			},
			"dialogs": [
				{
					"id": 730141501,
					"content": "#Terima kasih Nara {NICKNAME}, sisanya biar Arapandu yang urus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141502
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141502,
					"content": "Tapi, sudah terlalu lama, tidak tahu apakah akan berhasil ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141503
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141503,
					"content": "Eh?! Masih mungkin bisa gagal?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141504,
					"content": "Pernah berhasil sebelumnya, tapi kali ini masih tidak tahu. Seperti sebelumnya matahari terbit, tidak tahu berikutnya apakah masih akan terbit, tidak ada yang tahu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141505
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141505,
					"content": "Kan Paimon juga baru bisa bilang, \"Ah, mataharinya terbit lagi,\" setelah mataharinya memang sudah terbit lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141506
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141506,
					"content": "Huhu ... serem banget sih ... Terus kalau mataharinya enggak terbit lagi gimana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141507,
					"content": "#Paimon jangan takut, Nara {NICKNAME} sama seperti Nara Varuna, emas seperti matahari, Nara yang pemberani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141508
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141508,
					"content": "#Nara Varuna telah membawakan matahari dan bulan kembali untuk kami, Nara {NICKNAME} juga pasti bisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141509
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141509,
					"content": "#Hmm! Paimon juga percaya sama {NICKNAME} yang enggak akan tumbang sama masalah seberat apa pun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141510,
					"content": "Tenang, serahkan padaku.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141511
					]
				},
				{
					"id": 730141511,
					"content": "Tapi yang sekarang, serahkan saja sama Arapandu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141512
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141512,
					"content": "Oh ... Kayaknya ... berhasil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141513,
					"content": "Benar, cabang dan daun di sini berhasil sembuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141514
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141514,
					"content": "Hebat! Tarian Aranara memang benar-benar mengagumkan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141515,
					"content": "Paimon, kelihatannya kamu harus belajar sama Aranara.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141516
					]
				},
				{
					"id": 730141516,
					"content": "Ide bagus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141517,
					"content": "Paimon, kamu kan banyak makan, sudah seharusnya banyak olahraga juga ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141518
					]
				},
				{
					"id": 730141518,
					"content": "#Huh! Kan Paimon sudah ngikutin {NICKNAME} ke sana kemari, masa itu bukan olahraga sih!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141519,
					"content": "Tapi, kalau baru begini saja masa penyembuhan Varuna Contraption sudah beres sepenuhnya sih?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141520,
					"content": "Masih ada tiga lagi yang tersebar di Vana. Arabalika sangat kuat, mungkin bisa ... tapi Aranakula dan Arakunti, sangat mengkhawatirkan. Karena hujan tidak normal, Vana semakin berbahaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141521
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141521,
					"content": "#Gimana kalau Paimon sama {NICKNAME} pergi lihat kondisi mereka juga? Lagian kan kalau Varuna Contraption enggak disembuhin, mana bisa kita ngadain Festival Utsava dengan tenang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141522,
					"content": "#Berkat bantuan Paimon dan Nara {NICKNAME}, Varuna Contraption pasti bisa lekas sembuh, kehidupan di Vana akan kembali seperti dulu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141523
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141523,
					"content": "Aranakula pergi ke <color=#00E1FFFF>Monumen Yasna</color>. Ada kenangan Aranara tentang Nara Varuna di kedalaman Vana, tapi karena \"Fungus\" dan \"spora\", jadinya sudah lama belum ke sana lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141524
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141524,
					"content": "Aranakula terbiasa dengan tanah dan benih-benihan, semua yang lahir dari tanah tidak asing lagi baginya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141525
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141525,
					"content": "Temukan dia, beri tahu nama Arapandu, dia tidak akan takut lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141526
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141526,
					"content": "Oh, kayaknya Aranara sedikit penakut ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141527,
					"content": "#Ararakalari Arabalika sangat kuat! Tapi ... tidak apa-apa Paimon dan Nara {NICKNAME} lihat-lihat kondisinya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141528
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141528,
					"content": "#Arabalika ada di <color=#00E1FFFF>Ruins of Dahri</color>, ada banyak aroma besi di sana ... Paimon dan Nara {NICKNAME} harus hati-hati.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141529
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141529,
					"content": "Baiklah, kami akan berhati-hati.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141530
					]
				},
				{
					"id": 730141530,
					"content": "Arakunti ada di <color=#00E1FFFF>Grove of Dreams</color>, di sana ada pintu masuk menuju mimpi. Dia lebih jauh dari Nara, dan kalau dia bersembunyi, mainkan saja musik kami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141531
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141531,
					"content": "Oh ya, kami pernah dapat partitur musik Aranara sebelumnya. Jadi kalau Arakunti enggak ketemu, bisa coba putar musik ini dong ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141532
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141532,
					"content": "Arapandu akan pergi ke \"tempat istirahat\" terlebih dulu untuk menunggu sambil mengamati siatuasi Vana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141533
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141533,
					"content": "Aranakula, Arabalika, dan Arakunti semua tahu, akan kembali bertemu di \"tempat istirahat\" setelah menyembuhkan cabang dan daun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141534
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141534,
					"content": "#Nara Emas, Nara pemberani, semoga Aramuhukunda menyertai Nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141535
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141535,
					"content": "Baiklah! Serahkan sama kami!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7301417,
			"completionStepIds": [
				7301417
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301417",
							"2"
						],
						"stepId": 7301417,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Arapandu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730141701,
					"content": "Hei! Di situ ada apa?! Bagus banget!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141702,
					"content": "#Nara {NICKNAME} dan Paimon sudah lihat kan, itu adalah Varuna Treasure. Nah kalau Varuna Contraption letaknya lebih dalam lagi, di tempat yang sedalam akarnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141703
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141703,
					"content": "Kelihatannya kita terlalu nganggap remeh Nara Varuna ya, enggak disangka ukurannya sebesar ini ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141704,
					"content": "Kekuatan seperti itu tidak bisa diremehkan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141705
					]
				},
				{
					"id": 730141705,
					"content": "Sebelum hujan hitam, Nara Varuna belum datang ke Vana, tapi Aramuhukunda dan Lord of Dendro sudah menciptakan Varuna Contraption. Lalu, hujan mendatangkan banyak kehidupan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141706
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141706,
					"content": "Hujan hitam dan lumpur hitam, juga banyak hal lain, membuat Vana berantakan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141707
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141707,
					"content": "Sebelum dia, tidak pernah ada Nara yang begitu berani menyembuhkan Varuna Contraption bersama Aranara, seperti matahari yang berani mengusir kabut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141708
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141708,
					"content": "Sekarang Nara Varuna tidak lagi di Vanarana, begitu juga Aramuhukunda ... tapi Aranara ingin menyembuhkan Varuna Contraption lagi, demi Festival Utsava, demi Vanarana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141709
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141709,
					"content": "Kami kan sudah sepakat sama Araja dan Arama untuk sama-sama bersiap-siap buat Festival Utsava, kayak kalimat ungkapan, \"Semakin banyak Nara, semakin 'panas membara' acaranya!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141710,
					"content": "Eeeh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141711
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141711,
					"content": "Ah! Bukan gitu maksudnya, maksud Paimon, \"Semakin banyak Nara, semakin ramai acaranya dan lebih gampang berhasil!\" Jangan takut ya, arti 'panas membara' di sini enggak ada hubungan apa-apa kok sama api!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141712,
					"content": "Jangan banyak gaya, Paimon, sudahnya konyol sendiri, kan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141713
					]
				},
				{
					"id": 730141713,
					"content": "Ugh ... Sudah susah payah sampai ke Sumeru, ya kan minimal mau pamer ilmu dikit gitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141714,
					"content": "#Arapandu tidak takut, Paimon sangat baik, sama dengan Nara {NICKNAME}, sama dengan Nara Varuna, semua teman Aranara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141715
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141715,
					"content": "Aranakula, Arabalika, Arakunti, dan Arapandu, ingin menyembuhkan Varuna Contraption, namun ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141716
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141716,
					"content": "Terlalu banyak \"spora\" dan \"Fungus\", jadi kita tidak bisa apa-apa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141717
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141717,
					"content": "Arapandu tidak punya Ararakalari sehebat Arabalika, Fungus juga jadi lebih ganas karena hujan yang tidak normal ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141718
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141718,
					"content": "Tunggu, \"Ararakalari\" ... Paimon rasa dulu pernah dengar Arana bilang kalau itu bisa dipakai buat ngelawan Marana ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141719,
					"content": "Ararakalari sangat kuat, dapat mengusir \"Fungus\". Ararakalari Arapandu lemah, tidak dapat melawan Fungus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141720
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141720,
					"content": "Apa? Ararakalari bisa dipakai buat gitu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141721
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141721,
					"content": "Ararakalari sepertinya jadi sebutan umum untuk suatu kemampuan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141722
					]
				},
				{
					"id": 730141722,
					"content": "#Nara {NICKNAME} lebih pintar dari Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141723
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141723,
					"content": "*hiks* ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141724,
					"content": "Masing-masing Aranara mungkin punya Ararakalari yang berbeda. Tapi semua Aranara, memperoleh kekuatan untuk menggunakannya dari pohon di Vana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141725
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141725,
					"content": "Ararakalari Arabalika sangat kuat, sama sekali tidak takut Fungus yang besar, juga ada Nara besi yang besar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141726
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141726,
					"content": "Nara besi yang besar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141727,
					"content": "#Nara besi yang besar, sama dengan Nara {NICKNAME}, memiliki dua tangan, dua kaki, tapi hanya satu mata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141728
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141728,
					"content": "Ah, maksudnya Ruin Guard!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141729,
					"content": "Paimon pintar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141730
					]
				},
				{
					"id": 730141730,
					"content": "Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141731
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141731,
					"content": "Ah! Ada \"Fungus\" di atas pohon sana ... Arabalika pasti bisa mengalahkan mereka, tapi Arapandu tidak bisa ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141732
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141732,
					"content": "#Nara {NICKNAME} juga tidak takut dengan Fungus, meski tidak pakai Ararakalari, tapi sangat kuat. Seperti angin yang menghampaskan daun, wuuush ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141733
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141733,
					"content": "#Jika dibiarkan, akan semakin banyak \"spora\" dan \"Fungus\" ... Nara {NICKNAME} ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141734
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141734,
					"content": "#Serahkan pada kami! Dengan kemampuan Nara {NICKNAME} sih, pasti ini bakal selesai hanya dengan \"wuuush\"! Iya, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}