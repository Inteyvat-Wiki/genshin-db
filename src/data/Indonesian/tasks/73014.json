					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141204
					]
				},
				{
					"id": 730141204,
					"content": "Daun batu, cabang batu, keduanya diciptakan oleh Aramuhukunda dan Lord of Dendro bersama-sama, dapat menyalurkan kekuatan Vanarana kepada Varuna Contraption.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141205
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141205,
					"content": "Varuna Contraption seperti pohon besar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141206
					]
				},
				{
					"id": 730141206,
					"content": "Oh gitu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141207,
					"content": "Hmm ... harus putar ketiga daunnya ke arah cabang, tapi Arapandu tidak cukup kuat, sedih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141208
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141208,
					"content": "#Ah, Aranara ini kan cuma sekecil ini, yang ginian sih kasih saja sama Nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141209,
					"content": "Arabalika sih mungkin bisa saja, tapi Aranakula dan Arakunti ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141210
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141210,
					"content": "#Sebaiknya selesaikan masalah yang ini saja dulu, mohon bantuannya, Nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				}
			]
