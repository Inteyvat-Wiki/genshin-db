							"7320501",
							"2"
						],
						"stepId": 7320501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732050101,
					"content": "Ayo ke sini, lihat benih-benih ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050102
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050102,
					"content": "Sepertinya tidak berubah sama sekali.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050103
					]
				},
				{
					"id": 732050103,
					"content": "Iya, walaupun aku sudah bertahun-tahun bercocok tanam, tapi bercocok tanam beda dengan menanam bunga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050104
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050104,
					"content": "Tapi kenapa mereka belum tumbuh juga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050105
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050105,
					"content": "Sini biar Paimon lihat. Hmm ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732050106,
					"content": "Kakek Affan, Paimon rasa lahan pembibitannya terlalu kering. Kandungan tanah di sekitar Desa Aaru mungkin enggak cukup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732050107,
					"content": "Kami dulu pernah bantu tanam bunga di desa. Kami ada pengalaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732050108,
					"content": "Oh, benarkah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050109
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050109,
					"content": "Masuk akal juga. Pastinya spesies bunga yang langka seperti ini lebih peka daripada yang biasa. Rasanya memang air dan pupuk yang kuberikan tidak cukup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050110
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050110,
					"content": "Tapi tempat pembibitan ini agak jauh dari sumber air, agak repot mengambil airnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050111
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050111,
					"content": "Air yang kusimpan untuk kebutuhan sehari-hari juga tidak banyak, agak repot kalau sering dipakai untuk mengairi lahan pembibitan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050112
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050112,
					"content": "Aku bisa membantu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050113
					]
				},
				{
					"id": 732050113,
					"content": "Baiklah, kalau begitu tiga benih ini tolong disiram air ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		},
		{
			"id": 7320503,
