			"dialogs": [
				{
					"id": 732050401,
					"content": "Sirami dulu tiga benih itu, masalah pupuknya akan kupikirkan lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050402
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050402,
					"content": "Setelah menanam selama puluhan tahun, tentu saja aku tahu cara membuat pupuk yang sederhana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
