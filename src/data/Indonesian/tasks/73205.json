					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732040701,
					"content": "Wah, aku belum sempat masak, tidak ada makanan yang bisa kusajikan ke kalian loh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040702,
						732040703
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040702,
					"content": "Tidak deh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040704
					]
				},
				{
					"id": 732040704,
					"content": "Bocah satunya lagi ini temanmu, kan? Dia imut sekali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040705
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040705,
					"content": "Maukah kalian datang untuk melihat bunganya saat sudah mekar nanti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040706
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040706,
					"content": "Oke.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040707
					]
				},
				{
					"id": 732040707,
					"content": "Bunganya tidak lama lagi mungkin akan mekar. Kembalilah nanti untuk melihat bunga yang kalian bantu tanam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040708
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040708,
					"content": "Oke.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040709
					]
				},
				{
					"id": 732040709,
					"content": "Baiklah, aku mengerti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040710
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040710,
					"content": "♪ ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040703,
					"content": "Jangan khawatir, kami tidak lapar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040704
					]
				}
			]
		},
		{
			"id": 7320501,
			"completionStepIds": [
				7320501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
