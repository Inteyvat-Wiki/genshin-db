				{
					"id": 741930506,
					"content": "Melusine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930507
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930507,
					"content": "#Paimon, teman ... baik! {NICKNAME} ... teman ... baik! Tukar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930508
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930508,
					"content": "Uh, ya sudah deh. Pahsiv mau pergi berapa lama? Kapan ketemu lagi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930509,
					"content": "Sampai ... jumpa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930510
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930510,
					"content": "Yah, gitu caranya janji biar ketemu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930511,
					"content": "\"Sampai ketemu\" itu cara kami bilang salam perpisahan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930512
					]
				},
				{
					"id": 741930512,
					"content": "Iya. Kan kami sudah janji mau ajarin kamu. Nah, coba kamu yang ngomong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930513,
					"content": "Salam ... pisah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930514
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930514,
					"content": "Eh ... enggak ngerti apa artinya ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930515,
					"content": "Hmm ... ya, anggap saja masih kayak tukeran lah. Kayak tukeran hari esok, sama hari esok yang lainnya lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930516,
					"content": "Ambil sedikit besoknya kamu, terus kasih kami. Kami juga sama, besoknya kami buat kamu. Jadi kita bakal ketemu lagi! Gimana, ngerti enggak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930517,
					"content": "Tukar ... besok ... sama besok! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930518
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 741930518,
					"content": "Hehe, paham nih kayaknya. Oke deh, sampai ketemu lagi ya! Kita pasti bakal ketemu lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930519,
					"content": "Sampai ketemu, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741930520,
					"content": "Sampai jumpa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930521
					]
				},
