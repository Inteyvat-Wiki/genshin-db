			},
			"dialogs": [
				{
					"id": 100070701,
					"content": "#Baiklah, seharusnya sudah cukup. Penampilan yang luar biasa, {NICKNAME}. Terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070702
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070702,
					"content": "Kekuatan yang kamu keluarin barusan ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070703
					]
				},
				{
					"id": 100070703,
					"content": "Ah, jangan khawatir. Kekuatan itu murni milikku sendiri. Tidak ada bantuan dari luar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070704
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070704,
					"content": "Anggap saja seperti ... menyetel alat musik agar bisa memainkan melodi yang lebih indah lagi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070705
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070705,
					"content": "Hah, ternyata kamu punya trik tersembunyi! Kamu nyembunyiin apa lagi, hmm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100070706,
					"content": "Oh, Paimon. Memangnya berapa banyak trik yang bisa kusembunyikan? Aku kan cuma punya dua lengan baju.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070707
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070707,
					"content": "Kamu tahu lah maksud Paimon bukan itu, Pengamen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100070708,
					"content": "Hahaha, aku punya firasat anginnya akan sangat kencang hari ini. Sebaiknya kita kembali ke Mondstadt dan kasih tahu orang-orang biar megang topi mereka erat-erat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 1000710,
