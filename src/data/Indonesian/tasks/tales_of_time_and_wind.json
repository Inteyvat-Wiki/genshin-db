					"speakerTitle": "Venti"
				},
				{
					"id": 100070502,
					"content": "Tapi itu ngelanggar peraturan konser, jadi, yuk kita usir mereka pergi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
