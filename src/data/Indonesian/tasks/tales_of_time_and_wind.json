						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 100071101,
					"content": "Aku pernah cerita ini sebelumnya, ingat? Tentang bagaimana aku bertemu dengan \"Waktu\" di Thousand Winds Temple dan mendapat bantuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071102
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071102,
					"content": "Yah, berkat bantuan Waktu-lah angin kebebasan pertama itu bisa bertiup begitu kencang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 1000712,
			"completionStepIds": [
				1000703
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 100071201,
					"content": "Namun, angin kencang seperti itu lebih cocok untuk membersihkan sesuatu, bukan untuk membantu sesuatu tumbuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071202
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071202,
					"content": "Jadi, setelah beberapa krisis di Mondstadt terselesaikan, aku membuat angin menjadi lebih lembut. Cukup kuat untuk mendukung penduduk di saat mereka membutuhkan, tapi tidak sampai membuat mereka terjatuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071203,
						100071204
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071203,
					"content": "Jadi, sesampainya kita di sini sekarang ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100071205
					]
				},
				{
					"id": 100071205,
					"content": "....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071206
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071206,
					"content": "Bayangan berkumpul di kejauhan. Aku yakin kamu juga merasakannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071207
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071207,
					"content": "Aku sudah dengar tentang konfrontasi antara Archon Pyro dan Ronova Yang Berkuasa Atas Kematian, serta apa yang terjadi pada Fatui Harbinger, the Captain.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071208
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071208,
					"content": "Belum lagi aktivitas Abyss yang semakin lama semakin mendekati Mondstadt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071209
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071209,
					"content": "Aku khawatir krisis yang akan datang ini mungkin di luar kemampuan manusia untuk mengatasinya ... Mengingat hal itu, aku harus bersiap-siap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071210
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071210,
					"content": "Sudah menjadi tugas Archon Anemo untuk turun tangan di saat dibutuhkan. Oleh karena itu, aku, Barbatos, akan mendatangkan angin yang cukup kuat untuk menghapus badai apa pun yang ada di depan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071211
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071211,
					"content": "Tapi, kalau aku menciptakan angin sekuat itu di Kota Mondstadt, tempat itu akan jadi berantakan. Baju, topi, bunga-bunga yang ada di balkon orang-orang ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071212
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071212,
					"content": "Itulah alasannya aku memilih tempat ini, yaitu tempat di mana aku pernah mempersembahkan sebuah sajak untuk Waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071213
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071213,
					"content": "Siapa tahu, mungkin saja Waktu memberikan perhatian khusus pada pulau ini justru karena musikku yang indah, sangat indah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071214
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071214,
					"content": "Tunggu, jadi ... Tempat ini benar-benar spesial? Tapi kok kelihatannya enggak gitu ya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100071215,
					"content": "Ada pasang surut air laut, dan sekumpulan burung yang datang dan pergi ... Kelihatannya sih ... biasa saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100071216,
					"content": "Dampak waktu pada sesuatu tidak terbatas pada apa yang bisa dilihat mata. Bayangkan seperti ... buah Sunsettia yang matang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071217
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071217,
					"content": "Jika kulit luarnya masih utuh, orang biasa hampir tidak mungkin bisa mengetahui apakah buah di dalamnya sudah matang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071218
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071218,
					"content": "Namun, kalau ada lubang sekecil apa pun pada kulitnya, pasti akan menyebabkan buah tersebut membusuk, dimulai dari titik tersebut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071219
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071219,
					"content": "Dalam genggaman Waktu, tak satu pun \"noda\" menandai \"kulit\" pulau ini. Dengan demikian, pengaruh Waktu terhadap esensinya tetap tersembunyi dari semua orang.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071220
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071220,
					"content": "Pada tingkat yang paling mendasar, tentu saja, semua hal yang tidak mendapat berkah Waktu pada akhirnya akan terhapus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071221
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071221,
					"content": "Tapi dengan kekuatan yang masih tersisa di sini, aku bisa memanfaatkan Waktu untuk membuat batasan di sekeliling Angin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071222
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071222,
					"content": "Dengan begitu, dunia luar tidak akan menyadari apa pun, tidak peduli seberapa kencang angin yang kuciptakan di sini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071223
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071223,
					"content": "#Tentu saja, sebagai yang meminta bantuan, aku harus kasih sesuatu sebagai balasannya. Itu alasanku mengundangmu ke sini, {NICKNAME} ... Agar kita bisa membawakan sebuah syair untuk Waktu bersama-sama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071224
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071224,
					"content": "#Kasih tahu aku kalau kamu sudah siap, {NICKNAME}. Oh, dan aku bisa meminjamkan alat musik kalau kamu butuh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071204,
					"content": "Apa kita mau membuat angin kembali ...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100071205
					]
				}
			]
		},
		{
			"id": 1000713,
