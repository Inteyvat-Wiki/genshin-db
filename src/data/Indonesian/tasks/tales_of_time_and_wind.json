			},
			"dialogs": [
				{
					"id": 100070401,
					"content": "Pulau ini ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070402
					]
				},
				{
					"id": 100070402,
					"content": "Apa ada yang spesial dari pulau ini?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070403
					]
				},
				{
					"id": 100070403,
					"content": "Tidak selalu. Dahulu ini hanyalah sebuah pulau seperti yang lainnya. Hanya kumpulan pasir dan kerikil yang biasa saja, tidak menarik perhatian.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070404
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070404,
					"content": "Sampai benih-benih cerita dibawa kemari oleh angin, dan dipelihara oleh waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070405
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070405,
					"content": "Dan seiring waktu berlalu, angin membawa cerita-cerita baru, dan waktu membuat mereka tumbuh menjadi legenda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070406
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070406,
					"content": "#Jadi, dengan itu ... Izinkan aku menyambutmu dengan \"kejujuran\" ke pulau yang dikasihi oleh Waktu ini, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070407
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070407,
					"content": "Inilah tempat di mana Waktu dan Angin bertemu di masa lampau.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070408,
					"content": "Wah, wah, wah ... Kamu tiba-tiba terdengar serius banget, Pengamen. Paimon juga enggak yakin bisa ngikutin pembicaraan ini lagi ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100070409,
					"content": "Hehe, Paimon enggak usah khawatir! Cerita terbaik selalu dimulai dengan sedikit ketegangan dan intrik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
