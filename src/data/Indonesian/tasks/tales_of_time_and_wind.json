			"dialogs": [
				{
					"id": 100070101,
					"content": "... Kalau begitu, kuanggap itu sebagai jawaban \"ya\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070102
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070102,
					"content": "Venti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070103
					]
				},
				{
					"id": 100070103,
					"content": "#Ah, akhirnya! Kamu udah datang, {NICKNAME}! Mungkin kamu bawain pesan untukku dari seseorang?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070104,
						100070105
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070104,
					"content": "Pesan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070106
					]
				},
				{
					"id": 100070106,
					"content": "\"Tidak ada satu pun ramalan tentangmu dalam kamus itu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070107
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070107,
					"content": "Itu yang mau kamu katakan, kan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070108,
						100070109
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070108,
					"content": "Ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070110
					]
				},
				{
					"id": 100070110,
					"content": "#Oh? Tunggu sebentar, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070111
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070111,
					"content": "Hmm ... Rasa ingin tahumu sepertinya masih kuat seperti biasa, Barbeloth. Sayangnya, \"masa depanku\" harus tetap absen dari kamusmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070112
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070112,
					"content": "Angin mungkin senang membiarkan bunga dandelion melacak bentuknya, dan membiarkan para penyair melantunkannya dalam sajak, namun terkurung bukanlah sifat alaminya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070113
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070113,
					"content": "Jadi, Barbeloth yang baik, tolong letakkan penamu. Kata-kata yang terdengar di angin tidak ditakdirkan untuk dicatat di kertas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070114
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070114,
					"content": "Jika kamu benar-benar tertarik dengan legenda ini, izinkan aku menggubahnya menjadi sebuah puisi. Aku akan membagikannya kepada kalian para wanita di acara minum teh kita berikutnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070115
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070115,
					"content": "Barbeloth? Dia ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070116
					]
				},
				{
					"id": 100070116,
					"content": "Hahaha, Barbeloth orangnya selalu masuk akal kok, dan aku yakin dia mendengar permintaanku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070117
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070117,
					"content": "Dengan begitu, percakapan kita seharusnya tidak akan terganggu untuk sementara waktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070118
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070118,
					"content": "Tunggu, Barbeloth menguping pembicaraan kita tadi? Pa-Paimon sama sekali enggak sadar ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100070119,
					"content": "Yah, dia kan penyihir Hexenzirkel. Mereka semua punya banyak trik tersembunyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070120
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070120,
					"content": "Tapi kamu langsung sadar, bahkan berhasil bikin dia ninggalin kita. Bukannya itu artinya di sini malah kamu yang jagonya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100070121,
					"content": "Hmm ... Melihat berbagai faktor yang ada, aku bisa menyebut diriku cukup jago, hingga batasan tertentu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070122
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070122,
					"content": "Tuh kan, kamu mulai misterius lagi. Yah, pokoknya, enggak ada satu hal pun tentangmu di kamus itu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070123,
						100070124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100070123,
					"content": "Ya, dia cuma ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070125
					]
				},
				{
					"id": 100070125,
					"content": "Kehadiranmu di sini sudah cukup. \"Ramalan\" Barbeloth tentang diriku mungkin \"tidak lengkap,\" tapi itu bukan berarti \"salah.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070126
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070126,
					"content": "Ada sesuatu yang harus kulakukan, dan aku memang butuh bantuanmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070127,
						100070128
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070127,
					"content": "Apa itu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070129
					]
				},
				{
					"id": 100070129,
					"content": "Hehe, seperti biasa, bisa diandalkan. Kalau begitu ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070130
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070130,
					"content": "#Maukah kamu bermain musik bersamaku nanti, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070131,
						100070132
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070131,
					"content": "Hah? Bisa aja sih ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070133
					]
				},
				{
					"id": 100070133,
					"content": "Yap. Hanya itu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070134
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070134,
					"content": "Tapi jangan khawatir. Ini bukan pertunjukan untuk menentukan nasib dari suatu peristiwa penting ... Ini hanyalah duet antara teman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070135
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070135,
					"content": "Terakhir kali aku memainkan lagu ini, angin kencang yang menderu menjadi satu-satunya penontonku, dan nada-nadanya tersebar ke segala arah, yang tertinggal hanyalah serpihan melodi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070136
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070136,
					"content": "Tapi sekarang, kalau ada teman sepertimu di sisiku, kenapa harus angin saja yang menjadi saksi musik ini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070137
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070137,
					"content": "Lagi pula, aku yakin tanganku akan jauh lebih mantap saat bermain bersama teman terpercaya sepertimu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070138
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070138,
					"content": "Aku akan bermain sebaik mungkin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070139
					]
				},
				{
					"id": 100070139,
					"content": "Aku minta itu doang. Yuk kita pergi ke tempat pertunjukan. Kalau kita mengikuti arah angin, pasti akan cepat sampai di sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070132,
					"content": "Tapi apa itu saja yang perlu kulakukan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070133
					]
				},
				{
					"id": 100070128,
					"content": "Serahkan padaku!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070129
					]
				},
				{
					"id": 100070124,
					"content": "Menyuruhku untuk datang ke sini dan menunggu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070125
					]
				},
				{
					"id": 100070109,
					"content": "Para penyihir memang menyuruhku untuk menemuimu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070110
					]
				},
				{
					"id": 100070105,
					"content": "Sebenarnya, um ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070106
					]
				}
			]
		},
