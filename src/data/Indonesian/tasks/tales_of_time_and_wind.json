				"points": []
			},
			"dialogs": [
				{
					"id": 100071001,
					"content": "Dahulu kala, aku memanggil angin kebebasan pertama demi rakyat Mondstadt. Dengan bantuan angin itu, kebebasan dikembalikan kepada mereka yang berhak mendapatkannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 1000711,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"1504501",
