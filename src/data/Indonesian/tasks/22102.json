			"dialogs": [
				{
					"id": 221020101,
					"content": "Benar-benar merepotkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020102
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020102,
					"content": "Ada apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221020103
					]
				},
				{
					"id": 221020103,
					"content": "Lihatlah kantong mataku ini. Aku sudah berhari-hari tidak bisa tidur dengan baik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020104
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020104,
					"content": "Apa kamu melihat tamu-tamu yang lain? Satu demi satu suka mencari masalah. Salah satu dari mereka melompat ke bawah dari bangunan setinggi ini. Apa sih yang mereka pikirkan?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020105
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020105,
					"content": "Sudahlah, jangan pedulikan hal itu. Sekarang aku sedang menunggu kiriman sayur dari kota. Seharusnya sebentar lagi akan sampai.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020106
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020106,
					"content": "Monster-monster di sepanjang jalan tidak akan tinggal diam. Apa kamu bisa membantuku membasmi mereka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020107,
						221020108
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020107,
					"content": "Baiklah.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221020109
					]
				},
				{
					"id": 221020109,
					"content": "Terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020108,
					"content": "Penginapan ini sepertinya telah dikutuk...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221020110
					]
				},
				{
					"id": 221020110,
					"content": "Menampung para pengembara membuatmu dapat mendengar berbagai cerita berharga dari segala penjuru dunia. Itulah yang aku harapkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020111
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020111,
					"content": "Penginapan ini hanya terletak di lokasi yang sedikit jauh dan sedikit sibuk. Tidak ada yang bisa disombongkan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020112
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020112,
					"content": "Aku sangat berterima kasih atas bantuanmu. Semoga beruntung.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
