			"dialogs": [
				{
					"id": 700000401,
					"content": "Selamat datang di Floral Whisper. Ada yang perlu dibantu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000402
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 700000402,
					"content": "Tentang foto Sayid...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000403
					]
				},
				{
					"id": 700000403,
					"content": "Hmm, kurasa Festival Windblume di Mondstadt memang sangat unik. Orang-orang Sumeru mungkin tidak ada yang merayakannya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000404
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 700000404,
					"content": "Ingin memotret aku dan bungaku? Tidak masalah kok. Tuan Sayid memang punya cara berpikir yang unik. Namanya juga peneliti ya, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
