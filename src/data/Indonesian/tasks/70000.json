					"Sayid"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700000601,
					"content": "Kalian sudah selesai memotret semuanya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000602
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000602,
					"content": "Semuanya sudah selesai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000603
					]
				},
				{
					"id": 700000603,
					"content": "Oh, hasil potret yang sangat bagus. Aku yakin foto-foto ini akan berguna untuk penelitianku.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000604
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000604,
					"content": "Melihat pemandangan yang begitu indah mengingatkanku akan festival di kampung halamanku, Sumeru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000605
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000605,
					"content": "Festival apa yang kamu rayakan di sana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000606
					]
				},
				{
					"id": 700000606,
					"content": "Ah, kurasa kamu tidak begitu akrab dengan tradisi kami. Setiap tahun, kami merayakan Festival Sabzeruz untuk memperingati kelahiran Lesser Lord Kusanali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000607
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000607,
					"content": "Tapi jika kita ingin membandingkan suasananya, bisa dibilang ada beberapa perbedaan antara festival sekarang dengan festival yang ada di kampung halamanku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000608
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000608,
					"content": "Ngomong-ngomong, aku juga tidak bisa ikut merayakan Festival Sabzeruz tahun ini. Ah, rasanya sudah lama sekali, aku jadi ingin tahu bagaimana keadaan di Akademiya saat ini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000609
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000609,
					"content": "Topiknya jadi melenceng jauh. Bagaimanapun, terima kasih atas bantuanmu ya. Silakan terima ini sebagai pembayaran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sayid"
				}
			]
		}
	]
