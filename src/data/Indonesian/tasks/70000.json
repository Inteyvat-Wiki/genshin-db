					"Sayid"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700000101,
					"content": "Sungguh tradisi yang romantis ya. Nah, sekarang jadi berharga untuk diteliti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000102
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000102,
					"content": "Kamu sedang apa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000103
					]
				},
				{
					"id": 700000103,
					"content": "Oh, ternyata kamu, Pengembara. Apakah kamu ke perpustakaan karena tertarik dengan lagu-lagu romantis Mondstadt juga?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000104
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000104,
					"content": "Tetap saja, kata-kata di halaman buku bisa dibaca kapan saja, tapi sejarah yang terjadi di sekitar kita akan berlalu begitu saja.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000105
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000105,
					"content": "Penduduk Mondstadt memiliki banyak kebiasaan khusus di saat-saat nyaman dan romantis yang dikenal sebagai Festival Windblume ini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000106
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000106,
					"content": "Apa bentuk tradisi ini, dan bagaimana dengan sejarah di baliknya? Semua ini adalah sudut pandang penelitian yang sangat baik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000107
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000107,
					"content": "Aku sedang menulis laporan penelitian tentang hal ini dan aku yakin deskripsi saja tidaklah cukup. Bisakah kamu membantuku memotret beberapa foto pemandangan di sekitar Festival Windblume?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000108,
						700000110
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000108,
					"content": "Boleh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000109
					]
				},
				{
					"id": 700000109,
					"content": "Terima kasih telah membantu penelitianku, aku pasti akan mencantumkan namamu ke dalam daftar ucapan terima kasih.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000113
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000113,
					"content": "Semua hal-hal ini berharga untuk didokumentasikan: <color=#00E1FFFF>hiasan bunga di atas air mancur alun-alun</color>, <color=#00E1FFFF>patung Archon Anemo yang berhiaskan bunga-bunga di depan Katedral</color>, dan <color=#00E1FFFF>pemilik toko bunga yang sedang sibuk bekerja keras</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000115
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000115,
					"content": "Tolong bantu potretkan semua pemandangan ini dan serahkan foto-foto itu kepadaku sesudahnya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000110,
					"content": "Sebaiknya kamu pergi sendiri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700000111
					]
				},
				{
					"id": 700000111,
					"content": "Tidak, tidak, aku tidak bisa pergi sekarang. Baru juga menyusun garis besar laporanku, kalau aku pergi sekarang, nanti semua pikiranku akan buyar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000112
					],
					"speakerTitle": "Sayid"
				},
				{
					"id": 700000112,
					"content": "Kuserahkan padamu ya, Pengembara. Walaupun jumlahnya tidak banyak, tapi aku akan menyiapkan kompensasi untukmu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700000113
					],
					"speakerTitle": "Sayid"
				}
			]
		},
