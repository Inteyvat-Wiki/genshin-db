			"dialogs": [
				{
					"id": 790480101,
					"content": "Di sini ada lembaran-lembaran kertas, catatan siapa ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790480102
					],
					"speakerTitle": "Baca"
				},
				{
					"id": 790480102,
					"content": "Kalau dilihat dari kata-katanya sih ... Kayaknya buku harian seorang pelukis?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790480103,
						790480104
					],
					"speakerTitle": "Baca"
				},
				{
					"id": 790480103,
					"content": "Percaya diri sekali dia ....",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790480105
					]
				},
				{
					"id": 790480105,
					"content": "Tapi Paimon ngerti kok! Kalau enggak punya tekad sekuat itu, mau bagaimana pun pasti susah buat menguasainya dengan cepat, kan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790480106
					],
					"speakerTitle": "Baca"
				},
				{
					"id": 790480106,
					"content": "Tapi, buku harian ini enggak cukup detail juga sih, Paimon jadi penasaran apa yang terjadi sesudahnya ....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790480107
					],
					"speakerTitle": "Baca"
				},
				{
					"id": 790480107,
					"content": "#Mungkin kita bisa ketemu sisa buku hariannya di tempat lain. {NICKNAME}, coba kita lihat-lihat dulu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Baca"
				},
				{
					"id": 790480104,
					"content": "Agak arogan ya dia ....",
