			"dialogs": [
				{
					"id": 726680101,
					"content": "Bu harika. Bir yönden \"Mehtaplı Denizlerin Canavarı\"nın peşine düşenlerin dilekleri gerçekleşmiş oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680102,
					"content": "Bitirdin mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680103
					]
				},
				{
					"id": 726680103,
					"content": "Baksana baksana, Jiawei sağlıklı bir eş buldu mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680104,
					"content": "Nantuck da içeriği tamamen yanlış olmasına rağmen, \"Mehtaplı Denizlerin Canavarı\" kitabı sayesinde itibarlı bir yazar oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680105,
					"content": "Kujirai Momiji ise babasının yapamadığını yaptı, \"Mehtaplı Denizlerin Canavarı\"nı yakalayarak Inazuma'daki en ünlü balıkçı oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680106,
					"content": "#Paimon'a göre senin de dileklerin gerçek olacak {NICKNAME}! Hi hi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680107,
					"content": "Paimon az önce ne diledi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680108
					]
				},
				{
					"id": 726680108,
					"content": "Söylemem ki! Söylemem ki! Paimon dileğini söylerse dileği gerçekleşmez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680109,
					"content": "\"Mehtaplı Denizlerin Canavarı\"nın o kadar pinti olduğunu düşünmüyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680110
					]
				},
				{
					"id": 726680110,
					"content": "Hımmm. İyi dinle o zaman bak, Paimon yalnızca bir kere söyleyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680111,
					"content": "Paimon, senin dileğinin gerçekleşmesini diledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726680112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 726680112,
					"content": "Duyamadım, ne dedin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726680113
					]
				},
				{
					"id": 726680113,
					"content": "Hıh, Paimon tekrar söylemeyecek! Paimon'un canı şeker istiyor. Lalala...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
