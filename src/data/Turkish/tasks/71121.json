			"dialogs": [
				{
					"id": 711215101,
					"content": "C-Cesur ve yiğit kahraman! Lütfen hayatımı bağışla! Ben onlardan biri değilim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711215102
					],
					"speakerTitle": "Tuhaf Tüccar"
				},
				{
					"id": 711215102,
					"content": "Peki sen kimsin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711215103
					]
				},
				{
					"id": 711215103,
					"content": "Ben mi? Şey... Ben... Uzun hikaye... Bir şeyler çalmışlardı, ustam da benden bu çalıntı malları kaydetmemi ve geri vermemi istedi, hepsi bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711215104
					],
					"speakerTitle": "Tuhaf Tüccar"
				},
				{
					"id": 711215104,
					"content": "Tüm hırsızları uzaklaştırdığına ve buradaki işim bittiğine göre benden bu kadar, sakıncası yoksa ben kaçar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711215105
					],
					"speakerTitle": "Tuhaf Tüccar"
				},
				{
					"id": 711215105,
					"content": "Bir dakika...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711215106
					]
				},
				{
					"id": 711215106,
					"content": "Gerek yok. Ne de olsa yeniden buluşacağız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tuhaf Tüccar"
				}
			]
