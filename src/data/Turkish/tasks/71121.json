			"dialogs": [
				{
					"id": 711210201,
					"content": "Çok teşekkürler, size minnettarım! Siz olmasaydınız tüm mallarım kaybolmuştu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210202
					],
					"speakerTitle": "Tuhaf Tüccar"
				},
				{
					"id": 711210202,
					"content": "Üzerimde pek para yok ama lütfen bunu kabul edin. Çekinmeyin, alın hadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210203
					],
					"speakerTitle": "Tuhaf Tüccar"
				},
				{
					"id": 711210203,
					"content": "Vay canına, ne kadar da nazik birisin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711210204,
					"content": "O halde şimdilik elveda. Umarım daha sonra tekrar karşılaşırız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tuhaf Tüccar"
				}
			]
		},
		{
