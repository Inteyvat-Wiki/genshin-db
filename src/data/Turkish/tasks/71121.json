				"points": []
			},
			"dialogs": [
				{
					"id": 711210301,
					"content": "L-Lütfen canımı bağışlayın büyük kahramanlar... Ha, siz miydiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210302
					],
					"speakerTitle": "Tuhaf Tüccar"
				},
				{
					"id": 711210302,
					"content": "Sen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711210303
					]
				},
				{
					"id": 711210303,
					"content": "Hey, bu ne tesadüf! Hehehe, siz dönüp işinize bakın. Şimdi izin verirseniz ben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210304
					],
					"speakerTitle": "Tuhaf Tüccar"
				},
				{
					"id": 711210304,
					"content": "Arkalarında ne gibi değerli eşyalar bıraktıklarına bakmanı öneririm. Halihazırda her şeyin kaydını aldım... Geri verilmesi gereken her şeyi vereceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711210305
					],
					"speakerTitle": "Tuhaf Tüccar"
				},
				{
					"id": 711210305,
					"content": "Bekle!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711210306
					]
				},
				{
					"id": 711210306,
					"content": "Gerek yok. Ne de olsa yeniden buluşacağız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tuhaf Tüccar"
				}
			]
		},
