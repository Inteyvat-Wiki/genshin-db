			"dialogs": [
				{
					"id": 745310101,
					"content": "#{NICKNAME}, Paimon, dönmüşsünüz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310102,
						745310103
					],
					"speakerTitle": "Ninette"
				},
				{
					"id": 745310102,
					"content": "Bu sefer bayağı fotoğraf çektim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745310104
					]
				},
				{
					"id": 745310104,
					"content": "Harika! Yardımın için çok teşekkür ederim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310105
					],
					"speakerTitle": "Ninette"
				},
				{
					"id": 745310105,
					"content": "Sen fotoğrafları çekerken öylece durup hiçbir şey yapmazsam hiç ilerleme kaydedemeyeceğimi düşünmeye başladım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310106
					],
					"speakerTitle": "Ninette"
				},
				{
					"id": 745310106,
					"content": "Bu yüzden cesaretimi toplayıp yoldan geçen birkaç kişiden yardım istedim, hatta kendim de bir sürü fotoğraf çektim! Sanırım test için yeterince veri toplanmış oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310107
					],
					"speakerTitle": "Ninette"
				},
				{
					"id": 745310107,
					"content": "#Heh, beni hayal kırıklığına uğratmayacağını biliyordum! Yardımların için sana da teşekkürler {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310108
					],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 745310108,
					"content": "Lepine-Pauline! Ne zaman döndün? Ninette son zamanlarda başka bir şeyle meşgul olduğunu söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745310109,
					"content": "Tabii ki bu çok büyük bir iş, hem de ceplerimi hıncahınç doldurmaya yetecek kadar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310110
					],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 745310110,
					"content": "Son zamanlarda çok yoğundum, bu yüzden Ninette'e yardım etmene çok sevindim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310111
					],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 745310111,
					"content": "Kabiliyetli ve zevkli biri, orası kesin. Yalnızca biraz utangaç. Ama senin yardımınla çok önemli bir adım atmayı başardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310112
					],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 745310112,
					"content": "İyi de bu esrarengiz tavırlarla bahsettiğin \"büyük iş\" de neymiş? Sakın Paimon'a deli saçması bir söylenti duyup da yine her şeyi riske attığını söyleme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745310113,
					"content": "Ne? Tabii ki öyle bir şey yok! Dersimi aldım. Bu seferki gerçek bir fırsat. Güvenli ve mutlaka servet kazandıracak türden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745310114
					],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 745310114,
					"content": "(Pek inandırıcı gelmiyor...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745310115
					]
				},
				{
					"id": 745310115,
					"content": "Hıh, şimdi söylersem sürprizi bozulur. İş bittiğinde ilk deneyen siz olacaksınız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 745310103,
					"content": "\"Şipşak Aksiyon\" lensi muhteşem iş çıkardı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745310104
					]
				}
			]
		}
	]
}