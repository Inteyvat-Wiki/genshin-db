			"dialogs": [
				{
					"id": 3790201,
					"content": "Tekrar hoş geldiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790202
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790202,
					"content": "İşte, Kutsal Lir! Almayı başarmışsın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790203
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790203,
					"content": "Gül ağacına işlenmiş bir meltem... Yaylara dokununca hâlâ bir esinti geliyor. Ah, anılar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790204
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790204,
					"content": "Ne düşünüyorsun Venti? Dvalin'i çağırabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790205
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3790205,
					"content": "Bu lir gerçek olsa da işe yarayacağından şüpheliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790206
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790206,
					"content": "Gördüğünüz gibi, lir bin yıllık bir geçmişe sahip. Sahip olduğu Rüzgar gücü tükenmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790207
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790207,
					"content": "Bu durumdayken Diluc'un hanı için bile müzik çalamazsın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790208
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790208,
					"content": "Ozanlar benim hanımda sahneye çıkmak için kapışıyor. Bilip bilmeden konuşma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790209
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3790209,
					"content": "Usta Diluc, şu an gerçekten konumuz bu mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3790210,
					"content": "Ayrıca... Kutsal Liri yalnızca sarhoşlara müzik yapmak için mi ödünç aldın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3790211,
					"content": "Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790212
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790212,
					"content": "Ne demek \"hehe\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3790213,
					"content": "Neyse, bununla Dvalin'i çağırmak mümkün olmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790214
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790214,
					"content": "Lirin kendisinde sorun yok, ama yayları...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790215
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790215,
					"content": "Top sende, yabancı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790216,
						3790217
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790216,
					"content": "Benden mi bahsediyorsunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790218
					]
				},
				{
					"id": 3790218,
					"content": "Rahat ol! Bozuk değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790219
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790219,
					"content": "Yalnızca Rüzgar gücünün yoğunluğu büyük ölçüde azalmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790220
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790220,
					"content": "#{NICKNAME}, Dvalin'in Gözyaşı Kristali hâlâ yanında mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790221
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790221,
					"content": "*başını evet anlamında sallar*",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3790217,
					"content": "Ben enstrüman tamirinden anlamam.",
