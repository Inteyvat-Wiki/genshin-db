					"content": "Gençlik dolu bu ışıltı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790403
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3790403,
					"content": "Kendini mi övüyorsun? Gerçekten mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3790404,
					"content": "... Kutsal Lirden bahsediyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790405
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3790405,
					"content": "#Kristali arındıran {NICKNAME} sayesinde, Kutsal Lir artık gücünü kaybetmeyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790406
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790406,
					"content": "Bununla beraber, gücü henüz tamamen yenilenmiş değil. Daha fazla gözyaşı bulabilirsek harika olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790407,
						3790409,
						3790410
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790407,
					"content": "Yardım edeceğiz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790408
					]
				},
				{
					"id": 3790408,
					"content": "Nasıl daha fazla toplayabiliriz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3790411,
					"content": "Dvalin'in zaten ağladığını düşünüyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790412
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790412,
					"content": "Issız bir yerde tek başına acı çekiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790413
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790413,
					"content": "Dvalin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790414
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3790414,
					"content": "Zavallı şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3790415,
					"content": "Bu bir Fahri Şövalyenin tek başına yapabileceği bir iş değil. Diğer şövalyeleri sana destek olması için seferber edeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790416
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3790416,
					"content": "#Gözyaşı Kristalini aldığında, lütfen {NICKNAME} arındırma işlemini yapsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790417
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3790417,
					"content": "Bana bırakın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790418
					]
				},
				{
					"id": 3790418,
					"content": "Kahramanlar birbirine destek oluyor ve beraber bir yolculuğa çıkıyor... Çok heyecan verici!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790419
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790419,
					"content": "Sizin için bir şarkı yazayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790420
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790420,
					"content": "Tek yapacağın şey bu mu cidden? Şarkı mı söyleyeceksin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3790421,
					"content": "Şimdi söylemezsem ozanlığımın ne anlamı kalır?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790422
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3790422,
					"content": "Hım. Çok şımarıksın... Kötü bir lakabı hak ediyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3790423,
					"content": "Oh, Paimon buldu bile! Bundan sonra seni <color=#00E1FFFF>\"Detone Ozan\"</color> olarak bilecekler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3790409,
					"content": "Doğru. Bunu nasıl yapacağız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790411
					]
				},
				{
					"id": 3790410,
					"content": "Dvalin'i nasıl ağlatacağız? Onu döverek mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790411
					]
