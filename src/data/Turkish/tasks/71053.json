			"dialogs": [
				{
					"id": 710501401,
					"content": "O halde asıl meseleye gelelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501402
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501402,
					"content": "Son birkaç gün içinde bana büyük yardımın dokundu. Sana bunun karşılığını nasıl veririm bilmiyorum gerçekten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501403
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501403,
					"content": "Sürdürdüğümüz samimi iş birliğini düşünürsek, sana Mora ile ödeme yapmam yetersiz kalır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501404
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501404,
					"content": "Aslında, ısrar ediyorsan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710501405
					]
				},
				{
					"id": 710501405,
					"content": "Ciddiyim! Yalnızca altın vererek senin gururunu incitecek kadar görgüsüz biri miyim ben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501406
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501406,
					"content": "Bunun sana hakaret etmekten ne farkı var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501407
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501407,
					"content": "İşte, bu mektubu al. Gelecekte Sumeru'ya yolun düştüğünde, eğer başın belaya girerse veya yardıma ihtiyaç duyarsan, bu mektubu Purbiruni ailesine ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501408
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501408,
					"content": "Sana elimizden gelen her şekilde yardım ederiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501409
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710501409,
					"content": "\"Bağlantılar, altından daha değerlidir.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501410
					],
					"speakerTitle": "Khedive"
				},
				{
