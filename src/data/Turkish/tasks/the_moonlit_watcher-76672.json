						],
						"pointId": 361100049
					}
				]
			},
			"dialogs": [
				{
					"id": 766720202,
					"content": "Lakka Böğürtlenli Krumkake, Tütsülenmiş Balık Fileto, Böğürtlenli Et Kızartması ve Gece Nöbeti Çorbası... Burada ne kadar çok şey var! Neredeyse Paimon için bile çok fazla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766720203,
					"content": "Hımm... Bunu genelde akşam yemeğinde askerler için pişirdiğimiz miktarlara göre hazırladım. O yüzden... Evet, üç kişi için biraz fazla olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720204
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720204,
					"content": "Ama sorun değil, acele etmeyin. Benim birazdan gidip benim ihtiyarı görmem lazım, siz akşama kadar kalabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720205,
						766720206
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720205,
					"content": "Bu kadar yetenekli bir şef olduğunu bilmiyordum!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766720208
					]
				},
				{
					"id": 766720208,
					"content": "Aslında mevcut görevime başlamadan önce herkese sık sık yemek yapardım. Fakat son zamanlarda pek vaktim olmuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720209
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720209,
					"content": "Piramida halkı dünyanın dört bir yanından geliyor, bu yüzden çok farklı damak zevklerine hitap eden yemekler var. Başka bir deyişle her telden çalmak işe yarıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720210
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720210,
					"content": "Ama sizin damak zevkinizi henüz bilmediğim için her şeyden azar azar hazırladım. Aralarında özellikle beğendiğiniz bir şey olursa söylemekten çekinmeyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720211,
						766720214
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720211,
					"content": "Paimon beğenirse ben de beğenirim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766720212
					]
				},
				{
					"id": 766720212,
					"content": "O da ne demek oluyor? Bak şimdi, Paimon gözünü Böğürtlenli Et Kızartmasına dikti. Sakın onunla kapışmaya falan kalkma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766720213,
					"content": "Haha, kavga etmenize gerek yok. Ben biraz daha yaparım. Takım arkadaşlarımı aç bırakmam herhalde, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720216
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720216,
					"content": "İnsanlar ne derse desin, biri sevdiği bir yemeği yerken yüzünün aldığı o ifade asla yalan söylemez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720217
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720217,
					"content": "Benim için insanları memnun görmekten daha mutluluk verici hiçbir şey yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720218
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720218,
					"content": "Gerek bir Işık Muhafızı gerek bir şef olarak etrafımdakilerin gülümsemesini sağlamak için elimden ne geliyorsa yaparım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720219
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720219,
					"content": "Bu size önemsiz gelebilir ama aslında kendimi bildim bileli istediğim tek şey bu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720220,
						766720221
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720220,
					"content": "Kendini küçük görme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766720222
					]
				},
				{
					"id": 766720222,
					"content": "Aynen öyle! Etrafındakiler tüm yaptıkların için sana minnettar olmalı. Hatta kendini bu şekilde küçümsediğini duysalar muhtemelen kızarlardı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766720223,
					"content": "Hem zaten önce biz geldik, onların sıraya girmeleri gerekirdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766720224,
					"content": "Teşekkür ederim, hehe... Pekala, akşam yemeğiyle ilgisi olmayan başka bir konu açmayacağım. Lütfen yemeğinizin tadını çıkarın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720221,
					"content": "Harika bir iş çıkarıyorsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766720222
					]
				},
				{
					"id": 766720214,
					"content": "Senin elinden ne olsa yerim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766720215
					]
				},
				{
					"id": 766720215,
					"content": "Heh, beni böyle pohpohlamana gerek yok. Hatta sen iltifat ettikçe senin en çok seveceğin yemeği bulmayı daha da istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720216
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720206,
					"content": "Merak etme, Paimon bu işi halleder.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766720207
					]
				},
				{
					"id": 766720207,
					"content": "Tabii ki, hehe, ona şüphe yok! Dostumuzun çabalarının boşa gitmesine izin veremeyiz! Yine de Paimon senin bu kadar iyi bir aşçı olmanı beklemiyordu Illuga.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720208
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}