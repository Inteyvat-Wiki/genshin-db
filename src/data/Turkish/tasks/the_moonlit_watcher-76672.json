			"dialogs": [
				{
					"id": 766720101,
					"content": "Görev tamamlandı! Heh, burası artık gıcır gıcır bir kamp gibi duruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766720102,
					"content": "Evet! İstihkamlar bile tamamlandı. İster canavar olsun ister başka bir şey, artık saldıran hiç kimse savunmamızı kolay kolay aşamaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720103
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720103,
					"content": "Deniz fenerinde yarım aylık yakıt stoku var, bu yüzden büyük bir Vahşi Av saldırısı durumunda bile destek kuvvetler gelene kadar dayanabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720104
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720104,
					"content": "O kadar ilerisini düşünüyorsun ha?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766720105
					]
				},
				{
					"id": 766720105,
					"content": "Haha, işte... En kötüsüne hazırlıklı olmak her zaman iyidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720106
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720106,
					"content": "Her neyse, buradaki işler bittiğine göre artık bir mola verebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766720107,
					"content": "Doğru, bu yüzden de ilk iş eve gideceğim. Ne de olsa benim ihtiyarı görmeyeli epey oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720108
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720108,
					"content": "Eve mi? Aaa, doğru. Paimon seni burada görmeye o kadar alıştı ki aslında Piramidalı olduğunu neredeyse unutmuştu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766720109,
					"content": "Siz de gelmek ister misiniz? Sakıncası yoksa sizi evimizde ağırlamak isterim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720110
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720110,
					"content": "Paimon'un önerisi üzerine buraya bir yiyecek arabası kurduk ama yine de evde yemek pişirmek daha pratik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720111
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 766720111,
					"content": "Ooo, demek yemek yapacaksın? Çok şanslısın, çünkü Paimon lezzetli bir yemeğe asla hayır demez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7667202,
