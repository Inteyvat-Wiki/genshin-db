					"Bricole"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741700401,
					"content": "Başardın! Demek bu mücadeleyi kazanmak o kadar da zor değilmiş! Teklifi enstitüye gönül rahatlığıyla götürebilirim artık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700402
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700402,
					"content": "Maalesef her yeri tam kontrol edemedim... Daha sonra tekrar gelmem gerekecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700403
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700403,
					"content": "Ama yardımların için sağ ol! İşte ödülün. İyi yolculuklar sana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bricole"
				}
			]
		},
