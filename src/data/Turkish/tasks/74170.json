				{
					"id": 741700210,
					"content": "Mücadeleyi bırak şimdi. Coutrot'ya ne oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741700211
					]
				},
				{
					"id": 741700211,
					"content": "Fontaine Araştırma Enstitüsünden atılmak aklını başına getirmeye yetmedi. Gerçekten de dik kafalının teki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700212
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700212,
					"content": "Yine de rahatlayabilirsin çünkü artık onu destekleyen kimse yok. Bundan sonra başımıza dert açamaz.",
					"roleType": "TALK_ROLE_NPC",
