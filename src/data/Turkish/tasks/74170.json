			},
			"dialogs": [
				{
					"id": 741701701,
					"content": "Aa, dönmüşsün. Ben de döndüm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701702
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701702,
					"content": "Enstitü benim kısa raporumu gördükten sonra, kaynakları toplarken bir yandan da kalite geliştirme talim kampı için bölgenin uyumluluğunu değerlendirmem istendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701703
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701703,
					"content": "*iç çeker* Bunlar bana hiç yabancı gelmiyor aslında. Bir zamanlar Yönetim Görevlimizin herkes dalış eğitimi alsın diye çok ısrarcı olduğu dönemleri hatırlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701704
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701704,
					"content": "Bana sorarsan hepsi boş ama iş başa düşünce yapacak bir şey yok işte. Görev beklemez sonuçta... Burasının ne kadar acayip... Yani muhteşem olduğunu anlatmama gerek yok herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701705
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701705,
					"content": "Bu yüzden bölgeye dayanağın birkaç replikasını yerleştirdim. Merak etme, hepsi sahte ve tamamen güvenli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701706
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701706,
					"content": "Şu anki idmanın hedefi <color=#00E1FFFF>belirlenen süre içinde binanın içerisindeki bütün Dayanakları almak</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701707
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741701707,
					"content": "Sen de denemek ister misin? Katılırsan karşılığını alacaksın, merak etme. Sen de araştırmanın bir parçası olacaksın sonuçta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bricole"
				}
			]
		},
		{
			"id": 7417004,
			"completionStepIds": [
				7417004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
