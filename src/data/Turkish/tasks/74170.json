				{
					"id": 741700217,
					"content": "Mücadeleyi boş ver de şu cihazlar neyin nesi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741700218
					]
				},
				{
					"id": 741700218,
					"content": "Çok karışık görünüyor değil mi? Görünüşe bakılırsa üzerinde birçok... Değişiklik yapmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700219
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700219,
					"content": "Turistlerin ziyaret edebileceği kadim bir harabeye daha uygun sanki artık. Böyle konuşmak pek akıllıca değil gerçi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700220
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700220,
					"content": "*öhöm* Bahsedilen bakış açısı benim kişisel fikrimdir ve Fontaine Araştırma Enstitüsünü veya fikirlerini temsil etmemektedir.",
					"roleType": "TALK_ROLE_NPC",
