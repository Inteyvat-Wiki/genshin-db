			"dialogs": [
				{
					"id": 741700213,
					"content": "Neyse, Kuisel kim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741700214
					]
				},
				{
					"id": 741700214,
					"content": "Ben de bilmiyorum. Fontaine Araştırma Enstitüsünde o isimde birini hatırlamıyorum... Belki de kimsenin adını bilmemesi onun için daha iyidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700215
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700215,
					"content": "Kendisinin de söylediği üzere Kuisel kullandığı bir karakterdi sadece. Karakter gerçek kişiliğinden ne kadar farklı olursa o kadar iyiydi çünkü bu, insanların onu tanıma olasılığını azaltıyordu. En azından benim tahminim bu yönde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700216
					],
					"speakerTitle": "Bricole"
				},
				{
					"id": 741700216,
					"content": "*iç çeker* Bana sorarsan yıllar içinde yeterince değişmiş zaten. İlk bakışta tanıyamadım onu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bricole"
				}
			]
		},
