			"dialogs": [
				{
					"id": 740831001,
					"content": "Harika, bir anahtar daha aldık. Şimdi tek yapmamız gereken sonuncu anahtarı bulmak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831002,
					"content": "Anahtar, anahtar, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831003
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831003,
					"content": "Aa, Pahsiv! Sen nereden çıktın öyle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831004,
					"content": "Kayboldu, Pahsiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831005
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831005,
					"content": "Pekala o zaman... Paimon daha önce hiç böyle eşsiz bir Melusina ile karşılaşmamıştı... Ayrıca Paimon bütün Melusinaların ya Fontaine Şehri'nde ya Merusea Köyü'nde yaşadığını düşünüyordu. Sen neden buradasın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831006,
					"content": "Fontaine Şehri? Merusea Köyü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831007
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831007,
					"content": "Kafan karıştı sanki. O yerleri duymadın mı hiç?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831008,
					"content": "Fontaine Şehri, Melusina... Merusea Köyü, Melusina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831009
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831009,
					"content": "Ha... Erinnyes, Pahsiv, ev.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831010
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831010,
					"content": "Erinnyes, Pahsiv, koru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831011
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831011,
					"content": "Bir dakika, yani senin evin burası mı? Sen de onu koruyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831012,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831013
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831013,
					"content": "Ama Melusinalar Merusea Köyü'nde yaşamıyor muydu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740831014
					]
				},
				{
					"id": 740831014,
					"content": "Evet, biraz garip. Bazı Melusinalar farklı yerlerde mi doğuyor? Paimon burada başka hiç Melusina görmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831015
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831015,
					"content": "Pahsiv, burada yalnız mı yaşıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831016,
					"content": "Yalnız? Melusina. Nevale! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831017
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831017,
					"content": "... Nevale mi? Nevale mi var? Kim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831018,
					"content": "#... Nevale! Paimon, Paimon, {NICKNAME}, {NICKNAME}. Nevale, Nevale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831019
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831019,
					"content": "Peki Nevale kim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740831020
					]
				},
				{
					"id": 740831020,
					"content": "Pahsiv... Nevale'nin isminin aslında \"Nevale\" olduğunu mu söylemeye çalışıyorsun? Paimon'un isminin Paimon olması gibi mi yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831021
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831021,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831022
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831022,
					"content": "Aha! Haklıymışım. Paimon zeki olduğunu söylemişti, öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831023,
						740831024
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831023,
					"content": "Çok garip bir isimmiş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740831025
					]
				},
				{
					"id": 740831025,
					"content": "Nevale, Pahsiv, bilgi, bam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831026
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831026,
					"content": "Hımm... Nevale sana bir şeyler mi öğretiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831027
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831027,
					"content": "Pahsiv! Bir sürü. Dil, bilgi... Bir sürü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831028
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831028,
					"content": "Şey, Paimon \"bir sürü\" olduğunu pek sanmıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831029
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831029,
					"content": "Pahsiv, Nevale, koru, bam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831030
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831030,
					"content": "Yani senin burayı korumana yardım mı ediyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831031
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831031,
					"content": "Melusina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831032
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831032,
					"content": "Sen mi onun burayı korumasına yardım ediyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740831033
					]
				},
				{
					"id": 740831033,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831034
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831034,
					"content": "Demek öyle... Ama kim ki Nevale? Neden burayı korumak için senin yardımına ihtiyacı var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831035
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831035,
					"content": "Burada da çok kötü şeyler yaşanmış. Taş tableti gördük, birileri üzerindeki yazıları kazımış. Ayrıca bir sürü pislik gördük... Etrafta düşmanlar mı var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831036
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831036,
					"content": "Meraklı Paimon, Pahsiv! Ama zaman değil bir sürü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831037
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831037,
					"content": "Anahtar, anahtar, anahtar, meydan, batı, bam, bam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831038
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831038,
					"content": "Elimizden geldiğince hızlı olacağız!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740831039
					]
				},
				{
					"id": 740831039,
					"content": "#Paimon, Pahsiv! {NICKNAME}, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740831040
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831040,
					"content": "Pahsiv mutlulukla iki defa sıçrar ve aceleyle oradan ayrılır.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740831041
					]
				},
				{
					"id": 740831041,
					"content": "Zamanımız çok kısıtlı galiba. İki anahtarı aldık ama zaten, hadi çabuk olalım ve üçüncü anahtarı da alalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740831024,
					"content": "Süper bir isimmiş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740831025
					]
				}
			]
