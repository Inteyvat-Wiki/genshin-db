			"dialogs": [
				{
					"id": 740820701,
					"content": "Sunakta ışıl ışıl parlayan bir su incisi belirir.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740820702
					]
				},
				{
					"id": 740830102,
					"content": "Şey, bu su damlası... Hazine olamaz, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830103,
					"content": "Hazineye benzemiyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830104
					]
				},
				{
					"id": 740830104,
					"content": "Paimon da öyle düşünüyor. Bu kadar kolay olamaz. Ama o zaman bu ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830105,
						740830110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830105,
					"content": "İblis Kral'ı tutan anahtar olabilir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830106
					]
				},
				{
					"id": 740830110,
					"content": "Belki de bunu başka biri koydu buraya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830111
					]
				},
				{
					"id": 740830106,
					"content": "Ne? Öyleyse felaket olur! Çabuk yerine geri koy. Geç kaldıysak yandık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830107,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830108
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830108,
					"content": "Eyvah! İblis Kral geldi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830109,
					"content": "İblis Kral? Melusina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830115
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830111,
					"content": "Ne? Of, o zaman biz hırsız sayılırız. Ayy, Paimon çok özür diliyor... Hadi hemen yerine geri koyalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830112,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830113
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830113,
					"content": "Olamaz! Sahibi geri döndü!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830114,
					"content": "Sahibi? Melusina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830115
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830115,
					"content": "Ayy, Paimon'un ödünü kopardın... Bir Melusina ha? Burada ne işin var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830116,
					"content": "Anahtar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830117
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830117,
					"content": "Anahtar mı? Ne anahtarı? Bu su damlası bir anahtar mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830118,
					"content": "Pahsiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830119
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830119,
					"content": "Şey... Su damlası Pahsiv mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830120,
					"content": "Melusina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830121
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830121,
					"content": "Ay! Ne demek istiyorsun? Su damlası bir Melusina mı? Paimon'un aklı çorbaya döndü. Ne oluyor ya? Buradaki Melusina sen değil misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830122,
					"content": "Pahsiv...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830123
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830123,
					"content": "Şey... Sen bir Pahsiv misin? Yoksa senin adın mı Pahsiv? Bir dakika... Hayır, cevap verme. Paimon'un aklı iyice karışır yoksa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830124,
					"content": "Her neyse, Paimon sana Pahsiv demeye karar verdi. Olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830125,
					"content": "Melusina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830126
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830126,
					"content": "#{NICKNAME}... Ne yapsak? Paimon söylediklerinden hiçbir şey anlamadı. Ne söylemeye çalışıyor ki acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830127,
					"content": "Bizim söylediklerimizi anlayabiliyorsun, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830128
					]
				},
				{
					"id": 740830128,
					"content": "Pahsiv...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830129
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830129,
					"content": "Bu su damlası bir anahtar mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830130
					]
				},
				{
					"id": 740830130,
					"content": "Pahsiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830131
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830131,
					"content": "Sen bir insan değilsin, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830132
					]
				},
				{
					"id": 740830132,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830133
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830133,
					"content": "Şey... Birden yükselmene gerek yok, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830134,
					"content": "Ben bir insan değilim, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830135
					]
				},
				{
					"id": 740830135,
					"content": "M-Melusina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830136
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830136,
					"content": "Aa! Bir dakika! Paimon anlamaya başladı galiba. \"Pahsiv\" evet, \"Melusina\" ise hayır demek. Böyle olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830137,
					"content": "Pahsiv! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830138
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830138,
					"content": "Senin adın Pahsiv değilmiş öyleyse. Kusura bakma, Paimon az önce ismini yanlış anladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830139,
					"content": "Pahsiv... Sevdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830140
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830140,
					"content": "Bu ismi sevdin mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830141
					]
				},
				{
					"id": 740830141,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830142
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830142,
					"content": "#Harika! O zaman Paimon sana Pahsiv diyecek, hehe. Bu {NICKNAME}. Seninle tanıştığımıza memnun olduk Pahsiv. Paimon daha önce hiç senin gibi bir Melusina ile karşılaşmamıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830143,
					"content": "#Paimon, Pahsiv! {NICKNAME}, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830144
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830144,
					"content": "Erinnyes... Melusina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830145
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830145,
					"content": "Erinnyes nereden çıktı şimdi? Hımm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830146,
					"content": "Erinnyes ile ilgili bir sorun mu var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830147
					]
				},
				{
					"id": 740830147,
					"content": "Erinnyes, Melusina, şimdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830148
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830148,
					"content": "Pahsiv, Erinnyes, koru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830149
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830149,
					"content": "Erinnyes'in başına kötü bir şeyler geliyor ve sen de onu korumak mı istiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830150
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830150,
					"content": "#Paimon, {NICKNAME}, Erinnyes, bam, bam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830151
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830151,
					"content": "#Hımm... Bu sefer beş kelime söyledi. O zaman... {NICKNAME} ve Paimon'un Erinnyes'i yumruklamasını mı istiyorsun? BAM diye?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830152,
					"content": "Melusina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830153
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830153,
					"content": "Yardım etmemizi mi istiyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830154
					]
				},
				{
					"id": 740830154,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830155
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830155,
					"content": "Tamam, bizden yardım istiyor. Orasını anladık en azından. Paimon, Erinnyes'i nasıl yumruklayacağımızı pek anlamadı ama, sonuçta kocaman ada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830156
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830156,
					"content": "Bam, bam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830157,
						740830161
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830157,
					"content": "Ödül olacak mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830158
					]
				},
				{
					"id": 740830161,
					"content": "Ne yapmamız gerek?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830162
					]
				},
				{
					"id": 740830158,
					"content": "Ö... dül?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830159
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830159,
					"content": "#Yapma şimdi {NICKNAME}! Pahsiv zaten zar zor konuşuyor! Kendisine yardımcı olacak başkasını bulamaz, bizim yardım etmemiz lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830160
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830160,
					"content": "Ne yapmamız gerek?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830162
					]
				},
				{
					"id": 740830162,
					"content": "Anahtar, anahtar, anahtar, sayı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830163
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830163,
					"content": "Peki ya sonra? Kaç anahtar var bu arada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830164
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830164,
					"content": "Anahtar! Anahtar! Anahtar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830165
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830165,
					"content": "Üç anahtar mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830166
					]
				},
				{
					"id": 740830166,
					"content": "Pahsiv! Anahtar, sisli yol, güney...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830167
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830167,
					"content": "Anahtar, pınar, kuzey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830168
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830168,
					"content": "Anahtar, söğüt, doğu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830169
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830169,
					"content": "Ha, demek öyle... Hemen not edelim... Toplamda üç anahtar var; biri güneydeki sisli yolda, diğeri kuzeydeki pınarda ve sonuncusu da doğudaki söğütlerde... Paimon doğru anlamış mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830170
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830170,
					"content": "Anahtar, anahtar, anahtar, meydan, batı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830171
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830171,
					"content": "Batıdaki meydanda üç anahtar mı var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830172
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830172,
					"content": "Üç anahtarı da toplayıp meydana mı gidelim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830173
					]
				},
				{
					"id": 740830173,
					"content": "#Paimon, Melusina! {NICKNAME}, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830174
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830174,
					"content": "#Aşk olsun Pahsiv, neden hep {NICKNAME} Paimon'dan daha zekiymiş gibi davranıyorsun? İkimizin de zeka düzeyi aşağı yukarı aynı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830175
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830175,
					"content": "Her neyse, elimizde zaten bir tane anahtar var. Şimdi tek yapmamız gereken diğer ikisini bulmak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830176
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830176,
					"content": "Erinnyes, Melusina... Pahsiv, koru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830177
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830177,
					"content": "Sakin ol. Paimon ne olduğunu bilmiyor ama Erinnyes'i korumana yardımcı olacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830178
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830178,
					"content": "İzin verirsen Paimon ufak bir parantez açmak istiyor Pahsiv. Olur da şöyle parlak, yuvarlak, istenmeyen veya pahalı görünen bir sandık görürsen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830179
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830179,
					"content": "Şey, bize haber verirsen çok seviniriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830180
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820780,
					"content": "Pahsiv anlamaya çalışırken kafasını kaşır, ardından mutlulukla iki defa sıçrar ve aceleyle oradan ayrılır.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740820781
					]
				},
				{
					"id": 740830181,
					"content": "#Aa, koştu gitti hemen. Yapması gereken acil bir işi var herhalde. {NICKNAME}, gidip diğer iki anahtarı arayalım mı şimdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
