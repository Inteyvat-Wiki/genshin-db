					"nextDialogs": [
						740830204
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830204,
					"content": "Kayboldu, Pahsiv!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740830205
					]
				},
				{
					"id": 740830205,
					"content": "#Paimon, Pahsiv! {NICKNAME}, Pahsiv! Anahtar, anahtar, anahtar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830206
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740830206,
					"content": "Meydan, batı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740830207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740830207,
					"content": "Hehe. Bunu mu söylemeye çalışıyordun? Merak etme, şimdi oraya gidiyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
