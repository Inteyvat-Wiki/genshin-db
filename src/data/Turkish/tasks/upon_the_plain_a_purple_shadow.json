			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha",
					"Kujou Kamaji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120370601,
					"content": "#Ah, senmişsin {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370602
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370602,
					"content": "Selam. Önsezi Avı Fermanının yürürlükten kaldırılmasını konuşuyorduk. Madem geldiniz, isterseniz siz de konuşmamızı dinleyebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370603
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370603,
					"content": "Şogunluk adına iyi niyet göstergesi olarak Bay Kaedehara'yı buraya davet ettik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370604
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370604,
					"content": "Gösterdiğiniz çaba sayesinde işler iyi sonuçlandı, şu anda bunun tadını çıkarıyoruz. Ayrıca klanımın önceki hatalarını düzeltme fırsatı da buldum. Bunun için çok müteşekkirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370605
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370605,
					"content": "Yüce Şogun yıllardır artan gerilimi ortadan kaldırmak ya da en azından azaltmak için çok sayıda emir verdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370606
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370606,
					"content": "Üçlü Heyet bu fırsatı kullanarak Kaedehara isminin yine eskisi gibi onurlu bir isim olmasını sağlamayı önerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370607
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370607,
					"content": "Kaedehara Klanının tarihine gelince... Tahminimce zaten bir şeyler biliyorsundur, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370608,
						120370609
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370608,
					"content": "Birkaç şey duymuştum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370610
					]
				},
				{
					"id": 120370610,
					"content": "Kısaca anlatmak gerekirse bir zamanlar doğrudan Şogun'a hizmet eden seçkin kılıç zanaatkarları varmış. Bunlar Yüce Şogun'un geleneksel kılıç dövme zanaatını koruyup geliştirmekten sorumluymuş. Kaedehara Klanı da bu zanaatkarlardanmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370611
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370611,
					"content": "Bir süre sonra bu kılıç zanaatkarlarından bazıları isyan ederek Snezhnaya'ya kaçmış. Hem Kaedehara hem de Kamisato Klanları ilgisizlik ve dikkatsizlikle suçlanarak büyük bir karışıklığa sürüklenmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370612
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370612,
					"content": "Daha sonra tüm bu talihsizliklerin Fatui tarafından gizlice düzenlendiğini öğrendik. Yani tüm suçun Kamisato ve Kaedehara Klanlarına atılması ne doğru ne de adildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370613
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370613,
					"content": "Yüce Şogun, Bay Kaedehara'nın bir kez daha Inazuma'ya oldukça büyük bir katkıda bulunduğunu göz önünde bulundurarak onu başardığı şeyler için ödüllendirmenin yanı sıra geçmişte klanının maruz kaldığı büyük cezaların telafisini de alması gerektiğini düşünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370614
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370614,
					"content": "Fatui'nin kılıç zanaatkarlarına daha fazla sorun çıkarmaması için bu konudaki araştırmalarımızı halka açıklamamaya karar verdik. Eminim siz de bunun niye böyle olması gerektiğini anlıyorsunuzdur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370615
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370615,
					"content": "Gerçekten onur duydum. Yüce Şogun'un ve genel olarak Şogunluğun bana bir jest yapmasına sevindim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370616
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370616,
					"content": "Yine de bu büyük jestin karşılığında bazı beklentiler olacağını tahmin ediyorum. Haksız mıyım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370617
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370617,
					"content": "Öyle bir durum kesinlikle söz konusu değil. Sadece geçmişteki bir adaletsizliği düzeltmeye çalışıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370618
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370618,
					"content": "Kaedehara Klanının itibarı ve icra ettiği zanaat eski şanlı haline gelince Kaedehara ailesi bir kez daha kılıç zanaatkarları olacak ve sonunda hayatın düzene girecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370619
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370619,
					"content": "Yüce Şogun'un izni ve Şogunluğun tam desteğiyle Inazuma Şehri'nde güven ve bolluk içinde yaşayabileceksin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370620
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370620,
					"content": "Doğada yaşamaya alıştım. Bundan sonra ihtişamlı bir evin yüksek duvarları arasında rahatça yaşayabileceğimden şüpheliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370621
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370621,
					"content": "Yine de atalarımın Kaedehara adından ve bu adın temsil ettiği kılıç zanaatkarlığından büyük bir onur duyduğu doğru. Onların onurlarını eski haline getirmekle sorumluyum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370622
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370622,
					"content": "Biraz tereddüt ediyor gibisin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370623
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370623,
					"content": "Bu teklifi kabul edersen bence halkın dilindeki kötü dedikoduların çoğu unutulacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370624
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370624,
					"content": "Kötü dedikodular mı? Buraya gelirken hakkında o kadar fazla övgü duyduk ki buralarda başka bir Kaedehara Kazuha olduğundan şüphelenmeye başladık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370625,
					"content": "Bazılarına göre Musou no Hitotachi asla alt edilemeyen bir saldırı. Bay Kaedehara'nın, Şogun'un saldırısını gerçekten savurduğuna inanamıyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370626
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370626,
					"content": "Ayrıca insanlar onun Rüzgar gücü dışında Elektrik gücü kullandığını da görmüş. Bunun sonucunda da \"Kaedehara Kazuha kesin Sanrı kullanıyordu.\" diye yalan bir haber yayılmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370627
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370627,
					"content": "Ne? Bu hiç mantıklı değil. Sanrı kullanmak insanı yaşlandırır ve zayıflatır. Kazuha hâlâ iyi görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370628
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370628,
					"content": "Doğru ama bazılarına göre bir kişinin aynı anda iki elementi kontrol etmesi hâlâ akılalmaz bir durum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370629
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370629,
					"content": "Bu, benzer dedikodulardan sadece biri. İster şüpheye ister şöhrete sebep olsun, insanların benim hakkında konuşmasından rahatsız oluyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370630
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370630,
					"content": "Gerçi Şogunluk beni açıkça desteklemek istiyorsa belki bu durumdan daha çabuk kurtulurum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370631
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370631,
					"content": "İşte tam olarak bu yüzden teklifimizi biraz daha düşünmeni öneririm. Hepimizin yararına olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370632
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370632,
					"content": "Hımm. Bu konuyu düşünmem için biraz süre rica ediyorum sizden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370633
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370633,
					"content": "Hatta şimdilik bu konuyu biraz bekletelim. Peki o zaman, siz ikinizi buraya hangi rüzgar attı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370634
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370634,
					"content": "Eyvah! Neredeyse en önemli konuyu unutuyorduk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370635
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370635,
					"content": "Sen ve Paimon, Kazuha'ya şehrin dışında uğradığınız saldırıyı anlatıyorsunuz.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						120370636
					]
				},
				{
					"id": 120370636,
					"content": "Öyle tehlikeli biri beni niye arasın ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370637,
						120370638
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370637,
					"content": "Kardeşin var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370639
					]
				},
				{
					"id": 120370639,
					"content": "Hayır. Benim kafam da sizinki kadar karıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370640
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370640,
					"content": "Esasen kılıçları denemek için geliştirilen teknikleri temel alan dövüş stillerimi bana ailem öğretti. Her kılıcın kalitesinin düzgünce kontrol edilebilmesi için kılıcın yapacağı her hareketi sürekli kullanacağımız yoğun bir eğitim aldık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370641
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370641,
					"content": "Zamanla bu teknikler bir tür Kaedehara kılıç sanatına dönüşmüş. Bu sanat, kılıçların denenmesine odaklansa da çok sayıda savaş duruşu da içeriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370642
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370642,
					"content": "Bu dövüş duruşları, samurayların savaşırken genelde kullandıklarından epey farklıdır. Yani bahsettiğin benzerliğin tesadüften ibaret olduğunu sanmıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370643
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370643,
					"content": "İşte bu yüzden daha da dikkatli olman lazım! Gördüğümüz adam cidden deliydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370644
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370644,
					"content": "Doğru. Anladığım kadarıyla çok sinirliymiş. Hedefinde kim varsa başına ciddi bir sakatlık veya daha da beteri gelebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370645
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370645,
					"content": "Madem öyle, hemen onu bulmak için birkaç adamımı göndereceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370646
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370646,
					"content": "Teşekkür ederim. Açıkçası şimdi bu işin aslını çok merak ettim. Teklifini düşünmek için de biraz zamana ihtiyacım var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370647
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370647,
					"content": "Önce Gezgin ile birlikte gidip ona saldıranın kim olduğunu araştıracağım. Döndüğümde son kararımı söylerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370648
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370648,
					"content": "Peki. Lütfen dikkatli olun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370649
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120370649,
					"content": "Hadi gidip sana saldıranı bulalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 120370638,
					"content": "Aynı ustadan birlikte eğitim aldığın biri olabilir mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370639
					]
				},
				{
					"id": 120370609,
					"content": "Hatırlamıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370610
					]
				}
			]
		},
