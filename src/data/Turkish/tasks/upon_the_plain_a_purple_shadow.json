			"dialogs": [
				{
					"id": 120370201,
					"content": "Inazuma'ya ilk gelişimizin üzerinden epey zaman geçti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370202,
					"content": "O zamandan beri çok şey oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370203,
						120370204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370203,
					"content": "Sanki göz açıp kapayıncaya kadar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370205
					]
				},
				{
					"id": 120370205,
					"content": "Evet. Kesinlikle yolculuğumuzda ilerleme katettik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370206,
					"content": "Peki bugün nereye gidelim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370207,
					"content": "Bir dakika.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370208
					]
				},
				{
					"id": 120370208,
					"content": "Hı? Ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370209,
						120370210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370209,
					"content": "Dikkatli ol.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 120370210,
					"content": "Biri geliyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 120370204,
					"content": "Birçok unutulmaz olay yaşadık.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370205
					]
				}
			]
		},
		{
			"id": 1203704,
			"completionStepIds": [
				1203704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
