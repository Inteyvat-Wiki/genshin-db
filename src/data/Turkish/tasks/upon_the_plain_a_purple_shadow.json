			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kagotsurube Isshin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120370401,
					"content": "Ne? Önsezin yokmuş demek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370402
					],
					"speakerTitle": "Kagotsurube Isshin"
				},
				{
					"id": 120370402,
					"content": "Sanırım seni başkasıyla karıştırdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370403
					],
					"speakerTitle": "Kagotsurube Isshin"
				},
				{
					"id": 120370403,
					"content": "Saldırmadan önce en azından doğru kişi olup olmadığına bir bak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370404,
					"content": "Hayır, dur... Doğru kişi olsa bile öyle bir anda saldırmaman lazım! Tehlikeli bir şey bu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370405,
					"content": "Hiç Kaedehara Kazuha adında biriyle karşılaştınız mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370406
					],
					"speakerTitle": "Kagotsurube Isshin"
				},
				{
					"id": 120370406,
					"content": "Seninki gibi bir kılıcı var. Ayrıca duyduğum kadarıyla Rüzgar Önsezisine sahipmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370407
					],
					"speakerTitle": "Kagotsurube Isshin"
				},
				{
					"id": 120370407,
					"content": "Onu neden arıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370408
					]
				},
				{
					"id": 120370408,
					"content": "Bu seni hiç ilgilendirmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370409
					],
					"speakerTitle": "Kagotsurube Isshin"
				},
				{
					"id": 120370409,
					"content": "Her neyse. Zaten bir şey bilmiyorsun anlaşılan. Boşa zaman harcıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370410
					],
					"speakerTitle": "Kagotsurube Isshin"
				},
				{
					"id": 120370410,
					"content": "Derdi ne bunun? Gelip o tuhaf kılıcını üzerimize savurdu. Üstelik özür bile dilemedi! Deli midir nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370411,
					"content": "Neyse. Ona Kazuha ile ilgili hiçbir şey anlatmayacağız, orası kesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370412,
						120370414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370412,
					"content": "Haklısın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370413
					]
				},
				{
					"id": 120370413,
					"content": "Değil mi? Yine de Paimon bu adamın Kazuha ile düello yapmayı başarsa bile onu yenemeyeceğini düşünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370416,
					"content": "Neyse. Yine de emin olmak için hemen Kazuha'yı bulup dikkatli olmasını söylememiz lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370417,
					"content": "Aslında içimde bir his var...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370418
					]
				},
				{
					"id": 120370418,
					"content": "Öyle mi? Nasıl bir his?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370419,
					"content": "Bence Kazuha'yla bu adamın arasında özel bir bağ olabilir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370420
					]
				},
				{
					"id": 120370420,
					"content": "Özel bir bağ mı? Yani birbirlerini tanıyor olmalarından öte bir şey mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370421,
						120370422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370421,
					"content": "Tam olarak emin değilim ama...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370423
					]
				},
				{
					"id": 120370423,
					"content": "Hımm, evet. Biraz benziyor olabilir... Yine de dövüşmeye başladıklarında çoğu insan birbirine benzer. Yani buradan kesin bir sonuç çıkaramayız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370424,
					"content": "Neyse. Kaybedecek vaktimiz yok. Hadi gidip Kazuha'ya haber verelim ki başı belaya girmesin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370425,
					"content": "Paimon, Güneyhaçı Filosunun şu anda Ritou'da erzak takviyesi yaptığını duymuştu. Kazuha'yı orada arayalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370422,
					"content": "... Sanki dövüş stilleri benziyor gibi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370423
					]
				},
				{
					"id": 120370414,
					"content": "Kırk yılda bir de olsa mantıklı konuştun!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370415
					]
				},
				{
					"id": 120370415,
					"content": "Çok ayıp. Paimon çoğu zaman mantıklı konuşuyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370416
					],
					"speakerTitle": "Paimon"
				}
			]
		},
