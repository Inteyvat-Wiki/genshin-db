			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120370501,
					"content": "Selam! Kazuha nerede biliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370502,
					"content": "Sen de mi Kazuha'yı arıyorsun? Demek ki bu sefer etkileyici bir şey yapmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370503
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370503,
					"content": "Başkaları da mı arıyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370504
					]
				},
				{
					"id": 120370504,
					"content": "Hahaha, peki. Küçük tekneleri sıradan bir erzak alışverişi için Ritou'ya getirdik ama bu sefer biz limana girer girmez Inazumalı büyük bir kalabalıkla karşılaştık. Hepsi Kazuha'yı sordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370505
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370505,
					"content": "Bunun nedeni Nazuchi Sahili'ndeki savaşsa Kaptan Beidou'nun orada yaptıkları da çok etkileyiciydi ama o bile bu kadar ilgi görmüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370506
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370506,
					"content": "Kazuha çoğu zaman içine kapanıktır. Hatta bazen kaptanı bile dinlemez ama kaptan sadece gülüp geçer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370507
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370507,
					"content": "Öyle mi? Yani ne yaptığını bilmiyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370508,
					"content": "Bir şeyler duymuştum. Şogun Raiden'ın \"Musou no Hitotachi\" saldırısını engellemeyi başarmış sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370509
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370509,
					"content": "İnsanların abarttığı kadar önemli bir şey mi bu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370510
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370510,
					"content": "Beidou'nun Haishan'ı yenmek için kullandığı teknikle kıyaslanabilir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370511
					]
				},
				{
					"id": 120370511,
					"content": "Gerçekten mi? Vay canına! O zaman gerçekten de önemli demektir. Hahaha. Madem öyle, yeni şöhretini sonuna kadar hak etmiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370512
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370512,
					"content": "Yakın zamanda Tenryou Heyetinden birkaç kişi onu çağırdı. Onunla konuşacakları önemli bir şey varmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370513
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370513,
					"content": "Başta onu tutuklamaya geldiler sandım ama ona çok iyi davrandılar. Ona çok saygı duyuyorlar galiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370514
					],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370514,
					"content": "Yakın zamana kadar bunun olacağını hayal bile edemezdim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370515,
						120370516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370515,
					"content": "Muhtemelen Şogunluk niyetinin iyi olduğunu göstermeye çalışıyordur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370517
					]
				},
				{
					"id": 120370517,
					"content": "Teşekkür ederiz! Tenryou Heyetine bir uğrayacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120370518,
					"content": "Tamam o zaman. Ben burada kalıp kalabalığı dağıtmaya çalışacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chao"
				},
				{
					"id": 120370516,
					"content": "Sonuçta Şogun Raiden'ın bakış açısı da değişti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370517
					]
				}
			]
		},
		{
			"id": 1203706,
