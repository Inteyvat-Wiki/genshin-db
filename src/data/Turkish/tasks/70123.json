			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Joel"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701230501,
					"content": "Nasıl geçti? Babacığımdan haber var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230502,
						701230511
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230502,
					"content": "Mağaradaki zirvede bunu bulduk...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230503
					]
				},
				{
					"id": 701230503,
					"content": "Babacığım... Olamaz. Babacığım harika bir maceracı! Böyle ufak bir zorluğu kolayca atlatır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230504
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230504,
					"content": "Notlarında dağdan aşağı bir yol bulduğunu söylemişti değil mi? Güvenli bir şekilde aşağı varmıştır. Öyle olmuştur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230505
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230505,
					"content": "Sanırım güvenli bir şekilde aşağı indi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230506
					]
				},
				{
					"id": 701230506,
					"content": "Aynen öyle. Öyle olmuştur! Hatta şu anda dinleniyordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230507
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230507,
					"content": "Ya da... Zirvede yeni bir kamp yeri kurmuştur ve orada mola veriyordur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230508
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230508,
					"content": "Durum ne olursa olsun, eminim ki dinlendiğinde Babacığım gelip beni bulur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230509
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230509,
					"content": "Burada onu beklemeye devam edeceğim. Bu arada yardım ettiğin için sağ ol. Al bakalım, bunlar senin için.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230511,
					"content": "Hiçbir şey bulamadım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230512
					]
				},
				{
					"id": 701230512,
					"content": "Ge-Gerçekten mi? Ama Favonius Şövalyesi Babacığımın dağa gittiğini söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230513
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230513,
					"content": "Belki de yanlış biliyordu... Ya da belki Babacığım başka yerde kamp kurmuştu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230514
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230514,
					"content": "Sanırım burada onu bekleyeceğim... Eminim Babacığım eve gelip beni bulamazsa çok endişelenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230515
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230515,
					"content": "Yardım ettiğin için sağ ol. Lütfen bunları kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230516
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230516,
					"content": "Neredesin baba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Joel"
				}
			]
		},
