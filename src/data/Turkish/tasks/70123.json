			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 701230201,
					"content": "Şimdilik her şey gayet iyi gidiyor. Hava durumu iyi, bolca malzeme var ve canavarların da keyfi yerinde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230202
					],
					"speakerTitle": "Özenle Yazılmış Not"
				},
				{
					"id": 701230202,
					"content": "Ayrıca sırt çantamda \"Yaban Domuzu Prenses\"in 6. Bölümünün olduğunu keşfettim. Herhalde Joel koymuştur. Şu arsız çocuk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230203
					],
					"speakerTitle": "Özenle Yazılmış Not"
				},
				{
					"id": 701230203,
					"content": "Aslında bu kitap cesur bir Yaban Domuzu Prensesin, dostlarıyla karlı bir dağa yolculuğunu anlatıyor... Ben de karlı bir dağa çıkıyorum ve şimdiye kadar olup bitenleri düşününce... Kim bilir? Belki bu kitap bana iyi şans getirmiştir. Teşekkür ederim Joel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230204
					],
					"speakerTitle": "Özenle Yazılmış Not"
				},
				{
					"id": 701230204,
					"content": "Her neyse, malzeme tedariki yapıp ilerlememi kaydetmek için sonraki kamp alanına gitmem gerek. Sonrasında dağdan aşağı ineceğim, Joel beni bekliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Özenle Yazılmış Not"
				}
			]
		},
		{
			"id": 7012303,
			"completionStepIds": [
				7012303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7012302",
							"3"
						],
						"stepId": 7012302,
