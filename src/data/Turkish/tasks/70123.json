					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 701230301,
					"content": "Buraya gelirken beklenmedik bir şey olmadı. Hava durumu hâlâ iyi. Görünüşe göre şansım nihayet döndü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230302
					],
					"speakerTitle": "Özenle Yazılmış Not"
				},
				{
					"id": 701230302,
					"content": "Belki de sonunda zirveye doğru harekete geçebilirim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230303
					],
					"speakerTitle": "Özenle Yazılmış Not"
				},
				{
					"id": 701230303,
					"content": "Bir deneyelim bakalım. Sorun çıkarsa hemen geri dönerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Özenle Yazılmış Not"
				}
			]
		},
		{
			"id": 7012304,
			"completionStepIds": [
				7012304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7012303",
							"3"
						],
						"stepId": 7012303,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 701230401,
					"content": "Zirvedeki kar fırtınası çok çabuk geldi. Kendimi mağaraya zar zor attım. Erzakımın yarısını da kargaşada kaybettim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230402
					],
					"speakerTitle": "Karalanmış Not"
				},
				{
					"id": 701230402,
					"content": "Neden bilmiyorum ama mağaranın tepesindeki taşlar aniden çöktü ve düşen çakıllar da mağara girişini mühürledi. Bu kötü oldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230403
					],
					"speakerTitle": "Karalanmış Not"
				},
				{
					"id": 701230403,
					"content": "Ama... Sanırım başka bir çıkış daha var. Bu mağaranın diğer tarafı uçurum ama aşağıda derin kardan başka bir şey yok. Belirli bir mesafeye kadar aşağı inebilirsem kalan kısımdan atlayabilirim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230404
					],
					"speakerTitle": "Karalanmış Not"
				},
				{
					"id": 701230404,
					"content": "Erzakım birkaç günden fazla dayanmayacak. Yakında harekete geçmem gerek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230405
					],
					"speakerTitle": "Karalanmış Not"
				},
				{
					"id": 701230405,
					"content": "Joel'e kar yağışını beraber izleyeceğimize dair söz vermiştim, bu sözden dönemem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230406
					],
					"speakerTitle": "Karalanmış Not"
				},
				{
					"id": 701230406,
					"content": "Ah, evet. Bu notu gören olursa lütfen tilkiler için mama kabına biraz yiyecek koysun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230407
					],
					"speakerTitle": "Karalanmış Not"
				},
				{
					"id": 701230407,
					"content": "Burada mahsur kaldığım süre boyunca bana arkadaşlık ettiler. Fırsatım olursa Joel'i de onları görmeye getirmeyi çok isterim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Karalanmış Not"
				}
			]
		},
		{
			"id": 7012305,
			"completionStepIds": [
				7012305
			],
