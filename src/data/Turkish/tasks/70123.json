			},
			"dialogs": [
				{
					"id": 701230101,
					"content": "Babacığım nereye gitti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230102
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230102,
					"content": "Sorun nedir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230103
					]
				},
				{
					"id": 701230103,
					"content": "Ha... Ben... Merhaba... Babacığımı bulamıyorum da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230104
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230104,
					"content": "Gelip beni alacağını, sonra da beraber kar görmeye gideceğimizi söylemişti. Buluşma saatimiz gelip geçti ama o hâlâ gelmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230105
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230105,
					"content": "Kesin nadir ve değerli bir hazine haritası falan bulmuştur, ondan yanıma gelememiştir. Böyle olmuştur, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230106
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230106,
					"content": "Ben de kalkıp Ejdersırtı'na geldim. O bana gelemiyorsa ben ona giderim. Öyle düşündüm yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230107
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230107,
					"content": "Ama Babacığım orada da değildi. Şuradaki Favonius Şövalyesi babamın dağın zirvesine gittiğini söyledi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230108
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230108,
					"content": "Gidip aramak istedim ama Şövalye bana izin vermedi. Ben de burada babamın dönmesini bekliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230109
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230109,
					"content": "Ama... Ama o geri dönmedi ve ben de endişeleniyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230110
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230110,
					"content": "Ejdersırtı'na gidiyorsan babamı bulmama yardım eder misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230111,
						701230112
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230111,
					"content": "Oldu bil evlat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230113
					]
				},
				{
					"id": 701230113,
					"content": "Yapacak mısın? Harika!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230114
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230114,
					"content": "Düşüneyim... Şövalye, Babacığımın ilk olarak <color=#00E1FFFF>yukarı giden Karlı Yolu</color> izleyeceğini söylemişti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230115
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230115,
					"content": "Sonrasında da <color=#00E1FFFF>dağ zirvesine</color> çıkmayı denemeden önce <color=#00E1FFFF>Gömülü Şehrin Banliyölerine</color> gidip biraz gezeceğini söylemişti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230116
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230116,
					"content": "Lütfen bu alanları aramama yardım et. Babacığım hâlâ oralara yakın bir yerde olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230117
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230117,
					"content": "Gidip birlikte kar yağışını izleyeceğimize söz vermişti. Sözünü tutmaması mümkün değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Joel"
				},
				{
					"id": 701230112,
					"content": "Nereye bakmalıyım?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230113
					]
				}
			]
		},
		{
			"id": 7012302,
			"completionStepIds": [
				7012302
