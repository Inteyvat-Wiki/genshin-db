				"points": []
			},
			"dialogs": [
				{
					"id": 20170201,
					"content": "Ah! Şu oyuncak tanuki insana dönüştü!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170202,
					"content": "Neler oluyor? Paimon daha önce bunlardan hiç görmemişti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170203,
					"content": "Tanuki değil... Ben bir Mujina'yım... *horlar*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170204
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170204,
					"content": "Çok yorgunum... Yeterince uyumazsam büyüyemem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170205
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170205,
					"content": "Hım, bahsettiğin \"uzman\" bu muydu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170206,
					"content": "Heh... Bana hiç profesyonel gibi gelmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170207,
					"content": "Hehe... O, Shuumatsuban'ın bir üyesi ve hakiki bir ninjadır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170208
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170208,
					"content": "Vay be, bir ninja! Peki bu, efsanevi ninja dönüşüm tekniklerinden biri miydi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170209,
					"content": "Neyse, Shuumatsuban nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170210,
					"content": "Yashiro Heyetine ait olan ve Kamisato Ayato yönetimindeki gizli bir birim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170211
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170211,
					"content": "Artık Kamisato Ayato ve Yashiro Heyeti tarafsız olduklarından, Shuumatsuban'a emir verme hakkım yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170212
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170212,
					"content": "Bununla birlikte, en tembel üyesini bize yardım etmeye ikna etmek de yeteneklerime dahil bir durumdur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170213
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170213,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170214
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170214,
					"content": "Senden şunu yapmanı istiyorum, kasabaya git ve Tenryou Heyetinin ihanetine dair bir kanıt bul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170215
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170215,
					"content": "Benim orada görülmem uygun olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170216
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170216,
					"content": "Çok basitmiş gibi söylüyorsun ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170217,
						20170218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170217,
					"content": "Ne aradığıma dair hiçbir fikrim yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170219
					]
				},
				{
					"id": 20170219,
					"content": "Öyle mi? Ah, şimdiye kadar anlarsın diye düşünmüştüm. Tamam o zaman, sana biraz daha bilgi vereceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170220
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170220,
					"content": "Tamamen yabancı olan biri için Tenryou Heyetinin iç işleyişini anlamak neredeyse imkansız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170221
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170221,
					"content": "Ama üç heyet Şogun'a hizmet etmek üzere birlikte çalıştığı için, onların yakın ilişkileri var. Diğer heyetlerden birinde yer alan biri, neyin peşinde olduklarını daha kolay bulabilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170222
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170222,
					"content": "Yashiro Heyeti!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170223
					]
				},
				{
					"id": 20170223,
					"content": "Hehe... Şimdi beni anlıyorsun işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170224
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170224,
					"content": "Şogun'un Ordusu seni aramaktan henüz vazgeçmedi ama bu Shuumatsuban ninjasının yardımıyla, arkadaşlarınla buluşabileceğinden eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170225
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170225,
					"content": "Unutma, zamanımız az. Kanıtı vaktinde getirdiğinden emin ol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20170218,
					"content": "Kanıt tam olarak ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170219
					]
				}
			]
		},
		{
