			"trigger": {
				"objectNames": [
					"Thoma"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20170403,
					"content": "#{NICKNAME}, seni buraya hangi rüzgar attı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170404
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170404,
					"content": "Direnişle buluştun mu? Savaş nasıl gidiyor? Dışarı çıkmam için etraf güvenli mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170405
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170405,
					"content": "Henüz değil... Buraya gelirken yolda devriyeler gördük.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170406,
					"content": "Yani hâlâ sona ermemiş... Buraya konuşmak istediğin bir şey olduğu için geldin sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170407
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170407,
					"content": "Birini bulup Bayan Kamisato'yu arattıracağım, bir saniye lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170408
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170408,
					"content": "Ayaka'yı ve Thoma'yı mevcut durumdan haberdar ediyorsun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170409,
					"content": "Anladım. Son görüşmemizden bu yana çok şey yaşamışsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170410
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170410,
					"content": "Tenryou Heyetinin ihanetine ilişkin kanıta ihtiyacın olduğunu anlıyorum. Bir düşüneyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170411
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170411,
					"content": "Sen söyleyince aklıma geldi de, beni hep endişelendiren bir şey var. Şogun'un Ordusu uzun süredir direnişle savaş halinde ama Şogun bunu bir kez olsun soruşturmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170412
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170412,
					"content": "Eskiden Şogun'un bunu sadece umursamadığını sanırdım ama şimdi düşünüyorum da sorun belki de en başından beri <color=#00E1FFFF>Tenryou Heyetinin Şogun'a verdiği raporlardadır</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170413
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170413,
					"content": "Ne demek istiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170414,
					"content": "Tenryou Heyeti yerel askeri işlere başkanlık eder. Raporlarında herhangi bir bilgiyi gizlemek isteselerdi, bunu hiçbir şekilde bilemezdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170415
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170415,
					"content": "Bu arada Şogun, Önsezi Avı Fermanının bir tehdit oluşturmadığı konusunda yanlış bir sonuca vardı ve kararına bağlı kaldı. Eğer onun raporlarına erişebilseydik, bu her şeyi doğrulardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170416
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170416,
					"content": "Ama hatırladığım kadarıyla, bu tür resmi belgelere erişimi olan tek kişi Kujou Takayuki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170417
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170417,
					"content": "Ayrıca çok sıkı korunuyor. Sayu'nun yardımıyla dahi, bir belgeyi gözlerinin önünden almak kolay bir iş değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170418
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170418,
					"content": "Muhafızların dikkatini yeterince uzun süre dağıtmamızın keşke bir yolu olsaydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170419
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170419,
					"content": "Hım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170420,
						20170421
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170420,
					"content": "Dikkat dağıtıcı bir şey, demek...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170422
					]
				},
				{
					"id": 20170422,
					"content": "Yoimiya'nın havai fişekleri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170423
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170423,
					"content": "Bu tam da Thoma'nın yapacağı bir öneri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170424
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170424,
					"content": "Ama mantıklı. Alemüstü Tanrı'nın Heykeli hemen Tenryou Heyetinin yanında. Biri heykelin yakınlarında havai fişek atarsa, bunu kesinlikle görmezden gelemezler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170425
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170425,
					"content": "Onlar bununla meşgulken Sayu, Tenryou Heyetine sızıp raporu ve başka kanıt bulursa onları alabilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170426
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170426,
					"content": "Harika! Yeniden özgür biri olmaya adım adım yaklaştığımı hissediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170427
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170427,
					"content": "Ah... En son böyle oturup konuşmamızın üzerinden çok uzun zaman geçmiş gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170428
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170428,
					"content": "O kadar da uzun zaman olmadı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170429
					]
				},
				{
					"id": 20170429,
					"content": "Bana öyle geldiği kesin... Buraya geldiğimden beri, tekrar seni görmek için sabırsızlanıyordum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170430
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170430,
					"content": "Bu çayevi eskiden en sevdiğim saklanma yeriydi, şimdiyse... Gerçi en son ne zaman dışarı çıktığımı hatırlamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170431
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170431,
					"content": "Of ya! Kaplıcalara gitmeyi çok istiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170432
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170432,
					"content": "Zavallı Thoma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170433,
					"content": "Elimizdeki soruna odaklanalım. Önsezi Avı Fermanı ne kadar çabuk yürürlükten kalkarsa, Thoma da o kadar çabuk özgürlüğüne kavuşur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170434
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170434,
					"content": "Bu bir nevi bir araya gelmeydi ama hasret gidermeye vakit yok. Her şey sona erdiğinde düzgün bir kutlama yaparız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170435
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170435,
					"content": "Ah, yine güveç oyununu oynayalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170436
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170436,
					"content": "Sen hâlâ onu mu düşünüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170437,
					"content": "Tenryou Heyeti çok sıkı korunuyor. Yaklaştığında dikkatli ol. Sonrasında burada buluşalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170438
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170438,
					"content": "#Tamamdır {NICKNAME}. Önce <color=#00E1FFFF>Yoimiya'yı</color> bulmak için <color=#00E1FFFF>Hanamizaka'ya</color> gidelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170421,
					"content": "Bunu daha önce yapmıştık...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170422
					]
				}
			]
		},
