					"speakerTitle": "Paimon"
				},
				{
					"id": 20171001,
					"content": "\"Çok büyük havai fişek\" mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171002
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 20171002,
