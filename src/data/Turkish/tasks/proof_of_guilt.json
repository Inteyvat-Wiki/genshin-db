			"dialogs": [
				{
					"id": 20170701,
					"content": "Mmm... Neredeyse düşündüğüm gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170702
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170702,
					"content": "Bir sürü insan var... Biri beni görürse yakalanırım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170703
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170703,
					"content": "Onlardan kurtulmamız lazım, yoksa içeri sızamam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170704
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170704,
					"content": "Yoimiya'ya güvenmemiz gerekecek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170705
					]
				},
				{
					"id": 20170705,
					"content": "Ben belgeyi aldıktan sonra <color=#00E1FFFF>Komore Çayevinde</color> buluşalım, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170706
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170706,
					"content": "Ayrıca yakalanırsam... Lütfen gelip beni kurtar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170707
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170707,
					"content": "Bu gerçekten de iyi bir fikir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170708,
					"content": "Of neyse, <color=#00E1FFFF>heykele</color> doğru gidelim! Dikkatli ol, muhafızlara dikkat et ve sakın yakalanma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
