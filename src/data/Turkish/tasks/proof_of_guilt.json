						20171003
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 20171003,
					"content": "Şansına daha birkaç gün önce bu çok güçlü havai fişeği yapmıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171004
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 20171004,
					"content": "Ama o kadar güçlü ki, henüz bunu deneyebileceğim bir yer bulamadım... Bari size vereyim. Nasıl olduğunu bana anlatırsınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171005
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 20171005,
					"content": "Unutmayın, fitili ateşledikten sonra çok uzağa gidin ve kıyafetlerinizi yakmamaya çalışın. Ayrıca kulaklarınızı kapatmanız da sizin için iyi olur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171006
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 20171006,
					"content": "Eh, Paimon nedense birdenbire gergin hissetmeye başladı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20171007,
					"content": "Hahaha, endişelenme, sadece bir havai fişek, hadi ama. En kötü ne olabilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20171008
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 20171008,
					"content": "Bir deneyelim... Sağ ol Yoimiya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
