			"dialogs": [
				{
					"id": 20170901,
					"content": "#Eee, {NICKNAME}? Nasıl gitti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170902,
						20170903
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170902,
					"content": "Emin değilim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170904
					]
				},
				{
					"id": 20170904,
					"content": "Güzel. Sayu'dan haber bekleyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170905
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170905,
					"content": "Bir süre sonra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170906,
					"content": "*nefes nefese kalır*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170907
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170907,
					"content": "Spor yapmanın büyümeye yardımcı olduğunu biliyorum ama bu biraz fazlaydı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170908
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170908,
					"content": "Çok başım dönüyor... Herkes dönüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170909
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170909,
					"content": "Hayır, şimdi uyuyamam. Yapmam gereken önemli bir şey vardı... Ah, evet, doğru. Hatırladım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170910
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170910,
					"content": "Bahsettiğiniz belgeyi nasıl bulacağımı bilmiyordum, bu yüzden şüpheli görünen bir ton şeyi arakladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170911
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170911,
					"content": "Buyurun... Artık uyuyabilirim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170912
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170912,
					"content": "Leydim, bunlar da nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170913
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170913,
					"content": "Bu mühürlü zarf, Tenryou Heyetinin Şogun'a sunmak için hazırladığı resmi bir rapor olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170914
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170914,
					"content": "Ayrıca elimizde... Fatui ile bir yazışma var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170915
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170915,
					"content": "Sanırım Guuji Yae haklıymış. Gizli kapaklı sorun çıkarıyorlarmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170916
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170916,
					"content": "#{NICKNAME}, bu kanıtlar yeterlidir herhalde. Lütfen bunları <color=#00E1FFFF>Guuji Yae'ye</color> götür. Sonraki adıma dair bir planı olduğuna inanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170917
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170917,
					"content": "Ben de Inazuma'da Fatui'nin kökünü kurutmak için birilerini toplayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170918
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170918,
					"content": "Yine de Şogun'la karşılaştığında kendine dikkat et. Onun kılıcını çektiği her aklıma geldiğinde, hâlâ tüylerim diken diken oluyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170919
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20170919,
					"content": "Tekrar söylüyorum, Guuji Yae'ye güvenmemiz gerekecek. O, Şogun'a yakın biri ve bu yüzden belki bir yolunu bulur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170920
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20170920,
					"content": "Paimon doğru hatırlıyorsa, Yae Miko ile yakın zamanda buluşacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170921
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170921,
					"content": "Eşyalarımızı toplayalım ve <color=#00E1FFFF>Büyük Narukami Tapınağına</color> gitmeye hazırlanalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20170903,
					"content": "Havai fişeği ateşledik ve kaçtık...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20170904
					]
				}
			]
		},
