					"nextDialogs": [
						20170705
					]
				},
				{
					"id": 20170705,
					"content": "Ben belgeyi aldıktan sonra <color=#00E1FFFF>Komore Çayevinde</color> buluşalım, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170706
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170706,
					"content": "Ayrıca yakalanırsam... Lütfen gelip beni kurtar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170707
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 20170707,
					"content": "Bu gerçekten de iyi bir fikir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20170708
					],
					"speakerTitle": "Paimon"
