					"Antei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722370401,
					"content": "Narukami Adası'ndaki elçilerden birinin \"kuş\" adında bir yaratıktan bahsettiğini duymuştum. Kanatları var ve göklerde uçabiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370402
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370402,
					"content": "Gerçekten inanılmaz, hayal edebiliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370403
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370403,
					"content": "Kimileri bu kuşların insanların kaderleriyle ilgili sözleri taşıyan tanrı ulakları olduğuna inanır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370404
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370404,
					"content": "Sürgün edilen birisi vahşi doğada hayatını kaybederse, bu yaratık gelir ve ölen kişinin etini gagalayarak tüketir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370405
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370405,
					"content": "Açıkçası bu hayvanlar beni hayrete düşürüyor. Hayatta kalırsam kesinlikle yanıma bir kuş alacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Antei"
				}
			]
		},
		{
			"id": 7223705,
			"completionStepIds": [
				7223708
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
