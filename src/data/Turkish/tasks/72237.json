					"Antei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722370301,
					"content": "Siz ikiniz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370302
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370302,
					"content": "Sen Antei misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722370303,
					"content": "Evet doğru, Antei'yim. Biraz... tuhaf hissediyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370304
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370304,
					"content": "O alçakları kovaladığımı hatırlıyorum... Çekirdeğin birini söküp kampa fırlattım. Sonrasında yaralarım nedeniyle biraz sersemledim... Fena yaralanmıştım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370305
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370305,
					"content": "Ama sonrasında uyandım ve seninle tanıştım ve şimdi iyi hissediyorum. Yoksa yakında ölecek miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370306
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370306,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722370307
					]
				},
				{
					"id": 722370307,
					"content": "Şu anda bunun bir önemi yok. Yine beni tutuklamaya mı geldiniz? Ben masumiyetimi çoktan kanıtladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370308
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370308,
					"content": "Kitapları Khaenri'ah'dan gelenler çaldı. Ben de korumalarından biriydim ama onlarla iş birliği yapacak değilim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370309
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370309,
					"content": "Diplomasi ekibini buraya kadar takip edip hepsini dövdüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370310
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370310,
					"content": "Ama yanlarındaki devasa mekanik yaratıkla uğraşmam biraz uzun sürdü. Sonunda çekirdeğini parçaladım ama o esnada fena yaralandım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370311
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370311,
					"content": "Etkisiz hale getirdiğim o makina, kayıp kitabın üstüne düştü. Artık geri almanın yolu yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370312
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370312,
					"content": "Byakuyakoku'nun Jibashirileri epey güçlü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722370313,
					"content": "Siz de Jibashiri adayları değil misiniz? *iç çeker* Her neyse. Jibashiriler, Su Ejderlerine karşı savaşan kahramanlar olarak faaliyet göstermeye başlamıştı. Sonrasında emniyet gücü yani silahlı yargıçlar haline geldiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370314
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370314,
					"content": "Makinanın çekirdeği kampta. İnanmıyorsan gidip kendin bakabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Antei"
				}
			]
		},
		{
			"id": 7223704,
