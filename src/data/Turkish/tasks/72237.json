			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Antei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722370501,
					"content": "Kitabı aldınız mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370502
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370502,
					"content": "Aldık. Gerçekten de masummuşsun Antei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722370503,
					"content": "Önceki konuşmamızdan yola çıkacak olursam siz Jibashiri değilsiniz... Bu kötü oldu... Jibashiri olsaydınız masum olduğumu ilan edebilirdiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370504
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370504,
					"content": "Bu da bana zaman kazandırmış olurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370505
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370505,
					"content": "Kendimi yeniden zinde hissediyorum fakat kısa süre öncesine kadar, aşırı kan kaybından dolayı yorgundum. Yakında ölecekmişim hissini üzerimden atamıyorum bir türlü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370506
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370506,
					"content": "Hımm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722370507,
					"content": "*iç çeker* Sana bir soru sorayım yabancı. Byakuyakoku tarafından yanlışlıkla mahkum edilmiş bir adam günah işlemiş sayılır mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370508
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370508,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722370509
					]
				},
				{
					"id": 722370509,
					"content": "Sırf o zamanki bozuk düşünce yapım nedeniyle Tokoyo Ookami tarafından Günahkar Ruh olarak buraya bırakılsaydım bu günah sayılır mıydı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370510
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370510,
					"content": "Ben suçlu muyum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370511
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370511,
					"content": "Hayır değilsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722370512
					]
				},
				{
					"id": 722370512,
					"content": "#Dikkatli ol {NICKNAME}. Biliyorsun, bunu fark ederse... ortadan kaybolur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722370513,
					"content": "Sen yalnızca Antei'nin geride bıraktığı bir yansımasın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722370514
					]
				},
				{
					"id": 722370514,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370515
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370515,
					"content": "Sen masumsun. Tüm dünyanın bunu öğrenmesini sağlayacağım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722370516
					]
				},
				{
					"id": 722370516,
					"content": "Haha. Demek öyle. Ben yalnızca ölümümden geriye kalan bir gölgeyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722370517
					],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370517,
					"content": "Ve... Masumum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Antei"
				},
				{
					"id": 722370518,
					"content": "Antei'nin yansıması bozuk cümleleri tekrarlamaya başlıyor.\\n\"Hangi ilahi kanuna karşı geldim? Talihsizler neden tanrıdan beklenti içinde?\\nYaptığım en iyi niyetli işler bile adımı günahkara çıkardı, yaptıklarımın bir anlamı var mı ki?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Antei"
				}
			]
		}
	]
}