			"dialogs": [
				{
					"id": 747040101,
					"content": "Selam Columbina! Akvaryumumuzdaki balıkları mı seyrediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747040102,
					"content": "Hı hı. Burada harika bir iş çıkarmışsınız. Daha önce hiç görmediğim o kadar çok balık var ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040103
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 747040103,
					"content": "Daha önce bir akvaryuma gittin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747040104,
					"content": "Hayır, gerçi Snezhnaya'da birkaç akvaryum görmüştüm. Ama o zamanlar gözlerim kapalıydı, bu yüzden tam olarak keyfini çıkaramamıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040105
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 747040105,
					"content": "Şimdi nasıl buldun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747040106
					]
				},
				{
					"id": 747040106,
					"content": "Çok güzel. Su altı dünyasının bu kadar canlı ve rengarenk olduğunu hiç bilmiyordum. Sanki... Sonsuz bir ilkbaharda yaşamak gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040107
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 747040107,
					"content": "Aa, şu balığa bakın. Tıpkı Sandrone'ye benzemiyor mu? Bir de şuradaki ikisi var, biri diğerinin peşinden gidiyor... Tıpkı ikiniz gibiler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040108
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 747040108,
					"content": "Aa, evet! Sen söyleyince Paimon dikkat etti de, gerçekten bize benziyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747040109,
					"content": "Şuradaki meşgul görünen bana Lauma'yı hatırlatıyor. Mercanın içindeki ise tıpkı Leydi Nefer gibi sessizce her şeyi gözlemliyor sanki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040110
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 747040110,
					"content": "Şey... Paimon'a tüm arkadaşlarını balıklara benzetmeyi çok seviyormuşsun gibi geldi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747040111,
					"content": "Pek sayılmaz. Arkadaşlarımı seviyorum, bu yüzden doğal olarak kendimi onları düşünürken buluyorum. Balıklara bakarken bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040112
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 747040112,
					"content": "Vay canına! Paimon bunu duyduğuna çok mutlu oldu! Peki sana birini hatırlatan başka balık var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747040113,
					"content": "Hımm... Son zamanlarda bir sürü yeni arkadaş edindim. Korkarım her birine uyacak bir balık bulamam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040114
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 747040114,
					"content": "Tabii. Neyse, akvaryuma daha fazla balıkçık eklemeye devam edeceğiz! Ara sıra yine uğra, belki bir sonraki gelişinde daha fazla arkadaşını bulabilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747040115,
					"content": "... Arkadaşlarımı akvaryuma mı koyacaksın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747040116
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 747040116,
					"content": "Tabii ki de hayır! Paimon balıkçıklara benzeyen arkadaşlarını kastediyor, seni gidi şapşal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}