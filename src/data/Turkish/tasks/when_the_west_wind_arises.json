				"objectNames": [
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4861001,
					"content": "Bu Kaeya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4861002,
					"content": "Seni bekliyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861003
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861003,
					"content": "Jean'in hastalandığını duydum. Tüm Favonius Şövalyeleri adına desteğin için minnettar olduğumu söylemek isterim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861004
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861004,
					"content": "Ne kadar saygılı ve nazik. Bu Paimon'un tanıdığı Kaeya değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4861005,
					"content": "Haha... Koşullar öyle gerektiriyor. Sonuçta konuştuğumuz kişi Büyük Kumandan Vekilinin kendisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861006
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861006,
					"content": "Ayrıca teşekkür mesajının yanı sıra bir şey daha var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861007
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861007,
					"content": "Bizim için bir iş mi var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4861008
					]
				},
				{
					"id": 4861008,
					"content": "Aklımı okudun! Aramızda güçlü bir bağ yok mu sence de?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861009
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861009,
					"content": "Bize bu noktada ödülümüzü mü takdim edeceksin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4861010
					]
				},
				{
					"id": 4861010,
					"content": "Hahaha. Tarzını sevdiğimi söylemem lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861011
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861011,
					"content": "Ancak ödül konusunu görüşebilmemiz için Şövalyelere yardımcı olabileceğini düşündüğüm bazı konular var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861012
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861012,
					"content": "Jean'in yerine bakmakla ilgili işler mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4861013,
					"content": "Evet. Jean'e ilettiğin dosyalar başka birisine atanmış olsa da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861014
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861014,
					"content": "... Jean'in eli değmeden gereken özenin gösterileceği konusunda endişelerim var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861015
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861015,
					"content": "Bu nedenle uygun gördüğün yerlerde yardım edebilirsin diye umuyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861016
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861016,
					"content": "Fahri Şövalyenin bu vakalarla bizzat ilgilendiğini bilmek içimi rahatlatacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861017
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861017,
					"content": "#{NICKNAME} hakkında istediğin kadar övgü dolu sözler söyleyebilirsin ama lütfen Paimon'a cevap ver: Neden SEN yapmıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4861018,
					"content": "Haha... Benim yapmam gereken çok daha önemli işler var da ondan. Şey... Hazırlanması gereken bir sürü şey var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861019
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4861019,
					"content": "İyi, tamam. O halde bizden <color=#00E1FFFF>Sara, Charles ve Margaret'ın</color> işleri için yardım istiyorsun, doğru mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4861020,
					"content": "Evet, o işler için. Yardımınıza minnettarım. Görüşürüz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				}
			]
		},
