					}
				]
			},
			"dialogs": [
				{
					"id": 761590201,
					"content": "Bir anda kendinizi bir uçurumun kenarında buluyorsunuz...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761590202
					]
				},
				{
					"id": 761590202,
					"content": "Pekala, işte geldik. Bu Peri Avlusunun manzarası gerçekten çok hoş, öyle değil mi? Şuradaki noktayı görüyor musunuz? İşte orası başlangıç noktası.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590203,
						761590204
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590203,
					"content": "... Peri Avlusu mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590205
					]
				},
				{
					"id": 761590205,
					"content": "Onu kullanıp bizi buraya daha hızlı mı getirdim? Elbette! Bu Peri Avluları Ley Hatlarına bağlı, kimsenin kullandığı da yok. Etrafta gezinmek söz konusu olduğunda çok işe yarıyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590206
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590206,
					"content": "Ayrıca Periler de ben de önceden melektik, yani eski meslektaş sayılırız. Arada sırada evlerini kullanmamı sorun etmeyeceklerine eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590207
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590207,
					"content": "Etrafta başka kimse yok galiba...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590208
					]
				},
				{
					"id": 761590208,
					"content": "Erken gelmişiz. Kısa bir süre sonra bir ozan gelip kadim methiyeler söyleyecek ve çağlar boyunca gezinen bin rüzgarı geri çağıracak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590209
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590209,
					"content": "Yoksa bu ödev...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590210
					]
				},
				{
					"id": 761590210,
					"content": "Şşş... Sabırlı ol. Zamanı gelince her şey ortaya çıkacak. Çok yakında bir methiyenin içine yerleşmiş tek bir ahenkli melodiye dönüşeceksin ve bin rüzgar etrafında girdaplar oluşturacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590211
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590211,
					"content": "Ama bu olmadan önce, huzur içinde uyumasına izin vermeliyiz... Hadi, sıradaki yere gidelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590212,
						761590213
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590212,
					"content": "Bir dakika, burası...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590214
					]
				},
				{
					"id": 761590214,
					"content": "Evet, sözlükte okumuştum. Nasıl sonlandığına bakılırsa Lord Barbatos ile çok güzel bir melodi çalmış olmalısınız. Barbie'nin tek bir notasını bile duyamamış olması ne yazık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590215
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590215,
					"content": "Alice'e bunu söyleyince o kadar güldü ki az kalsın şapkası düşüyordu. Öhöm! Hadi bir sonraki konuma gidelim! Yani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590213,
					"content": "Venti'yle bir keresinde şu uzaktaki adada bir düet yapmıştık.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590214
					]
				},
				{
					"id": 761590204,
					"content": "Sen az önce onu kullanıp...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590205
					]
				}
			]
		},
