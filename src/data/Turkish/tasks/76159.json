			"dialogs": [
				{
					"id": 761590101,
					"content": "Hemen gidiyor musun? Barbie! Bir şeyi unutmuyor musun? Hani vermen gereken bir sürü şey vardı ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590102
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590102,
					"content": "... Bana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590103,
						761590104
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590103,
					"content": "Kötü bir zamanda mı geldik?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590105
					]
				},
				{
					"id": 761590105,
					"content": "Yok canım, gelişiniz Barbie'nin kehanetine aşağı yukarı uyuyor... Gerçi dürüst olmak gerekirse biraz daha geç geleceğinizi düşünmüştüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590106
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590106,
					"content": "Neyse... İş konuşmaya başlamadan önce... Bir şeyler yemeye ne dersiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590107,
						761590108
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590107,
					"content": "B-Barbeloth kehanetinde acıkacağımızı da mı söyledi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590109
					]
				},
				{
					"id": 761590109,
					"content": "Hayır, tabii ki hayır! Ama kulaklarım oldukça keskindir, Paimon'un midesinin guruldadığını kilometrelerce öteden duydum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590110
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590110,
					"content": "*gurul* *gurul*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590111,
					"content": "Aa! Paimon'un karnı iki kişilik gurulduyor... İkimiz de kurt gibi açız herhalde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590112,
						761590113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590112,
					"content": "O mekanda bifteğin biteceğini nereden bilebilirdim ki...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590114
					]
				},
				{
					"id": 761590114,
					"content": "Hiç canınızı sıkmayın! Bende bir sürü kurabiye ve kek var. Hem bilirsiniz, bir \"cadıdan\" yiyecek kabul eden aç gezginlerin başına şimdiye kadar kötü bir şey hiç gelmemiştir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590115
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590115,
					"content": "Paimon'la keyifle kurabiye ve kek atıştırırken bir yandan da çaylarınızı yudumluyorsunuz. Tuhaftır ki ne kadar yiyip içseniz de çaydanlık hep yarısına kadar dolu kalıyor ve tabaklarınızda her zaman taze bir kurabiye ve bir dilim kek bulunuyor...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761590116
					]
				},
				{
					"id": 761590116,
					"content": "Paimon çok doydu... Karnını ne kadar doldurursa doldursun tabağına hep yenisi geliyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590117,
						761590120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590117,
					"content": "Demek büyücülerin çay saatleri böyle oluyormuş...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590118
					]
				},
				{
					"id": 761590118,
					"content": "E tabii ki! Bolca yiyecek içecek olmadan çay saati olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590119
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590119,
					"content": "Öte yandan tıka basa doyunca \"büyücülere yakışır\" bir zarafet sergilemek zordur. Bu yüzden çaydanlık genelde sadece yarısına kadar doludur ve her tabakta yalnızca bir kurabiye veya bir dilim kek olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590123
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590123,
					"content": "Paimon gerçekten daha fazla yiyemez! Az kaldı, patlamak üzere... Artık sadede gelebilir miyiz? *geğirir*... Ay... Pardon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590124,
					"content": "Pekala. Sanıyorum ki \"ödevimi\" getirmeye geldiniz, hani şu Barbie'nin kehanette bulunduğu ödevi, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590125,
						761590126
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590125,
					"content": "En başından beri biliyordun...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590127
					]
				},
				{
					"id": 761590127,
					"content": "Sandığınız gibi değil. Biz tamamen farklı bir konu üzerine konuşuyorduk. Aydaki büyük kayma onun su falının dengesini bozmuş, bu yüzden bir süreliğine geri dönüp sessiz meditasyon dönemine girmesi gerekiyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590128
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590128,
					"content": "O yokken herkesin ödevlerinin sorumluluğunu ben üstleneceğim. Ayrıca bir sonraki ödevleri sözlüğe eklemesine yardım etmeyi de planlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590129
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590129,
					"content": "Hı? Sorumlu kişiyi öylece değiştirebiliyor musun yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590130,
						761590131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590130,
					"content": "Eh, bunu başarabilecek biri varsa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590132
					]
				},
				{
					"id": 761590132,
					"content": "Başka seçeneğim yoktu ki! Barbie ve Alice bana bu konuyu açmadan önce \"özel ödevimi\" sözlüğe çoktan yazmışlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590133
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590133,
					"content": "Her ne kadar hepsini silip atıp dünyayı gelişigüzel gözlemlemeye devam etmeyi istesem de Alice Teyvat'ın sınırlarını korumakla meşgul, Barbie de su falını yeniden dengelemekle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590134
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590134,
					"content": "Octavia geri dönme zahmetine girmedi, Rhinedottir'i zaten unutun gitsin... Diğer büyücülerin hepsinin ilgilenmesi gereken kendi işleri var, o yüzden bu ödevi denetleme görevi bana kaldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590135,
						761590136
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590135,
					"content": "Cadılar Meclisinin bu kadar meşgul olduğunu fark etmemiştim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590137
					]
				},
				{
					"id": 761590137,
					"content": "Gerçekten de öyleyiz. Adının hakkını verecek bir çay saati düzenlemek için hep birlikte en son ne zaman toplandık hatırlamıyorum bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590138
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590138,
					"content": "Her neyse, ödevimi bitirdiğim sürece hikayem de resmi olarak sözlüğe yazılacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590139
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590139,
					"content": "#Ondan sonra gözcülüğe ve rehberliğe devam edebileceğim... Ee {NICKNAME}, Paimon, mesajınızı iletin bakalım. Ödevim nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590140
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590140,
					"content": "Ha, ayrıca bu bir kehanet sayılmadığından, yani sadece Barbie ve Alice'in on dakika önce uydurduğu bir şey olduğundan, muhtemelen taşıdığınız o sözlükte işe yarar bir bilgi yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590141
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590141,
					"content": "Haklısın Nicole! Gelmeden önce bir göz attık, hiç ayrıntılı talimat yok. Sadece şu iki cümle var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590142,
						761590143,
						761590144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590142,
					"content": "\"Nicole görevini yerine getirecektir.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590145
					]
				},
				{
					"id": 761590145,
					"content": "Pekala. İlk cümlenin Barbie tarafından yazıldığı aşikar ama son Morama bahse girerim ki ikinciyi Alice eklemiştir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590146
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590146,
					"content": "Neyse, hadi şu ödeve başlayalım! Dur bir düşüneyim, nereden başlasak acaba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590147,
						761590148
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590147,
					"content": "Bir dakika, ne yapmanı istediklerini gerçekten anladın mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590149
					]
				},
				{
					"id": 761590149,
					"content": "Hım? Ha, Barbie az önce görevlerimi özetledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590150
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590150,
					"content": "Kısaca anlatmam gerekirse birkaç ödev noktasına gidip her şeyin yolunda olduğundan emin olmam ve biraz da saha çalışması yapmam gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590151
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590151,
					"content": "Bir dakika! Paimon onun sana kehanette bulunduğunu sanıyordu. Nasıl oluyor da \"özet\" bir kehanet sayılıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590152,
					"content": "Şöyle ki ben Barbie'nin bana söylediği her şeyi doğal olarak bir tür kehanet gibi görürüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590153
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590153,
					"content": "Ayrıca Barbie bu ödevimi yazdığında, tek yaptığı hikayemin son sayfasına gidip bana sonunu önceden söylemekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590154,
						761590156
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590154,
					"content": "Ama sürprizi kaçmadı mı şimdi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590155
					]
				},
				{
					"id": 761590155,
					"content": "Hımm... Haklısın ama kehanetle arasında ne fark var ki zaten? Pekala, bu kadar oyalanmaca yeter, hadi gelin. Gideceğimiz yer... Hımm, evet, burası gayet iyi olur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590159
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590159,
					"content": "Hemen gidiyor muyuz? Dur bir dakika, oraya nasıl gide...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590160
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590160,
					"content": "Bir anda kendinizi bir uçurumun kenarında buluyorsunuz...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 761590156,
					"content": "E ben buraya boşuna mı geldim o zaman?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590157
					]
				},
				{
					"id": 761590157,
					"content": "Nasıl yani? Bu ödevin senin tarafından teslim edilmesi gerekiyordu, bu çok önemli bir adım. Ödevin geçerli sayılması için belirli süreçlere uyulması gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590158
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590158,
					"content": "Ama bunu daha sonra konuşabiliriz. Neyse, bu kadar oyalanmaca yeter, hadi gelin. Gideceğimiz yer... Hımm, evet, burası gayet iyi olur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590159
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590148,
					"content": "Ben hiçbir şey anlamadım da...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590149
					]
				},
				{
					"id": 761590143,
					"content": "\"Sizin bedavaya çalışmanıza asla izin vermez!\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590145
					]
				},
				{
					"id": 761590144,
					"content": "Hepsi bu kadar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590145
					]
				},
				{
					"id": 761590136,
					"content": "Sen söyleyince dank etti, bayağı kalabalıksınız aslında.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590137
					]
				},
				{
					"id": 761590131,
					"content": "... O da Nicole'dur!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590132
					]
				},
				{
					"id": 761590126,
					"content": "Demek az önce Barbeloth...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590127
					]
				},
				{
					"id": 761590120,
					"content": "Bir dahaki sefere Varesa'yı da getirelim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590121
					]
				},
				{
					"id": 761590121,
					"content": "Natlan'daki Bereket Kolektifinin yeme şampiyonu muydu o? Alice bana ondan bir keresinde bahsetmişti. Büyüleyici bir genç hanımefendiymiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590122
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590122,
					"content": "Sanıyorum çay saatlerimizden birine katılacak olsa ona üç... Hatta belki yedi tabak hazırlamamız gerekirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590123
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590113,
					"content": "O kadar salata yedik ama sanki bir kase dolusu yeşil hava gibiydi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590114
					]
				},
				{
					"id": 761590108,
					"content": "Acıkmanın da kehaneti oluyor mu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590109
					]
				},
				{
					"id": 761590104,
					"content": "Sonra gelsek daha iyi olabilir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590105
					]
				}
			]
		},
		{
			"id": 7615902,
