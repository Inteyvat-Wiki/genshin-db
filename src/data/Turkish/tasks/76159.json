			"dialogs": [
				{
					"id": 761590301,
					"content": "Burası Kurtlar Diyarı mı? \"Ödev\" yapmak için pek uygun bir yere benzemiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590302,
					"content": "Burası gideceğimiz yere en yakın Peri Avlusu. Merak etmeyin, başlangıç noktasından uzakta değiliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590303
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590303,
					"content": "Aaa! Bütün bu kurtlar nereden çıktı böyle? Hey... Size zarar vermeye gelmedik! Biz Razor'ın arkadaşlarıyız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590304,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590305,
						761590306
					],
					"speakerTitle": "Kurt Sürüsü"
				},
				{
					"id": 761590305,
					"content": "Kurtlar gitti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590307
					]
				},
				{
					"id": 761590307,
					"content": "Şşş. Çocuk hâlâ gelmedi mi? Belki de yine çok erken gelmişizdir. Merak etmeyin, \"lupical\"ının yanında durduğu sürece her düşmanın üstesinden gelebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590308
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590308,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590309
					],
					"speakerTitle": "Kurt Sürüsü"
				},
				{
					"id": 761590309,
					"content": "Neden geri geldiler? Konuştuğumuzu mu duydular? Keşke Razor burada olsaydı, ne söylediklerini çevirirdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590310,
					"content": "Haksız sayılmazsın Paimon ama kurtların söylediklerinden çok daha fazlasını anlaması gerekiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590311,
						761590312
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590311,
					"content": "Hey, burası...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590313
					]
				},
				{
					"id": 761590313,
					"content": "Doğru. O çocuk, kaderinde olan savaşı çoktan kazandı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590314
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590314,
					"content": "\"Lupical\"ının yanında olduğu sürece her türlü düşmanın üstesinden gelebileceğine inanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590315
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590315,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590316
					],
					"speakerTitle": "Kurt Sürüsü"
				},
				{
					"id": 761590316,
					"content": "... Eminim lupical'ı da böyle düşünüyordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590317
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590317,
					"content": "Pekala! Burası bitti. Şöyle güzel bir dinlenmeyi hak ettim. Hadi gidelim. Geri dönüp bir fincan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590318
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590318,
					"content": "Aaa! Bu kapı ne zaman ortaya çıktı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590319,
						761590320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761590319,
					"content": "Üzerinde bir not var...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590321
					]
				},
				{
					"id": 761590321,
					"content": "Alice'in el yazısına benziyor. Bir bakalım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590322
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590322,
					"content": "\"Ödeve yardım ettiğin için teşekkürler! Şimdi hemen eve git ve sıcacık bir fincan çay iç!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590323
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590323,
					"content": "\"Not: Bu kapının arkasında seni bir sürpriz bekliyor!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590324
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590324,
					"content": "\"Hemen eve git\" mi? Bir saniye, bu kapı neden bu kadar tanıdık geliyor? Yoksa arkasında...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590325
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761590325,
					"content": "Nicole kapıyı iterek açıyor ve kararlı adımlarla içeri giriyor, siz de peşinden giriyorsunuz. Birden kendinizi bir odanın içinde buluyorsunuz...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 761590320,
					"content": "Bu tarz... Bir yerden tanıdık geliyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590321
					]
				},
				{
					"id": 761590312,
					"content": "Razor ile bir keresinde burada birlikte savaşmıştık.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590313
					]
				},
				{
					"id": 761590306,
					"content": "Yoksa bu ödev...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590307
					]
				}
			]
		},
