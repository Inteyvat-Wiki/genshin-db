			"dialogs": [
				{
					"id": 200610501,
					"content": "Güvercinlerin hakkında...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610502
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610502,
					"content": "Ne yaptım DEDİN? Nasıl yaparsın? Onlar benim posta güvercinlerimdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610503
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610503,
					"content": "Sen bir yabani, hatta bir dağ yabanisi kadar budalasın! Bütün bu mektuplarla ne yapacağım şimdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610504,
						200610506
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610504,
					"content": "Özür dilerim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610505
					]
				},
				{
					"id": 200610505,
					"content": "Elinden gelenin en iyisi bu mu? Lanet olası bir Favonius Şövalyesinin yapabildiği en iyi şey isteksizce özür dilemek mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610508
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610508,
					"content": "İşi eline yüzüne bulaştırdın, şimdi de düzeltmek zorundasın. Zaten kuş beyinli olduğun için yeni posta güvercinim olmanda sakınca yoktur umarım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610506,
					"content": "Bazen gücümü kontrol edemiyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610507
					]
				},
				{
					"id": 200610507,
					"content": "Lanet olası bir satırla kovalamasan kontrol edebilirdin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610508
					],
					"speakerTitle": "Draff"
				}
			]
		},
