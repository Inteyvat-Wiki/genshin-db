			"dialogs": [
				{
					"id": 200610401,
					"content": "Güvercinlerin hakkında...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610402
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610402,
					"content": "Artık gelecekte bu kadar sorun çıkarmadan mesajları iletirler herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610403
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610403,
					"content": "Ama peşlerinden gidip ne yaptıklarına bakamam ki. Neyse, şimdilik işimiz bitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610404
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610404,
					"content": "Çabalarının karşılığı olarak lütfen bunu al. Mesaj göndermen gerekirse de gelip beni bulursun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				}
			]
		},
		{
			"id": 2006105,
