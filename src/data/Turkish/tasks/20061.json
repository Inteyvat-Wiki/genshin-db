			"dialogs": [
				{
					"id": 200610101,
					"content": "Güvercinlerin hakkında...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610102
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610102,
					"content": "Şöyle birkaç yabani mantarla fırına atsam daha çok işime yararlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610103
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610103,
					"content": "Sorun ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610104
					]
				},
				{
					"id": 200610104,
					"content": "Onları mesaj iletsinler diye posta güvercini olarak yetiştirdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610105
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610105,
					"content": "Ancak nedense gün geçtikçe daha da güvenilmez oluyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610106
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610106,
					"content": "Ya mesajı kaybediyorlar ya da saatlerce süzülüp mesajı iletmeden geri geliyorlar. Bazen de birileri onları kovalayana kadar oturup bekliyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610111
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610111,
					"content": "Vaktin varsa belki az önce saldığım güvercinlerin peşinden onlara yetişebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610107,
						200610109
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610107,
					"content": "Tamamdır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610108
					]
				},
				{
					"id": 200610108,
					"content": "Harika. Aylaklık yapanı görürsen de kovalarsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610109,
					"content": "Güvercinlerle husumetim olsun istemiyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610110
					]
				},
				{
					"id": 200610110,
					"content": "Merak etme. Güvercinler kin besleyemez, hemen unuturlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610112
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 200610112,
					"content": "Senin güvercin sevdalısı olacağını hiç düşünmezdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				}
			]
		},
