			},
			"dialogs": [
				{
					"id": 210370101,
					"content": "Liyue... Kim bilir tekrar ne zaman geleceğim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370102
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370102,
					"content": "Bir şey mi oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370103
					]
				},
				{
					"id": 210370103,
					"content": "Gezgin, sen mi geldin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370104
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370104,
					"content": "Fontaine'e olan yolculuğum sonunda kesinleşti. Birkaç gün sonra o tüccarla yola çıkacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370105
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370105,
					"content": "Hâlâ ilgilenmesi gereken birkaç iş var. Ben bu zamanı her şeyi topladığımdan emin olmak için harcıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370106,
						210370107
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370106,
					"content": "Jueyun Gölü'ne son bir kez gitmeyecek misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370108
					]
				},
				{
					"id": 210370108,
					"content": "Haha, eğer bunu yaparsam kararımdan pişmanlık duyacağımı düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370109
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370109,
					"content": "Buradan şehre bakmak bana yeter. Burada çok uzun zaman boyunca yaşadım ve şimdi tekrar ne zaman dönerim bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370110
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370110,
					"content": "Şey, bu arada Que'er... *iç çeker* Sonunda benimle gitmek istemediğini söyledi ama çoktan Zhiruo'ya ona bakmasını söyledim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370111
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370111,
					"content": "Birikimimin bir kısmını da ona ayırdım. Benden çok daha zeki biri. Kendine bakabileceğinden eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370112
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370112,
					"content": "Belki bir gün verdiğim kararı anlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370113
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370113,
					"content": "Evet, bir isteğim daha olacaktı Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370114
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370114,
					"content": "Bana biraz toprak getirebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370115,
						210370116
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370115,
					"content": "Neden olmasın...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370117
					]
				},
				{
					"id": 210370117,
					"content": "Benim gibi memleketinden gidecek biri yanında birkaç hatıra götürmek ister, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370118
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370118,
					"content": "Liyue'nin toprağı yanımda götürebilirsem en azından bu topraklardan tamamen ayrılmadığımı hissedebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370119
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370119,
					"content": "Neden kendin almıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370120
					]
				},
				{
					"id": 210370120,
					"content": "Hahaha... Dediğim gibi buradan gidersem burada geçirdiğim birçok anı birden aklıma gelir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370121
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370121,
					"content": "Sonra da zaten az olan cesaretimi kaybedip buradan gitmemeye karar verebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370122
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370122,
					"content": "Bu yüzden bu görevi ancak sana verebilirim Gezgin. Gitmen gereken yeri senin için işaretleyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370123
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370123,
					"content": "Orası neden senin için bu kadar özel?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370124
					]
				},
				{
					"id": 210370124,
					"content": "Öhöm... Orada Que'er ile kılıç tekniğim üzerinde çalışırdım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370125
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370125,
					"content": "Neyse! Bu görevi sana bırakıyorum Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370116,
					"content": "Ne yapacaksın ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370117
					]
				},
				{
					"id": 210370107,
					"content": "Burada son bir kez gezmeyecek misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370108
					]
				}
			]
		},
