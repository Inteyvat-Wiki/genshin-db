				"points": []
			},
			"dialogs": [
				{
					"id": 210370401,
					"content": "Bilerek yapıyor olmalı, Zhiruo! O aslında... O benimle kalmak istemiyor! *sızlanır*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370402
					],
					"speakerTitle": "Minik Que'er"
				},
				{
					"id": 210370402,
					"content": "Que'er, siz beraber o kadar çok vakit geçirdiniz ki, o ne düşündüğünü tahmin edebiliyor olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370403
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 210370403,
					"content": "Bu sefer Liyue'yi terk edip başka yerlere gitmeye kararlı görünüyor. Onunla gitsen ne zararı olur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370404
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 210370404,
					"content": "Ben buradan ayrılmak istemiyorum! Sonsuza kadar burada kalsak ne olur ki? Guhua Klanı... Guhua Klanı falan umurumda değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370405
					],
					"speakerTitle": "Minik Que'er"
				},
				{
					"id": 210370405,
					"content": "Ona neden bunu söylemiyorsun o zaman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370406
					],
					"speakerTitle": "Zhiruo"
				},
				{
					"id": 210370406,
					"content": "Ben... *iç çeker* O Klanı diriltme fikrine kafayı takmış durumda. Böyle konuştuğumu bilse, benden nefret eder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370407
					],
					"speakerTitle": "Minik Que'er"
				},
				{
					"id": 210370407,
					"content": "*iç çeker* Que'er...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiruo"
				}
			]
		},
