			"dialogs": [
				{
					"id": 210370301,
					"content": "Teşekkür ederim, bu kadarı bana yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370302,
						210370305
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370302,
					"content": "Pek heyecanlı görünmüyorsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370303
					]
				},
				{
					"id": 210370303,
					"content": "Ahahaha... Özür dilerim, darılmanı falan istemem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370304
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370304,
					"content": "Sadece uzun zamandır yaşadığım Liyue'den gitme konusunda biraz tereddüte düştüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370305,
					"content": "Ne zaman gideceksin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370306
					]
				},
				{
					"id": 210370306,
					"content": "Eşyalar hazırlanınca yola çıkacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370307
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370307,
					"content": "Ha, bizi Kanyon'a götüren maceracı da bizimle seyahat edecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370308
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370308,
					"content": "Bizim Fontaine'e gideceğimizi duymuş, onun da ilgisini çektiğinden bizimle gelmeye karar verdiğini söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370309
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370309,
					"content": "Tüccar onu koruyacak başka bir maceracı katılacağı için memnun. Fakat doğruyu söyleyeyim, bu kadar hevesli insanlarla iletişim kurmakta pek iyi değilim... *iç çeker*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370310
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210370310,
					"content": "Bir gün bu kadar uzağa seyahat edeceğimi hiç tahmin etmezdim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
		{
