			"dialogs": [
				{
					"id": 200430101,
					"content": "Ah, sırtım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430102
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430102,
					"content": "İyi misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430103
					]
				},
				{
					"id": 200430103,
					"content": "Tam da işe gitmeye hazırlanıyordum ama birden sırtım ağrımaya başladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430104
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430104,
					"content": "Bugün Quinn'e meyve tezgahında yardım edeceğime söz vermiştim ama sanırım önce burada biraz dinlensem daha iyi olacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430105
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430105,
					"content": "Ama burada durup her şeyi beklemeye alamam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430106
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430106,
					"content": "Quinn'e gidip benden ne istediğini sorar mısın? Böylece hazırlanabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430107,
						200430109
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430107,
					"content": "Tamam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430108
					]
				},
				{
					"id": 200430108,
					"content": "Teşekkür ederim. Biraz dinlendikten sonra daha iyi olurum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430109,
					"content": "Çok uzakta değil, muhtemelen yapabilirsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430110
					]
				},
				{
					"id": 200430110,
					"content": "Hadi ama, çok şey mi istiyorum? Bana yardım ediver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
