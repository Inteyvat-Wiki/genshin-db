			"dialogs": [
				{
					"id": 200430601,
					"content": "Quinn'le görüştün mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430602
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430602,
					"content": "Evet. Biraz dinlen dedi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430603
					]
				},
				{
					"id": 200430603,
					"content": "Bugün zaten Quinn'in orada yapacak bir şey yok. Eve gidip biraz dinlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200430604,
					"content": "Gerçekten mi... *iç çeker* O zaman yapacak başka bir şey bulmam gerek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430605
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430605,
					"content": "Ne? Hastalık izni almayacak mısın? Hazır fırsatın varken değerlendir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200430606,
					"content": "Bir durup etrafında olan biteni hisset. Lord Barbatos'un rüzgarları hâlâ harıl harıl çalışıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430607
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430607,
					"content": "Barbatos bizi kutsuyor. Bu öyle hafife alınacak bir ayrıcalık değil... Hepimiz üstümüze düşeni yapmalıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430608
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430608,
					"content": "Senin üstüne düşene gelecek olursak... Ne yapıyordun? Neden bu kadar terledin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430609
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430609,
					"content": "Sen de çok meşgul görünüyorsun ama bu kötü bir şey değil. Ne kadar sıkı çalışırsak o kadar terleriz ve Barbatos'un rüzgarını o kadar çok hissederiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430610
					],
					"speakerTitle": "Michelle"
				},
				{
					"id": 200430610,
					"content": "Bu sütü al. İçip işe geri dön, bu dünyada yapacak iş hiç bitmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michelle"
				}
			]
		},
