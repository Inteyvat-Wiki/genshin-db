			"dialogs": [
				{
					"id": 200430501,
					"content": "Güneriği buldun mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430502
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430502,
					"content": "Buldum, buradalar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430503
					]
				},
				{
					"id": 200430503,
					"content": "Harika. Bu Bayan Eury'ye yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430504
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430504,
					"content": "*iç çeker* Ama müşterilerimin çoğunu kaybettim sanırım. Görünüşe göre bu tek kişilik bir iş değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430505
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430505,
					"content": "Emeklerinin karşılığında bir şeyler vereyim. Bekle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430506
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430506,
					"content": "Hediyeye gerek yok ama senden bir ricamız var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200430507,
					"content": "Michelle'le ilgili.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200430508
					]
				},
				{
					"id": 200430508,
					"content": "Michelle mi? Onu gördünüz mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430509
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430509,
					"content": "Daha az yorucu bir iş mi vermeliyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430510
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430510,
					"content": "Ondan sadece meyve tezgahına bakmasını istemiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430511
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430511,
					"content": "Öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200430512,
					"content": "Ama müşteri kalmadığına göre artık onu da yapmasına gerek kalmayacak gibi duruyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430513
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430513,
					"content": "Lütfen benim için ona eve gidip dinlenmesini söyleyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200430514
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200430514,
					"content": "Az sonra gidip şu teslimata bir bakacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quinn"
				}
			]
		},
