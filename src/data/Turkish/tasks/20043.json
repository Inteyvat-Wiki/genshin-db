					"nextDialogs": [
						200430403
					]
				},
				{
					"id": 200430403,
					"content": "Şehrin dışında bolca <color=#00E1FFFF>güneriği</color> vardır. Benim burada kalmam gerekiyor, lütfen bana biraz toplayıp getirir misin?",
					"roleType": "TALK_ROLE_NPC",
