				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clitopho",
					"Paimon",
					"Zhiqiong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710410301,
					"content": "Kilit mekanizması henüz paslanmamış. Hatta görünüşe göre yağlanmış. Anlaşılan maden mühürlendikten sonra bile biri bunun bakımını yapmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410302
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410302,
					"content": "Topun alt kısmı da sağlam duruyor... Tek sorun emniyet kilidinin an itibarıyla açık olması.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410303
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410303,
					"content": "Neden bahsediyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410304,
					"content": "İlerideki tüneller madenciler dağıtıldıktan sonra büyük kayalar kullanılarak mühürlenmişti... Anlaşılan topu burada yeniden kullanmamız gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410305
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410305,
					"content": "Ancak ateşleyecek güllemiz olmazsa topun büyüklüğü hiçbir işe yaramaz. Bu yüzden birkaç gülle bulmamız gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410306
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410306,
					"content": "Hıh, Bay Çokbilmiş. Sanki ben bunu bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410307
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410307,
					"content": "Yakınlarda içinde gülle olması gereken bir depo var. Şanslıysak madenciler dağıtıldığında hepsini başka yere taşımamışlardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410308
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410308,
					"content": "O tarafa gidelim o zaman.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410309
					]
				},
				{
					"id": 710410309,
					"content": "Hadi gidelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clitopho"
				}
			]
		},
		{
			"id": 7104104,
			"completionStepIds": [
