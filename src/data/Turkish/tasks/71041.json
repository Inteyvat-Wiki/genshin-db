			"dialogs": [
				{
					"id": 710410401,
					"content": "İşte burası. *öksürür* Of, kapı kilitli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410402
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410402,
					"content": "Görünüşe göre kapıyı açmak için aynı anda iki anahtar kullanmamız gerekiyor... Yeter ama artık. Neden siz Liyueliler en basit konularda bile bu kadar titizsiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410403
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410403,
					"content": "Boş konuşmayı bırak... Kapının yanına yapıştırılmış bildiriyi görüyor musunuz? En azından bu bildiri sayesinde içeride gülle bulabileceğimizi anlıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410404
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410404,
					"content": "Doğru diyorsun ancak fitillerin iyi muhafaza edilip edilmediğini nereden bileceğiz? Ben olsam henüz ümitlenmezdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410405
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710410405,
					"content": "Vay be, ne kadar da iyimsersin sen öyle. Eziğin teki gibi konuşmayı keser misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410406
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410406,
					"content": "Cidden yani, bir Hazine Avcısının bizi yönlendirmesine nasıl müsaade edebildim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410407,
						710410408
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410407,
					"content": "Clitopho haklı aslında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410409
					]
				},
				{
					"id": 710410409,
					"content": "Aynen öyle! Atışmayı keser misiniz artık?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710410410,
					"content": "Hıh, tamam. Devam edelim. Belki Jinwu bu kapının nasıl açıldığını biliyordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410411
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410411,
					"content": "Kapı açıldıktan sonra da bayağı bir işimiz var. Topun arka kısmını açabilmek için bir sinyal cihazını etkinleştirmemiz gerekecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710410412
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410412,
					"content": "Jinwu, yıkım ekibi tarafından kullanılan bir gözlem noktası olduğunu ve topun oradan görülebildiğini söyledi. Dediğine göre sinyali oradan ayarlayabilir ve topun emniyet kilidini güvenli bir mesafeden kapatabilirmişiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710410408,
					"content": "Her halükarda ilk olarak bu kapıyı açmamız gerekiyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710410409
					]
				}
			]
		}
	]
