			"dialogs": [
				{
					"id": 706920101,
					"content": "Vay genç Şövalye, büyük kahramanımızı buraya getirmişsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920102
					],
					"speakerTitle": "\"Resim Delisi\""
				},
				{
					"id": 706920102,
					"content": "Fahri Şövalyemiz ve Beyazlı Yardımcısı! Selamlar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920103
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920103,
					"content": "Mika ve... Natlanlı bir arkadaş mı? Burada ne yapıyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706920104,
					"content": "Gözcü Sürüngen hakkında bilgi vermek için buradayız. Maceracılar için çok faydalı olacağını düşünüyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920105
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920105,
					"content": "Amber'ın Sumeru'dan getirdiği Gözcü Yoldaş'ın mekanik çekirdeğini, Natlan'daki arkadaşlarımın bana verdiği sevimli küçük Sürüngen oyuncağın görünümüyle birleştiriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920106
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920106,
					"content": "Gözcü Yoldaş... Ha, evet, Paimon hatırladı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706920107,
					"content": "Tıpkı Sumeru'daki Gözcü Yoldaşlar gibi, Gözcü Sürüngen de canavar keşfi yapmak ve bilinmeyen arazileri incelemek için kullanılabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920108
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920108,
					"content": "Fakat odağımız ikincisi olduğundan, Gözcü Sürüngen kontrol edilebilirlik ve hareket hassasiyeti ön planda tutularak tasarlandı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920109
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920109,
					"content": "... Fahri Şövalye, bir test uçuşu yapmak ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920110,
						706920111
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920110,
					"content": "Bu çok ciddi bir giriş oldu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706920112
					]
				},
				{
					"id": 706920112,
					"content": "Hı? Belki biraz gerilmişimdir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920113
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920113,
					"content": "Evet gerilmiş olmalıyım... Yemin ederim daha önce yanında daha rahattım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920114
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920114,
					"content": "Son zamanlarda diğer uluslardan gelen arkadaşlarımdan senin hakkında pek çok hikaye duyuyorum, yaptıkların giderek daha da olağanüstü bir hal alıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920115
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920115,
					"content": "Sana yardım etmem ve işine engel olmamam gerektiğini düşündükçe kendimi yine gergin hissediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920116
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920116,
					"content": "Bu tam da Mika'ya göre bir söz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706920117,
					"content": "Bence harika bir iş çıkarıyorsun genç Şövalye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920118
					],
					"speakerTitle": "\"Resim Delisi\""
				},
				{
					"id": 706920118,
					"content": "#Natlan'da kabilemizin savaşçıları {NICKNAME} ile karşılaştığında bazen o kadar heyecanlanıyorlar ki abuk sabuk konuşmaya başlıyorlar. Hatta bazılarının bunalıp tek kelime bile edemediğine şahit oldum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920119
					],
					"speakerTitle": "\"Resim Delisi\""
				},
				{
					"id": 706920119,
					"content": "#{NICKNAME} ile birlikte çalıştığın için sen de bir efsane sayılırsın. Şefimizle konuşurken bile gergin olmana hiç gerek yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920120
					],
					"speakerTitle": "\"Resim Delisi\""
				},
				{
					"id": 706920120,
					"content": "Doğru söylüyorsun! Kendine daha çok güvenmelisin Mika!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706920121,
					"content": "Hımm... Hiç bu açıdan düşünmemiştim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920122
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920122,
					"content": "#Her neyse {NICKNAME}, eğer Gözcü Sürüngeni test eder ve kaliteli bulursan, bunun her maceracıya faydası dokunacak güvenilir ve sevimli bir mekanizma olduğunu netleştirmiş olacağız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706920123,
						706920124
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920123,
					"content": "Test konusunda uzmanım diyebilirim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706920125
					]
				},
				{
					"id": 706920125,
					"content": "Harika! Son birkaç ayar daha yapayım, sonra hazırsın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mika"
				},
				{
					"id": 706920124,
					"content": "Bakalım bu Sürüngen neler yapabiliyor!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706920125
					]
				},
				{
					"id": 706920111,
					"content": "Bu kadar resmi olmaya gerek yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706920112
					]
				}
			]
		}
	]
}