			},
			"dialogs": [
				{
					"id": 715230101,
					"content": "Hımm... Artık çok zor olmasa gerek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230102
					],
					"speakerTitle": "Ting Zhi"
				},
				{
					"id": 715230102,
					"content": "Ne yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715230103
					]
				},
				{
					"id": 715230103,
					"content": "Sorumlusu olduğum oyunu hazırlıyorum... \"Yüz Adımda Fırlatma Ayinleri\" diye bir oyun duymuş muydun hiç?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230104
					],
					"speakerTitle": "Ting Zhi"
				},
				{
					"id": 715230104,
					"content": "Nesneleri uzağa fırlatmak için ayin falan mı yapılıyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715230105
					]
				},
				{
					"id": 715230105,
					"content": "Tam olarak öyle değil ama yaklaştın doğrusu! Oyunun mekaniği \"fırlatma\" üzerine ama \"ayin\" derken o tarz bir ayinden bahsetmiyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230106
					],
					"speakerTitle": "Ting Zhi"
				},
				{
					"id": 715230106,
					"content": "Çok eski bir kitaptan öğrendim ben bu oyunu. Kısaca anlatayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230107
					],
					"speakerTitle": "Ting Zhi"
				},
				{
					"id": 715230107,
					"content": "Oyunun eski versiyonunda kurallar gereği ayin sırasında tüm katılımcıların oturması gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230108
					],
					"speakerTitle": "Ting Zhi"
				},
				{
					"id": 715230108,
					"content": "Tabii belirli bir şekilde oturuyor olman lazım ama burada hiç yastık olmadığı için şimdi gösteremiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230109
					],
					"speakerTitle": "Ting Zhi"
				},
				{
					"id": 715230109,
					"content": "Katılımcılar oturdukları yerden müziğin ritmini takip ederek \"Dart Oklarını\" uzaktaki \"testilere\" doğru \"fırlatır.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230110
					],
					"speakerTitle": "Ting Zhi"
				},
				{
					"id": 715230110,
					"content": "Dart Oklarını testilere fırlatmanın, kendine has isimleri olan birçok farklı yöntemi vardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230111
					],
					"speakerTitle": "Ting Zhi"
				},
				{
					"id": 715230111,
					"content": "Mesela testiye isabet eden ilk Dart Okuna \"Birinci Atış\" deniyor. Sonraki Dart Oku da isabet ederse \"Seri Atış\" oluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230112
					],
					"speakerTitle": "Ting Zhi"
				},
				{
					"id": 715230112,
					"content": "Dart Oku, testinin sapına isabet ettiğinde buna \"Deldi Geçti\" deniyor. Ancak önce testiye girip sonra içinden sekerse de \"Sekti Geçti\" oluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230113,
						715230116
					],
					"speakerTitle": "Ting Zhi"
				},
				{
					"id": 715230113,
					"content": "O ne karışık oyunmuş öyle ya!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715230114
					]
				},
				{
					"id": 715230114,
					"content": "Endişelenme canım. Diyorum ya, bu \"eski\" versiyonu zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230115
					],
					"speakerTitle": "Ting Zhi"
				},
				{
					"id": 715230115,
					"content": "Ben kuralları herkes anlayabilsin diye oyunu biraz basitleştirdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230118
					],
					"speakerTitle": "Ting Zhi"
				},
				{
					"id": 715230118,
					"content": "Öhöm! Neyse işte, kısacası sen süre bitmeden olabildiğince çok Dart Okunu testiye atmaya odaklan... Gerisi bende!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230119
					],
					"speakerTitle": "Ting Zhi"
				},
				{
					"id": 715230119,
					"content": "Gerçekten de basitleştirmişsin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715230120
					]
				},
				{
					"id": 715230120,
					"content": "Yani kural kitapçığına göre, eninde sonunda kazanan kişi en çok oku testiye isabet ettiren oluyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230121
					],
					"speakerTitle": "Ting Zhi"
				},
				{
					"id": 715230121,
					"content": "Kaybeden tarafın içip şiir yazması gerektiğini belirten kurallara gelecek olursak... Kaybeden her oyuncudan bunu yapmasını isteyemem tabii!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230122
					],
					"speakerTitle": "Ting Zhi"
				},
				{
					"id": 715230122,
					"content": "Neyse! Oyun neredeyse hazır. El Testileri orada, Dart Oklarını da hemen getiriyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230123
					],
					"speakerTitle": "Ting Zhi"
				},
				{
					"id": 715230123,
					"content": "İstersen hemen deneyebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ting Zhi"
				},
				{
					"id": 715230116,
					"content": "Ben bunları ezberleyene kadar oyun biter!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715230117
					]
				},
				{
					"id": 715230117,
					"content": "Endişelenme canım. Sen hepsini hatırlamasan da olur zaten. Onları akılda tutmak benim işim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230118
					],
					"speakerTitle": "Ting Zhi"
				}
			]
		}
	]
}