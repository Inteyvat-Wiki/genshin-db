			"dialogs": [
				{
					"id": 200710201,
					"content": "Çiçekler ne durumda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710202
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710202,
					"content": "Üzgünüm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200710203
					]
				},
				{
					"id": 200710203,
					"content": "Neden? Ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710204
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710204,
					"content": "Kazara çiçekleri ve paketleri mahvettim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200710205
					]
				},
				{
					"id": 200710205,
					"content": "Ka-Kazara mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710206
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710206,
					"content": "Hay aksi... O çiçekleri özenle seçmiştim. O kalitedeki çiçekleri başka hiçbir yerde bulamazsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710207
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710207,
					"content": "Ejdersırtı o kadar tehlikeli mi ki? Senin gibi bir maceracı paketleri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710208
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710208,
					"content": "Yine de benim için bu kadar yol gittin, teşekkür ederim. Bunları teşekkür niyetine kabul et. Şimdi izninle çiçeklerimle ilgilenmem lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710209
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710209,
					"content": "*iç çeker* Belki de Sara'nın önerdiği yöntemi denemeliyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
