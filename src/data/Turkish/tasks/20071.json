			"dialogs": [
				{
					"id": 200710101,
					"content": "Ejdersırtı'nda sakladığımız çiçekler ne durumda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710102
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710102,
					"content": "Yalnızca bir tanesini getirebildim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200710103
					]
				},
				{
					"id": 200710103,
					"content": "Diğerlerini toplayamadın, öyle mi? Tamam o zaman. Dağdaki koşulları tahmin etmek oldukça zor ne de olsa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710104
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710104,
					"content": "Sadece bir paketi alabildiysen karşılaştırma yapamayız ama. Sanırım başka bir fırsat doğana kadar beklemek zorundayız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200710105
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200710105,
					"content": "Zahmete girdiğin için teşekkür ederim. İşte, ödül olarak sana bunları hazırladım. Gelecekte tekrar yardımına ihtiyaç duyabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
		{
			"id": 2007102,
