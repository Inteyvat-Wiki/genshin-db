			"dialogs": [
				{
					"id": 731580101,
					"content": "\"Hastanın yaşı: 65. Cinsiyeti: Erkek...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731580102
					],
					"speakerTitle": "Khayyam'ın Hastalık Geçmişi"
				},
				{
					"id": 731580102,
					"content": "\"Semptomları: Kısa süreli hafıza kaybı, zaman geçtikçe kötüleşiyor. Duygusal açıdan dengesiz, sürekli çocukluk ve gençlik anılarından bahsedip duruyor.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731580103
					],
					"speakerTitle": "Khayyam'ın Hastalık Geçmişi"
				},
				{
					"id": 731580103,
					"content": "\"Nedeni bilinmeyen bir beyin hastalığı söz konusu. Yapılan beyin muayenelerine göre 60 yaşından sonra hastanın beyin hücreleri işlevini yitirmeye başlamış ve bu durum zaman içinde hafıza kaybına yol açmış.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731580104
					],
					"speakerTitle": "Khayyam'ın Hastalık Geçmişi"
				},
				{
					"id": 731580104,
					"content": "\"... Hasta, rahat ve sakin bir hayat sürdüğü takdirde durumun daha yavaş kötüleşeceğini umarak Akademidenin Amu{RUBY#[S]Biyoloji}rta bölümünden emekli olmak için başvurdu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731580105
					],
					"speakerTitle": "Khayyam'ın Hastalık Geçmişi"
				},
				{
					"id": 731580105,
					"content": "\"Amurta tarafından yapılan duyuruya göre bilge Siman Farrokhzad hastayla bizzat ilgilenecek ve tedavi edilmesini sağlayacak.\"",
					"roleType": "TALK_ROLE_NPC",
