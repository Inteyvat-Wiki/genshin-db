				"points": []
			},
			"dialogs": [
				{
					"id": 730980401,
					"content": "Hımm. Bir bakalım. Bu yeni bir hazine haritasına benziyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980402,
					"content": "\"Kapana kısılmış Aranaraya\" yardımcı olmayacak mıydık?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980403
					]
				},
				{
					"id": 730980403,
					"content": "#Öhöm! Evin sahibini bulamadık. Endişe verici bir durum! {NICKNAME}, o resimde görünen yerlere gidip bir bakalım mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980404,
					"content": "Oraya gidince de şey yapabiliriz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980405,
						730980407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980405,
					"content": "Daha fazla hazine mi bulabiliriz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980406
					]
				},
				{
					"id": 730980406,
					"content": "Evet! Bir dakika, Paimon şey demek istemişti... Hayır! \"Kapana kısılmış\" Aranarayı bulmalıyız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980409,
					"content": "Çok ilginç bir \"posta kutusu\". Belki de ileride burada daha fazla resim buluruz. Gözümüz üstünde olsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980407,
					"content": "\"Kapana kısılmış Aranarayı\" mı bulabiliriz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980408
					]
				},
				{
					"id": 730980408,
					"content": "Evet! O arada hazine de buluruz belki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980409
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
