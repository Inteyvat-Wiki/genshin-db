			"dialogs": [
				{
					"id": 730980301,
					"content": "Paimon bir baksın... Hımm. Bu bir Aranara resmi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980302,
					"content": "Etrafı karıştırmak ayıptır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980303
					]
				},
				{
					"id": 730980303,
					"content": "Hımm. Kimbilir kaç tane maceracı kampının ve hazine sandığının altını üstüne getirdik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980304,
					"content": "O zaman şöyle diyeyim. Aranarayı evin civarında göremeyince endişelendik. Bizi ona götürecek herhangi bir ipucu var mı diye bakmak istedik. Kapana kısılmış bir Aranaraya yardımcı bile olabiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980305,
						730980306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980305,
					"content": "Haklısınız.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980307
					]
				},
				{
					"id": 730980307,
					"content": "Tabii ki! Neyse, sanki resim buraya yakın bir yere benzemiyor mu? Aa, belki de bu bir hazine haritasıdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730980308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980308,
					"content": "#{NICKNAME}, resimde görünen yere gitmeliyiz! Belki de Aranaranın arkasında bıraktığı hazinelerden bazılarını buluruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730980306,
					"content": "Hımm. Evet, çok mantıklı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730980307
					]
				}
			]
		},
		{
			"id": 7309804,
			"completionStepIds": [
				7309803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
