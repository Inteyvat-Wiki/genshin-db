			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101110601,
					"content": "Gezgin, sanırım küçük bir keşif yaptım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110602
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110602,
					"content": "Nirnama dedektörünü bir kez daha kullanabilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110603
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110603,
					"content": "Ne? Stanley'nin hayali bir arkadaşı mı var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101110604,
					"content": "Hayali arkadaşı deneyimli bir savaşçıya benziyor... Baştan aşağı yara izleriyle kaplı ve yüzünde kararlı bir ifade var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110605,
						101110608
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110605,
					"content": "Aynı Stanley'nin kendini tanımladığı gibi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110606
					]
				},
				{
					"id": 101110606,
					"content": "Yani onun hayali arkadaşı ideallerindeki kendisi gibi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110607
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110607,
					"content": "İlginç bir fikir! Ama bu doğru mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110611
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110611,
					"content": "İzninle artık gidiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110612
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101110612,
					"content": "Hoşça kal Stanley!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110613
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110613,
					"content": "İkinizin hâlâ biraz vakti var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110614
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110614,
					"content": "Nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110615
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110615,
					"content": "Birkaç gün önce Stanley sarhoş oldu ve bana bir sır verdi, daha önce kimseye söylemediği bir sır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110616
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110616,
					"content": "Yıllar önce macerasında aldığı silahlar... Onlar, bir zamanlar Mondstadt'ın en büyük kahramanı Vennessa tarafından kullanılan silahlardı! <color=#00E1FFFF>Muhteşem Cesaret Kılıcı</color> ve <color=#00E1FFFF>Görkemli Onur Kalkanı</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110617
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110617,
					"content": "Bana inanır mısınız bilmiyorum ama... Anlaşılan hem kılıç hem de kalkan hâlâ Mondstadt'ta, <color=#00E1FFFF>Dadaupa Geçidi'nde</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110618
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110618,
					"content": "Siz çocuklar bu konuda uzman olduğunuzdan... Benimle gelip o iki efsanevi silahı geri almayı deneyebilir misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110619,
						101110621
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110619,
					"content": "Stanley gerçekten bu silahlara sahip miydi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110620
					]
				},
				{
					"id": 101110620,
					"content": "Elbette! Stanley'den bahsediyoruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110623
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110623,
					"content": "Aileme neler yapabileceğimi göstermeye yetecek kadar etkileyici bir şey bulabilirsem belki sonunda bir maceracı olma fikrime sıcak bakarlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110624
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110624,
					"content": "Şu anda sadece bir acemiyim. Yeteneklerim sınırlı ve ailem, beni bu konuda birazcık bile desteklemiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110625
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110625,
					"content": "Peki, ne diyorsunuz? Bu adama yardım edecek misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110626
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110626,
					"content": "Bunu Stanley'ye söylemeye cesaret edemiyorum çünkü nedenlerim çok... Bencilce. Ama yemin ederim işim biter bitmez silahları ona geri vereceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110627
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110627,
					"content": "Ayy, zavallı Jack... Hadi ona yardım edelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110628,
						101110629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101110628,
					"content": "Tamam o zaman.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110630
					]
				},
				{
					"id": 101110630,
					"content": "Venti, sen de geliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101110631,
					"content": "Hımm... Bilmiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110632
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110632,
					"content": "Ah, bir şey daha var. Birkaç yıl önce birinin bana hediye ettiği yıllanmış nadir bir şişe şarabım var. O silahları bulmama yardım ederseniz onu size veririm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110633
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110633,
					"content": "Ah, <color=#00E1FFFF>Dadaupa Geçidi</color> miydi? Haha, hadi acele edelim, kaybedecek zaman yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110629,
					"content": "Bu üzücü hikayeden sonra hayır demek zor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110630
					]
				},
				{
					"id": 101110621,
					"content": "Stanley neden onları ormanın ortasına bırakmış ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110622
					]
				},
				{
					"id": 101110622,
					"content": "Bilmiyorum, önemli kişiler her zaman tuhaf davranışlarıyla anılır, öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110623
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110608,
					"content": "Bu hikayede tuhaf bir şey olduğunu biliyordum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110609
					]
				},
				{
					"id": 101110609,
					"content": "Sen de mi böyle düşünüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110610
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110610,
					"content": "Katılıyorum. Anlatmadığı bir şeyler vardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110611
					],
					"speakerTitle": "Venti"
				}
			]
		}
	]
}