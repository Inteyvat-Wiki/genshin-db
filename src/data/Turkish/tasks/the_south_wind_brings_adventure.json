			},
			"dialogs": [
				{
					"id": 101110401,
					"content": "*nefes nefese*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110402
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101110402,
					"content": "Ölmek üzere olduğuma emindim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110403
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110403,
					"content": "Açıkçası her şey olabilirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110404
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110404,
					"content": "O halde sanırım sen Maceracı Jack olmalısın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110405
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110405,
					"content": "Evet... Siz kimsiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110406
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110406,
					"content": "Aslında seni aramaya geldik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101110407,
					"content": "Ellin sana bir mesaj gönderdi. Bir sonraki maceranızı planlamak için bugün sana eşlik edemeyeceğini söyledi. Seninle daha sonra görüşecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110408,
					"content": "Ah, anladım... Onca yolu beni bulmak için geldiğiniz... Ve beni kurtarmak zorunda kaldığınız için kötü hissediyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110409
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101110409,
					"content": "Tüm bu tantanayı anlamıyorum. Bu durum benim, yani Stanley'nin kendi başına halledemeyeceği bir şey değildi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110410
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101110410,
					"content": "Vay canına, Stanley sen misin? Hani şu efsanevi maceracı? Tüm Mondstadt'ta ün salmış olan? Ve bir keresinde Mare Jivari'ye ayak basan kişi misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101110411,
					"content": "Hahaha, ta kendisiyim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110412
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101110412,
					"content": "Hahaha! Söylemeden geçemeyeceğim, senin gibi bir efsaneyle tanışmak bir şeref.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110413
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110413,
					"content": "Peki o zaman, bundan sonra ne yapacağız? Geri mi dönelim yoksa ilerleyelim mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110414,
						101110417
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110414,
					"content": "Stanley, sen ne düşünüyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110415
					]
				},
				{
					"id": 101110415,
					"content": "Hahaha, pekala... Artık Mondstadt'ın büyük kaşifi ve efsanesi Stanley'nin güvenli kollarındasınız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110416
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101110416,
					"content": "Bu durumda neden şimdi geri dönelim ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110419
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101110419,
					"content": "Tamam, öneri oy birliğiyle kabul edildi! Hadi o zaman ilerleyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 101110417,
					"content": "Jack, sen ne düşünüyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110418
					]
				},
				{
					"id": 101110418,
					"content": "Bence devam etmeliyiz. Yanımızda Stanley varken sorun yaşamayız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110419
					],
					"speakerTitle": "Jack"
				}
			]
		},
		{
			"id": 1011106,
			"completionStepIds": [
				1011106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
