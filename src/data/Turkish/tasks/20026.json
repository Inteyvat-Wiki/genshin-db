			"dialogs": [
				{
					"id": 200260101,
					"content": "Paket servis siparişi",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260102
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260102,
					"content": "Merhaba Gezgin! Ne oluyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260103
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260103,
					"content": "Sadece yemek yemeye mi geldin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260104
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260104,
					"content": "Anlıyorum... Gerçekten. Ama bana yardım edersen sana şimdiye kadar yediğin en lezzetli yemeği sunmaya söz veriyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260105
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260105,
					"content": "Şafak Şaraphanesinden Ernest, şarabının yanında yiyeceği yemekleri genelde buradan sipariş ediyor ve siparişlerinde özel taleplerde bulunuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260106
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260106,
					"content": "Bu defa <color=#00E1FFFF>Kızarmış Turp Köftesi</color> istiyor ama içine yumurta eklenmesini talep etmiş. Ama maalesef yumurtam yeni bitti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260107
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260107,
					"content": "Bana birkaç tane Kuş Yumurtası getirebilirsen harika olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260108,
						200260111
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260108,
					"content": "Madem ısrar ediyorsun...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200260109
					]
				},
				{
					"id": 200260109,
					"content": "Rüzgaralan etrafında bolca Kuş Yumurtası olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260110
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260110,
					"content": "Teşekkür ederim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260111,
					"content": "Buraya sadece yemek yemeye gelmiştim, açlıktan ölüyorum!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200260112
					]
				},
				{
					"id": 200260112,
					"content": "Rüzgaralan etrafında bolca Kuş Yumurtası olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260113
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200260113,
					"content": "İstediğimi yaptıktan sonra sana Avcının Yeri'nin özel menüsünden bir şeyler ısmarlarım! Şimdiden teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
		},
