			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Naganohara Ryuunosuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120601,
					"content": "Yoimiya, kötü bir şey oldu! Tenryou Heyetinden bazı insanlar geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120602
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120120602,
					"content": "Ne? Neden? Biliyorlar mıymış?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120603
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120603,
					"content": "Baba, iyi misin? Sana bir şey yapmadılar, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120604
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120604,
					"content": "Onlara gösterinin yakın zamanda başlayacağını ve mekanın havai fişeklerle dolu olduğunu, yangın tehlikesi nedeniyle içeri girmemeleri gerektiğini söyledim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120605
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120120605,
					"content": "Ama dinlemediler. Sakujirou'nun içeride olduğunu biliyor gibiydiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120606
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120120606,
					"content": "Neyse ki Sakujirou, geldiklerini duydu ve pencereden kaçmayı başardı. Tenryou Heyeti onu yakalayamadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120607
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120120607,
					"content": "İşte bu kötü olmuş. Sakujirou'nun kafasını toplamak için yeterli zamanı olduğunu sanmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120608
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120608,
					"content": "Baba, onun nereye gittiğini gördün mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120609
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120609,
					"content": "Tenryou Heyeti de kesin onun peşinden gidecektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120610
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120610,
					"content": "Herhangi birinin adını duyabildin mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120611
					]
				},
				{
					"id": 120120611,
					"content": "Aynen! Adları, bize onların adları lazım! Bir anda böyle ortaya çıkmaları, Keisuke'nin işi olmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120612
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120612,
					"content": "Normalde heyet, bir kaçak nedeniyle böyle büyük bir gürültü çıkarmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120613
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120613,
					"content": "Kusura bakmayın, kulaklarım iyi duymuyor ve onları tam da göremedim. Hangi yöne gittiklerini merak ediyorsanız, çoktan şehirden ayrıldılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120614
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120120614,
					"content": "Keşke adlarını duyabilseydim... *iç çeker* Ama hiçbir şey duymadım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120615
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 120120615,
					"content": "Olay yaşanırken, ben duydum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120616
					],
					"speakerTitle": "Morihiko"
				},
				{
					"id": 120120616,
					"content": "Arkadaşımın evinden biraz maden cevheri alıyordum ve yol üstünde onlarla karşılaştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120617
					],
					"speakerTitle": "Morihiko"
				},
				{
					"id": 120120617,
					"content": "Sanırım, dediğin gibi, liderlerinin adı Keisuke'ydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120618
					],
					"speakerTitle": "Morihiko"
				},
				{
					"id": 120120618,
					"content": "Tam da düşündüğüm gibi! Teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120619
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120619,
					"content": "Sakujirou hâlâ karar vermediyse, ikisinin karşılaşması hiçbir şeyi çözmez ve daha da kötüsü, Sakujirou için bu işin geri dönüşü olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120620
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120620,
					"content": "#Bunun olmasına izin veremeyiz. Benimle gel {NICKNAME}, onları takip edelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
		},
