			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Imatani Kaori",
					"Imatani Saburou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120101,
					"content": "Aaa, bu Yoimiya değil mi? İçeri gel canım, gel de otur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120102
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120102,
					"content": "Bu ikisi senin arkadaşların mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120103
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120103,
					"content": "Evet, onlar uzaktan gelen gezginler. Bugünlerde yabancıların Inazuma'ya girmesi oldukça zor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120104
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120104,
					"content": "Aslında benzeri görülmemiş bir zamanda yaşıyoruz. Ama bu kadar yoldan geldiklerini görünce, yerliler olarak onları hoş karşılamamız gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120105
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120105,
					"content": "Mm-hım... Ha unutmadan, istediğiniz havai fişekleri getirdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120106
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120106,
					"content": "Ah, teşekkürler canım. Ailen, her yıl bize çok iyi davranıyor. Önce baban, şimdi de sen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120107
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120107,
					"content": "Naganohara Havai Fişekleri'nin sonraki varisini görecek kadar yaşar mıyım bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120108
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120108,
					"content": "Bir sonrakini değil, çok sonrakini de görürsünüz, ikiniz de çok sağlıklısınız! Böyle şeyler söylemeyin, kötü şans getirir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120109
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120109,
					"content": "*iç çeker* Yine de eskisi gibi genç değiliz. Vücudumuz bunun farkında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120110
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120110,
					"content": "Eskiden bütün günü tarlada çalışarak, bir oraya bir buraya su taşıyarak geçirirdim ama şimdi hafif bir iş yapsam bile her yerim ağrıyor ve acıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120111
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120111,
					"content": "Dün biraz otları temizleyeyim dedim ama başlamak için eğilir eğilmez, az daha ileri gidersem tekrar ayağa kalkamayacağımı hissettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120112
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120112,
					"content": "Endişelenme, önemli değil. Biz hallederiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120113
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120113,
					"content": "Hayır, hayır olmaz. Evimizdeki misafire iş yaptıramayız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120114
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120114,
					"content": "Gidip biraz çay ve atıştırmalık bir şeyler getireyim. Sohbetimize öyle devam edelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120115
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120115,
					"content": "Sorun değil, size bu tür işlerde daha önce de yardım ediyordum. Yaklaşan havai fişek gösterisi nedeniyle son zamanlarda çok vaktim olmadı ama daha sonra kesinlikle sık sık geleceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120116
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120116,
					"content": "Hiç sorun değil, gerçekten. Yardımcı olmaktan mutluluk duyarız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120120117,
					"content": "*iç çeker* Siz çok iyi çocuklarsınız. Benim çocuğuma gelince, o da artık büyüdü, henüz birini bulamadı ve çok sık ziyaretime gelmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120118
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120118,
					"content": "Sorun olmayacağından kesinlikle eminseniz, o halde... Burada biraz turp turşum var, bunları köyün diğer ucundaki Satoru'ya götürebilir misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120119
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120119,
					"content": "Tabii, hiç zamanımızı almaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120120
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120120,
					"content": "Yaşlılar çok hızlı hareket edemiyor, o yüzden onlara yardımcı olalım. İlk önce <color=#00E1FFFF>yabani otlardan kurtulalım</color> ve sonra da <color=#00E1FFFF>turp turşusunu götürelim</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
		},
		{
			"id": 1201204,
			"completionStepIds": [
				1201204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201204",
							"2"
						],
						"stepId": 1201204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Satoru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120401,
					"content": "Merhaba Satoru, nasılsın? Her şey yolunda mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120402
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120402,
					"content": "Her zamanki gibi, pek değişmemişsin. Yine çok hayat dolu görünüyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120403
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120403,
					"content": "Sadık müşterilerimizin desteği sayesinde. Aile şirketi sürekli daha iyiye gidiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120404
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120404,
					"content": "Bir süre önce Liyue'ye biraz havai fişek sattık ve çok memnun kaldılar. Gelecekte onlardan daha fazla iş alırız gibi görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120405
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120405,
					"content": "Bu daha çok çalışacağın anlamına geliyor olmalı, değil mi? Bay Ryuunosuke ile ikiniz bu işin üstesinden gelebileceğinize emin misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120406
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120406,
					"content": "Çok ağır gelirse, daima benden yardım isteyebileceğini unutma. Tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120407
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120407,
					"content": "Sorun olmaz gibi... Bence halledebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120408
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120408,
					"content": "Ah, evet. Bayan Imatani biraz turp turşusu gönderdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120409
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120409,
					"content": "Ah, çok teşekkür ederim! İnanır mısın, eskiden turp turşusunu hiç sevmezdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120410
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120410,
					"content": "Sonra Bayan Imatani'nin evde yaptığı bu turşuyu denedim ve ondan sonra tadına doyamadım. Ailecek müdavimi olduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120411
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120411,
					"content": "Ailenden bahsetmişken, hepsi iyiler mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120412
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120412,
					"content": "Herkes iyi. Arada sırada gergin tartışmalarımız oluyor ama... Sanırım her ailede olan şeyler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120413
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120413,
					"content": "Ailene yakın olmak, onlarla yapılan tartışmalara katlanmak anlamına gelse de, onları hiç görememekten iyidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120414
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120414,
					"content": "Bay ve Bayan Imatani'nin iyi bir ilişkisi var gibi ama çocukları hiç ziyaret etmediği için yalnızlık çekiyor olmalılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120415
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120415,
					"content": "Hah, bana hiç öyle görünmediler. Bence alışmışlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120416
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120416,
					"content": "Yine de doğru söyledin. Artık onlara daha fazla uğramalıyım. Böylece çok sıkılmazlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120417
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120417,
					"content": "Bence çok sevinirler, Konda Köyü'ndeki herkes senin sık sık gelip gitmeni ister.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120418
					],
					"speakerTitle": "Satoru"
				},
				{
					"id": 120120418,
					"content": "Hehe, teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
		},
		{
			"id": 1201205,
			"completionStepIds": [
				1201205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201205",
							"2"
						],
						"stepId": 1201205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Imatani Kaori"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120120501,
					"content": "Bu, oldukça hızlıydı! Ah, işi gençlere bırakacaksın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120502
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120502,
					"content": "Gençler enerjiyle, yaşlılar ise bilgelik ve deneyimle dolular. Herkesin güçlü yanları var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120503
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120503,
					"content": "Gençlikten bahsetmişken... Biliyor musun? Bu yıl tam 50 yıl oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120504
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120504,
					"content": "Ah, evet! Tanrım, zaman ne çabuk geçiyor. Yıllar geçerken insan fark etmiyor ama bir anda 50 yıl geçmiş oluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120505
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120505,
					"content": "Neyin üzerinden 50 yıl geçmiş? Önemli bir gün mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120120506,
					"content": "Haha, peki. Merak ediyorsan 50 yıl önceydi, bu genç hanım kalbimi çalmaya çalışıyordu o günlerde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120507
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120507,
					"content": "Ah, beni etkilemeye çalışmayı bırak. İkimiz de, umutsuzca bana abayı yakanın ve çaresizce sevgimi kazanmaya çalışanın sen olduğunu biliyoruz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120508
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120508,
					"content": "Peki, haklı olabilirsin. 50 yıl önce, karıma Naganohara Havai Fişekleri Gösterisinde evlenme teklifi etmiştim. O zamandan beri birlikteyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120509,
						120120510
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120509,
					"content": "İkinizi de tebrik ederim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120511
					]
				},
				{
					"id": 120120511,
					"content": "Gerçeği söylemek gerekirse tam olarak emin değildim. Naganoharaların dükkanına girip havai fişek istediğimde, ne yaptığımı kendim bile tam bilmiyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120512
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120512,
					"content": "Hatta havai fişekler havaya yükselirken bile... Ne söyleyeceğim hakkında hiçbir fikrim yoktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120513
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120513,
					"content": "Sonra havai fişek patladı, gökyüzü aydınlandı... Ona baktım ve havai fişeklerin ışığıyla parlayan gözlerini gördüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120514
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120514,
					"content": "... Tam olarak neler olduğunu anlayamadan, ben ona teklif ettim, o da bana \"evet\" dedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120515
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120515,
					"content": "50 yıl... Duruma göre hem çok uzun, hem de çok kısa bir süre. Aslında sadece bir sayı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120516
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120516,
					"content": "Ama 50 yıl birlikte olunca... Kesinlikle anmaya değer bir şey oluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120517
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120517,
					"content": "50. yıl dönümünüz olduğunu hiç bilmiyordum. Bilseydim, yalnızca size özel biraz daha şık havai fişekler yapardım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120518
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120518,
					"content": "Ah hayır, hiç sorun değil. Her yıl aynı havai fişeği patlatırız biz. O olmadan aynı olmazdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120519
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120519,
					"content": "O havai fişeğin yükseldiğini görmek, bizi o günlere götürüyor. Bu yaşımızda bile hâlâ hiçbir pişmanlık duymadan geçmişe bakabiliyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120520
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120520,
					"content": "Ah, ne kadar harika bir ilişkileri var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120120521,
					"content": "Bizden bu kadar bahsettik, yeter. Yoimiya, yaklaşan havai fişek gösterisiyle ilgilenmiyor muydun sen? Konuşman gereken bir şeyler mi vardı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120522
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120522,
					"content": "Evet, hım... Konuşması biraz zor bir konu ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120523
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120523,
					"content": "Hım... Sakujirou... Geri geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120524
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120524,
					"content": "Ne? Onu tanıyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120525
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120525,
					"content": "Gençken oğlumuzun en yakın arkadaşıydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120526
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120526,
					"content": "*iç çeker* Hiç ayrılmazlardı. Birlikte büyüdüler, her şeyi paylaştılar ve her yere birlikte gittiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120527
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120527,
					"content": "Ama bir gün, çok kötü kavga ettiler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120528
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120528,
					"content": "Sakujirou, Inazuma'nın çok huzurlu bir yer olduğunu sanıyordu ve dış dünyanın nasıl bir yer olduğunu görmek istedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120529
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120529,
					"content": "Ama Keisuke'miz annesine ve babasına benziyordu. Huzurlu olmak gibisinin olmadığını düşünüyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120530
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120530,
					"content": "Çocukların nasıl olduğunu bilirsin, bu tür konularda duyguları giderek yoğunlaşır. Sonunda Sakujirou çekip gitti ve arkadaşlıkları bitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120531
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120531,
					"content": "Anladım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120532
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120532,
					"content": "Keisuke, kavgalarıyla ilgili bana veya eşime hiçbir şey söylemedi. Çok incindiğini anlayabiliyorduk ama gerçekte nasıl hissettiğiyle ilgili bizimle konuşmak istemedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120533
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120533,
					"content": "Sonunda bastırılmış öfkesinden veya başka bir nedenden dolayı Tenryou Heyetine katıldı. Buraya artık çok nadiren geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120534
					],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120534,
					"content": "Başka bir şey olsaydı, Keisuke ile konuşabilirdim ve eminim ki o da yardımcı olmak isterdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120535
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120535,
					"content": "Ama Sakujirou hakkında bir şey olduğundan... Sanırım bizim dahil olabileceğimiz pek bir şey yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120536
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120536,
					"content": "Ne kadar tuhaf bir rastlantı. Kimin aklına gelirdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120537
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120120537,
					"content": "Şimdi anlıyorum. Sakujirou'ya neden geri geldiğini sorduğumda \"geçmişteki hatalardan dolayı\" demişti ve daha fazla bir şey söylemek istememişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120538
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120538,
					"content": "Ne yapacağına neden karar veremediğini şimdi anlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120539
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120539,
					"content": "Çocukluktaki en yakın iki arkadaş... Biri büyüyüp Tenryou Heyetine katılıyor ve diğeri de Tenryou Heyetinin en çok arananlar listesine giriyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120540,
						120120541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120120540,
					"content": "Kader denilen şey bu olsa gerek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120542
					]
				},
				{
					"id": 120120542,
					"content": "Peki, sorun değil. Durum buysa boş verin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120543
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120543,
					"content": "Sakujirou'ya yardımcı olmanın başka bir yolunu bulabiliriz, sizin açınızdan işleri zorlaştırmaya gerek yok. Bu, Sakujirou ve Keisuke'nin kendi aralarında çözmesi gereken bir şey gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120544
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120120544,
					"content": "Evet, her şey eskisi gibi olsa çok iyi olurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120120545
					],
					"speakerTitle": "Imatani Kaori"
				},
				{
					"id": 120120545,
					"content": "Bence bu kadar yıldan sonra kinlerini bir kenara bırakmalılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Imatani Saburou"
				},
				{
					"id": 120120541,
					"content": "İkisini de asla böyle hayal edemezdim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120542
					]
				},
				{
					"id": 120120510,
					"content": "Sahip olduğunuz şeyle gurur duyuyor olmalısınız.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120120511
					]
				}
			]
		},
		{
			"id": 1201206,
			"completionStepIds": [
				1201206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
