			"dialogs": [
				{
					"id": 750711001,
					"content": "#Haha, çok sevgili {NICKNAME} ve Paimon, ilham perim ve... Minik ilham perim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711002
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711002,
					"content": "#Tabii bir de {REALNAME[ID(2)|SHOWHOST(true)]} var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711003
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711003,
					"content": "Hıh! Paimon minik değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711004,
					"content": "Raaar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711005
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750711005,
					"content": "Haha, gel hadi, bana aldırış etme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711006
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711006,
					"content": "Hıh. Paimon sana öyle bir aldırış edecek ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711007,
						750711011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711007,
					"content": "Yine ilham mı geldi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750711008
					]
				},
				{
					"id": 750711008,
					"content": "Elbette! Ancak... Hehe, yeni ilham demek... Sizden bir kez daha yardım isteyeceğim demek oluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711009
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711009,
					"content": "Sorun değil! Ödemesini yapıyorsun nasıl olsa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711010,
					"content": "Haha, harika! İşte benim küçük paralı askerim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711017
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711017,
					"content": "Bakın, şimdi de bir Tepetlizorun fotoğrafını çekeceğim.. Şşş. Dikkatli olun, onu rahatsız etmeyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711018
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711018,
					"content": "Bu Sürüngenleri bir süredir gözlemliyordum ama onlarla ilk defa etkileşime geçiyorum... Olağanüstü yaratıklar gerçekten. Her biri sert kabuğunun altında benzersiz bir karaktere sahip.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711019
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711019,
					"content": "Hehe, bunu birkaç kez besledikten sonra temel komutları öğrendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711020
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711020,
					"content": "Ancak inatçı Sürüngeni buraya getirmek ve onun dost Tepetlizorlarla kurduğu etkileşimi fotoğraflamak için sizin yardımınıza ihtiyacım olacak sevgili Sürüngen terbiyecileri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711021
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711021,
					"content": "Hehe, basit bir görev, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711022
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711022,
					"content": "Evet, aşırı kolay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711023,
						750711024
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711023,
					"content": "(Sana göre hava hoş tabii...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750711025
					]
				},
				{
					"id": 750711025,
					"content": "Haha, işte aradığım ruh! O halde hadi, sürüden ayrılan Tepetlizoru bana getirin de başlayalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711024,
					"content": "(Ayrıca sandığın kadar kolay değil!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750711025
					]
				},
				{
					"id": 750711011,
					"content": "Yine ilham peynirlerinin yardımına ihtiyacın olacak mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750711012
					]
				},
				{
					"id": 750711012,
					"content": "Peynir mi... Hehe, Paimon şimdiden acıktı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711013,
					"content": "Guruuu... Guruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711014
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750711014,
					"content": "Ha, \"peri\" mi demek istedin? O yiyecek bir şey değil ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711015
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711015,
					"content": "Hehe, sen ödemeyi yap da, Paimon o Moraları nasıl yemeğe dönüştüreceğini bilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711016,
					"content": "Öyle diyorsan öyledir Paimon... Ama param var, o yüzden sizi bedavaya çalıştırırım diye endişelenmene gerek yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711017
					],
					"speakerTitle": "Magnifico"
				}
			]
		},
