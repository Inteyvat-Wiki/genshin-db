			"dialogs": [
				{
					"id": 750711321,
					"content": "Düşmanı yenip küçük Yük Hayvanının hapsolduğu kafesin kapısını açıyorsunuz. Yük Hayvanı kafesten dışarı fırlıyor ve neşeyle çığlık atıyor.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750711301
					]
				},
				{
					"id": 750711301,
					"content": "Uf... Oh be! Sonunda bitti. Amma koşuşturduk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711302,
					"content": "Şşş! Bakın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711303
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711303,
					"content": "*çıkıt*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711304
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711304,
					"content": "Mükemmel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711305
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711305,
					"content": "Vay canına, ne kadar da iyi anlaşıyorlar... Paimon da Yük Hayvanının mideye indirileceğini falan sandı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711306,
					"content": "Hehe, yok canım. Tepetlizorlar sert görünseler ruhları narindir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711307
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711307,
					"content": "Fotoğrafı çektim, bir kopyası sizde kalıyor. Hah, işte bu da ödemeniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711308
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711308,
					"content": "*iç çeker* Burada yetişkin ve yavru Tepetlizor arasında samimi bir an yakalamayı düşünmüştüm ama Yük Hayvanının bir adım önde olacağını tahmin edemedim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711309
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711309,
					"content": "Hehe, hadi ama, Yük Hayvanları o kadar da sinir bozucu değiller. Sen de böyle düşünüyor olmalısın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711310,
					"content": "Önemli olan benim ne düşündüğüm değil, fotoğraf değerlendirme komitesinin ne düşündüğü!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711311
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711311,
					"content": "Yine de... Küçük Yük Hayvanımızın Natlan'ın bilinmeyen yerlerinde dolaşması çok tehlikeli olabilir. Hem benim de birkaç eşyamı taşıyacak bir yardımcıya ihtiyacım var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711312
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711312,
					"content": "Onu sahiplenebilirim sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711313
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711313,
					"content": "Şu anki sahibi ne olacak peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750711314,
					"content": "Hıh. Bu küçük hayvanı böyle tehlikeli bir yerde bırakmak onun suçu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711317
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711317,
					"content": "Neyse artık, bu bahsi kapatalım! Bekleyin beni Fontaine'in fotoğraf galerileri, geliyorum! Haha... Vakti geldiğinde sizi ziyarete bekliyor olacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750711318
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750711318,
					"content": "#Üzgünüm ancak bu ulustan ayrılma zamanı geldi benim için. Elveda {NICKNAME}, elveda Paimon! Elveda küçük dostum!",
