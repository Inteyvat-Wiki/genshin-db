						],
						"pointId": 8682
					}
				]
			},
			"dialogs": [
				{
					"id": 750700701,
					"content": "Haha! Yeniden karşılaşacağımızı biliyordum! Üstelik zamanlamanız mükemmel. Şimdi benim ikinci şaheserime tanıklık edeceksiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700702
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700702,
					"content": "Hımm... Belki de ikinci değildir. Daha bir sürü başarılı eserim var sonuçta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700703
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700703,
					"content": "Her halükarda çok şanslısınız çünkü benim ilk kez dinamik fotoğrafçılığı deneyişime tanık olacaksınız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700704
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700704,
					"content": "Ne de olsa daha önce çektiğim fotoğrafların hepsi olay yerindeki kurbanlara aitti... Şey, boş verin. Bu konunun ayrıntılarına girmeye hiç gerek yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700705
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700705,
					"content": "Ee? Yine yardımımıza ihtiyacınız olacak mı Bay Magnifico?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750700706,
					"content": "Raarr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700707
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750700707,
					"content": "Hayır, hayır, kesinlikle hay... Hımm, gerçi etseniz süper olurdu! Hadi gelin, size durumu anlatayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700708
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700708,
					"content": "Durum şu, bir Gukuzorun bu şelalenin döküldüğü göletin yüzeyine dalışını fotoğraflamam gerekiyor. En etkileyici kareleri yakalamalıyız, bu yüzden tam olarak suya daldığı andaki görüntüyü istiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700709
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700709,
					"content": "Şelalenin altındaki gölete Gukuzorları cezbedecek yiyecekler de sakladım. Fakat... *iç çeker* Şey, henüz doğru kamera açısında değiller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700710
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700710,
					"content": "Hımm? Bir saniye, suyun yüzeyindeki şu büyük daire de neyin nesi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750700711,
					"content": "Çok önemli bir şey değil, gerçi ne olduğundan ben de pek emin değilim ama... Hedef olarak kullanmak üzere yakındaki bir kabileden bulduğum bir hurda sadece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700712
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700712,
					"content": "*iç çeker* Şimdiye kadar çektiğim fotoğraflar öyle dandik ki insanın siniri bozuluyor. Beklemeye devam edebilirim ama madem buradasınız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700713
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700713,
					"content": "Acaba diyorum... Onları yönlendirseniz mi? Suya en güzel nasıl dalınacağını gösterseniz mesela? Ne de olsa siz Natlan'ın her yerinde tanınan meşhur Sürüngen terbiyecilerisiniz, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700714
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700714,
					"content": "Kabul mü? Harika! Ben buradan bir işaret göndereceğim. Geriye doğru sayıp \"bir\" dediğimde, sudaki işaretli hedefe dalacaksınız, işte bu kadar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700715,
						750700717
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700715,
					"content": "Deneyelim bakalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750700716
					]
				},
				{
					"id": 750700716,
					"content": "Haha, harika! Deneyelim o halde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700717,
					"content": "Başarılı olacağını garanti edemeyiz...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750700718
					]
				},
				{
					"id": 750700718,
					"content": "Sorun değil. Başarısız olursak kaybedeceğimiz tek şey zamanımız olur. Ayrıca biz gezginiz, zamandan daha bol bir şeyimiz yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750700719,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				}
			]
		},
