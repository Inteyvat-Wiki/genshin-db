			"dialogs": [
				{
					"id": 750700901,
					"content": "Haha! Mükemmel! Bir kopya da sana vereyim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700902
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700902,
					"content": "Vay canına, bu gerçekten çok güzel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750700903,
					"content": "İşte ödülünüz. Bu bana ikinci... Yok, üçüncü kez yardım edişiniz. Siz olmasaydınız... Fotoğraf çekme serüvenimi asla tamamlayamazdım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700904
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700904,
					"content": "Şimdi gideceğim yer... Tam şurası. Haritanızda işaretledim. Eğer ilginizi çekerse sizinle yeniden seve seve çalışabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700905
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700905,
					"content": "Oo, vakit gelmiş. Artık gitmeliyim. Görüşmek üzere ve iyi şanslar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750700906
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750700906,
					"content": "Magnifico eşyalarını toplar ve mutlu bir şekilde sıcak hava balonuna atlar.\\nBalon yavaşça gözden kaybolurken gürültülü kahkahaları da uzaklarda yankılanmaya başlar...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
