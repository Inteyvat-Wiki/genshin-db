					"nextDialogs": [
						750701606
					]
				},
				{
					"id": 750701606,
					"content": "Pes etmek mi? Kim pes ediyormuş? Hiç de bile! Öfke ve utanç beni daha çok hareket geçirir, bana daha fazla güç verir. Onların işlevi bu! Şimdi devam edelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701607
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750701607,
					"content": "İyice gaza geldi... Yine de çok tuhaf biri.",
