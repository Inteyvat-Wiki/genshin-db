			"dialogs": [
				{
					"id": 750701401,
					"content": "Of, en baştan yapmalıyız! ... Şey, yani sizin için de mahzuru yoksa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701402
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750701402,
					"content": "*iç çeker* Sorun \"olsa\" ne olur, \"olmasa\" ne olur? Sonuçta buradayız, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701403,
						750701405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750701403,
					"content": "Devam edelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750701404
					]
				},
				{
					"id": 750701404,
					"content": "Çok teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750701405,
					"content": "Önce biraz ara verelim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750701406
					]
				},
				{
					"id": 750701406,
					"content": "İyi olur. Kayalıklardan atlamak kolay iş değil malum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750701407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750701407,
					"content": "Ha... Evet. Onu hesap edemedim. Pekala, ne zaman hazır hissederseniz o zaman başlayalım. Sizi burada bekleyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				}
			]
		},
