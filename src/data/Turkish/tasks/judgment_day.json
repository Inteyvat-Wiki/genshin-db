			"dialogs": [
				{
					"id": 140310201,
					"content": "Beklettim, kusura bakmayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310202
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140310202,
					"content": "#Aa, dönmüşsün! Hı? {NICKNAME} ile Paimon'u da getirmişsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310203
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140310203,
					"content": "Ne hoş bir sürpriz. Oyunda bize eşlik edeceksiniz, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310204
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140310204,
					"content": "Lyney! Furina! Paimon sizin de oynayacağınızı bilmiyordu! Siz de mi Masa Oyunu Topluluğunun üyesisiniz yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140310205,
					"content": "Selam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310206
					]
				},
				{
					"id": 140310206,
					"content": "Hımm, ben daha çok sıradan bir üyeyim. Resmi kulüp etkinliklerine de katılmam pek. Lynette ve Freminet'yle birlikte bazen Bouffes d'Été Otelde toplanıp benzer oyunlar oynarız ama ben genelde Oyun Yöneticisi olurum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310207
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140310207,
					"content": "Yine de ilk defa oyuncu olmak oldukça eğlenceli olacaktır. Merakla bekliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310208
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140310208,
					"content": "Ben kulübe üye değilim aslında. Clorinde sabah beni uyandırıp denemeye değer güzel bir senaryo olduğu söyledi ve katılmak isteyip istemediğimi sordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310209
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140310209,
					"content": "İlgileniyorsan seni önerebilirim. Üyelik ücretinde de %40 indirim kazanırsın böylece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310210
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140310210,
					"content": "Önce bir bu deneyim nasıl sonuçlanacak onu göreyim. Özellikle de senaryonun kalitesini merak ediyorum. Yeterince eğlenceli olursa katılırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310211
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140310211,
					"content": "Sen Masa Oyunu Topluluğunun etkinliklerine sık sık katılır mısın Clorinde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140310212,
					"content": "Öyle de diyebiliriz. Kendisi Topluluktaki \"Kıdemli Oyun Yönetici\"lerinden biridir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310213
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140310213,
					"content": "Doğru. Kendisi daha benim astımken bile biliyordum bunu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310214
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140310214,
					"content": "... Önemli bir şey değil cidden. Sadece bir hobi işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310215
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140310215,
					"content": "Vay be, Paimon seni hep dimdik duran ve göz korkutan bir Düello Şampiyonu olarak görmeye alışkın. Arkadaşlarınla birlikte rol yapma oyunu oynadığını hayal edemedi bir an...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310216,
						140310217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140310216,
					"content": "Peki, kurallarla ilgili bir sorunla karşılaşırsak...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310218
					]
				},
				{
					"id": 140310218,
					"content": "Şaka yapıyorsun herhalde. Oyuncularım için işleri bilerek zorlaştırmam asla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310219
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140310219,
					"content": "Profesyonel hayatımla özel hayatım arasında net bir çizgi vardır hep. Mahkemedeyken Fontaine'in kanun ve düzenini temsil ederim. Tüm kişisel duygularımı bir yana koyarak onurunu korumak isteyen herkese adil bir düello şansı tanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310220
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140310220,
					"content": "Ancak özel hayatımda, ben yalnızca sıradan biriyim. Tıpkı diğer herkes gibi yeri gelir sinirlenir, yeri gelir üzülürüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310221
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140310221,
					"content": "Öyle diyorsun ama ben seni tanıdım tanıyalı hiç ağladığını görmedim... Sinirlendiğini gördüm tabii ama... Şimdi düşününce, acaba gerçekten sinirli miydin yoksa dışarıdan mı öyle görünüyordun bilemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310222
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140310222,
					"content": "Muhtemelen kafam işteydi o sırada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310223
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140310223,
					"content": "Öyle mi? Neyse yani, bana özel hayatında bile pek duygulanıyormuşsun gibi gelmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310224
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140310224,
					"content": "Ağladığımı mı görmek istiyorsun? O biraz zor olabilir. Ama öfkelendiğimi görmek istersen... Bir şeyler yapabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310225
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140310225,
					"content": "Y-Yok, öyle demek istemedim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310226
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140310226,
					"content": "Ben geldim! Sizi senaryo yöneticimiz Bay Florian ile tanıştırayım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310227
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140310227,
					"content": "Tanıştığımıza memnun oldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310228
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140310228,
					"content": "Merhaba! Bir dakika, yoksa siz de mi Düello Şampiyonusunuz Bay Florian?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140310229,
					"content": "Hayır. Bu sadece kulübün verdiği bir kostüm. Arada bir senaryolarımdaki rollerden bazılarını oynarım da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310230
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140310230,
					"content": "Epey zahmetli bir iş o zaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310231
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140310231,
					"content": "O kadar da değil. Oyunculara daha sürükleyici bir deneyim yaşatmak için yapabileceklerimizin küçük bir parçası.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310232
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140310232,
					"content": "Her neyse, size kısaca senaryoyu tanıtayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310233
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140310233,
					"content": "Bu senaryo, Mareşose Avcılarının gerçek tarihinden uyarlandı. Hepiniz o geçmiş dönemden bir Avcıyı oynayacaksınız ve başkentte gerçekleşen bir dizi olayı çözmeye çalışacaksınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310234
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140310234,
					"content": "Iıı... Paimon, Mareşose Avcılarının tarihini pek bilmiyor. Sorun olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140310235,
					"content": "Hiç sorun değil. Ben hemen durumu kısaca özetleyeyim. Mareşose Avcıları, nesiller boyunca aktarılan özel kılıç teknikleriyle canavarları avlamaya ve şehri korumaya kendilerini adamışlardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310236
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140310236,
					"content": "Hikayeleri de kadim Remuria Hanedanlığı'na ve ilk avcı olan Cassiodor'a kadar uzanıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310237
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140310237,
					"content": "Ama tabii ufak detayları anlatmayacağım ki siz daha sonra kendiniz keşfedebilin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310238
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140310238,
					"content": "Ben de hikaye ilerledikçe daha fazla açıklama yapacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310239
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140310239,
					"content": "O halde... Öhöm! Cesur yürekli avcılar, bilinmeyen bir maceraya atılmaya hazır mısınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310240
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140310240,
					"content": "Ayy! Bir cümleyle hikayeye aniden giriverdik sanki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140310241,
					"content": "Bir sürü kararlı bakış görüyorum karşımda! Güzel. O zaman bu konuma gidin ve kahramanlık yolculuğunuz başlasın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310242
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140310242,
					"content": "Yani hikayeyi takip ettikçe bizi belirli sahnelere mi yönlendirecek? Epey yenilikçi olmuş. Zarftaki mesajda ne diyor peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310243
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140310243,
					"content": "Sahnenin tam yeri ve resmi kullanım izni var. Her şey detaylıca hazırlanmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310244
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140310244,
					"content": "Lütfen tüm eşyalarınızı kontrol edin ve bir şey unutmadığınızdan emin olun. Hazır olduğunuzda lütfen beni belirlenen konuma doğru takip edin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310245
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140310245,
					"content": "Güzel! Avcı birliği, gidelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140310217,
					"content": "Bir düello talebinde mi bulunmamız gerekiyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310218
					]
				}
			]
		}
	]
}