			"dialogs": [
				{
					"id": 140310101,
					"content": "... Hâlâ bir sonuç çıkmadı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310102
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140310102,
					"content": "Hayır, neredeyse Fontaine Şehri'ndeki herkese de sordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310103
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140310103,
					"content": "Lynette zaten günlerce dışarıda olacağımızı duyunca hemen kulaklarını düşürdü. Freminet de... Etrafta tanımadığı insanların olacağını anladığı gibi kaskının ardına saklandı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310104
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140310104,
					"content": "Peki ya Chiori ile Charlotte? Onlar istekli olur bence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310105
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140310105,
					"content": "Onlara çoktan sordum ama ikisi de şu anda epey meşguller. Ben de Spina üyelerine birkaç gün izin vermiştim, o yüzden onları da rahatsız etmek istemiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310106
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140310106,
					"content": "Hımm... Bu iş gittikçe zorlaşıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310107
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140310107,
					"content": "Navia! Clorinde! Selam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140310108,
					"content": "Ah, benim sevgili ortaklarım gelmiş! Nasılsınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310109
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140310109,
					"content": "Navia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310110
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140310110,
					"content": "Hı? ... Aa! Yani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310111
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140310111,
					"content": "Evet, fırsat bu fırsat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310112,
						140310113
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140310112,
					"content": "... N-Ne yapacaksınız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310114
					]
				},
				{
					"id": 140310114,
					"content": "Yardımcı olabileceğimiz bir şey var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140310115,
					"content": "Evet! Sevgili ortaklarım, şu anda büyük bir sorunumuz var ki bunu yalnızca siz çözebilirsiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310116
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140310116,
					"content": "Aaa! Cidden mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140310117,
					"content": "Aynen öyle. Diğer tüm seçeneklerimizi tükettik bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310118,
						140310119
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140310118,
					"content": "Nasıl bir sorun peki bu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310120
					]
				},
				{
					"id": 140310120,
					"content": "#{NICKNAME}, Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310121
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140310121,
					"content": "Birlikte \"Mareşose Avcısı: Kıyamet Günü\" oynayalım mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310122
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140310122,
					"content": "Mareşose neyi dedin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140310123,
					"content": "Bu, yerel bir rol yapma macera kulübü olan Masa Oyunu Topluluğunun yazdığı yeni bir oyun senaryosu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310124
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140310124,
					"content": "Masa Oyunu Topluluğunu duydunuz mu hiç? Arkadaşlarınızla birlikte bir hikayeye katılıp karakterleri canlandırabildiğiniz oyunlar hazırlıyorlar. Çocukluğumdan beri bayılırım yaptıkları oyunlara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310125
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140310125,
					"content": "Epey ilginçmiş bu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140310126,
					"content": "Clorinde ile ben bu kulübün kıdemli üyeleriyiz. Geçenlerde biri yeni bir senaryoyla çıkageldi ve oyunu test etmesine yardımcı olacak birilerini arıyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310127
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140310127,
					"content": "Ben de reddedemedim haliyle. Yani sonuçta, henüz kimsenin oynamadığı yepyeni bir oyun senaryosu gelmiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310128
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140310128,
					"content": "Hıhı, genelde bu seviyedeki senaryolarda pek çok sorun olur aslında ama bu epey sağlam bence. Yazar belli ki hikayeye çok emek vermiş, dünya kurgulaması da çok iyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310129
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140310129,
					"content": "Hey, hey, dur! Sana senaryoyu ben verdim ama bazılarımız daha okumadı sonuçta! Anlatıp da heyecanını kaçırma lütfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310130
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140310130,
					"content": "... Neyse, senaryoya göre dört kişilik bir takım gerekiyor. Evet, şu anda bir oyuncumuz eksik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310131
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140310131,
					"content": "Haklıymışsın, bu büyük bir sorun!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310132
					]
				},
				{
					"id": 140310132,
					"content": "Yani... Bize yardım edecek misin? Sana güvenebileceğimi biliyordum ortak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310133
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140310133,
					"content": "#{NICKNAME} ve Paimon'u bir ekip olarak düşünelim. Olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140310134,
					"content": "Sorun değil. Oyun hızını, oyuncu sayısına göre ayarlayıp herkesin eğlenmesini sağlayabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310135
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140310135,
					"content": "#Ne dersin {NICKNAME}? Oynamak ister misin? Paimon sana ayak uydurur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310136,
						140310137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140310136,
					"content": "Yardıma ihtiyacı olan bir arkadaşım varsa her daim yardım ederim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310138
					]
				},
				{
					"id": 140310138,
					"content": "Pekala, sorunumuz çözüldü o halde. Teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310139
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140310139,
					"content": "Yaşasın! Ben hemen gidip kulüpten senaryo yönetmenini çağırayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310140
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140310140,
					"content": "Senaryo yönetmeni mi? Daha az önce senaryoyu Clorinde'e verdiğini söylememiş miydin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140310141,
					"content": "Kulüp, bu senaryo için tamamen yeni bir oyun hazırladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310142
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140310142,
					"content": "Bu versiyonda Oyun Yöneticisinin elindeki senaryo tamamlanmış halde değil. Senaryo yöneticisinden oyunun kalan bölümünü alabilmek için oyuncuların önce mevcut hedef listesini tamamlaması gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310143
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140310143,
					"content": "Ayrıca kulüp, oyuncuların kendilerini daha da fazla hikayenin içinde hissedebilmeleri için bazı set ve sahneleri gerçekte de hazırladı. Nereye gitmemiz gerektiğini de ancak senaryo yöneticisi başlangıç noktasını açıkladığında öğreneceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310144
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140310144,
					"content": "Vay be, haklıymışsın. Bu senaryoyu kim yazdıysa epey emek vermiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140310145,
					"content": "Hehe, çok heyecanlı, değil mi? Oyun Yöneticisi bile oyunun nasıl sonlanacağını bilmiyor yani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310146
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140310146,
					"content": "Ben de sizinle birlikte deneyimlemek için sabırsızlanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310147
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140310147,
					"content": "Önce gidip diğerleriyle buluşun siz, olur mu? Butik Chioriya'da bekliyor olmalılar. Ben de senaryo yöneticisini bulup onunla birlikte geleceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310148
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140310148,
					"content": "Olur. Yolda dikkatli olmayı unutma, acele de etme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310149
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140310149,
					"content": "Ne bu, ufacık çocuk muyum ben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310150
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140310150,
					"content": "Hımm... Bir düşüneyim bakalım, bu defa nasıl bir karakteri oynasam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140310151
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140310151,
					"content": "... Umarım bu defa işe yarar becerilerin olur. Ha bir de yolda denk geldiğin her hayvanı \"ikna etmeye\" çalışmazsın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140310137,
					"content": "Madem senaryo güzel, ben varım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310138
					]
				},
				{
					"id": 140310119,
					"content": "Anlatsana...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310120
					]
				},
				{
					"id": 140310113,
					"content": "Biz sadece geçiyorduk aslında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140310114
					]
				}
			]
		},
