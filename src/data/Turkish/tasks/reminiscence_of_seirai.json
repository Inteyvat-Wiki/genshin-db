					"nextDialogs": [
						721630410
					]
				},
				{
					"id": 721630410,
					"content": "O da benimle aynı durumda desek daha doğru. İkimizin de ataları orada yaşamış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
