					"nextDialogs": [
						721630416
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630416,
					"content": "Neyse, bunun konumuzla ilgisi yok. Bu senin için. Emeklerin için teşekkür olarak kabul et.",
