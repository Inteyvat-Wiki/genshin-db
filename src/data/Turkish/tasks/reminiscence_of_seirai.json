			"dialogs": [
				{
					"id": 721630201,
					"content": "Hımm, başıma ağrılar giriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630202
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630202,
					"content": "Bu haritadan bir şey anlıyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630203
					]
				},
				{
					"id": 721630203,
					"content": "Coğrafi yapıya bakılırsa burası Seirai Adası'nda bir yer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630204
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630204,
					"content": "Nereden anladın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630205
					]
				},
				{
					"id": 721630205,
					"content": "Eskiden Lonca, Seirai Adası'na birkaç keşif görevi düzenlemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630206
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630206,
					"content": "Bu görevleri kabul eden maceracılar ada hakkında öğrendiklerini bize raporlayıp getirirlerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630207
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630207,
					"content": "Maalesef insan gücü eksiğimiz olduğundan büyük çapta keşifler düzenleyemedik. Biz de bölgeyi keşfetmek için belli aralıklarla birkaç maceracı göndermek durumunda kaldık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630208
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630208,
					"content": "Ne yazık ki haritayı analiz etmek konusunda pek yardımcı olamayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630209
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630209,
					"content": "Ama Seirai Adası'yla benden daha çok ilgilenen birini tanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630210
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630210,
					"content": "İsmi Oda Tarou. Duyduğuma göre farklı sebeplerden buraya göç etmeden önce ataları Seirai Adası'nda yaşıyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630211
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630211,
					"content": "Aklıma gelmişken, bir süre önce onunla Seirai Adası'nı görmeye gitmesi için Loncadan maceracı tutmak istemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630212
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 721630212,
					"content": "Bu haritayı ona sorabilirsin. Belki sorularını o cevaplayabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Furuya Noboru"
				}
			]
		},
