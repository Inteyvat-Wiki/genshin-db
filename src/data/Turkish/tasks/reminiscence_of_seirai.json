			"dialogs": [
				{
					"id": 721630401,
					"content": "Dönmüşsün. Nasıl gidiyor? Fotoğrafları çekebildin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630402
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630402,
					"content": "Elbette.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721630403
					]
				},
				{
					"id": 721630403,
					"content": "Mükemmel. Bakabilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630404
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630404,
					"content": "Ah... Şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630405
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630405,
					"content": "Ahaha! Bu mekanlar nerede hiçbir fikrim yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630406
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630406,
					"content": "Ailem oradan göçtüğünden beri oralar çok değişmiş galiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630407
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630407,
					"content": "Acaba Bayan Fujiwara Toshiko bunları görse tanır mıydı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630408
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630408,
					"content": "Tekrar düşününce... Pek sanmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721630409
					],
					"speakerTitle": "Oda Tarou"
				},
				{
					"id": 721630409,
					"content": "O da mı Seirai Adası'ndan?",
