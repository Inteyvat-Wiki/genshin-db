			"dialogs": [
				{
					"id": 766530201,
					"content": "Nerede yanlış yaptım acaba? Keşke daha fazla teorik bilgiden fazlasına sahip olsaydım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530202
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530202,
					"content": "Pekala, bu siparişi teyit etmeye gerek yok... Ginette, Fontaineli bir mühendis demek ha? Aldığım en ilginç sipariş bu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530203
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530203,
					"content": "Sonunda geldiniz! Demek hâlâ umut var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530204
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530204,
					"content": "Merhaba! Biz Aino'nun asistanlarıyız... Ya da Paimon bize böyle diyebileceğini düşünüyor. Nasıl yardımcı olabiliriz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530205,
					"content": "Kuuvahki kullanarak, uzak mesafeden iletişim kurabilen bir tür robot yaptı... Kulağa çok eğlenceli geliyor! Ama bir sürü arıza çıkardığından bunları çözmek için benden yardım istedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530206
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530206,
					"content": "İtiraf etmekten utanıyorum ama farklı yöntemleri denemeye olan merakım pek bir işe yaramadı. Sonuç olarak olay yine pratik yapmaya dayanıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530207
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530207,
					"content": "Çok zor olmasa gerek... Biz hallederiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530208,
					"content": "Biraz utanıyorum ama... Siparişimi değiştirmek istiyordum. Senden cevap beklerken... Şey, ortalığı daha da karıştırdım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530209
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530209,
					"content": "Birden aklıma, çevre değişikliğinin sorunu çözebileceği fikri geldi. O yüzden farklı Kuuvahki yoğunluğuna sahip bölgelerde daha fazla test yaptım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530210
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530210,
					"content": "... Ama arızalar devam etti ve robotları kaybettim. Yani... Anlaştığımız hata giderme dışında... Robotları bulmak için de yardıma ihtiyacım olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530211
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530211,
					"content": "Robotları kayıp mı ettin? Hepsini mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530212,
					"content": "Fazladan ödeme yapmamı isterseniz bir şekilde hallederim, söz veriyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530213
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766530213,
					"content": "Hımm... Ama robotların izlerini bulmanın birçok yolu olmalı. Hepsi gücünü Kuuvahkiden alıyor, o yüzden nereye giderlerse gitsinler arkalarında Kuuvahki kalıntısı bırakıyor olmalılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530214
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530214,
					"content": "Sizin için özel bir cihaz hazırlayacağım. Bunu kullanarak yeterince Kuuvahki kalıntısı topladığınızda, onları ardında bırakan robotu da bulabileceksiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530215
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530215,
					"content": "Hımm... Eğlenceli olacak! Bu yüzden fazladan ücret de istemeyeceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530216
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530216,
					"content": "Gerçekten mi? Teşekkürler, çok teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ginette"
				}
			]
		}
	]
}