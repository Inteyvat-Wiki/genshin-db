			"dialogs": [
				{
					"id": 760370201,
					"content": "(Bildiri panosunda hedefler hakkında ayrıntılı bilgiler bulunuyor...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
