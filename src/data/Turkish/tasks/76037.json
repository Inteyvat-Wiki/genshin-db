			"dialogs": [
				{
					"id": 760370101,
					"content": "Dört hedefe dair tüm ayrıntılar panoda asılı. Gerekirse sizi bilgilendirebilirim ama canavar avları konusunda pazarlık yapmaya kalkmayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370107,
						760370102,
						760370108
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760370107,
					"content": "Hedeflerin icabına baktığına dair kanıt sunuyorsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 760370102,
					"content": "Hedefler hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370103
					]
				},
				{
					"id": 760370103,
					"content": "Şu anda dört hedef var, ancak sadece üçünden iz var. İlki, dolandırıcılıktan aranan Sumerulu falcı Hidimbi. Genellikle <color=#00E1FFFF>güney rıhtımı</color> civarında oluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370104
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760370104,
					"content": "Sonra <color=#00E1FFFF>Boşluk Geçidi</color>'nden geçen birkaç gezgin tüccarın canını alan, kontrolden çıkmış bir Inazuma Kairagisi var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370105
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760370105,
					"content": "Bir sonraki ise tehlikeli mallarla uğraşan bir kaçakçılık çetesi, <color=#00E1FFFF>kasabanın kuzeyindeki sahilde bir kampta</color> saklandıkları bildiriliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370106
					],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760370106,
					"content": "Sonuncusu ise Kırık Çene lakaplı acımasız korsan Hark. Şu an için ona dair hiçbir ipucu yok. Muhtemelen saklanıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leszek"
				},
				{
					"id": 760370108,
					"content": "Görüşürüz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370109
					]
				},
				{
					"id": 760370109,
					"content": "Görüşürüz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leszek"
				}
			]
		},
