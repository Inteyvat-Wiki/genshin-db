			"dialogs": [
				{
					"id": 760370401,
					"content": "(Kairagi hakkında...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370402
					]
				},
				{
					"id": 760370402,
					"content": "\"Hedef: Gonpachi. Kairagi tarzı kıyafetler giyiyor, Inazumalı, erkek. Suçları: Gezgin tüccarlara rastgele saldırılar düzenlemek. Birden fazla can kaybı bildirildi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370403
					],
					"speakerTitle": "Ödül"
				},
				{
					"id": 760370403,
					"content": "\"Hedef en son <color=#00E1FFFF>Boşluk Geçidi</color> yakınlarında görüldü. Onu yenip öldüğüne dair kanıt getirenler Lonca tarafından cömertçe ödüllendirilecek.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ödül"
				}
			]
		},
		{
			"id": 7603705,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
