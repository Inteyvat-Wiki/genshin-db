			"dialogs": [
				{
					"id": 760370501,
					"content": "(Kaçakçılar hakkında...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370502
					]
				},
				{
					"id": 760370502,
					"content": "\"Hedef: Yeni Demir ve Tuz Çetesi. Suçları: Büyük çaplı kaçakçılık ve tehlikeli yasaklı malların ticareti.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370503
					],
					"speakerTitle": "Ödül"
				},
				{
					"id": 760370503,
					"content": "\"Soruşturmalar, çetenin <color=#00E1FFFF>kasabanın kuzeyindeki sahilde bir kampta</color> geçici bir üs bulundurduğunu gösteriyor. Kaçakçılık operasyonlarını durdurmaya yardımcı olanlar Spina di Rosula tarafından cömertçe ödüllendirilecek.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ödül"
				}
			]
		},
