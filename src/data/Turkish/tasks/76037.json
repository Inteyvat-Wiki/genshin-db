			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 760370301,
					"content": "(Hidimbi hakkında...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370302
					]
				},
				{
					"id": 760370302,
					"content": "\"Hedef: Hidimbi, Sumerulu bir falcı. Kadın, yaşı bilinmiyor. Suçları: Lanetleme ve büyük çaplı dolandırıcılık.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370303
					],
					"speakerTitle": "Ödül"
				},
				{
					"id": 760370303,
					"content": "\"O kadın beni 18 milyon Mora dolandırdı! Aşk Tanrısı Al-Ahmar'dan aldığını iddia ettiği kolyeyi takarsam, tüm kadınların bana ilk görüşte aşık olacağını söyledi!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370304
					],
					"speakerTitle": "Ödül"
				},
				{
					"id": 760370304,
					"content": "\"Meğer Al-Ahmar aşk tanrısı falan değilmiş. Binlerce yıl önce ölmüş ve sevdiği kızın gönlünü bile kazanamamış.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370305
					],
					"speakerTitle": "Ödül"
				},
				{
					"id": 760370305,
					"content": "\"Yani bana sattığı kolye gerçekti ama ömür boyu aşkı bulmamı engellemek üzere lanetledi beni. Onu bulup laneti kaldırabilen kişi cömertçe ödüllendirilecek.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ödül"
				}
			]
		},
		{
			"id": 7603704,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
