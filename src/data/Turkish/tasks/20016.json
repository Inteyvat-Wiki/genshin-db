			"dialogs": [
				{
					"id": 200160101,
					"content": "Paket servis siparişi",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160102
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160102,
					"content": "Gezgin! Mükemmel zamanlama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160103
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160103,
					"content": "Üzgünüm, aç olduğunu biliyorum ama senden bir şey isteyebilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160104
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160104,
					"content": "Şu sıralar siparişler giderek artıyor. Ben de siparişleri bölgelerine göre ayırıp ardından her yemeği alıcının ismiyle etiketliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160105
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160105,
					"content": "Ama bu <color=#00E1FFFF>Gelin Çiçekli Yengeç Çorbasının</color> etiketini kaybettim. Tek bildiğim alıcının Pınarköy'de olduğu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160106
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160106,
					"content": "Bu <color=#00E1FFFF>Gelin Çiçekli Yengeç Çorbasının</color> Pınarköy'deki sahibini bulup ona verir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160107,
						200160110
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160107,
					"content": "Tabii, ama...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200160108
					]
				},
				{
					"id": 200160108,
					"content": "Geri döndüğünde seni sıcacık ve lezzetli bir yemek bekliyor olacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200160109
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160109,
					"content": "Sana güveniyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				},
				{
					"id": 200160110,
					"content": "Buraya sadece yemek yemeye gelmiştim, açlıktan ölüyorum!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200160111
					]
				},
				{
					"id": 200160111,
					"content": "İstediğimi yaptıktan sonra sana Avcının Yeri'nin özel menüsünden bir şeyler ısmarlarım! Şimdiden teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
		},
