			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Atiyah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732670101,
					"content": "Münzevilere katıl ve olağanüstü bir hayata başla! Gel dostum, Münzeviler hakkında bilgi edinmek ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670102
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670102,
					"content": "Şey...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670103
					]
				},
				{
					"id": 732670103,
					"content": "Hadi ama, azıcık dinle. Olman gereken yer Münzevilerin yanı! Özgürüz! Birlik içindeyiz! Üstelik cana yakınız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670104
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670104,
					"content": "Bize katılırsan ağaç sakinlerinin kalın cüzdanlarını çalabileceksin. Akademi araştırmacıları çok zengindir ve ödemelerini geciktiren tipler değillerdir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670105,
						732670106
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670105,
					"content": "Zaten Maceracılar Loncasındayım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670107
					]
				},
				{
					"id": 732670107,
					"content": "Hey! Sen Maceracılar Loncasından mısın? Bu bir engel değil, değil mi? Hadi ama, bugünlerde herkesin ek işi var ve maceracılarla paralı askerler birbirlerinden çok da farklı değiller, anlıyorsun değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670108
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670108,
					"content": "Bence oldukça farklılar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670109
					]
				},
				{
					"id": 732670109,
					"content": "Burada da güzel yemekler var! Menüde hep et ve balık var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670110
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670110,
					"content": "Üstelik şanslıysan Alevli Yele Dehya ile bile tanışabilirsin! Şimdi ben... *öksürür*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670111,
						732670112
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670111,
					"content": "Sakin ol, biraz su iç.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670113
					]
				},
				{
					"id": 732670113,
					"content": "*öksürür* Affedersin, biraz hızlı konuştum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670114
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670114,
					"content": "Bir süredir bu konuşmayı kimse dinlemediği için biraz heyecanlanmış olabilirim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670115
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670115,
					"content": "Bize katılmayı hiç mi istemiyorsun yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670116,
						732670117
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670116,
					"content": "Şimdilik istemiyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670118
					]
				},
				{
					"id": 732670118,
					"content": "Pekala, öyle diyorsan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670119
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670119,
					"content": "Hep burada durup yeni üye mi toplamaya çalışıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670120
					]
				},
				{
					"id": 732670120,
					"content": "Evet. İşim bu sonuçta. Bugünlerde elinden iş gelene denk gelmek çok zor. Bunun ceremesini de en çok paralı askerlik sektörü çekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670121
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670121,
					"content": "*iç çeker* Sana söyleyebilirim bence. Elimizde çok kişi olduğu kesin ama bizim işimiz çok tehlikeli bir iş. İnsanlara refakat etmek daha kolay işlerden sayılıyor, en kötü yorucu oluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670122
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670122,
					"content": "Ancak işin araştırmacılarlaysa kellen koltukta da denebilir. Tek parça dönersen şanslısındır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670123
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670123,
					"content": "Bu tür görevlerden döndükten sonra, üyelerimizin çoğu en az on, on beş gün izin alıyor. Yani bu tarz boşlukları doldurması için her zaman birilerine ihtiyacımız var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670124
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670124,
					"content": "Sumeru bir sürü araştırmacının olduğu büyük bir yer, o nedenle her gün yeni bir iş geliyor. Aslında gece gündüz çalışıyoruz diyebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670125
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670125,
					"content": "Yani evet yeni insanlara ihtiyacımız var yoksa bu iş yükünün altından kalkamayacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670126
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670126,
					"content": "Madem öyle, katılacak birilerini bulabildin mi bari?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670127
					]
				},
				{
					"id": 732670127,
					"content": "Bu köyde mi? Hahaha... Hayır. Bir kişi bile bulamadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670128
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670128,
					"content": "Doğrusunu söylemek gerekirse katılmasını istediğim insanlar katılmak istemiyor. İsteyenleri de ben kabul etmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670129
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670129,
					"content": "İnanmıyorsan benimle biraz yürü ve hızlıca üzerinden geçelim. Kim bilir, belki sonunda ikna olursun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670130
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670130,
					"content": "Şaka şaka. Katılmak istemediğini biliyorum, seni zorlamayacağım da. Sadece yürüyüş yaparken birilerinin eşlik etmesi hoşuma gidiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670132
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670132,
					"content": "Seninle gelirim, sorun değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670131
					]
				},
				{
					"id": 732670131,
					"content": "Hehe, çok teşekkürler. Bir bakalım... Önce Sania'nın yanına gidelim. Genelde gündüzleri müsait olur, geceleriyse... Genelde Jabari'yle önemli şeyler konuşmakla meşgul oluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670117,
					"content": "Maceracılar Loncasında işim başımdan aşkın zaten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670118
					]
				},
				{
					"id": 732670112,
					"content": "Bu konuşmayı yapmak için önceden çalıştın değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670113
					]
				},
				{
					"id": 732670106,
					"content": "Zaten yapacak bir sürü özel görevim var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670107
					]
				}
			]
		},
		{
