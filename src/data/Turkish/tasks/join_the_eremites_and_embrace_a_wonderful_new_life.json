			"dialogs": [
				{
					"id": 732671001,
					"content": "Bu akrepler kocamanmış! Onlara gerçekten de daha fazla yaklaşmak zorunda mıyız sizce?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671002
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732671002,
					"content": "Onları okla vurdum ama hiç kaçmadılar bile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671003
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732671003,
					"content": "Ama sen... Onları ne kadar da kolay öldürdün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671004,
						732671005
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732671004,
					"content": "Yılların idmanı tabii.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732671006
					]
				},
				{
					"id": 732671006,
					"content": "Fakat... Bayan Candace ilerleme kaydettiğimi söylemişti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671007
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732671007,
					"content": "Neşelen biraz Karima! Sen de ileride güçleneceksin, bu bir anda olabilecek bir şey değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671008
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671008,
					"content": "Sen de Ayten. Böyle sıkı çalışmaya devam edersen yakında aramıza katılman işten bile değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671009
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671009,
					"content": "Ah, keşke Bayan Dehya eğitimime yardımcı olsa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671010
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732671010,
					"content": "Bayan Candace'ı tekrar gördüğümde bana daha çok şey öğretmesini isteyeceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671011
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732671011,
					"content": "Hahaha! İşte böyle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671012,
						732671013
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671012,
					"content": "Sonuçta katılacak kimse bulamadın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732671014
					]
				},
				{
					"id": 732671014,
					"content": "*öksürür* Şahsi dertlerin üstüne gitmemen gerektiğini kimse söylemedi mi sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671015
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671015,
					"content": "İş hakkında sonra konuşuruz... Ayrıca pazarlamamın hiç etkisi olmadı değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671016
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671016,
					"content": "Bize katılmak istemeseler de beni dinledikten sonra bir sürü genç dış dünyayı görmek için köyü terk etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671017
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671017,
					"content": "Neyse, bunu sonra konuşuruz. Şimdi bu çocukları köye geri götürmek zorundayım. Ebeveynleri artık merak etmeye başlamıştır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671018
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671018,
					"content": "Bu arada bu sizin. Benimle buralara kadar geldiğiniz için teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671019
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671019,
					"content": "*iç çeker* Rapor verirken bunu diğer Münzevilere nasıl açıklayacağım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671020
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671020,
					"content": "Atiyah amca, daha bize test yapmadın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732671021
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732671021,
					"content": "Öyle mi? Doğru ya... evet. Önce köye dönelim de testi orada yaparız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732671013,
					"content": "Peki ya işin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732671014
					]
				},
				{
					"id": 732671005,
