				"points": []
			},
			"dialogs": [
				{
					"id": 732670301,
					"content": "Çok endişe verici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670302
					],
					"speakerTitle": "Sania"
				},
				{
					"id": 732670302,
					"content": "İyi günler Sania! Ne satın alıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670303
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670303,
					"content": "Sana defalarca söyledim Atiyah, Jabari size katılmak istemiyor ve ben de onun paralı asker olmasını istemiyorum. Onu ikna etmene yardım etmeyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670304
					],
					"speakerTitle": "Sania"
				},
				{
					"id": 732670304,
					"content": "Şey, yazık oldu aslında. Onun mutfaktaki becerileri işimize çok yarardı aslında ve ailene de iyi bir maddi gelir olurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670305
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670305,
					"content": "Hem çıkıp iş aramak istediğini söylememiş miydi? İstediği gerçekten buysa, ona eski bir arkadaştan daha iyi iş bulabilecek biri olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670306
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670306,
					"content": "Onun söylediği hiçbir şeyi ciddiye alma. Bir gün öyle der, sonraki gün fikrini değiştirir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670307
					],
					"speakerTitle": "Sania"
				},
				{
					"id": 732670307,
					"content": "Yani sonuç olarak beni köyde yalnız bırakmaya dayanamıyor... Ben de onun kendi kendine çabaladığını görmeye dayanamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670308
					],
					"speakerTitle": "Sania"
				},
				{
					"id": 732670308,
					"content": "Üstelik, sen onu paralı asker yapıp hayatını riske atmasını istiyorsun! Gitmek istese bile kesinlikle durdururum onu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670309
					],
					"speakerTitle": "Sania"
				},
				{
					"id": 732670309,
					"content": "Bu konuyu kapat artık. Satın almam gereken şeyler var... Git başkasıyla uğraş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670310
					],
					"speakerTitle": "Sania"
				},
				{
					"id": 732670310,
					"content": "Oh... Tamam o halde. Gördün mü gezgin? İşte her gün böyle uğraşıyorum ben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670311
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670311,
					"content": "Listemdeki bir sonraki isim Fodil. Bir zamanlar bizimle çalışıyordu ama istifa etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670312
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670312,
					"content": "Onu geri dönmeye ikna edebilsem iyi olurdu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atiyah"
				}
			]
		},
		{
			"id": 7326705,
			"completionStepIds": [
				7326705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7326705",
							"2"
						],
						"stepId": 7326705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fodil",
					"Atiyah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732670501,
					"content": "Atiyah... Yine mi sen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670502
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670502,
					"content": "Haha, bilmez değilsin sebat etmek erdemlerimizden biridir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670503
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670503,
					"content": "O zaman benim de ilkelerime sadık kalacak kadar erdemli olduğumu biliyorsundur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670504
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670504,
					"content": "Hadi ama kardeşim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670505
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670505,
					"content": "Örgütten ayrıldım. Bana öyle seslenme artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670506
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670506,
					"content": "Tamam, pekala Fodil. Hiç geri dönmeyi düşünmeyeceğine emin misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670507
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670507,
					"content": "Bazılarımız biraz pervasız biliyorum ama çoğumuz kanunlara saygılı vatandaşlarız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670508
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670508,
					"content": "Daha önce de söyledim Atiyah. Geri dönmeyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670509
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670509,
					"content": "Bahsettiğin şeylere kendi gözlerimle bizzat şahit oldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670510
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670510,
					"content": "Belki Münzevilerin hepsi kanunsuz işlere karışmıyordur ve düşene bir tekme de kendileri vurmaktan hoşlanmıyordur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670511
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670511,
					"content": "Ama kötülük bulaşıcıdır Atiyah. Bir kişinin kanunu ciddiye almaması, diğerlerinin ondan etkilenmesine yeter de artar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670522
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670522,
					"content": "Bir kişi başka birini etkiler ve o grup belli bir şekilde hareket etmeye devam ederse, daha fazla insanı etkilemeye başlarlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670523
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670523,
					"content": "Atiyah, eminim ki bunun ne demek olduğunu benden daha iyi biliyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670512
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670512,
					"content": "Böyle bir ortamda kötülük yapmak o kadar kolay ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670513
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670513,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670514
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670514,
					"content": "Sen benim geri dönmemi istiyorsun, ben ise senin gitmeni istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670515
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670515,
					"content": "Belki de tam anlamıyla onurlu olmasalar da Münzevileri şeytani bir örgüt olarak görmüyor olabilirsin... Ama her zaman orta yolda yaşayamazsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670516
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670516,
					"content": "Bu sadece bir tavsiye. İstediğini yapmakta özgürsün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670517
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670517,
					"content": "Biliyorum şef.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670518
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670518,
					"content": "Pekala. Şimdi gidersen ve yeni bir işe ihtiyacın olursa, ben yine sana yardım ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670519
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 732670519,
					"content": "İyi misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670520
					]
				},
				{
					"id": 732670520,
					"content": "Ah, şey... Sanırım Fodil ile girdiğim hiçbir tartışmayı kazanamayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670521
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670521,
					"content": "Sırada ne var? Doğru, evet. Şimdi biraz dinlenelim. O kadar laftan sonra boğazım ağrıdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atiyah"
				}
			]
		},
		{
			"id": 7326706,
			"completionStepIds": [
				7326706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7326706",
							"2"
						],
						"stepId": 7326706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ayten",
					"Atiyah",
					"Karima"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732670601,
					"content": "Hey, Atiyah Amca! Hâlâ insanları Münzevilere katılmaya ikna etmeye mi çalışıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670602
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670602,
					"content": "Ayten değil mi bu? Annene buraya geleceğini söyledin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670603
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670603,
					"content": "Söyledim! Annem çalışıyor, ben de Karima ile oyun oynamaya gittim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670604
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670604,
					"content": "Merhaba Atiyah Amca!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670605
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670605,
					"content": "Atiyah Amca, sen ne düşünüyorsun? Hani şu geçen konuştuğumuz konu hakkında...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670606
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670606,
					"content": "Bunca zamandır çalışıyorum ve Karima ile antrenman yapıyorum. Bir daha herhangi bir yarışta benim yanımdan bile geçemeyecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670607
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670607,
					"content": "Geçen seferki sayılmaz! O gün ben adamakıllı yemek yememiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670608
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670608,
					"content": "Neyse... Bana verdiğin idman programını uyguladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670609
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670609,
					"content": "O yüzden teste bir daha girmek istiyorum! Bakalım Münzevilere katılabilecek kadar iyi miyim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670610,
						732670611
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670610,
					"content": "Ah, demek bunu demek istemiştin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670612
					]
				},
				{
					"id": 732670612,
					"content": "Öhöm! Tamam o halde Ayten. Münzevilerin bir üyesi olarak seni bir kez daha teste tabi tutacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670613
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670613,
					"content": "Tamamdır! Hadi Karima, sen de bize katıl. Bunu birlikte yapalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670614
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670614,
					"content": "Ben Münzevilere katılmak istemiyorum ki... Tek istediğim burada köyde kalıp herkesi korumak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670615
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670615,
					"content": "Ama Atiyah Amcanın yeteneklerimi test etmesini isterdim. Aslında Bayan Candace'tan idman tavsiyesi istemiştim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670616
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670616,
					"content": "Bir dakika... Ne? Ne zaman...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670617
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670617,
					"content": "Hahaha! Güzel, güzel, hah şöyle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670618
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670618,
					"content": "Tamam Ayten, suratını asma. Fırsatımız olursa seni Dehya'ya götürürüm, ondan bir şeyler kaparsın, ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670619
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670619,
					"content": "Gider miyiz gerçekten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670620
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670620,
					"content": "Biz Münzeviler yalan söylemeyiz evlat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670621
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670621,
					"content": "Ama teste başlamadan önce, Gezgin bize beklenen standartları göstersin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670622,
						732670624
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670622,
					"content": "Bir saniye, buna ben de mi dahil oldum şimdi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670623
					]
				},
				{
					"id": 732670623,
					"content": "... Daha önce hiç gösteri yapma şansım olmamıştı. Bir yandan koşturup bunları yaparken, bu çocukları tek başlarına burada bırakamam. Çok tehlikeli olur... Neyse, yardımların için teşekkürler Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670626
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670626,
					"content": "*öksürür* Neyse, Gezginimiz oldukça yaman bir maceracı. Onu buraya getirip size bir gösteri yapması için çok uğraştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670627
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670627,
					"content": "Şimdi iyi izleyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670628
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670628,
					"content": "Pekala!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670629
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670629,
					"content": "Bir maceracı, öyle mi? Maceracılar Loncasından biri mi yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670630
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670630,
					"content": "İster paralı asker ister muhafız ol, kaçmanın en iyi seçenek olduğu durumlarla sürekli karşı karşıya geleceksin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670631
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670631,
					"content": "Bu gibi durumlarda, \"ne kadar hızlı kaçarsan o kadar iyi\" düsturuyla hareket ederiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670632
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670632,
					"content": "Teşekkürler Gezgin. Hadı hemen bir gösterelim... Hızlı bir kaçış nasıl yapılırmış görün!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670633
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670633,
					"content": "İşte başlangıç noktamız. Başlayabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670624,
					"content": "Normalde hiç gösteri yapmıyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670625
					]
				},
				{
					"id": 732670625,
					"content": "Hadi ama, hem kendi işimle hem de çocuklarla uğraşırken gösteri yapacak zamanım olmuş olabilir mi sence?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670634
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670634,
					"content": "Sana güveniyorum Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670626
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670611,
					"content": "Katılmak isteyen biri mi var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670612
					]
				}
			]
		},
		{
			"id": 7326708,
			"completionStepIds": [
				7326708
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7326708",
							"2"
						],
						"stepId": 7326708,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ayten",
					"Karima",
					"Atiyah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732670801,
					"content": "Vay canına!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670802
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670802,
					"content": "Ne kadar da hızlısın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670803
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670803,
					"content": "Çok güzel! Hızlıydın... Ve en önemlisi de çok kararlı duruyordun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670804
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670804,
					"content": "İzleyin ve öğrenin çocuklar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670805
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670805,
					"content": "Girdiğin her tehlikeli durumu sonuna kadar götürmek zorunda değilsin. Kaçman gerekiyorsa, kararlı ol ve kaç!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670806
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670806,
					"content": "Özellikle de sen Ayten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670807
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670807,
					"content": "Biliyorum, biliyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670808
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670808,
					"content": "Güzel. Hadi bir sonraki adıma geçelim... Şimdi sıra canlı savaş gösterisinde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670809
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670809,
					"content": "Vay, harika! Babam bana odundan kılıç yaptı. Sende ne var Karima?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670810
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670810,
					"content": "Bende küçük bir yay var ama annem yalnızca uçları olmayan oklardan verdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670811
					],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670811,
					"content": "Hahaha! O da olur! Bir kılıca, bir yaya ve sınırsız cesarete sahipsiniz. Maceraya atılmak için de bundan başka bir şeye ihtiyacınız yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670812
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670812,
					"content": "Ama köyün dışında başıboş koşturmayın. Benim veya Gezginin yanından ayrılmayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670813,
						732670814
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670813,
					"content": "Onları gerçekten köyün dışına mı götürüyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670815
					]
				},
				{
					"id": 732670815,
					"content": "Ah, merak etmeyin. Bu alanı daha önce keşfe çıkmıştım. Sadece zehirli akrepler var. Pek saldırı kabiliyetleri yok, o yüzden bir şey olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670816
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670816,
					"content": "Ve ne olursa olsun, biz ikimiz orada olacağız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670817,
						732670818
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670817,
					"content": "Şimdi beni de mi sayıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670819
					]
				},
				{
					"id": 732670819,
					"content": "Hadi ama, geldik bile. Bilirsiniz, \"battı balık yan gider.\" Loncanın kurallarına göre ödeme yapacağımdan emin olabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670820
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670820,
					"content": "Kemerlerinizi bağlayın çocuklar. Yola çıkıyoruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670821
					],
					"speakerTitle": "Atiyah"
				},
				{
					"id": 732670821,
					"content": "Vay canına!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732670822
					],
					"speakerTitle": "Ayten"
				},
				{
					"id": 732670822,
					"content": "İtiraf edeyim biraz heyecanlıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Karima"
				},
				{
					"id": 732670818,
					"content": "Böyle bir şeyi kabul ettiğimi hatırlamıyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670819
					]
				},
				{
					"id": 732670814,
					"content": "İki çocuğun peşinden dışarı çıkıyoruz...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732670815
					]
