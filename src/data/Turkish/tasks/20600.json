			"dialogs": [
				{
					"id": 206000401,
					"content": "Çariçe hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000402
					]
				},
				{
					"id": 206000402,
					"content": "Ne, bana Çariçe hakkında soru mu soracaksın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000403
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000403,
					"content": "Fatui'ye Çariçe için mi katılacaksın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000404
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000404,
					"content": "Hevesini kırmak istemem ama ağzından çıkanları kulağın bir duysun, olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000405
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000405,
					"content": "Gerçi Çariçe hakkında konuşamam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000406
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000406,
					"content": "Sen gidip Harabe Muhafızından bir şey alıp getirsene bana. Oyalanacak bir şey gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000407,
						206000409
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000407,
					"content": "Ben... Tamam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000408
					]
				},
				{
					"id": 206000408,
					"content": "Hadi naş. Ben burada bekliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000409,
					"content": "Ne yapacaksın ki o şeyi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000410
					]
				},
				{
					"id": 206000410,
					"content": "İncik boncuk toplamak da mı yasak? Yoksa Mondstadt ahalisi ufacık bir Harabe Muhafızından mı korkuyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000411
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000411,
					"content": "Bizim gibi Fatui üyeleri için kılımızı kımıldatmaya bile değmeyecek yaratıklar bunlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000412
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000412,
					"content": "Yine de... *iç çeker* Bu rüzgar beni iyice mayıştırdığından bu önemsiz işi sana bırakıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
