			"dialogs": [
				{
					"id": 206001001,
					"content": "Getirdin mi bakalım malları?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001002
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001002,
					"content": "Tabii ki getirdim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206001003
					]
				},
				{
					"id": 206001003,
					"content": "Ah, fena değil. Yetenekli olduğun belli oluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001004
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001004,
					"content": "Majesteleri Çariçe hakkında konuşmak istiyorsun, öyle mi? Şimdi, nereden başlasak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001005
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001005,
					"content": "Kısaca özetlersek Çariçe bizim tanrımızdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001006
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001006,
					"content": "Mecazen falan değil, gerçekten öyle. Çariçe aslında Buz Hükümdarı, yani ölümlüler diyarında hükümranlık süren Yedilerden biridir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001007
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001007,
					"content": "Ama biz Fatui üyeleri için Majestelerinin statüsü bir tanrıdan bile ötedir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001008
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001008,
					"content": "Sebebiyse... Açıklasam da anlamazsın. Daha doğrusu, anlayamazsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001009
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001009,
					"content": "Anlamak istiyorsan katıl bize. O zaman Majesteleri Çariçe'nin ne kadar üstün bir varlık olduğunu anlayacaksın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206001010
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206001010,
					"content": "Heh, diyeceklerim şimdilik bu kadar. Şu rahibe yine kötü kötü bakıyor bana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		}
