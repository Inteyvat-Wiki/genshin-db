			"dialogs": [
				{
					"id": 206000801,
					"content": "Getirdin mi bakalım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000802
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000802,
					"content": "Evet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000803
					]
				},
				{
					"id": 206000803,
					"content": "Bakalım. Hah, bu dandik yerde düzgün bir şey bulman mümkün değildi zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000804
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000804,
					"content": "Peki, tamam, Sanrılarla ilgili bir hikaye istiyordun. Bir düşüneyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000805
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000805,
					"content": "Sanrılar, Majesteleri Çariçe'nin bizzat bahşettiği muhteşem bir güç kaynağıdır. Sanrı o kadar güçlüdür ki Önsezi veya inanç falan yanında çocuk oyuncağı kalır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000806
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000806,
					"content": "Gerçi öyle herkes Sanrı kullanamaz. On Bir Haberci dışında çok az Fatui'de Sanrı var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000807
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000807,
					"content": "Yine de benim gibi sıradan bir ölümlü için Sanrı bir Önseziye göre çok daha pratik. Sonuçta Önseziyi sadece tanrıların lütfu sayesinde alabiliyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000808
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000808,
					"content": "Hah, bakıyorum da sende de Önsezi falan yok. Fatui'ye katılmaya ne dersin o zaman? Kim bilir, belki de eline gerçek bir Sanrı geçer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000809
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000809,
					"content": "Sanrılar hakkında diyeceklerim bu kadar. Favonius Şövalyeleri bu konuda biraz hassaslar, yani sakın onlara bahsetme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
