			"dialogs": [
				{
					"id": 206000301,
					"content": "Sanrılar hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000302
					]
				},
				{
					"id": 206000302,
					"content": "Hah! Salak mısın yoksa salağa mı yatıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000303
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000303,
					"content": "Fatui'nin resmi üyesi bile değilken ne cüretle Sanrının ne olduğunu sorabiliyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000304
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000304,
					"content": "Kapıdaki şu iki Favonius Şövalyesi gibi sana da anlatacağımı mı sandın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000305
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000305,
					"content": "Sanrılar gurur kaynağımızdır. Biraz açıklamaktan zarar gelmez herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000306
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000306,
					"content": "Şöyle yapalım o zaman. Mondstadt'ın dışında gezen Hazine Avcılarını görmüşsündür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000307
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000307,
					"content": "Haytalık peşindeki bir tilki sürüsünden ibaretler ama bazen onlar bile değerli bir şeye rastlayabiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000308
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000308,
					"content": "O tarafa gidip bana ufak bir şey getirirsen ben de karşılığında sana Sanrılardan bahsederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000309,
						206000311
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000309,
					"content": "Tamam o zaman.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000310
					]
				},
				{
					"id": 206000310,
					"content": "Galiba sevdim seni. İkile madem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000311,
					"content": "Para sıkıntın mı var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000312
					]
				},
				{
					"id": 206000312,
					"content": "Para mı? Hahaha, sen beni şu Favonius Şövalyelerinden biri mi sandın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000313
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000313,
					"content": "Hazine Avcılarının Mondstadt'ta nasıl bir şey bulabileceklerini görmek istiyorum sadece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000314
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000314,
					"content": "Gerçi doğru düzgün bir şey bulabileceklerini pek sanmıyorum. *kıkırdar*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
