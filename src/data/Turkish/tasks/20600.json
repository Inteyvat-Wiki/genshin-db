			},
			"dialogs": [
				{
					"id": 206000601,
					"content": "Ganimeti getirdin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000602
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000602,
					"content": "Tabii getirdim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206000603
					]
				},
				{
					"id": 206000603,
					"content": "Bir bakalım. Eh... İş görür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000604
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000604,
					"content": "Şimdi sana Fatui'den bahsedeyim biraz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000605
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000605,
					"content": "Biz Fatui üyeleri, Zapolyarny Sarayı'ndan geliriz. Majesteleri Çariçe'nin emirlerine kulak veririz, iradesini devralırız, bütün ülke boyunca da icra ederiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000606
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000606,
					"content": "Aramızdaki en güçlü on bir kişiye Majesteleri tarafından Haberci unvanı verilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000607
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000607,
					"content": "Benim gibi isimsiz bir emir erine kıyasla, On Bir Haberci muazzam kişilerdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000608
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000608,
					"content": "Fatui'ye katılıp gücünü gösterirsen belki sen de onlardan biri olabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000609
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000609,
					"content": "Devamında da yükselmeye devam edersin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000610
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000610,
					"content": "Ben pek de \"seçilmiş\" sayılmam ama burada Sinyora için ufak bir iş yürütüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206000611
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 206000611,
					"content": "Gerçi seçebilseydim... Capitano'nun emrinde çalışmayı yeğlerdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
