					"Yuan Qing"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210070601,
					"content": "Bak! Yine o adamlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210070602,
					"content": "Tek ve hür yaşayan ağaç, tek bir dala muhtaç... Haha, doğru, tek başına hiçbir şey yapamazsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070603
					],
					"speakerTitle": "Yuan Qing"
				},
				{
					"id": 210070603,
					"content": "Arkasına bile almaz rüzgarı, azametli kızıl güz yaprakları... Keşke kardeşlerimin ve babamın sözüne güvenseydim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070604
					],
					"speakerTitle": "Yuan Cheng"
				},
				{
					"id": 210070604,
					"content": "Dağılır arkasına alıp rüzgarı, azametli kızıl güz yaprakları... Hazine... Bir hazine yüzünden her şeyi kaybettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070605
					],
					"speakerTitle": "Yuan Liang"
				},
				{
					"id": 210070605,
					"content": "Ağaçlar kök salıp gölgesiyle güneşten korumalı, yuva dediğin böyle olmalı... Çocuklar, aile olmamız gerekiyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070606
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070606,
					"content": "Gerçekten hazineyi madende sakladığımı mı sandınız? *iç çeker*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070607
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070607,
					"content": "Hazine var aslında. Siz çocukken birlikte ağaç dikmiştik, hatırlıyor musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070608
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070608,
					"content": "Kocaman adamlar olduğunuzda beraber tekrar gelelim de kazıp ne olduğuna bakabilelim diye her yıl buraya bir şeyler koyardım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070609
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070609,
					"content": "Bulduklarımızla da yemek yiyip bir şişe şarap alalım diye... Ailecek kutlama yapıp eski günleri yad edelim diye...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070610
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070610,
					"content": "Ah çocuklarım, biricik çocuklarım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuan Hong"
				}
			]
		}
	]
