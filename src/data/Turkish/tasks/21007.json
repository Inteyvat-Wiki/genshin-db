			"dialogs": [
				{
					"id": 210070401,
					"content": "Hehehe... Hazine benim olacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070402
					],
					"speakerTitle": "Yuan Liang"
				},
				{
					"id": 210070402,
					"content": "Kardeşlerim çok aptal ya... Birkaç satır çözdüler diye hazinenin yerini bulduklarını sanıyorlar. Hehehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070403
					],
					"speakerTitle": "Yuan Liang"
				},
				{
					"id": 210070403,
					"content": "Babamızın buyruğunu yerine getirmek mi? Hah! O buyrukta hazinenin madende olduğunu yazan satır dışında okumaya değer hiçbir şey yoktu. Maden demişken... Yakında madene ben çökeceğim! Hehehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuan Liang"
				}
			]
		},
