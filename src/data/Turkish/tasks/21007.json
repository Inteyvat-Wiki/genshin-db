			"dialogs": [
				{
					"id": 210070501,
					"content": "Gitmiş... Hepsi gitmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070502
					],
					"speakerTitle": "Yuan Hong"
				},
				{
					"id": 210070502,
					"content": "Yuan Qing, Yuan Liang, Yuan Cheng... Aptal çocuklarım. Biraz daha dikkatli düşünmeniz ve etrafa daha iyi bakınmanız gerekecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuan Hong"
