				"points": []
			},
			"dialogs": [
				{
					"id": 210070301,
					"content": "Hıh, ne kadar kötü abilerim var ya! Varsa yoksa kendi çıkarları.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070302
					],
					"speakerTitle": "Yuan Cheng"
				},
				{
					"id": 210070302,
					"content": "Babam da iyice aklını kaçırdı. Ya hiçbir şeyin farkında değil ya da görmezden geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070303
					],
					"speakerTitle": "Yuan Cheng"
				},
				{
					"id": 210070303,
					"content": "Hazinenin madende olduğunu henüz anlamadılar sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070304
					],
					"speakerTitle": "Yuan Cheng"
				},
				{
					"id": 210070304,
					"content": "Onlardan önce hazineye ulaşmalıyım, sonra da ne kadar uzağa o kadar iyi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuan Cheng"
				}
			]
		},
