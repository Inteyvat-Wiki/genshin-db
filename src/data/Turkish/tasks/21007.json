			"dialogs": [
				{
					"id": 210070101,
					"content": "\"Tek ve hür yaşayan ağaç, tek bir dala muhtaç ama sert görünen kayanın bile vardır altından kalbi. Bir araya gelin, bereketini paylaşın. Bu bereketin altında gizli şu sözlere kulak verin: Babanızın buyruğunu yerine getirin.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayıp Notlar"
				}
			]
		},
