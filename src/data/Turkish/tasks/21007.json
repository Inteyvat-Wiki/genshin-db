			"dialogs": [
				{
					"id": 210070201,
					"content": "Hayır ya! Bunu hak edecek ne yaptım ben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070202
					],
					"speakerTitle": "Yuan Qing"
				},
				{
					"id": 210070202,
					"content": "Çaktırmadan aralarından sıyrılmayı başarmıştım. Madene önce varıp hazineye ilk ben ulaşayım dedim ama... Bu canavarlar da nereden çıktı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210070203
					],
					"speakerTitle": "Yuan Qing"
				},
				{
					"id": 210070203,
					"content": "Bittim ben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuan Qing"
				}
			]
		},
