				"points": []
			},
			"dialogs": [
				{
					"id": 752640401,
					"content": "Dinleyin, yanlış kişiyi yakaladınız... Ustamın adı Kanei, benimki ise Zhaka... İstediğiniz kişi o!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640402
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640402,
					"content": "Ustam gibi güzel oyuncaklar yapabilmem mümkün değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640403
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640403,
					"content": "Kaçırıldın mı yani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752640404
					]
				},
				{
					"id": 752640404,
					"content": "Hı? Dur bir saniye, siz onlarla değil misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640405
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640405,
					"content": "Tabii ki hayır! Onları nasıl patakladık, görmedin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752640406,
					"content": "Gerçekten mi? Bu harika! Artık özgür müyüm yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640407
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640407,
					"content": "Aynen öyle! Evine dönebilirsin. Fakat... Burada neler oldu böyle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752640408,
					"content": "O adamlar birden çıkagelip tatil köyünde satılan oyuncakların sahtelerini yapmaya kalktılar. Fakat o kadar kötü bir iş çıkardılar ki sonunda onlara yardım etmesi için ustam Kanei'yi kaçırmak zorunda kaldılar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640409
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640409,
					"content": "Fakat işler umdukları gibi gitmedi ve bu sefer de beni kaçırdılar... Halbuki ben ustamdan oyuncak boyamayı daha üç gün önce öğrenmeye başlamıştım... Onlara yardım edebilecek kapasitede değildim yani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640410
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640410,
					"content": "Her neyse, beni kurtardığınız için size teşekkür ederim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640411
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640411,
					"content": "Azhka, hadi eve gidiyoruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640412
					],
					"speakerTitle": "Zhaka"
				},
				{
					"id": 752640412,
					"content": "~!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Azhka"
				}
			]
		}
	]
