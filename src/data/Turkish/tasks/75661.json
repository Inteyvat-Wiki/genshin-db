			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chasca"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 756610101,
					"content": "İçimden bir ses buraya gelip bakmamı söylemişti, demek bu yüzdenmiş... Seni gördüğüme sevindim \"Tu{RUBY#[D]Umut}maini\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610102
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 756610102,
					"content": "Dur tahmin edeyim. Çiçek Tüyü Klanının savaşçı sınavı için geldin değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610103,
						756610106
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 756610103,
					"content": "Doğru. Zorluğunu test etmeye geldim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756610104
					]
				},
				{
					"id": 756610104,
					"content": "Hayal kırıklığına uğramayacaksın. Gukuzor Süvarilerinden hep en yüksek standardı hedeflemelerini beklerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610105
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 756610105,
					"content": "Eğitim verme konusunda pek iyi değilimdir, o yüzden bu aşamaları tasarlamaya davet alınca \"Aklıma gelen en zor mücadeleleri birbiri ardına dizerim.\" diye düşündüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610109
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 756610109,
					"content": "Bunun sonucunda... Kabile savaşçılarımızın yüzde doksan dokuzu başarısız oldu. Hem de daha ilk aşamada. O yüzden Irade'ın tavsiyesini dinleyip zorluğu düşürmekten başka çare yoktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610110
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 756610110,
					"content": "Ama eski halinin bile seni zorlayacağından şüpheliyim. Eğer öyle bir amacımız olsaydı... Benim dahi çaresiz kalacağım durumlar yaratmamız gerekirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610111,
						756610112
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 756610111,
					"content": "Nezaketin için teşekkür ederim ama ayrıcalıklı muamele görmek istemem!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756610113
					]
				},
				{
					"id": 756610113,
					"content": "Hayır, gerçekten de saygıyı hak ettiğini düşünüyorum. Bir eğitmen olmayabilirim ama karşımdakinin gücünü asla yanlış tartmamışımdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610114
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 756610114,
					"content": "Söz konusu sen olunca da... Yalnızca en zor mücadeleler uygun olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610115,
						756610116
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 756610115,
					"content": "Aşamanın uygunluğunu sıradan savaşçılar açısından değerlendirmem gerekiyor ama...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756610117
					]
				},
				{
					"id": 756610117,
					"content": "... Peki o zaman. Sen görevini tamamla, ileride başka fırsatlar çıkar karşımıza elbet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610118
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 756610118,
					"content": "Günün birinde, en üstün Gukuzor Süvarisi yeteneklerini bile aşan bir savaş ziyafeti sereceğim önüne. Sadece senin için.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chasca"
				},
				{
					"id": 756610116,
					"content": "Aşamaların evrenselliğine de dikkat edilmeli!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756610117
					]
				},
				{
					"id": 756610112,
					"content": "Haha, bırak beni pohpohlamayı!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756610113
					]
				},
				{
					"id": 756610106,
					"content": "Belki senin için gelmişimdir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756610107
					]
				},
				{
					"id": 756610107,
					"content": "Hım? Demek öyle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610108
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 756610108,
					"content": "Benim rekorumu \"geçmek\" mi istiyorsun o zaman? Ben de bunu beklerdim. Haberin olsun, aşamaları geçmişte karşılaştığım bir sürü zorlu mücadele ile doldurdum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756610109
					],
					"speakerTitle": "Chasca"
				}
			]
		}
	]
}