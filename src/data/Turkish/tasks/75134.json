			"dialogs": [
				{
					"id": 751340201,
					"content": "Raaa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340202
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340202,
					"content": "Off, dış kısmı Hiçlik tarafından aşındırılmış bunun. Düştü düşecek gibi duruyor üstelik... Coco'nun gösterdiği şey bu muydu dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340203,
					"content": "İçinde ne olduğunu bilmiyoruz gerçi ama aradığımız o Sunak olmadığı da gün gibi ortada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340204,
					"content": "\"Düz mantık düşünürsek bir yere varamayız...\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340205
					]
				},
				{
					"id": 751340205,
					"content": "Paimon şimdi anladı. Coco, Hiçlik yüzünden içeriye girmek istememiş demek ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340206,
					"content": "Hiçliğin icabına bakmamız gerekecek belli ki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340207
					]
				},
				{
					"id": 751340207,
					"content": "Evet, Coco bu yüzden içeriye girmek istemedi herhalde. Hiçlikten kurtulmamız lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340208,
					"content": "#Hadi gidelim {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751340209
					]
				},
				{
					"id": 751340209,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340210
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751340210,
					"content": "Bir dakika ya, Paimon ne olacak? Çok ayıp bu yaptığın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751340211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751340211,
					"content": "Neyse, önce şu pisliğin kökünü kurutalım hadi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
