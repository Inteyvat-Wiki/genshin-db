			"dialogs": [
				{
					"id": 402070201,
					"content": "Selam Ineffa! Aa, Jahoda! Sen de mi buradaydın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070202,
					"content": "Gösterdiğim çabanın ardından karşılık olarak bir dilim pastayı hak ettim bence, haksız mıyım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070203
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 402070203,
					"content": "Bir dakika, pasta mı var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070204,
					"content": "Evet. Tam vaktinde geldiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070205
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070205,
					"content": "Aino yardımlarınız için size teşekkür etmek istedi. Krum-Çın da sağ salim döndüğüne göre yapacağı pastayı herkesin tatması hoş olur diye düşündü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070206
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070206,
					"content": "Çın... Çın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070207
					],
					"speakerTitle": "Krum-Çın %70 Tatlı"
				},
				{
					"id": 402070207,
					"content": "Vay be, Krum-Çın böyle görünüyormuş demek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070208,
					"content": "Evet. Neyse ki çekirdek tek parçaydı, Aino'nun sadece yeni bir beden inşa etmesi gerekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070209
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070209,
					"content": "Çın... Çın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070210
					],
					"speakerTitle": "Krum-Çın %70 Tatlı"
				},
				{
					"id": 402070210,
					"content": "Aa, hazır mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070211,
					"content": "*yutar*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070212
					],
					"speakerTitle": "Krum-Çın %70 Tatlı"
				},
				{
					"id": 402070212,
					"content": "Hey, o da yedi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070213,
					"content": "Şefler bir tabağı servis etmeden önce birkaç lokma alır, gayet normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070214
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 402070214,
					"content": "Merak etmeyin. Doyduğunda sizin tatlılarınızı pişirmeye başlayacak. Birazdan başlar herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070215
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070215,
					"content": "Pekala... Bu arada tatlı demişken, Aino nerede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070216,
					"content": "Ha, aklına yeni bir robot fikri geldiği için kendini atölyeye kapayıp çalışmalara başladı. İlham geldiğinde hemen eyleme dökmek istiyor. O da öyle biri işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070217
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070217,
					"content": "Aino robot yapmayı neden bu kadar çok seviyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070218,
					"content": "Hım... Veri bankasından geçmiş kayıtlar alınıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070219
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070219,
					"content": "Başlangıçta Aino sanıyorum ilgisini tatlılardan daha çok çeken bir şey bulduğuna şaşırmıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070220
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070220,
					"content": "Neyse ki arkadaşları onun bu hevesine saygı duymuş, geçimini zar zor kazanıyor olmasına ve başka bir işe vakti kalmıyor olmasına rağmen üstelik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070221
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070221,
					"content": "Sonra bir gün meşhur bir öğretmen onu keşfetmiş ve onun içindeki bu tutkunun aslında bir deha olduğunu anlamış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070222
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070222,
					"content": "Arkadaşları gibi o da nihayet ne yapmak istediğini bulmuştu. Üstelik çok da başarılıydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070223
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070223,
					"content": "Deha ve tutku bir araya geldiğinde ortaya çıkan sonucu kimse durduramaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070224
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070224,
					"content": "Aino çocukluk arkadaşlarından ayrılmış, Çın Çın Krumkake Atölyesini kurmuş ve birbirinden çeşitli robot yoldaşlar yapmaya başlamış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070225
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070225,
					"content": "Belki her şeyin temelinde bir dahinin doğal içgüdüsü yatıyordur... Hayal ettiklerini gerçeğe dönüştürmek ister hepsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070226
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070226,
					"content": "Ha... Onu robot yapımına çeken bu muydu yani sence?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070227,
					"content": "Aino ile yaşadığım tecrübelerden yola çıkarak başka bir sebebi daha olduğunu düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070228
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070228,
					"content": "Beni yanına almadan uzun zaman önce bile her robota özel bir kişilik vermek için yeteneklerinin sınırlarını zorluyor ve onlara yoldaşları gibi davranıyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070229
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070229,
					"content": "Yani bu olay benimle veya benim geçmişim nedeniyle başlamadı demek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070230
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070230,
					"content": "Sanırım çok uzun zaman boyunca bir dahi olarak yaşadıktan sonra etrafına baktı ve yanında kimsenin olmadığını gördü, doğal olarak kendini yalnız hissetti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070231
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070231,
					"content": "Dolayısıyla ben, Krum-Çın ve Aino'nun atölyeye eklediği diğer tüm robotlar... Biz onun dehasının birer kanıtı değiliz yalnızca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070232
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070232,
					"content": "Biz onun ailesiyiz. Özlemini duyduğu yoldaşlık hissini sunuyoruz ona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070233
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070233,
					"content": "Bana göre Aino ile robotları arasındaki asıl ilişki bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070234
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070234,
					"content": "Vay be. Onun için çok değerlisiniz demek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070235,
					"content": "Evet. Bundan ötürü Aino, Krum-Çın'ın ne kadar güçlü olabileceğini veya gruplar arasında teknolojisine ne kadar korku ya da ilgi duyulacağını umursamadı hiç.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070236
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070236,
					"content": "Krum-Çın'ın bu aileye katılacağına bir kere karar verdi ya, onu kurtarmak için ne gerekiyorsa yapardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070237
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070237,
					"content": "Evet, mantıklı! Ama Paimon merak ediyor, Aino gibi biri neden Nod-Krai'da kalmayı tercih eder ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070238,
					"content": "... Maalesef mantık ünitem bu sorunun mantığını anlayamadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070239
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070239,
					"content": "Paimon'un anladığı kadarıyla Nod-Krai dalavereyle dolu bir kurtlar sofrası. Burada işleri iyi giden insanlar böyle bir dünya için doğmuş sanki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070240
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070240,
					"content": "Başkası olsa Aino'nun sahip olduğu teknolojiyle silahlar yapıp insanları tehdit ederdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070241,
					"content": "Oysa Aino... Silah olabilecek bir teknolojiyi alıp pasta yapan bir robota dönüştürüyor. Buraya ait biriymiş gibi durmuyor hiç...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402070242,
					"content": "Hayır, ben tam aksini düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070243
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070243,
					"content": "Nod-Krai'da yaşayan birbirinden çeşitli insanla karşılaştım. Tecrübelerime göre aralarından pek azının burayı temsil ettiği söylenebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070244
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070244,
					"content": "Aino'nun buraya ait olmadığını söylüyorsun ama bence buraya ait. Nod-Krai'da yaşayan birini tanımlamam gerekse... Aino'dan daha iyi bir örnek bulamam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070245
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070245,
					"content": "Çın... Çın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070246
					],
					"speakerTitle": "Krum-Çın %70 Tatlı"
				},
				{
					"id": 402070246,
					"content": "Hah, tatlılar hazır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070247
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 402070247,
					"content": "Evet. Bir saniye. Servis edeyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070248
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070248,
					"content": "Ben şekerleme kaplı olanı istiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070249
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 402070249,
					"content": "Pekala millet. Buyurun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070250
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402070250,
					"content": "... Mmm! Uğraştığımıza değdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}