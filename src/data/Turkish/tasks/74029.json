			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740290101,
					"content": "O oltayla ne yapacaksın burada? Gerçekten de balık mı tutacaksın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290102,
					"content": "Su var, olta da var... Tabii ki balık tutacağım. Siz yabancılar bunu bile bilmiyorsunuz... Cidden dünya nereye gidiyor acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290103,
						740290105
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290103,
					"content": "Bunun dünyada olan bitenlerle pek bir alakası yok bence...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290104
					]
				},
				{
					"id": 740290104,
					"content": "Haklı! Balıkçılık konusunda biz de bir şeyler biliriz aslında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290107,
					"content": "Paimon'un söylemeye çalıştığı... Yani bir Melusinanın olta kullanması biraz garip. Paimon sizin böyle balık tuttuğunuzu hayal etmezdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290108,
					"content": "B-Ben garip falan değilim! Bunu bir yabancıdan öğrendim. Delaroche müthiş birisi. O bana balık tutmayı öğretmekle kalmadı, olta bile verdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290109
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290109,
					"content": "Onun oltası daha güzel görünüyordu tabii ama bu sorun değil... O bir \"profesyonel\" ben ise \"hobi\" olarak balık tutuyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290110
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290110,
					"content": "Yine de... Çok uzun süredir burada bekliyorum. Neden hâlâ oltaya vuran bir şey olmadı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290111
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290111,
					"content": "Hehe, madem öyle bırak da biz profesyoneller sana neyi yanlış yaptığını anlatalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290112,
					"content": "Ne? Siz gerçekten Delaroche'tan daha mı iyisiniz? Ama o bir profesyonel ve çok güzel bir oltası var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290113
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290113,
					"content": "Hıh! Sanırım yeteneklerimizi göstermemiz gerek, ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290114,
					"content": "Ama burada balık var mı ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290115
					]
				},
				{
					"id": 740290115,
					"content": "Hımm. Şimdi sen söyleyince fark ettim de hiç yok! Paimon daha baştan bunun garip olduğunu düşünüyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290116,
					"content": "Balık... Delaroche her suda balık olmayabileceğini söylemişti. Şey, \"diğer şeyler\" de balıktan sayılır mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290117
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290117,
					"content": "Eğer \"diğer şeyler\" balık değilse, belki de o yüzden \"balık\" tutamıyorumdur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290118
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290118,
					"content": "#{NICKNAME} Usta, Paimon Usta, lütfen söyleyin bana. \"O şeyi\" tutmak için ne yapmam gerek?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290119
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290119,
					"content": "Iı sen... Aslında bayağı kibarsın! Sana tabii ki yardım ederiz ama önce \"o şeyin\" ne olduğunu söyleyebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290120,
					"content": "Suda çok çabuk hareket eder ve kaygan olduğundan yakalaması zordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290121,
						740290123
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290121,
					"content": "Balıktan bahsediyor olmalı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290122
					]
				},
				{
					"id": 740290122,
					"content": "Veya başka bir su altı canlısından bahsediyor olabilir, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290125,
					"content": "Her neyse, bu suda bir şeyler yaşadığı kesin. Ama silüetini göremediğimiz için derinlerde saklanıyor olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290126,
					"content": "Paimon'a göre biraz yem atmalı ve onu yüzeye çıkarmayı denemeliyiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290127,
					"content": "Ama zaten çok fazla yem yedi... Yemi değiştirmenin de bir faydası olur mu bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290128
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290128,
					"content": "Olsun, biraz yem atıp oltamızı hazırlayalım da yemi yutmasını bekleyelim. Ne olduğunu da bilmiyoruz ama olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290129,
					"content": "#Ne kadar güzel bir teknik... Bir daha deneyeyim. Usta {NICKNAME}, Usta Paimon, size yemi vereceğim ve oltamı hazırlayacağım. Bir profesyonelin güzel oltası olmasa bile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290130
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290130,
					"content": "Bu sorun değil. Yemi atma işini bize bırak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290123,
					"content": "Bir Melusina olabilir aslında.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290124
					]
				},
				{
					"id": 740290124,
					"content": "Gerçekten mi? Iara ve diğer Melusinaların birlikte balık tutmaca oynaması garip olmaz mıydı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290105,
					"content": "Paimon balıkçılıktan iyi anlar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290106
					]
				},
				{
					"id": 740290106,
					"content": "Doğru söylüyor. Bir zamanlar sen de Paimon'u oltayla tutup çıkarmıştın... Bir dakika ama konumuz bu değil ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290107
					],
					"speakerTitle": "Paimon"
				}
			]
		},
