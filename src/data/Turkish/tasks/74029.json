				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740290301,
					"content": "Iara gücünü yitiren Balon Ahtapotu su kovasına koyar...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740290302
					]
				},
				{
					"id": 740290302,
					"content": "Ne kadar güzel bir balıkçılık tekniği... Ancak bu yaratık artık hiç güzel değil. Nasıl oldu bu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290303
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290303,
					"content": "Kusura bakma... Senin \"o şey\" diye bahsettiğinin bir Balon Ahtapot olduğunu düşünemedik, o yüzden...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290304,
						740290306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290304,
					"content": "Benim suçum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290305
					]
				},
				{
					"id": 740290305,
					"content": "Evet, çok acele ettin! Şey, Paimon da seni durdurmadı aslında...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290308,
					"content": "Üzülmeyin. O artık kovada ve bu benim için yeterli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290309
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290309,
					"content": "Sen öyle diyorsan... Peki ama burada bir Balon Ahtapotun ne işi var? Akıntıyı takip edip yanlışlıkla buraya mı düştü acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290310,
					"content": "Onu dışarıda yakaladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290311
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290311,
					"content": "Bir dakika, ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290312,
					"content": "Olta becerilerimi denemek istedim, bu yüzden de gidip onu yakaladım... Adına \"Balon Ahtapot\" demiştiniz sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290313
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290313,
					"content": "Eğer onu buraya koyarsam istediğimde onu tutabileceğimi düşündüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290314
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290314,
					"content": "... Yani plan buydu aslında. Bekledim, bekledim ama ne olursa olsun oltaya hiç vurmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290315
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290315,
					"content": "Bir canlıyı yakalayıp olta antrenmanı yapmak için havuza koyman epey endişe verici bir şey aslında...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290316,
					"content": "Ama suya yem serptiğimizde hemen çıkageldi. Bunu yapmak senin aklına gelmedi mi Iara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290317,
					"content": "Farklı birçok çeşit yem denedim; kıyma, ekmek, solucan, nane, parçalar... Hiçbirini yemedi ve kayboldu. Hatta yeme hiç ilgisi olmadığını bile düşünmeye başladım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290318
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290318,
					"content": "Parçalar mı? Şey, yem yapmak için pek uygun değiller sanki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290319,
						740290321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290319,
					"content": "Su canlılarını garip şeylerle beslemesen iyi olur...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290320
					]
				},
				{
					"id": 740290320,
					"content": "Haklısın... Bekle, \"su canlısı\" ne çeşit bir isim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290323,
					"content": "Hımm. Parçalar çok ama çok önemli. Yem olarak kullanılmamaları gerektiğinden onları geri almak için bir yol bulmam gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290324
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290324,
					"content": "#Her neyse, Usta {NICKNAME}, Usta Paimon, lütfen bu parçalar ile size teşekkür etmeme izin verin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290325
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290325,
					"content": "Ah, sorun değil. Çok bir şey yapmadık zaten...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290326,
					"content": "Hı? Ama Delaroche bana yardım eden kişilere \"Usta\" demem gerektiğini ve onlara \"danışmanlık ücreti\" ödersem hoşlarına gideceğini söylemişti. Öyle olmadı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290327
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290327,
					"content": "Lütfen bu kuru parçaları alın. Merusea Köyü'nde çok işinize yararlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290328
					],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290328,
					"content": "Eh, madem öyle diyorsun Iara... Çok teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740290329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740290329,
					"content": "Önemli değil. Siz ikinizden ileride daha güzel balıkçılık teknikleri öğrenmeyi isterim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iara"
				},
				{
					"id": 740290321,
					"content": "Öyleyse Balon Ahtapotlar mekanik parçaları yiyebiliyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740290322
					]
				},
				{
					"id": 740290322,
					"content": "\"Yanlışlıkla yiyebilir\" desek daha doğru olmaz mı?",
