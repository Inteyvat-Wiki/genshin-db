					"nextDialogs": [
						722710205
					]
				},
				{
					"id": 722710205,
					"content": "Bizi seçtiğiniz için teşekkür ederiz. İşte Moran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710206
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710206,
