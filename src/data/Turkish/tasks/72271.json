			"dialogs": [
				{
					"id": 722710102,
					"content": "Satmak istediğim bir hazinem var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710103
					]
				},
				{
					"id": 722710103,
					"content": "Bakalım bu sefer nasıl nadir nesneler buldun? Bir göz atalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710104
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710104,
					"content": "Linlang'a Ejderkemiği Küresini anlatıyorsun.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722710105
					]
				},
				{
					"id": 722710105,
					"content": "Gördüklerin doğruysa bu gerçekten harika bir yadigar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710106
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710106,
					"content": "Şöyle üstünkörü bir bakınca çok da özel bir şey göremiyorum. Belki de özelliklerini göstermesi için yoğun bir şekilde kullanmak gereklidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710107
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710107,
					"content": "Bence anlattığın o fevkalade özellikler biraz abartılmış. Bunu daha önce satmaya çalışıp başarılı olmayan birisi vermiş olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710108
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710108,
					"content": "Söylediklerimi kişisel algılama. Şu an sesli düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710122
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710122,
					"content": "Sonuçta bu tarz durumlarla neredeyse her gün karşılaşıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710109
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710109,
					"content": "Öte yandan bunu kapalı bir yerde saklamadığını da anlayabiliyorum. Yüzeyinde şimdiden eskime belirtileri var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710110
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710110,
					"content": "Elbette bu nedenle karşılığında daha az para ödeyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710123
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710123,
					"content": "80.000 Moraya ne dersin? Üstüne yöresel yemek olarak da 5 adet Sürüsüne Bereket veririm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710111
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710111,
					"content": "Bunun iyi bir fiyat olduğunu düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710112,
						722710116,
						722710119
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710112,
					"content": "Ne için kullanacaksın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710113
					]
				},
				{
					"id": 722710113,
					"content": "Açık olmak gerekirse işe yaramasından daha çok hikayesinden dolayı satın alıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710114
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710114,
					"content": "Hikayeciler, opera topluluğu veya Yujing Terası'ndaki önemli erkek ve kadınların ilgisini çekebilecek bir hikayesi var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710115
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710115,
					"content": "Dükkanda öylece bir rafa koysam bile eski zamanlardan kalan mükemmel bir antik yadigar olarak sergileyebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710111
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710116,
					"content": "Makul bir fiyat. Anlaştık.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710117
					]
				},
				{
					"id": 722710117,
					"content": "Vay be çok hızlı oldu. Eh, iyi o halde. İşte Moran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710118
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710118,
					"content": "Bunun gibi başka hazineler bulursan kapımız her zaman açık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710119,
					"content": "Biraz daha düşüneyim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710120
					]
				},
				{
					"id": 722710120,
					"content": "Hiç sorun değil. Bu kadar değerli bir yadigar satmaya kalkıştığında ürünleri... Aman işte fiyatları her zaman kontrol etmelisin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710121
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 722710121,
					"content": "Kararını verdiğinde tekrar beni görmeye gelebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				}
			]
		},
