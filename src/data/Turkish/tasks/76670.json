				"points": []
			},
			"dialogs": [
				{
					"id": 766700101,
					"content": "Son zamanlarda işler nasıl gidiyor Lyylikki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700102
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766700102,
					"content": "Aa! Merhaba Leydi Lauma. Her şey yolunda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700103
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700103,
					"content": "Malzeme tedariki düzenli, sorun çıkaran kimse yok, üstelik aşçılık becerilerim de epey gelişti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700104
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700104,
					"content": "Bu arada, geçen sefer \"arkadaşlarım\" derken... O hayvanları mı kastediyordunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700105
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700105,
					"content": "Çok uysallar, sıraya giren insanları sessizce izlediler hep. Onlara yiyecek bir şeyler vermeye çalıştım ama kabul etmediler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700106
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700106,
					"content": "O ufaklıkların sorumluluk bilinci çok güçlüdür. İş başında olduklarında iyice odaklanırlar görev yerinden ayrılmazlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700107
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766700107,
					"content": "Ama işleri bittiğinde onlara atıştırmalık bir şeyler verebilirsin tabii. Hehe, eminim çok sevinirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700108
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766700108,
					"content": "Harika! O zaman teşekkür etmek adına onlara lezzetli bir şeyler hazırlayayım bugün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700109
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700109,
					"content": "Teşekkürler Lyylikki. Yardıma ihtiyacın olursa lütfen haber ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700110
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766700110,
					"content": "Yok yok, gerçekten gerek yok! Her şey kontrolüm altında. Hem Bay Kantor ve Bayan Jahoda da yardım ediyor zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700111
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700111,
					"content": "Pekala, o zaman sana kolay gelsin. Görüşürüz Lyylikki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700112
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766700112,
					"content": "Aa, yeni çıkan yemekleri dağıtmam lazım... Siz de denemek ister misiniz Leydi Lauma? Tazecik, fırından yeni çıktı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766700113
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766700113,
					"content": "Pekala, yemekleri tabağa koyayım... Ha? Yeni yıkadığım tabaklar nereye gitti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lyylikki"
				}
			]
		}
	]
}