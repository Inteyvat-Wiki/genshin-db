						220370302
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370302,
					"content": "Mantarların tamamı burada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370303
					]
				},
				{
					"id": 220370303,
					"content": "Hepsi bu kadar mı? Sanki daha çok vardı. Gerçekten hepsini temizledin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370304
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370304,
					"content": "Neyse, teşekkür ederim evlat. İşte ücretin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370305
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370305,
					"content": "Bu gübreler tam anlamıyla muhteşem. Mantarlar o kadar hızlı büyüdü ki... Keşke ekinlerin de bu kadar hızlı büyümesine yardımcı olabilselerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370306
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220370306,
					"content": "Vaktim olduğunda tekrar gelip biraz daha satın alacağımdan emin olabilirsin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Konda Densuke"
				}
