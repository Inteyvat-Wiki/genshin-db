			"trigger": {
				"objectNames": [
					"Vahid"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220370101,
					"content": "İnanmıyorum... Böyle bir şey nasıl olabilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370102
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370102,
					"content": "Sorun nedir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370103
					]
				},
				{
					"id": 220370103,
					"content": "Gezgin, ben de tam seni arıyordum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370104
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370104,
					"content": "Konda Densuke'yi hatırlıyor musun? Birkaç gün önce dükkana gelip gübrelerle ilgili bir şeyler sordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370105
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370105,
					"content": "Gübrelerden memnun kalmış mı bari?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370106
					]
				},
				{
					"id": 220370106,
					"content": "Pek kalmamış. Açıkçası Bay Konda Densuke'nin biraz aklı karışmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370107
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370107,
					"content": "Aklı mı karışmış?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370108
					]
				},
				{
					"id": 220370108,
					"content": "Aslında yaptığımız tanıtımdan sonra Bay Densuke senin talimatların doğrultusunda gübreleri kullanmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370109
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370109,
					"content": "Nitekim ekinler düzgün büyümemiş, hatta... her yerde bir sürü mantar türemiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370110
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370110,
					"content": "Dürüst olmam gerekirse Bay Konda'nın söylediklerinden sonra benim de biraz aklım karıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370111
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370111,
					"content": "Her neyse, gübreyle ilgili bir sorun olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370112
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370112,
					"content": "Konda Köyü'ne gidip Bay Konda'ya tarlasındaki mantarları toplaması için yardım edebilir misin Gezgin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370113,
						220370116
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370113,
					"content": "Hallederim, bana güven.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370114
					]
				},
				{
					"id": 220370114,
					"content": "Sana güveniyorum. Ben de bu sırada dükkanda biraz araştırma yapıp sorunun kaynağını bulmaya çalışacağım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370115
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370115,
					"content": "*iç çeker* Keşke Alrani burada olsaydı. Sorunun kaynağını kesinlikle bulurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370116,
					"content": "Bu sorun üzerinde çalışması için neden Alrani'den yardım istemiyoruz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370117
					]
				},
				{
					"id": 220370117,
					"content": "O burada olsaydı bu işi çoktan çözmüştük.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370118
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370118,
					"content": "Kendisi henüz dönmedi, şu an tam olarak nerede olduğunu bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370119
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220370119,
					"content": "Sana güvenmekten başka çarem yok Gezgin. Ben de bu sırada dükkanda biraz araştırma yapıp sorunun kaynağını bulmaya çalışacağım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				}
			]
		},
