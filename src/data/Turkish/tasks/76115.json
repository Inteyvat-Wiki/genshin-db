				]
			},
			"dialogs": [
				{
					"id": 761150301,
					"content": "Tam da beklediğim gibi oldu. Aynı hataları yapmaya devam eden zavallı bir ruh. Hayal kırıklığına uğradım doğrusu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150302
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150302,
					"content": "Yıllar önce kendisine engel olmuş, hata yapmayı bırakmıştı ama sonuç ortada... Kötüler asla doğru yolu bulamaz mı yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150303,
						761150304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761150303,
					"content": "Sürekli olarak doğru olanı yapmak daha zordur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761150305
					]
				},
				{
					"id": 761150305,
					"content": "Verdiği kararların sorumluluğu kendisine aitti. Son anında bile yaptığı hataları kabul etme şansı vardı. Ne var ki o şiddete başvurmayı seçti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150306
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150306,
					"content": "Yaptığı tüm yanlış hamleler nihayetinde onu bu noktaya sürükledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150307
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150307,
					"content": "#Neyse, bitti gitti işte. Güzel bir iş başardık. {NICKNAME}, av kanıtını konuştuğumuz gibi Leszek'e götürebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150308
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150308,
					"content": "İşi ikinize bırakmam çok iyi oldu! Bugün tatil yapmış gibi oldum resmen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150309
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150309,
