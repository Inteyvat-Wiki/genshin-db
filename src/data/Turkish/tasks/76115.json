			},
			"dialogs": [
				{
					"id": 761150201,
					"content": "... Ben hiçbirinize hiçbir şey yapmadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150202
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761150202,
					"content": "... Gelme sebebimizi biliyorsun galiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150203
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150203,
					"content": "... Tüm o şeyler geçmişte kaldı. Ben sadece huzurlu bir hayat istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150204
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761150204,
					"content": "Başkasından çaldığın hayatı yaşayarak mı huzur bulacaktın? Önce Juhani'de denedin ama işe yaramadı. Şimdi sırada Derwent var demek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150205
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150205,
					"content": "Kötü bir performansla seyircilerini uzun süre kandıramazsın. Artık daha fazla kurbanın olmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150206
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150206,
					"content": "... Juhani mi? *Onun* yerini mi almışım ben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150207
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761150207,
					"content": "Sahip olduğu hiçbir şey ona ait değildi! Her şeyi daha güzel görünerek, daha güzel konuşarak elde etti o.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150208
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761150208,
					"content": "Aynıydık biz! Sahip olduğu her şey bana aitti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150209
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761150209,
					"content": "Ya Bay Derwent ve tüccara ne demeli? Onlar ne kötülük yaptı sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150210
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150210,
					"content": "Onlar... Onlar sormamaları gereken sorular sordular bana. Tıpkı sizin gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150211
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761150211,
					"content": "Öleceksiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Derwent"
				}
			]
		},
