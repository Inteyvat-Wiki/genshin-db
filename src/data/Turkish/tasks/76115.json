			"dialogs": [
				{
					"id": 761150101,
					"content": "Nefer? Jahoda? Sizin burada ne işiniz var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761150102,
					"content": "Çalışıyoruz! Sırrını çözemediğimiz av hedefiyle ilgili bir ipucu bulduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150103
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150103,
					"content": "Jahoda size av hedefi \"Kırık Çene\" Hark hakkında öğrendiği her şeyi ve Sırlar Arşivi'nin topladığı tüm bilgileri anlatır...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761150104
					]
				},
				{
					"id": 761150104,
					"content": "Önce çıkarımımızı söyleyeyim. Gerçek keşiş Derwent muhtemelen artık hayatta değil. Şu an kulübede yaşayan kişi, av hedefimiz Kırık Çene Hark.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150105,
					"content": "Jahoda'nın bulduğu günlük sayfalarına göre Derwent, Hark'ın kim olduğunu bilmesine rağmen onu kulübesine almış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150106
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150106,
					"content": "Hark'ın eski günlerine geri dönmesi şaşırtıcı değil aslında. Derwent'ten kurtulduktan sonra kulübeye yerleşip keşiş gibi davranmaya başlamış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150107
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150107,
					"content": "Araştırmaya gittiğimde yüzünü göstermeyi kabul etmedi ama durum ayan beyan ortada, o evde yaşayan kişinin gerçek Derwent olmasının imkanı yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150108
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150108,
					"content": "Hark keşiş numarası yaptığı için herhangi bir şüphe uyandırmadan istediği tüm tuhaf işleri yapabilecek. Taktığı maskenin de \"kendi ekinlerini yetiştirmesiyle\" uzaktan yakından alakası yok. Yarasını saklamak için maske takıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150109
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150109,
					"content": "Kayıp tüccara gelince... En kötü ihtimalle çoktan hayatını kaybettiğini düşünüyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150110
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150110,
					"content": "Biri nasıl bu kadar... Kötü olabilir? İyiliğe karşılık cinayet işlemek... Paimon'un kanını kaynatıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761150111,
					"content": "Açıkçası ben Gezginler Grubunun mallarını çalan kişinin Hark olduğunu zannetmiyorum. Yeterince güçlü bir motivasyonu yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150112
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150112,
					"content": "10 yıl boyunca kendisine hakim olmuş. Birkaç çalıntı maldan kazandığı para, onca yıllık emeğini çöpe atmaya değer mi? Hiç sanmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150113
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150113,
					"content": "Biraz beyin fırtınası yapalım bence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150114
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150114,
					"content": "Atlas'ın enkazına geri döndüğünü, hazineyi bulmaya gelen hazine avcılarına saldırdığını biliyoruz. Varını yoğunu kaybeden insanlar genellikle her şeyin başladığı yere dönmeye meyillidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150115
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150115,
					"content": "Atlas'ın dümencisiyken şöhrete, paraya, istediği her şeye sahipti. Peki Gezginler Grubuna katıldığında eline ne geçti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150116
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150116,
					"content": "10 yıl boyunca uslu durdu ama hırsızlık olayı yaşandığı anda herkesin şüphelendiği ilk kişi yine de o oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150117
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150117,
					"content": "Dahası, bir zamanlar kendisi gibi korsanlık yapan ama kendisi kadar meşhur olmayan Juhani herhangi bir suçlamaya maruz bile kalmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150118
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150118,
					"content": "Hark, Juhani'yi suçlamaya çalıştı ama kimse ona inanmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150119
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150119,
					"content": "Hayal kırıklığının ve öfkenin etkisiyle ilk hatasını yaptı. Bu olayın dönüm noktası da bu oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150120
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150120,
					"content": "Keşişin kulübesinde de benzer bir olay yaşanmış olsa gerek... Hark gibi biri söz konusu olduğunda en küçük atışmaların bile bedeli çok ağır olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150121
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150121,
					"content": "#Bu kadar tehlikeli birinin elini kolunu sallayarak kötülük yapmasına izin verecek halimiz yok {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150122,
						761150123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761150122,
					"content": "Bu tehlikeli suçluyla ben ilgileneceğim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761150124
					]
				},
				{
					"id": 761150124,
					"content": "#{NICKNAME} bu kadar istekliyse sen artık dinlenebilirsin Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150125
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150125,
					"content": "Bana uyar. Soruşturma için fazla mesai yaptım zaten. Küçük bir tatili hak ettim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150126
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761150126,
					"content": "Şüphelerimin doğru olup olmadığını çok yakında öğreneceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761150123,
					"content": "Sonunda ödül olsun ya da olmasın, bu işle ben ilgileneceğim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761150124
					]
				}
			]
		},
