			"dialogs": [
				{
					"id": 708280401,
					"content": "(\"Rhonabouillet'nin Rüyası\"nı ver.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280402
					]
				},
				{
					"id": 708280402,
					"content": "Aa, bir Fontaine şiir derlemesi! Bir bakayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280403
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280403,
					"content": "Geçmişe yolculuk... Göl Şövalyesi'nin sarayı... Üstüne bir de ilk görüşte bir hizmetçiye mi aşık oluyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280404
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280404,
					"content": "Puhaha... Bu bayağı komikmiş! Zamanda geriye gitme şansı yakalıyorsun ve tüm derdin kendi atanın yaşındaki birine kur yapmak mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280405
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280405,
					"content": "Gerçi olay bu ya. Sonuçta bir aşk şiiri bu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280406
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280406,
					"content": "Hah, şimdi anladım. Aşk gerçekten de insanların aklını başından alıyor. Neyse, onu alıp daha sonra düzgünce okuyacağım. Teşekkürler altın saçlı maceracı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				}
			]
		},
		{
			"id": 7082805,
			"completionStepIds": [
				7082805
			],
