					"Elsie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280501,
					"content": "Haha, teşekkürler altın saçlı maceracı! Sen benim kahramanımsın, en büyük kahramanım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280502
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280502,
					"content": "Şimdiden zihnimde kabaran ilhamı hissedebiliyorum, tıpkı Fırtına Dehşeti'nin İnindeki rüzgarlar, Chenyu Vadisi'ndeki Zehirli Pus ve Seirai Adası'ndaki gök gürültüleri gibi taşmak üzere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280503
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280503,
					"content": "Kulağa çok tehlikeli geliyor!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280504
					]
				},
				{
					"id": 708280504,
					"content": "Heh, bekle de gör! Tüm bu fikirleri hemen şimdi not alıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280505
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280505,
					"content": "Linus'un gösterişli şiirlerinin hiç şansı yok. Başyapıtım tamamlandığında Teyvat'ın tüm hanlarında benim adım yankılanacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				}
			]
		},
