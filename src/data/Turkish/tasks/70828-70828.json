	"talks": [
		{
			"id": 7082801,
			"completionStepIds": [
				7082801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7082801",
							"2"
						],
						"stepId": 7082801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Elsie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280101,
					"content": "Şey, affedersiniz! Altın saçlı maceracı, lütfen biraz bekleyin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280103,
						708280104
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280103,
					"content": "Yardım mı lazımdı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280102
					]
				},
				{
					"id": 708280102,
					"content": "Ha, yok yok, öyle bir şey değil! Sadece elinizde aşk hakkında bir şiir derlemesi olup olmadığını soracaktım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280107
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280107,
					"content": "Bak, ben olağanüstü bir ozanım. Öyle ki Lord Barbatos'tan sonra tüm Mondstadt'taki en olağanüstü ozan olabilirim! Cidden harikayımdır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280108
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280108,
					"content": "Ama bir de Linus var... O sinir bozucu ozan benim daha iyi olduğumu asla kabul etmiyor! Sürekli karşıma çıkıp durmadan bana şiirler okuyor! Nereden bakarsan bak, bariz bir şekilde bana üstünlük taslamaya çalışıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280109
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280109,
					"content": "Ve en kötüsü ne biliyor musun? Tüm şiirleri aşk ve romantizm hakkında... Benim daha önce elimi bile sürmediğim konular!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280110
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280110,
					"content": "Bu yüzden artık ipleri elime alıyorum. Öyle destansı bir aşk şiiri yazacağım ki Mondstadt bunu asla unutmayacak! O zaman gerçek yetenek neymiş görür!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280111
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280111,
					"content": "Gerçi... Tüm zamanımı muhteşem sanat eserlerine adadığım için bizzat aşkı deneyimleme fırsatım olmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280112
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280112,
					"content": "O yüzden elinde aşka dair bir şiir kitabı falan varsa lütfen bana sat! Sayfalarını şöyle bir karıştırsam yeter, ardından ilham sel olup akmaya başlayacak zaten. Bendeki bu yetenekle aksi düşünülemez bile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280104,
					"content": "Korkarım yardım edemeyeceğim. İlgilenmem gereken başka işlerim var. Hoşça kal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280105
					]
				},
				{
					"id": 708280105,
					"content": "Hayır, hayır! Yardım istemiyorum. İşi ters giden herkes bir yabancıdan yardım isteseydi kimse seyahat etmeye cesaret edemezdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280106
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280106,
					"content": "Öhöm. Sadece yanınızda bir aşk şiirleri kitabı olup olmadığını sormak istemiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280107
					],
					"speakerTitle": "Elsie"
				}
			]
		},
		{
