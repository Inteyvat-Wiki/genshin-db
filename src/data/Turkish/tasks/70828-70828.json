				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Elsie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708280301,
					"content": "(\"İlahi Aşkın Tezahürü\"nü ver.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280302
					]
				},
				{
					"id": 708280302,
					"content": "Aa! Bunu daha önce duymuştum. Favonius Kilisesinin bir şiir derlemesi, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280303
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280303,
					"content": "Bir bakayım... \"Ruhu alevler içinde bir tarla, savuruyor ateşli şarkısını rüzgara. Yıldızlar, ay ve parlak güneş arasında, kendi ışığım bile yanıyor onun parıltısıyla...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280304
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280304,
					"content": "Bu nasıl bir şiir böyle? Açıkçası biraz rahatsız edici... Favonius Kilisesi belli ki şiirden anlamıyor. Yani, yıldızlar, ay ve güneş hep birlikte görünür mü hiç? Yok daha neler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280305
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280305,
					"content": "Pekala, karar verilmiştir! Özgüvenim yerine geldi. Eğer bu kitaptaki şiirlerin seviyesi buysa ben bile daha iyisini yapabilirim. Bunu alacağım. Teşekkürler altın saçlı maceracı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				}
			]
		},
