				"points": []
			},
			"dialogs": [
				{
					"id": 708280201,
					"content": "(\"Ay-Khanoum'un Şarkısı\"nı ver.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708280202
					]
				},
				{
					"id": 708280202,
					"content": "Vay canına, ne kadar güzel bir kitap! Bakalım içinde neler yazıyormuş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280203
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280203,
					"content": "\"... Ne taht vardır yılansız ne gül açar dikensiz. Acıyı son damlasına kadar yudumla Ferigees ve söz ver bana o güzel gözlerinle... Söz ver bana...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280204
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280204,
					"content": "Şey... Bir dakika, bu nasıl okunuyordu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708280205
					],
					"speakerTitle": "Elsie"
				},
				{
					"id": 708280205,
					"content": "Yok, bu beni kesinlikle aşar! Daha şimdiden dilim dolandı! En iyisi ben bunu eve götüreyim de sonra sindire sindire okuyayım... Teşekkürler altın saçlı maceracı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Elsie"
				}
			]
		},
		{
			"id": 7082803,
			"completionStepIds": [
				7082803
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
