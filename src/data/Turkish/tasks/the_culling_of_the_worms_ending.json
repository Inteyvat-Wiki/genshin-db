			"dialogs": [
				{
					"id": 735190101,
					"content": "Anlamıyorum... Raporu yazmak için kafeye gitme fikrini ortaya atan oydu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190102,
						735190103
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190102,
					"content": "Burada tek başına ne yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190104
					]
				},
				{
					"id": 735190104,
					"content": "*iç çeker* O konu hakkında konuşmak istemiyorum. Tek başına rapor yazmaya gitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190105
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190105,
					"content": "Aslında dün kafede buluşacaktık ama çok uzun zaman sonra ancak çıkageldi. Raporu yazmak için de yanında ne bir kalem ne de bir kağıt getirmişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190106
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190106,
					"content": "Rapor yazmada kullanacağı vakti boş harcıyor diye onu eleştirdim ve küplere bindi! Raporu kendi başına yazacağını söyledi ve beni kovdu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190107
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190107,
					"content": "Çok saçma değil mi sence de?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190108
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190108,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190109
					]
				},
				{
					"id": 735190109,
					"content": "Alıştım artık onun bu tür öfkeli hallerine, birkaç güne sakinleşir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190110
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190110,
					"content": "Keşke duyguları kontrol etmek bir makinayı kontrol etmek gibi kolay olsaydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190111,
						735190112
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190111,
					"content": "İyi şanslar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190113
					]
				},
				{
					"id": 735190113,
					"content": "Hı? Sen bile tuhaf davranıyorsun. Neyse... Etrafta halen birkaç tane etkilenmiş Solucan var ama kendi haline bırakınca durum yavaş yavaş yatışacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190114
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190114,
					"content": "Ama vaktin varsa yoldan geçenleri tehdit etmelerini durdurmaya yardım et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190115
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190115,
					"content": "Bu arada element ortamı ile yükleme cihazı artık normale döndü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735190116
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190116,
					"content": "Solucanezen Topunu tam güçte denemek için bundan daha iyi bir vakit olamaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735190112,
					"content": "Bol şans.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190113
					]
				},
				{
					"id": 735190103,
					"content": "Shriya nerede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735190104
					]
				}
			]
		}
	]
