			"dialogs": [
				{
					"id": 742460101,
					"content": "Hoş geldiniz! Sipariş ettiğiniz tüm Xiao Feneri parçaları hazır, her parça ayrı ayrı su geçirmez hale getirildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460102
					],
					"speakerTitle": "Fengtai"
				},
				{
					"id": 742460102,
					"content": "Her biri beş altı kat yağlı kağıda sarılı, yani onları bir gölete atıp bir hafta bekletseniz bile hiçbir şey olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460103
					],
					"speakerTitle": "Fengtai"
				},
				{
					"id": 742460103,
					"content": "Teşekkür ederim, eline sağlık. İçin rahat olsun, emeğinin ve masraflarının karşılığını eksiksiz ödeyeceğim. Ne de olsa Fener Şenliği zamanı değilken tüm bunları tedarik etmek epey zahmetli olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460104
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742460104,
					"content": "Yok canım, lafı mı olur! Bu kadar kibar olmanıza gerek yok! Ticarette müşterinin ihtiyaçları her zaman önceliklidir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460105
					],
					"speakerTitle": "Fengtai"
				},
				{
					"id": 742460105,
					"content": "Ha, aklıma gelmişken! Geçen sefer aldığınız çayı nasıl buldunuz? Biraz Chenyu Adeptus Çayı ister misiniz? Elimize yeni bir parti ulaştı, taze kurutulmuş! Her bir yaprağı birinci sınıf kalitede!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742460106
					],
					"speakerTitle": "Fengtai"
				},
				{
					"id": 742460106,
					"content": "Anlıyorum. Eğer bir indirim varsa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neuvillette"
				}
			]
		},
