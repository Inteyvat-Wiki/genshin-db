					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151102,
					"content": "Ay... Sonunda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10151103,
					"content": "Gezgin, şimdiye kadar maceramızın sana kattığı bir şey oldu mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151104
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151104,
					"content": "Tuhaftı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10151105
					]
				},
				{
					"id": 10151105,
					"content": "Tuhaf mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151106,
						10151107
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151106,
					"content": "Sosyete hayatı mı yaşadık emin değilim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10151108
					]
				},
				{
					"id": 10151108,
					"content": "Hahaha... Acaba hangisi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151109
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151109,
					"content": "Bu tür yolculukların ortaya çıkardığı sorular hepsinden daha karmaşık olur. Bırakayım da sen bunun üzerine uzun uzun düşün. Ayrıca yardımınızın karşılığında ne yapacağıma karar verdim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151110
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151110,
					"content": "Size yemek ısmarlayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151111,
						10151112
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151111,
					"content": "Zhongli... Ismarlayacak mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10151113
					]
				},
				{
					"id": 10151113,
					"content": "Bu arada endişelenmeyin. Bu defa Mora getirmeyi unutmayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151114
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151114,
					"content": "Bu akşam ikinizi birden Liyue'de çok sevilen küçük bir restorana götüreceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151115
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151115,
					"content": "Küçük restoran derken, güzel bir restorandan mı bahsediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10151116,
					"content": "Aynen öyle. Limanın yakınında \"Üçüncü Rauntta Nakavt\"ta buluşalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10151112,
					"content": "Vay. Harika.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10151113
					]
				},
				{
					"id": 10151107,
					"content": "Yoksa fakirlerin yaşadığı zorlukları mı deneyimledik?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10151108
					]
				}
