			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150601,
					"content": "Bu parçalar işe yarar gibi duruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150602
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150602,
					"content": "Bir saniye, aleti tamir etmeye çalışacağım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150603
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150603,
					"content": "Tamamdır. Guizhong Balistası düşündüğümden daha karmaşık tasarlanmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150604
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150604,
					"content": "Vay be! Nasıl çalıştırıyoruz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150605,
					"content": "Gayet basit. Şöyle yapsak yeter... Baksanıza, dürbünü bile var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150617
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150617,
					"content": "Burada... Hiçbir şey yok ve burada... Daha da bir şey yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150606,
					"content": "Hey! Ne yaptığını sanıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150607
					],
					"speakerTitle": "Freckle Huang"
				},
				{
					"id": 10150607,
					"content": "Bu tareti tamir edip de... Ne yapacaksın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150608
					],
					"speakerTitle": "Freckle Huang"
				},
				{
					"id": 10150608,
					"content": "Taret değil, Guizhong Balistası. Ayrıca soru sormadan önce adını söylemelisin. Bu bir görgü kuralıdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150609
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150609,
					"content": "Kör müsün sen? Karşında Hazine Avcılarının lideri var ihtiyar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150610
					],
					"speakerTitle": "Freckle Huang"
				},
				{
					"id": 10150610,
					"content": "Bu alan tıklım tıklım gizli hazinelerle dolu ama bu alet etrafı gözetlerken yanlarına bile yaklaşamıyoruz. Herhangi bir mekanik cihaz gibi duruyor olabilir ama inan bana bunun kendi aklı var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150611
					],
					"speakerTitle": "Freckle Huang"
				},
				{
					"id": 10150611,
					"content": "En son dağlara yaklaştığımızda arkadaşlarımızdan birini şişliyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150612
					],
					"speakerTitle": "Freckle Huang"
				},
				{
					"id": 10150612,
					"content": "Bunu durdurmak için arkadaşlarımız hayatını riske attı ve inanılmaz bir şekilde başardık... Ama sonra iki dakika arkamızı döndük ki ne görelim? HEMEN GELİP TAMİR Mİ ETTİN?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150613
					],
					"speakerTitle": "Freckle Huang"
				},
				{
					"id": 10150613,
					"content": "Tamir edeceğiniz bir sonraki şey suratlarınız olacak, tabii hayatta kalırsanız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150614
					],
					"speakerTitle": "Freckle Huang"
				},
				{
					"id": 10150614,
					"content": "Cık, cık. Bir Adeptusun mirasına bencil amaçlarla hasar vermek. Rezil bir davranış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150615
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150615,
					"content": "Kınanması gereken biz değil sizsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150616
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150616,
					"content": "#Aynen öyle, hadi {NICKNAME}, şunların icabına bakalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 101507,
			"completionStepIds": [
				101507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101507",
							"2"
						],
						"stepId": 101507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qiqi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150701,
					"content": "Kusura bakmayın, sözleşmedeki sorumluluklarımızı yerine getiremedik. Bahsettiğin adeptihayvan Hindistankeçisinin izini bulamadık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150702
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150702,
					"content": "Ne büyük hayal kırıklığı. Önemli değil, ama benim için büyük bir hayal kırıklığı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150703
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150703,
					"content": "Zavallı Qiqi... Neden Paimon birden çok suçlu hissetti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150704,
						10150705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150704,
					"content": "Qiqi, verebileceğin başka ipucu var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150706
					]
				},
				{
					"id": 10150706,
					"content": "Hindistankeçisi sütü lezzetli, çok lezzetli. Normal keçi sütünden çok daha iyi. Yalnızca bir adeptihayvan böyle lezzetli süt yapabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150707
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150707,
					"content": "Kusura bakmayın hafızam biraz kötü. Sütün adını hatırlayamıyorum. Bu yüzden kenara yazmıştım. Nereye koydum onu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150708
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150708,
					"content": "İşte burada. Adı \"hindistan cevizi sütü\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150709
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150709,
					"content": "Hı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150710,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150711
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150711,
					"content": "İkinize de özür borçluyum. Belki de durumu daha derinlemesine incelemem gerekirken bu zombi çocukla mantıklı gibi görünen bir anlaşmayı hemen kabul ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150712
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150712,
					"content": "Önemli değil Zhongli, bilmiyordun. Liyue deyiminde söylendiği gibi, \"Her şey rastgele ve... Nasıl herhangi bir şeyi öngörebilirsin ki\". Kimse böyle olacağını bilemezdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150713,
					"content": "Arkadaşlar, affedersiniz ama Qiqi kötü bir şey mi söyledi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150714
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150714,
					"content": "#Kusura bakma {NICKNAME} ama Paimon bu zavallı çocuğun dünyasını başına yıkma işini sana bırakıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150715,
						10150716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150715,
					"content": "Şimdi sana hindistan cevizi sütünün nereden geldiğini anlatacağız...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150717
					]
				},
				{
					"id": 10150717,
					"content": "Hayır... Mü-Mümkün değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150718
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150718,
					"content": "Qiqi için oldukça zor bir durum gibi görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150719,
						10150720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150719,
					"content": "Kabul etmek için biraz zamana ihtiyacı var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150721
					]
				},
				{
					"id": 10150721,
					"content": "Demek bugün birileri önemli bir hayat dersi öğrendi. Küçük Qiqi'mle ilgilendiğiniz için teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150722
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150722,
					"content": "Acaba kim olduğunuzu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150723
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150723,
					"content": "Ne kadar da kabayım. Ben Baizhu, Bubu Eczanesinin patronu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150724
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150724,
					"content": "Paimon Qiqi'yi patron zannediyordu... Meğer patron, boynunda ilaç malzemeleri taşıyan bir kaçıkmış!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150725,
					"content": "Ne kadar üzücü bir durum... Bu ufak maskot Qiqi'den de avanak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150726
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150726,
					"content": "Ah! İlaç... Yılan k-konuşuyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150727,
						10150728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150727,
					"content": "Vay canına, konuşan yılan!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150729
					]
				},
				{
					"id": 10150729,
					"content": "Normalde sessiz kalmayı tercih ediyorum ancak yabancılarla karşılaştığımda konuşmam gerek yoksa benim ecza dolabından kaçtığımı zannedebilirler. Ben yaşayan ve nefes alan bir yılanım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150730
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150730,
					"content": "Changsheng'e takılmayın, gerçekten iyi bir kızdır. Siz üçünüze gelirsek... Qiqi'yle birlikte yarattığınız kargaşayı bir kenara bırakırsak, burada ne işiniz var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150731
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150731,
					"content": "Bu güzel işletmede Ebedi Tütsü satıyor musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150732
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150732,
					"content": "Ebedi Tütsü mü? Elbette satıyoruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150733
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150733,
					"content": "Sonunda! Sonunda bir şeyler istediğimiz gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150734,
					"content": "Üç milyon Mora, en iyi kalite garantisiyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150735,
						10150737
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150735,
					"content": "Üç milyon mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150736
					]
				},
				{
					"id": 10150736,
					"content": "Altın Ev'i soy daha iyi! Gerçi onu Yedi Yıldız ele geçirdi... Güvenlik normalden daha sıkıdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150739,
					"content": "Hım... Üç milyon... Kendi başına zararsız bir sayı olsa da pratikte toplaması zor bir miktar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150740
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150740,
					"content": "Bu inanılmaz bir tutar! Asla o kadar çok Mora toplayamayız ve Zhongli'nin de... Üç milyon kadar eksiği var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150741
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150741,
					"content": "Doğru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150742
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150742,
					"content": "Utanmıyor da...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150743
					]
				},
				{
					"id": 10150743,
					"content": "Ne yapacağız? Bu noktada sürünerek Asilzade'ye mi döneceğiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150744
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150744,
					"content": "Hahahahahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150745
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10150745,
					"content": "Hindistankeçisi! Hindistan... Ahahaha, yanaklarım ağrıdı. Tanrım, buna kandığınıza İNANAMIYORUM!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150746
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10150746,
					"content": "Hey! Güleceğine anlayış göster!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150747
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150747,
					"content": "Gözyaşlarına boğulmak üzereyim... Teşekkür ederim, uzun zamandır böyle gülmemiştim. Karşılığında kendinizi içine düşürdüğünüz bu durumu çözmekten mutluluk duyarım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150748
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10150748,
					"content": "Affedersiniz efendim... Doktor Baizhu değil mi? Şeref verdiniz, ben Fatui Habercilerinden Asilzade. Küstahlığımı bağışlayın ama gelecekte sizinle iş birliği yapabileceğimiz birçok fırsat görüyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150749
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10150749,
					"content": "Bubu Eczanesinin hindistan cevizi sütü gibi sürekli tedariki gereken ürünler varsa Fatui sağlam ve hızlı bir dağıtım ağı kurarak yardım edebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150750
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10150750,
					"content": "Tuhaf... Fatui'nin baştan çıkarıcı tekliflerle işletmelere sızdığını biliyordum ancak... Yaygaranın tümü hindistan cevizi sütü için mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150751
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150751,
					"content": "Hindistan cevizi sütü. Baizhu. Çabuk. Qiqi hindistan cevizi sütü istiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150752
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150752,
					"content": "Evet, tabii ki Qiqi, sen ne istersen... Te-Teşekkürler Asilzade. Gelecekte başarılı bir iş birliği için sabırsızlanıyorum. Ebedi Tütsü için de sana indirim yapabilirim... 2.990.000 Mora diyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150753
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 10150753,
					"content": "Üç milyondan neredeyse hiç farkı yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150754
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150754,
					"content": "Hım... 2.990.000... Bu da kendi halinde bir sayı ancak pratikte üç milyonun asıl toplamından tam on bin daha az.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150755
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150755,
					"content": "Bunu da hallettiğimize göre Yujing Terası'na geri dönmemiz gerek. Bay Asilzade, Doktor Baizhu, Küçük Qiqi Hanım, görüşürüz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150756
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150756,
					"content": "Bu ekip inanılmaz. Gerçekten en son ne zaman böyle güldüğümü hatırlamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150757
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10150757,
					"content": "Umarım kulak kabartmışsındır. Ne kaçırdım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150758
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10150758,
					"content": "Evet Usta Asilzade. Yedi Yıldızın Altın Ev'i almasından bahsettiler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150759
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10150759,
					"content": "Vay, vay, vay. Ningguang ve Yedi Yıldız ahbapları. Exuvia orada değilse Altın Ev'de başka ne saklıyor olabilirler ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150760
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10150760,
					"content": "#Kusura bakma {NICKNAME} ama seni uyarmıştım değil mi? Liyue deyiminde söylendiği gibi: \"Yerin kulağı vardır.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10150737,
					"content": "Altın Ev'i soy daha iyi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150738
					]
				},
				{
					"id": 10150738,
					"content": "Çok yazık Altın Ev'i şimdilik Yedi Yıldız ele geçirdi... Güvenlik normalden daha sıkıdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150728,
					"content": "Liyue'de olan hiçbir şey artık beni şaşırtmıyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150729
					]
				},
				{
					"id": 10150720,
					"content": "Eninde sonunda büyümeleri gerekiyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150721
					]
				},
				{
					"id": 10150716,
					"content": "Hepsi hindistan cevizi ağacının meyvesiyle başlıyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150717
					]
				},
				{
					"id": 10150705,
					"content": "Sen bu Hindistankeçisini neden istiyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150706
					]
				}
			]
		},
		{
			"id": 101509,
			"completionStepIds": [
				101509
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101509",
							"2"
						],
						"stepId": 101509,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qiqi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150901,
					"content": "İşte buradasın! Ama tezgaha bile erişemiyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150902,
						10150904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150902,
					"content": "O bir... Zombi mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150903
					]
				},
				{
					"id": 10150903,
					"content": "Paimon haklı olabileceğini düşünüyor! Alnındaki tılsıma bak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150908,
					"content": "Bubu Eczanesine hoş geldiniz. Ben Qiqi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150909
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150909,
					"content": "Zamanında Qiqi öldü. Sonra Qiqi Adeptuslar tarafından kurtarıldı. Şimdi Qiqi bir zombi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150910,
						10150911
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150910,
					"content": "İnanılmaz bir hikaye ama çok sakin bir ifade...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150912
					]
				},
				{
					"id": 10150912,
					"content": "Mondstadt'ta böyle bir olay akılalmaz olurdu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150913,
					"content": "Merhaba... Küçük kız. Burada Ebedi Tütsü satıyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150914
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150914,
					"content": "Kusura bakmayın efendim. Reçetenizi getirdiniz mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150915
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150915,
					"content": "Ben... Ebedi Tütsü almak için reçete gerekmiyor değil mi? Zararlı bir madde değil ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150916
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150916,
					"content": "Qiqi ilacını getirebilir. Ancak sadece Qiqi'ye reçete gösterirsen. Bunlar Qiqi'nin Qiqi'ye emirleri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150917,
						10150918
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150917,
					"content": "\"Emirleri\" mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150920
					]
				},
				{
					"id": 10150920,
					"content": "Zombiler, emirlerinin izin verdiği kadarını yapabilir. Ancak bu durumda nasıl oluyorsa zombi, kendi emirlerini kendisi veriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150921
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150921,
					"content": "Sevgili Qiqi, korkarım ki reçete getirmedik. Ancak yine de bize Ebedi Tütsü bulmamızda yardımcı olursun diye umuyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150922
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150922,
					"content": "Tamam o zaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150923
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150923,
					"content": "Bunu nasıl başardın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150924
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150924,
					"content": "Ancak Qiqi size yardım ederse, siz de Qiqi'ye yardım edersiniz. Adil olan bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150925
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150925,
					"content": "Ne zamandan beri müşteriler, müşteriye hizmet veren çalışanlar için iyilik yapmak zorunda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150926
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150926,
					"content": "Önemli değil, bunu karşılıklı bir alışveriş gibi düşün. Böylece herkes kazanmış oluyor. Bazen Liyue'de anlaşma sanatı, zihin jimnastiği üzerinden zafer kazanmakla ilgilidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150927
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150927,
					"content": "Tianheng Dağı'na git. Guizhong Balistasını bul. Bir Hindistankeçisi avla. Lütfen ve teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150928,
						10150930
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150928,
					"content": "Nerede ve neyi nasıl avlayalım?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150929
					]
				},
				{
					"id": 10150929,
					"content": "Guizhong Balistası... Sanırım bu cihazın adını daha önce duymuştum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150932
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150932,
					"content": "Uzak geçmişte bir Adeptus tarafından Tianheng Dağı'na yerleştirilen bir arbalet tareti. Eski bir mekanik cihaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150933
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150933,
					"content": "Tianheng Geçidi'nde yer alan bu silah, Liyue'yi dış tehditlerden korumak için büyük canavarlara otomatik olarak saldıracak şekilde tasarlandı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150934
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150934,
					"content": "Bay Zhongli gerçekten Liyue'nin her yerini biliyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150935
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150935,
					"content": "Belli ki pek de sayılmaz... \"Hindistankeçisi\"ni ilk kez duyuyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150936
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150936,
					"content": "Hindistankeçisi efsanevi bir canlı. Bir adeptihayvan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150937
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150937,
					"content": "Eklemek istediğin bir şey var mı yoksa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150938
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150938,
					"content": "Hayır. Hindistankeçisi efsanevi bir canlı. Bir adeptihayvan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150939
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150939,
					"content": "Neye benzediğini bilmiyorum. Nereden bulunduğunu da bilmiyorum. Ayrıca nereden geldiğini de bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150940,
						10150941
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 10150940,
					"content": "Hatırlamadığın başka bir şey hatırlarsan bize söyle...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150942
					]
				},
				{
					"id": 10150942,
					"content": "Peki o zaman... <color=#00E1FFFF>Guizhong Balistasını</color> araştırarak işe başlayalım. Belki başka ipuçları buluruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150943
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150943,
					"content": "Hindistankeçisi de ne be?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150941,
					"content": "Elimizde pek işe yarar bir şey yok...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150942
					]
				},
				{
					"id": 10150930,
					"content": "Bizimle oyun oynuyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150931
					]
				},
				{
					"id": 10150931,
					"content": "Sanmıyorum. En azından Guizhong Balistasını daha önce duymuştum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150932
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150918,
					"content": "Neden bizi bu kadar zorluyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150919
					]
				},
				{
					"id": 10150919,
					"content": "Korkarım haklı olabilir. Sorun emirleriyle ilgili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150920
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150911,
					"content": "Zombiler de Adeptuslardan sayılıyor mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150912
					]
				},
				{
					"id": 10150904,
					"content": "Paimon, boydan bahsedecek olursak sen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150905
					]
				},
				{
					"id": 10150905,
					"content": "Kendine bak... Paimon uçabiliyor o yüzden boy bir sorun değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150906,
					"content": "Ama bununla ilgili tuhaf bir şey var. Alnında neden tılsım var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150907,
					"content": "Olamaz... O... Bir zombi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150908
					],
					"speakerTitle": "Paimon"
				}
			]
