			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150301,
					"content": "Şuna bak kocaman! Paimon bunun bir Adeptus tarafından yapıldığına inanıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150302,
					"content": "Ama bu nasıl kullanılıyor? Ne kadar güç gerektirdiğini bir düşünsene...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150303,
					"content": "Hım... Şu durumda zaten kullanılamaz. Bu alet bozulmuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150304
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150304,
					"content": "Ne? Bozulmuş mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150305,
					"content": "Bin yıllık yıpranmanın ardından Adeptus icatlarının bile bakımı zor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150306
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150306,
					"content": "Peki ne yapacağız? Çabuk Bay Zhongli, sınırsız sosyete bilgisi gücünü kullan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150307,
					"content": "Hım. Sanki tek özelliği, gerektiğinde ilginç gereksiz bilgiler vermek olan parazit bir burjuvaymışım gibi konuşuyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150308
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150308,
					"content": "Yine de biraz düşüneyim... Evet. İlk yapıldığında savaşta hasar görmesi ihtimaline karşı Guizhong Balistası için yedek parçalar üretilmişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150309
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150309,
					"content": "Hatırladığım kadarıyla o dönemin askeri deposu Geçidin içinde bir yerde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150310
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150310,
					"content": "Yedek parçaları depolandıkları yerden alabilirsek Guizhong Balistasını tamir edebiliriz. Aletin temel işleyiş prensibini anlamamız yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150311
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150311,
					"content": "Yani... Aletin temel işleyiş prensibini anlıyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10150312,
					"content": "Konu hakkında çok kısıtlı bilgim var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150313
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10150313,
					"content": "Elimizde <color=#00E1FFFF>parçalar</color> olursa en azından deneme yapabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		},
		{
			"id": 101506,
			"completionStepIds": [
				101515
			],
