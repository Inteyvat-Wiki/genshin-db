			"dialogs": [
				{
					"id": 760290101,
					"content": "Selamlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290102
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760290102,
					"content": "Ha? Dışarı mı gidiyorsun Columbina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290103,
					"content": "Evet. Lir tamir ettirmem gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290104
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760290104,
					"content": "... Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290105,
					"content": "Kuuhenkinin lirlerinden biri kırılmış. Bu liri çok önemsiyor, o yüzden eski haline getirmek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290106
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760290106,
					"content": "Kuuhenkiler gerçekten çok yetenekli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290107,
					"content": "Öyleler. Bu ufaklık sık sık burada müzik çalar, bazen ben de şarkı söyleyerek ona eşlik ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290108
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760290108,
					"content": "Paimon düşünüyor da, Kuuhenkileri biraz fazla şımartmıyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290109,
					"content": "Hak ediyorlar. Bunca zamandır bana eşlik ediyorlar. Hem onlar da bana sık sık ilginç eşyalar getiriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290110
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760290110,
					"content": "(Lauma bundan bahsetmişti. Kuuhenkiler içgüdüsel olarak Ay Tanrıçası'nı mutlu etmeye çalışırmış.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290111
					]
				},
				{
					"id": 760290111,
					"content": "Ayıptır sorması, liri nasıl tamir ettirmeyi planlıyorsun? İnsanlar tarafından görülmek istemediğini söylememiş miydin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290112,
					"content": "Hımm... Eskiden küçük hayvanlar veya Kuuhenkiler, tamir edilmesi gereken eşyaları bir zanaatkarın kapısına bırakmama yardım ederdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290113
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760290113,
					"content": "Zanaatkarın bulmasını beklemem yeterliydi. Tabii bazen bunun birkaç gün sürdüğü oluyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290114
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760290114,
					"content": "Çok dolambaçlı bir yöntem gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290115,
					"content": "Bizim halletmemizi ister misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290116
					]
				},
				{
					"id": 760290116,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290117
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760290117,
					"content": "Evet, o işi bize bırak. Kim bilir, belki de bugün içinde yaptırırız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290118,
					"content": "... Peki. Teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290119
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760290119,
					"content": "Rica ederiz! Bu arada eşyaları normalde hangi zanaatkara bırakıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290120,
					"content": "İsmini bilmiyorum. Kapısında kocaman bir mekanik el var. Deniz kabuğunu andıran yuvarlak bir evde yaşıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290121
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760290121,
					"content": "(Bir dakika, bu dediği...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290122
					]
				},
				{
					"id": 760290122,
					"content": "İçeriden hep Krumkake kokusu geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290123
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760290123,
					"content": "Kimden bahsettiği belli oldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
