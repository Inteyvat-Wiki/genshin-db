			"dialogs": [
				{
					"id": 760290201,
					"content": "Aino! Evde misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290202,
					"content": "Bir dakika, Paimon? Sen misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290203
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290203,
					"content": "Hangi rüzgar attı sizi buraya? Bana abur cubur getirdiniz mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290204
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290204,
					"content": "Paimon bunu soracağını tahmin etmişti! Al, gelirken bunları aldık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290205,
					"content": "Hehe, çabuk ver! Ineffa birazdan dönecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290206
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290206,
					"content": "Takılmaya mı geldiniz? Nasıl bir etkinlik yapsak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290207
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290207,
					"content": "Hehe... Aslında yardımına ihtiyacımız var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290208,
					"content": "Ayyy! O... Ucube şeyi benden uzak tutun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290209
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290209,
					"content": "\"Ucube şey\" mi? Bu liri mi diyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290210,
					"content": "Demiştim size, bilimin ya da mekanik ilkelerin açıklayamadığı şeylerden hiç haz etmiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290211
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290211,
					"content": "O lir var ya... Rastgele bir anda kapımda beliriyor. Ben tamir ettikten sonra da ortadan kayboluyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290212
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290212,
					"content": "T-Tabii ki öyle korkunç batıl inançlarım yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290213
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290213,
					"content": "Haa... Anlaşılan ortada bir yanlış anlaşılma var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290214,
					"content": "Ne demek istiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290215,
						760290216
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290215,
					"content": "Bu lir bir arkadaşımıza ait...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290217
					]
				},
				{
					"id": 760290217,
					"content": "Evet. Kötü bir niyeti yok, sadece liri kimse görmeden almak için kendince sebepleri var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290218,
					"content": "Öyle mi? Umarım doğru söylüyorsunuzdur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290219
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290219,
					"content": "Peki. Size güveniyorum. Liri tamir edeceğim ve bu sefer bir daha bozulmayacağından emin olacağım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290220
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290220,
					"content": "Biraz bekleyin. Hemen dönerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290221
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290221,
					"content": "Paimon Aino'ya güvenebileceğimizi biliyordu! Ama Columbina'nın rastgele eşya bırakmasından çok korkmuş anlaşılan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290222,
					"content": "Evet, bir karşılığı hak ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290223
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760290223,
					"content": "Aynen öy... Aaaaa! Burada ne işin var? Ödümüzü kopardın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290224,
					"content": "Size bir şey verecektim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290225
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760290225,
					"content": "Hımm? Bunlar ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290226,
					"content": "Kuuhenkinin topladığı birkaç ufak eşya. Zanaatkarın hoşuna gider diye düşündüm. Teşekkür etmek adına ona verebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290227
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760290227,
					"content": "Aaa... Ne kadar garip parçalar var. Tamamdır! Biz ona veririz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290228,
					"content": "Dönerken dikkat et kendine! Etrafta birileri olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290229,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290230
					]
				},
				{
					"id": 760290230,
					"content": "Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290231
					]
				},
				{
					"id": 760290231,
					"content": "Ha? Ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290232,
					"content": "Şurada...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290233
					]
				},
				{
					"id": 760290233,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290234,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290235
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290235,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290236
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760290236,
					"content": "... Görünüş analiz ediliyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290237
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290237,
					"content": "Niye yapıyorsun ki böyle bir şeyi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290238,
					"content": "Eşleşme bulundu: Nod-Krai Ay Tanrıçası Heykelleriyle %95 oranında benzerlik gösteriyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290239,
						760290241
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290239,
					"content": "Çünkü şey... O bir oyuncu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290240
					]
				},
				{
					"id": 760290240,
					"content": "#\"{NICKNAME}\" kişisinin kalp atışının hızlandığı tespit edildi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290243
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290243,
					"content": "Tamamdır, hallettim! O kadar güzel tamir ettim ki bir daha kırılması mümkün değil! Bir de atış... Aa! I-Ineffa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290244
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290244,
					"content": "En son ne diyordun Aino?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290245
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290245,
					"content": "Şey... Atışma bile yapılır bu lirle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290246
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290246,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290247
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290247,
					"content": "Arkanızdaki kim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290248
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290248,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290249,
						760290250
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760290249,
					"content": "Tamir edilen lirin sahibi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290251
					]
				},
				{
					"id": 760290251,
					"content": "(Yüzü tanıdık geliyor... Onu daha önce gördüm mü acaba? Aman, neyse. Asıl önemli olan konu başka. Paimon'un getirdiği abur cuburları saklayabildim...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290252
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290252,
					"content": "E-Evet! Liri tamir ettiğin için teşekkür etmek adına sana bu parçaları getirmiş Aino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290253
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290253,
					"content": "Aa, bakayım... İnanılmaz! Bu parçalar hem nadir hem de çok eski! Gerçekten alabilir miyim bunları?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290254
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290254,
					"content": "... Evet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290255
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760290255,
					"content": "Çok teşekkür ederim! Tamir edilecek bir şeyin olursa gelip beni bulabilirsin, utanmana gerek yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290256
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290256,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290257
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290257,
					"content": "Şey... Bizim gitmemiz gereken bazı yerler var, o yüzden... Aino, Ineffa, yanınıza başka bir gün uğrarız, olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290258
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290258,
					"content": "(Küçük Hanım'ı buradan çıkarmamız lazım, yoksa Ineffa kesin onu tanıyacak!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290259
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760290259,
					"content": "Olur! Sonra görüşürüz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290260
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290260,
					"content": "(Hemen ortalığı temizlemezsem Ineffa abur cubur kırıntılarını bulacak!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290261
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290261,
					"content": "Peki. Görüşmek üzere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290262
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290262,
					"content": "... Aino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290263
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290263,
					"content": "Iıı... Efendim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290264
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290264,
					"content": "Bu parçaları çerçeveletmek ya da saklamak ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290265
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290265,
					"content": "Ne? Neden ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290266
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290266,
					"content": "Bunlar \"Ay Tanrıçası'ndan gelen hediyeler\" gibi görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290267
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290267,
					"content": "Ne? Ne diyorsun ya? Bir ara hatırlat da devrelerini kontrol edeyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aino"
				},
				{
					"id": 760290250,
					"content": "Utangaç arkadaşımız!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290251
					]
				},
				{
					"id": 760290241,
					"content": "Iıı, hata payı ne kadar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290242
					]
				},
				{
					"id": 760290242,
					"content": "Hata payı en az düzeyde. Sonuç değerlendirmesi: Kesin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760290243
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760290216,
					"content": "Arkadaşımız yabancılardan biraz korkuyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290217
					]
				}
			]
