			"dialogs": [
				{
					"id": 760290401,
					"content": "(Hımm? Lir müziği mi? Galiba Columbina Kuuhenkilere lir çalıyor.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290402
					]
				},
				{
					"id": 760290402,
					"content": "(Son geldiğimizde lir henüz tamir edilmemişti. Columbina henüz herkesle tanışmamıştı...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760290403
					]
				},
				{
					"id": 760290403,
					"content": "Kısa bir süre önce...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
