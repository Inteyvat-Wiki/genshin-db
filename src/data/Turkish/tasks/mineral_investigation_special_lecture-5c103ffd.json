			"dialogs": [
				{
					"id": 761710101,
					"content": "Vay be, Speranza bugün çok kalabalık! Ne konuşuyorsunuz bakalım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761710102,
					"content": "Nod-Krai'daki en güzel kayanın hangisi olduğuna karar vermeye çalışıyoruz. Benim oyum Aydüşen Gümüşüne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710103
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761710103,
					"content": "Auni burada olmadığı için onun adına Buz Çakılları diyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710104
					],
					"speakerTitle": "Jurva"
				},
				{
					"id": 761710104,
					"content": "O zaman ben de Gökkuşağı Kristallerini aday gösteriyorum! Bir sürü farklı rengi var, üstelik onlardan silah da yapılıyor. Aydüşen Gümüşü ve Buz Çakıllarından çok daha kullanışlılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710105
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761710105,
					"content": "En güzel kayayı seçmiyor muydunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761710106
					]
				},
				{
					"id": 761710106,
					"content": "Şey... Sadece güzel görünen ama hiçbir işe yaramayan bir kayanın gerçekten güzel sayılabileceğini sanmıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710107
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761710107,
					"content": "Ya-ho... Ya-hoho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710108
					],
					"speakerTitle": "Lumi"
				},
				{
					"id": 761710108,
					"content": "Her ne kadar Gökkuşağı Kristali kadar günlük hayatta yaygın olmasa da Aydüşen Gümüşünün de epey bir kullanım alanı var aslında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710109
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710109,
					"content": "Hatta araştırmam sırasında Aydüşen Gümüşünden dokunmuş giysilerle ilgili ilginç hikayelere rastladım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710110
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710110,
					"content": "Ne? Yok artık! Kayalardan kıyafet dokunabiliyor mu gerçekten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710111
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761710111,
					"content": "Hehe, demek sana da inanması zor geldi ha? O zaman gel otur da dinle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710112
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710112,
					"content": "#Aydüşen Gümüşünden yapılmış giysiler... Paimon da çok merak etti! Hadi {NICKNAME}, durup biz de dinleyelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761710113,
					"content": "Evvel zaman içinde, Nod-Krai'da nadir süs eşyalarına takıntılı ve giyinip kuşanmaya çok meraklı bir Fey valisi varmış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710114
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710114,
					"content": "Bu valinin danışmanları, efendileri için yeni ve egzotik kıyafetler bulmak adına gece gündüz çalışırlarmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710115
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710115,
					"content": "Sonra bir gün, siyahlar giyinmiş genç bir terzi çıkagelmiş. Altın diyarın gizemli tekniklerini miras aldığını ve gümüş ay gibi parlayan kristalleri eğirip kumaş dokumak için ipliğe dönüştürebildiğini iddia etmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710116
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710116,
					"content": "Vali buna çok sevinmiş. Eğer kalıp kendisine kıyafetler yaparsa genç adama yüklü bir ödeme yapacağına söz vermiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710117
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710117,
					"content": "Genç terzi, atölyesine yüklü miktarda Aydüşen Gümüşü teslim edilmesini talep etmiş ve çalışırken kimsenin onu rahatsız etmemesini istemiş. Vali de bunu doğal olarak kabul etmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710118
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710118,
					"content": "Kararlaştırılan zaman geldiğinde vali, atölyenin tamamen boş olduğunu, ortada Aydüşen Gümüşü veya herhangi bir giysi olmadığını görmüş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710119
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710119,
					"content": "Yeni kıyafetlerini sabırsızlıkla bekleyen vali aceleyle sormuş: \"Onca Aydüşen Gümüşü nereye gitti? Peki ya söz verdiğiniz kıyafetler nerede?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710120
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710120,
					"content": "Genç terzi ellerini kaldırmış ve sanki bir kumaş parçasını silkeliyormuş gibi şöyle demiş:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710121
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710121,
					"content": "\"Bakın! Bana gönderdiğiniz Aydüşen Gümüşünü alıp bu cübbeye işledim. Tıpkı ay ışığı kadar saf. Hatta o kadar saf ki bir aptalın ya da sıradan bir adamın onu algılaması bile mümkün değil.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710122
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710122,
					"content": "Vali, danışmanına cübbenin nasıl göründüğünü sormuş, danışman da bunun şimdiye kadar gördüğü en muhteşem cübbe olduğunu, sanki gerçek ay ışığının dokunup şekil verilmiş hali gibi durduğunu söylemiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710123
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710123,
					"content": "Vali hiçbir şey göremiyormuş ama aptal ya da sıradan biri olduğunu kabul etmeye yanaşmadığından terzinin dediğini yapmış ve \"ay ışığı elbisesi\"ni \"giymiş\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710124
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710124,
					"content": "Vali, olağanüstü yeni cübbesini sergilemek için kasabanın en işlek caddesinde yürümeye karar vermiş. Ama tam bu sırada kemerinde deniz kabuğu olan bir çocuğun bağırdığını duymuş:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710125
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710125,
					"content": "\"Vali kıyafet giymiyor!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710126
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761710126,
					"content": "Görünüşe göre Mikko bu hikayenin sonunu tahmin etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710127
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710127,
					"content": "Terzi dolandırıcı. Nasha Kasabası'nda da böyle insanlar var. Hatta Sumerulu bir kadının bir sürü insanı dolandırdığını duymuştum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710128
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761710128,
					"content": "Peki Aydüşen Gümüşüne ne olmuş?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761710129
					]
				},
				{
					"id": 761710129,
					"content": "Güzel soru. Hikayeye göre genç terzi aslında kılık değiştirmiş Reed Miller'mış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710130
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710130,
					"content": "Validen aldığı Aydüşen Gümüşünü Moraya çevirip fakir kasaba halkına dağıtmış. Vali kasabada kendini sergilerken Reed Miller da yakındaki bir çatıdan gösterinin tadını çıkarıyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710131
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710131,
					"content": "Her taşın altından o çıkıyor resmen... Kaç tane hikayede adının geçtiğini saymayı bıraktım artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710132
					],
					"speakerTitle": "Jurva"
				},
				{
					"id": 761710132,
					"content": "Hımm... Ama eğer bu konuda yalan söylediyse bu en başından beri Aydüşen Gümüşünden yapılmış bir kıyafet olmadığı anlamına gelmez mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761710133,
					"content": "Öyle kıyafetler olduğuna inanıyorum ben ama onları dokuma sanatı kayboldu. Geriye kalan tek kanıt ise halk hikayelerinde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710134
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710134,
					"content": "\"Balıkçı ve Canavar\" masalında da bir ay ışığı elbisesinden bahsediliyor... Ama Mikko ve Maisie o masal için henüz çok küçükler, korkarım şimdilik beklemeleri gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710135
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710135,
					"content": "Ne? Haksızlık ama bu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710136
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761710136,
					"content": "Hım. Ne kadar tuhaf ve harika hikayeler biliyorsunuz Bayan Linnea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761710137,
					"content": "Benim de paylaşacak bir sürü seyahat bilgim var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761710138
					]
				},
				{
					"id": 761710138,
					"content": "Mutlaka! Eminim şimdiye kadar fark etmişsindir, dünya o kadar engin ki keşfedilecek daha nice sır var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710139
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710139,
					"content": "Bildiğimizi sandığımız şeylerin bile bilmediğimiz geçmişleri olabilir, tıpkı Aydüşen Gümüşü gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710140
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710140,
					"content": "Aslında Gökkuşağı Kristalleri için de aynı şey geçerli. Teyvat'ın her bölgesinin kendine özgü mineralleri vardır. Tıpkı farklı milletlerden insanların farklı gelenekleri olduğu gibi, farklı yerlerden gelen kayaların da kendilerine özgü nitelikleri vardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710141
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710141,
					"content": "Sabırla dinlersen sessiz kristallerin bile konuşmaya başladığını, hafızalarına kazıdıkları hikayeleri anlattığını fark edebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710142
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710142,
					"content": "Ve sadece mineraller de değil... Gerek kadim gerek yeni tüm yaşam formları güzeldir, eşsizdir... Bu dünya, her türden hikaye ve gizemle dolu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710143
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710143,
					"content": "Bir gizemin anlayış ışığıyla aydınlandığı o anda sayısız yeni olasılık kendini gösterir ve bütün dünya gözlerinin önüne serilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710144
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710144,
					"content": "Şey, k-kusura bakmayın, kendimi biraz kaptırdım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710145
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710145,
					"content": "Linnea ilgisini çeken konular hakkında konuşurken böyle olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710146
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761710146,
					"content": "\"Bayan Linnea\"ya Nod-Krai'daki en güzel kayanın hangisi olduğunu sorsak kesin \"Her kayanın kendine has bir güzelliği vardır.\" der.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710147
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761710147,
					"content": "O yüzden en iyisi siz ikinize soralım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710148
					],
					"speakerTitle": "Jurva"
				},
				{
					"id": 761710148,
					"content": "#En güzel kaya... Sen ne dersin {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710149,
						761710151,
						761710153,
						761710155
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761710149,
					"content": "Buz Çakılları.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761710150
					]
				},
				{
					"id": 761710150,
					"content": "Buz Çakılları mı? Paimon bunu hiç beklemiyordu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710158
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761710158,
					"content": "Peki ya sen Linnea? En güzel diyebileceğin sadece bir kaya türü seçme hakkın olsaydı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710159
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761710159,
					"content": "Şey... B-Bugünkü dersi burada bitirsek mi acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710160
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761710160,
					"content": "Vay be, Bayan Linnea sorudan kaçmaya çalışıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761710151,
					"content": "Aydüşen Gümüşü.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761710152
					]
				},
				{
					"id": 761710152,
					"content": "Bunca konuşulana rağmen en bariz olanı seçtin! Paimon'a göre de en güzeli Aydüşen Gümüşü!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710158
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761710153,
					"content": "Gökkuşağı Kristalleri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761710154
					]
				},
				{
					"id": 761710154,
					"content": "Demek Mikko'ya katılıyorsun. Bütün o renk çeşitliliği onlara müthiş bir güzellik katıyor kuşkusuz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710158
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761710155,
					"content": "Lumi'nin şapkası.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761710156
					]
				},
				{
					"id": 761710156,
					"content": "Ya-ho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710157
					],
					"speakerTitle": "Lumi"
				},
				{
					"id": 761710157,
					"content": "Iıı... Yani Paimon'a sorarsan evet, biraz kayaya benziyor... Ve kesinlikle çok güzel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761710158
					],
					"speakerTitle": "Paimon"
				}
			]
