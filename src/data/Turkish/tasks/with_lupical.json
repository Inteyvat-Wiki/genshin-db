					}
				]
			},
			"dialogs": [
				{
					"id": 100080301,
					"content": "Az kalsın ölüyorduk! İyi ki kurtlar yardıma geldi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080302,
					"content": "Hımm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080303
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080303,
					"content": "Bizim için o Hiçlik Kurtlarını durdurdular, hatta onları kovaladılar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080304,
					"content": "Ama bu... Kurt sorunu değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080305
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080305,
					"content": "Sen bunu Lupical'ın için yapıyorsun, değil mi? İşte onlar da senin güvende olmanı istiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080306,
					"content": "Kesin Kurt Kralı'na gidip \"Dinle! Bu sadece Lupical'ımızın sorunu değil. Bu tüm dünyanın sorunu!\" dediler... Ve sonra yardıma koştular!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080307,
					"content": "Hım, \"Lupical\"... \"Lupical\" demek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080308
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080308,
					"content": "Ben bir insanım ama \"Lupical\" olmak için kurt olmam gerekmiyor. Ben... Sadece onlara yardım etmek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080309
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080309,
					"content": "Ağzına sağlık Razor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080310,
					"content": "Belki de Poyraz Kurdu sürünün yardım etmesine izin vermiştir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080311
					]
				},
				{
					"id": 100080311,
					"content": "Çünkü senin kalbinden geçenleri biliyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080312
					]
				},
				{
					"id": 100080312,
					"content": "Öyle mi düşünüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
