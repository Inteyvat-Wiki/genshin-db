			"dialogs": [
				{
					"id": 100080101,
					"content": "Razor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080102,
					"content": "*koklar* Tanıdık bir koku. Aa, siz miydiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080103
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080103,
					"content": "İyi misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080104
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080104,
					"content": "Hehe, evet! Çok iyiyiz! Aa, Poyraz'a ne oldu Razor? Az önce konuştuğunuzu gördük. Sır falan mıydı yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080105,
					"content": "Ava çıkıyoruz. İkna etmeye çalışıyorum... Kurt efendisini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080106
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080106,
					"content": "Av mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080107,
					"content": "#(Aa, {NICKNAME}, bu Razor'ın \"görevi\" mi acaba?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080108,
					"content": "Kurtların yiyeceği mi bitti? Bu yüzden mi ava çıkıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080109,
						100080110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080109,
					"content": "Bana da birkaç domuz kapanı ver...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080111
					]
				},
				{
					"id": 100080111,
					"content": "Hayır. Bu av yiyecek için değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080112
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080112,
					"content": "Biz... Düşman avlayacağız. Karanlık kurt sürüsünü. Aldıkları topraklardan garip koku geliyor. Giderek kuvvetleniyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080113
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080113,
					"content": "Ormanı arındırmak için düşmanları avlamalıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080114
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080114,
					"content": "Aa, Poyraz kabul etti mi peki? Paimon onun geçen sefer şöyle bir şey dediğini hatırlıyor sanki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080115,
					"content": "\"Razor, sen bu işe karışmamalısın. Bu, kurtların kendi aralarında halletmesi gereken bir mesele.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080116,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080117
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080117,
					"content": "Ay, kusura bakma Razor. Paimon bu konuyu hatırlatmak istememişti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080118,
					"content": "Sorun değil. Lupical'ın kötü bir niyeti olmadığını biliyorum. Hem öğretmen bana kurt efendisiyle nasıl konuşacağımı öğretti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080119
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080119,
					"content": "Lisa sana onunla nasıl konuşacağını mı öğretti...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080120,
					"content": "Aa! Yani sana ne diyeceğini Lisa mı söyledi? O zaman Poyraz'ı ikna etmişsindir, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080121,
					"content": "Evet. Kelimeler... Zordu. Ama başardım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080122
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080122,
					"content": "Ha, demek o inatçı dev ihtiyarı ikna etmeyi başardın! Bu çok etkileyici Razor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080123,
					"content": "Kara kurtlar tüm dünyanın düşmanıdır. Öğretmen bunun bir kurt sorunu olmadığını söyledi. Bu, dünyanın sorunu... Ve kurt efendisi de kabul etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080124
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080124,
					"content": "Ama bu yüzden diğer kurtlar katılmayacak. Bu savaş benimle karanlık kurt sürüsü arasında...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080125
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080125,
					"content": "O zaman biz de geleceğiz! O berbat Hiçlik Kurtları bir süredir sinirlerimizi bozuyordu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080126,
					"content": "T-Teşekkürler... Yardımla av kolay olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080127
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080127,
					"content": "Peki bu av nasıl olacak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100080128,
					"content": "Tuzak kuracağız. Kara kurtları buraya kovalayacağız. Tuzağın içine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080129
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080129,
					"content": "Sonra kurt efendisi onları kıstıracak ve biz... Avı bitireceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080130
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080130,
					"content": "Hazır olunca söyle. Ava başlarız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080401
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080401,
					"content": "Hadi başlayalım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 100080110,
					"content": "Orman domuzları iyice büyümüş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080111
					]
				}
			]
		},
