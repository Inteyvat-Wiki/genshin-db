					"nextDialogs": [
						100080604
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 100080604,
					"content": "Senin için buradayız çünkü seni önemsiyoruz, tıpkı senin bizi önemsediğin gibi! Bu bizi Lupical yapıyor, değil mi?",
