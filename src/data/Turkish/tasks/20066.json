					"nextDialogs": [
						200660202
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660202,
					"content": "Hâlâ düşünüyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200660203
					]
				},
				{
					"id": 200660203,
					"content": "Daha önce birkaç Maceracıyla tanışmıştım. Onlar da aynı senin gibiydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660204
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660204,
					"content": "İş canavarlar oldu mu profesyonel kesilirler ama birkaç tahta çubuk kırmayı beceremezler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660205
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660205,
					"content": "Tahtayı da fırtına sığınağı gibi bir şey inşa ediyormuşçasına güçlendirirler. Kendi yeteneklerini gözlerinde büyütürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660206
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660206,
					"content": "Meydan okumaya bu kadar meraklılarsa neden gidip doğada bulabildikleri en büyük canavarla savaşmıyorlar ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				}
