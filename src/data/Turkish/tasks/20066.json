			"dialogs": [
				{
					"id": 200660101,
					"content": "Ah, çok sinir bozucu... Bu konuda ne yapmalıyım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660102
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660102,
					"content": "Neler yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200660103
					]
				},
				{
					"id": 200660103,
					"content": "Favonius Şövalyeleri denemelerine hazırlanıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660104
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660104,
					"content": "*iç çeker* Ancak bir türlü Jean kadar güçlü olamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660105
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660105,
					"content": "Güçten çok tekniğe odaklanmanın benim için daha iyi olacağını düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660106
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660106,
					"content": "Mesela tüm tahta hedefleri tek hamlede nasıl kırabileceğimi düşünüyorum. Çok sağlam görünmüyorlar ama elimdekiler bunlar. Babam bunları bulabilmek için çok uğraştı, mızmızlanırsam olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660107
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660107,
					"content": "Boştaysan nasıl altından kalkacağımı bulmama yardım eder misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660108,
						200660109
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660108,
					"content": "Üzerine kafa patlatırım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200660110
					]
				},
				{
					"id": 200660110,
					"content": "Tabii, hiç acele etme. Bu talim hedeflerinin bir yere gittiği yok zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660111
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660111,
					"content": "Bunu nasıl çözeceğim diye düşünüp dururken aynı şey hayatım için de söylenebilir, of...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660114
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660114,
					"content": "Bu mesafeden baktığımda bir tarafı hallederken diğer tarafa bomba atmak en iyi çözüm olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660115
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660115,
					"content": "Ha ha, şaka şaka. Bombayı bu civarda nereden bulacağımı bile bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660109,
					"content": "Beraber denemeye ne dersin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200660112
					]
				},
				{
					"id": 200660112,
					"content": "Takım savaşını seviyorsun demek. Bazıları için iyidir, her zaman destek alabileceğin birileri olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660113
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200660113,
					"content": "Benim gibilerse yalnız savaşçı olarak kendi ayakları üstünde kalabildiği kadar kalmaya çalışır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200660114
					],
					"speakerTitle": "Ellin"
				}
			]
		},
