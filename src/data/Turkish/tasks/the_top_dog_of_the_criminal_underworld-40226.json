			"dialogs": [
				{
					"id": 402260101,
					"content": "Sancak Gemisi... Anlaşılan bu katılımcı önce konaklama işini halletmek istemiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260102,
					"content": "Ortak! Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260103
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260103,
					"content": "Navia! Görüşmeyeli uzun zaman oldu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260104,
						402260105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260104,
					"content": "Tahmin edeyim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402260106
					]
				},
				{
					"id": 402260106,
					"content": "Evet. Spina di Rosula'yı temsilen geldim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260107
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260107,
					"content": "Yeraltı dünyasının en belalı patronu... Burada olman şaşırtmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260108,
					"content": "Yeraltı dünyasının en belalı patronu... Burada olman şaşırtmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260109,
					"content": "Haha, yeni lakabım bu mu? Hoşuma gitti, kulağa havalı geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260110
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260110,
					"content": "Seni bulduğumuz çok iyi oldu! Katılımcı kayıtlarına yardım etmek için bir görev aldık da. Bilirsin işte, eşyaların kontrolü falan filan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260111,
					"content": "Aa, öyle mi? O zaman buyurun siz de oturun. Bir sürü yemek söyledim. Clorinde ve Chevreuse eşyaları çıkarmaya gittiler ama birazdan dönerler... Hah, iyi insan lafın üstüne gelirmiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260112
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260112,
					"content": "Bizden mi bahsediyordunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260113
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 402260113,
					"content": "Clorinde! Chevreuse! Siz de buradasınız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260114,
					"content": "Nod-Krai karışık ve tehlikeli bir yer. Spina'nın Fontaine için ne kadar önemli olduğu düşünülürse başkanının başına bir iş gelmesini göze alamayız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260115
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 402260115,
					"content": "Arkadaşlarımla seyahat etmek benim de hoşuma gidiyor ama aşk olsun... Kiminle konuştuğuna bir bak! En fazla ne olabilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260116
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260116,
					"content": "Bu rahat tavırla başına ne işler açacağın belli olmaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260117
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 402260117,
					"content": "Peki o zaman. Düello Şampiyonumuzu benim... Korumam olarak kaydedebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260118
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260118,
					"content": "Çete patronu ve koruması... Anlaşıldı. Senin adını da fuara kaydedelim mi Chevreuse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260119,
					"content": "Gerek yok. Ben resmi bir görev için buradayım. Son zamanlardaki vakaların çoğu Nod-Krai ile bağlantılı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260120
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 402260120,
					"content": "Eveet, Paimon'un aradan çekilme vakti geldi, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260121,
					"content": "Ha, bir şey daha soracaktık! Spina fuarda neyi satışa sunmayı planlıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260122,
					"content": "İşte bunu! Fontaine Araştırma Enstitüsünün en yeni icatlarından biri. Kullanıcının savaşta Ruh ve Öz enerjisi yaymasını sağlayan bir tür aktarıcı sistemi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260123
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260123,
					"content": "Yani bu... Bir silah mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260124,
					"content": "Elbette! Böyle yasal denetimin olmadığı bir pazarda ilk kapışılan şey silahlar olur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260125
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260125,
					"content": "Orası öyle de... Chevreuse'ün önünde yasalara uymak zorunda olmamakla övünmek tuhaf geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260126,
					"content": "Sorun değil. Suç romanlarından \"kanunsuz bölge\" konseptine aşinayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260127
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 402260127,
					"content": "Bir dedektif olarak, burada işlerimi halletmek istiyorsam kuralları şimdilik bir kenara bırakmam gerektiğini biliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260128
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 402260128,
					"content": "Bu arada işe koyulsam iyi olacak. Devriye üyeleri beni bekliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260129
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 402260129,
					"content": "Ee, fuar alanına gitmeye hazır mısınız? Bizi takip etmeniz yeterli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260130,
					"content": "O zaman yola koyulalım! Biraz alışveriş de yapmak istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260105,
					"content": "... Fuar için mi geldin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402260106
					]
				}
			]
		},
