					"nextDialogs": [
						402260202
					]
				},
				{
					"id": 402260202,
					"content": "Vay be, beklediğimden büyükmüş burası. Umarım daha fazla kişi gelir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260203
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 402260203,
					"content": "İşler bir başlasın, ortalık o zaman hareketlenir. Yalnız görünüşe göre Jahoda'nın bayağı yardıma ihtiyacı var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402260204,
					"content": "Pekala, Clorinde ve ben şimdilik hazırız. Fırsatın olduğunda standımıza uğramayı unutma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
