				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hatim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230030201,
					"content": "Gezgin! Daha doğrusu servet ve şansın harikulade çocuğu! Gelmişsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030202
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030202,
					"content": "En son hazırladığın \"Altın Yemeği\" yedim ve Takas Noktasında voliyi vurdum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030203
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030203,
					"content": "Bugün buraya ne olup bittiğini kontrol etmek için geldim ve gerçekten de satın aldığım tüm vadelilerden büyük kazanç elde etmişim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030204
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030204,
					"content": "Hadi gel, Lambad'ın Hanına gidelim de istediğini ısmarlayayım sana. Bendensin! Sana teşekkürlerimi sunmam gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hatim"
				}
			]
		},
		{
			"id": 2300304,
			"completionStepIds": [
				2300303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300303",
							"2"
						],
						"stepId": 2300303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hatim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230030401,
					"content": "Bunların hepsi senin yardımın sayesinde oldu, o yüzden lütfen ne yemek istiyorsan onu söyle! Haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030402
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030402,
					"content": "Gerçekten de çok Mora kazandın herhalde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230030403,
					"content": "Sıradan insanlar için iyi para ama benim yani Hatim'in sahip olduklarına kıyasla çok az bir miktar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030404
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030404,
					"content": "Sonuçta ben eski toprak olarak onlarca yıllık tecrübeden gelen bilgiye sahibim. Vadeliler ile ilgileniyorsan seninle birkaç deneyimimi paylaşabilirim hatta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030405
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030405,
					"content": "En son ek faydalar elde edeceğini konuşmuştuk, o yüzden sor istediğini lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030406
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030406,
					"content": "Heh. Bu ek faydanın farkı çok da hissedilmiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230030407,
					"content": "Bizim vadelilerle işimiz yok sonuçta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030408
					]
				},
				{
					"id": 230030408,
					"content": "Saçmalama! Moradan da payını alacaksın elbette. Ama asıl değerli olan benim tavsiyelerim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030409
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030409,
					"content": "O zaman Paimon'un bir sorusu var... Bodurlop vadelileri olacak mı gerçekten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230030410,
					"content": "Paimon kar etmek istediği için falan değil tabii ki! Sadece soruyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230030411,
					"content": "Sadece tedavüldeki mallar vadeli olabilir. Yani piyasadaki un ve süt miktarı kadar Bodurlop Özü olursa Bodurlop Özü vadelilerinin ticareti yapılabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030412
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030412,
					"content": "Fakat bundan daha önce de bahsetmiştim. Bodurlop Özü vadelileri piyasasına girmek istiyorsan korkarım ki vahşi doğadaki tüm Bodurlopların soyu tükenecektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030413
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030413,
					"content": "Ayrıca bodurlop yetiştirme uzmanı enstitüler veya insanlar çıkıp sürekli büyük miktarlarda Bodurlop Özü üretebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030414
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030414,
					"content": "O zaman Bodurlop Özü fiyatları da artabilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030415
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030415,
					"content": "Nasıl yani? Alt tarafı birkaç Bodurlop Özü satın alıyorum, işler nasıl bu kadar karışıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230030416,
					"content": "#P-Paimon'a sorarsan {NICKNAME} o Bodurlopları dövmeye devam etsin o zaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230030417,
					"content": "Peki ya sen Servet Çocuğu? Senin sorun var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030418
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030418,
					"content": "\"Altın Yemek\" fikrini nereden buldun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030419
					]
				},
				{
					"id": 230030419,
					"content": "Gerçekten de Servet Çocuğuymuşsun. Hemen zengin olmanın yolunu soruyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030420
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030420,
					"content": "Ben \"buldum\" diyemem ama bu \"Altın Yemek\" olayını vadeli ticaret kariyerim sırasında öğrendim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030421
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030421,
					"content": "Vadeli ticaret piyasasına güven olmaz... Tabii bende \"Altın Yemekler\" olduğu sürece bu yatırım gemisini yönlendirmek çocuk oyuncağı olacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030422,
						230030423
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030422,
					"content": "Gerçekten saçmalık...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030424
					]
				},
				{
					"id": 230030424,
					"content": "Yeter bunu konuştuğumuz! Gel, ye hadi. Hepsini ye bakayım! Gelecekte yardımını daha sık isteyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030425
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030425,
					"content": "Al bakalım! Bu Döner Dürümü bir dene, Sumeru'ya has bir yemektir. Mutlaka denemelisin hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030426
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030426,
					"content": "Hatim ile birlikte lezzetli yemeğin tadını çıkarıyorsun...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 230030423,
					"content": "\"Huzur\" dedikleri tam da bu değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030424
					]
				}
			]
		},
		{
			"id": 2300307,
			"completionStepIds": [
				2300307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300307",
							"2"
						],
						"stepId": 2300307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hatim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230030701,
					"content": "Ben \"Servet Noktasına\" gittim ve hatta \"Altın Yemeği\" yedim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030702
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030702,
					"content": "Ama sonuç işte bu düşüş! Saçmalık! Bu piyasa tam bir saçmalık! Nerede adalet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030703
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030703,
					"content": "Hatim, uzun zamandır seni arıyoruz. İyi misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230030704,
					"content": "Ha, sizmişsiniz. Ben... İyiyim. Harikayım. Bakın, elim, kolum, her şeyim yerinde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030705
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030705,
					"content": "Sadece yatırdığım parayı kaybettim... Öhöm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030706
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030706,
					"content": "Özür dilerim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030707
					]
				},
				{
					"id": 230030707,
					"content": "Hayır! Senin suçun değil. Üzülme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030708
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030708,
					"content": "Elbette benim suçum da değil. Asıl suç kötü olan piyasanın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030709
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030709,
					"content": "Saçmalık! Bir kuralı yok ki! Bir bakıyorsun düşmüş, bir bakıyorsun çıkmış... Yani bu sefer çıkmadı tabii...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030710
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030710,
					"content": "Ben cidden... Cidden...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030711
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030711,
					"content": "Boş ver, inanamıyorum sadece... Ben, Kalimili zengin Hatim'in hâlâ vadeli ticarette başarılı olamadığıma inanamıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030712
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030712,
					"content": "Her şeyini kaybetmedin mi sen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230030713
					]
				},
				{
					"id": 230030713,
					"content": "Of, fark etmez. Hâlâ yedek fonlarım var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030714
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030714,
					"content": "Elimde Mora olmasa bile farklı yerlerde sermaye ve mallarım var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230030715
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230030715,
					"content": "Bekle sen Kalimi Takas Noktası! Ben, Hatim geri geleceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hatim"
				}
			]
		}
	]
}