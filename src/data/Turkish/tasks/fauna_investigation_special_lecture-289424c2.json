			"dialogs": [
				{
					"id": 761720101,
					"content": "Mora kadar parlak, resmen çopra dünyasının Altın Çopra Kralı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720102
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761720102,
					"content": "Mora mı? Mora mı var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761720103
					]
				},
				{
					"id": 761720103,
					"content": "Paimon az önce birinin altınla ilgili bir şey söylediğini mi duydu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761720104,
					"content": "Doğru duydun! Kuzeyde keşif yaparken bu eşsiz renkteki Altın Çoprayı buldum. Bölgede bu kadar belirgin bir renge sahip olan tek çopra buydu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720105
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720105,
					"content": "Şimdi gayet sağlıklı. Hayvanlardan anlayan bir doktora da gösterdim. Rengi patolojik bir durumdan kaynaklanmıyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720106
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720106,
					"content": "O zaman neden bu kadar farklı görünüyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761720107,
					"content": "Pek çok sebebi olabilir. Yaşam alanı, çevre, yaşadığı suyun nitelikleri, iklim... Hatta beslenme biçimi bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720108
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720108,
					"content": "Ama bunu spesifik tek bir nedene bağla derseniz korkarım ki bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720109
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720109,
					"content": "Bilmemek seni rahatsız etmiyor mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761720110
					]
				},
				{
					"id": 761720110,
					"content": "Neden etsin? O kadar nadir bir fenomen ki sadece tanıklık edebildiğim için bile inanılmaz şanslıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720111
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720111,
					"content": "Keşfimi belgeleyebilmek, çıkarımlar yapabilmek ve varsayımlarda bulunabilmek benim için fazlasıyla yeterli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720112
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720112,
					"content": "Tıpkı bir Pembe Buz Yüzgeçli Balina gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720113
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761720113,
					"content": "Derler ki bir Pembe Buz Yüzgeçli Balina görürsen dileklerin gerçek olurmuş ama onlar çok çok nadir görülür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720114
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761720114,
					"content": "Ama Linnea ile beraber bir tane görmüştük. Sanırım Linnea bize şans getirdiği içindi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720115
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761720115,
					"content": "Vay canına, o zaman biz de arayalım! Paimon'un o kadar çok dileği var ki... Balina önce hangisini gerçekleştirse acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761720116,
					"content": "Farklı renkler onlara gerçekten de mistik güçler veriyor mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761720117
					]
				},
				{
					"id": 761720117,
					"content": "... Hayal ürünü muhtemelen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720118
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720118,
					"content": "Yani pembe balinaların mistik güçleri yok mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761720119,
					"content": "Şey, özel renklere sahip bazı canlıların benzersiz yetenekleri olduğuna dair örnekler var... Ama gördüğümüz Buz Yüzgeçli Balina muhtemelen öyle bir canlı değildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720120
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720120,
					"content": "İnsanların sadece dilek dilemesi sorun değil de... Birilerinin o hayali hikayelere inanıp hayvana zarar vermesinden korkuyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720121
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720121,
					"content": "Hı? İnsanlar gerçekten böyle bir şey yapar mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761720122,
					"content": "Bunun cevabını biliyorum! Katya bana bazı kötü hazine avcılarının sıra dışı renklere sahip hayvanları avlayıp koleksiyonculara sattığını söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720123
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761720123,
					"content": "Doğru. Bir zamanlar Natlan'dan gelen hayvanlar karaborsada çok değerliydi. Özellikle de canlılarsa... Ama kemikleri ve kürkleri de yüksek fiyata alıcı buluyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720124
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720124,
					"content": "Kaçak mallarını şişirilmiş fiyatlardan satmak isteyen bazı tüccarlar, onları bir tür \"fantastik\" ürün olarak pazarlayıp müşterilere satmadan önce işler ve değiştirirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720125
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720125,
					"content": "Duyduğum bir vakaya göre kaçak avcılar, daha estetik görünmeleri ve kolay taşınmaları için Gukuzorların ayaklarını kesiyorlarmış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720126
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720126,
					"content": "Daha önce hiç Gukuzor görmemiş koleksiyoncular, onların doğuştan bacaksız olduğunu, tüm yaşamlarını gökyüzünde süzülerek, rüzgar ve çiy ile beslenerek geçirdiklerini sanıyorlarmış... Sanki doğanın bir tür mucizesiymiş gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720127
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720127,
					"content": "Onların bu pervasız egzotiklik arayışı, kaçak avcıların kötülüğünü daha da körükledi. Açgözlülük ve aldatmacadan doğan koca bir kaçakçılık ağı kurarak korkunç zararlara ve acılara neden oldular...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720128
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720128,
					"content": "Ya-ho...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720129
					],
					"speakerTitle": "Lumi"
				},
				{
					"id": 761720129,
					"content": "Kötülüklerle dolu bir denizde, bir canlının rengini değiştirmek için onu boyamak gibi nispeten önemsiz bir eylem bile yanlıştır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720130
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720130,
					"content": "Ö-Öyleyse... Şu Gümüş Kapibarayı bir yıkasak mı? Yoksa onu da mı kötü kalpli kaçak avcılar o renge boyamış?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720131
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761720131,
					"content": "Buna gerek olacağını sanmıyorum. Ben onu bulduğumda bir Dağ Yabanisinin yemek kazanında yıkanıyordu. Belki de orayı kaplıca sanmıştır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720132
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720132,
					"content": "Böyle bir kürkle doğan çok fazla Kapibara yoktur. Kaçakçılar da muhtemelen bu yüzden onu yakalamış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720133
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720133,
					"content": "Paimon, o pişirme kazanının içinde nasıl göründüğünü gözünde canlandırabiliyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761720134,
					"content": "Değil mi? Kendine özgü rengine rağmen diğer Kapibaralarla aynı doğaya ve mizaca sahip.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720135
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720135,
					"content": "Düşünüyorum da, daha önce biz de bir Beyaz Hırsız Gelincik yakalamıştık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720136
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761720136,
					"content": "Mora hırsızı! Peki ne oldu ona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761720137,
					"content": "Serbest bıraktık. Umarım dersini almıştır da bir daha Fatui araştırma tesislerine yaklaşmaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720138
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720138,
					"content": "Kapibara dostumuzdan farklı olarak o hayvanın renk değişimi sonradan kazanılmış bir özellik olmalı. Belki de çok yüksek yoğunlukta Kuuvahkiye maruz kalmasının bir sonucudur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720139
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720139,
					"content": "Mantıklı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761720140,
					"content": "Paimon düşünüyor da, benzersiz olmak her zaman iyi bir şey olmayabiliyor galiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761720141,
					"content": "Bazı canlıların sırf farklı oldukları için acı çekmesi ya da farklı olmalarının tek nedeninin başlarına kötü bir olay gelmiş olması...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761720142,
					"content": "Kulağa biraz bencilce gelebilir ama eğer Lumi bu kadar özel bir Ayaz Perisi olmasaydı biz de hiç ortak olamayabilirdik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720143
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720143,
					"content": "Ya-ho! Ya-hoho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720144
					],
					"speakerTitle": "Lumi"
				},
				{
					"id": 761720144,
					"content": "Pek umursamıyor gibi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761720145
					]
				},
				{
					"id": 761720145,
					"content": "Demek ki her zaman kötü bir şey de değilmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720146
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761720146,
					"content": "Eğer farklı olmak ikinizi bir araya getirdiyse o zaman bu elbette iyi bir şeydir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761720147,
					"content": "Helka'nın mektuplarından birinde Liyue'ye ait bir deyişe yer verdiğini hatırlıyorum. Lütuflar ve kötü talihle ilgili bir şeydi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720148
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761720148,
					"content": "\"Her kötü talihin içinde bir lütuf gizlidir; her lütfun içinde de bir kötü talih saklıdır.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720149
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761720149,
					"content": "Hehe, evet, o! Bu arada çok sessizsiniz Bayan Linnea. Öğretmen enerjinize ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720150
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761720150,
					"content": "Senin bana laf atacağın günler de gelecekmiş demek Mikko...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720151
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720151,
					"content": "A-Ama siz de bir zamanlar Deniz Kabuğu Çetesindeydiniz Bayan Linnea! *iç çeker* Neyse, bugünlük bu derin konuları bir kenara bırakalım da siz bize Volkodlakları anlatın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720152
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761720152,
					"content": "Gerçekten söylendiği kadar güçlüler mi? Leshy ve Snegoviklere kıyasla nasıllar mesela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720153
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761720153,
					"content": "Hımm, Volkodlaklar hakkında size anlatabileceğim bir sürü harika hikaye var... Ama bir dahaki sefere kalacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761720154
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761720154,
					"content": "Öf, yine mi \"bir dahaki sefere\"... Peki, ama sakın unutmayın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mikko"
				}
			]
		},
