			"dialogs": [
				{
					"id": 230290101,
					"content": "Vakti geldi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290102
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290102,
					"content": "Hâlâ Kutsal Ağacın kökleri üzerinde mi çalışıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230290103
					]
				},
				{
					"id": 230290103,
					"content": "Ah, Gezgin yine tam zamanında çıkageldin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290104
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290104,
					"content": "Tüm yardımların için çok teşekkürler. Kutsal Ağaç şu an harika durumda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290105
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290105,
					"content": "Bu konuyu Ladep'le konuştuk. Ağacın bir süre daha iyi durumda kalacağını düşünüyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290106
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290106,
					"content": "Sonunda tezlerimizi yazmaya zaman ayırabileceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290107
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290107,
					"content": "Bak, Pharez'den bir Kamera ödünç aldım, bunu Kutsal Ağacın durumunu kaydetmek için kullanacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290108
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290108,
					"content": "Gezgin, Kutsal Ağacın tamamının görüneceği şekilde bir fotoğraf çekebilir misin? Yeri haritanda işaretledim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290109,
						230290110
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290109,
					"content": "Oldu bil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230290110,
					"content": "Neden kendin yapamıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230290111
					]
				},
				{
					"id": 230290111,
					"content": "Şey, orası... Orası benim için çok yüksek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290112
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290112,
					"content": "Tek başıma yüksek bir yerde kalmaktan oldum olası korkarım. Rüzgara kapılıp gitmek... Ya da esen rüzgarın taslağımı alıp götürmesi gibi düşünceler aklımdan çıkmıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230290113
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230290113,
					"content": "Genelde yükseğe hep Pharez çıkardı ama şu an başka bir yerde bulunması gerekiyor. Güvenebileceğim tek kişi sensin Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				}
			]
		},
