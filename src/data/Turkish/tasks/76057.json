			},
			"dialogs": [
				{
					"id": 760570101,
					"content": "Bir dahaki sefere takımlı dövüşe ne dersin? Ya da belki düello yaparız? Aa, siz misiniz? Talim kampına hoş geldiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570102,
						760570105,
						760570109
					],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570102,
					"content": "Talim kampı hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760570103
					]
				},
				{
					"id": 760570103,
					"content": "Son zamanlarda giderek daha fazla kişi gelmeye başladı. Hepsi senin sayende. Tabii çocuklar ve Kovukçular da üzerlerine düşeni yaptı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570104
					],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570104,
					"content": "Bence talim kampı buluşmalar için mükemmel bir yer. Uzun zamandır görmediğin biriyle karşılaştığında konuşmaya nereden başlayacağını bilmek zor oluyor, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570105,
					"content": "Kovukçular hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760570106
					]
				},
				{
					"id": 760570106,
					"content": "Şey... Köstebeklerin yuvasına sermek için hedeflerden daha iyi bir şey bulamadım hâlâ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570107
					],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570107,
					"content": "Çocuklarla her türlü malzemeyi denedik ama her halükarda hedefleri tercih ediyorlar. Şimdilik onlarla ticaret yapmak tek seçeneğimiz gibi duruyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760570108
					],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570108,
					"content": "Ama hazine takası oranlarını çözdük sayılır ve oldukça iyi kar elde ediyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vaino"
				},
				{
					"id": 760570109,
					"content": "Bir ara tekrar uğrarım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760570110
					]
				},
				{
					"id": 760570110,
					"content": "İstediğin zaman gelebilirsin! Unutmayın, talim kampı ikiniz için de daima ücretsiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vaino"
				}
			]
		},
