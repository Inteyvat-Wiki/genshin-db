			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aberaku",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722410201,
					"content": "Ah, başka diyardan gelen Gezgin, bu sensin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410202
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410202,
					"content": "Sayende ruhum yeniden bir oldu. Artık her şeyi hatırlıyorum. İnanılmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410203
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410203,
					"content": "Belki biliyorsundur, çok ama çok önceleri Byakuyakoku'ya yoğun bir karanlık hakimdi. Halk ise Derinliklerin Ejdervarisi'nin korkusuyla yaşıyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410204
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410204,
					"content": "O zamanlar Dainichi Mikoshi'nin inşaatından sorumlu kişi bendim ve böylece Byakuyakoku, gece gündüz döngüsüne kavuştu. İsmindeki \"Byakuya\" da buradan geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410205
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410205,
					"content": "Hatta denmişti ki: \"Dainichi Mikoshi artık inşa edildiğine göre, bu topraklarda ebedi gece olsa bile en azından siyahla beyazı ayırt edebileceğiz.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410206
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410206,
					"content": "Düşününce ne kadar da utanç verici... Ruhumun parçaları yeniden bir olmadan önce, Dainichi Mikoshi'nin tamamlandığı ve insanların onun etrafında toplandığı günü bile hatırlayamamıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410207
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410207,
					"content": "Bunun benim en güzel hatıram olması gerekiyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410208
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410208,
					"content": "Evet, çok yazık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410209
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410209,
					"content": "Yazık derken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410210,
					"content": "Dainichi Mikoshi tamamlandığında Ejdervarisi hiç alışık olmadığı bir ışıkla geri püskürtülerek yenilmişti. Bundan sonra da insanlar huzura kavuştu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410211
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410211,
					"content": "Tam barış hüküm sürmeye başladı derken... Ah, insan kalbi anlaması ne zor şey. İçlerinde böyle bir kötülük beslediklerini kim bilebilirdi ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410212
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410212,
					"content": "Ey uzaklardan gelen Gezgin, kötülerin eline fırsat geçtiğinde, hak etmedikleri gücü ve zenginliği ele geçirmek için ne kadar doyumsuz olabileceklerini bildiğine eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410213
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410213,
					"content": "Bu emelleri doğrultusunda insanları kullanıp onların Dainichi Mikoshi'ye tapmalarını sağladılar. Onları böylesine beyhude ve cansız nesnelere inanma aptallığına sürüklediler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410214
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410214,
					"content": "En sonunda da toprak egemenliğinin \"Güneşin {RUBY#[S]Phaethon}Çocuğu\"na ait olduğunu iddia ettiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410215
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410215,
					"content": "Güneşin Çocuğu mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410216
					]
				},
				{
					"id": 722410216,
					"content": "Aynen öyle. Güneşin Çocuğu olarak hep küçük bir çocuk seçiliyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410217
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410217,
					"content": "O yaşlardaki çocukların dünyanın işleyişini anlaması imkansızdı. Bu toprakları yönetecek nitelikleri yoktu. Bu nedenle seçilen çocuklar, perdenin gerisinde iplerini kontrol eden kişilerin kuklaları oldular.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410218
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410218,
					"content": "Buna karşı çıkmak istedim ama kontrol ettikleri Güneşin Çocuğu beni ihanetle suçladı ve buraya mahkum etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410219
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410219,
					"content": "Ah, Güneşin Çocuğu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410220,
					"content": "Güneşin Çocuğu eninde sonunda kontrol edildiğini anlamadı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410221,
					"content": "Bu nedenle hiçbir Güneşin Çocuğu yetişkinliğe eremiyor. Çünkü dediğin gibi, yetişkinler kötülerin yönlendirmelerine o kadar kolay kanmıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410222
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410222,
					"content": "\"Ey kutlu Güneşin Çocuğu, başladı doğum töreni, Kanatlı Atın sırtında varacağın yer güneşin ziyafeti.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410223,
						722410224
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410223,
					"content": "Dur, umarım düşündüğüm şeyi söylemiyorsundur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410225
					]
				},
				{
					"id": 722410225,
					"content": "Evet. Doğum törenlerindeki gibi giyinip keyifli bir şekilde Dainichi Mikoshi'nin içerisindeki kutsal odaya götürülürler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410226
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410226,
					"content": "... O odadaki gizem Güneşin Çocuklarıyla alakalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410227
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410227,
					"content": "Bu dizgin birinin gerçekten güneşin çocuğu olduğunun kanıtı. Bir gün insanlara gösterip onları uyarmak için kullanırım diye buraya saklamıştım ama sanırım artık bunun bir anlamı yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410228
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410228,
					"content": "Başka bir diyardan gelen Gezgin... Ne o çocukları ne de bu ulusu koruyabildim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410229
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410229,
					"content": "Adım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410230
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410230,
					"content": "Aberaku, Helios'un Yaratıcısı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410231
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410231,
					"content": "Dainichi Mikoshi'nin inşasından ben sorumluydum. Ebedi karanlığın ortasına parlak aynayı astığımda, bir dahi olduğumu düşünmüştüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410232
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410232,
					"content": "Sahip olduğum onca yetenek! Onca kabiliyet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410233
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410233,
					"content": "Dainichi Mikoshi'yi kullanarak karanlıktan kurtulmayı hayal ediyordum fakat bu her şeyi yok eden ebedi gecenin aslında insanların kalbindeki açgözlülük ve arzu olduğunu bilmiyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410234
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410234,
					"content": "Uzaklardan gelen misafir, şimdi bu dizgini sana emanet ediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410235
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410235,
					"content": "Bu Kutsal Dizgin, tarihimizin ne denli gülünç bir durumda olduğunun göstergesidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410236
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410236,
					"content": "Güzelce sakla... Ya da ne istiyorsan onu yap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410237
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410237,
					"content": "Bu çok değerli bir hediye...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410238
					]
				},
				{
					"id": 722410238,
					"content": "Hah! Hayır, çoktan anlamını yitirdi. Kader sayesinde tekrar bir bütün olup bunu sana teslim edebiliyorum. Buna gelince; güzel bir ölüm olarak düşünülebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410239
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410239,
					"content": "Ah... Onca yetenek, onca kabiliyet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410224,
					"content": "Yani doğum gününde...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410225
					]
				}
			]
		},
		{
			"id": 7224103,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aberaku"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722410301,
					"content": "Lütfen Geçitler, Ebedi Gece Tapınağı ve Yılan Kalbi'nde bulunan adakları topla. Bu şekilde ruhum yeniden bütünlüğüne kavuşacak ve sana Dainichi Mikoshi yolunu açabileceğim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aberaku"
