				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722410601,
					"content": "Adım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410602
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410602,
					"content": "Aberaku, Helios'un Yaratıcısı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410603
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410603,
					"content": "Paimon'un adı da... Şey, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410604,
						722410609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410604,
					"content": "Şimdi de kendimizi tanıtma faslına mı başladık?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410605
					]
				},
				{
					"id": 722410605,
					"content": "O başlatınca ben de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410606,
					"content": "Sanırım nazik biri olduğu için böyle yaptı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410607,
					"content": "Önemsiz bir mesele. Haklısınız, böyle felaket bir durumdayken yanınıza gelerek size saygısızlık yapan bendim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410608
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410608,
					"content": "#Üzme kendini! Sıkıntı yok. Değil mi {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410613,
					"content": "Sahi, neden buradasınız bayım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410614,
					"content": "Ben... Ben Helios'un yaratıcısıyım, burası da benim... Ebedi istirahat yerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410615
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410615,
					"content": "Karanlık, buz gibi bir yerde asla uyanmamak üzere uykuya dalmak... Nasıl böyle ölebilirim? Ben, Helios'un Yaratıcısı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410616
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410616,
					"content": "Helios'un yaratıcısı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410617,
					"content": "Helios da nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722410618,
					"content": "Ah, doğru. Yarattığım şeye Helios adını vermiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410619
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410619,
					"content": "Belki bilmiyorsundur ama Byakuyakoku halkı ona...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410620
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410620,
					"content": "Dainichi Mikoshi adını verdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410621
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410621,
					"content": "Helios, Hype{RUBY#[S]Byakuya no Hikari}rion'u taşıyan savaş arabası olan Dainichi Mikoshi'dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410622,
						722410623
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410622,
					"content": "Yani Dainichi Mikoshi'nin mucidi sen misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410624
					]
				},
				{
					"id": 722410624,
					"content": "Evet, doğru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410625
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410625,
					"content": "Ey farklı bir diyardan gelen Gezgin. Her ne kadar ben yapmış olsam da burada, kendi icadımın üzerinde hapsedildim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410626
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410626,
					"content": "Ölümümden sonra ruhum Byakuyakoku'nun her yerine dağıldı ve bu sırada hafızamın büyük bir kısmını kaybettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410627
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410627,
					"content": "Dainichi Mikoshi'nin üzerinde... Çok önemli bir şey olduğunu hatırlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410628
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410628,
					"content": "Fakat bunun ne olduğunu hatırlayamıyorum. Uzak diyarların yolcusu, lütfen... Üç farklı yere yerleştirilmiş olan kıyafetlerimi, tacımı ve kemiklerimi bana getirebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410629
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410629,
					"content": "Bunları bulmak için Geçitler, Ebedi Gece Tapınağı ve Yılan Kalbi'ne gitmen gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410630
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410630,
					"content": "Bulduklarını üç sunağa adarsan ruhum yeniden bir bütün olacak ve sana Dainichi Mikoshi yolunu açabileceğim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410631
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410631,
					"content": "Böylelikle Dainichi Mikoshi'nin üzerinde seyahat edebilecek, ebedi gecenin gizlediği kapalı alanlara girebileceksin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410623,
					"content": "Demek sensin ha?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410624
					]
				},
				{
					"id": 722410609,
					"content": "Adım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410610
					]
				},
				{
					"id": 722410610,
					"content": "Anlıyorum. Sen uzaklardan gelen bir misafirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410611
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410611,
					"content": "Sadece seninle böyle korkunç bir halde tanışmış olmaktan ötürü pişmanım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410612
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722410612,
					"content": "Sorun değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410613
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7224107,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
