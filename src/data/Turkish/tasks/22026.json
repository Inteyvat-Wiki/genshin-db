			},
			"dialogs": [
				{
					"id": 220260101,
					"content": "Hımm... Buralarda bir yerlerde olsa gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260102
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260102,
					"content": "Julie, seni buraya hangi rüzgar attı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220260103
					]
				},
				{
					"id": 220260103,
					"content": "Ha? Gezgin, sen miydin? Hehe, sana burada rastlayacağım aklıma gelmezdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260104
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260104,
					"content": "Yemek malzemesi aramaya geldim. Xudong yeni yemekler üzerinde çalışıyor ve Parvaneh de ona fikir veriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260105
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260105,
					"content": "Xudong, Inazuma'nın Üç Renkli Dangosundan yola çıkarak lezzetli ve yumuşak bir tatlı yapmak istediğini söyledi ama bunu yapmak için birçok özel yemek malzemesi gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260106
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260106,
					"content": "Munehisa amca Eflatun Kavun almak için kasabaya gitti. Ben de Kiraz Çiçeği dedikleri malzemeden topluyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260107
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260107,
					"content": "Biraz topladım ama bu kadarı yetmez. Gidip biraz daha aramak istiyorum ancak ilerisi canavarlarla dolu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260108
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260108,
					"content": "Gezgin, üç Kiraz Çiçeği getirmeme yardım edebilir misin lütfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260109,
						220260111
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260109,
					"content": "Tabii, olur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220260110
					]
				},
				{
					"id": 220260110,
					"content": "Teşekkür ederim! Döndüğünde sana harika bir şey hazırlayacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260111,
					"content": "Bu canavarlar senin için sorun değildir herhalde, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220260112
					]
				},
				{
					"id": 220260112,
					"content": "Yani, genelde sorun olmaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260113
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260113,
					"content": "Ama şey, nasıl desem, bu canavarlarla savaşmam gerekirse bu sefer de yemek malzemesi toplama görevini kesin unuturum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260114
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260114,
					"content": "Mondstadt'tan beri böyleyim. Ne zaman canavarlarla uğraşmam gerekse kalan her şeyi unutuyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260115
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260115,
					"content": "Canavarları tamamen yendikten sonra ilgilenmem gereken bir mesele olduğunu hatırlıyorum... Bu şekilde bir sürü işi yapmayı unuttum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260116
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260116,
					"content": "Canavarlardan cidden nefret ediyorsun herhalde...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220260117
					]
				},
				{
					"id": 220260117,
					"content": "Nefret etmek mi? Yok, pek sayılmaz... Aslında onlarla savaşmayı epey keyifli buluyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260118
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260118,
					"content": "Hiç böyle hissettin mi, yani canavarları alt ederken başka hiçbir şey düşünmen gerekmiyormuş gibi. Harika bir his.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260119
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260119,
					"content": "Neyse, çok da üzerinde konuşmaya gerek yok. Kısacası lütfen bana Kiraz Çiçeği toplama görevinde yardım et, teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260120
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260120,
					"content": "Döndüğünde sana harika bir şey hazırlayacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				}
			]
		},
