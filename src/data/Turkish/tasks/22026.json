			},
			"dialogs": [
				{
					"id": 220260301,
					"content": "Tamamdır, bu kadarı yeterli, teşekkürler! Sen olmasan dalıp bu canavarların icabına benim bakmam gerekecekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260302
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260302,
					"content": "Öyle olsaydı kim bilir görevimin Kiraz Çiçeği toplamak olduğunu tekrar ne zaman hatırlardım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260303
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260303,
					"content": "Yardımın için teşekkürler, lütfen bu Tavuk Mantar Şişleri kabul et. Bayan Lynn bana bu klasik maceracı yemeğini yapmayı öğretmişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260304
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 220260304,
					"content": "Bu Kiraz Çiçeklerini Xudong'a geri götüreceğim. Acaba ne tarz bir şey yapacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julie"
				}
			]
		}
