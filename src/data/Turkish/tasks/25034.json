			"dialogs": [
				{
					"id": 250340501,
					"content": "#Bizi kurtardığın için teşekkürler {M#abi}{F#abla}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340502
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340502,
					"content": "Hurruu, rruu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340503
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250340503,
					"content": "Burası kabileden epey uzakta. Sen gelmeseydin ben gidip Illapa'yı uyarana kadar Qica çoktan yakalanmış olurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340504
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340504,
					"content": "İkiniz burada ne yapıyorsunuz ki zaten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340505
					]
				},
				{
					"id": 250340505,
					"content": "Her zamanki gibi tırmanma antrenmanı yapıyorduk ama yarı yolda acıktık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340506
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340506,
					"content": "Bu yüzden bir şeyler toplamaya gittik... Sonra bir baktık ki epey uzaklaşmışız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340507
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340507,
					"content": "Karnımız yeterince doyduğunda epey uzaklaştığımızı fark ettik. Geri dönünce annemden çok feci azar işiteceğim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340508
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340508,
					"content": "Bizi kurtardığın için tekrar teşekkürler. Bu Cacahuatl'lar senin olsun, daha yeni topladım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340509
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340509,
					"content": "Çabucak geri dönelim biz de. Hadi gel Qica!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340510
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340510,
					"content": "Raarr! Raarrr! Raarr!",
					"roleType": "TALK_ROLE_NPC",
