			"dialogs": [
				{
					"id": 250340101,
					"content": "Sizi hiç sevmedi... Hadi uzayın buradan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340102
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340102,
					"content": "Ufaklık... Şu Sürüngenle olayınız nedir sizin? Onu tanıyor musun yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340103
					],
					"speakerTitle": "Aceleci Hırsız"
				},
				{
					"id": 250340103,
					"content": "Raar... Raaarrrrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340104
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250340104,
					"content": "Bak sen, sabırsızlanmaya da başladı. Pekala ufaklık, kenara çekil. Çocuklara vurmayız biz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340105
					],
					"speakerTitle": "Aceleci Hırsız"
				},
				{
					"id": 250340105,
					"content": "Çantayı getirin beyler. Bu Sürüngen iyi para eder kesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340106
					],
					"speakerTitle": "Aceleci Hırsız"
				},
				{
					"id": 250340106,
					"content": "Yaklaşmayın! Canınız yanar sonra, uyarıyorum bak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340107
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340107,
					"content": "D-Dur biraz, bize vuracak mısın yani? Hahaha! Duydunuz mu beyler? Bizi haklayacakmış bu velet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340108
					],
					"speakerTitle": "Aceleci Hırsız"
				},
				{
					"id": 250340108,
					"content": "Ayy, ufaklık... Öyle koyktum ki tiy tiy tityiyoyum resmen! Pekala o zaman... Canın yanarsa beni suçlama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340109
					],
					"speakerTitle": "Aceleci Hırsız"
				},
				{
					"id": 250340109,
					"content": "Raarr! Raarrr! Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340110
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250340110,
					"content": "Off. Bu Sürüngen de amma tatava ediyor. Pekala ufaklık, sen gidip şurada biraz kestir bakalım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340111,
						250340112
					],
					"speakerTitle": "Aceleci Hırsız"
				},
				{
					"id": 250340111,
					"content": "Bence kestirme sırası size gelmiş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340113
					]
				},
				{
					"id": 250340113,
					"content": "#{M#Abi}{F#Abla}! Qica'yı almaya çalışıyorlar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340114
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250340114,
					"content": "Raaa! Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340115
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250340115,
					"content": "... Baksana bana. Sen bir kenara mı çekilsen acaba? Canını yakmayacağız, hatta pastadan bir pay da sana veririz. Ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340116,
						250340117
					],
					"speakerTitle": "Aceleci Hırsız"
				},
				{
					"id": 250340116,
					"content": "Qica'nın kılına dokunamazsınız.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340118
					]
				},
				{
					"id": 250340118,
					"content": "Hımm, buraya kadarmış o zaman. Kuralları biliyorsundur eminim. Ortalığı kızıştırma zamanı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340119
					],
					"speakerTitle": "Aceleci Hırsız"
				},
				{
					"id": 250340119,
					"content": "Hadi çocuklar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aceleci Hırsız"
				},
				{
					"id": 250340117,
					"content": "Siz hayırdır ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340118
					]
				},
				{
					"id": 250340112,
					"content": "Müsaadenizle araya gireceğim hemen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340113
					]
				}
			]
		},
