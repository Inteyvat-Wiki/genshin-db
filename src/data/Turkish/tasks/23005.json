			"dialogs": [
				{
					"id": 230050201,
					"content": "Hımm... Hiç fena değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050202
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050202,
					"content": "Bakıyorum da servet kazanmışsın...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230050203
					]
				},
				{
					"id": 230050203,
					"content": "Ah, Gezgin gelmiş! Sayenizde bu sefer az da olsa kar ettim. \"Altın Yemek\" gerçekten işe yarıyormuş demek ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050204
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050204,
					"content": "Fakat her zaman kazandığımdan çok da bir farkı yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050205
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050205,
					"content": "\"Altın Yemek\" yemenin sonucu böyle olmamalıydı. Yanlış yemeği mi yedim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050206
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050206,
					"content": "Hadi bir kere daha deneyelim Gezgin. Tekrar \"Altın Yemek\" seçmeme yardımcı olur musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050207
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050207,
					"content": "Her zamanki gibi lütfen <color=#00E1FFFF>Mora Bazlaması</color>, <color=#00E1FFFF>Tereyağlı Tavuk</color> ve <color=#00E1FFFF>Festival Kulesi</color> arasından seçimini yap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hatim"
				}
			]
		},
		{
			"id": 2300503,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
