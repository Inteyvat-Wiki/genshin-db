			"dialogs": [
				{
					"id": 230050601,
					"content": "Bu o iş insanının yaptığı elma şırası, değil mi? Nasıl da güzel tadı. Zihnim açıldı gerçekten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050602
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050602,
					"content": "Harika! Gerçekten çok güzelmiş. Piyasayı sallayacağı kesin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050603
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050603,
					"content": "İkinizin yardımlarını asla unutmayacağım! Tekrar görüşelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hatim"
				}
			]
		},
