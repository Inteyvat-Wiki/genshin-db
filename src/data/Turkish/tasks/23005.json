			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hatim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230050401,
					"content": "Şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050402
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050402,
					"content": "Selam! Nasılsın Hatim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230050403,
					"content": "Ah, demek sizsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050404
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050404,
					"content": "Herhalde yüz ifadem anlaşılıyordur, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050405
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050405,
					"content": "Dürüst olacağım, tüm paramın yarısını kaybettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050406
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050406,
					"content": "Tuhaf... Böyle olmamalıydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050407
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050407,
					"content": "Ama yine de... Bunun piyasanın uçacağına dair bir işaret olduğunu düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050408
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050408,
					"content": "Tıpkı insanların yükseğe zıplamadan önce eğilmeleri gerektiği gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050409
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050409,
					"content": "Aynısı vadeli ticaret piyasası için de geçerli. Piyasa hiç bu kadar düşmemişti. Hatta dibe vurmak üzere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050410
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050410,
					"content": "Başka bir deyişle şimdi indirim kovalamanın tam zamanı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050411,
						230050412
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050411,
					"content": "Belki de daha en dibe vurmamıştır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230050413
					]
				},
				{
					"id": 230050413,
					"content": "Hayır. Bu fırsat insanın eline bir kere geçer ve Hatim servet kazanma şansını asla kaçırmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050414
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050414,
					"content": "Kalimi'nin en zengini Hatim olarak adımın hakkını vermeliyim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050415
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050415,
					"content": "Hadi gel dostum, bana bir kere daha yardım et olur mu? Bir \"Altın Yemek\" daha seç lütfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050416
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050416,
					"content": "Hâlâ aynı seçenekler mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230050417,
					"content": "Hımm... Bir saniye, hayır! İndirim kovalayacağımız için çok daha özel bir yemek olmalı ki piyasaya şans getirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050418
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050418,
					"content": "Duyduğuma göre Mondstadt'ta çok karlı bir alkol işletmesi olan önemli bir iş insanı varmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050419
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050419,
					"content": "Kastettiğin kişi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230050420
					]
				},
				{
					"id": 230050420,
					"content": "Usta Diluc mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230050421,
					"content": "Ama onu sen nereden...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230050422,
					"content": "Hahaha, \"Festival Kulesi\" hakkında bile bilgim varken onu nasıl tanımam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050423
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050423,
					"content": "Adamın Elma Şırası adında harika bir içki sattığı bir hanı var. Birkaç kadeh yuvarlarsam belki zenginliği bana da bulaşır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050424
					],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050424,
					"content": "O yüzden lütfen bana bir şişe Elma Şırası getir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hatim"
				},
				{
					"id": 230050412,
					"content": "Bazı insanlar eğildiğinde bacaklarına kramp girer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230050413
					]
				}
			]
		},
