			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hatim"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230050301,
					"content": "En son kazandığım ufak kardan sonra bu sefer turnayı gözünden vuracağım kesin! <color=#00E1FFFF>Mora Bazlaması</color>, <color=#00E1FFFF>Tereyağlı Tavuk</color> ve <color=#00E1FFFF>Festival Kulesi</color>. Ne diyorsun? Hangisini seçeceksin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hatim"
				}
			]
		},
		{
			"id": 2300504,
			"completionStepIds": [
				2300504
			],
