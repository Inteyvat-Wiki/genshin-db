			"dialogs": [
				{
					"id": 741920301,
					"content": "Hatıralar kitaba yazılabildiğine göre, ters mantıkla düşünürsek kitap da doğrudan hatıralara yazılabiliyor olmalı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920302
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920302,
					"content": "Canotila?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920303
					]
				},
				{
					"id": 741920303,
					"content": "#Aa, tuhaf {M#Mr.}{F#Ms.} {NICKNAME}. Ne oldu? Benden bir şey mi isteyecektin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920304
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920304,
					"content": "Neden bahsediyordun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920305
					]
				},
				{
					"id": 741920305,
					"content": "Hımm. Hangi açıdan düşünürsen düşün, hatıraları kitaba dönüştürebilmek gerçekten de büyük bir başarı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920306
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920306,
					"content": "Bu kitabın yazarının bunu yapabilmesinin tek sebebi, hatıral{RUBY#[D]sanrılarındaki}arındaki duyguları dünyadaki en değerli şey olarak görmesi olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920307
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920307,
					"content": "Tabii bu onun ne kadar zor okunabildiği gerçeğini değiştirmiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920308
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920308,
					"content": "... Ayrıca okurlarda nasıl bir etki bırakacağından da emin değilim. Bu oldukça...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				}
			]
		},
