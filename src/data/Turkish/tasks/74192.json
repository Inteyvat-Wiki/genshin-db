			"dialogs": [
				{
					"id": 741920101,
					"content": "Anladım, tahttaki ateşler söndü ve yanıp tutuşan küller bir kez daha ağaçlara dönüştü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920102
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920102,
					"content": "Bastığın her yerde çiçekler açıyor ve gelecekteki kaçınılmaz yok oluşa değişim getiriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920103
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920103,
					"content": "Canotila?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920104
					]
				},
				{
					"id": 741920104,
					"content": "#Hı? {M#Bay}{F#Bayan} {NICKNAME}! Seni hangi rüzgar attı buraya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920105
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741920105,
					"content": "Aa, doğru ya! Altın kelebek geri döndü. Gidip onu görmem lazım! Görüşmek üzere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				}
			]
		},
