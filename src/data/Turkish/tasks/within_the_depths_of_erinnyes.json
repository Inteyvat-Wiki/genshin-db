					"id": 740851901,
					"content": "Olamaz! Onu aramaya fırsatımız olmadı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851902,
					"content": "Merak etme. Eminim yüzebiliyordur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851903
					]
				},
				{
					"id": 740851903,
					"content": "Doğru ama... Aa! Büyük ağaca bak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851904,
					"content": "İyileşmiş, ne kadar hoş görünüyor! Hastalanmadan önce böyle miymiş demek? Pahsiv görünce sevinir kesin, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851905,
					"content": "#Paimon! Pahsiv! {NICKNAME}! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851906
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740851906,
					"content": "Pahsiv? Oley! Nereye gittin? Çok endişelendik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851907,
					"content": "Kayboldu, Pahsiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851908
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740851908,
					"content": "Ah... Kutu. Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851909
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740851909,
					"content": "Ne? Hazine sandığı mı o? Hazine sandığı aramaya mı gittin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851910,
					"content": "Pahsiv! Ama, parlak, yuvarlak, Melusina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851911
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740851911,
					"content": "Hiç Mora bulamadın mı? Olsun. Sandık da gayet yeterli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851912,
					"content": "Paimon'un sana dediği şeyi unutmamışsın! Ay, Paimon'u ağlatacaksın şimdi! Sağ ol Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851913,
					"content": "Sağ... Ol?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851916
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740851916,
					"content": "Pahsiv demek!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851917
					]
				},
				{
					"id": 740851917,
					"content": "#Paimon, sağ ol! {NICKNAME} sağ ol!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851918
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740851918,
					"content": "#Paimon, iyi şey! {NICKNAME}, iyi şey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851919
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740851919,
					"content": "Pahsiv, iyi şey!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851920
					]
				},
				{
					"id": 740851920,
					"content": "Pahsiv, iyi şey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851921
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851921,
					"content": "#{NICKNAME}, vaktimiz olduğunda sık sık Pahsiv'i görmeye gelelim ve ona tıpkı Nevale'nin yaptığı gibi daha fazla kelime öğretelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851922
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851922,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851923
					]
				},
				{
					"id": 740851923,
					"content": "Ne dersin Pahsiv? Arada gelip seninle oynayabilir miyiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851924
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851924,
					"content": "Yine nereye gitti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851925
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851925,
					"content": "Pahsiv, kayboldu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851926
					]
				},
				{
					"id": 740851926,
					"content": "Vay canına! Paimon daha önce onun gibi bir Melusina hiç görmedi. Ya da daha doğrusu... O pek bir Melusina gibi davranmıyor, daha çok vahşi bir peri gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851927
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851927,
					"content": "Belki de bu sayede mor şeyi sessizce gözetleyebiliyordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851928
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851928,
					"content": "Hey Pahsiv! Görüşmek üzere! Yine karşılaşırsak düzgün vedalaşmayı öğretiriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
