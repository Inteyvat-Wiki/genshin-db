			"dialogs": [
				{
					"id": 740851701,
					"content": "#Oh be! Sonunda kontrol altına aldık. Hiçlik Kurdu kovanına çomak soktuk resmen. Ne durumdasın {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851702,
						740851703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851702,
					"content": "Benim daha enerjim var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851704
					]
				},
				{
					"id": 740851704,
					"content": "Hehe, sırf övünmek için demiyorsundur herhalde. Kökler iyileşiyor gibi duruyor. Artık bir sorun kalmadığı için olmalı, öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851705,
					"content": "Az önce ne oldu? Bir ejder yardıma geldi ve Pahsiv ortadan kayboldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851706,
					"content": "Hey! Pahsiv! Orada mısın? Paimon'u duyabiliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851707,
					"content": "Hımm, görünüşe göre gerçekten ortalıktan kayboldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851708,
					"content": "Sakladığı ne çok sır var kim bilir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851709
					]
				},
				{
					"id": 740851709,
					"content": "Hımm... Çok gizemli bir Melusina. Paimon onun hiçbir ödül istemediğini biliyor ama bu şekilde çekip gitmesi de çok tuhaf geliyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851710,
					"content": "Neden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851711
					]
				},
				{
					"id": 740851711,
					"content": "Sanki... Sanki en sevdiğin yemek bir gün sana bakıp \"Tak sepeti koluna, herkes kendi yoluna.\" demiş gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851712,
						740851713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851712,
					"content": "Çok üzücü olurdu, evet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851714
					]
				},
				{
					"id": 740851714,
					"content": "Şey, aslında aynı duygu biliyor musun? Ya Pahsiv'in başına bir şey geldiyse? En son çok yorgun görünüyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851715,
					"content": "Belki onu yakınlarda arayabiliriz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851716
					]
				},
				{
					"id": 740851716,
					"content": "Evet! Paimon da öyle düşünüyor. Başına her türlü tehlikeli şey gelmiş olabilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851717,
					"content": "Bir dakika... Ne oluyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740851718,
					"content": "Siz tam Pahsiv'i aramaya başlayacakken mağaraya su dolar ve çok geçmeden sizi sürükleyerek yüzeye çıkarır.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 740851713,
					"content": "Gerçi yemeğinin konuşması da bir o kadar garip olurdu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740851714
					]
				},
				{
