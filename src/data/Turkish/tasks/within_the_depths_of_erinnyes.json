					"nextDialogs": [
						740851007
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740851007,
					"content": "#{NICKNAME}, hadi tüm şu pisliği bir temizleyelim. Paimon bunların kökleri çürüttüğünü düşünüyor.",
