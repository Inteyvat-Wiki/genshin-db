			"dialogs": [
				{
					"id": 740851401,
					"content": "Nihayet hepsi bitti. Paimon senin bu kadar maharetli olduğunu bilmiyordu Pahsiv...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740851402
					],
