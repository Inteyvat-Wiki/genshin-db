			"dialogs": [
				{
					"id": 740850201,
					"content": "Anahtar, heykel, anahtar, heykel, anahtar, heykel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850202
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850202,
					"content": "Yani.. Anahtarları heykelin içine mi koymamız gerekiyor? Pekala, mantıklı. Üç heykele üç anahtar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850203,
					"content": "Deneyelim mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850204,
					"content": "Anahtarları yerleştirince ne olacak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850205
					]
				},
				{
					"id": 740850205,
					"content": "Kapı açılır, açık kapı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850206
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850206,
					"content": "Kapı mı? Nerede? Ayrıca kapının ardında ne var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850207,
					"content": "Kök, Erinnyes, çok derin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850208
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850208,
					"content": "Erinnyes'in köküne açılan bir kapı mı? Ne kadar çok şey biliyorsun Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850209,
					"content": "Pahsiv, koru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850210
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850210,
					"content": "Başka bilmemiz gereken ne var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850211
					]
				},
				{
					"id": 740850211,
					"content": "... Hı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850212
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850212,
					"content": "Bilgi diyorum hani. Ne kadar çok o kadar iyi! Ne kadar çok şey bilirsek kendimize güvenimiz o kadar artar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850213,
					"content": "Bil... gi? Bil... gi... Pahsiv! Bilgi, bir sürü!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850214
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850214,
					"content": "Süper!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850215,
					"content": "Erinnyes, bilgi, bir sürü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850216
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850216,
					"content": "Bir sürü bilgi demek... Peki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850217,
					"content": "Bilgi, su damarı, bir sürü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850218
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850218,
					"content": "Bir sürü su damarı, tamam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850219,
					"content": "Su damarı, Nevale, bir sürü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850220
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850220,
					"content": "Hımm... Nasıl yani? Nevale mi? Bir sürü mü? Paimon bunu anlamadı. Bu kadar nevale nereden geliyor? Ya da Paimon'a Nevale'nin ayna görüntülerini oluşturmayı bildiğini mi söylüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850221,
					"content": "Melusina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850222
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850222,
					"content": "Su damarı, Nevale, tat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850223
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850223,
					"content": "Kötü, Nevale, his.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850224
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850224,
					"content": "Su damarındaki kötülüklerin tadına mı bakıyor? Iıı, ne tür bir tat bu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850225,
					"content": "Nevale, su damarlarındaki bilgileri hissedebiliyor mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850226
					]
				},
				{
					"id": 740850226,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850227
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850227,
					"content": "Söğüt, topla. Sis, dağıt. Pınar, gönder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850228
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850228,
					"content": "Kök, su damarı, merkez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850229
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850229,
					"content": "Erinnyes, bilgi merkezi mi yani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850230
					]
				},
				{
					"id": 740850230,
					"content": "Bütün Erinnyes'in aslında Nevale'nin bilgi sistemi olduğunu mu söylüyorsun? Bu Nevale kötü şeyleri hissedebiliyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850231,
					"content": "#Akıllı Paimon! Akıllı {NICKNAME}! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850232
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850232,
					"content": "Of, bu Nevale kimin nesi acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850233,
					"content": "Fontaine, Nevale, koru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850234
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850234,
					"content": "Ama, Nevale, çok meşgul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850235
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850235,
					"content": "Mor şey, köke sızmak. Mor şey, gizlice kökü yok etmek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850236
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850236,
					"content": "Pahsiv, gizli bakmak. Pahsiv, gizlice taş tableti çizmek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850237
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850237,
					"content": "Taş tabletteki yazıları silen sendin demek! Mor şeyi durdurmak için mi yaptın bunu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850238,
					"content": "Pahsiv! Ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850239
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850239,
					"content": "Mor şey, köke gitmek devam. Mor şey, çok güçlü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850240
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850240,
					"content": "Mor şey köke giden başka bir yol mu buldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850241
					]
				},
				{
					"id": 740850241,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850242
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850242,
					"content": "Bu mor şey epey çetin bir cevize benziyor. Eğer kök yok edilirse bilgi sistemi de artık kullanılamaz hale gelir ve Nevale'nin hisleri de bundan etkilenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850243,
					"content": "Pahsiv, görev! Pahsiv, koru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850244
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850244,
					"content": "#{NICKNAME}, bam. Paimon, bam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850245
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740850245,
					"content": "#{NICKNAME}, daha fazla bekleyemeyiz. Hemen gidip bam yapmalıyız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850246
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740850246,
					"content": "Pekala o zaman Pahsiv! Kapıyı aç!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850247
					]
				},
				{
					"id": 740850247,
					"content": "Mükemmel, hadi gidelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
