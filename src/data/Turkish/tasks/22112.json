					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120302
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120302,
					"content": "Evet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120303
					]
				},
				{
					"id": 221120303,
					"content": "Bakalım... Bu kadarı yeter. Teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120304
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120304,
					"content": "İşe koyulayım, bunu mümkün olduğunca çabuk tamir etmem gerek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
