			},
			"dialogs": [
				{
					"id": 221120501,
					"content": "İşte, şimdi oldu. Kimse artık buraya basıp düşmez herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120502
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120502,
					"content": "Mekanın tarzına pek uymuyor ama...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120503
					]
				},
				{
					"id": 221120503,
					"content": "O konuda bir şey yapamam. Usta bir zanaatkar değilim sonuçta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120504
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120504,
					"content": "Dur... Bu, çatlaklardan sadece biri. Onarmam gereken bir tane daha var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120505
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120505,
					"content": "Bugünlük bu kadar yeter. Han halen açık ve artık müşterilere hizmet vermeye dönmem gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120506
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120506,
					"content": "Ne kadar acil tamir edilmesi gerektiği fark etmez, iş iştir... Yardımın için teşekkür ederim. Uğraşlarının karşılığı olarak bunu kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		}
