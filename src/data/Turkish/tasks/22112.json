				{
					"id": 221120201,
					"content": "Buldun mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120202
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120202,
					"content": "Henüz değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120203
					]
				},
				{
					"id": 221120203,
					"content": "Hemen dışarıda, bulmak o kadar da zor değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120204
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120204,
					"content": "Git de bir bak, birileri aceleyle gelirken kaza geçirmesin diye burada durmam gerek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
