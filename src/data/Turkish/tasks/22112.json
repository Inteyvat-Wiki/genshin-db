				"points": []
			},
			"dialogs": [
				{
					"id": 221120101,
					"content": "Görünüşe göre tamir edilmesi gerek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120102
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120102,
					"content": "Sorun ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120103
					]
				},
				{
					"id": 221120103,
					"content": "Ah, senmişsin. Bak, merdiven kırık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120104
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120104,
					"content": "Oldukça kötü durumda. Tamir edilmezse, birinin başına bir şey gelmesi işten bile değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120105
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120105,
					"content": "Nasıl kırıldı diye mi soruyorsun? Bir grup canavar içeri girmeye çalıştı, ben de onlarla savaşmaya çıktım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120106
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120106,
					"content": "Keşke yumruklarıma dikkat etseydim... Tam kuvvetli bir yumruk sallayacaktım ki merdivene denk geldi. Elim çarpar çarpmaz da kırıldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120107
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120107,
					"content": "Tamir ederim dedim ama hiç vaktim olmadı çünkü han gitgide daha da yoğunlaşmaya başladı. Bu yüzden merdiveni tamir etmek acil hale geldi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120108
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120108,
					"content": "Çok zor bir iş değil. Yardım almadan kolayca tamir edebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120109
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120109,
					"content": "Zamanın varsa bana birkaç tane Tahta Kalas getirir misin? Birileri buraya basmasın diye benim burada durmam gerekiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120110,
						221120113
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120110,
					"content": "Tamam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120111
					]
				},
				{
					"id": 221120111,
					"content": "Harika. Tahta Kalasları çoktan aldım, şu anda hanın dışında duruyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120112
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120112,
					"content": "Kalasları alıp birkaçını getirir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120113,
					"content": "Hadi gene kırılırsa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120114
					]
				},
				{
					"id": 221120114,
					"content": "Kırılmaz. Zaten artık yaşlanıyorum... Bir dahaki sefer kendimi tutacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120115
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120115,
					"content": "Öyle ya da böyle, bunu tamir etmek gerek. Tahta kalasları çoktan aldım, şu anda hanın dışında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120116
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221120116,
					"content": "Lütfen birkaçını buraya getir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
