			"dialogs": [
				{
					"id": 10160101,
					"content": "Ah, buradasınız. Sipariş vermenize gerek yok, ben hallettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160102
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160102,
					"content": "\"Üçüncü Rauntta Nakavt\", Mondstadt'taki hanlar gibi sıradan değildir. Buranın sahibi meyve suyu gibi sıra dışı siparişleri almıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160103
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160103,
					"content": "Yani bu sefer şarap sipariş edebilir miyim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160104
					]
				},
				{
					"id": 10160104,
					"content": "O da olur dersen şarapla fermente edilmiş tatlı soslu pirinç topları sipariş ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160105
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160105,
					"content": "Ne bekliyordum ki...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160106
					]
				},
				{
					"id": 10160106,
					"content": "Sevgili müşteriler, dilerseniz Leydi Ningguang'ın Yeşim Konak öyküsüne devam edebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160107
					],
					"speakerTitle": "Demir Dil Tian"
				},
				{
					"id": 10160107,
					"content": "Burada hikaye anlatıcı bile var! Harika bir ortam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160108,
					"content": "İyi şarabın yanı sıra harika ortam da bu yerin çok sevilme nedenlerinden biri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160109
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160109,
					"content": "Ortam derken Teyvat Seyahat Rehberinin diğer işletmeleri değerlendirmek için kullandığından farklı bir şeyden bahsediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160110
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10160110,
					"content": "Hepinizin bildiği üzere Liyue'nin yukarısında bulutların içinde bir konak, sislerin içinde bir saray var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160111
					],
					"speakerTitle": "Demir Dil Tian"
				},
				{
					"id": 10160111,
					"content": "Her şeyi gören gözlerin olması ne demek? Bu dostlarım, Leydi Ningguang'ın yeri ve göğü birbirine bağlayan şaheseri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160112
					],
					"speakerTitle": "Demir Dil Tian"
				},
				{
					"id": 10160112,
					"content": "Hayal edin. Bulutsuz bir gökyüzü, siz de aşağıya dünyaya bakıyorsunuz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160113
					],
					"speakerTitle": "Demir Dil Tian"
				},
				{
					"id": 10160113,
					"content": "İşte! Liyue Limanı'nın manzarası bütün ihtişamıyla karşınızda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160201
					],
					"speakerTitle": "Demir Dil Tian"
				},
				{
					"id": 10160201,
					"content": "Bunlar sadece kağıt parçaları olsa da Leydi Ningguang'ın ellerine rehberlik ediyorlar ve değerleri de buradan geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160202
					],
					"speakerTitle": "Demir Dil Tian"
				},
				{
					"id": 10160202,
					"content": "Bunlardan birkaç tanesini anlamak size Leydi Ningguang'ın bilgeliğinin ufak bir parçasını bahşeder. Bu da akranlarınızdan birkaç adım önde olmanıza yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160203
					],
					"speakerTitle": "Demir Dil Tian"
				},
				{
					"id": 10160203,
					"content": "Tianquan Ningguang... Bu ismi çok sık duyuyoruz sanki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160204,
					"content": "Liyue'nin yerli halkı ondan bahsediyor, Fatui ondan nefret ediyor. Muhtemelen Exuvia'yı o sakladı ve kendisini Zuhur Ayininde gördük...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160205,
					"content": "Paimon onun nasıl biri olduğunu merak ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160207,
					"content": "Jueyun Gölü'nden dönenler, sonunda sizi buldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160208
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160208,
					"content": "Kim var orada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160209,
					"content": "Paimon, gitmemiz gerek!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160210
					]
				},
				{
					"id": 10160210,
					"content": "Bekleyin! Ben Taşordu'yla değilim, niyetim başınıza koyulan ödülü almak da değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160211
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160211,
					"content": "Ben Liyue'nin Yedi Yıldızının elçisiyim. Adım Ganyu, Yuehai Konağı'nın sekreteriyim ve özel olarak sizinle buluşmaya geldim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160212,
						10160213
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160212,
					"content": "Elçi mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160214
					]
				},
				{
					"id": 10160214,
					"content": "En kaba tabiriyle Yedi Yıldızın kurumsal sekreteriyim. Şu anda Leydi Ningguang'ın özel elçisi olarak hizmet ediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160215
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160215,
					"content": "Seni Ningguang mı gönderdi? Az önce ondan bahsediyorduk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160216,
					"content": "Jueyun Gölü'nden dönenler, özür dilerim... Görevimin gereğini yapmak zorundayım ve şu anda sizlere gereken nezaketi gösteremiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160217
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160217,
					"content": "Ancak yanımda Leydi Ningguang'dan bir mektup var. Tianquan olarak sizlere resmi bir davetiye iletti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160218
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160218,
					"content": "Sizleri gökyüzündeki sarayına davet ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160219
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160219,
					"content": "Resmi bir davetiye mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10160220,
					"content": "Leydi Ningguang şöyle söyledi:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160221
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160221,
					"content": "\"Onu buraya davet et.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160222
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160222,
					"content": "\"Onunla tanışmak istiyorum.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10160223
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160223,
					"content": "\"Yeşim Konak'ta bir araya gelip etrafı sarmalayan karanlık bağların her birini keseceğiz.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10160213,
					"content": "Sekreter mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10160214
					]
				}
			]
		},
