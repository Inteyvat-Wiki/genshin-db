			},
			"dialogs": [
				{
					"id": 10161001,
					"content": "Ardından, adının Ganyu olduğunu söyleyen elçi kayboldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10161002,
					"content": "Ama Liyue'nin Yedi Yıldızından bir davetiye aldık. Paimon hâlâ buna inanamıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10161003,
					"content": "#{NICKNAME}! Paimon'un sayabileceğinden daha fazla parası olan insanlarla tanışacağız... En görgülü tavrımızı takınmalıyız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161004,
						10161005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10161004,
					"content": "Ben her zaman görgülü olmaya dikkat ediyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10161006
					]
				},
				{
					"id": 10161006,
					"content": "Yeşim Konak'ı ziyaret etmek için bir davetiye kesinlikle nadir rastlanan bir şeref.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161007
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10161007,
					"content": "Yola koyulsanız iyi edersiniz. Ancak Veda Ayinini unutmayın Yeşim Konak'ta işiniz bittiğinde benimle Dihua Bataklığı'nda buluşun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10161008
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10161008,
					"content": "Endişelenme, unutmayız! Dihua Bataklığı. Orada görüşürüz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10161005,
					"content": "Paimon yine bir şeylerin peşinde...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10161006
					]
				}
			]
		}
	]
}