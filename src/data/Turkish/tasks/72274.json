			},
			"dialogs": [
				{
					"id": 722740201,
					"content": "Ah, operasyon planlarımızın sızdırılacağı aklımın ucundan geçmezdi. Şansımıza tüküreyim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740202
					],
					"speakerTitle": "Fatui Avcı Eri"
				},
				{
					"id": 722740202,
					"content": "Aynen! Ayrıca Öğretmenin Snezhnaya'ya çağrıldığını duydum ama Watatsumi Adası operasyonu hâlâ devam ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740203
					],
					"speakerTitle": "Fatui Avcı Eri"
				},
				{
					"id": 722740203,
					"content": "Sen de Öğretmenin kafasına göre takıldığını düşünmüyor musun? Leydi Arlecchino'ya operasyondan bahsetmedi, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740204
					],
					"speakerTitle": "Fatui Avcı Eri"
				},
				{
					"id": 722740204,
					"content": "Haklısın. Operasyon onun fikriydi. Biliyor musun? Bu konuda içimde kötü bir his var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740205
					],
					"speakerTitle": "Fatui Avcı Eri"
				},
				{
					"id": 722740205,
					"content": "Yani başarısız olursak Öğretmen bütün suçu üzerimize yıkacak mı demek istiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fatui Avcı Eri"
				}
			]
		}
	]
