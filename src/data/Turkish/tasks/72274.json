				"points": []
			},
			"dialogs": [
				{
					"id": 722740110,
					"content": "Görünüşe göre buranın da gizemleri var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722740111,
					"content": "Sus! Dinle. Şurada birileri konuşuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740101
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722740101,
					"content": "Öf. Kadının ağzını bıçak açmıyor ya. Gerçekten, ağzından bir kelime bile çıkmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740102
					],
					"speakerTitle": "Fatui Avcı Eri"
				},
				{
					"id": 722740102,
					"content": "Hiç merak etmeyin efendim. Sorgu bizim uzmanlık alanımızdır. Siz bir mola verin. Biz hemen hallederiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740103
					],
					"speakerTitle": "Ronin: Anbu"
				},
				{
					"id": 722740103,
					"content": "Çok zamanımız kalmadı. Öğretmen bu kadının planlarımızın ne kadarını bildiğini acilen öğrenmek istiyor. Yoksa ortalık karışacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740104
					],
					"speakerTitle": "Fatui Avcı Eri"
				},
				{
					"id": 722740104,
					"content": "Öf. O da bir sinirlendi mi... Bu kadın, öğretmeni bu kadar sinirlendirecek ne yaptı ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740105
					],
					"speakerTitle": "Ronin: Anbu"
				},
				{
					"id": 722740105,
					"content": "Öğretmenin son planının kilit noktası Lyudochka diye biriydi. Shuumatsubanlı bu kadın onu ortadan kaldırdı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740106
					],
					"speakerTitle": "Fatui Avcı Eri"
				},
				{
					"id": 722740106,
					"content": "Neyse ki yetiştiğimizde her şeyi yakamamıştı. Keskin bakışlı Öğretmen, Lyudochka'nın kıyafetlerini bir bakışta tanıdı ve planımızın tehlikede olabileceğini anında fark etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740107
					],
					"speakerTitle": "Fatui Avcı Eri"
				},
				{
					"id": 722740107,
					"content": "Çok kötü sonuçlanabilecek bir olayı anında toparladı öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740108
					],
					"speakerTitle": "Ronin: Anbu"
				},
				{
					"id": 722740108,
					"content": "Hâlâ bu kadının planlarımızın ne kadarını bildiğini veya Shuumatsuban'dan birilerine haber verip vermediğini bilmiyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722740109
					],
					"speakerTitle": "Fatui Avcı Eri"
				},
				{
					"id": 722740109,
					"content": "Görünüşe göre Momoyo'yu yer altında bir hücrede tutuyorlar. Hadi onu kurtaralım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
