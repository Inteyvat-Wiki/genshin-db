			"dialogs": [
				{
					"id": 752570801,
					"content": "Sonuncusu çok güzel oldu! Sıra nihayet bu yakışıklı gence geldi. Nasıl bir fotoğraf istersiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570802
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570802,
					"content": "İltifatın için teşekkürler. Hayatım boyunca duruşuma ve şıklığa her şeyden çok önem verdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570803
					],
					"speakerTitle": "Inti"
				},
				{
					"id": 752570803,
					"content": "İnsanın duruşu doğru olmazsa şık görünmez. Şık görünmezse de zarif durmaz. Ne demek istediğimi anlıyorsunuz sanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
