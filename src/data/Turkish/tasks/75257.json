			"dialogs": [
				{
					"id": 752570101,
					"content": "Burada her şey yolunda görünüyor. Neden hâlâ açılmadı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570102
					],
					"speakerTitle": "Xoma"
				},
				{
					"id": 752570102,
					"content": "Ah, kusura bakmayın. Set dekoratörümüz akşam biraz fazla kaçırmış, bugün işe gelemedi. Yarın uğrayabilir misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570103
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570103,
					"content": "Ah evladım, yarın tüm o yolu tekrar gelebilmek için biraz fazla yaşlıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570104
					],
					"speakerTitle": "Xoma"
				},
				{
					"id": 752570104,
					"content": "Ayrıca yarın başka planlarımız da var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570105
					],
					"speakerTitle": "Inti"
				},
				{
					"id": 752570105,
					"content": "Çok üzgünüm. Yaz Fotoğrafı Standının tüm esprisi, her müşterinin kendi kişisel arka planını seçmesine dayalıdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570106
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570106,
					"content": "Dekoratörümüz olmadan bu mümkün değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570107
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570107,
					"content": "Yardıma mı ihtiyacınız var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752570108
					]
				},
				{
					"id": 752570108,
					"content": "Cidden mi? Yardım eder misiniz? Bu harika olur! Hiç zor değil, sadece müşterimizin talebine göre fotoğraf arka planını ayarlamanız gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yiztli"
				}
			]
		},
		{
			"id": 7525702,
