			},
			"dialogs": [
				{
					"id": 752570201,
					"content": "Çok eğlenceli olmalı!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752570202
					]
				},
				{
					"id": 752570202,
					"content": "Harika! Tamam o zaman, ilk kim çekilmek ister?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570203
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570203,
					"content": "Bence kadınlara öncelik verilmeli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570204
					],
					"speakerTitle": "Inti"
				},
				{
					"id": 752570204,
					"content": "Bana uyar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570205
					],
					"speakerTitle": "Wechtekah"
				},
				{
					"id": 752570205,
					"content": "Ne kadar centilmensiniz! Aslında sizin gibi gençlerle birlikte fotoğraf çekilmek isterim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570206
					],
					"speakerTitle": "Xoma"
				},
				{
					"id": 752570206,
					"content": "Hı? P-Peki, olur herhalde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570207
					],
					"speakerTitle": "Inti"
				},
				{
					"id": 752570207,
					"content": "Öhöm, bana uyar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570208
					],
					"speakerTitle": "Wechtekah"
				},
				{
					"id": 752570208,
					"content": "Hımm... Bir saniye, bu yeterli değil. Fotoğrafa üç genç adam daha eklemek istiyorum. Bunu yapabilirsin, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570209
					],
					"speakerTitle": "Xoma"
				},
				{
					"id": 752570209,
					"content": "Haa, hatta biraz da havai fişek olsun. Senin yaşlarında böyle şeylere bayılırdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570210
					],
					"speakerTitle": "Xoma"
				},
				{
					"id": 752570210,
					"content": "Anlaştık, hadi başlayalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yiztli"
				}
			]
		},
