			"dialogs": [
				{
					"id": 752570301,
					"content": "Sonuncusu çok güzel oldu! Sırada şu iri yapılı Fatui var. Aklınızda nasıl bir kare var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570302
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570302,
					"content": "Bir keskin nişancı gibi çıkmak istiyorum. İnsanlar bana baktığında hedefimi asla ıskalamadığımı anlasın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570303
					],
					"speakerTitle": "Wechtekah"
				},
				{
					"id": 752570303,
					"content": "Bu sayede birlikteki nişancılık yarışmalarında sonuncu olsam da sorun olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570304
					],
					"speakerTitle": "Wechtekah"
				},
				{
