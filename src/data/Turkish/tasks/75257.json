			"dialogs": [
				{
					"id": 752570701,
					"content": "Bu sonuncusuydu! Bugün gerçekten hayatımı kurtardınız. Yardımınız olmasa başımdan aşağı şikayet yağacaktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570702
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570702,
					"content": "Sorun değil, hehe. Biz en yardımsever maceracılarız!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752570703
					]
				},
				{
					"id": 752570703,
					"content": "Demek maceracısınız ha? Sizin fotoğrafınızı çekmeme ne dersiniz? Yardımsever ruhunuzu ortaya çıkarırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570704
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570704,
					"content": "Hadi, kameraya gülümseyin! Natlan'da tatiliniz keyifli, sefanız bol olsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752570705
					],
					"speakerTitle": "Yiztli"
				},
				{
					"id": 752570705,
					"content": "İkinize de tekrar teşekkürler. Lütfen bunları teşekkür olarak kabul edin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yiztli"
				}
			]
		},
