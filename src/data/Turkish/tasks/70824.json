					"nextDialogs": [
						708240202
					]
				},
				{
					"id": 708240202,
					"content": "Yer silmekten anlar mısın? Aman, boş ver. O kadar az kişiyle çalışıyoruz ki fazladan yardıma hayır demem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240203
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240203,
					"content": "Gel seni içeriye götüreyim. Orası da çok kirli, iyice temizlenmesi gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adelinde"
				}
			]
		},
