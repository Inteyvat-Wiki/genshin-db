					"nextDialogs": [
						708240403
					]
				},
				{
					"id": 708240403,
					"content": "Harika. Çok yardımcı oldun. Tek başıma yapsaydım kim bilir kaç saat sürerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240404
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240404,
					"content": "Kızlara yaptırsaydım, ellerine yüzlerine bulaştırırlardı muhtemelen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240405
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240405,
					"content": "Çok sağ ol. Lütfen bunları kabul et. Misafirimizsin ama Şaraphane hizmetçisinin işleriyle uğraştın, özür dilerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240406
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240406,
					"content": "Bir dahaki ziyaretinde Şaraphane tertemiz olacak.",
					"roleType": "TALK_ROLE_NPC",
