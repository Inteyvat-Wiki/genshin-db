			"dialogs": [
				{
					"id": 708240101,
					"content": "Etrafı bir daha temizle. Bu sefer tertemiz olsun! İlk izlenim çok önemlidir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240102
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240102,
					"content": "Özür dileriz Bayan Adelinde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240103
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 708240103,
					"content": "Bu sefer daha dikkatli olacağız, Bayan Adelinde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240104
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 708240104,
					"content": "Ne oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708240105
					]
				},
				{
					"id": 708240105,
					"content": "Selam Gezgin. Şafak Şaraphanesine hoş geldin. Fırtına dindi ama hâlâ Şaraphanede fırtınadan kalan pislikleri temizliyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240106
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240106,
					"content": "Temizlik işini organize etmeye çalışıyorum ama şu kızlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240107
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240107,
					"content": "Özür dileriz Bayan Adelinde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240108
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 708240108,
					"content": "Bu sefer daha dikkatli olacağız, Bayan Adelinde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240109
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 708240109,
					"content": "Demiştiniz zaten. Teşekkür ederim! Hadi özür dileyeceğinize biraz temizlik yapın. Yürüyün!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708240110
					],
					"speakerTitle": "Adelinde"
				},
				{
					"id": 708240110,
					"content": "Ah şu çocuklar... Çok baştan savma temizliyorlar. Bu hızda gidersek, bütün iş nasıl bitecek hiç bilmiyorum. Sonra bir de içeriyi temizlemek var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adelinde"
				}
			]
		},
