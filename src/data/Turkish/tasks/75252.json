			"dialogs": [
				{
					"id": 752520701,
					"content": "Buralarda kel birini gördün mü? Asıl önemli olan o. Onunla konuşmam gereken bir konu var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520702,
						752520703
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520702,
					"content": "Benim aradığım kişiye benziyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752520704
					]
				},
				{
					"id": 752520704,
					"content": "Az önce burada mıydı? Geldiğimi görmüş olmalı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520709
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520709,
					"content": "Hıh. Bunun hesabını sorarım senden Icahua...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520706
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520706,
					"content": "Daha önce tanıştığımız için ve herhangi yanlış bir hareketini görmediğimden seni uyarıyorum, o alçak serseriden ve benden uzak dur. Yoksa o güzel yüzün kırmızı ve beyaza boyanabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520707
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520707,
					"content": "Bunlar onun kampında bulduklarım. Yanına almak için vakti olmamış herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520708
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520708,
					"content": "Senin olsun. Merak etme, üzerindeki hakkından çoktan vazgeçti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520710
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520710,
					"content": "Er ya da geç onun canını alacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752520703,
					"content": "Onu görmedim, kusura bakma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752520705
					]
				},
				{
					"id": 752520705,
					"content": "Beni kandırmıyorsun, değil mi? O masum yüzüne inanasım geliyor... Şimdilik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752520706
					],
					"speakerTitle": "Tecuhtli"
				}
			]
