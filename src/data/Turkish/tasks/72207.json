			"dialogs": [
				{
					"id": 722070101,
					"content": "Hayır, yetmez... Yeterli değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070102
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070102,
					"content": "Kardeşimin bana bıraktığı hazine o büyük deniz kabuklarının içerisinde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070103
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070103,
					"content": "Ancak her yere dağıldılar, hem de her yere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070104
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070104,
					"content": "Kardeşimin hazinesi. Hayır, henüz ayrılamam. Hayır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070105,
						722070106
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070105,
					"content": "Hazine mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722070107
					]
				},
				{
					"id": 722070107,
					"content": "Sis Denizi'ne açılıp rahibi çok sinirlendirmişti. Rahip, kardeşimin ruhunun asla geri dönemeyeceğini söyledi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070108
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070108,
					"content": "Ancak kardeşim, \"Orada güzel çiçekler ve inci dolu denizler var. Babam kürek çekiyor ve küçük kız kardeşimizle bize el sallıyorlar...\" dedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722070109
					],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070109,
					"content": "Denize açıldığında hazinesini burada bıraktı ve bir daha dönmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shitoki"
				},
				{
					"id": 722070106,
					"content": "Bu bahsettiğin kardeşin kim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722070107
					]
				}
			]
		},
