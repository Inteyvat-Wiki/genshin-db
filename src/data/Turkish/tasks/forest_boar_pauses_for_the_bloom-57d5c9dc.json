			"dialogs": [
				{
					"id": 700610701,
					"content": "Aa, döndünüz mü? Nasıl geçti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610702
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610702,
					"content": "Onu kovalayıp kaçırdık!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610703
					]
				},
				{
					"id": 700610703,
					"content": "Oh, çok sağ olun. Buyurun, bu da zahmetiniz için.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610704
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610704,
					"content": "Ne de olsa her işin bir karşılığı olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610705
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610705,
					"content": "Nihayet çiçek tarlasını düzene sokabileceğim. Umarım bir daha \"insanlık dışı\" ziyaretçiler ortaya çıkmaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leopoldine"
				}
