			"dialogs": [
				{
					"id": 700610101,
					"content": "*iç çeker* Yine mi... Neden sürekli böyle oluyor? Tarla mahvolmuş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610102
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610102,
					"content": "Bu gidişle çiçekleri zamanında teslim edemeyeceğim. Müşterilerime ne diyeceğim şimdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610103
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610103,
					"content": "Ne oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610104
					]
				},
				{
					"id": 700610104,
					"content": "Şuna baksana. Bütün tarla mahvolmuş... Bu çiçekler ne güzel de açıyordu, şimdi hepsi çöp oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610105
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610105,
					"content": "Hepsi o baş belası yüzünden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610106
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610106,
					"content": "İnsanlık dışı bir hareket!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610107
					]
				},
				{
					"id": 700610107,
					"content": "Değil mi ama? ... Şey. Aslında gerçekten insanlık dışı bir hareket. Orman domuzunun işi çünkü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610108
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610108,
					"content": "Nedense son zamanlarda sürekli buraya inip çiçekleri kemiriyor ve sonra da tarlanın ortasında yuvarlanıp duruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610109
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610109,
					"content": "Çok da uyanık üstelik. Biri sesini duyup ona yöneldiği an kaçıp gidiyor. Demin yoldan geçen yaşlı bir adama çarpacaktı az kalsın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610110
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610110,
					"content": "Ne ayıp yahu. İçiyle dışıyla tam bir domuz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610111
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610111,
					"content": "Aa, bir dakika... Sen Fahri Şövalye değil misin? Mondstadt'ı kurtaran kahraman hani? Öyleyse lütfen bak, yardımına gerçekten ihtiyacım var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610112
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610112,
					"content": "Peki. Onu kovalayıp kaçırırım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700610113
					]
				},
				{
					"id": 700610113,
					"content": "İçime su serptin... Sanırım vadiye doğru gitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610114
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610114,
					"content": "Akıllıdır bu arada. Onu çiçeklerle kendine çekmen gerekebilir... Ama, yani, benim çiçeklerden geriye ne kaldığını görüyorsun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700610115
					],
					"speakerTitle": "Leopoldine"
				},
				{
					"id": 700610115,
					"content": "Belki yol boyunca birkaç Rüzgartepe Çiçeği alıp onları yem olarak kullanabilirsin. Uyanıklık nasıl olurmuş görsün!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leopoldine"
				}
			]
		},
