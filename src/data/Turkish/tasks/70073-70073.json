			},
			"dialogs": [
				{
					"id": 700730101,
					"content": "Bu koca oğlanla dövüşmek istiyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700730102
					]
				},
				{
					"id": 700730102,
					"content": "Şükürler olsun! Efendimiz bile ilahi bedenini esnek tutmalı ki düşen parçalar yumuşacık ve lezzetli olsun. Kendinizi sakınmayın, merhamet göstermeyin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mardava"
				}
			]
		},
		{
			"id": 7007302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7007302",
							"2"
						],
						"stepId": 7007302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mardava"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700730201,
					"content": "Lordum Maha Vasudev{RUBY#[D]Dünyalar Bahşeden Lord'un Varisi}ayaputra, dilerim Jiviti{RUBY#[D]Hayat Kökü}ndriya bu diyarın temel kayalarına kadar nüfuz eder. Lezzetiniz göklerin altındaki tüm tanrıları geride bıraksın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mardava"
				}
			]
		},
		{
			"id": 7007303,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7007302",
							"2"
						],
						"stepId": 7007302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mardava"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700730301,
					"content": "Bu da ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700730302
					]
				},
				{
					"id": 700730302,
					"content": "Ne harika bir soru! Saygıdeğer, Dünyalar Bahşeden Lord{RUBY#[S]Bifrons}'un Varisi, lezzetin zirvesinden doğmuş kutsal bir mantardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700730303
					],
					"speakerTitle": "Mardava"
				},
				{
					"id": 700730303,
					"content": "Nagahvaya, Yeşilliğin Efendisi ve Çiçek Bahçesin{RUBY#[D]Pushpavatika}in Efendisini her daim anar. Makani Khagan, Çölün Efendisine sonsuz dualar eder. Ancak onlara kendin sor. Bu üç büyük efendiden hangisinin tadı benim efendimden daha güzeldir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700730304
					],
					"speakerTitle": "Mardava"
				},
				{
					"id": 700730304,
					"content": "Şunu iyi bil: Kimseye zarar vermemek, erdemli olan yoldur. Efendimizin ilahi eti olmasaydı hayatta kalmak için hayvanların, kuşların ve bitkilerin canını almaya mecbur kalırdık... Ah, bu ne acınası bir durum olurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700730305
					],
					"speakerTitle": "Mardava"
				},
				{
					"id": 700730305,
					"content": "Gerçekten de şanslıyım. Uzay Lordu beni yerden kaldırıp götürdüğünde, lordumun jiv{RUBY#[D]sporları}ası da benimle beraber geldi. Ve şu an gördüğünüz gibi bugüne dek büyüyerek bana üstün ve harikulade bir lezzet bahşettiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mardava"
				}
			]
		},
		{
			"id": 7007304,
