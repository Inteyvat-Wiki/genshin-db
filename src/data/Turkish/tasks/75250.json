			"dialogs": [
				{
					"id": 752500101,
					"content": "Misafirler ellerinde oyuncaklarıyla birer birer ayrılır. Birkaç davetsiz ziyaretçi Alpaka Parkına girer...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752500102
					]
				},
				{
					"id": 752500102,
					"content": "Iı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500103
					]
				},
				{
					"id": 752500103,
					"content": "Dün beni soyan Fatui haydutları! Siz ha... Benden daha ne istiyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500104
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752500104,
					"content": "Merak etme, ben hallederim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752500105
					]
				},
				{
					"id": 752500105,
					"content": "Yoo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500106
					]
				},
				{
					"id": 752500106,
					"content": "Fatui lideri ellerini sallayarak avucuna buruşuk bir not kağıdı bırakıyor. Kağıdı açtığında üzerine kargacık burgacık bir yazı karalandığını görüyorsun...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752500107
					]
				},
				{
					"id": 752500112,
					"content": "Demek dünkü olayın aslı buymuş... Yani ellerini uzattıklarında aslında ödeme yapıyorlarmış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500113
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752500113,
					"content": "B-Ben çok özür dilerim... Niyetinizi tamamen yanlış anladım... Lütfen beni affedin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500114
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752500114,
					"content": "Bu oyuncakların... Hepsini alın lütfen! Benden size hediye olsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500115
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752500115,
					"content": "Fatui lideri başını hayır anlamında sallar ve parmaklarıyla üç rakamını gösterir.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752500116
					]
				},
				{
					"id": 752500116,
					"content": "Anlıyorum... Tıpkı Natlan'ın kahramanları gibisiniz. Gerçek kahramanlığın timsalleri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500117
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752500117,
					"content": "Öyleyse sizin tarzınıza uygun üç farklı renkte oyuncak seçeceğim. Anlayışınız için teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aloha"
				}
			]
