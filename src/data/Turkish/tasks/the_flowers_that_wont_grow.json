			"dialogs": [
				{
					"id": 230230301,
					"content": "Bunlar iş görür. Çok teşekkürler Gezgin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230302
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230302,
					"content": "Bu özel gübreyle toprağın verimliliğinde sorun kalmayacağından güller güzelce büyüyecektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230303
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230303,
					"content": "Umarım önceden kullandıklarımızın aksine bu seferki işe yarar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230304
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230304,
					"content": "Daha önce gübre kullanmayı denemiş miydiniz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230305
					]
				},
				{
					"id": 230230305,
					"content": "Sıradan birkaç gübre kullanmıştık. Pek işe yaramadılar... Hatta hiç işe yaramadılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230306
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230306,
					"content": "Ama diğer tarlalarda işe yaramışlardı. Buradaki sorunun ne olduğunu cidden merak ediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230307
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230307,
					"content": "Pekala, seni daha fazla tutmayalım. Bunları lütfen bir teşekkür olarak kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				}
			]
		},
