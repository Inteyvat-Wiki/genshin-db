			"dialogs": [
				{
					"id": 230230401,
					"content": "Toprak verimliliğinin yanında \"su\" da bir problem olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230402
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230402,
					"content": "Gülleri çok derine gömdüğümüzden, yeterli su gitmemiş olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230403
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230403,
					"content": "Gezgin, gülü sulamamıza yardım eder misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
