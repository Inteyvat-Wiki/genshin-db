			"dialogs": [
				{
					"id": 230230201,
					"content": "Çok fazla özel gübreye ihtiyacımız olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230202
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230202,
					"content": "Elimizde bu özel gübrenin yapımında kullanılan diğer malzemelerden var, ancak Harra Meyvesi kalmamış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230203
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230203,
					"content": "Gezgin, bize birkaç Harra Meyvesi getirebilir misin?",
					"roleType": "TALK_ROLE_NPC",
