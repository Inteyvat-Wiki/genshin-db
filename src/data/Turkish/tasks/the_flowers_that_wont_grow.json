			},
			"dialogs": [
				{
					"id": 230230101,
					"content": "Böyle devam edemeyiz baba. Bu güller pek düzgün büyümüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230102
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230102,
					"content": "Hemen bir çözüm bulmalıyız yoksa bu yıl şifalı bitkileri zamanında teslim edemeyeceğiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230103
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230103,
					"content": "Toprağı iyi. Yabani otlardan ve böceklerden de kurtulduk. O halde sorun ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230104
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230104,
					"content": "Sorun ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230105
					]
				},
				{
					"id": 230230105,
					"content": "Buraya şifalı bitki almak için mi geldin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230106
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230106,
					"content": "Biz bu şifalı bitkilerden düzenli aralıklarla Bimarstan'a gönderiyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230107
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230107,
					"content": "Aralarından en önemlisi bu özel \"Sumeru Gülü\"dür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230108
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230108,
					"content": "Güller ilaç olarak kullanılabilir mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230109
					]
				},
				{
					"id": 230230109,
					"content": "Bunu Bimarstan'daki doktorlara sormalısın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230110
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230110,
					"content": "Bu güllerin başka ilaçlarla birlikte güneş çarpmasını ve mide ağrılarını tedavi etmek için kullanılabileceği söyleniyor. Hatta başka faydaları da varmış ama şu an hatırlayamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230111,
						230230113
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230111,
					"content": "O halde sana yardım edeyim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230112
					]
				},
				{
					"id": 230230112,
					"content": "Çok minnettar oluruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230113,
					"content": "Bu gülün nesi var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230114
					]
				},
				{
					"id": 230230114,
					"content": "Anlamadığım bir nedenden dolayı son derece yavaş büyüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230115
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230115,
					"content": "Tecrübelerimize göre genelde bu tür sorunlar ya topraktan kaynaklanır ya da böcek problemi vardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230116
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230116,
					"content": "Ama aynı toprağa ektiğimiz diğer şifalı bitkiler gayet güzel büyüdü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230117
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230117,
					"content": "Ayrıca her gün böcek kontrolü yapıyoruz. Bu yüzden sorun böcekler de olamaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230118
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230118,
					"content": "Şimdi ihtimallere takılıp kalmanın sırası değil. Biraz daha gecikirsek gülleri Bimarstan'a zamanında ulaştıramayacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230119
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230230119,
					"content": "Planımız toprağı özel bir gübreyle gübrelemek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230120
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230120,
					"content": "Ama aynı zamanda diğer tarlalarla da ilgilenmeliyiz. Bu yüzden gübre için gerekli malzemeleri toplayacak zamanımız kalmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230121
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230121,
					"content": "Gezgin, Bimarstan'daki hastaların hatırına bize bu iyiliği yapar mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230122
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230122,
					"content": "Yaparım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230123
					]
				},
				{
					"id": 230230123,
					"content": "Çok minnettar oluruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230124
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230230124,
					"content": "Bir bakalım. Şu anki durumda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				}
			]
		},
