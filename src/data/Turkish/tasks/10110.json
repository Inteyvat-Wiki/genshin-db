				},
				{
					"id": 101100905,
					"content": "Teşekkürler... Ah, kendimi o kadar kaptırdım ki bugün yapmam gereken bir şey olduğunu unuttum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100906
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100906,
					"content": "Ah... Ama eğitim beni çok yordu, zar zor hareket edebiliyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100907
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100907,
					"content": "Fahri Şövalye, Jack'e benim için bir mesaj iletir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100908,
						101100913
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100908,
					"content": "Jack kim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100909
					]
				},
				{
					"id": 101100909,
					"content": "O benim arkadaşım. Yakın zamanda bir maceracı oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100910
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100910,
					"content": "Bu gece buluşup macera planları hakkında konuşacaktık... Ona bunu başka bir güne ertelememiz gerektiğini söyler misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100911
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100911,
					"content": "Yanılmıyorsam onu <color=#00E1FFFF>Aslan Tapınağında</color> bulabilirsiniz. Bugün Stanley ile maceraya çıktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100912
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100912,
					"content": "Stanley, tüm Mondstadt'ta bilinen gerçekten efsanevi bir maceracıdır. Bir keresinde Mare Jivari'ye ayak basmıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100917
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100917,
					"content": "Aslan Tapınağı mı? Tabii ki, orayı özledim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101100918
					]
				},
				{
					"id": 101100918,
					"content": "Harika! Çok teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				},
				{
					"id": 101100913,
					"content": "Elbette. Onu nerede bulabilirim?",
					"roleType": "TALK_ROLE_PLAYER",
