					"nextDialogs": [
						101100231
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 101100231,
					"content": "Başka bir zaman için kulağa eğlenceli bir fikir gibi geliyor! Ama şimdi ilgilenmemiz gereken başka şeyler var...",
