				{
					"id": 101100213,
					"content": "Ha ha ha, beni ve Bay Balon'u mu kastediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101100214
					],
					"speakerTitle": "Flora"
				},
