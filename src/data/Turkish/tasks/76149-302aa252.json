			"dialogs": [
				{
					"id": 761490101,
					"content": "Kim o? Kim var orada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490102
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490102,
					"content": "#{NICKNAME}. Bu çağa aitim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761490103
					]
				},
				{
					"id": 761490103,
					"content": "Peki, senin zamanına dair hiçbir şey bilmesem de benim adım Alara. Bir zamanlar Sessizlik Çağında bir Çileciydim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490104
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490104,
					"content": "Buraya geleli ne kadar zaman geçti hatırlamıyorum bile. Burası sessizlik meditasyonumu dahi bozdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490105
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490105,
					"content": "Demek ki doğruymuş... Düşüncesiz ve arzusuz bir zihinle meditasyon yapmak, kişinin Kötülüğün Düşüncesizlik Cennetinde yeniden doğmasına yol açıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490106
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490106,
					"content": "Önemli değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761490107
					]
				},
				{
					"id": 761490107,
					"content": "Bana teşekkür etmene gerek yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761490108
					]
				},
				{
					"id": 761490108,
					"content": "Yine de çok teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490109
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490109,
					"content": "Seni kurtarmak daha çok anlık gelişen bir olaydı. Ayrıca meditasyon dışında bir çıkış yolu bulmayı planlıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490110
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490110,
					"content": "Hiç deneyimin yok mu? Yoksa senin çağında meditasyon öğretilmiyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490111
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490111,
					"content": "Buradan ilk ayrılmam yüzlerce yılımı aldı. Hakikat arayışımı... Ve sevdiklerimi tekrar görme özlemimi terk ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490112
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490112,
					"content": "Bu sefer bunların hiçbirinden vazgeçmeye niyetim yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490113
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490113,
					"content": "Benim de.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490114
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490114,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490115
					],
					"speakerTitle": "Dex"
				},
				{
					"id": 761490115,
					"content": "Dex bir Ölümperisi Parçası daha topladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490116
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490116,
					"content": "Ölümperisi mi? Ha, Maranasati meditasyon tekniğinden bahsediyorsun. Kişinin ölümle yüzleştiği andaki zihin durumunu geliştirmek için kullanıldığını biliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490117
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490117,
					"content": "Zeitlind bulunduğuna göre, artık bir çıkış yolu arayalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490118
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490118,
					"content": "Buradan kendi başımıza çıkabileceğimizden emin misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490119
					],
					"speakerTitle": "Alara"
				},
				{
					"id": 761490119,
					"content": "Melanta ve Nihilita bu yerde özgürce hareket edebiliyor ve genellikle yanlarında insan getiriyorlar. Bu durumda Dex de aynısını yapabilmeli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490120
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490120,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490121
					],
					"speakerTitle": "Dex"
				},
				{
					"id": 761490121,
					"content": "Böylece üç Ölüm Perisi Parçası toplanmış oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490122
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490122,
					"content": "Yine de bunun geçici bir isim olduğunu söylemeliyim, çünkü Dex'in bunları ne için kullanacağına dair benim de hiçbir fikrim yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490123
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490123,
					"content": "Sırada ne var Dex?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490124
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761490124,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490125
					],
					"speakerTitle": "Dex"
				},
				{
					"id": 761490125,
					"content": "Talimatlarını izleyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Istoria"
				}
			]
		},
