			"dialogs": [
				{
					"id": 735220101,
					"content": "Lord Sangemah Bay'den yeni bilgiler satışa sunuldu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220102
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735220102,
					"content": "En son raporları satın almak ister misiniz? Bir bakayım, bu bilgi çok önemli değil, o yüzden yarım milyon Mora yeter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220103
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735220103,
					"content": "Her zamanki fiyatın yarısı, çok uygun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220104
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735220104,
					"content": "Bana bedavaya verir misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735220105
					]
				},
				{
					"id": 735220105,
					"content": "Vay canına, sıfır Moraya almak istiyorsun demek. Tam da senden beklediğim gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220106
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735220106,
					"content": "Ancak ben Lord Sangemah Bay'im. Madem bu kadar ilgilisin sana bedava anlatacağım ama başkalarına söylemeyeceğine söz ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220107
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735220107,
					"content": "Yirmi yıl önce, yarışmaya katıldıktan sonra aniden kişiliği değişen bir yarışmacı olduğunu duydum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220108
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735220108,
					"content": "Sanırım birileri onu Aaru Köyü'nde görmüş. Acaba şimdi nerededir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220109
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735220109,
					"content": "Bedava alabileceğiniz bilgi miktarı bu kadar. Daha fazlasını duymak istiyorsanız iki milyon Mora ödemeniz gerekiyor. Cömertliğiniz için şimdiden teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220110
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735220110,
					"content": "Bu bildiğin soygun! Aaru Köyü'ne gider kendimiz sorup öğreniriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7352202,
			"completionStepIds": [
				7352202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7352202",
							"2"
						],
						"stepId": 7352202,
						"stateName": "QUEST_STATE_UNFINISHED"
