				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rishti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735220201,
					"content": "Yirmi yıl önce... Gerçekten de buraya genç bir adam gelmişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220202
					],
					"speakerTitle": "Rishti"
				},
				{
					"id": 735220202,
					"content": "O zamanlar hayat şimdikinden daha zordu. Yoksulluk, hastalık, cehalet... Hepsi yakamıza yapışmıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220203
					],
					"speakerTitle": "Rishti"
				},
				{
					"id": 735220203,
					"content": "Akademiden geldiği ve parlak bir geleceğe sahip olacağı belli olan o genç adam, yine de buraya gelip bize yardım etmek istemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220204
					],
					"speakerTitle": "Rishti"
				},
				{
					"id": 735220204,
					"content": "Solucanlarla ve canavarlarla nasıl başa çıkabileceğimizi öğretti. Kendi cebinden ödeyerek bize birçok ilaç satın aldı ve tüm hastalarla çok yakından ilgilendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220205
					],
					"speakerTitle": "Rishti"
				},
				{
					"id": 735220205,
					"content": "Harika biriymiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735220206,
					"content": "Evet... Ama işte iyiler erken ölürmüş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220207
					],
					"speakerTitle": "Rishti"
				},
				{
					"id": 735220207,
					"content": "Her zaman kaşları çatık dururdu ve kimse onun neye kaygılandığını bilmezdi. Herkes acaba bizi terk mi edecek diye endişelenirdi. Bu yer onu güzelce ağırlayamayacak kadar fakirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220208
					],
					"speakerTitle": "Rishti"
				},
				{
					"id": 735220208,
					"content": "Yine de çoğu kişi onun ilk başlarda biraz deli olduğunu söylüyordu. Mesela, çocuklara bazen kendisi çocukken tuhaf bir yaratığa yazı yazmayı öğrettiğine dair hikayeler anlatıyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220209
					],
					"speakerTitle": "Rishti"
				},
				{
					"id": 735220209,
					"content": "Daha sonra sık sık köyden ayrılmaya ve çölü araştırmaya başladı. Bir keresinde ona ne aradığını sordum, o da bana Nagar bilmem ne grubundan biriyle konuşmak istediğini söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220210
					],
					"speakerTitle": "Rishti"
				},
				{
					"id": 735220210,
					"content": "Sonrasında onun bir bataklıkta öldüğünü duydum. Bir araştırma için yoldayken bataklığa saplanmış bir kervanla karşılaştığı, oradaki çok sayıda kişiyi kurtardığı ama kendisinin bataklıktan zamanında çıkamadığı söyleniyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220211
					],
					"speakerTitle": "Rishti"
				},
				{
					"id": 735220211,
					"content": "O sırada, evinde çocuğuna yazdığı ama yarım kalmış bir mektup vardı. Oğlum, o öldükten sonra bir gün sahiplerine ulaştırma düşüncesiyle o mektubu aldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220212
					],
					"speakerTitle": "Rishti"
				},
				{
					"id": 735220212,
					"content": "O yarım kalmış mektup... Halen burada mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735220213,
					"content": "Hayır, değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220214
					],
					"speakerTitle": "Rishti"
				},
				{
					"id": 735220214,
					"content": "Daha iyi bir yaşam sürmek adına oğlum bir paralı asker oldu. Birkaç yıl önce bir kavgada öldürüldü ve üzerindeki eşyalarına da el koydular.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220215
					],
					"speakerTitle": "Rishti"
				},
				{
					"id": 735220215,
					"content": "Göz açıp kapayıncaya dek yıllar geçti. Acaba çocuğu şimdi nasıldır, babasına karşı bir kin besliyor mudur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735220216
					],
					"speakerTitle": "Rishti"
				},
				{
					"id": 735220216,
					"content": "Bu olayları artık çoğu kişi bilmiyor. Yaşlanıyorum ve yakında belki ben de bunları unuturum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rishti"
				}
			]
		},
