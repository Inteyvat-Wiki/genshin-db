			"dialogs": [
				{
					"id": 706990101,
					"content": "Fahri Şövalye! Eğlence tezgahlarını test etmeye geldiğin için çok şanslıyız. Gerçekten içimi rahatlattın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990102
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990102,
					"content": "Aslında ilk kez bir geliştirme projesinde yer alıyorum, o yüzden biraz endişeliyim. Beynimin devreleri yandı biraz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990103
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990103,
					"content": "Tek yapmam gereken mevcut bir cihaza kaplama yapmaktı. Ama o kadar çok tasarım faktörü, ayarlanması gereken o kadar çok parametre vardı ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990104
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990104,
					"content": "Yüzbaşı Albedo'ya hiç imrenmiyorum açıkçası, o bir de sıfırdan, özel amaçlı cihazlar yaratıyor... Gerçekten zor bir iş olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990105,
						706990106
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990105,
					"content": "Bence cihaz gerçekten çok iyi çalışıyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706990107
					]
				},
				{
					"id": 706990107,
					"content": "Vay be, şey... T-Teşekkür ederim! Sağ ol Fahri Şövalye, bunları senin gibi birinden duymak benim için çok değerli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990108
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990108,
					"content": "Ben... Elimden geleni yapmaya devam edeceğim. Umarım Keşif Bölüğü için faydalı tasarımlar üretebileceğim bir noktaya gelebilirim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990109
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990109,
					"content": "Ha, oyunların birinden birkaç oyuncak kazandım. Bunlardan birini sana vermek istiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990110
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990110,
					"content": "Aynısından bende de var. Artık ne zaman ona baksam aklıma bana cesaret verişin gelecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mika"
				},
				{
					"id": 706990106,
					"content": "Kendine bu kadar yüklenme. Kendini geliştiriyormuşsun gibi düşün.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706990107
					]
				}
			]
		}
	]
