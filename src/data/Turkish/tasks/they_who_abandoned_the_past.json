			"dialogs": [
				{
					"id": 761170201,
					"content": "Peh, ne ezik biri. Meteliğe kurşun atıyor, çalmaya değer hiçbir şeyi yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170202
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170202,
					"content": "Selam Kaleva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170203
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170203,
					"content": "Kim var ora... Vaaay, Jahoda'ymış! Seni buraya hangi rüzgar attı ufaklık?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170204
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170204,
					"content": "Sakin ol, önemli bir şey yok. Birkaç gün önce Ihanti adlı bir adamdan bir şey çaldığını duydum, doğru mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170205
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170205,
					"content": "Bu parayı al ve çaldığın şeyi bana ver. Bugün bonkör günümdeyim, o yüzden senden satın alıyorum gibi düşün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170206
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170206,
					"content": "Bak sen, medeniliğin gözlerimi yaşarttı. Nefer arkanı kollayınca böyle oluyor demek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170207
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170207,
					"content": "Diyelim ki vermek istemiyorum. Ne yaparsın, ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170208
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170208,
					"content": "Bana bir iyilik yap Kaleva. Sen ve o salak arkadaşların bir kereliğine normal davranın. Olmaz mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170209
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170209,
					"content": "Bunca yolu bir hırsızla dürüstçe iş yapmak için geldiğini söylemeyeceksin herhalde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170210
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170210,
					"content": "Yoksa onu gerçekten de sana gümüş tepside sunacağımı mı düşündün?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170211
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170211,
					"content": "Anlaşılan bu pazarlık daha başlamadan sarpa sardı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761170212,
					"content": "*iç çeker*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170213
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170213,
					"content": "Hata bende Kaleva. Seninle Patron Nef gibi iş yapmaya çalışmamalıydım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170214
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170214,
					"content": "Senin gibi moronlar anca ağzına yumruk yemekten anlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170215
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170215,
					"content": "#Hadi {NICKNAME}, şu zibidileri sağlam bir benzetelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170216
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170216,
					"content": "Bizi hafife almak ne demek gösteririm ben sana! Hadi çocuklar, bu ufaklığı geldiği yere geri gönderelim. Yakalayın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaleva"
				}
			]
		},
