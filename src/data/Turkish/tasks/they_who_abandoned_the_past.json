			},
			"dialogs": [
				{
					"id": 761170401,
					"content": "*güçlükle nefes alır*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170402
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170402,
					"content": "Kim var orada? Moram yok, hiçbir şeyim kalmadı... Canımı almaya geldiyseniz hiç durmayın, alın gitsin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170403
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170403,
					"content": "E-Eşyalarını geri getirdim Ihanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170404
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170404,
					"content": "... Jahoda, sen misin? Sesini duyuyorum ama artık gözlerim iyi görmüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170405
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170405,
					"content": "Evet Ihanti, benim, tam karşında duruyorum. Neden gelip beni bulmadın? Perişan haldesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170406
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170406,
					"content": "Açlıktan ölmek üzere olan bir sokak köpeği bile zengin mahallesinde dolaşmaz... Yediği onca dayaktan sonra mümkün değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170407
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170407,
					"content": "Ben öyle biri değilim. Üstelik Nef... Yani Patron Nef de öyle biri değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170408
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170408,
					"content": "Size gelemeyişimin sebebi de bu zaten. Eğer insanlar sizin yardımsever birileri olduğunuzu duysalardı her gün kapınızda biterlerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170409
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170409,
					"content": "Hiç kimse Patrona karşı böyle bir şey yapmaya kalkışacak kadar delirmemiştir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170410
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170410,
					"content": "Ama sen hep sağda solda gizlice iyilik yapıyor ve günün sonunda yardım ettiğin kişiler tarafından sırtından bıçaklanıyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170411
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170411,
					"content": "Hey, ben Patron Nef'ten çok şey öğrendim. Bir daha hiç kimse beni öyle kandıramaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170412
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170412,
					"content": "... Başkalarını kollamaktan kendini alamıyorsun, değil mi Jahoda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170413
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170413,
					"content": "... Bu yalnızca beni ilgilendirir, başkasını değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170414
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170414,
					"content": "Heh... Belki de patronun seni bu kadar takdir etmesinin nedeni budur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170415
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170415,
					"content": "Belki de hâlâ hayatta olmamın bile tek sebebi budur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170416
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170416,
					"content": "Hahaha... *öksürür*... Haklısın Jahoda. Haklısın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170417
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170417,
					"content": "... Her neyse. Senin için yapabileceğim bir şey varsa Ihanti, şimdi söylemenin tam zamanı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170418
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170418,
					"content": "Hiç değişmeyeceksin, değil mi? Ya bu büyük bir oyunsa bu ve seni bir tuzağa çektiysem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170419
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170419,
					"content": "Öyle şey yapmazsın sen. Birbirimizi bunca zamandır tanıyoruz, mümkün değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170420
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170420,
					"content": "Güvenini kazanmak için bu kadarı yeterli, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170421
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170421,
					"content": "Hadi ama, şu haline bak. Bana nasıl bir tehdit oluşturabilirsin ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170422
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170422,
					"content": "Hah! Sonunda bir yere varıyoruz. Sanırım ağzını zar zor açabilen zehirli bir yılanı kurtarmak, ne olursa olsun güvenli sayılır... *öksürür*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170423
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170423,
					"content": "O zaman bana bir iyilik yap da şu çantadaki resmi rulo yapıp cebime koy. Benim hiç kuvvetim kalmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170424
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170424,
					"content": "Bu resmi karım ve kızımla birlikte çizdim. Tüm dünyada değer verdiğim bir tek bu kaldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170425
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170425,
					"content": "Artık başka hiçbir şeyin önemi yok benim için.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170426
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170426,
					"content": "Heh, eski Ihanti bu söylediğini duysa gülmekten yerlere yatardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170427
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170427,
					"content": "Hah... Bir zamanlar her şeyden çok değer verdiklerime ne oldu sanki ha? Ne karımı kurtarabildiler ne de hayatımı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170428
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170428,
					"content": "Ama belki de hırsızların kaderi budur. Çaldığımız her şey sonunda bizden geri çalınır ve er ya da geç yine boş kalır ellerimiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170429
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170429,
					"content": "Görev için verdiğim o kolye elimde kalan son şeydi... Hah, gerçi ona da \"benim\" diyemem ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170430
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170430,
					"content": "Çaldığın ilk mücevherdi. Bu hikayeyi en az on defa dinlemişimdir. Nasıl başardığından ve o zengin adamın gerçeği öğrendiğindeki yüz ifadesinden çok bahsettin daha önce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170431
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170431,
					"content": "Evet. Her neyse, artık senin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170432
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170432,
					"content": "İlk kimindi peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170433
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170433,
					"content": "Holomov adında bir Snezhnayalının. Nod-Krai'da yaşıyordu ama şimdi muhtemelen Snezhnaya'ya geri dönmüştür. Sakın bana o kolyeyi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170434
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170434,
					"content": "Ben artık hırsız değilim, elimde çalıntı eşya tutmaya da niyetim yok. Bu kolye gerçek sahibine geri dönmeli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170435
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170435,
					"content": "Haha... Hahaha... Senin kumaşın gerçekten farklıymış Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170436
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170436,
					"content": "Patron haklıymış... Senin gibi biri asla... *öksürür*... Hırsız olamazdı... *öksürür*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170437
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170437,
					"content": "*öksürür*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170438
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170438,
					"content": "Yeter, nefesini boşa harcama. Geri dönüp sana bir doktor bulacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170439
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170439,
					"content": "Boş ver. Bırak da ait olduğum yere gideyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170440
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170440,
					"content": "Ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170441
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170441,
					"content": "Jahoda, patronun prensibini biliyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170442
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170442,
					"content": "\"Huzur arayanları huzura kavuştur.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170443
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170443,
					"content": "Ne demek istediğimi biliyorsun, o yüzden beni rahat bırak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170444
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170444,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170445
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170445,
					"content": "Peki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170446
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170446,
					"content": "Bana yardıma gelen kişinin sen olmasına sevindim Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170447
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170447,
					"content": "Özür dilerim, sana verecek bir hazinem yok. Ama istersen bu bebeği alabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170448
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170448,
					"content": "İyi ama... Sana söyledim, çalıntı bir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170449
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170449,
					"content": "Merak etme, bunu kendim yaptım. Senin yaptıklarının hepsi çoktan yok oldu. Bana söylediğin gibi her birini yaktım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170450
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170450,
					"content": "Heh. Fena durmuyor, değil mi? Özellikle de neredeyse kör olmak üzere olan biri için...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170451
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170451,
					"content": "Al bunu Jahoda. Son hediyem olarak kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170452
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170452,
					"content": "Seni görmeye geri geleceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170453
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170453,
					"content": "Git hadi. Elveda Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170454
					],
					"speakerTitle": "Ihanti"
				},
				{
					"id": 761170454,
					"content": "Teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ihanti"
				}
			]
		},
