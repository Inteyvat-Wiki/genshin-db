				]
			},
			"dialogs": [
				{
					"id": 761170501,
					"content": "Harika, görevi tamamlamışsınız. Bekleyin lütfen, ödemenizi getireyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170502
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170502,
					"content": "Her şey yolunda mı Bayan Jahoda? Biraz solgun görünüyorsunuz... Bir sorunla karşılaşmadınız umarım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170503
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170503,
					"content": "Merak etmeyin, iyiyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170504
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170504,
					"content": "Peki öyleyse. Bir dakika bekleyin, ödemenizi hemen getireceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170505
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170505,
					"content": "Gerçekten iyi misin Jahoda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170506
					]
				},
				{
					"id": 761170506,
					"content": "Paimon doktor çağırmayacağımıza söz verdiğimizi biliyor ama... Ihanti gerçekten çok kötü görünüyordu. Acaba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761170507,
					"content": "Hayır. Prensibe bağlı kalacağımı söyledim, sözümün arkasında duracağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170508
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170508,
					"content": "Yakından tanışıyordunuz sanırım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170509
					]
				},
				{
					"id": 761170509,
					"content": "Biz eskiden \"çalışma arkadaşı\"ydık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170510
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170510,
					"content": "Ihanti korkak biri olsa da... Hehe, Mora kazanma konusunda onun üzerine yoktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170511
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170511,
					"content": "Herkes aptal dolandırıcılıklar ve küçük soygunlar peşindeyken, o oyunu öyle iyi oynuyordu ki insanlar gönüllü olarak veriyordu paralarını.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170512
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170512,
					"content": "İnsanları ikna etme konusunda tam bir ustaydı. Birlikte \"çalıştığımız\" zamanlarda bana bir sürü şey öğretti... Ayrıca her zaman güzel yemekler ısmarlardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170513
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170513,
					"content": "Arkadaşın mıydı peki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170514
					]
				},
				{
					"id": 761170514,
					"content": "Arkadaş mı? Hah, tabii ki hayır. O cehennemde arkadaş edinmeye çalışmak için çıldırmış olmak lazım. Olsa olsa... Tanışıklığımız vardı diyebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170515
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170515,
					"content": "Bana bu kadar iyi bakmasının tek nedeni gösteriş yapmaktı. Yanında küçük bir yardımcı sürüklemek onu büyük bir adam gibi hissettiriyordu sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170516
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170516,
					"content": "Ama bana iyi baktı, hakkını vereyim. Şimdi ona yardım etmemin tek sebebi de bu iyiliğinin karşılığını ödemek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170517
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170517,
					"content": "Pekala... İşte ödemeniz Bayan Jahoda. Maceracılar Loncası desteğiniz için size teşekkür eder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170518
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170518,
					"content": "#İşte payın {NICKNAME}. Yardımların için teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170519
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170519,
					"content": "Her neyse, Arşiv'e geri dönmeliyim. Patron bir iş yapılmasını ister de beni bulamazsa kesin yine başımın etini yer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170520
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170520,
					"content": "(Ona doktor çağırmayacağımı söyledim ama birkaç ağrı kesici götürmenin bir zararı olmaz sanırım.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170521
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170521,
					"content": "(Patrondan yardım isteyeceğim, eminim bazı bağlantılarını kullanabilir. En kötü ihtimalle bu ayki maaşımdan vazgeçerim... Ya da belki sadece yarısından...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170522
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170522,
					"content": "(Evet, böyle yapayım. Yarın Ihanti'ye ilacı götürsem iyi olur...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
