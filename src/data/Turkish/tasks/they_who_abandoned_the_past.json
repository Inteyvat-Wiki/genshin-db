			"dialogs": [
				{
					"id": 761170101,
					"content": "Hım, görevi sorunsuz bir şekilde halletmişsiniz. Teşekkürler Bayan Jahoda. Buyurun, ödemeniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170102,
					"content": "Gördünüz mü? Size sorun olmaz demiştim. Hem ödemesi de fena değil, hehe... Bunun gibi kolay Mora kazandıran başka işler de var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170103
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170103,
					"content": "Bir bakayım. Biraz bekleyin lütfen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170104,
					"content": "Ne? Baksanıza, şu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170105
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170105,
					"content": "Hey, Katheryne... Şuradaki kolye... Ödüllü bir görev ilanı için mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170106
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170106,
					"content": "Aynen öyle. Sizden de hiçbir şey kaçmıyor Bayan Jahoda. Bay Ihanti onu bir görev ilanı için teminat olarak bırakmıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170107,
					"content": "O halde ben o görevi alayım. Hadi bana detayları anlat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170108
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170108,
					"content": "Yalnız... Bu işin getirisi pek fazla değil, bu tarz eşyaların da günümüzde pek bir değeri kalmadı. Bayan Jahoda, açıkçası bu iş size göre mi emin değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170109,
					"content": "Sorun yok, ben bu görevi alacağım. Bunu bir tür... Hayırseverlik işi gibi düşünebilirim. Arada bir iyilik yapmaktan zarar gelmez sonuçta, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170110
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170110,
					"content": "Haha... Pekala. Lütfen biraz bekleyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170111,
						761170112
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170111,
					"content": "Yine görev mi alıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170113
					]
				},
				{
					"id": 761170113,
					"content": "Yapacak pek bir işim yok malum. Tüm gün oturup Ashru'yla oynayacak halim yok, değil mi ama? Nef... Yani Patron Nef beni anında kapının önüne koyar sonra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170114
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170114,
					"content": "#Hımm, aslında hazır siz buradayken... {NICKNAME}, Paimon, ne kadar becerikli olduğunuz ortada. Bu görevde bana katılmaya ne dersiniz? Ödülü paylaşırız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170115
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170115,
					"content": "#Görev mi? {NICKNAME} daha iyi bilir, bu işin uzmanı o sonuçta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170116,
						761170117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761170116,
					"content": "Sağ ol Paimon, beni utandırıyorsun...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170118
					]
				},
				{
					"id": 761170118,
					"content": "Çok önemli bir şey değildir kesin. Ihanti ödleğin tekidir, ciddi bir şey çıkacağını sanmıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170119
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170119,
					"content": "Bayan Jahoda, Bay Ihanti'nin görevinin ayrıntıları burada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170120
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761170120,
					"content": "Pekala, bakalım bizim pısırık nasıl bir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170121
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170121,
					"content": "... Of.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170122
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170122,
					"content": "Ne oldu? Lütfen aşırı zor bir görev olduğunu söyleme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761170123,
					"content": "Yok, öyle bir şey değil. Sadece bir sineği bile incitemeyecek birinin böylesine bir ölüm kalım görevi vereceğini tahmin etmezdim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170124,
						761170125
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170124,
					"content": "Ö-Ölüm kalım mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170126
					]
				},
				{
					"id": 761170126,
					"content": "Sen mi? Hahaha, öyledir muhakkak... İstesen de kanunlardan şaşamazsın hatta, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170127
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170127,
					"content": "Şaka şaka, takılıyorum sadece. Bir grup dolandırıcıdan bir eşyayı geri almamız gerekiyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170128
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170128,
					"content": "Bir dolandırıcı için hayat para, para da hayat demektir. Bu da meseleyi bir ölüm kalım meselesi haline getirir, haksız mıyım? Hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170129
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170129,
					"content": "Hadi gelin benimle. O serserileri tek başıma halledebileceğime eminim, büyük ihtimalle sizin parmağınızı bile kıpırdatmanıza gerek kalmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170125,
					"content": "Ben kanunlara uyan biriyim, baştan söyleyeyim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170126
					]
				},
				{
					"id": 761170117,
					"content": "Tabii, neden olmasın? Ne tür bir görev?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170118
					]
				},
				{
					"id": 761170112,
					"content": "Bakıyorum da her zamanki gibi meşgulsün...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761170113
					]
				}
			]
		},
