			"dialogs": [
				{
					"id": 761170301,
					"content": "Tamam tamam, siz kazandınız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170303
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170303,
					"content": "Ne dedim ben sana? En başta lafımı dinleseydin iş buraya gelmezdi. Şimdi şu Morayı al ve kendine düzgün bir doktor bul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170304
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170304,
					"content": "Hıh, aklınca bana merhamet mi ediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170305
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170305,
					"content": "Saçmalamayı kes de Morayı al. Parayı suya mı atarsın, bir avuç eşkıya tutup beni dövdürtür müsün orası senin bileceğin iş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170306
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170306,
					"content": "Ama şunu unutma, aç kalmak da dayak yemek de iğrenç bir şey. Durumu kendin için daha fazla zorlaştırma Kaleva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170307
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170307,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170308
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170308,
					"content": "O hasta heriften çaldığım ıvır zıvırlar şurada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170309
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170309,
					"content": "Biraz bozuk para, bir tablo ve kırık bir bebek vardı sadece. Mora çoktan bitti ama diğerlerini henüz elden çıkarmamıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170310
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170310,
					"content": "Pekala, son bir sorum var. Ihanti için \"hasta\" derken ne demek istedin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170311
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170311,
					"content": "Ne demek istediğim açıkça ortada. Öyle zayıf bir haldeydi ki nefes alıp almadığı bile meçhul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170312
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170312,
					"content": "Onu ilk bulduğumda yerde put gibi yatıyordu. Ne yalan söyleyeyim... Belki de çoktan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170313
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170313,
					"content": "... Neyse işte, artık çantaya ihtiyacı olmayacağını düşündüm ve aldım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170314
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170314,
					"content": "Onu en son gördüğün yeri işaretle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170315
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170315,
					"content": "Son gördüğüm yer mi? Sanırım... Şurası.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170316
					],
					"speakerTitle": "Kaleva"
				},
				{
					"id": 761170316,
					"content": "#Pekala. {NICKNAME}, Paimon, hadi gidelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170317
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761170317,
					"content": "Bu eşyayı müşteriye bizzat teslim etmek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
