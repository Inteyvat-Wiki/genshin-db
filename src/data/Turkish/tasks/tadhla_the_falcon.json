			"dialogs": [
				{
					"id": 732790401,
					"content": "Şşş... Gördün mü? Orada birileri var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790402,
					"content": "Hımm... Efendim, bunlar daha önce bahsettiğiniz kişiler olabilir mi? \"Saftui\" miydi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790403
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790403,
					"content": "\"Fatui\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790404
					]
				},
				{
					"id": 732790404,
					"content": "Bir fark yok gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790405
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790405,
					"content": "Şşş! Sessiz ol! Eğer bizi görürlerse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790406,
					"content": "Sakin olun. Beni duymuyorlar. İnanmıyorsanız kendiniz bakın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790407
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790407,
					"content": "Hey! Sen! Şişko! Buradayım! Yemek vakti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790408
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790408,
					"content": "Hı? Bir şey duydun mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790409
					],
					"speakerTitle": "1. Fatui Avcı Eri"
				},
				{
					"id": 732790409,
					"content": "Hayır, neden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790410
					],
					"speakerTitle": "2. Fatui Avcı Eri"
				},
				{
					"id": 732790410,
					"content": "Hım... Birisi \"yemek vakti\" dedi gibi geldi de.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790411
					],
					"speakerTitle": "1. Fatui Avcı Eri"
				},
				{
					"id": 732790411,
					"content": "Hehe, gördün mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790412
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790412,
					"content": "Paimon, Liloupar'ın çocuksu bir yönü olduğunu bilmiyordu. Hehe, çok tatlı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790413,
					"content": "Bak! Şurada! Yakaladıkları kişi Tadhla mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790414,
					"content": "Hımm... Uzun boylu, esmer, açık renk saçlı... Bu, o olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790415,
					"content": "Aferin ufaklık. Hadi halledelim efendim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790416
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790416,
					"content": "#Evet {NICKNAME}! Hadi halledelim şunu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
