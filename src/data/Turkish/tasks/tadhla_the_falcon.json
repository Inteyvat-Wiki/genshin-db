						],
						"stepId": 7327907,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Masseira",
					"Tadhla",
					"Liloupar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732790701,
					"content": "Ah, işte benim küçük Şahinim! Çok teşekkür ederim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790702
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790702,
					"content": "Özür dilerim, tuzağa düşürüldüm. Onların sayesinde geri gelebildim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790703
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790703,
					"content": "Onlar mı? Onlar dediğin Saygıdeğer Cin Efendisi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790704
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790704,
					"content": "Özür dilerim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790705
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790705,
					"content": "Ah tamam, sorun yok! Tadhla yaralı, ona iyi davran!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790706,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790707
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790707,
					"content": "Yaralandın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790708
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790708,
					"content": "Özür dilerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790709
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790709,
					"content": "Bir hayvan mı yaptı insan mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790710
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790710,
					"content": "Kuzeyliler yaptı. Takip edildiklerini fark edince beni tuzağa düşürdüler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790711
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790711,
					"content": "Tuzağa düşüren sen olmalıydın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790712
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790712,
					"content": "Ava giderken avlanmak. Bir Şahin olarak ne büyük bir utanç.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790713
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790713,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790714
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732790714,
					"content": "Gidip dinlen. Yarana daha sonra bakacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790715
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790715,
					"content": "Tadhla sessizce başını sallar ve acı içinde yavaşça uzaklaşır.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732790716
					]
				},
				{
					"id": 732790716,
					"content": "Masseira, konu Tadhla olunca biraz fazla katı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790717,
						732790720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790717,
					"content": "Siz anlaşamıyor musunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790718
					]
				},
				{
					"id": 732790718,
					"content": "Hı? Bu olabilir mi? O benim en sevdiğim Şahinim. Onu severim ama şımartmam. Bir Şahin eli boş gelirse onu nasıl besleyebilirsin ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790719
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790719,
					"content": "Ah, demek öyle... Bu kızın sonu iyi olmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790723
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790723,
					"content": "Lütfen bunu kabul edin. Size minnettarım, Saygıdeğer Cin Efendisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790724
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790724,
					"content": "Öhöm. Bir şey unutmuyor musun? Burada biz de varız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790725
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790725,
					"content": "Hehe, Paimon ikimizin de ödül almaya uygun olup olmadığından emin değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790726,
					"content": "Ah... Evet, tabii. Bu küçük perinin bir insan olmadığı aklımdan çıkmış ama biz bir teşekkürü hak ediyoruzdur, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790727
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790727,
					"content": "Hey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790728,
					"content": "Haha, kusura bakmayın. Lütfen bu ek ödemeyi kabul edin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790729
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790729,
					"content": "Ooo, ek ödeme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732790730,
					"content": "Yine de beklediğimden az ama... Ancak eğer itiraz etmezseniz ben kabul edeceğim efendim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790731
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732790731,
					"content": "Güzel. Eğer ileride vaktiniz olursa lütfen yine gelin. Şahinimin yine yardımınıza ihtiyacı olacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790720,
					"content": "Lütfen ona çok yüklenme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732790721
					]
				},
				{
					"id": 732790721,
					"content": "Yüklenmek mi? Aksine ona karşı hep çok yumuşak davrandım. O yüzden bu kadar dikkatsiz oldu. Tek yaptığım onu eğitmek. O harika bir Şahin. Onu nasıl incitebilirim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790722
					],
					"speakerTitle": "Masseira"
				},
				{
					"id": 732790722,
					"content": "Peki o halde, bir Şahinin kaderi nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732790723
					],
					"speakerTitle": "Liloupar"
				}
			]
		}
	]
}