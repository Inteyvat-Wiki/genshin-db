			"dialogs": [
				{
					"id": 700500501,
					"content": "Gördün mü? Paimon onun sıradan bir kedi olduğunu söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700500502,
					"content": "Hıh. Şu işe bak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500503
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500503,
					"content": "Miyav? Miyav... Miyav miyav?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500504,
						700500506
					],
					"speakerTitle": "Şaşkın Kedicik"
				},
				{
					"id": 700500504,
					"content": "Xuanwen Canavarlarıyla ilgili bir şey biliyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500505
					]
				},
				{
					"id": 700500505,
					"content": "Miyav?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500508
					],
					"speakerTitle": "Şaşkın Kedicik"
				},
				{
					"id": 700500508,
					"content": "Kedi çaresizce dönüp gider...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700500509
					]
				},
				{
					"id": 700500509,
					"content": "Yine de... Bu kedi, tamamen büyüyene dek Qiaoying Köyü'nde saklanan, tek hamlede tüm o koca çay bitkilerini yok edebilen o efsanevi canavarın genç hali olabilir mi acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500510
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500510,
					"content": "Bayan Guijarro, yine mi bu mesele? Xuanwen Canavarlarının o kadar nazik canavarlar olmadığını söylememiş miydim ben size?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500511
					],
					"speakerTitle": "Hung Fan"
				},
				{
					"id": 700500511,
					"content": "Ah, Bayan Hung Fan! Ne tesadüf. Sizi buraya hangi rüzgar attı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500512
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500512,
					"content": "*iç çeker* Lütfen \"suç davaları\" gibi şeylerden bahsetmeyi bırakın. Ya çocuklar dediklerinizi ciddiye almaya başlarsa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500513
					],
					"speakerTitle": "Hung Fan"
				},
				{
					"id": 700500513,
					"content": "Siz ikiniz tanışıyor musunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500514
					]
				},
				{
					"id": 700500514,
					"content": "Evet. Buraya geldiğimde valizlerimi taşımama yardımcı olması için bu hanımefendiyle anlaştım. Ayrıca kendisinden halk masallarıyla ilgili bilgi aldım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500515
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500515,
					"content": "Xuanwen Canavarlarının buralarda görülmediğini kaç kez söylesem de bana inanmadınız. Hatta yanlış hatırlamıyorsam demiştiniz ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500516
					],
					"speakerTitle": "Hung Fan"
				},
				{
					"id": 700500516,
					"content": "Burada olmasalar da onlarla ilgili bilgi toplamanın birçok yolu var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500517
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500517,
					"content": "Evet, aynen böyle demiştiniz... Sizi caydırmanın neredeyse imkansız olduğunu biliyorum ama köyden ayrılmamanızı rica etmek zorundayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500518
					],
					"speakerTitle": "Hung Fan"
				},
				{
					"id": 700500518,
					"content": "Canavarlar son derece tehlikelidir, yani biriyle karşılaşırsanız... *iç çeker* Neyse, lütfen köyden tek başınıza ayrılmayın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500519
					],
					"speakerTitle": "Hung Fan"
				},
				{
					"id": 700500519,
					"content": "Hung Fan, az önceki kediden daha yorgun ve çaresiz bir halde gider...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700500520
					]
				},
				{
					"id": 700500520,
					"content": "Bayan Hung Fan böyle söylediğine göre malzeme toplamak için başka yere gitmek zorunda kalacağız anlaşılan. Hadi o zaman, beni takip edin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500506,
					"content": "Kusura bakma, yanlış kediyi yakalamışız.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500507
					]
				},
				{
					"id": 700500507,
					"content": "Miyav...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500508
					],
					"speakerTitle": "Şaşkın Kedicik"
				}
			]
		},
		{
