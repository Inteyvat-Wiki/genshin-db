			},
			"dialogs": [
				{
					"id": 700500801,
					"content": "Demek \"fenerler\" bunlarmış. Ne güzel, tıpkı balığa benziyorlar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500802
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500802,
					"content": "Bu saplar fenerleri kaldırmak için kullanılıyor demek, öyle mi? Hımm... Teknik tasarım zekasına sahip olan biri böyle ayrılabilir bir yapıya kimse fark etmeden kolaylıkla birkaç gizli bölme ekleyebilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500803
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500803,
					"content": "İçerideki alan da oldukça genişmiş. Birkaç şey eklenebilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500804
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500804,
					"content": "Dur! Bu düşünceleri kendine saklasan iyi olur!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500805
					]
				},
				{
					"id": 700500805,
					"content": "Ne? Ah... Doğru ya! Hahaha, kusura bakmayın. Böyle ilginç şeyler görünce sesli düşünmekten kendimi alamıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500806
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500806,
					"content": "Hımm. Evet, bu \"fenerler\" romanıma kesinlikle epey katkıda bulunacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500807
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500807,
					"content": "Zahmet olmazsa kenara geçip benim için şu \"balık fenerin\" bir fotoğrafını çeker misin? Sonrası için referans olarak elimde bir resim olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500808,
						700500809
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500808,
					"content": "Bir kez daha Kamera becerilerimi geliştirme vakti geldi desene...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500810
					]
				},
				{
					"id": 700500810,
					"content": "Fotoğraf çekme işini sana bırakıyorum o halde... Lütfen fenerin tamamını kadraja aldığından emin ol. Bu benim için çok önemli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500811
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500811,
					"content": "\"Boyutlar\" ile ilgili bir olay örgüsü oluşturmak epey ilginç olacak... Esas soru ağırlık sorununun nasıl çözüleceği...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500809,
					"content": "Hallederim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500810
					]
				}
			]
		},
		{
			"id": 7005010,
