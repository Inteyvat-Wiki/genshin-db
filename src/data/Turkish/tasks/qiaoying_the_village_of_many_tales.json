					}
				]
			},
			"dialogs": [
				{
					"id": 700500601,
					"content": "Ne düşünüyorsun? Bu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500602
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500602,
					"content": "Bir çay kazanı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500603
					]
				},
				{
					"id": 700500603,
					"content": "Evet, çayla ilgili bir şey... Ve bu, onu özel kılıyor... Her neyse, böyle tam orta yere yerleştirilmiş! Bana soracak olursanız kesin özel bir anlamı var bunun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500604
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500604,
					"content": "Hımm. Peki ya... Xuanwen Canavarımız burayı başından beri bir gizlenme yeri olarak kullanıyorsa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500605,
						700500606
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500605,
					"content": "Bu hızla fantastik roman bile yazarsın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500607
					]
				},
				{
					"id": 700500607,
					"content": "Sonra bir bakmışsın, hikayeye bir de Adeptusları eklemişsin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700500608,
					"content": "Bunun bir suç hikayesine uygun bir konu olup olmadığından emin değilim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500609
					]
				},
				{
					"id": 700500609,
					"content": "Hımm, ne güzel ifade ettin. Xuanwen Canavarı çevresinde yoğunlaşmış bir suç hikayesinin ciddiye alınmayacak kadar \"absürt\" olacağını mı düşünüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500610
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500610,
					"content": "Şey... Yani evet, biraz. Hikayenin olay örgüsünü ilerletmek için böyle bir şeyi kullanabilir misin gerçekten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700500611,
					"content": "Bir dakika, sakın bana...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500612
					]
				},
				{
					"id": 700500612,
					"content": "#Haha, pek de zekisin {NICKNAME}. Söyledikleri kadar varsın doğrusu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500613
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500613,
					"content": "Aynen öyle! \"Mümkün olamayacak kadar absürt bir suç\" hakkında yazmak istiyorum. Sizin de Bayan Hung Fan'ın de tepkisi oldukça ilginçti. Romanıma bunları da ekleyeceğim mutlaka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500614
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500614,
					"content": "Xuanwen Canavarına gelince... Hikayemdeki \"suçlu\" o olacak. Daha önce hiç görülmemiş ama köydeki kötüleri parçalayıp yuttuğu söylenen bir canavar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500615
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500615,
					"content": "Bir festival sırasında, yerleşim yerinin dışında vahşi bir yaratık tarafından öldürülen bir köylü bulunur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500616
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500616,
					"content": "Ne var ki ana karakter, festivalin ikinci gününde aslında ölü olması gereken kurbanla karşılaşır... Hemen ardından başka bir kurban ortaya çıkar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500617
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500617,
					"content": "Ee, peki sonra? Sonra ne oluyor söylesene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700500618,
					"content": "O kadarını düşünmedim henüz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500619
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500619,
					"content": "Ben gidiyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500620
					]
				},
				{
					"id": 700500620,
					"content": "Off, yapmayın böyle! Kitabı bitirdiğimde size imzalı birer kopyasını göndereceğim mutlaka. Hatta önemli bir konuda yardım isteyeceğim sizden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500621
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500621,
					"content": "Bayan Hung Fan köyden tek başıma ayrılmamamı söylemedi mi hem? Tavsiyesine uymaya karar verdim ben de!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500622
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500622,
					"content": "İşte artık siz burada olduğunuz için yalnız değilim! Köyün dışına çıkabilirim yani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500623
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500623,
					"content": "Çok uzağa gitmeyeceğiz tabii! Ne diyorsunuz? Bana yardım etmek ister misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500624,
						700500625
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500624,
					"content": "Şey, tabii... Sana yardım edelim ki sen de bize hikayenin sonunu anlatabilesin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500627
					]
				},
				{
					"id": 700500627,
					"content": "Tamam o zaman! Şuraya gidelim mi? Orayı görmek istiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500625,
					"content": "Lütfen standart ödeme yöntemini kullan, teşekkürler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500626
					]
				},
				{
					"id": 700500626,
					"content": "Tabii. Merak etme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700500627
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700500606,
					"content": "Bence bu artık bir suç hikayesi olmaktan çıktı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700500607
					]
				}
			]
		},
		{
			"id": 7005008,
