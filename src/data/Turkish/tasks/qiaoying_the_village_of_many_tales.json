				]
			},
			"dialogs": [
				{
					"id": 700501001,
					"content": "Guijarro nereye gitti? Daha az önce burada değil miydi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501002,
						700501003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501002,
					"content": "Onu Xuanwen Canavarı mı kaçırdı acaba?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501004
					]
				},
				{
					"id": 700501004,
					"content": "Öyle şeyler söyleme! Muhtemelen olay örgüsü üzerine düşünmek için bir yerlere gitmiştir. Paimon'a kalırsa bölgeyi aramalıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501005,
					"content": "Yandaki çay tarlası iyi bir gözetleme noktası olabilir. Oradan başlayalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501006
					]
				},
				{
					"id": 700501006,
					"content": "İyi fikir! Aramaya yüksekten başlayalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501003,
					"content": "Romanı gerçek bir hikayeye mi dönüştü yoksa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501004
					]
				}
			]
		},
		{
			"id": 7005012,
			"completionStepIds": [
				7005012
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
