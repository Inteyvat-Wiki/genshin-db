					}
				]
			},
			"dialogs": [
				{
					"id": 700501201,
					"content": "Guijarro! Buraya nasıl geldin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501202,
					"content": "... Hayır, hayır. En önemli ipucunu böyle bulmalarına izin veremem. Hem tüm gece buraya bağlı kaldıktan sonra düzgün bir şekilde düşünmek mümkün olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501203
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501203,
					"content": "Epey dalgın görünüyor. Çığır açan bir fikir mi buldu acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501204,
					"content": "Daha çok büyük bir engel gibi sanki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501205
					]
				},
				{
					"id": 700501205,
					"content": "#{NICKNAME}, Paimon, tam zamanında geldiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501206
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501206,
					"content": "Beni tahta bir kazığa bağlayabilir misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501207
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501207,
					"content": "Paimon doğru mu duydu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501208,
					"content": "Evet, aynen öyle dedim. Lütfen ellerimi bağlayın ve beni... Bir ağaca asın. Şey, onlar da ahşap zaten. O yüzden fark etmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501209
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501209,
					"content": "Romanındaki şüphelilerden biri olmaya niyetim yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501210
					]
				},
				{
					"id": 700501210,
					"content": "Merak etme, başıma gelebilecek tüm aksiliklerin sorumluluğunu üstlendiğim bir sorumluluk reddi belgesi hazırladım bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501211
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501211,
					"content": "Hayır yahu, sorun bu değil. Seni neden bağlamamızı istiyorsun ki? Yanlış bir şey yapmadın ne de olsa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501212,
					"content": "Romanımdaki ana karakter, köylüler tarafından ellerinden asılıp bir gece boyunca vahşi doğada bırakılıyor. Sonra da orada Xuanwen Canavarı tarafından yargılanmayı bekliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501213
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501213,
					"content": "Hikayenin devamında, olayların bu şekilde gerçekleşeceğini zaten tahmin eden ana karakterimiz bir şekilde hayatta kalıp geceyi geçiriyor ve sonrasında her şeyin ardındaki gerçeği ortaya çıkarıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501214
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501214,
					"content": "Ne var ki tüm gece boyunca elleri kolları bağlı bir şekilde asılı duran birinin nasıl hissedeceği hakkında bir fikrim yok. Ses tonu nasıl olurdu, nasıl düşünürdü ve hatta nasıl kıpırdardı bilmiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501215
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501215,
					"content": "Bu yüzden beni bağlayıp tüm gece boyunca burada bırakmanız lazım. Böylece bu duyguları bizzat tecrübe edebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501216,
						700501217
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501216,
					"content": "Olmaz. Bu çok tehlikeli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501218
					]
				},
				{
					"id": 700501218,
					"content": "Şey... Yani var aslında ama bu kadar etkili olacağını sanmam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501219
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501219,
					"content": "Böyle yapmak yerine ellerimi kaldırıp tüm gece boyunca burada kalabilirim de.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501220
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501220,
					"content": "Şey... Ya da o romanı yazmayabilirsin mesela. Paimon, burada yaptıklarımızın kolayca yanlış yorumlanabileceğini düşünüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501221,
					"content": "Ana karakterine çok acı çektiriyorsun...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501222
					]
				},
				{
					"id": 700501222,
					"content": "Lütfen! Bu en önemli adım! Bu engeli de aşınca romanım tamamlanmış olacak! Bu yöntemi kullanırsak cinayet işlemek zorunda kalmayacaksınız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501223
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501223,
					"content": "Zaten zorunda değildik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501224,
					"content": "En başından beri cinayet işlemek zorunda değildik ki zaten!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501225
					]
				},
				{
					"id": 700501225,
					"content": "Ah... Yani çok fazla şey yapmak zorunda kalmayacaksınız demek istemiştim. İhtiyacım olan bilgiyi toplayana kadar birisi ya da bir hayvan falan beni kapıp götürmesin diye yanımda durun yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501226
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501226,
					"content": "Bir bakalım... Romanda yaratmak istediğimiz atmosfer göz önüne alındığında hâlâ biraz daha yukarıya çıkmamız gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501227
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501227,
					"content": "Ne? Hey! Bizi bekle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501228,
					"content": "Guijarro ile birlikte çay tarlalarının en yüksek noktasına tırmanıyorsunuz...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700501229
					]
				},
				{
					"id": 700501229,
					"content": "Off, burası biraz s-soğukmuş ama... İnsanı moda da sokmuyor değil hani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501230
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501230,
					"content": "Tüm gece burada, ellerin havada duracak mısın cidden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501231,
					"content": "Aynen öyle. Kararımı verdim. Edebiyat uğruna bazı fedakarlıklarda bulunmak şart...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501232
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501232,
					"content": "Lütfen bu sırada siz de burada nöbet tutun. Sadece bir geceliğine... Sadece bir geceliğine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501217,
					"content": "Bunu yapmanın daha güvenli bir yolu yok mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501218
					]
				}
			]
		},
