				},
				{
					"id": 700501502,
					"content": "Guijarro!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501503,
					"content": "Önce ayağa kalkmasına yardım edelim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501504
					]
				},
				{
					"id": 700501504,
					"content": "Yere doğru düzgün oturabilmesi için Guijarro'nun doğrulmasına yardım ediyorsunuz.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700501505
					]
				},
				{
					"id": 700501505,
					"content": "Demek böyle bir hismiş... Berbat bir şeymiş hakikaten. Hem yorgunum hem de zihnim tamamen uyuşmuş gibi sanki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501506
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501506,
					"content": "Görev başarıyla tamamlandı o halde?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501507
					]
				},
				{
					"id": 700501507,
					"content": "Elbette. Bağlanıp asılarak bir geceliğine doğanın merhametine bırakılmanın nasıl bir his olduğunu biliyorum artık.",
					"roleType": "TALK_ROLE_NPC",
