					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501510,
					"content": "Öyle mi? Süper havalı bir numara mı yapacak yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501511,
					"content": "Kesinlikle... Muhteşem olacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501512
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 700501512,
					"content": "Guijarro bir kez daha bayılır...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700501513
					]
				},
				{
					"id": 700501513,
					"content": "Hey! Hey! Guijarro, sen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700501514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700501514,
					"content": "Bayılmadan *önce* bunun nasıl olacağını söylesen olmaz mıydı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700501515
					]
				},
				{
					"id": 700501515,
					"content": "N-Neyse, gidip ona bir doktor bulalım... Hadi köye dönelim!",
