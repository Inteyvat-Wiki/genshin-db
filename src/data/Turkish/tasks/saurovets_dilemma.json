				]
			},
			"dialogs": [
				{
					"id": 750180301,
					"content": "\"Raaarr!\"\\nGukuzor, ona karşı koyacak kimse yokmuşçasına haykırarak uçup gider...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750180302
					]
				},
				{
					"id": 750180302,
					"content": "Uf, çok hızlıydı! Toz oldu resmen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180303,
						750180305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180303,
					"content": "Hadi Paimon, peşinden gidiyoruz!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750180304
					]
				},
				{
					"id": 750180304,
					"content": "Ne? Paimon'un onu kovalamasını mı istiyorsun? Sen ciddi misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180307,
					"content": "... Hımm, hiç değilse iyileştiğini görmüş olduk. Şimdi yapmamız gereken şeyse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180308
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180308,
					"content": "Bu arada o Gukuzor neden öyle kızgındı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180309,
					"content": "... Hımm, Paimon biliyor! Onun atıştırmalıklarını çalmış olmalısın! Paimon sana şu kadarını söylesin, bu hayatta yiyeceğinin çalınması kadar sinir bozucu bir şey yoktur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180310,
					"content": "Atıştırmalık mı? Evet, biraz almıştım ama Kururuk böyle önemsiz bir şeye kafayı takacak bir Sürüngen değildir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180311
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180311,
					"content": "\"Kururuk\" mu? Demek bir adı da var... Hırçın bir tipe benziyor. Demin az kalsın yapıştırıyordu sana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180312,
					"content": "Yine de onu suçlayamam. Bunlar hep tedavinin etkileri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180313
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180313,
					"content": "Yani dayak yemek de bir çeşit tedavi mi? İnsan her gün yeni bir şey öğreniyor gerçekten...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750180314
					]
				},
				{
					"id": 750180314,
					"content": "Raarr! Raaaarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180315
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180315,
					"content": "#Ne? Hadi ama, bunu da nereden çıkardın? Saçmalamayı bırak. {REALNAME[ID(2)|SHOWHOST(true)]} ciddiye alıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180316,
					"content": "Roor? Aruu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180317
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180317,
					"content": "Haha, bu tedavi işe yarıyorsa ben de denemek isterim! Ne yazık ki Sürüngenler bizden farklılar. Onlara hızlı iyileşme sağlayan bir tedaviden bahsetsen bile anlayacaklarının garantisi yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180318
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180318,
					"content": "Ha, bu arada kendimi tanıtayım. Ben Mazkal. Genelde yakındaki yaralı ve hasta Sürüngenlerle ilgilenirim. Övünmek gibi olmasın ama genelde ilaçlarım gayet iyi yorumlar alır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180319
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180319,
					"content": "Hımm, küçük yoldaşınız oldukça sağlıklı görünüyor. Yardımıma ihtiyacı yok bence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180320
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180320,
					"content": "Raarr! Raaaarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180321
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180321,
					"content": "Ha, demek sen bir Sürüngen veterinerisin! Hımm, Kururuk'un hareketlerine bakılırsa işin epey zor olmalı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180322,
					"content": "O kadar da zor sayılmaz aslında. Kururuk'un durumu biraz özel... Şu anda insanlara karşı yoğun bir güvensizliği var, bu nedenle tüm tedavi ve ilaçları reddediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180323
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180323,
					"content": "*iç çeker* Keşke ben de Sürüngen olsaydım. Onu gözlemledim ve diğer Sürüngenlerle gayet iyi anlaştığını gördüm. Belki bir Sürüngen tarafından önerilse ilaçlarını almaya bile razı olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180324
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180324,
					"content": "Ruuu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180325
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180325,
					"content": "Hımm. Öyleyse belki sana yardımcı olabiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180326,
					"content": "Nasıl? Bir dakika, yani bu görünüşünüze rağmen aslında Sürüngen olduğunuzu mu söylüyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180327
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180327,
					"content": "Hayal gücün gerçekten tam kapasite çalışıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180328,
					"content": "#N-Neyse. {REALNAME[ID(2)|SHOWHOST(true)]} çok zeki bir Sürüngendir, bize yardım edebilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180329,
					"content": "Öyle mi? O kadar akıllı demek ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180330,
						750180332
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180330,
					"content": "Yoldaş olarak beni seçtiğine göre ne kadar akıllı olduğunu sen düşün...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750180331
					]
				},
				{
					"id": 750180331,
					"content": "Yani evet ama şu anki odak noktamız bu mu sence?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180333,
					"content": "#Aynen öyle! Özetle {REALNAME[ID(2)|SHOWHOST(true)]} senin işini çözebilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180334,
					"content": "Rarr! Rarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180335
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180335,
					"content": "#O halde Kururuk adına sana şimdiden teşekkür ederim {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180336
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180336,
					"content": "Onun bu devam eden huysuzluğu hem eski yaralarının iyileşmesine engel olur hem de yeni yaraların oluşmasına yol açar diye korkuyorum... Yardım edecek olmanız beni çok rahatlattı bu yüzden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180337
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180337,
					"content": "Onun için iki farklı ilaç hazırladım. İksirin iyileştirici etkilerini ve lezzetini dengelemek için elimden geleni yapmış olsam da henüz mükemmel bir solüsyon ürettiğimi söyleyemem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180338
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180338,
					"content": "Sonuç olarak, iki ilaçtan iyileştirici özellikleri güçlü olanı pek lezzetli değil, ancak Sürüngenlerin tadını sevdiği iksir de diğeri kadar etkili değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180339
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180339,
					"content": "#Hımm... Neyse, uzun uzadıya açıklamak yerine {REALNAME[ID(2)|SHOWHOST(true)]} gelip iksirleri koklasa daha pratik olacak. Verdiği tepkiye göre bir çıkarımda bulunursunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180340
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180340,
					"content": "Bu, iyileştirme özelliği etkili olan ilaç.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180341
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180341,
					"content": "Vuuu... Ruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180342
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180342,
					"content": "Bu ise daha iştah kabartan ama daha az etkili olan iksir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180343
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180343,
					"content": "Raarr! Raaaarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180344
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180344,
					"content": "Vay be, arada çok büyük fark var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180345,
					"content": "Hangi ilacı kullanırsanız kullanın Kururuk'un iyileşmesine yardımcı olacaktır, bu yüzden size ikisini de veriyorum. Hangisini denemek istediğinize siz karar verin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180346
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180346,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180347
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180347,
					"content": "Hehe, size güveniyorum! Neyse, ben hazırlık yapmak için kampa dönüyorum. Kururuk size emanet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180348
					],
					"speakerTitle": "Mazkal"
				},
				{
					"id": 750180348,
					"content": "#Sen merak etme, {REALNAME[ID(2)|SHOWHOST(true)]} bu işi halleder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750180332,
					"content": "İnsanlar ve Sürüngenler arasında dostluk bağları kurabilecek kadar akıllıdır.",
