					"nextDialogs": [
						750180102
					],
					"speakerTitle": "\"Kururuk\""
				},
				{
					"id": 750180102,
					"content": "Hadi ufaklık, hadi diyorum, lütfen oynama benimle. İlaçlarını almazsan iyileşemezsin bak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180103
					],
