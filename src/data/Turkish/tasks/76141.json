			"dialogs": [
				{
					"id": 761410101,
					"content": "Tekrar hoş geldiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410102
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410102,
					"content": "Ama uzun, duygusal ve gözü yaşlı bir vedanın vakti değil henüz... Ne de olsa küçük kulübemdeki turunuzu bitirmediniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410103
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410103,
					"content": "Paimon bütün odaları gezdiğimizden emindi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761410104,
					"content": "Ama size hiç gizli oda yok demedim, öyle değil mi? Biz büyücüler böyle küçük tuhaflıkları severiz. Artık buna alışmış olmanız lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410105
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 761410105,
					"content": "Bu taraftan lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
		{
			"id": 7614102,
			"completionStepIds": [
				7614102
			],
