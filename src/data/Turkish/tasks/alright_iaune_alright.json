			},
			"dialogs": [
				{
					"id": 240130101,
					"content": "*iç çeker* Bu neden oldu bilmiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130102,
						240130103
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130102,
					"content": "Iaune?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130104
					]
				},
				{
					"id": 240130104,
					"content": "Aa Gezgin, seni gördüğüme sevindim. Kahve içmeye mi geldin? Sana bir bardak ısmarlayayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130105
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130105,
					"content": "Sorun ne? Çok kötü görünüyorsun. Biri yine geç saatlere kadar seni ayakta mı tuttu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240130106,
					"content": "İlgin için sağ ol ama bu sefer sorun tamamen benimle ilgili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130107
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130107,
					"content": "Bir süredir... İşimin amacını düşünüyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130108
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130108,
					"content": "Hukuk Dairesi benim gözümde hep, herkesin birbirine yardım etmeye istekli olduğu, adil, verimli ve güçlü bir kurumdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130109
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130109,
					"content": "Onun yönetimi altında Fontaine Şehri'nin iyi yönde gelişeceğine inanıyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130110
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130110,
					"content": "Ama şimdi burası gözümde mahvolmuş mekanik bir evden başka bir şey değil. Dişlileri, kolları ve gedikleri düzensiz bir şekilde çalışıyor... Yalnızca sözde itibarı ayakta duruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130111
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130111,
					"content": "Hâlâ işlevsel olmasını bir seri tesadüf ve derslere borçlu. Dikkatli değerlendirmeler ve tasarımlardan söz edemeyiz bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130112
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130112,
					"content": "Ben... Bu konuda bir şey yapmak istiyorum ama yapamıyorum. Tek bir hatamın tüm burayı felakete sürüklemesinden endişe ediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130113
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130113,
					"content": "Roialte bana her zaman rahatlamamı, hatalarımın burayı olduğundan daha kötü bir hale getiremeyeceğini söylüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130114
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130114,
					"content": "B-Birini avutmak için garip bir yöntem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240130115,
					"content": "*iç çeker* Pardon, şikayet etmemem gerekir. Ne de olsa buraya tüm olan bitenden biraz olsun uzaklaşmak için geldim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130116
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130116,
					"content": "Sana bir kahve demleyeyim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130117
					]
				},
				{
					"id": 240130117,
					"content": "Gerçekten mi? Kahve demlemeyi biliyor musun? Bu harika. Her zaman öğrenmek istemişimdir ama buna hiç fırsatım olmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240130118
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130118,
					"content": "Demle bakalım o zaman. Ben seni burada bekliyorum... Umarım şansım yaver gider de burada da işle ilgilenmem gerekmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240130103,
					"content": "Bugün izinli misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240130104
					]
				}
			]
		},
		{
			"id": 2401302,
			"completionStepIds": [
				2401302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
