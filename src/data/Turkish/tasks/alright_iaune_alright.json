					"nextDialogs": [
						240133102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240133102,
					"content": "Kahve demliyorsunuz...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240133103
					]
				},
				{
					"id": 240133103,
					"content": "Uuu, çok güzel kokuyor! Hadi bunu Iaune'a verelim. Paimon bunun onu mutlu etmesini umuyor!",
					"roleType": "TALK_ROLE_NPC",
