			"dialogs": [
				{
					"id": 751330101,
					"content": "Paimon, Coco'nun bizi buraya getirmesini beklemiyordu. Bu tuhaf kale tıpkı seninle karşılaştığımız yere benziyor Bona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330102,
					"content": "Baksanıza, duvar resimleri bile aynı! Üstlerindeki çizikler dışında tabii. Acaba daha yukarıda oldukları için mi böyle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330103,
					"content": "#{NICKNAME}, baksana! Bona'nın bahsettiği Piton Kral olmalı bu. Cidden çok zalim duruyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330104,
					"content": "Evet, bu Piton Kral Och-Kan. Efsanede anlatıldığına göre Tonatiuh'yu inşa ettirmek için halkına büyük zulümler etmiş. Yaptığı eziyetler de Hiçliğin dikkatini çekmiş. Nihayetinde hem canından hem de krallığından olmuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330105
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330105,
					"content": "Tabii bu sadece bir efsane. Kabilemdeki hikaye anlatıcıları Och-Kan'ın hikayesini hep farklı farklı anlatıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330106
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330106,
					"content": "Kim bilir, belki de hâlâ Tonatiuh'da gezinip hazinesinin tadını çıkarıyordur. Peşimize düşen kötü ejderha aslında onun hayaleti bile olabilir, neme lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330107
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330107,
					"content": "Cik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330108
					],
					"speakerTitle": "Cocouik"
				},
				{
					"id": 751330108,
					"content": "Ne biçim bir hikaye o öyle ya! Zavallı Coco'nun ödü koptu senin yüzünden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330109,
					"content": "Raarr! Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330110,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} ejderhayı yendiğimizden beri kendini göstermek istiyor sanki. Coco'ya gizliden gizliye kafa mı tutuyor ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330111,
					"content": "Neyse. Aradığımız Sunak ne tarafta peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330112,
					"content": "Coco doğru yönü gösteriyorsa hemen altımızda olmalı... Hımm, yukarıda olur sanmıştım aslında ben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330113
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330113,
					"content": "Yolu mu karıştırdık yoksa? Kadim Ateş Sunağı dağın içinde olamaz herhalde, değil mi? Oradaysa içeriden gökyüzüne nasıl yolculuk edebiliriz ki? Gemiye çıkabilmemiz için dağın yıkılması falan lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330114
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330114,
					"content": "Belki de özel bir ulaşım yöntemi vardır...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330115
					]
				},
				{
					"id": 751330115,
					"content": "E şimdi ne olacak o zaman? Yola çıkmadan önce kendinden çok emindin. Şimdi Coco'nun ne demek istediğini de anlayamıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330116,
					"content": "Kulu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330117
					],
					"speakerTitle": "Cocouik"
				},
				{
					"id": 751330117,
					"content": "Raarr! Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330118
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330118,
					"content": "#Senden bir fikir çıkar mı {REALNAME[ID(2)|SHOWHOST(true)]}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330119,
					"content": "Sanırım anladım olayı. Böyle düz mantık düşünürsek hiçbir yere varamayacağımızı söylemeye çalışıyor bize!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330120
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330120,
					"content": "Bunu şu saniye uydurdun kesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330121,
					"content": "Neyse ne canım. Aşağıda ne var bilmiyorum ama bir gidip bakmalıyız bence. Maceraya boşuna mı atıldık sonuçta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330122
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330122,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330123
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330123,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} çok heyecanlandı. Şimdi aşağıya nasıl ineceğimizi bulalım bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
