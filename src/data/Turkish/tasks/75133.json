			"dialogs": [
				{
					"id": 751330301,
					"content": "#Açıldı! Harikasın {REALNAME[ID(2)|SHOWHOST(true)]}! Sen olmasan mekanizmayı hayatta bulamazdık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330302,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330303
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330303,
					"content": "#Başarabileceğini biliyordum {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330304
					]
				},
				{
					"id": 751330304,
					"content": "Yine de öyle galeyana gelme hemen. Önümüzde uzun bir yol var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330305,
					"content": "Geçidi bulduğumuza göre artık pes etmek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330306,
					"content": "Aynı fikirdeyim Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330307
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330307,
					"content": "Cik... Cik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330308
					],
					"speakerTitle": "Cocouik"
				},
				{
					"id": 751330308,
					"content": "Ne oldu? Neden gelmek istemiyorsun? Korktun mu yoksa? Yolculuğumuzu yarıladık bile, artık geri dönemeyiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330309
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751330309,
					"content": "Ku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330310
					],
					"speakerTitle": "Cocouik"
				},
				{
					"id": 751330310,
					"content": "Daha fazla zorlama Bona. Baksana, korkudan zangır zangır titriyor zavallıcık. Aşağıda büyük bir tehlike mi var acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330311,
					"content": "Benim de gözüm korktu doğrusu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330312
					]
				},
				{
					"id": 751330312,
					"content": "#Sen ciddi misin? Acilen kendine gelmen lazım, {REALNAME[ID(2)|SHOWHOST(true)]} gibi cesur ol!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330313,
					"content": "Heyecanlanmaya başladım bile ben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330314
					]
				},
				{
					"id": 751330314,
					"content": "Paimon bu kadar gaza geleceğini de düşünmemişti doğrusu. Hoş, karşımıza çıkabilecek her şeyi ezer geçersin gerçi sen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330315,
					"content": "Merak etme, bizim minik Sürüngenimiz çok cesurdur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751330316
					]
				},
				{
					"id": 751330316,
					"content": "Rarr... Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330317
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751330317,
					"content": "Coco o kadar korktuysa onu gelmeye zorlamayalım ama... Burada yalnız kalması da hoş olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751330318,
					"content": "Eh, başka yolu yok sanırım. Ben burada Coco'yla kalacağım. Ateş Fosforitini siz alabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751330319
					],
					"speakerTitle": "Bona"
				},
				{
