						201031205
					]
				},
				{
					"id": 201031205,
					"content": "Notlarımı takip ettiğine emin misin? Onlar da mı yanlıştı yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031206
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031206,
					"content": "Ben... Çok özür dilerim. Olduğumu düşündüğüm seviyeye gelememişim demek ki... Daha sıkı çalışmam gerek sanırım. Neyse, yardımın için teşekkürler. Çabalarının karşılığı olarak bunları al.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031207
					],
					"speakerTitle": "Ella Musk"
				},
				{
