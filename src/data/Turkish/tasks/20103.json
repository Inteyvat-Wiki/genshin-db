			"dialogs": [
				{
					"id": 201031501,
					"content": "Dağ yabanileri şiirlerimi beğenecek mi acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031502,
						201031509,
						201031515
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031502,
					"content": "Dağ yabanisi dilinde şiir yazarken nereden ilham aldın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031503
					]
				},
				{
					"id": 201031503,
					"content": "Açıkçası dil becerilerimi geliştirmek için yazdım. Belirli dil bilgisi kuralları, cümle yapıları, kelimelerin söz dizimi gibi daha tam anlayamadığım kısımlar var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031504
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031504,
					"content": "Bu mısraları yazarken gece gündüz çalıştım ama kim bilir... Ana dili olan biri için akıcı ve doğal gelmeyebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031505
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031505,
					"content": "Bazen yanlış bir sözcük seçtiğinde anlamı tam vermiyor ve sonra bütün cümlenin anlamı değişiyor. Böyle ince ayrıntıları öğrenmenin tek yolu gerçek bir dağ yabanisiyle konuşmak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031506
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031506,
					"content": "Çoğu insan dağ yabanisi dilini direkt dağ yabanilerinden öğrenme fikrine sıcak bakmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031507
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031507,
					"content": "Ancak ben bu fikirde değilim. Dağ yabanisi dilinde ustalaşmayı ve kültürlerini anlamayı kafaya koydum, bunu yapmam gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031508
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031508,
					"content": "Mondstadt'ın dağ yabanileriyle şiir yoluyla iletişim kurmaktan daha uygun ne olabilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031509,
					"content": "Bu yorumlar ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031510
					]
				},
				{
					"id": 201031510,
					"content": "En sondakiler mi? Şey... Şiirlerde kullandığım kelimeleri daha önce başka metinlerde gördüm de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031511
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031511,
					"content": "Cümleleri bir araya getirirken her kelimenin orijinal kullanımına uydurmak için elimden geleni de yaptım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031512
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031512,
					"content": "Ancak diller çok karmaşık. Bazen çok basit görünen bir kelime bile belli bağlamda kullanıldığında tüm cümlenin anlamını değiştirebiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031513
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031513,
					"content": "Neyse. Bu kıtalara anlaşılırlık açısından diğerlerinden daha çok güveniyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031514
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031514,
					"content": "Diğer kıtaları ben yazdım ama konuştuğumuz dile nasıl çevireceğimi bilmiyorum. Onlarla uğraşmana gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031515,
					"content": "Aşağı yukarı çözdün sanırım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031516
					]
				},
				{
					"id": 201031516,
					"content": "Yani... \"Aşağı yukarı\" hâlâ \"tamamen\" çözmekten çok uzak. Bir dağ yabanisiyle arkadaşça iletişim kurmayı hedeflememe rağmen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031517
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031517,
					"content": "Yanlış bir kelime kullansam bana kendimi açıklama şansı vereceklerinden şüpheliyim. Daha çok sinirlenirler ve oradan sağ salim dönemem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031518
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031518,
					"content": "Bu sebeple sen burada devreye giriyorsun! Hehehe. Sana bir şey olmaz, gerçekten! Notlarımı takip et yeter, hiçbir sorun yaşamazsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031519
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031519,
					"content": "Neredeyse hiçbir sorun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
