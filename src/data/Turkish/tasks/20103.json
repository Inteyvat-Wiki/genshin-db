				},
				{
					"id": 201031102,
					"content": "Evet, okudum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031103
					]
				},
				{
					"id": 201031103,
					"content": "Nasıl karşıladılar? Görünüşe göre iyi geçti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031104
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031104,
					"content": "Çok iyi geçti hem de!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201031105
					]
				},
				{
					"id": 201031105,
					"content": "Yani kelimelerin anlamlarını doğru anlamışım. Harika haber!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031106
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031106,
					"content": "Bu bizi Dağ Yabanisi Dil Biliminde bir adım ileriye taşıdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031107
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031107,
					"content": "Bir gün dağ yabanileriyle gönlümce konuşabileceğim ve paylaşmak istedikleri sırlarını direkt onların ağzından dinleyeceğim. O gün geldiğinde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031108
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031108,
					"content": "Musk soyadına yaraşır bir hayat sürdüğümü söyleyebileceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201031109
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201031109,
					"content": "Ama hepsinden önce, bu senin için. Çok teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
