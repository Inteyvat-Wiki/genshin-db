			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ella Musk"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201030101,
					"content": "Seni tekrar görmek güzel! Beni hatırlıyorsun, değil mi? En azından dağ yabanileriyle arkadaş olmaya çalıştığımızı hatırlıyorsundur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030102
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030102,
					"content": "Bana öyle bakma... Dil öğrenmenin doğası böyle. Sürekli alıştırma yapmalısın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030103
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030103,
					"content": "Çaban boşa gitmedi, için rahat olsun! Dağ yabanisi dilini konuşma becerim o günden beri şaşırtıcı bir hızla gelişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030104
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030104,
					"content": "Ancak dağ yabanisi dili yazma becerimi de iyi bir seviyeye getirmem gerekti. Yani, yoğun bir araştırma dönemi sonunda, dağ yabanisi dilinde şiirler yazdım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030105
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030105,
					"content": "Bununla beraber, hâlâ emin olamadığım birkaç mısra var. Anlamlarını kontrol etmem lazım... Benim için gidip bu mısraları test eder misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030106,
						201030111
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030106,
					"content": "\"Mısraları test etmek\" mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201030107
					]
				},
				{
					"id": 201030107,
					"content": "Ya, işte şey... Bir dağ yabanisine sesli oku ve nasıl tepki gösterdiklerine bak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030108
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030108,
					"content": "Merak etme! Anlamından tam emin olamadığım mısraları <color=#00E1FFFF>işaretledim</color>. Anlamdan o kadar uzak değillerdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030109
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030109,
					"content": "Kafamda çoktan bir yer belirledim. Buradaki dağ yabanileri daha arkadaş canlısı gibiler. Anlamını çıkaramadığım mısraları okusan yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030110
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030110,
					"content": "Yardımın için teşekkürler! Şiiri okuduktan sonra buraya dön, her şeyi bilmek istiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030111,
					"content": "Dağ yabanilerine okumak mı? Yine mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201030112
					]
				},
				{
					"id": 201030112,
					"content": "Aynen öyle! Nasılsa bu konuda tecrübelisin. Merak etme! Anlamından tam emin olamadığım mısraları <color=#00E1FFFF>işaretledim</color>. Anlamdan o kadar uzak değillerdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030113
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030113,
					"content": "Kafamda çoktan bir yer belirledim. Buradaki dağ yabanileri daha arkadaş canlısı gibiler. Anlamını çıkaramadığım mısraları okusan yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030114
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030114,
					"content": "Yardımın için teşekkürler! Şiiri okuduktan sonra buraya dön, her şeyi bilmek istiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201030115
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 201030115,
					"content": "Şey, planladığımız gibi gitmezse eminim sorunu çözmekte zorlanmazsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
		},
