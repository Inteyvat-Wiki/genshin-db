			"dialogs": [
				{
					"id": 756710101,
					"content": "Cik cik! Guk guk! Cik cik cik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710102
					],
					"speakerTitle": "Beşinci Basima"
				},
				{
					"id": 756710102,
					"content": "Iı... Burada neler oluyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710103,
						756710104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756710103,
					"content": "Bir tür... Gizli mesaj mı gönderiyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710105
					]
				},
				{
					"id": 756710105,
					"content": "Bir bakıma! Sevimli küçük serçelerle iletişim kurmak için kullandığım bir teknik bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710106
					],
					"speakerTitle": "Beşinci Basima"
				},
				{
					"id": 756710106,
					"content": "Ah, sizlere merhaba demeyi ve çok önemli açılış cümlemi söylemeyi unuttum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710107
					],
					"speakerTitle": "Beşinci Basima"
				},
				{
					"id": 756710107,
					"content": "Kıymetli Gezginler, ben Beşinci Basima, Amurta Araştırmacısı, yükselen ticaret yıldızı ve sevimli hayvanlar uzmanı, size içten selamlarımı sunarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710108
					],
					"speakerTitle": "Beşinci Basima"
				},
				{
					"id": 756710108,
					"content": "Lütfen gevşeyin, zihninizi boşaltın ve beni dikkatle dinleyin çünkü sizlere çok önemli bir şey söyleyeceğim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710109
					],
					"speakerTitle": "Beşinci Basima"
				},
				{
					"id": 756710109,
					"content": "\"Serçeler kadar sevimlisi yok\" mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756710110,
					"content": "Kesinlikle doğru! Tebrikler, Serçenin sevimliliği seni de etkilemiş anlaşılan. Cevap vermek için hemen atladın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710111
					],
					"speakerTitle": "Beşinci Basima"
				},
				{
					"id": 756710111,
					"content": "Çok tuhaf. Paimon sebebini bilmiyor ama masadaki oyunu görünce aklına bu cümle geliverdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756710112,
					"content": "#Sana da tanıdık geldi mi {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710113,
						756710115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756710113,
					"content": "Onunla daha önce tanışmıştık, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710114
					]
				},
				{
					"id": 756710114,
					"content": "Haklısın! Ve kısa bir rastlantı da değildi. İkinizi de yeniden bu kadar hayat dolu görmek içimi ısıtıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710117
					],
					"speakerTitle": "Beşinci Basima"
				},
				{
					"id": 756710117,
					"content": "Neyse, oyunu denemek ister misiniz? Bu, üçüncü nesil \"Bam Güm Serçe Topu\" oyununun 17. sürümü!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710118
					],
					"speakerTitle": "Beşinci Basima"
				},
				{
					"id": 756710118,
					"content": "Bir yandan rahatlayıp oyunun tadını çıkarırken bir yandan küçük serçe ve ondan çok daha büyük olan Kadim Kızıl Tüylü Serçenin martılar karşısındaki zaferinin hikayesini dinleyeceksiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710119
					],
					"speakerTitle": "Beşinci Basima"
				},
				{
					"id": 756710119,
					"content": "Süper! Rahatlatıcı oyunların her zaman büyük hayranı olmuşuzdur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710120,
						756710121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756710120,
					"content": "Hadi oynayalım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710122
					]
				},
				{
					"id": 756710122,
					"content": "Pekala! Umarım kendinize en uygun oyun tarzını bulur ve bu benzersiz deneyimi yaşayabilirsiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Beşinci Basima"
				},
				{
					"id": 756710121,
					"content": "Oyun başlıyor! Oyun başlıyor!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710122
					]
				},
				{
					"id": 756710115,
					"content": "Dilersen \"serçeler kadar sevimlisi yok\" muhabbetine başlayabiliriz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710116
					]
				},
				{
					"id": 756710116,
					"content": "Aynen! Hem geçmişi hemen hatırlayamasan da sorun değil. Önemli olan şu anın tadını çıkarman...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756710117
					],
					"speakerTitle": "Beşinci Basima"
				},
				{
					"id": 756710104,
					"content": "Ya da bir çeşit... Şifreyle mi konuşuyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756710105
					]
				}
			]
		}
	]
}