				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 721411601,
					"content": "(Burası sıradan bir tapınağa benziyor. Etrafta sıra dışı bir element izi yok gibi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411602
					],
					"speakerTitle": "Yabancılar Tapınağı"
				},
				{
					"id": 721411602,
					"content": "Saygılarını sunmaya devam et",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411603
					]
				},
				{
					"id": 721411603,
					"content": "(Dalgaların kayalıklara vuran sesini duyuyorsun. O çağlayan ses, insanları deniz ile gökyüzünün buluştuğu yere bakmaya itiyor. Dinlemeye çalışıyorsun ama bir şey olmuyor.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yabancılar Tapınağı"
				}
			]
		},
		{
			"id": 7214117,
			"completionStepIds": [
				7214108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
