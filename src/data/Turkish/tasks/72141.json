			"dialogs": [
				{
					"id": 721410101,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410102,
						721410103
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410102,
					"content": "Merhaba. Bakar mısın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410105
					]
				},
				{
					"id": 721410105,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410106
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410106,
					"content": "Beni duyuyor musun sen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410107
					]
				},
				{
					"id": 721410107,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410108,
						721410109
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410108,
					"content": "Merhaba. Bakar mısın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410110
					]
				},
				{
					"id": 721410110,
					"content": "... Beni lütfen rahatsız etme artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410111
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410111,
					"content": "\"O\" çok mutsuz. \"O\" \"kalbin sözlerini\" bastıran \"dilin sözlerinin\" verdiği rahatsızlıktan hiç hoşnut değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410112
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410112,
					"content": "\"Dilin sözleri\" mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410113
					]
				},
				{
					"id": 721410113,
					"content": "\"Dilin sözleri\" yağan yağmur gibidir. Kulaklarına zarar verir ve kalbini altüst eder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410114
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410114,
					"content": "\"Kalbin sözleri\" sis gibidir. Kolayca sızıp etrafını sarar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410116
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410116,
					"content": "Sessiz! \"O\" dinliyor. \"O\" konuşuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410117
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410117,
					"content": "Dilini kullanma. Kulaklarını kullanma. Kalbinle dinle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410118
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410118,
					"content": "Gel buraya. Tapın. Dua et. Ve dinle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410119
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410119,
					"content": "Unutma, üç kere tapın. Üç kere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410120,
						721410121
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410120,
					"content": "(Bir dene.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721410121,
					"content": "Yok ben almayayım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721410109,
					"content": "Konuşabiliyorsan başını salla.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410110
					]
				},
				{
					"id": 721410103,
					"content": "Ne yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410105
					]
				}
			]
		},
