			"dialogs": [
				{
					"id": 721410701,
					"content": "\"Onun\" büyük lütuflarının yanında bu küçük bir ödül.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410702
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410702,
					"content": "Dua et. Tapın. \"Onu\" dinle ve \"onun\" seni dinlemesine izin ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410703
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410703,
					"content": "İşte o zaman sen de benim gibi \"onun\" sözlerinin kendi kalbinden geldiğini duyacaksın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410704
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410704,
					"content": "O zaman \"o\" seni acından kurtaracak ve sana büyük bir ödül verecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410705,
						721410706
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410705,
					"content": "Şey...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410707
					]
				},
				{
					"id": 721410707,
					"content": "Unutma. Günde üç kere tapınırsan ödüllendirileceksin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410708
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410708,
					"content": "Unutma, unutma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410706,
					"content": "Sen nasıl diyorsan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410707
					]
				}
