				},
				{
					"id": 721410607,
					"content": "Neden bahsettiğinin farkında mısın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410609
					]
				},
				{
					"id": 721410609,
					"content": "Buraya bir dahaki gelişinde kendin görürsün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410608,
					"content": "Yüzeyselliğimi bağışla ama seni anlamıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410609
					]
				},
				{
