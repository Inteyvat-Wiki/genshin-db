			},
			"dialogs": [
				{
					"id": 721411101,
					"content": "Tapın, dinle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411102
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411102,
					"content": "\"O\" güçlü çünkü \"o\" dinliyor. \"O\" her şeyi görüp duyuyor çünkü \"o\" güçlü. Bu yüzden \"o\" her şeyi görüyor. Her şeyi duyuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411103
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411103,
					"content": "Ne Sangonomiya'daki aptallar ne de Narukami Adası'ndaki deliler anlıyor, hissediyor. O yüzden bildikleri tek şey birbirleriyle savaşmak ve akan kanın gözlerini kör etmesine izin vermek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411104
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411104,
					"content": "Ama bunu anlamalısın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411105,
						721411106
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411105,
					"content": "Bu çok saçma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411107
					]
				},
				{
					"id": 721411107,
					"content": "Cevap tapınmakta yatıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411108
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411108,
					"content": "Unutma. Günde üç kere tapınırsan ödüllendirileceksin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411106,
					"content": "Aşağı yukarı anladım sayılır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411107
