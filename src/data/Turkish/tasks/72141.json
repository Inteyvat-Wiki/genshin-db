			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Washizu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721411701,
					"content": "\"Onu\" sakinleştirmeliyiz. \"Onun\" öfkesi dindirilmeli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411702
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411702,
					"content": "İyi iş çıkardın! Çok iyi iş çıkardın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411703
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411703,
					"content": "Unutma, bazıları seni maskelerle kandırmaya çalışacak ama \"o\" sana yardım edecek. \"O\" her zaman sana yardım edecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411704,
						721411705
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411704,
					"content": "Hım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411706
					]
				},
				{
					"id": 721411706,
					"content": "O kadın efsanede anlatılan Kitsune iblisleri gibi. Gitmesine ben izin verdim. \"O\" çok sinirli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411707
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411707,
					"content": "\"O\" tekrar sinirlendi... Bu benim günahım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411708
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411708,
					"content": "Lütfen beni affet... Tekrar feda edeceğim. \"Dönenler\" için feda edecek bir şey bulacağım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411709
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411709,
					"content": "Lütfen affet beni, lütfen affet beni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411710
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411710,
					"content": "Lütfen affet beni, lütfen affet beni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411705,
					"content": "Tamam öyleyse...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411706
					]
				}
			]
		},
