			"dialogs": [
				{
					"id": 721411801,
					"content": "Gelmişsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411802
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411802,
					"content": "Nasılsın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411803
					]
				},
				{
					"id": 721411803,
					"content": "Günahlarımı affettiğin için teşekkür ederim. Lütfen sana dönmeme izin ver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411804
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411804,
					"content": "Benimle mi konuşuyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411805
					]
				},
				{
					"id": 721411805,
					"content": "Ne... Ama neden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411806
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411806,
					"content": "Her feda edilen şeyin başında durdum ve senin her lütfunu kabul ettim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411807
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411807,
					"content": "Ama senin damgaladığın, senin ellerin ile var olan kadın senin lütuflarından kaçtı. Bize ihanet etti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411808
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411808,
					"content": "Neden bahsediyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411809
					]
				},
				{
					"id": 721411809,
					"content": "Ah! Üzgünüm... Üzgünüm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411810
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411810,
					"content": "\"Onun\" seçimini sorgulamamalıyım. Dayanmaya devam et, tapınmaya devam et...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411811
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411811,
					"content": "Beni duyabiliyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721411812
					]
				},
				{
					"id": 721411812,
					"content": "Dayanmaya devam et... Tapınmaya devam et...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721411813
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721411813,
					"content": "Dayanmaya devam et... Tapınmaya devam et...",
					"roleType": "TALK_ROLE_NPC",
