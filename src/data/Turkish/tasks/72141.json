			"dialogs": [
				{
					"id": 721410601,
					"content": "Nasıldı? \"Onun\" bilgeliğini duyma şansı yakalayabildin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410602,
						721410603
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410602,
					"content": "Hiçbir şey duymadım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721410604
					]
				},
				{
					"id": 721410604,
					"content": "Sorun değil. Sorun yok. \"O\" görüyor. \"O\" duyuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410605
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410605,
					"content": "\"O\" rahat ve \"ondan\" memnun olanlar ödüllendirilecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410606
					],
					"speakerTitle": "Washizu"
				},
				{
					"id": 721410606,
					"content": "\"Onun\" ödülü uzakta bir yerlerde değil. Yarın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721410607,
