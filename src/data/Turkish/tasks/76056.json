			"dialogs": [
				{
					"id": 760560601,
					"content": "Yoldan geçen birine üst üste üç kere yenildiğime inanamıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560602
					],
					"speakerTitle": "Incali"
				},
				{
					"id": 760560602,
					"content": "Yok yok, sen ve ben ikişer kez kaybettik, patron da sadece bir kez kaybetti. O kadar da kötü değil yani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560603
					],
					"speakerTitle": "Bielov"
				},
				{
					"id": 760560603,
					"content": "#Heh! Yenilgi yenilgidir, üzerine düşünmenin anlamı yok. {NICKNAME} gerçekten bambaşka bir boyutta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560604
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560604,
					"content": "İkiniz de en şanslı gününüzde bile beni yenemezsiniz. Şimdi gerçek bir ustayı iş başında seyrettiniz. Gördünüz mü? Daha kırk fırın ekmek yemeniz lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560605
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560605,
					"content": "Bana gelirsek... Belki de erken emekliliği düşünme zamanım gelmiştir. Acaba Vaino'nun talim kampı hâlâ eleman arıyor mudur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Terho"
				}
			]
		},
