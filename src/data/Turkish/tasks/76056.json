			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Terho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560201,
					"content": "Sadece birkaç raunt mu? İstediğiniz kadar devam edebilirim ben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560202
					]
				},
				{
					"id": 760560202,
					"content": "Haha, işte bu! Gerçek dövüşçüler arasında sağlam bir dövüşten daha iyisi var mı? Bielov, misafirimizle birkaç raunt kapışmaya ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560205
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560205,
					"content": "Tabii patron! Gör bak, üç hamlede bitireceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bielov"
				}
			]
		},
		{
			"id": 7605603,
