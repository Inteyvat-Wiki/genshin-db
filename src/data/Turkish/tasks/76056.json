			"dialogs": [
				{
					"id": 760560101,
					"content": "Selam dostum! Bütün gün hedef mi vuruyorsun? Bu biraz sıkıcı olmuyor mu? Becerikli duruyorsun, bizimle birkaç raunt kapışmaya ne dersin?",
					"roleType": "TALK_ROLE_NPC",
