				"objectNames": [
					"Terho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560401,
					"content": "Ö-özür dilerim patron... Herkesi hayal kırıklığına uğrattım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560402
					],
					"speakerTitle": "Bielov"
				},
				{
					"id": 760560402,
					"content": "Önemli değil, alt tarafı eğleniyoruz burada. Bielov, git kenarda biraz nefeslen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560403
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560403,
					"content": "Harika numaraların var dostum! Ben Terho, tanıştığımıza sevindim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560404
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560404,
					"content": "#Ben {NICKNAME}. Tanıştığıma memnun oldum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560405
					]
				},
				{
					"id": 760560405,
					"content": "Gerçek savaşta epey tecrübeli olduğun belli oluyor. Sanırım işini biraz daha zorlaştırmamız gerekecek. Son raunt sayılmaz, hadi bir tur daha dövüştürelim seni! Incali, sıra sende!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560406
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560406,
					"content": "Hıh, sen de beni anca başın belaya girdiğinde hatırlıyorsun patron... Neyse. Hadi bakalım becerikli dostum, dövüşe başlayalım mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Incali"
				}
			]
		},
		{
			"id": 7605605,
			"completionStepIds": [
				7605603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
