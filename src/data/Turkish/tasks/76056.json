			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Terho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760560501,
					"content": "B-Ben... Yoldan geçen birine kaybetmiş olamam... B-Bu gerçek olamaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560502
					],
					"speakerTitle": "Incali"
				},
				{
					"id": 760560502,
					"content": "Demek Incali bile kazanamadı... Seni fazla hafife almışım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560503
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560503,
					"content": "Senin hatan değil patron. Bu kadar kuvvetli birinin tesadüfen buradan geçeceği kimin aklına gelirdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560504
					],
					"speakerTitle": "Bielov"
				},
				{
					"id": 760560504,
					"content": "Patron! Kaçmalarına izin veremeyiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560505
					],
					"speakerTitle": "Incali"
				},
				{
					"id": 760560505,
					"content": "Oo, niyetiniz sadece dövüşmek değil anlaşılan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560506
					]
				},
				{
					"id": 760560506,
					"content": "Yanlış anlamayın. Incali'nin demeye çalıştığı... Bu şekilde yenilgiyi kabullenemeyiz. Hazine avcıları olarak korumamız gereken bir itibarımız var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560507
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560507,
					"content": "#{NICKNAME}, sana resmi olarak meydan okuyorum. Bu sefer sadece eğlencesine değil. Tüm gücümüzle savaşalım ve elimizden geleni ardımıza koymayalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760560508
					],
					"speakerTitle": "Terho"
				},
				{
					"id": 760560508,
					"content": "O zaman biriniz değil, hepiniz gelin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560509
					]
				},
				{
					"id": 760560509,
					"content": "Tamam, kendimizi tutmayacağız yalnız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Terho"
				}
			]
		},
		{
			"id": 7605606,
