			},
			"dialogs": [
				{
					"id": 760560301,
					"content": "Özür dilerim, halletmem gereken başka işler var...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760560302
					]
				},
				{
					"id": 760560302,
					"content": "Sorun değil. Zaten sadece vakit öldürüyoruz. Müsait olduğunda ya da sıkıldığında gelip bizi bulabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Terho"
				}
			]
		},
		{
			"id": 7605604,
			"completionStepIds": [
				7605602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
