			"dialogs": [
				{
					"id": 761700301,
					"content": "Başka bir efsaneye göre Gece Çiçeğinin zıt renkleri, Donuk Ayın Çocuklarından iki kız kardeşi temsil ediyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700302
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700302,
					"content": "Onlar da mı birbirlerini öldürüyorlar? Fark ettim de birçok hikayede kardeşler en sonunda birbirini öldürüyor. Neden öyle ki? Deniz Kabuğu Çetesinde biz hiç böyle değiliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700303
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761700303,
					"content": "Hey, bırakın da Linnea hikayeyi bitirsin. Kız kardeşler hikayenin sonunda kesin barışıyordur, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700304
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761700304,
					"content": "Yoksa insanlar neden onları temsilen iki çiçeği birbirine bağlı olan Gece Çiçeğini kullansın ki? Umarım sonunda barışıyorlardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maisie"
				}
			]
		},
