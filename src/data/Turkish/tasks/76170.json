			"dialogs": [
				{
					"id": 761700101,
					"content": "Sadece Mehtap Böcekleri olmadığına inanamıyorum... Kediler bile yeniyormuş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700102
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761700102,
					"content": "Şey, Jurva... Bir dahakine Pavlov'u yürüyüşe çıkardığında gözünü üzerinden ayırma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700174
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761700174,
					"content": "Bu kadar endişelenmene gerek yok! Pavlov bir kediden çok daha büyük. Üstelik alt tarafı birkaç bitki hepsi. En kötü ne yapabilirler ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700103
					],
					"speakerTitle": "Jurva"
				},
				{
					"id": 761700103,
					"content": "Yanlış hatırlamıyorsam yeni yetme bir maceracı da benzer bir şey söylemişti, tam da bir Heksadekatonik Mandragorayla karşı karşıya gelmeden önce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700104
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700104,
					"content": "Şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700105
					],
					"speakerTitle": "Jurva"
				},
				{
					"id": 761700105,
					"content": "Heksadekatonik Mandragora... Süper!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700106
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761700106,
					"content": "Ya-ho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700107
					],
					"speakerTitle": "Lumi"
				},
				{
					"id": 761700107,
					"content": "N-Ne diye bağırıp duruyorsunuz? Paimon gürültünüzü kilometrelerce öteden duydu! Ders mi veriliyor burada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761700108,
					"content": "Evet, aynen öyle! Linnea bize son bulgularını anlatıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700109
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761700109,
					"content": "E güzelmiş. Biz de katılabilir miyiz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700110
					]
				},
				{
					"id": 761700110,
					"content": "Elbette! Buyurun, oturun lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700111
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700111,
					"content": "Hazır konu Heksadekatonik Mandragoralardan açılmışken, Issız Deniz Tepesi yakınlarında bulunabilen başka bir önemli bitki türü daha var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700112
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700112,
					"content": "Kış Buzotunu diyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700113
					],
					"speakerTitle": "Jurva"
				},
				{
					"id": 761700113,
					"content": "Aynen! Kış Buzotundan bahsediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700114
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700114,
					"content": "Hile yapıyorsun Jurva! Linnea daha sorusunu bitirmemişti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700115
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761700115,
					"content": "Ha, pardon... Kendimi kaptırıp aceleci davrandım. Ama merak etme, cevaplanacak daha bir sürü soru olacak, değil mi Linnea?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700116
					],
					"speakerTitle": "Jurva"
				},
				{
					"id": 761700116,
					"content": "Herkese yetecek kadar var! Cevaplarınızı hazırlayın, hepinizin şeker heykelcik kazanma şansı olacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700117
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700117,
					"content": "#Aaa, tatlı mı tatlı bir ödül! Hadi {NICKNAME}, tam bizlik iş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700118,
						761700119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761700118,
					"content": "Çocuklar diye torpil geçmem yalnız!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700122
					]
				},
				{
					"id": 761700122,
					"content": "Pekala! Konumuza dönelim... Aslında Kış Buzotu hakkında ilginç bir hikaye var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700123
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700123,
					"content": "Efsaneye göre bu bitkinin \"Kış Buzotu Kralı\" ile derin bir bağı varmış. \"Kış Buzotu Kralı\"nın bir erkek kardeşi varmış, onun sembolik bitkisi de hepinizin çok iyi bildiği bir bitki... Ne olduğunu söyleyebilecek var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700124,
						761700127,
						761700130
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700124,
					"content": "... Tatlı Çiçekler mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700125
					]
				},
				{
					"id": 761700125,
					"content": "Hımm, Paimon onları biliyor! Ama muhtemelen doğru cevap değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761700126,
					"content": "Yanlış! Doğru cevap Yazdönümü Böğürtlenleri olacaktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700132
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700132,
					"content": "Yazdönümü Böğürtlenleri! Tek bildiğim hem Katya'nın hem de Aino'nun çok lezzetli bir Yazdönümü Pastası yapabildiği...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700133
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761700133,
					"content": "Yazdönümü Böğürtlenleri, \"Kış Buzotu Kralı\"nın kardeşi olan \"Yazdönümü Meşesi Kralı\"nın sembolüdür. Efsaneye göre bu ikiz kardeşler, doğumlarından beri savaşıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700134
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700134,
					"content": "Sırayla birbirlerini öldürüp sonra yeniden diriliyorlar. Her biri kendi mevsimine hükmediyor ve bu ölüm ile yeniden doğuş döngüsü zamanın sonuna kadar sürüp gidiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700135
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700135,
					"content": "Ne kadar üzücü... Aralarında kan bağı olmasına rağmen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700136
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761700136,
					"content": "Katya bir keresinde bana iyi bir ilişkinin kan bağıyla ilgisi olmadığını söylemişti. Hatta bazen çatışmaların çıkmasına neden olan da tam olarak bu bağlarmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700137
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761700137,
					"content": "Bu hikaye mevsimlerin değişimiyle ilgili, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700138
					]
				},
				{
					"id": 761700138,
					"content": "Çok zekisin! Evet, doğru. Snezhnaya'daki alimler de bu hikayenin tam olarak onu temsil ettiğini düşünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700139
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700139,
					"content": "Dahası, Kış Buzotu dayanıklılığı ve soğuğa karşı direnci nedeniyle aynı zamanda Işık Muhafızlarının da bir sembolü olarak kabul edilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700140
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700140,
					"content": "\"Çiçek solsa da...\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700141
					]
				},
				{
					"id": 761700141,
					"content": "\"Yapraklar sözünü tutar.\" Paimon bu sözü daha önce duymuştu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761700142,
					"content": "Bu çok eski bir deyiştir, günümüzde neredeyse kimse kullanmaz. Bunu biliyor olmanıza şaşırdım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700143
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700143,
					"content": "Hehe, bizler tecrübeli maceracılarız, yani aynı zamanda... Nasıl deniyordu ya? Hah evet, \"çok gezip çok okuyan\" kimseleriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761700144,
					"content": "Işık Muhafızları... Şu siyahlara bürünenlerdi onlar, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700145
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761700145,
					"content": "Onlar da soğuğa karşı dayanıklı ve dirençli mi? Gerçi kıyafetleri çok sıcak tutuyor gibi... Eğer gerçekten o kadar dirençlilerse biraz daha hafif giyinemezler mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700146
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 761700146,
					"content": "Karıştırıyorsun bence. Linnea Abla'nın demek istediği şey şu, Işık Muhafızları da tıpkı Kış Buzotu gibi dondurucu rüzgar kadar şiddetli zorluklar karşısında dimdik durur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700147
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761700147,
					"content": "Harikasın! Tam yerinde bir yorum yaptın ama sormak istiyorum, bu fikre nasıl vardın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700148
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700148,
					"content": "Hehe, Helka bana ta Fontaine'den bir el kitabı gönderdi. Bana çiçeklerin dilinden ve Fontaine'deki tüm çiçeklerin kendilerine özgü gizli anlamları olduğundan bahsetti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700149
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761700149,
					"content": "Bence Kış Buzotunun bir anlamı olsaydı... \"Sarsılmazlık\" ya da belki \"sonuna kadar dayanma cesareti\" gibi bir şey olabilirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700150
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761700150,
					"content": "Bak sen, anlaşılan birileri çıkarım yapmayı öğrenmiş. Aferin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700151
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700151,
					"content": "Mikko... Sen olaya çok daha farklı bir açıdan yaklaşmış olabilirsin ama mantık anlayışın kesinlikle çok ilginç!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700152
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700152,
					"content": "Aa, Linnea Hanım, peki ya Paimon'la ben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700153
					]
				},
				{
					"id": 761700153,
					"content": "Hımm, bakalım sıradaki soruyu cevaplayabilecek misiniz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700154
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700154,
					"content": "#Gönder gelsin! {NICKNAME} için zor soru diye bir şey yoktur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700155
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761700155,
					"content": "Kendinize o kadar güveniyorsunuz demek! Öyleyse en zor sorularımdan birini soracağım. Gece Çiçekleri neden hem kırmızı hem de mavi renklerde olur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700156,
						761700158
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700156,
					"content": "\"Güller kırmızıdır, menekşeler mavi\" diye mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700157
					]
				},
				{
					"id": 761700157,
					"content": "Şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700160
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761700160,
					"content": "Peki... O zaman cevap ne? Nod-Krai'da gördüğümüz kırmızı ve mavi tek şeyler Gece Çiçekleri değil. Şöyle bir düşününce her yerde kırmızı ve mavi şeyler gördük!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700161
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761700161,
					"content": "Eğer Nod-Krai ile ilgili en çok göze çarpan şeyi soruyorsan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700162
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761700162,
					"content": "Kuuvahkilerin olağanüstü gücü olmalı!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700163
					]
				},
				{
					"id": 761700163,
					"content": "Hey! Her şeyi \"Kuuvahkilerin gücü\" diyerek geçiştirmeye çalışma! Cevabın bu kadar bariz olmasına imkan yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700164
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761700164,
					"content": "Doğru bildin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700165
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700165,
					"content": "Ya-hoho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700166
					],
					"speakerTitle": "Lumi"
				},
				{
					"id": 761700166,
					"content": "Ne? Cidden mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700167
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761700167,
					"content": "Nod-Krai'da yaşayan herkes bunu bilir ama uzaklardan gelen maceracılar genelde bilmez. Dolayısıyla zorlayıcı bir soru olarak kabul edilebilir sanırım, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700168
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700168,
					"content": "Ama sen bu sorunun tuzağına düşmedin. Anlaşılan kusursuz bir maceracı olma yolundasın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700169
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700169,
					"content": "Pekala, bugünlük bu kadar soru yeter. Soru cevaplayan tüm öğrenciler birer şeker heykelcik alabilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700170
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700170,
					"content": "Hı? Bir dakika! Sakın bir tek Paimon'un şekerleme alamayacağını söyleme! Bilseydi daha çok soru cevaplardı... Gerçi muhtemelen hepsini yanlış cevaplardı ama olsun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700171
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761700171,
					"content": "#Merak etme, sen de alacaksın! Tıpkı Lumi'yle benim gibi, {NICKNAME} ile sen de bir takımsınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700172
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700172,
					"content": "Ne güzel, değil mi Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700173
					]
				},
				{
					"id": 761700173,
					"content": "Vay canına, Linnea gerçekten de dünyanın en iyi öğretmeni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761700158,
					"content": "İnsan yapımı oldukları için mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700159
					]
				},
				{
					"id": 761700159,
					"content": "Sıra dışı bir cevap! Ama maalesef... Doğru değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700160
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700127,
					"content": "Nane olmalı!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700128
					]
				},
				{
					"id": 761700128,
					"content": "Mantıklı! Nane de Kış Buzotu da yeşil... Bu da demek oluyor ki Lahana da yakın akrabası olmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761700129,
					"content": "Yanlış! Doğru cevap Yazdönümü Böğürtlenleri olacaktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700132
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700130,
					"content": "Acaba Yazdönümü Böğürtlenleri mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700131
					]
				},
				{
					"id": 761700131,
					"content": "Doğru! Cevap Yazdönümü Böğürtlenleri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700132
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700119,
					"content": "Çocukların elinden şekerlerini almak gibi olacak ama...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700120
					]
				},
				{
					"id": 761700120,
					"content": "Merak etmeyin, size bir sır vereyim... Katya herkese yetecek kadar şeker heykelcik hazırladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700121
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761700121,
					"content": "Ooo! Öyleyse onlara ne kadar zeki olduğumuzu göstermemiz gerekecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700122
					],
					"speakerTitle": "Paimon"
				}
			]
		},
