			"dialogs": [
				{
					"id": 766530401,
					"content": "Sonunda geldin. Ender bulunan bu ekstra iş fırsatını unutmadın, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530402
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530402,
					"content": "Bekle biraz, senin siparişin hangisiydi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530403
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530403,
					"content": "... Ben Gaudenty, Kuuvahki Deneysel Tasarım Bürosunun yabancı temsilcisiyim. Hatırlaman için bu kadarı yeterli olsa gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530404
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530404,
					"content": "Çok uzun, hiç duymadım. Siparişinin ayrıntılarını ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530405
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530405,
					"content": "Sen... Cık, sadece bir kere daha anlatacağım. Yakın zamanda bir grup keşif robotu kontrolden çıktı ve Tasarım Bürosundan uçup gitti. Benim görevim, bu başıboş dolaşan robotları geri getirmek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530406
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530406,
					"content": "Ama robotlar çok yükseğe uçuyor ve ben de onlarla tek başıma baş edemiyorum. Bu yüzden bu fırsatı sana sundum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530407
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530407,
					"content": "Açıkçası, onları ister alabilir ister bulundukları yerde yok edebilirsiniz. Amacımız sadece yabancıların eline geçmesini engel olmak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530408
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530408,
					"content": "Evet, o keşif robotları çok ama ÇOK yükseğe çıkabiliyor ve sıradan insanların onlara dokunması dahi mümkün değil. İşte ben de bu yüzden onlara ulaşabilmemizi sağlayan Ay Damarları yapmanın bir yolunu buldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530409
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530409,
					"content": "#Kuuhenkiden yardım alabilirsin, değil mi {NICKNAME}? Ay Damarlarını kullanarak keşif robotlarını indirebilecek miyiz bir bakalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530410
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530410,
					"content": "#Sorun değil! {NICKNAME} hemen halleder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530411,
						766530412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530411,
					"content": "Tabii ki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766530413
					]
				},
				{
					"id": 766530413,
					"content": "Ha bu arada, ödemeniz Mora ile olmayacak. Yerine robot parçalarını ödeme olarak alabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530414
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530414,
					"content": "Siparişi ilk verdiğimde bunu belirtmiştim. Aksi bir durumu kabul edemem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530415
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530415,
					"content": "... Ödeme olarak bize yedek parça mı vereceksin? Robotların yabancıların eline geçmemesi gerektiğini söylememiş miydin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530416,
					"content": "İşte tam da bu yüzden sizin için değerli bir fırsat bu! Her şey yolunda giderse emeklerinizin karşılığında bunu göz ardı edebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530417
					],
					"speakerTitle": "Gaudenty"
				},
				{
					"id": 766530417,
					"content": "Bu bana biraz tuhaf geldi, aslında bize ödeme yapmak istemiyor gibisin sanki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530418,
					"content": "Mora versin veya vermesin, umurumda değil. O parçaları istiyorum. Onları gelecekteki araştırma projelerimde kullanacağım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530419
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530419,
					"content": "Eh, senin için de sorun yoksa Aino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530412,
					"content": "Biraz zor görünüyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766530413
					]
				}
			]
		}
	]
