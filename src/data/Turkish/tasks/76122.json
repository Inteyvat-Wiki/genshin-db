			"dialogs": [
				{
					"id": 761220101,
					"content": "Columbina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220102,
					"content": "Hımm. Çok tuhaf. Paimon, Columbina'nın sesini duyduğuna emindi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220103,
					"content": "... Hiya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220104
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761220104,
					"content": "Aaaaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220105,
					"content": "Merhaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220106
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761220106,
					"content": "Yine korkuttun ama! Hiç hoş değil! Madem buradaydın, söyleseydin ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220107,
					"content": "Bu oyuna artık aşina olduğunuz için bu sefer zorluğu artırmalıyım diye düşündüm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220108
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761220108,
					"content": "Hıh! Paimon bir dahaki sefere senin hakkından gelecek, bekle sen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220109,
					"content": "Harika! Sabırsızlıkla bekliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220110
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761220110,
					"content": "Göz bandına ne oldu Columbina?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220111
					]
				},
				{
					"id": 761220111,
					"content": "Ah. Sanırım demin oynarken Kuuhenkiler aldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220112
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761220112,
					"content": "Genellikle gözlerimi kullanmaya ihtiyaç duymadığımdan bir şey fark etmiyor. Hoşlarına gidiyorsa oynasınlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220113
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761220113,
					"content": "Ha! Bu arada, daha sık dışarı çıkmak ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220114,
					"content": "Artık kimseden saklanmana gerek yok, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220115
					]
				},
				{
					"id": 761220115,
					"content": "Evet... Artık bolca vaktim var. Dilediğim yere, dilediğim zaman gidebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220116
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761220116,
					"content": "Ancak beni aramaya geldiğinizde veda etmeden gittiğimi görürseniz endişelenirsiniz diye düşündüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220117,
						761220118
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761220117,
					"content": "Öyle bir şey olursa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220119
					]
				},
				{
					"id": 761220119,
					"content": "Evet! İyi olduğunu bilmemiz yeter aslında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220120,
					"content": "Anlıyorum. O halde bunu düşüneceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220121
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761220121,
					"content": "Sadece \"düşünecek\" misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220122,
					"content": "Ya da belki de olmak istediğin yer tam olarak burasıdır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220123
					]
				},
				{
					"id": 761220123,
					"content": "Burada yaşanan her şey... Bence hepsi mutlu anılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220124
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761220124,
					"content": "Öte yandan burada sizi beklememin başka bir sebebi daha var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220125
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761220125,
					"content": "Neymiş o?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220126,
					"content": "Size hoş bir sürpriz yapmak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761220118,
					"content": "Bir not bırakabilirsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220119
					]
				}
			]
		},
