					"content": "Vay be! Bahsettiğin yer burası olmalı, değil mi? Paimon geçen sefer gelmemişti, o yüzden göremedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220402,
					"content": "Gerçekten de çok güzel.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220403
					]
				},
				{
					"id": 761220403,
					"content": "Paimon etrafta bir uçup bakabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220404,
					"content": "Tabii ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220405
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761220405,
					"content": "Eğer hoşunuza gittiyse sizi bir gün tekrar getirebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220406
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761220406,
					"content": "Demek \"hoş sürpriz\" bu, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220407,
					"content": "Hı? Senin gözünde \"hoş bir sürpriz\" olması için bu kadarı yeterli mi yani? Hayır, asıl sürprizi henüz görmediniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220408
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761220408,
					"content": "Dahası da mı var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220409
					]
				},
				{
					"id": 761220409,
					"content": "Gelin. Resim yapalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220410
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761220410,
					"content": "Bir dakika. Burada mı? Ama Paimon etrafta hiç tuval, fırça ya da boya göremiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220411,
					"content": "Ha. Çok basit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220412
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761220412,
					"content": "Su yüzeyi tuvalimiz, ay ışığı fırçalarımız ve yürüdüğümüz yollar da fırça darbelerimiz olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220413
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761220413,
					"content": "Ayın yansıması bize yol gösterirken saf düşünceler ayaklarımızın altından akacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Küçük Hanım"
				}
			]
		}
	]
}