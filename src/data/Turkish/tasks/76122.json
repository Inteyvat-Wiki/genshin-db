			"dialogs": [
				{
					"id": 761220201,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220202
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761220202,
					"content": "Luonnotar! Gerçekten sensin! Geri dönmüşsün! Gümüş gibi parlıyorsun! Paimon seni bir daha göremeyeceğini sanmıştı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220203,
					"content": "Çizdiğimiz resim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220204
					]
				},
				{
					"id": 761220204,
					"content": "Bu çocuğun formunu çizmek için ay ışığını kullandık, ben de içine yeni güç ve yeni lütuflar doldurarak onun yeniden doğmasını sağladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220205
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761220205,
					"content": "Artık benim ruhumu taşımak zorunda değil. Ruhu yalnızca ona ait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220206
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761220206,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220207
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761220207,
					"content": "Aa, geliyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220208,
					"content": "Evet. Birlikte geçirdiğiniz zamanlara dair tüm anıları uyandırdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220210
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761220210,
					"content": "... ! ... !",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220211
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761220211,
					"content": "*burnunu çeker* Paimon geri döndüğün için çok mutlu oldu Luonnotar. Bundan sonra sana daha iyi davranacağına söz veriyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220212,
					"content": "Paimon sürprizin bu kadar hoş olacağını beklemiyordu... Paimon buna bayıldı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761220213,
					"content": "Teşekkür ederiz Columbina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220214
					]
				},
				{
					"id": 761220214,
					"content": "Lafı bile olmaz. Ben de onu tekrar gördüğüm için mutluyum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220216
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761220216,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220217
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761220217,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220218
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761220218,
					"content": "(Hâlâ Luonnotar'a çok bağlı ama ifadesi öncekinden farklı.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220219
					]
				},
				{
					"id": 761220219,
					"content": "(Luonnotar'a yalnızca yaratılmış bir hizmetkar olarak değil, tanıdık bir dost gibi bakıyor.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761220220
					]
				},
				{
					"id": 761220220,
					"content": "Git hadi. Onları özlemişsindir mutlaka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220221
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761220221,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761220222
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761220222,
					"content": "Ne zaman isterseniz gelebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Küçük Hanım"
				}
			]
