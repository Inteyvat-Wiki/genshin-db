				{
					"id": 710981502,
					"content": "Merakımı mazur gör ancak bu yemeği... Bu yemeği nasıl yaptın? Yemek malzemelerinden tam olarak ne miktarda kullandın? Hangi baharatları nasıl kullandın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981503,
						710981504
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981503,
					"content": "H-Hey! Uzaklaş!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981505
					]
				},
				{
					"id": 710981505,
					"content": "Evet... Kusura bakma. O yemeği nasıl yaptığını bana tüm detaylarıyla anlatır mısın? Belki bu bana ilham verir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981506
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981506,
					"content": "Turplu Sebze Çorbasını nasıl yaptığını tüm detaylarıyla anlatıyorsun.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710981507
					]
				},
				{
					"id": 710981507,
					"content": "Anladım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981508
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981508,
					"content": "*iç çeker* Her yemeğin tadını belirleyen birçok değişken var. En doğru sonuca ulaşmak için çok fazla hesaplama yapılması gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981509
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981509,
					"content": "Daha fazla hesaplama yapabilmek için Numaralandırma Makinamı geliştirmeliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981510
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981510,
					"content": "Umarım Akademinin kütüphanesinde bana ilham verecek bir şeyler vardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981511
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981511,
					"content": "O değil de neden böyle bir makina yapmaya karar verdin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981512
					]
				},
				{
					"id": 710981512,
					"content": "Hımm... Güzel soru ama sorunu cevaplamadan önce ben de sana bir soru sormak istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981513
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981513,
					"content": "Sence Numaralandırma Makinasının kendi \"aklı\" var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981514,
						710981515
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981514,
					"content": "Ne demek istiyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981516
					]
				},
				{
					"id": 710981516,
					"content": "Aynen öyle. Lütfen önce bu soru üzerine düşün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981517
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981517,
					"content": "Sonraki görüşmemizde bu soru hakkında konuşabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981518
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981518,
					"content": "İlk olarak bazı verileri düzenlemeliyim... Hadi Lutong, başlayalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981519
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710981519,
					"content": "Emredersiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981520
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710981520,
					"content": "Ah evet, lütfen bunları kabul et iyi kalpli Gezgin. Sen Bay Garcia'ya bakma. O böyledir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981521
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710981521,
					"content": "Siz ikiniz Sumeru'ya mı gidiyorsunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981522
					]
				},
				{
					"id": 710981522,
					"content": "Evet. Bay Garcia, Akademiye gidip birkaç kaynağa göz atmak istiyor ve benim işim de onunla beraber gitmek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710981523
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710981523,
					"content": "Görüşmek üzere Gezgin. Kader bizi Sumeru'da yeniden karşılaştırsa ne güzel olur... Eminim Bay Garcia da buna çok sevinir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710981515,
					"content": "Makinanın \"aklı\" olup olmadığını mı soruyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981516
					]
				},
				{
					"id": 710981504,
					"content": "Şey, dibime girmezsen sevinirim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710981505
					]
				}
			]
		}
	]
}