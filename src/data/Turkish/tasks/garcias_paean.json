				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710980101,
					"content": "Efendim, bugünü de hesaba katacak olursak altı gündür Turplu Sebze Çorbası içtiğimizi söylemeliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980102
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980102,
					"content": "Ekonomik olarak vahim durumda da olsak midemizin sağlığını göz ardı edemeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980103
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980103,
					"content": "Haklısın sevgili Lutong. Her zamanki gibi algıların yine keskin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980104
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980104,
					"content": "Midemizdeki sıkıntılar yüzünden bu yemeğin tadını tam tutturamıyor olabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980105
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980105,
					"content": "Bir tanığa ihtiyacımız var Lutong! Kendimize üçüncü bir kişi bulmamız gerek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980106
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980106,
					"content": "Gururumu okşadınız efendim ancak demeye çalıştığım şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980107,
						710980108
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980107,
					"content": "Pardon ama siz ikiniz burada ne yapıyorsunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980109
					]
				},
				{
					"id": 710980109,
					"content": "İşte! Tanığımız da geldi. Hatta birden fazla tanığımız var! Harika!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980110
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980110,
					"content": "N-Ne? Ne tanığı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980111,
					"content": "Biz mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980112
					]
				},
				{
					"id": 710980112,
					"content": "Evet! Söyleyin bakalım, daha önce hiç Turplu Sebze Çorbası içtiniz mi? Tadına ve nasıl yapıldığına aşina mısınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980113
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980113,
					"content": "Efendim, sanırsam önce onlara durumu açıklamalıyız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980114
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980114,
					"content": "#Tabii ki, çok iyi biliriz! {NICKNAME} nasıl yapıldığını dahi biliyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980115,
					"content": "Paimon, ilk önce durumun ne olduğunu öğrenelim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980116
					]
				},
				{
					"id": 710980116,
					"content": "Evet, doğru. Özel görevinizi açıklayayım size. Umarım bu özel görev sizin için uygundur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980117
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980117,
					"content": "Ben Lutong, bu da Fontaine'den gelen patronum Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980118
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980118,
					"content": "Bay Garcia'nın şu an üzerinde çalıştığı proje... Sanırım ona Numaralandırma Makinası adını verdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980119
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980119,
					"content": "Detaya inecek olursak, insanlar çeşitli hesaplamalar yaparken bu araçtan faydalanabilecek, değil mi efendim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980120
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980120,
					"content": "Kesinlikle doğru sevgili Lutong. Numara Makinasının işlevi tam olarak bu. Kısa ve öz bir cevap oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980121
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980121,
					"content": "Evet, özlük... Öz olmalıyız. O dönüştürücü biraz fazla karmaşık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980122
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980122,
					"content": "Bir dakika, bunun Turplu Sebze Çorbasıyla ne ilgisi var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980123,
					"content": "Sanırım bu soruyu siz yanıtlamalısınız Bay Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980124
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980124,
					"content": "Bunu nasıl basit hale getirebiliriz ki? Hah! Tabii ya, evet. Hemen açıklayayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980125
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980125,
					"content": "Hımm... En basit şeylerden başlayalım. \"Formülün\" ne anlama geldiğini biliyor musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980126
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980126,
					"content": "Hım... Pek sayılmaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980127,
					"content": "Tam olarak neden bahsettiğini ben de bilmiyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980128
					]
				},
				{
					"id": 710980128,
					"content": "Pekala, sorun yok. Formülü şey gibi düşünebilirsin... Hım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980129
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980129,
					"content": "Genel bir uygulanabilirliği olan ve çeşitli miktarlar arasındaki ilişkilerin ifade edilmesi için kullanılan matematiksel bir ifade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980130
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980130,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980131,
					"content": "Etkileyiciymiş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980132
					]
				},
				{
					"id": 710980132,
					"content": "Kısacası Numaralandırma Makinasını, Turplu Sebze Çorbasının tarifi için bir formül ortaya koyma amacıyla kullanmak istiyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980133
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980133,
					"content": "Bay Garcia, doğru formülü elde edebilirsek, Turplu Sebze Çorbasının yapımını...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980134
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980134,
					"content": "... Ortak bir prosedüre bağlayabileceğimizi düşünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980135
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980135,
					"content": "Yani aptalların bile uygulayabileceği bir prosedür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980136
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980136,
					"content": "Bu prosedürü uygulayan herkes lezzetli bir Turplu Sebze Çorbası yapabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980137
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980137,
					"content": "İyi fikir... Ancak niye birinden yemeğin nasıl yapılacağını öğretmesini istemediniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980138,
					"content": "Ne yazık ki bu yöntem fazlasıyla doğal yetenek gerektiriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980139
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980139,
					"content": "Bize öğretirken ne kadar sabırlı olursa olsun, ben ve Bay Garcia gibi mutfak becerileri bu denli kötü olan iki insanın herhangi bir aşçının verdiği dersi kavrayabileceğini düşünmüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980140
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980140,
					"content": "Aslına bakarsanız, bu handaki Bay Yanxiao bunu bizzat kendisi deneyimledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980141,
						710980143
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980141,
					"content": "Bu \"formülü\" hesaplamak için bizim yardımımıza mı ihtiyacınız var yani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980142
					]
				},
				{
					"id": 710980142,
					"content": "Kesinlikle hayır! Sizi asla böyle büyük bir yükün altına sokmam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980145
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980145,
					"content": "Aslında sizin tam anlamıyla \"tarafsız bir üçüncü taraf\" olmanızı istiyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980146
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980146,
					"content": "Kısacası, Bay Garcia'nın formülü kullanarak yaptığı Turplu Sebze Çorbasını denemenizi ve geri bildirim vermenizi bekliyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980147
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980147,
					"content": "O halde en iyi yemeği elde etmek için tadımcılık yapacağız, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980148,
					"content": "Bu söylem biraz hafif kalır...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980149
					]
				},
				{
					"id": 710980149,
					"content": "Bence sorun olmaz! Her neyse, Paimon daha önce hiç \"formüle\" göre yapılmış Turplu Sebze Çorbası yememişti! Hadi deneyelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980150
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980150,
					"content": "O zaman anlaştık. Bu durumda mutfağa geçelim. Bay Yanxiao orayı kullanmamıza izin verdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980151
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980151,
					"content": "Bay Garcia, efendim, bu deneyde de önceki adımları mı uygulamalıyız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980152
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980152,
					"content": "Ha? Doğru ya. Üzgünüm, biraz dikkatim dağıldı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980153
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980153,
					"content": "Kafamda bir sürü zaptı zor parametre var da... Ama evet, önceki üç aşamalı işlemi uygulayalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980143,
					"content": "Size yemek yapmayı öğretmemizi mi istiyorsunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980144
					]
				},
				{
					"id": 710980144,
					"content": "Tam olarak öyle de denemez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980145
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980108,
					"content": "Turplu Sebze Çorbasının \"formülünü\" merak ediyorsan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710980109
					]
				}
			]
		},
		{
			"id": 7109803,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
