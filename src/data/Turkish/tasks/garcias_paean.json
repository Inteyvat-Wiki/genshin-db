			},
			"dialogs": [
				{
					"id": 710980301,
					"content": "Anlamıyorum. İnsanlar nasıl Turplu Sebze Çorbası yapmayı beceremez ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
