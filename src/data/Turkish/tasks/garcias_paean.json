					"nextDialogs": [
						710980711
					]
				},
				{
					"id": 710980711,
					"content": "Hımm, o zaman gidip soralım. Belki de yeni bir yemek araştırıyorlardır... Yani bizim de deneyebileceğimiz türden bir şeyler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710980712,
					"content": "Hadi gidip soralım.",
