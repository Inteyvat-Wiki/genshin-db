					"nextDialogs": [
						710980706
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 710980706,
					"content": "Evet, Turplu Sebze Çorbası siparişi verildi efendim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710980707
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 710980707,
					"content": "Harika. Çok düşüncelisin sevgili Lutong. Eminim bu defa işleme formülünü bulacağız.",
