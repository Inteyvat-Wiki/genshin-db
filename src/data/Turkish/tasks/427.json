					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4270401,
					"content": "Ha ha ha... Kanatlarla uçmayı kavramaya başladın gibi duruyor! Hadi son aşamayı yapalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270402
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270402,
					"content": "Basit! Burada daha önce uçmuştun zaten...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4270403,
					"content": "Son aşamayı geçtiğinde nihayet kendi uçuş ehliyetini almaya hak kazanacaksın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270404
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270404,
					"content": "Ehliyeti düşünmeye devam et yeter. Hazır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270405
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4270405,
					"content": "... Başla!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 42708,
			"completionStepIds": [
				42708
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
