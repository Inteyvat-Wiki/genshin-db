			"dialogs": [
				{
					"id": 6080101,
					"content": "Of, Rüzgarçiçeği Festivali sırasında yıldırımımı kullanmayalı epey olmuştu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080102
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 6080102,
					"content": "Önceden sık sık kullanıyor muydun ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080103
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 6080103,
					"content": "İnsanlar üzerinde mi? Haha, hayır, hayır. Belki arada bir. Yine de kendimi frenlememek iyi hissettiriyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080104
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 6080104,
					"content": "Hah, hatta eski Profesörüm birkaç gün önce bana bununla ilgili bir mektup yazdı. Tabii ki \"herkese iyi davrandığımı\" belirtmeyi unutmadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080105
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 6080105,
					"content": "Bir öğrencinin hocasının alışkanlıklarını miras alması gayet normal. Benim hocam da Spantamad okulundan nazik, yaşlı bir adamdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080106
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 6080106,
					"content": "Gördün mü? Bu sefer yalnızca nazik elektrik akımları kullandım. O kadar naziktim ki Jean'in müdahale etmesi bile gerekmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080107
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 6080107,
					"content": "Nazik elektrik akımları demek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080108
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 6080108,
					"content": "Görünüşe göre keyfiniz yerinde Bayan Lisa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080109
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 6080109,
					"content": "Ah, bilirsin, arada bir hareket etmek iyi geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				}
			]
		},
