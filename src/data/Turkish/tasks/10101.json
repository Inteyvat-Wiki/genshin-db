			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101010701,
					"content": "Hırsız <color=#00E1FFFF>harabelerde</color> mi yaşıyor? Mondstadt halkının tuhaf huyları var cidden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010702,
					"content": "Lütfen Mondstadt sakinlerinin alışkanlıkları hakkında hemen böyle saçma sonuçlara varmaktan kaçın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010703
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010703,
					"content": "Bu bence çok da dost canlısı olmayan baş belalarının işi gibi duruyor daha çok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010704,
						101010707,
						101010709
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010704,
					"content": "Dağ yabanileri mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010705
					]
				},
				{
					"id": 101010705,
					"content": "Kitap çalmak pek de dağ yabanilerinin yapacağı bir iş değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010706
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010706,
					"content": "Kitapları ancak kamp ateşleri sönmesin diye kullanırlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010712
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010712,
					"content": "Bunun <color=#00E1FFFF>Hiçlik Tarikatının</color> işi olma olasılığı daha yüksek. Sonuçta hayalet gibi bir yerlere girip çıkma huyları var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010713
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010713,
					"content": "Ayrıca... Girişte bir element mührü var. Bir Hiçlik Büyücüsünün yapacağı bir büyünün izi gibi duruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010714
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010714,
					"content": "Mühür mü? Mührü nasıl kıracağız? Yine zahmetli bir işe mi dönüşecek bu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010715,
					"content": "Merak etme. Ufacık bir büyü bana engel olur sanıyorsan yanılıyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010716
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010716,
					"content": "Nedenmiş?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010717,
					"content": "Gelin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010718
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010718,
					"content": "Vay be...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010719,
					"content": "Lisa sıkı çalışınca böyle oluyormuş demek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010707,
					"content": "Hiçlik Tarikatı mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010708
					]
				},
				{
					"id": 101010708,
					"content": "Sanki aklımı okuyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010712
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010709,
					"content": "Maceracılar Loncası mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010710
					]
				},
				{
					"id": 101010710,
					"content": "Onlar olabilir. Yer altı harabelerinde oradan oraya koşturup durmalarıyla tanınıyorlar sonuçta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010711
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010711,
					"content": "Ama Maceracılar genelde başkalarının eşyalarını almaz... Yani, yaşayanların eşyalarını.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010712
					],
					"speakerTitle": "Lisa"
				}
			]
		},
		{
			"id": 1010108,
			"completionStepIds": [
				1010108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1010108",
							"2"
						],
						"stepId": 1010108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101010801,
					"content": "<color=#00E1FFFF>Soluk Prenses ve Altı Cüceler</color>! Paimon bu adı hatırlıyor, aradığın kitap bu muydu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010802,
					"content": "Evet bu. Hasar görmemiş olması çok iyi, aksi takdirde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010803
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010803,
					"content": "Aksi takdirde ne? Yoksa planladığın daha da çılgınca cezalar da mı vardı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010804,
					"content": "Hehe. Bu durumda iksirlerimden birini kullanmam gerekirdi muhtemelen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010805
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010805,
					"content": "Ah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010806,
					"content": "Kaldı ki... Daha önce söylediğim gibi bu kitap özel bölümden değil. Sırf bu yüzden sıradan bir vatandaşın ödünç almasına izin vermiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010807
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010807,
					"content": "Ayrıca hiç sıra dışı element güçleri var gibi durmuyor. Benim yerleştirdiğim işaretler hariç.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010808
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010808,
					"content": "Evet... Sıradan bir romana benziyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010809,
						101010810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010809,
					"content": "Peki o zaman Hiçlik Tarikatı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010810
					]
				},
				{
					"id": 101010810,
					"content": "(Çok ilginç. Çok merak ediyorum...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010811
					]
				},
				{
					"id": 101010811,
					"content": "Kütüphanecilik işlerimin zor kısmı bitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010812
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010812,
					"content": "Madem bu kitap ilgini çekti, ödünç almaya ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010813,
						101010814
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010813,
					"content": "Teslim tarihi ne zaman?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010814
					]
				},
				{
					"id": 101010814,
					"content": "Geç getirirsem beni cezalandırma lütfen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010815
					]
				},
				{
					"id": 101010815,
					"content": "Senin için süre sınırı yok. Seni \"ödünç alan\" yerine \"sorumlu\" olarak kaydedeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010816
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010816,
					"content": "Bu yalnızca güvenilir vatandaşlara verilen özel bir ayrıcalık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010817
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010817,
					"content": "Özel ayrıcalık mı? Neden bu ayrıcalık Paimon'a zahmetli işini başkasının üzerine yıkmanın sinsi bir yoluymuş gibi geliyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101010818,
					"content": "Pardon? Benim işimden memnun değil misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010819,
						101010820
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010819,
					"content": "Memnunum efendim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010820
					]
				},
				{
					"id": 101010820,
					"content": "Bu kitaba gözüm gibi bakacağım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101010821
					]
				},
				{
					"id": 101010821,
					"content": "Güzel. İş birliğine açıksın öyleyse. Keşke kişisel asistanım olarak yanımda kalsan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101010822
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 101010822,
					"content": "Burada işim bitti. Geri dönüyorum.",
					"roleType": "TALK_ROLE_NPC",
