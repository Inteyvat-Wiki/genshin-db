			"dialogs": [
				{
					"id": 250360101,
					"content": "... Bu soru fazla mı kolay oldu yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360102
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360102,
					"content": "Aa, kusura bakmayın. Sesli düşünüyordum, geldiğinizi fark etmedim bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360103
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360103,
					"content": "Müsaadenizle kendimi tanıtayım. Ben Gece Rüzgarının Ustalarından Keita. Dosya yönetiminden sorumlu bir asistanım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360104
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360104,
					"content": "Ne düşünüyordun peki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250360105
					]
				},
				{
					"id": 250360105,
					"content": "Ah... Natlan'ın geçmişi, bugünü ve geleceği hakkında birkaç basit soru üzerine düşünüyordum sadece. Tartışmaya bile değmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360106
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360106,
					"content": "Görünüşünüze bakılırsa uzaklardan gelen bir gezgine benziyorsunuz. Derin dostluklara ve engin bir bilgiye sahip olduğunuz aşikar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360107
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360107,
					"content": "İsterseniz daha önce kaydettiğim bazı soruları yanıtlamayı deneyebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250360108
					],
					"speakerTitle": "Keita"
				},
				{
					"id": 250360108,
					"content": "Bu soruların cevapları yolculuğunuzda saklı. Geçmişte, bugünde ve gelecekte yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Keita"
				}
			]
