			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Collei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30010101,
					"content": "Pekala, sağ eline bir bakalım... Hımm, fena değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010102
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010102,
					"content": "Ama unutma, bir süre daha dikkatli olman gerek. Anlaşıldı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010103
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010103,
					"content": "Tamam, dikkat edeceğim. Bir de bugünün devriye rotası hâlâ elime ulaşmadı, Usta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010104
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010104,
					"content": "Bak Collei, bugünün devriyesi uzun olacak, o yüzden bu sefer katılmayacaksın. Ayrıca şeyle karşılaşma ihtimalimiz de var... Anladın sen işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010105
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010105,
					"content": "Ama benim de Önsezim var! İşe yaramaz biri mi oldum şimdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010106
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010106,
					"content": "Böyle konuşma, Collei. Şimdilik bu konuda kafanı takacağın bir şey yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010107
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010107,
					"content": "Ah, işte buradasın. Kendini daha iyi hissediyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010108
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010108,
					"content": "Yardım edebileceğimiz bir şey var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010109
					]
				},
				{
					"id": 30010109,
					"content": "Evet, bir süre daha burada kalacağımıza göre buradaki işlere destek olabiliriz diye düşündük.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010110,
					"content": "Heh, belli ki siz sırtını yaslayıp keyif çatacak tipler değilsiniz. O halde bugün Collei siz ikinizi Gandharva'nın güneyine devriye gezmeye götürebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010111
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010111,
					"content": "Ayrıca eğer isterseniz Yedilerin Heykelini temizleme görevini üstlenebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010112
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010112,
					"content": "Tighnari, yola çıkmaya hazırız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010113
					],
					"speakerTitle": "Amir"
				},
				{
					"id": 30010113,
					"content": "Anlaşıldı, geliyorum! Pekala, biz ormana doğru gidiyoruz. Diğer bütün ayrıntılarla Collei ilgilenecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010114
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30010114,
					"content": "Evet, bana güvenebilirsiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010115
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010115,
					"content": "Ee Collei, bugün tam olarak nereye gidiyoruz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010116,
					"content": "Tighnari az önce heykel temizliğinden bahsetti ama... Bu bir muhafızın yapacağı bir iş değil gibi sanki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010117,
					"content": "Eh, Orman Muhafızlarının çok çeşitli sorumlulukları vardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010118
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010118,
					"content": "Çevre yolların durumunu kontrol etmekten orman tesislerinin bakımını yapmaya, yangın önleme standartlarının karşılandığından emin olmaktan gezginlere ve yerlilere yardımcı olmaya kadar çeşitli konularla ilgileniyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010119
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010119,
					"content": "Usta ise yağmur ormanının tehlikeli bölgeleriyle ilgilenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010120
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010120,
					"content": "Bugün Yedilerin Heykeline giden yolun üstünde bulunan lambaların rutin kontrollerini yapacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Collei"
				}
			]
		},
		{
			"id": 300105,
			"completionStepIds": [
				300103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300103",
							"2"
						],
						"stepId": 300103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Collei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30010501,
					"content": "Yedilerin Heykeli, büyük bir kaya oluşumunun tepesinde bulunuyor. Bu yoldan geçerken görmüş olmalısın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010502
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010502,
					"content": "Oldukça yüksekte, değil mi? Merak etme, oraya çıkmaktan korkuyorsan Usta, heykeli temizlememene bir şey demez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010503,
						30010504
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010503,
					"content": "Merak etme. Ben harika bir tırmanıcıyım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010505
					]
				},
				{
					"id": 30010505,
					"content": "Öyle mi? O halde bu işi sana bırakıyorum. Heykele tırmandıktan sonra ayağını basabileceğin çok sağlam bir yer yok, bu yüzden orada dikkatli ol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010506
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010506,
					"content": "#Paimon seninle birlikte oraya uçar ve ulaşılması zor yerlerde sana yardımcı olur {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010507,
					"content": "Şey, Collei... Doğa Hükümdarı hakkında bir şeyler biliyor musun acaba? Nasıl biri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010508,
					"content": "Ahh, hangisinden bahsettiğine göre değişir, Mahadevi Rukkhadevata'dan mı bahsediyorsun yoksa Devi Kusanali'den mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010509
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010509,
					"content": "Hı? Mahadevi Rukkhadevata mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010510,
					"content": "Eski Doğa Hükümdarı'nın adı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010511,
					"content": "Evet. Mahadevi Rukkhadevata, Sumeru'nun ilk Doğa Hükümdarı'ydı. Çölün yakınlarındaki Samiel Duvarını ve yağmur ormanlarını o yarattı. Onun yarattıkları sayesinde herkes huzurlu bir ortamda yaşıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010512
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010512,
					"content": "Sumeru halkı için o yalnızca bilgeliğin değil, aynı zamanda gücün ve nezaketin simgesi. Maalesef birkaç yüzyıl önce yaşanan büyük bir felakette ortadan kayboldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010513,
						30010514
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010513,
					"content": "(Tıpkı Makoto Raiden'ın başına gelen gibi...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010515
					]
				},
				{
					"id": 30010515,
					"content": "Ustanın söylediğine göre bilgeler daha sonra yeni doğan Doğa Hükümdarı'nı buldu ve onu hemen Sumeru'ya geri getirdiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010516
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010516,
					"content": "Bilgeler, kayıp tanrılarının yerine yeni birinin gelmesini kutlamak için ona \"Devi Kusanali\" adını verdiler ve onu Surasthana Mabedinde ağırladılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010517
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010517,
					"content": "Hıhı, peki sonra ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010518,
					"content": "Eh, sonra... Şey... Ne olduğundan çok emin değilim açıkçası.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010519
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010519,
					"content": "Nasıl yani? Emin değil misin? Ama sen Sumerulu değil miydin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010520,
					"content": "Evet, Sumeruluyum ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010521
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010521,
					"content": "Belki de bu konuyu yabancılarla konuşmak zor geliyordur... Eğer öyleyse merak etme, biz anlarız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010522,
					"content": "Hayır, hayır. O yüzden değil. Sizden bir şey saklamaya çalışmıyorum. Ayrıca sizi yabancı olarak görmüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010523
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010523,
					"content": "Neyse, s-siz ikiniz Amber'ı tanıyorsunuz, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010524
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010524,
					"content": "Bir dakika, Amber mı? Yani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010525,
						30010526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010525,
					"content": "Favonius Şövalyelerinin Kaşifi Amber mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010527
					]
				},
				{
					"id": 30010527,
					"content": "Evet, o! Bir süre Mondstadt'ta yaşadım ve o zamanlarda bana çok yardımcı oldu. Hatta yeni bir insana dönüşmeme yardımcı oldu bile diyebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010528
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010528,
					"content": "Amber bir tanedir! Kalbindeki adalet duygusunu hiç kaybetmeden hayatı sonuna kadar yaşıyor. Çağrıldığı an harekete geçmeye hazır ve diğerlerine karşı da bir o kadar anlayışlı! O, etrafındaki herkesin yüreğindeki ateşi yakabilecek bir kıvılcım gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010529
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010529,
					"content": "Bence o gerçekten örnek bir Kaşif. Mondstadt'a gelen herkes önce onunla tanışır. Onun cazibesinden ve heyecanından etkilenmemek mümkün değil. Mondstadt topraklarına aşık olmanı sağlar ve...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010530
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010530,
					"content": "Ah, hehe... Üzgünüm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010531,
						30010532
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010531,
					"content": "Ha?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010533
					]
				},
				{
					"id": 30010533,
					"content": "Paimon, Kaşiflerin senin anlattığından biraz daha farklı işler yaptığını sanıyordu... Ama şu kadarı kesin, Amber'ı gerçekten seviyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010534
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010534,
					"content": "Öhöm... Ü-Üzgünüm, boş boş konuşuyorum işte. Söylediklerim size tuhaf gelmiş olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010535
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010535,
					"content": "Hehe, sorun değil Collei. Senin de Amber'ın arkadaşı olduğunu bilmek nedense Paimon'un sana daha yakın hissetmesine neden oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010536
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010536,
					"content": "Pekala, Amber'ı tanıdığımızı nereden bildin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010537
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010537,
					"content": "Ben Sumeru'ya döndükten sonra Amber ve ben birbirimize mektup yazarak irtibatta kaldık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010538
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010538,
					"content": "Bir mektubunda Mondstadt'a korkunç bir ejderin saldırdığını söylemişti. Ama gizemli sarışın bir gezgin ve uçan minik dostu şehri kurtarmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010539
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010539,
					"content": "Sizi gördüğüm anda sizin mektupta bahsettiği kişiler olduğunuzu anladım. Ama, ah, o gün boyunca yaşadıklarınızdan sonra bu konuyu açmak uygunsuz olur diye düşündüm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010540
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010540,
					"content": "Ah, demek oradan anladın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010541,
					"content": "Evet! Bu yüzden size güvenimin tam olduğunu bilmenizi isterim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010542
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010542,
					"content": "Keşke size Doğa Hükümdarı hakkında daha fazla şey anlatabilseydim. Ama ben de bir süredir Sumeru'da değildim ve hiç kitap okumadım... Üzgünüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010543
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010543,
					"content": "Önemli değil! Bize zaten çok yardımcı oldun, sen bahsetmeden önce Mahadevi Rukkhadevata'yı da Surasthana Mabedini de duymamıştık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010544
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010544,
					"content": "Yardım edebildiğime sevindim. Ama sormak istediğim bir şey var... Doğa Hükümdarı'nı neden merak ediyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010545
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010545,
					"content": "Yolculuğunuzun amacını ona anlatıyorsunuz.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						30010546
					]
				},
				{
					"id": 30010546,
					"content": "Demek bu yüzden buradasınız. Hikayenizi bana anlattığınız için teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010547
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010547,
					"content": "Ne demek! Sonuçta biz arkadaşız, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010548
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010548,
					"content": "Paimon doğru söylüyor, biz arkadaşız.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010549
					]
				},
				{
					"id": 30010549,
					"content": "Hehe! Pekala, daha temizlememiz gereken bir heykel var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010550
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010550,
					"content": "İkinize de teşekkür ederim! Siz temizlik yaparken ben de gidip ormanlık alanı kontrol edeceğim. Birazdan tekrar burada buluşalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Collei"
				},
				{
					"id": 30010532,
					"content": "Vay be, senin bu tarafını hiç görmemiştik Collei...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010533
					]
				},
				{
					"id": 30010526,
					"content": "Mondstadt'ın heyecanlı pilotu mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010527
					]
				},
				{
					"id": 30010514,
					"content": "(Khaenri'ah ile aynı zamana mı denk geliyor?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010515
					]
				},
				{
					"id": 30010504,
					"content": "Benim için sorun olmaz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010505
					]
				}
			]
		},
