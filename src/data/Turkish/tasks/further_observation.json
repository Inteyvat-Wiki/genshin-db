			"dialogs": [
				{
					"id": 30011101,
					"content": "Ah, Gezgin, dönmüşsün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011102
					],
					"speakerTitle": "Nasrin"
				},
				{
					"id": 30011102,
					"content": "Evet, döndük. Acaba Collei'i gördün mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30011103,
					"content": "Collei mi? Evet, şimdi onu odasına giderken gördüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30011104
					],
					"speakerTitle": "Nasrin"
				},
				{
					"id": 30011104,
					"content": "Pekala... Sanırım onunla konuşmak için yarını beklememiz gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
