			"dialogs": [
				{
					"id": 30015101,
					"content": "Şey, ben pek iyi tırmanamam, bu yüzden heykelle siz ilgilenmelisiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30015102
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30015102,
					"content": "Ben de gidip ilerideki tesislere bir bakacağım. Bu arada işimizi bitirdikten sonra... Biraz daha sohbet eder miyiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Collei"
