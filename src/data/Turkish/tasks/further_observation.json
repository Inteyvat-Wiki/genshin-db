					"nextDialogs": [
						30010612
					]
				},
				{
					"id": 30010612,
					"content": "Evet! Küçük ve yuvarlaktı... Sebze gibi bir şeydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010615,
					"content": "Paimon'u çok korkuttu! O şey her neyse gidip bir araştırsak iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010616,
					"content": "Aslında, tekrar düşündüm de önce heykeli temizlesek daha iyi. Paimon uçup heykelin üst kısmını temizleyecek, alt kısmını da sen temizle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010617,
					"content": "Paimon'la birlikte heykeli güzelce temizliyorsunuz.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 30010613,
					"content": "Lahana gibi bir şey mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30010614
					]
				},
				{
					"id": 30010614,
					"content": "Evet, lahana gibi! Lahana gibi küçük ve yuvarlak... Ama hareket ediyordu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30010615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30010605,
					"content": "Devi Kusanali olabilir mi?",
