					"nextDialogs": [
						751501508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501508,
					"content": "... Bu adlara sahip olan kişiler vardı fakat ben ikisi de değilim.",
					"roleType": "TALK_ROLE_NPC",
