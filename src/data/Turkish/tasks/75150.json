			"dialogs": [
				{
					"id": 751500401,
					"content": "Kutsal Dağ'ın Kalbi'ne nasıl gireceğiz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751500402
					]
				},
				{
					"id": 751500402,
					"content": "Kalbin girişi yakında. Lord Xiuhcoatl, Tollan'ın şehir merkezini yeniden inşa ederken dengeli bir deneysel ortam oluşturmak amacıyla aşağı doğru kazdı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500403
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751500403,
					"content": "Ve orada Hiçlik ile savaşmak için üstün bir silah yaptı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500404
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751500404,
					"content": "Ancak mühür nedeniyle bu cihaz ağır bir Hiçlik aşındırmasına uğradı. Şehir de bu yüzden ele geçirildi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500405
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751500405,
					"content": "Kutsal Dağ'ın Kalbi'nin girişi, Kutsal Şehir'in çatlaklarının altında yer alıyor... Karanlık düşmanımızın aşınmasının en ağır olduğu nokta da orası.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				}
			]
		},
