					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751501512,
					"content": "Bir dakika... Hayır... Adım yok değil, ben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501513
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751501513,
					"content": "Ben efendisi olmayan tek akıllı Gizli Kaynak Hizmetkarıyım. Lord Xiuhcoatl öldükten sonra bile en temel görevlerime...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501514
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751501514,
					"content": "En temel şehir bakımı ve bilgi kaydı görevlerime devam ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501515
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751501515,
					"content": "Ancak karanlık düşmanımızın istilasından ötürü bazı kayıtlar kayboldu, dolayısıyla kendi adıma dair bir kayda sahip değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501516
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751501516,
					"content": "Evet, galiba yanlış adamı... Şey, yanlış ejderha robotunu bulmuşuz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501517,
					"content": "Sorun değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501518
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751501518,
					"content": "Hımm. Bu robot kocaman ama pek de zeki görünmüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501519,
					"content": "#Bu muhtemelen bizimle makinalar aracılığıyla konuşan o kişi değil {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501520,
					"content": "Ama kayıt tutmakla falan görevli olduğunu söyledi, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501521,
					"content": "Bildiklerini sorsak mı? Ya da... Kutsal Dağ'ın Kalbi'ne nasıl ulaşabileceğimizi sorabilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501522,
						751501523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751501522,
					"content": "Belki de \"o kişinin\" planı buydu...",
