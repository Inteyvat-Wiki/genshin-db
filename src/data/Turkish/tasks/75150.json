			"dialogs": [
				{
					"id": 751500901,
					"content": "Merhaba. Yeni veri kurtarma kategorisi tespit edildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500902
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751500902,
					"content": "... Gizli Kaynak Mekanizması enerji çekirdekleriyle ilgili girdiler güncellendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500903
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751500903,
					"content": "Gizli Kaynak Mekanizmalarına güç veren ana enerji formu Filojistondur fakat ışığı andıran yoğunlaştırılmış bir formdadır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500904
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751500904,
					"content": "[VERİ KAYIP] adlı kontrollü tepkime ile sabit miktarlarda Filojiston Birimleri oluşturulabilir ve serbest bırakılan enerji daha hassas kontrol edilebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500905
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751500905,
					"content": "Gizli Kaynak Mekanizmalarının ihtiyaç duyduğu enerji, Mekanizmanın boyutuna ve faaliyet mantığının karmaşıklığına bağlı olarak değişir. Bir Gizli Kaynak Hizmetkarının ihtiyaç duyduğu Filojiston Birimi miktarı [VERİ KAYIP] iken...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500906
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751500906,
					"content": "Boyutu daha büyük Gizli Kaynak Ejderha Heykelleri ise çok daha az Birim gerektirir. Hatta bu miktar tam olarak üç adettir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500907
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751500907,
					"content": "\"Bilgi enerjidir, enerji de bilgidir.\" Getirdiğiniz veri taşıyıcısı bir Filojiston Birimi sayılır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500908
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751500908,
					"content": "Yani bir \"Filojiston Birimi\" bir alev topu oluyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751500909
					]
				},
				{
					"id": 751500909,
					"content": "Evet, öyle düşünebilirsiniz. Hiçlik tarafından bozulan bir Filojiston Birimini onardınız. Ancak o zaman ondan bir şeyler çıkarabildim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500910
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751500910,
					"content": "Ayrıca Hiçliğin aşındırdığı Gizli Kaynak Mekanizmalarında enerji kaynağı olarak da kullanılabilirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				}
			]
		},
