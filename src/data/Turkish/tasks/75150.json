					"nextDialogs": [
						751501302
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751501302,
					"content": "Kutsal Dağ'ın Kalbi'ne nasıl gireceğiz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501303
					]
				},
				{
					"id": 751501303,
					"content": "Kutsal Dağ'ın Kalbi'nin girişi, yeni kazılan girişte bulunuyor... Yanardağın en derin çatlağına inin, Dağ'ın Kalbi orada bir Gizli Kaynak Ejderha Heykeli tarafından korunmaktadır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501304
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751501304,
					"content": "Ayrıca Kalbe erişmek isteyenlerin bir \"izin\" alması gerekmektedir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501305
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751501305,
					"content": "Ancak o zaman Huitzilopochtli olarak da bilinen Kutsal Dağ'ın Kalbi'nin muhafızı olan... Gizli Kaynak Ejderha Heykelinin onayını alabilirsiniz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501306
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751501306,
					"content": "Bu izni nereden alabiliriz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501307
					]
				},
				{
					"id": 751501307,
					"content": "Lord Xiuhcoatl'ın düzenlediği anlaşma ve ferman gereğince... Kutsal Dağ'ın Kalbi, yani \"Huitzilopochtli\"ye giriş... Soyundan gelenlerin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501308
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751501308,
					"content": "Başvuruda bulunmak için Müzakere Odasına gidin ve iznin çıkmasını bekleyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501309
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751501309,
					"content": "Gizli Kaynak Ejderha Heykellerinin ihtiyaç duyduğu enerji kaynağı nedir peki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501310
					]
				},
				{
					"id": 751501310,
					"content": "Aranıyor... İlgili veri kategorisi bulunamadı... Şehrin Hiçlik aşındırmasına uğramasından ötürü pek çok şey gibi bu konudaki veriler de kaybolmuş olabilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501311
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751501311,
					"content": "Hiçliğin etkisini ortadan kaldırıp verileri kurtarabilirseniz aradığınız girdileri bulabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501312
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751501312,
					"content": "Sizin için olası bir veri depolama noktası işaretledim. Lütfen oradaki Hiçlik aşındırmasını yok edin ve alanı kurtarın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501313
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751501313,
					"content": "Bir sorunuz var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501314
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751501314,
					"content": "Başka sorum yok...",
					"roleType": "TALK_ROLE_PLAYER",
