			"dialogs": [
				{
					"id": 761160101,
					"content": "Aa, ömürlük dostlarımız gelmiş! Bobik'in de tabii!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761160102,
						761160105,
						761160108,
						761160110
					],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160102,
					"content": "Ee, planınız ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160103
					]
				},
				{
					"id": 761160103,
					"content": "Bir süre daha buradayız. Drzislav'ın laboratuvar kapısının güvenliği aşıldı. O yüzden buralarda kalıp o kötü adamların içeri girmesine engel olmamız gerek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761160104
					],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160104,
					"content": "Kapıyı tamir edince ya da Slava geri gelince biz de sizin izinizden gidip Bobik ile beraber seyahate çıkarız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160105,
					"content": "Drzislav hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160106
					]
				},
				{
					"id": 761160106,
					"content": "Nerede olduğuna dair hiçbir fikrim yok... Ancak yolculuğunuz sırasında ona rastlarsanız bizden selam söyleyin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761160107
					],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160107,
					"content": "Onunla bir kez daha Sancak Gemisinde sabahlayıp bütün gece içki içmeyi çok isterim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160108,
					"content": "Bobik ne yapıyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160109
					]
				},
				{
					"id": 761160109,
					"content": "Ah, şimdiden onu özledin demek? Merak etme, boş vaktin olunca gelip onunla oynayabilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anezka"
				},
				{
					"id": 761160110,
					"content": "Sonra görüşürüz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761160111
					]
				},
				{
					"id": 761160111,
					"content": "Aynen. Merak etme, yollarımız yine kesişecektir. Bizler her türlü zorluğa birlikte göğüs germiş yakın arkadaşlarız sonuçta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anezka"
				}
			]
		}
	]
