			"dialogs": [
				{
					"id": 721170101,
					"content": "Harika zamanlama Gezgin! Veriler neredeyse tamam ve işaretçileri toplama vakti de geldi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170102,
