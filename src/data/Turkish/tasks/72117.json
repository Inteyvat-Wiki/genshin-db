					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170102,
					"content": "Bana güvenebilirsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721170103
					]
				},
				{
					"id": 721170103,
					"content": "Aynen, aynen. Lütfen hızlı ol ve hepsini gizlice topla. Fatui'nin seni görmesine izin verme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170104,
					"content": "Nereden biliyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721170105
					]
				},
				{
					"id": 721170105,
					"content": "Bu işaretçilerin oldukça ayrıntılı kullanım kılavuzları olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170106
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170106,
					"content": "Bunlarda çeşitli farklı durumlar ve her durumda veri toplamak için gereken süre belirtilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721170107,
					"content": "Tatarigami gibi bilinmeyen enerji formlarına ise en fazla süreyi ayırıyorum. İşaretçileri toplama işi her türlü sana düşüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
