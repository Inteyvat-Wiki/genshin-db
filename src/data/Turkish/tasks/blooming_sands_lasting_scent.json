					"nextDialogs": [
						230420903
					]
				},
				{
					"id": 230420903,
					"content": "İyiyim, iyiyim! Yapım aşamasında bir şeyi yanlış yaptım. Bir başarısız deneme daha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420904
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420904,
					"content": "Neyse, onu boş verelim şimdi. Malzemeleri getirdin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420905
					],
					"speakerTitle": "Nermin"
				},
				{
