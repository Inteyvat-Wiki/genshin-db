				"points": []
			},
			"dialogs": [
				{
					"id": 230420601,
					"content": "Nermin... Gezgin de buradaymış. Hangi rüzgar attı sizi buraya? Bir sorun mu var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420602
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420602,
					"content": "Umarım çiçeklerle ilgili bir sorun çıkmamıştır... Hâlâ görev başındayım. İşim bitince...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420603
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420603,
					"content": "Nermin sana bir şey getirdi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420604
					]
				},
				{
					"id": 230420604,
					"content": "Al, bu parfüm senin için. Nane kokulu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420605
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420605,
					"content": "Önce Zaytun Şeftalisi gibi koksun istemiştim ama... Nedense şeftalileri ekleyince parfüm yapış yapış oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420606
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420606,
					"content": "T-Teşekkür ederim. Peki bu... \"Parfüm\" ne işe yarıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420607
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420607,
					"content": "Tetikte kalabilmeni sağlıyor! Üstelik ter kokusunu da kapatıyor. Bütün gün terlemekten başın dönüyordu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420608
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420608,
					"content": "Eh, artık alıştım sanırım. Ter kokusu birden giderse tuhaf olabilir belki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420609
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420609,
					"content": "O zaman kullanma. Parfümümü geri alıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420610
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420610,
					"content": "Dur canım! Şaka yapıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420611
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420611,
					"content": "Ver bakayım parfümü! Başım dönmeye başladı bile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420612
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420612,
					"content": "Al bakalım. Sadece kollarına süreceksin, Jawahir Nine öyle dedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420613
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420613,
					"content": "Kokusu hiç fena değil, hatta bayağı ferahlatıcı diyebilirim. Hem kollarıma da bir serinlik geldi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420614
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420614,
					"content": "Hıh! Jawahir Nine'nin tarifi sonuçta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420615
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420615,
					"content": "Böyle harika bir parfümü Gezginin yardımı sayesinde yapabildim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420616
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420616,
					"content": "Azıcık yardım ettim sadece.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420617
					]
				},
				{
					"id": 230420617,
					"content": "Bu kadar çok yardım istediğim için kusura bakma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420618
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420618,
					"content": "Bunlar senin için. Emeğinin karşılığı olarak kabul et... Çok teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420619
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420619,
					"content": "Bu parfüm sahiden çok kullanışlıymış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420620
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420620,
					"content": "Şey... Nermin... Peki parfümü sürdüğüm yerler neden kızarmaya başladı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raef"
				}
			]
		},
