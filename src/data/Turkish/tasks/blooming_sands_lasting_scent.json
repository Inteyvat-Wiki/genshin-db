				"objectNames": [
					"Nermin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230420501,
					"content": "Harika! Geçen seferden kalan malzemelerim de var. Yeni getirdiklerini kullanarak son üründen önce birkaç deneme daha yapabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420502
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420502,
					"content": "Notlarıma tekrar bir bakayım... Bu sefer başaracağıma eminim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420503
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420503,
					"content": "Ah, birkaç tane çiçek yaprağı da lazım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420504
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420504,
					"content": "Nermin gergin bir halde parfümü tekrar yapmaya başlar...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230420505
					]
				},
				{
					"id": 230420505,
					"content": "Bitti! Çok güzel kokuyor... Hem yapış yapış da değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420506
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420506,
					"content": "Bu sefer başardım herhalde, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420507,
						230420508
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420507,
					"content": "Öyle görünüyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420509
					]
				},
				{
					"id": 230420509,
					"content": "Evet! Bak, parfümü koyabileceğim bir şişe bile aldım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420510
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420510,
					"content": "Hadi gel parfümü Raef'e birlikte verelim Gezgin. Umarım beğenir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420508,
					"content": "En azından başarısız denemez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420509
					]
				}
			]
		},
