			"dialogs": [
				{
					"id": 230420301,
					"content": "Merhaba! Bugün neye ihtiyacın var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420302
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 230420302,
					"content": "Nermin'in siparişi için gelmiştim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420303
					]
				},
				{
					"id": 230420303,
					"content": "Ah, Nermin'in siparişi... İşte burada. Hepsi çok kaliteli malzemeler, hem de ucuzlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420304
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 230420304,
					"content": "Nermin bu malzemelerle parfüm yapacak herhalde, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420305
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 230420305,
					"content": "*iç çeker* Bu kadar hevesli olması çok güzel ama Nermin'in kendine daha iyi bakması gerek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Azalai"
				}
			]
		},
		{
			"id": 2304205,
			"completionStepIds": [
