			"dialogs": [
				{
					"id": 230420801,
					"content": "Bu sefer neyle uğraşıyorsun Gezgin? Koşturup duruyorsun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420802
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420802,
					"content": "Şey, son zamanlarda hiç Nermin'e yardım ettin mi? Ya da neler yaptığı konusunda bir şeyler duydun mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420803
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420803,
					"content": "Çok meşgul görünüyor ama ne yaptığına dair hiçbir fikrim yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420804,
						230420806
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420804,
					"content": "O... Şey... Çiçekleriyle ilgileniyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420805
					]
				},
				{
					"id": 230420805,
					"content": "Öyle mi? Evinde yeni çiçek saksısı görmemiştim halbuki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420806,
					"content": "O... Şey... Yemek pişirmekle uğraşıyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420807
					]
				},
				{
					"id": 230420807,
					"content": "Öyle mi? Hilmi ve diğerleri yine Naneli Fasulye Çorbası mı istedi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420808
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 230420808,
					"content": "Ah, o çocuklar yok mu... Vakit bulunca onlarla bir konuşayım en iyisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raef"
				}
			]
		},
