			"dialogs": [
				{
					"id": 230420101,
					"content": "Raef bu sürprizi görünce gözlerine inanamayacak... Hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420102
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420102,
					"content": "Ne sürprizi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420103
					]
				},
				{
					"id": 230420103,
					"content": "Ah! Ödümü kopardın Gezgin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420104
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420104,
					"content": "Gizlice yaklaşmadım ki...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420105
					]
				},
				{
					"id": 230420105,
					"content": "Bir şey düşünüyordum, o yüzden seni fark etmedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420106
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420106,
					"content": "\"Parfüm\" diye bir şey duymuş muydun Gezgin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420107
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420107,
					"content": "Jawahir Nine gençliğinde parfüm yaptığını söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420108
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420108,
					"content": "İnsan bedenindeki ter kokusunu kapatıyormuş. Üstelik bazı parfüm çeşitlerinin canlandırıcı etkileri de varmış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420109
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420109,
					"content": "Raef sürekli köyü korumak zorunda. Sıcaktan çok terliyor ve hep güneşin altında başının döndüğünü söylüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420110
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420110,
					"content": "O yüzden ona bir şişe Nane parfümü yapmak istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420111
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420111,
					"content": "Jawahir Nine parfüm tarifini yazıp malzemeleri almama yardım etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420112
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420112,
					"content": "Gel gör ki parfüm yapmak beklediğimden çok daha zormuş. Malzemeleri hazırlamak bile çok uzun sürdü, üstelik bir sürü de hata yaptım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420113
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420113,
					"content": "Bu gidişle Raef ona parfüm yaptığımı öğrenecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420114
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420114,
					"content": "Bazı malzemeleri hazırlamama yardım eder misin Gezgin? Tabii dikkat et, Raef ne olduğunu anlamasın sakın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420115,
						230420117
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420115,
					"content": "Neden ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420116
					]
				},
				{
					"id": 230420116,
					"content": "Bu sürprizi uzun zamandır hazırlıyorum. Şimdi öğrenirse tüm hazırlıklarım mahvolacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420119
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420119,
					"content": "Çok zor iş değil. Gidip Bay Azalai'yi bul ve sipariş ettiğim malzemeleri al. Sonra da bir kova su getir. Bu kadar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420120
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420120,
					"content": "Şüphe uyandırmamaya dikkat et. Raef'in haberi olmasın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230420117,
					"content": "Hallederim o zaman...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420118
					]
				},
				{
					"id": 230420118,
					"content": "Tekrar teşekkürler. Merak etme, harcadığın zamana değecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420119
					],
					"speakerTitle": "Nermin"
				}
			]
		},
