				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Layla"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191530901,
					"content": "Tamamdır, sanırım şimdi anladım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530902
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530902,
					"content": "Pekala, neler buldun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530903
					]
				},
				{
					"id": 191530903,
					"content": "İlk olarak, Katayoun'dan gelen bilgilere dayanarak Perinin Rtawahist Darşanında bir öğrenci olduğunu varsayabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530904
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530904,
					"content": "Darşan dışından biri olma olasılığını göz ardı edebiliriz çünkü kütüphaneciyle konuşmadan o iki kitaba ulaşmak imkansız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530905
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530905,
					"content": "Sonra, çılgın yeteneklerini bir kenara bırakırsak görüldüğü yerlerin hepsi Akademi tarafından astrolojik gözlem için resmi olarak önerilen bölgelerdeydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530906
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530906,
					"content": "Başka bir deyişle, muhtemelen sadece araştırma yapıyor ve araştırmasının içeriği de benimkine çok benzer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530907
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530907,
					"content": "Sorduğum soru kolay değildi fakat buna rağmen sadece bir gün içinde cevap verebildi. Bu, onun benzer bir araştırma alanına hakim olduğunu gösteriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530908
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530908,
					"content": "Yani, bu mantıktan yola çıkarak yapmamız gereken, bir sonraki astrolojik gözlem alanında onu beklemek olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530909,
						191530910
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530909,
					"content": "Mantık yürütmen gayet başarılı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530911
					]
				},
				{
					"id": 191530911,
					"content": "Ah, pek bir şey yapmadım. Tahmin yürüttüğüm başka faktörler de var aslında...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530912
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530912,
					"content": "Ama bunun şimdilik bir önemi yok, hadi işe koyulalım. Elimizde bir ipucu olsa bile herhangi bir şey öğrenip öğrenemeyeceğimizi söylemek şu an için zor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191530913
					],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530913,
					"content": "Peri gelmezse sana neden böyle düşündüğümü anlatacağım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Layla"
				},
				{
					"id": 191530910,
					"content": "Bu yeteneğinle tezini tamamlamak hiç sorun olmamalı aslında.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191530911
					]
				}
			]
		}
	]
}