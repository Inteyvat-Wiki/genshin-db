			"dialogs": [
				{
					"id": 732580401,
					"content": "(Okumaya Devam Et...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732580402
					]
				},
				{
					"id": 732580402,
					"content": "\"Çelenkle harika görünüyor ve herkesle arasında bir bağ var, sanki o da bir Aranaraymış gibi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732580403
					],
					"speakerTitle": "Özensiz Yazılmış Not"
				},
				{
					"id": 732580403,
					"content": "#\"Nara {NICKNAME} ve Paimon şu anda dinleniyor. Hâlâ anlamıyorum, Naraların neden dinlenmesi gerekiyor ki? Ara verirsen arkadaşlarınla anı biriktiremezsin...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732580404
					],
					"speakerTitle": "Özensiz Yazılmış Not"
				},
				{
					"id": 732580404,
					"content": "#\"Ashvattha'yla buluşacağım. Ashvattha, Nara {NICKNAME} ve Paimon'u kabul edecek. Hepimiz ormanın çocuklarıyız.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732580405
					],
					"speakerTitle": "Özensiz Yazılmış Not"
				},
				{
					"id": 732580405,
					"content": "#\"Bu arada artık Aranyaka'da Nara {NICKNAME}, Paimon ve herkes hakkında bir sürü macera hikayesi vardır herhalde.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732580406
					],
					"speakerTitle": "Özensiz Yazılmış Not"
				},
				{
					"id": 732580406,
					"content": "#\"Nara {NICKNAME} ve Paimon Bijayı alıp Narana'ya yardım ettikten sonra Arana'yı çağırıp Aranyaka'daki hikayeleri okuyalım!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Özensiz Yazılmış Not"
				}
			]
		}
