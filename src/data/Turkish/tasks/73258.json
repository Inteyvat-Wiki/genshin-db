				{
					"id": 732580301,
					"content": "(Okumaya Devam Et...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732580302
					]
				},
				{
					"id": 732580302,
					"content": "\"Arama çiçekleri hazırladı ama Arama bunları ona veremeyecek diye korkuyor. Yine de Arana, her zaman korku iyi bir şey değildir der. Korkarsan korkunun gücüne inanırmışsın...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732580303
					],
					"speakerTitle": "Özensiz Yazılmış Not"
				},
				{
					"id": 732580303,
					"content": "\"Utsava Festivali başlamak üzere. Arama'nın uzun zamandır görmediği bir sürü arkadaşı Vanarana'ya döndü. Araja da bu boşluğu doldurmaktan memnun.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Özensiz Yazılmış Not"
				}
			]
		},
		{
			"id": 7325804,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
