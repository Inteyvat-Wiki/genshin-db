			},
			"dialogs": [
				{
					"id": 752650301,
					"content": "Hey dostum, burada çok güzel mallarım var... Dur bakalım, yine mi siz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650302
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650302,
					"content": "Size satmıyorum demiştim! Hadi kaybolun şimdi, kapatmayın dükkanın önünü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650303
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650303,
					"content": "Dur bakalım, sana özür dilemen için son bir şans veriyoruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752650304,
					"content": "Derdiniz ne sizin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650305
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650305,
					"content": "Sahte mal satıyorsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752650306
					]
				},
				{
					"id": 752650306,
					"content": "Ee? Ne olmuş yani? İşine baksana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manou"
				}
			]
		},
