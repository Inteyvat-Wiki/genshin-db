					"Manou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752650101,
					"content": "Hey dostum! Burada harika parçalarım var, fiyatlar da iyi! Göz atmak ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650102
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650102,
					"content": "Hı? Bunlar Koholazor oyuncakları değil mi? Paimon daha önce onları Sefa Yeli Pazarında görmüştü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752650103,
					"content": "Haklısın! Ama benimkiler daha ucuz, yarı fiyatına hatta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650104
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650104,
					"content": "Nasıl bu kadar ucuz olabiliyorlar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752650105
					]
				},
				{
					"id": 752650105,
					"content": "Hehe, üzümünü ye bağını sorma dostum. Benim de kendime göre yöntemlerim var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650106
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650106,
					"content": "Daha ucuz olabilirler ama renkleri biraz tuhaf duruyor... Bunlar çakma mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752650107,
					"content": "Çakma mı dedin? Sen ne anlarsın bücürük? Kaybol!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752650108
					],
					"speakerTitle": "Manou"
				},
				{
					"id": 752650108,
					"content": "Bas git hadi! Satmıyorum sana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manou"
				}
			]
		},
		{
