					"nextDialogs": [
						722420404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722420404,
					"content": "Sanırım şuradaki harabeler bize daha yakın. Hadi oradan başlayalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722420405,
					"content": "Bina insan demektir... En azından bir zamanlar burada olduklarını biliyoruz. Bir yerde insan varsa orada yazı da vardır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
