				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111030201,
					"content": "Bu buhurdanlık... Uygun gibi, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030202,
					"content": "En azından bu tapınak kadar harap bir halde değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030203,
					"content": "O zaman geriye... Yedi Yıldızlı Lambaları toplamak kaldı değil mi? Ne kadar erken başlarsak o kadar çabuk bitiririz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1110303,
			"completionStepIds": [
				1110303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110303",
							"2"
						],
						"stepId": 1110303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111030301,
					"content": "Ha? Nereye gitti? Tam buradaydı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030302,
					"content": "Almak için geldiğiniz şeyi aldıktan sonra beni unutacağınızı ve yolunuza devam edeceğinizi sanmıştım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030330,
					"content": "Aaa! Bu o adamın sesi! Merhaba? N-Neredesin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030303,
					"content": "Fiziki formumun varlığı bin yıldan uzun bir süre önce sona erdi. Daha önce şahit olduğunuz şey, Faniliğe Dönüş olarak bilinen Adeptus büyüsünün yarattığı bir illüzyondu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030304,
					"content": "Faniliğe Dönüş ayininde kullanılan Yedi Yıldızlı Lambaları ve buhurdanlığı aldığınıza göre artık fiziksel formum size görünür değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030305,
						111030306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030305,
					"content": "Yani sen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030308
					]
				},
				{
					"id": 111030308,
					"content": "Bir zamanlar, Rex Lapis'in bizzat Pervases adını verdiği Yakshalar tarikatında bir öğrenciydim. Ne var ki gücüm tükendi ve savaşta katledildim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030309,
					"content": "Bugün benim ölüm yıl dönümüm. Son dileğim modern Liyue'yi görmekti, ben de bu ayini burada yapma cüretinde bulundum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030310,
					"content": "Bu bir yana... Sizi buraya İblislerin Fatihi gönderdi, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030311,
					"content": "Birbirinizi tanıyorsunuz öyleyse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030312,
					"content": "Üzerinizde onun aurasını seziyorum ve karmasının ağır yükünü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030313,
					"content": "*iç çeker* Aradan binlerce yıl geçmesine rağmen hâlâ bu denli büyük acılar mı çekmek zorunda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030314,
					"content": "Gerçekten çok mahcubum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030315,
					"content": "Böyle söyleme Pervases! Liyue için hayatını feda ettin, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030316,
					"content": "Hayat değerli bir şey, evet... Ancak İblislerin Fatihi'nin taşıması gereken yükü düşündüğümde... *iç çeker* Ölüm bana kolay bir kaçış kapısı gibi geliyor. Hatta, bencilce bir boyun eğiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030317,
					"content": "Pervases...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030318,
					"content": "Ahah, özür dilerim. Doğum günleri neşeli günlerdir ancak aynı şekilde insanın ölüm yıl dönümünde melankolik olmaması da zor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030319,
					"content": "Faniliğe Dönüş büyüsü birazdan sona erecek. Kendinize iyi bakın ve lütfen İblislerin Fatihi'ne saygılarımı iletin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030320,
						111030321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030320,
					"content": "İletiriz!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030322
					]
				},
				{
					"id": 111030322,
					"content": "*iç çeker* Keşke bu yöreye özgü Izgara Kapan Balığından bir kez daha tadabilseydim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030323,
					"content": "Dalga ve fırtınayla balık avlar, rüzgar ve karla kötülüğü yok ederim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030324,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030325,
					"content": "Ha? Gitti sanki... Paimon en azından birinin Yaksha Pervases'i hatırlayacağını umut ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030326,
					"content": "Gitmeliyiz. Bir ara buraya gelip bir adakta bulunalım ama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030321,
					"content": "Sen de kendine iyi bak Pervases...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030322
					]
				},
				{
					"id": 111030306,
					"content": "S-Sen bir ha-hayalet misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030307
					]
				},
				{
					"id": 111030307,
					"content": "Ahaha... Öyle demek de yanlış olmaz. Adeptuslar ve hayaletler arasında ince bir çizgi var doğrusu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030308
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
