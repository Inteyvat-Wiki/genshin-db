			"dialogs": [
				{
					"id": 111031101,
					"content": "Ah! İşte buradasın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031102,
					"content": "Yetki Mührünü geri aldık. Almak ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031103,
					"content": "Teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031104
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111031104,
					"content": "Siparişinizi alabilir miyim efendim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031105
					],
					"speakerTitle": "Xiuhua"
				},
				{
					"id": 111031105,
					"content": "Bir tane Izgara Kapan Balığı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031106
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111031106,
					"content": "Elbette, hemen hazırlıyoruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031107
					],
					"speakerTitle": "Xiuhua"
				},
				{
					"id": 111031107,
					"content": "Ha? Bu defa Badem Tofusu almıyor mu? Hiç Xiao'nun tarzı gibi değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031108,
					"content": "Kapan Balığı Pervases'in en sevdiği yemekti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031109
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111031109,
					"content": "Tadı nasılmış bir bakmak istedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031110
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111031110,
					"content": "Ha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031111,
					"content": "Dalga ve fırtınayla balık avlar, rüzgar ve karla kötülüğü yok ederim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031112
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111031112,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031113
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111031113,
					"content": "Başka bir konu var mıydı? Yalnız yemeye alışkınım da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031114,
						111031115
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111031114,
					"content": "Seni rahatsız etmeyelim o zaman...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031116
					]
				},
				{
					"id": 111031116,
					"content": "A-ha! Böylece, Dedektif Paimon ve sadık gezgin davayı çözdüler ve sessizce uzaklaştılar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031115,
					"content": "Hadi Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031116
					]
				}
			]
		},
