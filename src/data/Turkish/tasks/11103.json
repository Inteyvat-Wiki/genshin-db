				"points": []
			},
			"dialogs": [
				{
					"id": 111030501,
					"content": "Ayin için gereken eşyaları topladınız mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030502
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030502,
					"content": "Hım.. Bu buhurdanlık ve lambalar... Tasarımları mükemmel adeta Adeptus büyülerinde kullanılmak için yapılmış gibiler. Nereden buldunuz bunları?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030503
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030503,
					"content": "Pervases adında bir Yakshadan aldık...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030504
					]
				},
				{
					"id": 111030504,
					"content": "Aa! Bir de... Sana selamlarını iletti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030505,
					"content": "Pervases...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030506
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030506,
					"content": "Evet, bu Pervases'in yapabileceği cinsten bir şeyin izlerini taşıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030507
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030507,
					"content": "Düşündüğüm gibi, Liyue'yi de geride bırakamamış gibi görünüyor... Umarım şu anki hali sayesinde huzur içinde yatabilir artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030508
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030508,
					"content": "İyi o zaman. Ayin için hazırlıklara başlayalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030509
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030509,
					"content": "Buhurdanlığı ortaya yerleştir ve Yedi Yıldızlı Lambaları etrafına koy. Alanı soğuk nesnelerle donat. Bu adım tamamlandıktan sonra devam edeceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030510
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030510,
					"content": "Tamam, bu iş görür. Şimdi, sıradaki aşama ise Rüya Bulucusu büyüsünü yapmanın püf noktası.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030511
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030511,
					"content": "Bu ayini yapmanın dört adımı var: Tütsü yakmak, meditasyon yapmak, büyülü sözleri söylemek ve ok atmak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030512
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030512,
					"content": "Ah... Tam bir saçmalığa benziyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030513,
					"content": "Adeptus büyüleri, Adeptusların binlerce yıllık çalışmalarının meyvesidir. Onların bu mistik öğretilerini \"saçmalık\" olarak yabana atma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030514
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030514,
					"content": "Ciddiye alınmaması, tekniğin kişinin kendi bedenini yok etmesine ya da ruhun bedenden kalıcı olarak ayrılmasına neden olabilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030515
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030515,
					"content": "Aay! Kes şu konuşmayı! Paimon çok üzgün!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030516,
					"content": "Tütsü yakarken, Rex Lapis'e olan hürmetlerimizi sunarak tütsüyü buhurdanlığa yerleştiririz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030517
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030517,
					"content": "Meditasyonun amacı, kendimizi önemsiz düşüncelerden arındırmak ve yaptığımız büyünün amacına odaklanmaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030518
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030518,
					"content": "Ardından, yüksek sesle büyüyü söyleyeceğiz: \"Devayaksha, günahı ortaya çıkar!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030519
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030519,
					"content": "Son olarak, sözleşmemiz için hükümlerini almak üzere Yaksha heykellerinin her birine doğru birer ok atacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030520
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030520,
					"content": "Her şey yolunda giderse Yıldızkapan'ın ruhu hemen buraya gelecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030521,
						111030522
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030521,
					"content": "Anlaşıldı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030523
					]
				},
				{
					"id": 111030523,
					"content": "Başka sorunuz yoksa başlayalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030524
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030524,
					"content": "Hımm... Pekala... Tütsü yakarak başlayalım, olur mu? Yani, Rex Lapis'e ve her şeye hürmetlerimizi sunarak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030522,
					"content": "*yutkunur*",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030523
					]
				}
			]
		},
