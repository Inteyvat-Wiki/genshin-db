			},
			"dialogs": [
				{
					"id": 111031001,
					"content": "Selam. Yıldızkapan burada kalıyor, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031002,
					"content": "Yıldızkapan... Hımm... Maske takan şu sahte Adeptusu mu diyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031003
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 111031003,
					"content": "Buraya Wang Ping'an adıyla giriş yaptı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031004,
						111031005
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 111031004,
					"content": "Bu... Gerçekten sıradan bir isim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031006
					]
				},
				{
					"id": 111031006,
					"content": "O çoktan çıkış yaptı. Tek başına kutsal yolculuğa çıkmak istediğini söyledi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031007
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 111031007,
					"content": "Ah evet. Ayrıca, gelip onu sormaları halinde bu mektubu \"konuşan peri\" ile birlikte seyahat eden bir gezgine vermemi istedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031008
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 111031008,
					"content": "Konuşan peri mi... O da kim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031009,
					"content": "Her neyse, o gezgin sen olmalısın. İşte mektup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031010
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 111031010,
					"content": "Bize mektup bırakması ne kadar tuhaf. Yoksa bizi son bir kez daha kandırmaya mı çalışıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031011,
					"content": "Hadi, aç! Paimon çok merak ediyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031019
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031019,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031012,
					"content": "Bize birkaç güzel hatıralık bırakmış gibi görünüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031013,
					"content": "Yanında da... Oleeeyy! Yetki Mührü!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031014
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031014,
					"content": "Paimon uzun zamandır onun gibi bir kötü adamla tanışmamıştı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111031015,
						111031016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031015,
					"content": "Hakikaten duygulandım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031017
					]
				},
				{
					"id": 111031017,
					"content": "Aynen... Neyse, gidip bu Yetki Mührünü Xiao'ya götürelim, olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111031016,
					"content": "Hepsi Xiao sayesinde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031017
					]
				},
				{
					"id": 111031005,
					"content": "Görünüşe göre epey sıradan bir insanmış.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111031006
					]
				}
			]
		},
