					"content": "Artık bize inanıyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030903
					]
				},
				{
					"id": 111030903,
					"content": "Evet! Evet, inanıyorum! Öleceğim sandım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030906
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111030906,
					"content": "Nasıl oldu da sizinle tanışma talihsizliğini yaşadım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030907
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111030907,
					"content": "Lütfen, yüce Adeptus hayatımı bağışla. Bunu bir daha asla yapmayacağım, yemin ederim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030908
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111030908,
					"content": "Ruhunu buraya çağırdık ama bizler Adeptus değiliz. Ama o Adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030909,
					"content": "Halkı şarlatanlıklarla kandırıyor, Adeptus kılığına giriyor, iblisleri yok etmeden kovuyor ve yaşama karşı büsbütün bir saygısızlıkta bulunuyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030910
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030910,
					"content": "Bir gün ektiğini biçeceksin... Cehennemi hayatlarına davet edenlerin kurtuluşu yoktur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030911
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030911,
					"content": "Ah... Ben... Sen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030912
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111030912,
					"content": "Görünüşe göre Xiao onu epey korkuttu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030913,
					"content": "Ey büyük Adeptus... Adınızı sormamda bir mahsur var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030914,
						111030915
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111030914,
					"content": "O, İblislerin Fatihi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030916
					]
				},
				{
					"id": 111030916,
					"content": "Gerçekten sizsiniz! Gerçekten sizsiniz! Hayatım boyunca hiç İblislerin Fatihi, Bekçi Yaksha'nın ta kendisiyle karşılaşabileceğimi düşünmemiştim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030917
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111030917,
					"content": "Xiao'yu biliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030918,
					"content": "Tabii ki! Büyükbabam bir halk bilimciydi. Çocukluğum İblislerin Fatihi'nin hikayelerini dinleyerek geçti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030919
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111030919,
					"content": "O gün bu gündür Yakshalar hakkındaki kitapların fanatik bir koleksiyoncusuyum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030920
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111030920,
					"content": "Ancak, büyükbabamın kişisel eşyalarını karıştırırken bir Yetki Mührü bulduğumdan beri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030921
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111030921,
					"content": "Önceleri sadece eğlenmek için Adeptusları taklit ediyordum... Sonra ise yavaş yavaş doğru yoldan uzaklaşmaya başladım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030922
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111030922,
					"content": "Yani durumu özetlemek gerekirse... Xiao'nun en büyük hayranı mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030923
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030923,
					"content": "E-Evet. İblislerin Fatihi'ne bizzat şahit olmama izin verdiğiniz için ikinize de teşekkür ederim. Adeta bir hayalim gerçek oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030924
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111030924,
					"content": "Ah, niyetimiz pek bu değildi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030925
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030925,
					"content": "Lütfen, İblislerin Yüce Fatihi'nin huzurunda bu yemini etmeme izin verin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030926
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111030926,
					"content": "Kötülüğe sırtımı döneceğime, dürüst bir hayat süreceğime ve Adeptusların adına bir daha asla leke sürmeyeceğime yemin ederim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030927
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111030927,
					"content": "Yeminini unutmayacağım... Git şimdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030928
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030928,
					"content": "Teşekkür ederim... Bağışlayıcılığınız için binlerce kez teşekkür ederim... Liyue için yaptığınız her şey için de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030929
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111030929,
					"content": "Yemin ederken çok içten görünüyordu. Sanırım artık kimseyi kandıramayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030930
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030930,
					"content": "Bekle! Yetki Mührünü henüz geri almadık. Yarın ilk iş onu aramaya Wangshu Hanına gidelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030915,
					"content": "O, Bekçi Yaksha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030916
					]
				},
				{
					"id": 111030904,
					"content": "Şu \"Yüce Olan\" saçmalığını sürdürmeye devam edecek miyiz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030905
					]
				},
				{
					"id": 111030905,
					"content": "H-Hayır, hayır, bir daha asla! A-Az kalsın ölüyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030906
					],
					"speakerTitle": "Yıldızkapan"
				}
			]
		},
		{
			"id": 1110310,
			"completionStepIds": [
				1110310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
