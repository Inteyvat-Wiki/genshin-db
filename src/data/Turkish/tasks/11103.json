			},
			"dialogs": [
				{
					"id": 111030101,
					"content": "Ruh göklere yükselir, dünya dönerken beden dinlenir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030102
					],
					"speakerTitle": "Pervases"
				},
				{
					"id": 111030102,
					"content": "Şey... Böldüğüm için üzgünüm ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030103,
					"content": "Buhurdanlık ve birkaç lamba ödünç almak istiyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030104
					]
				},
				{
					"id": 111030104,
					"content": "Daha neler... Bu da mı başıma gelecekti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030105
					],
					"speakerTitle": "Pervases"
				},
				{
					"id": 111030105,
					"content": "İki kişi gelir tapınağa, ne tanrıları ve Adeptusları aramak ne de onlara tapmak için, kendi amaçları uğruna ibadet gereçlerini çalmak için. Ahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030106
					],
					"speakerTitle": "Pervases"
				},
				{
					"id": 111030106,
					"content": "İstemenin kabalık olduğunu biliyoruz ancak onlara sadece kısa bir süreliğine ihtiyacımız var. Sahiden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030107,
					"content": "Rüya Bulucusu ayini için, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030108
					],
					"speakerTitle": "Pervases"
				},
				{
					"id": 111030108,
					"content": "Ne? Bunu nasıl bildin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030109,
					"content": "Düşündüğünden çok daha uzun süredir bu tapınaktayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030110
					],
					"speakerTitle": "Pervases"
				},
				{
					"id": 111030110,
					"content": "Belki de sadakatimin mükafatı olarak Adeptus büyüleri hakkında biraz bilgi bahşedilmiştir bana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030111
					],
					"speakerTitle": "Pervases"
				},
				{
					"id": 111030111,
					"content": "Vay canına. Paimon daha önce hiç bunun olduğunu duymamıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030112,
					"content": "Önemli değil. İhtiyacınız olanı alın. Bu eşyaların işinize yarayabilecek olması ne güzel bir tesadüf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030113
					],
					"speakerTitle": "Pervases"
				},
				{
					"id": 111030113,
					"content": "Nasılsa burada pek bir amaca hizmet etmediler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030114,
						111030116
					],
					"speakerTitle": "Pervases"
				},
				{
					"id": 111030114,
					"content": "Aklına takılan bir şey mi var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030115
					]
				},
				{
					"id": 111030115,
					"content": "Hah. Dert etmeniz gereken bir şey değil. Lütfen, dilediğinizi alın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pervases"
				},
				{
					"id": 111030116,
					"content": "Peki o zaman, teşekkürler!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030117
					]
				},
				{
					"id": 111030117,
					"content": "Rica ederim! Lütfen, dilediğinizi alın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pervases"
				}
			]
		},
		{
			"id": 1110302,
			"completionStepIds": [
				1110317
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
