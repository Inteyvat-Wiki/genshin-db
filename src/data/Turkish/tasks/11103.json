						111030703
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030703,
					"content": "Gerisini bana bırakın. Siz ikiniz onu karşılamaya hazır olun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030704
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111030704,
					"content": "Yüce Olan nerede? Ha? Siz ikiniz tanıdık geliyorsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030705
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111030705,
					"content": "Yüce Olan'ın vücudunun nesi var? Hafif hissediyor, tüy gibi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030706,
						111030709
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111030706,
					"content": "Adeptus büyüsü ile ruhunu çağırdık.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030707
					]
				},
				{
					"id": 111030707,
					"content": "Adeptus büyüsü mü? Hahaha! Yüce Olan'ın, benim huzurumda Adeptus kılığına girmeye cüret mi ediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030708
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111030708,
					"content": "Yüce Olan'ın şu anki konumu meselesine gelirsek... Biraz evvel Wangshu Hanında uyuyup kaldığıma yemin edebilirim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030712
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111030712,
					"content": "Bekle... Bu... Tabii ki öyle! Haha, benim gibi bir Adeptustan da bekleneceği üzere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030713
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111030713,
					"content": "Gerçekten bir rüyada olmalıyım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030714
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111030714,
					"content": "Öff... Bu adam ümitsiz vaka, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030715,
						111030716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030715,
					"content": "Rüya görmüyorsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030717
					]
				},
				{
					"id": 111030717,
					"content": "Ha? Bu da ne demek şimdi? Gerçekten rüyalarımda böyle bir küstahlığa izin vereceğimi mi sanıyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030718
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111030718,
					"content": "Pekala, ona haddini bildirmenin vakti geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111030716,
					"content": "Nihayetinde rüya görenler, acıyı hissetmezler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030717
					]
				},
				{
					"id": 111030709,
					"content": "Bil bakalım ne oldu? Çoktan öldün.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111030710
					]
				},
				{
					"id": 111030710,
					"content": "Öldüm mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030711
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111030711,
					"content": "İmkansız! Wangshu Hanında huzur içinde yatmaktaydım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111030712
					],
					"speakerTitle": "Yıldızkapan"
				}
			]
		},
