			"dialogs": [
				{
					"id": 200370501,
					"content": "Mektubumu teslim ettin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370502
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370502,
					"content": "Glory iyi dileklerini iletti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370503
					]
				},
				{
					"id": 200370503,
					"content": "Oh be... En azından o kadar sessiz kalmama rağmen bana sinirli değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370504
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370504,
					"content": "Başından beri Mondstadt'taysan Liyue Limanını nereden biliyorsun sen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200370505,
					"content": "Evet... Hikayelerimin hepsi Büyük Kumandan'ın bana anlattıklarından alıntı. Her yeri gezip görmüş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370506
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370506,
					"content": "Her neyse. Tekrar teşekkür ederim. Çok yardımcı oldun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370507
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370507,
					"content": "Bu Karahindiba Tohumlarını al. Kendim tek tek topladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370508
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370508,
					"content": "Glory bir daha Karahindiba Tohumu istediğinde ona yardımcı olursan sevinirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				}
			]
		}
	]
