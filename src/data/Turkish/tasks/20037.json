			"dialogs": [
				{
					"id": 200370301,
					"content": "Merhaba. Bu sesi biliyorum... Gezgin! Sensin değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370302
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370302,
					"content": "Seni buraya hangi rüzgar attı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370303
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370303,
					"content": "Birisi sana bu mektubu getirmemi istedi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370304
					]
				},
				{
					"id": 200370304,
					"content": "Bir mektup... Bana mı? Kim bana mektup gönderir ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370305
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370305,
					"content": "... Godwin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370306
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370306,
					"content": "Onu gördün mü? O zaman bu, iyi olduğu anlamına geliyor. Ne zaman döneceğini söyledi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370307
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370307,
					"content": "Pardon, sorduklarımı boş ver. Bu soruları yanıtlayamayacak kadar meşguldür zaten. Üzerine daha fazla baskı yapmak istemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370308
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370308,
					"content": "Ama mektubu bana okur musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370309
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370309,
					"content": "Sessizce... İkimizden başkası duymasın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370310
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370310,
					"content": "Tamam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370311
					]
				},
				{
					"id": 200370311,
					"content": "Vay be, çok güzel okudun... Bunu sık sık yapıyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370312
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370312,
					"content": "Bu da mektubun sonu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370313
					]
				},
				{
					"id": 200370313,
					"content": "Liyue Limanı... Vay be, demek Godwin gerçekten de dünyayı geziyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370314
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200370314,
					"content": "Teşekkür ederim, bu mektubu saklayacağım. <color=#00E1FFFF>Godwin'i</color> bir daha görürsen hep aklımda olduğunu söyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370315
					],
					"speakerTitle": "Glory"
				}
			]
		},
