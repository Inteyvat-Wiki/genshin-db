			"dialogs": [
				{
					"id": 200370101,
					"content": "Mondstadt'a dönmeye çok hazırım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370102
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370102,
					"content": "Gezgin! Selam! Senden bir iyilik isteyebilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370103
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370103,
					"content": "Gördüğün üzere ben bir Şövalyeyim ve şu anda devriyedeyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370104
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370104,
					"content": "Kız arkadaşıma çok önceden, sağ salim olduğumu söylemek için bir mektup göndereceğime söz vermiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370105
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370105,
					"content": "Sonra işler yığılınca göndermeyi unuttum... Bu <color=#00E1FFFF>mektubu</color> benim için ona götürebilir misin? Adı <color=#00E1FFFF>Glory</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370106
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370106,
					"content": "Bir dakika, Glory mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370107
					]
				},
				{
					"id": 200370107,
					"content": "Görme engelli kız... Karahindiba Tohumu toplatan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200370108,
					"content": "Herhalde sen Godwin'sin. Glory senden bahsetmişti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200370109,
					"content": "Ne? Glory'yi nereden tanıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370110
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370110,
					"content": "Onun için yapmamızı istediği bir iş vardı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370111
					]
				},
				{
					"id": 200370111,
					"content": "Onun için iş mi yaptınız? Umarım çok tehlikeli bir şey değildi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370112
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370112,
					"content": "Sadece Karahindiba Tohumu toplamamızı istedi, o kadar. Onları rüzgara bıraktığında kalbinin arzularını sana taşıyabileceklerini söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200370113,
					"content": "Karahindiba Tohumları mı? Bu tam da benim Glory'min yapacağı bir şey.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370114
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370114,
					"content": "Bir saniye, Mondstadt'tan uzakta bir yerlerde olduğunu söylemişti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370115
					]
				},
				{
					"id": 200370115,
					"content": "Evet, plan öyleydi... Sana olayı anlatayım ben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370116
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370116,
					"content": "Büyük Kumandan'ın Mondstadt'tan ayrılıp beş şövalyeden dördünü yanında götürdüğünden haberin var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370117
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370117,
					"content": "İşte o keşif görevine atananlardan biri de bendim, ama ne yazık ki... Tam ayrılmaya hazırlanırken Glory'nin bana verdiği hatıralığı kaybettiğimi fark ettim. Ben onu bulana kadar ekip çoktan ayrılmıştı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370118
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370118,
					"content": "Hâlâ onlara nasıl yetişeceğimi bilmiyorum ve o sırada da burada dönüp duruyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370119
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370119,
					"content": "Mondstadt'a dönmeyi kendime yediremiyorum. Öylece geri dönersem şövalyeler benim hakkımda ne düşünür tahmin bile edemiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370120
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370120,
					"content": "Ayrıca... Glory'ye dünyanın her yerinden mektuplar ve hediyeler göndereceğime söz vermiştim. Ona dünyaları göndereceğim demiştim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370121
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370121,
					"content": "Mondstadt'tan bile çıkamadığımı duyarsa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370122
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370122,
					"content": "İtibarını kaybetmek istemiyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200370123,
					"content": "Lütfen bu <color=#00E1FFFF>mektubu</color> <color=#00E1FFFF>Glory'ye</color> götür olur mu? Muhtemelen benim için çok endişelenmiştir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370124,
						200370126
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370124,
					"content": "Tamam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370125
					]
				},
				{
					"id": 200370125,
					"content": "Sana ne kadar teşekkür etsem az Gezgin! Ama lütfen söylediğim her şeyi sır olarak sakla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370126,
					"content": "Sen de karahindiba hattını denesene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370127
					]
				},
				{
					"id": 200370127,
					"content": "Glory'ye söylemek istediğim çok fazla şey var. Söyleyeceklerim bir avuç Karahindiba Tohumunun taşıyacağından fazla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370128
					],
					"speakerTitle": "Godwin"
				},
				{
					"id": 200370128,
					"content": "Mektubumu götürdüğün için teşekkür ederim. Unutma, burada konuşulanlardan bahsetmek yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Godwin"
				}
			]
		},
