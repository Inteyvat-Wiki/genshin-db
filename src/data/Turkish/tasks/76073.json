					"Netochka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760034015,
					"content": "Katya'nın yemekleri harika... Novokitezhgrad biraz daha bekleyebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034016,
						760034002,
						760034011
					],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760034016,
					"content": "Yine karşılaştık Netochka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760034017
					]
				},
				{
					"id": 760034017,
					"content": "Aa! Düello için mi geldiniz? B-Bu sürpriz saldırı sayılır yalnız! İlla savaşacaksak bari yeri ve zamanı belirleyelim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034018
					],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760034018,
					"content": "Nasha Kasabası'nı doğru düzgün keşfetme fırsatım olmadı, o yüzden burada biraz daha güzel vakit geçirmek istiyorum. Düelloyu daha sonra yapsak olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760034002,
					"content": "Novokitezhgrad hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760034003
					]
				},
				{
					"id": 760034003,
					"content": "Orada yaşarken çok bunaltıcı geliyordu. Ama ayrıldığımdan beri özler oldum... İlk defa evden bu kadar uzak kalıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034004
					],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760034004,
					"content": "Memleketimde olduğu gibi diğer yerlerde de bir sürü Fey görürüm diye düşünmüştüm. Snezhnograd'da bile epey Fey vardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034005
					],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760034005,
					"content": "Ama Nod-Krai'a geldiğimden beri bir tane bile görmedim. Paimon da Fey olmadığını söylüyor. Hımm... Buranın iklimiyle ilgisi yoktur, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034013
					],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760034013,
					"content": "Zira burada kar fırtınası olmuyor, ayrıca sobasız dışarıda kalsan bile hayatta kalmanın bir yolu bulunur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760034014
					],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760034014,
					"content": "Bir keresinde Nod-Krai'da Novokitezhgrad likörü içen birini gördüm. İçki sektörümüz de madencilik sektörümüz kadar meşhur aslında. Ama memleketimden gelen bir şey görmek beni duygulandırdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Netochka"
				},
				{
					"id": 760034011,
					"content": "Görüşürüz!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760034012
					]
				},
				{
					"id": 760034012,
					"content": "Evet! O zamana kadar ikimize de iyi şanslar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Netochka"
				}
			]
		},
