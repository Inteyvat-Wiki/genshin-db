					}
				]
			},
			"dialogs": [
				{
					"id": 790610301,
					"content": "<color=#FFCC33FF>İçerideki dünya</color> da çok kötü sayılmaz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610302
					]
				},
				{
					"id": 790610302,
					"content": "Doğru söylüyorsun. Sonuçta burası senin evin Esnoir. Paimon burayı çok sevdiğini biliyor. Ayrıca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610303,
						790610304,
						790610305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790610303,
					"content": "Tüm yakın arkadaşların burada yaşıyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610306
					]
				},
				{
					"id": 790610306,
					"content": "Kesinlikle! Bunları kaybetmekten korkuyorum ve sürekli endişe içerisindeyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610307
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610307,
					"content": "Her şey çok güzel, hatta mükemmel diyebilirim. Ben onların değişmesini istemiyorum, kendim de değişmek istemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610308
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610308,
					"content": "Ama... Dış dünyaya gitmek her şeyi değiştiriyor, değil mi Rozel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610309
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610309,
					"content": "Evet, kesinlikle değiştiriyor. Sana yalan söyleyecek değilim, hele ki seni üzmeyi asla istemem sevgili Esnoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610310
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610310,
					"content": "Tamam... Tamam. İçinden geçenleri anlayabiliyorum, senin de beni anladığından eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610311
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610311,
					"content": "Karar vermeden önce davetini enine boyuna düşünmek istiyorum. Her neyse, gel de en azından huzur içinde şu çayımızı içelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610312
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610312,
					"content": "Tamam. Sana eşlik edeceğim Esnoir. Bir sonraki seyahatime daha var. Bu konuyu o zamana kadar birlikte düşünebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610304,
					"content": "Bir sürü güzel çiçek ve...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610306
					]
				},
				{
					"id": 790610305,
					"content": "Harika pasta da var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610306
					]
				}
			]
		},
		{
			"id": 7906104,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7906102",
							"2"
						],
						"stepId": 7906102,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"0",
							"1",
							"79061"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790610401,
					"content": "Rozel, belki... Ben de seninle gelebilirim. Ancak... Nereden hazırlanmaya başlamam gerektiğini bile bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610402
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610402,
					"content": "Çok kolay. Reçelin, ekmeğin ve merakın hazır olsun, üzerine de rahat giysiler giyip yanına da yedeklerini aldın mı tamamdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610403
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610403,
					"content": "Son olarak da psikolojik olarak kendini hazırla. Çünkü yanına aldığın o şeylerin bazılarını yolda atman gerekebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610404
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610404,
					"content": "Hımm, kulağa karmaşık geliyor. Onları asla atmak istemem çünkü onlar bana ait ve benim en kıymetlilerim. Çok seviyorum onları.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610405
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610405,
					"content": "Onları attıktan sonra çok daha değerli yeni şeyler bulacaksın ama sevgili Esnoir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
