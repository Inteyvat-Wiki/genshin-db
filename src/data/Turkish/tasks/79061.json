				{
					"id": 790610601,
					"content": "\"Bu mektup komşularım, arkadaşlarım, fener ve küçük çiçek için.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610602
					],
					"speakerTitle": "Özensiz Yazılmış Mektup"
				},
				{
					"id": 790610602,
					"content": "\"Rozel ile bir seyahate çıkmak üzereyim. Salıncağımı, masamı ve taburemi istediğiniz gibi kullanabilirsiniz.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610603
					],
					"speakerTitle": "Özensiz Yazılmış Mektup"
				},
				{
					"id": 790610603,
					"content": "\"Her şey gönlünüzce olsun.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610604
					],
					"speakerTitle": "Özensiz Yazılmış Mektup"
				},
				{
					"id": 790610604,
					"content": "\"Komşunuz Esnoir.\"",
