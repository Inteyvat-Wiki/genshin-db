					}
				]
			},
			"dialogs": [
				{
					"id": 790610201,
					"content": "Evet, var. <color=#FFCC33FF>Dış dünyada</color> daima keşfedilecek yeni şeyler var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610202
					]
				},
				{
					"id": 790610202,
					"content": "Doğru! Bir sürü eğlence ve bolca yiyecek var, hatta birçok ilginç şeyle ve harika insanlarla karşılaşabilirsin. Mesela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610203,
						790610204,
						790610205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790610203,
					"content": "Her şeyin sadece güzelliğine odaklanan insanlar bulabilirsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610206
					]
				},
				{
					"id": 790610206,
					"content": "Gerçekten mi? İnanamıyorum. Dış dünyanın sadece \"değer\" bilincine sahip olduğunu ve şapka takmak isteyip de buna cesaret edemeyenlerle dolu olduğunu sanırdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610207
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610207,
					"content": "Hımm, bunu daha çok... Üzerinde çeşitli çikolataların olduğu bir pasta gibi düşünebilirsin! Her ısırıkta farklı bir tat alırsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790610208,
					"content": "Bu, tüm çikolataların aynı tatta olmasından katbekat iyidir. Yoksa ortaya çok sıradan bir pasta çıkardı, öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610209,
						790610210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790610209,
					"content": "Haklısın Paimon! Çok haklısın!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610211
					]
				},
				{
					"id": 790610211,
					"content": "Bu kadar uzun süre haşır neşir olduktan sonra nasıl olmayalım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790610212,
					"content": "Öyle mi? Bunu düşünmek için biraz zamana ihtiyacım olacak. Ama belki de... Birazcık seyahatten bir şey olmaz, ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610213
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610213,
					"content": "Acele etmene gerek yok Esnoir. Bir sonraki seyahatime daha var. Bu konuyu o zamana kadar birlikte düşünebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610210,
					"content": "Bakıyorum da buraların jargonuna epey hakimsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610211
					]
				},
				{
					"id": 790610204,
					"content": "Işıl ışıl yanan ve asla solmayan ideallere tanıklık edebilirsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610206
					]
				},
				{
					"id": 790610205,
					"content": "Hayallerini gerçekleştirmek uğruna gece gündüz çalışan insanlarla tanışabilirsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610206
					]
				}
			]
		},
		{
