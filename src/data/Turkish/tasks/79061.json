			"dialogs": [
				{
					"id": 790610501,
					"content": "Kusura bakma Rozel. Ben... Yine de seninle gelemem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610502
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610502,
					"content": "Burada kalmak bana yetiyor da artıyor bile. Hem sen seyahatten döndüğünde seni burada karşılayan biri olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610503
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610503,
					"content": "Ama Esnoir, ben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610504
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610504,
					"content": "Ben ne zeki biriyim ne de cesurum Rozel. Ama inanıyorum ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610505
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610505,
					"content": "İnanıyorum ki rüzgarlar ağaçların arasından esiyor, ırmaklar da gölden akıyor ve her bir döngü en başa sarıyor. Sonunda ise her şey başladığı yere geri dönüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610506
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610506,
					"content": "Belki de onca değişimi geçirdikten sonra son istekleri yine de... Eski benliklerine kavuşmaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610507
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610507,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610508
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610508,
					"content": "Ben seni burada, memleketimizde bekleyeceğim dostum. Her zaman olduğu gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Esnoir"
				}
			]
		},
