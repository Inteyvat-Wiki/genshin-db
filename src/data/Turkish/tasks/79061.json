			"dialogs": [
				{
					"id": 790610101,
					"content": "Rozel, beni kaç defa çağırırsan çağır seninle birlikte yolculuğa çıkmayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610102
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610102,
					"content": "Benim arkadaşımsın, evet ve hep de öyle kalacaksın. Seni seviyorum, ama... Seyahat etmeyi sevmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610103
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610103,
					"content": "Esnoir, düşündüğün kadar korkunç bir şey değil. Sadece bir gezi, hepsi o kadar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610104
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610104,
					"content": "Dış dünyada bizim köyümüzde olmayan çiçekler ve daha önce hiç görmediğimiz insanlar var. Oradaki bulutların şekli bile buradakilerden farklı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610105
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610105,
					"content": "Sana getirdiğim tohumu hatırlıyor musun? Daha önce o şekil ve renkte bir çiçek görmediğine adım gibi eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610106
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610106,
					"content": "Şu anda sadece bir tohum. Onu ekeceğim, bakalım nasıl bir şey çıkacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610107
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610107,
					"content": "Benimle birlikte gelirsen o çiçeği kendi gözlerinle görebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610108
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610108,
					"content": "Rozel... Kusura bakma, cidden dış dünyaya gitme gibi bir niyetim yok, o seyyahlar gibi olmak da istemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610109
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610109,
					"content": "Sürekli halıların değeri hakkında endişelenip duruyorlar, güzel şapkalar umurlarında bile değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610110
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610110,
					"content": "Yaptığınız seyahatler sizi böyle değiştirdi işte ve bu beni korkutuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610111
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610111,
					"content": "Haklısın. Ama çantalarını tıka basa doldurdukları haritaları, bitki numunelerini ve gezi günlüklerini gördün mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610112
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610112,
					"content": "Çalılıkların ve ağaçların arasından esen rüzgar, gölden geçerek akan ırmaklar gibiyiz... Farklı şeylerle karşılaştığımız için biz de farklı kişilere dönüşüyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610113
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610113,
					"content": "Seyahatler bizi böyle değiştiriyor işte, ben de korkuyorum... Ama bu değişiklikler için bir yandan da şükrediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610114
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610114,
					"content": "Ben bunu iki tarafına da krema sürülmüş bir ekmek dilimine benzetiyorum. Ne kadar dikkatli tutmaya çalışırsan çalış eline yüzüne bulaştırmaman imkansız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610115
					],
					"speakerTitle": "Rozel"
				},
				{
					"id": 790610115,
					"content": "Bu durumda ben o kremayı tek tarafa sürerim. Böylece belki farklı lezzetler deneyebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610116,
						790610117
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610116,
					"content": "Kötü bir fikir değil. Gayet doyurucu olacağına eminim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610118
					]
				},
				{
					"id": 790610118,
					"content": "Ah siz, nihayet gelmişsiniz! Rozel de bana dış dünyanın ne kadar harika olduğundan bahsediyor ve beni birlikte yolculuğa çıkmaya davet ediyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790610119
					],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610119,
					"content": "O dünyanın ne kadarını biliyorsunuz? Gerçekten de... Onun anlattığı kadar var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Esnoir"
				},
				{
					"id": 790610117,
					"content": "Hiç de fena bir fikir değil. Ellerin de kirlenmez hem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790610118
					]
				}
			]
		},
		{
			"id": 7906102,
