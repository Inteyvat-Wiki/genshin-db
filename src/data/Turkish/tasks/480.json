			},
			"dialogs": [
				{
					"id": 4820202,
					"content": "Yani şey, okudum ama...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4820204
					]
				},
				{
					"id": 4820203,
					"content": "Kuralları tam olarak anladım diyemem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4820204
					]
				},
				{
					"id": 4820201,
					"content": "Harika, gelmişsin! Uçuş kılavuzunu dikkatlice okudun mu? Kuralları not aldın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820202,
						4820203
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820204,
					"content": "Çok zahmetli iş gerçekten. Benim de başımdan geçti, oradan biliyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820205
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820205,
					"content": "Kılavuzun dili aşırı sıkıcıydı... Hiç ama hiç sevemedim. Jean'e sakın söylemeyin ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820206
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820206,
					"content": "Ya? Hımm... Paimon kılavuzda çok harika hikayeler olduğunu düşünmüştü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4820207,
					"content": "Harika hikayeler mi? Aa, Ek bölümdeki örneklerden bahsediyorsun galiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820208
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820208,
					"content": "Bazıları hoşuma gitmişti. En çok hoşuma giden de yasa dışı Rüzgar Bodurlopu kalkışıyla ilgili olan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820209
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820209,
					"content": "Anlaşılan o ki bir Rüzgar Bodurlopu patlatıp rüzgar şiddetlendiğinde kalkış yaparsan seni çok ama çok yükseğe fırlatırmış... Bunu denemeyi çok istiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820210
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820210,
					"content": "Yok, o hikaye değil. Paimon uçmayı öğrenmek isteyen minik kuşla ilgili olan hikayeden bahsediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4820211,
					"content": "Ah... Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820212
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820212,
					"content": "Bir bakayım şuna... Eyvah, bu küçükken okuduğum hikaye kitabı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820213
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820213,
					"content": "Tüh, özür dilerim! İki kitabı da aynı yere koymuşum ve çıkarken yanlış kitabı almışım galiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820214
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820214,
					"content": "Hikaye kitabıyla talimat kılavuzunu nasıl karıştırabilirsin ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4820215,
					"content": "Ahh... Çok utanıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820216
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820216,
					"content": "Belki de... İçten içe o masalın bana gerçekten uçmayı öğreten şey olduğunu düşündüğüm içindir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820217
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820217,
					"content": "\"İhtiyacınız olan şey rüzgar değildi. Bu dünyanın ilk uçan kuşları olmanızı sağlayan şey cesaretinizdir.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820218
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820218,
					"content": "Bu cümleler kanatlarla uçup Kaşif olmam, hatta Mondstadt Uçuş Şampiyonu olmam için beni yüreklendirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820219
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820219,
					"content": "... Her neyse, şimdi sınava geri dönelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820220
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820220,
					"content": "Gerilmene gerek yok, her zamanki gibi uç yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820221
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4820222,
					"content": "Hazırım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4820221,
					"content": "Tamam o zaman. Yapman gereken tek şey <color=#00E1FFFF>işaretli rotayı</color> takip edip bitişe ulaşmak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820222
					],
					"speakerTitle": "Amber"
				}
			]
		},
