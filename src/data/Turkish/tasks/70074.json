			"dialogs": [
				{
					"id": 700740401,
					"content": "İnanılmaz! Demek böyle yapılıyormuş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740402
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 700740402,
					"content": "Off... Paimon neden bu tepkiyi daha önce yüz kez duymuş gibi hissediyor acaba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740403,
					"content": "Hımm... Evet, bu iş görür! Şekli, dokusu, kalitesi... Mükemmel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740404
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740404,
					"content": "Bir odun parçasını diğerinden nasıl ayırt edebildiğini Paimon'un aklı almıyor... Neyse, sen mutlu ol da... Sırada şu \"sevinçle dökülmüş güvercin tüyleri\" var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
