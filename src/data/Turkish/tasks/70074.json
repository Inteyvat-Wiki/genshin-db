			},
			"dialogs": [
				{
					"id": 700740801,
					"content": "Guk guk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740802
					],
					"speakerTitle": "Güvercin"
				},
				{
					"id": 700740802,
					"content": "Yakaladım! Tüyler çantada! Tekrar ediyorum, tüyler çantada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740803
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740803,
					"content": "Sonunda! Bu ödev Paimon'un düşündüğünden daha zormuş gerçekten...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740804,
					"content": "Geriye sadece bir malzeme kaldı, \"büyük bir kazanda kaynatılmış şifalı et suyu\". Bunu Dadaupa Geçidi'nde kesin buluruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740805
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740805,
					"content": "Ben hemen gidiyorum. Siz de fırsat bulduğunuzda gelin, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740806
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740806,
					"content": "Hey, bekle! Hay aksi, amma heyecanlı... Ürkmüş güvercinlerden bile daha hızlı fırlayıp gitti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740807,
						700740808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740807,
					"content": "Klasik \"rüzgar gibi özgür\" kafası...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740809
					]
				},
				{
					"id": 700740809,
					"content": "... Koca ayyaş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740810
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740810,
					"content": "Hımm? Kim var orada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740811
					]
				},
				{
					"id": 700740811,
					"content": "Aa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740812
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740812,
					"content": "Diona? Ne işin var burada? Neden saklanıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740813,
					"content": "Ben... Ben sadece meyve toplamaya gelmiştim, yemin ederim! O baş belasıyla burada karşılaşacağımı hiç düşünmemiştim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740814
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740814,
					"content": "Off, son zamanlarda sürekli peşimde, ona yine şu içkiden yapmam için beni ikna etmeye çalışıyor. O kadar sıkıldım ki gördüğüm yerde ondan kaçıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740815
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740815,
					"content": "Peki bu içeceğin olayı ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740816
					]
				},
				{
					"id": 700740816,
					"content": "Geçenlerde keşif seferinin bir kısmıyla beraber geri döndüğünden haberiniz vardır. Neredeyse ayağının tozuyla yaptığı ilk iş, kutlama niyetine \"bir iki kadeh\" atmak için soluğu Kedi Kuyruğu'nda almak oldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740817
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740817,
					"content": "Gerçekten mi? Paimon onların Favonius Şövalyeleri Karargahında kalacaklarını sanıyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740818,
					"content": "Şahsen Varka'nın daha çok Meleklerin Payı'nda takılan biri olduğunu sanıyordum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740819
					]
				},
				{
					"id": 700740819,
					"content": "Off... Bu yüzden \"neredeyse\" dedim. Çünkü bundan da fazlasını yaptılar! Kedi Kuyruğu, şehir çapındaki han turlarının üçüncü durağıydı sadece...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740820
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740820,
					"content": "... Sonraki asker grubu da eve döndüğünde yine aynı şeyleri yapacaklar kesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740821
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740821,
					"content": "Kesin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740822
					]
				},
				{
					"id": 700740822,
					"content": "Her neyse, uzun lafın kısası o sarhoş yaşlı kokarcalara bir saniye daha katlanamazdım! Bu yüzden onlara tüm Teyvat'taki en iğrenç, en mide bulandırıcı içecekleri yapmayı kendime görev edindim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740823,
						700740824
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740823,
					"content": "Ama Diona...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740825
					]
				},
				{
					"id": 700740825,
					"content": "Evet... Ben de o yüzden içkileri Prens hazırlasın istedim zaten. Of, keşke o sarhoşlar darlamasaydı onu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740826
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740826,
					"content": "... En son Prens işini bitiremeden kaçtı. Neyse, en azından çıkarken o yaşlı ayyaşa güzel bir tırnak izi bıraktı! Hahahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740827
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740827,
					"content": "(Haa, demek Varka'nın yara izi böyle olmuş...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740828
					]
				},
				{
					"id": 700740828,
					"content": "Derin ve karanlık bir zind{RUBY#[D]hana}ana girmiş, hayatımda gördüğüm en vahşi, en acımasız canav{RUBY#[D]Prens}arlarla savaşıyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740829
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740829,
					"content": "Hemen önümdeydi, tamamlanmasına sadece tek bir adım kalmıştı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740830
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740830,
					"content": "... Yani son dokunuşları kendin mi yaptın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740831
					]
				},
				{
					"id": 700740831,
					"content": "Evet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740832,
						700740833
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740832,
					"content": "Sadece merak ettiğimden bir şey daha soracağım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740834
					]
				},
				{
					"id": 700740834,
					"content": "Şey... Şövalyelerin kıyafetlerinde fark ettiğim birkaç odun parçası, ormandan topladığım birkaç güvercin tüyü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740835
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740835,
					"content": "... Ve ayılmaları için yapmayı düşündüğüm Dağ Yabanisi bitki çorbası.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740836
					],
					"speakerTitle": "Diona"
				},
				{
					"id": 700740836,
					"content": "Bir dakika... Tüm bunların Varka geri döndükten kısa bir süre sonra olduğunu söyledin, değil mi? Öyleyse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740837,
						700740838
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740837,
					"content": "Ona kimse söylememiş...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740839
					]
				},
				{
					"id": 700740839,
					"content": "Eyvah, durum feci olabilir! Çok geç olmadan onu durdurmalıyız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740838,
					"content": "... Bu kadar berbat bir tarifin lezzetli olmasını sadece Diona başarabilir!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740839
					]
				},
				{
					"id": 700740833,
					"content": "İçkilere ne koydun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740834
					]
				},
				{
					"id": 700740824,
					"content": "Sen istesen bile kötü bir içecek yapamıyorsun ki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740825
					]
				},
				{
					"id": 700740808,
					"content": "Kesin akşam olsa da içsek diye bekliyordur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740809
					]
				}
			]
		},
