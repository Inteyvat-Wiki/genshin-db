			},
			"dialogs": [
				{
					"id": 700740901,
					"content": "İnanılmaz... Dağ Yabanileri ne zamandan beri bu kadar uzlaşmacı oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740902
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700740902,
					"content": "Ella! Varka'yı buralarda görmedin, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740903,
					"content": "Aslına bakarsan gördüm. Az önce Dağ Yabanilerinden \"büyük bir kazan\" ödünç almaya gitti... Ve işin ilginç tarafı, onu görür görmez kazanı hemen verdiler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740904
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700740904,
					"content": "En tuhaf olanıysa neredeyse hiç konuşmamalarıydı. İşini nasıl bu kadar sorunsuz halletti anlamıyorum... Yoksa Büyük Kumandan benim bilmediğim bir Dağ Yabanisi beden dili mi biliyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740905,
						700740906
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700740905,
					"content": "Bunun \"iletişimle\" olduğunu sanmıyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740907
					]
				},
				{
					"id": 700740907,
					"content": "Her neyse, konudan sapmayalım! Şu an nerede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740908,
					"content": "İşte orada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740909
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 700740909,
					"content": "Sonunda bitti! Tüm Teyvat'taki en iyi şarap... İşte burada, ellerimde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740910
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740910,
					"content": "Varka! Yapma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740911
					]
				},
				{
					"id": 700740911,
					"content": "Aa selam çocuklar, sonunda geldiniz! Az önceki şu Dağ Yabanileri şaşırtıcı derecede anlayışlıydı... Bu kadar sorunsuz geçmesini beklemiyordum, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740912
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740912,
					"content": "Her neyse, şimdi bu güzelliğin tadına bakma zamanı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740913
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740913,
					"content": "... Dur, içme!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740914
					]
				},
				{
					"id": 700740914,
					"content": "Hı? Önce sen mi tatmak istiyorsun? Hehe, rüyanda görürsün evlat... İlk bardağın şerefi bana ait!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740915
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740915,
					"content": "Onu demek istemedim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740916
					]
				},
				{
					"id": 700740916,
					"content": "Merak etme! Sana da bırakırım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740917
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740917,
					"content": "*gluk* *gluk* Ahhh... Öğğ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740918
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740918,
					"content": "Fakat... Kendimi neden... Bu kadar kötü hissediyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740919
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740919,
					"content": "Varka! İyi misin? Varka? Varkaaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740920,
						700740921
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740920,
					"content": "Büyük Kumandan!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740922
					]
				},
				{
					"id": 700740922,
					"content": "Haydi! Bir tanrıyı yenip de nalları böyle dikmek sana yakışmaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740923
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740923,
					"content": "Uff... Ahh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740924
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740924,
					"content": "... Yemin ederim bir an için geçmiş tüm Poyraz Şövalyelerinin tam karşımda durduğunu gördüm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740925,
						700740926
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740925,
					"content": "Bu hale düştüğün için sana kızmalı mıyım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740927
					]
				},
				{
					"id": 700740927,
					"content": "Her neyse, tüm bunları sindirmek için biraz zamana ihtiyacım var... Hem içkiyi hem de aldığım dersi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740928
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740928,
					"content": "Varka'ya Diona'nın içki hazırlamadaki kusursuz yeteneğini anlatıyorsun.\\n\"Yani bu garip malzemeleri birinci sınıf bir içkiye dönüştürebilecek tek kişi o...\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						700740929
					]
				},
				{
					"id": 700740929,
					"content": "Haa, eksik malzeme aslında pınar perisinin kutsamasıymış demek... Haha, hayatta tahmin edemezdim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740930
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740930,
					"content": "Hey, bırak masum rolü kesmeyi! Bizi kandırmaya çalıştığın için hâlâ bize borçlusun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740931
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740931,
					"content": "Özür dilerim... Ama gerçekten işe yarayacağına inanmıştım. Sonrasında bir iki kadeh içerken her şeyi itiraf etmeyi planlıyordum zaten...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740932
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740932,
					"content": "Ama sanırım... Artık içmek istemiyorsunuz, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740933,
						700740934
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740933,
					"content": "Yok... Ben almayayım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740935
					]
				},
				{
					"id": 700740935,
					"content": "Hımm... Size borçlandım desene! Şöyle yapalım, döndüğümüzde sizi Avcının Yeri'nde yemeğe götüreyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740936
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740936,
					"content": "Bak bu olur işte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740937
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740937,
					"content": "Sen de rüşvete hemen kanıyorsun...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740938
					]
				},
				{
					"id": 700740938,
					"content": "Hadi ama! O şeyi içtikten sonra ne hale geldiğini sen de gördün. Dersini almıştır artık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740939
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740939,
					"content": "*iç çeker* Kendim ettim kendim buldum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740940,
						700740941
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740940,
					"content": "Her neyse... Şu \"ödev\" meselesine dönelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740942
					]
				},
				{
					"id": 700740942,
					"content": "Haha, şey... O hikayeyi hana saklıyordum ama sanırım burada anlatmak zorunda kalacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740943
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740943,
					"content": "... Mondstadt'taki herkese \"ödevler\" veriyorsun, öyle mi? İlginç bir fikir... Bana da bir tane var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740944
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740944,
					"content": "Hehe... Peki, illaki bilmek istiyorsan seninki \"kehanet aynasına yansıyan kaderi değiştirmek\"ti. Ama bunu epey zaman önce zaten yaptın. Tam olarak seferine çıkmaya karar verdiğin an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alice"
				},
				{
					"id": 700740941,
					"content": "Neden boş?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740942
					]
				},
				{
					"id": 700740934,
					"content": "O kadar cesaretim var mı bilmiyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740935
					]
				},
				{
					"id": 700740926,
					"content": "Yoksa hâlâ ayakta durabildiğine hayret mi etmeliyim bilmiyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740927
					]
				},
				{
					"id": 700740921,
					"content": "Hadi dostum, kendine gel!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740922
					]
				},
				{
					"id": 700740906,
					"content": "Beden dili ya da başka türlü tanımlanabilecek bir dilde değil en azından...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740907
					]
				}
			]
		},
