			"dialogs": [
				{
					"id": 700740201,
					"content": "Demek \"şövalyelerin kestiği odunları\" buradan alacağız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740202,
					"content": "Aa, Büyük Kumandan! Fahri Şövalye! Siz de mi talim yapmaya geldiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740203
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 700740203,
					"content": "Yani tam olarak öyle sayılmaz ama... Sonuçta ulaşmak istediğimiz bir hedef var, o yüzden bu da bir nevi talim diyebiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740204
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740204,
					"content": "Zaten çok yeteneklisiniz ama hâlâ daha mükemmeli hedefliyorsunuz... Buyurun, dilediğiniz gibi talim yapın! Ben de kenardan izleyip bir şeyler kapmaya çalışırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				}
			]
		},
