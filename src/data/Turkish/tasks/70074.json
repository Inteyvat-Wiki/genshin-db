			},
			"dialogs": [
				{
					"id": 700740501,
					"content": "Hey! Bütün güvercinleri korkuttunuz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740502
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 700740502,
					"content": "... B-Büyük Kumandan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740503
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 700740503,
					"content": "Aa, bizim küçük Timmie değil mi bu? Kocaman olmuşsun! Yemeklerini bitiriyor musun bakayım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740504
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740504,
					"content": "E-Evet efendim! Bana söylediklerinizi hiç aklımdan çıkarmadım. Büyüyüp güçlü olmak istiyorsam iyi beslenmeli ve bol bol egzersiz yapmalıyım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740505,
						700740506
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 700740505,
					"content": "Çocuğun tavrı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740507
					]
				},
				{
					"id": 700740507,
					"content": "Sanırım bu da Varka etkisi... Eh, şehrin \"yaşayan efsanesine\" hayranlık duymayan bir tane çocuk olsa Paimon şaşardı zaten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740508,
					"content": "Güvercinlerini korkutup kaçırdığım için özür dilerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740509
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740509,
					"content": "Aslında sana bir sorum olacaktı... Güvercinleri ürkütmeden yaklaşıp onları mutlu etmenin bir yolu var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740510
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740510,
					"content": "Hımm... Açıkçası ben genelde sessizce yanlarına yaklaşıp biraz yem serpiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740511
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 700740511,
					"content": "Bu kadar basit işte! Peki şu an yanında fazladan yem var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740512
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740512,
					"content": "Epey var ama... Büyük Kumandan... Ne yapmayı düşünüyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740513
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 700740513,
					"content": "Merak etme ufaklık, sadece birkaç tane tüy ödünç almamız gerekiyor... Sana söz veriyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740514
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740514,
					"content": "Ha... Peki o zaman, sorun yok! Teşekkürler Büyük Kumandan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				},
				{
					"id": 700740506,
					"content": "Bir anda değişiverdi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740507
					]
				}
			]
		},
