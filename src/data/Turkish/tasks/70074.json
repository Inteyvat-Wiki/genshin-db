			"dialogs": [
				{
					"id": 700740101,
					"content": "Aslında Cadılar Meclisiyle şu \"görüşmeyi\" ayarlama fikri Varka'nındı. Ona ne ödev verdiklerini neden hiç öğrenemedik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740102,
					"content": "Bir bakalım... Varka, Varka... Bir saniye, burası neden boş?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740103,
					"content": "Gidip kendisine soralım mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740104
					]
				},
				{
					"id": 700740104,
					"content": "Mantıklı... Onun gibi birini bulmak için önce civardaki hanları ve lokantaları gezerek işe başlayabiliriz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740105,
					"content": "... Hâlâ gelmedi mi? Anlaşılan bu işi kendi başıma çözmem gerekecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740106
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740106,
					"content": "İyi insan lafın üstüne gelirmiş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740107
					]
				},
				{
					"id": 700740107,
					"content": "Hey, Varka! Şu \"ödevin\" hakkında senden bilgi almak istiyorduk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740108,
					"content": "Merhaba Fahri Şövalye, merhaba Paimon! \"Ödevim\" mi? Neden bahsediyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740109,
						700740110
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740109,
					"content": "Cadılar Meclisi herkes için ödevler belirledi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740111
					]
				},
				{
					"id": 700740111,
					"content": "Sahiden Alice bana bu konuda bir şeyler söylemişti galiba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740112
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740112,
					"content": "\"Galiba\" öyle mi? Bu \"ödevlerin\" var olma sebebi onlarla yaptığın şu \"görüşme\" zaten! Öff her neyse, seninki neden boş peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740113,
					"content": "... Tahminde bulunacak olursam, görevim küçük kitaplarına ağır geleceği içindir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740114,
						700740115
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740114,
					"content": "Şimdi ilgimi çektin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740116
					]
				},
				{
					"id": 700740116,
					"content": "Ödevim... Teyvat'ın en kaliteli şarabını yapmak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740117
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740117,
					"content": "... Bunun neresi \"ağır\" be?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740118,
					"content": "Güven bana, bu ciddi bir iş... Kolumdaki bu yeni yara izini görüyor musun? Tarifi ele geçirmek için ödediğim bedel bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740119
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740119,
					"content": "Derin ve karanlık bir zindana girmiş, hayatımda gördüğüm en vahşi, en acımasız canavarlarla savaşıyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740120
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740120,
					"content": "Ciddi misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740121
					]
				},
				{
					"id": 700740121,
					"content": "Bu işi bitirmek için sadece üç özel malzeme eksik! Fahri Şövalye, Paimon, bana yardım etmeye var mısınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740122
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740122,
					"content": "Aman peki, neden olmasın... Madem sadece üç malzeme lazım, Paimon hikayene inanmış gibi yapacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740123,
					"content": "Pekala! Hehe... Şu anda \"şövalyelerin kestiği odunlara\", \"sevinçle dökülmüş güvercin tüylerine\" ve \"büyük bir kazanda kaynatılmış şifalı et suyuna\" ihtiyacımız var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740124
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740124,
					"content": "Bir dakika... \"Şarap\" yapmıyor muyduk? Bu bahsettiklerin daha çok şüpheli bir iksir yapmalık sanki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700740125,
					"content": "Hımm, iyi bir noktaya parmak bastın... Ödevi verenler bir grup büyücü ne de olsa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740126
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740126,
					"content": "Tarifi harfi harfine takip etmeliyiz, yani üç malzeme de isteklerini karşılamalı. Hadi gelin şu odunlarla başlayalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				},
				{
					"id": 700740115,
					"content": "Neymiş bu \"ağır\" ödev?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740116
					]
				},
				{
					"id": 700740110,
					"content": "Ama seninki boş görünüyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740111
					]
				}
			]
		},
