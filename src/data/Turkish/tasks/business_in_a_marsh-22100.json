			"dialogs": [
				{
					"id": 221000101,
					"content": "*İç çeker* Ne yapacağım ben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000102
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000102,
					"content": "Sorun ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000103
					]
				},
				{
					"id": 221000103,
					"content": "Burası... Han işletmek için hiç de uygun bir yer değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000104
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000104,
					"content": "Dihua Bataklığı'nda çok fazla Gümüşotu bulunuyor, bu da doğal olarak canavarları kendisine çekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000105
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000105,
					"content": "Taşordu, bölgedeki canavarların birçoğunu ortadan kaldırdığı için şanslıyız. O zamandan beri durumumuz fena sayılmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000106
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000106,
					"content": "Ancak nedendir bilinmez, son zamanlarda yeniden hareketlenmeye başladılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000107
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000107,
					"content": "Hanın çevresine yaklaşmayacaklarını biliyorum fakat göze battıkları su götürmez bir gerçek. Ben bile rahatsız olduysam müşterilerin halini sen düşün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000108
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000108,
					"content": "Yardım edebilir misin? Yakınlardaki canavarları ortadan kaldırırsan çok memnun olurum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000109,
						221000110
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000109,
					"content": "Tamam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000111
					]
				},
				{
					"id": 221000111,
					"content": "Haha, itiraf etmeliyim ki samimiyetin beni rahatlatıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000114
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000114,
					"content": "Neyse, misafirlerimden birine yardım etmesi için yalvarmak benim de hoşuma gitmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000115
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000115,
					"content": "Ancak bana yardım edersen emeğinin karşılığını vereceğimden emin olabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000116
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000116,
					"content": "Teşekkür ederim, iyi şanslar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000110,
					"content": "Sırf göze batıyorlar diye mi rahatsız oluyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000112
					]
				},
				{
					"id": 221000112,
					"content": "Açıkçası evet. Sadece varlıkları bile rahatsızlık vermeye yetiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000113
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000113,
					"content": "Mesela sessizliğe ve huzura düşkün genç beyefendilerden biri onları oldukça rahatsız edici buluyor. O beyefendi rahatsız olduğunda genelde Dihua Bataklığı'nın diğer sakinleri de rahatsız oluyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000114
					],
					"speakerTitle": "Huai'an"
				}
			]
		},
