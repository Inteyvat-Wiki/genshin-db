			"dialogs": [
				{
					"id": 221000201,
					"content": "Nasıl gidiyor? Hepsini temizledin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000202
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000202,
					"content": "Henüz değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000203
					]
				},
				{
					"id": 221000203,
					"content": "Peki, acelemiz yok zaten. Genelde çok yakınlaşmadıkları için şu anda bir sorun teşkil etmiyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000204
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000204,
					"content": "Ancak kör olanlarından biri yolunu kaybeder de buraya gelir ve genç beyefendinin huzurunu kaçıracak olursa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000205
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000205,
					"content": "Dihua Bataklığı'nın tamamını kaosa sürükleyebilir. Daha da önemlisi ortalık durulana kadar hanın işleri de kesilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
