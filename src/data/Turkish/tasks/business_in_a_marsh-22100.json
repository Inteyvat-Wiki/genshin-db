					"content": "Nasıl gidiyor? Hepsini temizledin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000302
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000302,
					"content": "Temizledim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000303
					]
				},
				{
					"id": 221000303,
					"content": "Harika, çok teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000304
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000304,
					"content": "Söz verdiğim gibi, işte ödemen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000305
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000305,
					"content": "Umarım bir süre bizi rahatsız etmezler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000306
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221000306,
					"content": "Affedersin, bu genç beyefendi de kim? Aslında bu, patrona sormak istediğim bir soru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
