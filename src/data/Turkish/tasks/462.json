			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4620701,
					"content": "\"Kız onu hiç sevmiyor. Berrak pınardan çağlayarak akan tutku rolden ibaret. Kız soğuk ve tek başına olduğunda yüreği ortaya çıkıyor.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620702
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620702,
					"content": "Ne anlama geliyor sence?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620703,
					"content": "Tesadüfen bulduğunuz bir aşk romanından koparılmış bir sayfa falan mı bu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620704
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620704,
					"content": "Ya, ipucu değil demek ki. Paimon kadar akıllı birinin anlamamasına şaşmamak lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620705,
					"content": "Hahaha... Şaka yapıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620706
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620706,
					"content": "Peh... Şu işi biraz daha ciddiye al Kaeya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620707,
					"content": "Haha, bu çözülmesi kolay bir bilmece değil. Berrak pınar derken... Pınarköy'ü mü kastediyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620708
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620717,
					"content": "Kaynak suyunda yıkanan insanlar varken olabilir mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4620724,
					"content": "Su seviyesi değiştiğinde mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4620708,
					"content": "\"Berrak pınardan çağlayarak akan tutku...\" Berrak pınardan tutku ne zaman çağlayarak akar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620709
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620718,
					"content": "Ne kadar uygunsuz bir davranış... Mondstadt'ta bir süredir böyle davranışlar yaygınlaşıyor gibi hissediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620719,
					"content": "Tabii... İkinizin bir alakası varsa bununla bilemem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620720,
					"content": "Özür dilerim. İnsanların özel hayatlarında yaptıkları şeyleri yargılamamalıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620721,
					"content": "Senin neyin var be? Sen bizi nasıl insanlar sanıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620723,
					"content": "Hımm... Berrak pınarın su seviyesi değiştiğinde olabilir mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4620722,
					"content": "Ha ha. Mesele şu ki \"çağlayan tutku\" berrak pınardan gelmiyorsa yıkanan insanlardan geliyor o zaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620725,
					"content": "Fena fikir değil! Hani... Mesela şeyde şelale var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620726,
					"content": "Bence bu bilmecenin cevabı Pınarköy'ün arkasındaki şelaleyle alakalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620727,
					"content": "Burada betimlenen tutkuyu ancak Mondstadt'ı kutsayan berrak pınar ortaya çıkarabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620709,
					"content": "Şelalenin \"yüreği\" de şelalenin sol tarafındaki kayalığa gönderme yapıyor olsa gerek. Bölgede devriye gezerken dikkatimi çekmişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620710
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620710,
					"content": "Sondaki \"soğuk ve tek başına\" kısmı da muhtemelen Buz ile alakalı. Buz, Önsezi kullanarak kontrol edilebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620711
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620712,
					"content": "Yardımın için teşekkürler Kaeya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620713
					]
				},
				{
					"id": 4620711,
					"content": "<color=#00E1FFFF>Yanında Buz gücünü kullanmayı bilen birini götürsen</color> iyi edersin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620712
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620713,
					"content": "Ne demek. Favonius Şövalyeleri bir bilmecenin cevabını bile bulamayacaksa suçların gizemlerini nasıl çözebilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620714
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620714,
					"content": "Hadi Pınarköy'e bakalım. Seni de \"suçların gizemleriyle\" baş başa bırakalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620715,
					"content": "Im...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620716
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620716,
					"content": "Yok, dur biraz... Bırakalım da sen suçların gizemlerini ÇÖZ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
