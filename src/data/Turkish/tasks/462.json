					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4620401,
					"content": "Ooo bakayım içinde ne varmış!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620402,
					"content": "\"Kız onu hiç sevmiyor. Berrak pınardan çağlayarak akan tutku rolden ibaret. Kız soğuk ve tek başına olduğunda yüreği ortaya çıkıyor.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620407,
					"content": "Bir harita daha var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620403,
					"content": "Daha fazla bilmece mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620404,
					"content": "Paimon'un başı dönmeye başladı çoktan. Olamaz! Paimon'un beyni sulanmış iyice!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620405,
					"content": "Hep öyleydi zaten...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620406
					]
				},
				{
					"id": 4620406,
					"content": "Paimon bıraksın sen eğlen. Ya da gidip Kaeya'den yardım isteyebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
