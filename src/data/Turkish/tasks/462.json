			"trigger": {
				"objectNames": [
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4620501,
					"content": "#{NICKNAME}! Dönmüşsünüz! Bilgileri almışsınız gibi duruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620502
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620502,
					"content": "Hem evet hem hayır. Durum biraz karışık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620503,
					"content": "\"Göldeki şehirde üç tane altı kollu dev yaşar. İkisi heykeli korur, diğeri ise hazineyi.\" Sence ne demek istiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620504,
					"content": "Bilmece mi? Çok garip. Bir düşüneyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620505
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620505,
					"content": "\"Göldeki şehir\" belli ki Mondstadt... Altı Kollu Devlere gelince de... Hımm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620506
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620506,
					"content": "Yengeç mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620507
					]
				},
				{
					"id": 4620507,
					"content": "Dev yengeçler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620508,
					"content": "Dev yengeçleri nerede bulacağımız konusunu kenara bırakırsak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620509
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620509,
					"content": "Yengeçlerin sekiz bacağı vardır, altı değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620516
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620516,
					"content": "Yel değirmenleri öyleyse?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620517
					]
				},
				{
					"id": 4620517,
					"content": "Yel değirmenleri olabilir mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620518
					]
				},
				{
					"id": 4620518,
					"content": "Hey! İyi düşündün!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620519
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620519,
					"content": "Yel değirmeninin altı kanadı vardır... Uydu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620510
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620510,
					"content": "Vay be! Çok mantıklı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620511,
					"content": "Yani üç yel değirmeninden ikisi heykele yakın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620512
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620512,
					"content": "Diğeri ise...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620513
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620513,
					"content": "Oo! Oo! Paimon bunu biliyor! Hazineyi koruyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4620514,
					"content": "Hehehe... Umalım da o kadar basit olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620515
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4620515,
					"content": "#Hadi gel {NICKNAME}! Yel değirmeninin etrafına bir bakalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 46207,
			"completionStepIds": [
				46207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
