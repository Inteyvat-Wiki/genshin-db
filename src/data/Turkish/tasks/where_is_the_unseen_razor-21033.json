			"dialogs": [
				{
					"id": 210330403,
					"content": "Bu kılıç kabzası... Hâlâ sağlam görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330404
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 210330404,
					"content": "Bunun Görünmez Ustura ile bir ilgisi var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210330405
					]
				},
				{
					"id": 210330405,
					"content": "Detaylıca incelemem gerek... Ah, söylemeyi unuttum. Uzunca bir süredir bu silahın parçaları için bu bölgeyi arıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330406
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 210330406,
					"content": "Pazar yerinden ve dışarıdan sayısız parça topladım, hatta maceracılardan bile satın aldım... Belki beni Görünmez Usturaya ulaştırır diye düşündüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330407
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 210330407,
					"content": "Buna rağmen şimdiye kadar gölgesine dahi rastlamadım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330408
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 210330408,
					"content": "Neyse, Liyue'de bir deyiş vardır: \"Sabır güçten daha çok şey başarır.\" Aramaya devam edeceğim... Görünmez Usturayı bulana kadar yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330409
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 210330409,
					"content": "Çabaların için bunu kabul et Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lahn"
				}
			]
		}
