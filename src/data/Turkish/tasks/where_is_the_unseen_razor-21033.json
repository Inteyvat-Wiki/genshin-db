			"dialogs": [
				{
					"id": 210330101,
					"content": "Faydası olur mu bilmem ama bir fikrim var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330102
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 210330102,
					"content": "Hâlâ kılıcını arıyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210330103
					]
				},
				{
					"id": 210330103,
					"content": "Aa, sen mi geldin Gezgin? Görünmez Usturayı hâlâ arıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330104
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 210330104,
					"content": "Fakat henüz elle tutulur bir ipucu bulamadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330105
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 210330105,
					"content": "Liyue'de bir kılıç aramak, samanlıkta iğne aramak gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330106
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 210330106,
					"content": "Birileri bana kılıcın uzun süre önce bir canavar tarafından yok edilmiş olabileceğini söyledi. Öyle bile olsa, her bir parçasını arayıp bulacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330107
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 210330107,
					"content": "Kusura bakma, öylesine konuşuyorum. Bu sefer kontrol etmeni istediğim yeri haritanda işaretledim. Yardımın için teşekkürler Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210330108
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 210330108,
					"content": "Umarım kılıç gerçekten de kırılmamıştır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lahn"
				}
			]
		},
