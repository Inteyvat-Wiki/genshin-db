			"dialogs": [
				{
					"id": 220220301,
					"content": "Liyue'de Tianshu Usulü Rosto olarak bilinen meşhur bir yemek var... Xudong buraya da bir şeyler karalamış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220302
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220302,
					"content": "\"Kabuğu soyulmuş patatesleri buharda pişir, sıcakken ez ve yağ ile tuz ekle. Sonra bir kaseye alıp üzerine yoğun sosunu ekle. İlk ısırığın tadı tıpkı yumuşak et gibi gelecek.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220303
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220303,
					"content": "İlk ısırık... Yani sonraki ısırıklarda farklı mı oluyor? Hadi ama, bu yalnızca daha önce hiç Tianshu Usulü Rosto yememiş insanları kandırmaya yeter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220304
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220304,
					"content": "Neyse... Gezgin sorum şu: \"Tianshu Usulü Rostoda Çiğ Et, Şeker ve Matsutake dışında ne var?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220305,
						220220306,
						220220308,
						220220309
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220305,
					"content": "Mor Ot.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220310
					]
				},
				{
					"id": 220220310,
					"content": "Hımm... Öyle mi? O zaman dur, yazayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
