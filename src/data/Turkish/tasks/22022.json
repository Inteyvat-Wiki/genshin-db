			"dialogs": [
				{
					"id": 220220201,
					"content": "Mondstadt'ta Kuzey Usulü Elmalı Güveç dedikleri bir yemek var. Xudong buraya yine bir sürü zırva yazmış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220202
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220202,
					"content": "\"Tereyağı pahalı ve çiğ eti saklamak zor. Hamuru yoğurup glütenini yıkadıktan sonra hamuru buharda pişirip yanına meyve ve sebze ekleyerek lezzetli bir yemek yapılabilir.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220203
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220203,
					"content": "Şu adam yok mu... Tereyağı nasıl pahalı olabilir? Ayrıca neden gidip taze et almıyormuşuz ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220204
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220204,
					"content": "Neyse... Gezgin sorum şu: \"Elma, Tereyağı ve Çiğ Et dışında Kuzey Usulü Elmalı Güveçte başka ne var?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220205,
						220220206,
						220220208,
						220220209
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220205,
					"content": "Badem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220210
					]
				},
				{
					"id": 220220210,
					"content": "Hımm... Öyle mi? O zaman dur, yazayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220206,
					"content": "Karabiber.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220207
					]
				},
				{
					"id": 220220207,
					"content": "Hımm... Öyle mi? O zaman dur, yazayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220208,
					"content": "Jueyun Biberleri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220210
					]
				},
				{
					"id": 220220209,
					"content": "Jambon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220210
					]
				}
			]
		},
