			},
			"dialogs": [
				{
					"id": 220220101,
					"content": "Bu tarifin böyle olması lazım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220102
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220102,
					"content": "Ne yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220103
					]
				},
				{
					"id": 220220103,
					"content": "Tarifleri sıralıyordum ama ne yazık ki bazılarını çok net hatırlayamıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220104,
						220220106
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220104,
					"content": "Neden Xudong'a sormuyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220105
					]
				},
				{
					"id": 220220105,
					"content": "Xudong... Zaten onun \"yaratıcı yemekleri\" yüzünden tarifleri hatırlayamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220109
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220109,
					"content": "Her yeni tarif bulduğunda tarifi en fazla bir ya da iki gün tam uyguluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220110
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220110,
					"content": "Sonrasında... Tarifi geliştirmek için çeşitli şeyler deniyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220111,
						220220113
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220111,
					"content": "Niye öyle yapsın ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220112
					]
				},
				{
					"id": 220220112,
					"content": "Ona göre bu şekilde tarifler daha ucuz oluyormuş ama ben bunları yapma nedenini tam da idrak edemiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220118
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220118,
					"content": "Ama sonuç da ortada. Gayet başarılı oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220119
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220119,
					"content": "Tadı aslına benzese de üretim maliyeti inanılmaz ucuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220120
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220120,
					"content": "Böyle tuhaf yemek pişirme yöntemleri olduğu için onunla çalışmak istemiştim ve bence o da beni becerilerimden dolayı yanına aldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220121,
						220220123
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220121,
					"content": "Peki senin için ne yapabilirim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220122
					]
				},
				{
					"id": 220220122,
					"content": "Ah... Hay aksi! Xudong'dan bahsedip dururken asıl meseleyi unutuyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220128
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220128,
					"content": "Xudong beni tarifleri değiştirelim diye darlayıp duruyordu. Doğrudan tariflerin üstüne yazıp çizdiği için bazı tarifleri okumak artık iyice zorlaştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220129
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220129,
					"content": "Bu tarifleri düzgünce ayırıp gerekirse diye bir kopyasını saklamak istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220130
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220130,
					"content": "Gezgin, tarifleri hatırlıyorsan bana yardım eder misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220131,
						220220132
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220131,
					"content": "Tamamdır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220133
					]
				},
				{
					"id": 220220133,
					"content": "Teşekkürler. Ben kötü hale gelen tarifleri hallederim, sen de net olmayan kısımlarını düzeltirsin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220132,
					"content": "Tabii ki. Teyvat'ta ne varsa hepsini yedim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220133
					]
				},
				{
					"id": 220220123,
					"content": "Becerilerin mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220124
					]
				},
				{
					"id": 220220124,
					"content": "Söylememiş miydim? Akademideki araştırma konum \"muazzam baharattı\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220125
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220125,
					"content": "Kısacası her yiyeceği lezzetli kılacak süper bir baharat yapmaya çalışıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220126
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220126,
					"content": "Bu nedenle çeşitli mutfaklar hakkında bilgi topluyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220127
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220127,
					"content": "Öhöm, çok uzattım. Şimdi tariflere dönelim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220128
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220113,
					"content": "Tarifleri tam olarak nasıl geliştiriyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220114
					]
				},
				{
					"id": 220220114,
					"content": "Şey... Yöntemleri başkalarından farklı. Çoğu şef tarifi zenginleştirerek yemeği daha pahalıya satmayı dener.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220115
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220115,
					"content": "Ama Xudong'un tamamen farklı bir prensibi var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220116
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220116,
					"content": "Örneğin patates, mantar ve birkaç ucuz sebze daha kullanarak vejetaryen yemeği yaptı ama tadı bir şekilde Acılı Jueyun Tavuğuna benzedi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220117
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220117,
					"content": "Bir de Patates, Pirinç, Nilüfer Başı, Jueyun Biberi, hamur ve Çiğ Et kullanarak yaptığı basitleştirilmiş bir Adeptus Doyuran tarifi var. Hem dokusu hem de tadı garip bir şekilde asıl yemeğe çok benziyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220118
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220106,
					"content": "Dur, sen Üstün Gurme değil misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220220107
					]
				},
				{
					"id": 220220107,
					"content": "Lütfen bir daha benim yanımda o ismi kullanma. O kelimeler asla benim kağıdımda yer almayacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220108
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220220108,
					"content": "Ayrıca, zaten Xudong'un \"yaratıcı yemekleri\" yüzünden tarifleri hatırlayamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220220109
					],
					"speakerTitle": "Parvaneh"
				}
			]
		},
