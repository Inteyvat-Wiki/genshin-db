					"nextDialogs": [
						60110914
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 60110914,
					"content": "Bir şeye ihtiyacı olursa ilk önce bana haber vereceksiniz bak, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dori"
