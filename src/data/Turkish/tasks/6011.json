			"dialogs": [
				{
					"id": 60110101,
					"content": "Herkes toplanıp başlarına gelenleri ve öğrendiklerini paylaşır...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						60110102
					]
				},
				{
					"id": 60110102,
					"content": "Çok şükür minimum hasarla atlatabildik. Kasaba halkından yalnızca birkaç kişi zarar gördü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110103
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60110103,
					"content": "Ancak Ay Avcısı bütün bir form kazandı ve hâlâ amacının ne olduğuna dair hiçbir şey bilmiyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110104
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60110104,
					"content": "Vahşi bir Gukuzoru doğaya salmak gibi oldu yaptığımız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110105
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60110105,
					"content": "... Üzgünüm. Burada kimse Gukuzorları bilmiyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110106
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60110106,
					"content": "P-Paimon ne demek istediğini anlıyor ama bu biraz ince bir benzetme oldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110107,
					"content": "Bu dünyanın kendisine bir şey ifade etmediğini söyledi, o yüzden şu anda bizimle savaşmak için bir sebebi olmayabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110108
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110108,
					"content": "Amacı sadece intikam almak olsaydı muhtemelen mahvolmuştuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110109
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110109,
					"content": "Şey, istifamı vermeye zamanım var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110110
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110110,
					"content": "Şaka şaka! Merak etme patron. Artık bu işin kaçışı olmadığını biliyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110111
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110111,
					"content": "O kadar emek verdiğim, gurur kaynağım olan topum destek yerine köstek mi oldu... Öf! Var ya, hemen sökeceğim onu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110112,
						60110113
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110112,
					"content": "Bu senin suçun değildi Aino.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110114
					]
				},
				{
					"id": 60110114,
					"content": "Evet, ayrıca hâlâ normal Vahşi Av anomalilerinde işe yarıyor. Hiç canını sıkma Aino!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110115,
					"content": "Flins, Işık Muhafızlarıyla birlikte olayın sonuçlarıyla ilgilenmen gerekecek. Merak etme, onlara her şeyi açıkladım. Adın temize çıktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110116
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110116,
					"content": "Hem bunun için hem de gerçeğe ulaşmamız adına gösterdiğin tüm çabalar için teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110117
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110117,
					"content": "Biraz daha insan içine çıkmaya niyetli olsaydın, bu kadar kolay yalnız bırakılmazdın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110118
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110118,
					"content": "Heh. Mesaj alındı. Bunu bir düşüneceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110119
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110119,
					"content": "Hımm. Aslında Başçavuş Sousi'nin yerine geçmenin bana faydası dokunabilirmiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110120
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110120,
					"content": "Terfi mi aldın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110121,
					"content": "Şaka yapıyor Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110122
					]
				},
				{
					"id": 60110122,
					"content": "Tek anlamayan Paimon muydu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110123,
					"content": "#{NICKNAME}, vaktin varsa benimle gelmek ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110124
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110124,
					"content": "Son yolculuğuna uğurlayacağım bir beyefendi var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110113,
					"content": "Topun suçu da değildi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110114
					]
				}
			]
		},
