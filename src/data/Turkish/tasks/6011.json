					"speakerTitle": "Jahoda"
				},
				{
					"id": 60110502,
					"content": "Olur da yine başkalarıyla birlikte çalışırsak, Sırlar Arşivi 1 ila 10 arasında ne kadar emek harcamalı sence?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110503
					],
