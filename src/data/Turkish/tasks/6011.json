			"dialogs": [
				{
					"id": 60110401,
					"content": "Krumkake hazır. Soğutmadan yiyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110402
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60110402,
					"content": "Hatırladığın için sağ ol Bayan Ineffa. Yıllar geçse bile hatırı baki kalacak dostluğumuza şahitlik etsin bu tat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110403
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60110403,
					"content": "Anlaşıldı. Ancak korkarım ki Krumkakeler o kadar uzun süre saklanamaz. Tadı bozulmadan en fazla bir hafta durabilirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110404
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60110404,
					"content": "Hehe, demeye çalıştığım... Hımm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110405
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60110405,
					"content": "Misafirimiz var anlaşılan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110406
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60110406,
					"content": "Aa, Krumkakenin kokusunu almışlardır... Tehlike yok, yaklaşın. Ineffa bizim dostumuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110407
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60110407,
					"content": "Doğru. Aslında kişisel tercihlerine göre tahıllı omlet yapıp başkalarıyla da paylaşabilmeleri için küçük porsiyonlara ayırabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110408
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60110408,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110409
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60110409,
					"content": "Ne diyorlar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110410
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60110410,
					"content": "Şey... Adresini soruyorlar. Seninle eve gitmek istiyorlarmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				}
			]
