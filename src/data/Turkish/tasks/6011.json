					"nextDialogs": [
						60110508
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110508,
					"content": "Alt ya da üst limiti yok demeye çalışıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110509
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60110509,
					"content": "Ha! Her zamanki gibi ileriyi düşünmüşsün patron...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110510
					],
