			"dialogs": [
				{
					"id": 60110801,
					"content": "Flins? Buralara pek uğramazdın. İstediğin gibi bakabilirsin etrafa. Şu anda meşgulüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110802
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110802,
					"content": "Sizi ziyarete geldim Aino Hanım. Kasabadan geleneksel tereyağı aromalı atıştırmalıklar aldım. Nereye koyayım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110803
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110803,
					"content": "Şşş! Ineffa duyacak şimdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110804
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110804,
					"content": "... Ne için geldin? Top olayından dolayı artık tüm Vahşi Av vakalarını Ratnikler mi devralacak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110805
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110805,
					"content": "Kimsenin öngöremeyeceği sonuçlardan ötürü sizin gibi bir dahiyi suçlayabilir miyim hiç? Teessüf ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110806
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110806,
					"content": "Olur da bir gün öyle bir ayıbımız olursa tüm teknolojik gelişmelere veda etmemiz gerekir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110807
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110807,
					"content": "Hıh. Tatlı dillisin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110808
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110808,
					"content": "İçinizi rahatlatabildiysem ne mutlu bana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110809
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110809,
					"content": "Neyse, tam olarak sorun ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110810
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110810,
					"content": "Fenerimi tamir etmeme yardım edebilir misiniz? Nasha Kasabası'ndayken yaptırmıştım ama son savaşımızda yine kırıldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110811
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110811,
					"content": "Benim gibi bir dahiden fener tamir etmesini mi istiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110812
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110812,
					"content": "Kusura bakmayın. Sanırım bu ricayı ve atıştırmalıkları Bayan Ineffa'ya yöneltsem daha iyi olur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110813
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110813,
					"content": "B-B-B-Ben... Şey... Tabii yapabilirim, hiç sorun değil. Burada bekle. Senin \"Tamir et!\" demene kalmadan halledeceğim hemen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110814
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60110814,
					"content": "Minnettarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110815
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110815,
					"content": "Bir daha aynısı olursa ilk önce bana gel, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aino"
				}
