			"dialogs": [
				{
					"id": 60110201,
					"content": "Deniz feneri gibi bir adamdı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110202
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110202,
					"content": "Görev icabı burada yaşadığında, etrafındakilere ışık tuttu ve nezaket gösterdi. Ama insanlar, aydınlığa alışınca bu fenerin varlığını görmezden gelmeye başladılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110203
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110203,
					"content": "Zamanla o da kendisi hakkında öyle düşünmeye başladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110204
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110204,
					"content": "\"Yeterince başarılı olamadım, daha iyi olmalıyım, yapılacak daha çok iş var...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110205
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110205,
					"content": "Sonu trajik oldu fakat ben, başkaları için yolu aydınlatmasıyla hâlâ gurur duyuyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110206
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110206,
					"content": "Işıktan doğan tüm gölgeler, onun yaptıklarını hatırlayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110207
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110207,
					"content": "Zavallı adam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110208,
					"content": "Bir keresinde Fener Feyinin hikayesini duymuştum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110209
					]
				},
				{
					"id": 60110209,
					"content": "Heh. O hikayeyi ben de duydum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110210,
						60110211
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110210,
					"content": "Ona da aynısını söylemek isterdim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110212
					]
				},
				{
					"id": 60110212,
					"content": "Öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110213
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110213,
					"content": "Haklısın. Çabalarımızın boşa gittiğini ve Rerir'in amacına ulaştığını söyleyebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110214
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110214,
					"content": "Ama sonuç istediğimiz gibi olmasa bile sonuna kadar peşini bırakmayacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110215
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110215,
					"content": "Mezarlık Muhafızı olarak görevimden pek farklı değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110216
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110216,
					"content": "Ölüleri hayata döndürmeyi değil, onları huzura kavuşturmayı amaçlıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110217
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110217,
					"content": "Böyle düşündüğünü bilmek güzel.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110218
					]
				},
				{
					"id": 60110218,
					"content": "Evet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110219
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110219,
					"content": "S-Siz neden bahsediyorsunuz? Açıklayabilir misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110220,
					"content": "Şimdi olmaz Paimon. Döndüğümüz zaman anlatırım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110221
					]
				},
				{
					"id": 60110221,
					"content": "Peki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110222,
					"content": "Her halükarda Fener Feyi bu son törenlerde büyük bir rol oynamıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110223
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110223,
					"content": "\"Işığın elçisi, şana ve adalete giden yolda kanını feda ettin.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110224
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110224,
					"content": "\"Acele etsek de, çok yara alsak da, bir süre durup dünyaya ve geride bıraktığımız sevgiyle nefrete bakalım.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110225
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110225,
					"content": "\"Dünya gecenin karanlığında gözlerini kapatana ve kimsenin görmediği bir fener yalnız senin hatırına yanana dek.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110226
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110226,
					"content": "Her şey için teşekkürler Başçavuş Sousi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				},
				{
					"id": 60110211,
					"content": "Sonuçlara takılı kalmaya gerek yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110212
					]
				}
			]
		},
