			"dialogs": [
				{
					"id": 60110601,
					"content": "Columbina! Burada ne yapıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110602,
					"content": "Hımm? Bana yürüyüş yapmamı öneren siz değil miydiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110603
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60110603,
					"content": "Evet ama Fatui'nin seni görmesinden korkmuyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110604,
					"content": "Sandrone beni yakalamakla ilgilenmiyor, diğerleri de temasa geçme riskini almaz. İlgilenmeleri gereken daha karmaşık meseleler var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110605
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60110605,
					"content": "(Rerir'den bahsediyor herhalde... Nod-Krai'da yaşayan herkes için bir tehdit ne de olsa.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110606
					]
				},
				{
					"id": 60110606,
					"content": "Neyse, yürüyüşe çıkmak her türlü iyi gelir. Nasılsın? Nasha Kasabası'nı beğendin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110607,
					"content": "Hımm... Kuuvahki akışı biraz çalkantılı ve insanlar çok tedirgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110608
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60110608,
					"content": "Ancak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110609
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60110609,
					"content": "Ancak ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110610,
					"content": "Bana \"ısmarladığınız\" yemekleri buradan mı almıştınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110611
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60110611,
					"content": "(Cidden bunu mu düşünüyor? Aklı Böğürtlenli Et Kızartmasında mı kalmış?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110612,
					"content": "Şey, istersen seni yemeğe götürebiliriz. Burada evde bulamayacağın bir sürü lezzetli çeşit var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60110613,
					"content": "... Çok durgunsun. Aklında bir soru mu var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110614,
						60110620,
						60110625,
						60110630
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60110614,
					"content": "Rerir konusunda endişeliyim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110615
					]
				},
				{
					"id": 60110615,
					"content": "Maalesef planlarına dair hiçbir şey öğrenemedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110616
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60110616,
					"content": "Artık fiziksel bir forma sahip olduğu için gücünü hafife almak ölümcül bir hata olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110617
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60110617,
					"content": "Ama gücünün ardında, deliliğin sınırlarına dayanan bir takıntı yatıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110618
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60110618,
					"content": "Takıntısı aylarla mı yoksa başka bir şeyle mi alakalı bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110619
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60110619,
					"content": "Belki bunun ne olduğunu anlamak ileride onu defetmemize yardımcı olur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110620,
						60110625,
						60110630
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60110620,
					"content": "Fatui hakkında konuşalım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110621
					]
				},
				{
					"id": 60110621,
					"content": "Sandrone'nin günlük rutini çok düzensiz, Doktor da sürekli birilerine emir verip duruyor. Arlecchino'ya gelirsek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110622
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60110622,
					"content": "Hımm? Merak ettiğiniz bu değil miydi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110623
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60110623,
					"content": "Pekala. Deneysel Tasarım Bürosuna gittiniz mi? Yaptıkları \"silah\", Çariçe'nin planında önemli bir rol oynayacak. En azından ben öyle duydum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110624
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60110624,
					"content": "Bu plan ne diye sorarsanız... Pek de umurumda değil açıkçası.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110614,
						60110625,
						60110630
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60110625,
					"content": "Uzay gemimiz hakkında düşünüyordum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60110626
					]
				},
				{
					"id": 60110626,
					"content": "Dilersen senin için Ebedi Ayın iliğine bakabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110627
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60110627,
					"content": "Ama önceki denememizden sonra, uzay geminin bilinçli olarak saklandığını düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110628
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60110628,
					"content": "Belki de birilerinin senden ya da başkalarından saklamak istediği bazı gerçekler vardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60110629
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60110629,
					"content": "Böyle bir şeyi başarabilecek çok fazla kişi olduğunu sanmıyorum.",
