			"dialogs": [
				{
					"id": 102020401,
					"content": "Tahmin et kim geldi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020402,
					"content": "Bu Paimon'un sesi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020403,
						102020404
					],
					"speakerTitle": "Hücre Hapsi"
				},
				{
					"id": 102020403,
					"content": "Buradan çıkmak için yardım ister misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020405
					]
				},
				{
					"id": 102020405,
					"content": "Evet! Lütfen! Ama... Hayır, yapamam. Klee iyi bir kız olmalı ve yaptıklarını düşünmeli... Beni ayartmayın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020406
					],
					"speakerTitle": "Hücre Hapsi"
				},
				{
					"id": 102020406,
					"content": "Hazır cezalıyken daha da özel, yeni bir hazine yapıyorum... Harpastum Festivaline özel bir hazine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020407
					],
					"speakerTitle": "Hücre Hapsi"
				},
				{
					"id": 102020407,
					"content": "\"Hazine\" derken...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020408,
					"content": "İşte! Hem de top şeklinde yaptım! Çok tatlı görünmüyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020409,
						102020410
					],
					"speakerTitle": "Hücre Hapsi"
				},
				{
					"id": 102020409,
					"content": "Top şeklinde bir bomba mı yaptın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020411
					]
				},
				{
					"id": 102020411,
					"content": "Harpastum Festivali gelsin de görün... Herkes bayılacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020412
					],
					"speakerTitle": "Hücre Hapsi"
				},
				{
					"id": 102020412,
					"content": "Aman! Jean bunları işitirse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102020413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020413,
					"content": "Klee çok daha uzun süre buradan çıkamaz gibi duruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102020410,
					"content": "Yani, yeni bir bomba yaptın, öyle mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020411
					]
				},
				{
					"id": 102020404,
					"content": "Yiyecek bir şeye ihtiyacın var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102020405
					]
				}
			]
		}
	]
}