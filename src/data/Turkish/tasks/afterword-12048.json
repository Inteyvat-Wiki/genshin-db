			"dialogs": [
				{
					"id": 120480101,
					"content": "Pardon, merhaba! Lütfen gelip kaydınızı yaptırın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480102
					],
					"speakerTitle": "Hyakujitsuhaku Shion"
				},
				{
					"id": 120480102,
					"content": "Neler oluyor? Neden bu kadar çok insan var? Bilseydim bir kısmını geri çevirirdim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480103
					],
					"speakerTitle": "Shiba Murasaki"
				},
				{
					"id": 120480103,
					"content": "Vay, Emura Ichigensai meselesi çözülünce işler yoluna girmiş gibi görünüyor. Murasaki ve Shion'un iyileştiğini görmek de güzel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120480104,
					"content": "#{NICKNAME}, Paimon, günaydın. Randevu almaya mı geldiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480105
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480105,
					"content": "Evet! Mümkünse bugüne lütfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120480106,
					"content": "O halde size yine VIP bilet vereyim ben. Ne de olsa bizim en önemli müşterilerimizsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480107
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480107,
					"content": "Hehe, çok iyi! O zaman VIP Paimon bu defa yemeklerle başlamak istiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120480108,
					"content": "Ah... Düşünsene, ya geçen gün tavsiyeme kulak verip hisselerini satmış olsaydın... Şimdi işlerin tekrar yoluna girmişken sana pahalıya patlardı. Umarım bana çok kızmamışsındır eski dostum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480109
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480109,
					"content": "Neden kızayım ki? Tavsiyeni ciddiye almamıştım zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480110
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480110,
					"content": "Ah, bu konuşmalarını bile özledim. Ne kadar sevecensin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480111
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480111,
					"content": "Cidden, her seferinde gizlice yaklaşmasan ölür müsün?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120480112,
					"content": "Günaydın ufaklıklar. Dün gece manzaranın tadını çıkardınız mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480113
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480113,
					"content": "Ne? Bizi mi gözetliyordun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120480114
					]
				},
				{
					"id": 120480114,
					"content": "Pek sayılmaz aslında. O ağaç Büyük Narukami Tapınağının tam altında. Ne yapsaydım, size alan tanımak için tüm tapınağı taşısa mıydım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480115
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480115,
					"content": "Burada olmanın özel bir sebebi var mı Leydi Guuji?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480116
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480116,
					"content": "Heh... Aslında yürüyüş yapmak istemiştim. Bir de Tenryou Heyetinden iletmem gereken bir mesaj var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480117
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480117,
					"content": "Dün gece Yumekui-baku arkadaşınızın sudan kurtardığı beyefendi kritik durumu atlattı. Ancak zihni küçük bir çocuğunki gibi çalışıyor artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480118
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480118,
					"content": "Daha kötüsü de olabilirdi... Leydi Guuji, sana bir teşekkür borçluyum. Senin yardımın olmasa dün işler bu kadar yolunda gitmezdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480119
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480119,
					"content": "Hımm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480120
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480120,
					"content": "Ben bir şey söylemedim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120480121
					]
				},
				{
					"id": 120480121,
					"content": "Hadi ama Miko. Sır tutma konusunda hep benden kötüydün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480122
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480122,
					"content": "Senin yanında daha özgüvensiz hissedip kendimi kanıtlama ihtiyacı duyduğumu kabul ediyorum. Nasıl böyle hissetmeyeyim ki? Hatta belki de bu işi bu kadar ileri götürmemi sağlayan şey bu duygularımdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480123
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480123,
					"content": "Bu özgüvensizlik kompleksim egomu kontrol altında tutuyor, kendimi kanıtlama arzumsa bana azim veriyor. Bu parçalarımı olduğu gibi kabul edebiliyorum. Bu konuda endişelenmene gerek yok yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480124
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480124,
					"content": "#*iç çeker* Bunu daha önce söylemeliydin... {NICKNAME} bunca zaman benim için koşturup durdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480125
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480125,
					"content": "#Evet. Ama yine de {NICKNAME} yardım etmese zor durumda kalırdın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480126
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480126,
					"content": "Emura Ichigensai büyük bir hayran kitlesine sahipti. Büyük Narukami Tapınağının Guujisi ona doğrudan karşı çıksa bu tehlikeli bir hareket olurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480127
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480127,
					"content": "Bir grup öfkeli fanatik tapınağın itibarına ciddi zarar verebilirdi... Guuji'nin doğrudan müdahale etmemesi daha güvenli ve daha doğru bir karardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480128
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480128,
					"content": "Tüm bunlar doğru ancak benim asıl endişem eski bir dostumu üzmemekti. Yoksa daha doğrudan bir yaklaşım benimseyebilirdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480129
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480129,
					"content": "Miko...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480130
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480130,
					"content": "Göründüğünden daha kurnaz ve daha az sevimli olduğunu hep unutuyorum... Anlaşılan seni üzmekle ilgili endişelerim yersizmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480131
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120480131,
					"content": "... Üzülmediğimden değil. Herkesin kendince sorunları vardır... Ancak her sorunun da bir çaresi vardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480132
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120480132,
					"content": "Buyurun, yeni VIP biletleriniz. Lütfen kaybetmeyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yumemizuki Mizuki"
				}
			]
		},
