			"dialogs": [
				{
					"id": 762080101,
					"content": "Hı? Etrafımızda şeffaf bir perde yükseliyor sanki... Yoksa bunu şu ağaç mı yapıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762080102,
					"content": "Sanki reçine püskürtüyor... Paimon'a kalırsa bütün burayı bir kehribar parçasına çevirmeye çalışıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762080103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762080103,
					"content": "Biz de içinde mahsur kalan küçük böcekler oluruz o zaman.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762080104
					]
				},
				{
					"id": 762080104,
					"content": "İçinde ikimizin olduğu bir kehribar parçası ha? Paimon bunun bütün açık artırmaların göz bebeği olacağına bahse girer! Resmen eşi benzeri olmayan bir hazine olurduk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762080105,
					"content": "O zaman asıl en değerli parça ne olurdu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762080106
					]
				},
				{
					"id": 762080106,
					"content": "Tabii ki de bu ağaç! Bütün bu kehribarı üreten o sonuçta. Şunu alıp yanımızda götürememek çok yazık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762080107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762080107,
					"content": "Paimon acaba etrafta bununla ilgili bir ipucu var mıdır diye merak ediyor.",
