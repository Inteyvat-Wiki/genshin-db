			},
			"dialogs": [
				{
					"id": 230060101,
					"content": "*iç çeker* Bu saatte yardım edecek birini nereden bulacağız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060102
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060102,
					"content": "Sorun ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060103
					]
				},
				{
					"id": 230060103,
					"content": "Ah! Selam Gezgin. Tedavi için mi geldin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060104,
						230060105
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060104,
					"content": "Yalnızca geçerken uğradım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060106
					]
				},
				{
					"id": 230060106,
					"content": "Hehe... O kadar belli oluyor muydu? Haklısın ama. Bir konuda endişeleniyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060107
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060107,
					"content": "Niye bilmiyorum ama son zamanlarda Bimarstan'a tedavi olmaya gelen insan sayısı arttı. Personel hastalara zor yetişiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060108
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060108,
					"content": "Dr. Zakariya yine de etrafı temiz tutmanın bir yolunu bulmam için ısrar etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060109
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060109,
					"content": "Hastane ve hastalar temiz tutulduğu takdirde Doğa Hükümdarı'nın lütfuna daha kolay erişebileceklerini söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060110
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060110,
					"content": "*iç çeker* Ama bu işe ayıracak adamımız yok. Hastalığı hafif olan hastalardan yardım isteyecek halim de yok yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060111,
						230060113
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060111,
					"content": "Temizlik işini bana bırakmaya ne dersin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060112
					]
				},
				{
					"id": 230060112,
					"content": "Yardım eder misin gerçekten? Ne kadar da naziksin! Ödemen hazır olacak. Sadece... Beklentilerini düşük tutman gerekebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060123
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060123,
					"content": "*iç çeker* Doğa Hükümdarı insanları hastalıklardan korusun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060113,
					"content": "Bu iş için birini tutamaz mısın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060114
					]
				},
				{
					"id": 230060114,
					"content": "Hastalarla dolu bir yerde çalışmayı isteyen pek fazla kişi yok. Ayrıca o kadar insanı işe alacak bütçemiz de yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060115
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060115,
					"content": "Normalde temizlik işini vardiyalara bölerdik ama şu anda boşta kimse yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060116
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060116,
					"content": "Kısacası Gezgin... Sen yardım edebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060117
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060117,
					"content": "Ödemeni yapacağız! Fazla bir şey veremeyeceğiz gerçi ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060118
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060118,
					"content": "Buradaki hastaların olayı ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060119
					]
				},
				{
					"id": 230060119,
					"content": "Hastaların çoğunun baş ağrısı falan gibi ufak şikayetleri var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060120
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060120,
					"content": "Dr. Zakariya onlara bu hastalıkların düşündükleri kadar korkunç olmadığını her defasında söylese de bu kimsenin işine gelmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060121
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060121,
					"content": "Korktukları şey hastalık değil de hasta olmak herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060122
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060122,
					"content": "Temizliği sana bırakıyorum o halde Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060123
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060105,
					"content": "Çok endişeli görünüyordun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060106
					]
				}
			]
		},
