						230060403
					]
				},
				{
					"id": 230060403,
					"content": "Sana ne kadar teşekkür etsem az Gezgin. Lütfen karşılığında bunu kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060404
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060404,
					"content": "Bu arada Bay Gurgen son zamanlarda yine kendisini çalışmaya zorluyor. Biraz daha vakit ayırıp fikrini değiştirmesini sağlamalıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060405
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060405,
					"content": "Son zamanlarda yapılması gereken çok şey var, o yüzden bir sonraki temizlik görevlerinde de sana gelebilirim.",
					"roleType": "TALK_ROLE_NPC",
