						230060302,
						230060306
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060302,
					"content": "Bana Zakariya'dan biraz daha bahseder misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060303
					]
				},
				{
					"id": 230060303,
					"content": "Dr. Zakariya çok iyi bir doktordur ve Doğa Hükümdarı'na yürekten inanır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060304
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060304,
					"content": "Günün her saati hasta tedavi eder, yemek yemeye bile zor zaman bulur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060305
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060305,
					"content": "Hatta Dr. Zakariya Doğa Hükümdarı'nın lütuflarını daha fazla insana ulaştırmanın kendi görevi olduğunu bile söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060306,
					"content": "Doğa Hükümdarı'nın lütfu insanları iyileştirme konusunda bu kadar önemli mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230060307
					]
				},
				{
					"id": 230060307,
					"content": "Aslında \"tedavi\" denilen şeyin kendisi Doğa Hükümdarı'nın bir lütfu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060308
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060308,
					"content": "Doğa Hükümdarı'nın lütfu sayesinde hastalara tedavi bulabildik ve hastalıkları tedavi etmek için bitkiler yetiştirebildik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230060309
					],
					"speakerTitle": "Golshan"
				},
				{
					"id": 230060309,
					"content": "Lütufların için teşekkür ederiz Doğa Hükümdarı. Herkesi hastalıklardan koru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Golshan"
				}
			]
		},
