					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4851107,
					"content": "#Bunun uçuş ehliyeti sınavının üçüncü ve sonuncu aşaması olmasına ne dersin {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851108,
					"content": "Sınavın böyle olması gerektiğine emin misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4851109,
					"content": "#Bu sınavın {NICKNAME} için özelleştirilmiş hali! Benim tarafımdan hazırlandı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851110,
					"content": "Ayrıca normal sınav Mondstadt'ın kahramanına hiç mi hiç yakışmazdı!",
