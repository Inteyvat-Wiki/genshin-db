			"dialogs": [
				{
					"id": 4850301,
					"content": "Karşıya geçmenin bir yolu yok gibi duruyor... Uff, buralarda bir yerde olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850302
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850302,
					"content": "Amber, baksana orada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850303,
					"content": "Beni takip etmekten vazgeçmiyorsanız öyle olsun madem. Küçük kızı kim getirdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850304
					],
					"speakerTitle": "Avcı"
				},
				{
					"id": 4850304,
					"content": "Sen Avcı olmalısın! Kaçamazsın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850305
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850305,
					"content": "Ha ha! Kaçmama gerek yok ki! Bu tarafa geçmenizin bir yolu yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850306
					],
					"speakerTitle": "Avcı"
				},
				{
					"id": 4850306,
					"content": "Ah... Çok yüksekmiş... Çok da uzak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850307
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850307,
					"content": "Küçük kız, hemen eve dönüp bu işi liderine bırakmaya ne dersin? Merak etmeyin, Büyük Kumandan buraya geldiğinde hemen teslim olacağım, söz veriyorum! Ha ha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850308
					],
					"speakerTitle": "Avcı"
				},
				{
					"id": 4850308,
					"content": "Laflarına dikkat et! Karşında Favonius Şövalyeleri Kaşifi var! Seni tutukladığımda çok pişman olacaksın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850309,
						4850310
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850309,
					"content": "Derin nefes al Amber.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850311
					]
				},
				{
					"id": 4850311,
					"content": "... Haklısın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850312
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850312,
					"content": "Uff... Tam karşımızda duruyor... Keşke karşıya geçmenin bir yolu olsaydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850313
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850313,
					"content": "Peki o nasıl geçti ki karşıya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850314,
						4850317,
						4850319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850314,
					"content": "Bir tür mekanizmayla mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850315
					]
				},
				{
					"id": 4850315,
					"content": "Mekanizma görmüyorum ben, üstelik gözlerim iyi görür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850316
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850316,
					"content": "Ayrıca kenarda mekanizma kurulacak bir yer de yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850322
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850322,
					"content": "Görüşürüz ufaklık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850323
					],
					"speakerTitle": "Avcı"
				},
				{
					"id": 4850323,
					"content": "Olamaz! Kaçıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850324,
					"content": "Daha fazla tereddüt edemeyiz. Karşıya geçmenin tek yolu oraya uçmak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850325
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850325,
					"content": "Ama... Ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850326,
					"content": "Merak etmeyin, ben Mondstadt Uçuş Şampiyonuyum, unuttunuz mu? Avcı yapabiliyorsa ben de yapabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850327
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850327,
					"content": "Ah, Kaşif! Kanadın olmadan burada Mondstadt'taki Rüzgar Tanrısı heykelinden atlamaktan daha az hayatta kalma şansın var! Ha ha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850328,
						4850329
					],
					"speakerTitle": "Avcı"
				},
				{
					"id": 4850328,
					"content": "Amber'a katılıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850330
					]
				},
				{
					"id": 4850330,
					"content": "#Paimon seni anladı {NICKNAME}... Tamamen imkansız olan her şeyi eleyince geriye sadece uçmak kalıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850331,
					"content": "#{NICKNAME}, sana verdiğim kitabı hatırlıyor musun? Uçuş kılavuzu sanıp vermiştim hani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850332
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850332,
					"content": "Uçamayan kuşlar. Uçmak, kanyona atlama cesaretini gösterdikleri için onlara verilen ödüldü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850333
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850333,
					"content": "Şahidim olun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850334
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850334,
					"content": "Kaşif, İleri Marş!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850335
					]
				},
				{
					"id": 4850335,
					"content": "Anlaşıldı! Kaşifin gücünü bu adama gösterelim hadi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850336
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850336,
					"content": "Bekle... Dur! Asla başaramazsın! Hadi ama, dön geri artık. Uslu bir kız olup evine geri dön.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850337
					],
					"speakerTitle": "Avcı"
				},
				{
					"id": 4850337,
					"content": "Avcı başaramayacağımı söylüyor. Ama dikkatlice dinlerseniz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850338
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850338,
					"content": "Rüzgar! Rüzgar BAŞARACAĞIMI söylüyor! Bu da bana yeter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850329,
					"content": "Bu iş cidden çok büyük cesaret istiyor ama tamamen imkansız sayılmaz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850330
					]
				},
				{
					"id": 4850317,
					"content": "Element büyüsüyle olabilir mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850318
					]
				},
				{
					"id": 4850318,
					"content": "#{NICKNAME}, Element Görüşünle bir şey görebiliyor musun? Hayır mı? Tamam... Boş ver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850319,
					"content": "Çengel, sivri uç ya da başka bir şeyle mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850320
					]
				},
				{
					"id": 4850320,
					"content": "Uçulamayacak kadar uzaksa bu tarz bir şey için de uzak demektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850321,
					"content": "Tutturma noktası izi de yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850322
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850310,
					"content": "Hadi etrafımıza bir bakalım. Tıpkı senin bana öğrettiğin gibi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850311
					]
				}
			]
		},
		{
			"id": 48506,
			"completionStepIds": [
				48506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
