					"nextDialogs": [
						4850805
					]
				},
				{
					"id": 4850805,
					"content": "Aa, seni sonraki Uçuş Şampiyonasına kaydettireyim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850806
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850806,
					"content": "Öyle hızlı uçuyorum ki bana kimse yetişemiyor. Gökyüzünde sadece ben, tek başıma uçup duruyorum... Biraz canım sıkılıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850807,
						4850808
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850807,
					"content": "Harika. Kesinlikle ben kazanacağım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850809
					]
				},
				{
					"id": 4850809,
					"content": "Ooo... Büyük konuşuyorsun! Anlaşılan şampiyonanın ne kadar korkutucu olduğu hakkında hiçbir fikrin yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850810
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850810,
					"content": "Pekala, ben şampiyonada seni alt edene kadar sana mutlu, özgürlüğü hissedeceğin ve her şeyin ötesinde yasalara uygun bir uçuş deneyimi dilerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850811
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850811,
					"content": "Kurallara uymayı sakın unutma. Sakın ha ehliyetini kaptırma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850812
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850812,
					"content": "Daha neler... Bunu Amber söyleyince biraz komik oldu bence...",
