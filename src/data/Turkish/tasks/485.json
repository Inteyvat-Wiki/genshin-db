					"nextDialogs": [
						4850619
					]
				},
				{
					"id": 4850619,
					"content": "Önce ben gidiyorum çünkü Avcı'yı şehre götürmem gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850620
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850620,
					"content": "Şehre geri dönünce Katedrale gelip beni bul. Uçuş ehliyetini orada vereceğim.",
