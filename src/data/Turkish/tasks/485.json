				{
					"id": 4851101,
					"content": "Orada tek bir yol var. Avcı bu tarafta olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851102,
					"content": "Ama yetişmenin tek yolu kanatlarla uçmak gibi duruyor.",
