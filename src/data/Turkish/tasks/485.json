					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4851104,
					"content": "Bunu yapacaksak <color=#00E1FFFF>uçup bir hamlede onları yenmemiz gerekiyor</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4851105,
					"content": "#{NICKNAME}, sınavının bir aşaması daha kalmıştı, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
