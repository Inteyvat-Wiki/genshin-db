			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4850601,
					"content": "Tamam! Onu yakaladım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850602
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850602,
					"content": "Rüzgar akıntısını havadayken fark ettim ve sadece bir tane var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850603
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850603,
					"content": "Avcı'nın gittiği tarafa doğru kaçmaya çalışmak intihar olurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850604
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850604,
					"content": "Yani Avcı'nın tek kaçış yolu bu taraftı, bizi geçmesi gerekiyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850605
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850605,
					"content": "Aha! Yani ukala ukala konuşup bizi kandırmaya çalışıyordu aslında, pes edip gideriz diye umuyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850606,
					"content": "Tabii bizim kolayca kanmayacağımızdan haberi yoktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850607,
					"content": "#Her şey {NICKNAME} sayesinde oldu! Tıpkı bilge bir adamın bir zamanlar dediği gibi: \"İmkansız olan seçeneği elediğinizde geriye kalan seçenek her ne kadar mümkün görünmese de doğru olandır.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850608
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850608,
					"content": "Sonuçta kanatla uçmanın yüzde yedisi teknik, yüzde üçü içgüdü, yüzde doksanı ise cesarettir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850609
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850609,
					"content": "Senin yaptığının yüzde doksan dokuzu cesaretti bence...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850610,
					"content": "Ah, tıpkı benim ilk uçuş ehliyeti sınavımdaki gibiydi... Aşırı gerilmiştim ama sonuç olarak korkacak bir şey yoktu ve sorun yaşamadan geçtim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850611
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850611,
					"content": "O zamandan beri girdiğim sınavlarda o heyecanı yaşamayı özledim... Aynı hisler yoktu ama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850612
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850612,
					"content": "... Şey, pardon. Paimon sorun yaşamadan geçtiğini söylediğini sanmıştı. O zamandan beri girdiğin sınavlar derken ne demek istedin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850613,
					"content": "Aa... Şey, Mondstadt durmadan burası \"uçma bölgesi değil\", şurası \"iniş bölgesi değil\" dediğinden...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850614
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850614,
					"content": "*iç çeker* Ehliyetimi her aldığımda iptal edip duruyorlar. Sınava toplam 15 kez falan girmişimdir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850615
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850615,
					"content": "Ama hep ilk denememde geçtim. Galiba minik uçma kılavuzum o kadar da kötü değilmiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850616
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4850616,
					"content": "#... {NICKNAME}, gidip bir ara Büyük Kumandan Vekili Jean'den asıl uçuş kılavuzunun bir kopyasını alalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850617,
						4850618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4850617,
					"content": "Güzel plan.",
