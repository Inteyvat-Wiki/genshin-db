						],
						"pointId": 340100403
					}
				]
			},
			"dialogs": [
				{
					"id": 140160701,
					"content": "Tamamen otomatik bir olta kullanıyorsan balıkçılık neresinde bunun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160702,
					"content": "Hımm? Nesi var ki? Poisson'da çoğu kişi bu tür oltalar kullanıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160703
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160703,
					"content": "Ama... Ama balıkçılık böyle bir şey değil ki... Attığın yemi dikkatle izlemen, sonra nihayet balık takıldığında büyük bir heyecanla oltayı çekmen gerekmez mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160704,
					"content": "#Öyle de olur tabii, kişiye kalmış! Sen ne düşünüyorsun {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160705,
						140160707
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160705,
					"content": "Paimon'a katılıyorum. Eski usulcüyüm ben de.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160706
					]
				},
				{
					"id": 140160707,
					"content": "Bence otomasyon daha verimli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160708
					]
				},
				{
					"id": 140160706,
					"content": "O zaman bir dahakine normal oltalar deneyelim. Gerçek bir balıkçılık yarışması yaparız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160709
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160708,
					"content": "Haha, katılıyorum. Balık yakalayabildiğim sürece bana hava hoş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160709
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160709,
					"content": "Açıkçası Paimon bu saatte bu kadar enerjin olmasına çok şaşırdı. Genelde gecenin bu vaktinde Paimon gözlerini açık tutmakta çok zorlanır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160710,
					"content": "Eh, ailemden geliyor olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160711
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160711,
					"content": "Öyle bir şey mi var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160712,
					"content": "Hehe, ayrıntılara girersek daha da çok uykun gelir. Neyse, anneme ve Spina'daki diğer herkese ne kadar minnettar olduğumu düşünüyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160713
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160713,
					"content": "Annene mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160714
					]
				},
				{
					"id": 140160714,
					"content": "Babamın benden çok abartı beklentileri vardı. Beni kendisine benzetmeye çalıştıkça ağzından çıkanları dinleme hevesim de o kadar kaçtı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160715
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160715,
					"content": "Annemin öyle beklentileri olmadı ama hiç. Duyduğuma göre benim için sadece tek dileği varmış, o da mutlu ve güvenli bir çocukluk yaşamammış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160716
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160716,
					"content": "Spina üyeleri onun bu dileğine saygı duymuş, ben çocukken ne yaparsam yapayım bana hoşgörüyle yaklaşırlardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160717
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160717,
					"content": "Düşünebiliyor musunuz? Babam beni azarlayacağı zaman millet iki sıra haline girer ve sessizce dikilip babamın fırçalarını dinlerdi. Melus ve Silver da hep orada olurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160718
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160718,
					"content": "Babam ne kadar bağırırsa bağırsın kimseden çıt çıkmazdı. Herhalde babam bir gün beni önemsiz konular yüzünden azarlamanın gereksiz olduğunu fark etmiş olacak ki bana fırça atmayı giderek azalttı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160719
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160719,
					"content": "Paimon şaşırdı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160720,
					"content": "Evet... Şu an bir yetişkin olarak dönüp bakınca herkesin bana karşı ne kadar sabırlı ve kibar olduğuna inanamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160721
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160721,
					"content": "Gençken aklıma eseni yapabileceğimi düşünürdüm hep, nasıl olsa arkamı toplayacak birileri oluyordu sürekli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160722
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160722,
					"content": "Ama bir keresinde Melus'un yaralı halde döndüğünü gördüm. Nasıl yaralandığını söylemedi ama benimle bir ilgisi olduğunu anlamıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160723
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160723,
					"content": "İşte o gün her hatanın bir bedeli olduğunu öğrendim. Çevrendekilere ne kadar değer veriyorsan elinden geldiğince doğru olanı yapmaya da aynı ölçüde özen göstermelisin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160724
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160724,
					"content": "Çünkü olur da bocalarsan bir gün sonuçlarıyla yüzleşmen gerekir. Yüzleşme vakti geldiğinde ise en değer verdiğin kişiler kendilerini sana siper eder ve hatanın bedelini senin yerine onlar öder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160725,
						140160726
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160725,
					"content": "Navia...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160727
					]
				},
				{
					"id": 140160726,
					"content": "Senin için hâlâ çok zor, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160727
					]
				},
				{
					"id": 140160727,
					"content": "Kusura bakmayın, bu konuyu açmasaydım keşke. Bu gece hüzünlü şeylerden konuşmak istemiyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160728
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160728,
					"content": "Neyse, sonuç olarak Spina'daki hoşgörülü ortamın babamdan ziyade annemin mirası olduğunu söylüyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160729
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160729,
					"content": "Annemin sevgisini hissetmemin tek yolu buysa ben de diğerlerine karşı o hoşgörüyü göstermek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160730
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160730,
					"content": "Bugün o adamları o yüzden mi gönderdin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160731
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160731,
					"content": "Evet, gerçi tabii belki de geçmişteki hataları tekrarlamak istemediğim içindir. Mantıklı biri olarak görülmek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160732
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160732,
					"content": "#{NICKNAME}, bak! Galiba bir şey yakaladın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160733
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160733,
					"content": "Olta neden otomatik çekmiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160734,
					"content": "Mekanizmayı kurarken bir yerde yanlış yaptım herhalde. Böyle bir oltayı hayatımda ilk kez kurdum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160735
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160735,
					"content": "Kaçırmamalıyız! Hadi hep birlikte, yakalayalım şunu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160736
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160736,
					"content": "P-Paimon da mı yardım etsin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160737
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160737,
					"content": "Bir süre uğraştıktan sonra nihayet büyük bir balık yakalamayı başarıyorsunuz.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						140160738
					]
				},
				{
					"id": 140160740,
					"content": "Ne... Oltana kanca takmadın mı sen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
