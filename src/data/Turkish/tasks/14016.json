				]
			},
			"dialogs": [
				{
					"id": 140160601,
					"content": "Muhteşem bir yemek yiyip hoş bir performans izliyorsunuz. Gece saatleri siz farkına varmadan akıp geçiyor.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140160602
					]
				},
				{
					"id": 140160602,
					"content": "Etraf durulduktan sonra Paimon'la odanıza dönüyorsunuz fakat çok geçmeden kapınız çalınıyor...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140160603
					]
				},
				{
					"id": 140160603,
					"content": "Selam. Uyudunuz mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160604,
						140160605
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160604,
					"content": "Navia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160606
					]
				},
				{
					"id": 140160606,
					"content": "Yok, bir şey olmadı. Böyle gecelere pek denk gelemiyoruz ya hani, dibine kadar tadını çıkaralım dedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160607
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160607,
					"content": "Balığa gitmek ister misiniz? Yanımda olta ve yem var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160608
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160608,
					"content": "Demek bahsettiğin \"hazırlık\" oydu! Tabii, geliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160609,
					"content": "Hehe, umarım uykunuzu bölmemişimdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160610,
						140160613
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160610,
					"content": "Yok yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160611
					]
				},
				{
					"id": 140160611,
					"content": "Merak etmeyin, çok yorgunsanız balık tutmanıza gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160612
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160612,
					"content": "Sadece bana eşlik edecekmişsiniz gibi düşünün. Ne dersiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160615
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160615,
					"content": "Tamam, hadi gidelim. Balıklar bizi bekler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160613,
					"content": "Madem davet senden geliyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160614
					]
				},
				{
					"id": 140160614,
					"content": "Hehe, biliyordum, en iyi ortaklarımsınız işte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160615
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160605,
					"content": "Bir şey mi oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160606
					]
				}
			]
		},
		{
			"id": 1401607,
