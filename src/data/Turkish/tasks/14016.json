			"dialogs": [
				{
					"id": 140160401,
					"content": "Konuşun bakalım. Kimsiniz ve neden peşimizdesiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160402
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160402,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160403
					],
					"speakerTitle": "Martinat"
				},
				{
					"id": 140160403,
					"content": "Susmak bir işinize yaramaz, aklınızda olsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160404,
						140160405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160404,
					"content": "Durumun farkındasınızdır umarım. Kaçmayı düşünmeyin bile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160406
					]
				},
				{
					"id": 140160406,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160407
					],
					"speakerTitle": "Martinat"
				},
				{
					"id": 140160407,
					"content": "Nasılsınız Patron? Yaralanan oldu mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160408
					],
					"speakerTitle": "Colter"
				},
				{
					"id": 140160408,
					"content": "Bize karşı bir şansları olduğunu düşündüysen çok yanılmışsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160409
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160409,
					"content": "Neyse, sert çocuk havalarını bırakın da konuşun. Asayiş Dairesi dahil olduğunda uzlaşma şansınız olmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160410
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160410,
					"content": "... Spina di Rosula'dan intikam almak istedik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160411
					],
					"speakerTitle": "Martinat"
				},
				{
					"id": 140160411,
					"content": "Ama bizi fark ettiniz, dövüşte de sizi alt edemedik... Kabul ediyoruz, yenildik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160412
					],
					"speakerTitle": "Martinat"
				},
				{
					"id": 140160412,
					"content": "İntikam mı dedin? Bir dakika... Siz Romeuf'ün adamları mısınız yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160413
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160413,
					"content": "Nereden biliyorsun o ismi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160414
					],
					"speakerTitle": "Martinat"
				},
				{
					"id": 140160414,
					"content": "Biliyorsan sizden neden bu kadar nefret ettiğimizi de anlıyorsundur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160415
					],
					"speakerTitle": "Martinat"
				},
				{
					"id": 140160415,
					"content": "Sakinleşmeni öneririm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160416
					]
				},
				{
					"id": 140160416,
					"content": "Katılıyorum. Şu an kazanma gibi bir ihtimaliniz kalmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160417
					],
					"speakerTitle": "Colter"
				},
				{
					"id": 140160417,
					"content": "Cık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160418
					],
					"speakerTitle": "Martinat"
				},
				{
					"id": 140160418,
					"content": "Dışarıda içiyorduk, Navia'yı gördük. O kadar sinirlendik ki sizi takip edip tadınızı kaçırmak için bir fırsat bekledik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160419
					],
					"speakerTitle": "Martinat"
				},
				{
					"id": 140160419,
					"content": "Ama önce siz bizim tadımızı kaçırdınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160420
					],
					"speakerTitle": "Martinat"
				},
				{
					"id": 140160420,
					"content": "Yalan söylüyorsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160421
					]
				},
				{
					"id": 140160421,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160422,
						140160423
					],
					"speakerTitle": "Martinat"
				},
				{
					"id": 140160422,
					"content": "Bizi buraya kadar takip etmişsiniz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160424
					]
				},
				{
					"id": 140160424,
					"content": "Çok akıllısın. Ne olmuş yani? Bir şey yapmadık ki. Size bir şey yapamayacağımız da belli olmuştur zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160425
					],
					"speakerTitle": "Martinat"
				},
				{
					"id": 140160425,
					"content": "Sizi öyle görünce birden tepemiz attı, içkiliydik zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160426
					],
					"speakerTitle": "Martinat"
				},
				{
					"id": 140160426,
					"content": "Bakın, Callas öleli çok oldu. Geçmişte ne yaşanmışsa yaşanmış, ben yeni bir başlangıç yapmak istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160427
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160427,
					"content": "Spina di Rosula'nın şu anki Başkanı benim. Patronunuz benimle konuşmak isterse kapım kendisine açık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160428
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160428,
					"content": "Saldırınız için suç duyurusunda bulunmayacağım. Dediklerimin arkasında olduğumu böylece anlarsınız belki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160429
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160429,
					"content": "... Anladım, teşekkürler. Patronumuza haber vereceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160430
					],
					"speakerTitle": "Martinat"
				},
				{
					"id": 140160430,
					"content": "Ama bir daha buna benzer bir şey denemeye kalkarsanız işte o zaman gözünüzün yaşına bakmam. Anladınız mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160431
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160431,
					"content": "Tamam, anladık. Haydi, gidelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160432
					],
					"speakerTitle": "Martinat"
				},
				{
					"id": 140160432,
					"content": "Gitmelerine izin vermek doğru bir karar mı Navia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160433,
					"content": "Babamın düşmanlıklarını da devralmak istemiyorum. Ayrıca feribüs konusunda babamın yaptıklarının tamamen doğru olduğunu da savunmuyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160434
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160434,
					"content": "Karşı tarafın oturup konuşmaya niyeti varsa uzlaşmak için ben de bir adım atmaya hazırım. Yeni başlangıçlara fırsat vermek gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160435
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160435,
					"content": "Patrona katılıyorum. Bu \"göze göz\" olayı ilkel bir kavram, bugünün Spina di Rosula'sında yeri yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160436
					],
					"speakerTitle": "Colter"
				},
				{
					"id": 140160436,
					"content": "Evet. Hem şu an paraya sıkışık olduklarını biliyoruz. Finansal durumları o kadar vahimse bize meydan okuyacak kaynakları yok demektir. Konuşmak için gayet iyi bir zaman o halde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160437
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160437,
					"content": "Gerçi yine de Romeuf'ün adamlarına karşı bir gözümüzü açık tutalım derim. Olur da yaptığım uyarıyı görmezden gelmeye karar verirse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160438
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160438,
					"content": "Yine dövüşmemiz gerekir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160439
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160439,
					"content": "Evet, o adamların sana hayran olmadıkları belliydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160440
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160440,
					"content": "İşlerin o raddeye ulaşmamasını yeğlerim... Birbirimizle yıllardır konuşmamış olsak da bir zamanlar hepimiz Spina di Rosula ailesinin birer parçasıydık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160441
					],
					"speakerTitle": "Colter"
				},
				{
					"id": 140160441,
					"content": "Evet, katılıyorum. Neyse madem, paketleyip yolladığımıza göre o adamları düşünmemize gerek kalmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160442
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160442,
					"content": "Saat de geç oluyor, bu gece Cendre Nehri'nde kalalım mı? Poisson'a yarın döneriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160443
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160443,
					"content": "Ayrıca Florent'a bir mektup yazdırayım, bugün yaşananları bilmesi gerek. Poisson çevresindeki güvenliği artırsın ve şüpheli kişilere karşı bir gözü açık olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160444
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160444,
					"content": "Yine mi Cendre Nehri'nde kalmamız gerekiyor? Oranın yastıkları bile yosun kokuyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160445
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160445,
					"content": "Kusura bakmayın, suya yakın yaşayıp pek gün ışığı almayınca öyle oluyor. Poisson da aşağı yukarı aynı sayılır gerçi, ben çoktan alıştım o yüzden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160446
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160446,
					"content": "Akşam vakti ızgara balık yiyip bir şeyler içebiliriz aslında. Hem kesin şarkı söyleyen denizciler de olur! Ne dersiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160447
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160447,
					"content": "Aa, güzelmiş! Tamam o zaman, Paimon'a uyar. Hadi gidelim, Paimon da şarkı söylemek istiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160423,
					"content": "Başka bir iş var bunun içinde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160424
					]
				},
				{
					"id": 140160405,
					"content": "Yukarıda ve aşağıda da adamlarımız var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160406
					]
				}
			]
		},
