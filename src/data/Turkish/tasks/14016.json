					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160202
					],
					"speakerTitle": "Martinat"
				},
				{
					"id": 140160202,
					"content": "Hım. Bunları konuşturmak istiyorsak önce bir ders vermemiz gerekecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160203
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160203,
					"content": "Kardeşlerim, karanlıkta saklanmamıza gerek yok artık! Vakit, günlerini gösterme vaktidir!",
					"roleType": "TALK_ROLE_NPC",
