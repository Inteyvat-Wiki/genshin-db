			"dialogs": [
				{
					"id": 140160801,
					"content": "Boşa vakit harcamayın. Patron tüm gün bekleyemez sizi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160802
					],
					"speakerTitle": "Martinat"
				},
				{
					"id": 140160802,
					"content": "Yarın operasyonu gerçekleştiriyoruz. Bu bilgiyle ne yaparsanız yapın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160803
					],
					"speakerTitle": "Martinat"
				},
				{
					"id": 140160803,
					"content": "Heh, senin oltanın da bir parçası eksikmiş... O yüzden eşit sayılırız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160804
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160804,
					"content": "Kayıp parçaların sayısından bahsediyorsak evet... *esner* Of, neyse, Paimon gerçekten uyanık kalamıyor daha fazla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160805,
					"content": "Hahaha, hadi siz doğru yatağa! Çok güzel bir gündü bugün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160806
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160806,
					"content": "Yarın görüşürüz Navia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160807
					]
				},
				{
					"id": 140160807,
					"content": "Görüşürüz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160808
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160808,
					"content": "Nasıldı geceniz? İyi uyuyabildiniz mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160809
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160809,
					"content": "Paimon denizde ışıldayan yıldızlarla dans ettiğini gördü rüyasında... Göz kamaştırıcı bir rüyaydı yani. Anladın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160810,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160811
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160811,
					"content": "Nereden çıktı bu şaka şimdi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160812
					]
				},
				{
					"id": 140160812,
					"content": "Hahaha, espri anlayışın süpermiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160813
					],
					"speakerTitle": "Colter"
				},
				{
					"id": 140160813,
					"content": "Bak, bu adam Paimon'u anlıyor işte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160814,
					"content": "Neyse, hadi çıkalım. Bizi Poisson'a geri götürecek bir tekne ayarlayacağım. Adele sizi tekrar görünce sevinir eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160815
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160815,
					"content": "Hediyeni beğenir diye umuyor Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160816,
					"content": "Ben de öyle umuyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				}
			]
		},
