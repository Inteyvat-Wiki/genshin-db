			"dialogs": [
				{
					"id": 140160101,
					"content": "Naber Ludivine? İşler nasıl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160102
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160102,
					"content": "Aa, Matmazel di Rosula! Şöyle söyleyeyim, hâlâ iflas etmediysem sizin desteğiniz sayesinde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160103
					],
					"speakerTitle": "Ludivine"
				},
				{
					"id": 140160103,
					"content": "Haha, bırak şimdi bu şakaları, hepimiz ne kadar yetenekli bir iş kadını olduğunu biliyoruz. Ayrıca hatırlatayım, kendisi artık Patron olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160104
					],
					"speakerTitle": "Colter"
				},
				{
					"id": 140160104,
					"content": "Pardon, benim hatam. Matmazel demeye çok alışmıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160105
					],
					"speakerTitle": "Ludivine"
				},
				{
					"id": 140160105,
					"content": "Üniformayı almaya mı geldiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160106
					],
					"speakerTitle": "Ludivine"
				},
				{
					"id": 140160106,
					"content": "Evet. Geçen işlerimi halletmeye geldiğimde sana uğramayı unuttum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160107
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160107,
					"content": "Haha, bizzat Matmazel'in gelip almasını beklemiyordum açıkçası. Alt tarafı bir üniforma sonuçta. Çalışanlarından biri de gelebilirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160108
					],
					"speakerTitle": "Ludivine"
				},
				{
					"id": 140160108,
					"content": "Navia en ufak şeyleri bile ciddiye almayı seviyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160109,
					"content": "Gelmemin tek sebebi üniforma değil! Yürüyüşe çıkıp kafamızı dağıtmak istedik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160110
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160110,
					"content": "Yeni bir yolculuğa ilk adımı atmak kadar motive edici çok az şey var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160111
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160111,
					"content": "Haha, Patron haklı. Arkadaşlarla yolculuk yapmak, evde oturup sıkılmaktan iyidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160112
					],
					"speakerTitle": "Colter"
				},
				{
					"id": 140160112,
					"content": "Peki... Ben gidip üniformayı getireyim, bekleyin lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160113
					],
					"speakerTitle": "Ludivine"
				},
				{
					"id": 140160113,
					"content": "Biri Paimon'a hatırlatabilir mi, Adele neden Spina'ya katılmak istiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160114,
					"content": "Hehe, bana net bir sebep vermedi. Sadece bana hayranlık duyduğunu söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160115
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160115,
					"content": "Babasının adını temize çıkardığımızdan beri daha neşeli ve sosyal bir çocuğa dönüştü. Artık babasının kötü bir adam olmadığına emin olduğu için olsa gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160116
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160116,
					"content": "Eskiden babasından korkuyormuş, o yüzden Spina'daki diğer herkesi de korkutucu buluyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160117
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160117,
					"content": "Ama bugünkü Spina çok farklı artık. Cesaretini toplayıp benimle konuştu, ben de onu gerçekten anladığımı hissettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160118
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160118,
					"content": "İkiniz de benzer bir dram yaşadınız.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160119
					]
				},
				{
					"id": 140160119,
					"content": "Evet, doğru. Vakanın ardındaki gerçeği ortaya çıkararak onun da içini rahatlatmış oldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160120
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160120,
					"content": "Benim gibi biri olmak istediğini söyledi. Durup etrafındakilerden yardım beklemektense gidip başkalarına yardım eli uzatmak istiyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160121
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160121,
					"content": "Öyleyse Spina'ya çok iyi bir katkısı olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160122
					],
					"speakerTitle": "Colter"
				},
				{
					"id": 140160122,
					"content": "Bence de ama şimdilik ona güzelce büyüyebileceği bir ortam sunmaya bakalım. Yaşı büyüdüğünde bize katılabilir, bu kararı da kendi verebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160123
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160123,
					"content": "(Gaipten sesler duymuyormuşum demek ki.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160124
					]
				},
				{
					"id": 140160124,
					"content": "#Bir şey mi oldu {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160125,
						140160126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160125,
					"content": "Gelin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160127
					]
				},
				{
					"id": 140160127,
					"content": "Ne? T-Takip mi? Paimon geliyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160128,
					"content": "Ben de geliyorum! Colter, bunu benim için tutar mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160129
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160129,
					"content": "T-Tamam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Colter"
				},
				{
					"id": 140160126,
					"content": "Biri bizi takip ediyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140160127
					]
				}
			]
		},
