			},
			"dialogs": [
				{
					"id": 140160501,
					"content": "Dönüp dolaşıp geldik yine buraya. Aslında düşününce Paimon burayı biraz sevmeye başladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160502,
					"content": "Zaten baktığında Spina'nın şehirdeki üssü, Mermonia Sarayı gibi şatafatlı bir bina olsaydı tuhaf olurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160503,
					"content": "Hahaha, aynen! Kesinlikle haklısın Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160504
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160504,
					"content": "Gerçi tabii Spina'nın istikrarlı büyümesinden ötürü babam Poisson'un Fontaine Şehri'ne benzer bir merkez haline gelmesini istiyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160505
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160505,
					"content": "Çok hırslı bir adamdı, tamamen hedefine odaklıydı. İyisiyle kötüsüyle bir şekilde diğer herkesten bir adım öne çıkardı bu özelliğiyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160506
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160506,
					"content": "O yüzden seveni olduğu kadar nefret edeni de çoktur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160507
					],
					"speakerTitle": "Colter"
				},
				{
					"id": 140160507,
					"content": "Neyse, beni restoranda bekleyebilir misiniz? Ben gidip hazırlık yapayım, gitmişken odanızı da hazırlatırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160508
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160508,
					"content": "Geçen seferki odada kalabilirsiniz yine. Oda numarasını hatırlıyorsunuz, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160509
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160509,
					"content": "Evet! Zaten çok fazla oda yok burada, hangisi olduğunu unutmak zor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160510,
					"content": "Ooo, biri Cendre Nehri'ne laf mı attı yoksa? Gideyim de adamlarıma söyleyeyim o zaman, yastıklarınızı yosunlarla doldursunlar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160511
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140160511,
					"content": "Paimon özür diliyor! Lütfen affet Navia! Yoksa gece Paimon'un gözüne asla uyku girmez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140160512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140160512,
					"content": "Hahaha, şaka yapıyorum canım. Hadi gidin bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				}
			]
		},
