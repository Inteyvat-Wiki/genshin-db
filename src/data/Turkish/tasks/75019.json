			"dialogs": [
				{
					"id": 750190701,
					"content": "Hehe, güzel! Kazandık! Çok iyi iş çıkardık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190702,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190703
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190703,
					"content": "Hah... Kabilemizin en iyi savaşçısının bile seni yenebileceğini sanmıyorum... Net bir yenilgiydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190704
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190704,
					"content": "Sen bu konuda ne düşünüyorsun dostum? Sanırım daha çok idman yapmamız lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190705
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190705,
					"content": "Hımm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190706
					],
					"speakerTitle": "Uchu"
				},
				{
					"id": 750190706,
					"content": "Gerçekten de harika bir savaş oldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190707
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190707,
					"content": "Konuşmaya gelince çok iyisin Manqu ama becerebildiğin tek şey laf mı? Sen de bir denemek ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190708
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190708,
					"content": "Çok teşekkürler, ben almayayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190709
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190709,
					"content": "#Anca laf, çok sıkıcısın. Güzel bir karşılaşmaydı {NICKNAME}... Sen gerçekten işinin erbabısın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190710,
						750190712
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190710,
					"content": "Daha yeni ısınıyordum halbuki...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190711
					]
				},
				{
					"id": 750190711,
					"content": "Hahaha! Ne kadar da kendinden emin! Hoşuma gitti. Güçlülerin az da olsa iddialı olduklarını göstermeleri gerekir! Yoksa güçlü olmanın ne anlamı kalır ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190714
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190714,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190715
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190715,
					"content": "#Haha, görünüşe göre epey iyi bakılmışsın {REALNAME[ID(2)|SHOWHOST(true)]}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190716
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190716,
					"content": "#Tabii ki! {REALNAME[ID(2)|SHOWHOST(true)]} bizim güvenilir yoldaşımızdır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190717,
					"content": "Bunu duyduğuma sevindim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190718
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190718,
					"content": "Söz verdiğim gibi alın işte, kabile şefi tarafından kabul edildiğinize dair kanıt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190719
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190719,
					"content": "Resmi adı ise... Iıı, Manqu konuşma sırası sende...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190720
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190720,
					"content": "Waxaklahun Ubah Kan'ın Tılsımı... Alev Çalan Bilge'nin yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190721
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190721,
					"content": "Hah işte ondan, bu ismi asla ezberleyemiyorum ben. Ateşin Ejderha Hükümdarının ölümünden ve ilk Ateş Hükümdarının alevlerden yeniden doğuşundan sonra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190722
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190722,
					"content": "Bilge ile Hükümdar yanardağdan birer nişan getirdiler. Bu nişanların her ikisini de elde eden kişi, yanardağın içerisindeki arındırıcı ateşe girip tüm lanetleri ve felaketleri ortadan kaldırabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190723
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190723,
					"content": "Bu Bilge kaç yıl yaşamıştı Manqu? Kabile çağından Ochkanatlan dönemine kadar yaşadığına dair hikayeler duyduğumu hatırlıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190724
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190724,
					"content": "... Hatta Gölge İğnesine dair onunla alakalı efsaneler bile var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190725
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190725,
					"content": "Filojiston kullanan ilk insan oymuş... Böylesine efsanevi birinin akıbeti kim bilir ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190726
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190726,
					"content": "Kimileri bedeniyle ruhunun Filojistona dönüşüp Natlan'ın rüzgarlarına, topraklarına ve çiçeklerine karıştığını, böylece kendisine yardım için dua eden kabile üyelerinin seslerini duyabilme gücüne eriştiğini söyler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190727
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190727,
					"content": "Kimileri ise her çağın kendi halefine bilgelik unvanı verip onu nesilden nesile aktararak günümüze kadar ulaştırdığını söylüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190728
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190728,
					"content": "Açık sözlülüğümü mazur görün ama bunlar genellikle hikayecilerin varsayımlarından ibarettir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190729
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190729,
					"content": "Haha, sözlerine dikkat etsen iyi olur. Titu'yu yine kızdıracaksın yoksa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190730
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190730,
					"content": "Pekala, benim görevim böylece sona ermiş oldu. Bir dakika, geleneklere göre yapmam gereken bir şey daha var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190731
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190731,
					"content": "Cesur gezginlere ve onların yoldaşlarına lütuf bahşetmem gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190732
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190732,
					"content": "Hım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190733
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190733,
					"content": "Bu da sizin ritüellerinizden biri mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190734,
					"content": "Hah, daha çok manevi bir destek diyebiliriz. Çok bir şey beklemeyin, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190735
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190735,
					"content": "#Pekala o zaman. {NICKNAME}, {REALNAME[ID(2)|SHOWHOST(true)]}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190736
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190736,
					"content": "Buradayım şef.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190737
					]
				},
				{
					"id": 750190737,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190738
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190738,
					"content": "Güçlü kuşlar gibi dağların arasından süzülüp geçesin.\\nAzılı dalgalara karşı sağlam kayalar gibi dimdik durasın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190739
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190739,
					"content": "Dünya hangi zorluklarla dolarsa dolsun, hiçbirinin korkusu seni yıldıramasın.\\nAyrılık kaderinden kaçış yok, fakat siz hiç birbirinizden ayrılmayasınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190740
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190740,
					"content": "İstediğin yere ulaşıp istediğin her şeyi elde edesin... Ve her şeyden de önemlisi, sağ salim geri dönesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190741
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190741,
					"content": "İçin rahat olsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190742
					]
				},
				{
					"id": 750190742,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190743
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190743,
					"content": "Ne? Paimon'a herhangi bir lütufta bulunmayacak mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190744
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190744,
					"content": "Haha! Sana gelince minik Paimon... Yiyeceğin içeceğin bol, uykun derin, büyümen sağlıklı olsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190745,
						750190746
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190745,
					"content": "Hiç de fena değil!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190748
					]
				},
				{
					"id": 750190748,
					"content": "Her neyse, Paimon bu lütfu kabul etsin bari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190749
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190749,
					"content": "Bana uyar. O halde, tanıklık ayini sona erdi ama gitmeden önce tekrar hatırlatayım: Dikkatli olun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190750
					],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190750,
					"content": "Tamam Pacal, anlaşıldı. Görüşürüz! Sen de kendine iyi bak Uchu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190751
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190751,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190752
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750190752,
					"content": "Raarr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190753
					],
					"speakerTitle": "Uchu"
				},
				{
					"id": 750190753,
					"content": "Bol şans. Yakında görüşmek üzere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pacal"
				},
				{
					"id": 750190746,
					"content": "Sağlıklı ya da sağlıksız, sen daha da büyüyebilir misin Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190747
					]
				},
				{
					"id": 750190747,
					"content": "Tabii ki! Zamanı gelince göreceksin, sen farkına varmadan Paimon'un üç dağ boyuna ulaşmış!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190748
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750190712,
					"content": "Sen de fena değildin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750190713
					]
				},
				{
					"id": 750190713,
					"content": "Hahaha, teselliye gerek yok. Biraz daha genç olsaydım kim bilir sonuç nasıl olurdu? Keşke o zamanlar seninle bir karşı karşıya gelebilseydik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190714
					],
					"speakerTitle": "Pacal"
				}
			]
		},
