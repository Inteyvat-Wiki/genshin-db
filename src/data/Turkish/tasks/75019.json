			"dialogs": [
				{
					"id": 750190601,
					"content": "Açık sözlülüğüm için tekrar özür dilerim... Gücünün farkındayım ama sen yine de dikkatli ol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190602
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190602,
					"content": "Kadim Ad elde edemedi ama Pacal da hafife alınacak biri değildir... Hele ki son birkaç yılda idmanlarını ihmal etmemişse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750190603
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750190603,
					"content": "Hazırsanız başlayalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manqu"
				}
