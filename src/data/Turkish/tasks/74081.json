					}
				]
			},
			"dialogs": [
				{
					"id": 740811701,
					"content": "Şey, acaba biz... Çok kötü bir şey mi yaptık?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811702,
					"content": "Az önce bir titreşim hissettim, çok tuhaf...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811703,
						740811704
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811703,
					"content": "Ben de hissettim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811705
					]
				},
				{
					"id": 740811705,
					"content": "Hımm, acaba üst kattaki cihazla uğraştık diye mi böyle oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811706,
					"content": "Bu kapı önceden kilitli değil miydi? Hatta Kurmalı Mekalar koruyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811707,
						740811708
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811707,
					"content": "Muhafızlara ufak bir \"mola\" verdirip kapıyı açtım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811709
					]
				},
				{
					"id": 740811709,
					"content": "Başka... Başka şansımız yoktu! Önce onlar saldırdı, biz yalnızca kendimizi savunduk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811710,
					"content": "Maillardet'nin prototipleri... Uyku modunda olmaları gerekiyordu. Erinnyes'te güzel bir yere kapak atınca buraya çok az uğrar olmuştu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811711
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811711,
					"content": "Şimdi düşündüm de araştırmalarını şık bahçelerde saygın bir dinleyici kitlesine sergilemek varken kim bu nemli, köhne laboratuvara gelir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811712
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811712,
					"content": "Bay Bossuet buradan ayrıldıktan sonra, herkes tıpkı bu malzemeler gibi Enstitünün dört bir yanına dağılıp gitti. Geriye bir koltuk bile kalmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811713
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811713,
					"content": "Burada yalnızca asla dönmeyecek araştırmacıları bekleyen prototipler olmalıydı. Normalde uyku modunda bekleyecekleri için sorun olmaması gerekiyordu. Şu hale bakın, harika.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811714
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811714,
					"content": "Bakın! O kadar kötü bir savaştan çıkmışlar ki çoğu Kurmalı Meka parçalara ayrılmış. Maillardet öğrenirse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811715,
						740811716
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811715,
					"content": "Benim yüzümden oldu. Üzgünüm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811718
					]
				},
				{
					"id": 740811718,
					"content": "Üzgünüm... Bu prototip çok mu pahalıydı? Telafi etmemizi istersen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811719,
					"content": "Rahat ol. Maillardet öğrenirse gülmekten yerlerde yuvarlanır diyecektim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811720
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811720,
					"content": "Prototiplerin dansını genelde o bölerdi. Dayak yedikten sonra da oturup kahkahalar atardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811721
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811721,
					"content": "Ah, çok konuştum ama kendimi tanıtmadım. Ben Fontaine Araştırma Enstitüsü araştırmacısıyım. Adım Sevigne. Sizler kimsiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811722
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811722,
					"content": "#Paimon'un adı Paimon, bu da {NICKNAME}. Biz, şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811723,
						740811725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811723,
					"content": "Sadece buradan geçiyorduk, farklı bir niyetimiz yoktu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811724
					]
				},
				{
					"id": 740811724,
					"content": "Evet! Sadece geçiyorduk, belki buradan hazine çıkar diye düşünüp bir bakalım dedik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811726,
					"content": "Ah, hazine avı etkinliği olan harabe turları gibi bir şey bekliyordunuz demek? Burası bunun için yanlış yer. Harabe gibi görünüyor olabilir ama... Burası aslında harabe değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811727
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811727,
					"content": "Turistlere tavsiye edilen harabeler listesinde yazmıyor zaten adı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811728
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811728,
					"content": "Peki... Biz gidelim o zaman...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811729,
					"content": "... Bekleyin, yeni Fontaine Araştırma Enstitüsünü duydunuz, değil mi? Çıkışta oraya uğrayıp Chisseray'i bulmanızı rica edecektim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811730,
						740811731
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811730,
					"content": "Ama oraya gitmiyoruz ki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811732
					]
				},
				{
					"id": 740811732,
					"content": "Öyleyse ne yapacağım ben? Hâlâ bir sürü işim var, üstelik Maillardet'nin prototipleri de bozuldu! Onları hemen götürecek biri lazım bana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811733
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811733,
					"content": "#Hımm... Belki biz yardımcı olabiliriz {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811734,
					"content": "Harika! Hazır bana yardım ederken delikli şerit işini de size bırakıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811735,
						740811736
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811735,
					"content": "Böyle olacağını bilsem dışarıdaki cihazlara elimi bile sürmezdim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811746
					]
				},
				{
					"id": 740811746,
					"content": "Öyle demeyin. Sonuçta bu sizin için çocuk oyuncağı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811737
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811737,
					"content": "Bu sayede özel görev masrafını, araştırma materyallerini kurtarma maliyeti olarak yansıtabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811738
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811738,
					"content": "Gerçekten mi? Sorun olmaz, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811739,
					"content": "Araştırma çalışmalarımıza yardımcı olacağı için hem makul hem de meşru. Hiç sorun olmaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811740
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811740,
					"content": "Herhangi bir şüphe oluşursa yönetim birimi zaten isteğimi reddeder. Öyle bir şey olursa görev masrafını kendi cebimden karşılamam gerekir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811741
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811741,
					"content": "Böyle şeyler başına sık geliyor mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811742
					]
				},
				{
					"id": 740811742,
					"content": "Benim başıma hiç gelmedi! Başkalarını bilmiyorum ama böyle durumlar yaşandığını duymuştum... Neyse, yabancıların ilgilendiği konular değil zaten bunlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811743
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811743,
					"content": "Üç tane delikli şerit almanız gerekiyor. Zaten rafta da sadece üç tane olmalı. Yerini kolayca bulursunuz. Yardımınız için ikinize de teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811744
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811744,
					"content": "Ben de prototipleri bir daha kontrol edeyim. Malum, uzun süredir çalışmıyorlardı... Şalterleri atarsa pek hoş olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811745
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811745,
					"content": "Tamamdır, biz şeritleri bulur bulmaz geri geleceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740811736,
					"content": "Sorun değil. Hallederim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811737
					]
				},
				{
					"id": 740811731,
					"content": "Bulmamız gereken başka hazineler var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811732
					]
				},
				{
					"id": 740811725,
					"content": "Burada hazine var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811726
					]
				},
				{
					"id": 740811716,
					"content": "Prototiplerin gücünü geliştirmeyi hiç düşündün mü?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811717
					]
				},
				{
					"id": 740811717,
					"content": "Maillardet daha önce yapmıştı aslında. Nihai ürün belki de beklentilerini karşılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740811718
					],
					"speakerTitle": "Sevigne"
				},
				{
					"id": 740811708,
					"content": "Evet! Çok tuhaf, şimdi neden açık o zaman?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811709
					]
				},
				{
					"id": 740811704,
					"content": "Sana öyle gelmiş olmasın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740811705
					]
				}
			]
		},
