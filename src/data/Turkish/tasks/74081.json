			"dialogs": [
				{
					"id": 740813101,
					"content": "Merhaba! Bayan Sevigne'den haber getirdik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740813102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740813102,
					"content": "Olanları Chisseray'e anlatıp üç delikli şeridi veriyorsunuz...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740813103
					]
				},
				{
					"id": 740813103,
					"content": "Ben de gidip onu kontrol etmeyi düşünüyordum. Demek öyle oldu. Bilgi verdiğiniz için teşekkür ederim... Delikli şeritler için de çok sağ olun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740813104
					],
					"speakerTitle": "Chisseray"
				},
				{
					"id": 740813104,
					"content": "Maillardet'nin prototiplerinin hâlâ çalışır durumda olmasına ve Sevigne'in böyle tehlikeli bir ortamda çalışmaya devam etmesine çok şaşırdım. Yönetim birimiyle konuşup malzemelerin alınması için gerekli işlemleri başlatacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740813105
					],
					"speakerTitle": "Chisseray"
				},
				{
					"id": 740813105,
					"content": "Masraflar karşılanabilir mi diye de biraz araştıracağım... Çok akıllıca bir iş yapmış. Masrafları karşılama kararı yönetim birimine bağlı olsa da mevcut süre zarfında ödemeyi ben yapacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740813106
					],
					"speakerTitle": "Chisseray"
				},
				{
					"id": 740813106,
					"content": "Neyse, yardımınız için teşekkürler. İşte ödemeniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chisseray"
				}
			]
