			"dialogs": [
				{
					"id": 220090301,
					"content": "Nasıl geçti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090302
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220090302,
					"content": "Yadigarları getirdim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220090303
					]
				},
				{
					"id": 220090303,
					"content": "Hımm. Tam da düşündüğüm gibi. Beni takip ediyor ve çalışmalarımın beni götürdüğü yol boyunca her yeri kazıyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090304
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220090304,
					"content": "Pek kayda değer bir teknikleri olmasa da sayıları fazla. Bu avantajı kullanarak birkaç yadigar bulmayı başardılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090305
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220090305,
					"content": "Çok teşekkür ederim. Sen olmasaydın o kültürel yadigarların başına kim bilir neler gelirdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		}
	]
