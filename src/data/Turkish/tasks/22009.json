			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220090101,
					"content": "Bu Hazine Avcıları iyice etrafa yayılmaya başladı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090102
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220090102,
					"content": "Beni mi arıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220090103
					]
				},
				{
					"id": 220090103,
					"content": "Evet. Senden bir şey rica edeceğim. Daha önce bahsettiğin bu Bao'er vardı ya... Etraflıca araştırdım ve Hazine Avcılarından olduğunu tespit ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090104
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220090104,
					"content": "Neden tek başına hareket ettiğine gelince... Belki de bütün hazineyi kendisi almak istedi ya da belki Hazine Avcılarının ana grubunun öncüsü olması gerekiyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090105
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220090105,
					"content": "Senin gibi deneyimli bir maceracıyı bile nasıl kandırabildiğine bakılırsa dolap çevirmekte gayet yetenekli duruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090106
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220090106,
					"content": "Onu kendi haline bırakırsak çevredeki Hazine Avcılarını da kontrolsüz bırakmış oluruz. Bu da çevredeki tüm kültürel yadigarlar için tehlike teşkil ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090107
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220090107,
					"content": "İşte bu nedenle Hazine Avcılarını durdurmanı istiyorum. Onları tamamen zapt etmemiz mümkün olmaz belki ama en azından bazı yadigarları pençelerinden kurtarabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090108,
						220090110,
						220090117
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220090108,
					"content": "Anlaşıldı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220090109
					]
				},
				{
					"id": 220090109,
					"content": "O halde bu işi sana bırakıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220090110,
					"content": "Nerede olduklarını nasıl biliyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220090111
					]
				},
				{
					"id": 220090111,
					"content": "Yanılmıyorsam bu Hazine Avcıları grubu bir süredir beni takip ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090112
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220090112,
					"content": "Bu açgözlü alçakları peşimden bir hazineye götürmem yetmemiş herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090113
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220090113,
					"content": "Gittiğim her yeri bulup bir şeyler çıkarma umuduyla etrafı kazıyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090114
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220090114,
					"content": "Nereye gideceklerini bu yüzden biliyorum işte. Ama sonuçta ben alimim. Mantık yürütme gerektiren bu tür konular bana basit gelse de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090115
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220090115,
					"content": "Savaşmayı senin gibi deneyimli maceracılara bırakmam gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090116
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220090116,
					"content": "Lütfen Hazine Avcılarından o yadigarları geri al!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220090117,
					"content": "Onların icabına bakacağım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220090118
					]
				},
				{
					"id": 220090118,
					"content": "Bir dakika. Avcıları durdurman gerektiğini söyledim ama Bao'er ile hemen yüzleşmeni istemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090119
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220090119,
					"content": "Hazine Avcılarının çok dağınık bir organizasyonu var, o nedenle izlerini sürmek zor. Artık onlarla dolaylı da olsa bir ilişkin olduğuna göre çok önemli bir fırsat var elimizde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090120
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220090120,
					"content": "Guili Ovası'nda dolanıyor olmalarının arkasında daha büyük bir plan olduğunu düşünüyorum. Bao'er ile ilişkini sürdürürsen planlarını gün yüzüne çıkarabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090121
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220090121,
					"content": "Yani henüz kendini ifşa etme. Saldırabileceğin zaaflarını bulma yeteneğine güveniyorum. Bir de, şey, işlerini çabuk bitir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090122
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220090122,
					"content": "Tekrar söylüyorum, yadigarları al ve çık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
