			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chenxiang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220080101,
					"content": "Doudou, haydi güzel kızım. İlacını almazsan iyileşemezsin bak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080102
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080102,
					"content": "Hayır! İstemiyorum! Nefret ediyorum, tadı iğrenç...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080103
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080103,
					"content": "Sorun ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080104
					]
				},
				{
					"id": 220080104,
					"content": "Merhaba Gezgin. Doudou oldukça hasta. Doktor Baizhu'nun verdiği reçeteye göre bu ilacı alması gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080105
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080105,
					"content": "Ama ilacı almayı reddediyor. Tadını beğenmiyormuş... *iç çeker* Bitkisel ilaçlar ne yazık ki acı oluyor, yapacak bir şey yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080106
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080106,
					"content": "İlacı aldıktan sonra bir kase Badem Tofusu yemesine izin verirsem ancak o zaman ilacı kabul ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080107
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080107,
					"content": "Gezgin, vaktin varsa gidip bana bir kase Badem Tofusu alabilir misin? Benim burada kalmam lazım... Doudou'yu ikna etmem gerekebilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080108,
						220080110,
						220080115
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080108,
					"content": "Tamam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080109
					]
				},
				{
					"id": 220080109,
					"content": "Teşekkür ederim. Doudou için bir kase yeterli olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080110,
					"content": "Hastalığı ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080111
					]
				},
				{
					"id": 220080111,
					"content": "*iç çeker* Keşke bilebilsem. Nasıl bir hastalıksa artık, Doktor Baizhu tedavinin imkansıza yakın olduğunu söylüyor. Sırf belirtileri kontrol altında tutmak için bile bir sürü ilaç alması gerekiyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080112
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080112,
					"content": "Hayatı boyunca ilaç kullanması gerekecek diye korkuyorum. Hem de bu kadar küçük bir yaşta başlamış olacak... Düşüncesine katlanamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080113
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080113,
					"content": "Keşke onun yerine ben hasta olsaydım... Umarım zavallı çocuğumun hastalığı ileride daha da kötüleşmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080114
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080114,
					"content": "Neyse. Bize Badem Tofusu getirebilir misin? Bir kase getirsen yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080115,
					"content": "Selam ufaklık. İlacı sevmediğini duydum, doğru mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220080116
					]
				},
				{
					"id": 220080116,
					"content": "İlaç çoooook acı!!! Lulu'nun ilacı hiç benimki kadar acı değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080117
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080117,
					"content": "Doudou... Lulu ve arkadaşları oyun yapıyordu. İçtikleri gerçek ilaç değildi. Badem Tofusu kasesinin dibindeki şekerli suyu içtiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080118
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080118,
					"content": "Hı... Yani Badem Tofusu beni iyileştirmeyecek mi? O zaman... Sanırım o iğrenç ilacı almak zorundayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080119
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080119,
					"content": "Aynen öyle! Aferin benim güzel kızıma. İyileştiğinde ne istersen yiyebilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080120
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080120,
					"content": "Neden ilacın tadını Badem Tofusu gibi tatlı yapamıyorlar? Haksızlık bu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080121
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080121,
					"content": "*iç çeker* Onu ikna edemiyorum... Neyse. Bize Badem Tofusu getirebilir misin? Bir kase getirsen yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chenxiang"
				}
			]
		},
