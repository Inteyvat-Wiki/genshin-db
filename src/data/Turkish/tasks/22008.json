					"nextDialogs": [
						220080403
					]
				},
				{
					"id": 220080403,
					"content": "Badem Tofusu mu? Ama yine de önce ilacı almam gerekiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080404
					],
					"speakerTitle": "Hongdou"
				},
				{
					"id": 220080404,
					"content": "Doudou, haydi güzel kızım. İlacını almazsan iyileşemezsin bak... Hem bak sana Badem Tofusu da aldırttım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220080405
					],
					"speakerTitle": "Chenxiang"
				},
				{
					"id": 220080405,
					"content": "Off... Bay Baizhu çok zeki biri değil mi? Neden ilacın tadını Badem Tofusu gibi yapmıyor ki?",
					"roleType": "TALK_ROLE_NPC",
