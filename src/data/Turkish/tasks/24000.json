			"dialogs": [
				{
					"id": 240000101,
					"content": "Tekrarlıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000102
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000102,
					"content": "Bay Livre, isteğinizi anlıyorum ve elimden geldiğince size yardım etmek istiyorum ancak... Lütfen şu başvuruya bir göz atın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000103
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 240000103,
					"content": "Burada yetki sahibi olan kişi Bay Clapiers. Daha önce gönderdiğiniz tüm materyallerin sınıflandırma ve işlenmesi onun sorumluluğundadır. Onun haricinde kimsenin bu materyallerle çalışma izni yoktur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000104
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 240000104,
					"content": "Kendisi şu anda bir iş için dışarıda. Vermiş olduğunuz malzemelerin gider hesaplama sistemimize girilebilmesi için kendisinin damgası gerekmektedir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000105
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 240000105,
					"content": "Tamam, tamam! Bakın, ben buraya üçüncü defadır geliyorum. İşimi halledecek misiniz, halletmeyecek misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000106
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000106,
					"content": "Lütfen sakin olun Bay Livre. Bay Clapiers'ın ofisinde yalnızca iki kişi var zaten. Bir kendisi bir de Bay Monthois...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000107
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 240000107,
					"content": "Ancak kendisi artık yaşlandı ve şu anda emekliliğine gün sayıyor. Aslında kendisi bir süredir herhangi bir iş de yapmıyor. Maaşını bile almıyor hatta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000108
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 240000108,
					"content": "O zaman ben de ofise gider o yaşlı adama damgalatırım. Ah, gerekirse damgayı kendim basarım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000109
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000109,
					"content": "Çok üzgünüm ancak bu bir işe yaramaz. İlk olarak, kuralları çiğnemiş olursunuz, ikincisi de damganın anahtarı Bay Clapiers'ta, yani sadece o açabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000110
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 240000110,
					"content": "Bana gelince, halletmem gereken başka işlerim var... Güvenin bana, Bay Clapiers bugün geri dönünce işinizi halledecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000111
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 240000111,
					"content": "... Pekala. İyi günler Bayan Cornelia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000112
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000112,
					"content": "Size de Bay Livre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000113
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 240000113,
					"content": "Cornelia aceleyle ayrılır...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240000114
					]
				},
				{
					"id": 240000114,
					"content": "Anlaşılan eve yine eli boş gideceğim, hah... *iç çeker*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000115,
						240000116
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000115,
					"content": "Ne oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000117
					]
				},
				{
					"id": 240000117,
					"content": "Hiçbir şey, cidden. Sadece vaktimi boşa harcamış oldum. Hatta tam olarak söylemek gerekirse yarım günümü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000118
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000118,
					"content": "Bu Clapiers yetti artık! Mermonia Sarayı birkaç Kurmalı Meka siparişi verdi ama ödemeyi henüz yapmadılar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000119
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000119,
					"content": "İlk geldiğimde, ofisin ay sonu hesap denetimi yaptıklarını ve bundan dolayı bir sonraki aya kadar herhangi bir ödeme yapamayacaklarını söyledi. Başvurum da böylece işleme alınmamış oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000120
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000120,
					"content": "İkinci gelişimde de damga için kullandıkları mürekkebin bittiğini ve tedarikçinin mürekkep deposunda yangın çıktığını, bu yüzden başka bir yerden mürekkep almaları gerektiğini söyledi. Yani başvurumu yine damgalatamadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000121
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000121,
					"content": "Üçüncü seferde ise Harici Yardımcı Personel Kayıt Formunun güncellendiğini, dolayısıyla tekrar doldurmam gerektiğini söyledi. E tabii ki ellerinde form kalmamıştı ve yenileri de ancak yarın gelecekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000122
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000122,
					"content": "Aslında bugün gidip form alacaktım ama bugün de kendisi ofiste değildi. Tanrım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000123
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000123,
					"content": "Hı? Bay Livre? Neden bu kadar üzgün görünüyorsunuz? Size yardım edebileceğim herhangi bir konu var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000124
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000124,
					"content": "Memur Rhemia! Sizi gördüğüme sevindim. Durum şu ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000125
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000125,
					"content": "Livre hikayeyi bir çırpıda anlatıverir...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240000126
					]
				},
				{
					"id": 240000126,
					"content": "Ah, Bay Clapiers... Onu yerinde yakalamak kolay değil tabii ama şu anda gerçekten Mermonia Sarayı'nda değil, kendisi Erinnyes'te.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000127
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000127,
					"content": "Her neyse, önce sizin için bir form alalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000128
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000128,
					"content": "Ha? Ama Clapiers hiç form kalmadığını söylemişti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000129
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000129,
					"content": "Bu problemi çözebilirim. Yanlış hatırlamıyorsam Mermonia Sarayı ile uzun süreli anlaşmaları olan bazı dükkanlar da sizinkiyle aynı durumu yaşamıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000130
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000130,
					"content": "Buldukları çözüm de gerekli olan formları ve belgeleri alabilmek için düzenli olarak Saraya gitmekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000131
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000131,
					"content": "Bu şekilde hem formları doldurup göndermeyi daha hızlı halletmiş oluyorlar hem de belgelerde yapılan değişikliklerden hemen haberleri oluyor... Ne derler? \"Hazırlıklı olmak iyidir.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000132
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000132,
					"content": "Yani... Formlar bu yüzden mi tükendi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000133
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000133,
					"content": "Bu dükkanlarda fazladan form vardır diye bu yüzden dedim. Hadi gidelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000134
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000134,
					"content": "Ayrıca, Saraydan defalarca eli boş döndüğünü duyunca eminim yardımcı olmak isteyeceklerdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000135
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000135,
					"content": "Ah, bu arada bir an önce formları alıp doldurmamız ve çalışma saati bitmeden Bay Clapiers'ın ofisine götürmemiz lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000136
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000136,
					"content": "Yardımcı olmak ister misin Gezgin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000137
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000137,
					"content": "Gezgin, lütfen bana yardım et! Bu işi halledemezsem yine gözüme uyku girmez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000138,
						240000139
					],
					"speakerTitle": "Livre"
				},
				{
					"id": 240000138,
					"content": "Tamam...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000140
					]
				},
				{
					"id": 240000140,
					"content": "Sadece şu iki dükkana gidin ve ellerinde Harici Yardımcı Personel Kayıt Formunun en güncel hali varsa ödünç alın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000141
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000141,
					"content": "Bakayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000142
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000142,
					"content": "Lütfen Estelle'in demirci dükkanına ve Caron'ın saat dükkanına gidin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000143
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000143,
					"content": "Daha yakın zamanda, demirci dükkanı Sarayın sokak lambalarını tamir ederken saat dükkanı da saatlerini ayarlamaya yardımcı oluyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000144
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000144,
					"content": "Sık sık Saraydan görev alırlar o yüzden kesin ellerinde form vardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000145
					],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000145,
					"content": "Bu yerlere bakmak için yardımınızı rica ediyoruz. O sırada Livre ve ben de ayrılıp başka dükkanları kontrol edeceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rhemia"
				},
				{
					"id": 240000139,
					"content": "Peki ne yapmam lazım?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000140
					]
				},
				{
					"id": 240000116,
					"content": "Neyle karşılaştın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000117
					]
				}
			]
		},
		{
