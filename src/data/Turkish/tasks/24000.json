			"dialogs": [
				{
					"id": 240000201,
					"content": "Ne zor ama... Sadece birkaç Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000202
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 240000202,
					"content": "Harici Yardımcı Personel Kayıt Formu hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240000203
					]
				},
				{
					"id": 240000203,
					"content": "Livre'in yaşadıklarını ve formu istediğini anlatıyorsun...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240000204
					]
				},
				{
					"id": 240000204,
					"content": "*iç çeker* Livre'e yazık oldu... Maalesef elimde fazladan form yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000205
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 240000205,
					"content": "Mermonia Sarayı'ndaki sokak lambalarını tamir ederken yanımda dükkandan bir çalışanı bana yardımcı olması için getirdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000206
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 240000206,
					"content": "Ama şimdiye kadar neredeyse hiç yardımcı olmadı, o yüzden adını forma yazmadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000207
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 240000207,
					"content": "Ama formu teslim etme zamanı geldiğinde Clapiers herkesin ismini yazmam konusunda çok ısrar etti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000208
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 240000208,
					"content": "Hatta formu dürüst bir şekilde doldurmazsam \"ciddi ve beklenmedik sonuçları\" olabileceğini söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240000209
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 240000209,
					"content": "Cidden, sadece bir isim eksik olacaktı. Bu nasıl ciddi sonuçlara yol açabilir ki? Saçmalıktan başka bir şey değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Estelle"
				}
			]
		},
