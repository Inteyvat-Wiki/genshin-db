			"dialogs": [
				{
					"id": 732170701,
					"content": "Deniz canavarlarına dikkat edin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170702
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732170702,
					"content": "Son zamanlarda deniz canavarlarında büyük bir hareketlilik gözlemliyoruz. Limandan ayrılan gemiler Pharos Feneri tarafından yapılan uyarılara dikkat etmeli veya öncesinde Akaşa'dan deniz hakkında bilgi edinmelidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170703
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732170703,
					"content": "Herhangi bir sorunuz varsa lütfen Fener Muhafızıyla iletişime geçin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
