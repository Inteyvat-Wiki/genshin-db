			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170101,
					"content": "Bu İlan Panosu, Ormos Limanı'nın Liman Sorumlusu tarafından Ormos Limanı civarındaki önemli olayları kamuya aktarmak için yerleştirilmiştir. İlan Panosunda bulunan uyarılara dair sorularınız veya şüpheleriniz olursa ilan panosuna asabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7321702,
			"completionStepIds": [
				7321702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321702",
							"2"
						],
						"stepId": 7321702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170201,
					"content": "\"Makale formatınızla ilgili sorun mu yaşıyorsunuz? Makaleniz için yeni fikirler bulmaya mı çalışıyorsunuz? O halde yeni bir şey denemenin vakti gelmiş demektir!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170202
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732170202,
					"content": "\"Ben Hara{RUBY#[S]Göstergebilim}vatat'ta kendimi geliştirdim, Span{RUBY#[S]Elementbilim}tamad ve Kshah{RUBY#[S]Teknoloji}rewar alanlarına da hakimim. Makaleleriniz için kalite kontrol hizmeti veriyorum.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170203
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732170203,
					"content": "\"Dertlerinizden kurtulma zamanı geldi. Otelde Bay Amandeep ile iletişime geçin. Hizmet bedeli konusunda pazarlığa açığız.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170204
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732170204,
					"content": "\"Başkası adına makale yazıyor musunuz?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170205
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732170205,
					"content": "\"Hayır, Müfettiş böyle bir şeye izin vermeyecektir.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170206
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732170206,
					"content": "\"Doğru. Sen çalışmana bak, şansını da fazla zorlama.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7321703,
			"completionStepIds": [
				7321703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321703",
							"2"
						],
						"stepId": 7321703,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170301,
					"content": "Daha önce havada durmak diye bir şey duymuş muydunuz? Peki hiç uçan birini gördünüz mü? Uçan Yük Hayvanının sırlarını keşfetmek ister misiniz? O halde Fontaine Pilotlarının Sumeru'daki ilk gösterisini sakın kaçırmayın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170302
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732170302,
					"content": "Hoş geldiniz, gösterimiz başlamıştır! Eşi benzeri görülmemiş bu sanat gösterisini kaçırmayın. Bir bilet yalnızca beş Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170303
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732170303,
					"content": "\"Gerçekten muhteşemdi. Daha önce böyle bir şeyi Fontaine'de bile görmedim!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7321704,
			"completionStepIds": [
				7321704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
