			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170601,
					"content": "Kaçakçılığı takip edebilmek için birtakım soruşturmalar yürütülmektedir. Limandan geçen her türlü malın kaydı tutulacak ve teftiş edilecektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170602
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732170602,
					"content": "Kaydı tutulmamış veya kaçak tüm mallara el konulacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170603
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732170603,
					"content": "Doğabilecek tüm sonuçlar mal sahibinin mesuliyetindedir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
