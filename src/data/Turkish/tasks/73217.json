			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170401,
					"content": "Özel bir hatırlatma: Sumeru'daki tek paralı asker örgütü Münzevilerdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170402
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732170402,
					"content": "Dolandırılmamak için lütfen kimliği belirsiz kişilere itibar etmeyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170403
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732170403,
					"content": "Koruma veya güvenlik ekibi tutma gibi istekleriniz için, lütfen Ormos Limanı'nda Otuzlu Teşkilattan Yüzbaşı Feroz ile irtibata geçin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7321705,
			"completionStepIds": [
