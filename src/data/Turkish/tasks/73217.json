			"dialogs": [
				{
					"id": 732170801,
					"content": "Ormos Limanı'ndaki en büyük otel olarak tüccarlara ve turistlere en kaliteli hizmeti sağladığımızdan emin olabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170802
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732170802,
					"content": "Akademi öğrencileri ve mezunları için özel indirimimiz de bulunmaktadır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170803
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732170803,
					"content": "Mallarınızı depolayacak bir yere ihtiyacınız varsa lütfen Wikala Hanıyla iletişime geçin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7321709,
			"completionStepIds": [
				7321709
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321709",
							"2"
						],
						"stepId": 7321709,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170901,
					"content": "\"Shapur Otel'deki hizmet güzeldi ancak ses yalıtımı berbattı.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170902
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732170902,
					"content": "\"Burada kalma sebebim Ormos Limanı'nda fiyatların ucuz olmasıydı. Şimdi Sumeru Şehri'ne taşınmak zorundayım.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170903
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732170903,
					"content": "\"Bu yıl da sınavda başarısız olursam eve dönüp çiftçilik yapmak zorunda kalacağım. O durumda yanıma Anahit Bereketi alabilecek miyim acaba?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7321710,
			"completionStepIds": [
				7321710
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321710",
							"2"
						],
						"stepId": 7321710,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171001,
					"content": "\"Gönderdikleri bu Mahamatalar geçen seferkilerden bile daha işe yaramaz. Sorduğum tek bir soruya bile cevap veremiyorlar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171002
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732171002,
					"content": "\"Artık Akaşa'ya erişimimiz de olduğuna göre, bu amatör Mahamatalar benimle aynı seviyede bile değiller.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171003
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732171003,
					"content": "\"Geçen sefer nakliyat programlarını hazırlarken bize yardımcı olan fakat ortalıkta pek görünmeyen o Katip hariç tabii. Demek ki Akademideki herkes aptal değilmiş.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7321711,
			"completionStepIds": [
				7321711
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321711",
							"2"
						],
						"stepId": 7321711,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171101,
					"content": "\"Cyno, General Mahamatra olduğundan beri üzerimdeki sorumluluk arttı. Yine de artık şu can sıkıcı gruplaşmayla uğraşmak zorunda olmadığımdan rahatladım diyebilirim.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171102
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732171102,
					"content": "\"Yoksa araştırma gezisindeyken hayatta buralarda aylaklık edemezdim.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171103
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732171103,
					"content": "\"Cyno'nun nerede olduğunu bilmiyorum ama buraya yazdıklarımı görmez herhalde.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171104
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732171104,
					"content": "\"Göreceğimi gördüm. Yarın öğleden önce yanıma gelip rapor ver ve cezanı çek.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171105
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732171105,
					"content": "\"Zamanımı boşa harcama.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7321712,
			"completionStepIds": [
				7321712
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321712",
							"2"
						],
						"stepId": 7321712,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171201,
					"content": "Ticaret loncamız Liyue'de üretilen değerli taşların ve cevherlerin ticaretini yapmaktadır. Güvenilir ve istikrarlı tedarikçilerle çalışıyoruz ve birçok filoyla uzun vadeli iş birliği içindeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171202
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732171202,
					"content": "Sınırlı sayıdaki muazzam ipek kumaşlarımız satışa çıktı. Sakın kaçırmayın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171203
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732171203,
					"content": "Yöresel Sumeru battaniyeleri, şifalı bitkileri, değerli taşları ve sırmalı ipek kumaşları tedarik edebiliyorsanız bize ulaşın. Ticaret yapalım, dost olalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7321713,
			"completionStepIds": [
				7321713
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321713",
							"2"
						],
						"stepId": 7321713,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171301,
					"content": "\"Geçen ay, yelken açıp gittiğim ülkenin kralı hayatında hiç at görmemiş. Buna inanabiliyor musunuz?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171302
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732171302,
					"content": "\"Bunu duyunca ben de orada Yük Hayvanı satmaya karar verdim. Herkese bunların at olduğunu söyleyeceğim, haha. Anlaşmaya varabilirsek belki de oranın kralı olurum!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171303
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732171303,
					"content": "\"Kral ne demek ki?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171304
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732171304,
					"content": "\"Liman Memuru veya Vezir gibi biri ama onlardan çok daha kudretli. Efsanevi Yirmi Dokuz Okyanus Deyine de çok benziyor. Üff, ne olduğunu anlatmak da amma zormuş.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171305
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732171305,
					"content": "\"Bu dediklerinin hepsini uydurdun kesin.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7321714,
			"completionStepIds": [
				7321714
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321714",
							"2"
						],
						"stepId": 7321714,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171401,
					"content": "\"Bıktırır elbet bilgenin vaazı, alırım elime bir kadeh şarabı. Zira yolculuk bekler bizi, bekler artık yedi diyarın denizi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7321715,
			"completionStepIds": [
				7321715
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321715",
							"2"
						],
						"stepId": 7321715,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171501,
					"content": "Denizcilerin, gezginlerin, tüccarların ve liman sakinlerinin dikkatine: Liman yönetmeliği buradan ilan edilmektedir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171502
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732171502,
					"content": "Bir anlaşmazlık durumunda lütfen Şerif Shyam'a başvurun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7321716,
			"completionStepIds": [
				7321716
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321716",
							"2"
						],
						"stepId": 7321716,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171601,
					"content": "\"Sumeru Şehri'ndeki Kapalı Çarşı yerine Ormos Limanı'ndaki eski pazar yerlerini ziyaret etmenizi öneririm.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171602
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732171602,
					"content": "\"Mahamatalar Kapalı Çarşı'yı mahvetti. Biz ise burada Sumeru'nun geleneklerini ve karakterini canlı tutmaya çalışıyoruz.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171603
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732171603,
					"content": "\"Tabii dans gösterisi izlemek isterseniz Zubayr Tiyatrosuna gitmeniz gerekecek.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171604
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732171604,
					"content": "\"Şu köylülerin dediğine bak hele. Sumeru Şehri araştırmacılar tarafından çok detaylı bir plan temel alınarak inşa edildi. Buradaki her bölgenin imarı bilimsel araştırmalarla desteklenmiştir.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171605
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732171605,
					"content": "\"Bakıyorum da yine birileri abuk sabuk konuşuyor. Ormos Limanı'nın kural tanımaz sokakları hemen de kıymete binivermiş!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171606
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732171606,
					"content": "\"Ne dedin? Seni duyamıyorum!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7321717,
			"completionStepIds": [
				7321717
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321717",
							"2"
						],
						"stepId": 7321717,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171701,
					"content": "\"Bunu söylerken biraz utanıyorum ama biz ticaret gemilerinin bakımını yapan işçilerdik. Atalarımızdan bize miras kalan bu becerilerle geçimimizi sağlıyorduk.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171702
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732171702,
					"content": "\"Gel gör ki bir süre önce Akaşa'ya yepyeni teknolojik gelişmeler eklendi ve bunca yıllık tecrübemiz çöpe gitti. Gençler Akaşa'dan yeni şeyler öğrenebilir belki ama bizim gibi ihtiyarlar için iş değiştirmekten başka çare kalmadı.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171703
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732171703,
					"content": "\"Katip, açık denizde şansımızı deneyebileceğimizi söyledi ama şu an buna ayıracak paramız yok. Elinizde iş varsa lütfen bize haber verin.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171704
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732171704,
					"content": "\"Siz Katibe takmayın. Zanaatkar arayan büyük bir müşteri tanıyorum. Sizi onunla tanıştırayım. Şu parayı da alın, boş verin denizi falan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171705
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732171705,
					"content": "\"Keşke bu kadar saçma işlere girişmeseniz. Şu hayatta bazıları başarılı olur, bazıları da başarısız. Dünya böyle işliyor işte. Neden burnunuzu sokup iyi niyetli biriymiş gibi görünmeye çalışıyorsunuz ki?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171706
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732171706,
					"content": "\"Katip yine gelmiş dünyanın işleyişinden bahsediyor... Bir de bunu neden yaptığımı soruyor bana. Beni mutlu ediyor da o yüzden yapıyorum!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171707
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732171707,
					"content": "\"Şunu aklınızdan sakın çıkarmayın: Bu hayatı yaşanır kılan yardımlaşma, eşitlik ve insanların haklı öfkesidir. 'Güçlü olan hayatta kalır' safsatasından gına geldi artık!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171708
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732171708,
					"content": "\"Kastettiğin şeyi inkar etmiyorum zaten ama sen benim söylediğimi hiç anlamamışsın. Konu kapanmıştır.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171709
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732171709,
					"content": "\"Fevri insanlarla tartışmak da çok yorucu doğrusu. Bu arada sen bütçeni nereye harcıyorsun? Akademinin sana verdiği ödeneği bu tarz saçmalıklara harcadığını söyleme sakın.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171710
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732171710,
					"content": "\"'Yoksul, zenginin servetinden muzdariptir. Herkesin iyiliği için zenginin servetini dağıtması gerekir.' der Bilge Zolfikar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171711
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732171711,
					"content": "\"Bilge Zolfikar öyle bir şey demedi ki.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171712
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732171712,
					"content": "\"Dedi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171713
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732171713,
					"content": "\"Hayır, demedi. Ayrıca bu ay kendi içkilerinin parasını kendin ödeyeceksin.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171714
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732171714,
					"content": "\"Bu konuda hiç seninle tartışasım yok. Ancak bana bir ay süre ver. Bilge Zolfikar'ın bunu dediğini sana kanıtlayacağım.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
