			},
			"dialogs": [
				{
					"id": 732171801,
					"content": "\"Şirketimizin Dornman Limanı güzergahı hizmete girmiştir. Sizi, en içten dileklerimizle meyve ticaretimize katılmaya davet ediyoruz.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171802
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732171802,
					"content": "\"Nasıl yani, aradaki upuzun mesafeye rağmen Mondstadt'tan meyve ithal edilebiliyor mu? İçki olsa belki ilgimi çekebilirdi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171803
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732171803,
					"content": "\"Herkes Mondstadt'tan şarap ithal edildiğini bilir ama meyve ithal edeni hiç duymuş muydunuz? Bu işi burada sadece ben yapıyorum. Sırf bu yüzden harika bir iş fırsatı ya!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171804
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732171804,
					"content": "\"Hem zaten ille de Mondstadt'tan ithal etmeye gerek yok ki...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
