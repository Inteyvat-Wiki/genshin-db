				"points": []
			},
			"dialogs": [
				{
					"id": 732170501,
					"content": "Limana yanaşan tüm gemilerin kişisel bilgileri ve geliş sebebi Liman Sorumlusuna bildirilmelidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170502
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732170502,
					"content": "Ticari gemilerin taşıdıkları yük hakkında detaylı bilgi vermesi gerekmektedir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170503
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732170503,
					"content": "Ticari gemiler buraya kayıt yaptırmadan yük indiremez veya herhangi bir ticari faaliyet gerçekleştiremez. Kural ihlali durumunda ağır cezalar uygulanacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7321706,
			"completionStepIds": [
				7321706
