				{
					"id": 750090202,
					"content": "Bu küçük top... Sanki bir şeyin parçasıymış gibi duruyor. Sevdin mi bakalım sen bunu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
