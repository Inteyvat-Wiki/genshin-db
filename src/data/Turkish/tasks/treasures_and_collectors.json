			"dialogs": [
				{
					"id": 750090101,
					"content": "Giriş ücreti üç yüz Mora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090102,
						750090103
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090102,
					"content": "İndirim yapar mısın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090105
					]
				},
				{
					"id": 750090105,
					"content": "Fiyatlar Sürüngen Kalıntıları Derneği tarafından belirlenir ve pazarlığa açık değildir. Zaten bildiğim kadarıyla en uzun süredir açık olan ve en uygun fiyatlı kazı alanı burası.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090106
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090106,
					"content": "Tabii bugünlerde senin gibi hayalperestler çıkıp şansını bir denemek istiyor işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090107
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090107,
					"content": "Neyse, ne olacağı belli olmaz tabii! Belki senden önce gelen yüzlerce, hatta binlerce kişi oldukça sıradan görünse bile aslında paha biçilemez olan bir yadigarı gözden kaçırmıştır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090108
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090108,
					"content": "Böyle bir hayalin gerçekleşme ihtimali için 300 Mora bayılmaya razı olan çok kişi var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090109
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090109,
					"content": "Ee, kendinizi şanslı hissediyor musunuz? Başınıza talih kuşu konacak mı dersiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090110
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090110,
					"content": "Rrrr... Raarr! Raarr! Raaarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090111,
						750090112
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090111,
					"content": "Benim şansım hep yaver gider.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090113
					]
				},
				{
					"id": 750090113,
					"content": "#Bakalım bize şans getirecek misin {REALNAME[ID(2)|SHOWHOST(true)]}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090114,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090115
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090115,
					"content": "Nasıl da heyecanlandı, baksana. Hem 300 Mora dediğin nedir ki zaten? Paimon hemen ödeyiverir şimdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090116,
					"content": "Üç yüz Moraya üç umut ışığı... Fena bir anlaşma sayılmaz aslında!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090117,
					"content": "O halde size bol şans diliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090112,
					"content": "Boş ver talih kuşunu, yanımda bana uğur getiren Sürüngenim var benim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090113
					]
				},
				{
					"id": 750090103,
					"content": "Seni pataklarsam ücret ödemem herhalde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090104
					]
				},
				{
					"id": 750090104,
					"content": "Ağzından çıkanı kulağın duysun ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090105
					],
					"speakerTitle": "Paimon"
				}
			]
		},
