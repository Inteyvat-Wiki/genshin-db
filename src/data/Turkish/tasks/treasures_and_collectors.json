			"dialogs": [
				{
					"id": 750090601,
					"content": "Nasıl geçti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090602
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090602,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} bunu buldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090603,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090604
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090604,
					"content": "Bir bakayım... Aşırı sıra dışı değil ama yine de ender rastlanan bir yadigar. Neredeyse hiç zarar görmemiş, üzerindeki Filojiston dalga desenleri hâlâ net bir şekilde görülebiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090605
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090605,
					"content": "Evet... Size 10.000 Mora versem bunu bana bırakır mısınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090606
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090606,
					"content": "Ne diyorsun... Eşsiz bir Sürüngen yadigarı mı bulduk gerçekten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090607,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}... Paimon senin harikalar yaratacağını ve bize şans getireceğini biliyordu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090608,
					"content": "Hayır, hayır. Sandığınız kadar değerli bir şey değil bu. Şöyle anlatayım, bunu Derneğin karargahına götürüp değer biçmelerini isteseniz taş çatlasa 5.000 Mora derler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090609
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090609,
					"content": "Pardon da Paimon'da bu numaraları yiyecek göz var mı sence? Bu şey madem 5.000 Mora değerinde, sen neden 10.000 Mora ödemeye razı oluyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090610,
					"content": "Çünkü üzerindeki bu eşsiz desenleri çok beğendim. Başkalarının gözüne o kadar güzel görünmeyebilir ama ben biraz buna fazla Mora vermeye razıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090611
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090611,
					"content": "Size tuhaf gelebilir ama koleksiyonculuk hali işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090612
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090612,
					"content": "Hımm... Şimdi öyle söyleyince Paimon'a mantıklı geldi. Ayrıca giriş ücretini düşününce 10.000 Mora gayet iyi bir ücretmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090613,
					"content": "O halde bu yadigarı 10.000 Mora karşılığında veriyor muyuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090614,
					"content": "Raarr... Raar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090615
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090615,
					"content": "#Durumdan pek memnun değil gibisin {REALNAME[ID(2)|SHOWHOST(true)]}... Yoksa senin olmasını mı istiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090616,
					"content": "Raarr... Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090617,
						750090618
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090617,
					"content": "Eh, bunu bulan sensin. Karar da sana kalmış.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090619
					]
				},
				{
					"id": 750090619,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} satmak istemiyor, yani bunu sana veremeyeceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090620,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090621
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090621,
					"content": "#Belli ki senin için Moradan da değerli şeyler varmış {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090622
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090622,
					"content": "Tabii ki var! Ne de olsa bizim yoldaşımız o... Tabii daha sonra yine buna benzer bir şey bulursak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090623
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090623,
					"content": "Sağ olun ama bir koleksiyoncunun hevesi saman alevi gibi parlayıp sönüverir. Belki ileride başka bir nesneye de böyle kafayı takabilirim ama şu an için ne olacağını kestirmek güç.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090624
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090624,
					"content": "Rarr! Raarr, rarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090625
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090625,
					"content": "#Sen de ona katılıyor musun {REALNAME[ID(2)|SHOWHOST(true)]}? Aa, tabii ya! Paimon şimdi anladı... Koleksiyoncular arasında böyle karşılıklı bir saygı ve anlayış gelişiyor demek ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750090626,
					"content": "Böyle genç ve parlak bir Tepetlizor tarafından tanınmak benim için büyük bir şeref. Birlikte iş yapmıyoruz diye arkadaş olmayacak değiliz ya! Koleksiyonculuk hakkında konuşmak isterseniz kapım size her zaman açık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090627
					],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090627,
					"content": "Neyse, sizi daha fazla tutmayayım ben. İyi şanslar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quipia"
				},
				{
					"id": 750090618,
					"content": "Yoksa sen de mi koleksiyoncu olmak istiyorsun bakalım?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090619
					]
				}
