					"content": "Raarr... Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090204
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090204,
					"content": "Yerin altından çıkarmadık gerçi ama sonuçta bu alanın içinde bulduk... Belki gerçekten değerli bir şeydir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090205
