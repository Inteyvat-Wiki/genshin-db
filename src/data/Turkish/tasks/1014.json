			"dialogs": [
				{
					"id": 10140201,
					"content": "Sizin çanı acilen bulmanız gerekmiyor mu? Hadi arayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140202
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140202,
					"content": "Ancak dikkatli olun, mekanı uzun süredir temizlemedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140203
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140203,
					"content": "Güzel kıyafetleriniz lekelenirse temizlemesi zor olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madam Ping"
				}
			]
		},
		{
			"id": 101403,
			"completionStepIds": [
				101403
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101403",
							"2"
						],
						"stepId": 101403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Madam Ping"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10140301,
					"content": "Vay, hemen girip çıktınız... Siz gençler çok hızlısınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140302,
						10140305,
						10140308
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140302,
					"content": "Siz Adeptus musunuz efendim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140303
					]
				},
				{
					"id": 10140303,
					"content": "Adeptus... Bu kelimeyi birilerinden duymayalı çok uzun zaman oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140304
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140304,
					"content": "Adeptus olup olmamama gelirsek, evlat, zaten anladın değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140312
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140312,
					"content": "Paimon neden bahsettiğini biliyor gibi ama biraz da kafası karıştı. Şimdi çanı bize öylece veriyor musun nineciğim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140313,
					"content": "Sence de tuhaf değil mi? Rex Lapis'e bir şey oldu ve sonrasında biz gelip çanı istedik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140314,
					"content": "Şapşal olmayın. Liyue Limanı tarihte önemli bir yere sahip. Var olduğu süre boyunca birçok Adeptusun ayrılışına şahitlik etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140315
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140315,
					"content": "Ancak ne olursa olsun her şeyden önce hep Veda Ayinini gerçekleştirdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140316
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140316,
					"content": "Avazı çıktığı kadar bağırarak \"katili yakalayın!\" deyip Veda Ayinini görmezden gelmek... Bence bu yanlış olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140317
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140317,
					"content": "Çanı ödünç almaya geldiğine göre sanırım eski dostum sonunda meseleyle kendisi ilgilenmeye karar verdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140318
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140318,
					"content": "Yani neden size çanı vermek istemeyeyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140319,
						10140322
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140319,
					"content": "Peki ya dostun çanı geri getirmezse?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140320
					]
				},
				{
					"id": 10140320,
					"content": "Öyle olursa... Haha, yaşlı bir kadın kapısını çalar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140321
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140321,
					"content": "Uzun süredir de görüşmüyoruz, bir şeyler içip sohbet etmek aslında iyi olurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140326
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140326,
					"content": "Yapacağınız işler vardır. Çanı aldığınıza göre geri dönmelisiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140327
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140327,
					"content": "Ayrıca sizi gönderen kişiye şunu söyleyin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140328
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140328,
					"content": "... Zamanı olursa çay için gelebilir. İkram edecek çok bir şeyim yok ancak bir demlik çay isterse bu yaşlı kadın her zaman burada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140329
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140329,
					"content": "İletiriz! Teşekkürler nineciğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140322,
					"content": "Çan bende kalabilir mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140323
					]
				},
				{
					"id": 10140323,
					"content": "Hey! Çan teyzeye ait! Ödünç aldığımız şeyi geri götürmemiz gerek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140324,
					"content": "Sende kalmasına izin mi vereyim? Haha, gerçekten çok açık sözlü bir çocuksun. İstiyorsan sende kalabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140325
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140325,
					"content": "Ancak bu çan arada ev hasreti çekiyor. Kim bilir, belki de bu yaşlı ellere geri dönebilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140326
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140305,
					"content": "Liyue'nin Yedi Yıldızından mısınız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140306
					]
				},
				{
					"id": 10140306,
					"content": "Yedi Yıldız... O çocuklar beni ve arkadaşlarımı bırakalı uzun zaman oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140307
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140307,
					"content": "Yine de son zamanlarda gayet iyi gidiyorlar. İhtiyarlar olarak boş geziyor olmaktan memnunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140312
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140308,
					"content": "Fatui'yle misiniz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140309
					]
				},
				{
					"id": 10140309,
					"content": "Fatui mi? Evlat, aklından ne geçiyor çok merak ediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140310
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140310,
					"content": "Onlarla oturup tartışmak için çok yaşlıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140311
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140311,
					"content": "Ancak sınırlarını aşarlarsa yapmam gerekeni yaparım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140312
					],
					"speakerTitle": "Madam Ping"
				}
			]
		},
