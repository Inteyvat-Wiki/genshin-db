			"dialogs": [
				{
					"id": 10140401,
					"content": "Bu kesinlikle Arınma Çanı. Hım, iyi durumda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140402
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140402,
					"content": "Hazırladığımız parfümü içine koyalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140403,
						10140405
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140403,
					"content": "Madam Ping'i tanıyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140404
					]
				},
				{
					"id": 10140404,
					"content": "Tabii ki, aksi takdirde çanın ona ait olduğunu nereden bilecektim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140407
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140407,
					"content": "Şüphe verici bir tepki! Ama söylemek istemiyorsan ısrar etmeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140408,
					"content": "Ah! Bir de yaşlı teyze sana bir şey söylememizi istedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140409,
					"content": "\"Zamanın olursa çay için gelebilirsin. İkram edecek çok bir şeyim yok ancak bir demlik çay istersen bu yaşlı kadın her zaman burada.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140410,
					"content": "Bu ses sana hiç uymuyor. Yine de çaydanlığı gerçekten çok iyi. Daha iyi çay demleyen bir çaydanlık yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140411
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140411,
					"content": "Uygun bir zamanda güzel bir çay alıp kendisini ziyaret edeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140412
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140412,
					"content": "Hazırlıklarımızdaki sonraki adım nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140413,
					"content": "Şimdi <color=#00E1FFFF>uçurtma</color> satın almamız gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140414
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140414,
					"content": "Paimon uçurtmalara bayılır! Bizi uçurtma uçurmaya mı götüreceksin? Mola zamanı mı geldi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140415,
					"content": "Haha, hayır, hayır. Uçurtmalar çocuk oyuncağı olmalarının yanı sıra Liyue ayinlerinde de çeşitli sembolik rolleri vardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140416
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140416,
					"content": "Konuyu size açıklayacağım ama önce uçurtmaları satın almalıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140417
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10140417,
					"content": "Tabii ki... Gittikçe meraklanıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140405,
					"content": "Sen de mi Adeptussun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140406
					]
				},
				{
					"id": 10140406,
					"content": "Adeptus...",
					"roleType": "TALK_ROLE_NPC",
