			"dialogs": [
				{
					"id": 10140101,
					"content": "Her şey zamanla değişir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140102,
						10140105
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140102,
					"content": "Nasılsın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140103
					]
				},
				{
					"id": 10140103,
					"content": "Genç dostum, çiçeklere bakmaya mı geldin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140104
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140104,
					"content": "Çok yazık. Bu Parlak Zambakların neredeyse hepsi solmuş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140107
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140107,
					"content": "Bu çiçeklere ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140108,
					"content": "Benim zamanımda insanlar Parlak Zambakların insan kalbini okuyabildiğini söylerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140109
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140109,
					"content": "Kahkaha ve şarkılar gibi güzel sesler duyduklarında da çiçekler neşeyle açardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140110
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140110,
					"content": "Ancak dedikodu ve iftira duyarlarsa hemen solarlardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140111
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140111,
					"content": "Yani bu çiçekler Liyue'de olan biten şeyleri hissediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140112,
					"content": "Evet, Rex Lapis'in ölümüyle ilgili söylentiler ufak bir mesele değil. Her yerde konuşuluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140113
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140113,
					"content": "Kimisi bunun Fatui komplosu olduğunu söylüyor. Kimileri Yedi Yıldızın bunu uydurduğunu, kimileri de Derinlerde Yatanın özgür kalacağını düşünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140114
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140114,
					"content": "Bu liman kuru tahta yığını gibi. Bir kıvılcımda yanıp kül olacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140115
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140115,
					"content": "Neyse, daha fazla konuşmayayım. Bu yaşlı kadın çok yaşlandı ve huysuzlaştı... Bir şey mi diyecektin, genç dostum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140116,
						10140121
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140116,
					"content": "Arınma Çanını ödünç almak istiyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140117
					]
				},
				{
					"id": 10140117,
					"content": "Ah, şu eski zımbırtı... Buralarda olduğunu hatırlıyorum ama yaşlandım. Nereye koydum tam hatırlamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140118
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140118,
					"content": "Gençlik zamanımda eski bir dostum bu çanı takıp da gezerdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140119
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140119,
					"content": "Sık sık baktığımı görünce de bana verdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140120
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140120,
					"content": "Ama biri gelip çanı ödünç almak isterse vermemekte ısrar etmememi söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140127
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140127,
					"content": "Yıllar geçti ve kim bilir kaç kişi bu çanı ödünç almaya geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140128
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140128,
					"content": "Ancak hâlâ ne zaman başladığını hatırlamıyorum. Birileri çanı ödünç almaya geleli epey bir zaman geçti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140129
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140129,
					"content": "Yaşlı kemiklerim bir şeyleri aramak için fazla yavaş. Bu kadar bekleyebilir misiniz emin değilim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140130,
						10140133
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140130,
					"content": "Kendimiz arayabiliriz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140131
					]
				},
				{
					"id": 10140131,
					"content": "Aynen öyle nine, seninle gelip çanı kendimiz arayabiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140132,
					"content": "Ayrıca yapman gereken ev işleri varsa onlara da yardım ederiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140135,
					"content": "Tamam çocuklar, endişelenmeye gerek yok. Çanı çok uzağa koymadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140136
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140136,
					"content": "Buraya yakın bir yerde mi yaşıyorsun nine? Ama burası Yujing Terası. Çok pahalı olsa gerek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140137,
					"content": "Haha, benim gibi yaşlı bir kadının parası bu şehirde ev almaya yetmez. Şu seramik çaydanlığı görüyor musunuz? Tüm evim burada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140138
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140138,
					"content": "Nasıl yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140139,
						10140140,
						10140143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140139,
					"content": "İçinde ev anahtarların mı var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140146
					]
				},
				{
					"id": 10140146,
					"content": "Gençler, dediğim gibi çan bu çaydanlığın içinde bir yerde ve siz de dilediğiniz gibi ödünç alabilirsiniz, tabii bulabilirseniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140140,
					"content": "Tek mal varlığın çan mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140141
					]
				},
				{
					"id": 10140141,
					"content": "Hey bu kabaca oldu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140142,
					"content": "Hem öyle bile olsa, çok pahalı bir çan olsa gerek değil mi teyzeciğim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140143,
					"content": "Hadi içine, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140144
					]
				},
				{
					"id": 10140144,
					"content": "Ne? Paimon asla buraya sığmaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140145,
					"content": "Ayrıca niye Paimon'un girmesi gerekiyor? Kapağı kaldırıp içine kendin bakamaz mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140133,
					"content": "Ben Favonius Şövalyeleri sertifikalı bir kayıp eşya bulma uzmanıyım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140134
					]
				},
				{
					"id": 10140134,
					"content": "Ne tuhaf bir gurur kaynağı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10140121,
					"content": "Senden bir şey ödünç almak istiyoruz...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140122
					]
				},
				{
					"id": 10140122,
					"content": "Bir şey ödünç almak mı? Arınma Çanını almaya geldiniz değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140123
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140123,
					"content": "Bunun dışında gençlerin isteyebileceği değerli bir şeyim yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140124
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140124,
					"content": "Bu da aslında benim değildi. Eskiden bir dostuma aitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140125
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140125,
					"content": "Gençken çok kibirli ve güzeldim. Bu çan için sürekli arkadaşımın kafasını ütülerdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140126
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140126,
					"content": "Beni vazgeçiremeyince mecburen çanı verdi ancak birisi gelip ödünç almak istediğinde vermemekte ısrar etmememi söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140127
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 10140105,
					"content": "İyi misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10140106
					]
				},
				{
					"id": 10140106,
					"content": "Sorun yok, sorun yok. Sadece Parlak Zambakların çoğunun solmuş olmasına üzüldüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10140107
					],
					"speakerTitle": "Madam Ping"
				}
			]
		},
		{
			"id": 101402,
