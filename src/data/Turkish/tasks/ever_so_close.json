				"points": []
			},
			"dialogs": [
				{
					"id": 30060401,
					"content": "Şimdi tekrar veri kaydetmeye başlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060402
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060402,
					"content": "Alhaitham, nasıl gidiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30060403,
					"content": "Satın aldığın Bilgi Kapsülü onun savaş becerisini gerçekten de artırdı. İkinci savaş sırasında, genel savaş performansı %0,073 oranında arttı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060404
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060404,
					"content": "Bir dakika... Ne kadar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060405,
						30060406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30060405,
					"content": "%0,073.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060407
					]
				},
				{
					"id": 30060407,
					"content": "Yaaaa! Dori tam bir pislik! Bizi resmen dolandırdı! Bir milyon Mora ha? Bu şey onun onda biri bile etmez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30060408,
					"content": "O zaten çok güçlü olduğundan, kapsülün içerdiği bilgiler önemli boyutta artış sağlamamış olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060409
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060409,
					"content": "En azından bu test sayesinde ikinizle ilgili daha fazla bilgi edinmiş oldum. Anlaşmamız, yatırımlarıma fazlasıyla değmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060410
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060410,
					"content": "Ben Wikala Hanına geri dönüyorum. İki gün içinde yanıtınızı bekliyorum. Dori'den bilgi istediğinizde vereceğiniz Mora da burada. Ne kadar isterse o kadar ödeyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060406,
					"content": "Neredeyse sıfır yani.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060407
					]
				}
			]
		},
		{
			"id": 300605,
			"completionStepIds": [
				300607
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
