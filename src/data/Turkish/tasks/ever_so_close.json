				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30060101,
					"content": "Geldiniz. Yüzünüze bakılırsa başarılı olmuşsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060102
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060102,
					"content": "Aaa, burada Akademili bir sürü insan var! Neden buluşma yeri olarak burayı seçtin ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30060103,
					"content": "Wikala Hanı, Akademinin kontrolünde olduğu için doğal olarak Akademililer burada çalışıyor. Bazı resmi işlerle meşgul olduğum iddiasıyla Ormos Limanı'na geldim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060104
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060104,
					"content": "Kahvaltıda yürek yedin herhalde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30060105,
					"content": "Sakin olun, kimse söylediklerimizle ilgilenmiyor ve Matra buralara gelmez. Pekala, Dori'yle nasıl gittiğini anlatın bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060106
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060106,
					"content": "Olanları Alhaitham'a anlatıyorsunuz ve satın aldığınız Konserve Bilgiyi ona teslim ediyorsunuz...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						30060107
					]
				},
				{
					"id": 30060107,
					"content": "Bizden istediğini yaptık. Şimdi Akademinin kaybettiği Bilgi Kapsülünden bahseder misin biraz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30060108,
					"content": "Ondan önce sormam gereken bir şey var. Siz neden bu kapsülün peşine bu kadar düştünüz? Buna yanıt vermeniz şart değil tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060109,
						30060110
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060109,
					"content": "Sır değil sonuçta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060111
					]
				},
				{
					"id": 30060111,
					"content": "Evet, Bilgelik Tanrısı ile buluşmak ve ona önemli bir soru sormak istiyor. Bir süredir Sumeru'da olmamıza rağmen henüz bir yolunu bulamadık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30060112,
					"content": "Akademinin tanrılarla ilgili bir şeyi kaybettiğini duyunca talihimizi döndürebiliriz belki diye buraya geldik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30060113,
					"content": "O halde doğru yoldasınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060114
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060114,
					"content": "Kısa bir süre önce Akademi çölde bir Bilgi Kapsülü kaybetti. Bu kapsülün bir Kutsal Bilgi Kapsülü olduğu düşünülüyor. Onu kullanırsanız tanrıların bilgeliğine erişirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060115
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060115,
					"content": "Vay canına, gerçekten böyle bir şey mi var? Sence bunu bulursak, Doğa Hükümdarı ile nasıl buluşabileceğimizi ve hatta kardeşini nasıl bulabileceğimizi öğrenebilir miyiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30060116,
					"content": "Mistik özellikleri olduğunu hiç sanmıyorum ama o kapsül gerçekten var ve şu an Ormos Limanı'nda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060117
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060117,
					"content": "Peki tam olarak nerede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30060118,
					"content": "İşte bulmamız gereken sonraki şey bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060119
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060119,
					"content": "Sen de mi onu bulmaya çalışıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060120
					]
				},
				{
					"id": 30060120,
					"content": "İnkar etmeyeceğim. Ben de araştırıyorum çünkü Kutsal Bilgi Kapsülünün gerçekte ne olduğunu merak ediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060121
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060121,
					"content": "Sizin de bilebileceğiniz üzere Ormos Limanı'ndaki Münzeviler de onun peşinde. İnanılmaz değerli bir eşyadan bahsediyoruz. Ona sahip olan kişiye muazzam bir güç veya zenginlik kazandırabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060122
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060122,
					"content": "Son günlerde bir sürü farklı ekip o eşyanın peşinde fakat hâlâ başarıya ulaşabilen çıkmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060123
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060123,
					"content": "Ekonomik durumum ve bağlantılarım Münzevilerinkiyle boy ölçüşemez. Farklı yollar denedikten sonra en sonunda ekiplerden birkaçıyla bazı ortak anlaşmalar yapmayı başardım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060124
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060124,
					"content": "Kutsal Bilgi Kapsülü üstünde çalışma fırsatı karşılığında, ona sahip olma hakkımdan tamamen feragat ettim. Sonuçta ne olduğunu anlamaktan zarar gelmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060125
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060125,
					"content": "Yine de Ayn Al-Ahmar'dakiler gibi bu konuda anlaşmaya çok açık olmayanlar da var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060126
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060126,
					"content": "Kutsal Bilgi Kapsülünün Kral Deshret'in gücünü barındırdığı konusunda çok sabit fikirliler ve kapsülü aldıklarında kralın geri döneceğine inanıyorlar. Akademililerin, tanrılarının ruhunu kirletmesine izin vermeyi reddediyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060127
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060127,
					"content": "Seninle iş birliği yapmadıkları için izlerini sürmeye devam mı ediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30060128,
					"content": "Evet. Ayn Al-Ahmar zengin bir yapılanma değil fakat üyeleri kapsülü ne pahasına olursa olsun bulmaya kararlı. Bu amaç uğruna yeterli miktarda bütçe ayırabilmek için adaleti hiçe sayacak bir sürü yola başvuruyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060129
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060129,
					"content": "Ben de onları benimle anlaşmaya zorlamak için işlerini sabote ediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060130
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060130,
					"content": "Önümüzdeki birkaç gün içinde Kutsal Bilgi Kapsülü çok gizli bir açık artırmayla satışa sunulacak. Ekiplerin hepsi kendi tekliflerini sunacak ve kazanan taraf el altından ödülünü alacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060131
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060131,
					"content": "Kapsülün güvenliğini sağlamak adına ve Matranın fark etmemesi için kazanan ekibin zaferi duyurulmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060132
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060132,
					"content": "Kutsal Bilgi Kapsülünün kimin eline geçeceğini bilmediğim sürece onlarla yaptığım anlaşmalar da boşa gidecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060133
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060133,
					"content": "Dori en güvenilir bilgi kaynağı olsa da kendisinin kapıları bana kapalıydı. Şimdi siz varsınız, o yüzden durum farklı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060134
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060134,
					"content": "Başka bir deyişle bizden Dori'yle arkadaş olmamızı istedin, böylece Kutsal Bilgi Kapsülünün yerini öğrenebileceksin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30060135,
					"content": "Evet, öyle denebilir. Tabii, bu anlaşma iki tarafa da zarar vermiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060136
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060136,
					"content": "Yarından sonraki gün Dori'nin yanına gidin ve Kutsal Bilgi Kapsülünün yerinin bilgisini satın almaya çalışın. Eğer bilgisi yoksa iki gün bekledikten sonra aynı şeyi tekrarlayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060137
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060137,
					"content": "Kutsal Bilgi Kapsülünü kullanma fırsatını elde edersem öğrendiklerimi sizinle de paylaşacağım. Bu yeterli bir karşılık olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060138,
						30060139
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060138,
					"content": "Ben de tam bunu istiyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060140
					]
				},
				{
					"id": 30060140,
					"content": "Pekala. İki gün içinde görüşürüz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060141
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060141,
					"content": "Alhaitham, bir dakika! Kendimize de bir Bilgi Kapsülü satın aldık ama nasıl kullanıldığını bilmiyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30060142,
					"content": "Bilgi Kapsülü mü kullanmak istiyorsunuz? Tamam, ben size öğretirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060143
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060143,
					"content": "Bunu Akademinin burnunun dibinde yapmak başımıza iş açabilir ama. Şehrin biraz dışına çıkalım ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060139,
					"content": "Teşekkürler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060140
					]
				},
				{
					"id": 30060110,
					"content": "Doğa Hükümdarı'yla tanışmak istiyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060111
					]
				}
