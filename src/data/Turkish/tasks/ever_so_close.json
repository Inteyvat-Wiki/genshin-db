				"objectNames": [
					"Alhaitham"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30060801,
					"content": "Ha? Teyvat aşkına ne oldu öyle? Kocaman adam birden aklını kaybetmiş gibi görünüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30060802,
					"content": "Kutsal Bilgi Kapsülünü kullandı herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060803
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060803,
					"content": "Yani Kutsal Bilgi Kapsülü yüzünden mi böyle olmuş diyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30060804,
					"content": "Kapsül demişken, Haypasia bunun olabileceğinden bahsetmişti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060805
					]
				},
				{
					"id": 30060805,
					"content": "Nasıl yani, bazı araştırmacılar Irminsul'dan bilgi aldıktan sonra kafayı mı sıyırıyor diyorsun sen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30060806,
					"content": "Satyavada Yaşamı aşamasındaki birçok araştırmacının delirdiğini duydum. Bu adamın bulunduğu hal de ona benziyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060807
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060807,
					"content": "Kutsal Bilgi Kapsülü gerçekten de tanrılarla bağlantılı gibi fakat onun ötesinde, dedikoduların iddia ettiği gibi bir şey de değil sanki. Ona sahip olmak sana kutsal bilgelik veya güç bahşetmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060808
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060808,
					"content": "Ne dediğini duydun mu? \"Dünya... Unut beni...\" Bu ne demek olabilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060809
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060809,
					"content": "(Irminsul'da duyduğum şey tam da buydu...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060810
					]
				},
				{
					"id": 30060810,
					"content": "Matra onu götürdüyse o zaman Akademi, Kutsal Bilgi Kapsülünü geri aldı demektir. Çok yazık oldu, ne kadar yaklaşmıştık halbuki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30060811,
					"content": "Yine de Paimon, Kutsal Bilgi Kapsülünün bu kadar tehlikeli bir şey olmasını beklemiyordu. Açmayı denediğimizi bir düşünsene... Kim bilir başımıza neler gelirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30060812,
					"content": "Bu durumda Ormos Limanı'nda kalmanın hiçbir anlamı yok. Ortaklığımızın sonuna gelmiş bulunuyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060813
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060813,
					"content": "Kutsal Bilgi Kapsülünü aramakla o kadar meşguldük ki Paimon sana bir şey sormayı unuttu! Akademi üyesi olduğuna göre Devi Kusanali'yle nasıl görüşebileceğimiz hakkında herhangi bir fikrin var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30060814,
					"content": "Dürüst olmak gerekirse yok. Devi Kusanali, Sumeru yönetiminin tamamen dışında. Çoğu zaman varlığından bile haberdar olmazsınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060815
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060815,
					"content": "Ayrıca, Akademi tanrımızın bilgeliğinin sembolü olan Akaşa'ya sahip. Alimlerin de tanrının bizzat kendisiyle iletişime geçmek için herhangi bir sebebi yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060816
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060816,
					"content": "*iç çeker* Devi Kusanali'yle ilgili her şey bir gizem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30060817,
					"content": "Ben Akademiye dönüyorum. Siz ne yapacaksınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060818
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060818,
					"content": "Aa, Sabzeruz Festivali gelmek üzere! Biz de dönsek iyi olacak belki de. Birkaç gündür oradan oraya koşturup duruyorduk. Biraz kafa dinlemek bize de iyi gelecektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060819,
						30060820
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30060819,
					"content": "Haklısın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060821
					]
				},
				{
					"id": 30060821,
					"content": "O halde yollarımız burada ayrılıyor Alhaitham. Tekrar görüşmek üzere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060822
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30060822,
					"content": "Hım... Önce bununla mı ilgilensem, yoksa üstlerimin istediği raporu mu hazırlasam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060820,
					"content": "Sumeru Şehri'ne dönelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060821
					]
				}
			]
