				"objectNames": [
					"Alhaitham"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30060201,
					"content": "Tamamdır, burası olur. Satın aldığınız kapsülü gösterin bakayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060202
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060202,
					"content": "İşte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30060203,
					"content": "Hım, Kılıç Dövüşü Teknikleri VIII... Savaş sınıfı Bilgi Kapsülü. Bu kapsül sınıfına rastlamak bugünlerde çok zor çünkü Münzeviler kendi savaş taktiklerini geliştirmek için hepsini kapıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060204
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060204,
					"content": "Öyle mi? İşte be, müthiş seçim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30060205,
					"content": "Kapsülün etkisini ölçmek istiyorsan öncelikle savaş yeteneklerini ölçebilirim. Fakat halihazırda çok güçlüysen kapsülün ancak minik bir etkisi olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060206
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060206,
					"content": "Kontrollü deney yapabiliriz. Biri kapsülden önce, biri kapsülden sonra olmak üzere iki kere savaşırsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060207
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060207,
					"content": "Savaşırken de bir Akaşa Terminali kullanarak farklı fiziksel parametrelerini ölçebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060208
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060208,
					"content": "İki test arasında fiziksel gücünde farklılıklar ve düşmalarının yeteneklerinde yer yer eşitsizlikler görülebilir... Yine de dert etme, fark oluşturan etkileri hafifletmek için sonrasında istatistiksel analizler yapacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060209
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060209,
					"content": "Vay be... Alhaitham sen kesin Akademiden en yüksek notlarla mezun olan tiplerdensin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30060210,
					"content": "Bir şey Paimon'un merakını uyandırdı. Sen Akademiden mezun olabilmek için Konserve Bilgiye ihtiyaç duyan o öğrencilerden değildin herhalde? O zaman neden bu kapsül için Matraya yakalanmayı göze alıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30060211,
					"content": "Bunu ben de merak ettim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060212
					]
				},
				{
					"id": 30060212,
					"content": "Bir araştırmacının eylemlerine anlam verilemediği çoğu durumda iş meraka yorulur. Bu yalnızca bir teori tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060213
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060213,
					"content": "Hımm... Sorudan kaçmaya çalışıyorsun gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30060214,
					"content": "Pekala teste başlayalım. Normalde nasıl savaşıyorsan öyle savaş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alhaitham"
				}
			]
		},
		{
