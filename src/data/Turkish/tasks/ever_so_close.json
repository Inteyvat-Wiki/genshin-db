			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dori"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30060501,
					"content": "Buraya, buraya! Hoş geldiniz sadık müşterilerim. Sizin için bu sefer ne yapabilirim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060502
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 30060502,
					"content": "Yeter ki söyleyin! Konserve Bilgi, erzak veya ne lazımsa. Tedarik etmenin bir yolunu bulurum... Yeteri kadar Mora her kapıyı açar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060503
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 30060503,
					"content": "İstediğimiz her şeyi tedarik edebilir misin gerçekten? Her şeyi ama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30060504,
					"content": "Hay hay! Konserve Bilgi artık muazzam açlığınızı kesmeye yetmiyor galiba? O halde lütfen bekletmeden ne istediğinizi söyleyin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060505
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 30060505,
					"content": "Kutsal Bilgi Kapsülünün bulunduğu yerin bilgisini satın almak istiyorum!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060506
					]
				},
				{
					"id": 30060506,
					"content": "Ooo, heheh! Sizin gibi cebi alabildiğine dolu müşterilerin nihayetinde sıradan Konserve Bilgiden daha önemli bir şeyi arzulayacağını biliyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060507
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 30060507,
					"content": "Ama tahmin edebileceğiniz üzere böyle bir bilgi edinmek ucuza gelmeyecektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060508
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 30060508,
					"content": "Sonuçta adamımı açık artırma alanına sokabilmek için gerçekten çok çalıştım. Ayrıca, içeriden bilgi sızdıran kişinin ben olduğum öğrenilirse başım çok ama çok fena belaya girer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060509
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 30060509,
					"content": "Ama bilginin doğru olduğundan nasıl emin olacağız? Paimon, ihtiyacımız olan bu bilgiye tam da ihtiyacımız olduğu sırada nasıl sahip olduğunu merak ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30060510,
					"content": "Hehehe... Çünkü ben değeri olan her şeyi tedarik edilecek mal olarak görüyorum. Bu yüzden de daha fazla satış yapabilmek için piyasada nelerin popüler olduğunu her daim bilmeliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060511
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 30060511,
					"content": "Bilginin doğruluğuna gelirsek, o konuda endişelenmenize lüzum yok. Alışverişin fotoğrafını çekmek için Kamera kullandım. Onu kimse sorgulayamaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060512,
						30060513
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 30060512,
					"content": "Fiyatını söyle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060514
					]
				},
				{
					"id": 30060514,
					"content": "Sizin gibi kaliteli müşterilerle iş yapmak her zaman zevktir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060515
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 30060515,
					"content": "Ödemenin tamamını yaptığınıza göre bilgiyi vereyim: Kutsal Bilgi Kapsülü dün Ayn Al-Ahmar'ın lideri Mizri tarafından satın alındı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060516
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 30060516,
					"content": "Ayn Al-Ahmar mı? Kral Deshret'e tapan Münzevileri mi kastediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30060517,
					"content": "Demek siz de onları biliyorsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060518
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 30060518,
					"content": "O grup, Kutsal Bilgi Kapsülünü ele geçirebilmek için elinden gelen her şeyi yaptı. Çünkü kapsülde Kral Deshret'in gücünün yattığına inanıyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060519
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 30060519,
					"content": "O Kutsal Bilgi Kapsülü daha önce gördüğüm Konserve Bilgilerin hiçbirine benzemiyor. Kıpkırmızı parıldıyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060520
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 30060520,
					"content": "Kapsül çektiğim fotoğrafta da açıkça görünüyor. Kendiniz de bakabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060521
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 30060521,
					"content": "Bilgi için teşekkürler Dori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30060522,
					"content": "Lütfen, benim için bir zevkti. Sizin gibi zeki müşteriler sayesinde dün harcadığım çabalar boşa gitmedi. Lütfen gelecekte ihtiyaç duyduğunuz herhangi bir şey olduğunda bana ulaşmaktan çekinmeyin. Moranız olduğu sürece dükkan sizindir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dori"
				},
				{
					"id": 30060513,
					"content": "Satın alıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060514
					]
				}
			]
		},
		{
			"id": 300606,
