			},
			"dialogs": [
				{
					"id": 30060301,
					"content": "Tamamdır, verileri kaydetmek için Akaşa Terminalini bağlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060302
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060302,
					"content": "Sıradaki adım Bilgi Kapsülünü kullanmak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060303
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060303,
					"content": "Kapsülü elinde tut. Gücünü etkinleştirebilmen için bağlantı kurmana yardımcı olacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alhaitham"
				}
			]
		},
		{
			"id": 300604,
			"completionStepIds": [
				300606
