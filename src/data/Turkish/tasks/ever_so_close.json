					"nextDialogs": [
						30060906
					]
				},
				{
					"id": 30060906,
					"content": "Çalıştı mı diyorsun yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30060907,
					"content": "Pekala, ikinci tura geldik. Az önceki gibi savaş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060905,
					"content": "Bilgi Kapsülünde her ne vardıysa hafızamın bir parçası oldu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060906
					]
