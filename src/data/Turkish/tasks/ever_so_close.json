				"points": []
			},
			"dialogs": [
				{
					"id": 30060601,
					"content": "Alhaitham! İstediğin bilgiyi aldık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30060602,
					"content": "Öyle mi? Anlatın o zaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060603,
						30060604
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060603,
					"content": "Ayn Al-Ahmar'ın elinde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060605
					]
				},
				{
					"id": 30060605,
					"content": "Dori bize bilgi için kanıt bile sundu. Şuna bak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30060606,
					"content": "Şuna bak... Her şey gün gibi ortada. Münzevilerin olduğu yere sızmak epey cesaret ister. Hele de böyle bir fotoğraf çekecek kadar yakınlaşmak... Cesur hareket. Sen ne cesurmuşsun be Dori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060607
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060607,
					"content": "Evet, resimdeki kişi kesinlikle Ayn Al-Ahmar'ın lideri Mizri ve elinde tuttuğu kırmızı parıldayan kapsül de Kutsal Bilgi Kapsülü olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060608
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060608,
					"content": "Bu durumda önümüzdeki hafta onlarla yüzleşirken doğru kartları oynarsak onların da elini zorlayabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060609
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060609,
					"content": "İlk başta Paimon neden Ayn Al-Ahmar'ı kışkırttığını anlamasa da sonra taşlar yerine oturmaya başladı. Her şey senin planına uygun gerçekleşiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30060610,
					"content": "Onları yendikten sonra liderleriyle oturup ciddi ciddi konuşabilir ve ondan Kutsal Bilgi Kapsülünü ödünç vermesini isteyebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30060611,
					"content": "Vaktiniz ve emekleriniz için teşekkür ederim. Ben hazırlık yaparken birkaç gün ortalarda olmayacağım. Belirlediğimiz gün öğleden sonra saat tam üçte buluşalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060612
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060612,
					"content": "Orada olacağız.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060613
					]
				},
				{
					"id": 30060613,
					"content": "Sonra görüşürüz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060614
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060614,
					"content": "Birkaç gün sonra, Ayn Al-Ahmar'la görüşeceğiniz gün...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						30060615
					]
				},
				{
					"id": 30060615,
					"content": "Alhaitham da iyi gecikti. Nerelerde olabilir ki? Aha, geldi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30060616,
					"content": "Beklettiğim için kusura bakmayın. Pharos Feneri'nin önündeki rıhtıma gidelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060617
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060617,
					"content": "Olur, tamamdır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30060604,
					"content": "Yüzleşmek üzere olduğumuz grupta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30060605
					]
				}
			]
		},
