			},
			"dialogs": [
				{
					"id": 30060701,
					"content": "Alhaitham... Deli olduğunu biliyordum da bugün buraya gelecek kadar deli olduğunu bilmiyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060702
					],
					"speakerTitle": "Tariq"
				},
				{
					"id": 30060702,
					"content": "Bu müzakerelerin gerçekleşmesini talep eden bendim zaten. Daha çok sizin sözünüzde durmayacağınızdan korkuyordum. Fakat siz sözünüzde durmaya kararlı görünüyorsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060703
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060703,
					"content": "Bu olay biraz büyüyor. Ben yanımda destek getirdim, sizin için sorun olmaz değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060704
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30060704,
					"content": "Destek mi? Sen geçen gün restorandaki velet değil misin? Sana yardım etti diye bu deliyi desteklemeye mi geldin? Peki, bunu sen istedin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060705
					],
					"speakerTitle": "Tariq"
				},
				{
					"id": 30060705,
					"content": "Lafı hiç eveleyip gevelemeyeceğim. Sizinle işim bittiğinde balıklara yem olacaksınız. Bitirin işlerini çocuklar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30060706
					],
					"speakerTitle": "Tariq"
				},
				{
					"id": 30060706,
					"content": "Ay, geliyorlar! Size kolay gelsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 300608,
			"completionStepIds": [
				300612
			],
