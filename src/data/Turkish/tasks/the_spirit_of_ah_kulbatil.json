			"dialogs": [
				{
					"id": 401730101,
					"content": "Tekrar merhaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730102
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730102,
					"content": "Citlali, selam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730103,
					"content": "Şeften seremoni kılıcını aldım. Bu gibi durumlarda ihtiyaç duyulan bir güce sahip.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730104
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730104,
					"content": "Bugün ne yapacağımızı unutmadınız, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730105
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730105,
					"content": "Tabii ki unutmadık, Leyla'yı uyandıracağız! Ve ona neyin peşinde olduğunu soracağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730106,
					"content": "Seremoni için kalan aletleri de ninemin talimatlarına göre hazırladım. Her şeyi özenle hazırladık, bugünün sorunsuz geçeceğine eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730107
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730107,
					"content": "Aferin evlat. O zaman daha fazla oyalanmadan başlayalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730108
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730108,
					"content": "Citlali, seremoni kılıcı \"Eshu'nun Felaketi\"ni çağırır.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401730109
					]
				},
				{
					"id": 401730109,
					"content": "Mistik dumandan adak adıyorum. Aysız bir gecede yıldızların armağanı, bir kasırgada düşlerin tacı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730110
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730110,
					"content": "Ölümün Hakimi'ne gitsin adaklar. Soluyor, soluyor, soluyor. Üç defa söyleyin, üç defa daha tekrarlayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730111
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730111,
					"content": "Vay be! Büyülerinden biri mi bu? Her yer buz kesti bir anda! Neler oluyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730112,
					"content": "Sessiz ol biraz. Onu rahatsız etmeyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730113
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730113,
					"content": "Biz, rahip kralın çocukları, kadim anlaşmaya sadık kalacağımıza ve Gece Diyarının perdesini yırtıp geçeceğimize söz veriyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730114
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730114,
					"content": "Ben Citlali, emrime kulak ver. Ben kıyametin yol göstericisi, Ben Ah K'ulbatil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730115
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730115,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730116
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730116,
					"content": "Bakın! Leyla'nın ruhu geri geldi. Bedenine doğru gidiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730117
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730117,
					"content": "Gecenin örtüsünü çakmaktaşıyla delip geçeceğim, ölüler diyarına ait olmayan tüm ruhları defedeceğim.\\n",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730118
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730118,
					"content": "Leyla! Emrime itaat et ve gün ışığının aydınlattığı topraklara dön. Kendi yoluna geri dön!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730119
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730119,
					"content": "İ-İşe yaradı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730120,
					"content": "Hı... Hım? Neredeyim ben? Siz kimsiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730121
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730121,
					"content": "Aaa! I-Itztli Nine! Yani! Başrahibe Citlali! Lütfen, bağışla beni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730122
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730122,
					"content": "Suçluluk mu hissediyorsun? Demek yaptıklarının farkındasın gayet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730123
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730123,
					"content": "Bir daha asla geri dönemeyebilirdin, farkında mısın bunun? Ya da cansız bir nesneye dönünce hayatın daha eğlenceli olacağını mı düşündün?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730124
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730124,
					"content": "B-Ben özür dilerim! Çok büyük bir hata yaptım... Ve sonuçlarıyla yüzleşeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730125
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730125,
					"content": "Hı? Emin misin? Öyleyse ailenle vedalaş ve şunları söyle onlara:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730126
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730126,
					"content": "\"Anne, baba, hoşça kalın. Hayatı boş bir kabuk olarak yaşamayı öyle sevdim ki Itztli Nine'den önümüzdeki birkaç yüzyıl boyunca evinin önünde nöbet tutabilmem için beni taştan bir heykele dönüştürmesini istemeye karar verdim.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730127
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730127,
					"content": "Hayır, lütfen! Lütfen nine, yalvarırım sana! Bir daha asla böyle bir şey olmayacak, söz veriyorum! Teşekkür ederim Başrahibe Citlali, beni kurtardığın için teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730128
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730128,
					"content": "Hehe, bana değil torunuma teşekkür et. Bir şeylerin ters gittiğini hissetmese bu durumla ilgilenmezdim bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730129
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730129,
					"content": "Teşekküre hiç gerek yok Leyla. Hem sen ninemin dediklerine bakma, o öyle konuşur işte. İyi olmana sevindik hepimiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730130
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730130,
					"content": "Ayrıca biri bunu yapman için seni kandırdı, değil mi? Şu Kokuchuu denen adam. Burada asıl suçlu o.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730131
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730131,
					"content": "Hayır... Bay Kokuchuu'nun bu durumla bir alakası yok. Her şeyi ben kendim yaptım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730132
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730132,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730133,
					"content": "Yani güçlü bir ruh yadigarını iletişim aracı olarak kullanmayı o önerdi. Ancak bunu uygulamak tamamen benim kararımdı. Beni hiçbir şekilde zorlamadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730134
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730134,
					"content": "Özür dilerim. Bir suçlu varsa o da benim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730135
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730135,
					"content": "Hah, beynin iyi yıkanmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730136
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730136,
					"content": "Hım... O parçayı sana Kokuchuu mu verdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730137,
					"content": "Evet. Mare Jivari'yle ilgili bir hazine olduğunu söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730138
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730138,
					"content": "İşte bu da onun seni kullandığını kanıtlar! Seni, onun yerine bir durugörü yapman için kullanmış!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730139,
					"content": "Ancak ben bir büyü bile yapamayan bir sersem ruhum... Ona ne gibi bir faydam olabilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730140
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730140,
					"content": "Benim gibiler oturup ömrünün kalanını meditasyonla geçirse bile herhangi bir ruhu algılayamazlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730141
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730141,
					"content": "Ancak Bay Kokuchuu, eğer zorla bir durugörü yapar ve kendini tamamen ruhsal açıdan zengin maddelere çevrelersem, o zaman bir ruh görebileceğimi söylemişti. Benim de başka seçeneğim yoktu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730142
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730142,
					"content": "Yine de sersem bir ruh olduğunu bile bile zorla durugörü yapmaya çalışmak... Bacakların olmadan maraton koşmaya çalışmak gibi bir şey! Citlali olmasa sonsuza dek kaybolmuştun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730143,
					"content": "Biliyorum, özür dilerim... Kabilemdeki herkes son derece yetenekli, öte yandan ben... Diğerleri gibi olabilmek istemiştim yalnızca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730144
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730144,
					"content": "Nasıl hissettiğini çok iyi anlıyorum Leyla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730145
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730145,
					"content": "Bazı tohumlar hiç uğraşmadan büyüyüp güzel birer lahana olurlar, bazılarıysa ne kadar uğraşırlarsa uğraşsınlar filizlenmezler bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730146
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730146,
					"content": "Nedenini kim bilir... Belki de tüm olay hayatın kendidir. Ne de olsa hayat değiştiremeyeceğimiz şeylerle dolu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730147
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730147,
					"content": "Biliyorum bunları söylemek hiçbir şeyi değiştirmez ama umarım kendini biraz daha iyi hissedersin en azından.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730148
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730148,
					"content": "Şimdilik bu konuşmayı bir kenara bırakalım. Seni Matla'ya götürüp bir muayene ettirmemiz lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				}
			]
		},
