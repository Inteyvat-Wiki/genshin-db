			"dialogs": [
				{
					"id": 401730201,
					"content": "Pekala, iyi görünüyor... Herhangi bir rahatsızlığı yok. Ama döndüğünüzde bir şeyler yesin, çok acıkmış olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730202
					],
					"speakerTitle": "Matla"
				},
				{
					"id": 401730202,
					"content": "Çok rahatladım. Çok uzun süre meditasyon yapan bazı kişilerin vücutlarının nekroza uğradığını duymuştum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730203
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730203,
					"content": "Düşünmesi bile korkunç...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730204,
					"content": "Hım. Her neyse, Leyla, her ne kadar bu yaşananlardan önce birbirimizi tanımıyor olsak da iyi olmana çok sevindim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730205
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730205,
					"content": "Sen beni tanımıyordun belki ama... Ben senin hakkında çok şey duydum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730206
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730206,
					"content": "#Aynısı Başrahibe Citlali, {NICKNAME} ve Paimon için de geçerli. Hakkınızda çok şey duydum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730207
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730207,
					"content": "Hı? Bizim de mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730208,
					"content": "Kulağa biraz klişe gelebilir ama siz benim her zaman olmak istediğim türden insanlarsınız... Ancak artık bunun yalnızca imkansız bir hayalden ibaret olduğunu anlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730209
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730209,
					"content": "Neden bir sersem ruh olarak dünyaya geldim ki sanki? Hehe, neyse sorun değil. İşe yaramazın teki olmaya alıştım zaten. Beni kurtardığınız için teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730210
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730210,
					"content": "Ororon, sanırım sen haklısın, hayat işte. Söz veriyorum bir daha böyle bir tehlikeye atmayacağım kendimi. Size de gereğinden fazla zahmet verdim hem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730211
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730211,
					"content": "Yaa, Leyla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730212,
					"content": "Haha, sorun değil! Beni teselli etmene gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730213
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730213,
					"content": "Hey, seni velet. Ne diyorsun sen? Bana bak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730214
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730214,
					"content": "Hı? Ne oldu Başrahibe Citlali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730215
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730215,
					"content": "Bana bak dedim. Dikkatli bak. Tuhaf bir şey hissediyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730216
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730216,
					"content": "Nine, sen neden bahsediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730217
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730217,
					"content": "#Ne dersin {NICKNAME}? Onun da mı yüzünde \"yardım etmekten mutluluk duyan biri\" yazıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730218,
					"content": "... Bir dakika, sanırım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730219
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730219,
					"content": "Ya zihnim bana bir oyun oynuyor ya da... Bedeni bir illüzyondan ibaret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730220
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730220,
					"content": "Yok... Hayal görüyorum muhtemelen. Böyle bir şeyi görüyor olmamın imkanı yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730221
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730221,
					"content": "Bir dakika, bu numarayı biliyorum... Daha önce kullandığımın aynısı. Ninem bize fark ettirmeden sıvıştı resmen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730222
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730222,
					"content": "Gördün mü? Artık bazı ruhsal anormallikleri algılayabiliyorsun. Tebrikler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730223
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730223,
					"content": "G-Gerçekten mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730224
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730224,
					"content": "Peki nereye gidiyorsun nine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730225
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730225,
					"content": "Nereye olabilir? Balığı yakalamaya gidiyorum sersem seni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730226
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730226,
					"content": "Birisi mağarada kurduğum tuzağı tetikledi. Dostumuz Kokuchuu yemi yuttu anlaşılan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730227
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730227,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730228,
					"content": "Kusura bakmayın, açıklayacak vakit yok şu an. Mağarada görüşelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				}
			]
		},
		{
