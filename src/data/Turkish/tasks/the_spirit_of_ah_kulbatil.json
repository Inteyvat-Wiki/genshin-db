			},
			"dialogs": [
				{
					"id": 401730301,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730302
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730302,
					"content": "(İnanamıyorum! Kaçtı! Ah, bu çok kötü oldu... Neden bu kadar kibirli davrandım ki bu konuda? Of, bir aptal gibi görüneceğim...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730303
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730303,
					"content": "(Bu Kokuchuu kaçma konusunda usta olmalı. Ancak bunu diğerlerine anlatamam. Bir şeyler düşünmem lazım...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730304
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730304,
					"content": "Citlali? Onu yakaladın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730305,
					"content": "Burada tek başına olmasına bakılırsa... Sanırım yakalayamamış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730306
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730306,
					"content": "... Ben....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730307
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730307,
					"content": "Şimdilik onu bırakmayı düşünmüştüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730308
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730308,
					"content": "Ama üzerinde bir işaret bıraktım! Yani bir daha buraya geldiğinde her hareketini takip edebileceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730309
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730309,
					"content": "Demek ninem mağaradan çıkıyor gibi numara yapıp aslında ona tuzak kurmak için pusuya yatmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730310
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730310,
					"content": "Aa, tıpkı Ororon'u yakaladığın gibi yani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730311,
					"content": "Ama Kokuchuu'nun buraya geleceğini nereden biliyordun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730312,
					"content": "Çünkü yemi buraya yerleştirdim. Mare Jivari haritasıyla yay parçasını bilerek burada bıraktım. Bunların peşinde olduğuna dair bir his vardı içimde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730313
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730313,
					"content": "Biz gittikten kısa bir süre sonra da tuzak tetiklendi zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730314
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730314,
					"content": "Demek buraya cidden tuzaklar yerleştirmiştin, ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730315,
					"content": "Evet ama size bir şey yapmayacak türden tuzaklar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730316
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730316,
					"content": "Gördünüz mü? Ne demiştim ben size?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730317
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730317,
					"content": "Bay Kokuchuu, demek beni kullandınız... Bunca zaman tek istediğiniz Mare Jivari'nin yerini bulmaktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730318
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730318,
					"content": "Aynen öyle. Bulduğumuzdan beri parçayı neden burada bırakmış olabileceğini düşünüyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730319
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730319,
					"content": "Mare Jivari'nin yerini tespit ettikten sonra bunun bir yem olduğunu fark ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730320
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730320,
					"content": "Leyla'nın ruhunun kaybolacağını ve kabiledekilerin de onu kurtarmaya geleceklerini umuyordu. Sonra da Leyla'ya yardım ederek aslında ona yardım etmiş olacaktık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730321
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730321,
					"content": "Aa! Demek tuzakmış! Hepsi, gerçekten durugörü yapıp parçayı onun yerine inceleyebilecek birini bulmak içinmiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730322,
					"content": "Evet. Birisi de yemi yutup tuzağına düşmüş oldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730323
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730323,
					"content": "Özür dilerim... Yemi yutan ben oldum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730324
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730324,
					"content": "Ama nine de var tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730325
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730325,
					"content": "Bu ne cüret? Ben senin yüzünden dahil oldum bu olaya, seni küçük velet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730326
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730326,
					"content": "Her türlü Kokuchuu bizimle bir güzel oynadı. Kendini hiç riske atmadan amacına ulaşmayı başardı. Oldukça kurnazca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730327
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730327,
					"content": "Aynen öyle! Citlali'ye doğrudan yaklaşmaya çalıştığını düşünsenize. Hemen fark ederdi onu zaten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730328,
					"content": "Bu arada Citlali, neden onun gitmesine izin verdin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730329,
					"content": "Iı... Çünkü tüm becerilerimi burada kullanma riskini almak istemedim. Çok hilebaz biri, eğer onu burada zorla tutmaya kalksaydım beklenmedik sonuçlara neden olabilirdi bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730330
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730330,
					"content": "Kötü bir yer seçmek benim hatam mıydı? Özür dilerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730331
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730331,
					"content": "Leyla'ya yardım etmeye ilk karar verdiğimde ruhsal enerjinin yoğun olduğu bir yer arıyordum ve sonunda bu çılgın bilgenin saklandığı yeri seçtim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730332
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730332,
					"content": "Çılgın bilge mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730333,
					"content": "Evet, tam şurada, duvarın arkasında uyuyor. Onu uyandırırsak uğraşmamız gereken bir sorun daha olacaktı. O yüzden tüm becerilerimi burada kullanmaktan imtina ettim işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730334
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730334,
					"content": "İyi haberlerim de var tabii. O kaçmadan hemen önce parçayı ve haritayı kurtarmayı başardım. Kendimi geri tutmuş olabilirim ama en azından öylece gitmesine izin vermedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730335
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730335,
					"content": "Çok iyi! Eli boş kaldı o zaman, haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730336,
					"content": "Iı, evet sanırım... Kötü haber şu ki gitmeden önce haritaya bir göz atma şansı oldu. Mare Jivari'nin bilinen son konumu pek de sır değil ama işte yine de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730337
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730337,
					"content": "Evet, bu biraz endişe verici... Ya şeytani bir planı varsa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401730338,
					"content": "Merak etme, ben onu takip etmeye devam edeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730339
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730339,
					"content": "#Leyla, senin için de bir sakıncası yoksa {NICKNAME} bu parçayı ve haritayı hediye olarak alsın diyorum. Yolculuğunun ilerleyen zamanlarında işine yarayabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730340
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730340,
					"content": "#Tabii ki bir sakıncası yok! {NICKNAME} bunu hak ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730341
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730341,
					"content": "Emin misiniz? Bu çok cömert bir hediye.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401730342
					]
				},
				{
					"id": 401730342,
					"content": "Hiçbirimizin özellikle ilgisini çekmiyorlar zaten. Hem seni Mare Jivari'ye götürme şansı varsa senin gibi bir maceracı kesinlikle bu fırsatı kaçırmaz zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730343
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730343,
					"content": "Itztli Nine'nizin bu konularda sezgisi iyidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730344
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730344,
					"content": "Peki Itztli Nine... Sence ben hâlâ bir sersem ruh muyum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730345
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401730345,
					"content": "Ne aptal bir soru bu böyle? Benim illüzyonumu gördün, değil mi? Yani bilerek kusursuz bir şekilde göstermedim ama yine de bir sersem ruh bunu algılayamazdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730346
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730346,
					"content": "Ororon, vaktin olunca bu adama bir şeyler öğret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730347
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730347,
					"content": "Leyla, ne kadar öğrenebileceğin de senin çabana bağlı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730348
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401730348,
					"content": "Harika... Hayat sürprizlerle dolu. Sen ilerlemeye devam ettiğin sürece bir gün yolda tesadüfen gübre bulabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730349
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401730349,
					"content": "Senin için çok mutluyum Leyla. İkimiz de elimizden geleni yapalım, kim bilir belki bir gün ikimiz de güzel lahanalar oluruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ororon"
				}
			]
		},
