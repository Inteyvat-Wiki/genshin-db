			"dialogs": [
				{
					"id": 760680101,
					"content": "Aria. Bakıyorum sen de kendine bir \"insan\" formu seçmişsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680102
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680102,
					"content": "Hehe, sen de tam düşündüğüm gibi olmuşsun Canon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680103
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680103,
					"content": "Yine de o sevimli ufaklıklar için kalkıp böyle bir form yaratmanı hiç beklemiyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680104
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680104,
					"content": "Gayet normal Aria. O kırılgan canlılar bana güvenip sesleniyor, ben de haliyle onlara kulak vereceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680105
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680105,
					"content": "Biz dünyayı korumak için doğduk. Eğer \"insan\" denen varlıklar buraya yerleşmek istiyorsa, onların çağrılarına kulak vermek Kralımızın bize verdiği görevi yerine getirmek demektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680106
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680106,
					"content": "Evet. Sonuçta yıldızlar denizindeki tüm canlıların müttefikimiz olduğunu bizzat kendisi söylemişti. Karanlığa karşı bizimle omuz omuza savaşıyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680107
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680107,
					"content": "Ama ben ondan bahsetmiyordum ki. Yani senin, koskoca \"Donuk Ay\"ın böyle duygusal bir tarafı olabileceğini hiç beklemiyordum. Çok sevimlisin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680108
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680108,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680109
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680109,
					"content": "... Bakıyorum da o küçük insanların lafları şimdiden diline dolanmaya başlamış Aria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680110
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680110,
					"content": "Kullandıkları kelimeler hep çok belirsiz. Kullanma onları. \"Sevimli\" derken ne kastettiğini gerçekten hiç anlamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680111
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680111,
					"content": "Yapmayın lütfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680112
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680112,
					"content": "Kardeşlerim, madem kendimize birer beden yaptık, ilk işimizin fark edilmeden dışarı çıkıp yüzeydeki insanlarla eğlenmek olması gerekmiyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680113
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680113,
					"content": "Yoksa bunları boşu boşuna yapmış oluruz! Hadi çabuk olun, kimselere yakalanmadan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680114
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680114,
					"content": "Hehe. Anlaşılan sevgili kardeşimizin beklemeye hiç niyeti yok Canon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680115
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680115,
					"content": "Hatırlıyorum da, yüzeyde medeniyetlerini ilk kurmaya başladıklarında \"Şu yabancı hiç tekin değil, e haliyle yarattıklarının da farkı yok.\" demiştin. Dönüp yüzlerine bile bakmazdın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680116
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680116,
					"content": "O başka bir mesele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680117
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680117,
					"content": "Bana kalırsa ikiniz o yabancıyı hiç içeri almamalıydınız ama yüzeydeki insanlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680118
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680118,
					"content": "Hah... Siz eğlenin. Hadi gidin bakalım, Aria'nın yanından da sakın ayrılma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680119
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680119,
					"content": "Nasıl yani? Sen gelmiyor musun bizimle Canon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680120
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680120,
					"content": "Şu Gökten Gelen'in hizmetkarının, bu dünyanın yer çekimsel potansiyeli ve metrik ten{RUBY#[D]zamanın kanunları}sörü hakkında benimle konuşacakları varmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680121
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680121,
					"content": "Istaroth mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680122
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680122,
					"content": "Sanırım adı oydu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680123
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680123,
					"content": "İnsanların isimlerini artık aklında tutman lazım kardeşim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680124
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680124,
					"content": "Belki de sadece bana öyle geliyordur ama onun şu Gökten Gelen'i nasıl gördüğüyle ilgili içimde... Değişik bir his var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680125
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680125,
					"content": "Hemen bir sonuca varmayacağım Aria, ama yine de gözümü dört açacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680126
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 760680126,
					"content": "Sevindim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680127
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680127,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680128
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 760680128,
					"content": "Hehe, bir şey yok. Biz önden gidelim o zaman Canon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680129
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680129,
					"content": "Merak etme, biz Sonnet'le sana bir hediye getiririz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680130
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 760680130,
					"content": "... Hediyeye falan gerek yok. Dikkat edin de kimse sizi tanımasın, o yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canon"
				}
			]
		}
	]
}