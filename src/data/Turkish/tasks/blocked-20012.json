					"nextDialogs": [
						200120206
					]
				},
				{
					"id": 200120206,
					"content": "Teşekkür ederim! Umarım çocuklarım da senin gibi nazik olurlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Telaşlı Myrana"
				},
				{
					"id": 200120205,
					"content": "Yapacak başka işlerim var.",
