				{
					"id": 200120301,
					"content": "Çok te-teşekkür ederim Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120302
					],
					"speakerTitle": "Telaşlı Myrana"
				},
				{
					"id": 200120302,
					"content": "Bu arada lütfen kimseye başımı belaya soktuğumu söyleme. Kocam bunu öğrenirse çok kızar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120303
					],
					"speakerTitle": "Telaşlı Myrana"
				},
				{
					"id": 200120303,
					"content": "Hiç bana öyle bakma, evlendiğinde sen de anlarsın. Hayatını biriyle yaşamaya adadıktan sonra arada bir yalnız dolaşmak bir lütuftur ve bunu en iyi şekilde değerlendirmek gerekir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120304
					],
					"speakerTitle": "Telaşlı Myrana"
				},
				{
					"id": 200120304,
					"content": "Bunu dışarıdayken toplamıştım, al lütfen. Kendi yemeğini kendin pişirmek Avcının Yeri'nde yemekten çok daha ucuza gelir! Biraz tutumlu olmakta fayda var.",
					"roleType": "TALK_ROLE_NPC",
