					"nextDialogs": [
						751031103
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751031103,
					"content": "Bir sürü balık hazırladım, Akarsu Kuşlarını buraya çekebilirsek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751031104
					],
					"speakerTitle": "Pania"
				},
				{
