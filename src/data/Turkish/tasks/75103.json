			"dialogs": [
				{
					"id": 751030101,
					"content": "Ne kadar çok balık var öyle! Siz burada ne yapıyorsunuz bakalım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030102,
					"content": "#Hı? Aa, merhaba sarışın {M#abi}{F#abla}! Merhaba onun yanındaki... Beyaz saçlı... Kardeş?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030103
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030103,
					"content": "Iwai ile birlikte Akarsu Kuşlarının kıyıya dönmesini bekliyoruz. Başka yapacak bir şeyimiz de yok zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030104
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030104,
					"content": "Kıyıya dönmelerini mi? Gerçekten mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030105,
					"content": "Hurruu, rruu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030106
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030106,
					"content": "Oldu mu böyle ama Iwai? Uslu bir çocuksun sen. Azıcık daha sabredelim, aceleye falan hiç gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030107
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030107,
					"content": "Raaa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030108
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030108,
					"content": "Neyse, aslında planımız buraya gelip oyun oynamaktı. Buraya Rongo Amca dışında pek kimse gelmiyor zaten... Yani bizim çok gizli üssümüz gibi bir yer oluverdi diyelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030109
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030109,
					"content": "Yine de bu kuşların bugün bizden erken davranacağını düşünmemiştik tabii...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030110
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030110,
					"content": "Sırf onları buraya çekebilelim diye bu balıkları hazırladık. Akarsu Kuşları bayılır bunlara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030111,
						751030112
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030111,
					"content": "Öyle mi? Pek çekememişsiniz sanki ama.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030116
					]
				},
				{
					"id": 751030116,
					"content": "Orası öyle. Acaba uzak olduğumuz için balıkların kokusunu alamıyor olabilirler mi? Onları bir şekilde kıyıya doğru yönlendirebilirsek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030117
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030117,
					"content": "Rongo Amca burada olsa <color=#00E1FFFF>\"Hepsini kıyıya doğru itekleyiverin işte!\"</color> gibi bir şey derdi... Tabii Iwai ile bende o güç ne arar? Biz o kuşları değil, onlar bizi iteklerdi kesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030118
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030118,
					"content": "#Hımm... Biz bir denesek mi acaba {NICKNAME}? Kuşları kıyıya çekebilirsek balık kokusuna gelirler belki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030112,
					"content": "Bizim Paimon aslında bir tür Akarsu Kuşuymuş meğer, şimdi anlaşıldı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030113
					]
				},
				{
					"id": 751030113,
					"content": "Hem yuvarlak hem de balıklara bayılıyor diyorsun yani... O zaman evet, haklısın galiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030114
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030114,
					"content": "Mmm! Mmmm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030115
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030115,
					"content": "O ne demek ya? Yok daha neler! Neyse, uzatmadan konuya geri dönelim. Akarsu Kuşlarını buraya çekememişsiniz ki siz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030118
					],
					"speakerTitle": "Paimon"
				}
			]
		},
