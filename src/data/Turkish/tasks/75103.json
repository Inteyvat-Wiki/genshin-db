			},
			"dialogs": [
				{
					"id": 751030801,
					"content": "Vay be, amma çok balık var burada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030802,
					"content": "#Dur, sakın kıpırdama sarışın {M#abi}{F#abla}! Akarsu Kuşlarını buraya çekelim diye koyduk o balıkları!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030803
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030803,
					"content": "Aa, Akarsu Kuşlarını çekmek için mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030804,
					"content": "Evet! Iwai ile birlikte Akarsu Kuşlarının kıyıya dönmesini bekliyoruz. Başka yapacak bir şeyimiz de yok zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030805
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030805,
					"content": "Hurruu, rruu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030806
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030806,
					"content": "Oldu mu böyle ama Iwai? Uslu bir çocuksun sen. Azıcık daha sabredelim, aceleye falan hiç gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030807
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030807,
					"content": "Raaa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030808
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030808,
					"content": "Neyse, aslında planımız buraya gelip oyun oynamaktı. Buraya Rongo Amca dışında pek kimse gelmiyor zaten... Yani bizim çok gizli üssümüz gibi bir yer oluverdi diyelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030809
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030809,
					"content": "Yine de bu kuşların bugün bizden erken davranacağını düşünmemiştik tabii...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030810
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030810,
					"content": "Sırf onları buraya çekebilelim diye bu balıkları hazırladık. Akarsu Kuşları bayılır bunlara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030811,
						751030812
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030811,
					"content": "Öyle mi? Pek çekememişsiniz sanki ama.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030816
					]
				},
				{
					"id": 751030816,
					"content": "Orası öyle. Acaba uzak olduğumuz için balıkların kokusunu alamıyor olabilirler mi? Onları bir şekilde kıyıya doğru yönlendirebilirsek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030817
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030817,
					"content": "Rongo Amca burada olsa <color=#00E1FFFF>\"Hepsini kıyıya doğru itekleyiverin işte!\"</color> gibi bir şey derdi... Tabii Iwai ile bende o güç ne arar? Biz o kuşları değil, onlar bizi iteklerdi kesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030818
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030818,
					"content": "#Hımm... Biz bir denesek mi acaba {NICKNAME}? Kuşları kıyıya çekebilirsek balık kokusuna gelirler belki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751030812,
					"content": "Bizim Paimon aslında bir tür Akarsu Kuşuymuş meğer, şimdi anlaşıldı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751030813
					]
				},
				{
					"id": 751030813,
					"content": "Hem yuvarlak hem de balıklara bayılıyor diyorsun yani... O zaman evet, haklısın galiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030814
					],
					"speakerTitle": "Pania"
				},
				{
					"id": 751030814,
					"content": "Mmm! Mmmm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030815
					],
					"speakerTitle": "Iwai"
				},
				{
					"id": 751030815,
					"content": "O ne demek ya? Yok daha neler! Neyse, uzatmadan konuya geri dönelim. Akarsu Kuşlarını buraya çekememişsiniz ki siz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751030818
					],
					"speakerTitle": "Paimon"
				}
			]
		},
