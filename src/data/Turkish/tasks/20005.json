			"dialogs": [
				{
					"id": 200050101,
					"content": "Gezgin! Tam zamanında geldin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200050102
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200050102,
					"content": "Geçen gece bu malları şehre taşımak için yolda giderken gözüme birkaç parlak küre takıldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200050103
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200050103,
					"content": "Ç-Çok içtim ve... İlgimi çektiler, anlarsın ya. Kontrol etmek için yanlarına gittiğimde büyük bir bodurlop grubu olduğunu fark ettim. Hatta beni çok fena benzettiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200050104
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200050104,
					"content": "Panikleyip kaçtım ama yolumu kaybettim. Arabamı yeniden bulmam saatler sürdü. Bu sabah da <color=#00E1FFFF>anahtarımın</color> kaybolduğunu fark ettim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200050105
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200050105,
					"content": "Aramama yardım eder misin? Buralarda bir yerlerde olsa gerek... Burnumun dibindeymiş gibi hissediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200050106,
						200050108
					],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200050106,
					"content": "Tamam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200050107
					]
				},
				{
					"id": 200050107,
					"content": "Harika! Burası çok büyük bir alan, nereden aramaya başlayacağımı bile bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wyatt"
				},
				{
					"id": 200050108,
					"content": "Halletmem gereken acil bir işim var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200050109
					]
				},
				{
					"id": 200050109,
					"content": "Burası çok büyük bir alan. Nereden aramaya başlayacağımı bilmiyorum. Lütfen, bana yalnızca sen yardım edebilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wyatt"
				}
			]
