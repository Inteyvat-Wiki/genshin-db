			"dialogs": [
				{
					"id": 740390701,
					"content": "#İyi misin {NICKNAME}? İyi misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390702
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390702,
					"content": "Lütfen kusura bakma... İlacın öyle garip yaratıkları çekebileceğini bilmiyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390703,
						740390710
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390703,
					"content": "Herhalde iksir beni sıcacık yaptığı için öyle oldu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390704
					]
				},
				{
					"id": 740390704,
					"content": "Iı, öyle mi? Sıcak olmakla nasıl bir alakası var ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390705,
					"content": "Aa... Doğru ya! Su canlıları sıcak şeyleri güneş zannedip ona doğru çekiliyorlar. Bu da demek oluyor ki... İksir işe yaramış! İkinize de gerçekten teşekkür ederim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390706
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390706,
					"content": "Paimon böyle olduğunu pek düşünmüyor ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390707,
					"content": "Su canlıları mı? Ateş Bodurlopu değil miydi onlar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390708
					]
				},
				{
					"id": 740390708,
					"content": "Evet... Hımm, halüsinojenik yan etkiler... Pekala, not aldım. Tamamen etkisiz olmadı en azından. Ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390709
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390709,
					"content": "Ama etkileri korkunçtu! Dev yengeçleri Ateş Bodurlopları gibi gösterdi. Ya bir sonraki sefer daha tehlikeli bir canavar gelirse? O zaman ne olacak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390720,
					"content": "Evet... Size çok zahmet verdim ama denenmesi gereken son bir iksir daha var... Devam edebilir misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390721,
						740390723
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390721,
					"content": "Zehirli olmadığı sürece sorun yok, devam edelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390722
					]
				},
				{
					"id": 740390722,
					"content": "Gerçi zehirli olup olmadığını yalnızca test edince anlayabileceğiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390725,
					"content": "Evet! Teşekkürler! Sırada Net Görüş İksiri var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390726
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390726,
					"content": "Ne? B-Bekle bir saniye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390727,
					"content": "İlki Süper İksirdi, sonra Deniz Meltemi İksiri geldi, şimdiki iksirin adı da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390728,
					"content": "Net Görüş İksiri, çünkü \"insanlara doğruyu gösteriyor\"... Nesi var ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390729
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390729,
					"content": "Şey... Önemli değil... Paimon bu ismin diğerlerine kıyasla epey farklı olduğunu düşünüyor da! 360 derece değişmiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390730,
						740390731
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390730,
					"content": "360 derece değişse aynı olmaz mıydı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390732
					]
				},
				{
					"id": 740390732,
					"content": "Ne? Iı... Paimon'un o kadar parmağı yok ki! Anladın zaten Paimon'un ne demek istediğini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390733
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390733,
					"content": "Hehe, çünkü ilk ikisinin ismini İksir Ustası verdi ama bunun ismini ben buldum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390734
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390734,
					"content": "İsim bulma konusunda iyi değilim, bu yüzden onun buldukları kadar güzel değil hiç.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390735
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390735,
					"content": "Ciddi misin? Paimon tam tersini düşünüyor... Neyse, kendine biraz daha güven! Bulduğun isim tam iksire yaraşır bir isim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390736
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390736,
					"content": "Hım, sağ ol. Neyse... Bu iksir ilk ikisinden farklı. O yüzden çok tehlikeli olabilir... Atölyeme gelin lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390737
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390737,
					"content": "Denizde olursak iksirin etkilerini ortam hafifletecektir. Tehlikelerle mücadele etmek için gerekli aletler de atölyemde mevcut...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390738
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390738,
					"content": "Vay be, bu çok acayipmiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390739,
					"content": "Başlayalım o zaman.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390740
					]
				},
				{
					"id": 740390740,
					"content": "Peki. Gelin benimle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390731,
					"content": "180 derece demek istedin herhalde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390732
					]
				},
				{
					"id": 740390723,
					"content": "Neyse, buraya kadar geldik...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390724
					]
				},
				{
					"id": 740390724,
					"content": "Aynen öyle! Yarı yolda vazgeçersek tüm bunların ne anlamı kalır? Gerçi... Paimon endişelenmiyor değil tabii ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390710,
					"content": "Merak etme, Ateş Bodurlopları çok güçlü değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390711
					]
				},
				{
					"id": 740390711,
					"content": "Hehe... Yok hayır, sen çok güçlüsün!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390712,
					"content": "Hımm, bir saniye... Ateş Bodurlopu mu dedin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390713
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390713,
					"content": "Aa! Doğru... Bir sürü dev yengeç gördük aslında!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390714,
						740390716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390714,
					"content": "Yengeç mi? Evet, kıyıya yakın yerde yengeç görmemiz normal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390715
					]
				},
				{
					"id": 740390715,
					"content": "Hiç normal değildin ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390716,
					"content": "Fakat yanma hissi gerçekti. Onlardan gelen ısı dalgalarını hissedebiliyordum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390717
					]
				},
				{
					"id": 740390717,
					"content": "Evet... Hımm, halüsinojenik etkiler... Pekala, not aldım. Tamamen etkisiz olmadı en azından. Ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390718
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390718,
					"content": "Her neyse, bir şeyinizin olmaması harika! Sadece... İksir yine işe yaramadığı için üzgünüm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390719
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390719,
					"content": "#Takma kafana! Neyse... Berbat kokmasına rağmen yarı yarıya işe yaradı denebilir. Baksana, {NICKNAME} iksiri içtikten sonra ona hiçbir şey olmadı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390720
					],
					"speakerTitle": "Paimon"
				}
			]
		},
