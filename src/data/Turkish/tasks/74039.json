			},
			"dialogs": [
				{
					"id": 740390501,
					"content": "Teşekkürler! Önce ilk iksiri deneyelim o zaman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390502
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390502,
					"content": "#Çok içme {NICKNAME}! Kötü hissedersen hemen tükür, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390503,
					"content": "Merak etme Paimon. Bana bir şey olmaz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390504
					]
				},
				{
					"id": 740390504,
					"content": "Hıh. Paimon endişelenmeden edemiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390505,
					"content": "Hazırım. İksiri ver.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390506
					]
				},
				{
					"id": 740390506,
					"content": "Bunun adı Süper İksir. Seni çok kuvvetli yapacak! Yani teoride öyle olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390507
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390507,
					"content": "İksiri Verenata'dan alıp tek dikişte bitiriyorsun.\\nDayanması zor, keskin bir kokusu var ama içimi kolay. Yoğun ve tatlı bir lezzete sahip.\\nFakat bunlar dışında vücudunda bir tepki olmuyor.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390508
					]
				},
				{
					"id": 740390508,
					"content": "Verenata'nın talimatı üzerine Patojenler etkinleşene kadar bekliyorsun.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
