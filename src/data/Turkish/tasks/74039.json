						"sceneId": 3,
						"position": [
							2501.063,
							445.119,
							4637.081
						],
						"pointId": 5959
					}
				]
			},
			"dialogs": [
				{
					"id": 740390601,
					"content": "Ş-Şey, bu yaratıkları Süper İksir sayesinde mi bu kadar kolay yendin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390602,
						740390605
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390602,
					"content": "Aynen! Bana Süper Güç verdi resmen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390603
					]
				},
				{
					"id": 740390603,
					"content": "O ne biçim bir pazarlama sloganı oldu öyle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390604,
					"content": "Ah, teşekkür ederim! İksirin etkisi tesir etti o zaman. Bir İksir Ustasının reçetesi ne de olsa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390609
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390609,
					"content": "Tamam o zaman. Süper İksiri testini burada bitirebiliriz. Sırada şu Deniz Meltemi İksiri var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390610
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390610,
					"content": "Şey, bu isimleri kendin mi buldun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390611,
					"content": "Yok, isim bulmada pek iyi sayılmam. Genelde güzel isim bulmama başkaları yardım eder hep...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390612
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390612,
					"content": "Öyle deme... Hem zaten bir iksirin ismi, iksirin etkisini en baştan açıkça belirtmeli. Değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390613,
					"content": "Hımm. Bunu ilk kez duyuyorum... Ama haklısın! Bir İksir Ustası böyle yapmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390614
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390614,
					"content": "#*öksürür* H-Her neyse, iksiri test etmek için hazır mısın {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390615
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390615,
					"content": "Tabii, başlayalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390616
					]
				},
				{
					"id": 740390616,
					"content": "Off, bu da felaket kokuyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390617,
					"content": "Deniz Meltemi İksirinin teorik olarak seni soğuğun etkilerinden koruması ve sıcak tutması gerekir! Evet, sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390618
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390618,
					"content": "İksiri Verenata'dan alıyorsun. Tozlu ve küflü eski deri gibi kokuyor...\\nBiraz tereddüt ettikten sonra tek dikişte hepsini içiyorsun. İçeceğin lezzeti kötü değil, hafif acı, tarçın ve zencefil tadı hissediliyor... Yağmurlu bir günde çıtırdayan şömine ateşi başında oturduğunu anımsatıyor insana.\\nFakat bunlar dışında vücudunda bir tepki olmuyor.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740390619
					]
				},
				{
					"id": 740390619,
					"content": "Daha sonra Verenata'nın talimatı üzerine biraz dinleniyorsun.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 740390605,
					"content": "Pek bir şey hissetmedim ama tatlıymış.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390606
					]
				},
				{
					"id": 740390606,
					"content": "Ne? Ama berbat kokuyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390607,
					"content": "Hımm... Öyle mi? Bir şeyi yanlış mı yaptım acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390608
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390608,
					"content": "Moralini bozma, en azından zehirlenmedik... Bu da bir başarı, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390609
					],
					"speakerTitle": "Paimon"
				}
			]
		},
