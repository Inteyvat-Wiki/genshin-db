			"dialogs": [
				{
					"id": 740390101,
					"content": "Hımm... Tidalga çamuru, ezilmiş Tan Yıldızı bağırsağı ve bir miktar... Hım, \"bir miktar\" tam olarak ne kadar ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390102
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390102,
					"content": "Selam, çorba mı yapıyorsun? Iy, çok garip kokuyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390103,
					"content": "Hımm? Garip mi kokuyor? Yok canım. Carabosse'un verdiği formülü harfi harfine takip ettim. Normal kokuyor olmalı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390104,
						740390106
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390104,
					"content": "Ölü kurbağa dolu bir kazana yatırılıp üç yıl mayalanmış levrek gibi kokuyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390105
					]
				},
				{
					"id": 740390105,
					"content": "Öğ, sesli söylemen gerekiyor muydu? Şimdi görüntüsü Paimon'un gözünün önünden gitmiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390108,
					"content": "H-Her neyse, ne yapıyorsun? Yardıma ihtiyacın var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390109,
					"content": "İksir yapıyorum! Bir sürü insana yardım edecek bir formül oluşturmaya çalışıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390110
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390110,
					"content": "Sen bir iksircisin öyleyse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390111,
					"content": "Henüz değil. Şu an İksir Ustasının yardımcısıyım ve ondan hâlâ öğrenecek çok şeyim var. Onun ismi Carabosse, ben de Verenata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390112
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390112,
					"content": "Hehe, büyük bir hekimin yardımcısı da büyük bir yardımcı sayılmaz mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390113,
					"content": "Hehe, eve... Bir dakika, hayır! Alakası yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390114
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390114,
					"content": "Yani... Hâlâ bilmediğim bir sürü şey var. Ustamın iksir yapmasına elimden geldiğince yardım etmeye çalışıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390115
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390115,
					"content": "Ayrıca... Ş-Şey, ben ismimi söyledim ama sizin isimlerinizi bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390116
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390116,
					"content": "#Paimon'un adı Paimon, bu da {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390117,
					"content": "\"Paimon\". Ne güzel bir isim. Gürültücü beyaz denizanaları gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390118
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390118,
					"content": "#{NICKNAME}. Birazcık tuhaf bir isim, altın gibi parlıyor. Ama çok cana yakın. Memnun oldum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390119
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390119,
					"content": "Şey, yardıma ihtiyacım var mı diye sordunuz... Var ama yardım etmek ister misiniz bilemem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390120
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390120,
					"content": "Bir anlat bakalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390121
					]
				},
				{
					"id": 740390121,
					"content": "Aynen öyle! Yardıma ihtiyacın varsa söyle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390122,
					"content": "Yeni iksirlerimi... Denemenizi istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390123
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390123,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390124,
					"content": "İksirlerin kokusu ve tadı kötü oluyor, biliyorum... Ama bir sürü insana yardımcı olabiliyor ve pek çok hastalığı iyileştirebiliyorlar. Çok faydalı şeyler yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390125
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390125,
					"content": "Biz hasta olamıyoruz ve tuhaf şeyler içmeyi sevmiyoruz. İnsanlar da iksirlerin tadına bakmak için yardım etmeyi bıraktı. Benim için büyük bir sorun bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390126
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390126,
					"content": "Iı... Bu iksirleri tuhaf olduğunu kendin söyledin! Tehlikeli değildir herhalde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390127,
					"content": "Değil. Biz iksirlerden zehirlenmeyiz. Şey... Siz de zehirlenmezsiniz herhalde... Yani en azından teoride öyle olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390128
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390128,
					"content": "Denenmesi gereken toplamda üç iksir var. Biri insanların daha iyi dövüşmesini sağlıyor! İkincisi insanları sıcak tutuyor. Üçüncüsü de... Şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390129
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390129,
					"content": "Nasıl anlatsam bilemedim ama Carabosse bu üçüncü iksirin insanların gerçeği anlamasını sağladığını söyledi. Kendi öyle diyor yani... Ben ne anlama geldiğini anlamadım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390130
					],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390130,
					"content": "Tehlikeli duruyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740390131,
					"content": "Hayır, tehlikeli değil... Neyse, yardım etmek ister misiniz? Edecekseniz sizi hemen test alanına götürebilirim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verenata"
				},
				{
					"id": 740390106,
					"content": "Biraz sakinleşirsen Tatlı Çiçeklerin kokusunu alabilirsin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740390107
					]
				},
				{
					"id": 740390107,
					"content": "Hey, öyle bir şey yok hiç!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740390108
					],
					"speakerTitle": "Paimon"
				}
			]
		},
