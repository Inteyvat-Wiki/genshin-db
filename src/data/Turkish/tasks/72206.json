					"Abe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722060501,
					"content": "Vay canına! Haha... Ne kadar garip şekilleri var! Bunların da ruhu var mı? İnsanların anılarını saklıyorlar mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060502
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060502,
					"content": "Bir de bu yumuşak, kanada benzer şeyler var... Uçabiliyorlar mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060503
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060503,
					"content": "Ah, işte ben ve bitmek bilmeyen merakım! Sandalcı sinirlenmeye başladı galiba. Üzgünüm ama artık gitmeliyim. Evet, gitmeliyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Abe"
				}
			]
		}
	]
