			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Abe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722060301,
					"content": "Hey! Hey! Sizi daha önce uyarmadım mı? Kör müsünüz yoksa sağır mısınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060302
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060302,
					"content": "Aa, bak. Bir hayalet!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060303
					]
				},
				{
					"id": 722060303,
					"content": "Ne! Hayalet mi? Nerede? Nerede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060304,
						722060305
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060304,
					"content": "Tam burada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060306
					]
				},
				{
					"id": 722060306,
					"content": "Aaaah! Git! Kış kış! Kötü ruhlar gidin buradan! Klanım olan Abe Klanı adına gidin buradan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060307
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060307,
					"content": "Ne? Ha-Hayır! Bu olamaz! Ben... Hayatım boyunca bu kadar kötü bir ruh görmemiştim! Ne-Neden ayrılmıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060308
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060308,
					"content": "Neden mi? Bu adanın çok uzaklarından geldim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060309
					]
				},
				{
					"id": 722060309,
					"content": "Sis Denizi'nin ötesinden gelen bir şeytani ruh mu? Se-Senden korkmuyorum! Hele sen bekle! Bü-Büyük Yıldırım Kuşu seni buradan kovacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060310,
						722060311
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060310,
					"content": "Yıldırım Kuşu çoktan gitti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060312
					]
				},
				{
					"id": 722060312,
					"content": "Ne-Ne dedin sen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060313,
						722060314
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060313,
					"content": "Herkes ayrıldı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060315
					]
				},
				{
					"id": 722060315,
					"content": "Ne-Ne diyorsun sen? Sa-Sakın beni böyle korkutmaya çalışma. Ah, tüylerim diken diken oldu bile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060316
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060316,
					"content": "Gerçi son zamanlarda adada çok az insana rastladım. Ayrıca Kina, herkesin sandala bindiğini söyledi... *iç çeker* Kim bilir o çocuk nereye gitti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060317
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060317,
					"content": "Bekle biraz. Bu adadan olmayan ruh... Sen de ayrılmıyor musun? Sahildeki gümüş sandala binmeyecek misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060318,
						722060319
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060318,
					"content": "Orada sandal görmedim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060320
					]
				},
				{
					"id": 722060320,
					"content": "Ne... Biliyordum. Yabancıların o sandalı göremediğini biliyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060321
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060321,
					"content": "Yine de şeytani ruh, bana sandala binmem gerektiğini söylediğin için teşekkür ederim. Şey... Sadece çok uzun süredir buradayım ve hâlâ yapamadığım o kadar çok şey var ki... Buradan öylece gidemem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060322
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060322,
					"content": "Neye ihtiyacın var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060323
					]
				},
				{
					"id": 722060323,
					"content": "İhtiyaç mı? Ne? Yani bir şeye ihtiyacım olduğundan değil. Sadece yeni bir şey görmek istiyorum, anlıyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060324
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060324,
					"content": "Eskiden ben daha çok gençken Una ile bir iddiaya girmiştik. Adamızdan farklı yerlerde farklı tür mantarların olduğunu söylemiştim ama Una bana inanmamıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060325
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060325,
					"content": "Biz büyüdükten sonra Una'nın kocası yabancıların yaşadığı yerleri bulmak için denize açıldı. Asla geri dönmedi. Ruhunun uzaklarda amaçsızca dolaştığı söyleniyor... Yazık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060326
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060326,
					"content": "O günden beri Una yalnız yaşıyor. Bunu her düşündüğümde ben... *iç çeker*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060327,
						722060328
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060327,
					"content": "Una hakkında bu kadar endişelenme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060329
					]
				},
				{
					"id": 722060329,
					"content": "Rahibe bile yalvardım biliyor musun? En sonunda birine kalacak bir yer ayarlamamız gerekti... Ah doğru, doğru! Mantarlar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060330
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060330,
					"content": "*öksürür* Yakında sandala bineceğim ve çok fazla pişmanlığım yok. Yalnızca bu adanın dışına hiç çıkmadım. Yine de aklım her gün baktığım mantarlarda kalacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060331
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060331,
					"content": "Lütfen bana Sis Denizi'nin ötesinden mantar getir. Nasıl göründüklerini çok merak ediyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060332
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060332,
					"content": "Yabancı şeytani ruh, lütfen yardım et!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060328,
					"content": "Şu mantarlar hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060329
					]
				},
				{
					"id": 722060319,
					"content": "Sandal beni alacak şekilde tasarlanmamış da ondan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060320
					]
				},
				{
					"id": 722060314,
					"content": "Gitme zamanı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060315
					]
				},
				{
					"id": 722060311,
					"content": "Sis Denizi artık geçmişte kaldı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060312
					]
				},
				{
					"id": 722060305,
					"content": "Benim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060306
					]
				}
			]
		},
