			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722060201,
					"content": "Amanın! Az önceki adam... Gördün mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060202,
						722060203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722060202,
					"content": "Hayır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060204
					]
				},
				{
					"id": 722060204,
					"content": "Aah, çok korkutucuydu. Biraz mantar toplayıp buradan gidelim, olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722060203,
					"content": "Hayal görmüş olmalısın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060204
					]
				}
			]
		},
		{
			"id": 7220603,
			"completionStepIds": [
				7220605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220604",
							"3"
