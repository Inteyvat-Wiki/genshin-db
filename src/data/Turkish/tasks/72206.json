				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722060101,
					"content": "Hey! Buradayım, görmüyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060102
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060102,
					"content": "Günümüz gençleri... Siz çocuklarda hiç saygı yok mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722060103,
						722060105
					],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060103,
					"content": "Öz-Özür dileriz!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060104
					]
				},
				{
					"id": 722060104,
					"content": "Hıh! Aferin. Mantarlara gelince; size hediyem olsun. Ama geri kalanlara kafanıza göre dokunmayın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Abe"
				},
				{
					"id": 722060105,
					"content": "Bunlar senin mantarların mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722060106
					]
				},
				{
					"id": 722060106,
					"content": "Seni ilgilendirmez! Kafana göre toplamayı bırak ve defol buradan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Abe"
				}
			]
		},
		{
