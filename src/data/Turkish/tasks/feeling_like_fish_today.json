			"dialogs": [
				{
					"id": 750150501,
					"content": "Oh be, her yeri temizledik... G-Galiba artık Paimon'un balık tutma vakti geldi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150502,
					"content": "Göreceksiniz, Paimon öyle büyük bir balık tutacak ki feleğiniz şaşacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150503,
					"content": "Maalesef suyun yüzeyi tıpkı bir ayna gibi hareketsiz kalır, tek bir kıpırtı bile yoktur.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150504
					]
				},
				{
					"id": 750150504,
					"content": "Off... Buranın suyunda bir gariplik mi var, ne? Balıkların sudan çıkası yok gibi sanki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150505,
						750150508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150505,
					"content": "Hehe, çok yaklaşmıştın...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150506
					]
				},
				{
					"id": 750150506,
					"content": "Evet, öyle ama... bu iş böyle olmayacak gibi. Off, bu balığı tutmak yıllar sürecek galiba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150507,
					"content": "Paimon'a boşu boşuna umut verme şimdiden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150511,
					"content": "Raarr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150512
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150512,
					"content": "Başarabilirsin Paimon! Başarabilirsin!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150513
					]
				},
				{
					"id": 750150513,
					"content": "Paimon'un dikkatini dağıtmasanıza ya... Üff!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150514,
					"content": "Aa, bir dakika! Oltaya bir şey takıldı! Hadi makarayı çekelim de Paimon ne yakalamış görelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150515,
					"content": "#Bu ne böyle... Balık değil ki bu, şişeymiş! Hatta balık tutma noktasında duran tahta kalaslara bağlıymış... Off, neyse ki sen de sürekli böyle saçma sapan şeyler tutuyorsun {NICKNAME}. Yoksa Paimon şu an kahrolurdu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150516,
					"content": "Senin de tutamadığın şey yok Paimon... Balık haricinde tabii.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150517
					]
				},
				{
					"id": 750150517,
					"content": "Ne olmuş ya, sanki sen hiç tuhaf tuhaf şeyler tutmuyorsun! Neyse... Madem bu şişe çıktı, bakalım içinde ne varmış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150518,
					"content": "Bunu buraya bırakan şuradaki ikili olabilir mi sence? Kafayı böyle balıkçılıkla bozan insanlar da bayağı korkunçmuş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150519,
					"content": "Galiba bu şişeyi birbirleriyle haberleşmek için kullanıyorlar. Biz bunu geri suya atalım en iyisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150520,
					"content": "Neyse! Paimon bu kez bir balık tutacak gibi hissediyor, hehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150521,
					"content": "Olta birden öne doğru eğilir ve güçlü bir şekilde suya doğru çekilmeye başlar.\\nOldukça büyük ve ağır bir şey takılmış gibidir...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150522
					]
				},
				{
					"id": 750150522,
					"content": "Sonunda bir şey yakaladık! Bayağı büyük bir balık olsa gerek bu... Gel bakalım seni koca balık seni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150523,
					"content": "Hanimiş güzel balık, gel bakalım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150524
					]
				},
				{
					"id": 750150524,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150525
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150525,
					"content": "#Paimon'u öyle çabalarken görünce\\n{REALNAME[ID(2)|SHOWHOST(true)]} ile birlikte onu tutuyorsunuz...\\nNe var ki olta inanılmaz bir güçle suya doğru çekilmeye devam ediyor.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150526
					]
				},
				{
					"id": 750150526,
					"content": "En sonunda güçlü bir cup sesi duyulur ve balık kaçıverir...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750150527
					]
				},
				{
					"id": 750150527,
					"content": "*ağlar* Ne kadar büyük bir balıktı kim bilir... Küçük olsa Paimon'un elinden hayatta kurtulamazdı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150528,
					"content": "Off, çok sinir bozucu... Bir dakika ya. Hâlâ suyun üzerinde yüzmeye devam ediyor bu! Yok daha neler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150529,
					"content": "Raarr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150530
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150530,
					"content": "Hayır, hayır! Su çok tehlikeli! Zaten senin yakalaman mümkün değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150531
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150531,
					"content": "Raarr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150532
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150532,
					"content": "#Şu balığı yakalamanın bir yolunu bulabilseydik keşke {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150508,
					"content": "Çok uzun sürmez canım. Sen heyecan yapma, yeter!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750150509
					]
				},
				{
