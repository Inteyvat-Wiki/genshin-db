			"dialogs": [
				{
					"id": 750150401,
					"content": "#İşte bu! Paimon ne demişti sana? Ele avuca sığmayan bu ufaklığı yakalarsa ancak {NICKNAME} yakalar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750150402,
					"content": "Ha, yeteneklerden konu açılmışken... Acaba tüm bu yemleri suya atsak, balıklar da şişene kadar yiyip suyun üstüne çıksa... Yine de \"balıkçılık\" sayılır mı bu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150403
