					"content": "Raarr... Raarr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150404
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750150404,
					"content": "#Hehe. Sen de hak verdin, değil mi {REALNAME[ID(2)|SHOWHOST(true)]}? Gözündeki parıltıdan anlaşılıyor ne düşündüğün! Bir dahaki sefere bunu deneyelim madem, hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750150405
					],
					"speakerTitle": "Paimon"
				},
				{
