			},
			"dialogs": [
				{
					"id": 790440101,
					"content": "Sevgili gezginler, seyahatleriniz sizi nihayet buraya getirdiği için kadere teşekkür etmeliyiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440102
					],
					"speakerTitle": "Lunapark Duyuru Hoparlörü"
				},
				{
					"id": 790440102,
					"content": "Akla hayale sığmayacak, şans eseri bir karşılaşma arıyor olmalısınız. Sıradan bir hayal gücüne sığamayacak kadar nefes kesici bir macera...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440103
					],
					"speakerTitle": "Lunapark Duyuru Hoparlörü"
				},
				{
					"id": 790440103,
					"content": "İşte tüm bu arzularınızı gerçekleştirme fırsatınız burada, şu an karşınızda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440104
					],
					"speakerTitle": "Lunapark Duyuru Hoparlörü"
				},
				{
					"id": 790440104,
					"content": "Yepyeni \"Daiya'nın Üç Günlük Rüyası\" sizi çağırıyor! Büyük sahneye çıkın ve akla hayale sığmayan, heyecan verici yeni bir deneyim yaşayın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440105
					],
					"speakerTitle": "Lunapark Duyuru Hoparlörü"
				},
				{
					"id": 790440105,
					"content": "Mora dolu bir havuzda gönlünüzce yüzün... Kadim kalelere musallat olan hayaletleri defedin... Yer çekiminin zincirlerinden kurtulun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440106
					],
					"speakerTitle": "Lunapark Duyuru Hoparlörü"
				},
				{
					"id": 790440106,
					"content": "Şu anahtar cümleyi fısıldamanız yeterli: \"Bizi rüyaların dünyasına götür.\" Merak ve tutkunuzu duyurun, yolculuğunuza başlayın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440107
					],
					"speakerTitle": "Lunapark Duyuru Hoparlörü"
				},
				{
					"id": 790440107,
					"content": "Vay be, şu konuşmacı insanları etkilemeyi cidden iyi biliyor! Paimon ayrıntıları anlayamadı gerçi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440108,
					"content": "Yolculuk, gösteri, sahne... Bir de... Mora havuzu dedi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440109,
						790440110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440109,
					"content": "Yeni bir eğlence programı herhalde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440111
					]
				},
				{
					"id": 790440111,
					"content": "Ah! Sen böyle deyince... Paimon daha önce böyle bir etkinlik duyduğunu hatırladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440112,
					"content": "Peki, şu anda konuşan kişi Daiya mı? Oyunun rejisörü herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440113,
					"content": "O zaman kayıt yaptırırsak oyunlardaki karakterler olarak oynayabiliyor muyuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440114,
						790440115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440114,
					"content": "İlgini mi çekti Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440116
					]
				},
				{
					"id": 790440116,
					"content": "Kulağa havalı gelmedi değil! Paimon özellikle şu Mora havuzunu pek bir merak ediyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440117,
					"content": "Şey... Sırf onu değil tabii! Veluriyam Serabı'nda böyle özel bir yeri hak eden bu gizemli eğlence programını da görmek istiyor Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440118,
					"content": "O zaman anahtar cümleyi beraber söyleyelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440119,
					"content": "Bizi rüyaların dünyasına götür!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440120
					]
				},
				{
					"id": 790440120,
					"content": "Bizi rüyaların dünyasına götür!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440121,
					"content": "Cidden mi? Ne kadar da çabuk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440122
					],
					"speakerTitle": "Lunapark Duyuru Hoparlörü"
				},
				{
					"id": 790440122,
					"content": "*öhöm* Harika! Kayıtlarınız onaylandı, Daiya'nın Üç Günlük Rüyası birazdan başlayacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440123
					],
					"speakerTitle": "Lunapark Duyuru Hoparlörü"
				},
				{
					"id": 790440123,
					"content": "\"Kadim bir efsane yeniden gün yüzüne çıkar, paha biçilmez bir hazineye dair yeni ipuçları bulunur. Bir grup cesur korsan, silahlarını biler ve yelkenlere asılır...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440124
					],
					"speakerTitle": "Lunapark Duyuru Hoparlörü"
				},
				{
					"id": 790440124,
					"content": "\"Gökte süzülen bir kasaba, daha önce benzeri görülmemiş bir felaketle karşılaşır. Mucizeler yaratan bir mimar, hemen harekete geçmeli ve uçan şehrin yere çakılmasını önlemelidir...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440125
					],
					"speakerTitle": "Lunapark Duyuru Hoparlörü"
				},
				{
					"id": 790440125,
					"content": "\"Düşen arkadaşlarını kurtarmak isteyen yalnız bir Su Tayfı, hayaletlerin musallat olduğu kaleye sızmalı ve laneti kaldırmanın bir yolunu bulmalıdır...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440126
					],
					"speakerTitle": "Lunapark Duyuru Hoparlörü"
				},
				{
					"id": 790440126,
					"content": "Üç farklı gösteri var, üçünün de konusu farklı. Lütfen birini seçin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440127
					],
					"speakerTitle": "Lunapark Duyuru Hoparlörü"
				},
				{
					"id": 790440127,
					"content": "Bunun gibi bir duyuru hoparlörü bulun ve talimatları takip ederek rüya sahnesine ulaşın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440128
					],
					"speakerTitle": "Lunapark Duyuru Hoparlörü"
				},
				{
					"id": 790440128,
					"content": "#Hadi {NICKNAME}! Gidip bir duyuru hoparlörü arayalım da şu oyunu deneyelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440115,
					"content": "Oyunculuk alanında yükselişimiz başlıyor mu yoksa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440116
					]
				},
				{
					"id": 790440110,
					"content": "Misafirleri sahneye çıkarıp bir tiyatro oyununda oynatıyorlardır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440111
					]
				}
			]
		},
		{
			"id": 7904406,
			"completionStepIds": [
				7904405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7904405",
							"2"
						],
						"stepId": 7904405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790440601,
					"content": "Vay be! Burada neden bu kadar Su Damlacığı var? Şu dev makinanın etrafına toplanmış ne yapıyorlar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440602,
					"content": "Paimon'un kafası karıştı, bu makina ne işe yarıyor acaba? Bu arada Daiya nerede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440603,
					"content": "Üç Günlük Rüya'ya hoş geldiniz! Gözlerinizin önünde gerçekleşen bu görüntü sizi şaşırtmış olmalı, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440604
					],
					"speakerTitle": "Lunapark Duyuru Hoparlörü"
				},
				{
					"id": 790440604,
					"content": "İzninizle gösterelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440605
					],
					"speakerTitle": "Lunapark Duyuru Hoparlörü"
				},
				{
					"id": 790440605,
					"content": "Haydi Aylak, uyuklamayı bırak! Şimdi, Pozisyon 1, Hareket 2!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440606
					],
					"speakerTitle": "Lunapark Duyuru Hoparlörü"
				},
				{
					"id": 790440606,
					"content": "\"Sevgili gezginler, seyahatleriniz sizi nihayet buraya getirdiği için kadere teşekkür etmeliyiz!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440607
					],
					"speakerTitle": "Lunapark Duyuru Hoparlörü"
				},
				{
					"id": 790440607,
					"content": "O Su Damlacığı... Duyuru hoparlörünü kullanarak kayıt mı oynatıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440608,
					"content": "Çok tanıdık geldi... Paimon bunu nerede duymuştu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440609,
						790440610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440609,
					"content": "Bu, eğlence programına dair duyduğumuz ilk duyurudan bir cümle bu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440611
					]
				},
				{
					"id": 790440611,
					"content": "Dümenci, sıra sende! Pozisyon 3, Hareket 7!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440612
					],
					"speakerTitle": "Lunapark Duyuru Hoparlörü"
				},
				{
					"id": 790440612,
					"content": "\"Yeni katılan mürettebatın karşısına çıkan İkinci Kaptanın kıyafetleri yırtık pırtıktı, vücudunun dört bir yanı sargılarla sarılıydı. Zorlu bir savaştan çıktığı belli oluyordu...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440613
					],
					"speakerTitle": "Hoparlördeki Anlatıcı"
				},
				{
					"id": 790440613,
					"content": "Paimon hatırladı! Bu, \"Kara Sedef ve Korkunç Kraken\"den bir sahne! İkinci Kaptanla tanışmamızdan hemen sonrası!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440614,
					"content": "O zaman duyduğumuz kayıt da böyle çalıyordu... Zamanlaması çok iyi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440615,
					"content": "Patavatsız ile Kara Sedef, hazinenin saklandığı geçide varmak üzere. Acele et, sahneyi ve dekorları hazırla! Yüzüne bulaştırma sakın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440616
					],
					"speakerTitle": "Lunapark Duyuru Hoparlörü"
				},
				{
					"id": 790440616,
					"content": "Şu cihazı... Su Damlacığı mı kontrol ediyormuş? Paimon nasıl oldu da anlayamadı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440617,
						790440618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440617,
					"content": "İzleme, yayın ve mekanizmaların kullanımı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440619
					]
				},
				{
					"id": 790440619,
					"content": "Evet! Bu devasa cihazın işlevi, oyunlardaki tüm mekanizmaların zamanlamasını kontrol etmek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440620
					],
					"speakerTitle": "Lunapark Duyuru Hoparlörü"
				},
				{
					"id": 790440620,
					"content": "Çalışkan Su Tayflarımız da her bir gösterinin ilerlemesini aralıksız takip ediyor. Böylece turistler belirlenen noktalardan birine geldiğinde doğru anlatımı duyuyorlar ve tüm dekorlar ile cihazlar zamanında etkinleştiriliyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440621
					],
					"speakerTitle": "Lunapark Duyuru Hoparlörü"
				},
				{
					"id": 790440621,
					"content": "Misafirler prosedürü takip ettiği sürece, gözlerinizin önünde muhteşem bir \"Üç Günlük Rüya\" oynanıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440622
					],
					"speakerTitle": "Lunapark Duyuru Hoparlörü"
				},
				{
					"id": 790440622,
					"content": "Tabii misafirlerimiz yarıda ayrılırsa veya beklenmedik davranışlar sergilerse gösteriden aldıkları zevk de ona göre etkileniyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440623
					],
					"speakerTitle": "Lunapark Duyuru Hoparlörü"
				},
				{
					"id": 790440623,
					"content": "Şu anda bu tür olaylarla ilgilenebilecek yeterli personelimiz yok... Neyse, tüm misafirlerin kendilerine hakim olacağını düşünüyorum. Haksız mıyım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440624
					],
					"speakerTitle": "Lunapark Duyuru Hoparlörü"
				},
				{
					"id": 790440624,
					"content": "N-Ne kadar güzel! O kadar eğleniyorduk ki sahne arkasında verilen bunca çabanın farkına hiç varmadık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440625,
					"content": "Dikkatle kullanılması gereken o kadar dekor ve mekanizma var ki... Bu gösterileri sorunsuz yönetmek çok zor olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440626,
						790440627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440626,
					"content": "Muazzam bir tasarım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440628
					]
				},
				{
					"id": 790440628,
					"content": "Öyleyse... Şu anda bizimle konuşan Daiya mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440629,
					"content": "\"Üç Günlük Rüya\"yı yönetmek için bu Su Tayflarını mı kullanıyorsun? Neden gelip kendin açıklamadın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440630
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440630,
					"content": "Paimon'un sana sormak istediği bir sürü soru var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440631,
					"content": "Haklısınız, ama dahası var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440632
					],
					"speakerTitle": "Lunapark Duyuru Hoparlörü"
				},
				{
					"id": 790440632,
					"content": "Tüm gördükleriniz, hatta bu Yayın İstasyonunun içindeki her şey... Baş Rejisör, Numaracı Oyun Yazarı, Aylak, Dümenci, Patavatsız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440633
					],
					"speakerTitle": "Lunapark Duyuru Hoparlörü"
				},
				{
					"id": 790440633,
					"content": "Tabii kimsenin görmediği ve duymadığı ama sahne arkasında harıl harıl çalışan Su Tayfları da var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440634
					],
					"speakerTitle": "Lunapark Duyuru Hoparlörü"
				},
				{
					"id": 790440634,
					"content": "İşte \"Daiya\" bu saydıklarımın bir birleşimi. Kendisi bir kişi değil, bütün sistemin ta kendisi. Gösterinin hem yaratıcısı hem yöneticisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440635
					],
					"speakerTitle": "Lunapark Duyuru Hoparlörü"
				},
				{
					"id": 790440635,
					"content": "Yani Daiya aslında... Bir sistem mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440636
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440636,
					"content": "Bir saniye ya. Paimon'un aklı almadı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440637
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440637,
					"content": "Paimon, Su Damlacıklarının zeki olduğunu biliyor fakat bu kadar karmaşık bir... Sistemi... Tek başlarına tasarlayabilirler mi ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440638,
						790440639
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440638,
					"content": "Perdenin ardında bir tasarımcı olmalı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440640
					]
				},
				{
					"id": 790440640,
					"content": "Evet, ilk başlarda dediğiniz gibiydi. Şaşırmanızı anlayabiliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440641
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440641,
					"content": "Özetleyecek olursam Daiya'nın Üç Günlük Rüyası, tutkulu Rejisör Zosimos ile başladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440642
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440642,
					"content": "Rejisör Zosimos, Veluriyam Serabı'ndaki kısa ziyareti sırasında tüm enerjisini heyecan verici oyunlar sahnelemeye ayırdı ve başka hiçbir şeye vakit ayıramadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440643
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440643,
					"content": "Su Tayflarıyla daha fazla vakit geçirdikçe onların zekalarını ve zengin duygularını keşfetti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440644
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440644,
					"content": "Su Tayfları, onun yazdığı oyunları severek izlediler ve hep bir sonraki gösteriyi beklediler. Aldıkları zevki diğer ziyaretçilerle de paylaşmak istediler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440645
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440645,
					"content": "Zosimos'un aklına bir fikir geldi. Su Tayfları bir gösteri yönetebilir, hatta tasarlayabilir miydi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440646
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440646,
					"content": "Ne kadar cesur bir fikir! Bir grup çocuğa öğretmekten farkı yok neredeyse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440647
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440647,
					"content": "Evet, zordu. Neyse ki herkes birlikte çalıştı ve böylece tüm zorlukları aşmayı başardık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440648
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440648,
					"content": "Rejisör Zosimos oyunlarla en çok ilgilenen bazı Su Tayflarını eğitti ve onlara en önemli kavramları öğretti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440649
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440649,
					"content": "Bazı deneme ve yanılmalardan sonra, Zosimos birkaç örnek oyun yazdı ve düşünce biçimini anlatan detaylı açıklamalar ekledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440650
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440650,
					"content": "Idyia'nın da yardımıyla kontrol cihazını ve cihaza bağlı mekanizmaları üretti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440651
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440651,
					"content": "Rejisör Zosimos, oyunlarda geçen repliklere ek olarak insanların konuşurken en sık kullandığı pek çok kelimenin de kaydını aldı. Böylece bu kayıtları bir araya getirerek misafirlerle iletişim kurabilecektik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440652
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440652,
					"content": "Uzun süre alıştırma yaptıktan sonra, nihayet üç örnek oyunu da sorunsuz bir şekilde sahnelemeyi başardık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440653
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440653,
					"content": "Bu üç oyun \"Kara Sedef ve Korkunç Kraken\", \"Taşlaştıran Bakış\" ve \"Gökteki Kalenin Kurtarıcıları\" idi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440654
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440654,
					"content": "Özetlemek gerekirse... Rejisör Zosimos, Daiya'nın Üç Günlük Rüyası için bütün temeli ve altyapıyı hazırladı, üstelik metinleri ve gerekli talimatları da bıraktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440655
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440655,
					"content": "Her şeyi aslında Su Damlacıklarının yönettiğini kesinlikle fark etmedik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440656
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440656,
					"content": "Ne hoş bir iltifat! Emeğimizi takdir etmeniz ve fikirlerimizi doğrulamanız bizi çok sevindirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440657
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440657,
					"content": "Müsaadeniz olursa size minnettarlığımızın bir nişanesini sunmak ve gösterinin prodüksiyonunda olup bitenleri göstermek istiyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440658,
						790440659
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440658,
					"content": "Lafı bile olmaz!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440660
					]
				},
				{
					"id": 790440660,
					"content": "Evet! Çok özel bir eğlence programıydı, ufkumuzu genişletti hatta! Asıl biz size teşekkür etmeliyiz Daiya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440661
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440661,
					"content": "Hahaha! O zaman bir sonraki hedefimize doğru emin adımlarla ilerleyebiliriz... Kendi oyun metinlerimizi yazmak istiyoruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440662
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440662,
					"content": "Bunu başarabilmek için \"oyun\" kavramına dair anlayışımızı geliştirmemiz ve yeni materyaller toplamamız gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440663
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440663,
					"content": "Numaracı Oyun Yazarı ismindeki arkadaşımız, ziyaretçilerden hikayeler topluyor ve fikirlerimizi bu hikayelerle geliştiriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440664
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440664,
					"content": "Numaracı Oyun Yazarı, misafirlerin kendileriyle bizzat tanışamasa da diğer Su Tayflarıyla konuşarak onların tecrübelerini dinliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440665
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440665,
					"content": "Aa! Yani, Numaracı Oyun Yazarına hikayelerimizi anlattığımızda aslında sizin oyun yazmanıza yardımcı olmuş oluyoruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440666
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440666,
					"content": "Aynen öyle! Vaktiniz olursa lütfen Numaracı Oyun Yazarıyla daha sık konuşun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440667
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440667,
					"content": "Ayrıca lütfen Veluriyam Serabı'nda keyfinize bakmaya devam edin. Buradaki Su Tayflarıyla daha fazla konuşmayı da ihmal etmeyin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440668
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440668,
					"content": "#Siz hiç merak etmeyin! Paimon ve {NICKNAME} burayı çok sevdi. Elimizden geldiğince materyal sağlamaya çalışacağız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440669
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440669,
					"content": "Hımm... Aslında bir konu daha var... Paimon uzun süredir merak ediyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440670
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440670,
					"content": "Programın adı neden \"Üç Günlük Rüya\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440671
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440671,
					"content": "Hani acaba... Rejisör Zosimos her oyun üzerinde üç gün mü harcadı? Yoksa toplam üç gün falan mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440672,
						790440673
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440672,
					"content": "Haha, ben bu sorunun cevabını biliyorum!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440674
					]
				},
				{
					"id": 790440674,
					"content": "\"Dün\", \"bugün\" ve \"yarın\" mı? Paimon'a mantıklı geldi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440675
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440675,
					"content": "Diğer bir deyişle Rejisör Zosimos... Yani Daiya'nın tüm üyeleri, bu oyunlar üzerinde her gün çok fazla emek harcıyor anlamında, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440676
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440676,
					"content": "Çok hoş bir düşünce! Ama maalesef asıl anlamı bu kadar derin değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440677
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440677,
					"content": "\"Üç gün\" aslında...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440678
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440678,
					"content": "\"Eh, nasıl olsa vaktim var, yarın bakarım\", \"Belki aradığım ilhamı yarın bulurum\" ve \"Bunu yarın bitirmezsem yandım bittim\" anlamlarını taşıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440679
					],
					"speakerTitle": "Daiya"
				},
				{
					"id": 790440679,
					"content": "Ciddi mi bu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440673,
					"content": "\"Dün\", \"bugün\" ve \"yarın\" anlamında, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440674
					]
				},
				{
					"id": 790440659,
					"content": "Biz çok eğlendik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440660
					]
				},
				{
					"id": 790440639,
					"content": "Metinleri inceleyen biri de olmalı, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440640
					]
				},
				{
					"id": 790440627,
					"content": "Zamanlamanız ve ekip çalışmanız muntazam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440628
					]
				},
				{
					"id": 790440618,
					"content": "Bu özellikler yeter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440619
					]
				},
				{
					"id": 790440610,
					"content": "Bu kaydı oynatıyordu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790440611
					]
				}
			]
		},
		{
