			"dialogs": [
				{
					"id": 790440701,
					"content": "Hımm... Bu gizli kapıyı nasıl daha önce fark etmedik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790440702,
					"content": "Aaa! Paimon biliyor! Anahtar cümleyi bir daha söyleyelim, yeni bir yol açılır o zaman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790440703
					],
					"speakerTitle": "Paimon"
				},
