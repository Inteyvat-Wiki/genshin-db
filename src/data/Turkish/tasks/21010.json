					"nextDialogs": [
						210100003
					]
				},
				{
					"id": 210100003,
					"content": "Ah, yok bir şey. Wangshu Hanının ne kadar uzun bir bina olduğunu düşünüyordum. O kadar merdivenden inmek kaç günümü alır acaba?",
					"roleType": "TALK_ROLE_NPC",
