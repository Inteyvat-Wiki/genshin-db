						210100004
					],
					"speakerTitle": "Dandy"
				},
				{
					"id": 210100004,
					"content": "Gidip bir deneyeyim derken yaprak yığınları planlarımı altüst etti. Hepsini temizleyip aradan çıkarmak istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210100005
					],
					"speakerTitle": "Dandy"
				},
				{
					"id": 210100005,
					"content": "Ancak bu sefer de merdivenlerden basamak basamak inmem gerekecek. Düşüncesi bile yoruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210100006
					],
					"speakerTitle": "Dandy"
				},
				{
