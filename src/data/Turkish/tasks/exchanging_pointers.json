				"points": []
			},
			"dialogs": [
				{
					"id": 191079801,
					"content": "Harika bir iş çıkarmışsın, aynen böyle devam et. Diona'yı kesinlikle buraya barmen olarak almalıyız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079802
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 191079802,
					"content": "Umarım işe yarar. Bu fırsat için haftalardır burada bekliyordum... Bu şansı kesinlikle kaçırmamalıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079803
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 191079803,
					"content": "Bu sefer cidden kendini aştın Connor. Diona'yı burada çalışmaya ikna edebilirsek, yaptıklarımız boşa gitmez. Bu sadece ilk adım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079804
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 191079804,
					"content": "Unutma, Diona samimiyetimizi ve tutkumuzu hissetmeli! Ha bu arada unutma, abartmamaya çalış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079805
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 191079805,
					"content": "Sorun değil. Tekrar tekrar provasını yaptık zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079806
					],
					"speakerTitle": "Connor"
				},
				{
					"id": 191079806,
					"content": "Siz neden bahsediyorsunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191079807
					]
				},
				{
					"id": 191079807,
					"content": "Biz mi? Şey, hehe... Hiç. Biz sadece, ıı... Şaraphaneyle ilgili işlerden bahsediyorduk, evet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191079808
					],
					"speakerTitle": "Elzer"
				},
				{
					"id": 191079808,
					"content": "Evet, iş konuşuyorduk. Şaraphanenin bakım masraflarının üzerinden bir daha geçelim, olur mu Elzer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Connor"
				}
			]
		},
