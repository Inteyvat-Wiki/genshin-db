			"dialogs": [
				{
					"id": 711630301,
					"content": "Neler oluyor? Buraya nasıl geldik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630302,
					"content": "Eee, sizin için yaptığım küçük hediyeyi nasıl buldunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630303
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630303,
					"content": "Demek buradaydın Zibai! Bu şemsiye de ne böyle? Birden \"vınn\" diye bir ses çıkardı ve bizi buraya ışınladı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630304,
					"content": "Görünüşe göre bir şeyleri hatırlamakta zorlanan tek kişi ben değilmişim. Daha önce benimle binmiştiniz, unuttun mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630305
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630305,
					"content": "Bu hafızanı tazeledi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630306
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630306,
					"content": "Aa! Bu... Ayın savaş arabası! Demek ki o yüzden tanıdık gelmiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630307,
					"content": "Haha, bu sadece anılarımdan yarattığım bir replika aslında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630308
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630308,
					"content": "Bana geri verdiğiniz kırık yeşim nişan sayesinde yaptım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630309
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630309,
					"content": "Ha! Yapmayı planladığın küçük araç buymuş o zaman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630310,
					"content": "Aynen öyle. Bu yeşim nişanlı savaş arabası gitmeyi dilediğiniz her yere sizi hızla taşıyabilir. Bu da seyahatlerinizin daha sorunsuz geçmesine yardımcı olacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630311
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630311,
					"content": "Lütfen hediyemi kabul edin sadık rehberlerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630312
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630312,
					"content": "Vay canına, harika... Paimon o \"araç yapma\" laflarını sırf kibarlık olsun diye söylediğini sanmıştı. Gerçekten yapmanı hiç beklemiyordu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630313,
					"content": "Başlangıçta bunun çok uzun süreceğini düşünmüştüm. Zira yeşim nişan çok hasar görmüştü ve ruhsal enerjisi tamamen yok olmuştu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630314
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630314,
					"content": "Ama neyse ki burası Chenyu Vadisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630315
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630315,
					"content": "Hı? Buranın nesi bu kadar özel ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630316,
					"content": "Vadinin tam olarak neresinde olduğumuzu biliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630317
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630317,
					"content": "Hım... Yilong Rıhtımı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630318,
					"content": "Hehe, burası hakkında öğrenecek çok şeyin var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630319
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630319,
					"content": "Ayaklarımızın altındaki zemin aslında Liyue'nin Ley Hatlarındaki en önemli kesişim noktalarından biridir. Bunun gibi toplam sekiz düğüm var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630320
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630320,
					"content": "Yaşam, Ölüm, İstirahat, İnziva, Başlatım, Arazi, Korku ve Yara.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630321
					]
				},
				{
					"id": 711630321,
					"content": "Burayı beklediğimden daha iyi biliyorsun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630322
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630322,
					"content": "Aa! Paimon şimdi hatırladı. Sekiz kapıdan bahsediyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630323,
					"content": "Doğru. Şu anda durduğumuz yer, o kapıların en uğurlusu olan Yaşam Kapısının merkezi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630324
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630324,
					"content": "Yaşam Kapısı büyümeyi, refahı ve canlanmayı simgeler. Bu sayede yeşim nişanın ruhsal enerjisini çabucak yenileyip bu savaş arabasını üretebildim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630325
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630325,
					"content": "Vay be, ne kadar da güçlü bir yermiş! Chenyu Vadisi gerçekten mucizelerle dolu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630326,
					"content": "Öyle... Burada huzur ve refah içinde bir hayat kursanız ne iyi olur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630327
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630327,
					"content": "Hı? \"Kursanız\" derken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711630328,
					"content": "Yok bir şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630329
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630329,
					"content": "Pekala, dilediğim her şeyi yaptım. Artık kendi işinize bakabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630330
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630330,
					"content": "Ben de dağın tepesinde gezeceğim biraz. Yollarımız burada ayrılıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630331
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630331,
					"content": "Teşekkürler Zibai.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630332
					]
				},
				{
					"id": 711630332,
					"content": "Teşekkür etmene gerek yok. Beni uykumdan uyandırdın, asıl ben sana borçluyum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630333
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630333,
					"content": "Aslında her şey Zhongli'nin başının altından çıktı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630334
					]
				},
				{
					"id": 711630334,
					"content": "Ona da sana dediklerimin aynısını söyledim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630335
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630335,
					"content": "Senin uzun bir yolculukta olduğundan bahsetti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630336
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630336,
					"content": "Bir sonraki durağınız uzaklardaki kar diyarı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630337
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630337,
					"content": "Evet, Snezhnaya'ya gidiyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630338
					]
				},
				{
					"id": 711630338,
					"content": "Snezhnaya... Hımm, orası hakkında hiçbir şey bilmesem de buz ve karda yolculuk yapmak daima tehlikelidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630339
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630339,
					"content": "Eğer yardıma ihtiyacınız olursa beni nerede bulacağınızı biliyorsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711630340
					],
					"speakerTitle": "Zibai"
				},
				{
					"id": 711630340,
					"content": "Biliyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711630341
					]
				},
				{
					"id": 711630341,
					"content": "Kendinize iyi bakın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zibai"
				}
			]
		}
	]
}