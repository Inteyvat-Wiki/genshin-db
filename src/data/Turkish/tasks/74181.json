			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Melo Lombroso",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741810101,
					"content": "Burada ne yapıyorsun Madam Melo?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810102,
					"content": "Aa, siz de buradaymışsınız. Hiçbir işe yaramaz kocamın burada bir yerde yeri varmış, ben de gelip onu bir göreyim dedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810103
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810103,
					"content": "Ama bak ne buldum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810104
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810104,
					"content": "Fotoğrafı gerçekten yanından ayırmıyormuş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810105
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810105,
					"content": "Heh, Rocher Amca seni gerçekten umursuyor Madam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810106,
					"content": "Aslında senden şüpheleniyorduk ama Rocher Amca şüphemizin yerinde olmadığını söyledi. Bu suçu işlemediğine bizi tek başına ikna etti. Bize karşı çıkacak cesareti nereden buldu diye merak ediyorduk ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810107,
					"content": "Galiba bunun için içindeki tüm erkekliği kullanmış.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741810108
					]
				},
				{
					"id": 741810108,
					"content": "Of... Gerçekten mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810109
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810109,
					"content": "Evet! Hem sana kolyeni kumarda kaybettiğini söylemedi mi? Bu da doğru değil. Gerçeği söylemekten çok utandığı için sana yalan söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810110,
					"content": "Aa, onu mu diyorsun? Bunu bana çok uzun zaman önce söylemişti ama dediklerine zaten hiç inanmamıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810111
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810111,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810112,
					"content": "Kocam sıradan birisi değildir. Biraz çekingen, korkak ve tuhaf olabilir ama oldukça güvenilir birisidir. Kandırıldığına inanırım ama hayatsız bir kumarbaz olduğuna asla inanmam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810113
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810113,
					"content": "Gerçeği kendi rızasıyla söylemesini istediğimden onu herhangi bir şekilde zorlamadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810114
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810114,
					"content": "Vay be, ne kadar iyi birisiymişsin. Keşke şimdi onu bulabilsek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810115,
					"content": "(Şşş... Oraya bak! O kutunun içinde saklandığından eminim.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810116
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810116,
					"content": "(... Hı?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810117,
					"content": "(Eskiden beri böyledir. Ne zaman tartışsak hemen en yakınındaki dolabın içine saklanır. Bir de bunu hâlâ bilmediğimi sanıyor.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810118
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810118,
					"content": "(Onu senin için yakalamamızı ister misin?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741810119
					]
				},
				{
					"id": 741810119,
					"content": "(Zahmet etmenize gerek yok. Bakalım içeride ne kadar dayanabilecek.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810120
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810120,
					"content": "Doğru ya, bana yardım edebileceğiniz bir şey daha var. Eğri veya Ajan Talochard ile tekrar karşılaşırsanız onlara şunu söyleyin:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810121
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810121,
					"content": "Odaların birkaçını topladım, o yüzden istedikleri zaman bana gelebilirler. Tabii, Lombroso Evi'nin kapısı her zaman size de açık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810122
					],
					"speakerTitle": "Melo Lombroso"
				},
				{
					"id": 741810122,
					"content": "#Ama... {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810123,
					"content": "Tamam, anlaşıldı Madam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741810124
					]
				},
				{
					"id": 741810124,
					"content": "Peki... Seni rahat bırakıyoruz o halde. Paimon, Rocher Amca'nın yakında olduğu yerden çıkmasını umuyor. Size iyi günler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741810125,
					"content": "Teşekkür ederim. Size de iyi günler. Umarım tüm sorularınızın cevabını bulursunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Melo Lombroso"
				}
			]
		},
