			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240150601,
					"content": "*nefes nefese* Teşekkürler... Gerçekten çok teşekkür ederim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150602
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150602,
					"content": "Gerçekten, burada resim yapıyordum sadece sonra ne olduğunu anlayamadan etrafımı sardılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150603
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150603,
					"content": "Resmime öyle bir saldırdılar ki sanki onu yemek istiyorlarmış gibiydi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150604
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150604,
					"content": "Ama tabii resmimi onlara bırakamazdım, ben de tuvali aldığım gibi oradan kaçtım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150605
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150605,
					"content": "Sonra beni çok geçmeden yakaladılar ama Hükümdarlara şükürler olsun siz gelip beni kurtardınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150606,
						240150607
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150606,
					"content": "Resimle ilgili bir sorun mu var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150608
					]
				},
				{
					"id": 240150608,
					"content": "Biliyorsam ne olayım! Ben boya yapmak için hep Yalancı Çiçek Nektarı kullanırım. Hani şu benim için topladıklarınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150609
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150609,
					"content": "Bir saniye... Ya boya onları çekiyorsa? Ama hayır, öyle değildir çünkü nektarı boyaya karıştırdıktan sonra kokusu kalmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150610
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150610,
					"content": "Hali hazırda kullanırken boyanın formülünü de değiştirmeye cesaret edemiyorum. Sanırım başka bir yol bulmamız gerekecek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150611
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150611,
					"content": "*öksürür* Ben de Yalancı Çiçeğin bile resmimdeki güzelliği anlayabileceğini düşünüp gelip bir bakmak istemiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240150607,
					"content": "Ne yaptın ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150608
					]
				}
			]
		}
	]
}