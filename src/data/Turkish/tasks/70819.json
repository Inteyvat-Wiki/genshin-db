			"dialogs": [
				{
					"id": 708190201,
					"content": "Ah... Nezaketin için teşekkür ederim. Fakat Favonius Kilisesinden bir rahibe olarak böyle hediyeleri kabul edemem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708190202
					],
					"speakerTitle": "Hannelore"
				},
				{
					"id": 708190202,
					"content": "Deniz rüzgarıyla süzülüp gelen bu kokuyu biraz olsun içime çekmek benim için yeterli. Güzel şeyler tek bir kişiye değil, rüzgara aittir. İnançla yürüyenlerin yolu budur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708190203
					],
					"speakerTitle": "Hannelore"
				},
				{
					"id": 708190203,
					"content": "Yine de güney esintisi kadar sıcak olan nezaketin bana ulaştı. Lütfen karşılığında bu kitabı küçük bir hediye olarak kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708190204
					],
					"speakerTitle": "Hannelore"
				},
				{
					"id": 708190204,
					"content": "Rüzgar Hükümdarı seni korusun. Yolun tıpkı bu koku gibi erdem, özgürlük ve şefkatle dolsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hannelore"
				}
			]
