			"dialogs": [
				{
					"id": 733280201,
					"content": "İşte sana kucak dolusu bir sarılma! Görüşürüz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280202,
						733280206
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280202,
					"content": "Tekrar nerede buluşacağız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280203
					]
				},
				{
					"id": 733280203,
					"content": "Kim bilir? Belki Kutsal Diyar'da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280204
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280204,
					"content": "Hahahaha! Şaka yapıyordum! Ama benimle orada görüşmek istersen kesinlikle orada olacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280205
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280205,
					"content": "Bana nedenini sorma, biliyorum, hepsi bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280208
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280208,
					"content": "Neyse, görüşürüz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeht"
				},
				{
					"id": 733280206,
					"content": "Ben de sana kucak dolusu sarılayım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733280207
					]
				},
				{
					"id": 733280207,
					"content": "Haha, teşekkür ederim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733280208
					],
					"speakerTitle": "Jeht"
				}
			]
		}
