			"dialogs": [
				{
					"id": 737140101,
					"content": "Hehe, sırada Paimon'un çok dikkatli bir planlama sonucunda belirlediği özel bir rota var! Biraz yürüyeceğiz ama...",
					"roleType": "TALK_ROLE_NPC",
