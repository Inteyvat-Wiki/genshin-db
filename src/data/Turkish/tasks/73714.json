				},
				{
					"id": 737140102,
					"content": "İlk durak, çöldeki vaha! Sonra Mawtiyima Ormanı'ndan geçeceğiz ve oradan da Bayda Limanı'na geri döneceğiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737140103
					],
					"speakerTitle": "Paimon"
				},
				{
