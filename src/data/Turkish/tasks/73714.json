					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737140104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737140104,
					"content": "İyi ki bu sefer acele etmemiz gerekmiyor. Paimon ağırdan alıp her anın tadını çıkarmamızı öneriyor!",
					"roleType": "TALK_ROLE_NPC",
