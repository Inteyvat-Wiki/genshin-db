			"dialogs": [
				{
					"id": 710750101,
					"content": "Hey sen! Evet, sen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750102
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750102,
					"content": "Senin gibi buraları bilen birisi Erge salağının bulamadığı şeyi bulabilir bence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750103
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750103,
					"content": "Bulamaz mısın? O zaman ben de bulabilecek birini bekleyi bulmalarını sağlayıp onlardan alırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750104
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750104,
					"content": "Bana Qingceli Çocuk derler ve hiçbir Kanyon madencisi beni durduramaz. Yoluma çıkan olursa bir daha asla yüzümü göremezsiniz. Ee hadi, versene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750105
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750105,
					"content": "Taşordu hazinesini biz alalım, teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750106,
						710750107
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750106,
					"content": "Ne aradığını bilmiyorum ama...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710750108
					]
				},
				{
					"id": 710750108,
					"content": "Sen ne dersen o galiba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750109
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750109,
					"content": "... Hımm. O kadar koşturmadan sonra biraz daha çetin biri olursun sanmıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750110
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750110,
					"content": "Sana bir seçenek sunayım. Ya bana Koruyucu Miğferi şimdi verirsin ya da seni yere serdikten sonra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750111
					],
					"speakerTitle": "???"
				},
				{
					"id": 710750111,
					"content": "... Benimle dövüşmek istemezsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710750112
					]
				},
				{
					"id": 710750112,
					"content": "Büyük konuşana da bak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750113
					],
					"speakerTitle": "???"
				},
				{
