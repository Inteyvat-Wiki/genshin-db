			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430801,
					"content": "\"Bazıları Akademinin Akaşa'yı fazla zorladığını düşünebilir ama bence yeteri kadar zorlamıyor. Çoğu Mahamata yeterince üretken değil, hatta bazı açılardan eskilerden bile daha yetersizler.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430802
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732430802,
					"content": "\"Akaşa üzerinden iş dağılımı yapabildiğimizi ve Takas Noktasında yapılan işleri Akaşa'nın yönettiğini bir düşünsenize...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430803
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732430803,
					"content": "\"Bu şekilde Mahamataların en az yarısını görevden alabiliriz.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430804
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732430804,
					"content": "\"Doğru diyorsun. Belki de bu yüzden yapmıyoruzdur.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mesaj Panosu"
				}
			]
		},
		{
			"id": 7324309,
			"completionStepIds": [
				7324309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324309",
							"2"
						],
						"stepId": 7324309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430901,
					"content": "\"Hepimiz, araştırmacıların işinin sonsuz bilgiye ulaşmak olduğunu biliyoruz fakat ne yazık ki şu anki Akademinin tek derdi idarecilik.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430902
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732430902,
					"content": "\"Şu anda birçok öğrenci, eğitimlerini tamamladıktan sonra araştırmalarını bırakmaya zorlanıp farklı yerlere Mahamata olarak atanıyor. Bu durum Akademinin amacıyla çelişmiyor mu sizce de?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430903
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732430903,
					"content": "\"Akaşa'da bu konuda bir sonuca çoktan varılmamış mıydı zaten?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430904
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732430904,
					"content": "\"Millet kendini batıl inançlara kaptırmış gidiyor, hakikate en yakın olanlar ise yine bizleriz. Dünyayı aydınlatma görevinden nasıl vazgeçebiliriz? Bundan vazgeçersek, Sumeru kaosa sürüklenir!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mesaj Panosu"
				}
			]
		},
		{
			"id": 7324310,
			"completionStepIds": [
				7324310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324310",
							"2"
						],
						"stepId": 7324310,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431001,
					"content": "\"Yurt dışında okuyan bir öğrenci olarak, Akademide geçirdiğim her gün Mahadevi Rukkhadevata'nın yüceliğini daha iyi anlıyorum.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431002
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732431002,
					"content": "\"Mondstadt'tayken, çok basit bir soruya dair farklı teoriler bulmak için bile onlarca kitabı karıştırmak gerekiyordu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431003
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732431003,
					"content": "\"Oysaki Akaşa Terminali sayesinde, merak ettiğin bir bilgiyi almak için tek yapman gereken şey düşünmek. Dünyada bundan daha iyi bir şey yok doğrusu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mesaj Panosu"
				}
			]
		},
		{
			"id": 7324311,
			"completionStepIds": [
				7324311
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324311",
							"2"
						],
						"stepId": 7324311,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431101,
					"content": "\"Akademi, Pir Kavikavus döneminden beri Kshahrewar için ayırdığı yıllık bütçesini hiç artırmadı.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431102
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732431102,
					"content": "\"Yukarıdakiler daha sakin ve huzurlu bir toplum için makinaların ve teknolojik gelişmelerin sıkı bir kontrol altında tutulması gerektiğini söyleyip duruyorlar. Madem öyle, Akaşa'yı kapatalım gitsin!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431103
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732431103,
					"content": "\"Lord Sangemah Bay gibi akıllı bir iş insanı Kshahrewar için uzun vadeli fon sağlamamış olsaydı, şu an Kshahrewar'ın yerinde yeller eserdi!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mesaj Panosu"
				}
			]
		},
		{
			"id": 7324312,
			"completionStepIds": [
				7324312
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324312",
							"2"
						],
						"stepId": 7324312,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431201,
					"content": "\"Bilgelerin ve akıl hocalarımızın yargısına güveniyorum fakat yine de Akademi, Akaşa'ya fazla bel bağlıyor sanki.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431202
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732431202,
					"content": "\"Akaşa'yı kullanmaya alıştığımızdan beri, dışarıya gönderdiğimiz gezgin bilgelerin sayısı azaldı. Bence yeni öğrencilerin Akaşa'ya erişimlerini kısıtlamalıyız.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431203
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732431203,
					"content": "\"Bunu nasıl dersin? Çölde Akaşa'sız yaşayan tarikatların, bilgelik kazanmak için zehirli yılanları çiğ çiğ yediklerini duymadın mı hiç?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431204
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732431204,
					"content": "\"Edindiğimiz bilgilerin saflığını Mahadevi Rukkhadevata dışında yalnızca Akaşa sağlayabilir.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mesaj Panosu"
				}
			]
		},
		{
			"id": 7324313,
			"completionStepIds": [
				7324313
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324313",
							"2"
						],
						"stepId": 7324313,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431301,
					"content": "Bu haftanın botanik semineri, Orman Gözcüsü Tighnari'nin sunumuyla her zamanki gibi Pardis Dhyai'de düzenlenecek. İlgilenen herkes kayıt yaptırabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431302
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732431302,
					"content": "Kim olduğunuz fark etmez, botanikle ilgilenen herkes gelebilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431303
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732431303,
					"content": "Üzülerek belirmek isteriz ki seminere çok fazla kişi kayıt yaptırdığı için katılım Akademi tarafından Amu{RUBY#[S]Biyoloji}rta öğrencileri ve gözcülerle sınırlandırmıştır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mesaj Panosu"
				}
			]
		},
		{
			"id": 7324314,
			"completionStepIds": [
				7324314
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324314",
							"2"
						],
						"stepId": 7324314,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431401,
					"content": "\"Aranızda Yae Yayınevinin çıkardığı son romanı okuyan var mı? Sumerulu bir yazar yazmış, ismi Pursina mı neydi... Amurta'dan olduğu o kadar belli ki.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431402
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732431402,
					"content": "\"Amurta'ya girebilseydim... Hem tüm gün manzarayı izlerdim hem de hikaye yazmaya vaktim olurdu. Onun yerine kendimi Haravatat'ta buldum. Burada kafamı kaldırıp dışarı bakamıyorum bile, hayatım araştırma yapıp makale yazmaktan ibaret.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431403
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732431403,
					"content": "\"Ne? Yae Yayınevi, benden önce başka birisinin kitabını mı yayınlamış yani? Bu, bir resimli roman uzmanı olarak güvenilirliğimi sarsacak bir durum...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mesaj Panosu"
				}
			]
		},
		{
			"id": 7324315,
			"completionStepIds": [
				7324315
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324315",
							"2"
						],
						"stepId": 7324315,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431501,
					"content": "\"Gerçek hayatta işler ders kitaplarında yazdığı gibi işlemiyor... Keşke Kapalı Çarşı'da kalsaydım.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431502
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732431502,
					"content": "\"Artık makale yazamıyorum. Param da kalmadı zaten.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431503
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732431503,
					"content": "\"Böyle giderse okulu bırakıp Münzevilere katılsam daha iyi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mesaj Panosu"
				}
			]
		},
		{
			"id": 7324316,
			"completionStepIds": [
				7324316
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324316",
							"2"
						],
						"stepId": 7324316,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431601,
					"content": "\"Çölden gelenlere karşı bir sempatim olduğundan değil tabii ama bence General Mahamatra tanınmış bir araştırmacı olmalı. Özellikle de yumruklarla çözülemeyen akademik meseleler konusunda.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431602
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732431602,
					"content": "\"Yine de işler siz Rtawahist'tekilerin yürüttüğü dönemden daha iyi. En azından kimse taraf tutmuyor. Yıllık yayın oranlarının ardında yatan gerçek hikayeleri cidden kimsenin bilmediğini mi sanıyorsunuz?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431603
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732431603,
					"content": "\"Dinle beni, seni Kshahrewarcı! Kanıtın varsa iyi edersin, yoksa bu meseleyi Matrayla konuşacağız!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mesaj Panosu"
				}
			]
		},
		{
			"id": 7324317,
			"completionStepIds": [
				7324317
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324317",
							"2"
						],
						"stepId": 7324317,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431701,
					"content": "\"Yabancı üyelerin kabul edilmesine katlanabilirim fakat onlara Akaşa'ya erişim izni vermek apayrı bir konu...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431702
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732431702,
					"content": "\"Yabancı akılların Akaşa üzerindeki etkilerini geçtim, dışarı aktarılan bilgiler Sumeru ticaretine ne kadar zarar verecek kim bilir...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431703
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732431703,
					"content": "\"Araştırmacılar ekonomi hakkında endişeleniyor muymuş? İlk defa duyuyorum.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431704
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732431704,
					"content": "\"İşte bu yüzden siz Haravatat'takilere züppe diyorlar. Daha iyi bir boya türü yaratmak istemesem hayatta burada olmazdım!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mesaj Panosu"
				}
			]
		},
		{
			"id": 7324318,
			"completionStepIds": [
				7324318
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324318",
							"2"
						],
						"stepId": 7324318,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431801,
					"content": "\"O çöl cücesini de bayağıdır ortalıkta görmüyorum... Artık biraz rahatlayabiliriz herhalde.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431802
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732431802,
					"content": "\"Disiplin üyeleri neden bu dönem değerlendirmeden geçmemi engelledi acaba?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431803
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732431803,
					"content": "\"Değerlendirmeyi geçmek için orada bulunman bile yeterli, yeterince çalışmadığın için başkalarını suçlama. Matrada yeterince personel yok diye böyle şeyler söyleyemezsin.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431804
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732431804,
					"content": "\"Matra, yetkileriyle hava atan hiyerarşik bir düzenden ibarettir. Bir dakika, Akaşa'dan mesaj geldi...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431805
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732431805,
					"content": "\"Belli ki dikkatli olmak lazımmış.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mesaj Panosu"
				}
			]
		},
		{
			"id": 7324319,
			"completionStepIds": [
				7324319
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
