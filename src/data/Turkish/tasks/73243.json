					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430501,
					"content": "\"Bu mesaj panosu henüz Akaşa Erişiminin bir parçası değil ve panoya sistem olmadan da erişilebilir.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430502
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732430502,
					"content": "\"Akademik alanlar dışındaki yerlere bildiri asmak kesinlikle yasaktır. Bunu unutmamanızı rica ederiz.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mesaj Panosu"
				}
			]
		},
		{
			"id": 7324306,
			"completionStepIds": [
				7324306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324306",
							"2"
						],
						"stepId": 7324306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430601,
					"content": "\"Ufak bir hatırlatma yapmak isteriz. Lütfen kampüs dışında da Akademinin nezaket ve görgü kurallarını gözetin.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430602
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732430602,
					"content": "\"Bilginin tek merkezden yönetildiği bu sistem, 'Bilginin Toprakları' için olmazsa olmazdır. Kasıtsızca yapılan hatalar yüzünden Akademide eğitim görme şansınızı tehlikeye atmayın.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mesaj Panosu"
				}
			]
		},
		{
			"id": 7324307,
			"completionStepIds": [
				7324307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324307",
							"2"
						],
						"stepId": 7324307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430701,
					"content": "\"Son günlerde birden fazla Konserve Bilgi kaçakçılığı vakası tespit edildi. Soruşturmanın ardından, ilgili öğretilerin hocaları ve öğrencilerine bir sonraki Jnagarbha Gününden önce Akaşa üzerinden detaylı bilgi verilecektir.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430702
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732430702,
					"content": "\"Makale yazmanın öğrencilerde neden olduğu zihinsel stresi azaltmak ve olası suçları önlemek için hocaların öğrencilerle iletişimlerini artırması önemle rica olunur.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mesaj Panosu"
				}
			]
		},
