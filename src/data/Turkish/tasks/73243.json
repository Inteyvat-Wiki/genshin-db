			"dialogs": [
				{
					"id": 732432401,
					"content": "\"Bu ilan panosu yalnızca Akademi içindeki duyurular içindir. Yanlış bilgi yaymak ve yasa dışı bilgiler vermek kesinlikle yasaktır.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432402
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732432402,
					"content": "\"Matra herkese, araştırmacıların uyması gereken davranış kurallarını hatırlatmaya devam edecektir!\"",
