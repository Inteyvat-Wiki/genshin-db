			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732432201,
					"content": "\"Bilgelerin ve akıl hocalarımızın yargısına güveniyorum fakat yine de Akademi, Akaşa'ya fazla bel bağlıyor sanki.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432202
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732432202,
					"content": "\"Akaşa'yı kullanmaya alıştığımızdan beri dışarıya gönderdiğimiz gezgin bilgelerin performansı azaldı. Bence yeni öğrencilerin Akaşa'ya erişimlerini kısıtlamalıyız.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432203
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732432203,
					"content": "\"Bunu nasıl dersin? Çölde Akaşa'sız yaşayan tarikatların, bilgelik kazanmak için zehirli yılanları çiğ çiğ yediklerini duymadın mı hiç?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432204
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732432204,
					"content": "\"İnsanlar, yalnızca Akaşa'nın bilgilerin saflığını koruduğunu anlamıyorlar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mesaj Panosu"
				}
			]
		},
