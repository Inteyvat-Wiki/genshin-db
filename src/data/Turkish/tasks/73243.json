			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430101,
					"content": "Tüm Akademi bildirileri ve yönetici duyuruları Akaşa'ya taşındı. Bu mesaj panosu ise eğitmenler ve öğrenciler arasındaki iletişim için tahsis edilmiştir. Dışarıdan kimselerin yorum yapmasına izin verilmemektedir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mesaj Panosu"
				}
			]
		},
		{
			"id": 7324302,
			"completionStepIds": [
				7324302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324302",
							"2"
						],
						"stepId": 7324302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430201,
					"content": "\"Daha rahat bir akademi ortamı, daha iyi bilgi alışverişi! Makalelerinizi artık gülümseyerek yazacaksınız!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430202
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732430202,
					"content": "\"Yüce Koruyucu adayı olarak Vikram'ı destekliyoruz!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430203
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732430203,
					"content": "\"Herkesi Vikram'ın Dostları grubuna katılmaya davet ediyoruz. Genç, cana yakın ve eğlenceli bir Yüce Koruyucunun yükselişine gelin beraber şahit olalım!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mesaj Panosu"
				}
			]
		},
		{
			"id": 7324303,
			"completionStepIds": [
				7324303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324303",
							"2"
						],
						"stepId": 7324303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430301,
					"content": "\"Akademinin üç erdemini ve altı günahını sakın unutmayın.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430302
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732430302,
					"content": "\"Nasihat, Marifet ve Uygulama... Bunlar tüm araştırmacıların benimsemesi gereken erdemlerdir.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430303
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732430303,
					"content": "\"Rifaet de onlarca yıldır bu üç erdemi ifa etmektedir.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430304
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732430304,
					"content": "\"'Fravashi Kitap Okuma Topluluğu' sizleri bilgeliğin ışığında yürümeye ve gelecek Yüce Koruyucuyu seçmeye çağırıyor.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mesaj Panosu"
				}
			]
		},
		{
			"id": 7324304,
			"completionStepIds": [
				7324304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324304",
							"2"
						],
						"stepId": 7324304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732430401,
					"content": "\"Erdem arayışında olan tüm üyelerimize selam olsun.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430402
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732430402,
					"content": "\"Duyduğuma göre Rifaet makalelerinin yarısından fazlasını başkalarına yazdırmış.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430403
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732430403,
					"content": "\"Demek ki o yüzden bu kadar başarılı olmasına rağmen gösteriş yapmaktan kaçınıyordu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430404
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732430404,
					"content": "\"Mesaj panosuna yazılan mesajlar için kanıt gerekmiyor olabilir, sonuçta makale yazmıyoruz. Yine de bu panoyu kişisel saldırılar için kullanmasanız keşke.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430405
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732430405,
					"content": "\"Bu yorumlar hep kıskançlıktan yapılıyor!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430406
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732430406,
					"content": "\"Ben de duydum ki Vikram tatlı diliyle birçok kızın gönlünü kazanmış.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430407
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732430407,
					"content": "\"Onun evli olduğunu bilmiyorlar ki. Yoksa onun bu kadar popüler olmasını kıskanıyor musun sen?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732430408
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732430408,
					"content": "\"Akademi araştırmacılarına asılsız iddialarla dil uzatmak yasaktır. Dedikodu yaymaya devam eden kişiler Matraya teslim edilecektir.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mesaj Panosu"
				}
			]
		},
		{
			"id": 7324305,
			"completionStepIds": [
				7324305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7324305",
