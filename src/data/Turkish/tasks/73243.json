			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732432001,
					"content": "\"Büyük bilge Tabari'nin Yıldız Güncesini inceleyince sonunda ne olduğunu anladım. İster tanrıların savaşı olsun, ister kadim imparatorlukların düşüşü... Bunların hepsi göksel hareketlerin oluşturduğu küçük evrenler aslında.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432002
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732432002,
					"content": "\"Ebedi olan tek şey tepemizdeki yıldızlı gökyüzüdür.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432003
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732432003,
					"content": "\"Şey, duygusallığı bir kenara bırakırsak... Siz Rtawahist araştırmacıları tüm kadim olayları bir mi tutuyorsunuz gerçekten?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432004
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732432004,
					"content": "\"Yıldızları seyredip hayallere dalmak yerine olayları tarihi açıdan inceleyebilsen keşke.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432005
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732432005,
					"content": "\"Sen ne anlarsın ki? Buna evrenin kanunlarını keşfetmek denir! Vahumana'dakilerin kitaplardan başını kaldıramamasına şaşmamalı!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mesaj Panosu"
				}
			]
		},
