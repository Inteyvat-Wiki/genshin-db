			},
			"dialogs": [
				{
					"id": 732432101,
					"content": "\"Yurt dışında okuyan bir öğrenci olarak, Akademide geçirdiğim her gün Doğa Hükümdarı'nın yüceliğini daha iyi anlıyorum.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432102
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732432102,
					"content": "\"Mondstadt'tayken, çok basit bir soruya dair farklı teoriler bulmak için bile onlarca kitabı karıştırmak gerekiyordu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732432103
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732432103,
					"content": "\"Oysaki Akaşa Terminali sayesinde, merak ettiğin bir bilgiyi almak için tek yapman gereken şey düşünmek. Dünyada bundan daha iyi bir şey yok doğrusu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mesaj Panosu"
				}
			]
		},
		{
