			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732431901,
					"content": "\"Zandik soruşturmasıyla ilgili... Dastur... Ölüm nedeni... Muhtemelen cinayet...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431902
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732431902,
					"content": "\"Zandik... listeden çıkarıldıktan sonra... Eleazar'la ilgili... ama yeterli kanıt yok...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431903
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732431903,
					"content": "\"Kayıtlar birden ortadan yok oldu... Yılı bilinmiyor... Eleazar salgını başladı...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431904
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732431904,
					"content": "\"Yok olmadan önce... Varuna efsanesi... takıntılı...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732431905
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732431905,
					"content": "(Devamında yazanlar anlaşılmaması için tamamen okunmaz hale getirilmiştir.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mesaj Panosu"
				}
			]
		},
		{
			"id": 7324320,
			"completionStepIds": [
				7324320
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
