			"dialogs": [
				{
					"id": 722040301,
					"content": "*iç çeker* Her şey netliğini kaybediyor... Daha da sisli bir hale bürünüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040302,
						722040303
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040302,
					"content": "Merhaba?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040304
					]
				},
				{
					"id": 722040304,
					"content": "*iç çeker* Hafızam gün geçtikçe kötüleşiyor. Sanırım yaşlanmaya başladım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040305
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040305,
					"content": "Ama ne yapmalıyım? Kito ve Kina aç mı ya da dışarıda oynarken güvende mi bilmiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040306,
						722040307
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040306,
					"content": "Bir şey olmaz onlara.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040308
					]
				},
				{
					"id": 722040308,
					"content": "Kito, Kina! Buradasınız! Yolda düştünüz mü? Bir şeye takıldınız mı? Yine gidip ağaçlara tırmanmadınız değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040309
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040309,
					"content": "Yaşlı Ninenizi nasıl da endişelendirdiniz! *iç çeker* Son zamanlarda ne oldu bilmiyorum ama sanki adadaki kişi sayısı gitgide azalıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040310
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040310,
					"content": "Ve ben de artık çoğunu hatırlamıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040311
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040311,
					"content": "*iç çeker* İkinizi unutsam ne yaparım ben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040312
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040312,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040313
					]
				},
				{
					"id": 722040313,
					"content": "*iç çeker* Bu çiçek yapraklarını alın. Nine sizi unutursa bunları bana verin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040314
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040314,
					"content": "Daha size anlatmak istediğim bir sürü hikaye var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Una"
				},
				{
					"id": 722040307,
					"content": "Yardım edebileceğimiz bir konu var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040308
					]
				},
				{
					"id": 722040303,
					"content": "Bir şey mi oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040304
					]
				}
			]
		},
