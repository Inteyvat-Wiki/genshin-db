					"Una"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722040701,
					"content": "Merhaba, merhaba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040702
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040702,
					"content": "Kusura bakmayın ama yaşlandıkça hafızam bulanıyor. Kim olduğunuzu sorabilir miyim? Hiç tanıştık mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040703,
						722040704
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040703,
					"content": "#Ben {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040705
					]
				},
				{
					"id": 722040705,
					"content": "Daha önce hiç böyle bir isim duymadım. Yabancı mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040706
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040706,
					"content": "Oldukça tuhaf. Büyük Yıldırım Kuşu varken bu kıyıya varamaman gerekirdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040707,
						722040708
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040707,
					"content": "Yıldırım Kuşu artık yok...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040709
					]
				},
				{
					"id": 722040709,
					"content": "*iç çeker* Sana bakınca aklıma zavallı kocam geliyor. Artık yüzünü bile hatırlamıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040710
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040710,
					"content": "O zamanlar gençtik ve aklımızda bir sürü çılgınca şey vardı... Ama bazı insanlar hiç büyümüyor. Birlikte çok fazla zaman geçirseniz bile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040711
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040711,
					"content": "Beni bırakıp kendisine tahtadan bir sal yaptı ve yabancıların yaşadığı yerlere yelken açmaya çalıştı. Özgürce avlanıp daha önce görmediği çiçekler toplamak istediğini söyledi... Güzel çiçekler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040712
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040712,
					"content": "Genç zamanlarımızdan beri bunu söylerdi ama o hiç büyümedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040713
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040713,
					"content": "Sonra rahibin çocuğu onu buldu... Öylece sahilde yatıyormuş, kabuklar kadar sessiz ve kumlardan daha beyaz... Elinde de çiçekleri sımsıkı tutmuş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040714
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040714,
					"content": "Rahip ağlayıp atalarımızın sandalının onu reddettiğini söyledi. Artık ruhu hep yabancıların topraklarında dolaşacaktı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040715
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040715,
					"content": "O zamanlar çocuğumuz yeni doğmuştu... Bunu ona nasıl söyleyecektim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040716
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040716,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040717
					]
				},
				{
					"id": 722040717,
					"content": "Sonrasında çocuğumun da çocukları oldu ve ben burada kalırken çocuğumu gümüş sandala bindirdim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040718
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040718,
					"content": "Buraya olan tek bağım ve endişem ise... Kito ve Kina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Una"
				},
				{
					"id": 722040708,
					"content": "Bunu açıklamamız gerekebilir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040709
					]
				},
				{
					"id": 722040704,
					"content": "#Bana {NICKNAME} diyebilirsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040705
					]
				}
			]
		},
