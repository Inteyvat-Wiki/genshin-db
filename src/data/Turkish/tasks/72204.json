				{
					"id": 722040401,
					"content": "Ama şimdi değil. Şimdi gidin de oynayın, Nine burada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040402
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040402,
					"content": "Çiçek yaprakları, çiçek yaprakları, neydi sizin büyüdüğünüz toprakların adı?",
					"roleType": "TALK_ROLE_NPC",
