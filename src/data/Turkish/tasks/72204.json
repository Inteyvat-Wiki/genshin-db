					"nextDialogs": [
						722040907
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040907,
					"content": "\"Göçüp gitmek\" mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040908
					]
				},
				{
					"id": 722040908,
					"content": "Son zamanlarda sandalcı beni çok sık görmeye geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040909
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040909,
					"content": "Her seferinde altın kürkten kıyafetleriyle, altından uzun pantolonuyla ve kafasında altın ipekten yapılma tacıyla sessiz bir şekilde geliyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040910
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040910,
					"content": "Tıpkı annemin söylediği ve benim de Kito'yla Kina'ya söylediğim gibi... Bizi gümüş sandalına almaya geliyor, bizi gümüş sandalına alacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040911
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040911,
					"content": "Sandal, parlayan nehirden rüyalar diyarına doğru yelken açacak. Orada sis olmayacak ve yetmiş beşik üstüne yetmiş beşik daha olan altından bir salonda her biri ileri geri sallanacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040912
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040912,
					"content": "Orada uyuyup ışık tanelerine dönüşeceğiz... Sonra da bu dünyanın çocuklarının rüyaları haline geleceğiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040913,
						722040914
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040913,
					"content": "Vay...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040915
					]
				},
				{
					"id": 722040915,
					"content": "Sandalcı bunları Kito ve Kina'dan bana getirdiğini söyledi. Ah o çocuklar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040916
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040916,
					"content": "Henüz zamanı değil... Zaman henüz gelmedi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Una"
				},
				{
					"id": 722040914,
					"content": "Yani demek istediğin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040915
