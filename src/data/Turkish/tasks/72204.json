			},
			"dialogs": [
				{
					"id": 722040501,
					"content": "Abe mi o? Evindeki mantarlar nasıl? Haha... Sakın bir daha rahibi rahatsız etme. Kaç defa sorarsa sorsun kabul etmeyeceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040502
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040502,
					"content": "Haha! Yani üzgünüm ama evle kendim ilgilenmekle meşgulüm. Çok üzgünüm, hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040503
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040503,
					"content": "Üzgünüm... *iç çeker* Üzgünüm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040504,
						722040505
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040504,
					"content": "Merhaba Nine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040506
					]
				},
				{
					"id": 722040506,
					"content": "Sen! Çabuk bizi utandırmadan içeri gel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040507,
						722040508
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040507,
					"content": "Ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040509
					]
				},
				{
					"id": 722040509,
					"content": "Balıkçılık nasıl gitti? Hiçbir şey çıkmadı demek... Boş ver canım. Bahçede yetişenler bize yeter. Yıldırım Kuşu'na adayacak kadar yok ama... Ha? Ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040510
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040510,
					"content": "Ne diyorsun sen? Bu yılki seremoni iyi geçti! Sonraki yıl da iyi geçecek. Rahip sağlıklı bir çocuğumuz olacağını bile söyledi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040511
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040511,
					"content": "Şimdi neden bundan bahsediyorsun ki? Kama Klanına ne olduğunu unuttun mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040512,
						722040513
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040512,
