			"trigger": {
				"objectNames": [
					"Una"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722040101,
					"content": "Kito, Kina, dönmüşsünüz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040102
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040102,
					"content": "Artık etrafta koşuşturup durmayın. Bu yaşlı bacaklar ikinizin hızına yetişemiyor! Hem başınız belaya girerse ne yapacağız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040103,
						722040104
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040103,
					"content": "Selamlar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040105
					]
				},
				{
					"id": 722040105,
					"content": "Ne? Siz çocuklar yaşlı bir kadına nasıl böyle bir şey söylersiniz? Kalbimi kıracaksınız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040106
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040106,
					"content": "Hazır buradayken tekrar gitmeyin olur mu? Nineye biraz eşlik edin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040107,
						722040108
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040107,
					"content": "Bak, üzgünüm ama...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040109
					]
				},
				{
					"id": 722040109,
					"content": "Şimdi hikayenin neresinde kalmıştık? Tamam, hatırladım... Büyük babanın büyük babasının genç olduğu zamanlardı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040110
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040110,
					"content": "Sis Denizi'nin ötesinde, yabancıların olduğu bir adada Sumari Klanı yaşardı. Bu klanın başında tilki görünümlü bir kadın olduğu söylenirdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040111
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040111,
					"content": "Bu topraklarda yıldırım rengi çiçekler yetişirmiş ve Sumariler dağların ve ovaların arasında evler kurup uyum içinde yaşarmış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040112
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040112,
					"content": "Sonrasında... Çiçekleri... *horlar*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040113
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040113,
					"content": "*horlar* Evet, Sis Denizi'nin dışında...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040114,
						722040115
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040114,
					"content": "Nine, iyi misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040116
					]
				},
				{
					"id": 722040116,
					"content": "Kito? Kina? Gidiyor musunuz? *iç çeker* Üzgünüm, yine uyuyakalmışım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040117
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040117,
					"content": "Gitmeden önce bunları almayı unutmayın... Ninen bunları sizin için saklıyordu. Sis Denizi'nin uzaklarından gelme çiçekler. Sakın bunları kaybetmeyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Una"
				},
				{
					"id": 722040115,
					"content": "(En iyisi rahatsız etmeyelim...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040116
					]
				},
				{
					"id": 722040108,
					"content": "Pekala...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040109
					]
				},
				{
					"id": 722040104,
					"content": "Bizi biriyle karıştırmış olabilirsin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040105
					]
				}
			]
		},
