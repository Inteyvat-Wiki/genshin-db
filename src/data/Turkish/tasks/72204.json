						722040514
					]
				},
				{
					"id": 722040514,
					"content": "Büyük Yıldırım Kuşu'nu terk edip kızgın dalgalar tarafından yutulmak istiyorsan keyfine bak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040515
					],
					"speakerTitle": "Una"
				},
				{
					"id": 722040515,
					"content": "Bebeğim... Ah benim zavallı bebeğim... *iç çeker*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Una"
				},
				{
					"id": 722040513,
					"content": "\"Kama\" mı?",
					"roleType": "TALK_ROLE_PLAYER",
