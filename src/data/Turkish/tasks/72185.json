					"nextDialogs": [
						721850308,
						721850310
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850308,
					"content": "Hallederim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721850309
					]
				},
				{
					"id": 721850309,
					"content": "O zaman sana güveniyorum. Tek bir kalıp Peynir yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850310,
					"content": "Cidden dükkanda Peynir kullanmıyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721850311
					]
				},
				{
					"id": 721850311,
					"content": "Hiç kullanmıyor değiliz de, epey nadir kullanıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850312
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850312,
					"content": "Sonuçta dükkanda Peynir gerektiren pek fazla yemek yok o yüzden biz de stoklamıyoruz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850313
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850313,
					"content": "Her neyse, sana güveniyorum Gezgin. Lütfen bana bir kalıp Peynir getir.",
