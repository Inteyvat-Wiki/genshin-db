					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850302,
					"content": "Nasıl gitti? Hiç geri bildirim aldın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850303
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850303,
					"content": "Müşterilerin geri bildirimi hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721850304
					]
				},
				{
					"id": 721850304,
					"content": "Orijinal Mantarlı Pizza... Denemeye değer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850305
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850305,
					"content": "Hazırlanacak malzemeler Peynir, Lahana ve Mantar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850306
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850306,
					"content": "Diğer malzemeler elimde var ama genelde çok Peynir bulundurmayız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721850307
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721850307,
					"content": "Gezgin, rica etsem bana bir kalıp peynir getirir misin?",
