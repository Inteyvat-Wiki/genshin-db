			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Asakura"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728040406,
					"content": "Sakinliğine bakılırsa o Kairagi grubu seni hiç zorlamamış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040407
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040407,
					"content": "Sen de kazanmışsın sanırım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040408
					]
				},
				{
					"id": 728040408,
					"content": "Aynen öyle. Beni kandırarak bir mızrak darbesiyle kurtulmayı başardı, bunu söylerken bile utanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040409
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040409,
					"content": "Yine de yarası çok derindi. Birkaç yıl boyunca kötü işlere bulaşabileceğini düşünmüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040410
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040410,
					"content": "Daha da önemlisi, onu tek başıma yendim ve silahımı geri aldım. Artık o utançtan kurtuldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040411
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040411,
					"content": "Tebrikler Asakura.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040412
					]
				},
				{
					"id": 728040412,
					"content": "Sana minnettarım tabii ki. Fakat henüz işim bitmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040413
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040413,
					"content": "Olanların tek sebebi yeteri kadar çalışmamamdı. Çok çalışmaya devam edip yeteneklerimi geliştireceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040414
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040414,
					"content": "Bunun için ileride benimle antrenman yapmanı isteyeceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040415
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040415,
					"content": "Ha, evet. Lütfen bunu teşekkür olarak kabul et. Çok bir şey değil ama senin olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040416
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040416,
					"content": "Tekrar sağ ol!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				}
			]
		}
	]
}