					"Asakura"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728040206,
					"content": "Ah! Lütfen merhamet et! Böyle birini nereden buldun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040207
					],
					"speakerTitle": "\"Kairagi\""
				},
				{
					"id": 728040207,
					"content": "Pis hain! Hemen silahımı ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040208
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040208,
					"content": "Hâlâ onu mu düşünüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040209
					],
					"speakerTitle": "\"Kairagi\""
				},
				{
					"id": 728040209,
					"content": "Sadece silahımı almaya geldim. Nerede olduğunu söylersen seni bağışlarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040210
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040210,
					"content": "Bu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040211,
						728040212
					],
					"speakerTitle": "\"Kairagi\""
				},
				{
					"id": 728040211,
					"content": "Onun için nefesini boşa tüketme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040213
					]
				},
				{
					"id": 728040213,
					"content": "Hayır, lütfen! Ne olur durun! Asla söylemem demedim! Bu kadar şiddet göstermenize gerek yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040214
					],
					"speakerTitle": "\"Kairagi\""
				},
				{
					"id": 728040214,
					"content": "Pa-Patronumuz o silahı koleksiyonuna aldı. İstiyorsan şuradaki kampa gidip alabilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040215
					],
					"speakerTitle": "\"Kairagi\""
				},
				{
					"id": 728040215,
					"content": "Sonunda mantıklı bir şeyler söyledin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040216
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040216,
					"content": "Lü-Lütfen. Söyledim işte size...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040217
					],
					"speakerTitle": "\"Kairagi\""
				},
				{
					"id": 728040217,
					"content": "Defol buradan!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040218
					]
				},
				{
					"id": 728040218,
					"content": "Derhal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040219
					],
					"speakerTitle": "\"Kairagi\""
				},
				{
					"id": 728040219,
					"content": "Dövüşmekte pek yetenekli değil ama hızlı koşuyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040220
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040220,
					"content": "Arkadaşlarını da çabuk sattı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040221
					]
				},
				{
					"id": 728040221,
					"content": "Kairagi aslında kendi çıkarları için toplanmış rastgele insanlardan oluşan bir grup. Onlar için sadakat de inanç da önemli değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040222
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040222,
					"content": "Tehlikenin yaklaştığını görür görmez kaçıyorlar. Hep böyleler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040223
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040223,
					"content": "Neyse ki yardım ettin. Sen olmasan bu kadar kolay pes ederler miydi bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040224
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040224,
					"content": "Neyse. Şimdi ana üslerine gidiyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040225
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040225,
					"content": "İlk stratejimizi kullanacağız. Ben liderleriyle savaşırken sen de diğerleriyle ilgileneceksin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040226,
						728040227
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040226,
					"content": "Hallederim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040228
					]
				},
				{
					"id": 728040228,
					"content": "Teşekkür ederim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040227,
					"content": "Aynı anda on tanesiyle bile dövüşürüm. Sorun değil!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040228
					]
				},
				{
					"id": 728040212,
					"content": "Hadi, başkasını bulalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040213
					]
				}
			]
		},
		{
			"id": 7280403,
			"completionStepIds": [
				7280405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
