			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"\"Kairagi\" Lideri"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728040301,
					"content": "Yine mi sen? Sen şu geçen seferki velet misin? Ne oldu? Yine koleksiyonuma bir şeyler eklemeye mi geldin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040302
					],
					"speakerTitle": "\"Kairagi\" Lideri"
				},
				{
					"id": 728040302,
					"content": "Hayır. Silahımı almaya geldim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040303
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040303,
					"content": "En azından cesurmuşsun. Yanında sadece bir kişi mi getirdin? Beni zayıf biri sanıyorsun herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040304
					],
					"speakerTitle": "\"Kairagi\" Lideri"
				},
				{
					"id": 728040304,
					"content": "Bak ne diyeceğim. Cesaretin için sana bir şans vereceğim. Hadi! Bu işi başka yerde halledelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040305
					],
					"speakerTitle": "\"Kairagi\" Lideri"
				},
				{
					"id": 728040305,
					"content": "Tabii... Bizim çocukları burada yalnız bırakmak olmaz değil mi? Buldum! Şu minik yardımcın burada kalsın da oynasınlar olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040306,
						728040307
					],
					"speakerTitle": "\"Kairagi\" Lideri"
				},
				{
					"id": 728040306,
					"content": "Hazır olduklarında başlayalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040308
					]
				},
				{
					"id": 728040308,
					"content": "Hahaha. Amma da arsızmışsın! Hadi çocuklar. Duydunuz. Gösterin bakalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040309
					],
					"speakerTitle": "\"Kairagi\" Lideri"
				},
				{
					"id": 728040309,
					"content": "Sana gelince... Hadi şuraya gidelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040310
					],
					"speakerTitle": "\"Kairagi\" Lideri"
				},
				{
					"id": 728040310,
					"content": "Bunları sana bırakıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040311
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040311,
					"content": "Hallederim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040312
					]
				},
				{
					"id": 728040312,
					"content": "Çok teşekkür ederim. Hemen şunu öldürüp sana yardıma geleceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728040313
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 728040313,
					"content": "Sen de çok gevezeymişsin. Dene de gör!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Kairagi\" Lideri"
				},
				{
					"id": 728040307,
					"content": "Umarım ellerinden geleni yaparlar da çok sıkılmam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728040308
					]
				}
			]
		},
		{
			"id": 7280404,
			"completionStepIds": [
				7280407
			],
