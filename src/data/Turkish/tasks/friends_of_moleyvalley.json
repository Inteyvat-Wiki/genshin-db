			"dialogs": [
				{
					"id": 760240101,
					"content": "Yolun sonuna geldin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240102,
					"content": "Büyük Patron Hırsız Gelinciği ilk kez bu kadar yakından görüyorum... Senin de ona Büyük Patron demen lazım Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240115
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240115,
					"content": "Ne... Paimon bir Hırsız Gelinciğe asla \"Patron\" falan demez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240118,
					"content": "Haklısın. Yaramaz çocuklar patron olamaz, değil mi? Ayrıca kimse cenazelerine katılmaz... Cenaze düzenlenirse tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240132
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240132,
					"content": "Aa, doğru ya! Helka, Hırsız Gelincik eti gibi garip etler yiyen tuhaf insanlardan bahsetmişti daha önce. Bir de numune toplamayı sevenler varmış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240133
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240133,
					"content": "İster yesinler ister toplasınlar, her türlü sonrasında cenaze töreni gerekmeyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240134
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240134,
					"content": "Ayy, Auni... Bütün bu korkutucu şeyleri nasıl istifini bozmadan söyleyebiliyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240135,
					"content": "(Bu çok korkmuş görünüyor...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240136
					],
					"speakerTitle": "Büyük Patron Hırsız Gelincik"
				},
				{
					"id": 760240136,
					"content": "Dur! Sakın kaçmaya kalkma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240137,
					"content": "Hı? Kaçmıyor... Bizi mi bekliyor ki? Gidip ne olduğuna bakalım madem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
