				{
					"id": 760240803,
					"content": "Sen de mi katılmak istiyorsun? Öyleyse, Jurva'ya sorman gerekecek. \"Speranza\"da şu an. Ama oylama yapılacaksa sıkıntı olabilir, Helka burada değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240804
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240804,
					"content": "Ama sorun yok. Eminim Jurva bir çaresini bulur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240805,
					"content": "İz Sürücü Köstebekler hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240806
					]
				},
				{
					"id": 760240806,
					"content": "Sanırım insanlarla uzun süre yan yana yaşadıkça onların alışkanlıklarını kopyalamaya başladılar. Hırsız Gelincikler de aynısını yapıyor, hatta duyduğuma göre Natlan'daki Sürüngenler de öyleymiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240807
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240807,
					"content": "Bu iyi bir şey mi, kötü bir şey mi bilemiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240808,
					"content": "Görüşürüz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240809
					]
				},
				{
					"id": 760240809,
					"content": "İyi yolculuklar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Auni"
				}
			]
		},
