			"dialogs": [
				{
					"id": 760240501,
					"content": "Ne olduğundan emin değilsin ama küçük kızın yanına gidiyorsun...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760240502
					]
				},
				{
					"id": 760240502,
					"content": "Hırsız Gelinciklere dikkat et. Bir süredir Kösbik Vadisi'ni mesken tuttular. Sizi yakalarlarsa siz de gölgesiz insanlara dönüşürsünüz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240503
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240503,
					"content": "Hırsız Gelincikler mi? Neredeler? Ayrıca, \"gölgesiz insan\" ne demek?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240504,
					"content": "Ay! Bu makinanın nesi var? Hırsız Gelincikler bize saldırmak için mi kullanıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240505,
					"content": "Bunlar insanlar tarafından yetiştirilenler. Hatta insanlardan daha zeki bile olabilirler. Tüm koca oğlanları böyle kaçırdılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240506
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240506,
					"content": "Koca oğlanlar bunu daha önce denediklerinde başarısız oldular ama <color=#00E1FFFF>enerji çekirdeğini alman</color> yeterli olacaktır. Henüz başarabilen olmadı, o yüzden muhtemelen çok kolay olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240507
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240507,
					"content": "#Hımm, enerji çekirdeğini alırsak Hırsız Gelincikleri durdurabileceğiz yani. Hadi {NICKNAME}, bir deneyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240508,
					"content": "Ortalıkta küçük bir çocuk koşuştururken böyle tehlikeli bir durumu görmezden gelemeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240509,
					"content": "Yeter ki sen iste ulu Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240510
					]
				},
				{
					"id": 760240510,
					"content": "Sen burada kal ve saklan, tamam mı küçük hanım? Adın neydi bu arada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240511,
					"content": "Hı? Buradaki \"en küçük\" hanım sen değil misin? Anlamadım... Neyse, ben Auni. Ayrıca bana \"abla\" demelisin en küçük hanım. Doğru olan bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240512
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240512,
					"content": "#Şey... Şimdilik hitap şeklini bir kenara bırakalım. Hadi {NICKNAME}, şu Hırsız Gelincikleri hizaya getirelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
