			"dialogs": [
				{
					"id": 760240601,
					"content": "Sanırım Büyük Patron Hırsız Gelincikler, koca oğlanları taklit edip Kösbik ailesine ayak işlerini yaptırmaya çalışıyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240602
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240602,
					"content": "Koca oğlanlar gibi onlar da istediklerini elde edemediler herhalde. Gelincikler Kösbik Vadisi'ni talan etti, Kösbik ailesi bir yerlerde saklanıyordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240603,
						760240605
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240603,
					"content": "Köstebeklerden çok bir şey beklememek lazım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240604
					]
				},
				{
					"id": 760240604,
					"content": "Evet, alt tarafı İz Sürücü Köstebekler sonuçta... Hem zaten Hırsız Gelinciklerin aşırı tehlikeli silahları var! Böyle silahlara erişimlerinin olması bile başlı başına saçmalık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240607,
					"content": "Kösbik Vadisi yeniden Kösbik Dede ve ailesine ait. Anlaştığımız gibi, işte Moranız. Yardımınız için teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240608
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240608,
					"content": "Ha, unutmadan... Bunu da size vereyim bari. Helka kitapçığında kurguya yer verilmemesi gerektiğini söyledi. Yoksa gerçeği yalandan ayırt etmek zorlaşırmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240609
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240609,
					"content": "Bence pek önemi yok... Sahte şeylerde bile gerçeklik payı olur, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240610
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240610,
					"content": "#Neyse, görüşürüz {NICKNAME} ve Küçük Hanım Paimon. Eğer Büyük Patron Hırsız Gelincikler yine ortalığı karıştırmaya kalkarsa sizi bulurum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240611
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240611,
					"content": "#Hehe, şanımız yürüyor {NICKNAME}! Yine de Paimon gelinciklerin tekrar yaramazlık yapmamasını umuyor. Kendine iyi bak Auni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240612,
					"content": "Merak etmeyin. İyi yolculuklar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240605,
					"content": "Yani bunun için de insanlara güveniyorlarmış.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240606
					]
				},
				{
					"id": 760240606,
					"content": "Eh, alt tarafı İz Sürücü Köstebeklerle uğraşıyoruz sonuçta... Ayrıca Hırsız Gelinciklerin tehlikeli makinalara ulaşmasının başlıca sebebi insanlar. Başka insanların yarattığı karmaşayı insanların çözmesini en doğrusu olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240607
					],
					"speakerTitle": "Paimon"
				}
			]
		},
