			},
			"dialogs": [
				{
					"id": 760240401,
					"content": "Paimon tüm Hırsız Gelinciklerin şu ilerideki küçük tepeye doğru kaçtığını fark etti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240402,
					"content": "Evet, bu Hırsız Gelincikleri eğiten koca oğlanlar yüzünden oldu. Büyük Patron Hırsız Gelincik bunu kullanarak koca oğlanları patakladı. Aşağı yuvarlandılar, sonra da bir güzel süründüler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240403,
						760240404
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240403,
					"content": "Hayal etmesi zor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240406
					]
				},
				{
					"id": 760240406,
					"content": "#Neyse, gidip tepeyi araştıralım. {NICKNAME}, gözünü açık tut. Hırsız Gelincikler pusu kurabilir. Paimon yuvarlanmak ya da sürünmek istemiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240404,
					"content": "Keşke orada olsaydım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240405
					]
				},
				{
					"id": 760240405,
					"content": "Yardım eder miydin ki? Sadece ortalık karışsın istiyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240406
					],
					"speakerTitle": "Paimon"
				}
			]
		},
