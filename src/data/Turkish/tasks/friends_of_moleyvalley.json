			"dialogs": [
				{
					"id": 760241501,
					"content": "Aa, bakın. Kösbik ailesinin tamamı burada. Kösbik Dede, Baba ve Anne, Minik Kösbik, Mini Mini Kösbik ve diğerleri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241502
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760241502,
					"content": "Aa, İz Sürücü Köstebek miymiş onlar? Nasıl ayırt ediyorsun ki? Paimon'a hepsi aynı görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241503,
					"content": "Kişiliklerinden tabii ki! Onları tanıdıkça anlarsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241504
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760241504,
					"content": "Ama hepsinin insanlardan bir şeyler dilenmek gibi kötü bir alışkanlığı var. *iç çeker* Zavallı yaratıklar. Biz yok olursak ne yapacaklar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241505
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760241505,
					"content": "... İnsanların soyu mu tükenecek? İz Sürücü Köstebekler buna rağmen hayatta mı kalacak? Bu nasıl mümkün olabilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241506,
					"content": "Linnea Abla birçok nedenden dolayı hayvanların neslinin tükenebileceğini söylüyor. Bu da insanların neslinin de tükenebileceği anlamına gelir. Bunu nasıl bilmezsin Küçük Hanım Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241507,
						760241509
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760241507,
					"content": "En azından İz Sürücü Köstebeklerden daha uzun yaşayacağımı düşünmek istiyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760241508
					]
				},
				{
					"id": 760241508,
					"content": "Ama bu Auni'nin sorusunu yanıtlamıyor, değil mi? Hımm... Gerçekten de insanlar için tehdit oluşturan çok fazla unsur var. Bu korkutucu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241512,
					"content": "Neyse, konuya dönelim. Köstebeklerimizi bulduk, peki şimdi bu Hırsız Gelincikleri ne yapacağız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241513,
					"content": "Daha iyi bir fikri olan yoksa onları Sancak Gemisi'ne teslim edebiliriz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241514
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760241514,
					"content": "Hazine! Yoksa bu durumda rüşvet mi oluyor? Aman, ne fark eder. Madem veriyorlar, biz de kabul ederiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241515,
					"content": "#En azından pişman görünüyorlar. Bu sefer onları affedelim {NICKNAME}! Bize hazine verdiler diye değil tabii ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760241509,
					"content": "Böceklerin insanlardan önce var olduğu söylenir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760241510
					]
				},
				{
					"id": 760241510,
					"content": "Muhtemelen biz yok olduktan sonra da var olmaya devam edecekler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760241511
					]
				},
				{
					"id": 760241511,
					"content": "Bekle, yani insanlar böceklere mi yenilecek? Of, bu düşünce Paimon'u çok rahatsız etti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760241512
					],
					"speakerTitle": "Paimon"
				}
			]
