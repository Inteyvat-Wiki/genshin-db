					}
				]
			},
			"dialogs": [
				{
					"id": 760240201,
					"content": "#O koca oğlanlardan çok daha kuvvetliydin {NICKNAME}! Demek ki bu işler boya bakmıyormuş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240202
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240202,
					"content": "#Hehe, değil mi? {NICKNAME} çok uzun olmasa da kendisinden on kat büyük canavarlara taş çıkarır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240203,
						760240205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240203,
					"content": "Kendimce bir şeyler yapıyorum işte. Asıl uzman Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240204
					]
				},
				{
					"id": 760240204,
					"content": "Ne? Yağcılık yaparak bir şey kazanacağını sanıyorsan... Ş-Şey... Belki bir dahaki sefere güzel bir şey yediğimizde Paimon'un payının yarısını alabilirsin, olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240206,
					"content": "#O zaman Büyük Patron Hırsız Gelinciği Kösbik Vadisi'nden kovabilirsin, değil mi {NICKNAME}? Burası onların evi olmamasına rağmen sürekli ortalığı birbirine katıyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240207
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240207,
					"content": "Yapılması gereken cenazeler yapılamıyor. Üstelik Kösbik Dede de onlar yüzünden öldürülmüş olabilir. Ama yeni cenazeler düzenleyeceksek önce hepsini bulmamız gerekecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240208
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240208,
					"content": "Hı? Gelincik Hırsızları böyle bir şeyi gerçekten yapmış mıdır? Ayrıca Paimon bir şey soracak... Az önce cenazelerden bahsediyordun, cidden burada cenaze mi yapılıyor? Öyleyse neden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240209,
					"content": "Tabii ki. Tüm hazırlıkları ben yaptım, söylenecek şarkıları da seçtim hatta. İstersen bakabilirsin ama lütfen sessiz ol. Bırak huzur içinde dinlensin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240210
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240210,
					"content": "Auni cebinden küçük bir kibrit kutusu çıkarıp açar. İçinde, çiçekli bir kumaşın üzerinde güzel renkli bir böcek duruyor. Birkaç beyaz taç yaprak sahneyi süslüyor...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760240211
					]
				},
				{
					"id": 760240211,
					"content": "Sonsuz uykusuna daldı, bu yüzden ona bir cenaze töreni düzenlememiz gerekiyor. Ama seçtiğim yerlerin hepsi makinaların olduğu küçük tepeler ve hepsi Hırsız Gelincikler tarafından işgal edilmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240212
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240212,
					"content": "Kösbik Dede'nin ailesi şimdiye kadar kaçmadıysa bile muhtemelen ölmüşlerdir. Hırsız Gelincikler evlerini yerle bir etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240213
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240213,
					"content": "#({NICKNAME}, bahsettiği bu \"Kösbik Dede\" gerçekten de...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240214,
						760240216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240214,
					"content": "(Bir tür küçük hayvan sanırım.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240215
					]
				},
				{
					"id": 760240215,
					"content": "(Evet, Paimon da öyle düşünüyor. Muhtemelen onun hayvan arkadaşlarından biridir.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240218,
					"content": "Hımm. Bu yaramaz Hırsız Gelincikleri yakalamana yardım etmemizi ister misin? Kösbik Dede'nin ailesine gelince... Hırsızları adalete teslim ettikten sonra arayabiliriz onları. Nasıl fikir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240219,
					"content": "Hımm. Çok naziksiniz. Sizi kesinlikle cenaze törenine davet edeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240220
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240220,
					"content": "Şey, bunu yapmana hiç gerek yok aslında...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240221,
					"content": "Tamam. O zaman aldığım şeker heykelciği vereyim size... Hım. Görünüşe göre hepsi bitmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240222
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240222,
					"content": "Neyse, Jurva'nın bana verdiği harçlık hâlâ duruyor. Alın sizin olsun, kendinize şeker heykelcik alabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240223
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240223,
					"content": "İnsanlardan yardım istediğinde, onlara borcunu ödemek ve teşekkür etmek gerekir. Doğrusu budur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240224,
						760240226
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240224,
					"content": "Çok fenasın Paimon. Çocukların minik ellerinden şekerlemelerini almanı beklemezdim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240225
					]
				},
				{
					"id": 760240225,
					"content": "Bir dakika! Neden Paimon'u kötü biri gibi gösteriyorsun ki şimdi? Neyse, küçük bir çocuğa göre çok kibarsın Auni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240227,
					"content": "Sağ olun! Ama ikiniz için de birer Şeker Heykelciğe yetecek kadar Mora veriyorum. Bana yağ çekmeniz fazladan bir şey kazandırmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240228
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240228,
					"content": "İlkelerinden de taviz vermiyorsun... Birden fazla kurnaz Hırsız Gelincik ile karşı karşıyayız, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240229,
					"content": "Evet, doğru. Az önce kaçan Hırsız Gelincik, daha önce gördüğüm Büyük Patron Hırsız Gelincikten farklıydı. Kaç tane kardeşi olduğunu hiç bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240230
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240230,
					"content": "Ama bu mermi atan robot pençelerinden orada da var, bu yüzden orada da daha fazla Hırsız Gelincik bulabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240231
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 760240231,
					"content": "Tamam. Bu sefer Hırsız Gelinciklerin kaçmasına izin vermeyeceğiz. Onlara iyi bir ders verelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240226,
					"content": "Gerçekten takdire şayan bir görgü anlayışın var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240227
					]
				},
				{
					"id": 760240216,
					"content": "(Burada eskiden yaşayan biri olabilir.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240217
					]
				},
				{
					"id": 760240217,
					"content": "(Hı? Ama burası kimsenin uzun süre yaşadığı bir yer gibi durmuyor... Muhtemelen hayvan arkadaşlarından biridir! Ne de olsa böcekler için bile cenaze töreni yapıyor.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760240218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760240205,
					"content": "Küçük canavarlara da acımam!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760240206
					]
				}
			]
		},
