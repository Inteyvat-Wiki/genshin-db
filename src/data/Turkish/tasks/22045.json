			"dialogs": [
				{
					"id": 220450301,
					"content": "Hım, ne yapıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450302
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220450302,
					"content": "Fotoğraf çekiyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450303
					]
				},
				{
					"id": 220450303,
					"content": "Peki ya onlar ne? Çok garipsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450304
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220450304,
					"content": "Neyse. İşine devam et ama tapınağın altını üstüne getirme yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
