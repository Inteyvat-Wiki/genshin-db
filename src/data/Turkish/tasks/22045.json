			"trigger": {
				"objectNames": [
					"Ooshima Junpei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220450101,
					"content": "Bu işte hâlâ bir yanlışlık var gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450102
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450102,
					"content": "Sorun ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450103
					]
				},
				{
					"id": 220450103,
					"content": "Ah, selam Gezgin! Ben de seni arıyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450104
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450104,
					"content": "Son zamanlarda yaptığım kütük oymalarının çok... cansız olduğunu düşünmeye başladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450105,
						220450107
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450105,
					"content": "Kütükten yapıyorsun da ondan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450106
					]
				},
				{
					"id": 220450106,
					"content": "Yani öyle demek istemedim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450108
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450108,
					"content": "Hımm, bunu nasıl açıklasam ki? Şöyle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450109
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450109,
					"content": "Gördüğün gibi geçici başrahibemiz genelde uyur fakat zaman zaman uyanıp etrafta dolanır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450110
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450110,
					"content": "Etrafta dolanırken hoplar, zıplar, yere düşen yaprakların üzerinden falan geçer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450111
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450111,
					"content": "O anları yakalamak istiyorum. Yaptığı hareketleri oymalarıma geçirmek istiyorum. \"Canlılıktan\" kastım bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450112,
						220450113
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450112,
					"content": "O zaman git ve onu incele...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450114
					]
				},
				{
					"id": 220450114,
					"content": "Ama ben... Biraz utanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450115
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450115,
					"content": "Ne olursa olsun sonuçta o benim patronum. Yanına çöküp hareketlerini izlemeye kalkarsam onu mutsuz edebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450116
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450116,
					"content": "Diğer yandan sizin ilişkiniz çok daha iyi olmalı. Bu nedenle bana referans olması için onun fotoğraflarını çekebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450117,
						220450118
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450117,
					"content": "Tamam, tamam, hallederim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450121
					]
				},
				{
					"id": 220450121,
					"content": "Tamam, teşekkür ederim Gezgin. İşin bittiğinde lütfen bana fotoğrafları getir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450118,
					"content": "İstediğin anları tam olarak yakalayabileceğime dair söz veremem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450119
					]
				},
				{
					"id": 220450119,
					"content": "Sorun değil. O büyük anları yakalamasan da olur. Zaten oymacılık yeteneğimin şu anda yeterli olduğundan emin değilim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450120
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450120,
					"content": "Birkaç hareketini yakalasan yeter. En azından şimdilik iş görür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450121
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220450113,
					"content": "İşte bak orada...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450114
					]
				},
				{
					"id": 220450107,
					"content": "Sanatına nasıl bir \"canlılık\" katmak istiyorsun ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450108
					]
				}
			]
		},
