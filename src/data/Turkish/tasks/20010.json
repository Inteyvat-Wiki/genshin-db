					"nextDialogs": [
						200100703
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200100703,
					"content": "Doğru ya! Unutmadan, şu dağ yabanisinin verdiği hediyeyi al lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100704
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200100704,
					"content": "Bir dağ yabanisinden bir hediye... Bugünleri göreceğini sanmıyordun, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100705
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200100705,
					"content": "Neyse ben gideyim artık. Not etmem gereken çok fazla şey öğrendim. Belki bir ara tekrar görüşme şansı buluruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
