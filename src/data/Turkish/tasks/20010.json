			"dialogs": [
				{
					"id": 200100101,
					"content": "Gezgin! Bu tarafa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100102
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200100102,
					"content": "Dağ yabanilerini ürkütme. Nasıl oluyor da yolun hep dağ yabanilerinin kamplarına düşüyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100103
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200100103,
					"content": "Boş ver, bunun bir önemi yok. Uzun süredir Dağ Yabanisi Dili üzerine çalışıyorum fakat konuşma pratiğimi kitapların ötesine taşımak istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100104
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200100104,
					"content": "Sonunda bir dağ yabanisi kampı buldum... Bu fırsatın elimden kaçmasına izin veremem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200100105
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200100105,
					"content": "Gezgin, benimle birlikte kampa gidip pratik yapabileceğim bir dağ yabanisi bulmama yardım eder misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ella Musk"
				}
			]
		},
