			"dialogs": [
				{
					"id": 745280401,
					"content": "Aa, sen miydin? Anlaşılan yollarımız yine kesişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280402,
						745280403
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280402,
					"content": "Uzun zamandır görüşmemiştik Skirk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280404
					]
				},
				{
					"id": 745280404,
					"content": "Bu dünyanın üzerinde bırakılan \"yaraları\" gözlemliyorum. Bir patlama burayı tamamen yok etmiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280405
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280405,
					"content": "Ama sonra insanlar bu enkazın üzerine yeni bir şey inşa etmişler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280406
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280406,
					"content": "Her şeyin bir sonu vardır. Ama bir şey yok olduğunda yeni bir şey doğabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280407
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280407,
					"content": "Son görüşmemizden bu yana daha da güçlenmişsin. Görünüşe göre idmanını ihmal etmemişsin. Bu iyi bir şey.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280408,
						745280409
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280408,
					"content": "Aslında küçük bir ricam var...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280410
					]
				},
				{
					"id": 745280410,
					"content": "Fotoğraf mı? Bu dünyadan sadece geçip gidiyorum. Neden varlığımın izlerini bırakayım ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280411,
						745280412
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280411,
					"content": "Bana göre geçip giden biri değilsin sadece.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280413
					]
				},
				{
					"id": 745280413,
					"content": "... Eğer bunu yapmaya zaten karar verdiysen o zaman yap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280414
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280414,
					"content": "Ben buradayım. İstediğin zaman başlayabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 745280412,
					"content": "Her buluşma hatırlanmaya değerdir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280413
					]
				},
				{
					"id": 745280409,
					"content": "Bir fotoğrafını çekebilir miyim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280410
					]
				},
				{
					"id": 745280403,
					"content": "İş için mi buradasın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280404
					]
				}
			]
		}
	]
