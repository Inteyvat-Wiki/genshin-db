			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319510",
							"2"
						],
						"stepId": 7319510,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951001,
					"content": "\"En mükemmel hikaye anlatıcıyı nerede bulabileceğimi bilen var mı? Hikayeyi tüm gerçekliğiyle anlatan birisi olmalı.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951002
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731951002,
					"content": "\"Dehşet verici bir Jin bana musallat oldu. Ona her gün aynı hikayeyi anlatmazsam beni öldüreceğini söylüyor. Bu durum bir aydan beri devam ediyor ve beynim bu işkenceden dolayı pelte gibi oldu...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951003
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731951003,
					"content": "\"Ne tuhaf bir tecrübe. Puspa Kafede Maddah adında bir hikayeci olduğunu duydum. Belki o sana yardımcı olabilir.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7319511,
			"completionStepIds": [
				7319511
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319511",
							"2"
						],
						"stepId": 7319511,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951101,
					"content": "\"Birçok ülkede bulundum, sayısız gösteri izledim. Nilou'nun, Teyvat'ta en iyi dansçı olduğu şüphesiz bir gerçek; ama Akademideki çok bilmişler, onun performanlarını takdir etmedikleri gibi bir de ondan şikayet ediyorlar! Tam bir sanat düşmanlığı!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951102
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731951102,
					"content": "\"Mondstadt'ta edindiğim deneyimlerden yararlanarak Nilou için bir fan kulübü kurmalıyız. O zaman sanat hakkında bilgi sahibi olmayanlar, bir daha ona saygısızlık yapmaya cüret edemez.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951103
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731951103,
					"content": "\"Fan Kulübü mü? Mondstadt'ın kültüründe var mı böyle şeyler? Her neyse... Kusursuz bir performans, topluluktaki herkesin ortak emeğinin bir karşılığıdır. Tüm ilgiyi tek bir kişi üzerinde yoğunlaştırmak pek adaletli olmaz.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951104
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731951104,
					"content": "\"Bence sanatın kendisi herkesi bir araya getiren bir bağdır. Nilou'nun performansından memnun kalmanıza sevindim.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951105
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731951105,
					"content": "\"Bu zarif el yazısına bakılırsa siz genç bir hanımefendisiniz, öyle değil mi? Dans gösterilerini izlemeyi seven başka birilerinin olduğunu görmek harika bir şey. Acaba bir ara benimle kahve içmeye ne dersiniz?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951106
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731951106,
					"content": "\"Kusura bakmayın, çok meşgulüm. Yardıma ihtiyacınız olursa, lütfen menajerimle görüşün.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951107
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731951107,
					"content": "\"Görünüşe göre adam reddedilmiş. Son mesajdaki yazı sert mizaçlı bir adamınkine benziyor... Muhtemelen de zengin bir hanımefendinin koruması falan gibi bir şey.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7319512,
			"completionStepIds": [
				7319512
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319512",
							"2"
						],
						"stepId": 7319512,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951201,
					"content": "\"Satılık büyülü şişeler. Ruhların güçlerini kullanabilen büyülü şişeler. Ödemenizi lütfen buraya bırakın. Sadee bir Moraya hayalleriniz gerçek olsun.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951202
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731951202,
					"content": "\"Satılık büyülü şişeler. Dilekleri gerçekleştiren büyülü şişeler. Yalnızca bir Moraya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951203
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731951203,
					"content": "\"Ben bir Cinim. Bana bir Mora verin, ben de tüm dileklerinizi gerçekleştireyim.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951204
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731951204,
					"content": "\"Regzar Kalesi, yakın zamanda gerçekleşen birbiriyle bağlantılı dolandırıcılıkları araştırıyor. Lütfen kimse paniğe kapılmasın.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951205
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731951205,
					"content": "\"Başka soruları olan dolandırıcılık kurbanları, bir Mora karşılığında danışma hizmetinden yararlanabilir.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7319513,
			"completionStepIds": [
				7319513
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319513",
							"2"
						],
						"stepId": 7319513,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951301,
					"content": "\"Orman Gözcüsü olduğumdan beri vaktimin tümünü ormanda geçiriyorum. Bu böye devam ederse, yakında Alacakaranlık Kuşlarıyla konuşmaya başlarım.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951302
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731951302,
					"content": "\"Keşke onları anlayabilseydim... Şimdi böyle canım sıkılmazdı.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7319514,
			"completionStepIds": [
				7319514
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319514",
							"2"
						],
						"stepId": 7319514,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951401,
					"content": "\"Bir müddet önce, oldukça hoş bir paralı asker tuttum. Adı Alevli Yele gibi bir şeydi...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951402
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731951402,
					"content": "\"Eskiden iş için denize açılacağım zamanlarda onu yanımda götürürdüm. Hazine Avcıları veya Taşordu hiç fark etmez, o benim yanımdayken hiçbir şeyden korkmuyordum. Onun sayesinde bir servet kazandım.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951403
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731951403,
					"content": "\"Yine de son zamanlarda hiçbir özel görevi kabul ettiğini sanmıyorum. Ayrıca duyduğuma göre, Liyue yolundaki canavar sayısında da bir artış olmuş. Böyle devam ederse paramı Kalimi Takas Noktasına yatırmak zorunda kalacağım.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951404
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731951404,
					"content": "\"Yasal bir iş yapan birine benzemiyorsun... Ama eğer o gerçekten Alevli Yele ise, duyduğuma göre yakın zamanda Homayani ailesi tutmuş onu. Bu yüzden, onu yeniden tutabilmen için biraz beklemen gerekecek.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951405
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731951405,
					"content": "\"Benden herkese tavsiye: Paranızı Kalimi Takas Noktasına yatırmak yerine 100 tane halı almak en iyi yatırımdır!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951406
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731951406,
					"content": "\"Kesinlikle haklısınız! Lütfen dükkanımıza gelip halılarımıza bakın! Halıların her birinin nasıl kullanıldığını detaylı şekilde anlatabilirim!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7319515,
			"completionStepIds": [
				7319515
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
