			},
			"dialogs": [
				{
					"id": 731950101,
					"content": "Bu İlan Panosu Sumeru Şehri'nde meydana gelen önemli olayları kamuoyuna duyurmak için Vezir tarafından hazırlanmıştır. İlan Panosundaki bildirilere dair herhangi bir sorunuz olursa buraya mesaj bırakabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7319502,
			"completionStepIds": [
				7319502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319502",
							"2"
						],
						"stepId": 7319502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950201,
					"content": "\"Bildiri: Rishboland Kaplanlar sorununu halledebilecek profesyoneller arıyoruz.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950202
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731950202,
					"content": "Bildiri mesajı boya fırçasıyla karalanmış ve yanına da çocuksu bir el yazısıyla bir şeyler yazılmış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950203
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731950203,
					"content": "\"Rishboland Raja sadece insanlarla dalga geçmek istiyordu!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7319503,
			"completionStepIds": [
				7319503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319503",
							"2"
						],
						"stepId": 7319503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950301,
					"content": "\"Mantarları yedikten sonra dans eden periler görmeye başlarsanız, sakın paniğe kapılmayın. Bu, normal bir yan etkidir.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950302
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731950302,
					"content": "\"Bununla birlikte, etraftaki bitkilerin konuşmaya başladığını görürseniz, lütfen en yakın Orman Muhafızına başvurun.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7319504,
			"completionStepIds": [
				7319504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319504",
							"2"
						],
						"stepId": 7319504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950401,
					"content": "\"Bilinmeyen nedenlerden ötürü ormanlık alan boyunca Solduranın miktarı ve büyüklüğü arttı.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950402
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731950402,
					"content": "\"Solduran, sadece bölgedeki bitki örtüsünün kuruyup gitmesine sebep olmakla kalmaz, aynı zamanda vahşi yaşama ve hatta insanlara bile ölümcül zarar verebilir. Orman Gözcüleri, Solduran etkisi altındaki bölgeyi işaretlemek için Kirlenme Bölgeleri kurmuştur. Lütfen bu tür bölgelerden uzak durun.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950403
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731950403,
					"content": "\"Ormanda yeni bir Solduran görmeniz durumunda, sorunun profesyonelce halledilmesi için lütfen en yakın Orman Muhafızına başvurun.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7319505,
			"completionStepIds": [
				7319505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319505",
							"2"
						],
						"stepId": 7319505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950501,
					"content": "Matra, yerel Pazarlarda yakın zamanda gerçekleştirilen teftişler sırasında yasa dışı olarak yapılan çok sayıda Konserve Bilgi ticareti vakasını ortaya çıkardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950502
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731950502,
					"content": "Konserve Bilgi ticareti Akademi tarafından yasaklanmıştır ve fark edildiği takdirde yapanlar en sert şekilde cezalandırılacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950503
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731950503,
					"content": "Konserve Bilginin yasa dışı kullanımından doğan herhangi bir sonuçtan Akademi sorumlu tutulamaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7319506,
			"completionStepIds": [
				7319506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319506",
							"2"
						],
						"stepId": 7319506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950601,
					"content": "\"Yıllık Sabzeruz Festivali yaklaşıyor. Bu büyük festival, geçen yıl olduğu gibi bu yıl da yine Kapalı Çarşı'da gerçekleştirilecek.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950602
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731950602,
					"content": "\"Coşkulu ortamı şenlendirmek için hanımımız katılan tüm tüccarlar için özel bir ödenek hazırladı.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950603
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731950603,
					"content": "\"Devi Kusanali'nin doğum gününü gelin hep birlikte kutlayalım!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7319507,
			"completionStepIds": [
				7319507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
