			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951501,
					"content": "Ormanda boş bakışları olan ya da kendi kendine konuşan birileriyle karşılaşırsanız şaşırmayın. Onlar, Satyavada Yaşamı araştırmacıları. Lütfen onları rahatsız etmeyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951502
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731951502,
					"content": "Olur da sizi rahatsız ederlerde, bu konuyla doğru şekilde ilgilenilmesi için lütfen bunu Mahamata'ya bildirin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7319516,
			"completionStepIds": [
				7319516
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319516",
							"2"
						],
						"stepId": 7319516,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951601,
					"content": "\"Duyduğuma göre, eskiden Diwan bizim gibi şehir sakinlerinin haklarını korurmuş; şimdi ise Mahamata ne derse onu yapıyor.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951602
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731951602,
					"content": "\"Vezir de aynı şekilde. O da asla sözünde durmuyor. Sadece Mahamata sorumluluk dağıtmaya çalıştığında ortaya çıkıyor.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951603
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731951603,
					"content": "Akademinin tüm idari birimlere gönderdiği rehber, Mahadevi Rukkhadevata'nın mirasıdır. Lütfen karalamaya kalkışmayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7319517,
			"completionStepIds": [
				7319517
			],
