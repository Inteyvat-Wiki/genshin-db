			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950701,
					"content": "\"Hanımımız evden çıktı ve hâlâ geri dönmedi. Kahverengi saçlı, mavi ve mor elbiseli genç bir kız gördüğünüz takdirde lütfen Homayani ailesi ile irtibata geçin. Yardımınızın karşılığını alacaksınız!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950702
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731950702,
					"content": "\"Hanımımız, bu afişi görürseniz lütfen derhal bizimle iletişime geçin. Aileniz sizin için çok endişeleniyor.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7319508,
			"completionStepIds": [
				7319508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
