			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950801,
					"content": "\"Geri döndü! Lordum Al-Ahmar geri döndü!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950802
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731950802,
					"content": "\"Onun geri döndüğü gün, siz yaprak kafalılar için azap günüdür!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950803
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731950803,
					"content": "Bu yalan haber ve şu anda haberin kaynağını araştırıyoruz. Sumeru'daki tüm olaylar Akaşa üzerinden düzenli olarak paylaşılacaktır. Lütfen etrafta dolaşan dedikodulara kulak asmayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7319509,
			"completionStepIds": [
				7319509
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319509",
							"2"
						],
						"stepId": 7319509,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950901,
					"content": "\"Canınızı sıkan herhangi bir şey var mı? Kudretli Lord Sangemah Bay burada ve aradığınız cevaplar onda.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950902
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731950902,
					"content": "\"Cüzi bir miktar Mora karşılığında sorunlarınız anında çözülecek.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950903
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731950903,
					"content": "\"Çok geç olmadan harekete geçin! İletişim bilgileri...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950904
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731950904,
					"content": "Bu İlan Panosu, piyasa işlemlerinin düzenlenmesi amacıyla Baş Vezir tarafından hazırlanmıştır. Lütfen buraya reklam asmayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
