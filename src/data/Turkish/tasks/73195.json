			},
			"dialogs": [
				{
					"id": 731951701,
					"content": "\"Nasıl ki bilgeliğin şehri bizimse, cehalet ormanı da bizimdir. Ağacın tepesindeyse kayıp hayaller krallığının kalıntıları var.\"",
					"roleType": "TALK_ROLE_NPC",
