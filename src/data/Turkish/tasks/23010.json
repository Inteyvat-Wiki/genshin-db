					"nextDialogs": [
						230100807
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100807,
					"content": "Ama yine de aceleyle hareket ediyorsun. Çözmeye çalıştığın bir sorun mu var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100808
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100808,
					"content": "Çözmeye çalıştığın sorun ne bilmiyorum ama sana bir önerim var.",
