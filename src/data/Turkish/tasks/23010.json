					"nextDialogs": [
						230100815
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100815,
					"content": "Çiğ Eti nasıl bulduğun önemli değil bu arada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100816
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100816,
					"content": "Bir parça Çiğ Et aradığını hatırla yeter. Bu sana dert olmamalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100805,
