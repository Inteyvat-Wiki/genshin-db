					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100707
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100707,
					"content": "Zihnimin o bahsettiğim huzurlu nehrin içinde güzel güzel akmasına izin veriyorum. Böyle rahatlıyorum ben de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100708
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100708,
					"content": "Afiyet olsun hadi. Bu yemek senin de zihnini biraz rahatlatır umarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jafar"
				}
			]
		},
