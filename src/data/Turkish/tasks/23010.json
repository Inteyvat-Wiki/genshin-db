			"dialogs": [
				{
					"id": 230100101,
					"content": "Acelen var galiba dostum. Seni rahatsız eden şey nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100102,
						230100105
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100102,
					"content": "Birçok şey...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100103
					]
				},
				{
					"id": 230100103,
					"content": "Ah... Evet, yorgun ve zamanının sıkışık olduğunu görebiliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100104
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100104,
					"content": "Aklında hemen çözmen gereken bir şey varmış gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100109
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100109,
					"content": "Acele etmek yerine biraz daha beklemeyi kabul edersen seni lezzetli bir yemeğe davet etmek isterim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100110
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100110,
					"content": "Acele etmek hayatın bir parçası, doğru... Ama çoğu zaman söylediğimiz gibi, hırçın bir nehir bile bazen sakin bir akarsuyun içinde huzurla akmalıdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100111
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100111,
					"content": "Ara sıra mola vermelisin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100112
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100112,
					"content": "Hımm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100113
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100113,
					"content": "Hadi gel beraber biraz Naneli Fasulye Çorbası içelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100114
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100114,
					"content": "Bana Mora ödemene gerek yok. Nane filizi bulmama yardım etsen yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100115
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100115,
					"content": "Bu arada, nane filizini ararken çok seçici olmana gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100116
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100116,
					"content": "Sıradan bir filiz arıyorsun, unutma. Bela aramıyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100105,
					"content": "Aslında iyiyim ben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230100106
					]
				},
				{
					"id": 230100106,
					"content": "Peki, bu iyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100107
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100107,
					"content": "Ama yine de aceleyle hareket ediyorsun. Çözmeye çalıştığın bir sorun mu var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100108
					],
					"speakerTitle": "Jafar"
				},
				{
					"id": 230100108,
					"content": "Çözmeye çalıştığın sorun ne bilmiyorum ama sana bir önerim var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230100109
					],
					"speakerTitle": "Jafar"
				}
			]
		},
