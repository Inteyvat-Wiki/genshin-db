				"points": []
			},
			"dialogs": [
				{
					"id": 721690101,
					"content": "Bu yemekte kesinlikle \"Julie\" vari bir hava var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690102
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690102,
					"content": "Aslında, bu yemeği ilk gördüğümde Mondstadt'a özgü olduğunu düşünmüştüm ama gel gör ki buranın yöresel yemeğiymiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690103
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690103,
					"content": "Eminim tadı da görüntüsü kadar iyidir Xudong! Hadi, lütfen biraz yapalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690104,
						721690105
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721690104,
					"content": "Yine karşılaştık.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721690106
					]
				},
				{
					"id": 721690106,
					"content": "Sen miydin Gezgin? Hehe, sana yollarımız tekrar kesişecek demiştim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690107
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690107,
					"content": "Xudong şehirde yeni bir tarif buldu! Adı Kabukta Yengeç. Güzel isim, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690108
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721690108,
					"content": "Yapması o kadar da zor değil ama çok fazla yengece ihtiyacımız olacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690109
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690109,
					"content": "Birkaç normal yengeç hazırladım ve şimdi birkaç... Özel yengeç arıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690110
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690110,
					"content": "Özel yengeç mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721690111
					]
				},
				{
					"id": 721690111,
					"content": "Aynen öyle! Aslında Yıldırım Kirazının altında yaşayanlardan istiyoruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690112
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690112,
					"content": "Onlara \"yıldırım çarpmış yengeçler\" de denebilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690113
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690113,
					"content": "Öyle bir yerde yaşayan yengeçlerin tadını gerçekten çok merak ediyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690114
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690114,
					"content": "Yine de ağacın etrafında bu kadar şimşek çakarken oraya gitmeye cesaretim yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690115
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690115,
					"content": "Kitabımda yazana göre geçen seferki gibi Yıldırım Kirazı Dalına dokunup Elektrik Taneciğinin sana yapışmasını sağlamalısın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690116
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690116,
					"content": "Böylece Yıldırım Kirazından gelen yıldırımların seni çarpmasını önleyebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690117
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690117,
					"content": "Ağacın nasıl bir şey olduğunu gördün. Böylesine kabaca bir çözüm önerisine dayanarak riske giremem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690118
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690118,
					"content": "Yeterince hızlı koşmak işe yaramaz mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690119
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690119,
					"content": "Aklını mı kaçırdın? Yıldırımdan daha hızlı koşabileceğini mi düşünüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690120
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690120,
					"content": "Bir çubukla yengeçleri oradan çıkarmayı deneyebiliriz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690121
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721690121,
					"content": "Bence yakın bir yere hendek kazalım. Hendek, suyu da yengeçleri de dışarı çıkaracaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690122
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721690122,
					"content": "Hahaha. Herkesin bir fikri var. Harika, harika!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690123
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690123,
					"content": "Gezgin, sakıncası yoksa Yıldırım Kirazının altında yaşayan yengeçleri yakalamamıza yardım eder misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690124
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690124,
					"content": "Yardım edersen karşılığında sana harika bir ziyafet hazırlarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690125
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690125,
					"content": "Ah, tabii. Bir dakika... Bu yemi al.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690126
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690126,
					"content": "Yengeçleri yakalarken bu yemle dikkatlerini çekebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690127
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690127,
					"content": "Bu sayede daha az uğraşıp vakit kazanabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690128
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690128,
					"content": "Yıldırım Kirazının yanında yaşayan yengeçler... Tatlarının nasıl olacağını merak ediyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690105,
					"content": "Konu yine lezzetli yiyecekler, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721690106
					]
				}
			]
		},
		{
