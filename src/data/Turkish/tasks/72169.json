			"dialogs": [
				{
					"id": 721690201,
					"content": "Gezgin! Yengeç avın nasıl gidiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690202
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690202,
					"content": "Vay! Bu yengeç çok iyi görünüyor. Bu işte epey iyisin, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690203
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690203,
					"content": "Tüm malzemeler tamamlandığına göre hemen pişirmeye başlayabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721690204
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721690204,
					"content": "Ben hazırlık yaparken lütfen burada bekle Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
