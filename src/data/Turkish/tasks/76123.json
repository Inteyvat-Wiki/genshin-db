			"dialogs": [
				{
					"id": 761230101,
					"content": "Harika bir şey kokuyor! Yine Columbina'nın yemek saatine mi denk geldik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230102,
					"content": "Hım. Şu Kuuhenkiler... Columbina'nın servis ettiği çorba için sıraya mı girmiş?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230103,
					"content": "Bekleyin lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230104
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761230104,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230105
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761230105,
					"content": "Vay canına, bu çok iyi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230106,
					"content": "Ferahlatıcı ve lezzetli bir meyve çorbası... Paimon daha önce hiç böyle bir şey tatmamıştı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230107,
					"content": "Bir porsiyon daha ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230108
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761230108,
					"content": "İki olsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230109,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230110
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761230110,
					"content": "Yemek pişirmeyi mi öğreniyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230111
					]
				},
				{
					"id": 761230111,
					"content": "Evet. Ineffa'dan birkaç basit tarif istedim ve birkaç deneme yaptım. Hem Kuuhenkiler hem de hayvanlar oldukça olumlu tepkiler verdiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230112
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761230112,
					"content": "Mutfakta bir sorun yaşıyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230113
					]
				},
				{
					"id": 761230113,
					"content": "Şey... Elbisemin kolları çok geniş. Dikkatli olmazsam tencereye değiyorlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230114
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761230114,
					"content": "(Yani yemek pişirmekle ilgili bir sorun yaşamıyorsun.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230115
					]
				},
				{
					"id": 761230115,
					"content": "Bir de tatlı yapmakta biraz zorlanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230116
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761230116,
					"content": "Sıcaklığı ve oranları tam doğru ayarlamak gerekiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230117
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761230117,
					"content": "(Daha önce pek yemek yapmamış gibi duruyor.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230118
					]
				},
				{
					"id": 761230118,
					"content": "(Ayrıca tek başına çalışırken tatlıları ve atıştırmalıkları tutturması daha da zor...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230119
					]
				},
				{
					"id": 761230119,
					"content": "Yardım etmemi ister misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230120
					]
				},
				{
					"id": 761230120,
					"content": "Olur. Krumkake ile başlayalım, ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230121
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761230121,
					"content": "Bir süre sonra...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761230122
					]
				},
				{
					"id": 761230122,
					"content": "Birini denemek ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230123,
						761230124
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761230123,
					"content": "(Ucundan bir ısırık alayım.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230125
					]
				},
				{
					"id": 761230125,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230126
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761230126,
					"content": "(Ah, bayağı ekşiymiş, kesin suratımı buruşturdum...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230127
					]
				},
				{
					"id": 761230127,
					"content": "(Ama ağza tatlı bir aroma yayılıyor... Belki de alıştıkça tadı daha güzel geliyordur...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230128
					]
				},
				{
					"id": 761230128,
					"content": "Nasıl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230129,
						761230130
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761230129,
					"content": "Fena değil...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230131
					]
				},
				{
					"id": 761230131,
					"content": "Paimon bir şey kaçırmadı, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230132,
					"content": "Şunu hemen bir dener misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230133
					]
				},
				{
					"id": 761230133,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230134,
					"content": "Aaaaaa, çok ekşi! P-Paimon'a ne yapmaya çalışıyorsunuz siz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230135,
					"content": "Haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230136
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761230136,
					"content": "Ağızda bıraktığı tat gayet güzel ama.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230137
					]
				},
				{
					"id": 761230137,
					"content": "Tüm olay ilk tatta biter! Biriniz Paimon'u daha küçük bir ısırık alması için uyaramaz mıydı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230138,
					"content": "Sen bir şey demeseydin Paimon bunun bir şaka olduğunu sanırdı! İnsanların yüzünü buruşturmasını izlemek için falan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230139,
					"content": "Tamam. Tekrar deneyeyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230140
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761230140,
					"content": "Biraz daha zaman geçer...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761230141
					]
				},
				{
					"id": 761230141,
					"content": "Bir de bunu deneyin bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230142
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761230142,
					"content": "(Vay canına! Bu çok daha iyi!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230143,
						761230144
					]
				},
				{
					"id": 761230143,
					"content": "Enfes!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230145
					]
				},
				{
					"id": 761230145,
					"content": "Gerçekten mi? Paimon da istiyor! Mmmm! İşte bu! Çooook lezzetli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230146,
					"content": "Hediye olarak verilecek kadar iyi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230147
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761230147,
					"content": "Kesinlikle! Bir dakika, sen birine hediye vermek istediğin için mi yemek pişirmeyi ve Krumkake yapmayı öğrendin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230148,
					"content": "Evet... Arkadaşlarım için.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230149
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761230149,
					"content": "Ne hoş bir fikir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230150
					]
				},
				{
					"id": 761230150,
					"content": "Buraya ilk geldiğiniz zamanı hatırlıyor musunuz? Bana yemek hazırlamıştınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230151
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761230151,
					"content": "Yemek yemek, kaybettiğim gücü yenilemek adına pek bir işe yaramasa da beni rahatlatmıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230152
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761230152,
					"content": "O zamanlar pek üzerinde durmamıştım ama şimdi anlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230153
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761230153,
					"content": "Bir yemeğe ruhunu veren şey, yemeği özenle hazırlamak için harcanan zaman ve emektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230154
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761230154,
					"content": "Tadını çıkardığım şey sadece yemeğin kendisi değil, onu yapan ellerdeki sıcaklık ve nezaketti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230155
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761230155,
					"content": "Ve o eller ne kadar az karşılık ararsa hakkını ödemek için o kadar büyük bir sıcaklık ve nezaket gerekir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230156
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761230156,
					"content": "Ayy, böyle devam edersen Paimon'un utançtan yanakları kızaracak... Dürüst olmak gerekirse o zamanlar en azından biraz gözüne girmeyi umuyorduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230157,
						761230158
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230157,
					"content": "Ama artık işler değişti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230159
					]
				},
				{
					"id": 761230159,
					"content": "Evet. Ama artık tüm bunları anladığıma göre biraz daha fazlasını yapmak istiyorum... Bu muhteşem bir his.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230160
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761230160,
					"content": "Benimle arkadaşlarımızı ziyarete gelir misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230161
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761230161,
					"content": "Krumkakenin yanında başka hediyeler de hazırladım. Şey, ama bunların gizlice gönderilmesi gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230162
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761230162,
					"content": "Paimon'un sormasında sakınca yoksa, neden \"gizlice\" gönderiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230163
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230163,
					"content": "Beni o tatlı \"sürprizlerle şaşırtan\" hep siz oldunuz. Şimdi ise roller değişti, arkadaşlarımın nasıl tepki vereceğini görmek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230164
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761230164,
					"content": "Oh be. Oradan oraya koşturup durduk ama sonunda bitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230165
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230165,
					"content": "Ama tepkileri biraz şaşırtıcıydı. Bazıları hediyelerin senden geldiğini fark etmedi bile Columbina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230166
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230166,
					"content": "Aino ise hemen yemeye başladı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230167
					]
				},
				{
					"id": 761230167,
					"content": "Sorun değil. Zaten bunu bekliyordum. Önemli olan, hediye aldıkları için sevinmeleri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230168
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761230168,
					"content": "Öyleyse Lauma masasındaki Krumkakelerin ve tacın senden geldiğini kesinlikle anlamıştır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230169
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230169,
					"content": "Paimon, tacı takma konusundaki tereddüdünü anlayabiliyor ama cidden on dakika boyunca Krumkakelere baktı ve yine de bir tanesini bile yiyemedi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230170
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230170,
					"content": "Onları kutsal bir emanet gibi saklayacak sandım bir ara...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230171
					]
				},
				{
					"id": 761230171,
					"content": "Jahoda epey korktu galiba... Belki de hediyeleri gizlice tam arkasına bırakmamalıydık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230172
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761230172,
					"content": "Korkudan neredeyse ruhunu teslim edecekti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761230173
					]
				},
				{
					"id": 761230173,
					"content": "Belki de doğası gereği daha tetiktedir. Yine de Ashru gelip gönderdiğin tırmalama direğini patilemeye başlayınca sakinleşti sanki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230174
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230174,
					"content": "Nod-Krai'da olmayan diğer arkadaşlarımıza gelince, onların hediyelerini teslim etme işini size bırakıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230175
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
