						761230178
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761230178,
					"content": "Ooo! Sonunda sıra bize mi geldi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761230179
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761230179,
					"content": "Hı? Şeker mi? Paimon bizim de herkes gibi Krumkake alacağımızı sanmıştı.",
