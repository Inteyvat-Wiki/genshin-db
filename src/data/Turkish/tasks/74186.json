			"dialogs": [
				{
					"id": 741860301,
					"content": "Dominus Cassiodor! Dominus Cassiodor... Siz mi geldiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860302
					],
					"speakerTitle": "İsimsiz Golem"
				},
				{
					"id": 741860302,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860303
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741860303,
					"content": "Sizsiniz gerçekten! Tam da düşündüğüm gibi! Nihayet döndünüz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860304
					],
					"speakerTitle": "İsimsiz Golem"
				},
				{
					"id": 741860304,
					"content": "Bu kaleyi koruma emri almıştım ama o acımasız Ejderlerin ve barbarların saldırılarına daha fazla dayanamadım. O yüzden yavaş yavaş geri çekilmeye başladım, en sonunda da buraya kadar geldim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860305
					],
					"speakerTitle": "İsimsiz Golem"
				},
				{
					"id": 741860305,
					"content": "Ama sanırım o zamandan bu yana çok uzun yıllar geçti... Dışarıda durumlar nasıl? Kazandık mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860306
					],
					"speakerTitle": "İsimsiz Golem"
				},
				{
					"id": 741860306,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860307
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741860307,
					"content": "... Demek öyle. Kaybettik o halde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860308
					],
					"speakerTitle": "İsimsiz Golem"
				},
				{
					"id": 741860308,
					"content": "Özür dilerim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860309
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741860309,
					"content": "Böyle şeyler söylemeyin Dominus'um. Sebastos'un ordusuna katıldığımda bugünlerin geleceğini öngörmüştüm elbet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860310
					],
					"speakerTitle": "İsimsiz Golem"
				},
				{
					"id": 741860310,
					"content": "Sebastos'un önderliğinde \"Fortuna\"nın zincirlerini kırma yoluna baş koymuştuk... Ama bunu yapmak öyle kolay olabilir mi hiç?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860311
					],
					"speakerTitle": "İsimsiz Golem"
				},
				{
					"id": 741860311,
					"content": "Ne de olsa bizzat kadere karşı koymaya çalışıyoruz. Kadere meydan okumak en kudretli tanrılar için bile zor olsa gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860312
					],
					"speakerTitle": "İsimsiz Golem"
				},
				{
					"id": 741860312,
					"content": "En nihayetinde tüm çabalarımız boşa gitti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860313
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741860313,
					"content": "Hayır, öyle demeyin Dominus'um. Biz kaderin iradesine karşı kılıçlarımızı kaldırdık, yaptığımız her şeyle göklerin yasalarına meydan okuduk. Kehanete, olanca gücümüzle ve cesaretimizle karşı koyduk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860314
					],
					"speakerTitle": "İsimsiz Golem"
				},
				{
					"id": 741860314,
					"content": "Ancak sonunda kaybettik... Kesin birileri bize ihanet etti ve bizi yanlış yönlendirdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860315
					],
					"speakerTitle": "İsimsiz Golem"
				},
				{
					"id": 741860315,
					"content": "Artık sonucun bir önemi yok. Ne pahasına olursa olsun yaptığımız her bir şey bu dünyanın \"tarihine\" altın harflerle kazınacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860316
					],
					"speakerTitle": "İsimsiz Golem"
				},
				{
					"id": 741860316,
					"content": "Aa! Bir anda yere yığılıverdi! Taş insanlar da... Birden bayılabiliyor muymuş böyle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741860317,
					"content": "Adını öğrenemedim bile... Sanırım böylece bu kişinin \"tarihi\" sona ermiş oldu artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860318
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741860318,
					"content": "Ama bu çok üzücü! Binlerce yıldır burada bu şekilde savaşıyor muymuş yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741860319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741860319,
					"content": "Neyse ki sonunda huzura kavuştu. Biz de yolumuza devam edelim artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Osse"
				}
			]
		}
	]
}