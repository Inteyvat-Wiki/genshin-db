				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Neko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722130601,
					"content": "Miyav miyav miyav. Sorun mu var? Merak etmeyin, münasip \"naaşı\" ayarlıyorum ben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130602,
						722130603
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130602,
					"content": "\"Maaş\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130605
					]
				},
				{
					"id": 722130605,
					"content": "Ah, boş ver. Olay şu, senin taş insan... yani Bay Ooshima'nın aletleri kırılmış, biz de ona tamir etmesi için gereken malzemeleri sağladık. Bir sorun kalmaması lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722130606,
					"content": "Hımm? Sorun mu dedin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130607,
						722130608
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130607,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130609
					]
				},
				{
					"id": 722130609,
					"content": "Güzel. Taşın son halini görmek için sabırsızlanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130610
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130610,
					"content": "Bir keresinde Hibiki benim suretimde bir taş yapılınca güzel bir şeyin olabileceğini söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130611
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130611,
					"content": "Ah, içim kıpır kıpır resmen! Ne olabilir ki acaba? Belki Hibiki döner...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130608,
					"content": "Sorun morun yok. Her şey tıkırında.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130609
					]
				},
				{
					"id": 722130603,
					"content": "Ne kadar olacak?",
					"roleType": "TALK_ROLE_PLAYER",
