				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722130101,
					"content": "\"Naaş\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130102,
					"content": "Heykel işi nasıl gidiyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130103
					]
				},
				{
					"id": 722130103,
					"content": "Taş insan pek marifetliymiş, miyav miyav miyav.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130104,
					"content": "Bitti mi peki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130105
					]
				},
				{
					"id": 722130105,
					"content": "Hayır ama bir baktım, kocaman bir taş getirmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130106,
					"content": "Sonra taşı dövmeye başladı. Tak, tak, tak diye. Bir yandan da \"işveren\" ve \"maaş\" falan deyip durdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130107
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130107,
					"content": "Konusu açılmışken naçizane sormak isterim: \"işyiyen\" ve \"naaş\" ne demek?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130108,
					"content": "\"İşveren\" ve \"maaş\" demek istiyor olmayasın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130109
					]
				},
				{
					"id": 722130109,
					"content": "Kısaca özetlersek ondan bir şey istediğin için senin de ona bir şey vermen gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722130110,
					"content": "Ah, öyle mi? Siz insanlar ne çok takıyorsunuz böyle şeyleri... Tamam o zaman. Kulaklarımı okşamasına izin veririm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130111,
					"content": "Paimon bunun yeterli olacağını pek sanmıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722130112,
					"content": "Yetmez mi? Hımm, o zaman ona mama vereyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130113,
					"content": "Bence asıl istediği şey Mora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130114
					]
				},
				{
					"id": 722130114,
					"content": "Mora mı? Bağış Kutusuna sokuşturmaktan başka bir işe de mi yarıyor? İnsanlar böyle şeylere de mi takılıyorlarmış?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130115,
					"content": "Yani, maaş dediğin aslında çok önemlidir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130116
					]
				},
				{
					"id": 722130116,
					"content": "Hah. Öyle diyorsanız öyledir. Bir sürü yardımınız dokundu bana sonuçta. Döndüğümüzde taş insanla konuşacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130117
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130117,
					"content": "Gelgelelim taş insan tak, tak, tak yapmıyor artık. Kısa bir kazık taşıdığını gördüm, artık her ne işine yarayacaksa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130118
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722130118,
					"content": "Kazık mı? Heykeltıraşlık dediğin çekiçle, keskiyle falan yapılmıyor muydu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722130119,
					"content": "Aletleri mi kırıldı yoksa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722130120
					]
				},
				{
					"id": 722130120,
					"content": "#Ah be. Gel {NICKNAME}. Gidip Bay Ooshima'yı bulalım, galiba yardımımıza ihtiyacı var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
