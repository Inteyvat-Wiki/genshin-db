			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ooshima Junpei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722130501,
					"content": "Mükemmel! Bunlar işimi görür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130502
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130502,
					"content": "Ben gidip ocak yapmaya müsait bir yer bulayım, sonra da aletlerimi yapmaya başlayayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722130503
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722130503,
					"content": "Leydi Rahibe'ye haber eder misiniz? Ben de toparlanayım o arada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				}
			]
		},
		{
			"id": 7221306,
			"completionStepIds": [
				7221304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221304",
							"2"
						],
						"stepId": 7221304,
						"stateName": "QUEST_STATE_UNFINISHED"
