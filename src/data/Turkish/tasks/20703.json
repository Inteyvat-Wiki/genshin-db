			"dialogs": [
				{
					"id": 207030401,
					"content": "Araştırmalara katılmak için biçilmiş kaftansın resmen, onu söyleyeyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030402
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030402,
					"content": "Maceracılıkta oldukça deneyimlisin, ayrıca metanetlisin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030403
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030403,
					"content": "Daha da önemlisi Önsezi olmadan bile elementleri kontrol edebiliyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030404
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030404,
					"content": "Elementler... Sırlarını açığa çıkarmak için bu kıtada herhangi bir çalışma yapılabilir mi gerçekten? Bir araştırmacı için Önsezi kullanım kabiliyeti veya bu kabiliyetin yokluğu ciddi anlamda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030405
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030405,
					"content": "Ah, yine konudan saptım. Üzgünüm, beni ciddiye alma lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dr. Edith"
				}
			]
		},
