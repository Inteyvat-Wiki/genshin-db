			"dialogs": [
				{
					"id": 207030501,
					"content": "Bir şey buldun mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030502
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030502,
					"content": "Birkaç yaprak buldum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207030503
					]
				},
				{
					"id": 207030503,
					"content": "Yaprak mı? Bir bakayım. Hah, yaprakları kutuya bile koymuşsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030504
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030504,
					"content": "Bu yapraklar, elindeyken gerçekten de içlerindeki Rüzgar enerjisini hissetmeni sağladılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030505
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030505,
					"content": "Bu ağacın böyle bir güce sahip olduğunu düşününce... Önsezim olsaydı bu kadar zaman harcamam gerekmezdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030506
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030506,
					"content": "Çok teşekkürler. Bu çok önemli bir kaynak, kesinlikle değerlendireceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030507
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030507,
					"content": "Ama bu yaprakları nasıl muhafaza edeceğimi bilmiyorum. Rüzgar enerjilerinin her an dağılması oldukça muhtemel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030508
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030508,
					"content": "Şimdilik bunu emeklerinin karşılığı olarak kabul et. Araştırma malzemesi toplamama yardım etmen için seni tekrar çağırmam gerekebilir, belli olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dr. Edith"
				}
			]
		}
	]
