			"dialogs": [
				{
					"id": 207030101,
					"content": "Bu malzemeyi de kullanamam, çok üzücü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030102
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030102,
					"content": "Ne üzerinde çalışıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207030103
					]
				},
				{
					"id": 207030103,
					"content": "Mondstadt tarihindeki Rüzgar üzerine yeni bir kitap yazmak istiyorum da, ilham aramak için buraya geldim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030104
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030104,
					"content": "Burası düşününce çok uygun bir yer. Rüzgarı temsil eden Yedilerin Heykeli burada, ayrıca bu ağaç yüce kahraman Vennessa'nın efsanesiyle yakından bağlantılı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030105
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030105,
					"content": "Yine de... Biraz komik gelebilir ama... Önsezi olmadan Rüzgar aramak ve toplamak çok zor. Bende de Önsezi yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030106
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030106,
					"content": "İlham aramak için geldiğimi söyledim ya. Öylece boşluğa bakıp duruyorum sadece. Elimdeki malzemelerin çoğu ikinci el kaynaklardan sentezleniyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030107
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030107,
					"content": "Bu kıtada Önsezin olmayınca böyle oluyor. Çok şey yapıyorsun ama çok şey başaramıyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030108
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030108,
					"content": "Önsezi olmadan elementlerin gücünü kullanamayız. İster araştırma ister yaşamak için olsun, elementler olmadan kendi dünyamızda yabancı gibi yaşarız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030109
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030109,
					"content": "Hahaha, belki tanrıların gözünde Önsezi sahipleri bu dünyanın ana karakterleridir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030110
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030110,
					"content": "Kusura bakma, çenem düştü. Umutsuz konuşsam bile araştırmamdan vazgeçmeyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030111
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030111,
					"content": "Önsezim olmasa da bilime güveniyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030112
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030112,
					"content": "Hem, Önsezi olmadan elementleri kullanabildiğini duymuştum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030113
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030113,
					"content": "Rüzgarla kaplı birkaç eşya bulmama yardım edersen araştırmam için gerçekten çok faydalı olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030114
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030114,
					"content": "Ağaca tırmanmama ve göz atmama yardım edebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dr. Edith"
				}
			]
		},
