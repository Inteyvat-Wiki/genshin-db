					"nextDialogs": [
						207030202
					]
				},
				{
					"id": 207030202,
					"content": "Harika, o zaman sana güveniyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030303
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030303,
					"content": "Elementleri görebiliyorsun, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030304
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030304,
					"content": "Rüzgarın izini takip edip gittiği yere bakınman yeterli olacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030305
					],
					"speakerTitle": "Dr. Edith"
				},
				{
					"id": 207030305,
					"content": "Seni ağacın altında bekliyorum. Bir şey bulursan bana getir yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dr. Edith"
				}
			]
		},
