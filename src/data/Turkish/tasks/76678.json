					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490707,
					"content": "Ah, niyetim o değildi... Sadece melodini nazik bir ay ışığıyla süslemek istedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760490709,
					"content": "Bulutları ve sisi delip geçtik, birlikte aydaki cevaba şahit olduk... Güzelliği, tıpkı şimdi tellerinin söylediği müzik gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Küçük Hanım"
				}
			]
