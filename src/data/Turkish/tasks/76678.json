					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490805
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760490805,
					"content": "Bir gün mutlaka gidip görmelisin! Sana rehberlik edebiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
