			"dialogs": [
				{
					"id": 760830501,
					"content": "Hadi bakalım arkadaşlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830502
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760830502,
					"content": "Tek yapmanız gereken resmin ne olduğunu tahmin etmek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830503,
						760830508,
