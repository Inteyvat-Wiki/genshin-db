					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760830503,
					"content": "Demir Yumruk Ördek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760830504
					]
				},
				{
					"id": 760830504,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830505
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760830505,
					"content": "Bunu nasıl tahmin edebildin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760830506,
					"content": "Demek adı buymuş. Onu yaratan kişiyi tutup elinde mi taşıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830507
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760830507,
					"content": "Paimon, senin Aino'yu eski bir meslektaşınla karıştırdığını düşünüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760830508,
					"content": "Çok fazla yemek yemiş bir Hırsız Gelincik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760830509
					]
				},
				{
					"id": 760830509,
					"content": "Bu kadar tok bir Hırsız Gelincik hâlâ bir şeyler çalabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760830510,
					"content": "Belki de artık çalmaya ihtiyacı yoktur, ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830511
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760830511,
					"content": "Doğru cevap \"Aino'nun atölyesinin yanındaki büyük mekanik ördek\" olacaktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830512
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760830512,
					"content": "Geri gelin. Teşekkürler, bunun kolay olmadığını biliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760830513,
					"content": "Bir şişe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760830514
					]
				},
				{
					"id": 760830514,
					"content": "Vay canına, Kuuhenkiler sırf bu oyun için özel laboratuvar ekipmanlarının nasıl göründüklerini mi öğrenmiş? Bu işi gerçekten ciddiye alıyorlar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760830515,
					"content": "Çok yaklaştın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830516
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760830516,
					"content": "Doğru cevap \"Aino'nun atölyesinin yanındaki büyük mekanik ördek\" olacaktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830517
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760830517,
					"content": "Sen buna yaklaşmak mı diyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
