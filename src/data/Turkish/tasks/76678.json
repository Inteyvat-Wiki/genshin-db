			"dialogs": [
				{
					"id": 760840101,
					"content": "Aa, siz miydiniz? Kuuhenkiler yine lir çalıyorlar. Onlara geçen seferki gibi bir şarkı çalabilir misin?",
					"roleType": "TALK_ROLE_NPC",
