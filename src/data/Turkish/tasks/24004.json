			"dialogs": [
				{
					"id": 240040201,
					"content": "Sanırım bu sayfayı daha önce okumuştum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040202,
						240040203
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040202,
					"content": "Kitap mı okuyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040204
					]
				},
				{
					"id": 240040204,
					"content": "Ha? Çok hızlı geldiniz. Kitap okumaya yeni başlamıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040205
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040205,
					"content": "Lovi'nin babası bu kitabı bana vermesini istedi. Hatta anlamadığım bir şey olursa ona sorabileceğimi söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040206
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040206,
					"content": "Açıkçası... Bu kitaptan \"anladığın\" bir şey var mı diye sorsanız daha iyi olur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040207
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040207,
					"content": "Her neyse, buluşma noktasına döneceğim. Ne de olsa beni buldunuz, kural kuraldır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040203,
					"content": "Öğrenmeye çok meraklısın, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040204
					]
				}
			]
		},
