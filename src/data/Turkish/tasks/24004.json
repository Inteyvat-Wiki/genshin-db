				"points": []
			},
			"dialogs": [
				{
					"id": 240040101,
					"content": "Abi, hadi oraya saklanalım. Bence orası onun seçtiği yerden çok daha iyi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040102
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040102,
					"content": "Hey, Verut, yanımdan ayrılma! Kaybolursan seni hemen bulamayacağımı biliyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040103,
						240040104
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040103,
					"content": "İkiniz burada ne yapıyorsunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040105
					]
				},
				{
					"id": 240040105,
					"content": "Hey, gelmişsin! Vaktin var mı acaba? Hadi bizimle oyna sen de! Lovi çoktan saklanmıştır bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040106
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040106,
					"content": "Bana Lovi'den bahset...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040107
					]
				},
				{
					"id": 240040107,
					"content": "Hadi, vaktimiz yok! Burayı çok iyi bilir... Daha iyi bir saklanma yeri bulmamız lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040108
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040108,
					"content": "Verut acele ile ayrılır...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240040109
					]
				},
				{
					"id": 240040109,
					"content": "*iç çeker* Verut... Ne zaman söz dinleyecek acaba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040110
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040110,
					"content": "Üzgünüm ama bizimle bir tur daha oynar mısınız diye sizi rahatsız edecektim. Verut nedense çok heyecanlı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040111,
						240040114
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040111,
					"content": "Belki de yeni bir arkadaş buldu diyedir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040112
					]
				},
				{
					"id": 240040112,
					"content": "Bence de. O mutlu olduğu sürece sorun yok tabii...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040113
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040113,
					"content": "Umarım çok fazla heyecanlanıp Lovi'nin peşine düşmez de o tuhaf yerlerden birine saklanmaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040118
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040118,
					"content": "Pardon ama lütfen bizimle tekrar saklambaç oynayabilir misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040119
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040119,
					"content": "Sanırım saklanacak bir yer bulsam iyi olur, yoksa Verut yine üzülecek... Bir de ağlamaya başlarsa sokağın ortasında rezil olurum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040120
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040120,
					"content": "Aurele ayrılır...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 240040114,
					"content": "Bana Lovi'den bahset...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040115
					]
				},
				{
					"id": 240040115,
					"content": "Az önce tanıştığımız bir kız. Saklambaç oynadığımızı görüp bize katılmak için çok ısrar etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040116
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040116,
					"content": "O da karakter olarak Verut'a benziyor, o yüzden çok iyi anlaştılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040117
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040117,
					"content": "Onun da babasının oynayacak çok vakti olmuyor. Sanırım onunla aynı durumdayız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040118
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040104,
					"content": "Hâlâ saklambaç mı oynuyorsunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040105
					]
				}
			]
		},
