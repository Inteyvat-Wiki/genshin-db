			"dialogs": [
				{
					"id": 240040401,
					"content": "Of, demek beni buldun... Ha? Bir dakika, sen kimsin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040402
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040402,
					"content": "Aurele ve Verut'un arkadaşı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040403
					]
				},
				{
					"id": 240040403,
					"content": "Aa! Senden daha önce bahsetmişlerdi... Verut, bu oyunda çok iyi olduğunu söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040404
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040404,
					"content": "Bugün de kendi gözlerimle görmüş oldum. Bu oyunda gerçekten iyisin ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040405
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040405,
					"content": "Beni iyi buldun. O halde ben de buluşma noktasına gideyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lovi"
				}
