			"dialogs": [
				{
					"id": 240040501,
					"content": "Neden bana öyle bakıyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040502
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040502,
					"content": "Yine gizlice kitap okuyordun, değil mi? Oyunu hiç ciddiye almıyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040503
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040503,
					"content": "Doğru söylüyor. Biraz ciddi olsana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040504
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040504,
					"content": "Siz ikiniz iyi yerleri kaptınız ve ben bu oyunda çok iyi değilim... O yüzden zaman geçirmek için kitap okudum işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040505
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040505,
					"content": "Hadi canım! Yalan söylüyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040506
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040506,
					"content": "Hıh! Kitap kurdu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040507
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040507,
					"content": "Gerçekten mi? Beni kurtarın lütfen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040508,
						240040509
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240040508,
					"content": "Tamam, onu rahat bırakın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040510
					]
				},
				{
					"id": 240040510,
					"content": "Hehe, Lovi saklambaçta çok iyi. Tüm iyi saklanma yerlerini avucunun içi gibi biliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040517
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040517,
					"content": "Hehehe, Lovi olunca burası harika bir yer oluyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040511
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240040511,
					"content": "Verut, hem duvarlara çok hızlı tırmanıyor hem de çok güçlü. Bana birçok defa yardım etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040512
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240040512,
					"content": "Birlikte saklandığımız sürece bahse girerim ki bizi kimse bulamaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040513
					],
					"speakerTitle": "Lovi"
				},
				{
