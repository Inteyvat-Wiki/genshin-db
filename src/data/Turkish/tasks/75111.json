					"Michica"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751110401,
					"content": "Muhuru Mücevher Dükkanı... Imix mi? Off, bu da bir fatura kesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110402
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110402,
					"content": "Bu fatura yolda kaybolursa Bayan Cheven çocuğa çok fena fırça çeker.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110403
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110403,
					"content": "Benim daha dükkandaki paketleri halletmem gerekiyor. Bunu Imix'e sen gönderir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110404
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110404,
					"content": "Muhuru Mücevher Dükkanı, Yankıların Çocukları toprakları içinde yer alıyor. Gözün kapalı bulursun orayı, merak etme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michica"
				}
			]
		},
