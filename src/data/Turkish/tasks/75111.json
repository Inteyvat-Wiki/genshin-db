					],
					"speakerTitle": "Imix"
				},
				{
					"id": 751111603,
					"content": "Çok teşekkür ederim! Lütfen al bunları, senin olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111604
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 751111604,
					"content": "Şey, bu arada... Bu durumu Bayan Cheven'a anlatmasan olur mu? Yalvarırım aramızda kalsın!",
					"roleType": "TALK_ROLE_NPC",
