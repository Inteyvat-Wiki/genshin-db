				{
					"id": 751111501,
					"content": "Aa. Evet, bu benim siparişim. Ne olmuş da bu hale gelmiş zavallıcık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111502
					],
					"speakerTitle": "Chanca"
				},
				{
					"id": 751111502,
					"content": "Eh, bir mektup daha yazarım artık. Aciliyeti olan bir şey değildi zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111503
					],
					"speakerTitle": "Chanca"
				},
				{
					"id": 751111503,
					"content": "Neyse, mektubu getirdiğin için sağ ol. Ter içinde kalmışsın zaten, sana içecek bir şeyler ısmarlayayım.",
					"roleType": "TALK_ROLE_NPC",
