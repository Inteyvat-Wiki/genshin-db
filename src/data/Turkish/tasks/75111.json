			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Michica"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751110301,
					"content": "Bu... Chanca'nın el yazısına benziyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110302
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110302,
					"content": "Bu da bir sipariş faturası sanırım. Paketi mahvolmuş gerçi, bu şekilde teslim etmek olmaz. Bu mektubu geri göndermemiz lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110303
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110303,
					"content": "Benim daha dükkandaki paketleri halletmem gerekiyor. Bunu benim yerime Chanca'ya gönderebilir misin acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110304
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110304,
					"content": "Kutsal Alev Stadyumunun yakınındaki Keyif Hanının sahibi olur kendisi. Elinle koymuş gibi bulursun o hanı, gözden kaçacak gibi bir yer değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michica"
				}
			]
		},
		{
			"id": 7511104,
			"completionStepIds": [
				7511104
			],
