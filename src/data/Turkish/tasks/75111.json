			"dialogs": [
				{
					"id": 751111401,
					"content": "Evet, benim bu. Yankıların Çocuklarından biri boya satın almak istedi ama hangi renkleri istediğini bir türlü tarif edemedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111402
					],
					"speakerTitle": "Acat"
				},
				{
					"id": 751111402,
					"content": "O yüzden ben de içinde bir sürü küçük boya numunesi olan bir paket gönderdim ki bir sonraki ziyaretine kadar kararını verebilsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111403
					],
					"speakerTitle": "Acat"
				},
				{
					"id": 751111403,
					"content": "Tekrar göndereyim en iyisi bunu. Yoksa yine gelip yok şöyle bir renk, yok böyle bir renk diye saçma sapan şeyler tarif edecek bana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751111404
					],
					"speakerTitle": "Acat"
				},
				{
					"id": 751111404,
					"content": "Ha, doğru ya. Bu senin olsun. Paketi geri getirdiğin için sağ ol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Acat"
				}
			]
		},
