			"dialogs": [
				{
					"id": 751110501,
					"content": "... Yanılmıyorsam bu mektup Tirda'dan gelmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110502
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110502,
					"content": "Kabilesine mi göndermeye çalışıyordu acaba? Ahı gitmiş vahı kalmış gerçi mektubun... Sahibine geri göndermemiz gerekecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110503
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110503,
					"content": "Benim daha dükkandaki paketleri halletmem gerekiyor. Bunu Tirda'ya benim yerime sen gönderebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110504
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 751110504,
					"content": "Kendisi Altın Gün Batımı'nda şarkı söyler. Hemen bulursun bence kendisini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michica"
				}
			]
