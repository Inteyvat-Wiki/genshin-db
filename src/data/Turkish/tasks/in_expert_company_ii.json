			"dialogs": [
				{
					"id": 741140301,
					"content": "#Aha! Harikasın {NICKNAME}. Sen cidden harikasın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140302
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 741140302,
					"content": "Sen olmasaydın kutunun içindeki her şeyi kaybedecektik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140303
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 741140303,
					"content": "Şehre dönmeli ve filmleri Bay Geisert'e vermeliyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140304
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 741140304,
					"content": "#Sonrasında ise... Bir yemek yiyelim. {NICKNAME}, istersen sen de bize katılabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140305
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 741140305,
					"content": "Yemekten sonra ödemeni yaparım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140306,
						741140307
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 741140306,
					"content": "Pekala.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140308
					]
				},
				{
					"id": 741140308,
					"content": "Tamamdır! Bu sorunu da halletmiş olduk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140309
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 741140309,
					"content": "Yifeng, kutudaki filmleri birazdan Bay Geisert'e ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140310
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 741140310,
					"content": "Xingye, gidip bana yakınlardan biraz yeşillik al. Son zamanlarda Poisson Deniz Mahsulü Çorbası üzerinde çalışıyorum. Çorbamı Bay Geisert'e göstermenin tam zamanı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140311
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 741140311,
					"content": "Patron, zaten restorana gideceğiz. Neden hâlâ işleri kendin yapıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140312
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140312,
					"content": "Maliyetleri düşürelim diye...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140313
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 741140313,
					"content": "Öhöm! Halloldu, hadi gidelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140314
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 741140314,
					"content": "#{NICKNAME}, beni takip edebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 741140307,
					"content": "Şey, ben de tam acıkmıştım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140308
					]
				}
			]
