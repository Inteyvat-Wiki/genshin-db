			"dialogs": [
				{
					"id": 741140101,
					"content": "Sorun değil, kutumuz su geçirmez. Yapmamız gereken tek şey dalmak ve onu almak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140102
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 741140102,
					"content": "Patron, hiçbirimiz dalmayı bilmiyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140103
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140103,
					"content": "Ben yüzme biliyorum ama dalma beni aşar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140104
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 741140104,
					"content": "Maceracılar Loncasında yayınladığımız özel görev hâlâ duruyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140105
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 741140105,
					"content": "Patron, daha önce acele etmemizi ve görevi iptal etmemizi söylemedin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140106
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 741140106,
					"content": "Dün iptal ettik. Lonca, önden ödediğimiz görev yayınlama ücretini bugün iade edeceğini söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140107
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140107,
					"content": "Ah... Tekrar bir özel görev yayınlasak fazladan bir hizmet bedeli ödememiz gerekir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140108,
						741140109
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 741140108,
					"content": "Filminizi bitirdiniz mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140110
					]
				},
				{
					"id": 741140110,
					"content": "#Maceracı... {NICKNAME}! Tam da sana ihtiyacımız varken geldin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140111
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 741140111,
					"content": "Suya dalabilir misin? Ya da... Şu anda vakti olan bir dalgıç bulabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140112
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 741140112,
					"content": "Bir su altı çekimi mi istiyorsunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140113
					]
				},
				{
					"id": 741140113,
					"content": "O kadarını yapamayız. Bir de su geçirmez film ekipmanı almaya paramız yetmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140114
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 741140114,
					"content": "Filmlerimizi içine koyduğumuz kutu suya düştü, bu yüzden bize dalgıç lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140115
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 741140115,
					"content": "#Pekala, bu kadar yeter! {NICKNAME}, bize yardım etmen lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140116
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 741140116,
					"content": "Ücreti dert etmeyin sakın. Geçen seferki gibi nakit ödeyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 741140109,
					"content": "Burada ne yapıyorsunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140110
					]
				}
			]
		},
