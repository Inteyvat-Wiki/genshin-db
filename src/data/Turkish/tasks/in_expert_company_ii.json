			"dialogs": [
				{
					"id": 741140601,
					"content": "#{NICKNAME}, seni usta bir film yapımcısıyla, Bay Geisert ile tanıştırmak istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140602
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 741140602,
					"content": "#Bay Geisert, bu {NICKNAME}. Kendisi oldukça yetenekli bir maceracıdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140603
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 741140603,
					"content": "#İlerleyen zamanlarda bir aksiyon filmi çekecek olursanız başrol oyuncusu olarak {NICKNAME} çok iyi bir seçenek olabilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140604
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 741140604,
					"content": "Haha, Bayan Qiu abartıyor. Uzman film yapımcısı falan değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140605
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140605,
					"content": "Sadece film yapımlarındaki ışıklandırma kullanımına aşina olan biriyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140606
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140606,
					"content": "Ah, çok mütevazı davranıyorsun. Filmlerindeki ışıklandırmalar kendini gayet iyi anlatıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140607,
						741140609
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 741140607,
					"content": "Film yapımında kullanılan ışıklandırmalar mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140608
					]
				},
				{
					"id": 741140608,
					"content": "Evet. Işıklandırma teorilerime göre, ışığın uygun şekilde kullanımı duyguların da uygun şekilde yansıtılmasıdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140611
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140611,
					"content": "Ama... Nasıl desem ki? Teorilerim, Fontaine film endüstrisinde henüz kabul görmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140612
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140612,
					"content": "Rejisörlerin çoğu, hikayelerini yansıtmak için ya sahnenin kendisini ya da doğrudan aksiyon kullanmayı tercih eder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140613
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140613,
					"content": "Anlatıları ifade etmek için sadece ışık geçişleri kullanarak birkaç film çektim ama neredeyse kimse ilgi göstermedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140614
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140614,
					"content": "Ama şimdi en azından bir rejisör benim ışıklandırma teorimin değerli olduğunu düşünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140615
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140615,
					"content": "Rejisör mü? Ben mi? Haha, dalga geçme lütfen. Ben daha önce sıradan bir çay satıcısıydım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140616
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 741140616,
					"content": "Çay satıcısının rejisör olamayacağını da kim söyledi? Ben de daha önce bir gazeteciydim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140617
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140617,
					"content": "Gazeteci mi? O zaman haber yazmada da epey iyisindir. Hani şu gazetelerde olanlardan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140618
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 741140618,
					"content": "Sanırım öyleyimdir. Ne oldu ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140619
					],
					"speakerTitle": "Geisert"
				},
				{
					"id": 741140619,
					"content": "Hah... Tam da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140620
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 741140620,
					"content": "Ah! Neyse, yok bir şey. Hadi yemeğimizi yiyelim! İlerleyen zamanlarda birlikte çalışacak daha çok vaktimiz olacak, hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140621
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 741140621,
					"content": "Bayan Qiu kahkahalarla gülerken diğer herkes yerini alır.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741140622
					]
				},
				{
					"id": 741140622,
					"content": "Yemekten sonra Bayan Qiu fazladan bir yemek yapar ve paketleyip çantana koyar...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 741140609,
					"content": "Film yapımında ışıklandırma çok önemli mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741140610
					]
				},
				{
					"id": 741140610,
					"content": "Tabii ki. Teorilerime göre, bir sahnedeki ruh halini ifade etmede ışıklandırma en önemli yöntemlerinden biri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741140611
					],
					"speakerTitle": "Geisert"
				}
			]
		},
