			"dialogs": [
				{
					"id": 200110301,
					"content": "Sonunda yol açıldı. Teşekkürler Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110302
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110302,
					"content": "Anna asla tam olarak iyileşmiyor ancak çok paramız olmadığı için fırsat buldukça buraya şifalı bitki toplamaya geliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110303
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110303,
					"content": "Tam ihtiyacım olan bitkileri bulmuştum ki bir anda saldırıya uğradım. Beni kurtarmak için tam vaktinde geldin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110304
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110304,
					"content": "Bu senin için. Bununla hep Anna'ya çay yaparım. Öksürüğüne iyi geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110305
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110305,
					"content": "Sen de hep dışarıda dolaşan birine benziyorsun, kendine iyi bakarsan iyi edersin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		}
