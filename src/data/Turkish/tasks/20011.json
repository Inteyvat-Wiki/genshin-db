			"dialogs": [
				{
					"id": 200110201,
					"content": "Oh be. Teşekkür ederim Gezgin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110202
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110202,
					"content": "Hâlâ yolu tıkayan barikatlar var, buradan geçemem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110203
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110203,
					"content": "Haha... Şu dağ yabanileri beni dayaktan bayıltmamış olsaydı onlara günlerini gösterirdim. Her tarafım ağrıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110204
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110204,
					"content": "En azından Anna için topladığım şifalı bitkiler zarar görmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110205
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110205,
					"content": "Benim için yaptığın onca şeyden sonra sormaya çekiniyorum fakat şu barikatları ortadan kaldırabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110206,
						200110207
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110206,
					"content": "Elbette.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200110208
					]
				},
				{
					"id": 200110208,
					"content": "Teşekkür ederim! Ben de bu sırada dinlensem iyi olur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200110207,
					"content": "Üzgünüm, yapmam gereken işler var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200110209
					]
				},
				{
					"id": 200110209,
					"content": "Lütfen, Anna evde beni bekliyor, yardımına ihtiyacım var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		},
