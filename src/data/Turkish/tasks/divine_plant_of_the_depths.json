			"dialogs": [
				{
					"id": 721500201,
					"content": "Döndünüz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500202
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500202,
					"content": "İstediğin şeyi getirdik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500203
					]
				},
				{
					"id": 721500203,
					"content": "Adak Havuzundan az önce aldığımız tertemiz su!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500204,
					"content": "Ah, çok teşekkür ederim. Benimle gelin, ben de bu suyu Ruhbitkilerine vereyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500205
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500205,
					"content": "Hım, nerede kalmıştık... Ah, evet. Ruhbitkilerini daha da parlak kılmak için yapmamız gereken bir şey daha var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500206
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500206,
					"content": "Ruhbitkisinin kökü ve yaprakları sadece denizin derinliklerinden gelen Su ile dolu bir ortamda kendisini yuvasında hissedip \"dileklerin\" canlı renklerini sergiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500207
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500207,
					"content": "Kısacası... Kuzeydeki bir mağaranın Su yapısında bu bitkinin doğal ortamındaki suya son derece yakın bir kaynak var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500208
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500208,
					"content": "Bu mağaranın içinde suyun yoğunluğu da mekandan mekana değişiyor. Aradığınız Su tertemiz ve berrak olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500209
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500209,
					"content": "Ancak su bulanıklaşırsa veya diğer canlılar yolunuzu keserse işiniz zorlaşabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500210
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500210,
					"content": "*iç çeker* Bu yaşımda bu kelimelerin ne anlama geldiğinden emin olamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500211
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500211,
					"content": "Gördüğünüz zaman ne demek olduğunu anlarsınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500212
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500212,
					"content": "Bu mağara atalarımızın sırrına sıkıca bağlı. Maalesef son savaşla beraber gençler Ruhbitkileri için oradan su getirmez oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500213
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500213,
					"content": "*iç çeker* Gençler demişken, umarım sağ salim dönerler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500214
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500214,
					"content": "Ah, evet. Oraya su çekmeye gidersen evlat, lütfen kendine mukayyet ol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500215
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500215,
					"content": "Merak etme Nine. Bize bir şey olmaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500216,
						721500217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500216,
					"content": "Hatırlamaya çalışırım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500218
					]
				},
				{
					"id": 721500218,
					"content": "Güzel, güzel. Eksik olmayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500217,
					"content": "Endişelenmenize gerek yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500218
					]
				}
			]
