			"dialogs": [
				{
					"id": 721500301,
					"content": "Ah, döndünüz demek. Gelin, dinlenin biraz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500302
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500302,
					"content": "Komaki Nine, istediğin suyu getirdik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500303,
					"content": "Bahsettiğin \"ideal su\" bu, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500304
					]
				},
				{
					"id": 721500304,
					"content": "Evet, bu kadarı yeterli. Size de zahmet verdim ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500305
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500305,
					"content": "Haha, şunlara bak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500306
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500306,
					"content": "Ruhbitkilerinin ışıldamalarına bakarsak... Önümüzdeki sene kuşkusuz huzurlu ve bereketli olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500307
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500307,
					"content": "Hımm, nereden anladın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500308,
					"content": "Ruhbitkilerinin rengi öteden beri aldıkları nem miktarına ve insanların dileklerinden aldıkları besine bağlı olmuştur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500309
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500309,
					"content": "Bu ruh ışığı, dileklerin vücut bulmuş halidir. Dilekler ne kadar iyiyse ışık da o kadar parlak, geleceğimiz de o kadar umutlu olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500310
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500310,
					"content": "Sonuçta herkes daha iyi yarınlar için dilek tutar, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500311
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500311,
					"content": "Herkes mevcut yaşamlarını iyileştirmek için dilek tuttuğu sürece...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500312
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500312,
					"content": "Savaş sonrası kadar korkunç bir süreç bile yanında ufak bir mesele kalabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500313
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500313,
					"content": "Peki... Bütün bunların kehanetin... Gücü ile bir ilgisi var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500314,
					"content": "Elbette. Bu, biz yaşlıların hikmeti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500315
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500315,
					"content": "Dilekler yol gösterip yüreklendirirken insanların eylemlerinin neticeleri de dileklerini şekillendirir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500316
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500316,
					"content": "Huzurlu yaşamlarımızı korumaya gücümüz yettiği sürece, karanlık günlerde bile umuda tutunabildiğimiz sürece...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500317
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500317,
					"content": "Ruhbitkisinin kehanetleri her zaman tesirli olacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500318,
						721500319
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500318,
					"content": "Batıl inanç için yapılmış alelacele bir açıklama sanki...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500320
					]
				},
				{
					"id": 721500320,
					"content": "Hehe. Ah evladım, sen de bir gün anlayacaksın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500321
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500321,
					"content": "Bu arada sudaki dileklerin gücü birkaç gün daha dayanır. Dilerseniz başka bir kehanet için yine gelebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500319,
					"content": "Fakat faydasız olduğu da söylenemez...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500320
					]
				}
			]
		},
