			},
			"dialogs": [
				{
					"id": 721500101,
					"content": "Merhaba evlat. Giyim kuşamına bakılırsa bu adadan değilsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500102,
						721500103
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500102,
					"content": "Doğru.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500104
					]
				},
				{
					"id": 721500104,
					"content": "Demek bir tür gezginsin. O zaman... Burada biraz duraklayıp yolculuğunla ilgili kehanet dinlemek ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500105
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500105,
					"content": "Ne, kehanet mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500106,
						721500107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500106,
					"content": "Yolculuk derken?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500108
					]
				},
				{
					"id": 721500108,
					"content": "Hahaha, hayır, yok. Bu kadar kaygılanma. Özür dilerim, öyle pat diye söyleyince tabii...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500109
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500109,
					"content": "Burada, Bourou Köyü'ndeki Watatsumi tapınağı pek güçlüdür. Bu nedenle geleceğini okumayı teklif ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500110
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500110,
					"content": "Yürüdüğün yol tehlikelerle dolu demek istemedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500111
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500111,
					"content": "Sonuçta yürüdüğümüz yollar sadece birkaç kelimeden ibaret olabilir mi? Bu çok saçma olurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500112
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500112,
					"content": "Yani sadece falcılık öyle mi? İyi bari, rahatladım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500113,
					"content": "Bize kaça patlar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500114
					]
				},
				{
					"id": 721500114,
					"content": "Sizden ücret istemiyorum. Böyle şeyler için para talep etmeyiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500115
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500115,
					"content": "Tapınak görevlileri \"dilek\" gibi şeyler için para toplayacak olsalar Omikami'nin ulu ruhu bundan muhakkak rahatsız olurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500116
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500116,
					"content": "Sonuçta hepimiz faniyiz. Başkalarının dileklerinden çıkar sağlamak ne haddimize?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500117
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500117,
					"content": "Ah, demek öyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500118,
					"content": "Pekala. Şöyle bir falınıza bakmamı ister misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500119
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500119,
					"content": "Bir deneyelim bakalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500120
					]
				},
				{
					"id": 721500120,
					"content": "Haha, eksik olmayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500121
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500121,
					"content": "Bu devirde huzura kavuşmak çok zor. Köyün gençleri de başka şeylerle uğraşıyorlar. Sizin gibi gençlerin buraya geldiğini görmek ihtiyar yüreğimi ısıtıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500122
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500122,
					"content": "Senin gibi Watatsumi Adası adetlerine saygı gösteren yabancıları ise mumla ararsın. Ziyadesiyle etkileyici, haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500123
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500123,
					"content": "Tamam, dırdır etmeyeyim. Fala gelirsek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500124
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500124,
					"content": "Başlamadan önce bu ihtiyar kadıncağıza bir konuda yardım eder misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500125
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500125,
					"content": "Dönüp dolaşıp yine Moraya mı geldik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500126,
					"content": "Hehe, hayır, hayır... Beni bir dinleyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500127
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500127,
					"content": "Bourou Köyü'ndeki bu tapınağa gücünü, orada büyüyen \"Derin Deniz Ruhbitkisi\" veriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500128
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500128,
					"content": "İsminden de belli olacağı üzere bu bitki bir zamanlar atalarımızın geldiği yerde, okyanusun dibinde yetişiyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500129
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500129,
					"content": "Atalarımız binlerce yıl önce bu bitkileri denizin dibinden toprağa naklederek özenle yetiştirdiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500130
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500130,
					"content": "Köy sakinlerinin nesiller boyu gösterdiği özveri sayesinde ne savaşlar ne de doğal afetler, hatta Omikami'mizin şehadetinin kederi bile bu uzun ömürlü Ruhbitkilerini yok edemedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500131
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500131,
					"content": "Bu bitki normalde su altında yetişiyor, bu sebeple hayatta kalması için sık sık sulamamız gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500132
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500132,
					"content": "Ayrıca zifiri karanlıkta yaşadığından sürekli yumuşak bir ışık saçar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500133
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500133,
					"content": "Biz de ışığının parlaklığını dileklerin gerçekleşip gerçekleşemeyeceğini anlamak için kullanıyoruz. Bu gizemi ise su kaynağı besliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500134
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500134,
					"content": "Hehe, genç tapınak görevlileri genelde kehanet ayininin güvenilirliğinden şüphe ediyor. Yeterince muteber olmadığı, batıl inançtan bir farkı olmadığı gibi şeyler düşünüyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500135
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500135,
					"content": "Daha net ve kolay anlaşılacak kuramları tercih ediyorlar. Haliyle ağızdan ağıza aktarılırken zamanla bozulan efsanelere pek meyilli değiller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500136
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500136,
					"content": "Yine de bunlar... Atalarımızın hikmeti, nesilden nesile aktarılan bilgiler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500137
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500137,
					"content": "Net bir teori altında toplayabilmek ziyadesiyle gayret gerektirse de içinde barındırdığı bazı hakikatleri de göz ardı edemeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500138
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500138,
					"content": "Ee... Su kaynağından bahsediyordun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500139
					]
				},
				{
					"id": 721500139,
					"content": "Su kaynağı mı? Ah! Hehe, doğru! Bir anda muhabbete dalmışım. Yaşım kendini belli ediyor, ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500140
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500140,
					"content": "Devam edeyim. Ruhbitkilerini yetiştirmek için bu adadaki tapınağın Adak Havuzundan, içinde \"dilekler\" olan su gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500141
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500141,
					"content": "Suyun içinde gerçekten böyle bir şey olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500142,
					"content": "Hehe, tabii ki. İnsanların dilediği \"dilekler\" o havuzda birikip suya karışır. Tıpkı balın suya karıştığı gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500143
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500143,
					"content": "Onları kimse göremez ama suyun tatlılığından ve kıvamından anlaşılır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500144
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500144,
					"content": "Bu hem hafıza hem de inanç için geçerlidir. Hepsi bu ilkelere uyar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500145
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500145,
					"content": "Ah, evet. Su çekmeye giderseniz dikkatli olun. Adak Havuzundan ayrıldığınız anda dileklerin gücü havaya karışmaya başlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500146
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500146,
					"content": "Yıllar geçtikçe hayallerin uçup gitmesi gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500147
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500147,
					"content": "Dileklerin havaya karışması da verdikleri histen ve ağırlıklarından anlaşılabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500148
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500148,
					"content": "Vay be...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500149
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500149,
					"content": "Ha...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500150
					]
				},
				{
					"id": 721500150,
					"content": "Haha, kusuruma bakmayın. Sanırım yine konudan saptım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500151
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500151,
					"content": "Her neyse, suyu çektikten sonra oyalanmadan hemen buraya dönün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500152
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500152,
					"content": "Yoksa dileklerin gücü tamamen dağılır ve Ruhbitkileri yeterli besini alamaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500153
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500153,
					"content": "Ruhbitkilerini beslemek ve kehanetimizin tesirini emniyete almak için yapmamız gereken bir şey daha var. Bana sonra mutlaka hatırlatın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500154
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500154,
					"content": "Nine, bu iş çok zahmetli. Sana yardımcı olabilecek tapınak görevlisi yok mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500155
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500155,
					"content": "*iç çeker* Günümüz tapınak görevlileri böyle şeyleri can sıkıcı buluyor. Eski adetlere burun kıvırıyorlar ve genelde yardımcı olmak da istemiyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500156
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500156,
					"content": "Ruhbitkilerinin ışıklarının gün be gün solmasını izlemek ne kadar üzücü bilemezsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500157
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500157,
					"content": "Evet ama biraz zahmetli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500158
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721500158,
					"content": "Tapınak görevlilerinin ne hissettiğini şimdi anlayabiliyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500159
					]
				},
				{
					"id": 721500159,
					"content": "Peki. Biraz su çekmeme yardım edecek misiniz bakalım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500160
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721500160,
					"content": "Ah, edeceğiz elbette.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500161
					]
				},
				{
					"id": 721500161,
					"content": "Öyleyse size minnettar olacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Komaki"
				},
				{
