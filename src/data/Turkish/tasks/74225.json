			"dialogs": [
				{
					"id": 742250201,
					"content": "Teşekkürler yardımcım! Tanrı Kral seni kutsasın, nihayet kurtuldum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250202
					],
					"speakerTitle": "Foscari"
				},
				{
					"id": 742250202,
					"content": "Bu şehri savunan lejyonerlerden biri misin, yoksa geçerken uğrayan cesur bir ruh mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250203
					],
					"speakerTitle": "Foscari"
				},
				{
					"id": 742250203,
					"content": "Her halükarda kendimi tanıtayım. Faustus'tur adım, Tanrı Kral tarafından bizzat atanmış bir Mercatores Exquisiti tüccarıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250204
					],
					"speakerTitle": "Foscari"
				},
				{
					"id": 742250204,
					"content": "Buraya güney diyarlarından baharat sevkiyatı yapmaya geldim... Kıyıya yanaşır yanaşmaz o alçak ejderlerin etrafımı kuşatmasını beklemiyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250205
					],
					"speakerTitle": "Foscari"
				},
				{
					"id": 742250205,
					"content": "Ejder mi? Hiç ejder görmedim ben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742250206
					]
				},
				{
					"id": 742250206,
					"content": "Hımm? Aman tanrım, sen gerçekten de güçlü bir savaşçısın! Az öncekileri düşmandan saymıyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742250207
					],
					"speakerTitle": "Foscari"
				},
				{
					"id": 742250207,
					"content": "Her neyse, lütfen bunları al. Şu anda maalesef sohbet etmeye vakit yok. Bu malların şehre götürülmesi gerekiyor. Orada belki tekrar karşılaşırız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Foscari"
				}
			]
		}
	]
