			"dialogs": [
				{
					"id": 150290101,
					"content": "Parşömeni dokuma konusunda parmağınızı kıpırdatmanıza bile gerek yok. Ama Huitzilin'in tekniğini aktaracaksak katılımınız çok önemli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290102
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290102,
					"content": "Nasıl yani Citlali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290103,
					"content": "Gelin benimle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290104
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290104,
					"content": "Aa, şuraya bak... Sen de mi parşömen dokuyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290105,
					"content": "Parşömenler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290106
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290106,
					"content": "Parşömenler mi? Bana şaheserini göstereceksin sanıyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290107
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290107,
					"content": "Göstereceğim eski dostum. Sana göstereceğim teknik dokuma parşömenlerle doğrudan ilgili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290108
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290108,
					"content": "*iç çeker* Peki, nedir? Savaşın gidişatını değiştirebilecek veya büyük bir felaketi önleyebilecek bir şey mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290109
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290109,
					"content": "Bana meydan okumak istiyorsun kesin, değil mi? Gerçek bir dövüşe yetecek kadar gücün olmadığını biliyorum, o yüzden beni sözlerinle dövmene izin vereceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290110
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290110,
					"content": "*öksürür*... Eski dostum, vadem dolmak üzere. Korkarım... Bir düello daha yapacak vaktim yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290111
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290111,
					"content": "Hey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290112
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290112,
					"content": "Merak etme. Kabilemizin inancına güveniyorum... Ölüm bir son değil, her şeyin anılardan yapıldığı Gece Krallığı'nda yeni bir varoluşun başlangıcı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290113
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290113,
					"content": "Atalarımız tarihi kaydetmek için neden renkli parşömenler dokumakta ısrar etmiş biliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290114
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290114,
					"content": "Çünkü... Tarih, bir halkın hafızasıdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290115
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290115,
					"content": "Parşömenlerimize ölüler gün batımının sıcaklığını hissedebilsin diye turuncu renk veriyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290116
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290116,
					"content": "Ölüler hasatlarımızın bereketini görsün diye Tahıl Meyvesi taneleriyle süslüyoruz parşömenleri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290117
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290117,
					"content": "Biliyordum bunları da... Bu kadar önemli bir tekniği neden öğrencilerinden birine değil de bana emanet ettin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290118
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290118,
					"content": "Hehe, dostun olarak itiraf edeyim... Biraz kendi bencilliğimden ötürü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290119
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290119,
					"content": "*öksürür* Fazla vaktim kalmadı Citlali. Kararımı açıklayabilir miyim... Emin değilim. Ama bir gün anlayacağını biliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290120
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290120,
					"content": "Şimdilik... Son dileğimi kabul edecek misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290121
					],
					"speakerTitle": "Huitzilin"
				},
				{
					"id": 150290121,
					"content": "... Yalnızca bu seferlik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290122
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290122,
					"content": "Anlıyorum şimdi Huitzilin, anlayacağımı söylemiştin ya... Pençe, yardım et de bunu dışarı taşıyalım. Boyayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290123
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290123,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290124
					],
					"speakerTitle": "Tlapo"
				},
				{
					"id": 150290124,
					"content": "#{NICKNAME}, Paimon, benimle gelin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				}
			]
		},
