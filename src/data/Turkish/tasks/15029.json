				{
					"id": 150295101,
					"content": "Ah, Natlan'ın Hiçliğe karşı zaferi! Böyle bir parşömen için çok uygun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150295102
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150295102,
					"content": "Acaba Yüce Tlapo bir sonraki atanmışı ne zaman seçecek?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150295103
					],
					"speakerTitle": "Aywastin"
				},
				{
					"id": 150295103,
					"content": "Yüce Tlapo demişken dün gözden kaybolmuş diye duydum! Ne olmuş biliyor musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150295104
					],
					"speakerTitle": "Besuci"
				},
				{
					"id": 150295104,
					"content": "Yüce Tlapo'nun işine akıl sır ermez. Gidişinin anlamı zamanla ortaya çıkar elbet fakat biz şu an anlayamayız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
