				{
					"id": 150290504,
					"content": "Evet ama Şef Biram tüm o çabalarının karşılığında bundan fazlasını hak ediyordu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290505
					]
				},
				{
					"id": 150290505,
					"content": "... Önceki şeflerden farklı sanırım. Ama eğer bunca yıldır parşömenleri dokuyanın ben olduğumu anlarsa ayvayı yerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290506
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290506,
					"content": "İşte buradasınız! Her yerde sizi arıyordum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290507
					],
					"speakerTitle": "Allier"
				},
				{
					"id": 150290507,
					"content": "Aa, Fontaineli diğer araştırmacı... Patronuyla beraber götürülmemiş mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290508,
					"content": "Bana Allier diyebilirsiniz, lütfen... Sorgunun ardından kabile bir kabahatim olmadığına kanaat getirdi, ben de yanınıza geldim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290509
					],
					"speakerTitle": "Allier"
				},
				{
					"id": 150290509,
					"content": "Yakında Fontaine'e döneceğim. İşverenim gittiği için finansmanım da kalmadı artık. Ama önce araştırmamı tamamlamak istedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290510
					],
					"speakerTitle": "Allier"
				},
				{
					"id": 150290510,
					"content": "Huitzilin hakkında bazı sorular sormak istiyorum. Hikayesi Natlan'ın dışında da duyulsun istiyorum ama bilgilerimde bazı eksik noktalar var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290511
					],
					"speakerTitle": "Allier"
				},
				{
					"id": 150290511,
					"content": "Sorular mı? Hıh... Bir yabancının bizim hikayelerimizi anlatmasına neden izin verecekmişim peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290512
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290512,
					"content": "Yanlış anlamayın lütfen, tarihinizi çarpıtmak veya kazanç sağlamak amaçlı kullanmak gibi bir niyetim yok. Safi merak benimkisi, gerçekten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290513
					],
					"speakerTitle": "Allier"
				},
				{
					"id": 150290513,
					"content": "Harika hikayelerin dünyayla paylaşılmayı hak ettiğini düşünüyorum ben. Kültür de diyalog ve alışverişle büyür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290514
					],
					"speakerTitle": "Allier"
				},
				{
					"id": 150290514,
					"content": "Haklı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290515
					]
				},
				{
					"id": 150290515,
					"content": "Peki, sor o zaman sorularını ama çabuk ol. Önemli planlarım var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290516
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290516,
					"content": "Önemli planların mı var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290517,
					"content": "Çok sağ olun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290518
					],
					"speakerTitle": "Allier"
				},
				{
					"id": 150290518,
					"content": "Allier kapsamlı bir röportaj yapar, Citlali'nin sabrı tükendiğinde de gider.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150290519
					]
				},
				{
					"id": 150290519,
					"content": "Yine sosyal pilim tükendi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290520
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290520,
					"content": "Artık gidelim o zaman.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290521
					]
				},
				{
					"id": 150290521,
					"content": "Olur... Aa, bir dakika! Bana kitap borcunuz var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290522
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290522,
					"content": "Ha... Söz konusu resimli romanlar oldu mu hafızan zehir gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290523,
					"content": "Öyle nadir kitapları bulması zaman ister...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290524
					]
				},
				{
					"id": 150290524,
					"content": "Bak sen... Doğru evet, kolay olmayacak. Bizzat Yae Yayınevine gitmeniz gerekebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290525
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290525,
					"content": "Kitaplara öyle acil ihtiyacım yok. Yine de unutmayın, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290526
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290526,
					"content": "Tabii unutmayız! Bulur bulmaz sana gönderteceğiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290527,
					"content": "Göndertecek misiniz? Yok, olmaz, akşamdan kalmayken kapımı bir yabancı çalsın istemem. Bunu alın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290528
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290528,
					"content": "Nedir bu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290529,
					"content": "Evimin anahtarı. Bir dahakine kapıyı çalmayın, uykumu bölüyorsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				}
			]
		},
