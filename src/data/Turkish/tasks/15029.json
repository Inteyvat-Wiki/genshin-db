			"dialogs": [
				{
					"id": 150290401,
					"content": "Başardınız mı? Yedi Renk Savaşı araştırmanız verimli geçmiş demek. Umarım öğrendiklerinizi benimle de paylaşırsınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290402
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290402,
					"content": "Vay be, parşömen bitmiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290403
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150290403,
					"content": "Yüce Tlapo'nun bilgeliği asla şaşırtmıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290404
					],
					"speakerTitle": "Aywastin"
				},
				{
					"id": 150290404,
					"content": "#Evet, açıklayalım... Top sende {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290405,
					"content": "Citlali'nin katkıları haricinde özel renkle ilgili öğrendiklerinizi anlatıyorsunuz.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150290406
					]
				},
				{
					"id": 150290406,
					"content": "Anlıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290407
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290407,
					"content": "Pek şaşırmış durmuyorsun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290408,
					"content": "Çok mantıklı geldi! Tarih bir halkın hafızasıdır. Bu hafızayı tasvir etmek istiyorsak kullanılabilecek en iyi boya tabii ki insanların anılarından gelen bir boya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290409
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290409,
					"content": "Şimdi geriye bir tek bu gizli tekniği muhafaza etmek kaldı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290410
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290410,
					"content": "Hımm... Anlattıklarınıza göre tekniği öğrenmek için önceki kişinin anılarını paylaşması gerekiyor, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290411
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290411,
					"content": "Yani, evet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290412,
					"content": "O halde rahiplerimizle çalışarak anlattığınız bu prensipler doğrultusunda tekniği yeniden icat etmeliyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290413
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290413,
					"content": "#Sonuçta anılar değerlidir. En yakınlarımızla paylaşılmayı hak ederler. Bu tercihi senin elinden alamam {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290414
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290414,
					"content": "Görevi layığıyla tamamladınız. Bu mirası sürdürmenin yolunu bulmak da bizim görevimiz artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290415
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290415,
					"content": "Tamamdır, bu işi size bırakıyoruz o zaman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290416,
					"content": "Ha bu arada lütfen Itztli Nine'ye teşekkürlerimi iletin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290417
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290417,
					"content": "Yakaladığı Fontaineli tüccarı sorguya çektik. Kabilemizde bazı insanların tarihimize şüpheyle yaklaşmalarının sebebi oymuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290418
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290418,
					"content": "Yedi Renk Savaşı hakkında yalan yanlış bilgiler yaysın diye insanlar tutmuş. Kabiledeki bu son sürtüşme onun eseri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290419
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290419,
					"content": "Suçlarını kayıt altına aldık, birkaç gün içinde Fontaine yetkilileriyle çalışmaya başlarız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290420
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150290420,
					"content": "Demek tartışmaların arkasında o varmış! İnsanlar bir konuyu sorgularken onu araştırmak daha kolay oluyor herhalde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290421,
					"content": "Neyse, bu iş de böyle kapandı! İnsanlar durduk yere tarihlerini sorgulamazmış demek ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290422,
					"content": "Sağ ol Biram. Biz artık gidelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290423
					]
				},
				{
					"id": 150290423,
					"content": "Görüşmek üzere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Biram"
				}
			]
		},
