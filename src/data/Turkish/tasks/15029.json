			"dialogs": [
				{
					"id": 150290201,
					"content": "Zamanın semalarında uçan kuşlar gibiyiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290203
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290203,
					"content": "(Paket Videosu)",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150290204
					]
				},
				{
					"id": 150290204,
					"content": "Anlayacağını biliyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290205
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290205,
					"content": "Bu... Özel parşömen! Nasıl dokunacağını nereden bildin Citlali?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290206,
					"content": "\"Ruhlardan gelen hediye\"yi hatırlıyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290207
					]
				},
				{
					"id": 150290207,
					"content": "Bir dakika, iki yüz yılı aşkın süredir yaşıyorsun ve özel parşömeni dokumayı biliyorsun, o zaman... \"Ruhlardan gelen hediye\" aslında sensin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290208,
					"content": "Görevin atandığı kişilerle iletişim kurmak istemediğim için parşömeni her verdiğimde yanılsamalarla akıllarını karıştırırdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290209
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290209,
					"content": "Kimse numaralarımı fark edecek kadar yetenekli olmadığı için zamanla \"ilahi müdahale\" gibi bir söylentiye dönüştü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290210
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290210,
					"content": "Niye gerçeği söylemedin ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290211
					]
				},
				{
					"id": 150290211,
					"content": "Bunca yıldır bu görevi tek başına mı üstlendin? Başkalarıyla iletişim kurmayı sevmiyorsun tamam ama niye başkasına öğretmedin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290212,
					"content": "#... {NICKNAME}, özel rengi görebiliyorsun sen, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290213
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290213,
					"content": "Evet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290214
					]
				},
				{
					"id": 150290214,
					"content": "Bu rengin özünde anılar var. Yani özel parşömeni tamamlamak için kendi anılarında renk araman gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290215
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290215,
					"content": "Tekniği birine aktarmak demek, onunla anılarını paylaşmak demek. Onun anılarında kendi renginin izini bırakman lazım, aynı şekilde onun da senin anılarında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290216
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290216,
					"content": "Bunu henüz bugün doğruladım fakat uzun zamandır şüphelerim vardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290217
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290217,
					"content": "Bir de... Huitzilin öldüğünden beri insanlarla o tür bir bağ kurmak istemedim hiç.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290218
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290218,
					"content": "Ha, doğru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290219,
					"content": "Son dileği buydu, o yüzden bu yükü sonsuza dek üstlenmeye karar verdim. Sonuçta vaktim bol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290220
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290220,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290221
					],
					"speakerTitle": "Tlapo"
				},
				{
					"id": 150290221,
					"content": "Ama Pençe parşömen dokumak için yeni adaylar atayıp durdu. Üstelik biliyordu bu konuda ne düşündüğümü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290222
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290222,
					"content": "Yani sana yeni arkadaşlar bulmaya çalıştı hep, öyle mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290223
					]
				},
				{
					"id": 150290223,
					"content": "... Ne yaptığını gayet iyi biliyordum. Ayrıca evet, anılarımı biriyle paylaşacak olsam o kişi dostum olurdu. Ama işler o raddeye ulaşmadı hiç.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290224
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290224,
					"content": "Ama bu sefer sen kazandın Pençe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290225
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290225,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290226
					],
					"speakerTitle": "Tlapo"
				},
				{
					"id": 150290226,
					"content": "Alın bunu. Sanırım... Geçen gece bana söylediğine cevabım bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290227
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290227,
					"content": "Nedir bu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290228,
					"content": "Kendime bir renk seçecek olsam bu mendilin rengini seçerdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290229
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290229,
					"content": "Anılarımda sayısız insan yaşıyor. Bir gün benim de kaderim bu olacak, biliyorum. Başkasının zihninde yaşayan bir anı olacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290230
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290230,
					"content": "Senin uzun bir ömrün olacağı için bu anıyı... Ve rengimi zihninde taşımaya en uygun aday sensin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290231
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290231,
					"content": "Resmi olarak dostun mu oldum yani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290232
					]
				},
				{
					"id": 150290232,
					"content": "... İyi bak ona, ben göçüp gittiğimde rengimi sakın unutayım deme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290233
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290233,
					"content": "Hop, ölümü konuşmak için daha çok erken değil mi? Dostluğumuza resmilik kazandıralı daha birkaç saniye oldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290234,
					"content": "Dostlar bunun için değil midir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290235
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290235,
					"content": "#Peki, ciddi bir sorumluluk bu... Citlali, {NICKNAME} senin zihninde renk bırakacaksa altın rengi olur herhalde, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290236,
					"content": "Çoktan iz bıraktı aslında. Bir türlü düzeltemediğim şu zihin okuma etkisi var ya hani? Nihayet çözdüm onu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290237
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290237,
					"content": "Duyu paylaşmak farklı kişilerin bilinçleri arasında iletişim kurma imkanı sunuyor. Bu sürece anılar da dahil oluyor tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290238
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290238,
					"content": "Zamanında bunu bilmiyordum tabii ama ikimizde de \"anıların rengi\"ni görme yetisi var. Yani seninle duyumu paylaştığımda hafızalarımız arasında bir bağ oluştu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290239
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290239,
					"content": "Bu bağ yüzünden büyüm kafayı yedi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290240
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290240,
					"content": "Yani... Birbirinizin anılarında iz bıraktığınız için mi duyabiliyorsun Gezginin düşüncelerini?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290241,
					"content": "#{NICKNAME} aynı şekilde bu yüzden duyuyordu seni! İki yönlü çalışıyor çünkü, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290242,
					"content": "Hızlı kavradın fakat yalnızca mistik sanatlarda eğitimli kişiler böyle bir bağı sürdürebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290243
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290243,
					"content": "#O yüzden ben {NICKNAME} ne düşünüyorsa duyabiliyorum fakat o beni duyamıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290244
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290244,
					"content": "Ama endişelenecek bir durum yok. Nasıl çalıştığını çözdüm şimdi, hemen kurtulacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290245
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290245,
					"content": "Ha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290246
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290246,
					"content": "(Yalan söyledim. Birbirimizin düşüncelerini duyabilmemiz, anılarımızın arasındaki bağlantının gücüne bağlı.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290247
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290247,
					"content": "(Dolayısıyla tüm o yaşadıklarımızdan sonra eminim beni tekrar duyabiliyorsundur.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290248
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290248,
					"content": "(!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290249
					]
				},
				{
					"id": 150290249,
					"content": "(Biliyordum...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290250
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290250,
					"content": "(Bunu durdurmanın bir yolu var mı peki?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290251
					]
				},
				{
					"id": 150290251,
					"content": "(Anılarımız arasında bir kere bağlantı oluştuğu için etkiden kurtulmanın tek yolu birbirimizi unutmak.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290252
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290252,
					"content": "(...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290253
					]
				},
				{
					"id": 150290253,
					"content": "(Hehe, şaka yapıyorum... Kabilemde efsane olmuş bir şamanım ben, bu etkinin sebebini bildiğime göre çözümünü bulurum.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290254
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290254,
					"content": "(Biraz zaman alır ama. Şimdilik dayan.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290255
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290255,
					"content": "(Üstelik benim içim dışım bir. Utanç verici bir şey duyacak değilsin... Şey, birkaç kadeh içmediysem tabii.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290256,
						150290259
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290256,
					"content": "(Kapatabiliyor musun yani? Tüh...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290257
					]
				},
				{
					"id": 150290257,
					"content": "(Tüh mü? Bu telepati kaosunu olur da özlersen seninle yine duyularımı paylaşabilirim.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290258
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290258,
					"content": "(Söz vermiyorum ama. İnsan bazı şeyleri de kendine saklamalı.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290261
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 150290261,
					"content": "Iıı... Hı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150290259,
					"content": "(Kapatabiliyor musun yani? Sevindim.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150290260
					]
				},
				{
					"id": 150290260,
					"content": "(Evet, haklısın tabii. İnsan bazı şeyleri de kendine saklamalı.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150290261
					],
					"speakerTitle": "Citlali"
				}
			]
		},
