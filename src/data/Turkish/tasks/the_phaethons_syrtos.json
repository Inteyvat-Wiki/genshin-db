					"nextDialogs": [
						722440604
					]
				},
				{
					"id": 722440604,
					"content": "Aberaku no Mikoto'nun kendisi mi verdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440605
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440605,
					"content": "Çok garip. Ulusumuzun kurulduğu günlerde kendisinin çok önemli bir kişilik olduğunu hatırlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440606
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440606,
					"content": "Ancak Güneşin Çocuğu yönetimini devirmeye çalıştığı ve ihanet suçuna çarptırıldığı söylenmişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440607
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440607,
					"content": "Ondan aldığını söylüyorsan belki de arka planda anlayamadığım işler dönüyordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440608
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440608,
					"content": "Kader dizginin buraya gelmesine karar verdi... Ah, çocukların yüzleri sanki gözümün önünde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440609
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440609,
					"content": "Böylece başarısızlıklarımı telafi edebileceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440610
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440610,
					"content": "Gezgin, dizgini Mahaldeki havuzun içine yerleştir. Böylece ruhlarına yeniden hayat verebileceğimize eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440611
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440611,
					"content": "Evet, bu şekilde bir bütün olabilir ve sonraki hayatlarına sağlıklı bir şekilde devam edebilirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clymene"
