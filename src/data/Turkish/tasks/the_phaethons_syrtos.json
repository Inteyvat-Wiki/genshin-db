					"nextDialogs": [
						722440304
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440304,
					"content": "Yabancı diyarın Gezgini, senden çok şey istediğimin farkındayım. Ancak lütfen çocukların ruhu huzura kavuşurken orada ol.",
					"roleType": "TALK_ROLE_NPC",
