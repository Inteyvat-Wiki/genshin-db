			"dialogs": [
				{
					"id": 722440401,
					"content": "Ah, Gezgin. Sonunda geldin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440402
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440402,
					"content": "Burası Ruh Rehberinin Mahalli, son düşüncelerimin olduğu yer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440403
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440403,
					"content": "Güneşin Çocukları belli bir yaşa geldiklerinde bir törene uygun olarak doğum günlerinde Dainichi Mikoshi'ye girerlerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440404,
						722440405
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440404,
					"content": "Girerdi mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440406
					]
				},
				{
					"id": 722440406,
					"content": "Evet, bu sürecin adı Güneşe Dönüş Ayiniydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440407
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440407,
					"content": "Güneşin Çocukları Dainichi Mikoshi'den doğar ve ölümlü dünya saflıklarına zarar veremeden tekrar güneşe dönerlerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440408
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440408,
					"content": "Dainichi Mikoshi o kadar sıcaktı ki tüm Byakuyakoku'yu ısıtabiliyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440409
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440409,
					"content": "Güneşin Çocukları ise sonunda ruhlarını parça parça Ruh Rehberinin Mahalline teslim ediyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440410
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440410,
					"content": "Hâlâ inanıyorum, belki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440411
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440411,
					"content": "Belki ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440412
					]
				},
				{
					"id": 722440412,
					"content": "Mahalli açan ben olsaydım belki hatıralarımı kullanarak ruhlarından geri kalanları tamamlayabilirdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440426
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440426,
					"content": "Denememe izin ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440427
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440427,
					"content": "Piramumon... Orupeusu... İşte, buradayım. Dönmeyecek misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440428
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440428,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440429
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440429,
					"content": "Nasıl gitti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440430
					]
				},
				{
					"id": 722440430,
					"content": "*iç çeker* Güneşin yedi çocuğundan Piramumon ve Orupeusu elimde büyümüşlerdi. Onlar bile dönmeyecekse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440413
					],
					"speakerTitle": "Clymene"
				},
				{
