			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clymene"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722441201,
					"content": "Ah, Piramumon. Kitapları çok severdin, bilmediğimiz bir dünya var derdin de sana inanmazdım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441202
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441202,
					"content": "Çılgın sözlerine hep gülümser ve kafa sallardım. Yazık, çok yazık! Sana inanmalıydım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441203
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441203,
					"content": "Bir gün Dainichi Mikoshi'den kaçıp bilmediğimiz diyarları keşfedecektin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441204
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441204,
					"content": "Git şimdi Piramumon. Bir daha kimsenin seni engellemesine izin verme. Git ve özgür ol!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441205
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441205,
					"content": "Ve sen, Orupeusu... Tekrar şarkı söylediğini duymak için neler vermezdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441206
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441206,
					"content": "Senin o temiz, saf sesini kimse duyamadı. Söylediğin şarkılara kimse içtenlikle eşlik etmek istemedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441207
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441207,
					"content": "Güneşe Dönüş Ayininden önceki gece bir anda sesimi duymak istedin. Ne olursa olsun sana şarkı söylememi istedin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441208
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441208,
					"content": "Ne kadar kötü söylersem söyleyeyim gülmeyeceğine söz verdin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441209
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441209,
					"content": "Biliyordun değil mi? Güneşe Dönüşünün sonun olacağını biliyordun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441210
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441210,
					"content": "Yine de ben... O zaman bile ben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441211
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441211,
					"content": "Clymene?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722441212
					]
				},
				{
					"id": 722441212,
					"content": "Özür dilerim Gezgin. Bu benim ayıbımdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441213
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441213,
					"content": "Güneşin Çocuklarına hizmet eden kadın yetkili saflığını korumalıdır. Asla evlenemez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441214
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441214,
					"content": "Bu nedenle kendi çocuğum olmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441215
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441215,
					"content": "Hizmet ettiğim ve büyümelerini izlediğim bu çocuklar... Bir noktada bana kendi kanımdan yakın oldular.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441216
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441216,
					"content": "Teşekkür ederim Gezgin. Dizgini bulduğun için sağ ol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441217
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441217,
					"content": "Her Güneşin Çocuğunun elinden geçti ve onlardan aldığı hatıralar ruhlarındaki boşlukların tamamlanması için yeterlidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441218
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441218,
					"content": "Her ne kadar bu hatıralar çift taraflı olsa da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441219,
						722441220
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441219,
					"content": "Çift taraflı mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722441221
					]
				},
				{
					"id": 722441221,
					"content": "Elbette. Bu durumda hatıralar çift taraflı. Bir tarafta kendi hatıraların var, öbür tarafta ise diğerlerinin seninle olan hatıraları var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441222
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441222,
					"content": "Bu nedenle boşluklar hem dizgine kazınan Güneşin Çocuklarının kendi hatıralarıyla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441223
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441223,
					"content": "Hem de günahın çocuğu haline getirilerek onları suçlayan Byakuyakoku halkının onlar hakkındaki hatıralarıyla doluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441224
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441224,
					"content": "Benim hatıralarım yetersizdi. Bu nedenle insanlarımızın hatıralarıyla desteklemek zorunda kaldım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441225
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441225,
					"content": "Byakuyakoku halkı onları üzerlerine yıkılan suçlar nedeniyle hatırlıyor; artık ruh yansımalarını geride bırakabilirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441226
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441226,
					"content": "Sağ ol Gezgin. En büyük dileğimi gerçekleştirdin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441227
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441227,
					"content": "Sonunda... Rahata erebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722441228
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441228,
					"content": "Evet... Yeniden o çocuklarla olabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722441220,
					"content": "Hatıraların tarafı mı var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722441221
					]
				}
			]
		},
