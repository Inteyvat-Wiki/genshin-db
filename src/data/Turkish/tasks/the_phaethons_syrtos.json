			},
			"dialogs": [
				{
					"id": 722440101,
					"content": "Hımm? Ne kadar garip. Senin gibi giyinen birini uzun yıllardır görmemiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440102
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440102,
					"content": "Duruşuna bakılırsa Byakuyakoku'dan olmadığın da açık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440103
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440103,
					"content": "Uzaklardan gelip buraya düşmüş bir misafir misin acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440104
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440104,
					"content": "Aşağı yukarı öyle...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440105
					]
				},
				{
					"id": 722440105,
					"content": "Byakuyakoku'ya dış dünyadan erişimin olması... Buna cidden çok şaşırdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440106
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440106,
					"content": "Ben burada doğdum, bugüne kadar da dış dünyadan kimseyi görmemiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440107
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440107,
					"content": "Zamanında biri bana dış dünyaya bir göz atmak istediğini söylemişti de latife ediyor diye düşünmüştüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440108
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440108,
					"content": "*iç çeker*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440109
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440109,
					"content": "Gezgin. Açıkçası senden küçük bir isteğim var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440110
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440110,
					"content": "Byakuyakoku'da \"Güneşin {RUBY#[S]Phaetonlar}Çocukları\"nın gömüldüğü yedi tane kraliyet mezarı var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440111
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440111,
					"content": "Güneşin Çocukları...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440112,
					"content": "Aynen öyle. Biz Dainichi Mikoshi'ye tapıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440113
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440113,
					"content": "Belirli bir süreden sonra bir çocuk Güneşin Çocuğu olarak seçilir ve tahta geçer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440114
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440114,
					"content": "Şimdiye kadar toplam... Yedi Güneşin Çocuğu oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440115
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440115,
					"content": "Ey başka diyardan gelen Gezgin, lütfen mezarlarını ziyaret et ve onlara saygılarını sun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440116
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440116,
					"content": "Bu iş için neden bizim gibi yabancılara ihtiyacınız var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440117,
					"content": "Normalde bu saygı sunma işini ailesi ve arkadaşları yapmaz mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440118,
					"content": "Haklısın, normalde öyle olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440119
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440119,
					"content": "Korkarım ki bu ulustan kimse saygısını sunmak istemiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440120
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440120,
					"content": "Hatta çok uzun zamandır kimsenin mezarlara gitmediğini düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440121
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440121,
					"content": "İyi de neden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440122,
					"content": "Bu ulusun insanları Güneşin Çocuklarını sevmiyorlar mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440123,
					"content": "\"Sevmemek\" biraz hafif kalır, hissettikleri duyguya \"nefret\" desek daha doğru olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440124
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440124,
					"content": "Daha önce de dediğim gibi Güneşin Çocukları bu rolü yerine getirmek için doğdular.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440125
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440125,
					"content": "Saf bir çocuk nasıl bir ulusu yönetebilir? Aslında perdenin ardındaki güçlü insanlar her şeyi yönetiyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440126
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440126,
					"content": "Güneşin Çocukları birer kuklaydı. İpleri ise bu kişilerin elindeydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440127
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440127,
					"content": "İpleri ellerinde tutmalarına rağmen bu güçlü insanlar açgözlülükte sınır tanımadılar. Halkın emeğini bu insanlar sömürdü, Güneşin Çocuklarını ise pis işlerine alet ettiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440128
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440128,
					"content": "Gün geçtikçe insanlar daha da öfkelendi ve bu günahların sorumluluğu da Güneşin Çocuklarına atıldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440129
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440129,
					"content": "Bu korkunç...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440130,
					"content": "Güneşin Çocukları masumdu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722440131,
					"content": "Masum mu? Yok, hayır. Değillerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440132
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440132,
					"content": "Byakuyakoku halkına göre en büyük günah bu çocukların cahilliğiydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440133
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440133,
					"content": "İşlenen bir günah insanlara zarar verir, işleyen farkında olsa da olmasa da... Bu suçları işleyen bir insan nasıl masum olabilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440134
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440134,
					"content": "Zor olurdu, değil mi? Olan olduktan sonra ne yapılabilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440135,
						722440136
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440135,
					"content": "Böyle düşünüyorsan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440137
					]
				},
				{
					"id": 722440137,
					"content": "Sanırım duygularım bana bunu söyletiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440138
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440138,
					"content": "Adım Clymene. Dainichi Mikoshi'de Güneşin Çocuklarının gündelik hayatlarından sorumlu kadın yetkiliydim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440139
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440139,
					"content": "Her ne kadar hata yaptıklarını ve manipüle edildiklerini bilsem de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440140
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440140,
					"content": "Yine de onlar gözlerimin önünde büyüyen çocuklardı. Onlara acıdım, üzüldüm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440141
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440141,
					"content": "Ancak asla nefret etmedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440142
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440142,
					"content": "İşimden dolayı her gün onların etrafında olsam da ağır gözetim altındaydım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440143
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440143,
					"content": "O çocukların yanındayken ağzımı açmam bile yasaktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440144
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440144,
					"content": "Kimsecikler yokken, yardıma muhtaç ve korkmuş hissettiklerinde bana o kadar çok şey söylüyorlardı ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440145
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440145,
					"content": "... Cevap olarak bir kelime bile edemiyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440146
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440146,
					"content": "Kendimi feda etme pahasına cesaretimi toplayıp bir şeyler söyleseydim belki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440147
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440147,
					"content": "Belki her şey farklı olurdu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440148
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440148,
					"content": "Lütfen, sana yalvarıyorum. Bu halimle onlarla yüzleşemem. Onları onurlandırmamın tek yolu bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440149
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440149,
					"content": "Lütfen kalbi güzel Gezgin, bana yardım et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440150
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440150,
					"content": "Sadece mezarlarına birer Sango İncisi bırakmanı istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440153
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440153,
					"content": "Böylelikle buradaki taş tapınağın Ruh Lambalarını yakabilecek, Ruh Rehberinin Mahalline gidebilecek ve ruhlarını huzura kavuşturacaksın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722440151
					],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440151,
					"content": "Tamam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440152
					]
				},
				{
					"id": 722440152,
					"content": "Teşekkür ederim. Sana güveniyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clymene"
				},
				{
					"id": 722440136,
					"content": "Neden hâlâ bizim onlara saygı göstermemizi istiyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722440137
					]
				}
			]
