			},
			"dialogs": [
				{
					"id": 80000101,
					"content": "Evet, evet. Hiçbir şeyin peşine düşmekten çekinmiyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000102
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 80000102,
					"content": "Yediler, ejderler, tanrılar... Bunlarla alakası olan hiçbir kadim yadigar onların açgözlü emellerinden kurtulamaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000103
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 80000103,
					"content": "Yine de bu kez farklı... Hiçlik Tarikatının hazinelerinin peşine düşerek kim olduklarını sanıyorlar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000104
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 80000104,
					"content": "Ah, Gezgin, sen miydin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000105
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 80000105,
					"content": "Hı? Ganyu, Lahn ile burada ne yapıyorsunuz? Vermek istediğin bir görev mi var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000106,
					"content": "#Merhaba, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000107
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000107,
					"content": "Biz de tam Hazine Avcılarından bahsediyorduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000108
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000108,
					"content": "Evet, cüretkar Hazine Avcılarının bile Hiçlik ile uğraşmaması gerektiğini konuşuyorduk. Bu çok yanlış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000109
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 80000109,
					"content": "Ama Sivil İşler Bakanlığından aldığımız habere göre Liyue ve Mondstadt'taki iki büyük Hazine Avcısı ortak bir operasyon planlıyorlarmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000110
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000110,
					"content": "\"İki büyük Hazine Avcısı\" mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000111,
					"content": "Evet, \"Güney'in Ablası\" ve \"Kuzey'in Avcısı\" adlarıyla biliniyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000112
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 80000112,
					"content": "Aa! Avcı! Paimon, onun Mondstadt'ta Amber'dan kaçtığını hatırlıyor... Ama \"Güney'in Ablası\" da kim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000113,
						80000114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000113,
					"content": "\"Abla\" derken, çevresindekilere kabadayılık mı yapıyor yani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000116
					]
				},
				{
					"id": 80000116,
					"content": "Haklısın. Kendisi Liyue'deki Hazine Avcılarının başıdır. Anladığıma göre tüm Hazine Avcıları ona \"Patron\" diyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000117
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 80000117,
					"content": "Kimilerine göre de Hırsızlar Tanrısı ona maceralarında kullanması için bir yetenek bahşetmiş ve \"Güney'in İlahi Ablası\" olmuş... Tabii bu muhtemelen uçuk bir dedikodudan ibaret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000118
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 80000118,
					"content": "Her neyse; Hazine Avcıları, Hiçlik Tarikatının kapalı kapılar ardında koruduğu ve daha önce keşfedilmemiş bazı harabeler keşfetmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000119
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000119,
					"content": "Durumun tehlikesine rağmen, tüm Hazine Avcılarının düşündüğü tek şey içeride bulabilecekleri türlü hazineler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000120
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000120,
					"content": "Planları bile hazır; Hiçlik Tarikatı birliklerini harabelerden uzaklaştıracak bir aldatma ekibi yollayacaklar. Sonrasında da hazineyi çalması için uzman bir hırsızı içeri gönderecekler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000121
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000121,
					"content": "Bunun için de Abla ve Avcı duyumlara göre Fontaine'den \"Yüce Hırsız\"ı kiralamışlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000122
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 80000122,
					"content": "\"Yüce Hırsız\" mı? Oldukça etkileyici bir unvan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000123,
					"content": "Öyle. Olağanüstü birisidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000124
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 80000124,
					"content": "Yüce Hırsız, Hazine Avcıları arasında çok saygı duyulan biri, tıpkı biz maceracıların büyük maceracılara gıptayla baktığı gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000125,
						80000127
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 80000125,
					"content": "Tıpkı meşhur maceracı Alice gibi mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000126
					]
				},
				{
					"id": 80000126,
					"content": "Ah, Teyvat Seyahat Rehberinin yazarını tanıyorsun öyleyse? Doğru, Yüce Hırsız onun kadar bilinen birisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000129
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 80000129,
					"content": "Pekala, her ne kadar Liyue ve Mondstadt'taki en büyük isimler olsalar da Abla ve Avcı onun seviyesindeki bir hırsızı aralarına katmak ve şahsen bu operasyonu yönetmeye ikna etmek için çok çaba harcadılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000130
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 80000130,
					"content": "Yakın zamanda Liyue'de meydana gelen büyük değişikliklerle birlikte Sivil İşler Bakanlığı ve Taşordu'nun işi başından aşkın. Hazine Avcısına dair ortalıkta dolaşan söylentilerle uğraşmaya vakitleri yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000131
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000131,
					"content": "Lakin, Hiçlik ile alakalı her şey bana derinlerde bir yerde bilinmeyen bazı tehditlerin olduğu hissini veriyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000132
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000132,
					"content": "O yüzden ben de Maceracılar Loncasına görev ilanı vermek için geldim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000133,
						80000134
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000133,
					"content": "Pekala, burada olduğuma göre...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000135
					]
				},
				{
					"id": 80000135,
					"content": "Evet! Bu görevi bize verin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80000136,
					"content": "Ah, çok teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000137
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 80000137,
					"content": "Bu işin güvenilir bir Lonca üyesine verildiğini görmek güzel. Peki öyleyse, bol şans. Lonca bu görevin detaylarıyla ilgilenecektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lahn"
				},
				{
					"id": 80000134,
					"content": "Ben de Hiçliğin ne kadar tehlikeli olduğunu anlıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000135
					]
				},
				{
					"id": 80000127,
					"content": "Aynı büyük maceracı Stanley gibi mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000128
					]
				},
				{
					"id": 80000128,
					"content": "Ah, yaşayan efsaneyle Mondstadt'ta iken tanıştınız mı? Doğru, Yüce Hırsız onun kadar bilinen birisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000129
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 80000114,
					"content": "Hazine Avcılarının bahsettiği \"Patron\" mu o?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80000115
					]
				},
				{
					"id": 80000115,
					"content": "Öyleyse zaten bir şeyler biliyorsunuz. Sanırım daha önce birçok kez Hazine Avcılarıyla yolunuz kesişmiştir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80000116
					],
					"speakerTitle": "Lahn"
				}
			]
		},
		{
			"id": 800002,
