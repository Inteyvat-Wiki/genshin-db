			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Liloupar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732820601,
					"content": "Kahretsin, Masseira gitmiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732820602,
					"content": "Hıh, o kurnaz yaşlı tilki arkasında bir de not bırakmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820603
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 732820603,
					"content": "Sen bu notu gördüğünde, ben vadideki bir güvenli eve çoktan yerleşmiş olmalıyım.\\nBaşın hâlâ omuzlarının üzerindeyse Tadhla'nın yaptığı seçime ağlama.\\n\\nBu av henüz sona ermedi. Bu sadece fırtınanın başlangıcıydı.\\nTanit'in avcısı ve büyüğü Masseira, seni bu şekilde uyarıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820604
					],
					"speakerTitle": "Araştır"
				},
				{
					"id": 732820604,
					"content": "Ne? Tüm bunlarla neyi kastediyor? Paimon anlamadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732820605,
					"content": "Birtakım baskılar altında kabileden kaçmış ve sana bu notu bırakmış gibi görünüyor. Hıh, Tanit kesinlikle göründüğü kadar huzurlu değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Liloupar"
				}
			]
		},
		{
			"id": 7328228,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
