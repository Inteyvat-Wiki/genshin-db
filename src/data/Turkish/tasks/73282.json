			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tadhla"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732820401,
					"content": "Gelmişsin. Seni burada gördüğüme çok sevindim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820402,
						732820403
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732820402,
					"content": "Benimle konuşmak istediğini duydum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820404
					]
				},
				{
					"id": 732820404,
					"content": "Günün bu saatinde çölü hep sevmişimdir. Çok güzel oluyor. En sevdiğim manzara bu işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820405
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732820405,
					"content": "Ama ne yazık ki gün batımını arkadaşlarımla birlikte izleme şansım hiç olmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820406
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732820406,
					"content": "Evet... Çöl, gün batımının rengine bürünmüş. Ne kadar da huzurlu ve sessiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732820407,
					"content": "İyi de Tadhla, sen bizi buraya bunun için mi çağırdın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732820408,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820409
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732820409,
					"content": "Tanit'e göre sen misafirsin. Şahin içinse potansiyel bir avsın. Umarım hayatta kalacak olan sen olursun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732820410
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732820410,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820411
					]
				},
				{
					"id": 732820411,
					"content": "O yüzden özür dilerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732820403,
					"content": "Nasıl gidiyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732820404
					]
				}
			]
		},
		{
