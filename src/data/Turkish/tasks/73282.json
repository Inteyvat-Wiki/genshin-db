			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tadhla"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732822801,
					"content": "(Tadhla göz teması kurmaktan kaçınıyor ve gergin bir şekilde başını öne eğiyor.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822802,
						732822805
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822802,
					"content": "İyi misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822803
					]
				},
				{
					"id": 732822803,
					"content": "Özür dilerim, av sona erdi. Ben babamın \"Şahin\"iyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822804
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822804,
					"content": "Ama kendimi harika hissediyorum. Benim için endişelenme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822808,
						732822810
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822808,
					"content": "Bu çok aşırı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822809
					]
				},
				{
					"id": 732822809,
					"content": "Aşırı mı? Bilmem, çocukluğumdan beri hep böyle yaşadım ben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822814
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822814,
					"content": "Şey... Ama seninle Paimon'un hikayeleri ve ikinizin yaşadığı maceralar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822815
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822815,
					"content": "Fırsat olursa gerçekten onlardan daha fazlasını duymak isterim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822816
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822816,
					"content": "Hiç sorun değil! Anlatacak bir sürü hikayemiz var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822817,
						732822818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732822817,
					"content": "Evet, sana hepsini anlatacağım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822819
					]
				},
				{
					"id": 732822819,
					"content": "Off...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822820
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822820,
					"content": "#Öhöm, özür dilerim. Çok mutlu oldum. Teşekkürler Cin Efendisi. Yani şey, teşekkür ederim {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822818,
					"content": "İstediğin zaman anlatabilirim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822819
					]
				},
				{
					"id": 732822810,
					"content": "Hiç biraz da kendin için yaşamayı düşünmedin mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822811
					]
				},
				{
					"id": 732822811,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822812
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822812,
					"content": "Hayır hiç düşünmedim. Hiçbir zaman böyle bir düşünceye veya beklentiye girmedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822813
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822813,
					"content": "Çöl, kendi iyiliğimi düşünecek vaktimin olmadığı, umursamazlık ve gaddarlıkla dolu bir yerdir. Kabilem, bensiz de aynı şekilde yaşamaya devam edecektir. Ancak kabilem olmadan benim hayatta kalmam mümkün değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822814
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822805,
					"content": "Masseira ile olan ilişkiniz hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732822806
					]
				},
				{
					"id": 732822806,
					"content": "Dediğim gibi, o benim babam ve ben de onun Şahiniyim. Onun emirlerini yerine getiriyorum. Onun için avlanıyor ve onun için hayatımı riske atıyorum çünkü o Tanit'in iradesini temsil ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822807
					],
					"speakerTitle": "Tadhla"
				},
				{
					"id": 732822807,
					"content": "Babamın emirlerini tam olarak yerine getiremeyeceğim gün geldiğinde, o zaman benim de hayatım bir Şahin olarak sona erecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732822808,
						732822810
					],
					"speakerTitle": "Tadhla"
				}
			]
		},
		{
			"id": 7328229,
