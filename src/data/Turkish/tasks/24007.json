			"dialogs": [
				{
					"id": 240070101,
					"content": "Lovi, iyi bir şey bulabildin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070102
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070102,
					"content": "Hayır, burada hiçbir şey yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070103
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070103,
					"content": "Ne yapıyorsunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070104
					]
				},
				{
					"id": 240070104,
					"content": "Hazine arıyoruz! Hehe... Bize katılmak ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070105,
						240070108
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070105,
					"content": "Hazine mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070106
					]
				},
				{
					"id": 240070106,
					"content": "Sen Verut'a kulak asma. Birkaç parça arıyoruz o kadar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070107
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070107,
					"content": "Demek parçalar hazine oldu... Ha? Burada biraz olmalı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070114
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070114,
					"content": "Sanırım burada bir şey bulamayacağız. Başka bir yere gitsek mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070115
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070115,
					"content": "Tamam! Hadi biraz daha ileriye gidelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070116,
						240070117
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070116,
					"content": "Ben de sizinle geleceğim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070118
					]
				},
				{
					"id": 240070118,
					"content": "Vay be, aynı abim gibi konuşmaya başladın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070119
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070119,
					"content": "Pekala, o zaman biraz daha uzağa yürüyelim. Buradaki sularda birçok parça olduğuna eminim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070117,
					"content": "Kafanıza estiği gibi her yere gitmemelisiniz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070118
					]
				},
				{
					"id": 240070108,
					"content": "Aurele nerede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070109
					]
				},
				{
					"id": 240070109,
					"content": "Bay Delerue'ya birkaç soru sormaya gitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070110
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070110,
					"content": "Bizim de uslu uslu oturup... Hazine aramamız gerekiyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070111
					],
					"speakerTitle": "Verut"
				},
				{
