			"dialogs": [
				{
					"id": 240070501,
					"content": "Bir bakayım... Bu dişliyi kullanabiliriz, bu rulmanı da açabilirsek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070502
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070502,
					"content": "Bunları ne için arıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240070503
					]
				},
				{
					"id": 240070503,
					"content": "Kendi kurmalı kuklamı yapmak istiyorum. Aslında bu konuyu bir süredir gizlice araştırıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070504
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070504,
					"content": "Nasıl yapıldığını bir çözeyim kocaman bir Kurmalı Meka yapacağım. Babam çok şaşıracak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070505
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070505,
					"content": "Odasında bir sürü kitap okudum ve kitaplarda yazan talimatları takip ederek bazı temel parçaları yaptım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070506
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070506,
					"content": "Uğraşmaya devam ettikçe bu mekayı tamamlayacağıma eminim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070507
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070507,
					"content": "Ancak bu şeyleri şehirde araştıramıyorum, yoksa babam anlar ve sürpriz mahvolur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070508
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070508,
					"content": "İşte burası bu şekilde Lovi'nin gizli Kurmalı Meka araştırma üssü oldu. Bana gelince... Ben de onun asistanıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070509
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240070509,
					"content": "Asistanım, konuşarak daha fazla vakit kaybetmeyelim! Araştırmamıza başlamamızın zamanı geldi. Bugün hareket edebilen mekanik bir kol yapmamız lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240070510
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240070510,
					"content": "Pekala hanımefendi! Hadi araştırmamıza başlayalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				}
			]
