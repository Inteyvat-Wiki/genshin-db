			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Iaanesh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730190401,
					"content": "Merhaba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190402,
					"content": "Merhaba... Nasıl yardımcı olabilirim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190403
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190403,
					"content": "Biz bir şey almak istiyorduk da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190404,
					"content": "Hehe, istiyorsunuzdur tabii. Herkes buraya \"bir şey\" almaya gelir ama yalnızca \"bir şey\" derseniz, ben o \"şeyin\" ne olduğunu anlayamam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190405
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190405,
					"content": "Ha... Doğru. O zaman Paimon şöyle anlatsın, bizim istediğimiz şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190406,
					"content": "Beyaz ve küp şeklinde...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190407
					]
				},
				{
					"id": 730190407,
					"content": "Beyaz ve küp şeklinde mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190408
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190408,
					"content": "Evet, ayrıca bastırınca kum gibi ufalanıyor. Hem de sert bir baloncuk içinde tutulması gerekiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190409,
					"content": "Ne kadar garip bir tasvir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190410
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190410,
					"content": "Anlattıklarınızdan ne olduğu anlaşılmıyor doğrusu. Bu beyaz ve küp şeklindeki şey ne işe yarıyormuş peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190411
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190411,
					"content": "Kullanım amacı peki. Ne için kullanıldığını biliyorsunuz, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190412,
						730190414
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190412,
					"content": "Yenilebiliyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190413
					]
				},
				{
					"id": 730190413,
					"content": "Yenilebilir, beyaz ve küp şeklinde bir şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190416
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190416,
					"content": "Hah! Şimdi anladım! İstediğiniz şeyi biliyorum... Hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190417
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190417,
					"content": "Neresi komik bunun şimdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190418,
					"content": "Haha, hahaha! Beyaz, küp şeklinde, bastırınca ufalanıp kum gibi oluyor... Üstelik yenilebiliyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190419
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190419,
					"content": "Bildiğimiz \"şeker\" işte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190420
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190420,
					"content": "Sert baloncuk... Şekerin durduğu cam kavanozdan mı bahsediyorsunuz? Tanrım! Sert baloncuk! Hahahahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190421
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190421,
					"content": "Ne? Şeker miymiş yani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190422,
						730190423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190422,
					"content": "Utandım şimdi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190424
					]
				},
				{
					"id": 730190424,
					"content": "Gülmekten gözümden yaş geldi. Son birkaç yıldır işime o kadar odaklanmıştım ki en son ne zaman bu kadar güldüm hatırlamıyorum bile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190425
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190425,
					"content": "Şeker deyince çocukluk anılarım canlandı. Uzun zaman önce, daha çocukken bir arkadaşım vardı. O da ilk kez şeker yedikten sonra sizinle aynı şeyleri söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190426
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190426,
					"content": "\"Bu küp şeklindeki beyaz şey çok lezzetli! Mükemmel! Mutluluğun tadı meğerse buymuş!\" demişti. O da çok şaşırmıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190427
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190427,
					"content": "Haha... Tabii bu uzun zaman önceydi. Bahsettiğim arkadaşımın şu an yüzünü bile hatırlayamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190428
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190428,
					"content": "Hah, beni bu kadar güldürdüğünüz için bu şeker kavanozunu size hediye olarak vereceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190429
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190429,
					"content": "Teşekkürler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190430
					]
				},
				{
					"id": 730190430,
					"content": "Dikkatli tutun. Sert baloncuk sert olsa da düşünce kırılabilir. \"Sert baloncuk\"! Hahahahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190423,
					"content": "Rezil olduk...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190424
					]
				},
				{
					"id": 730190414,
					"content": "Yemek yaparken kullanılıyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190415
					]
				},
				{
					"id": 730190415,
					"content": "Beyaz ve küp şeklinde, yemek yaparken kullanılan bir şey... Baharat falan mı acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190416
					],
					"speakerTitle": "Iaanesh"
				}
			]
		},
		{
			"id": 7301905,
