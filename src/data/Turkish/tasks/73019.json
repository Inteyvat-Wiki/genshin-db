			},
			"dialogs": [
				{
					"id": 730190501,
					"content": "Ben, uzun yıllardır Kanyon ve Sumeru arasında ticaret yapan bir aileden geliyorum. Nadir bulunan cevherleri Liyue'den ithal ediyoruz ve oraya baharat ihraç ediyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190502
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190502,
					"content": "Tam olarak neden olduğunu hatırlayamıyorum ama... Bir keresinde babam beni çok uzun bir süreliğine Gandharva'da bırakmıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190503
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190503,
					"content": "Ormanda olduğumu hatırlıyorum, orada bir arkadaş edinmiştim. Birlikte etrafta koşturup duruyorduk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190504
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190504,
					"content": "Daha sonra neler olduğunu hatırlamıyorum. Arkadaşımın adını da unuttum, yüzünü de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190505
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190505,
					"content": "O sıralarda çok mutlu olduğumu hatırlıyorum. Daha sonra babam geri gelip beni almıştı. Bir ara dönüp arkadaşımı bulmayı bile düşünmüştüm ama bir türlü fırsat bulamadım. Sonra da zaten aklımdan çıkıverdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190506
					],
					"speakerTitle": "Iaanesh"
				},
				{
					"id": 730190506,
					"content": "Siz gelip benden şeker istemeseydiniz, bunların hepsini unutacaktım. Neden böyle oldu acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaanesh"
				}
			]
		},
		{
			"id": 7301906,
			"completionStepIds": [
				7301906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301906",
							"2"
						],
						"stepId": 7301906,
