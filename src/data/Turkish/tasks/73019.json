			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730190201,
					"content": "Ayy! Nara... Ne kadar uzun, ne kadar korkunç...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190202
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190202,
					"content": "Lütfen, yalvarıyorum... Sakın koparmayın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190203
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190203,
					"content": "Merak etme, koparmayız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190204,
					"content": "Harika. Hehe... Bu Zaytun Şeftalilerini küçücük birer çekirdekti, hepsini milim milim ben yetiştirdim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190205
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190205,
					"content": "Bir dakika, hayır! Kötü Naralar sizi! Başkasının Zaytun Şeftalilerine bunu nasıl yaparsınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190206
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190206,
					"content": "N-Naraların neden böyle kötü bir huyu var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190207
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190207,
					"content": "Biz bir şey yapmadık ki! Şeftalileri dalından biz toplamadık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190208,
					"content": "Siz bir şey yapmamışken bile durum yeterince korkunç. Üstüne bir de siz bir şey yapmış olsaydınız, korkudan ölürdüm herhalde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190209
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190209,
					"content": "Yok artık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190210,
					"content": "Hayır, hayır Arasaka... Düşünsene, aşçılık eğitimin için bu Zaytun Şeftalilerine ne kadar çok emek verdin... Şimdi geri adım atamazsın. Hayır, korkmuyorsun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190211
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190211,
					"content": "Arasaka sensin yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190212,
					"content": "Sen... A-Adımı nereden biliyorsunuz? Siz Naralar nereden geliyorsunuz böyle? Beni görür görmez adımı bildiniz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190213,
						730190216
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190213,
					"content": "Kendin söyledin ya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190214
					]
				},
				{
					"id": 730190214,
					"content": "Ah, benim düşük çenem! Her şey bitti! Artık adım korkunç lanetlerde anılacak... Lütfen, lütfen beni bağışlayın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190215
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190215,
					"content": "Zaytun Şeftalilerini veremem ama onun dışında her şeyi yaparım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190219
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190219,
					"content": "Sakin ol. Buraya Arapacati'nin isteği üzerine geldik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190220,
					"content": "Ara-Arapacati mi? Ah, benim biricik \"kız kardeşim\", gür ormanlara düşen gün ışığım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190221
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190221,
					"content": "Arasaka'ya olanları anlatıyorsun...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730190222
					]
				},
				{
					"id": 730190222,
					"content": "Utsava Festivali ne ara gelip çattı... Aa, yoksa siz festivale katılmaya gelen Naralar mısınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190223
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190223,
					"content": "Size kötü Nara dediğim için özür dilerim. Siz iyi Naralarsınız çünkü yalnızca iyi Naralar Vanarana'ya gelip Utsava Festivaline katılabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190224
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190224,
					"content": "Utsava Festivali yaklaşıyor. Aşçılık eğitimimi tamamlamadan Vanarana'ya dönersem... Olmaz, hayır... Gerçi Utsava Festivalini de kaçıramam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190225
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190225,
					"content": "Neden bu kadar çok gerildin ki? Elinde ektiğin Zaytun Şeftalilerinden yok mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190226,
					"content": "B-Bu kadar yetmez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190227
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190227,
					"content": "\"Mutluluğun tadı\" olmadan olmaz! O olmadan Zaytun Şeftalileri sıradan birer Zaytun Şeftalisi sadece...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190228
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190228,
					"content": "Arachatora, Arapas ve Araphala, \"mutluluğun tadının\" gerçek olduğuna inanmıyorlar. O yüzden yapıp onlara göstereceğim. Naraların da tadına bakmasını istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190229,
						730190230
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190229,
					"content": "\"Mutluluğun tadı\" mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190231
					]
				},
				{
					"id": 730190231,
					"content": "Hehe, \"mutluluğun tadı\"... Daha önce bir defa denemiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190232
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190232,
					"content": "\"Mutluluğun tadı\" beyaz bir şey, elini sürdüğünde ufalanmaya başlıyor... Beyaz Valuka'ya dönüşüyor ama Valuka kadar sert değil ve can yakmıyor. Ayrıca sert bir baloncuğun içinde depolanıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190233,
						730190234
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190233,
					"content": "Beyaz Valuka mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190235
					]
				},
				{
					"id": 730190235,
					"content": "Beyaz Valuka herhalde beyaz kum demek. Peki sert baloncuk dediği ne acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190236,
					"content": "Paimon bundan pek bir şey anlamadı. \"Mutluluğun tadını\" nereden bulabiliriz peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190237,
					"content": "B-Bunu neden soruyorsun? Yoksa benden önce gidip \"mutluluğun tadını\" almak mı istiyorsun? Ne kadar korkunç...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190238,
						730190239
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190238,
					"content": "Sadece sana yardım etmek istiyoruz...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190241
					]
				},
				{
					"id": 730190241,
					"content": "Bana yardım etmek mi? Ne için? Ben kendim hallederim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190242
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190242,
					"content": "Tek sıkıntı etrafta çok fazla Nara olması. Üstelik bir tanesi Nara Valuka gibi kokuyor. Üff, Çok fazla Nara! Çok korkunç... Ortalıkta daha az Nara olsa işimi halledebilirdim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190243
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190243,
					"content": "Evet, kendim gidip alamayacağım galiba... Gandharva'ya girmeye cesaretim yok. Orada çok fazla Nara ve bir sürü kurumuş ağaç var. Ödüm kopuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190244
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190244,
					"content": "Şehirde yaşayan bir Nara dostum var ama son görüşmemizin üzerinden epey zaman geçti. Kendisi çok değişti, artık sesimi duyamıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190245
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190245,
					"content": "Yani bu bahsettiğin \"mutluluğun tadı\" Gandharva'da var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190246
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190246,
					"content": "\"Mutluluğun tadı\" yerde yetişmez, Naralar tarafından yapılır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190247
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190247,
					"content": "O tadı bir kere daha denemeyi çok isterim. İlk denediğimde ne kadar mutlu olduğumu hâlâ hatırlıyorum. Muazzam bir tattı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190248
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190248,
					"content": "Nara dostumla ormandaydık, yaprakların arasından sızan ışık hüzmelerini sayıyorduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190249
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190249,
					"content": "Birlikte şarkı söyleyip \"mutluluğun tadını\" yemiştik. Dalların üzerine düşen güneş ışığını gördükçe, aklıma hep o Nara dostum geliyor. Onu her düşündüğümde de \"mutluluğun tadını\" hatırlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190250
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190250,
					"content": "O yüzden Arapacati'nin de bunu tatmasını istiyorum. Sonra Utsava Festivali başladığında, Naraların da tadına bakmasını istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190251
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190251,
					"content": "#Paimon anladı. O zaman bu işi {NICKNAME} ve Paimon'a bırak! Ne dersin {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190252,
						730190253
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190252,
					"content": "Ben de mutluluğun tadına bakmak isterim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190254
					]
				},
				{
					"id": 730190254,
					"content": "Gerçekten mi? Bana yalan söylemiyorsunuz, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190255
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190255,
					"content": "Hayır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190256
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190256,
					"content": "Gerçi Gandharva'da çok fazla insan var. İpucu bulmak için kime gitmemiz lazım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190257
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190257,
					"content": "Benim aklımda biri var. Kısa süre önce buradan geçip <color=#00E1FFFF>Gandharva'ya giden</color> bir Nara görmüştüm. Onun yanında vardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190258
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190258,
					"content": "Sırtında şişkin bir şey taşıyordu. Naralar, o şeyi eşyalarını taşımak için kullanıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190259
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190259,
					"content": "Sırtta taşınan şişkin bir şey... Hımm. <color=#00E1FFFF>Muhtemelen bir çanta veya küfedir</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190260
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190260,
					"content": "Anladım! Şimdi gidip \"mutluluğun tadını\" bulmana yardım edeceğiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190253,
					"content": "Zaten Arapacati'ye söz vermiştim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190254
					]
				},
				{
					"id": 730190239,
					"content": "Ah Paimon, ne kadar korkunç birisin!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190240
					]
				},
				{
					"id": 730190240,
					"content": "Ne? Paimon sadece Arasaka'ya yardım etmek istiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730190234,
					"content": "Sert baloncuk mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190235
					]
				},
				{
					"id": 730190230,
					"content": "Neymiş bu \"mutluluğun tadı\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190231
					]
				},
				{
					"id": 730190216,
					"content": "Biz bunu çoktan biliyorduk zaten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730190217
					]
				},
				{
					"id": 730190217,
					"content": "Ne dedin? Çoktan biliyor muydunuz? Demek uzun zamandır beni gözetliyordunuz... N-Ne istiyorsunuz benden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190218
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190218,
					"content": "Yoksa derdiniz Zaytun Şeftalileri mi? Hayır! Diğer her şeyi alabilirsiniz ama şeftalilerim olmaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190219
					],
					"speakerTitle": "Arasaka"
				}
			]
		},
