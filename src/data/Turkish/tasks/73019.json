			"dialogs": [
				{
					"id": 730190301,
					"content": "Ne oldu? \"Mutluluğun tadını\" buldunuz mu? Gandharva'da olması lazım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730190302
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730190302,
					"content": "Sırtında şişkin bir şey taşıyan bir Nara var. \"Mutluluğun tadı\" o şeyin içinde olsa gerek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arasaka"
				}
			]
		},
		{
			"id": 7301904,
			"completionStepIds": [
				7301904
