			"dialogs": [
				{
					"id": 766500301,
					"content": "Vay be, bu heykel kocamanmış... Evet tamam, kuşla veya gelincikle olacak iş değilmiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500302,
					"content": "Aynayı bile geçememişlerdir muhtemelen... Ee Lauma, bu heykel ne kadar değerli tam olarak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500303,
					"content": "Mora olarak mı? Pek değerli değildir sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500304
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500304,
					"content": "Hem tasarımı basit hem de oyulduğu taş buralarda çok sık bulunuyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500305
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500305,
					"content": "Fakat o dönemin Ay İlahicisi ve günümüz Donuk Ayın Çocukları için paha biçilemez bir hazine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500306
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500306,
					"content": "Hiç değilse artık varlığına dair somut bir kanıt var elimde. Bu konudaki bazı belgelerin güvenilirliğini doğrulamak için yeterli bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500307
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500307,
					"content": "Bu da benim için bu yolculuğu başarılı kılıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500308
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500308,
					"content": "#Yardımın için sağ ol {NICKNAME}. Sana dair fikrimde haklı çıkacağımı biliyordum. Ay Aynası senin için hiç engel teşkil etmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500309
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500309,
					"content": "Küçük dostumuz da senin mekanizma kullanma becerilerine hayran kaldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500310
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500310,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500311
					],
					"speakerTitle": "Hırsız Gelincik"
				},
				{
					"id": 766500311,
					"content": "Ne diyor Lauma?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500312,
					"content": "#{NICKNAME} kadar iyi bir hazine avcısını ömrü hayatı boyunca görmediğini söylüyor. Dünyadaki tüm hazine sandıklarını açma görevinde ona katılmak istiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500313,
						766500314
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500313,
					"content": "Of, adım hırsıza çıkacak...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500315
					]
				},
				{
					"id": 766500315,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500316
					],
					"speakerTitle": "Hırsız Gelincik"
				},
				{
					"id": 766500316,
					"content": "\"Artık açamadığım bir hazine sandığı bulursam seni çağırırım!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500317
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500317,
					"content": "Iı... Peki, görüşürüz o zaman... Bize tercih hakkı bile vermedi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500318,
					"content": "Merak etmeyin, her gün ağzında bir Morayla gelip cama vurarak sizi bir hazine avına sürüklemeye çalışmaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500319
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500319,
					"content": "Gecenin bir vakti odanızı ziyaret edip açamadığı kilitler için söylenmez de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500320
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500320,
					"content": "#Eyvah, bu gece uyumadan önce pencereleri ve kapıları kilitleyelim {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500321,
					"content": "Rahat olun. Gelincik yalnızca bir çocuk, zarar vermek gibi bir niyeti yok. Sadece... Çoğu gelincikten daha geveze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500322
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500322,
					"content": "Pekala, artık dönelim. Akşam yemeği vakti yaklaştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500323
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500323,
					"content": "Ayrıca bu heykeli kütüphanemize nasıl götüreceğimizi de çözmemiz gerekiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500324
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500324,
					"content": "... Küçük dostlarımın yardımına ihtiyacım olacak anlaşılan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500314,
					"content": "Gerçi bir sürü sandık açtım, doğru...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500315
					]
				}
			]
