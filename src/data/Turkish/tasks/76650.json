			"dialogs": [
				{
					"id": 766500101,
					"content": "~♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500102
					],
					"speakerTitle": "Uzun Tüylü Leylek"
				},
				{
					"id": 766500102,
					"content": "... Evet, eminim bir sürü dostun vardır fakat olay bu değil. Hiisi Adası'ndaki bütün leylekleri çağırsan bile Ay Aynası'nı yerinden oynatamazdın bence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500103
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500103,
					"content": "Bir şekilde başarsan bile içindeki Ay Sureti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500104
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500104,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500105
					],
					"speakerTitle": "Hırsız Gelincik"
				},
				{
					"id": 766500105,
					"content": "... Kazmak mı? Hımm. Olabilir ama Aynayı hareket ettirmek sana bile zor gelirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500106
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500106,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500107
					],
					"speakerTitle": "Uzun Tüylü Leylek"
				},
				{
					"id": 766500107,
					"content": "Ne? Eğer gerekiyorsa adadaki bütün leylekleri gerçekten çağırabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500108
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500108,
					"content": "... Öte yandan sen de Leylek bütün ailesini dahil etse bile bu planın bir şaka olduğunu mu düşünüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500109
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500109,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500110
					],
					"speakerTitle": "Hırsız Gelincik"
				},
				{
					"id": 766500110,
					"content": "Vay be, burada işler kızışmış... Galiba bir Hırsız Gelincik, bir kuşla hararetli bir tartışma içinde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500111,
						766500112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500111,
					"content": "Ortak soygun mu planlıyorsunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500113
					]
				},
				{
					"id": 766500113,
					"content": "Tam olarak söylemek gerekirse \"bir dolaplar planlıyoruz\". Bu işte ilerlemeden önce \"deveyi düze çıkarmamız\" gerektiği söylendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500114
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500114,
					"content": "Fakat ortaklarım en iyi yaklaşım konusunda büyük anlaşmazlık yaşıyor ve pek diplomatik de davranmıyorlar. Ağır laflar edildi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500115
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500115,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500116
					],
					"speakerTitle": "Uzun Tüylü Leylek"
				},
				{
					"id": 766500116,
					"content": "Tamam tamam, sana inanıyorum. Yüksek mevkilerde arkadaşların vardır kesin. Peki böyle konuşmayı nereden öğrendin acaba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500117
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500117,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500118
					],
					"speakerTitle": "Uzun Tüylü Leylek"
				},
				{
					"id": 766500118,
					"content": "... Metal kollu ve şapkalı, boyu kısa bir kızdan mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500119
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500119,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500120
					],
					"speakerTitle": "Uzun Tüylü Leylek"
				},
				{
					"id": 766500120,
					"content": "... Ha, tabii keyif aldığın sürece böyle konuşmaya devam edebilirsin. Ama... Onun yanında makul davran, tamam mı? Yaptığı her şeyi taklit etme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500121
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500121,
					"content": "#Şimdi {NICKNAME} ve Paimon ile biraz sohbet edeceğim, uslu ol ve biraz sakinleş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500122
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500122,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500123
					],
					"speakerTitle": "Uzun Tüylü Leylek"
				},
				{
					"id": 766500123,
					"content": "Vay be, gerçekten sessizleşti. Hayvan dilini anlayabilmek çok havalı! Keşke Paimon da anlayabilse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500124,
					"content": "... İnan bana Paimon, hiç keyif almazdın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500125,
						766500126
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500125,
					"content": "Böyle söylemen biraz ürkütücü geldi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500127
					]
				},
				{
					"id": 766500127,
					"content": "Ah, yanlış anlamayın lütfen. Korkunç bir şey yaşanmaz elbette, aklınızı yitirmenize falan da yol açmaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500128
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500128,
					"content": "... Fakat öte yandan bazen yorucu geliyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500129
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500129,
					"content": "Hayvanların dilini anlayabildiğimi ilk keşfettiğimde sevinçten havalara uçmuştum fakat kısa süre içinde eksi yönünü de öğrendim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500130
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500130,
					"content": "Bu yetenek sürekli aktif ve onu kontrol edemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500131
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500131,
					"content": "Ha... Doğru, sıkıntıymış biraz. Ayrıca kontrol edemiyorsan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500132,
						766500133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500132,
					"content": "Ormandan su kıyısına...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500134
					]
				},
				{
					"id": 766500134,
					"content": "... Aynen öyle. İnsanlar ormanın derinliklerinde cıvıldayan kuşları dinlemenin onlara çok içten bir huzur ve moral verdiğini söyler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500135
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500135,
					"content": "Ancak ben nereye gidersem gideyim... Asla sükunet ve huzur bulamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500136
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500136,
					"content": "Ormandayken vahşi kedilerin, tavşanların, Buzboynuzlu Geyiklerin, Şık Porsukların ve Uzun Tüylü Leyleklerin dırdırını duyuyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500137
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500137,
					"content": "Kimin yuvasına kimin zarar verdiğini veya en iyi dalların ormanın hangi kısmında bulunduğunu gürültülü biçimde tartışıyorlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500138,
						766500139
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500138,
					"content": "Kulakların asla rahatlayamıyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500140
					]
				},
				{
					"id": 766500140,
					"content": "P-Pekala... Galiba hayvanlarla konuşabilmek o kadar da süper değilmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500141,
					"content": "Sabah kuşların cıvıltısına uyanmak çok hoş, ama... Cıvıltı yerine kavga olunca pek iç açıcı gelmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500142,
						766500143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500142,
					"content": "Kuş cıvıltısının seni uyandırmaya yetmediğini ikimiz de biliyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500144
					]
				},
				{
					"id": 766500144,
					"content": "Şahsen... O kadar uzun zamandır böyle yaşıyorum ki artık alıştım. Hatta bir gün uyanıp serçelerin en iyi banyo hangi evdeki hangi fincanda yapılır diye tartıştıklarını duyamasam çok zorlanırdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500145
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500145,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500146
					],
					"speakerTitle": "Hırsız Gelincik"
				},
				{
					"id": 766500146,
					"content": "#... Evet, dolap planlamak, hatırlattığın için sağ ol. Konudan biraz saptım. Gerçi artık {NICKNAME} burada olduğuna göre sorunumuzun çözümünü bulmuş olabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500147,
						766500148
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500147,
					"content": "Benim de yüksek mevkilerde arkadaşlarım var...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500149
					]
				},
				{
					"id": 766500149,
					"content": "Yok yok, sadece sen olsan yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500150
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500150,
					"content": "Bu iş için önceki bir Ay İlahicisi tarafından Ay Aynası ile oluşturulan üç mührü açmak ve bir depo odasına girmek gerekiyor. Senin gibi yetenekli biri için basit bir görev olur eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500151,
						766500152
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500151,
					"content": "Önceki bir Ay İlahicisi mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500153
					]
				},
				{
					"id": 766500153,
					"content": "Merak etme, halledersin. Hadi gidelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500152,
					"content": "Yaparken öğrenirim artık.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500153
					]
				},
				{
					"id": 766500148,
					"content": "Ekip oluşturmak için zamana ihtiyacım var ama.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500149
					]
				},
				{
					"id": 766500143,
					"content": "Kaç defa seni sarsarak uyandırmak zorunda kaldım acaba?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500144
					]
				},
				{
					"id": 766500139,
					"content": "Nereye gidersen git asla bitmeyen bir gevezelik...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500140
					]
				},
				{
					"id": 766500133,
					"content": "Hayvanların olduğu her yerde...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500134
					]
				},
				{
					"id": 766500126,
					"content": "Tüylerim diken diken oldu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500127
					]
				},
				{
					"id": 766500112,
					"content": "Ganimeti nasıl bölüşeceğinizi mi tartışıyorsunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500113
					]
				}
			]
		},
