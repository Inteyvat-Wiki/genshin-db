			"dialogs": [
				{
					"id": 766500401,
					"content": "Burada bırakabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500402
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500402,
					"content": "Hım. Ne kadar olaysız geçti... Paimon heykeli bıraktığımızda heyecanlı bir şeyler olur sanıyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500403,
					"content": "Hehe, sonuçta eski, basit bir heykel yalnızca. Tarihi bir yadigar yani. Öyle gizemli bir gücü yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500404
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500404,
					"content": "Gerçek değeri arkasındaki hikayelerde saklı... Benim işim de bu hikayeleri saklandıkları yerden bulup çıkarmak, doğrulamak ve insanlarla paylaşmak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500405
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500405,
					"content": "Güzelmiş! Buraya tek parça getirdiğimiz iyi oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500406,
					"content": "Doğru, bunun için ikinize de teşekkür ederim. Lütfen bu meyveleri alın ve susuzluğunuzu giderin. Ormandaki hayvanlara toplattım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500407
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500407,
					"content": "Ondan sonra da... Kusuruma bakmayın lütfen ama sizden bir isteğim daha olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500408
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500408,
					"content": "Tabii. Nedir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500409
					]
				},
				{
					"id": 766500409,
					"content": "Eğer haddimi aşıyorsam özür dilerim ancak çevrenizin ne kadar geniş olduğunu gördüm, gizli ve unutulmuş yerlere yaptığınız yolculukları da işittim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500410
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500410,
					"content": "Gelecekteki yolculuklarınızda eğer Donuk Ayın Çocuklarıyla ilgili metinlere denk gelirseniz onları ödünç alıp kütüphanemizi genişletmek için kopyalarını çıkarabilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500411,
						766500412
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500411,
					"content": "Tabii ki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500413
					]
				},
				{
					"id": 766500413,
					"content": "Donuk Ayın Çocukları adına size en içten teşekkürlerimi sunuyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500414,
						766500415
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500414,
					"content": "Ben şu meyveyi yiyeyim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500416
					]
				},
				{
					"id": 766500416,
					"content": "Oh be, meyveler çok lezzetliymiş! Paimon'un alıştıklarından çoook daha güzeldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500417
					],
					"speakerTitle": "Paimon"
				},
