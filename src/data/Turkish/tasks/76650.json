			"dialogs": [
				{
					"id": 766500201,
					"content": "İşte geldik. Karşında Ay Aynası, içinde de Ay Sureti mühürlü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500202
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500202,
					"content": "Mühürlemek için bunca zahmete girdiklerine göre çok değerli bir heykel olmalı... İçeride tuzak olacak mı? Hani yanlış yere basarsan ok fırlatan cinsten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500203,
						766500204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500203,
					"content": "Ben her türlü hazırım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500205
					]
				},
				{
					"id": 766500205,
					"content": "Merak etmeyin. Bu ufaklık önden keşif yaptı. Mühürde öyle ölümcül tuzaklar bulunmuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500206
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500206,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500207
					],
					"speakerTitle": "Hırsız Gelincik"
				},
				{
					"id": 766500207,
					"content": "Aa, süper! İyi oldu bildiğimiz. Tam da Hırsız Gelinciğe göre bir işmiş bu arada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500208,
						766500209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500208,
					"content": "Ama görünüşüne bakılırsa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500210
					]
				},
				{
					"id": 766500210,
					"content": "Haha. Doğru. Her yardımını istediğimde önceki seferden bir Mora fazlasını ödemem gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500211
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500211,
					"content": "Bak sen şu gelinciğe, resmen hırsız! ... Ha, doğru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500212,
					"content": "Hımm, gerçi Ay Suretine göz kulak olmana yardım ediyorsa ismini değiştirmek gerekebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500213,
					"content": "Mesela... \"Muhafız Gelincik\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500214,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500215
					],
					"speakerTitle": "Hırsız Gelincik"
				},
				{
					"id": 766500215,
					"content": "Hehe, Paimon'u yakalayamazsın ki, Paimon uçuyor! Bööö!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766500216,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500217,
						766500218
					],
					"speakerTitle": "Hırsız Gelincik"
				},
				{
					"id": 766500217,
					"content": "Hop, hop, tırmanma üzerime!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500219
					]
				},
				{
					"id": 766500219,
					"content": "Misafirlerimize karşı kibar davran lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500220
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500220,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500221,
						766500222
					],
					"speakerTitle": "Hırsız Gelincik"
				},
				{
					"id": 766500221,
					"content": "Ne yapmam gerekiyor şimdi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500223
					]
				},
				{
					"id": 766500223,
					"content": "Ay Suretini almak için iki farklı konumdaki ikili mekanizmaları etkinleştirmemiz gerekiyor. İki kişilik bir iş yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500224
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500224,
					"content": "Eğer sen şu taraftaki mekanizmayı halledersen ben de bu taraftakini hallederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500225
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500225,
					"content": "Nasıl aynı anda etkinleştireceğiz peki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500226
					]
				},
				{
					"id": 766500226,
					"content": "Orası sorun değil. Gökyüzünde gözlerim var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500227
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500227,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766500228
					],
					"speakerTitle": "Uzun Tüylü Leylek"
				},
				{
					"id": 766500228,
					"content": "Senin konumunu ve önünde hangi mekanizma olduğunu bildirecek bana. Merak etme, sen sadece talimatlarımı izle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				},
				{
					"id": 766500222,
					"content": "Mekanizmayı nasıl açacağız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500223
					]
				},
				{
					"id": 766500218,
					"content": "Saçımı çekme! Saçımı çekme!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500219
					]
				},
				{
					"id": 766500209,
					"content": "Hırsız Gelincik bedavaya çalışmıyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500210
					]
				},
				{
					"id": 766500204,
					"content": "Alışığım böyle şeylere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766500205
					]
				}
			]
		},
