			"dialogs": [
				{
					"id": 200180101,
					"content": "Teşekkürler Gezgin. Her zaman bir şekilde işleri batırmayı beceriyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180102
					],
					"speakerTitle": "Korkmuş Magar"
				},
				{
					"id": 200180102,
					"content": "Başımı belaya sokmadan şarap arabasını A noktasından B noktasına bile taşıyamayacaksam... Ben ne işe yararım ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180103
					],
					"speakerTitle": "Korkmuş Magar"
				},
				{
					"id": 200180103,
					"content": "Kendimi toparlamazsam Şaraphaneden atılacağım... Bay Connor çoktan böyle bir karar vermeyi düşünmüyorsa tabii... Şu anda ben konuşurken Bay Elzer'ın istifa mektubumun taslağını çıkardığına eminim... Tam bir umutsuz vakayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180104
					],
					"speakerTitle": "Korkmuş Magar"
				},
				{
					"id": 200180104,
					"content": "Hey Nelly! Sakinleş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200180105
					]
				},
				{
					"id": 200180105,
					"content": "*iç çeker* İş durumum artık umutsuz olsa da bu arabayı gitmesi gereken yere götürmeliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180106
					],
					"speakerTitle": "Korkmuş Magar"
				},
				{
					"id": 200180106,
					"content": "Araba hasar da gördü... Gezgin, ihtiyacım olan eşyayı bulmamda bana yardım eder misin? Bir tane <color=#00E1FFFF>Sağlam Kalas</color> işimi görür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Korkmuş Magar"
				}
			]
		},
		{
