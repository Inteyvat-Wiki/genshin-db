			"dialogs": [
				{
					"id": 200180401,
					"content": "Oh... İyi ki buradasın Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180402
					],
					"speakerTitle": "Korkmuş Magar"
				},
				{
					"id": 200180402,
					"content": "Ama şimdi arabamı nasıl onaracağımı hiç bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180403
					],
					"speakerTitle": "Korkmuş Magar"
				},
				{
					"id": 200180403,
					"content": "Arabanın her yerinde hasar var... Sanırım elimden geldiği kadar yama yapacağım. Ne yaparsam yapayım, araba kalıcı olarak tamir olmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180404
					],
					"speakerTitle": "Korkmuş Magar"
				},
				{
					"id": 200180404,
					"content": "Boş ver. Kasabaya gidene kadar kurtarsa yeter. Oraya vardığımda ne yapacağıma bakarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180405
					],
					"speakerTitle": "Korkmuş Magar"
				},
				{
					"id": 200180405,
					"content": "Arabada ip vardı diye hatırlıyorum... Herhalde onu da alıp gittiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180406
					],
					"speakerTitle": "Korkmuş Magar"
				},
				{
					"id": 200180406,
					"content": "Gezgin... Benim için şu ormana bir göz atar mısın? Etrafta <color=#00E1FFFF>İp</color> varsa şahane olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Korkmuş Magar"
				}
			]
		},
