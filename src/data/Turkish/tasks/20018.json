			"dialogs": [
				{
					"id": 200180301,
					"content": "Bu işe yarar. Artık arabayı onarabilirim. Sanırım. Yani umarım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200180302
					],
					"speakerTitle": "Korkmuş Magar"
				},
				{
					"id": 200180302,
					"content": "Hay aksi, geri geldiler! Yardım et Gezgin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Korkmuş Magar"
				}
