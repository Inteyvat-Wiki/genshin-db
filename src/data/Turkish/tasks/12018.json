			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120180701,
					"content": "Kujou Kamaji yaralandı. Takatsukasa Klanının varisleri, ona bakmak sizin sorumluluğunuzda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180702
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180702,
					"content": "Bana meydan okumaya cesaretin olmayabilir ama eminim ki bunun gibi küçük bir mevzuyu halledebilecek becerin vardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180703
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180703,
					"content": "Evet, tabii ki. Özür dilerim... Çok, çok üzgünüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180704
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180704,
					"content": "Kujou Klanının artık Tenryou Heyetinin görevlerini üstlenmeye uygun olmadığını duymuştum. Tenryou Heyeti Başkanı pozisyonuna geçecek birini bulmak gerçekten acil bir mesele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180705
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180705,
					"content": "Fakat bu düellonun ardından Kujou Klanını cezalandırma işini şimdilik ertelemeye karar verdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180706
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180706,
					"content": "Bu sırada Takatsukasa Klanının tıpkı önceden olduğu gibi Kujou Klanına destek vermeye devam etmesini bekliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180707
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180707,
					"content": "Emirleriniz aynen uygulanacak. Yüce Şogun'un kararını sorgulama cüretini gösterecek değiliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180708
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180708,
					"content": "Son olarak; Fatui'nin kararlarımda hata yapmam için bana yanıltıcı bilgiler verme stratejisini taklit edebileceğinizi düşünüyorsanız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180709
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180709,
					"content": "Bugün yaptığım gibi bir kez daha ortaya çıktığımı görürsünüz... Lakin bir dahaki sefere kılıcımın merhameti olmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180710
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180710,
					"content": "Anlaşıldı. Bilgeliğiniz ve merhametiniz için teşekkürler Yüce Şogun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180711
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180711,
					"content": "Bu kadarı yeterli. Okuzumeshuu'nun araştırmayı buradan devralmasını isteyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180712
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180712,
					"content": "Benimle gelin. Sessiz bir yer bulalım. Sizinle konuşmak istediğim bir şey var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ei"
				}
			]
		},
		{
			"id": 1201810,
			"completionStepIds": [
				1201810
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
