			"dialogs": [
				{
					"id": 120180301,
					"content": "Vay canına, baksanıza ne kadar da iyi gizlenmiş bir yer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120180302,
					"content": "Birinin dağların derinliklerine böyle bir yapı inşa etmek istemesi için hiçbir neden bulamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180303,
						120180304
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180303,
					"content": "Belki de felaketlerden kaçmak içindir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120180305
					]
				},
				{
					"id": 120180305,
					"content": "Buraya ait olmayan bir şey hissediyorum... Tehlike seziyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180306
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180306,
					"content": "Ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120180307,
					"content": "Dikkatli ilerlemeliyiz. Kujou Klanının varisinin başı belada olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180304,
					"content": "Belki de tespit edilmemek içindir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120180305
					]
				}
			]
		},
		{
			"id": 1201805,
			"completionStepIds": [
				1201805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
