			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120181001,
					"content": "Söz konusu olayların icabına bakmak olunca aynı Şogun gibisin, çok katı oluyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120181002,
					"content": "Öyle miyim dersin? Ben de epey uzlaşmacı olduğumu düşünmüştüm. Orada Şogun olsaydı... Kujou Kamaji'nin kellesini bir saniye bile düşünmeden uçurmuştu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181003,
						120181004
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181003,
					"content": "Şanslıymış.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181005
					]
				},
				{
					"id": 120181005,
					"content": "Bence böyle bir şey olma ihtimaline hazırlıklıydı. Bunu gözlerinde görebiliyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181006
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181006,
					"content": "Kujou Klanı, parlak günlerinden bugünkü çöküşüne giden yolda çarpıcı değişimler geçirdi. Kamaji, Kujou adına layık bir varis sayılmaz ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181007
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181007,
					"content": "Bana dünya değişse bile bazı şeylerin aynı kaldığını gösterdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181008
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181008,
					"content": "Ayrıca size de teşekkür ederim. Sokaklarda başımıza gelen şeyler ve çektiğiniz fotoğrafım bana bu farkındalığa ulaşmamda yardımcı oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181009
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181009,
					"content": "Peki Kujou Klanını şimdi ne bekliyor? Tenryou Heyetinin başında olmaya devam edebilecekler mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120181010,
					"content": "Mümkün değil. Varisleri umut veren biri olsa da geçmişteki hataları silinemez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181011
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181011,
					"content": "Yine de... Onlara biraz daha zaman vereceğim. En nihayetinde hata yapan bir tek onlar değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181012
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181012,
					"content": "Şogun hata yapmaz, hatadan arındırılmış bir varlık. Fakat ben, Ei olarak özür dilemek isterim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181013
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181013,
					"content": "Önümüzdeki günlerde üzerine düşünüp taşınmam gereken çok şey var. En azından şimdilik önümü görebiliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181014
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181014,
					"content": "Inazuma'yı doğrudan mı yöneteceksin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181015
					]
				},
				{
					"id": 120181015,
					"content": "Sanırım o işi Şogun'a bırakacağım. Zamanın getirdiği erozyon sonsuzluk için hâlâ en büyük tehdit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181016
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181016,
					"content": "Dediğim gibi, Şogun'un değişikliklere karşı kendini koruduğu güçlü bir sistemi var. Zamanla değişeceğimi öngördüğüm için var bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181017
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181017,
					"content": "Ama kararımı verdim. Ne kadar zor olursa olsun yapılması gereken neyse onu yapacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181018
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181018,
					"content": "Hımm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181019
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181019,
					"content": "Bu, gerçekten hatırlanmaya değer bir olaylar dizisi oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181020
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181020,
					"content": "Kesinlikle! Tenryou Heyetini hallettin. Şehirdeki insanlar da mutlu ve sağlıklı bir Şogun görebildiler. Bütün o korkunç dedikodular çok geçmeden yok olacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181021
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120181021,
					"content": "Yolculuğun hoşuna gittiyse bir ara yine gezmeye çıkarız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181022,
						120181023
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120181022,
					"content": "Bir dahakine sana hediye de getiririz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181024
					]
				},
				{
					"id": 120181024,
					"content": "Gerek yok. Hayatımda böyle eşyalar için yer yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181025
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181025,
					"content": "Ayrıca lütfen bir arkadaşa ihtiyacım varmış gibi konuşmayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181026
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181026,
					"content": "Pekala, artık geri dönmeye hazırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181027
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181027,
					"content": "Yalnızlık dönemim devam edecek ama çok uzun sürmeyecek. Bu esnada meydana gelebilecek küçük sorunlarla ilgilenme işini siz insanlara bırakıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181028
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120181028,
					"content": "Pekala, sonra görüşürüz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181029
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120181029,
					"content": "Olanların çoğunun epey beklenmedik bir şekilde gerçekleştiğini düşünürsek, işler sonunda şaşırtıcı bir şekilde tatlıya bağlandı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181030
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120181030,
					"content": "Geriye kalan tek şey Geçiş İznini Yae Miko'ya iade etmek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120181023,
					"content": "Bir dahakine sana eğlenceli biblolar getiririz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181024
					]
				},
				{
					"id": 120181004,
					"content": "Belki de beklediği buydu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181005
					]
				}
			]
		},
		{
			"id": 1201812,
			"completionStepIds": [
				1201812
			],
