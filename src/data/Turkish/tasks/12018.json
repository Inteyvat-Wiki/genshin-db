			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kujou Kamaji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120180506,
					"content": "Yüce Şogun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180507
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180507,
					"content": "Şo-Şogun, siz burada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180508
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180508,
					"content": "Takatsukasa Klanının varisi, burada neler olduğunu açıkla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180509
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180509,
					"content": "Ah, son zamanlarda Tenryou Heyetinde baş gösteren bazı küçük meseleleri tartışıyorduk. Gerçekten, Yüce Şogun'un endişe etmesini gerektirecek hiçbir şey yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180510
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180510,
					"content": "Ve bu küçük meseleler, gözlerden uzak bir yeri ve nöbet tutan ronin ve Kairagileri mi gerektiriyordu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180511
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180511,
					"content": "Şey, son zamanlarda çok fazla kargaşa var. Yalnızca güvenlik önlemleri sebebiyle yapılmıştı, hepsi bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180512
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180512,
					"content": "Sessizlik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180513
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180513,
					"content": "Kujou Klanının varisi. Sıra sende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180514
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180514,
					"content": "Pekala. Buraya pazarlık etme niyetiyle geldim ama anlaşılan o ki ilgilendikleri tek şey Kujou Klanından almak istedikleri yazılı bir itiraf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180515
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180515,
					"content": "Yazılı bir itiraf mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180516
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180516,
					"content": "Evet. Son zamanlardaki tüm suistimaller de dahil olmak üzere, Önsezi Avı Fermanının başlangıcından bu yana Kujou Klanı tarafından işlenen bütün suçları kabul eden bir açıklama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180517
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180517,
					"content": "Tabii ki hepsi gerçek beyanlar. Tek bir sahte beyan dahi yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180518
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180518,
					"content": "Bunu inkar edemem. Ama aynı zamanda belge boyunca Takatsukasa Klanının başarıları vurgulanarak, başından beri sebat ettikleri ve krize karşı savaştıkları iddia ediliyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180519
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180519,
					"content": "Bunlar tamamen gerçek dışı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180520
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180520,
					"content": "Söyleyene bak! Seni ikiyüzlü! Söylediklerinden neden cayıyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180521
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180521,
					"content": "Ben sadece gerçekleri söylüyorum. Eminim, Yüce Şogun gerçeği ayırt edebilir. Takatsukasa Klanının yapmaya çalıştığı tek şey kendilerini iyi göstermek, böylece Kujou Klanının yerini almak için ilk sırada onlar olacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180522
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180522,
					"content": "Yoksa neden yazılı bir itirafta klanınızı yalan yanlış ifadelerle iyi bir şekilde göstermeye uğraşasınız ki? Bir de üstüne bana baskı altında imzalatmaya çalışıyorsunuz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180523
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180523,
					"content": "Sen neden bahsediyorsun? Baskı altında falan değilsin, burada sadece görüşüyoruz! Tamamen döneklik ediyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180524
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180524,
					"content": "Sanırım meseleyi şimdi anladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180525
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180525,
					"content": "Onun saçmalıklarına kulak asmayın. Eminim Kujou Klanının büyük başarısızlıklarının farkındasınızdır. Kuşkusuz herkes biliyor, söyledikleri tek bir kelimeye dahi güvenilmez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180526
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180526,
					"content": "Hıh. Aranızdaki münakaşanın beni ilgilendirdiğini düşünüyorsanız yanılıyorsunuz. Takatsukasa Klanının varisi, yeni Tenryou Heyeti Başkanı olmak istiyorsun. Doğru mu anladım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180527
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180527,
					"content": "Şey, evet, elbette! Hayatlarını Yüce Şogun'un hizmetine adamak Tenryou Heyetindeki herkesin ebedi arayışıdır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180528
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180528,
					"content": "O zaman mesele sandığın kadar karmaşık değil. Ne de olsa Tenryou Heyetinin Başkanını atayan kişi benim. Süreç oldukça basit: Kim beni bir düelloda mağlubiyete uğratırsa yeni vekil o olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180529
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180529,
					"content": "Ah, pardon... Yüce Şogun ile bir düello mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180530
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180530,
					"content": "İlk Tenryou Heyeti Başkanı elinde kılıcıyla azmini ortaya koydu. Öyle ki, bu unvan o zamandan beri Kujou Klanı içinde kuşaktan kuşağa aktarılıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180531
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180531,
					"content": "Yeni bir klan atamamı istiyorsanız öncelikle yeni bir düello yapılmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180532
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180532,
					"content": "Ben... Şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180533
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180533,
					"content": "Kılıç tutmayı bilmiyor musun? Yoksa ilerleyen yaşın ve giderek zayıflayan sağlık durumundan ötürü yeteneklerinden şüphe mi ediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180534
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180534,
					"content": "Karşıma geçmiş hayatını sunmaktan bahsediyorsun ama kılıcımla yüzleşmekten acizsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180535
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180535,
					"content": "Ah... Şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180536
					],
					"speakerTitle": "Takatsukasa Susumu"
				},
				{
					"id": 120180536,
					"content": "Boş ver öyleyse. Peki ya sizlerden biri? Takatsukasa olsun ya da olmasın, beni yenebilecek herhangi biri yeni Tenryou Heyeti Başkanı olarak atanacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180537
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180537,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180538
					],
					"speakerTitle": "Takatsukasa Klanı Hizmetkarı"
				},
				{
					"id": 120180538,
					"content": "Bir kişinin bile karşıma çıkmaya cesareti yok mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180539
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180539,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180540
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180540,
					"content": "Ben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180541
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180541,
					"content": "Size meydan okuyacağım Yüce Şogun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180542
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180542,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180543
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120180543,
					"content": "Kujou Klanının varisi. Ne yazık ki bana karşı kazansan bile bu, Kujou adı altında yapılan hataları telafi edemez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180544
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180544,
					"content": "Bunun farkındayım. Zaten size karşı kazanma şansım da pek yok. Babamın yaptığı hatalar yüzünden Kujou Klanının Tenryou Heyetindeki varlığına son verilmesi gerektiğini çok iyi biliyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180545
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180545,
					"content": "Önsezi Avı Fermanını yerine getirirken bile babamın kararlarına dair şüphelerim vardı. Yaptığım şeyin yanlış olduğunu biliyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180546
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180546,
					"content": "Ama yaptığım yalnızca şüphelenmek ve düşünmek oldu. Durumu gayet iyi anlamama rağmen hiçbir şey yapmadım, bir kişiyi bile kurtarmadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180547
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180547,
					"content": "Yaptıklarımın cezası olarak Kujou Klanının düşüşünü kabul ediyorum. Bunu engellemeyi başaramadığımı bile söyleyemem... Çünkü başarısız olmak için en azından denemiş olmak gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180548
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180548,
					"content": "Açık konuşmak gerekirse... Denemiş olsan dahi, senin gücünde birinin yapabileceği pek bir şey yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180549
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180549,
					"content": "Evet... Çok güçsüzüm. Babam beni görmezden geliyor, abim bana yardım edemiyor ve hatta bazen beni hizaya getirmesi için Ippei'ye ihtiyacım oluyor... Her zaman böyle oldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180550
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180550,
					"content": "Öyleyse ben de Kujou Klanının son saatlerinde, tam da şu anda ve tam burada onu temsil edecek kişinin ta kendisiyim, tıpkı benden önce babamın yaptığı gibi. Onun görevleri artık bana geçti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180551
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180551,
					"content": "Şogun'un da dediği gibi, bir zamanlar atalarımdan biri iradesini kılıcıyla göstermişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180552
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180552,
					"content": "O halde lütfen izin verin, Kujou Kamaji olarak ben de Kujou Klanının hikayesini başladığı gibi bitireyim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180553
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180553,
					"content": "Bir şeyler yapabilmek için bu benim son şansım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180554
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 120180554,
					"content": "Bunun anlamsızlığı ortada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180555
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120180555,
					"content": "Ama tamam, kabul ediyorum. Bir adım öne çık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ei"
				}
			]
		},
		{
			"id": 1201807,
			"completionStepIds": [
				1201807
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
