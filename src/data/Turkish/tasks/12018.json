			},
			"dialogs": [
				{
					"id": 120181201,
					"content": "Miko, biz geldik! Harika bir yolculuktu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120181202,
					"content": "Öyle mi? Peki madem, her şeyi bana da anlatın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181203
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120181203,
					"content": "Hehe, ne kadar da eğlenceli. Yüce Şogun şehir merkezine iniyor ve aniden şehirde yolunu bulmaya çalışan şaşkın bir kasaba kızına dönüyor. Harikulade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181204
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120181204,
					"content": "Bunu görememiş olmam çok yazık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181205,
						120181206
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120181205,
					"content": "Bunu söylemeye cüret edebilen tek kişisin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181207
					]
				},
				{
					"id": 120181207,
					"content": "Sorun değil, o buna aldırmaz. Gerçekten aldırmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181208
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120181208,
					"content": "Peki. Söylediklerinize bakılırsa sonsuzluğun nasıl bir şekil alması gerektiğini sonunda kavramışa benziyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181209
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120181209,
					"content": "Bu yolculuğun en önemli sonucu bu. Dürüst olmak gerekirse size Geçiş İznini verdiğimde bu kadar ilerleme kaydedebileceğinizi hiç beklemiyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181210
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120181210,
					"content": "Evet. Görünüşe göre artık her şeyi aynı kalmaya zorlamayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120181211,
					"content": "Kibar bir şekilde söylemek gerekirse, tanrılar bile hüsnükuruntuya kapılabiliyor... Açıkça söylemek gerekirse de Yedilerin bile kendilerinden daha güçlü bir şeyle karşılaştıklarında yapamayacağı şeyler vardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181212,
						120181213
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120181212,
					"content": "İnsan kalbi mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181214
					]
				},
				{
					"id": 120181214,
					"content": "Haha. Tahmin edin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181215
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120181215,
					"content": "Her neyse. Görünüşe göre oldukça güzel bir seyahat geçirmişsiniz ve Ei'in resmi olmayan tarafını görme şansınız bile olmuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181216
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120181216,
					"content": "Bir dahaki sefere onu görmek istediğinizde gelip benden Geçiş İzni alabilirsiniz. Bunu asla kabul etmese de aslında epey yalnızlık çekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181217
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120181217,
					"content": "Ne? Ama arkadaş istemediğini söylemişti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120181218,
					"content": "Çünkü o bir tanrı. Mesele tanrıların arkadaşlığa ihtiyaç duymaması değil, bir tanrının arkadaşının olması fikri ona şımarıkça geliyor o kadar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181219
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120181219,
					"content": "Ama sen bu dünyaya ait değilsin. Belki de onun ihtiyacı olan arkadaş sensin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120181213,
					"content": "Semavi İlkeler mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181214
					]
				},
				{
					"id": 120181206,
					"content": "Sen ve Şogun birbirinize sataşmaktan hoşlanıyorsunuz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181207
					]
				}
			]
		}
	]
}