					"Hong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730760401,
					"content": "\"Kral Yük Hayvanı\" mı? Birkaç gün önceydi. Özel bir cevherin peşine düşmüştüm. Nasıl olduysa dağın diğer tarafına gitmişim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760402
					],
					"speakerTitle": "Hong"
				},
				{
					"id": 730760402,
					"content": "Devasa Yük Hayvanı orada öylece duruyordu. İnanılmaz bir şeydi. Hayatımda hiç bu kadar büyüğünü görmemiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760403
					],
					"speakerTitle": "Hong"
				},
				{
					"id": 730760403,
					"content": "Beni gördüğü an üzerime atıldı. Neyse ki kaçacak kadar hızlı koşabildim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760404
					],
					"speakerTitle": "Hong"
				},
				{
					"id": 730760404,
					"content": "Hangi dağın diğer tarafına? Ah, batıdaki dağlardan biri olabilir. Ayrıntıları hatırlayamıyorum ama batıdaki zirvelerden biri olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hong"
				}
			]
		},
