			},
			"dialogs": [
				{
					"id": 730760301,
					"content": "Peki siz şu acımasız yaratıklardan birine rastladınız mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760302
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760302,
					"content": "Olur da karşılaşırsanız lütfen onları bölgeden uzaklaştırın. Bu hem insanlar hem de hayvanlar için çok iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760303,
						730760305,
						730760309,
						730760313
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760303,
					"content": "Timsah Raja hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760304
					]
				},
				{
					"id": 730760304,
					"content": "Timsah Rajanın şehrin doğusundaki sularda yaşadığı söyleniyor. Gerçi birkaç kez gidip baktım ama o alçak yaratıkla karşılaşmadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760305,
					"content": "Rishboland Raja hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760306
					]
				},
				{
					"id": 730760306,
					"content": "Anlatılan hikayeye göre Rishboland Raja gece yarısı batıdaki ormandan çıkar ve henüz uyumamış yaramaz çocukları kaçırırmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760307
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760307,
					"content": "Çocuk kaçırma kısmını muhtemelen çocukları bir türlü uyumayan anne babalar uydurdu ancak Rishboland Kaplanı gerçekten de geceleri daha aktif.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760308
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760308,
					"content": "Gece yolculuk yapanların devasa bir Rishboland kaplanı tarafından kovalandığı haberi ağızdan ağıza yayıldı ancak neyse ki henüz bir kayıp yaşanmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760309,
					"content": "Kral Yük Hayvanı hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760310
					]
				},
				{
					"id": 730760310,
					"content": "Bazı vahşi Yük Hayvanlarının bölgelerini korumaya düşkün olduklarını ve oraya girenlere saldırdıklarını duymuştum. Eminim Kral Yük Hayvanı da aynıdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760311
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760311,
					"content": "Onun bölgesi de doğuda bir yerde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760312
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760312,
					"content": "Kral Yük Hayvanı adını verdiklerine göre kim bilir ne kadar büyük bir yaratıktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760313,
					"content": "Hâlâ arıyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760314
					]
				},
				{
					"id": 730760314,
					"content": "Güzel, aramaya devam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Santon"
				}
			]
		},
