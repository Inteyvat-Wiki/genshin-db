					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730760501,
					"content": "Kral Yük Hayvanı mı? O devasa Yük Hayvanından bahsediyorsun, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760502
					],
					"speakerTitle": "Najib"
				},
				{
					"id": 730760502,
					"content": "İki gün önce Liyue'ye gidiyordum ve o yaratığı Kanyon'un orada gördüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760503
					],
					"speakerTitle": "Najib"
				},
				{
					"id": 730760503,
					"content": "Şanslı günümmüş ki uyukluyordu. Parmak ucumda yürüyerek etrafından dolaştım ve kaçtım. Neredeyse bir tepe büyüklüğündeydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760504
					],
					"speakerTitle": "Najib"
				},
				{
					"id": 730760504,
					"content": "Onu nerede mi gördüm? Liyue buranın güneyinde kaldığına göre o taraflarda olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760505
					],
					"speakerTitle": "Najib"
				},
				{
					"id": 730760505,
					"content": "Genelde Sumeru'dan Liyue'ye su yolundan gidilmez mi? Sen neden Kanyon'a gittin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760506,
					"content": "Şey... Kişisel bir mesele. Seni ilgilendireceğini düşünmüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760507
					],
					"speakerTitle": "Najib"
				},
				{
					"id": 730760507,
					"content": "Tüm bildiklerim de bunlar. Yapacak başka işlerim var, beni rahat bırakın artık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najib"
				}
			]
		},
