			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Santon",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730760701,
					"content": "Vahşi canavarları uzaklaştırdınız mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760702
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760702,
					"content": "Ben daha bir tanesiyle bile karşılaşamadım. Gerçekten de çok mu korkunçlardı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760703,
						730760705
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760703,
					"content": "Yok o kadar da korkunç değillerdi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760704
					]
				},
				{
					"id": 730760704,
					"content": "Bu iş sana göre çocuk oyuncağıymış demek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760707
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760707,
					"content": "O canavarlardan kurtulduğumuz için çok rahatladım ama hiçbirini göremediğim için de biraz buruğum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760708
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760708,
					"content": "Doğada güçlü hayvanların rakiplerini av için alt etmelerine sık rastlanır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760709
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760709,
					"content": "Haha, ama bir dahakine kaybetmeyeceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760710
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760710,
					"content": "Biz de arkanda kalmayacağız!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760711
					]
				},
				{
					"id": 730760711,
					"content": "Aynen öyle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760712,
					"content": "Sumeru'da \"vahşi hayvanlarla ilgilenmek\" Orman Muhafızlarının görevi değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760713,
					"content": "Ne? Daha önce söylemedim mi? Bu görevi... Tanıdığım bir Orman Muhafızından aldım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760714
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760714,
					"content": "İnsanların çoğu Solduran ile ilgili son olaylar yüzünden meşgul, gerçi ayrıntıları çok bilmiyorum ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760715
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760715,
					"content": "O yüzden \"vahşi hayvanlarla ilgilenmek\" bana kaldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760716
					],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760716,
					"content": "Demek sebebi bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760717,
					"content": "Yardımın için çok teşekkür ederim. İşte ödemen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Santon"
				},
				{
					"id": 730760705,
					"content": "Ne kadar korkutucu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760706
					]
				},
				{
					"id": 730760706,
					"content": "Gerçekten mi? Keşke kendi gözlerimle görebilseydim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760707
					],
					"speakerTitle": "Santon"
				}
			]
		},
