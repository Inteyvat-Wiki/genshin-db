			"dialogs": [
				{
					"id": 730761001,
					"content": "\"Son zamanlarda büyük Rishboland Kaplanlarının görülmesiyle ilgili duyuru:\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730761002
					],
					"speakerTitle": "Bildiri"
				},
				{
					"id": 730761002,
					"content": "\"Lütfen karanlık çöktükten sonra oyalanmayın. Rishboland Kaplanlarının geceleri ortaya çıktığı biliniyor.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730761003
					],
					"speakerTitle": "Bildiri"
				},
				{
					"id": 730761003,
					"content": "\"Lütfen bu bölgede açıkta et bırakmayın. Kaplanları beslemek sizin güvenliğinizi garantilemez. Aksine kaplanların buradan ayrılmamasına neden olur.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bildiri"
				}
			]
		}
	]
