			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anaya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730760601,
					"content": "\"Kral Yük Hayvanı\" mı? Geçen gece ormandayken gördüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760602
					],
					"speakerTitle": "Anaya"
				},
				{
					"id": 730760602,
					"content": "Bulutlu bir geceydi. Bir tepe kadar büyük gölgenin gümbürtüler çıkararak üzerime doğru koşturduğunu gördüğümde ormanda yürüyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760603
					],
					"speakerTitle": "Anaya"
				},
				{
					"id": 730760603,
					"content": "Bayılmışım ve ancak sonraki gün kendime geldim. Beni taşıyarak geri getiren adam dağın eteklerinde yığılıp kaldığımı söyledi. Şansıma ağır yaralanmamıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760604
					],
					"speakerTitle": "Anaya"
				},
				{
					"id": 730760604,
					"content": "Kesin yerinden emin değilim. Galiba doğudaydı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anaya"
				}
			]
		},
		{
			"id": 7307607,
			"completionStepIds": [
				7307607
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
