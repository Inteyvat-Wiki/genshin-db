					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730760101,
					"content": "Kesinlikle, yalnızca Sumeru'dayken gerçek anlamda doğayı hissedebilirsin. Aksine Fontaine'in havası resmen zehirli gazlardan ibaret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760102
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760102,
					"content": "Ne oldu? Nasıl yardımcı olabilirim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760103
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760103,
					"content": "Yalnızca merak etmiştik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760104
					]
				},
				{
					"id": 730760104,
					"content": "Bu çadırda sen mi yaşıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760105,
					"content": "Evet, bir süredir burada yaşıyorum. Ha, anladım. Fontaine'den birinin Sumeru ormanlarında çadırda yaşaması size garip geldi, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760106
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760106,
					"content": "Nedenine gelirsek, anlatırım ama önce isimleriniz ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760107
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760107,
					"content": "Paimon'un adı Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760108,
					"content": "#Ben {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760109
					]
				},
				{
					"id": 730760109,
					"content": "#Demek {NICKNAME} ve Paimon. Anlaşıldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760110
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760110,
					"content": "Adım Santon. Gördüğünüz gibi Fontaine'den geldim ve Sumeru'da bulunma sebebim tabii ki de ormanlar! Ormanları çok severim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760111
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760111,
					"content": "Şehirde uzun süre yaşarsan hareketsizlikten vücudun zayıflar ve zihinsel olarak da kayıtsız hale gelirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760112
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760112,
					"content": "Uyum duygusunu yeniden yakalamanın tek yolu kendini uçsuz bucaksız doğaya bırakmaktır. Ormanlar doğayla yeniden bağ kurmak için en iyi yerler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760113
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760113,
					"content": "Sumeru'ya bu yüzden geldim. Ne de olsa Teyvat'ın en güzel ormanları burada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760114
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760114,
					"content": "Paimon anlıyor gibi ama tam da değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760115,
					"content": "Orada yaşayan envaiçeşit yaratık yüzünden Sumeru ormanları çok tehlikeli de olabilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760116,
					"content": "Olay da o zaten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760117
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760117,
					"content": "Ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760118,
					"content": "Hiç tehlike olmasaydı yaşadığımı hissedemezdim ki! Endişelenmeyin ben Fontaine'de nam salmış bir avcıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760119
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760119,
					"content": "Hatta ormanda avlanmayı çok severim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760120,
					"content": "Aslında Fontaine'den gelen kaçak bir avcısın, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760121,
						730760122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760121,
					"content": "Sanırım müdahale etmemiz gerekecek!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760123
					]
				},
				{
					"id": 730760123,
					"content": "Hayır, yanlış anladınız. Kaçak avcı değilim! Kaçak avcılık ciddi bir suçtur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760124
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760124,
					"content": "Fontaine'de kaçak avcılık yaparken avlanırsan hayatın biter. Asla o işe girmem. Fontaine'de biz avcılar genelde \"vahşi hayvanlarla\" ilgileniriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760125
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760125,
					"content": "Vahşi hayvanlarla ilgilenmek mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760126,
					"content": "Bir düşün. Vahşi hayvanların insanların yaşadığı bölgelere yaklaşması iki taraf için de tehlikelidir, o yüzden bu hayvanların yerleşim yerlerinden uzak tutulması gerekir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760127
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760127,
					"content": "Yani yaptığın şey bu mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760128,
					"content": "Evet, bu sayede yakınlarda yaşayanlar acımasız hayvanların gazabına uğramayacak ve insanların faaliyetleri de hayvanları rahatsız etmeyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760129
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760129,
					"content": "İşin aslı civarda vahşi hayvanlar olduğunu duydum, buraya gelince de yaşayanlar beni tuttular. Yani bir avcı olarak nasıl görmezden gelebilirdim ki, haksız mıyım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760130
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760130,
					"content": "Elbette, öyle yaratıklara özel bir ilgim de var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760131
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760131,
					"content": "Şu aşırı büyümüş timsah çok etkileyici mesela. Çocukların \"Timsah Raja\" dedikleri yaratık, adeta bir şehir efsanesinden fırlamış gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760132
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760132,
					"content": "Yakınlardaki sularda yaşadığı söyleniyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760133
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760133,
					"content": "Diğer yandan çocukları kaçırmaya çalışan Rishboland Raja ve Liyue'ye giden yolu tıkayan devasa Yük Hayvanı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760134
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760134,
					"content": "Rishboland Raja galiba buranın batısında kalan ormanda yaşıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760135
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760135,
					"content": "Kral Yük Hayvanına gelirsek... Ah, hani şu bahsettiğim devasa Yük Hayvanı... Korkudan ödü patlamış bazı görgü tanıkları onun doğu tarafında dolandığını ve oradan geçen herkese saldırdığını iddia ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760136
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760136,
					"content": "Hepsi de birbirinden tehlikeliymiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760137,
					"content": "Evet. Onları görürseniz dikkatli olun. Gerçi ikiniz de görmüş geçirmiş avcılara benziyorsunuz, belki de endişelerim yersizdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760138
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760138,
					"content": "O yaratıklarla karşılaşırsanız lütfen onları buralardan uzaklaştırın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760139
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760139,
					"content": "Buradaki insanların güvenliği için!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760140
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760140,
					"content": "Elbette, karşılaşırsak onları uzaklaştırırız.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760141
					]
				},
				{
					"id": 730760141,
					"content": "Bu çok iyi olur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760142
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760142,
					"content": "Lütfen bölge halkının ve vahşi hayvanların güvende olmasına dikkat edin! Tabii kendi güvenliğinize de!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760143
					],
					"speakerTitle": "???"
				},
				{
					"id": 730760143,
					"content": "Anlaştık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730760122,
					"content": "Kaçak avcılık ekosisteme zarar veriyor!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760123
					]
				}
			]
		},
