					"id": 741180501,
					"content": "Merhaba, size nasıl yardımcı olabilirim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180502
					],
					"speakerTitle": "Menthe"
				},
				{
					"id": 741180502,
					"content": "Şey, uzun lafın kısası...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180503
					]
				},
				{
					"id": 741180503,
					"content": "Memur Menthe'ye olan biteni anlatıyorsun...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741180504
					]
				},
				{
					"id": 741180504,
					"content": "Ha, mesele Bay Garcia'yla ilgili demek. Anlıyorum, hadi birlikte gidelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180505
					],
					"speakerTitle": "Menthe"
				},
				{
					"id": 741180505,
					"content": "Hiç olmazsa önce şu şüpheli şahsın icabına bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
