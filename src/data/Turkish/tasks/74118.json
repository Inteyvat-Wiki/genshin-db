			"dialogs": [
				{
					"id": 741180601,
					"content": "Teşekkürler Jandarma Menthe... Siz gelir gelmez kuyruğunu kıstırıp kaçtı o hergele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180602
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180602,
					"content": "Ben sadece görevimi yaptım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180603
					],
					"speakerTitle": "Menthe"
				},
				{
					"id": 741180603,
					"content": "Görünüşe göre bu şehirden hemen ayrılıp tez zamanda Petrichor'a dönsek iyi olacak efendim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180604
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180604,
					"content": "Sabırları tükenmek üzere gibi... Daha saldırgan eylemlerde bulunmaya başlayabilirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180605
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180605,
					"content": "Bu durumu üstlerime bildireceğim. Birkaç gün içinde yanıt alırsınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180606
					],
					"speakerTitle": "Menthe"
				},
				{
					"id": 741180606,
					"content": "Hatta size eşlik edecek birkaç görevli bile gönderebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180607
					],
					"speakerTitle": "Menthe"
				},
				{
					"id": 741180607,
					"content": "Maalesef kaynaklarımız sınırlı, şehirde ilgilenmemiz gereken meseleler de var. Bu yüzden size en fazla yolun yarısına kadar eşlik edebiliriz, Petrichor'a kadar değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180608
					],
					"speakerTitle": "Menthe"
				},
				{
					"id": 741180608,
					"content": "Ayrıca gidene kadar kalabileceğiniz güvenli bir yer bulsanız iyi olur. Bu meselenin sonuca ulaşması biraz vakit alabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180609,
						741180610
					],
					"speakerTitle": "Menthe"
				},
				{
					"id": 741180609,
					"content": "Eşlik etme işini bana bırakın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180611
					]
				},
				{
					"id": 741180611,
					"content": "Teşekkürler. Siz yanımızda olursanız saçma sapan işlere kalkışmaya cüret edemezler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180612
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180612,
					"content": "İyi de Kaia kumpanyada görevli değil mi? Siz Petrichor'a giderseniz ona ne olacak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180613,
					"content": "Ben de onlarla giderim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180614
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180614,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180615
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180615,
					"content": "Sizden rica ediyorum hanımefendi, lütfen yapmayın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180616
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180616,
					"content": "Sevgili Lutong, yorma kendini lütfen. Benim de patronundan pek farkım yok, biliyorsun. Bildiğimi okurum hep.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180617
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180617,
					"content": "İyi ama kim bilir ne tür tehlikeler bekliyor bizi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180618
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180618,
					"content": "İşte bu yüzden sizinle gelmem lazım ya zaten! Geçen seferki gibi beni tek başıma, elimde ne başı ne de sonu olan bir besteyle ortada mı bırakacaksınız yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180619
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180619,
					"content": "Hem kumpanya yönetmenimiz, senin makinayla bestelenen müziklerine bir hayli ilgi duyuyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180620
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180620,
					"content": "Eminim ki sizinle birlikte gelmemi destekleyecektir. Kararım belli yani. Ee, nereye gidiyoruz şimdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180621
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180621,
					"content": "S-Sumeru'da olduğu gibi... Kaia yine Garcia'yı sindiriverdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180622,
					"content": "Garcia'nın Kaia ile aşık atması mümkün değil ki...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180623
					]
				},
				{
					"id": 741180623,
					"content": "Bay Garcia haklı çıkmak istemediği içindir belki de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180624
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180624,
					"content": "*öksürür* Lutong! Acele edelim, kalacak doğru düzgün bir yer bulmamız lazım! Kalabalık bir yer tercihimdir tabii...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180625
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180625,
					"content": "Kalabalık bir yer istiyorsanız eğer... Belki şeye gidebiliriz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180626
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180626,
					"content": "Kumpanyamızın kaldığı otele mi gitsek? Orası hep kalabalık olur, herkes de birbirini tanır zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180627
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180627,
					"content": "Yabancının biri aramıza sızmaya kalkışırsa hemen göze batar. Ayrıca kumpanya yönetmenimiz, senin şu Numaralandırma Makinası hakkında daha fazla şey öğrenmek isteyecektir eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180628
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 741180628,
					"content": "Iı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180629
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180629,
					"content": "O zaman karar verilmiştir! Şahane, tüm sorunlarımız halloldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180630
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180630,
					"content": "Tüm sorunlarımız derken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180631
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180631,
					"content": "#Anlaştık o zaman. {NICKNAME}, bu sizin. Hizmetleriniz için bir avans olarak düşünebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180632
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180632,
					"content": "Ne zaman yola çıkarız bilmiyorum ama o zaman geldiğinde işinizi layığıyla yapacağınıza inancım tam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180633
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180633,
					"content": "İyi de... Ben neden şimdi başımızda eskisinden daha fazla sorun varmış gibi hissediyorum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180610,
					"content": "Onları ben korurum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180611
					]
				}
			]
		},
