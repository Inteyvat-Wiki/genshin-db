			"dialogs": [
				{
					"id": 741180401,
					"content": "Tahmin ettiğim gibi... Bay Garcia'yı şahin gibi izliyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180402
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180402,
					"content": "Tezgahın yanındaki masanın oraya baksana. Önünde şapka olan adam var ya hani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180403
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180403,
					"content": "Son birkaç gündür peşimizden ayrılmayan adamın o olduğundan eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180404,
						741180405
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180404,
					"content": "Gidip Jandarmaları çağırayım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180406
					]
				},
				{
					"id": 741180406,
					"content": "Yapabileceğimiz en mantıklı şey bu olabilir... Yakınlarda da bir Jandarma var zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180407
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180407,
					"content": "Bu vakayı daha önce Jandarma Menthe'ye bildirmiştik, kendisinin durumdan haberi var yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180408
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180408,
					"content": "Bize yardım etmek isteyeceğinden eminim. Bir Jandarma burada olduğu müddetçe kimsenin tuhaf işler yapmaya kalkışacağını sanmam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180409
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180409,
					"content": "#{NICKNAME}, lütfen gidip Jandarma Menthe'yle konuşun. Ben de gidip Bay Garcia'yla konuşayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180410
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180410,
					"content": "Hadi gidelim o zaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180405,
					"content": "E Jandarmaları çağır işte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180406
					]
				}
			]
		},
