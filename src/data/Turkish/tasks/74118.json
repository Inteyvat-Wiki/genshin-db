						741185003
					]
				},
				{
					"id": 741185003,
					"content": "Bu şüphelilerin kim olduğunu tespit etmemiz şart.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185004
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185004,
					"content": "Durumu Jandarmalara bildirmiş olsak da ortada bir ipucu falan yokken onların da elinden pek bir şey gelmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185005
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185005,
					"content": "Hem Fontaine Şehri kocaman bir yer. Jandarmalar bizi gittiğimiz her yerde nasıl korusun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185006
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185006,
					"content": "Artık Kaia'yı da bu işe bulaştırdığımız için her şey daha da karmaşık bir hal aldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185007
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185007,
					"content": "Umarım Bay Garcia, Kaia Hanım'ı Fontaine'den ayrılmaya ikna edebilir. O durumda asıl planımıza göre devam edebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185008,
					"content": "Her neyse, Garcia'nın araştırması çıkmaza girmedi mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741185009
					]
				},
				{
					"id": 741185009,
					"content": "Performansı artırmanın başka bir yolu olmadığında bu duruma \"çıkmaz\" diyebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185010
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185010,
					"content": "Gelgelelim pratik uygulamalar açısından düşününce bu Numaralandırma Makinasının harika başarılar elde etmesi mümkün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185011
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185011,
					"content": "Sorun şu ki pratiklik söz konusu olduğunda Bay Garcia hiç oralı olmuyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185012
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185012,
					"content": "Bana sorarsanız bu kadar sıkıntı yaşamasının nedenlerinden biri de bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741185013
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185013,
					"content": "Öte yandan, çilekeş araştırmacı rolüne cuk oturmasının sebebi de bu olabilir tabii...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741185014,
					"content": "Hoşça kal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741185015
					]
				},
				{
					"id": 741185015,
					"content": "Teşekkürler, size güveniyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				}
			]
