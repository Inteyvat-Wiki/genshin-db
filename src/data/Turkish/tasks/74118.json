			},
			"dialogs": [
				{
					"id": 741180101,
					"content": "... Efendim, ilk önce Petrichor Köyü'ne gitsek iyi olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180102
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180102,
					"content": "Bay Xavier ve Bay Félix köyde değil fakat Bay Mécantre ve Bay Babisse hâlâ orada olsa gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180103
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180103,
					"content": "Belki size bazı önerilerde bulunup biraz ilham verirler. En azından iki kelime sohbet edip içinizi dökebileceğiniz birileri olur işte, ne dersiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180104
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180104,
					"content": "Hayır sevgili Lutong, olmaz... Mécantre ile Babisse'in araştırması almış başını gidiyor artık, tam gaz ilerlemeye devam ediyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180105
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180105,
					"content": "Son mektuplarında Fontaine Araştırma Enstitüsünden son derece zeki bir adamın Petrichor'a geldiğinden bahsetmişlerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180106
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180106,
					"content": "Dediklerine göre Bay Bossuet adlı bu ziyaretçi son derece bilgili ve gözlem yeteneği yüksek biriymiş. Birtakım sorunları çözmelerine de yardım etmiş üstelik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180107
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180107,
					"content": "Bir de bana bak... *iç çeker*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180108,
						741180109
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180108,
					"content": "Garcia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180110
					]
				},
				{
					"id": 741180110,
					"content": "#Ne güzel bir tesadüf bu böyle {NICKNAME}. Sizi Fontaine'de göreceğimiz aklımızın ucundan geçmezdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180111
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180111,
					"content": "Gerçi... Zamanlamanız da her zamanki gibi mükemmel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180112
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180112,
					"content": "#Harika bir zamanlama cidden... Yine de seni gördüğümüze sevindik {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180113
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180113,
					"content": "Aa, ne kadar yorgun görünüyorlar öyle! Gözlerinin altı mosmor olmuş... Kollarını kaldıracak halleri de yok gibi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180114,
					"content": "Ne oldu Garcia?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180115
					]
				},
				{
					"id": 741180115,
					"content": "Biz... Şey... Araştırmasında beklenmedik bazı sorunlar çıktı da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180116
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180116,
					"content": "Uzun hikaye, boş verin... Şimdi Epiclese Opera Salonuna gidip halletmemiz gereken bazı hesap işleri var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180117
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180117,
					"content": "İşlerimizi hallettikten sonra sakin bir yerde oturup konuşabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180118
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180118,
					"content": "İşleriniz daha bitmedi mi yani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180119
					]
				},
				{
					"id": 741180119,
					"content": "İş demek doğru olmaz aslında... Bizi bazı hesaplamalara yardımcı olmamız için tuttular diyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180120
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180120,
					"content": "Epiclese Opera Salonu kısa süre önce bir dizi kumpanyayı ağırladı ve acilen muhasebe işlerinin yapılması gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180121
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180121,
					"content": "Eh, Petrichor'a dönüş masraflarına yetecek kadar para kazanmamız lazım. O yüzden bu görevi biz... Şey, yani Bay Garcia yerine ben kabul edeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180122
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180122,
					"content": "Cık! Ne gerek var? O \"hesaplamaları\" küçücük bir çocuk bile yapar. Numaralandırma Makinasını kullanmadan bile bir çırpıda halledilecek bir iş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180123
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 741180123,
					"content": "Para biriktirmek için on numara bir yol anlayacağınız. Hadi hemen yola koyulalım efendim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180124
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180124,
					"content": "#Siz de bize eşlik etmek ister misiniz {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180125
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180125,
					"content": "Yanımızda sizin gibi itibarlı biri olursa yolda bir belayla falan karşılaşmayız belki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180126
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180126,
					"content": "İçiniz rahat olsun, emeğinizin karşılığını da alacaksınız elbette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180127,
						741180128
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180127,
					"content": "Tamam o zaman.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180129
					]
				},
				{
					"id": 741180129,
					"content": "Ondan o kadar emin olmayın derim... Hehe. Neyse, artık yola koyulmamız gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180128,
					"content": "Şehrin ortasında ne belası?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180129
					]
				},
				{
					"id": 741180109,
					"content": "Fontaine'e mi döndün?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180110
					]
				}
			]
		},
