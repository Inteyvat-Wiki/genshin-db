						],
						"pointId": 5698
					}
				]
			},
			"dialogs": [
				{
					"id": 741180301,
					"content": "... Burası uygun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180302
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180302,
					"content": "Müsaadenizle baştan anlatayım. Sumeru'da Numaralandırma Makinası için bize yardım ettiğiniz zamandan beri cihazın performansı önemli ölçüde arttı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180303
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180303,
					"content": "Doğal olarak Bay Garcia bu konuda fazlasıyla heyecanlıydı ve makinayı geliştirmeye devam etmek istiyordu. Ne var ki kendisinin de daha önceden bahsettiği üzere geleneksel mekanizmaların aktarım yapısı oldukça kısıtlı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180304
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180304,
					"content": "Artık bu Numaralandırma Makinasının performansında çığır açacak bir gelişme sağlayamıyorduk. Bu yüzden yeni ilham kaynakları bulup fikir edinmek için Fontaine'e dönmeye karar verdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180305
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180305,
					"content": "Ancak döndüğümüzde Bay Garcia'nın yanına çok tuhaf biri geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180306
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180306,
					"content": "Araştırma için bütçe sağlayabileceğini, hatta Bay Garcia'ya başka araştırma ortakları bulabileceğini bile söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180307
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180307,
					"content": "Ancak bir sorun vardı. Bunların karşılığında Bay Garcia'dan tüm tasarımlarını ve verilerini onunla paylaşmasını istedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180308,
						741180309
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180308,
					"content": "Garcia böyle bir şeyi hayatta kabul etmez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180310
					]
				},
				{
					"id": 741180310,
					"content": "Aynen öyle! Daha en başından birinden araştırma bulgularını istemek... Düpedüz hırsızlık denir buna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180311,
					"content": "Kesinlikle. İşte o yüzden Bay Garcia bu teklifi kibarca reddetti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180312
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180312,
					"content": "Fakat daha sonra birileri bizi takip ediyormuş gibi hissetmeye başladık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180313
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180313,
					"content": "Hatta biz dışarıdayken biri odamıza girip eşyalarımızı karıştırmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180314
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180314,
					"content": "O kişi her kimse her şeyi bulduğu gibi bırakmaya özen göstermişti ama Bay Garcia yine de ardında bıraktığı izleri fark etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180315
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180315,
					"content": "Ç-Çok korkunçmuş ya... Verileri o kişiye vermediğiniz için gelip kendisi mi almaya kalkışmış yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741180316,
					"content": "Odamızın bu şekilde karıştırıldığını fark ettikten sonra buradan ayrılmaya ve en kısa sürede Petrichor'a dönmek için para biriktirmeye karar verdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180317
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180317,
					"content": "Oraya varınca da planımız, Düşler Kulübündeki diğer saygıdeğer beyefendilerle iletişime geçip bu soruna birlikte bir çözüm bulmak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180318
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180318,
					"content": "Malum, Petrichor zaten... Bay Garcia'nın kendi sahası diyelim, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180319
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180319,
					"content": "Onun gözünde oradan daha güvenli bir yer yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180320
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180320,
					"content": "Aslında bugün Petrichor'a gitmeyi planlıyorduk. Siz de bizimle gelip arkamızı kollarsınız diye ummuştuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180321
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180321,
					"content": "Burada Kaia Hanım ile karşılaşacağımızı da hiç tahmin etmemiştik gerçi. Güvenlikten ödün vermemek adına Bay Garcia'nın onu şehre geri götürmesini sağladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180322,
						741180323
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180322,
					"content": "Ben ne yapabilirim peki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180324
					]
				},
				{
					"id": 741180324,
					"content": "Dönüş tarihini ertelememiz gerekecek, orası belli oldu. Lütfen gidip Bay Garcia'yı bulun, elinizi çabuk tutmalısınız. Daha önce de söylediğim gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180325
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180325,
					"content": "Yanımızda sizin gibi itibarlı biri olursa yolda bir belayla falan karşılaşmayız belki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180326,
						741180327
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180326,
					"content": "Hemen gidiyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180330
					]
				},
				{
					"id": 741180330,
					"content": "Bay Garcia durumu Kaia Hanım'a da anlatacaktır. Sonrasında ne yapacağı artık Kaia Hanım'a kalmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180331
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180331,
					"content": "Neyse, en kısa zamanda şehre geri dönsek iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180327,
					"content": "Gerçekten tehlikede değillerdir, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180328
					]
				},
				{
					"id": 741180328,
					"content": "Hayır, sanmam. Sonuçta Bay Garcia hâlâ Fontaine Şehri'nde, orada da bir sürü Meka Jandarma devriye geziyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180329
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180329,
					"content": "Şiddete başvurmaya kalkışan olursa Asayiş Dairesi, sorunun büyük kısmını halleder zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741180330
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 741180323,
					"content": "Nasıl yardımcı olabilirim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180324
					]
				},
				{
					"id": 741180309,
					"content": "Kötü niyetli biri olduğu belli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741180310
					]
				}
			]
		},
