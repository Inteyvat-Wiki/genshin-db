			"dialogs": [
				{
					"id": 766760101,
					"content": "Herkesin eline sağlık! Bu parti gerçekten kusursuz ilerliyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760102
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 766760102,
					"content": "Sumeru'dan gelen dostlarımızın çoğu bizim dans stillerimizi öğrendi... Danslarımızın Teyvat'ta yayılmaya başladığını şimdiden görebiliyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760103
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 766760103,
					"content": "Umarım sırayla birbirimizi ziyaret ederek bu dans partisini bir geleneğe dönüştürebiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760104
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 766760104,
					"content": "Yani Natlan'ın sürüngenleri de Münzeviler gibi kılıç dansları yapabilecek mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760105,
						766760106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766760105,
					"content": "O efsanevi \"savaş dansı\" da var...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766760107
					]
				},
				{
					"id": 766760107,
					"content": "Ne? Kılıç Amca ile diğerlerinin Nusta onlarla ilk tanıştığında Kutsanmış Kızıl Akbabaları korkutup kaçırmak için kullandığı ürkütücü hamlelerden mi bahsediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760108
					],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 766760108,
					"content": "O hareketlerin nereden geldiğini söylemedi mi sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760109
					],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 766760109,
					"content": "Evet, söyledi. İsmine ne demişti... \"Alevli Yele ile Balıkçıl Muhafızının Düeti\" miydi? İsmi çok beğendim, hem zarafeti hem de gücü yansıtıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760110
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 766760110,
					"content": "Aa, o iki isim Paimon'a tanıdık geldi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760111,
						766760112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766760111,
					"content": "Bana iki dostumu anımsattı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766760113
					]
				},
				{
					"id": 766760113,
					"content": "#{NICKNAME} ve Paimon, evet. Herhalde buna çok da şaşırmamışsınızdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760114
					],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 766760114,
					"content": "Kutsanmış Kızıl Akbabalarla karşılaştığınız yer, Alev Canavarlarının yük hayvanı kervanının düzenli olarak ziyaret ettiği bir yolun yakınında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760115
					],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 766760115,
					"content": "Bir süre önce, Dehya ile Candace'ı Aaru Köyü'ne getiren bir kervan aynı kızıl akbaba sürüsüyle karşılaşmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760116
					],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 766760116,
					"content": "O gezide yeterince egzersiz yapmadıklarını düşünmüşler ve akbabalara var güçleriyle saldırmışlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760117
					],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 766760117,
					"content": "O zamandan beri de Alev Canavarları üyelerinden biri onların hareketlerini taklit ettiğinde akbabalar kaçıp gidiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760118
					],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 766760118,
					"content": "Ah, tam da Paimon'un düşündüğü gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766760119,
					"content": "O gün akbabalar çok şanssızmış desene... Hem Dehya hem de Candace ile karşılaşmışlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760120,
						766760121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766760120,
					"content": "Başlarına geleni hak etmişler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766760122
					]
				},
				{
					"id": 766760122,
					"content": "Bence de! O iki ustadan ders alma şansını kaçırdığıma inanamıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760123
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 766760123,
					"content": "Sumeru'ya bir dahaki gidişimizde beni onlarla tanıştırmalısın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760124
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 766760124,
					"content": "Onlara boks yöntemleriyle ilgili sorular sormayı çok isterim. Özellikle de enerjisini sırayla ayaklar, bacaklar ve gövdeden alarak kollar ve yumruğa ileten o hızlı mı hızlı, güçlü mü güçlü yumrukların ritmini nasıl tutturacağımı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760125
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 766760125,
					"content": "Eminim ki hepiniz gecenin geç saatlerine kadar içip sarhoş olursunuz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766760126
					],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 766760126,
					"content": "Ben de hepinizi ayıltacak bir şey hazırlamak zorunda kalırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 766760121,
					"content": "Dehya ile Candace iyi etmiş!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766760122
					]
				},
				{
					"id": 766760112,
					"content": "Sanırım ne olduğunu tahmin edebilirim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766760113
					]
				},
				{
					"id": 766760106,
					"content": "Kızıl akbabaları korkutup kaçırabilen bir dans...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766760107
					]
				}
			]
		}
	]
}