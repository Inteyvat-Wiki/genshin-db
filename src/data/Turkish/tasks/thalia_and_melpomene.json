				},
				{
					"id": 740760102,
					"content": "En azından girişi hâlâ mühürlü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760103
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760103,
					"content": "Jakob buradaki bilmecenin cevabını bulamamış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760104
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760104,
					"content": "Belki de bir cevap vermiştir ama doğru cevabı bulamamıştır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760105
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740760105,
					"content": "Hımm... Önceki cevaplar \"gölge\", \"hayat\" ve \"aşk\"tı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760106,
					"content": "Önceki bilmecelerden yola çıkarak mantık modülüm bu tablette şöyle yazacağı kanısına vardı:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760107
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760107,
					"content": "\"Hiç ayrılmaz\"... \"Bir anda doğar, çelişkili de olsa sana ebedi istirahatinde eşlik eder\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760108
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760108,
					"content": "Son satırda da \"ilk damlacık\" yazıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760109,
					"content": "Tırtıl, Seymour, siz cevabı biliyor musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
