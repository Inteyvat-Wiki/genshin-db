			"dialogs": [
				{
					"id": 740760501,
					"content": "İlerideki şu şey \"Kişilik\" parçası mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760502
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760502,
					"content": "Önümüzdeki maddenin yoğunluğunu ölçemiyorum. Kütlesi... Sıfır görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760503
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760503,
					"content": "Son parçayı aldık. En azından şimdi düşmanlarımızla biraz pazarlık edecek kozumuz oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760504
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740760504,
					"content": "İyi yanından bakarsak Nergis Haçı Derneğinin Kutsal Kılıcı dövmesini engelleyebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760505,
					"content": "Pek öyle sayılmaz Paimon. Biz de Kutsal Kılıcı dövmek istiyoruz. Kılıcı, onların planlarını durdurmak için kullanacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760506
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740760506,
					"content": "Ann, bu kılıcın senin için ne anlama geldiğini unutmadım elbette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760507
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740760507,
					"content": "İradeyi kesebilen bu Kutsal Kılıcın aynı zamanda gizemi aydınlatmak için bir anahtar olduğunun farkındayım. Açıkçası bu benim için de oldukça önemli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760508
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740760508,
					"content": "Ama şimdilik daha önemli ve öncelikli işlerimiz var. Bu gizemin cevabını daha sonra bulsak senin için bir sorun olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760509
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740760509,
					"content": "Sorun değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760510
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760510,
					"content": "#O halde buyur {NICKNAME}. Lütfen \"Kişiliği\" al.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tırtıl"
				}
			]
		}
	]
