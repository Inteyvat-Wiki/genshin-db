					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740760204,
					"content": "Rakibimiz henüz bilmeceyi çözmemiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760205
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740760205,
					"content": "Buradaki yazıtta şöyle yazıyor: \"Hiç ayrılmaz\"... \"Bir anda doğar, çelişkili de olsa sana ebedi istirahatinde eşlik eder\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760206
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760206,
					"content": "Son satırda da \"ilk damlacık\" yazıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760207,
					"content": "Önceki bölgelerde de bunun gibi bilmeceler vardı. Cevaplarını hâlâ hatırlıyor musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760208
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740760208,
					"content": "\"Gölge\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760209
					]
				},
				{
					"id": 740760209,
					"content": "\"Hayat\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760210
					]
				},
				{
					"id": 740760210,
					"content": "\"Aşk\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760211
					]
				},
				{
					"id": 740760211,
					"content": "Of, cevaplar gitgide soyutlaşıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760212,
					"content": "Tırtıl, Seymour, bu bilmecenin cevabını biliyor musunuz?",
