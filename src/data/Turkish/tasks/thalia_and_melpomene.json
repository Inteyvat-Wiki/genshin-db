				},
				{
					"id": 740760304,
					"content": "Rakibimiz henüz bilmeceyi çözmemiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760305
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740760305,
					"content": "Bu arada \"rakibimiz\" tam olarak kim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760306,
					"content": "Nergis Haçı Derneğinin yüzyıllardır etkin olmadığını, sahip olduğum bilgilerin hâlâ geçerli olduğunu varsayar ve şimdiye kadar yaşanan olayları göz önünde bulundurursak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760307
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740760307,
					"content": "Jakob olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760308
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740760308,
					"content": "Seymour'la uğraşan pislikten mi bahsediyorsun? Ne planlıyor olabilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760309
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760309,
					"content": "Korkarım ki amacı seninkiyle aynı, Nergis Haçı'nın Kutsal Kılıcını dövmek için gereken malzemeleri arıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760310
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740760310,
					"content": "Dernek; yer altı krallığı ve Kadim Fontaine'deki gizli felsefelere dayanarak gereken dört varsayımsal maddeyi burada, nesnel dünyada üretmeyi başardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760311
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740760311,
					"content": "Ne demek istediğinizi anlamadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760312
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760312,
					"content": "Bu esrarengiz şeyler tamamen deneyimseldir. Hatta normal mantığın ve element gücünün ötesinde oldukları bile söylenebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760313
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740760313,
					"content": "Akademideki Spantamad'ın giriş ve ileri seviye tüm kitaplarını uzun zaman önce hafızama ekledim. Element gücü hakkında gizemli olan hiçbir şey yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760314
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760314,
					"content": "Öyle mi? Neyse, özetle bunlar Fontaine'in gelenekleriyle kadim yer altı krallığının teknolojilerinin birleşiminden doğdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760315
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740760315,
					"content": "Ve böylelikle dört tür madde meydana geldi: Hatıra, Dilek, Ruh ve Kişilik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760316
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740760316,
					"content": "Birbirlerine karışmaması için onlara şimdilik \"Hatıra\" parçası, \"Dilek\" parçası, \"Ruh\" parçası ve \"Kişilik\" parçası diyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760317
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740760317,
					"content": "Kutsal Kılıcı yapmak için neden bunlar kullanılıyor peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760318,
					"content": "Nergis Haçı Derneğinin mistik felsefesine göre bu tapınak küçük bir evren, üyeleri yeni tanrılar ve kutsal yağ da kuvvetli irade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760319
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740760319,
					"content": "Kutsal Kılıç ise her şeyi kesip açmak için kullanılan \"mantık\". Bu kılıç ancak bir insanın iradesinden doğabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760320
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740760320,
					"content": "Çok karmaşıkmış.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760321
					]
				},
				{
					"id": 740760321,
					"content": "Mistik felsefeler böyledir işte. Sana yeterince tanıdık gelirse benimsersin. Daha sonra bu türden felsefeler büyüye dönüştüğünde kurgu da gerçekliğe dönüşür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760322
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740760322,
					"content": "Her halükarda rakibimiz henüz bu bilmeceyi çözememiş. Çözmüşse de doğru cevabı verememiş. Bahsi geçen bu rakip Jakob olduğu için ben henüz doğru cevabı veremediğini düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760323
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740760323,
					"content": "Buradaki yazıtta şöyle yazıyor: \"Hiç ayrılmaz\"... \"Bir anda doğar, çelişkili de olsa sana ebedi istirahatinde eşlik eder\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760324
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760324,
					"content": "Son satırda da \"ilk damlacık\" yazıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760325,
					"content": "Önceki bölgelerde de bunun gibi bilmeceler vardı. Cevaplarını hâlâ hatırlıyor musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760326
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740760326,
					"content": "\"Gölge\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760327
					]
				},
				{
					"id": 740760327,
					"content": "\"Hayat\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760328
					]
				},
				{
					"id": 740760328,
					"content": "\"Aşk\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760329
					]
				},
				{
					"id": 740760329,
					"content": "Of, cevaplar gitgide soyutlaşıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760330,
					"content": "Tırtıl, Seymour, bu bilmecenin cevabını biliyor musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7407604,
			"completionStepIds": [
				7407602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
