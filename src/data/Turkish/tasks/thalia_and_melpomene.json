					}
				]
			},
			"dialogs": [
				{
					"id": 740760401,
					"content": "Sanırım \"ilk damlacık\" hakkında bir fikrim var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760402
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740760402,
					"content": "Dünya yaratıldıktan sonra yağan ilk yağmur damlacığını niteliyor olabilir. Bildiğim kadarıyla bu düşünce Kadim Fontaine'de ve Dernekte oldukça yaygın kabul görüyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760403
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740760403,
					"content": "Böyle bir şeyi nasıl bulacağız peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760404,
					"content": "Bu ilk su damlacığı, Teyvat'taki tüm suların bir parçası oldu. O yüzden aslında her su damlacığı \"ilk damlacık\"tır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760405
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740760405,
					"content": "İlk tanrının yücelik potansiyelini yayması gibi işte. Herkesin vücudunda bir parça kutsallık bulunur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760406
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740760406,
					"content": "Ama cevap bu kadar basitse bizden önce gelen kişi bunu çoktan çözmüş olmalıydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760407,
					"content": "Evet. Yanılıyor olabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760408
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740760408,
					"content": "Yanlış bile olsa iyi bir cevaptı. Bu bilmeceleri hazırlayan kişide hiçbir duygusallık sezemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760409
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740760409,
					"content": "O kişi şimdi güvenlikten anlamadığın için sana gülüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760410,
					"content": "Bu soruya bir cevap veremiyorum. Arama sonucunda \"ilk damlacık\" hakkında 1.200 sonuç ile karşılaştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760411
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760411,
					"content": "\"Efsaneye göre dünyadaki ilk şarap damlacığı Rüzgar Tanrısı'na aitmiş...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760412,
						740760414
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760412,
					"content": "Tamam, devam etmene gerek yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760413
					]
				},
				{
					"id": 740760413,
					"content": "Pekala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760416
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760416,
					"content": "Hazır sözü açılmışken... Sanırım sizinle paylaşmak istediğim bir şey var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760417
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760417,
					"content": "Bir efsaneye göre Okeanidler, önceki Su Hükümdarı'nın döktüğü ilk gözyaşından oluşmuşlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760418
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760418,
					"content": "Dünyadaki ilk gözyaşını da bir Okeanid, insanları anlamaya başladıktan sonra dökmüş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760419
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760419,
					"content": "Dünyadaki ilk gözyaşının ağlayan ilk insan bebeğinden gelmesi gerekmez mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760420,
					"content": "Hayvanlar aslında fazla tuzu atmak için gözyaşı dökerler. O huzur dolu zamanlarda insanlar ilk kahkahaların tadına baktılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760421
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760421,
					"content": "Efsaneler bu şekilde yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760422
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760422,
					"content": "Aslında bebeklerin ağlaması ve hayvanların fazla tuzu atmaları da birbirine benzeyen duygusuz davranışlar olarak nitelendirebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760423
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760423,
					"content": "Bebekler dış etkenlerden dolayı ciğerlerini havayla doldurmak için ağlar. Sumeru Amurta kitabında öyle yazıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760424
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740760424,
					"content": "Cevap \"Okeanid\" mi yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760425,
					"content": "Bu bizden önceki kişinin verebileceği bir cevaba benzemiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760426,
						740760428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760426,
					"content": "Bence boşa kafa yoruyorsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760427
					]
				},
				{
					"id": 740760427,
					"content": "Paimon doğru yolda olduğumuza inanıyor ama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760430,
					"content": "Nergis Haçı Derneği hakkında bildiklerime dayanarak bunu mantıklı buluyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760431
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740760431,
					"content": "Kızıl İmparatoriçe bilinmeyen bir yerde rüya görüyor, bu rüyayı görense hiçbir zaman ne demek istediğini söylemiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760432
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740760432,
					"content": "Bilmecelerden bile daha kafa karıştırıcı oldu bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760433,
					"content": "Ne fark eder ki? Zaten yüzdük yüzdük kuyruğuna geldik. Sonuç ne olursa olsun, cevap eninde sonunda ortaya çıkacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760434
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740760434,
					"content": "Sıra sende Ann.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760435
					]
				},
				{
					"id": 740760435,
					"content": "Elbette, bir deneyeyim ama başarısız olursam hızlıca yeni bir cevap düşünün, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760436
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740760436,
					"content": "Açıldı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760437,
					"content": "Son parçayı bizim almamız gerekiyor. Yoksa Kutsal Kılıç, Derneğin eline geçecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740760428,
					"content": "Bence doğru yoldayız!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760429
					]
				},
				{
					"id": 740760429,
					"content": "Rüzgar Tanrısı'nın şarabını bulmaya çalışmaktan iyidir en azından!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740760414,
					"content": "Denemekten zarar gelmez. Hadi Mondstadt'a gidelim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740760415
					]
				},
				{
					"id": 740760415,
					"content": "Madem boşa kürek çekiyoruz, en azından bunu keyif alarak yapalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740760416
					],
					"speakerTitle": "Paimon"
				}
			]
		},
