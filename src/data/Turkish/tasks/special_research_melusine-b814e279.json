			"dialogs": [
				{
					"id": 761930130,
					"content": "(Hı? Y-Yoksa o bir... Melusina mı?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930101
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930101,
					"content": "Vay canına! Gerçek bir Melusina! Ayy... Küçücük, sevimli bir Melusina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930102
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930102,
					"content": "Hımm? Sen... Sen kimsin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930103
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761930103,
					"content": "Hımm... Sana dokunabilir miyim acaba? Senin gibi bir Melusinanın dokusu nasıl hep merak etmişimdir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930104
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930104,
					"content": "Hem bu kadar sevimli hem de akıllı olman... Cildin acaba pürüzsüz müdür yoksa yumuşak mı? Belki de pofuduktur. Hehe... Korkma, sadece küçücük bir dokunacağım o kadar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930105
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930105,
					"content": "Ah... Ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930106
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761930106,
					"content": "Hanımefendi, lütfen hareketlerinize dikkat edin ve kanunlara aykırı eylemlerden kaçının.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930107
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761930107,
					"content": "Mamere Hanım bir Fontaine vatandaşıdır. Kendisine izinsiz fiziksel temasta bulunmak yanlış anlaşılmalara yol açabilir ve üç yıldan fazla hapis ve kalıcı giriş yasağı gibi ciddi yasal sonuçlar doğurur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930108
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761930108,
					"content": "Aman tanrım! Hareket eden ve konuşan bir makina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930109
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930109,
					"content": "Öhöm... Kusura bakmayın lütfen. O kadar sevimliydi ki kendime hakim olamadım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930110
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930110,
					"content": "Ben Linnea. Maceracılar Loncası için çalışan bir danışmanım. Şey... Yemin ederim ki öyle tuhaf biri değilim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930111
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930111,
					"content": "İtiraz ediyorum. Şüpheli davranışlarda bulunan şahıslar sıklıkla \"tuhaf biri olmadıklarını\" iddia ederler. Bu, tümdengelimli akıl yürütmenin temel bir ilkesidir Linnea Hanım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930112
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761930112,
					"content": "Aaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930113
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930113,
					"content": "Her önüne gelene tuhaf dememelisin Seymour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930114
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761930114,
					"content": "Bu minik peri kızın renkleri ne kadar da güzelmiş. Bab{RUBY#[D]Elynas}aya hiç benzemiyor ama sıcak bir enerjisi var ve çok güzel görünüyor. Demek ki tuhaf biri değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930115
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761930115,
					"content": "İtiraz ediyorum. Mor renk dışında, renklerin kişinin ahlaki değerleriyle genellikle bir ilgisi yoktur. Bu, tümdengelimli akıl yürütmenin temel bir ilkesidir Mamere Hanım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930116
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761930116,
					"content": "... Ben insanların kıyafetlerinden bahsetmiyordum Seymour.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930117
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761930117,
					"content": "Ha? Mor neden istisna ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930118
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930118,
					"content": "Şey... Merhaba Linnea. Ben Mamere. Fontaineli gezgin bir ressamım. Bu da Seymour, benim can dostumdur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930119
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761930119,
					"content": "Burada başka biriyle karşılaşmayı beklemiyordum. Sen de mi ilham aramaya geldin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930120
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761930120,
					"content": "İlham aramak mı... Hım, bir düşüneyim. Arşivime yeni kayıtlar eklemek de bir nevi ilham sayılır herhalde, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930121
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930121,
					"content": "Linnea, Mamere'e pembe Buz Yüzgeçli Balinadan bahseder...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761930122
					]
				},
				{
					"id": 761930122,
					"content": "Ayrıca, hehe... Galiba Maisie haklıymış. Şu Buz Yüzgeçli Balina gerçekten de iyi şans getiriyormuş! Sayesinde çok tatlı bir Melusinayla tanıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930123
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930123,
					"content": "Hanımefendi, lütfen hareketlerinize dikkat edin ve kanunlara aykırı eylemlerden kaçının.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930124
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761930124,
					"content": "B-Biliyorum! İzinsiz hiçbir şeye dokunmam, söz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930125
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930125,
					"content": "Anlıyorum. Hayvanları sever misin Linnea?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930126
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761930126,
					"content": "Tabii ki! *iç çeker*... Keşke ben de bir Melusina gibi hızlı yüzebilseydim... O Buz Yüzgeçli Balinalar nasıl da eğleniyorlardı! Ben de onlarla oynamak isterdim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930127
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761930127,
					"content": "Hımm... Madem öyle, bu resim senin olsun Linnea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930128
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761930128,
					"content": "Bununla daha hızlı yüzemezsin ama odana asarsan belki... Kendini Buz Yüzgeçli Balinalarla oynuyormuş gibi hissedebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761930129
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761930129,
					"content": "Vay canına... Çok sağ ol! Harika bir şey bu! Döndüğümde Speranza'daki herkese göstereceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnea"
				}
			]
		}
	]
}