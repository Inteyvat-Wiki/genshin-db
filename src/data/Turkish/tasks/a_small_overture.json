			"dialogs": [
				{
					"id": 761860201,
					"content": "Gerçekten enfes bir bitki çayı Bayan Sandrone. Adeta samimiyetinizi yudumluyor gibiyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860202,
						761860203
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860202,
					"content": "(Biraz daha oturalım.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860204
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761860204,
					"content": "Pekala. Bir dahaki sefere ben sizi çaya davet edeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860203,
					"content": "Yavaş yavaş toparlansam iyi olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860204
					],
					"speakerTitle": "Kukla"
				}
			]
		}
	]
