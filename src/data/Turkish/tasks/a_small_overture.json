			"dialogs": [
				{
					"id": 761860101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860102
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860102,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860103
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761860103,
					"content": "... Ee, Donuk Ayın Çocukları bu aralar ne alemde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860104
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761860104,
					"content": "Gayet iyi. Ay Tanrıçası'nın geri dönüşü, bize çizilen yolda yürüme kararlılığımızı artırdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860105
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860105,
					"content": "Öyle mi? Bunu duyduğuma sevindim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860106
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761860106,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860107
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761860107,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860108
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860108,
					"content": "Hah... Sanırım gerçekten konuşacak hiçbir şeyimiz yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860109
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761860109,
					"content": "Korkarım bunun sebebi... Donuk Ayın Çocukları ile Fatui arasında bir kalemde silip atılamayacak kadar ağır bir geçmiş olması.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860110
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860110,
					"content": "Tamamen kendi adıma konuşmam gerekirse Nod-Krai'ı korumak ve Ay Tanrıçası'na yeniden kavuşmamızı sağlamak adına gösterdiğiniz çabalara minnettarım Bayan Sandrone. Gelgelelim iş ortaklarınız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860111
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860111,
					"content": "Anlıyorum. Türlü sebeplerden ötürü aramızda dostane bir ilişki, hatta karşılıklı çıkara dayalı bir bağ bile kuramadık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860112
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761860112,
					"content": "Ancak Fatui artık Donuk Ayın Çocuklarından bir şey alma peşinde değil, astlarıma da işleri zorlaştırmamalarını tembihledim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860113
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761860113,
					"content": "Bana kalırsa madem komşuyuz, kusursuz bir ahenk içinde yaşayamasak bile en azından birbirimize saygı gösterebilirsek güzel olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860114
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761860114,
					"content": "Korkarım bu, bugünden yarına olacak iş değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860115
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860115,
					"content": "Orası kesin. Ama işe ufak adımlarla başlayabiliriz. Kendi demlediğim bu bitki çayının tadına bakmak ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860116
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761860116,
					"content": "Aa? Bitki çayı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860117
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860117,
					"content": "Hımm... Ne kadar da yoğun bir aroma. Bunu Donuk Ayın Çocukları usulüyle mi demlediniz? Tanıdığım yabancıların çoğu çayımızdan pek hazzetmez. Siz nasıl...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860118
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860118,
					"content": "Öğrenerek. Ve saygı duyarak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860119
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761860119,
					"content": "Hah... Fena bir ilk adım sayılmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860120
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860120,
					"content": "Umarım damak zevkinize hitap etmiştir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860121
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761860121,
					"content": "Çok hoşuma gitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860122
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860122,
					"content": "Sıcak bir çay eşliğinde edilen samimi sohbetler, yeni dostluklar kurmanın en güzel yolu olmuştur hep.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761860123
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761860123,
					"content": "İçimden bir ses, bunun bu sefer de geçerli olduğunu söylüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				}
			]
		},
