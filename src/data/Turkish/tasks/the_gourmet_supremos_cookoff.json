			"dialogs": [
				{
					"id": 220210701,
					"content": "Yardımların için teşekkür ederim. Üç Lezzetli Şişi hazırlamak kolay olabilir ama yemek malzemelerinin tazeliğine fazladan özen göstermek gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210702
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210702,
					"content": "Kuş Yumurtaları dışında tüm malzemelerden yeterince oldu... Her ihtimale karşı bana iki tane taze yumurta getirebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210703,
						220210705
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210703,
					"content": "Tamamdır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210704
					]
				},
				{
					"id": 220210704,
					"content": "Teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210705,
					"content": "Bunu yapmayı nereden öğrendin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210706
					]
				},
				{
					"id": 220210706,
					"content": "Şogunluğa hizmet ettiğim zamanlarda şarabın yanına bu tarz ufak yemekler hazırlardım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210707
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210707,
					"content": "Ama şimdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210708
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210708,
					"content": "Her neyse, geçmişi bir kenara bırakalım. Kuş Yumurtaları işini sana bırakıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210709
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210709,
					"content": "Ben de burada yemek malzemelerini halledeceğim. Lütfen Kuş Yumurtalarını bulur bulmaz bana getir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
