			},
			"dialogs": [
				{
					"id": 220210101,
					"content": "Hazır olun, bu harika bir yemek olacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210102
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210102,
					"content": "Benim yemeğim de benzer şekilde harika olacak, hazır ol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210103
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210103,
					"content": "Siz ikiniz ne yapıyorsunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210104
					]
				},
				{
					"id": 220210104,
					"content": "Merhaba Gezgin. Parvaneh ve Julie yemek malzemesi topluyor, bizim de onlara yemek hazırlamamız gerekiyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210105
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210105,
					"content": "Ama Munehisa Amcayla ben ne hazırlayacağımıza dair ufak bir anlaşmazlık yaşadık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210106
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210106,
					"content": "Derken yarışmak için ikimiz de birer yemek yapalım dedik. Kazanan bugünün yemeklerinin temasını belirleyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210107
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210107,
					"content": "Ben Liyue'ye has Mücevher Çorbası yapıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210108
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210108,
					"content": "Ben de en iyi yaptığım yemek olan Üç Lezzetli Şiş yapacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210109,
						220210111
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210109,
					"content": "Yardım edebileceğim bir şey var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210110
					]
				},
				{
					"id": 220210110,
					"content": "Vaktin varsa bize bir de hakem lazım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210113
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210113,
					"content": "Ama sadece iki elimiz olmasına rağmen her yemekten dört porsiyon hazırlamamız gerekiyor, bu yüzden biraz fazla yoğunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210114
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210114,
					"content": "Hakemlik yapmadan önce yiyecek hazırlamamıza yardım edebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210115
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210115,
					"content": "Tek kişi olduğun için hangi yemeğe yardım edeceğini seçebilirsin tabii ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210116,
						220210119
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210116,
					"content": "Xudong, bunu tek başına halledebilecek misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210117
					]
				},
				{
					"id": 220210117,
					"content": "Beni merak etme. Eskiden Liyue'de restoran işletiyordum, yani yemek hazırlamak benim için kolay iş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210118
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210118,
					"content": "Tabii biraz yardım alırsam yemeği daha da iyi yapabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210122
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210122,
					"content": "Her neyse, ilgini çeken yemeği seçebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210123,
						220210126
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210123,
					"content": "Xudong, sana yardım edeceğim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210124
					]
				},
				{
					"id": 220210124,
					"content": "Öyle mi? Bu harika bir haber. Munehisa Amca, yemeğime karşı kaybetmeye hazırlan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210125
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210125,
					"content": "Ben öyle kolay pes etmem. Elinden geleni ardına koyma sakın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210126,
					"content": "Munehisa Amca sana yardım edeceğim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210127
					]
				},
				{
					"id": 220210127,
					"content": "Teşekkür ederim. Xudong, hazır ol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210128
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210128,
					"content": "Sorun değil. Elinden geleni ardına koyma sakın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210119,
					"content": "Munehisa Amca, bunu tek başına halledebilecek misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210120
					]
				},
				{
					"id": 220210120,
					"content": "Endişelenme. Tercih ettiğin kimse onu seç. Ben Şogunluktayken tek başıma bir sürü kişiye yemek hazırlardım, şimdi sadece dört porsiyon hazırlayacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210121
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210121,
					"content": "Ama bana yardım edersen eminim yemeği daha da iyi yapabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210122
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210111,
					"content": "O zaman hakeminiz eksik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210112
					]
				},
				{
					"id": 220210112,
					"content": "Hahaha, aynen öyle. Yemekleri deneyecek bir hakem lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210113
					],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
