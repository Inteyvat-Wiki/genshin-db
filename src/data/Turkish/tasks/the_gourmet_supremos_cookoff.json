			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xudong",
					"Kamei Munehisa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220210201,
					"content": "Tamamdır. Teşekkürler Gezgin. Çok güzel kokuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210202
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210202,
					"content": "İlk olarak bunu deneyeceğim... Vay be, harika. Yemek malzemeleri tam ayarında pişmiş ve mükemmel kokuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210203
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210203,
					"content": "Buna \"Mükemmel Mücevher Çorbası\" bile diyebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210204
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210204,
					"content": "Pekala Munehisa Amca, senin yemek nasıl gidiyor? Gezgine göstermeye hazır mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210205
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210205,
					"content": "Şey... Bir hata yaptım. Başladıktan hemen sonra yeterince Kuş Yumurtam olmadığını fark ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210206
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210206,
					"content": "Hemen Kuş Yumurtası almak için ormana gittim ama dönene kadar diğer yemek malzemeleri artık çok beklemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210207
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210207,
					"content": "Taze olmayan yemek malzemeleriyle yapılan Üç Lezzetli Şişten hayır gelmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210208
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210208,
					"content": "Bu kadar ihmalkar davranmış olmaktan utanç duyuyorum. Becerilerimi daha da geliştirmem lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210209
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210209,
					"content": "Bu defa sen kazandın ama sonraki sefere seni kesinlikle yeneceğim Xudong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210210,
						220210214
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210210,
					"content": "İşte böyle Amca.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210211
					]
				},
				{
					"id": 220210211,
					"content": "Haha, kolay bir rakip olmayacağıma söz veriyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210212
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210212,
					"content": "Bu arada Gezgin, bunlar senin için. Yardımların için teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210213
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210213,
					"content": "Sonraki yarışmamıza da kesin gel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210214,
					"content": "Aslında tadı fena değil...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210215
					]
				},
				{
					"id": 220210215,
					"content": "\"Fena değil\" beni tatmin etmiyor. Yemek pişirirken bile kişi mükemmelliği yakalamayı amaçlamalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210216
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210216,
					"content": "Ancak bu şekilde mutfak sanatında ustalaşabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210217
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210217,
					"content": "Anladım, aynen öyle... Tam olarak öyle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210218
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210218,
					"content": "Aynen öyle!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210219
					]
				},
				{
					"id": 220210219,
					"content": "Kılıç ve yemek sanatı bu bağlamda aynı sayılır ve bana sorarsan ikisi de varlık sanatının birer parçasıdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210220
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210220,
					"content": "Harika! İşte böyle Munehisa Amca... Sana inancım tam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210221
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210221,
					"content": "Şey... Bu kadar şey olan biriyle nasıl başa çıkılır bilmiyorum... Ciddi olan. Sanırım yalnızca Julie bunu başarabilir ama o da şu anda burada değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210222
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210222,
					"content": "Açıkçası ben de şok oldum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210223
					]
				},
				{
					"id": 220210223,
					"content": "*öksürür* Yine de çabaların için teşekkür ederim Gezgin. Lütfen bunları kabul et. Ben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210224
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210224,
					"content": "Xudong, sana pişirmeyle ilgili birkaç soru daha sormak istiyorum. Biraz vaktin var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210225
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210225,
					"content": "Ha? Doğru, evet! Hemen geliyorum! Hemen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 2202103,
			"completionStepIds": [
				2202110
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2202110",
							"2"
						],
						"stepId": 2202110,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamei Munehisa",
					"Xudong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220210301,
					"content": "Hımm. Kokusu ve görünümü... Bu Üç Lezzetli Şişlere, Ekstrem Şiş denmeli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210302
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210302,
					"content": "Ekstrem... Şiş mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210303
					]
				},
				{
					"id": 220210303,
					"content": "Hehe, yani çok mükemmel bir yemek olduğunu söylemek istedim... Vay be, saate bak. Xudong'un Mücevher Çorbası da hazırdır şimdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210304
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210304,
					"content": "Tabii ki! İşte Mücevher Çorbam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210305
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210305,
					"content": "Biraz fazla pişmiş duruyor olabilir çünkü zamanlamasını tam tutturamadım ama tadı fena değildir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210306
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210306,
					"content": "Bir tadalım bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210307
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210307,
					"content": "Hafif bir yanık tadı var. Tüm tencereyi berbat edecek kadar kötü değil ama nihayetinde bir kusur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210308
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210308,
					"content": "Hahaha, bu defa acelem vardı. Bir sonraki sefer tüm yemek malzemelerini önden hazırlarım ve bir daha böyle olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210309
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210309,
					"content": "Bu defa sen kazandın ama sonraki karşılaşmamızda aynı hatayı yapmayacağımı bil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210310,
						220210314
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210310,
					"content": "Görünüşe göre dikkatsiz davranmışsın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210311
					]
				},
				{
					"id": 220210311,
					"content": "Hahaha... Evet, dikkatsizdim. Bir sonraki sefer daha dikkatli olmam gerek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210312
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210312,
					"content": "Bu arada Gezgin, bunlar senin için. Yardımların için teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210313
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210313,
					"content": "Sonraki yarışmamıza da kesin gel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210314,
					"content": "Munehisa Amcanın Ekstrem Şişleri günün kazananı oldu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210315
					]
				},
				{
					"id": 220210315,
					"content": "Ekstrem Şişler mi? O ne demek?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210316
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210316,
					"content": "Yani bu Üç Lezzetli Şiş mükemmel yapılmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210317
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210317,
					"content": "Amacın \"ekstrem\" olduğunda yüreğin asla \"kabul edilebilir\" şeylerle tatmin olmaz. Bunun yerine her zaman mükemmellik hedeflersin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210318
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210318,
					"content": "Yemek pişirirken bile kişi her zaman mükemmelliğin peşinde olmalıdır. Ancak bu şekilde mutfak sanatında ustalaşabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210319
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210319,
					"content": "Anladım, aynen öyle... Tam olarak öyle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210320
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210320,
					"content": "Aynen öyle!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210321
					]
				},
				{
					"id": 220210321,
					"content": "Kılıç ve yemek sanatı bu bağlamda aynı sayılır ve bana sorarsan ikisi de varlık sanatının birer parçasıdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210322
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210322,
					"content": "Xudong, sana \"ekstrem\" olmayı anlatayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210323
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210323,
					"content": "Ha? Ta-Tamam. Bir saniye, hemen geliyorum. Gezgin, işte ödemen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210324
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210324,
					"content": "Şey... Bu kadar şey olan biriyle nasıl başa çıkılır bilmiyorum... Ciddi olan. Sanırım yalnızca Julie bunu başarabilir ama o da şu anda burada değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210325
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 220210325,
					"content": "Hadi git de Ekstrem Pişirme tecrübesi kazan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220210326
					]
				},
				{
					"id": 220210326,
					"content": "Xudong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220210327
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220210327,
					"content": "Ha? Geliyorum. Bir saniye! Hemen geliyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
