			"dialogs": [
				{
					"id": 210200001,
					"content": "\"Sanırım açgözlülüğün sonu bu. Her şeyi isteyip nerede duracağını bilmeyince böyle oluyor. Gömülü hazineyi bulduğumda dursaydım ve o aptal, dandik ateşe gitmekte ısrar etmeseydim mekanizmayı hiç tetiklemeyecektim ve o korkunç canavar tarafından buraya hapsedilmeyecektim. Şimdi burada mahsur kaldım.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210200002
					],
					"speakerTitle": "Yıpranmış Mektup"
				},
				{
					"id": 210200002,
					"content": "\"Onu yenebilecek kuvvete sahip olan varsa o ateşte bir dilek dilesin. Ne olduğu önemli değil. Ben de... duygusal açıdan destek olurum. Hehe.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yıpranmış Mektup"
				}
			]
