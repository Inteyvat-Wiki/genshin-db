			"dialogs": [
				{
					"id": 210202001,
					"content": "\"Şu ateşin dilekleri gerçekleştirdiği hikayesi tamamen yalan! Tabii altında gömülü olan hazineler gerçek. Patron o kağıt parçasını bulduğum yerde bırakıp yakınlarda beklememi söyledi. İnsanlar kesin tuzağa düşermiş. Ateş yanmaya başlar başlamaz da... Hehehe. Bu fikir ceplerimizi çok güzel dolduracak.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210202002
					],
					"speakerTitle": "Karalanmış Notlar"
				},
				{
					"id": 210202002,
					"content": "\"Tabii buradaki hazinelerin hepsini tek seferde taşıyamam. Patron hazineyi önce <color=#00E1FFFF>Cuijue Yamacı'ndaki en yüksek tepeye</color> gömmemi söyledi. Dağın tepesinde yaşlı, solmuş bir ağaç var. Göreceğine eminim.\"",
					"roleType": "TALK_ROLE_NPC",
