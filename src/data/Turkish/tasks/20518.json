			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180101,
					"content": "Aa, yine karşılaştık. Nasıl gidiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180102
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180102,
					"content": "Bu arada bir şey daha söylemem gerek. Jilliana için işler fena gitmiyor. İyi haber, henüz Mondstadt'tan ayrılmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180103
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180103,
					"content": "Kötü haberse durumunu Rahibe Victoria'ya itiraf etti. O da henüz bu konuda pek bir şey yapmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180104
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180104,
					"content": "Artık bu olayın sonunu görmek için bize düşen tek şey beklemek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180105
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180105,
					"content": "Neler planlıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180106
					]
				},
				{
					"id": 205180106,
					"content": "Bana hiç öyle bakma. Beni kötü biri falan mı sanıyorsun? Ona nasıl yardım edeceğini gösterdiğimi ne çabuk unuttun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180107
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180107,
					"content": "Neyse, işimize dönelim. Ziyaretimin sebebi önceki olaydan kalan \"yarım kalmış işler\"i çözmek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180108
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180108,
					"content": "Kısacası, Hazine Avcılarını defettin, evet. Ama aynı zamanda Jilliana'yı da ifşa ettin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180109
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180109,
					"content": "Hazine Avcıları hainlere merhamet göstermez. Nelerle uğraştıklarını şimdiden az çok öğrendik ama böyle bir şeyi biz de ilk kez görüyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180110
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180110,
					"content": "Büyük ihtimalle Jilliana'nın peşindeler. Ayrıca kaybettikleri onca şeyin intikamını almak istiyorlar. Onları yenmeni istiyoruz, elimizden bu kadarı geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180111,
						205180113,
						205180115
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180111,
					"content": "Bütün bunların arkasında sen yok musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180112
					]
				},
				{
					"id": 205180112,
					"content": "Lütfen... Ben de emir kuluyum. O beyefendi ısrar etmiş olmasaydı zaten gelip de özellikle senden istemezdim bunu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180121
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180121,
					"content": "Merak etme, bu seferki ödül seni fazlasıyla tatmin edecektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180122
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180122,
					"content": "Bu kez sevgili beyefendimiz bana yüklü miktarda Mora gönderdi. Önceki görevde ödemeni cebimden yaptığımı düşünürsek... Ah evet, Hazine Avcılarının yerini haritanda işaretlesem iyi olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180123
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180123,
					"content": "Tamamdır o halde. Jilliana'yı, Rudolf'u, Lily'yi ve Mondstadt'ı en azından Mora için koru. Artık her şey sana bağlı, elinden geleni yap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180113,
					"content": "Git kendin yap!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180114
					]
				},
				{
					"id": 205180114,
					"content": "Öyle deme. Senin kadar güçlü olmadığımı biliyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180121
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180115,
					"content": "Bununla Şövalyeler ilgilenmeli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180116
					]
				},
				{
					"id": 205180116,
					"content": "Orası öyle ama o beyefendiye göre halihazırdaki şartlar gereği Jilliana'nın yaptıklarını ne kadar az kişi bilirse o kadar iyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180117
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180117,
					"content": "Ayrıca, o beyefendi Şövalyelerin bu işe karışmasını istemiyor. Ne de olsa Şövalyeler açık alanda çatışmaya alışkın, yani sık sık aşırıya kaçıyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180118
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180118,
					"content": "Mesela pek güvenilir şövalyemiz Huffman. Mondstadt'ın yakınlarında Hazine Avcılarının olduğunun haberini alsa bir saate kalmaz alarmı çaldırır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180119
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180119,
					"content": "Sonra Şövalyeler tam kadro taarruza geçerken Hazine Avcıları da onları beklemek yerine anında tüyer. Bir kez daha onlardan kurtulma planımız haliyle boşa gider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180120
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180120,
					"content": "Yani yine tek gidip onları tek başına halletmeni istiyoruz çünkü buna mecburuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180121
					],
					"speakerTitle": "Vile"
				}
			]
		},
		{
			"id": 2051802,
			"completionStepIds": [
				2051804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2051804",
							"2"
						],
						"stepId": 2051804,
						"stateName": "QUEST_STATE_UNFINISHED"
