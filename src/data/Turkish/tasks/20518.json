				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180301,
					"content": "Aynen öyle, saklansanız iyi olur pis hırsızlar. Hele sizi bir yakalarsam... Hakikaten nereye kayboldunuz hepiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180302
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205180302,
					"content": "Nerede saklandıklarını biliyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180303
					]
				},
				{
					"id": 205180303,
					"content": "Sen mi? Nasıl? Ha. Haritadaki işaretler bayağı detaylıymış. Kim işaretledi? Vile mı? Demek o bile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180304
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205180304,
					"content": "Burası bizim daha önce saptadığımız yerin çok uzağında. Amacı ne bu Hazine Avcılarının?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180305
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205180305,
					"content": "Pardon, şu işaretleri not alayım... Tamamdır, aldım. Adamlarımı bu konumları doğrulamaları için bilgilendiriyorum derhal. Doğruladıktan sonra da gidip bu Hazine Avcılarını geri püskürteceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180306
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205180306,
					"content": "Mondstadt'a katkıların için bir kez daha sana minnettarım. Bu kez tek bir Hazine Avcısı bile kaçamayacak elimizden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
		},
		{
			"id": 2051804,
			"completionStepIds": [
				2051806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2051806",
							"2"
						],
						"stepId": 2051806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180401,
					"content": "Ne çabuk döndün. Pek becerikliymişsin. O beyefendinin niye işleri sana bırakmayı bu kadar sevdiğini galiba anlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180402
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180402,
					"content": "Favonius Şövalyelerine bıraktım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180403
					]
				},
				{
					"id": 205180403,
					"content": "Demek Favonius Şövalyelerine bıraktın. Ben sana demedim mi onlara bırakmak sorun çıkarabilir diye?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180404
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180404,
					"content": "İyi biliyorsun kaytarmayı. Neyse ki beyefendi bunu yapabileceğini tahmin etti, ben de B planı hazırladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180405
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180405,
					"content": "Kalanı bize bırak. *iç çeker* Yine koşuşturmam gerekecek galiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180406
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180406,
					"content": "Ama o beyefendiye göre eylemlerin bizi enteresan yerlere götürebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180407
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180407,
					"content": "Sonuçta Hazine Avcılarının faaliyetlerini benim bildirmem biraz fazla göze batardı. O beyefendi de bizzat Şövalyelere başvurmayacağına göre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180408
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180408,
					"content": "Neyse, bunlar sana. Al hepsini. Ne demişti o beyefendi? Hah, \"rüzgarın yönünü değiştirdiğin\" için küçük bir ödül.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				}
			]
		},
		{
			"id": 2051805,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2051802",
