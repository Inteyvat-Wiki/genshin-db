						"stepId": 2051802,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2051803",
							"2"
						],
						"stepId": 2051803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180501,
					"content": "Hâlâ hazırlanıyor musun? Sorun değil. Hazır olunca yola çıkarsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180502,
						205180506
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180502,
					"content": "Kim bu beyefendi bu arada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180503
					]
				},
				{
					"id": 205180503,
					"content": "Ne kadar sorsan da söylemem. Bizim sektörde işler böyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180504
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180504,
					"content": "Herhangi bir bilgi paylaşıyorsak bu ancak mecbur olduğumuz içindir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180505
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180505,
					"content": "Şunu bir düşün mesela: Az önce söylediklerimin hangisi \"mecbur olduğum için paylaştığım bilgiler\" kategorisine girer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 205180506,
					"content": "Amacınız ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180507
					]
				},
				{
					"id": 205180507,
					"content": "O beyefendinin amacı... Tahmin edemiyorum. Ama o da Mondstadt'ı korumak istiyor, buna inanıyorum.",
