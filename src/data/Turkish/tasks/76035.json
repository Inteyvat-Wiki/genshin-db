			"dialogs": [
				{
					"id": 760350101,
					"content": "(Columbina... Burada değil mi?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350102
					]
				},
				{
					"id": 760350102,
					"content": "Beni mi arıyordunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350103
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760350103,
					"content": "Ayyy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350104,
						760350105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350104,
					"content": "Beni korkuttun...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350106
					]
				},
				{
					"id": 760350106,
					"content": "Geldiğinizi hissettiğimde size arkadan ne kadar yaklaşabileceğimi bir denemek istedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350107
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760350107,
					"content": "Yapacak daha iyi bir şeyin yok mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350108,
					"content": "Hımm... Öyle mi duruyorum? Fatui'deyken de çok farklı değildi... Yapacak pek bir şeyim olmuyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350109
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760350109,
					"content": "Çariçe yalnızca Ay Tanrıçası'nın gücünü istiyordu. Hiç Gnosis almaya falan gönderilmedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350110
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760350110,
					"content": "Normalde vakit geçirmek için ne yapıyordun peki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350111
					]
				},
				{
					"id": 760350111,
					"content": "Yürüyüş yapıyordum, ayı izliyordum, bazen de şarkı söylüyordum. Ama Sandrone sonuncusunu yasakladığı için daha az şarkı söyler oldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350112
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760350112,
					"content": "Hımm? Şarkı söylemeni beğenmiyor muydu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350113,
					"content": "Hayır. Aksine övüyordu. Ama o zamanlar Fatui'ye yeni katılmıştım ve sesimin diğerlerini tedirgin ettiğini söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350114
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760350114,
					"content": "Bilmeyenlere bir tür güç kullanmak üzereymişim gibi geliyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350115
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760350115,
					"content": "Aa... Paimon anlıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350116,
					"content": "Ah, doğru. Bir sebebi daha vardı. Geceleri uyanık kalıp araştırma yapıyordu, o yüzden gündüz şarkı söylediğimde uyumakta zorlanıyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350117
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760350117,
					"content": "(Asıl sebebi budur kesin!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350118
					]
				},
				{
					"id": 760350118,
					"content": "Bu yüzden ben de geceleri kapısının önünde şarkı söylemeye başladım. Ama beni kovmaya devam etti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350119
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760350119,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350120,
					"content": "Diğerleriyle iyi anlaşıyor muydun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350121
					]
				},
				{
					"id": 760350121,
					"content": "\"Anlaşmak\"... Hımm... İlk tanıştığımızda Arlecchino, benimle \"iyi anlaşmaya\" hevesli gibi görünüyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350122
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760350122,
					"content": "Az önce size yaptığım gibi sessiz sedasız arkamda belirirdi hep. Beni \"test ettiğini\" söylüyordu sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350123
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760350123,
					"content": "Ben de oyuna katılmaya çalıştım ama her seferinde daha yaklaşamadan fark etti beni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350124
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760350124,
					"content": "En son mecburen Kuuvahki kullandım ve arkasından yaklaşıp onu epey korkutmayı başardım. Ama bir daha benimle o oyunu oynamadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350125
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760350125,
					"content": "(Paimon bunun Yaver için bir \"oyun\" olduğunu hiç sanmıyor...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350126,
					"content": "Başka kim vardı... Haa, Doktor da sık sık benden Işık Diyarı araştırmasına yardım etmemi istiyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350127
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760350127,
					"content": "Birkaç kere kabul ettim ama çok sıkıcıydı. \"Kuuvahki kullanarak şuna vur\", \"Kuuvahki kullanarak bunu kontrol et\"... Bir süre sonra gitmeyi bıraktım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350128,
						760350129
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760350128,
					"content": "Bugün keyfin yerinde gibi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350130
					]
				},
				{
					"id": 760350130,
					"content": "Evet. \"Evden kaçmış\" olsam da hâlâ oraya dair güzel hatıralarım var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350131
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760350131,
					"content": "Arlecchino ve Sandrone bana çok iyi davranıyordu, aynı şekilde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350132
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760350132,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350133
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760350133,
					"content": "(Yüzündeki ifade... Acaba kim geldi aklına?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350134
					]
				},
				{
					"id": 760350134,
					"content": "Elini ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350135,
						760350136
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760350135,
					"content": "... Ha?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350137
					]
				},
				{
					"id": 760350137,
					"content": "Rosalyne bana... Başkalarına teşekkür etmenin önemli olduğunu öğretmişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350138
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760350138,
					"content": "Dinlediğin için teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350139
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760350139,
					"content": "Rica ederim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350140
					]
				},
				{
					"id": 760350140,
					"content": "(Bu... Ay Tanrıçası'nın Lütfu mu?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350141
					]
				},
				{
					"id": 760350141,
					"content": "Bugünlük bu kadar yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350142
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760350142,
					"content": "Vay canına! Çok ani oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350143,
						760350144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350143,
					"content": "Şşş... Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350145
					]
				},
				{
					"id": 760350145,
					"content": "Evet, galiba haklısın. O zaman onu rahatsız etmeyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760350144,
					"content": "Geçmişindeki bir şeyleri hatırladı sanırım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350145
					]
				},
				{
					"id": 760350136,
					"content": "... Neden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350137
					]
				},
				{
					"id": 760350129,
					"content": "Geçmişinden epey bahsettin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350130
					]
				},
				{
					"id": 760350105,
					"content": "Arkamızda bir anda belirmek zorunda mıydın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350106
					]
				}
			]
		}
	]
}