			"dialogs": [
				{
					"id": 111120501,
					"content": "Ne? Hepiniz buradasınız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120502,
					"content": "Eski zamanlardan bahsediyoruz, geçmişi düşünüyoruz... Aslında yıllardır yaptığımız şey.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120503
					],
					"speakerTitle": "Minik Wu"
				},
				{
					"id": 111120503,
					"content": "Kasabamız bir felakette tamamen yerle bir olmuştu, o yüzden gidecek yerimiz yoktu. Şimdiyse dostlarımız neredeyse evimiz orası.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120504
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120504,
					"content": "Tam da şimdi bana hatıralık eşyalar aradığınızı söylüyorlardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120505
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120505,
					"content": "Ben Liyue Limanı'nın orada el yapımı Xiao Fenerleri yapıyorum. Sanırım beni en iyi temsil eden şey onlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120506
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120506,
					"content": "Birkaç gün önce kaliteli Plaustrit Parçaları aldım. Şu anda hepsi rıhtımdaki depoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120507
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120507,
					"content": "Müdürle de konuştum. Acaba onları benim için alabilir misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120508
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120508,
					"content": "Görünüşe göre senin olan bitenden zaten haberin var! Bir çırpıda geri geleceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
