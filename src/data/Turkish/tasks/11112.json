			"dialogs": [
				{
					"id": 111120801,
					"content": "İkinize de teşekkür ederim, bu malzemeler harika görünüyor. Lütfen bir dakika bekleyin, bu son adım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120802
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120802,
					"content": "Pekala, işte oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120803
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120803,
					"content": "Fenerin içine beşimizin de ismini yazdım. Biliyorsunuz, yılda bir yapılan Fener Şenliğinde hepimiz bunun gibi bir fener bırakıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120804
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120804,
					"content": "Gelecek ne getirirse getirsin, hangi yolu seçersek seçelim... Bu şenlik olduğu sürece her birimiz aynı kalırız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120805
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111120805,
					"content": "Koca G mevzusuna gelince... Üçümüz aramızda konuştuk ve sizi bu konuda zorlamayacağımız konusunda uzlaştık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120806
					],
					"speakerTitle": "Minik Wu"
				},
				{
					"id": 111120806,
					"content": "Ama fırsatınız olursa lütfen ona söyleyin... Biz gayet iyiyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120807
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120807,
					"content": "Ve bir zamanlar konuştuğumuz şeylerin hepsi oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120808,
						111120809
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120808,
					"content": "Bize güvenebilirsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120810
					]
				},
				{
					"id": 111120810,
					"content": "Teşekkürler, bunu ileteceğiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120811,
					"content": "Koca G sizin gibi dostlara sahip olduğu için çok şanslı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120809,
					"content": "Ben de \"bir zamanlar konuştuğunuz şeyler\" konusunda sizi zorlamayacağım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120810
					]
				}
			]
