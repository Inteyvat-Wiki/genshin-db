			},
			"dialogs": [
				{
					"id": 111120101,
					"content": "Bütün bu olan bitenden sonra Paimon bile artık neler olduğundan emin değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120102,
						111120103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120102,
					"content": "Ben de Koca G'ye bu şekilde rastlamayı beklemiyordum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120104
					]
				},
				{
					"id": 111120104,
					"content": "Aslında ben hiç şaşırmadım. Ne dediğimi hatırlıyor musunuz? Bu dünyaya gelebilecek kötü ruhların bir sınırı var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120105
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120105,
					"content": "Onun ilk başta Wuwang Tepesi'nden ayrılması kaderin bir cilvesiydi. Şimdiyse bir sebeple geri dönemiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120106
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120106,
					"content": "Bu açıklama Paimon'a biraz zorlama geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120107,
					"content": "Aslına bakarsanız... Durumu özetlemiş oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120108
					],
					"speakerTitle": "Koca G"
				},
				{
					"id": 111120108,
					"content": "Hı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120109,
					"content": "Hehe, benim mesleki içgüdülerimi sorgulama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120110
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120110,
					"content": "Ben sadece arkadaşlarım neler yapıyor, görmek istemiştim. Bu yüzden Liyue Limanı'na geldim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120111
					],
					"speakerTitle": "Koca G"
				},
				{
					"id": 111120111,
					"content": "Yemin ederim haylazlık peşinde değildim! Kimseyi korkutmak istemedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120112
					],
					"speakerTitle": "Koca G"
				},
				{
					"id": 111120112,
					"content": "Birkaç gün önce birkaç kişi meydan okuma üzerine Wuwang Tepesi'ne geldiler. Onların Liyue Limanı'ndan geldiklerini duydum o yüzden onlardan birini takip edip buraya kadar geldim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120113
					],
					"speakerTitle": "Koca G"
				},
				{
					"id": 111120113,
					"content": "Ah, takip ettiğin kişi zavallı Luocheng olmalı. Belki seni fark etmemiştir ama yine de varlığını hissedebilmiş. Şimdi onun kabuslarına neyin sebep olduğunu biliyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120114
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120114,
					"content": "İ-İfşa mı oldum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120115
					],
					"speakerTitle": "Koca G"
				},
				{
					"id": 111120115,
					"content": "Sanırım öyle, yoksa korkudan aklı çıkmamış olurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120116
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120116,
					"content": "Neden Meng'i aramaya daha önce gelmedin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120117
					]
				},
				{
					"id": 111120117,
					"content": "Evet, Hu Tao ve Meng her yerde seni arıyorlardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120118,
					"content": "Çünkü onları bulamadım. Liyue Limanı'na ilk gelişim ve şehirde kayboldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120119
					],
					"speakerTitle": "Koca G"
				},
				{
					"id": 111120119,
					"content": "Sözü gelmişken, Koca G'nin yön duygusu her zaman zayıftı. Biz çocukken tepeden asla tek başına inemezdi. Hep ona yol göstermek zorunda kalırdık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120120
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111120120,
					"content": "Yani tüm bunlar sen kaybolduğun için mi oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120121,
					"content": "Neden uçup gitmedin? Hani diğer hayalet ve ruhlar gibi. Sence de yukarıdan bakarak yolu bulmak daha kolay değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120122,
					"content": "Ben... Uçamam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120123
					],
					"speakerTitle": "Koca G"
				},
				{
					"id": 111120123,
					"content": "Benim için çok yüksek, korkuyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120124
					],
					"speakerTitle": "Koca G"
				},
				{
					"id": 111120124,
					"content": "Doğru, evet! Eskiden yüksekten o kadar korkuyordu ki tepeden aşağıya bile bakamıyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120125
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111120125,
					"content": "Hahaha, hiç değişmemişsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120126,
						111120127
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111120126,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120128
					]
				},
				{
					"id": 111120128,
					"content": "Yaşayanlara kendimi göstermemem gerektiğini biliyordum ve Liyue Limanı'nda etrafta o kadar insan yürürken tek seçeneğim saklanmaktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120129
					],
					"speakerTitle": "Koca G"
				},
				{
					"id": 111120129,
					"content": "Ley Hattı Anıtının çağrısı olmasaydı sizi bulamazdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120130
					],
					"speakerTitle": "Koca G"
				},
				{
					"id": 111120130,
					"content": "Kötü bir ruh olmadığın için çok rahatladım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120131
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111120131,
					"content": "Dediğim gibi, mesleki içgüdülerimden asla şüphe etmeyin. Şimdi tek yapmamız gereken bu kayıp çocuğa Wuwang Tepesi'ne kadar eşlik edip bu durumu tatlı bir sona bağlamak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120132
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120132,
					"content": "Ama daha şimdi arkadaşlarını ziyaret etmek istediğini söyledi. Benim dışımda Minik Wu, Mumu ve Congzi var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120133
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111120133,
					"content": "Peki... Durum buysa onu yüzüstü bırakamayız. Onlardan Koca G için bir veda merasimi hazırlamamıza yardım etmelerini isteriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120134
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120134,
					"content": "Meng ve ben Koca G'ye Wuwang Tepesi'ne kadar eşlik edeceğiz. Siz de o üçüyle görüşün ve tören sırasında her birini temsil eden hatıralık eşyalar isteyin. Sonra da gelip bizi bulun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120135
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120135,
					"content": "Onların hepsi arkadaş, oraya hep beraber gidemez miyiz? Veya Koca G'yi onlara götürebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120136,
					"content": "Hım... Bu iyi bir fikir değil. Onları korkutmak istemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120137
					],
					"speakerTitle": "Koca G"
				},
				{
					"id": 111120137,
					"content": "Sıradan insanların batıl inanç sahibi olmaya başlamalarını istemiyorum... Ne kadar az şey bilirlerse o kadar iyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120138
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120138,
					"content": "O yüzden hatıralık eşyaları toplarken dediklerinize dikkat edin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111120127,
					"content": "İyi ki sana \"Uzun G\" dememişler...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120128
					]
				},
				{
					"id": 111120103,
					"content": "Yani Koca G kötü ruh değil miymiş?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120104
					]
				}
			]
		},
		{
			"id": 1111202,
			"completionStepIds": [
				1111202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111202",
							"2"
						],
						"stepId": 1111202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Minik Wu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111120201,
					"content": "Şey... Merhaba... Hehe... Bizi hatırladın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120202,
					"content": "Of yine mi siz? Üzgünüm, yakın zamanda cenaze evinin hizmetlerine ihtiyacım olmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120203,
						111120204
					],
					"speakerTitle": "Minik Wu"
				},
				{
					"id": 111120203,
					"content": "Meng bize geçmişini anlattı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120205
					]
				},
				{
					"id": 111120205,
					"content": "Evet, birlikte büyüdük. Şimdi bile iletişimimizi koparmadık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120206
					],
					"speakerTitle": "Minik Wu"
				},
				{
					"id": 111120206,
					"content": "Neden Wangsheng Cenaze Evinde çalışmaya başladığını bilmiyorum. Dürüst olmak gerekirse oranın müdürünü oldukça tuhaf buluyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120207
					],
					"speakerTitle": "Minik Wu"
				},
				{
					"id": 111120207,
					"content": "Ama mutlaka nedenleri vardır. Ne de olsa artık kendi başına ve hâlâ Koca G'ye olanları atlatabilmiş değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120208
					],
					"speakerTitle": "Minik Wu"
				},
				{
					"id": 111120208,
					"content": "Size bundan bahsetti mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120209
					],
					"speakerTitle": "Minik Wu"
				},
				{
					"id": 111120209,
					"content": "Evet, bahsetti. Koca G'ye hatıralık olarak tek bir şey verecek olsaydın ne seçerdin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120210,
					"content": "Yani, teorik olarak tabii. Burada farazi olarak konuşuyoruz, yoksa kesinlikle gidip onu anma töreni gibi bir şey yapmayacağız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120211,
						111120212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120211,
					"content": "(Niyetimizi doğrudan belli ettin.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120213
					]
				},
				{
					"id": 111120213,
					"content": "Ben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120214
					],
					"speakerTitle": "Minik Wu"
				},
				{
					"id": 111120214,
					"content": "Onun için bir şey pişirirdim. Hiç kimse onun kadar baharatlı yemek yiyemezdi. En sevdiği yemek ekstra baharatlı Acılı Jueyun Tavuğuydu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120215
					],
					"speakerTitle": "Minik Wu"
				},
				{
					"id": 111120215,
					"content": "Bana birkaç tane Jueyun Biberi getirirseniz sizin için pişirebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120216
					],
					"speakerTitle": "Minik Wu"
				},
				{
					"id": 111120216,
					"content": "Eminim çocukluk yıllarının lezzetinden zevk alırdı. Hâlâ eski tarifi kullanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120217
					],
					"speakerTitle": "Minik Wu"
				},
				{
					"id": 111120217,
					"content": "Anlaştık! Bize bir dakika ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120212,
					"content": "(Klasik Paimon...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120213
					]
				},
				{
					"id": 111120204,
					"content": "Meng senin eski bir arkadaşı olduğunu söyledi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111120205
					]
				}
			]
		},
		{
			"id": 1111203,
