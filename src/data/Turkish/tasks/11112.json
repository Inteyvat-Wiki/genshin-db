			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mumu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111120401,
					"content": "Ah... Yine mi siz. Size söyledim, Wangsheng Cenaze Evinin ne işler çevirdiğiyle hiç ilgilenmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120402
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120402,
					"content": "Meng senden bahsetti. İyi arkadaşsınız, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120403,
					"content": "Bu doğru, evet. Aklıma gelmişken, onun geçenlerde Wangsheng Cenaze Evinde çalışmaya başladığını hatırlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120404
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120404,
					"content": "Dostlarının bunun nedenini anlaması uzun sürmedi... Koca G olayı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120405
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120405,
					"content": "Ama bunu atlatması için ona söyleyebileceğimiz hiçbir şey olmadığını biliyorum. Geçmişi geride bırakmak acılı bir süreç. Bilirim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120406
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120406,
					"content": "Yani, beni görmeye gelme sebebiniz Koca G mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120407
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120407,
					"content": "Nereden bildin? Daha hiçbir şey söylemedik bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120408,
					"content": "Haha, ben bir iş adamıyım. Bu tür şeyler konusunda önsezilerim iyidir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120409
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120409,
					"content": "Herkes \"Mumu\" ismini duyunca beni ahmak sanıyor. Dükkanı açtığımda onları susturabilene aşk olsun. Ama... Birkaç insanı haksız çıkardığımı söyleyebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120410
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120410,
					"content": "İşte, bunu alın. Bu çocukken sahip olmayı düşlediğimiz birinci sınıf bir oyuncak kutusu. O zamanlar hiçbirimizin parası buna yetmiyordu... Meteliksizdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120411
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120411,
					"content": "Bugünse işler bomba gibi. Bunlardan bir sürü aldım. Hayalim gerçek olmuştu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120412
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120412,
					"content": "Vay, sen süper zengin falan olmalısın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120413,
					"content": "Hahaha... Bu, benim için uzun süre önce yitip giden çocukluğumun hatırası. O olmadan bugün olduğumuz yerde olamazdık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120414
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120414,
					"content": "Beni bulduğunuza göre, sanırım şimdi Minik Wu ve Congzi'yi arayacaksınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120415
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120415,
					"content": "Hı hı! Minik Wu ile zaten görüştük, şimdi Congzi'yi bulmalıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111120416,
					"content": "Anladım. Aradığınız Congzi ise Feiyun Yamacı'ndaki üst geçitte buluşalım. Rıhtıma giden merdivenin hemen üst tarafında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111120417
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111120417,
					"content": "Benim yapmam gereken bir iş var. İşim biter bitmez gelip sizi bulurum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mumu"
				}
			]
		},
