			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dehya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30100201,
					"content": "İşte buradasınız. O kaçıran kişilerin icabına baktım bile. Yaralandınız mı leydim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100202
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100202,
					"content": "Bekle, bir terslik var...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100203
					]
				},
				{
					"id": 30100203,
					"content": "Dehya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100204,
					"content": "Ne oldu? Niye ikiniz de bana öyle tuhaf tuhaf bakıyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100205
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100205,
					"content": "Sen... Bu sefer yaralanmadın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100206,
					"content": "Ne? \"Bu sefer\" de ne demek? Ayrıca yaralanmadan kurtulmama niye bu kadar şaşırdınız? O çocuklar amatör tiplerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100207,
						30100208
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100207,
					"content": "Hâlâ yeni büyük kılıcına alışmaya çalışmıyor muydun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100209
					]
				},
				{
					"id": 30100209,
					"content": "Şşş! Büyük kılıcımı nereden biliyorsunuz siz? Kimseye söylememiştim. Lütfen Bayan Dunyarzad'a söylemeyin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100210
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100210,
					"content": "Demek Dehya gerçekten de hafızasını kaybetmiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100211,
						30100212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100211,
					"content": "Dövüş sırasında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100213
					]
				},
				{
					"id": 30100213,
					"content": "Tuhaf bir şey mi? Zaten yeni büyük kılıcımı biliyorsunuz. Hımm... Aklıma gelen en tuhaf şey yeni bir silahın bana bu kadar tanıdık gelmesi açıkçası.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100214
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100214,
					"content": "Yani... Sanki bu silahı sayısız dövüşte çok kez kullanmış gibiyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100215
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100215,
					"content": "Yani bunu kullandığını hatırlamasan da sanki bedenin hatırlıyor gibi, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100216,
					"content": "Öyle. Hem paralı askerler hem de savaşçılar için kas hafızası çok önemlidir. Savaşın sadece teorisini bilmek insana bir yere kadar yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100217
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100217,
					"content": "Sen ne düşünüyorsun Gezgin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100218,
						30100219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100218,
					"content": "Akaşa Terminallerimizi çıkardığımız için olabilir mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100220
					]
				},
				{
					"id": 30100220,
					"content": "Evet, Paimon gerçekten çok umutlu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100221,
					"content": "Yani bundan kurtulmuş olabilir miyiz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100222
					]
				},
				{
					"id": 30100222,
					"content": "Haklısın! Daha önce samsarada böyle bir şey hiç olmamıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100223,
					"content": "Günün sonunda kesinlikle öğrenmiş olacağız.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100224
					]
				},
				{
					"id": 30100224,
					"content": "Neden bahsettiğiniz hakkında hiçbir fikrim yok ama burası hâlâ tehlikeli. Yani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100225
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100225,
					"content": "O yüzden sen burada halen birileri var mı diye bakarken Dunyarzad'ı başka bir yerde dinlenmeye götürmemizi mi istiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100226,
					"content": "Ne söyleyeceğimi nereden bildin? Zihnimi mi okuyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100227
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30100227,
					"content": "Boş ver, sen yapman gerekeni yap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100219,
					"content": "Bu daha önce hiç olmamıştı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100220
					]
				},
				{
					"id": 30100212,
					"content": "Tuhaf bir şey hissettin mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100213
					]
				},
				{
					"id": 30100208,
					"content": "Genelde silahına alışık olmadığında biraz yara bere alıyorsun da.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100209
					]
				}
			]
		},
		{
			"id": 301003,
			"completionStepIds": [
				301003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301003",
							"2"
						],
						"stepId": 301003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30100301,
					"content": "... Ay, sonunda gece oldu. Dehya'nın yaralanmaması dışında her şey aynı görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100302,
					"content": "Dinle Nahida! Daha önce her seferinde onu kaçıranlarla dövüştüğünde yaralanmasına rağmen bu kez Dehya'nın yaralanmadığını öğrendik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100303,
					"content": "Samsara döngüsü kırılmış olabilir mi? Dunyarzad'ı kurtardık mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100304,
					"content": "Gerçekten mi? Tebrik ederim. Bugün iyice uyuyup dinlenin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100305
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100305,
					"content": "Hey! Bu nasıl bir cevap böyle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100306,
					"content": "Herkes yarının geleceğine inanır ama bundan emin olmanın tek yolu yarını gerçekten yaşamaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100307
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100307,
					"content": "Kaç tane \"bugün\" geçti? \"Bugün\"den sonra \"dün\" gelebilir mi? \"Yarın\" gerçekten var mı yoksa tamamen uydurma bir kavram mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100308
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100308,
					"content": "Hatta tüm dünya bir yalandan, tüm tarih de sonsuz bir Sabzeruz Festivalinden ibaret olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100309
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100309,
					"content": "Tamam, lütfen, yeter! Paimon'un beyni erimek üzere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100310,
					"content": "Hehehe... İşte bu yüzden yarın öğreneceğin şeyleri düşünerek enerjini harcamana gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100311
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100311,
					"content": "İyice dinlenin! Ne bileyim, tuvalete falan gidin de endişelerinizin üzerine sifonu çekin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100312
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100312,
					"content": "Ne? Bekle, ne dedin? Paimon doğru mu duydu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100313,
					"content": "Ne? İnsanlar hep tuvalete gittikten sonra rahatlama hissetmez mi? O yüzden size de bunu önerdim. Bu çok mu tuhaf?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100314
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100314,
					"content": "Şey... Bu o kadar acayip ve sağduyudan o kadar uzak ki Paimon'un nutku tutuldu... Daha bir dakika önce çok akıllıca konuşuyordun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100315,
					"content": "Biraz dinlenecektik zaten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100316
					]
				},
				{
					"id": 30100316,
					"content": "Evet... Sabzeruz Festivalinde her gün mutlu ve canlı geçse de ne zamandır ciddi anlamda dinlenemedik. Hadi odamıza gidelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100317
					],
					"speakerTitle": "Paimon"
				},
				{
