			},
			"dialogs": [
				{
					"id": 30100101,
					"content": "Paimon her şeyi hatırlıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100102,
					"content": "İyi bari, bu sefer hızlı uyum sağladın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100103
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100103,
					"content": "Dün gecenin sonunda...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100104
					]
				},
				{
					"id": 30100104,
					"content": "Dün gece kesinlikle Akaşa Terminallerimizi çıkardık ama ona rağmen bip sesini duyduk. Bu neden olmuş olabilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100105,
						30100106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100105,
					"content": "Acaba vücudumuza başka bir tür terminal mi koydular?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100107
					]
				},
				{
					"id": 30100107,
					"content": "Yine de en azından artık bir şeyden emin olabiliriz. Bizi bu döngüye sıkıştıran şeyin kesinlikle Akaşa'yla bir ilgisi var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100108,
					"content": "Paimon anlamadı. İstediği şey herkesin irfanı ise Akaşa niye bu kadar uğraşsın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100109,
					"content": "Sonuçta deney farelerinin deneyde onlara niye kötü muamele edildiğini anlamaları çok zordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100110
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100110,
					"content": "Biz deney fareleriysek sen nesin peki? Nahida, bize kendinden hiç bahsetmedin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100111,
					"content": "Şey... Sanırım ben de Ay'ım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100112
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100112,
					"content": "Ay mı? Falımızda da Ay çıkmamış mıydı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100113,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100114
					]
				},
				{
					"id": 30100114,
					"content": "Neyse, kim olduğumu öğrenmek sizi gerçeğe daha da yaklaştırmayacak, o yüzden başka şeylere odaklanın. Dikkatinizi dağıtıp ipuçlarını kaçırmayın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100115
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30100115,
					"content": "Tamam o zaman... Dehya bize dün çok yardımcı oldu, gidip onu bulalım bence. Paimon saati doğru hesapladıysa adam kaçıranlar yakında ortaya çıkacaklar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30100106,
					"content": "Onlarla bağlantımızı koparmayı başaramamış olabilir miyiz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100107
					]
				}
			]
		},
		{
			"id": 301002,
			"completionStepIds": [
				301002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301002",
							"2"
						],
						"stepId": 301002,
						"stateName": "QUEST_STATE_UNFINISHED"
