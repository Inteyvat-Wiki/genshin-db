			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sorush"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732320601,
					"content": "Hadi Sorush, uyan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732320602,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320603
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732320603,
					"content": "Oh, nihayet uyandın! Öyle bayılınca Paimon'u çok korkuttun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732320604,
					"content": "İyi... İyiyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320605
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732320605,
					"content": "Sen bayıldıktan sonra ağaç açıldı, içeri giden yolu takip ettik. Bu... Zurvan'ın bahsettiği dev nilüfer Gaokerena, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732320606,
					"content": "Ne oldu demin sana? Bahar Tacı ile ilgili bir sorun mu çıktı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732320607,
					"content": "Yeryüzünün Harvisptokhm Ağacına döndüğü anıları gördüm. Sayısız Pari, Dahri makinası ve insan savaşçı, iblislere karşı olan bir savaşta kendilerini feda ediyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320608
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732320608,
					"content": "Maskeli bir kılıç ustası, tek kollu bir bilge ve kadim atalarımız, derinlerden çıkan canavarları alt etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320609
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732320609,
					"content": "Bilinçleri daha sonra Khvarena ile beraber Harvisptokhm Ağacıyla birleşti ve göklerden yağan yağmurlara dönüştü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320610
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732320610,
					"content": "Dahri makinaları mı? Bir dakika, o zaman olaylar gerçekten Nasejuna'nın anlattığı gibi mi yaşanmış?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732320611,
					"content": "Zurvan'a sormamız gerekecek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732320612
					]
				},
				{
					"id": 732320612,
					"content": "Evet. Şimdi ne yapacağız o zaman? Paimon, Zurvan'ın kirleri temizlememiz gerektiği gibi bir şey söylediğini hatırlıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732320613,
					"content": "Tanrımızın bilincindeki Kirli Odalara girip kirlerin hapsettiği Spenta'nın Kalplerini kurtarmamız gerek. Ancak o zaman bilinç yeniden uyanacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320614
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732320614,
					"content": "Gördüğüm anılarda orası sonsuz bir boşluktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320615
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732320615,
					"content": "Öyleyse nasıl içeri gireceğiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732320616,
					"content": "Benimle gelin. Geçmiş kahramanların ardında bıraktığı yolu takip edersek hedefimize ulaşabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sorush"
				}
			]
		},
