			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sorush",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732320301,
					"content": "Büyük ağaç kütüğünün tepesinde miyiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732320302,
					"content": "Mağaradan çıkmak için o kadar çabalamamıza rağmen yolumuz yine mi kapandı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732320303,
					"content": "Çift Boynuzlu Bahar Tacını aldım, Harvisptokhm Ağacı neden reddediyor beni? Böyle olmamalıydı... *ağlar*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320304
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732320304,
					"content": "Şey, bir sorun mu var Sorush? Pek iyi görünmüyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732320305,
					"content": "*ağlar* Çift Boynuzlu Bahar Tacı... Bir şey... Bir şey geliyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732320306
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732320306,
					"content": "Hey! Sorush!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732320380,
					"content": "Kadim ağacın kökleri dört bir yana dağılır, birbirine dolanır, her düğümde soluk bir ışık parlar.\\nIşık ve gölge birbirine karışır, peş peşe görüntüler gelip geçer.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 732320381,
					"content": "Issız dağların arasında kahramanların ellerinde çeşitli silahlar vardır. Pariler ise onların arkasına dizilmiştir.\\nEtraflarını kara bulutlar kuşatmış olsa da geriye tek bir adım atmazlar.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 732320382,
					"content": "Karanlık çukurlarda devasa makinalar hafifçe ışıldar.\\nYakıp kavuran kara alevlerden kaçan insanları korurlar.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 732320383,
					"content": "Engin kırlarda maskeli bir kılıç ustası\\nve tek kollu bir bilge sırt sırta vermiştir.\\nArdı arkası kesilmeyen canavar akınına\\nKhvarena'nın kalkanı altında karşı koyarlar.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 732320384,
					"content": "Khvarena herkese yol gösterir, aynı zamanda hedefleridir de.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 732320385,
					"content": "Sayısız ışık birleşerek küçük parçacıklar oluşturur, ağacın köklerinden beyaz bir parıltı yükselir.\\nNihayetinde bir zamanlar kararan gökyüzü aydınlanır.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7323206,
			"completionStepIds": [
				7323206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
