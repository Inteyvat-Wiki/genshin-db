			"dialogs": [
				{
					"id": 732321801,
					"content": "Ab-Zohr Ayininin tamamlanmasıyla akan Amritayı takip ediyor ve Sorush ile birlikte Harvisptokhm Ağacından ayrılarak çiçek denizine dönüyorsunuz...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732321802
					]
				},
				{
					"id": 732321802,
					"content": "Sizi bekleyen Zurvan ile karşılaşıyorsunuz.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732321803
					]
				},
				{
					"id": 732321803,
					"content": "Demek gerçekten Ab-Zohr Ayinini tamamlayabildiniz. Gösterdiğiniz çaba kadim kahramanları aratmıyor. Gerçekten çok şaşırdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321804
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732321804,
					"content": "Hiç şaşırmış durmuyorsun ama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732321805,
					"content": "Apaosha'nın Alameti söndürüldü, yeryüzü arındırıldı. Hem de hiçbir fedakarlıkta bulunulmadan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321806
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732321806,
					"content": "Çok fazla yağmur yağıyordu! Gökyüzündeki devasa delik kapandı, çürümüş ağaç kütüğü de büyüyüp tekrar dev bir ağaca dönüştü!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732321807,
					"content": "O kirlerden kurtulduğuna göre tanrınız artık eskisi kadar acı çekmez herhalde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732321808,
					"content": "Beş yüz yıl önce olanlar hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732321809
					]
				},
				{
					"id": 732321809,
					"content": "Aa, doğru! Sorush'un gördüğü anılarda canavarlara karşı savaşan ilk Kuşkucuların arasında Khaenri'ahlılar da vardı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732321810,
					"content": "Durun bakalım, bu kadar ciddileşmeye gerek yok. Geçmişin anılarını gördüğünüze göre size şimdi anlatacaklarım öykü değil, gerçeklerin ta kendisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321811
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732321811,
					"content": "Çok uzun zaman önce, çiçek denizinde ilk uyandığım vakit gökyüzü, karanlık çukurun tuhaflıklarıyla kaplıydı. Buradaki ufak sığınak dışında her yerde canavarlar kol geziyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321812
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732321812,
					"content": "Kutsal kuşun son isteği doğrultusunda Khvarena'nın kudretini topladım ve canavarlara boyun eğdirmek için çiçek denizinden ayrıldım. Bir gün yabanda o altın saçlı adamla karşılaştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321813
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732321813,
					"content": "Adamın bedeninin yarısı canavara dönüşmüştü. Buna rağmen içinde hiç canavarlık hissetmedim. Onu bulduğumda elinde sıkıca bir yüzük tutuyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321814
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732321814,
					"content": "Onu çiçek denizine getirdim. Uyandığında sırf lanetlendiği için hayatta kalan bir Dahri kılıç ustası olduğunu iddia etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321815
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732321815,
					"content": "Uzunca bir süre bu maskeli kılıç ustasıyla seyahat ettik ve çiçek denizini istila eden Dhev ile mücadele ettik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321816
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732321816,
					"content": "Lanetlenmişti demek...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732321817
					]
				},
				{
					"id": 732321817,
					"content": "Evet. Dahri halkının o felaket sırasında farklı ölçülerde lanetlendiği söylenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321818
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732321818,
					"content": "Kısa süre sonra doğudaki çöl topraklarından tek kollu bir bilgenin önderlik ettiği, alim kıyafetli insanlar geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321819
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732321819,
					"content": "Zamanında Dahri'nin kahramanlarıyla omuz omuza çarpıştıklarını iddia ettiler. O kahramanların sahip oldukları kötü şöhrete rağmen onlarla birlikte savaştığını söylediler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321820
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732321820,
					"content": "O kahramanların vasiyetini yerine getirmek ve karanlık çukurlardan gelen felaketi yok etmek için kahramanların yolunu takip ederek buraya geldiklerini söylediler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321821
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732321821,
					"content": "Sonra birlikte Dahrililerin geride bıraktığı bir harabeye girdik. O harabede canavarlara karşı koyan makinaları bulduk. Bunlar, o alimlerle omuz omuza savaşan insanlara ait makinalardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321822
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732321822,
					"content": "Sonra tek kollu bilge, Dahrililerin bıraktığı belgeleri inceleyerek karanlığın içinden Harvisptokhm Ağacına giden bir yol buldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321823
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732321823,
					"content": "Böylelikle ağaca girdik ve Amritayı kullanarak kirli gökleri ve yeri arındırdık. Sonrasında çiçek denizi sürekli Pariler doğurdu ve canavarlar topraklardan giderek kayboldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321824
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732321824,
					"content": "#Sonra maskeli kılıç ustası, yanında altın saçlı genç bir {M#kadınla}{F#adamla} çiçek denizinden ayrıldı. Bilge ise yer altındaki harabelere gitti ve bir daha dönmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321825
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732321825,
					"content": "Kalan insanlar yeni doğan Parilerle bağ kurdular ve buraya yerleştikleri için kendilerine Kuşkucular Cemiyeti adını verdiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321826
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732321826,
					"content": "Şimdiyse altın saçlı bir kahraman çiçek denizine döndü. Bu, daha önce gelen kahraman olmasa bile bir şeylerin yeniden akmaya başladığını hissedebiliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321827
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732321827,
					"content": "Ben de bu nedenle sizden yardım istedim. Siz yanımızdayken Parilerin yanında savaşacak cesur bir savaşçıyı nereden bulacağım diye endişelenmeme gerek kalmıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321828
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732321828,
					"content": "İnsanlara bir şey öğretmek gerçekten zor bir iş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321829
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732321829,
					"content": "Zor değil, sadece siz Pariler birbirinizden tembelsiniz o kadar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321830
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732321830,
					"content": "Beni dahil etme Beyaz Pofuduk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321831
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732321831,
					"content": "Pekala, Ab-Zohr Ayinini tamamladığınıza göre kirlilik bir süreliğine burayı tehdit edemeyecek. Ben de o esnada nihayet dinlenebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321832
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732321832,
					"content": "Sorush'u ise size bırakıyorum. Yolculuğunuzda ona iyi rehberlik edin. Nihayetinde bu da Yasnapatinin sorumluluklarından biri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321833
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732321833,
					"content": "Senden ders almaya niyetim yok Beyaz Pofuduk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321834
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732321834,
					"content": "Hehe, deme öyle! Hocalarını dinlemen lazım. Bu arada Zurvan, bir daha karşılaşmayacakmışız gibi konuştun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321835
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732321835,
					"content": "Ee, burada benimle kalmayı düşünmüyorsunuz, değil mi? Siz insanlar hep böylesiniz. Asla bir yerde durup oraya yerleşmiyorsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321836,
						732321837
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732321836,
					"content": "Döneceğiz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732321838
					]
				},
				{
					"id": 732321838,
					"content": "Haha! Korkarım sana inanamayacağım. Bu sözleri ilk kez duymuyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321839
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732321839,
					"content": "Bahsi geçmişken, acaba o maskeli kılıç ustası ne yapıyordur şimdi... Kendisini görürseniz selamımı iletin lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321840
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732321840,
					"content": "İkiniz de gezginsiniz sonuçta. Eminim yollarınız kesişir bir gün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732321841
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732321841,
					"content": "Tamam tamam, hadi gidin artık. Beni de öyle çok özlemeyin sakın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732321837,
					"content": "Tekrar görüşeceğiz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732321838
					]
				}
			]
		},
