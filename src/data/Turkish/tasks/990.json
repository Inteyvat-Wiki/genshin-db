			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Barbara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 9901508,
					"content": "Burası hoşuna gitti mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901509
					]
				},
				{
					"id": 9901519,
					"content": "Biraz muhabbet edelim mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901520
					]
				},
				{
					"id": 9901536,
					"content": "Yapmak istediğin bir şeyler var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901537
					]
				},
				{
					"id": 9901509,
					"content": "Buraya bayıldım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901510
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901510,
					"content": "Buranın manzarası Mondstadt'ınkinden çok farklıymış. İçim ferahladı resmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901511
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901511,
					"content": "Burada kimseyi rahatsız etmekten çekinmeden istediğim gibi şarkı söyleyebilirim! Rahatça pratik yapabileceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901512
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901512,
					"content": "Böylesine güzel bir sesi kimsenin rahatsız edici bulacağını sanmıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901513
					]
				},
				{
					"id": 9901516,
					"content": "Harika o zaman!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901517
					]
				},
				{
					"id": 9901513,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901514
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901514,
					"content": "Böyle düşünmen çok hoş ama... Yine de diğer insanları rahatsız etmediğimden emin olmalıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901515
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901515,
					"content": "Her neyse, beni buraya davet ettiğin için çok mutluyum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901516
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901517,
					"content": "Aynen... Beni buraya davet ettiğin için gerçekten çok mutluyum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901518
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901518,
					"content": "Burada biraz daha kalmak istiyorum sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901520,
					"content": "Tabii, olur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901521
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901521,
					"content": "Hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901522
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901522,
					"content": "O gülüşün altında ne var...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901523
					]
				},
				{
					"id": 9901524,
					"content": "Şey, uzun süredir bir arkadaşla böyle muhabbet etmemiştim de.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901525
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901525,
					"content": "Bir anlığına kendimi çok şanslı hissettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901526
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901526,
					"content": "Çabuk mutlu edilebilen birisin sanırım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901527
					]
				},
				{
					"id": 9901530,
					"content": "Diğer insanların mutluluğuna öncelik veriyorsun çünkü.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901531
					]
				},
				{
					"id": 9901527,
					"content": "Şey... Öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901528
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901528,
					"content": "Yani, muhtemelen... Ama kötü anlamda söylemedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901529
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901529,
					"content": "Ne kadar kolay mutlu olursan bu mutluluğu diğer insanlarla o kadar kolay paylaşabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901530
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901531,
					"content": "Evet, yapmam gereken de tam olarak bu zaten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901532
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901532,
					"content": "Bugüne kadar bana destek çıkan birçok insan oldu. Bu sebeple onlara bana gösterdikleri nezaketin karşılığını vermek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901533
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901533,
					"content": "İnsanlar senin muhteşem biri olduğunu söylemekte haklılar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901534
					]
				},
				{
					"id": 9901534,
					"content": "Aman, bu kadar iltifata ne gerek var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901535
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901535,
					"content": "Ancak nitelikli eleştiri yaparak ilerleme kaydedebiliriz, yanlış mıyım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901537,
					"content": "Ah, yeni bir şarkı üzerinde çalışıyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901538
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901538,
					"content": "Sadece birkaç detayın üzerinden geçmeye çalışıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901539
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901539,
					"content": "Sence nakarat kısmında yarım ses yükselmeli miyim? Emin olamıyorum... Dans programında da geliştirilebilecek kısımlar olduğunu düşünüyorum ama dediğim gibi emin değilim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901540
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901541,
					"content": "Sana koşulsuz şartsız destek olacağıma emin olabilirsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901542
					]
				},
				{
					"id": 9901542,
					"content": "Memnuniyet duyarım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901543
					]
				},
				{
					"id": 9901540,
					"content": "Senin için de sorun olmayacaksa gösterimi izleyip fikirlerini belirtmen hoşuma gider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901541
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901543,
					"content": "Teşekkür ederim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901544
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901544,
					"content": "Şey, hâlâ geliştirilmesi gereken bazı kısımlar var, o yüzden lütfen dalga geçme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901545
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901545,
					"content": "Bunu yapmayı uzun zamandır planlıyordum fakat bu kadar yakın mesafeden gösteri yapmak için cesaretimi toplamam çok uzun sürdü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901546
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901547,
					"content": "Merak etme, dalga geçecek değilim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901548
					]
				},
				{
					"id": 9901546,
					"content": "Dalga geçmiş olsaydın utancımdan yerin dibine girerdim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901547
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901549,
					"content": "Pekala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901550
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901550,
					"content": "O zaman...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901551
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 9901551,
					"content": "Gösteri başlasın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Barbara"
				}
			]
		},
