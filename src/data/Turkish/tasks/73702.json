					"Zurvan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737020101,
					"content": "En son konuşmamıza kıyasla çok daha mutlu görünüyorsun. İşler yolunda gitti galiba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020102
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020102,
					"content": "Hımm. Bu görevlerden öğrendiğim şeylerle büyüdüm. Şimdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020103
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020103,
					"content": "Çiçek Muhafızı unvanına layık mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020104
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020104,
					"content": "Hayır... Henüz değilim. Tamamlamam gereken son bir görev var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020105
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020105,
					"content": "Tüm görevleri tamamlayıp sizin saygınızı kazanmadan bitirmiş sayılmam. Ancak bunları başardıktan sonra Çift Boynuzlu Bahar Tacına tam anlamıyla layık olabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020106
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020106,
					"content": "Hım? Söylendiği gibi gerçekten de isyankar dönemini geride bırakmış gibisin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020107
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020107,
					"content": "B-Büyüğüm... O lafı hâlâ hatırlıyor musunuz? Unutun gitsin lütfen, rica ediyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020108
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020108,
					"content": "Haha. Moralinin yerine geldiğini görmek güzel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020109
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020109,
					"content": "#{NICKNAME}, Paimon, lütfen siz de Sorush'un Çift Boynuzlu Bahar Tacını hak edip etmediğine şahit olun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020110
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020110,
					"content": "Ben sizi en sonda bekliyor olacağım. Görüşürüz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zurvan"
				}
			]
		},
		{
			"id": 7370206,
			"completionStepIds": [
				7370206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7370206",
							"2"
						],
						"stepId": 7370206,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7323201",
