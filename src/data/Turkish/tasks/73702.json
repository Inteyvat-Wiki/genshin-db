				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sorush"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737020601,
					"content": "Tunigi Çukuru... Burası felaketin patlak verdiği yerdi. Her ne kadar şimdi her şey yolunda gibi görünse de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020602
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020602,
					"content": "Zamanında ne kadar kötü durumda olduğunu anlamak zor değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020603
					]
				},
				{
					"id": 737020603,
					"content": "Bu kristaller kocaman! Solucanınkinden bile büyük! Bir de burada ileride yaşanacak sorunları halletmenin Sorush'un sorumluluğunda olduğunu düşününce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020604,
					"content": "Bir Çiçek Muhafızının en önemli görevi bu değil mi? Üstelik Sorush'un kendinden beklediği şey de bu olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020605
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020605,
					"content": "Yani, öyle deniyor evet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020606,
					"content": "Bana güvenmiyor musun? Hıh. Beyaz Pofuduk tarafından bile böyle küçümsenecek bir noktada olduğumu fark etmemiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020607
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020607,
					"content": "Vay canına, Sorush'un kibri muhteşem bir şekilde geri döndü!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020608,
					"content": "Bu iyi bir şey mi, kötü bir şey mi bilemedim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020609
					]
				},
				{
					"id": 737020609,
					"content": "Hıh. Birlikte o kadar vakit geçirmemize rağmen ikiniz de niye benden böyle şüphe duyuyorsunuz? Gururum asla kibrimden dolayı değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020610
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020610,
					"content": "Hımm. Geçmişte yaptığım hataları tamamen anladım artık, söylemiş olayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020611
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020611,
					"content": "Daha önce itibarı, yaptıklarımın önünde tuttum ama öğrendim ki asıl ihmalkarlık bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020612
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020612,
					"content": "Tıpkı Simurgh'un yaptığı fedakarlık sonrası kutsal kuş olarak anılması gibi ben de yaptıklarımla Çiçek Muhafızı olacağım. Başarılarımdan dolayı adımdan övgüyle bahsedilecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020613
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020613,
					"content": "Ayrıca bana verdiğin tüm görevleri tamamladım Büyüğüm. Artık Çiçek Muhafızı unvanına ve Çift Boynuzlu Bahar Tacına layık olduğumu kabul etmelisiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020614
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020614,
					"content": "Khvarena'nın yaptığı bu seçime itirazım yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020615
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020615,
					"content": "... Hı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020616
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020616,
					"content": "Ne? İtiraz etmemi mi bekliyordun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020617
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020617,
					"content": "Hayır... Ben... Bu kadar kolay kabul etmenizi beklemiyordum Büyüğüm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020618
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020618,
					"content": "Ben en azından şöyle sert birkaç söz söylemeni bekliyordum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020619
					]
				},
				{
					"id": 737020619,
					"content": "Ah, o kadar da huysuz değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020620
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020620,
					"content": "Çiçek Muhafızının sorumluluklarına gelince... Bahar Tacından hiç bilgi alamadım aslında...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020621
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020621,
					"content": "Henüz tam anlamıyla bir Çiçek Muhafızı olamadığım için mi? Eğitimim mi eksik kaldı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020622
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020622,
					"content": "O konuda... Çiçek Muhafızı unvanı miras alınabilir ama görevleri her zaman değişir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020623
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020623,
					"content": "Anladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020624
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020624,
					"content": "Basitçe söylemek gerekirse kesin kurallar ve belirli standartlar yok. Genelde Khvarena'nın tercihi kesindir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020625
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020625,
					"content": "Hı? Yani diyorsunuz ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020626
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020626,
					"content": "Evet, Çift Boynuzlu Bahar Tacını senden almayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020627,
						737020629
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020627,
					"content": "Artık kafanın üşümesinden endişe etmene gerek yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020628
					]
				},
				{
					"id": 737020628,
					"content": "Olay o değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020633,
					"content": "Anladım! Bu da testin bir parçası olmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020634
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020634,
					"content": "Sorush şimdi anladı galiba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020635
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020635,
					"content": "Unutkansın Beyaz Pofuduk. Daha şimdi söyledim! Bu testleri geçebilmek için yeterlilik ve gözlem haricinde geçmişteki hatalarımı da anlamam gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020636
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020636,
					"content": "Sonuç belli olsa bile eğitim sırasında öğrendiğim bunca şeyi bir kenara bırakmak aptallık olmaz mı? Yani bence bu, Büyüğümün benim için hazırladığı son sınav.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020637
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020637,
					"content": "Gerçek bir Çiçek Muhafızı için bu basit bir görev. Bu da Büyüğümün bana tamamen güvendiğinin bir işareti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020638
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020638,
					"content": "Beni böyle hemen anlamanı beklemiyordum. Khvarena iyi bir seçim yapmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020639
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020639,
					"content": "#Ama senin bu değişimin... Sanırım {NICKNAME} ve Paimon'un da bunda payı var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020640
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020640,
					"content": "Evet! Benim kıymetli Yasnapatimin ve Beyaz Pofuduğun da çok katkısı oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020641
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020641,
					"content": "Tek başıma yeterince güçlü olduğumu söylemek istesem de... Onların yardımıyla \"Apaosha'nın Alameti\"ni söndürmenin zor olmayacağını düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020642
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020642,
					"content": "Haklısın, çok güvenilir dostlar. Mihir ve Rashnu'nun da sana yardımcı olabileceklerini unutma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020643
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020643,
					"content": "Merak etmeyin Büyüğüm! Siz her şeyi bana bırakın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020644
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020644,
					"content": "Paimon bunu Zurvan'ın planlamış olabileceğini düşünüyor... Ama Sorush'u bu kadar mutlu gördüğü için hiçbir şikayeti yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020629,
					"content": "Almayacak mısın yoksa alamıyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020630
					]
				},
				{
					"id": 737020630,
					"content": "Evet, Zurvan kendi dedi. Son karar Khvarena'ya aitmiş. Yani bu kararı Zurvan da değiştiremez, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020631,
					"content": "Vay, hahaha... Cidden öyle mi düşünüyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020632
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020632,
					"content": "Ayy... Korktum biraz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020633
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7370207,
			"completionStepIds": [
				7370206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7370206",
							"2"
						],
						"stepId": 7370206,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7323201",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sorush",
					"Zurvan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737020701,
					"content": "Tunigi Çukuru... Yıllar önce yaşanan felaketin patlak verdiği yer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020702
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020702,
					"content": "Vay canına! Paimon, Sorush'un Apaosha'nın Alametini gerçekten söndürüp buradaki sorunları çözebileceğini düşünmemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020703,
					"content": "Apaosha'nın Alametini söndürmek Çiçek Muhafızının görevidir. Sorush sadece yapması gerekeni yaptı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020704
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020704,
					"content": "Hepsi Mihir ve Rashnu'nun yardımları sayesinde oldu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020705
					]
				},
				{
					"id": 737020705,
					"content": "Evet. Biz de çok çaba gösterdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020706,
					"content": "Evet, Yasnapatim ve Beyaz Pofuduk'tan söz etmesek olmaz. Tabii bu başarıda rol oynayan en önemli kişi benim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020707
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020707,
					"content": "Vay canına, Sorush'un kibri muhteşem bir şekilde geri döndü!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020708,
					"content": "Hıh. Birlikte o kadar vakit geçirmemize rağmen ikiniz de niye benden böyle şüphe duyuyorsunuz? Gururum asla kibrimden dolayı değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020709
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020709,
					"content": "Hımm. Geçmişte yaptığım hataları tamamen anladım artık, söylemiş olayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020710
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020710,
					"content": "Daha önce itibarı, yaptıklarımın önünde tuttum ama öğrendim ki asıl ihmalkarlık bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020711
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020711,
					"content": "Tıpkı Simurgh'un yaptığı fedakarlık sonrası kutsal kuş olarak anılması gibi ben de yaptıklarımla Çiçek Muhafızı olacağım. Başarılarımdan dolayı adımdan övgüyle bahsedilecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020712
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020712,
					"content": "Ayrıca bana verdiğin tüm görevleri tamamladım Büyüğüm. Artık Çiçek Muhafızı unvanına ve Çift Boynuzlu Bahar Tacına layık olduğumu kabul etmelisiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020713
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020713,
					"content": "Khvarena'nın yaptığı bu seçime itirazım yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020714
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020714,
					"content": "... Hı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020715
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020715,
					"content": "Ne? İtiraz etmemi mi bekliyordun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020716
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020716,
					"content": "Hayır... Ben... Bu kadar kolay kabul etmenizi beklemiyordum Büyüğüm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020717
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020717,
					"content": "Ben en azından şöyle sert birkaç söz söylemeni bekliyordum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020718
					]
				},
				{
					"id": 737020718,
					"content": "Ah, o kadar da huysuz değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020719
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020719,
					"content": "Çiçek Muhafızının sorumluluklarına gelince... Bahar Tacından hiç bilgi alamadım aslında...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020720
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020720,
					"content": "Henüz tam anlamıyla bir Çiçek Muhafızı olamadığım için mi? Eğitimim mi eksik kaldı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020721
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020721,
					"content": "O konuda... Çiçek Muhafızı unvanı miras alınabilir ama görevleri her zaman değişir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020722
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020722,
					"content": "Anladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020723
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020723,
					"content": "Basitçe söylemek gerekirse kesin kurallar ve belirli standartlar yok. Genelde Khvarena'nın tercihi kesindir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020724
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020724,
					"content": "Hı? Yani diyorsunuz ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020725
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020725,
					"content": "Evet, Çift Boynuzlu Bahar Tacını senden almayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020726,
						737020728
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020726,
					"content": "Artık kafanın üşümesinden endişe etmene gerek yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020727
					]
				},
				{
					"id": 737020727,
					"content": "Olay o değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020732
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020732,
					"content": "Anladım! Bu da testin bir parçası olmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020733
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020733,
					"content": "Sorush şimdi anladı galiba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020734,
					"content": "Unutkansın Beyaz Pofuduk. Daha şimdi söyledim! Bu testleri geçebilmek için yeterlilik ve gözlem haricinde geçmişteki hatalarımı da anlamam gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020735
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020735,
					"content": "Sonuç belli olsa bile eğitim sırasında öğrendiğim bunca şeyi bir kenara bırakmak aptallık olmaz mı? Yani bence bu, Büyüğümün benim için hazırladığı son sınav.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020736
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020736,
					"content": "Gerçek bir Çiçek Muhafızı için bu basit bir görev. Bu da Büyüğümün bana tamamen güvendiğinin bir işareti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020737
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020737,
					"content": "Beni böyle hemen anlamanı beklemiyordum. Khvarena iyi bir seçim yapmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020738
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020738,
					"content": "#Ama senin bu değişimin... Sanırım {NICKNAME} ve Paimon'un da bunda payı var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020739
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020739,
					"content": "Evet! Benim kıymetli Yasnapatimin ve Beyaz Pofuduğun da çok katkısı oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020740
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020740,
					"content": "Tek başıma da yeterince güçlü olduğumu söylemek istesem de... Sanırım onların yardımı sayesinde \"Apaosha'nın Alameti\"ni söndürdüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020741
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020741,
					"content": "Bu kadar kısa sürede Sorush'un böyle sorumluluk sahibi olabileceğini düşünmezdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020742
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020742,
					"content": "Tabii ki! Sorumluluklarımı tüm kalbimle yerine getirdiğim sürece Büyüğümün de benim için endişelenmesine gerek kalmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020743
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737020743,
					"content": "Paimon bunu Zurvan'ın planlamış olabileceğini düşünüyor... Ama Sorush'u bu kadar mutlu gördüğü için hiçbir şikayeti yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020728,
					"content": "Almayacak mısın yoksa alamıyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737020729
					]
				},
				{
					"id": 737020729,
					"content": "Evet, Zurvan kendi dedi. Son karar Khvarena'ya aitmiş. Yani bu kararı Zurvan da değiştiremez, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737020730,
					"content": "Vay, hahaha... Cidden öyle mi düşünüyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020731
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737020731,
					"content": "Ayy... Korktum biraz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737020732
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}