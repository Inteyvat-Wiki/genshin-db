			"dialogs": [
				{
					"id": 150200101,
					"content": "Aa, selam Chasca. Seni Bilge Allpa mı yolladı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200102
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200102,
					"content": "Evet, başka meselelerle ilgileniyor şu an. Burada işler nasıl gidiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200103
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200103,
					"content": "Hımm, şöyle ki, incelememiz sonucunda imtihan arenasının çeşitli noktalarında tıkanıklıklar tespit ettik. Devamlı yaşanan Hiçlik istilalarından dolayı oluşan ley hattı bozukluklarının bir sonucu muhtemelen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200104
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200104,
					"content": "Teorik olarak, bu tıkanıklıkları temizlediğimizde arena yeniden Gaz Filojiston ile dolacaktır. Fakat çeşitli sebeplerden ötürü pratikte o kadar da kolay değil bu temizlik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200105
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200105,
					"content": "Gidip kendiniz bakmaya ne dersiniz? Çalışanlardan ayrıntılı bilgi alabilirsiniz isterseniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inkanak"
				}
			]
		},
