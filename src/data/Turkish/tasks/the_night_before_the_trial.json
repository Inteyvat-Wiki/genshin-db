			"dialogs": [
				{
					"id": 150201001,
					"content": "Aa, yardıma mı geldiniz? Çok şükür! Bunları tek başıma halledemezdim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201002
					],
					"speakerTitle": "Cesur Soruşturmacı"
				},
				{
					"id": 150201002,
					"content": "Buradaki tıkanıklığın özel bir bombayla temizlenmesi gerekiyor ama şu dik yamaçtan yukarı patlayıcı taşımak faciaya davetiye çıkarmak olur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201003
					],
					"speakerTitle": "Cesur Soruşturmacı"
				},
				{
					"id": 150201003,
					"content": "Patlayıcıyı düşürsem veya ayağım kaysa anında paramparça olurum. O yüzden bombayı öbür tarafa taşıyıp oradan sıcak hava balonuyla göndermeyi planlıyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201004
					],
					"speakerTitle": "Cesur Soruşturmacı"
				},
				{
					"id": 150201004,
					"content": "Tabii birinin <color=#00E1FFFF>balona doğru anda vurup patlayıcıyı tam oluğun üzerine düşürmesi lazım</color>... Böylece sorunumuz çözülür!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201005
					],
					"speakerTitle": "Cesur Soruşturmacı"
				},
				{
					"id": 150201005,
					"content": "Ne dersin? Gayet basit, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201006
					],
					"speakerTitle": "Cesur Soruşturmacı"
				},
				{
					"id": 150201006,
					"content": "Hallederim bence ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150201007
					]
				},
				{
					"id": 150201007,
					"content": "Şu sıcak hava balonu senin mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150201008
					]
				},
				{
					"id": 150201008,
					"content": "Hı? Ha, o mu... Yok, o kimin balonu bilmiyorum. Nasıl o kadar yükseğe çıkarmışlar onu da bilmiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201009
					],
					"speakerTitle": "Cesur Soruşturmacı"
				},
				{
					"id": 150201009,
					"content": "Keşke o kadar yükseğe uçup kullandıkları teknolojiye bakabilsem. Neyse, imtihan arenasını hazırlamak daha önemli şu an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150201010
					],
					"speakerTitle": "Cesur Soruşturmacı"
				},
				{
					"id": 150201010,
					"content": "Ben gidip balonu ayarlayayım. Hazır olduğunuzda söyleyin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cesur Soruşturmacı"
				}
