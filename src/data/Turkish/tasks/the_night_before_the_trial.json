			"dialogs": [
				{
					"id": 150200801,
					"content": "#Hım? Chasca, {NICKNAME}? Bu ne sürpriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200802
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200802,
					"content": "Bilge Allpa? Hı? Şey... Duyduğumuz şu agresif Gukuzor nerede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150200803,
					"content": "Uçup gitti bile. Destek geldiğini fark edince geri çekildi herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200804
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200804,
					"content": "Sence neden insanlara saldırdı? Yemek mi arıyordu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200805
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200805,
					"content": "Yok, bu tüccarlar yemek taşımıyor ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200806
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200806,
					"content": "Oh! Çok şükür! Filojiston Kanatları hâlâ tek parça!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200807
					],
					"speakerTitle": "Genç Tüccar"
				},
				{
					"id": 150200807,
					"content": "... Filojiston Kanatları mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200808
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200808,
					"content": "İmdadımıza yetiştiğiniz için çok teşekkür ederiz. Bu Filojiston Kanatları bizim için çok değerli. Onlara bir şey olsaydı mahvolurduk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200809
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200809,
					"content": "... Bir dakika, bizimle iş birliği yapmak isteyen tüccarlar siz misiniz? Warmi bahsetti de.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200810
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200810,
					"content": "Evet evet, biziz! O halde... Siz Bilge Allpa mısınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200811
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200811,
					"content": "Doğrudur. Yolculuk yormuştur sizi, saldırı da sarsıcıydı tabii. Gelin sizi kabilemize götüreyim de dinlenin, kendinize geldikten sonra iş konuşuruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200812
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200812,
					"content": "Gukuzor saldırısı ne olacak Bilge Allpa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200813
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200813,
					"content": "Misafirlerimizden ciddi yaralanan olmamış, malları da hasar görmemiş... Belki saldıran Gukuzor kötü bir gün geçiriyordur yalnızca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200814
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200814,
					"content": "Bu civarda çok Gukuzor var sonuçta, arada bir böyle münferit olaylar olması normal. Bence çok da irdelemeye gerek yok... Asıl söyleyin bakalım, uçuş imtihanlarının hazırlıkları nasıl gidiyor? Arenada her şey hazır mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200815,
						150200816
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200815,
					"content": "Her şey yolunda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200817
					]
				},
				{
					"id": 150200817,
					"content": "Hı? Doğru mu duydum, uçuş imtihanları mı dediniz? Vay be, tesadüfe bak! Filojiston Kanatlarımızı kullanmak için mükemmel fırsat! Yapabildiklerini görünce çok şaşıracaksınız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200818
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200818,
					"content": "Gerçekten mi? İlgimi çektiniz şimdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200819
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150200819,
					"content": "Hehe, o halde Gukuzor saldırısını unutalım şimdilik... Konuşmamız gereken ciddi konular var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200820
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200820,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200821
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200821,
					"content": "Bu kadar mıydı? Sorunsuz geçti... Neyse, biz de yola koyulalım o zaman... Hı? Chasca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200822
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150200822,
					"content": "Neye bakıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200823
					]
				},
				{
					"id": 150200823,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200824
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200824,
					"content": "Kanlı bir tüy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200825
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200825,
					"content": "Olay unutulur, Çiçek Tüyü Klanına yeniden huzur gelir.\\nSonraki birkaç gün olaysız geçer, uçuş imtihanı için hazırlıklar bütün hızıyla devam eder...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 150200816,
					"content": "İmtihanlar yakında başlayabilecek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200817
					]
				}
			]
		},
