						150201103
					]
				},
				{
					"id": 150201103,
					"content": "Ha, tabii. Patlayıcıyı sıcak hava balonuyla beraber öbür taraftaki oluğun tam üzerine göndereceğim...",
					"roleType": "TALK_ROLE_NPC",
