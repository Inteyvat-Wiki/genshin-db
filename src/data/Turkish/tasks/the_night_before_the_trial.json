			"dialogs": [
				{
					"id": 150200401,
					"content": "Vay be, hemen hallediverdiniz... Muhteşem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200402
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200402,
					"content": "Şimdi Gaz Filojistonun tamamen dolmasını bekleyeceğiz. Ondan sonra imtihan tekrarlarına başlayabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200403
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200403,
					"content": "Hımm... Inkanak, ben önce bir test uçuşu yapıp gözden kaçırdığımız bir şey var mı diye kontrol etmek istiyorum. Bunu ayarlayabilir misin benim için?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200404
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200404,
					"content": "Ne? Ama... Arenayı hazırlamayı yeni bitirdin, henüz fark etmediğimiz başka tehlikeler olabilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200405
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200405,
					"content": "O yüzden test etmem gerekiyor ya zaten. İkinci bir teftiş gibi düşünelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200406
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200406,
					"content": "Hım... Haklısın sanırım. Zaten sendeki uçuş becerileri varken fark etmediğimiz bir tehlikeyle karşılaşsan bile sana büyük risk teşkil etmez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200407
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150200407,
					"content": "Bu bölgedeki koşullar dengesiz duruyor biraz ama gözden kaçan bir sorun olduysa test uçuşunda yakalayabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200408
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200408,
					"content": "Tamamdır, ben ayarlıyorum şimdi senin için. Hazır olduğunda haber et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inkanak"
				}
			]
		},
