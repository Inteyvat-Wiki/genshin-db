					"nextDialogs": [
						150200602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150200602,
					"content": "Arenada başka bir sorun var mıymış?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200603
					]
				},
				{
					"id": 150200603,
					"content": "Hımm... Hayır, öyle büyük bir sorun çarpmadı gözüme. Birkaç güne imtihanları gerçekleştirebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200604
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200604,
					"content": "İmdat... Yardım edin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200605
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200605,
					"content": "... Siz Çiçek Tüyü Klanındansınız, değil mi? Lütfen çabuk gelin, yardımınız lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200606
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200606,
					"content": "Önce bir soluklan. Ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200607
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150200607,
					"content": "B-Bize... Bize Gukuzor saldırdı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200608
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200608,
					"content": "Arkadaşlarım taşıdığımız mallarla beraber yolun ortasında mahsur kaldı... Yalvarırım kurtarın onları!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200609
					],
					"speakerTitle": "Isidore"
				},
				{
					"id": 150200609,
					"content": "Hı? Gukuzorlar gerçekten o kadar agresif mi ki? Durduk yere insanlara saldırıyorlar mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150200610,
					"content": "Ben hiç görmedim... Ama her kuralın istisnası vardır elbet. Gelin gidip bir bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chasca"
				}
			]
		},
