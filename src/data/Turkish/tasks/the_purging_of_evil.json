				"points": []
			},
			"dialogs": [
				{
					"id": 111020401,
					"content": "Ah, burası Paimon'un tüylerini ürpertiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020402,
					"content": "Bu yerin karmasını bozmak için Tüm Şerlerin Laneti olarak bilinen ayini yapacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020403
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020403,
					"content": "Sakin kalmak zorundasınız. Mazide kalmış tanrıların bitmek bilmez öfkesinden etkilenmeyin sakın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiao"
				}
			]
		},
		{
			"id": 1110206,
			"completionStepIds": [
				1110205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110205",
							"2"
						],
						"stepId": 1110205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111020601,
					"content": "İyi ki buraya geldik. Alışılmadık sayıda canlı, şeytani bir etki altına girmişti. Eğer zamanında gelmiş olmasaydık sonuçları hayal bile edilemezdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020602
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020602,
					"content": "Şimdi. Şu bahsettiğin \"Yıldızkapan\". Nedir bu mesele?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020603
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020603,
					"content": "Ay, Paimon anlatsın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020604,
					"content": "Dilekleri yerine getiren bir Adeptus demek... İnsanların bu kadar bariz yalanlara bu kadar kolay kanabildiğini düşününce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020605
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020605,
					"content": "Bir Adeptus olarak, dilekleri yerine getirme gücün var mı Xiao?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020606,
					"content": "Eski Liyue asla Adeptuslardan hak etmediği iyilikleri dilemezdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020607
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020607,
					"content": "Bin yıl önce Liyue'nun ataları, evleri olarak gördükleri toprakları savunmak için güçten başka bir şey istemediler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020608
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020608,
					"content": "Eh.. Açıkçası, günümüzde insanların dileklerini yerine getiren bir Adeptus insanlara muhtemelen çok daha cazip geliyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020609,
					"content": "Günümüzdeki insanlar ne kadar aptal olurlarsa olsunlar beni ilgilendirmiyorlar. Beni ilgilendiren yalnızca Rex Lapis'in gerçek emirlerini takip etmek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020610
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020610,
					"content": "Ay... Paimon yine düşünmeden konuştu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020611,
					"content": "Ah! Bir şey daha var! Bu sahte Adeptusun bir Yetki Mührü var. Kötü ruhları kovmak için kullandığı şey bu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020612,
					"content": "Bekle, gerçekten mi? Hıh. Aptal. Kötü ruhları yok etmeden kovmak... Burada toplanmalarına şaşmamalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020613
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020613,
					"content": "Böyle devam ederse işler benim kontrolümden bile çıkabilir... Yetki Mührüne el koymalıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020614,
						111020615
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020614,
					"content": "El koymak mı? Hepsi bu mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020616
					]
				},
				{
					"id": 111020616,
					"content": "Aklın yolu bir! Paimon da aynı fikirde, bizi kandırmaya çalışmanın cezasını o düzenbaza göstermeliyiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020617,
					"content": "Şansa bak, yanımızda gerçek bir Adeptus da var! Xiao, Yıldızkapan'a bir ders verecek olursa şayet, bir daha asla Adeptus gibi davranmaya cesaret edemeyeceğine emin olabiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020618,
					"content": "Hayır. Ben sadece iblisleri avlarım, fanileri öldürmem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020619
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020619,
					"content": "Onu öldürmekten bahseden de kim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020620,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020621
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020621,
					"content": "Onu bu yanlış yoldan vazgeçmeye ikna edebilirsek şayet bunun kesinlikle Liyue'ye katkısı olacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020622
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020622,
					"content": "Rüya Bulucusu isminde bir büyü biliyorum. Genellikle kişinin kendini uyanık bir rüyada geliştirebilmesi için ruhu bedenden ayırmada kullanılır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020623
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020623,
					"content": "Ama aynı zamanda başkalarının ruhlarını çağırmak için de kullanılabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020624
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020624,
					"content": "Vay canına, işte bu esaslı bir Adeptus büyüsü!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020625,
						111020626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020625,
					"content": "\"Rüya ve önsezileri hediye etmek\" gibi mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020627
					]
				},
				{
					"id": 111020627,
					"content": "Bu büyünün kullanılabilmesi için bir ayin yapılmalı. Birkaç eşyayı toplamam için bana yardım edin.. Bir buhurdanlık, yedi lamba ve sıcaklığı düşürecek bir şey.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020628
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020628,
					"content": "Sıcaklığı düşürecek... Aha! Birkaç Sis Çiçeği muhtemelen iş görür, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020629
					],
					"speakerTitle": "Paimon"
				},
				{
