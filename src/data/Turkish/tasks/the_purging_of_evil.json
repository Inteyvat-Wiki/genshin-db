			},
			"dialogs": [
				{
					"id": 111020201,
					"content": "Siz... Sizi hatırlıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020202
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020202,
					"content": "Şeytani güçlerin lekelediği bazı canlıları kötülükten arındırıyordum. Size de biraz sıkıntı çıkarmışım gibi görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020203
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020203,
					"content": "(Ha? Genelde bu kadar nazik değildir, neler oluyor...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020204,
					"content": "Ama kötü ruh kovuyormuşsun, bu nasıl sorun yaratıyor olabilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020205,
					"content": "Çünkü bu canavarlarda ortaya çıkan değişimler benden, daha doğrusu üstümde topladığım karmadan kaynaklanıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020206
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020206,
					"content": "Mutasyonlar, karma... Bunun anlamı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020207,
						111020208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020207,
					"content": "Kitapta bunu okuduk...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020209
					]
				},
				{
					"id": 111020209,
					"content": "Evet. Paimon, Xiao'nun aynı zamanda Bekçi Yaksha olarak da bilindiğini hatırlıyor, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020210,
					"content": "Yani... Demek ki... Ayy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020211,
					"content": "*burun çeker* Z-Zavallı Xiao...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020212,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020213,
						111020214
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020213,
					"content": "Bir kitapta senin geçmişine dair bir şeyler okumuştuk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020215
					]
				},
				{
					"id": 111020215,
					"content": "Anlıyorum. Birkaç yüzyıl önce yazılan tamamen kurgusal hikayeyi kastediyor olmalısın herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020216
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020216,
					"content": "Hıh. Her şey geçici, var olmak ise acı çekmek demektir. Biz Yakshaların acınmaya ya da gözyaşlarına ihtiyacı yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020217
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020217,
					"content": "Bu diyardan göçüp gitmiş yoldaşlarım gözyaşlarınızı efsanelerine sürülen bir leke olarak göreceklerdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020218
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020218,
					"content": "Ay, şey... Paimon çok üzgün...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020219,
					"content": "Önemli değil. Her halükarda, şeytani etki altında olan bir yeri arındırmaya gidiyorum, bu yüzden yollarımız burada ayrılıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020220
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020220,
					"content": "B-Bekle! Yanına bizi de al! Çok yardımımız dokunur. Paimon söz veriyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020221,
					"content": "Gerek yok. Tek başıma savaşmaya alışkınım, ne de olsa bu mutasyonlar evvela benden kaynaklandı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020222
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020222,
					"content": "Öyleyse... Ah! Bunu Paimon'un az önce istemeden kaba davranmasının kefareti olarak say! Ne olur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111020223,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020224
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020224,
					"content": "Hadi öyleyse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020214,
					"content": "Biz de az önce \"Yakshalar: Muhafız Adeptuslar\" kitabını okuduk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020215
					]
				},
				{
					"id": 111020208,
					"content": "Xiao son Yaksha mı yani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020209
					]
				}
			]
		},
