					"speakerTitle": "Xiao"
				},
				{
					"id": 111020631,
					"content": "Liyue halkının ataları, Yakshaları onurlandırmak için orada tapınaklar inşa etti. Orada hâlâ bazı tören malzemelerinin olması gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020632
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020632,
					"content": "Bunları bulduğunuzda, karanlık çöktükten sonra benimle Yaksha heykellerinde buluşun, size bu büyünün nasıl kullanılacağını göstereceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiao"
				},
				{
					"id": 111020626,
					"content": "Onu kesinlikle korkutacaksın.",
