			},
			"dialogs": [
				{
					"id": 718300201,
					"content": "Bu proje sonunda bir şeye benzemeye başladı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300202
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300202,
					"content": "Burayı onarmayı gerçekten kafaya koymuşsun...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300203
					]
				},
				{
					"id": 718300203,
					"content": "Oo, hoş geldin. Artık dürüst bir vatandaş olduğumu söylemiştim, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300204
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300204,
					"content": "Yine de itiraf etmeliyim ki bu proje sandığımdan da büyük bir şeye dönüştü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300205
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300205,
					"content": "Yeni tapınağı tasarlaması için getirdiğim mimar bunun bir Yaksha tapınağı olduğunu söylediğimde bayağı bir heyecanlandı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300206
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300206,
					"content": "Bunun için bir sürü tasarım çizmesi yetmiyormuş gibi bir de beni malzeme almaya sürükledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300207
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300207,
					"content": "Çok daha genç olsaydı eminim şantiyede de bizzat çalışmak isterdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300208,
						718300210
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300208,
					"content": "Hiç tehlikeli bir durumla karşılaştın mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300209
					]
				},
				{
					"id": 718300209,
					"content": "Tehlike derken canavarlardan ve Hazine Avcılarından mı bahsediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300212
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300212,
					"content": "Merak etme. Sivil İşler Bakanlığı, bir Yaksha tapınağı tadilatına giriştiğimi öğrendiğinde güvenlik için birkaç Taşordu askeri görevlendirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300213
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300213,
					"content": "Onlar da çevredeki canavarları hemen hemen temizledi diyebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300214
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300214,
					"content": "Hazine Avcıları da Taşordu burada diye pek ses çıkarmıyor gibiler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300215
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300215,
					"content": "Bu tapınağı onarmak için gereken iş yükü beklediğimden de yüksek çıktı. Meğer sahip olduğumuz malzeme bu iş için yeterli değilmiş. Biz de o yüzden şehirden tedarik siparişi vermek zorunda kaldık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300216
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300216,
					"content": "Hazine Avcıları doğrudan şantiye alanına saldırmazlar muhtemelen. Ama gelecek malzemelere el koymak için sevkiyata yol üzerinde bir pusu kurabilirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300217
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300217,
					"content": "Taşordu şantiyeyi koruyabilir, orada sorun yok. Fakat olur da sevkiyat Hazine Avcıları tarafından saldırıya uğrarsa oraya asla vaktinde yetişemeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300218
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300218,
					"content": "Senden bir iyilik isteyebilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300219
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300219,
					"content": "Ne kadar yetenekli olduğunu biliyorum. Hazine Avcıları seninle asla boy ölçüşemezler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300220
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300220,
					"content": "Onlara bir ders verip işlerimizi aksatmalarını engelleyebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300221,
						718300223
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300221,
					"content": "Tamam, hallederim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300222
					]
				},
				{
					"id": 718300222,
					"content": "Çok ama çok sağ ol!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300223,
					"content": "Bunu neden Taşordu askerlerinden istemiyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300224
					]
				},
				{
					"id": 718300224,
					"content": "Zaten gece gündüz demeden şantiye alanını koruyorlar, onları iyice yormak istemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300225
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300225,
					"content": "Bu işi senin ellerine bırakıyorum Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300210,
					"content": "Buranın pek güvenli bir bölge olmadığını hatırlıyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300211
					]
				},
				{
					"id": 718300211,
					"content": "Çevresinin canavarlarla ve Hazine Avcılarıyla dolu olmasından mı bahsediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300212
					],
					"speakerTitle": "Wang Ping'an"
				}
			]
		},
