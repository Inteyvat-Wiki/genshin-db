			"dialogs": [
				{
					"id": 718300601,
					"content": "Tamamdır, bu <color=#00E1FFFF>Kum Ağacı Kütüğünü</color> alayım ben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300602
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300602,
					"content": "Tapınak tadilatı bir süre daha devam edecek, o nedenle ben de buralarda olacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300603
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300603,
					"content": "Vaktin olduğunda işler nasıl gidiyor diye bakmaya gelebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				}
			]
		},
		{
			"id": 7183007,
			"completionStepIds": [
				7183007
			],
			"beginWay": "TALK_BEGIN_MANUAL",
