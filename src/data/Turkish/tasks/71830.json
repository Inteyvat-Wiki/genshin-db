				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718300701,
					"content": "Hoş geldin. Etrafta hiç Hazine Avcısı var mıydı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300702
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300702,
					"content": "Ah, gittiler demek. Güzel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300703
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300703,
					"content": "Yardımcı olabileceğim başka bir şey var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300704
					]
				},
				{
					"id": 718300704,
					"content": "Hahaha. Çok kibarsın, teşekkür ederim. Bana zaten yeteri kadar yardım ettin, daha fazlasını istemek ayıp olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300705
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300705,
					"content": "Ancak gönlünden illa yardım etmek geçiyorsa bize biraz <color=#00E1FFFF>Kum Ağacı Kütüğü</color> getirmen çok işimize yarar. Bunu tapınak tadilatına yapacağın resmi bir katkı olarak düşünebilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300706
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300706,
					"content": "İyilik et iyilik bul demişler. Yapacağın küçük bir yardım belki bahtını açar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300707,
						718300709
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300707,
					"content": "Tamamdır, getireceğim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300708
					]
				},
				{
					"id": 718300708,
					"content": "Haha, peki. Topladığın <color=#00E1FFFF>Kum Ağacı Kütüklerini</color> doğrudan bana getirebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300709,
					"content": "Tadilat için bağış yapan başka insanlar da oldu mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300710
					]
				},
				{
					"id": 718300710,
					"content": "Hımm, açıkçası pek olmadı. Burası oldukça ücra bir yer olduğundan dolayı insanlar burada bir tapınak olduğunu bile bilmiyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300711
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300711,
					"content": "Ayrıca Pervases adında bir Yakshanın varlığından da pek çok insan bihaber...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300712
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718300712,
					"content": "Neyse, bunu daha sonra konuşuruz. Bulduğun <color=#00E1FFFF>Kum Ağacı Kütüklerini</color> doğrudan bana getir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				}
			]
		},
