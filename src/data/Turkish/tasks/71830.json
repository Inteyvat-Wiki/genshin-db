			"trigger": {
				"objectNames": [
					"Hazine Avcısı Şefi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718300401,
					"content": "Lütfen yeter! Teslim oluyoruz, lütfen bizi bağışlayın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300402,
						718300403
					],
					"speakerTitle": "Hazine Avcısı Şefi"
				},
				{
					"id": 718300402,
					"content": "Pılınızı pırtınızı toplayıp defolun!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300404
					]
				},
				{
					"id": 718300404,
					"content": "Tamam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300405
					],
					"speakerTitle": "Hazine Avcısı Şefi"
				},
				{
					"id": 718300405,
					"content": "Sizi gücendirecek ne yaptık ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300406
					],
					"speakerTitle": "Hazine Avcısı Şefi"
				},
				{
					"id": 718300406,
					"content": "Yakınlarda hazine falan mı buldunuz yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300407
					],
					"speakerTitle": "Hazine Avcısı Şefi"
				},
				{
					"id": 718300407,
					"content": "Yakınlardaki bir tapınağı yeniden inşa ediyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300408
					]
				},
				{
					"id": 718300408,
					"content": "Bu dağların ortasında bir tapınağı yeniden mi inşa ediyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300409
					],
					"speakerTitle": "Hazine Avcısı Şefi"
				},
				{
					"id": 718300409,
					"content": "Buralarda bir Adeptus anısına dikilmiş bir tapınak mı var? Bir dakika, yoksa o eski ev...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300410
					],
					"speakerTitle": "Hazine Avcısı Şefi"
				},
				{
					"id": 718300410,
					"content": "Geçen o taraflarda dinlenirken bir kuş heykeli görmüştük patron. Muhtemelen orası...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300411
					],
					"speakerTitle": "Hazine Avcısı Yardımcısı"
				},
				{
					"id": 718300411,
					"content": "Yakshalardan biri olan Pervases o.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300412
					]
				},
				{
					"id": 718300412,
					"content": "Ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300413
					],
					"speakerTitle": "Hazine Avcısı Şefi"
				},
				{
					"id": 718300413,
					"content": "Patron, yoksa biz bir Adeptusa saygısızlık mı ettik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300414
					],
					"speakerTitle": "Hazine Avcısı Yardımcısı"
				},
				{
					"id": 718300414,
					"content": "Saçmalama! Bilmiyorduk sonuçta, o yüzden sayılmaz! Adeptus cahilliğimizi bağışlayacaktır bence... Değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300415
					],
					"speakerTitle": "Hazine Avcısı Şefi"
				},
				{
					"id": 718300415,
					"content": "Neyse! Tapınak tadilatını haber verdiğin için teşekkür ederiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300416
					],
					"speakerTitle": "Hazine Avcısı Şefi"
				},
				{
					"id": 718300416,
					"content": "Cahilliğimiz ve kabalığımız için de özür dileriz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300417
					],
					"speakerTitle": "Hazine Avcısı Şefi"
				},
				{
					"id": 718300417,
					"content": "Geri dönüp diğerlerine de tapınaktan uzak durmalarını söyleyeceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300418
					],
					"speakerTitle": "Hazine Avcısı Şefi"
				},
				{
					"id": 718300418,
					"content": "Tapınağa gidip Adeptustan özür dilemek adına birkaç tütsü yaksak daha iyi olmaz mı patron?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300419
					],
					"speakerTitle": "Hazine Avcısı Yardımcısı"
				},
				{
					"id": 718300419,
					"content": "Son zamanlarda çenen iyice düştü senin! Hadi düş önüme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hazine Avcısı Şefi"
				},
				{
					"id": 718300403,
					"content": "Bir daha buranın yakınından dahi geçmeyin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300404
					]
				}
			]
		},
