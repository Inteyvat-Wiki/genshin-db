			"dialogs": [
				{
					"id": 120440201,
					"content": "Aah ah, burada Tanukileri kovaladığımız günleri hatırlıyor musun? Ne zamanlardı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440202,
					"content": "Hı? O da ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440203,
						120440204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440203,
					"content": "Bir Tanuki mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440205
					]
				},
				{
					"id": 120440205,
					"content": "Paimon öyle göründüğünü düşünmüyor... Aa, belki de yeni bir youkai türüdür?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440206,
					"content": "Hım... Onu takip etmemizi mi istiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440204,
					"content": "Bir domuz yavrusu mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440205
					]
				}
			]
		},
		{
			"id": 1204403,
