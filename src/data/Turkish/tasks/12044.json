			"dialogs": [
				{
					"id": 120440801,
					"content": "Ne oldu öyle? Bir anlığına göz göze geldik, sonra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440802,
					"content": "Bir dakika, tüm bu insanlar nereden çıktı? Ne işleri var burada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440803,
					"content": "Bir şey için sıraya girmişler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440804
					]
				},
				{
					"id": 120440804,
					"content": "Evet... Aa şu kız! Hâlâ burada. Hımm, belki o neler olduğunu biliyordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440805,
					"content": "Şimdi gidersem yeterli vaktim olacak mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440806
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 120440806,
					"content": "Daha kaç kere açıklamam gerekiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440807
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 120440807,
					"content": "Onu ihbar edersem geri dönüşü yok. Yine de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440808
					],
					"speakerTitle": "Sanada"
				},
				{
					"id": 120440808,
					"content": "Hım... İlham eksikliğinden kaynaklı kaygı... İlham genellikle kaygılı zihinlere yaklaşmaz. Umarım tedavimiz seni rahatlatabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440809
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440809,
					"content": "... Teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440810
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 120440810,
					"content": "... Geçmişteki yanlışlar için duyulan pişmanlık, bugünkü üzücü durum için hissedilen umutsuzluk... Sorunlarınla daha pozitif bir şekilde yüzleşmeni sağlayabilirim ancak senin de bazı şeyleri kendin halletmen gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440811
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440811,
					"content": "... Çok teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440812
					],
					"speakerTitle": "Nishiguchi"
				},
				{
					"id": 120440812,
					"content": "Sıradaki! *öksürür*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440813
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440813,
					"content": "Neyi var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440814,
					"content": "İyi misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440815
					]
				},
				{
					"id": 120440815,
					"content": "İyiyim. Sıradaki lütfen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440816
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440816,
					"content": "Şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440817,
					"content": "Mmm! Lezzetli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440818
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440818,
					"content": "Aaa, bu beklenmedikti işte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440819,
					"content": "Hı? Ne varmış burada... *geğirir* Ay, çok özür dilerim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440820
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440820,
					"content": "Niye özür diledin? Gerçi niye özür dilediğini bırak, burada neler olduğu hakkında hiçbir fikrimiz yok. Zahmet olmazsa anlatabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440821
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440821,
					"content": "Görünüşe göre yanlışlıkla benim rüyama girdiniz. Sizi uyandırayım da anlatayım her şeyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440822
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440822,
					"content": "Rüya mı? Ne zaman...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440901
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440901,
					"content": "Aaa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440902,
					"content": "#Merhaba! Biraz daha kendine gelmiş hissediyor musun? Heh, {NICKNAME} gelip rüyama girecek, hiç aklıma gelmezdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440903
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440903,
					"content": "Beni nereden tanıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440904
					]
				},
				{
					"id": 120440904,
					"content": "Bir tanıdığım sürekli senden bahsediyor. Ayrıca... Duyduklarımdan yola çıkarak profil çıkarmakta çok iyiyimdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440905
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440905,
					"content": "Sen kimsin peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440906,
					"content": "Doğru ya. İlk defa karşılaşıyoruz, doğru düzgün tanıtmam gerekir kendimi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440907
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440907,
					"content": "Ben Yumemizuki Mizuki veya kısaca \"Mizuki\". Ben bir Yumekui-bakuyum, Inazuma'daki bir youkai türüyüz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440908
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440908,
					"content": "Yumekui-baku mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440909,
					"content": "*homurdanır*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440910
					],
					"speakerTitle": "Küçük Baku"
				},
				{
					"id": 120440910,
					"content": "Hey, bu daha önce gördüğümüz şu küçük yaratık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440911,
					"content": "Asıl formumuz böyle görünüyor işte. Sanırım sizi rüyama yönlendiren de oydu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440912
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440912,
					"content": "Bakular, insanların kötü rüyalarıyla ziyafet çekerler, ancak onları sindirebilmek için kendi rüyamızda olmamız gerekir. Daha önce karşılaştığımız yer de kötü rüyaları sindirmek için gittiğim yerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440913
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440913,
					"content": "Sanırım çok fazla kötü rüya yedim çünkü sindirim sorunları çekiyorum... Neyse ki siz tam zamanında çıkageldiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440914
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440914,
					"content": "Tatlı bir tesadüf diyelim. Yardımın sayesinde artık tüm bu rüyaları düzgünce sindirebiliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440915
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440915,
					"content": "Evet, biraz rahatsız görünüyordun. Biz de o yüzden buraya geldik. Ne olduğundan haberimiz yoktu ama yardıma ihtiyacın olabileceğini düşündük.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440916
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440916,
					"content": "Hem Paimon kötü rüyaları hiç sevmez, o yüzden onları yiyebildiğin için çok mutlu oldu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440917,
					"content": "Teşekkür ederim... Ancak yine de sana bir özür borcum var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440918
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440918,
					"content": "Ne için?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440919
					]
				},
				{
					"id": 120440919,
					"content": "Sen rüyamdayken... Ben senin bir rüyanı yedim ama kötü olanlardan değildi. Güzel bir rüyaydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440920
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440920,
					"content": "Bugün o kadar fazla kötü rüya yedim ki farkına varmadan mideye indirivermişim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440921
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440921,
					"content": "Yani Yumekui-bakular güzel rüyaları da yiyebiliyor... Peki bu önemli bir mesele mi ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440922
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440922,
					"content": "Tabii ki öyle. Rüyalar, bir insanın sahip olabileceği en kıymetli şeylerdendir ve ben onu bir lokmada yuttum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440923
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440923,
					"content": "Bu benim türüm için yazılı olmayan bir kuraldır. \"Asla birinin güzel rüyalarını izinsiz yeme.\" Bu kadar dikkatsiz olduğuma inanamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440924,
						120440925
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440924,
					"content": "Kendine yüklenme böyle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440926
					]
				},
				{
					"id": 120440926,
					"content": "Ama... Aşırı depresif hissetmiyor musun kendini? Zihnin bir anda can sıkan anılarla dolup taşmadı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440927
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440927,
					"content": "Hayır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440928
					]
				},
				{
					"id": 120440928,
					"content": "Şaşırtıcı... Daha önce güzel rüyası yutulan birinin akıl sağlığını böyle koruyabildiğine şahit olmamıştım hiç...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440929
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440929,
					"content": "#Hım.... {NICKNAME} sayısız güzel rüya gördüğünden bir tanesinin yutulması sorun olmamıştır belki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440930
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440930,
					"content": "Olabilir, ama yine de bunun karşılığında sana bir şey borçluyum... Aa! İşte, al bunu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440931
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440931,
					"content": "Aisa Hamamı için VIP bilet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440932
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440932,
					"content": "\"Klinik psikologların görev yaptığı merkezimizde spa ve kaliteli yemek hizmetleri de sunuyoruz. Dertlerinizi bize getirip yenilenmiş ve tazelenmiş şekilde buradan ayrılmanız için sizleri davet ediyoruz...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440933
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440933,
					"content": "Ben burada çalışıyorum işte. Adresi üzerinde yazıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440934
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440934,
					"content": "Bu davet mektubunu kullanarak üst düzey hizmetimizden ücretsiz şekilde faydalanabilirsiniz... Ha, iş demişken, geç olmadan dönsem iyi olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440935
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440935,
					"content": "Yakında sizi bekliyoruz o zaman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440936
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120440936,
					"content": "Şimdi bu Mizuki hem kötü rüyaları yiyen bir Yumekui-baku hem de bir klinik psikolog, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440937,
						120440938
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440937,
					"content": "Öyleymiş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440939
					]
				},
				{
					"id": 120440939,
					"content": "Paimon daha önce hiç terapi almayı düşünmemişti. Gerçi Paimon hiç o kadar stres de olmaz ya. Tabii ne yiyeceğine karar vermeye çalıştığı anlar hariç...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120440940
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440940,
					"content": "Yemek demişken, şu hamamda güzel yemekler servis ediyorlarmış, bizim de VIP biletimiz var. Yani istediğimiz kadar yiyebiliriz, değil mi? Böylesi her zaman çıkmaz karşımıza! Kaçıramayız bu fırsatı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120440938,
					"content": "Evet. Oldukça havalı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440939
					]
				},
				{
					"id": 120440925,
					"content": "Ben iyiyim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120440926
					]
				}
			]
		},
