					"nextDialogs": [
						750800102,
						750800103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750800102,
					"content": "Bu neden bir yerlerden tanıdık geldi bana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750800104
					]
				},
				{
					"id": 750800104,
					"content": "Aa, zamanında Filojiston ile aşıladığımız tohum bu. Paimon onun Kor Çiçeği tohumu olduğunu fark etmemişti. Demek o yüzden daha önce çiçek açmıyormuş! İçinde yeterince Filojiston yokmuş ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750800105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750800105,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750800106
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750800106,
					"content": "#Gördün mü {REALNAME[ID(2)|SHOWHOST(true)]}? Senin ektiğin çiçek bu, bak. Tohum sapasağlam büyümüş, gayet güzel çiçek açıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750800107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750800107,
					"content": "Yalancı Çiçek çıkmamasına şaşırdım doğrusu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750800108
					]
				},
				{
					"id": 750800108,
					"content": "Sen de taktın kafaya yalancı çiçekleri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750800109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750800109,
					"content": "Rarr... Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750800110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750800110,
					"content": "#Hehe, ne kadar mutlu olduğun gözlerinden belli {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750800111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750800111,
					"content": "Sen de bu tohum gibi büyüyüp kocaman, güçlü ve harika bir Sürüngen olacaksın. Anlaştık mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750800103,
					"content": "#Bu tohumu {REALNAME[ID(2)|SHOWHOST(true)]} ekmemiş miydi?",
