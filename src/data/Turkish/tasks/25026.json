			"dialogs": [
				{
					"id": 250260401,
					"content": "Şu Hazine Avcılarına hadlerini bildirelim madem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260402
					]
				},
				{
					"id": 250260402,
					"content": "Sen de mi gelmek istiyorsun? Gerçekten çok sağ ol! Görmüş geçirmiş bir maceracı olduğun ortada zaten, bana büyük yardımın dokunacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260403
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260403,
					"content": "Maceracılar Loncası kurallarına uygun olarak ödemeni de yapacağım mutlaka. Hadi gidelim de o haydutları doğduklarına pişman edelim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlamot"
				}
			]
		},
