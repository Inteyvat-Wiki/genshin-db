			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tlamot"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250260301,
					"content": "Normalde tüm zamanını burada geçirir ama bugün hiç uğramamış bile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260302
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260302,
					"content": "Büyük bir şok geçirdi gerçi, saklanıyordur kesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260303
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260303,
					"content": "Aramaya gidelim mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260304
					]
				},
				{
					"id": 250260304,
					"content": "Yok. Biraz rahat bırakalım da kendine gelsin. Mantarları şuraya koyalım, o alır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260305
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260305,
					"content": "Tecrübelisin bakıyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260306
					]
				},
				{
					"id": 250260306,
					"content": "Ufaklığın bakımı konusunda mı? Öyleyim tabii. Bir süredir ona bakıyorum, hassas bir hayvan olduğunu öğrendim artık. Tanımadığı birini görünce korkudan ne yapacağını şaşırıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260307
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260307,
					"content": "Bana da ancak ben uzun bir süre yemek getirdikten sonra ısınmaya başlamıştı... Ama şimdi uzun bir süre ortalarda görünmez muhtemelen. O alçak herifler her şeyi mahvetti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260308
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260308,
					"content": "Şimdilik onu yalnız bıraksak daha iyi olur bence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260309
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260309,
					"content": "Eşlik ettiğin için teşekkürler. İşte ödülün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260310,
						250260311
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260310,
					"content": "Onu göremediğimize çok üzüldüm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260312
					]
				},
				{
					"id": 250260312,
					"content": "Merak etme, kendisine iyilik yapanları asla unutmaz o. Zamanı geldiğinde mutlaka bizi görmeye gelecektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260311,
					"content": "Küçük Yumkazorla tanışmayı çok isterdim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260312
					]
				}
			]
		},
