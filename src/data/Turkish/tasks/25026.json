				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tlamot"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250260201,
					"content": "Bence sen Yumkazoru rahatlatmaya odaklan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260202
					]
				},
				{
					"id": 250260202,
					"content": "Hımm... Doğru diyorsun aslında. Zavallı ufaklığın ödü koptu zaten... Dediğin gibi olsun o zaman. Önce onu biraz rahatlatalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260203
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260203,
					"content": "Sen de gel bakalım. Deneyimli bir maceracı olduğun her halinden belli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260204
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260204,
					"content": "İkimiz bir aradayken o hırsızlar saçma bir işe kalkışsın da göreyim ben onları... Ödeme konusunda da endişelenme. Lonca kurallarını bilen ve uygulayan biriyimdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260206
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260206,
					"content": "Bizim ufaklık Şamdan Mantarlarını yemeye bayılıyor. Yanlış hatırlamıyorsam şu ağacın altında bir sürü mantar oluyordu. Toplamaya oradan başlayabilirsin istersen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260205
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260205,
					"content": "Ben diğer tarafta Şamdan Mantarı toplayacağım. Sen de işini bitirince Stadyumun oradaki uçurumda buluşalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260207
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260207,
					"content": "Küçük Sürüngen genelde orada dinleniyor. Orada bulabiliriz belki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlamot"
				}
			]
		},
		{
			"id": 2502603,
			"completionStepIds": [
				2502603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
