			"dialogs": [
				{
					"id": 250260501,
					"content": "Hıh. Hele bir daha küçük Yumkazoruma ellerini kaldırsınlar bak, ne yapıyorum ben onlara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260502
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260502,
					"content": "Ortada bir yanlış anlaşılma var sanki...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260503
					]
				},
				{
					"id": 250260503,
					"content": "İnanma sen onların palavralarına, kendi gözlerimle gördüm diyorum! Zavallı Yumkazorun kuyruğuna ip geçirip onu sürüklemeye çalışıyorlardı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260504
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260504,
					"content": "Zamanında yetişmesem kim bilir başına neler gelecekti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260505
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260505,
					"content": "Neyse, yardımın için çok teşekkür ederim. İşte ücretin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260506
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260506,
					"content": "Hemen tabanları yağlamasalardı keşke... Elimize geçselerdi bir daha buraya adım dahi atamazlardı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlamot"
				}
			]
		},
