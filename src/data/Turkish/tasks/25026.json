			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tlamot"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250260101,
					"content": "Vah zavallı küçük Yumkazor, kıyamam ben sana... Yetti artık be. Dünya kaç bucakmış göstereceğim o alçaklara ben, burunlarından fitil fitil getireceğim yaptıklarını!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260102
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260102,
					"content": "Kaçabilirsiniz ama saklanamazsınız pis eşkıyalar sizi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260103
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260103,
					"content": "Ne oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250260104
					]
				},
				{
					"id": 250260104,
					"content": "Sen... Uzaklardan gelen bir gezgin olmalısın. Hoş geldin ama maalesef şu anda sohbete ayıracak vaktim yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260105
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260105,
					"content": "Hazine Avcıları denen o reziller yine şu küçük Yumkazoru yakalamaya çalıştı. Zamanında yetiştim de onların pençesinden kurtardım zavallıyı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260106
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260106,
					"content": "Ama baksana, korkudan küçük dilini yutmuş resmen. O kadar yalvardım yakardım ama yok, yanıma yanaşmıyor bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260107
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260107,
					"content": "Neyse, ziyanı yok. O haydutların saklandığı yeri buldum bile, canlarına okuyacağım... İşim bitince de ibret olsun diye hepsini şu ağaca bağlayıp sıra dayağına çekmezsem neyim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250260108
					],
					"speakerTitle": "Tlamot"
				},
				{
					"id": 250260108,
					"content": "Bu zavallı ürkmüş Yumkazoru rahatlatmak için yiyecek bir şeyler de bulmam lazım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tlamot"
				}
			]
		},
		{
			"id": 2502602,
			"completionStepIds": [
				2502601,
				2502606
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
