			},
			"dialogs": [
				{
					"id": 730580201,
					"content": "Ne oldu? Bir şey buldunuz mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580202
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580202,
					"content": "Hımm... Ne olduğu belirsiz emirler var sadece... He, bir de bu var! Kurumuş bir çiçek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730580203,
					"content": "Aa! Bu çiçeği alabilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580204
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580204,
					"content": "Bu kötü adamların bıraktığı çiçek ama... Zehirlenmekten falan korkmuyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730580205,
					"content": "Korkmaya gerek yok. Bu çiçeği daha önce de gördüm. Sahibini tanıyor olmalıyım... Lütfen bana verin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580206
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580206,
					"content": "Tamam, al bakalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580207
					]
				},
				{
					"id": 730580207,
					"content": "#Teşekkür ederim Nara {NICKNAME} ve Uçuşkan Beyazlı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580208
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580208,
					"content": "Aragaru küçük kuru çiçekleri Mawtiyima Ormanı'na getirdi...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
