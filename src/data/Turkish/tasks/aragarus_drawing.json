			},
			"dialogs": [
				{
					"id": 730580101,
					"content": "Yine gelmişsiniz Altın Nara ve Uçuşkan Beyazlı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580102
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580102,
					"content": "Ay! Bir dahaki sefere fırlamadan önce selam ver! Paimon'u yine korktuttun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580103,
						730580104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730580103,
					"content": "Biz kötü kişiler değiliz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580105
					]
				},
				{
					"id": 730580105,
					"content": "Hımm... Doğru diyorsun. Peki bana yine yardım edebilir misiniz iyi niyetli Altın Nara ve Uçuşkan Beyazlı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580106
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580106,
					"content": "#Tabii ki. Ben {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580107
					]
				},
				{
					"id": 730580107,
					"content": "Paimon da Paimon. Sakın bir daha unutma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730580108,
					"content": "Bir daha mı? Şey... Öhöm, ben Aragaru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580109
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580109,
					"content": "#Seninle daha önce de karşılaşmıştık ama her şeyi unutmuşsun. Off, hepsini açıklaması çok zor olacak! Birlikte anlatalım mı {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730580110,
					"content": "Aragaru'ya beraber atıldığınız macerayı ayrıntılarıyla anlatıyorsunuz.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730580111
					]
				},
				{
					"id": 730580111,
					"content": "Öyle mi? Hatırlayamıyorum ama nedense size inanmak istiyorum. Üstelik verdiğim çiçek de sizde, hissedebiliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580112
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580112,
					"content": "Az kalsın unutuyordum! Kötü Naralar bir kamp kurdu. Geride ne bıraktıklarına bakmamız lazım. Belki planlarını öğreniriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580104,
					"content": "Sizin için kötüleri kovduk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580105
					]
				}
			]
		},
		{
			"id": 7305802,
