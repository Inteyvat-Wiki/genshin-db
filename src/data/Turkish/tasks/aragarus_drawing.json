					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730580402
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730580402,
					"content": "Birinin kötü olduğunu nasıl anlıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730580403
					]
				},
				{
					"id": 730580403,
					"content": "#Tam olarak açıklayamıyorum ama Nara {NICKNAME} ve Uçuşkan Beyazlı kesinlikle kötü değil! Ben öyle düşünüyorum!",
					"roleType": "TALK_ROLE_NPC",
