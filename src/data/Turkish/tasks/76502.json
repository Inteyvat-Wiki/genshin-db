			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aino"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765020101,
					"content": "#Sen miydin {NICKNAME}! Aa, Paimon da gelmiş! Nasıl gidiyor? Yoksa süper mega bir görev için benim dehama mı ihtiyacınız var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020102
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020102,
					"content": "Bakın ne diyeceğim, hizmetlerim için size yüzde yirmilik bir arkadaş indirimi yapacağım! Bana abur cubur getirin yeter... Ha bir de Ineffa'ya bir şey söylemeyin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020103,
						765020104
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020103,
					"content": "Öylesine etrafa bakınıyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020105
					]
				},
				{
					"id": 765020105,
					"content": "Hehe, o zaman buradan iyisini bulamazsınız! Atölyem yüzde yüz on müsmükemmel bir yerdir. Buradan daha güzel bir yer bulamayacağınıza bahse girerim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020106
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020106,
					"content": "Bir tek adımınızı attığınız yere dikkat edin, yoksa bir parçaya takılıp yere kapaklanabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020107,
						765020108
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020107,
					"content": "Bu robot çok... Özel görünüyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020109
					]
				},
				{
					"id": 765020109,
					"content": "Hehe! Tabii ya, ne sandın? Adı Demir Yumruk Ördek. Çöp ve hurda ayıklamak için tasarladım onu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020110
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020110,
					"content": "Ama biraz fazla sağlam ve kollarını mega hızlı yaptım. Sonra da \"Madem öyle, neden süper güçlü bir savunması olmasın?\" dedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020111
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020111,
					"content": "Böylece atölyeme girmeye çalışan kötü adamları kolayca geri dönüştürülemeyen atıklara çevirebilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020112
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020112,
					"content": "Hayal gücün her zamanki gibi çılgın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020113,
						765020114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765020113,
					"content": "Eh, hazır fırsatını yakalamışken...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020115
					]
				},
				{
					"id": 765020115,
					"content": "Ben mi? Demir Yumruk Ördek ile mi? Ş-Şey, insanlar genelde icatlarıma ilgi gösterir. Pek benim fotoğrafımı çekmezler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020116
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020116,
					"content": "Ama dahi çocuk ile onun en iyi ve yenilmez savaş robotunu Kameranla görüntülemek istiyorsan... Evet, tabii ki olur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020117
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020117,
					"content": "Sadece... Kendi resmimi pek çekmediğimden nasıl havalı çıkacağımı falan pek bilmem... O yüzden fotoğrafların nasıl görüneceğinden emin değilim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020118,
						765020119
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020118,
					"content": "Kendin ol yeter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020120
					]
				},
				{
					"id": 765020120,
					"content": "Harika! Bu iş sende o zaman, Demir Yumruk Ördek en havalı haliyle çıksın yeter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aino"
				},
				{
					"id": 765020119,
					"content": "Seni en iyi göründüğün anda çekeceğim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020120
					]
				},
				{
					"id": 765020114,
					"content": "Senin fotoğrafını çekebilir miyiz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020115
					]
				},
				{
					"id": 765020108,
					"content": "Sen mi yaptın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020109
					]
				},
				{
					"id": 765020104,
					"content": "Bir yandan da fotoğraf çekmek için malzeme arıyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020105
					]
				}
			]
		},
