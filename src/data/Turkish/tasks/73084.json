			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Afratu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730840201,
					"content": "Siz bendeniz Afratu'nun özel olarak görevlendirdiği Münzeviler misiniz? Değilseniz lütfen burada durun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840202
					],
					"speakerTitle": "Afratu"
				},
				{
					"id": 730840202,
					"content": "İlerideki bölge çok tehlikeli. Bununla ilgilenmeleri için çoktan Regzar Kalesi'ndeki Münzevileri ayarladım. Sıradan insanlar buradan uzak durmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840203
					],
					"speakerTitle": "Afratu"
				},
				{
					"id": 730840203,
					"content": "Başınıza bir şey gelirse Mahamata olarak görevimi ihmal etmiş olurum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840204,
						730840206
					],
					"speakerTitle": "Afratu"
				},
				{
					"id": 730840204,
					"content": "Sıradan insanlar değiliz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840205
					]
				},
				{
					"id": 730840205,
					"content": "Ah, tüm yeni maceracılar böyle söyler ama aşırı özgüven çölde tehlikelidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840208
					],
					"speakerTitle": "Afratu"
				},
				{
					"id": 730840208,
					"content": "Şuradaki büyük makinayı görüyor musun? Efsanevi Dahri insanlarının yadigarı olduğu söylenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840209
					],
					"speakerTitle": "Afratu"
				},
				{
					"id": 730840209,
					"content": "Dahri mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840210
					]
				},
				{
					"id": 730840210,
					"content": "Belki de Khaenri'ah ismi senin için daha tanıdıktır. Dahri, genelde Vahumana Darşanında kullanılan eski bir isimdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840211
					],
					"speakerTitle": "Afratu"
				},
				{
					"id": 730840211,
					"content": "Dah{RUBY#[S]Khaenri'ah}ri Schwanenritter'ın bu devasa makinaları bir zamanlar hiçlikten gelen canavarlarla savaşmak için kullandığı söyleniyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840212
					],
					"speakerTitle": "Afratu"
				},
				{
					"id": 730840212,
					"content": "Üç Harabe Devi o zalim savaştan kurtuldu ve bilgeler tarafından mühürlendi. Bu onlardan biri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840213
					],
					"speakerTitle": "Afratu"
				},
				{
					"id": 730840213,
					"content": "Asırlardır burada sessizce duruyordu ama son zamanlarda birden etkinleşti ve hatta yakındaki insanlara bile saldırdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840214
					],
					"speakerTitle": "Afratu"
				},
				{
					"id": 730840214,
					"content": "Ayırt etmeden çevresindeki tüm canlılara ışın toplarıyla saldırıyor. Harabe Devlerinin bu tehlikeli özelliklerini ilk defa görüyoruz. Bu durumla hemen ilgilenmemiz lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840215
					],
					"speakerTitle": "Afratu"
				},
				{
					"id": 730840215,
					"content": "Onlara enerji veren Kaos Çekirdeklerinin uzun zaman önce tükenmiş olması gerekirdi, yani hâlâ işlevsel olmaları biraz garip... Hem de asırlar sonrasında bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840216
					],
					"speakerTitle": "Afratu"
				},
				{
					"id": 730840216,
					"content": "Paimon hiçbir şey anlamadı ama bu Harabe Devi Devantaka Dağı'nda gördüğümüze benziyor değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730840217,
					"content": "Ama o koca şey çevresindeki her şeye saldırmamıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730840218,
					"content": "Ah, Harabe Devlerini biliyorsunuz demek? Uzun uzadıya anlatmama gerek yok o zaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840219
					],
					"speakerTitle": "Afratu"
				},
				{
					"id": 730840219,
					"content": "Aklınızda olsun, otomatik sistemleri olsa da genelde onları insanlar kullanıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840220
					],
					"speakerTitle": "Afratu"
				},
				{
					"id": 730840220,
					"content": "Zaten garip olan da bu. Bilgeler Suda Akışını kullanarak Harabe Devine giden yolu mühürlemişlerdi, yani kimsenin onu etkinleştirmemesi lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840221
					],
					"speakerTitle": "Afratu"
				},
				{
					"id": 730840221,
					"content": "Acaba biri başka yollardan mı içeriye girdi? Ya da bilmediğimiz bir etkinleştirme cihazıyla mı tetiklendi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840222,
						730840227
					],
					"speakerTitle": "Afratu"
				},
				{
					"id": 730840222,
					"content": "Keşke Jazari burada olsaydı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840223
					]
				},
				{
					"id": 730840223,
					"content": "Evet! Bay Jazari Harabe Devi araştırmasında uzmandır! Burada olsaydı içeri girip kesinlikle bir göz atmak isterdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730840224,
					"content": "Jazari'yi tanıyorsunuz demek? Evet bu makinalar üzerine bir takım araştırmalar yaptı. Araştırmaya yardımcı olmasını istedim ama bir şeyler yazmakla meşgul gibiydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840225
					],
					"speakerTitle": "Afratu"
				},
				{
					"id": 730840225,
					"content": "Belki de Kshahrewar'un saflığı da budur. Eğer Akademinin iç işleyişi ile daha çok ilgilenseydi şu anda Dastur ile durmazdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840226
					],
					"speakerTitle": "Afratu"
				},
				{
					"id": 730840226,
					"content": "Sana bizim yardım etmemize ne dersin? Bay Jazari'ye de araştırmasında yardımcı olmuştuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730840231,
					"content": "#Tabii Münzevilerin ödeneğini bize verirsen. Değil mi {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730840232,
					"content": "Gerçekten mi? Önceden deneyimi olan birilerinin olması çok iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840233
					],
					"speakerTitle": "Afratu"
				},
				{
					"id": 730840233,
					"content": "Ama siz maceracı mısınız? Sıradan vatandaşları riske atamam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840234
					],
					"speakerTitle": "Afratu"
				},
				{
					"id": 730840234,
					"content": "Benzer bir makinanın araştırmasına yardımcı olmuşsunuz ama bu farklı. Bu şeyden gelen ışın toplarının şakası yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840235
					],
					"speakerTitle": "Afratu"
				},
				{
					"id": 730840235,
					"content": "Hayatınızı tehlikeye atmanıza izin verirsem Akademiye hesap veremem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840236,
						730840238
					],
					"speakerTitle": "Afratu"
				},
				{
					"id": 730840236,
					"content": "Biz kayıtlı maceracılarız.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840237
					]
				},
				{
					"id": 730840237,
					"content": "O halde en azından kulağa prosedüre uygun geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840240
					],
					"speakerTitle": "Afratu"
				},
				{
					"id": 730840240,
					"content": "Ne de olsa yapacak önemli bir araştırmam var burada dikilip kalmak da akıl karı değil. Sorunların hızlıca çözümünü size bırakıyorum o halde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840241
					],
					"speakerTitle": "Afratu"
				},
				{
					"id": 730840241,
					"content": "Harabe Devinin içine girip otonom sistemlerini devre dışı bırakmanız gerekiyor. Bu olayın ardındaki sebebi de ortaya çıkarırsanız çok iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840242
					],
					"speakerTitle": "Afratu"
				},
				{
					"id": 730840242,
					"content": "Otonom sistemi kabinindeki bir şalter ile kontrol ediliyor olmalı. Onu kapattıktan sonra Harabe Devinin el ile yönetim moduna girmesi lazım. Bununla birlikte maalesef kabin de mühürlü... Girmeden önce mührü kırman gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840243
					],
					"speakerTitle": "Afratu"
				},
				{
					"id": 730840243,
					"content": "Hımm... Kayıtlara göre mührün gücü \"Suda Akışı\" denilen üç grup mekanizmadan geliyormuş. Bunlar kırılırsa girişteki mühür de kalkar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840244
					],
					"speakerTitle": "Afratu"
				},
				{
					"id": 730840244,
					"content": "Sadece iç yapıyı kırmamak için dikkat et. Sonuçta bu Akademide kayıtlı önemli bir kültürel yadigar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840245
					],
					"speakerTitle": "Afratu"
				},
				{
					"id": 730840245,
					"content": "Hehe, tabii ki! O işi bize bırak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730840238,
					"content": "Biz dünyaca ünlü maceracılarız.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840239
					]
				},
				{
					"id": 730840239,
					"content": "Gerçekten mi? Bunu sonra Maceracılar Loncasından doğrulayabilirim ama şimdilik sizin sözünüz yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840240
					],
					"speakerTitle": "Afratu"
				},
				{
					"id": 730840227,
					"content": "Öğrenmenin tek yolu içeriye girip bir bakmak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840228
					]
				},
				{
					"id": 730840228,
					"content": "Doğru ama yine de Regzar Kalesi'nde ne olduğunu merak ediyorum... Münzeviler çok gecikti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840229
					],
					"speakerTitle": "Afratu"
				},
				{
					"id": 730840229,
					"content": "Akademinin mührü önemli değil. Önemli olan Harabe Devine giden yolu tıkayan devasa kaya. Kendi başıma imkanı yok hareket ettiremem onu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840230
					],
					"speakerTitle": "Afratu"
				},
				{
					"id": 730840230,
					"content": "Sana bu konuda yardımcı olabiliriz. Ne de olsa daha önce bir kez içeriye girdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730840206,
					"content": "İleride bir şey mi oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730840207
					]
				},
				{
					"id": 730840207,
					"content": "Tuhaf bir şeyler oluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840208
					],
					"speakerTitle": "Afratu"
				}
			]
		},
		{
			"id": 7308403,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Afratu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730840301,
					"content": "Bu bölgeden sorumlu Mahamata benim ama buraya geçici bir görev için gönderilmiştim. Bir keşif gezisindeydim ve yakınlardaydım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840302
					],
					"speakerTitle": "Afratu"
				},
				{
					"id": 730840302,
					"content": "Bununla birlikte ben bir Vamumanacıyım. Harabe Devleri hakkındaki bilgim okuduğum tarih kitaplarıyla sınırlı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730840303
					],
					"speakerTitle": "Afratu"
				},
				{
					"id": 730840303,
					"content": "Ama bu fırsatı kadim Dah{RUBY#[S]Khaenri'ah}ri ile ilgili daha detaylı bilgi edinmek için kullanırsam bir sonraki araştırmam için çok faydalı olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Afratu"
				}
			]
		},
		{
			"id": 7308417,
			"completionStepIds": [
				7308417
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7308417",
							"2"
						],
						"stepId": 7308417,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Afratu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730841701,
					"content": "Durum nedir? Harabe Devinin garip bir şekilde davrandığını gördüm. Yoksa otonom sistemini mi kapattınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841702,
						730841704
					],
					"speakerTitle": "Afratu"
				},
				{
					"id": 730841702,
					"content": "Aynen! Çantada keklikti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730841703
					]
				},
				{
					"id": 730841703,
					"content": "Süper! O halde özel görev tamamlandı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841706
					],
					"speakerTitle": "Afratu"
				},
				{
					"id": 730841706,
					"content": "Neden bir anda etkinleştiğiyle ilgili bir ipucu bulabildiniz mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841707
					],
					"speakerTitle": "Afratu"
				},
				{
					"id": 730841707,
					"content": "Afratu'ya Harabe Devinin içinde bulduklarından bahsediyorsun.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730841708
					]
				},
				{
					"id": 730841708,
					"content": "Aşırı büyümüş sarmaşıklar mı? Çölün doğasına pek de uymuyor. Ne olduklarından emin değilim ama sanırım Ley Hatlarıyla bir bağlantıları var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841709
					],
					"speakerTitle": "Afratu"
				},
				{
					"id": 730841709,
					"content": "Bana geçmişte çekirdeği zarar görmüş Harabe Makinalarının sürekli Ley Hatlarıyla \"dirildikleriyle\" ilgili raporlar gelirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841710
					],
					"speakerTitle": "Afratu"
				},
				{
					"id": 730841710,
					"content": "Dahri'nin yarattığı makinalarla Ley Hatları arasında henüz bilmediğimiz birçok bağlantı olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841711
					],
					"speakerTitle": "Afratu"
				},
				{
					"id": 730841711,
					"content": "Ayrıca kadim bilgelerin mührü Ley Hatlarındaki enerjiden yaratılmıştı. Bu yüzden eğer Ley Hatlarında anormal bir durum olursa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841712
					],
					"speakerTitle": "Afratu"
				},
				{
					"id": 730841712,
					"content": "Eğer çıkarımım doğruysa bu sorunların tüm mühürlü Harabe Devlerinde çıkması gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841713
					],
					"speakerTitle": "Afratu"
				},
				{
					"id": 730841713,
					"content": "Bu problem olur gibi duruyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730841714
					]
				},
				{
					"id": 730841714,
					"content": "Maalesef yapabileceğim tek şey bunu Akademiye bildirmek. Böyle bir şeyle tek başıma ilgilenemem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730841715
					],
					"speakerTitle": "Afratu"
				},
				{
					"id": 730841715,
					"content": "Buraya aslında Dahri insanlarının harabelerini keşfetmek için gelmiştim. Akademiden onay almak epey bir vaktimi almıştı, hatta yerli bir bölüğün beni alması için onlarla ileteşime bile geçtim.",
