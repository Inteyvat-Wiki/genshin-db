			"dialogs": [
				{
					"id": 4520101,
					"content": "#Selam Paimon, selam {NICKNAME}! Nasıl yardım edebilirim size?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520102,
					"content": "Selam Amber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520103,
						4520124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520103,
					"content": "Amber, bir şey oldu da...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520104
					]
				},
				{
					"id": 4520104,
					"content": "Amber, Kurtlar Diyarı'ndan gelen kurt çocuğu tanıyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520105,
					"content": "Kim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520106
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520106,
					"content": "İkiniz çok kaynaşmışsınız, öyle dedi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520107,
					"content": "Neden bahsediyorsun sen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520108
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520108,
					"content": "Tuhaf... Seni her zamanki yerde bekleyeceğini söyledi. Hafızanı falan mı kaybettin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520109,
					"content": "Hafızam gayet yerinde. Sihirli matsutake mantarı yedin yine, değil mi Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520110
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520110,
					"content": "Neden bahsettiğini bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520111
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520111,
					"content": "Sihirli matsutake... Hangi renkti onlar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520112,
					"content": "Mor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520113
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520113,
					"content": "... Paimon geçen gün birkaç tane yemiş olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520114,
					"content": "Ama konumuz bu değil! Paimon'un kafası hiç de karışık değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520115,
					"content": "Kurtlarla yaşayan o çocuğu cidden tanımıyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520116,
					"content": "Neden bahsettiğini cidden bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520117
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520117,
					"content": "Ama kurtlarla ilgili son günlerde bir şey araştırıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520118
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520118,
					"content": "Eskiden kurtlar, Kurtlar Diyarı dışına çıkmaya hiç cesaret edemezdi. Şimdilerde gittikçe cesur oluyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520119
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520119,
					"content": "Sarhoşlar Geçidi civarında bir araba konvoyuna saldırdıklarını duydum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520120
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520120,
					"content": "Vaktiniz varsa gelip konuyu araştırmama yardım eder misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520121,
						4520122
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520121,
					"content": "Tabii ki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520123
					]
				},
				{
					"id": 4520123,
					"content": "Harika! Size güvenebileceğimi biliyordum, hadi gidelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520122,
					"content": "Hadi işe koyulalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520123
					]
				},
				{
					"id": 4520124,
					"content": "Selam Amber, nasıl gidiyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520125
					]
				},
				{
					"id": 4520125,
					"content": "Merhaba... Sizin biraz vaktiniz var gibi duruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520126
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520126,
					"content": "İşte geliyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520127,
					"content": "Bu ara aşırı yoğunum. Bir Kaşifin işi asla bitmez... Yardım etmek ister misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520129
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520129,
					"content": "Demiştim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520130,
						4520131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520130,
					"content": "Tabii ki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520132
					]
				},
				{
					"id": 4520132,
					"content": "Geçen gün kurtlar Sarhoşlar Geçidi'nde arabalara saldırmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520133
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520133,
					"content": "Bildiğiniz üzere kurtlar çok tehlikeli olsalar da kendi kuralları vardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520134
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520134,
					"content": "Mondstadt'taki kurtlar genelde Parlak Taç Dağları'nın ve Kurtlar Diyarı'nın dışına pek çıkmazlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520135
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520135,
					"content": "Evet, söylenene göre yabani olmalarına ve insan eli değmemiş topraklar olmalarına rağmen buraların kendine ait kuralları varmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520136,
					"content": "Doğru. Yani kurtların Sarhoşlar Geçidi'nde olması çok sıra dışı bir olay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520137
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520137,
					"content": "Kurt demişken, Kurtlar Diyarı'ndan gelen bir kurt çocuk tanıyor olabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520138,
					"content": "Kim? Mondstadt'ta böyle biri olduğunu hiç duymadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520139
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520139,
					"content": "Iı... Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520140,
					"content": "\"Kırmızılı, alevli kız...\" Sen değil misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520141,
					"content": "Alevli mi? Ne diyorsun sen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520142
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520142,
					"content": "Her neyse, ben konuyu araştırmak için Sarhoşlar Geçidi'ne gidiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520143
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520143,
					"content": "Benimle gelin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520131,
					"content": "Konu nedir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520132
					]
				}
			]
		},
