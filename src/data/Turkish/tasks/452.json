			"dialogs": [
				{
					"id": 4520201,
					"content": "Bakın, ileride! Bir şeyler oluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520202
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520202,
					"content": "Kurt sürüsü falan değil... Arabalara saldıranlar dağ yabanileriymiş gibi duruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520203,
					"content": "Hıh. Bu olayda pek de gizem falan yokmuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520204
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520204,
					"content": "Çok konuştuk. Gidip yardım edelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		},
		{
