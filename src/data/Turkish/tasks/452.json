					"Siegfria"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4520301,
					"content": "Çok teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520302
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 4520302,
					"content": "Çocuk oyuncağıydı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4520303,
					"content": "Demek dağ yabanileri kurt korkusundan faydalanarak güç göstermeye başladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520304
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520304,
					"content": "Evet. Söylemeden geçemeyeceğim, Dağ Yabanilerini fena sanırsınız ama kurtlar onlardan da beter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520305
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 4520305,
					"content": "Bu... Bu sabah Pınarköy'e saldırdılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520306
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 4520306,
					"content": "Pınarköy'e mi? Delilik bu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520307
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520307,
					"content": "Duyulmuş şey değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520308
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 4520308,
					"content": "Kurtların eğlencesi bitince şansımı deneyip yola çıkabilirim diye düşünmüştüm... Dağ Yabanilerinin de ortaya çıkacağı hiç aklıma gelmezdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520309
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 4520309,
					"content": "Hemen oraya gidip durum ne kadar kötüymüş öğrenmemiz gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520310
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520310,
					"content": "Ama her şeyden önce arabandaki hasarı incelemen gerekiyor. Hâlâ çalışıyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520311
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4520311,
					"content": "Bir bakayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Siegfria"
				}
			]
		},
