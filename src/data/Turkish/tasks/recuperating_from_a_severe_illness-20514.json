				},
				{
					"id": 205140504,
					"content": "Ayrıca beni nasıl buldun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140505
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140505,
					"content": "Tabii ya. Bay Cyrus söylemiştir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140506
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140506,
					"content": "Bana ve abime hep göz kulak oldu. Ben de geçerken selam verdim. O da şaşırmış gibiydi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140507
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140507,
					"content": "Maceracılar Loncasına katılmayı deneyip Maceracı mı olsam acaba? Güzel olabilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140508
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140508,
					"content": "Ne? Abim beni mi arıyormuş? Hım. Epey zaman oldu değil mi? Hiç farkına varmadım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140509
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140509,
