					"nextDialogs": [
						205140402
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 205140402,
					"content": "Bir kız gördün mü?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140403
					]
				},
				{
					"id": 205140403,
					"content": "Kız mı? Anna'yı mı diyorsun? Evet, gördüm. Şuradaki yel değirmenine gidiyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140404
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 205140404,
					"content": "Ben de anlayamadım. Hasta sanıyordum. Nasıl o kadar enerjik olabiliyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140405
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 205140405,
					"content": "Selam verdi, sonra koşarak gitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140406
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 205140406,
					"content": "Ah şu çocuk... İyileşeli daha kaç gün oldu biliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
