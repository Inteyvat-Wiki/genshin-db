			"dialogs": [
				{
					"id": 205140201,
					"content": "O kadar yukarıdayım ki! Abim beni burada asla bulamaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140202
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140202,
					"content": "Ne yapıyorsun burada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140203
					]
				},
				{
					"id": 205140203,
					"content": "Ne? Nasıl çıktın buraya? Geldiğini duymadım bile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140204
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140204,
					"content": "Dur bir dakika. Beni nasıl buldun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140205
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140205,
					"content": "Ben mi? Tırmandım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140206
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140206,
					"content": "Abim beni mi arıyormuş? Ah. Epey zaman oldu değil mi? Farkına varmadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140207
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205140207,
					"content": "Tamamdır. Az sonra dönerim. Bırak biraz daha burada durayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
			]
		},
