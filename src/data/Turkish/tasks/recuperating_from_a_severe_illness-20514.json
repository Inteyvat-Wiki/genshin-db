				{
					"id": 205140301,
					"content": "Anna'yı buldun mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140302
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140302,
					"content": "Yel değirmeninin tepesinde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140303
					]
				},
				{
					"id": 205140303,
					"content": "Yel değirmeni mi? Nasıl çıkmış o kız oraya? Hemen Favonius Şövalyelerini çağırıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140304
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140304,
					"content": "Az sonra döneceğini söyledi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140305
					]
				},
				{
					"id": 205140305,
					"content": "Öyle mi? Neyse, önemli olan iyi olması. Bir an çok korkuttun beni! Yel değirmeninin tepesinde mahsur kaldı sandım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140306
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140306,
					"content": "Teşekkür ederim. Gidip bir bakayım ona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140307
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205140307,
					"content": "Daha yeni iyileşmişken oralara gidilir mi? Ben ona gösteririm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		},
