			"dialogs": [
				{
					"id": 3770201,
					"content": "Geldiniz demek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770202
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3770202,
					"content": "#Bir dakika, sen... {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770203,
						3770204
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770203,
					"content": "... Jean, sen misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770205
					]
				},
				{
					"id": 3770205,
					"content": "Öncelikle, birkaç kişiyle temasa geçtim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770206
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770206,
					"content": "İkinci olarak, kendisi burada \"Jean\" olarak bulunuyor, Büyük Kumandan Vekili olarak değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770207
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770207,
					"content": "Asla göremeyeceğin bir Jean yani, bir Fahri Şövalye olarak bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770208
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770208,
					"content": "Ne sürpriz ama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770209
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770209,
					"content": "Kutsal Lir olayını duydum, ama senden şüphelenmek hiç aklıma gelmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770210
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770210,
					"content": "Demek Kutsal Lirin sesi Fırtına Dehşeti'ni arındırıp normale döndürebilir, doğru mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770211
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770211,
					"content": "#Evet! {NICKNAME} bu Fırtına Dehşeti meselesini çözebilmek için kendisini öne atıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770212
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3770212,
					"content": "Favonius Şövalyelerinin yıldızından söz ediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770213
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3770213,
					"content": "Yine de bana kanunları çiğniyormuşuz gibi geliyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3770214,
					"content": "Bu kadar saçma bir açıklamaya inanması epey zor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770215
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770215,
					"content": "Ancak, ikna edebilmesi için ozandan şarkıyı tekrar çalmasını isteyebiliriz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770216
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770216,
					"content": "Sana inanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770217
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770217,
					"content": "Bizim inatçı komutanı ikna etmek... Bir dakika, ne dedin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770218
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770218,
					"content": "Dvalin'in ihaneti için herhangi bir neden bulamıyorum, özellikle de bir zamanlar Dört Rüzgardan biri olduğu düşünülünce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770219
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770219,
					"content": "Ancak, onca yıl önce Mondstadt uğruna yapılan savaşta zehirlendiyse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770220
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770220,
					"content": "Ve uyandıktan sonra Hiçlik Büyücüsü tarafından yozlaşmaya mahkum edildiyse, aslında onu suçlayamayız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770221
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770221,
					"content": "Ama Büyük Kumandan Vekili olarak böyle bir açıklamayı beyan etmem mümkün değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770222
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770222,
					"content": "Fatui'den gelen diplomatik baskı, Fırtına Dehşeti meselesine barışçıl bir çözüm bulmamızı zorlaştırıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770223
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770223,
					"content": "İnsanlar durumun kontrolünü kaybettiğimi düşünür. Bu nedenle bunu yalnızca gizlice yapabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770224
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770224,
					"content": "Peh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770225
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770225,
					"content": "Favonius Şövalyelerinden hoşlanmayışımın bir nedeni de bu işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770226
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770226,
					"content": "Bir yabancıya bu kadar kolay inanabilmen beni hayrete düşürüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770227
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770227,
					"content": "Benim tedbirli ve titiz <color=#00E1FFFF>amirim</color>, siz bile ona güveniyorsunuz. Değil mi efendim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770228
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770228,
					"content": "Bana efendim dememeni kaç defa söyleyeceğim... Neyse, boş ver. Her zaman birlikte çalışmıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770229,
						3770230
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770229,
					"content": "Efendim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770231
					]
				},
				{
					"id": 3770231,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770232
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770232,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770233
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770233,
					"content": "Vay canına! Bu... Gerçekten çok tuhaf...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3770234,
					"content": "Göklerin Kutsal Lirinin nerede olduğuyla ilgili kabaca bir fikrim var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770235
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770235,
					"content": "(İyi kurtardı! Konuyu değiştirmekte cidden başarılı...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770236
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3770236,
					"content": "Mondstadt ile Snezhnaya arasındaki çatışma, yedi ulus ve bu ulusların tanrıları arasındaki çatışmaya dayanıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770237
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770237,
					"content": "Buz Tanrısı'nın emrindeki Fatui, Rüzgar Tanrısı'nın gücünün peşinde olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770238
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770238,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770239,
						3770240
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3770239,
					"content": "Yani, Mondstadt'ın savunmasını üstlenecekler, öyle mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770241
					]
				},
				{
					"id": 3770241,
					"content": "Doğru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770242
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770242,
					"content": "Favonius Şövalyeleri Dvalin'e karşı girişilen bir suikastı önlediyse, o halde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770243
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770243,
					"content": "Rüzgar Tanrısı'nı etkilemenin tek bir yolu daha var, o da Kutsal Liri almak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770244
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770244,
					"content": "Mondstadt'a gelen o kadar fazla Fatui var ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770245
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770245,
					"content": "Onlarla ilgili... Birkaç rapor derlemeyi başardım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770246
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770246,
					"content": "Diluc, Kutsal Lirin Goth Grand Otelde saklanmadığını tespit etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770247
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770247,
					"content": "Sanırım çalınmış bir şeyi, kolayca bulunabileceği bir yerde tutmak istemiyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770248
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3770248,
					"content": "Paimon çaktı köfteyi. Eğer fazla gürültü çıkarsa, bu büyük bir diplomatik soruna neden olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770249
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3770249,
					"content": "Hım, işte yedi ulusun arasındaki diplomasi böyledir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3770250
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770250,
					"content": "Yabancı, gitmeye hazır mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3770240,
					"content": "Yani Dvalin'i öldürmek istiyorlar, öyle mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770241
					]
				},
				{
					"id": 3770230,
					"content": "(Hiçbir şey duymamış gibi yap)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770231
					]
				},
				{
					"id": 3770204,
					"content": "Neden Büyük Kumandan Vekili de geldi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3770205
					]
				}
			]
		},
