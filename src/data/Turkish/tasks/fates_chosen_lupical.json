			"dialogs": [
				{
					"id": 4540301,
					"content": "Döndük! Bu yeterli mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540302,
					"content": "Evet. Yeterli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540303
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540303,
					"content": "Razor tam da bana kurtların yasalarını anlatıyordu. Cidden akılalmaz şeyler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540304
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540304,
					"content": "Sağ olun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540305
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540305,
					"content": "Her yere baktık ama başka kurt göremedik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540307
					],
					"speakerTitle": "Muhteşem Hopkins"
				},
				{
					"id": 4540307,
					"content": "Evet, al sana kurt işte. Yakalamayı başardığımız kurt da hasta falandı herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540308
					],
					"speakerTitle": "Jotun"
				},
				{
					"id": 4540308,
					"content": "Ne işin var burada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540309
					],
					"speakerTitle": "Muhteşem Hopkins"
				},
				{
					"id": 4540309,
					"content": "İntikam almaya geldim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540310
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4540310,
					"content": "Bu o çocuk! Kurtların büyüttüğü çocuk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540311
					],
					"speakerTitle": "Jotun"
				},
				{
					"id": 4540311,
					"content": "Ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540312
					],
					"speakerTitle": "Muhteşem Hopkins"
				},
				{
					"id": 4540312,
					"content": "Sendin demek. Tahmin etmeliydim, kurtlar bunu yapacak kadar zeki değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540313
					],
					"speakerTitle": "Muhteşem Hopkins"
				},
				{
					"id": 4540313,
					"content": "İnsanlara tuzak kuran kurtlara yardım ettiğine inanamıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540314
					],
					"speakerTitle": "Muhteşem Hopkins"
				},
				{
					"id": 4540314,
					"content": "Önüne biraz kemik attılar diye onların soyundan gibi mi davranıyorsun? Kim olduğunu unuttun mu yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540315
					],
					"speakerTitle": "Muhteşem Hopkins"
				},
				{
					"id": 4540315,
					"content": "Yeter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540316
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4540316,
					"content": "Evet! Razor'la bu şekilde konuşamazsınız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4540317,
					"content": "Favonius Şövalyeleri bu adamın suçunu bağışlayacak mı yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4540318
					],
					"speakerTitle": "Jotun"
				},
				{
					"id": 4540318,
					"content": "Köye biz saldırmadık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Razor"
				}
			]
		},
