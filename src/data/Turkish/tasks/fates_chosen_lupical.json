			},
			"dialogs": [
				{
					"id": 4541501,
					"content": "Nereye geldik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4541502,
					"content": "#{NICKNAME}, bana yardım et. Bunları topla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541503
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541503,
					"content": "Bunlar kurt çengeli tohumu değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4541504,
					"content": "Onları ez. Yaranın üzerine koy. Kanamayı durdur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541505
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541505,
					"content": "Doğru söylüyor. Kurt çengeli tohumlarının hem hafif bir ağrı kesici görevi gören hem de kan durdurucu etki yaratan sıvı bir tabakası vardır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541506
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541506,
					"content": "... Bir kitapta okumuştum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541507
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541507,
					"content": "Neden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4541508,
					"content": "... Hiçbir fikrim yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541509
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541509,
					"content": "Dikenler sayesinde tohumlar hareket eder. Sıvı da acıyı ve kanamayı durdurur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541510
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541510,
					"content": "Hayvan dikenleri hissetmez, tohumları uzağa taşır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541511
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541511,
					"content": "... Morlu öğretmen öyle demişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541512
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541512,
					"content": "Ben burada kalıp bununla ilgileneyim. Kırmızılı kızın sorularını cevaplayayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541513
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4541513,
					"content": "Tamam. O grup geri dönerse de Favonius Şövalyelerinin bir üyesi karşısında şanslarını deneyeceklerini hiç sanmam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4541514
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4541514,
					"content": "#Kurt dostun şüphelerden henüz aklanmış değil. Yine de o tohumları alıp getirmemiz lazım {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		}
	]
