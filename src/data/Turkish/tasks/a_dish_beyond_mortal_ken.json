			},
			"dialogs": [
				{
					"id": 718291401,
					"content": "Tadına bir bakayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291402
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 718291402,
					"content": "Mmmm... Enfes ve yoğun bir aroması var ama ağızda kıvamı tıpkı yumuşak tofu gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291403
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 718291403,
					"content": "Sunumu da gayet şık görünüyor, üstelik ince işçilik gerektiriyor. \"Sebze yemeği görünümlü et yemeği\" olarak tanıtmak da ilgi çekecektir. Denemek isteyen çok kişi olacağına eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291404
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 718291404,
					"content": "Fena değil! Hiç fena değil! Hancının da beğeneceğine şüphem yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291405
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 718291405,
					"content": "Gerçekten şaşırttın beni. Düşündüğümden daha becerikliymişsin, hakkını vermek lazım. Senin gibi bir otlakçının böyle bir tarifi hatırlayacağı kimin aklına gelirdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291406
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 718291406,
					"content": "Hahaha, madem öyle bir itirafta bulunayım. Bu tarifi ilk öğrendiğimde gizli bir kılıç sanatının anlatıldığını sanıp gece gündüz tarifi anlamaya çalışmıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291407
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291407,
					"content": "Şimdi düşünüyorum da aklımı ekmek peynirle yemişim herhalde. Bildiğin yemek tarifi işte, içinde neden kılıç sanatıyla ilgili bir şeyler olsun ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291408
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291408,
					"content": "Neden kılıç sanatıyla ilgileniyordun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718291409
					]
				},
				{
					"id": 718291409,
					"content": "Adaleti sağlamak adına bulmam gereken biri vardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291410
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291410,
					"content": "Aha! Büyük bir olaydı o! Ne kadar sakin bahsettin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291411
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 718291411,
					"content": "Hahaha. Adalet yerini bulduktan sonra buraya geldim zaten. Sağ olsun hancı beni aldı ve buralarda aylak aylak dolaşmama hiç laf etmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291412
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291412,
					"content": "Artık arzularımdan arındım. Kılıç kullanmaya hevesim kalmadı, ondan başka bir yeteneğim de yok zaten. Hahaha, hayatımın geri kalanını burada geçirme fikri hiç fena gelmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291413
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291413,
					"content": "Neyse, sana da bu tarifin bir kopyasını vereyim. Zamanın olduğunda kendine yaparsın. Biraz uğraştırıyor ama tadı harika.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291414,
						718291415
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291414,
					"content": "Sağ ol.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718291417
					]
				},
				{
					"id": 718291417,
					"content": "Hımm... Şu tabağı ayıralım. Hancı gelince gösteririz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291418
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 718291418,
					"content": "Ondan sonra da... Hop, nereye gidiyorsun beleşçi efendi, buraya gel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291419
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 718291419,
					"content": "Ne oldu? Vereceğim başka bir tarif kalmadı cidden, söyleyeyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291420
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291420,
					"content": "Kılıç kullanmaktan başka yeteneğim yok dememiş miydin? Tamam işte, çıkar kılıcını. Et doğramayı öğreteceğim sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291421
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 718291421,
