			"dialogs": [
				{
					"id": 718291201,
					"content": "Şimdi ocağın altını yak ve et ezmesini ağır ateşte pişir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291202
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291202,
					"content": "Ateşi iyi kontrol etmen lazım. Fazla kısık olursa et iyi pişmez. Yüksek ateşte pişirirsen de ezme dağılıp kıvamını kaybeder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718291203
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718291203,
					"content": "Eti özel hazırlanmış bir suda ağır ateşte pişiriyoruz demek... Bu yemek hiç bütçe dostu değilmiş ha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Güleç Yanxiao"
				}
			]
		},
