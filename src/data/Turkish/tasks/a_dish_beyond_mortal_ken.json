			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangxue"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718290301,
					"content": "Oo, bugün özel bir konuğumuz varmış. Genelde yemeğimizi şefle baş başa sessizlik içinde yiyoruz. Belki bugün sen geldin diye ortam biraz olsun canlanır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290302
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290302,
					"content": "Bugün şefin bir derdi var sanırım. Suratı beş karış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangxue"
				}
			]
		},
		{
			"id": 7182904,
			"completionStepIds": [
				7182903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182903",
							"2"
						],
						"stepId": 7182903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jiangxue",
					"Güleç Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718290401,
					"content": "Köftelerin tadı gayet güzel, et ağzımın içinde eriyor resmen. Suyunun aroması da pek bir lezzetli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290402
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290402,
					"content": "Oo, etin içinde yengeç yumurtası varmış. Demek ki tadı o yüzden değişik geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290403
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290403,
					"content": "Bir tane daha ye Gezgin. Nasıl yapacağını göstereyim bak. Önce çubuklarınla köfteyi böl, sonra suyuna bandırıp pilavla beraber ye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290404,
						718290405,
						718290407
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290404,
					"content": "Çok naziksin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290409
					]
				},
				{
					"id": 718290409,
					"content": "Yemeğin tadını çıkarın... Burada pişirdiğim son yemek bu olabilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290410
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 718290410,
					"content": "Burada pişirdiğin son yemek mi? Kim söyledi bunu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290411
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290411,
					"content": "Eyvah, benim yüzümden mi yoksa? Hancı bana sürekli yemek verdiğin için kızdı mı sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290412
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290412,
					"content": "Haksızlık ama bu. Yakaladığım en iyi balıkları hana getirip karşılığında ücret bile istememiştim. Hesabımın bir kısmını karşılaması gerekirdi. Hancı böyle cimri biri de değildi aslında...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290413
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290413,
					"content": "Hadi oradan. Birkaç tane balık getirmiştin, çoğu da senin midene girdi zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290414
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 718290414,
					"content": "Yani diyorsun ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290415
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290415,
					"content": "*iç çeker* Neyse tamam, anlatayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290416
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 718290416,
					"content": "Sunumu güzel, lezzetli, şık, sanatsal ve kendine has bir yemek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290417
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290417,
					"content": "Hahaha, hancının isteklerini karşılayacak bir yemeğin bu dünyada var olduğunu sanmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290418
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290418,
					"content": "Çok mu komik geldi? Bir dahaki gelişinde beleş yemek bulamayınca bakalım böyle gülebilecek misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290419
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 718290419,
					"content": "Tamam, tamam, komik değil biliyorum. Demek o yüzden bu kadar gerginsin bugün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290420
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290420,
					"content": "Patronun senden mucize beklerken keyifli olmak pek mümkün değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290421
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 718290421,
					"content": "Hımm, bunun bir çözümü olabilir. Ben kendim yemek yapamıyorum fakat elimde eşsiz bir yemek tarifi var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290422
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290422,
					"content": "Seyahatlerimden birinde nüfuzlu birinin evine misafir olarak gitmiştim. Bahsettiğim yemeği de o zaman öğrendim. İsmi Tavuklu Yumuşak Tofu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290423
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290423,
					"content": "Dışarıdan bakınca et yemeğiymiş gibi durmuyor. Yumuşak tofu gibi hafif, ama oldukça yoğun bir et ve baharat tadı var. Sebze yemeğini andıran nadir et yemeklerinden biri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290424
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290424,
					"content": "Tadına bakınca o kadar ilgimi çekti ki ev sahibinden tarifini istedim. Ne yazık ki ben yemek yapmayı beceremiyorum... Bu yüzden tarif o zamandan beri sandığımda toz topluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290425,
						718290428
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290425,
					"content": "Eline böyle bir tarif geçmesine şaşırdım doğrusu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290426
					]
				},
				{
					"id": 718290426,
					"content": "Şey... Uzun lafın kısası ben birine yardım ettim, o da teşekkür etmek için beni yemeğe çağırdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290427
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290427,
					"content": "Şef de sağ olsun tarifi benimle paylaştı. Zaten böyle bir yemeği yapabilecek beceriye sahip çok az insan olduğuna emindi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290429
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290429,
					"content": "Tabii. Şefin dediğine göre bu yemeği yapmaya çalışan kişinin hem yemek sanatında hem de kılıç sanatında usta olması gerekirmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290430
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290430,
					"content": "Nasıl yani? Ne tür bir yemek için kılıç kullanmak gerekir ki? Etleri kendi bıçağımla gayet güzel doğrayabiliyorum ben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290431
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 718290431,
					"content": "Kusura bakma da sen o bıçakla eti ince ince kıyana kadar doğrama tahtasını ikiye bölersin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290432
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290432,
					"content": "Bana bu yemeğin en önemli kısmının iyi kıyılmış et olduğu söylendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290433
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290433,
					"content": "O yüzden kılıç tekniğinin kusursuz olması gerekiyormuş. Önce eti kılıçla bölüp doğruyorsun. Sonra da kılıcın sırtıyla eti kıyıyorsun. Ondan sonra da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290434
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290434,
					"content": "Dur bir saniye... Bu tarif bizim hiçbir işimize yaramayacak ki. Ben kılıç kullanamıyorum, sen de yemek yapamıyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290435
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 718290435,
					"content": "Güzel yemek yapabilen ve kılıç kullanan bir savaşçıyı nereden bulacağız peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290436
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 718290436,
					"content": "Aradığımız kişi... Tahmin ettiğinden daha yakın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290437,
						718290439
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290437,
					"content": "Be-Ben mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290438
					]
				},
				{
					"id": 718290438,
					"content": "Aynen öyle. Hem kılıcı hem de ocağı iyi kullanabilmen kaderin bir cilvesi değil mi sence de?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290441
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290441,
					"content": "Bırakalım da Gezgin şu eşsiz yemeği yapmayı bir denesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290442
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290442,
					"content": "Ama hancı yemeği Yanxiao'nun yapmasını...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290443
					]
				},
				{
					"id": 718290443,
					"content": "Hancı, Yanxiao'ya yalnızca yeni bir tarif bulmasını söylemiş. Yemeği kimin pişirmesi gerektiğini belirtmemiş, dolayısıyla o kısmı tartışmaya açık bence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290444
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290444,
					"content": "Haksız mıyım şef?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290445
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290445,
					"content": "Ha... Evet! Doğru diyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290446
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 718290446,
					"content": "Tavuklu Yumuşak Tofu yapmak için hangi malzemeler gerekiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290447
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 718290447,
					"content": "Kuş Eti, Jambon, Kuş Yumurtası ve Aslanağzı lazım. Hepsi gayet kolay bulunabilecek malzemeler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290448
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290448,
					"content": "Mutfakta Kuş Eti ve Jambon var... Ama Kuş Yumurtası ve Aslanağzı yeni bitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290449
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 718290449,
					"content": "Daha önce bilseydim Matsutakeli Omlete harcamazdım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290450
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 718290450,
					"content": "Gezgin, bana bu malzemelerden birer tane getirebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290451
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 718290451,
					"content": "Getirdiğinde Tavuklu Yumuşak Tofuyu beraber yaparız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290452
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 718290452,
					"content": "Şey... Yardımının karşılığını da alacaksın tabii. Şimdiden sağ ol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 718290439,
					"content": "Yemek yapmaktan anlıyorum, orası doğru...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290440
					]
				},
				{
					"id": 718290440,
					"content": "Aynı zamanda kılıçta da yetenekli değil misin? Yapabildiklerini kendi gözlerimle gördüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290441
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290428,
					"content": "Yapması çok zor bir yemek o zaman...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290429
					]
				},
				{
					"id": 718290405,
					"content": "Vay be, işin uzmanı olmuşsun...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290406
					]
				},
				{
					"id": 718290406,
					"content": "Hahaha, her gün böyle lezzetli yemekler yiyince insan bir şeyler öğreniyor haliyle. Bak bu balık yahnisi nasıl yenilir hemen göstereyim sana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290409
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 718290407,
					"content": "Sen bizimle yemeyecek misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718290408
					]
				},
				{
					"id": 718290408,
					"content": "Ben mi? Hancı sağ olsun karnımı stresle doyurdum ben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290409
					],
					"speakerTitle": "Güleç Yanxiao"
				}
			]
		},
