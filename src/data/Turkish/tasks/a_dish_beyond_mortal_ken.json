						718290704
					]
				},
				{
					"id": 718290704,
					"content": "Şey... Belki beleşçi dostumuz bizi biraz yönlendirebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718290705
					],
