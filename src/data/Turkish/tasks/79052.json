			"dialogs": [
				{
					"id": 790520201,
					"content": "Rayları biraz daha eğimli yapsaydık daha heyecan verici olurdu herhalde. Havadaki dönme açısı bu işin tuzu biberi... *öksürür*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520202
					],
					"speakerTitle": "Haddo"
				},
				{
					"id": 790520202,
					"content": "Aa, Haddo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790520203,
					"content": "Siz miydiniz... *öksürür* Veluriyam Serabı'nda günleriniz nasıl geçiyor bakalım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520204,
						790520205
					],
					"speakerTitle": "Haddo"
				},
				{
					"id": 790520204,
					"content": "Çok eğlendik!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790520206
					]
				},
				{
					"id": 790520206,
					"content": "Ne güzel... *öksürür* İyi vakit geçirmenize sevindim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520208
					],
					"speakerTitle": "Haddo"
				},
				{
					"id": 790520208,
					"content": "Bu arada... *öksürür* Bu minik test vagonlarından birini denemek ister misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520209
					],
					"speakerTitle": "Haddo"
				},
				{
					"id": 790520209,
					"content": "Test mi? Vagonları test etmek gerekiyor mu gerçekten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790520210,
					"content": "Evet. Arkamdaki alanı görüyor musunuz? İşte Çuf Çuf Vagonlar orada test ediliyor. Hehe, Dalga Kasırgasını hatırlıyor musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520211
					],
					"speakerTitle": "Haddo"
				},
				{
					"id": 790520211,
					"content": "İşte ray hattı burada başladı... *öksürür* Ön Baskı ve Akış Yansıtıcı da olsa düzgün tasarlanmış bir yol, sürecin tamamında büyük önem taşır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520212
					],
					"speakerTitle": "Haddo"
				},
				{
					"id": 790520212,
					"content": "İşte bu yüzden rayları önceden tasarlamak, test etmek ve ileride yapılacaklar için geri bildirim almak önemlidir. Şimdilik... Jeroney'nin deyişiyle \"aşırı uyarıcı\" kaçıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520213
					],
					"speakerTitle": "Haddo"
				},
				{
					"id": 790520213,
					"content": "Küçük vagonlara ayrılan test alanında eğim testi için üç ray bulunuyor. *öksürür* Çuf Çuf Vagonlar bu rayların üstünde biraz daha hızlı gidebiliyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520214
					],
					"speakerTitle": "Haddo"
				},
				{
					"id": 790520214,
					"content": "Adları ise... *öksürür* \"Eh, İdare Eder Rayı\", \"Feleğim Şaşmak Üzere Rayı\" ve \"Yavaşla Kaptan, İnecek Var Rayı\". Merak ettiyseniz söyleyeyim, bu isimleri Ferdinand buldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520215
					],
					"speakerTitle": "Haddo"
				},
				{
					"id": 790520215,
					"content": "Aa, Ferdinand nasıl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790520216,
					"content": "İyi. Sadece biraz... Temiz hava almaya ihtiyacı var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520217
					],
					"speakerTitle": "Haddo"
				},
				{
					"id": 790520217,
					"content": "Neyse, üçü de dışarıdaki raylardan... *öksürür* Üç test hattı da dışarıdaki raylardan daha hızlı, o yüzden \"Eh, İdare Eder Rayı\" ile başlamanızı tavsiye ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520218
					],
					"speakerTitle": "Haddo"
				},
				{
					"id": 790520218,
					"content": "Ee, ne diyorsun? Var mısın denemeye?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520219,
						790520220
					],
					"speakerTitle": "Haddo"
				},
				{
					"id": 790520219,
					"content": "Hadi başlayalım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790520221
					]
				},
				{
					"id": 790520221,
					"content": "Koca yürekli seni! Gidip üç test hattından sorumlu olan Su Tayfını bul o zaman. Testi senin için etkinleştirmekten mutluluk duyacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Haddo"
				},
				{
					"id": 790520220,
					"content": "Maalesef, başka işlerimiz var...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790520222
					]
				},
				{
					"id": 790520222,
					"content": "Acele etmene gerek yok. Üç test hattından sorumlu olan Su Tayfı hep orada durur. Vaktin olursa gel, bekleriz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Haddo"
				},
				{
					"id": 790520205,
					"content": "Öksürüğün ne durumda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790520207
					]
				},
				{
					"id": 790520207,
					"content": "*öksürür* Daha iyiye gitmesini beklemiyorum açıkçası. Zaten bir önemi yok, öksürüğüm ray tasarlama tutkumun önüne geçemez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790520208
					],
					"speakerTitle": "Haddo"
				}
			]
		}
	]
}