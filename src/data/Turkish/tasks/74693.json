			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Barbeloth"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746930101,
					"content": "Bana bu kart deseninin bir kopyasını çıkaramayacağına emin misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930102
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930102,
					"content": "Kesinlikle eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930103
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930103,
					"content": "Gerçekten çok etkileyici. Belki bir anlaşmaya varabiliriz, ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930104
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930104,
					"content": "Kesinlikle olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930105
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930105,
					"content": "Hımm, peki. Güzel kart desenleri elde etmenin de güçlü kartlarla oynamanın da belirli bir bedeli var. Anladım sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930106,
						746930107,
						746930108
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930106,
					"content": "Anladığını sanmıyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930109
					]
				},
				{
					"id": 746930109,
					"content": "Hey! Cyno'nun neden burada olduğunu bilmiyorsun! Belki de buraya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746930110,
					"content": "Aynen öyle. İnsan dostunu ne kadar iyi tanıyor işte, resmen aynı frekanstayız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930111
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930111,
					"content": "Ciddi misin ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746930112,
					"content": "Fontaine'de kart oyuncuları için küçük bir buluşma düzenleniyor. Duyduğuma göre katılımcılara ücretsiz olarak etkinliğe özel kartlıklar verilecekmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930113
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930113,
					"content": "Akademide acil bir işim olmadığı için ben de geleyim dedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930114
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930114,
					"content": "Acil işlerin olsaydı bile Paimon'un içinden bir ses, bir yolunu bulup onları... O kadar da acil olmayan bir hale getirirdin diyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746930115,
					"content": "Haklısın! Sadece iki hafta fazla mesai yaparak işimin neredeyse tamamını bitirmeyi başardım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930116
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930116,
					"content": "Sethos da yardım etti, ben de ona bu zahmetine karşılık bir kartlık getireceğime söz verdim. Evrak işlerinde çok iyidir bu arada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930117
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930117,
					"content": "Söyle bakalım General Mahamatra, kart çekecek misin, çekmeyecek misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930118
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930118,
					"content": "Çekeceğim tabii. Bu kart geleceğimi gösterecek diyorsun, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930119
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930119,
					"content": "Teknik olarak tam öyle sayılmaz. Ama öyle anlamak istersen de pek bir sıkıntı çıkacağını sanmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930120
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930120,
					"content": "Hım, anladım. Yani \"Düello Ustası\"ndaki şu meşhur replik gibi mi? \"Kaderini, çekeceğin bir sonraki karta bağla\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930121
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930121,
					"content": "Şimdi kart çekme sırası bende!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930122
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930122,
					"content": "Cyno derin bir nefes alır, havalı bir poz verir ve bir kart çeker...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						746930123
					]
				},
				{
					"id": 746930123,
					"content": "Ters Denge. Sumeru Akademisinin \"General Mahamatra\"sı için uygun bir kart.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930124
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930124,
					"content": "Cyno'yu tanıyor muydun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930125
					]
				},
				{
					"id": 746930125,
					"content": "Alice birkaç kere bahsetmişti. O sıkıcı ve eski kafalı Akademinin, espri anlayışı bu kadar \"gelişmiş\" bir General Mahamatra'sı olmasını komik buluyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930126
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930126,
					"content": "Lütfen iltifatı için kendisine teşekkürlerimi ilet. Kartı çektiğime göre şimdi ne yapıyorum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930127
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930127,
					"content": "Bu kart ters Denge, daha doğrusu ters \"Sanatkarlık\" olduğu için şimdilik hiçbir şey yapmamanı öneririm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930128
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930128,
					"content": "Aceleci davranmışsın ve kaderin dar köprüsünde neredeyse dengeni kaybediyormuşsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930129
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930129,
					"content": "Çok fazla kart oynadığım için, değil mi? Sethos ve Tighnari de aynı şeyi söyledi. Programımı düzenledim zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930130
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930130,
					"content": "... Ben kart oynamaktan bahsetmiyorum. Çalışma saatlerini kastediyorum. General Mahamatra'nın dikkatini vermesi gereken tek şey Dehanın Yakarışı olamaz, öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930131
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930131,
					"content": "Görevlerimde değişiklik yapma fırsatım pek olmuyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930132
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930132,
					"content": "Bu kadar yoğun bir programın stresini tek başına sırtlanmaya alıştın mı yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930133
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930133,
					"content": "Başka Matralar da var. İş yükünü aramızda bölüşüyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930134
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930134,
					"content": "Ama sonuçta hepsi sana bel bağlamıyor mu? Sadece Matralar da değil üstelik, araştırmacılar ve Sumeru halkı da... Sana inanan öyle çok insan var ki General Mahamatra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930135
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930135,
					"content": "Bunu sana hiç söylemezler, belki kendileri bile farkında değillerdir... Senin o durdurulamaz zekanın büyüsüne bu kadar kapılmışken niye söylesinler ki zaten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930136
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930136,
					"content": "Ama gece gündüz üzerinde dolaşan o bakışları hissedebiliyorsun... Tabii bir de yanından hiç ayrılmayan o gölge var. O da omuzlarındaki başka bir yük.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930137
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930137,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930138
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930138,
					"content": "Hep liderlik etmeye, başkalarının yükünü sırtlamaya alışmışsın... Belki de içindeki dengesizliğin nedeni budur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930139
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930139,
					"content": "Benim bir sürü arkadaşım var. İçlerinden biri de \"yakarış\" adıyla bilinen bir \"deha\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930140
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930140,
					"content": "Dinlenmeye hiç niyetin yok anlaşılan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930141
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930141,
					"content": "Durup dinlenecek vakit yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930142
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930142,
					"content": "Öyle gerçekten de. Senin gibi birinin içindeki savaş dinmek bilmiyorsa ölüm bile bu görevi sonlandırmaya yetmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930143
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930143,
					"content": "Bu Ay Arkanasını al. Belki de içindeki dengeyi yeniden kurmanı sağlayacak o sebebi bulmanda sana rehberlik eder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930144
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930144,
					"content": "Bulduğunda, kendi içinde verdiğin savaş da nihayete erecektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930145,
						746930146
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930145,
					"content": "Cyno asla kaybetmez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930147
					]
				},
				{
					"id": 746930147,
					"content": "#{NICKNAME}, Paimon, sağ olun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930148
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930148,
					"content": "Sana da teşekkür ederim. Merak etmeyin, saçma sapan davranmaya başlamayacağıma söz veriyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930149
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930149,
					"content": "... Hı? İyi de niye... Bir dakika, yoksa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930150,
						746930151,
						746930152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746930150,
					"content": "Eyvah, yine mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930153
					]
				},
				{
					"id": 746930153,
					"content": "... Bunun saçma sapan davranmakla ne alakası var şimdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930154
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746930154,
					"content": "Çünkü bu kartı çektiğime göre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930155
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930155,
					"content": "... Millet beni \"Denge\"siz ilan edebilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				},
				{
					"id": 746930151,
					"content": "Yine bulmuş bir tane.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930153
					]
				},
				{
					"id": 746930152,
					"content": "Barbeloth, sakın sorma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930153
					]
				},
				{
					"id": 746930146,
					"content": "Cyno'dan güçlüsü yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930147
					]
				},
				{
					"id": 746930107,
					"content": "Ben anlamadım ama...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930109
					]
				},
				{
					"id": 746930108,
					"content": "Bunca yolu kart oynamak için mi geldin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930109
					]
				}
			]
		},
