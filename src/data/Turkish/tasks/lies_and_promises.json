			"dialogs": [
				{
					"id": 750220703,
					"content": "Yumkazor önündeki yiyeceği saniyede mideye indiriyor.\\nOnun yiyeceği nasıl yuttuğunu göremiyorsun bile...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750220304,
					"content": "Y-Yiyeceğe bak... Yok oluyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220305,
						750220307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220305,
					"content": "Paimon, sana rakip çıktı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220306
					]
				},
				{
					"id": 750220307,
					"content": "Bir porsiyon... Yetmeyecek sanırım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220308
					]
				},
				{
					"id": 750220306,
					"content": "Hey, ne demeye çalışıyorsun? Paimon gerçek bir gurmedir, sonradan gurme değil. Yemek konusunda oldukça seçicidir ve yemeklerini asla böyle hapır hupur yemez... Her şeyi tek seferde mideye indirirsen yemeğin tadını nasıl çıkarabilirsin ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220308,
					"content": "#E-Evet. Paimon tahmin edemedi, ama bu küçük arkadaş da tam bir \"Kocamidelizor\" çıktı... Neyse ki {REALNAME[ID(2)|SHOWHOST(true)]} o kadar çok yiyemiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220309,
					"content": "Belki de zavallı şey çok acıkmıştır! Yazık, bir porsiyon daha verelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220310,
					"content": "Arawrrr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220311
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220311,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} dostumuz da yemek yemek istiyor mu? Önce şu diğer Sürüngen dostumuzu besleyelim, sonra da sana lezzetli bir şeyler ayarlarız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220312,
					"content": "Aç Sürüngen önündeki her şeyi tek seferde mideye indiriyor.\\nSanki aynı sahne iki kez yaşanmış gibi göz kırpıyorsun...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750220313
					]
				},
				{
					"id": 750220313,
					"content": "Pekala, artık karnın doyar diye düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220314,
					"content": "Hey! Bir dakika, niye yine oturdun? İki porsiyon yetmedi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220315,
					"content": "Yok artık, yemeği yedikten sonra mağaranın önünde uyuyacak mı? Yoldan çekilmek zerre umurunda değil gibi görünüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220316,
					"content": "#Ne yapacağız {NICKNAME}? Paimon bu arkadaşı çözemedi... Yemekten sonra uyuyacaksan bile en azından yolu kapatma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220317,
						750220318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220317,
					"content": "Yoldan çekilmeye hiçbir zaman razı olduğunu düşünmüyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220319
					]
				},
				{
					"id": 750220318,
					"content": "Kandırılmış hissediyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220319
					]
				},
				{
					"id": 750220319,
					"content": "Ooooofff! Üstelik bir sürü yemeğimizi yedi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220320,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220321
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220321,
					"content": "#Bunu izlemeye {REALNAME[ID(2)|SHOWHOST(true)]} bile dayanamaz! Hadi {NICKNAME}, onu uyandırmayı denemeliyiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
