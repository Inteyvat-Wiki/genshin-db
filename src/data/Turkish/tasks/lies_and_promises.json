				},
				{
					"id": 750220406,
					"content": "Gerçekten uyuyor sanırım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220408
					]
				},
				{
					"id": 750220408,
					"content": "(Uyurken söylediği şeyleri açıklıyorsun...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220409
					]
				},
				{
					"id": 750220409,
					"content": "İnsanların yemeklerini almak için onları kandırdığını ve bilerek yolu kapattığını mı söylüyorsun? Of, resmen oyuna geldik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220410,
					"content": "Hıh! O halde ona iyi davranmamıza gerek yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220411,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} tünelden geçip sandığı alsın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220412
					],
					"speakerTitle": "Paimon"
				},
				{
