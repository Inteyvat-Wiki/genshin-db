				},
				{
					"id": 750220609,
					"content": "Burada tek başına yaşayan bir Sürüngen, görünürde sahibi falan da yok... Muhtemelen kendi yiyeceğini bile bulamıyordur...",
					"roleType": "TALK_ROLE_NPC",
