					"nextDialogs": [
						750220413
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220413,
					"content": "Hileli yolu seçecekse bizim de adil davranmamızı bekleyemez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
