					"nextDialogs": [
						750220612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220612,
					"content": "Ne versek acaba?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220613
					]
				},
				{
					"id": 750220613,
					"content": "Paimon biraz düşünsün. Buradaki Sürüngenler her şeyden azar azar yemeye alışkınlardır, ancak Paimon Yumkazorların ne yediğinden pek emin değil... Renklerine bakılırsa yaprak, çimen gibi şeyler yiyor olmalı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220614,
					"content": "O halde yaprak ya da çimen bulup bir deneyelim! Karnı açsa fazla seçici davranmaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
