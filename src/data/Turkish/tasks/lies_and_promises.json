						750220802
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220802,
					"content": "Hehe, işte bu kadar! Bakalım sandıkta ne gibi değerli eşyalar varmış!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220803,
					"content": "Ha? Hiçbir şey yok mu? Sadece bir not mu yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220804,
					"content": "Notu bırakan kişi Sürüngenin sahibi miymiş? Yani bizi Sürüngen değil, sahibi mi kandırmış?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220805,
						750220808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220805,
					"content": "Çok sorumsuzca.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220806
					]
				},
				{
					"id": 750220806,
					"content": "Evet! Çok hasta olsa bile Yumkazorunu böyle bir yerde nasıl bırakabilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220807,
					"content": "Ayrıca insanların hırsından faydalanmak istedi... Hayır, daha doğrusu insanların Sürüngenlere duyduğu sempatiden faydalanmak istedi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220810,
					"content": "*iç çeker* Burada öylece durup insanların yiyeceklerini almalarına izin veremeyiz. Hadi Gök Kubbenin Evlatlarının Şefini bulup durumu anlatalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750220811,
					"content": "Durumu Gök Kubbenin Evlatlarının şefi Wayna'ya açıklıyor ve onu mağaranın önüne getiriyorsun.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750220812
					]
				},
				{
					"id": 750220812,
					"content": "Aman tanrım, beni aramaya geldiğinizde içimde bununla ilgili bir his vardı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220813
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220813,
					"content": "Bu yaratığı arkasında bırakan kişinin o hergele olacağı kimin aklına gelirdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220814
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220814,
					"content": "Hergele mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220815
					]
				},
				{
					"id": 750220815,
					"content": "Raarr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220816
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750220816,
					"content": "Bir hata yaptı ve alacağı cezadan korktuğu için kendi arzusuyla kabileden ayrıldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220817
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220817,
					"content": "Fakat suçlunun adını açıklamak doğru olmaz. Belki de kötü bir şey yaptığının farkına varmıştır. Bak, mektuba adını bile yazmamış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220818
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220818,
					"content": "Demek Sürüngeni onunla birlikte hareket etmeyi tercih etti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220819
					]
				},
				{
					"id": 750220819,
					"content": "Hayır, \"tercih ettiğini\" söyleyemeyiz. Sürüngenler doğruyla yanlışı ayırt edemeyen basit yaratıklardır. Çoğu zaman duygularının peşinden gider ve yoldaşlarına güvenirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220820
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220820,
					"content": "... Tam tahmin ettiğim gibi, özünde hiç değişmemiş. Kuş kadar aklı var, onu da kendi Sürüngeni de dahil başkalarını kandırmak üzere türlü türlü oyunlar oynamaya harcıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220821
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220821,
					"content": "Bu Yumkazoru düzenli olarak beslemek için insan göndereceğiz. Ne de olsa kabilenin bir çocuğu sayılır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220822
					],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220822,
					"content": "O hergeleye gelirsek... *iç çeker* Trajik bir son gerçekten, ancak onun için üzülmüyorum. İnsanlar kendi eylemlerinden sorumlu tutulmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wayna"
				},
				{
					"id": 750220808,
					"content": "Demek çok yiyenlerin kaderinde arkadaşları tarafından terk edilmek varmış...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750220809
					]
				},
				{
					"id": 750220809,
					"content": "Hey! Böyle bir konuda şaka yapma! Hem Sürüngen masum, belki de sahibinin geri dönmesini bekliyor ve bu yüzden hareket etmek istemiyordur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750220810
					],
					"speakerTitle": "Paimon"
				}
			]
