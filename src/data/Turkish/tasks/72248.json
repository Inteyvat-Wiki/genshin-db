			},
			"dialogs": [
				{
					"id": 722480201,
					"content": "Keşke Byakuyakoku'nun savaşçıları da senin kadar cesur olsaydı! Belki o zaman...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480202
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480202,
					"content": "*iç çeker* Bu iş tamamlandığında bütün dileklerim de gerçekleşmiş olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480203
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480203,
					"content": "Adakları tutsak ruhumun bulunduğu yere götürmelisiniz, ancak o zaman ruhum huzur bulacak. Bunu yapmalıyız, ancak öyle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480204
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480204,
					"content": "Ancak öyle ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480205,
					"content": "Çünkü... Çünkü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480206
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722480206,
					"content": "Ah, konuşmayı uzatmanın hiçbir anlamı yok. Yine bozuk saat gibi takıldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480207,
					"content": "#{NICKNAME}, bu eşyaları yanımıza alalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722480208,
					"content": "Ama bu ruhun tutsak olduğu şu yüksek yer neresi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7224803,
			"completionStepIds": [
				7224805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
