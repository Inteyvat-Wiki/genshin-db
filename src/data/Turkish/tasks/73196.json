			"dialogs": [
				{
					"id": 731960601,
					"content": "En uygun fiyata en kaliteli ürünleri arıyorsanız Jut'un Baharat Dükkanı tam size göre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960602
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731960602,
					"content": "Şimdi satın alın ve yanında bir hediye kazanın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
