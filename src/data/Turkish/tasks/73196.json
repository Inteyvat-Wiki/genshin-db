			},
			"dialogs": [
				{
					"id": 731960801,
					"content": "\"Kazeni'nin Kayıp Altın Heykellerini\" satın almak istiyoruz. Fiyatı pazarlığa açıktır. Lütfen dükkan sahibimizle iletişime geçin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960802
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731960802,
					"content": "Bu konuda bir bilginiz varsa lütfen Menakeri'nin Yeri'ne gelin ve Khalid ile görüşün. Emeğinizin karşılığını alacağınızdan şüpheniz olmasın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
