			"dialogs": [
				{
					"id": 731960901,
					"content": "Hakiki çöl mangalı burada! Kral Deshret'in gizli sosu ile terbiye edilir, yerel baharatlar ile pişirilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960902
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731960902,
					"content": "Herkesin seveceği harika yemekler ve harika içecekler bizdedir!",
					"roleType": "TALK_ROLE_NPC",
