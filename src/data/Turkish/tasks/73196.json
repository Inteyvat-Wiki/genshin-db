			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960701,
					"content": "Her türlü günlük ihtiyacınızı burada bulabilirsiniz. Ürünlerimizin hepsi bizzat dükkan sahibi tarafından kontrol edilir ve kalite garantilidir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960702
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731960702,
					"content": "\"Bana biraz daha Mora verebilir misin Baba? Duyduğuma göre Ajilenakh Yemişlerinin fiyatları yakında çok artacakmış. Bu sefer köşeyi döneceğime eminim.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
