			},
			"dialogs": [
				{
					"id": 731961001,
					"content": "\"Bir zamanlar sonsuz servetim vardı ama gösteriş ve savurganlık bile beni mutlu etmeye yetmedi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961002
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731961002,
					"content": "\"Bu yolculuktan sonra cebimde tek bir Mora bile kalmadı ama buna rağmen huzurluyum.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961003
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731961003,
					"content": "\"Hikayelerimi dinlemek isterseniz manavıma beklerim. Hazır gelmişken birkaç sebze alırsanız fena olmaz tabii.\"",
					"roleType": "TALK_ROLE_NPC",
