			},
			"dialogs": [
				{
					"id": 731961201,
					"content": "Denizaşırı ticaret hizmetleri alanında uzmanız. Mallarınızı en güvenli şekilde teslim etmek adına Güneyhaçı Filosu gibi güçlü filolarla uzun vadeli iş birliği içindeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961202
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731961202,
					"content": "İpek, baharat ve cevher gibi mallar için artık dört yeni güzergahımız var. Yeni gemilerimiz daha büyük bir yük kapasitesine sahiptir. Bizimle çalışmak isteyenlere de kapımız her daim açıktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961203
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731961203,
					"content": "Güzergahın tamamını ayırtmak istiyorsanız lütfen Farzaneh ile iletişime geçin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
