			"dialogs": [
				{
					"id": 731961301,
					"content": "Ani'nin Boyahanesi, müşterilerin şikayetleri üzerine kıyafet hırsızlığı şüphesiyle kapatılmıştır.",
					"roleType": "TALK_ROLE_NPC",
