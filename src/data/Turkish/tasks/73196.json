			"dialogs": [
				{
					"id": 731961601,
					"content": "Mutluluğun peşinden gidin! Dünyayı keşfetmek için denize açılın! Hemen Maceracılar Yoncasına katılın ve ilk aya özel üyelik yalnızca beş Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961602
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731961602,
					"content": "Gerçek bilgi yalnızca gerçek idmanla elde edilebilir. Zahmetli yolları arşınlarken kaybedilen bir hayat, aylaklık yaparak çarçur edilmiş bir hayattan çok daha anlamlıdır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961603
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731961603,
					"content": "\"Dikkati okuyun! Bunu Maceracılar Yoncası asmış, Maceracılar Loncası değil.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961604
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731961604,
					"content": "\"Nasıl yani? Ben bir yıllık üyelik almıştım! Paramı geri alabilecek miyim?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
