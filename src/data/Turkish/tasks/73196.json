			"dialogs": [
				{
					"id": 731961701,
					"content": "\"Herkes Lord Sangemah Bay'i duymuştur, kendisini tanıtmaya gerek yok.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961702
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731961702,
					"content": "\"Her neyse, yeni halılarımız sonunda geldi. Uçan halı falan değiller ama Sulaykha'nın halılarından daha iyiler. Almak istiyorsan koş da gel! Ne yapman gerektiğini biliyorsun. Hehe!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961703
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731961703,
					"content": "\"Dori, şaka gibisin!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
