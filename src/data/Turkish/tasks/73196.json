			},
			"dialogs": [
				{
					"id": 731961101,
					"content": "Ani'nin Boyahanesinde kıyafetlerinize enfes yeni renkler eklemenin en profesyonel yolları sunulmaktadır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961102
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731961102,
					"content": "\"Geçen ay buraya gönderdiğim kıyafetleri ne zaman alabilirim acaba?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961103
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731961103,
					"content": "\"Lütfen kusura bakmayın! Eşim dün gece doğum yaptı, çalışacak vakit bulamadım. Lütfen yarın tekrar gelin. O zamana kıyafetlerinizi hazır edeceğim.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961104
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731961104,
					"content": "\"Kıyafetleri getireli üç ay oldu. Boyanmasını da istemiyorum, kıyafetlerimi geri ver yeter.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961105
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731961105,
					"content": "\"Kusura bakmayın! Kıyafetlerinizi boyadım ancak tam kuruma aşamasındayken bir hırsız çalıverdi. Kıyafetlerinizi geri almak istiyorsanız hırsızı yakalayın lütfen.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
