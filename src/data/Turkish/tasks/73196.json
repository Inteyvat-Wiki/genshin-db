			]
		},
		{
			"id": 7319602,
			"completionStepIds": [
				7319602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319602",
							"2"
						],
						"stepId": 7319602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960201,
					"content": "Bu takas noktası, verilen bilgilerin doğru ve güvenilir olduğuna emin olmak için gereken tüm çabayı göstermektedir; fakat bu bilgilerin doğruluğunu ve geçerliliğini garanti etmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960202
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731960202,
					"content": "Hiçbir müşteri, bu İlan Panosunda yayınlanan piyasa bilgilerinin tamamının ya da bir bölümünün kullanımından doğabilecek zararlar nedeniyle tazminat talebinde bulunamaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7319603,
			"completionStepIds": [
				7319603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319603",
							"2"
						],
						"stepId": 7319603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960301,
					"content": "Daha önce havada durmak diye bir şey duymuş muydunuz? Peki hiç uçan birini gördünüz mü? Uçan Yük Hayvanının sırlarını keşfetmek ister misiniz? O halde Fontaine Pilotlarının Sumeru'daki ilk gösterisini sakın kaçırmayın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960302
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731960302,
					"content": "Hoş geldiniz, gösterimiz başlamak üzere! Eşi benzeri görülmemiş bu sanat gösterisini kaçırmayın. Bir bilet yalnızca beş Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960303
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731960303,
					"content": "Vatandaşlardan gelen ihbarlar doğrultusunda, bu gösteriye Akademi tarafından onay verilmediği öğrenilmiştir. Onların gösteri yapma izinlerini iptal ettik ve bu reklam afişi derhal kaldırılacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7319604,
			"completionStepIds": [
				7319604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319604",
							"2"
						],
						"stepId": 7319604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960401,
					"content": "Bankamızın Sumeru şubesi çok yakında açılacak! Gelecekteki kıymetli müşterilerimiz, açılışımızı dört gözle bekleyeceğinizi umuyoruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960402
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731960402,
					"content": "Halledilmesi gereken bir işiniz varsa ilgilenmesi için Viktor ile iletişime geçerek Liyue şubemizde halledebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960403
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731960403,
					"content": "Kredi çekmeyi düşünüyorsanız hemen temsilcimize danışın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7319605,
			"completionStepIds": [
				7319605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
