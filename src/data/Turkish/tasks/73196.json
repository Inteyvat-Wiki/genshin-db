			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731960501,
					"content": "Sumeru'ya özgü el dokuması halılarımızın hepsi birer şaheser!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960502
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731960502,
					"content": "Sumeru'da yaşayan kimse evlerin olmazsa olmazı bu halılardan almadan gitmesin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731960503
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731960503,
					"content": "Halılara paha biçilebilir fakat sanata paha biçilemez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
