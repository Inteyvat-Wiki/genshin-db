			"dialogs": [
				{
					"id": 731961501,
					"content": "\"Kapalı Çarşı'ya gelmişken Zubayr Tiyatrosuna uğramadan geçmeyin.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961502
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731961502,
					"content": "\"Orada Nilou'nun dans gösterisini mutlaka izlemenizi tavsiye ederiz!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731961503
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731961503,
					"content": "\"Sumeru seyahatiniz sırasında Nilou'nun Sabzeruz Dansını kaçırırsanız tüm yolculuğunuz boşa geçmiş olur!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
