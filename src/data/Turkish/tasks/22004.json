			},
			"dialogs": [
				{
					"id": 220040301,
					"content": "Onları... Onları yendin! Ama Paimon parmağını kıpırdattığını bile görmedi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220040302,
					"content": "Kimsin sen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220040303,
					"content": "Sıradan bir balıkçıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040304
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040304,
					"content": "Hımm... Hiç mantıklı değil bu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220040305
					]
				},
				{
					"id": 220040305,
					"content": "Haklısın, değil. Dünyadaki çoğu diğer şey gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040306
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040306,
					"content": "Handaki şef mesela. Eskiden kılıç ustasıydı, şimdi yemek pişirmeyi çok seviyor. Muşmula suratlı olsa da altın gibi bir kalbi var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040307
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040307,
					"content": "Ya da Patron. Aslen Mondstadtlı ama Mondstadt'taki kimse onu tanımıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040308
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040308,
					"content": "Tabii bir de... Sen. Önsezin yok ama yine de element gücünü kullanabiliyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040309
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040309,
					"content": "Bazı şeyler akla mantığa sığmaz ama bu, onlardan korkman gerektiği anlamına gelmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040310
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040310,
					"content": "Minnettarlığımın göstergesi olarak bunları kabul et. Şimdi izninle balık tutmaya devam etmek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangxue"
				}
			]
		}
	]
