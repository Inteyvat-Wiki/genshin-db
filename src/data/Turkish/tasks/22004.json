				"points": []
			},
			"dialogs": [
				{
					"id": 220040101,
					"content": "Eninde sonunda bir şey tutacağımı umuyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040102
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040102,
					"content": "Ne yapıyorsunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220040103
					]
				},
				{
					"id": 220040103,
					"content": "Bugüne kadar gördüğün en büyük balığı yakalamaya hazırlanıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040104
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040104,
					"content": "Yemek yapmayı seven bir arkadaşım var. Ona şöyle güzel, büyük bir balık yakalarsam çok mutlu olacağına eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040105
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040105,
					"content": "Tek sıkıntı şu ki, canavarlar burada sürekli sorun çıkardığı için balıklar korkuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040106
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040106,
					"content": "Sende kuvvetli bir element gücü seziyorum. Şu dediğim balığı yakalayabilmem için canavarları halletmek ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040107,
						220040109
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040107,
					"content": "Tamam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220040108
					]
				},
				{
					"id": 220040108,
					"content": "Teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040112
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040112,
					"content": "Peki canavarların buraya ne zaman geleceğini nereden biliyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220040113,
					"content": "Ben gördüğüme inanırım. Arkana bak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040114
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040114,
					"content": "Yemezler! Bu numarayı bilmeyen kaldı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220040109,
					"content": "Nereden anladın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220040110
					]
				},
				{
					"id": 220040110,
					"content": "Bir zamanlar benim de Önsezim vardı. Artık kullanmıyorum gerçi ama hâlâ istediğimde element gücünü sezebiliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040111
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220040111,
					"content": "Elementlerin gücü seninleyken bu canavarlar sana çantada keklik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040112
					],
					"speakerTitle": "Jiangxue"
				}
			]
		},
		{
			"id": 2200403,
			"completionStepIds": [
				2200405
			],
