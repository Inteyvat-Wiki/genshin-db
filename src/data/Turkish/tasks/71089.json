			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinwu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710890201,
					"content": "Jinwu. Bunu bulduk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710890202,
					"content": "Tamam, tamam. Sakin ol. Ne buldunuz? Zhiqiong'un nerede olduğundan bahsediyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890203
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890203,
					"content": "Bu mektubu o bırakmış. Kanyon'un daha derinlerine ineceğini söylemiş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710890204
					]
				},
				{
					"id": 710890204,
					"content": "Teşekkür ederim. Neler yazmış çabucak bir bakayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890205
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890205,
					"content": "Jinwu mektubu dikkatlice okuyor.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710890206
					]
				},
				{
					"id": 710890206,
					"content": "Ah şu kız... Sorunların bu kadar büyük olduğunu düşünmemiştim. O nedenle hayatına dair yaptığı seçimleri eleştiremem ama belki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890207
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890207,
					"content": "Belki yaptığı keşifleri zamanında kabullenmedim ya da ona gerektiği kadar saygılı ve anlayışlı olmadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890208
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890208,
					"content": "Haritaları olmasa keşfimizi tamamlamamız çok daha zor olurdu ama ben onun çalışkanlığı ve onca emek vererek başardıkları yerine sadece sağlığına ilgi gösterdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890209
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890209,
					"content": "Başından beri yaptığı işlerin biz madencilerden farklı olduğunu nasıl anlayamadım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890210
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890210,
					"content": "Unutulmak istemiyor sadece.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710890211
					]
				},
				{
					"id": 710890211,
					"content": "Tanrıların gözdesi olmayanlar olarak hepimiz onu istemiyor muyuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890212
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890212,
					"content": "İstiyoruz tabii ama bunu onun kadar saplantı haline getiren var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890213
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890213,
					"content": "Yine de çok önemli biri olma hayallerimi bir kenara bıraktığım anı düşününce... Her gün aynı şeyleri yapmaya alıştığımın farkına varınca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890214
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710890214,
					"content": "Zhiqiong'u eleştirmeye hakkımın olmadığını düşünüyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				}
			]
		}
	]
}