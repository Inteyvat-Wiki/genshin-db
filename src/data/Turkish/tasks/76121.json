			"dialogs": [
				{
					"id": 760540301,
					"content": "Acaba... Böyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540302
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540302,
					"content": "Hımm, bir düşüneyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540303
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540303,
					"content": "Ha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540304
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540304,
					"content": "Aylar... Aylar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540305
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540305,
					"content": "Burası nasıl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540306
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540306,
					"content": "Bu turu ben kazandım gibi görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540307
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540307,
					"content": "Benim üç ayım bağlantılı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540308
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540308,
					"content": "Hım, böyle kazanıyor olmam lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540309
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540309,
					"content": "Hım... Aylar sonsuz bir döngüde büyüyüp küçülüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540310
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540310,
					"content": "Görünüşe göre her iki ay seti de tutulmayı reddediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540311
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540311,
					"content": "Yoksa... Berabere mi kalacağız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540312
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540312,
					"content": "Anladığım kadarıyla kararlarını vermeden önce dikkatlice tartıyorsun. Acele etme tabii, vaktimiz bol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540313
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540313,
					"content": "Aylarını gece göğüne nasıl yerleştireceğini mi unuttun? Yardım etmemi ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540314
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540314,
					"content": "Bu oyunu sevmiyor musun? Hımm... Bence oldukça eğlenceli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540315
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540315,
					"content": "Hım? Bana mı bakıyorsun? Pek gizlemiyorsun da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540316
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540316,
					"content": "Bana bakıyorsun... Ayların hakikati yüzümde mi yazıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540317
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540317,
					"content": "Bu arada, tahta şurada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540318
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540318,
					"content": "Hım, ayların hizalanmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540319
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540319,
					"content": "Gece göğü senin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540320
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540320,
					"content": "Aa... Bir yerde... Hata yapmış olmalıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540321
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540321,
					"content": "Columbina ile oyun oynarken harika zaman geçiriyorsun...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760540322
					]
				},
				{
					"id": 761210202,
					"content": "Tek sıra halinde üç ay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210203
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761210203,
					"content": "Hı? Hâlâ o son oyunu mu düşünüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210204,
					"content": "Hayır. Sadece... Şimdi oyuna dönüp bakınca tuhaf bir hisse kapıldım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210205
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761210205,
					"content": "Aa, doğru. Artık üç ayın gücüne sahip olduğuna göre gece gökyüzüne hükmeden bir tanrıçadan daha fazlası oldun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210206,
					"content": "Evet. Ve ayrıca düşünüyorum da... Eğer üç Ay Tanrıçası arasında bir bölünme olmasaydı dünyanın kaderi farklı olabilirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210207
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761210207,
					"content": "Nasıldılar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210208
					]
				},
				{
					"id": 761210208,
					"content": "İlk gördüğüm Hareli Ayın tanrıçası Sonnet'ti. Hayal ettiğimden daha hayat doluydu, oyunbaz bir küçük kız kardeş gibiydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210209
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761210209,
					"content": "Ebedi Ayın Aria'sı, üçü arasında en olgun olandı. Doğuştan bir liderdi ve başkalarına karşı en nazik olanıydı. Aslında tıpkı Lauma gibiydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210210
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761210210,
					"content": "Donuk Ayın Canon'una gelince... Hem bilge hem de ileri görüşlüydü. Ve ayını bana veren de oydu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210211
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761210211,
					"content": "Anlaşılan hepsi de iyi kalpli tanrıçalarmış.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210212
					]
				},
				{
					"id": 761210212,
					"content": "Evet. Farklılıklarına rağmen Teyvat'ı seviyorlardı ve bu evi de seviyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210213
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761210213,
					"content": "Onlara gelecekten bahsettiğimde üçü de bu dünyanın böylesine zengin bir geleceği olduğu için rahatlamış ve sevinmiş görünüyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210214
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761210214,
					"content": "Bana \"eve\" dönme gücünü vermelerinin sebebi de buydu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210215
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761210215,
					"content": "Hımm... Paimon onları görmeyi ve onlara güzelce teşekkür etmeyi çok isterdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210216,
					"content": "Ben de çok isterdim. Ama korkarım bu artık mümkün değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210217
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761210217,
					"content": "Neyse ki bu dünya varlığını sürdürüyor. Korudukları insanlar ise hayatta kaldı ve hikayelerini bugüne dek aktarabildiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210218
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761210218,
					"content": "Aynen öyle! İyi bir hayat yaşamak ve kötü adamların dünyayı yok etmesine izin vermemek onlara edebileceğimiz en iyi teşekkür olur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210219,
						761210220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210219,
					"content": "Senin de ağzın iyi laf yapıyor Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210221
					]
				},
				{
					"id": 761210220,
					"content": "Senin her günün bir teşekkür o zaman...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210221
					]
				},
				{
					"id": 761210221,
					"content": "Tabii ki! Paimon her zaman hayatını dolu dolu yaşamaya çalışıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210222,
					"content": "Bu senin için de geçerli Columbina! Her gün güzelce beslen, güzelce uyu ve oyun oynamak istersen bizi bul!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210223,
					"content": "Haha, pekala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210224
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761210224,
					"content": "Sanırım bundan sonra ne zaman Ay Satrancı oynasam aklıma o üç nazik tanrıça gelecek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Küçük Hanım"
				}
			]
		},
