			"dialogs": [
				{
					"id": 761210101,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210102
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761210102,
					"content": "Selam Columbina! Bugün keyfin yerinde galiba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210103,
					"content": "Hehe... Yukarı gelin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210104
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761210104,
					"content": "Yine mi Ay Satrancı oynamak istiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210105,
					"content": "Evet. Uzun zaman oldu, oynamayı özlemişim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210106
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761210106,
					"content": "Kurallar eskisiyle aynı mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761210107
					]
				},
				{
					"id": 761210107,
					"content": "Yoksa Üç Ay Tanrıçası olduğun için artık kendi sıranda birden fazla taşı hareket ettirebiliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210108,
					"content": "Bu hile yapmak olurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210109
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761210109,
					"content": "Hehe, evet Paimon biliyor! Sadece şaka yapıyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761210110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761210110,
					"content": "O zaman başlayalım mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Küçük Hanım"
				}
			]
		},
