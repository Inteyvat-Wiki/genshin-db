						],
						"pointId": 10239
					}
				]
			},
			"dialogs": [
				{
					"id": 150240501,
					"content": "Aa, ne oldu öyle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240502,
					"content": "Rahiplerin rutin görevlerinden biri. Atalarımızın ruhlarıyla iletişime geçmeye çalışıp aydınlanma ve ilham arıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240503
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240503,
					"content": "Şef hemen şurada. Lütfen ben kendisiyle konuşurken biraz bekleyin. Hemen döneceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240504
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240504,
					"content": "Gece Rüzgarının Ustaları gerçekten de herkesin söylediği kadar gizemliymiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240505,
					"content": "Tamamdır, şefimize neden geldiğinizi açıkladım, şimdi kendisiyle konuşabilirsiniz. Buyurun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240506
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240506,
					"content": "Görevlendirilenler siz ikiniz misiniz? Ben Şef Biram. Hoş geldiniz, sabrınız için teşekkür ediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240507
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240507,
					"content": "... Ne kadar uzunsun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240508,
					"content": "Alışılmadık bir uzunluktayım evet, farkındayım. Ama sizi temin ederim ki benden çekinmenize gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240509
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240509,
					"content": "Ha, yok, tabii ki! Kusura bakma, Paimon düşünmeden konuştu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240510,
					"content": "Bizim bu \"görevlendirilme\" olayı nedir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240511
					]
				},
				{
					"id": 150240511,
					"content": "Hah evet, Caholom bahsetti bana. Kabilemize yabancı olduğunuz için muhtemelen ilk kez böyle bir kavram duyuyorsunuz. Kafanız karışmıştır eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240512
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240512,
					"content": "Tarihimiz boyunca bu tür görevler yalnızca Gece Rüzgarının Ustaları üyelerine verilmiştir. İlk defa bir yabancı seçildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240513
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240513,
					"content": "Gerçekten mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240514,
					"content": "Şöyle açıklayayım. Kabilemizin çok eski bir geleneği vardır. Biz tarihi, dokuma parşömenlere kaydederiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240515
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240515,
					"content": "Üstelik yalnızca kendi tarihimizi değil, diğer kabilelerin de efsanelerini ve kahramanlıklarını kayda geçiririz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240516
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240516,
					"content": "Yüzyıllardır sürdürdüğümüz bir adet bu. Kutsal bir görevdir bizim için.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240517
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240517,
					"content": "Fakat bütün Natlan'ı etkileyen büyük bir olay yaşandığında onu bu amaç için üretilen özel bir tür parşömene kaydederiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240518
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240518,
					"content": "Bu parşömenleri ise yalnızca Büyük Iktomizor'un seçtiği kişiler dokuyabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240519
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240519,
					"content": "Büyük Iktomizor, Ley Hatlarında önemli bir değişiklik hissettiğinde bu parşömeni oluşturacak kişiyi resmi bir duyuruyla belirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240520
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240520,
					"content": "Bir dakika, yani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240521,
					"content": "Yüce Tlapo uzun zaman önce bir Ley Hattı değişikliği sezmişti fakat parşömen dokumacılarını seçmemişti... Ta ki siz gelene dek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240522
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240522,
					"content": "Tamam ama... Bilginiz olsun diye söylüyoruz, parşömen nasıl dokunur hiçbir fikrimiz yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240523,
					"content": "Açıkçası buna hiç şaşırmadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240524
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240524,
					"content": "Neden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240525,
					"content": "Yüce Tlapo'nun görev yaptığı iki yüz yıl boyunca hiçbir zaman deneyimli parşömen dokuyucular seçilmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240526
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240526,
					"content": "Nasıl yani, son iki yüz yılın önemli olayları hiç kaydedilmedi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240527,
					"content": "Hayır, seçilenler parşömenleri zamanında dokudu. Fakat hepsi bu parşömenlerin kendi çalışmaları olmadığını, \"ruhlardan gelen bir hediye\" olduğunu iddia etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240528
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240528,
					"content": "Vay be... Bu kabile iyice gizemli bir hal almaya başladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240529,
					"content": "Evet... Bu kısım canımı sıkıyor açıkçası.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240530
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240530,
					"content": "Bu kadar önemli tarihi olayları kayda dökmek için \"ruhlardan gelen hediyeler\" gibi gizemli kavramlara bel bağlamamız... Tedirginlik verici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240531
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240531,
					"content": "Hım... Kabilenin şefinden bunları duymak epey şaşırtıcı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240532
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240532,
					"content": "Tahmin edebiliyorum. Gece Rüzgarının Ustalarını muhtemelen sır perdesiyle çevrili, esrarengiz yöntemlerimizle gurur duyan bir halk sanıyordunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240533
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240533,
					"content": "Ama ben istisna sayılırım. Şef olabilirim evet ama söz konusu geleneklerimiz olduğunda değişim ve reformdan yanayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240534
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240534,
					"content": "Kendimi kabilemizin sayısız gizeminin şifresini çözmeye adadım. Böylece daha net kurallar getirip geleneklerimizin gelecekte de uygulanabilmesini kolaylaştırmak istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240535
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240535,
					"content": "Vay be, güzelmiş! Peki bu \"ruhlardan gelen hediyenin\" gizemini çözebildin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240536
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240536,
					"content": "Maalesef hayır... Uzun süredir araştırıyorum fakat bu \"hediye\" ile ne kastedildiğini bir türlü çözemedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240537
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240537,
					"content": "Geçtiğimiz yüzyıllarda bu özel parşömenlere çok az sayıda olay kaydedilmiş, olaylar arasında onlarca yıl var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240538
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240538,
					"content": "Bir sonraki parşömen dokuyucu seçilene kadar şefliğim çoktan sona ermiş olacak. Konuyu ayrıntılı araştırabilecek bir pozisyonda olmayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240539
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240539,
					"content": "O zaman...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240540
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240540,
					"content": "Bu meseleyi henüz tam çözememiş olsam da biraz ilerleme kaydettim. Fakat teorilerimi geliştirebilmem için seçilen kişilerle iş birliği yapmam gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240541
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240541,
					"content": "O yüzden de bizi bir imtihandan geçirmek istiyorsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240542
					]
				},
				{
					"id": 150240542,
					"content": "Aynen öyle. Endişe etmenize gerek yok bu arada, mevcut hipotezimi doğrulamak için bulduğum bir yöntem sadece. Uzun sürmez, tehlikeli de değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240543
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240543,
					"content": "Peki. Tam olarak ne yapmamız gerekiyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240544
					]
				},
				{
					"id": 150240544,
					"content": "İmtihan alanına gittiğimizde her şeyi ayrıntılı açıklarım. Ama önce izninizle üzerimdeki Ruh Koruyan Pelerini çıkarayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240545
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240545,
					"content": "Bu giysi önemli kültürel yadigarlarımızdandır, nesillerdir şeften şefe aktarılıyor. Yalnızca belirli törenler sırasında giyiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240546
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240546,
					"content": "Ha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240547
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240547,
					"content": "Biram pelerinini çıkarır ve dikkatlice bir rahibe verir.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150240548
					]
				},
				{
					"id": 150240548,
					"content": "Lütfen beni takip edin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240549
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240549,
					"content": "Bu parşömeni görüyor musunuz? Dokunursanız gizli bir alana gireceksiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240550
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240550,
					"content": "Bugünün imtihanı bu alandan kaçmanın bir yolunu bulmak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240551
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240551,
					"content": "O kadar mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240552
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240552,
					"content": "Emin olun sandığınız kadar kolay değil. Çıkış yolunu bulamazsanız tabii ki ben müdahale edip sizi geri getireceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240553
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240553,
					"content": "Ama o zaman bu gizemi çözmeye yaklaşmış olmayacağız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240554
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240554,
					"content": "Deneyelim bakalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240555
