					}
				]
			},
			"dialogs": [
				{
					"id": 150240701,
					"content": "Oh be, nihayet çıktık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240702,
					"content": "Haklıymışım. Bu görevi üstlenebilecek kapasiteye sahipmişsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240703
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240703,
					"content": "Teorini kanıtladı mı bu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240704
					]
				},
				{
					"id": 150240704,
					"content": "Evet. İçeride bir sürü farklı görünümlü parşömen gördünüz, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240705
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240705,
					"content": "Evet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240706,
					"content": "Bu özel parşömen türü bize atalarımızdan kaldı. İncelediğimde sıradan parşömenlerde görülmeyen bir rengin kullanıldığını fark ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240707
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240707,
					"content": "Çoğu insanın algılayamadığı gizemli bir renk bu. Varlığını doğrulamak için çok özel teknikler kullanmam gerekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240708
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240708,
					"content": "Fakat bu rengi doğuştan görebilenler de var. O yüzden sizi denemek istedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240709
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240709,
					"content": "Yani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240710,
					"content": "Girdiğiniz alan, bu tür dokuma parşömenlerin saklandığı bir sergi odasıydı aslında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240711
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240711,
					"content": "Yüzyıllar önce Huitzilin adında büyük bir şaman odaya bu güvenlik önlemini uyguladı. Böylece odaya izinsiz girenler içeride mahsur kalacaktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240712
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240712,
					"content": "Bu önlem günümüzde de varlığını koruyor. Nasıl çalıştığını çözememiş olsam da nasıl açılıp kapatıldığını öğrendim en azından.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240713
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240713,
					"content": "Biri içeride mahsur kalırsa dışarıdan yardım almadan çıkması imkansız. Yüce şamanın o tuhaf rengi görme yeteneğini paylaşıyorlarsa başka tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240714,
						150240715
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240714,
					"content": "Ne demek istediğini anladım sanırım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240716
					]
				},
				{
					"id": 150240716,
					"content": "Bu yeteneğe sen de sahipsin demek ki... Demek ki Büyük Iktomizor insanlarda bu yeteneğin olup olmadığını sezebiliyor ve parşömen dokuyucuları buna dayanarak seçiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240717
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240717,
					"content": "#Bir başka gizli güç daha mı? Sırlarla dolusun {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240718,
					"content": "Fakat bu yeteneğe sahip olman parşömen dokumaya dair hiçbir şey bilmediğimiz gerçeğini değiştirmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240719,
					"content": "Onu merak etmeyin. Bu tür parşömenleri dokuma yöntemi, sıradan parşömen dokumakla aşağı yukarı aynı duruyor. Ana fark, parşömene eşsiz rengini veren o boya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240720
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240720,
					"content": "Şüphelerim doğruysa parşömeni dokumanın kilit noktası bu boya. Boyayı elde etmek için de özel yeteneğini kullanman gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240721
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240721,
					"content": "Boyama süreci de normalden biraz farklı ama o konuda ciddi bir sorunla karşılaşacağımızı sanmıyorum. İkiniz boyayı elde ederseniz boyama kısmında yardımcı olabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240722
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240722,
					"content": "... Güzel, seni izleyeceğiz o zaman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240723,
					"content": "Harika. O halde lütfen yeteneklerinizi kullanarak gerekli malzemeleri toplayın, ben de o sırada boyama testi için birine kumaş hazırlatayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240724
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240724,
					"content": "Hipotezimi denemek için birkaç numune boyarız, iyi bir sonuç elde edersek asıl parşömene başlayabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240725
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240725,
					"content": "Yardım etmeyi kabul ederseniz bu iş tamamlandığında cömert bir ödül kazanırsınız. Ne düşünüyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240726
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240726,
					"content": "Yardım etme imkanına sahip olmak, yardım etme sorumluluğunu da beraberinde getiriyor bence.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240727
					]
				},
				{
					"id": 150240727,
					"content": "Çok doğru! Özellikle de işin içinde ödül varsa! Ödül ne bu arada? Yemek mi? Paimon yemek olmasını umuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240728,
					"content": "Bunun kabilemiz için önemini düşünürsek ciddi miktarda Mora uygun olur diye düşündüm... Bedava yemektense bunu tercih edersiniz siz de herhalde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240729
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240729,
					"content": "Mora da olur tabii! Neyse, biz şu malzemeleri nasıl bulacağız? Yoksa Natlan'da bir aşağı bir yukarı dolanıp karşımıza çıkmalarını mı bekleyeceğiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240730,
					"content": "Yok, hayır. Bulabileceğinizi tahmin ettiğim bir yer belirledim, sizi oraya götürecek birini de ayarladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240731
					],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240731,
					"content": "Rehberiniz dışarıda sizi bekliyor. Dilediğiniz zaman yola koyulabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Biram"
				},
				{
					"id": 150240715,
					"content": "Farklı bir renk gördüm içeride gerçekten de...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240716
					]
				}
			]
		},
