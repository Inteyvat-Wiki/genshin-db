					],
					"speakerTitle": "Tlapo"
				},
				{
					"id": 150240108,
					"content": "Of... Paimon ne zamandır baygın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240109,
					"content": "Paimon şu yavru Iktomizorla bir saniyeliğine falan göz teması kurdu, sonra birden koooocaman bir Iktomizorun olduğu tuhaf bir yere çekildi!",
					"roleType": "TALK_ROLE_NPC",
