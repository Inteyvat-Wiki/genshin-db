			"dialogs": [
				{
					"id": 150240901,
					"content": "Ne çok dokuma parşömen var burada. Paimon bunlardan bazılarını diğer kabilelerde gördüğümüzü hatırlıyor. Tarihi olayların kayıtlarıymış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240902,
					"content": "Bu parşömen diğerlerinden daha farklı duruyor. Zaten aralarında en büyüğü bu. Hangi hikayeyi anlatıyor acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240903,
					"content": "Renkleri de çok farklı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240904
					]
				},
				{
					"id": 150240904,
					"content": "Evet, haklısın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240905,
					"content": "#Bak, şurada bir şey yanıp söndü! Gördün mü {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240906,
					"content": "Belki de çıkış yolumuz buradan geçiyordur...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240907
					]
				},
				{
					"id": 150240907,
					"content": "... Daha önce göremediğimiz şeyleri görmekten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240908
					]
				},
				{
					"id": 150240908,
					"content": "Aaa, evet! Paimon katılıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
