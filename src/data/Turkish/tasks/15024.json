						150240305
					],
					"speakerTitle": "Tlapo"
				},
				{
					"id": 150240305,
					"content": "Ay, pardon! Kabalık etmek istememişti Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240306,
					"content": "Sen... Büyüğümüze ne cüretle saygısızlık edersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240307
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240307,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240308
					],
					"speakerTitle": "Tlapo"
				},
				{
					"id": 150240308,
					"content": "Ha, demek öyle... Anladım. Özür dilerim, benim hatam. Buraya davet edilmişsiniz, dolayısıyla sizi hoş karşılamak bana düşüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240309
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240309,
					"content": "Kendimi tanıtayım. Ben Caholom, kabilemizin rahiplerinden biriyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240310
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240310,
					"content": "Bu da Büyük Iktomizor, Yüce Tlapopoctiztetl. Gece Rüzgarının Ustalarında yaşayan bir totemdir kendisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240311
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240311,
					"content": "İsminin telaffuzu zormuş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240312,
					"content": "Açıkçası biz de \"Yüce Tlapo\" diyoruz kısaca. Siz de öyle diyebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240313
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240313,
					"content": "Buraya çok... Sıra dışı biçimde davet edildik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240314
					]
				},
				{
					"id": 150240314,
					"content": "Ha, büyüğümüzün özel yeteneğini kastediyorsunuz sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240315
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240315,
					"content": "Yüce Tlapo nice yüzyıllardır yaşıyor, biz rahiplerin dahi açıklayamadığı pek çok sır barındırıyor. O nedenle bu tepkiniz gayet doğal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240316
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240316,
					"content": "Fakat şunu söyleyebilirim ki Yüce Tlapo siz ikinize son derece önemli bir görev verdi. Bu nedenle bir imtihandan geçmenizi rica ediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240317
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240317,
					"content": "Ne tür bir görev bu? Ve nasıl bir imtihan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240318,
					"content": "Sizin için sorun olmayacaksa şefimize götüreyim sizi. Sorularınızı o yanıtlasa daha iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240319
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240319,
					"content": "Iı... Tamam, tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150240320,
					"content": "Pekala. O halde lütfen benimle gelin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240401
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240401,
					"content": "Bu parşömeni kullanarak doğrudan Obsidiyen Sunağına gidebilirsiniz, şefimiz orada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240402
					],
					"speakerTitle": "Caholom"
				},
				{
					"id": 150240402,
					"content": "Merak etmeyin, kabilemizin mistik pek çok yeteneğinden biri bu yalnızca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Caholom"
				}
			]
		},
