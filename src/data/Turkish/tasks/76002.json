			"dialogs": [
				{
					"id": 760020501,
					"content": "Ha! Ekibimi eritip dağıtacağını söyleyip duran manyak yabancıdan da kurtulduk. Buzun içine hapsoldu, kendisini eritmeye çalışsın dursun artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020502
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020502,
					"content": "Oh be... Kaçak malların Nasha Kasabası'na sızmasına engel olduk! Aa, ödülümüzü unutma sakın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020503,
					"content": "Hıh, acele etmeyin. Önce şu mallara bir göz atmam lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020504
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020504,
					"content": "Hı? Mallara... Göz atmak mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020505,
					"content": "E herhalde! Mallarda kusur varsa zırnık almayız. Haliyle size de pay may düşmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020506
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020506,
					"content": "Cık... Şu çiziklere bak. Hatta pas bile var! Son zamanlarda Cendre Nehri iyice tembelleşti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020507
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020507,
					"content": "Hı? Fontaine işi bir Kurmalı Meka mı? Vay be, Fontaine teknolojisi etkileyici. Buraya taşındıktan sonra çalıştığını düşünmek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020508,
					"content": "Hâlâ çalışmak mı? Çok beklersin! Bu zımbırtının güç sistemi çok uzun zaman önce sökülmüştü. Çalışmasına imkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020509
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020509,
