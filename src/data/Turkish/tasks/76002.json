			"dialogs": [
				{
					"id": 760020101,
					"content": "Hey, sarı kafa! Tam zamanında geldin, şu velet resmen dayak dileniyor. El at da ganimetten sana da pay vereyim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020102
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020102,
					"content": "Hayırdır, kaybedeceğini bildiğin için takviye mi çağırıyorsun? Tamam, bu oyunu iki kişi de oynar! Dinle dostum, şu herifi birlikte indirelim, Morayı aramızda kırışırız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020103
					],
					"speakerTitle": "Hoyka"
				},
				{
					"id": 760020103,
					"content": "B-Bekle biraz, biz sadece geçiyorduk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
