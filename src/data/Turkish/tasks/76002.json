			"dialogs": [
				{
					"id": 760020301,
					"content": "Bırak kaçsınlar. Bu sürüngenler de amma hadsiz, bizim mahalleye dadanmak da neymiş?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020302
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020302,
					"content": "Sağ olasın. Bizim çocuklar şu \"Matmazel Belleville\"i Nasha Kasabası'na bıraktığında, payınız garanti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020303
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020303,
					"content": "Ah, evet, ödeme... Dur bir dakika... Matmazel mi? Bekle, siz insan kaçakçısı mısınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020304,
					"content": "Yanlış anlama küçük hanım. Biz adam kaçırma işleriyle uğraşmayız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020305
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020305,
					"content": "Bu metal yığınının adı \"Matmazel Belleville\". Cendre Nehri'nden buraya getirilmesi bize çok pahalıya patladı. Eğer çalınırsa mahvoluruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020306
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020306,
					"content": "Ooo, Fontaine işi bir Kurmalı Meka mı? Vay be, Fontaine teknolojisi etkileyici. Buraya taşındıktan sonra çalıştığını düşünmek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760020307,
					"content": "Fonta mı geçiyorsun benimle? Bu şeyin güç sistemi çok uzun zaman önce sökülmüştü. Çalışmasına imkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020308
					],
					"speakerTitle": "Basu"
				},
				{
					"id": 760020308,
					"content": "UYARI. Başlatma modu <color=#FF5E41FF>ANORMAL</color>. Enerji modülü <color=#FF5E41FF>ANx5F02&#5E38ORMAL</color>. Teyit başarısız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020309
					],
					"speakerTitle": "Matmazel Belleville"
				},
				{
					"id": 760020309,
					"content": "Teyit başarısız. <color=#FF5E41FF>Teyit başarısız.</color> <color=#FF5E41FF>Teyit başarısız.</color> <color=#FF5E41FF>İmha et.</color> <color=#FF5E41FF>İmha et.</color> <color=#FF5E41FF>İmha et.</color> <color=#FF5E41FF>İmha Et İmha Et İmha Et—</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020310
					],
					"speakerTitle": "Matmazel Belleville"
				},
				{
