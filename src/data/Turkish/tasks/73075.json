				},
				{
					"id": 730750102,
					"content": "Buradaki Viparyaslar mutlu. Bu sayede Arakara da mutlu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750103
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730750103,
					"content": "Utsava Festivali bitti. Altın Nara Vanarana'dan ayrılmadan önce...",
