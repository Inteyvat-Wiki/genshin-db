			"dialogs": [
				{
					"id": 730750101,
					"content": "#Nara {NICKNAME} ve Paimon teşekkür ederim. Artık Vanarana'daki bahçelerde Viparyas yetişiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
