				},
				{
					"id": 730750104,
					"content": "Bir Viparyas alıyorsun.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730750105
					]
				},
				{
					"id": 730750105,
					"content": "#Mutlu Viparyası Altın Naraya veriyorum. Umarım Nara {NICKNAME} ve Paimon da hep mutlu olur. Viparyas asla solmaz ancak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750106
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730750106,
					"content": "Yine de arada sırada onunla konuş. Hatta daha iyisi onun için müzik çal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730750107
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730750107,
					"content": "#Toprak ve Aranara unutmayacak. Umarım Nara {NICKNAME} ve Paimon da unutmaz.",
