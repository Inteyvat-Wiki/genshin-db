			"dialogs": [
				{
					"id": 200470301,
					"content": "Bir şey bulabildin mi? Herhangi bir şey.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470302
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470302,
					"content": "Bir şeyler buldum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470303
					]
				},
				{
					"id": 200470303,
					"content": "Anladım, anladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470304
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470304,
					"content": "Haberler böyle yani.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470305
					]
				},
				{
					"id": 200470305,
					"content": "Bunlar çok güzel haberler. Harika. Şahane! Teşekkür ederim, bu da uğraşların için.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470306
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470306,
					"content": "Bayan Patchi! Planda büyük bir değişiklik oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Doolan"
				}
			]
		}
	]
