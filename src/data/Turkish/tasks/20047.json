			"dialogs": [
				{
					"id": 200470201,
					"content": "Bir şeyler bulabildin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470202
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470202,
					"content": "Henüz değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470203
					]
				},
				{
					"id": 200470203,
					"content": "Lütfen, her şey sana bağlı! Bulguların, tüm macerayı ya vezir ya da rezil edecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Doolan"
