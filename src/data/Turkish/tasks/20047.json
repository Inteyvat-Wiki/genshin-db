				"points": []
			},
			"dialogs": [
				{
					"id": 200470101,
					"content": "Maceradayken mükemmel plan diye bir şey olmaz! Sürekli böyle üzerine düşünürsen nasıl ilerleyeceksin ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470102
					],
					"speakerTitle": "Meraklı Patchi"
				},
				{
					"id": 200470102,
					"content": "Plan kusursuz değilse her şeye hazırlıklı olmalıyız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470103
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470103,
					"content": "Niçin tartışıyorsunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470104
					]
				},
				{
					"id": 200470104,
					"content": "Ah, <color=#00E1FFFF>Bin Rüzgar Tapınağını</color> keşfe çıkmayı planlıyorduk ama Bayan Patchi'nin maceracılık tecrübesi pek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470105
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470105,
					"content": "Bugünlerde tapınağın içi canavar kaynıyor, girişteki Harabe Muhafızını söylemiyorum bile. Hiç düşünmeden tapınağa dalarsak hayatlarımızı riske atarız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470106
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470106,
					"content": "Sadece Bayan Patchi'nin güvenliğini... Yani aslında hepimizin güvenliğini düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470107
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470107,
					"content": "Maceraya atılırken çok titiz, dört dörtlük bir plan yapmanın ne kadar önemli olduğunu ona anlatmaya çalışıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470108
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470108,
					"content": "Ama tapınak arazisinin civarında basit bir keşfe başlarsak Patchi'nin çok heyecanlanıp içeriye dalmasından endişeleniyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470109
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470109,
					"content": "Burada kalıp ona göz kulak olmam gerek. Benim için gidip alanı bir inceler misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470110,
						200470113
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470110,
					"content": "Tamam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470111
					]
				},
				{
					"id": 200470111,
					"content": "Şahane! Ama her şeyi dikkatlice incelediğinden emin ol. Atlanan tek bir ayrıntı bile tüm maceramızın başarısız olmasına yol açabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470112
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470112,
					"content": "Orada olan biten her şeyi bana söylemeni istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470113,
					"content": "Onun yerine ben senin için Patchi'ye baksam?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470114
					]
				},
				{
					"id": 200470114,
					"content": "Yok, öyle olmaz! Şu anda bu planla ilgili onunla üzerinden geçmem gereken bir sürü ayrıntı var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470115
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200470115,
					"content": "Lütfen gidip ipucu toplamama yardım et!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Doolan"
				}
			]
		},
