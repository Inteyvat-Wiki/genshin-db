			"dialogs": [
				{
					"id": 207010101,
					"content": "Yine acıktım ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010102
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010102,
					"content": "Ah, sensin! Harika. Beni hatırladın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010103
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010103,
					"content": "Xiangling'le yemek yarışmasında kapışmıştık. Rakibi bendim, Siegfria!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010104
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010104,
					"content": "Hehe, şimdi hatırladın mı? Neyse. Zamanlaman mükemmel. Senden... Bir şey rica edebilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010105
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010105,
					"content": "Ne lazım?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207010106
					]
				},
				{
					"id": 207010106,
					"content": "Geçen sefer yaptığın Yeşim Bohçalarını hatırlıyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010107
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010107,
					"content": "O kadar lezzetliydi ki tadı damağımda kaldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010108
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010108,
					"content": "Ben de kendime pişireyim dedim ama... Tadı nedense tam oturmadı, eksik bir şey var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010109
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010109,
					"content": "Birkaç kez daha denersem aynı tadı yakalayabileceğimi düşünüyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207010110
					],
					"speakerTitle": "Siegfria"
				},
				{
					"id": 207010110,
					"content": "Örnek olması için bana Yeşim Bohçaları yapabilir misin acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Siegfria"
