			"dialogs": [
				{
					"id": 716664101,
					"content": "Yanfei'nin Hayalet Böceği çok güçlü! Madam Ping çiğ etle falan mı beslemiş bu hayvanı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716664102,
					"content": "Gördün mü? Kurtarıcının Hayalet Böceği gerçekten rakibine korku salıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664103
					],
					"speakerTitle": "Büyük Usta Hanakado"
				},
				{
					"id": 716664103,
					"content": "Ama geçen sefer generallerimle yaptığın zorlu dövüşlerde olduğu gibi... En keskin kılıç bile düşmanını yalnızca yetenekli bir kılıç ustasının elindeyken kesebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664104
					],
					"speakerTitle": "Büyük Usta Hanakado"
				},
				{
					"id": 716664104,
					"content": "Ç-Ç-Çok akıllıca sözler Büyük Usta... Peeeki... Neyse ki yoldaşım çok rahat, çok profesyonel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664105
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716664105,
					"content": "Vay be, süperdi! Bu böcek dövüşü olayı ilgimi çekti galiba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664106
					],
					"speakerTitle": "Süper Donanımlı Rakip"
				},
				{
					"id": 716664106,
					"content": "Çok eğlendim! Sağ olun! Ben buralarda takılıp biraz daha oynayacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Süper Donanımlı Rakip"
				}
			]
		},
