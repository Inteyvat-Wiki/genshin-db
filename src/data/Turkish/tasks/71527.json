			},
			"dialogs": [
				{
					"id": 716664001,
					"content": "Selam! Ben geldim! Söyleyin bakalım, Arataki Parlak Zırhlı Böcek Dövüşü Eğitim Kampı nasıl gidiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664002
					],
					"speakerTitle": "Süper Donanımlı Rakip"
				},
				{
					"id": 716664002,
					"content": "Tam zamanında geldin Yanfei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716664003,
					"content": "Kurtarıcım! İzin belgesinde yardım ettiğin için sağ ol! Tabela da süper olmuş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664004
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716664004,
					"content": "Bir dakika, ben bu bakışı biliyorum... Sen de mi böcek kapıştırmak istiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664005
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716664005,
					"content": "Ne olmuş ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664006
					],
					"speakerTitle": "Süper Donanımlı Rakip"
				},
				{
					"id": 716664006,
					"content": "Uluslararası ticaret yapan büyük bir müşterim var. Büyük bir dava kazanmasına yardım etmiştim, o da bu yüzden bana bir sürü hediye yollamıştı. İşte o hediyelerden biri de çok özel bir Hayalet Böcekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664007
					],
					"speakerTitle": "Süper Donanımlı Rakip"
				},
				{
					"id": 716664007,
					"content": "O zamanlar Hayalet Böcek nasıl bakılır bilmediğim için baksın diye bir süre nineme bırakmıştım. Şu an çok güçlü görünüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664008
					],
					"speakerTitle": "Süper Donanımlı Rakip"
				},
				{
					"id": 716664008,
					"content": "Katılsam sorun olur mu? Tarzınızı bozacağımı düşünmüyorsunuz, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664009
					],
					"speakerTitle": "Süper Donanımlı Rakip"
				},
				{
					"id": 716664009,
					"content": "Kurtarıcını kapıdan çeviremeyiz Oni Kral. Tecrübe eksiği olsa da hayatım boyunca gördüğüm en sağlam, en hayranlık uyandıran Hayalet Böceklerden birine sahip.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664010
					],
					"speakerTitle": "Büyük Usta Hanakado"
				},
				{
					"id": 716664010,
					"content": "Böyle bir teklifi reddedemem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664011
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716664011,
					"content": "Peki, Oni Kralın Sağ Kolunu Kızıl Asa ile gönderelim. Yoldaşım baskı altında bile sakin kalmasını bilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664012,
						716664013
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716664012,
					"content": "Tabii ki!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716664014
					]
				},
				{
					"id": 716664014,
					"content": "#{NICKNAME} ile mi dövüşeceğim yani? Peki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664015
					],
					"speakerTitle": "Süper Donanımlı Rakip"
				},
				{
					"id": 716664015,
					"content": "Bu oyunu henüz tam kavrayamadım, saçma bir şey yaparsam affola.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Süper Donanımlı Rakip"
				},
				{
					"id": 716664013,
					"content": "Bana güvendiğin için sağ ol!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716664014
					]
				}
			]
		},
