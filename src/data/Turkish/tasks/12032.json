			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Şogun Raiden",
					"Yae Miko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120320101,
					"content": "Inazuma bundan sonra da pek çok imtihandan geçecek. Ben bu imtihanlarla yüzleşmeye hazırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320102,
						120320107,
						120320112,
						120320117,
						120320122,
						120320128
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120320102,
					"content": "\"İmtihanlar\" derken...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320103
					]
				},
				{
					"id": 120320103,
					"content": "Sakoku Fermanını yürürlükten kaldırmanın türlü türlü sonuçları olacağına şüphe yok. Bu sonuçların hepsinin olumlu olacağını ve olumsuz bir duruma yol açmayacağını söylemek saçmalık olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320104
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120320104,
					"content": "Örneğin dış dünyanın Inazumalı işletmeler için bir tehdit oluşturma ihtimalinin farkındayım. Bunların hepsi benim çözmem gereken meseleler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320105
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120320105,
					"content": "Her şey hakkında ne kadar dikkatle ve özenle düşünüyorsun Ei. Bense sadece ileride Büyük Narukami Tapınağına giriş bileti satabilir miyim acaba diye düşünüyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320106
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320106,
					"content": "Dürüst olmak gerekirse Miko...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120320107,
					"content": "Tanrıların gözetimi konusunda...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320108
					]
				},
				{
					"id": 120320108,
					"content": "Makoto'nun gözü her daim Inazuma halkının üzerindeydi. Ben hep... Makoto'nun bunu görevi olduğu için yaptığını varsaymıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320109
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120320109,
					"content": "Oysa şimdi fark ediyorum ki Makoto'nun bakışları hep sevinç ve umut doluydu. Bu onun için sadece bir görev değil, aynı zamanda bir neşe kaynağıydı. İnsanlığı tüm kalbiyle sevmişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320110
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120320110,
					"content": "Geçmişteki insanlar, tanrıların ilgisini hak ettiyse gelecekteki insanlar da hak ediyor demektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320111
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320111,
					"content": "Evet. Onların tutkularını ve hayallerini artık görmezden gelmeyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120320112,
					"content": "Yüzyıllar süren savaş konusunda...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320113
					]
				},
				{
					"id": 120320113,
					"content": "Açık konuşmak gerekirse bitmek bilmeyen bir işkenceydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320114
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120320114,
					"content": "Ebedi bir savaş olduğu için sürekli dövüşmeye odaklanmam gerekiyordu. Dikkatim bir an olsun dağılırsa Şogun'un kılıcı canımı alırdı çünkü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320115
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120320115,
					"content": "Şunu diyebilirim ki geçmişte edindiğim savaş tecrübelerim olmasaydı yeteneklerim bu dövüşü kazanmaya yetmezdi. Şüphesiz ki yenilen taraf ben olurdum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320116
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120320116,
					"content": "Sen de bana yardımcı oldun tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120320117,
					"content": "Kutsal Kiraz Ağacının aldığı hasar ile ilgili...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320118
					]
				},
				{
					"id": 120320118,
					"content": "Merak etme, o da aklımda. Tenryou ve Yashiro Heyetlerine bu konuyla ilgilenmelerini hatırlatacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320119
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120320119,
					"content": "Endişelendiğim tek şey canavarlar değil. Beni asıl kaygılandıran Kutsal Kiraz Ağacından dışarı sızabilecek diğer şeyler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320120
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120320120,
					"content": "İşte bu gerçekten korkutucu bir düşünce... Ley Hatlarında anılar haricinde de bir sürü şey bulunuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320121
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320121,
					"content": "Madem farkındasın, o halde umarım bu konuda bir çaba gösterirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120320122,
					"content": "Yae Miko dedi ki tanrının...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320123
					]
				},
				{
					"id": 120320123,
					"content": "Öhöm! Yae Miko asla öyle bir şey demedi. Üstelik Yae Miko hâlâ buradayken Gezgin ne hakla böyle asılsız iddialarda bulunuyor bakalım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320124
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320124,
					"content": "Bazı konuşmaların gizli kalması gerekir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320125
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320125,
					"content": "Bana ihanet etmenin bedelini ödemek istemezsin, inan bana. Sana anlattıklarım aramızda ufak bir sır olarak kalsın. Anlaşıldı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320126
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320126,
					"content": "Ne konuşuyorsunuz aranızda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320127
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120320127,
					"content": "Hiç. Canım birden kızarmış tofu çekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120320128,
					"content": "Başka sorum yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
}