			"dialogs": [
				{
					"id": 721280401,
					"content": "Harika! İstediğim deniz kabuğu tam da buydu! Bir sandık seçip açabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280402,
						721280403
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280402,
					"content": "... Sadece bir tane mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280404
					]
				},
				{
					"id": 721280404,
					"content": "Hayır, teker teker açabilirsin ancak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280405
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280405,
					"content": "Hadi seç bakalım. İyi şanslar hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280403,
					"content": "Hepsini açamaz mıyım?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280404
					]
				}
			]
		},
