			"dialogs": [
				{
					"id": 721280501,
					"content": "Herhalde açtın bir sandık? Hahaha, umarım şansın yaver gitmiştir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280502
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280502,
					"content": "Bu deniz kabuklarını mı topluyorsun yani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280503
					]
				},
				{
					"id": 721280503,
					"content": "Aynen öyle, onları topluyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280504
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280504,
					"content": "Ama henüz nedenini söyleyemem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280505,
						721280509
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280505,
					"content": "Bir özelliği mi var deniz kabuklarının?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280506
					]
				},
				{
					"id": 721280506,
					"content": "İş açısından bakarsak kesinlikle var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280507
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280507,
					"content": "\"Tatarigami etkisi altında olan deniz kabukları\"... Hahaha, iyi bir fiyata satılacakları kesin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280508
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280508,
					"content": "Öhöm! Neyse, sen bana deniz kabuğu getir, ben de sana sandık vereyim. Anladın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280511
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280511,
					"content": "Neyse, bu seferki şansını kullandın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280512
					],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280512,
					"content": "Bir hazine sandığı daha açmak istersen daha sonra deniz kabuğu getirirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Takashi"
				},
				{
					"id": 721280509,
					"content": "Sana hiç güvenmiyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280510
					]
				},
				{
					"id": 721280510,
					"content": "Alt tarafı deniz kabuğu yahu! Bu kadar paranoyak olma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280511
					],
					"speakerTitle": "Takashi"
				}
			]
		},
