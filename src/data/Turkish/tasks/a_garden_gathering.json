			"dialogs": [
				{
					"id": 761820101,
					"content": "Demek eskiden burada yaşıyordun. Çok hoş bir yermiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820102
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761820102,
					"content": "Eskiden daha da güzeldi. Bahçe işlerine elim epey yatkındır, bilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820103
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761820103,
					"content": "Haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820104
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761820104,
					"content": "Şimdi neye gülüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820105
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761820105,
					"content": "Sadece seni yere çömelmiş, çiçeklerle ilgilenirken hayal ettim de... Çok tatlı bir manzara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820106
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761820106,
					"content": "İçeriye bir göz atabilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820107
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761820107,
					"content": "Tabii ki. Çoktan temizleyip pırıl pırıl yaptım bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820108
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761820108,
					"content": "Burayla ilgili ne gibi planların var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820109
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761820109,
					"content": "Hımm... Sanırım burayı henüz elimden çıkarmak istemiyorum. Vakit buldukça gelip etrafa çekidüzen veririm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820110
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761820110,
					"content": "Eğer meşgulsen senin yerine burayla ilgilenebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820111
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761820111,
					"content": "Bana eski odanın verdiği hissin aynısını veriyor. Huzur verici... Mutluluk dolu bir yer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820112
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761820112,
					"content": "Hıh... Sen bilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kukla"
				}
			]
		},
