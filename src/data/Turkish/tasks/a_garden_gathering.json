			"dialogs": [
				{
					"id": 761820201,
					"content": "... Burası gerçekten çok güzel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820202,
						761820203
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761820202,
					"content": "(Biraz daha oturalım.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820204
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761820204,
					"content": "Tamam, başka zaman tekrar gelelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761820203,
					"content": "Yavaş yavaş toparlansam iyi olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761820204
					],
					"speakerTitle": "Kukla"
