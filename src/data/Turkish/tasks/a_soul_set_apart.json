				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80030101,
					"content": "Dain, işte buradasın. Kumandan Jean'i gördün mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030102,
					"content": "Gördüm, ama görmezden geldim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030103
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030103,
					"content": "Hem Aslandiş Şövalyesi hem de Büyük Kumandan Vekili olarak haliyle bana karşı birtakım çekinceleri var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030104
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030104,
					"content": "Dikkatli olmazsam günün birinde kendimi soruşturmalarının hedefinde bulabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030105
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030105,
					"content": "Esas konumuza dönelim... Hiçlik güçlerinden bazılarını bozguna uğrattım ama herhangi bir bilgi edinemedim. Siz bir şey elde edebildiniz mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030106
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030106,
					"content": "Anladım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030107
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030107,
					"content": "Peki öyleyse. İlk Biçerdöverin akıbetini aşağı yukarı tahmin edebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030108
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030108,
					"content": "Nasıl? Gerçekten mi? Sadece Poyraz Kurdu'nun hikayesinden yola çıkarak mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030109,
					"content": "O bilgileri kapsamlı bir analizle bir araya getirerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030110
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030110,
					"content": "Mesela, Katedralde duyduğun bana anlattığın o hikaye...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030111
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030111,
					"content": "\"Tiranın Yıkıcı Gazabı\"!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030112
					]
				},
				{
					"id": 80030112,
					"content": "Kesinlikle. Genç rahibenin sana anlattığı tuhaf hikaye; uzun bir süre boyunca, ölmüş bir tiranın sebep olduğu bir lanet olarak görülmüş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030113,
						80030114,
						80030126
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030113,
					"content": "Gökten yağan ateş topları muhtemelen füzelerdi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030115
					]
				},
				{
					"id": 80030115,
					"content": "Ah, Paimon şimdi anladı! \"Tiranın Yıkıcı Gazabı\" aslında Biçerdöverin Kurtlar Diyarı'ndan kaçtıktan sonra attığı füzelerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030116,
					"content": "Kuzey'in Kurdu ile olan savaşta hasar aldıktan sonra Eski Mondstadt harabelerine gidip orada kalmış olmalı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030117,
					"content": "Sonrasında, yakınına ne zaman biri gelirse BAM, GÜM! Bir sürü füze yağdırdı onlara... Tabii günün birinde bozuldu ve gökten yağan ateş topları da sonra erdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030118,
					"content": "O zamanlar Mondstadtlılar pek Harabe Muhafızı görmemişlerdi, o yüzden bu olayı \"Tiranın Yıkıcı Gazabı\" olarak yorumladılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030119,
					"content": "Görünüşe göre <color=#00E1FFFF>Fırtına Dehşeti'nin İnine</color> gidip tüm bölgeyi temizlememiz gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030120,
						80030121
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030120,
					"content": "Hayır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030122
					]
				},
				{
					"id": 80030122,
					"content": "Hım. Ne demek istiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030123
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030123,
					"content": "Ben... Hatırlıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030124
					]
				},
				{
					"id": 80030124,
					"content": "Ne? Yani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030125,
					"content": "Şey, Paimon da hatırlıyor! Terk edilmiş bir halde <color=#00E1FFFF>kulenin tepesinde oturan Harabe Muhafızını</color> oraya önceki gidişimizde görmüştük! Böyle bir şeyi unutmam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030121,
					"content": "Gerek yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030122
					]
				},
				{
					"id": 80030114,
					"content": "Mondstadt'ın eski sakinleri ateş toplarının gerçekte ne olduğunu anlamamıştır...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030115
					]
				},
				{
					"id": 80030126,
					"content": "Aslında rahibe, Barbara...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030115
					]
				}
			]
		},
		{
			"id": 800302,
