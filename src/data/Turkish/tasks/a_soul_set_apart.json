			"dialogs": [
				{
					"id": 80030601,
					"content": "Onlar... Gittiler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030602,
					"content": "#Ah, bu kadar üzülme {NICKNAME}... Onları yine buluruz! İyi tarafından bak, en azından gerçekten işe yarayabilecek bazı bilgiler elde ettik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030603,
						80030605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030603,
					"content": "Üzgün... Değilim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030604
					]
				},
				{
					"id": 80030604,
					"content": "Gerçekten mi? Emin misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030607,
					"content": "En azından şu an Dain de Yediler gibi kardeşini bulma konusunda önemli role sahip, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030608,
						80030609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030608,
					"content": "Inazuma'ya vardığımızda daha fazla ipucu ararken bunu unutmamalıyız.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030610
					]
				},
				{
					"id": 80030610,
					"content": "Bu doğru! Ah... Bu arada, az önce söyledikleri şeyler oldukça kafa karıştırıcıydı. Sen bir şey anladın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030611,
						80030612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030611,
					"content": "Bir ölçüde anladım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030613
					]
				},
				{
					"id": 80030613,
					"content": "Ah... Peki öyleyse... Üzerinden bir kez daha geçelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030614,
					"content": "#Öncelikle, Hiçliğin Habercisi {F#kardeşine \"Prens\"}{M#kardeşine \"Prenses\"} dedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030615,
					"content": "Görünüşe göre kardeşin Hiçlik Tarikatına önderlik ediyor, Hiçliğin Habercileri bile ona hesap veriyor... Tabii henüz onun tarikattaki en üst rütbeli kişi olup olmadığını bilmiyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030616,
					"content": "Üstelik kardeşin tahtları yıkmak ve kaderle savaşa girmek istediğini söyledi. Bu ne demek oluyor ki? Acaba o Yedileri ve yedi ulusu yok etmek mi istiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030617,
					"content": "Bir sonraki şey de... Meğer Hiçlik Tarikatı canavarları, Khaenri'ah halkının ulusları yok olduktan sonra dönüştükleri şeylermiş. Bu hikaye çok korkunç!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030618,
					"content": "Dain de Khaenri'ahlıymış! 500 yıl önceki yıkımı görmüş. Ama... O bir canavara dönüşmemiş ve şimdi Hiçlik Tarikatına karşı savaşıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030619,
					"content": "Bu yüzden kardeşin Dain'in düşmanı olduğunu söyledi, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030620,
					"content": "Ama... Hiçliğin canavarları, Dain'in yıllar önce koruduğu insanlarsa... Dain neden şimdi Hiçlik Tarikatına düşman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030621,
					"content": "Ayrıca, nasıl oluyor da... Kardeşini bunca zamandır arıyoruz ve en sonunda Hiçliğin tarafında olduğu ortaya çıkıyor. Bu nasıl oluyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030622,
						80030623
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030622,
					"content": "Bir sürü yeni sorumuz ama çok az cevabımız var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030624
					]
				},
				{
					"id": 80030624,
					"content": "Evet, haklısın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030625,
					"content": "#Öyleyse... Hemen moralimizi bozmayalım {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030626,
					"content": "Yolculuğumuz henüz bitmedi, hadi yola koyulalım! Bu korkunç, karanlık yeri terk edip yeryüzüne, güneşin parıldadığı yere geri dönme zamanı geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030627,
					"content": "Kardeşin \"yolculuğunun sonuna ulaşmanı\" istiyorsa... Ona kim olduğunu göster o halde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030628
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030628,
					"content": "Hadi Gezgin, gidelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030623,
					"content": "Bunları tekrar tekrar düşünmek hiçbir şeyi çözmez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030624
					]
				},
				{
					"id": 80030612,
					"content": "#{F#Kardeşime}{M#Kardeşime} fazla odaklandığım için iyi dinleyemedim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030613
					]
				},
				{
					"id": 80030609,
					"content": "Yolculuğumuz için bir amaç daha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030610
					]
				},
				{
					"id": 80030605,
					"content": "Haklısın Paimon. Hâlâ umut var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030606
					]
				},
				{
					"id": 80030606,
					"content": "Hı hı, bu doğru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030607
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}