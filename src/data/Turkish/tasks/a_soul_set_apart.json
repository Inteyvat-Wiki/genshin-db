					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80030201,
					"content": "Hey, yoksa bu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030202,
					"content": "#{F#Aether}{M#Lumine}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030203
					]
				},
				{
					"id": 80030203,
					"content": "#{F#Lumine}{M#Aether}...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030204,
						80030205
					]
				},
				{
					"id": 80030204,
					"content": "Sonunda seni buldum!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030206
					]
				},
				{
					"id": 80030206,
					"content": "#Bir saniye, {NICKNAME}... O az önce Hiçliğin Habercisine yapılan bir saldırıyı engelledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030207,
					"content": "Kardeşin ve Hiçlik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030208,
					"content": "#{F#Lumine}{M#Aether}, sen neden Dain'lesin?",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030209,
						80030210
					]
				},
				{
					"id": 80030209,
					"content": "Ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030211,
						80030212
					]
				},
				{
					"id": 80030211,
					"content": "(Çok uzun zamandır ayrı düşmüştük...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030213
					]
				},
				{
					"id": 80030213,
					"content": "Ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030214,
					"content": "#{NICKNAME}, Kardeşin Dain'i tanıyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030215,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030216
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030216,
					"content": "#{F#Aether}{M#Lumine}. Tekrar karşılaştık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030217
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030217,
					"content": "N-Neler oluyor burada? Dain de onu tanıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030218,
					"content": "Bu adamla birlik olmamalıydınız.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030219
					]
				},
				{
					"id": 80030219,
					"content": "O benim düşmanım.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030220
					]
				},
				{
					"id": 80030220,
					"content": "#{F#Aether}{M#Lumine}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030221,
						80030222
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030221,
					"content": "Bekle bir saniye!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030223
					]
				},
				{
					"id": 80030223,
					"content": "...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030224
					]
				},
				{
					"id": 80030224,
					"content": "Ama söylenmesi gerekiyor... Beni durdurmaya çalışma. Hiçliği durdurmaya kalkma.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030225
					]
				},
				{
					"id": 80030225,
					"content": "Şu adam, Dainsleif, \"Alacakaranlık Kılıcı\". Son Khaenri'ah Hanedanının sadık muhafızlarından biriydi. 500 yıl önce Khaenri'ah'nın yıkılışını önlemeyi başaramadı.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030226
					]
				},
				{
					"id": 80030226,
					"content": "Ölümsüzlükle lanetlendi ve sonsuza dek ıssız topraklarda dolaşmaya mahkum oldu... Bu esnada da korumakla yükümlü olduğu insanların, gözünün önünde Hiçliğin canavarlarına dönüşmesini izledi.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030227
					]
				},
				{
					"id": 80030227,
					"content": "Yani diyorsun ki... Dain, Khaenri'ahlı mı? 500 yıl önce yıkılmış Khaenri'ah mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030228,
					"content": "İnsanların canavarlara dönüştüğünden bahsettin... Paimon'a Hiçlik Tarikatının Khaenri'ah ile sadece bağlantılı olmadığını, aslında Khaenri'ah halkı olduğunu mu söylemeye çalışıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030229,
					"content": "Ah... Bir de Dain'in senin düşmanın olmasıyla ilgili durum... Paimon'un kafası çok karıştı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030230,
						80030231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030230,
					"content": "#Benimle gel {F#Aether}{M#Lumine}! Eve gidelim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030232
					]
				},
				{
					"id": 80030232,
					"content": "Yuva...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030233
					]
				},
				{
					"id": 80030233,
					"content": "Evet, tabii ki. \"Yuva\" bizim bir arada olduğumuz yer.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030234
					]
				},
				{
					"id": 80030234,
					"content": "Ama yeni bir ev bulmak için seninle başka bir dünyaya gidemem... En azından şimdilik.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030235
					]
				},
				{
					"id": 80030235,
					"content": "Hiçlik tahtları yutana dek kader ile olan savaşım bitmeyecek...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030236
					]
				},
				{
					"id": 80030236,
					"content": "Kader mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030237
					]
				},
				{
					"id": 80030237,
					"content": "#Dinle beni {F#Lumine}{M#Aether}.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80030238
					]
				},
				{
					"id": 80030238,
					"content": "Bu dünyadan bir kez zaten geçtim. Benim gibi yolculuğunun sonuna geldiğinde bu dünyanın gerçek yüzünü kendi gözlerinle göreceksin.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": []
				},
				{
					"id": 80030231,
					"content": "Tüm bunları bana daha sonra da anlatırsın. Eve gidelim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030232
					]
				},
				{
					"id": 80030222,
					"content": "#Anlamsız şeyler söylemeyi bırak {F#Aether}{M#Lumine}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030223
					]
				},
				{
					"id": 80030212,
					"content": "(Neden önemsiz bir şeyi soruyorsun?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030213
					]
				},
				{
					"id": 80030210,
					"content": "Dain'i mi soruyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030211,
						80030212
					]
				},
				{
					"id": 80030205,
					"content": "Hadi gidelim buradan, burası çok tehlikeli!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030206
					]
				}
			]
		},
