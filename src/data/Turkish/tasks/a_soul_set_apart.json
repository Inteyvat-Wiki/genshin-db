				"points": []
			},
			"dialogs": [
				{
					"id": 80030301,
					"content": "Burası, değil mi? Hadi öyleyse, Element Görüşünü kullanarak gözü ara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030302,
					"content": "Ah... Peki neler gördün?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030303,
					"content": "Ne? Hiçbir şey mi? Ama Paimon çok heyecanlanmıştı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030304,
					"content": "Neler oluyor? Doğru yaptığına emin misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030305,
					"content": "Bunun için başka bir yöntem olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030306
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030306,
					"content": "Element Görüşünü Biçerdöver üzerinde kullanmak işe yaramaz çünkü ona güç veren şey elementler değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030307
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030307,
					"content": "Denememe izin ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030308
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030308,
					"content": "İşte oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030309
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030309,
					"content": "Vay canına! Bu, bu şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030310,
					"content": "Hiçliğin Habercisinin en başından beri aradığı şey... İlk Biçerdöverin gözü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030311
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030311,
					"content": "Günümüzün tüm Harabe Muhafızları bu makinanın kopyaları. Prototip olarak savaş becerileri sınırsızdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030312
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030312,
					"content": "\"Prototip\" mi? Paimon o kelimenin ne demek olduğunu bilmiyor. Khaenri'ah'dan kalma başka bir kadim terim mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030313,
					"content": "Hiçlik Tarikatının tahmin ettiği gibi bu göz, Kirli Heykelin ellerine yerleştirilirse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030314
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030314,
					"content": "Ayrıca Girdabın Lordu Osial'ın uzuvları da heykele eklenirse... Mekanik bir tanrı yaratmış olursun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030315
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030315,
					"content": "Bu yeni doğan tanrı da \"Kutsal Diyar'ın semavi tahtlarını yıkmak\" için gerekli güce sahip olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030316,
						80030317
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030316,
					"content": "Ne kadar ölçüsüz ve tehlikeli bir işlem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030318
					]
				},
				{
					"id": 80030318,
					"content": "Evet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030319
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030319,
					"content": "Peki sonra... Bu gözle ne yapmalıyız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030320,
						80030321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030320,
					"content": "Kimsenin bulamayacağı bir yere saklayın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030322
					]
				},
				{
					"id": 80030322,
					"content": "Hayır. Onu ben koruyacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030323
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030323,
					"content": "Ne? Sen mi? Dain... Onunla çılgınca bir şeyler yapmazsın, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030324,
					"content": "İstediğin kadar şüphe duyabilirsin ama yanlış ellere geçmediğinden emin olmak zorundayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030325
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030325,
					"content": "Onu nereye saklarsak saklayalım bir şekilde bulacaklardır. Favonius Kilisesine gelirsek... Onlara güvenmediğimi biliyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030326
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030326,
					"content": "Ah, haha... Doğru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030327,
					"content": "Ama işimiz daha bitmedi. Gelecekte olabilecek herhangi bir aksiliği önlemek için Kirli Heykelin de icabına bakmamız gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030328,
						80030329
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030328,
					"content": "Tam olarak ne yaparak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030330
					]
				},
				{
					"id": 80030330,
					"content": "Kiliseyi bu işe karıştıramayız. Bunu kendimiz halledelim. Nasıl yapacağımıza gelince... Tabii ki onu tamamen yok etmeyi kastediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030331
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030331,
					"content": "Y-Yok etmek mi? Ama o Yedilerin Heykeli! Önemli bir kültürel yadigar olmasının yanı sıra kutsal da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030332,
					"content": "Öf, peki, neyse ki daha önce Barbara'ya söylemedik. Yoksa çılgına dönerdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030333,
					"content": "Hım... Yediler, onlara ait olan bir şeye göz kulak olmamı bekliyorlar mı gerçekten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030334
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030334,
					"content": "Hadi <color=#00E1FFFF>o harabelere</color> geri dönelim ve ters çevrilmiş heykeli yok edelim. Şanslı günümüzdeysek Hiçliğin Habercisine de rastlarız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030335
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030335,
					"content": "Bu sefer kaçmasına izin vermeyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030329,
					"content": "Bu işi kiliseye bıraksak olmaz mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030330
					]
				},
				{
					"id": 80030321,
					"content": "Favonius Kilisesinin himayesine bırakın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030322
					]
				},
				{
					"id": 80030317,
					"content": "Hiçlik Tarikatı durdurulmalı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80030318
					]
				}
			]
		},
