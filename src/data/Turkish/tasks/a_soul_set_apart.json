			"dialogs": [
				{
					"id": 80030501,
					"content": "Sanırım vardık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030502
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030502,
					"content": "Tekinsiz, cansız, karanlık yer... Daha önce bahsettiğin o şeytani aurayı şimdi anlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030503
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030503,
					"content": "Ah... Ne korkunç bir yer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80030504,
					"content": "Kirli Heykelin gücünden etkilenmemeye dikkat edin. Hiçliğin Habercisi burada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030505
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030505,
					"content": "Hahahaha... Doğru hissettin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030506
					],
					"speakerTitle": "Hiçliğin Habercisi"
				},
				{
					"id": 80030506,
					"content": "Her zamanki gibi can sıkıcısın Dainsleif, Hiçliğin düşmanı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030507
					],
					"speakerTitle": "Hiçliğin Habercisi"
				},
				{
					"id": 80030507,
					"content": "Korkunç katliamdan dolayı ruhunun lekelendiğini hissediyorum belki de gördüğün karanlık kabuslarından. Tabii eğer... Hı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030508
					],
					"speakerTitle": "Hiçliğin Habercisi"
				},
				{
					"id": 80030508,
					"content": "Ah, bu daha da tehlikeli bir şey! Bana çok tanıdık gelen bir yozlaşma kokusu var sende...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030509
					],
					"speakerTitle": "Hiçliğin Habercisi"
				},
				{
					"id": 80030509,
					"content": "Aynıyız öyleyse. İkimiz de tehlikeliyiz. Fakat Hiçlik Tarikatının dışındaki tehlikeler yakalanmalı ve zincire vurulmalı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030510
					],
					"speakerTitle": "Hiçliğin Habercisi"
				},
				{
					"id": 80030510,
					"content": "Olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030511
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030511,
					"content": "Asıl senin sözlerin sonsuz bir yozlaşma içinde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80030512
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80030512,
					"content": "Sesini kesmenin zamanı gelmiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				}
			]
