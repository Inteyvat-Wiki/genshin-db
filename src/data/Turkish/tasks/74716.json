			},
			"dialogs": [
				{
					"id": 747160101,
					"content": "Süper... Büyük çöplerin neredeyse hepsi çıkarıldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160102
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160102,
					"content": "Bu kadar uğraşmak zorunda kaldığınız için üzgünüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160103
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160103,
					"content": "Özür dilemene hiç gerek yok Freminet! Paimon'a sorarsan \"iş\" yapmıyorduk zaten, sudan harika ganimetler çıkarıyorduk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160104,
						747160105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160104,
					"content": "Doğanın rahat bir nefes almasına da yardımcı olduk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160106
					]
				},
				{
					"id": 747160106,
					"content": "Teşekkür ederim... O kadar mutlu ve dolu dolu vakit geçirdim ki, hepsi sizin sayenizde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160107
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160107,
					"content": "Ne demek! Hem bu bir takım işiydi! Ayrıca Paimon senin gerçekten büyük bir ilerleme kaydettiğini düşünüyor. Hem su altında hem de karada bize çok yardımın dokundu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160108,
					"content": "Utanıp kızarmana hiç gerek yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160109
					]
				},
				{
					"id": 747160109,
					"content": "Ha, ıı... Peki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160110
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160110,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160111
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160111,
					"content": "Özür dilerim, böyle anlarda teşekkür etmek dışında ne diyebileceğimi gerçekten bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160112
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160112,
					"content": "Belki de... Biraz daha pratik yapmam gerekiyordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160113
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160113,
					"content": "Rahat ol, hiç aceleye gerek yok. Kendi temponda ilerlemeye devam etsen yeter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160114,
						747160115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160114,
					"content": "Fırsatımız olursa ileride yine birlikte çalışalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160116
					]
				},
				{
					"id": 747160116,
					"content": "Tamam, anlaştık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160117
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160117,
					"content": "... Hazır temizlik de bitmişken biraz kafa dinlemek için su altına dönerim diyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160118
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160118,
					"content": "Ama işin garibi, sizinle konuştuktan sonra... Gökyüzü bile daha bir dingin görünür oldu sanki. Bu hissi... Sizinle de paylaşmak istedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160119
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160119,
					"content": "Neyse... Ben yavaştan döneyim, Lyney ve diğerleriyle buluşsam iyi olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160120
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160120,
					"content": "Su altı araştırma verilerinin geri kalanı size emanet. Umarım aradığınızı bulursunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160121
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747160121,
					"content": "Sevinç çığlıklarınızı ta yukarı güverteden duydum. Hayrola, güzel bir haber mi var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160122
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747160122,
					"content": "Evet! Balıkçıkların canını sıkan tüm o çöpleri temizledik sayılır. Üstelik piyanonun eksik parçalarını da bulduk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160123,
					"content": "Öyle mi? Dur bir bakayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160124
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747160124,
					"content": "... Vay be. Bu parçalarla piyanoyu nihayet tamir edebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160125
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747160125,
					"content": "Belki tıpatıp eski günlerdeki gibi olmaz ama yine de güzel müzikler çalabileceğine eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160126
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747160126,
					"content": "Yaa! Bayağı mutlu olmuş gibisin Sandrone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160127,
					"content": "Ö-Öyle mi? Neyse, ben bir koşu gidip bunu tamir edeyim. Çok uzun sürmez. Zahmet olmazsa siz de buraya biraz çekidüzen verebilir misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160128
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747160128,
					"content": "Böylesine harika bir enstrüman, şanına yaraşır bir sahneyi hak ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160129
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747160129,
					"content": "Ayy... Cidden çok mutlu görünüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160130,
					"content": "Vay canına! Ne kadar güzel bir piyano!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160131,
						747160132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160131,
					"content": "Çok zarif!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160133
					]
				},
				{
					"id": 747160133,
					"content": "Hıh, tabii ki öyle. Sonuçta onu tamir eden benim! Mekanik bağlantıları güçlendirdim, dışını da yeniledim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160134
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747160134,
					"content": "Siz ikiniz de fena iş çıkarmamışsınız. Bu piyanoya yaraşır bir sahne olmuş burası.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160135
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747160135,
					"content": "Hehe, rica ederiz! Neyse, bu kadar sohbet yeter. Bize bir şarkı çalmayacak mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160136,
					"content": "... Ha? Şimdi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160137
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747160137,
					"content": "Başka ne zaman olacak ki? Çalmayacaksan piyanoyu neden tamir ettik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747160138,
					"content": "Bak ne diyeceğim... Bugünlük performansı pas geçelim! Nasılsa daha sonra size çalmak için bolca vaktim olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160139,
						747160140
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747160139,
					"content": "Notalarını mı unuttun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160141
					]
				},
				{
					"id": 747160141,
					"content": "Hıh... Külliyen saçmalık! B-Ben sadece bir süre onunla sessizce oturup eski günleri yad etmek istiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160142
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747160142,
					"content": "Sizin lafınızla gaza gelip çalacağımı falan sanmayın. Hıh, önce prova, sonra gösteri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747160140,
					"content": "Utanıyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160141
					]
				},
				{
					"id": 747160132,
					"content": "Muhteşem!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160133
					]
				},
				{
					"id": 747160115,
					"content": "Ne zaman yardıma ihtiyacın olursa biz hep yanındayız.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160116
					]
				},
				{
					"id": 747160105,
					"content": "Bir de üstüne bir sürü hazine bulduk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160106
					]
				}
			]
		}
	]
}