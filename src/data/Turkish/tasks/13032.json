			"dialogs": [
				{
					"id": 130320601,
					"content": "Rüya... Sona erdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320602
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320602,
					"content": "Çok güzel bir rüya gördük.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320603
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320603,
					"content": "Bu kadar üzgün durma! O seninle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320604
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320604,
					"content": "Arashani! Hâlâ... Buradasın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320605
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320605,
					"content": "Arashani üzgün olduğunu söylemek istiyor. Arashani, Narayı bulmaktan vazgeçmemişti. Arashani yalnızca zamanı unuttu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320606
					],
					"speakerTitle": "Arashani"
				},
				{
					"id": 130320606,
					"content": "Arashani şehre girmeye cesaret edemiyor. Ayrıca Arashani, Nara Avin'i görmedi, bu yüzden onun yeni arkadaşlar edindiğini düşündü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320607
					],
					"speakerTitle": "Arashani"
				},
				{
					"id": 130320607,
					"content": "Bu kaçınılmaz ve normal bir durum. Üzülmene gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320608
					],
					"speakerTitle": "Arapurva"
				},
				{
					"id": 130320608,
					"content": "Sorun yok, seni anlıyorum. Kendimi kaybettiğim için böyle davrandım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320609
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320609,
					"content": "Fakat artık gözlerim açıldı. Yoimiya haklıymış. Herkes bazen şanssız olabilir ama böyle anlarda birbirimize destek olmalıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320610
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320610,
					"content": "Anılarımı ve hayallerimi yeniden bulmama yardım ettiğin için teşekkür ederim. Çabalarının boşa gitmesine izin vermeyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320611
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320611,
					"content": "Hehe, ayrıca bize fazlasıyla yardım ettin. O yüzden bu kadar mütevazı davranmana gerek yok! Açıkçası Ur Taşını nerede aramamız gerektiğini bilmiyorduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320612
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320612,
					"content": "Ama şimdi Ur Taşının nerede olduğunu bildiğimize göre onu bulmakta zorlanmayacağız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320613
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320613,
					"content": "Yoimiya, meteor yağmurunu izlemek istediğin için mi Ur Taşını arıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320614
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320614,
					"content": "Evet. Ha, onu bulduğumuzda sen de bizimle gelmelisin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320615
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320615,
					"content": "Durum buysa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320616
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320616,
					"content": "Size kendi Ur Taşımı ödünç verebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320617
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320617,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320618,
					"content": "N-Ne oldu? Biraz önce... Gözlüğü göğsünden mi çıkardın sen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320619,
					"content": "Ne olup bittiğine dair benim de bir fikrim yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320620
					]
				},
				{
					"id": 130320620,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320621
					],
					"speakerTitle": "Arapurva"
				},
				{
					"id": 130320621,
					"content": "Hahaha, buna ihtiyacımız olduğunu nasıl bildin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320622
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320622,
					"content": "Bilmiyordum. Değerli arkadaşımı bulmama yardım ettiğin için ben de benim için değerli olan bir şeyle karşılık vermek istedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320623
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320623,
					"content": "Ardından ışık buna dönüştü. İhtiyacın olan şey bu mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320624
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320624,
					"content": "Teşekkürler. Sorunumuzu böyle çözebileceğimizi düşünmemiştim. O halde deneme yapma zamanı geldi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320625
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320625,
					"content": "Bunu nasıl kullanacağımı bilmiyorum ama sezgilerime güveneceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320626
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320626,
					"content": "Neredesin? Nerede olabilirsin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320627
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320627,
					"content": "Ah! Sanırım biliyorum! Aslında gayet açık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320628
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320628,
					"content": "Beni takip edin! Meteor yağmurunu izledikten sonra seni eve bırakırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320629
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320629,
					"content": "Bize yardım ettiğiniz için teşekkür ederiz! Nezaketi bir kenara bırakıp size içten bir iltifat edeceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320630
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320630,
					"content": "Hepiniz muhteşem hikayecilersiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320631
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320631,
					"content": "Vay canına, ne tesadüf! Ben de senin için aynısını söyleyecektim Kırmızı Nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapurva"
				}
			]
		},
