			"dialogs": [
				{
					"id": 130320101,
					"content": "Şey, Paimon \"hazır olmak\" derken neyi kastettiğini merak ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320102,
					"content": "Nara Avin her şeyi tam olarak anımsamıyor. Anılar da rüyalar da gerekli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320103
					],
					"speakerTitle": "Arapurva"
				},
				{
					"id": 130320103,
					"content": "Rüyalar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320104
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320104,
					"content": "Ama bir daha asla yürüyemeyeceğim. İyileşmem mümkün olsa bile bunun ne kadar süreceğini bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320105
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320105,
					"content": "Burada böyle şeyler için endişelenmen gereksiz. Nara Avin, hatırlaman gerek. Rüyalar bedenine değil, kalbine bağlıdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320106
					],
					"speakerTitle": "Arapurva"
				},
				{
					"id": 130320106,
					"content": "Kalbime mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320107
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320107,
					"content": "Seni buraya kadar getirdim ama şimdi Nara Avin, onun için değerli olanları tek başına bulmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320108
					],
					"speakerTitle": "Arapurva"
				},
				{
					"id": 130320108,
					"content": "Ne? Birdenbire öylece gitti mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320109
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320109,
					"content": "Gökyüzü biraz değişmiş gibi görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320110
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320110,
					"content": "Kalbim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320111
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320111,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320112
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320112,
					"content": "Ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320113,
					"content": "Ben... Ayağa kalktım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320114
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320114,
					"content": "Bunu yapmak hiç de zor ya da tuhaf değildi. Tıpkı... Rahatsızlanmadan önce olduğu gibi kolayca ayağa kalktım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320115
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320115,
					"content": "Bekle, öyleyse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320116,
					"content": "Bir rüyanın içindeyiz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320117
					]
				},
				{
					"id": 130320117,
					"content": "İlk kez bir rüyaya dalmıyoruz. Ah, Arapurva'nın endişelenme demesine şaşırmamak gerek... Avin bu rüyada istediği gibi hareket edebiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320118,
					"content": "Vay be, harika, bu... Kalbimin gücü mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320119
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320119,
					"content": "Harika! Şimdi hep beraber Arashani'yi arayabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320120
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320120,
					"content": "Hadi yarışalım! Ne kadar iyi koştuğunu görmek istiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320121
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320121,
					"content": "Tamamen iyileşmemiş olabilirim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320122
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320122,
					"content": "Neyse, hadi gidelim! Bir yetişkine asla kaybetmeyeceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320123
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320123,
					"content": "Ah, işte gidiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320124,
					"content": "Bu kolay oldu. Paimon daha fazla zamana ihtiyacı olacağını düşünmüştü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320125,
						130320126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320125,
					"content": "Yetenek dedikleri şey bu olmalı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320127
					]
				},
				{
					"id": 130320127,
					"content": "Hehe, doğru. Hadi onlara yetişelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320126,
					"content": "Bu bir dileğin gücü!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320127
					]
				}
			]
