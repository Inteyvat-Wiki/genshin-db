			},
			"dialogs": [
				{
					"id": 130321105,
					"content": "Sumeru harika bir yer. Geri geleceğimden emin olabilirsiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321106
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321106,
					"content": "Kapımız sana daima açık. Avin seni tekrar görmekten mutluluk duyacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321107
					],
					"speakerTitle": "Niousha"
				},
				{
					"id": 130321107,
					"content": "Anlaştık! Seni bekleyeceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321108
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130321108,
					"content": "Hahaha, geri döneceğime söz veriyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321109
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321109,
					"content": "Yoimiya, gitmeden önce sana yeni hayalimi anlatmalıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321110
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130321110,
					"content": "Inazuma'ya tek başıma seyahat etmek ve orada havai fişek gösterisi izlemek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321111
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130321111,
					"content": "Vay canına, çok etkilendim! Hehe, tatildeyken yeni müşterilerle tanışacağımı hiç düşünmemiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321112
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321112,
					"content": "Merak etme, sana asla unutamayacağın havai fişekler yapacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321113
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321113,
					"content": "Hey, siz ikiniz! Maceralarınız ne kadar heyecanlı olursa olsun Inazuma'ya geri dönmeyi unutmayın. Sizi burada yeniden görmek bizi her zaman mutlu eder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321114
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321114,
					"content": "Meteor yağmurundan ilham alarak yapacağım havai fişekleri görmeye mutlaka gelmelisiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321115
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321115,
					"content": "Anlaştık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321116,
						130321118,
						130321120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130321116,
					"content": "Sağlıcakla kal Yoimiya!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321117
					]
				},
				{
					"id": 130321117,
					"content": "Elbette! Haha, her zamanki gibi ciddisin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321122
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321122,
					"content": "Doğru. Bu arada, şuna baksana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321123
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321123,
					"content": "Bir Aranara Oyması...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321124
					]
				},
				{
					"id": 130321124,
					"content": "Haklısın. Bu oymayı seçmeme yardım etmiştin ve bana benzediğini söylemiştin. Ben de bir tane daha almaya gittim. Bu senin için.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321125
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321125,
					"content": "Kendini ne zaman kötü hissedersen ona bak. Belki moralini yükseltir. Yükseltemese bile en azından seni hep desteklediğimi bileceksin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321126
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321126,
					"content": "Yine de yüz yüze görüşmeyi tercih ederim. Hehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321127,
						130321128
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321127,
					"content": "Teşekkür ederim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321129
					]
				},
				{
					"id": 130321129,
					"content": "Pekala, artık geri dönüyorum. Yakında tekrar görüşeceğimize eminim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321130
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321130,
					"content": "Benim için hazırladığınız geziye bayıldım. Hatta oldukça etkilendim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321131
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321131,
					"content": "Nereye giderseniz gidin dostluğumuzun ve güzel hislerinin sizinle olacağını biliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321132
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321132,
					"content": "İlerlemeye devam edin. Yolculuğunuzun ve bu dünyanın sonuna dek ilerleyin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321133
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321133,
					"content": "Görüşürüz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321128,
					"content": "Onu sonsuza dek saklayacağım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321129
					]
				},
				{
					"id": 130321118,
					"content": "Umarım hep mutlu olursun!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321119
					]
				},
				{
					"id": 130321119,
					"content": "Her gün ve sonsuza kadar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321122
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321120,
					"content": "Havai fişekler geçicidir ama arkadaşlık sonsuza dek sürer!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321121
					]
				},
				{
					"id": 130321121,
					"content": "Ne-Neden böyle bağırdın? Bu utanç verici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321122
					],
					"speakerTitle": "Yoimiya"
				}
			]
		}
