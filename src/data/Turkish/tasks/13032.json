					"nextDialogs": [
						130320904
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320904,
					"content": "Tıpkı havai fişeklere benziyorlardı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320905
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320905,
					"content": "Ah, bunu sonsuza dek izleyebilirdim. Bu şimdiye dek gördüğüm en gerçek, en muhteşem, en büyülü rüyaydı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320906
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320906,
					"content": "Paimon da böyle düşünüyor! Paimon bizi o kayan yıldıza doğru çekmeni beklemiyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320907,
					"content": "Hehe! Açıkçası bunu önceden planlamamıştım. Çılgınca bir şey denememiz gerektiğini düşündüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320908,
						130320909
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320908,
					"content": "Yoimiya, sen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320910
					]
				},
				{
					"id": 130320909,
					"content": "Bunun bir rüya olduğunu zaten biliyordun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320910
					]
				},
				{
					"id": 130320910,
					"content": "Beni bilirsin. Deneyimlediğimiz şeylerin gerçek veya rüya olmasının benim için hiçbir önemi yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320911
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320911,
					"content": "Yine de size teşekkür etmeliyim. Bütün bunlar yedek planınızdı çünkü meteor yağmurlarını bulmanın zor olduğunu biliyordunuz, haksız mıyım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320912
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320912,
					"content": "Endişelenmeyin, bu rüyayı çok sevdim! Bence şimdiye dek aldığım en güzel hediyeydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320913
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320913,
					"content": "Bu iyi haber! Paimon gerçeği duyduktan sonra sinirlenebileceğinden korkuyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320914
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320914,
					"content": "Neden sinirleneyim ki? Rüyamda yardımsever, arkadaş canlısı ve şirin Aranaraları gördüm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320915
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320915,
					"content": "Ayrıca büyük mantarların üzerine koşarak zıpladığımızı ve Ur Taşını hiç beklenmedik bir şekilde keşfettiğimizi gördüm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320916
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320916,
					"content": "Tam uyandık derken gördüğüm diğer bölüm de muhteşemdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320917
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320917,
					"content": "Avin, kalbinden Ur Taşı gözlüklerini çıkardı. Yerden gökyüzüne doğru yükselen meteorlar bulduk, kayan yıldızlarla bir olduk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320918,
						130320919
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320918,
					"content": "Bir rüyanın içindeydik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320920
					]
				},
				{
					"id": 130320919,
					"content": "Ama uyandığımızı kim söyleyebilir ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320920
					]
				},
				{
					"id": 130320920,
					"content": "Haklısın. Rüyalar hayal ürünü olabilir ama aynı zamanda da tekrar yaşanamayacak ya da kopyalanamayacak deneyimlerdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320921
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320921,
					"content": "Gerçeklere ve uydurmacalara bu kadar takılıp kalsaydık asıl güzellikleri ve duyguları fark edemezdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320922
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320922,
					"content": "Hehe, iyi dedin! Paimon seni, \"Paimon'un En İyi Arkadaşları\" listesinde birkaç sıra yukarı taşıyacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320923
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320923,
					"content": "Demek bunun bir sıralaması var...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320924
					]
				},
				{
					"id": 130320924,
					"content": "Ha, bu arada... Aranaralardan bahsetmişken, onlar genelde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320925
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320925,
					"content": "Ah, evet! Çok şirinlerdi. Bu sevimli oymalara teşekkür etmeliyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320926
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320926,
					"content": "Oymalara mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320927
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320927,
					"content": "Doğru. Oymaları görmeseydik bu şirin Aranaraları hayal etmemiz mümkün olmazdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320928
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320928,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320929,
						130320930
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320929,
					"content": "Yoimiya bizi anladı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320931
					]
				},
				{
					"id": 130320930,
					"content": "Bence oymalardaki hallerinden daha şirinler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320931
					]
				},
				{
					"id": 130320931,
					"content": "Hehe! Endişelenme, biliyorum. Bence çok şirinler. Ayrıca onları koruduğum için mutluyum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320932
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320932,
					"content": "Onu eve götürme vakti neredeyse geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130321101,
					"content": "Avin'i eve götürdükten sonra Yoimiya ile Sumeru'da birkaç gün daha vakit geçiriyorsunuz.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130321102
					]
				}
			]
		},
