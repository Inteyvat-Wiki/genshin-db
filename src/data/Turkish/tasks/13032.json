				{
					"id": 130320201,
					"content": "*nefes nefese kalır* Sen... Gerçekten iyi bir koşucuymuşsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320202
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320202,
					"content": "Hehe, biraz daha koşsaydık bana yetişebilirdin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320203
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320203,
					"content": "Avin, Yoimiya ile baş başa gidiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320204,
					"content": "Daha önce pek çok yetişkini geride bıraktım. Uzun bacaklar daha iyi koşabildiğin anlamına gelmez. Antrenman yapmak da önemlidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320205
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320205,
					"content": "Haha! Birkaç yıl sonra seninle rekabet bile edemeyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320206
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320206,
					"content": "Hımm, biraz düşüneyim... Sonraki durağımız neresi olmalı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320207
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 130320207,
					"content": "Hey, baksana! İleride bir şey var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130320208,
					"content": "Bu bir yıldıza benziyor!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320209
					]
				},
				{
					"id": 130320209,
					"content": "Onu takip etmemizi istiyor olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320210
					],
					"speakerTitle": "Avin"
				},
				{
					"id": 130320210,
					"content": "Hımm, belki. Hadi gidip bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
