				},
				{
					"id": 750910311,
					"content": "Nasıl çığlık attığını duymuyor musunuz? \"Vay canınaaaaa!\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910312
					]
				},
				{
					"id": 750910312,
					"content": "Alakası bile yok! Paimon'u korkutmaya çalışıyorsun yine!",
