			"dialogs": [
				{
					"id": 750910501,
					"content": "Baksanıza, öncekinden çok daha iyi... Bunu daha önce görmeme rağmen yine de çok büyüleyici geliyor bana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910502,
					"content": "Hehe, izleyin yabancılar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910503
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910503,
					"content": "Kendi gözlerinizle de gördüğünüze göre Hazine Taşının yüceliğini inkar edemezsiniz artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910504
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910504,
					"content": "Ha bu arada, getirdiğiniz kayalar sayesinde Hazine Taşı artık çok daha güçlü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910505
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910505,
					"content": "Acaba sonunda ne kadar güçlü olacak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910506
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910506,
					"content": "Sen böyle deyince, Paimon da merak etti bak şimdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910507,
					"content": "Tek yapman gereken onu kayayla beslemek, sonrasında çok daha iyilerini veriyor... Peki bu nasıl çalışıyor? Kırıp içine bakmaya ne dersiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910508,
					"content": "Bö-Böyle bir şey teklif dahi edilemez! Hayır, asla izin vermem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910509
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910509,
					"content": "Gerçekten de içini açıp bakmayı aklınızdan geçiriyorsanız eğer... Önce benim cesedimi çiğnemeniz gerekir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910510
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910510,
					"content": "Iıı, öylesine söylemiştim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910511,
					"content": "Hıh, daha önceki taşların hepsini siz getirdiğiniz için küstahlığınızı görmezden geleceğim... Ama sadece bu seferlik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910512
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910512,
					"content": "Ta-Tamam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910513,
					"content": "Hissedebiliyorum, hehe! Onu daha kaliteli kayalarla besleyebilirsem çok daha inanılmaz şeyler çıkaracağına eminim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910514
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910514,
					"content": "Uzaklardan gelen gezgin, bir zamanlar yabancı bir tüccar bana çöllerde bulunan ve olağanüstü güce sahip olan özel bir taş türünden bahsetmişti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910515
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910515,
					"content": "Adı ise... Kan Kızılı Taşıydı. Bana o taşı getirirseniz Hazine Taşını onunla besleyebilirim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910516
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910516,
					"content": "Eminim, kesin işe yarayacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910517
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910517,
					"content": "#Hımm... Ne düşünüyorsun {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910518,
					"content": "Bir deneyelim bakalım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910519
					]
				},
				{
					"id": 750910519,
					"content": "Ne olacağını Paimon da çok merak etti şimdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910520,
					"content": "Kan Kızılı Taşını gerçekten bulabilirseniz eğer... Bir parçası bile işimizi görür...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qispi"
				}
			]
