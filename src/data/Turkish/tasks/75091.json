				{
					"id": 750910201,
					"content": "Hımm... Her şeyden önemlisi sabır. Ortalık iyice sakinleştiğinde bunlarla Hazine Taşını besleyeceğim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910202
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910202,
					"content": "Biraz beklemek gerek, hehe, sonrasında çok daha iyi kayalar çıkaracak... Hehe... Bir, iki...",
					"roleType": "TALK_ROLE_NPC",
