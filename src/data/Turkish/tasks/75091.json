			},
			"dialogs": [
				{
					"id": 750910301,
					"content": "Vay canına, gerçekten bir şeyler çıktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910302,
					"content": "Selam olsun sana, Hazine Ta.... Bir saniye, onları az önce sen koymadın, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910303,
					"content": "... Hehe, o kadar aptalca bir şey yapacak birine benziyor muyum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910304
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910304,
					"content": "Getirdiğiniz o kayalar sayesinde Hazine Taşı öncekinden çok daha enerjik hale geldi. Ah, sesi duymuyor musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910305
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910305,
					"content": "Yerin altında akan lavlar gibi ses geliyor... Bir kalp atışı gibi adeta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910306
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910306,
					"content": "Buldum... Onu biraz daha beslemem gerektiğini biliyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910307
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910307,
					"content": "Paimon hiçbir şey duymuyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910308,
					"content": "#Sen duyabiliyor musun {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910309,
						750910311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910309,
					"content": "Bence sadece sıradan eski bir kaya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910310
					]
				},
				{
					"id": 750910310,
					"content": "Doğru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910313,
					"content": "Hehe, yabancılar... Saygıdeğer misafirler desem daha doğru olur herhalde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910314
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910314,
					"content": "Bulabilirseniz eğer lütfen bana daha çok kaya bulun... Çok daha iyi ve güzellerinden olsun lütfen... Hazine Taşının gücü sizi asla hayal kırıklığına uğratmaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910315
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910315,
					"content": "İçime doğuyor... Bence işe yarayacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910316
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910316,
					"content": "Paimon gittikçe daha da büyük bir tuzağın içine çekiliyormuşuz gibi hissediyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910317,
					"content": "#Sen ne düşünüyorsun {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910318,
					"content": "Elimize çok daha iyi kayalar geçecekse eğer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910319
					]
				},
				{
					"id": 750910319,
					"content": "Denemeye kesinlikle değer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910320
