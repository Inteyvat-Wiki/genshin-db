			},
			"dialogs": [
				{
					"id": 750910101,
					"content": "Bir, iki... Hımm, üç...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910102
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910102,
					"content": "Hımm, hımm... Bir, iki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910103
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910103,
					"content": "Paimon'un tuhaflık alarmı çalmaya başladı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910104,
					"content": "Bana soracak olursanız, buradaki tek tuhaf olan şey sizsiniz yabancılar! Ha... Haha... Burası pek yabancılara göre bir yer değildir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910105
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910105,
					"content": "Burası bir çeşit... Gizli yer falan mı? Ya da kutsal falan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910106,
					"content": "Hayır, sadece tamamen tesadüfen keşfettiğim bir yer... Gömülü hazinelerle dolu. Siz de gelin hadi, toplaşın. Duyuyor musunuz? İşte gözünüzün önünde özel bir kaya. Bu... Bu işte \"Hazine Taşı\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910107
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910107,
					"content": "Çıkardığı mırıltılar bir yükseliyor bir alçalıyor... Sanki nefes alıyormuş gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910108,
						750910110
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910108,
					"content": "Kayaların hayatı da çok \"sert\", değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910109
					]
				},
				{
					"id": 750910109,
					"content": "Sadece nefes alıyor... Amma abarttın sen de!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910112,
					"content": "Nefes alabilen... Bir kaya mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910113,
					"content": "Evet, sadece bununla kalsa yine iyi... Kulağını dayadığında bir ritim... Hatta pürüzlü yüzeyinin altında birbirine sürten kayaların sesini de duyabilirsin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910114
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910114,
					"content": "Hehe... Hoho... Ne kadar da harika bir ses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910115
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910115,
					"content": "Ayrıca... Onu küçük kayalarla beslediğinde karşılığında sana çok daha iyi ve parlak kayalar verir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910116
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910116,
					"content": "Vaay, gerçekten inanılmaz, öyle değil mi? Şu mücevherlere baksana... Bir, iki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910117
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910117,
					"content": "Demek az önce buraya geldiğimizde mücevherleri sayıyordun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910118,
					"content": "Aynen, tüm o kayaları yuttuktan sonra Hazine Taşının çok daha güçlenip kuvvetlendiğini söyleyebilirim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910119
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910119,
					"content": "Bu resmen... Bir mucize! Ah, benim Hazine Taşım... Kıymetlim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910120,
						750910121
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910120,
					"content": "Bu biraz... Şüpheli duruyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910122
					]
				},
				{
					"id": 750910122,
					"content": "Hehe... Sizin gibi yabancıların bana inanmasını beklemiyordum. Denemeden kimse inanmaz çünkü buna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910123
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910123,
					"content": "Topladığım bazı cevherleri hazine taşının kenarına koyduğumda tamamen şans eseri fark ettim ben de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910124
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910124,
					"content": "Bu arada... Denemeye ne dersiniz? İnsan gözüyle görmediğine inanmaz sonuçta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910125
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910125,
					"content": "Ancak ne yazık ki buradaki tüm kayaları çoktan yedi bile, yenilerini bulmam lazım ona... Ama ben gidip de arayamam şimdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910126
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910126,
					"content": "Niye ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910127,
					"content": "Çünkü birilerinin kalıp Hazine Taşına bakması lazım. Ben yokken gidip yer altında bir yere saklanırsa neler olur, tahmin edebiliyor musun? Ne yaparım ben o zaman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910128
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910128,
					"content": "Uzun süredir burada nöbet tutuyorum... Yanımdaki kayaların hepsini ona yedirdim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910129
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910129,
					"content": "Gidin de bana biraz yeni kaya bulun, ben de size kanıtlayayım. Gözlerinizin önünde onu kayalarla besleyeceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910130
					],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910130,
					"content": "Hımm, klasik bir düzenbazın laflarına benziyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910131,
					"content": "#Ne diyorsun {NICKNAME}? Denemek ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750910132,
					"content": "Yani, sonuçta sadece kaya parçası...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910133
					]
				},
				{
					"id": 750910133,
					"content": "Hehe, anlaştık o zaman! Siz gidip bana biraz kaya bulun, sonra ben onlarla Hazine Taşını besleyeyim... Sonrasında çok daha iyilerini çıkaracağının garantisini veriyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qispi"
				},
				{
					"id": 750910121,
					"content": "Gerçekten mi? İşin içinde bir dolandırıcılık var gibi geldi bana...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910122
					]
				},
				{
					"id": 750910110,
					"content": "Ben de gayet nefes alabiliyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750910111
					]
				},
				{
					"id": 750910111,
					"content": "Evet, nefes alabilmek gayet normal bir şey... Bir dakika, neden bunu konuşuyoruz ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750910112
					],
					"speakerTitle": "Paimon"
				}
			]
		},
