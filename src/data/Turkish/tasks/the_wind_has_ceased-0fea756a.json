			"dialogs": [
				{
					"id": 700650101,
					"content": "Bazı insanlar gerçekten laftan anlamıyor. Sana zaten söylemiştim, şimdi dağa çıkmanın sırası değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650102
					],
					"speakerTitle": "Mann"
				},
				{
					"id": 700650102,
					"content": "Sinirlenme İhtiyar Mann. İki dakika sakinleşelim de şu işi konuşarak çözelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650103
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 700650103,
					"content": "Az önce Gecenin Demi'nde gayet iyi anlaşıyorduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650104
					],
					"speakerTitle": "Lipphart"
				},
				{
					"id": 700650104,
					"content": "Ama Rüzgartepe Zirvesi'ne gideceğimi söylediğim an beni tutup ta buraya kadar sürükledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650105
					],
					"speakerTitle": "Lipphart"
				},
				{
					"id": 700650105,
					"content": "Aa, Huffman bu. Burada neler oluyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700650106,
					"content": "Gördüğünüz gibi İhtiyar Mann, insanları Rüzgartepe Zirvesi'nden uzak tutmak için elinden geleni yapıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650107
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 700650107,
					"content": "Her neyse, sizi tanıştırayım. Bu Lipphart, kendisi bir maceracı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650108
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 700650108,
					"content": "Gördüklerim... Hissettiklerim... Korkunçtu! Duymak istemediğinize emin misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650109
					],
					"speakerTitle": "Mann"
				},
				{
					"id": 700650109,
					"content": "Bugün bir yere gideceğim yok gibi, o yüzden anlat da dinleyelim. Az önceki içme ve atıp tutma seansımızın devamı say.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650110
					],
					"speakerTitle": "Lipphart"
				},
				{
					"id": 700650110,
					"content": "Nasıl bir \"büyük tehlikeden\" bahsediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650111
					],
					"speakerTitle": "Lipphart"
				},
				{
					"id": 700650111,
					"content": "Sanatoryum hayaletli! Ciddiyim! Hayaletleri kendi gözlerimle gördüm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650112
					],
					"speakerTitle": "Mann"
				},
				{
					"id": 700650112,
					"content": "Hayaletler mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700650113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700650113,
					"content": "Dün gece oldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mann"
				}
			]
		}
	]
