			"dialogs": [
				{
					"id": 200010901,
					"content": "Onların icabına baktığın için teşekkür ederim Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200010902
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200010902,
					"content": "Gelmesen ne yapardım bilemiyorum. *iç çeker* Gerçi barikatlardan dolayı yolum hâlâ tıkalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200010903
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200010903,
					"content": "Burada beklemeye devam edersek meyveler çürüyecek... Onları toplamak için ne kadar uğraştım bilemezsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200010904
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200010904,
					"content": "Benim için barikatları ortadan kaldırabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200010905,
						200010906
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200010905,
					"content": "Elbette.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200010907
					]
				},
				{
					"id": 200010907,
					"content": "Sana ne kadar teşekkür etsem az!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200010906,
					"content": "Üzgünüm, vaktim yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200010908
					]
				},
				{
					"id": 200010908,
					"content": "Gerçekten mi? Birine yardım ediyorsan sonuna kadar devam etmen gerekmez mi? Neyse, son umudum sensin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quinn"
				}
			]
