			"dialogs": [
				{
					"id": 761970120,
					"content": "(test) Replik",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						761970101
					]
				},
				{
					"id": 761970101,
					"content": "Denizlerde geçirdiğim yıllarda bir keresinde nereden geldiği belli olmayan bir çağrı duymuştum. Diğerleri hiç tepki vermemişti ama ben resmen anında büyülenmiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970102
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970102,
					"content": "Başka bir dünyadan gelen bir ses olmalı. Ben de duydum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970103
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970103,
					"content": "Ancak sonradan fark ettim ki... O çağrı, uzak kıyılara ulaşamayan her hayali beraberinde taşıyordu. Bir nevi pişmanlıklar yığını denebilir buna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970104
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970104,
					"content": "Yanına bir Buz Çakılı almalısın. Ortasındaki delikten bakarsan sana kimin seslendiğini görebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970105
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970105,
					"content": "Ama o zamanlar hâlâ deli dolu ve toydum. Tehlike bile gözüme bir fırsat gibi görünüyordu. Bu yüzden hiç düşünmeden içine daldım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970106
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970106,
					"content": "Buz Çakılının merkezindeki deliğin başka bir dünyaya açılan bir geçit olduğu söylenir... Ama o delikten tam olarak nasıl geçilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970107
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970107,
					"content": "Ve daha sonra... Deniz ve onun azgın rüzgarları her şeyimi elimden aldı. Servetimi, onurumu ve hatta ailemi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970108
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970108,
					"content": "Hırs ve arzuyla çıkılan maceraların sonu asla iyi bitmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970109
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970109,
					"content": "Ah, sıkıştı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970110
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970110,
					"content": "Dur çıkarmana yardım edeyim. Bir daha da böyle bir şey yapmamaya çalış, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970111
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970111,
					"content": "Linnea! Seni tekrar buraya getiren nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970112
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970112,
					"content": "Yakınlarda Buz Çakılları topluyordum. Sizi sohbet ederken görünce bir selam vereyim dedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970113
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970113,
					"content": "Aa! Belki de başka bir dünyaya geçit açmak için bir Buz Çakılı kullanabilirsin Linnea! Eğer bunu başarabilecek biri varsa o da sensin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970114
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970114,
					"content": "Bunu ben bile yapamam. Sana daha önce de söylememiş miydim? İnsanların uydurduğu bir halk masalından ibaret bu. Arkasında hiçbir somut kanıt yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970115
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970115,
					"content": "Of... Galiba bu işe yaramayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970116
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970116,
					"content": "... Ha. Demek dinliyordun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970117
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970117,
					"content": "Öhöm... Hayır. Artık ben eski ben değilim. Bu sıralar elimdekilerle yetiniyorum ve başka da bir şey istemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970118
					],
					"speakerTitle": "Viljami"
				},
				{
					"id": 761970118,
					"content": "Tüh. O halde ben de Buz Çakılı toplamana yardım edeyim Linnea.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970119
					],
					"speakerTitle": "Auni"
				},
				{
					"id": 761970119,
					"content": "Harika olur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970124
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970124,
					"content": "Auni'nin yardımıyla malzemeler kısa sürede toplandı...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761970122
					]
				},
				{
					"id": 761970122,
					"content": "Teşekkür ederim ama ihtiyacım olan her şeyi topladım bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761970123
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761970123,
					"content": "Peki o zaman. Ben Kösbik Dede'yi ve diğerlerini görmek için Kösbik Vadisi'ne gidiyorum. Sonra görüşürüz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Auni"
				}
			]
		},
