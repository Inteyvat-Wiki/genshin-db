			"dialogs": [
				{
					"id": 761530101,
					"content": "Bugünlerde yayıncılıkta pek para yok. Belki de yatırımlara odaklanmalıyım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530102
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530102,
					"content": "Yatırım kuponlarına bakayım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530103
					]
				},
				{
					"id": 761530103,
					"content": "Buyurun. Her kupon 2.000 Mora değerinde ve yatırım vadesi haftalık olarak doluyor. Şimdi bunları keseye koyalım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530104
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530104,
					"content": "... Of!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530105
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530105,
					"content": "Sorun nedir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530106
					]
				},
				{
					"id": 761530106,
					"content": "Aa merhaba Jahoda. Burada ne yapıyorsun? Yoksa Leydi Nefer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530107
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530107,
					"content": "Ha, hayır hayır. Sadece arkadaşımla alışverişe çıktım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530108
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761530108,
					"content": "Hehe, görünüşe göre yatırım işleri çok iyi gidiyor Patron Dhabit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530109
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761530109,
					"content": "Ah, yok canım... Ay sonunu getirebilmek için ufak bir girişim işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530110
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530110,
					"content": "(Şuna bak... Kurnazlık edip her şeyi öğrenmeye çalışıyor! Kesin Nefer göndermiştir. Peh.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530111
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530111,
					"content": "Bundan gerçekten para kazanılıyor mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530112
					]
				},
				{
					"id": 761530112,
					"content": "Tabii ki! Patron Nef, Patron Dhabit'in en saygın ve en yetenekli iş adamı olduğunu söylüyor. Onunla yatırım yapmak kesinlikle güvenlidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530113
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761530113,
					"content": "Evet, evet... Haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530114
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530114,
					"content": "(Nefer! Biliyordum!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530115
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530115,
					"content": "O zaman, yatırımımın getirisini ne zaman alabilirim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530116
					]
				},
				{
					"id": 761530116,
					"content": "Bugün! Tam da bugün. Az önce yepyeni... Kısa vadeli yatırım kuponumuzu aldınız! Bu üründe kar ve zararlar anında hesaplanıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530117
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530117,
					"content": "Sanki hepsini şimdi uydurdun gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761530118,
					"content": "Ah... Endişelenmeyin. N-Neyse, kısa vadeli yatırım kuponumuzu aldığınız için teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530119
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530119,
					"content": "İşte yatırım getiriniz. İyi günler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530120,
						761530121
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530120,
					"content": "Eh... Para kazanmak hiçbir zaman kötü değildir sanırım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530122
					]
				},
				{
					"id": 761530122,
					"content": "Gerçekten mi? Paimon kuş şekilli bir heykelcik istiyor! Paimon'un favorisi o!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761530123,
					"content": "Öyle mi? O zaman ben de sizinle geleyim. Patron için de bir tane alırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530124
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761530124,
					"content": "B-Bayan Jahoda, lütfen bekleyin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530125
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530125,
					"content": "Şey... Leydi Nefer'dan bana bir mesaj getirdiniz mi acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530126
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530126,
					"content": "Hah, Patron şöyle dedi: \"Aradığınız şeyi bulduk.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530127
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761530127,
					"content": "\"Sabırlı olun Bay Dhabit. Doğru düzgün iş yapacaksak adım adım ilerlemeliyiz.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761530128
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761530128,
					"content": "Evet evet, tabii ki. Leydi Nefer haklı... Öyleyse bu iş size emanet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761530121,
					"content": "Hadi Paimon, gidip birkaç şeker heykelcik alalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761530122
					]
				}
			]
