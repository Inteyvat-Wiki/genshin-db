			"dialogs": [
				{
					"id": 710190201,
					"content": "Şu çanağın içinde büyük bir kaya var. Paimon, onun \"taş manzara betimlemesi\" olduğunu tahmin ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710190202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710190202,
					"content": "Ama bunlar normalde bahçelerde ya da avlularda olmuyor mu? Neden buraya konmuş ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710190203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710190203,
					"content": "Hım. Bu betimlemenin üstünde garip bir şey var. Bir tür işarete benziyor. Paimon'un ilgisini çekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710190204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710190204,
					"content": "Neyse, yolculukta olduğumuza göre... Bu taş döşeme gibi görünen dağları gözden kaçırmayalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710190205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710190205,
					"content": "Bir şeyler bulursak güzel olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
