			"dialogs": [
				{
					"id": 750013301,
					"content": "Tuhaf... Altın desenler önceki gibi süzülüp gitti ama Yazıt sütunun altında değildi... Neden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013302,
					"content": "Bu, Yazıtın çıkarılmasının haricinde bir de parçalandığı anlamına geliyor. Çok kötü. Parçaları bulmamız gerekiyor, hem de hızlı bir şekilde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013303
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013303,
					"content": "Peki onları nerede bulabiliriz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013304,
					"content": "... Ben de bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013305
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013305,
					"content": "Hım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013306,
					"content": "Dağılmış olmalarına rağmen bir güç onları tutuyor olmalı. O yüzden yakınlarda bir yerlerde olmalılar. Belki etrafa bir bakabiliriz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013307
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013307,
					"content": "Raar, raar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013308
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013308,
					"content": "Hım? Oraya mı gitmek istiyorsun? Ama şu an önemli bir şeyle uğraşıyoruz. Daha sonra oynarız, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013309,
					"content": "Rrraaaa... Rarr! Rrarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013310
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013310,
					"content": "Yazıtın şurada olduğunu mu söylüyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013311
					]
				},
				{
					"id": 750013311,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013312
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013312,
					"content": "Vay be! Şimdilerde bile Yazıtın gücünü hissedebilen Sürüngenler olduğunu duymuştum ama bunun bir söylentiden ibaret olduğunu düşünüyordum. Doğru olabilir mi acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013313
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013313,
					"content": "#Sanırım sen gerçekten sıradan bir Tepetlizor değilsin {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013314
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013314,
					"content": "Demek bunu da yapabiliyorsun, öyle mi? Hıh! Yine de Paimon kadar iyi bir rehber olabilmek için daha katetmen gereken çok yol var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013315,
					"content": "Hım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013316,
						750013318
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013316,
					"content": "Paimon kıskandı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013317
					]
				},
				{
					"id": 750013317,
					"content": "Kim demiş? Paimon çok açık fikirlidir bir kere! Onu övme şekliydi bu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013320,
					"content": "Rarr... Raar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013321
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013321,
					"content": "*iç çeker* Ufaklık hiçbir şey anlamadı. Keşke biraz daha akıllı olsaydı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013322,
					"content": "Eminim bir gün anlayacaktır...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013323
					]
				},
				{
					"id": 750013323,
					"content": "Aynen öyle. Kabilede Sürüngen bakımından sorumlu olanlar, onlarla gerçek anlamda iletişim kurmanın vakit aldığını söylerler hep.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013324
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013324,
					"content": "İşin sırrı sabırlı olup sürekli iletişim kurmak. Durum ister bir insanın bir Sürüngeni anlaması olsun ister tam tersi... Her türlü çok fazla zamana ihtiyaç vardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013325
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013325,
					"content": "#Evet... Tıpkı Paimon'un, {REALNAME[ID(2)|SHOWHOST(true)]} dostumuzun ne söylemeye çalıştığını anlayamaması gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013326,
					"content": "#Kusura bakma {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013327,
					"content": "Raaa, Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013328
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013328,
					"content": "Hakkını vermek lazım, epey hızlı cevap veriyorsun ama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013329,
					"content": "Pekala, o halde seninle gelelim, bakalım altın desenlerden bulabilecek miyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013318,
					"content": "Gördün mü? Paimon seni övüyor!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013319
					]
				},
				{
					"id": 750013319,
					"content": "Evet ama sen çok da şımarma yine de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013320
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}