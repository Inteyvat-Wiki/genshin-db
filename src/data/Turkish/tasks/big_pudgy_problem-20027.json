			"dialogs": [
				{
					"id": 200270101,
					"content": "#Teşekkürler {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270102
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270102,
					"content": "Üzüm asmalarına bakmaya çalışıyordum ama sonra... Bu oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270103
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270103,
					"content": "*iç çeker* Lütfen oğluma bundan bahsetme. Kendisi bir Favonius Şövalyesi, zaten işi başından aşkındır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270104
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270104,
					"content": "Şapşal bir ihtiyarın başını soktuğu belayla onu meşgul etmeye gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270105
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270105,
					"content": "Ancak yakın zamanda bu çevrede bodurloplarla sorun yaşamaya başladık. Sürekli üzüm asmalarıma zarar verecekler diye endişeleniyorum. Artık geceleri uykum kaçıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270106
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270106,
					"content": "Benim gibi bir ihtiyara ayıracak zamanın var mı bilmiyorum ama... Benim için bu bölgedeki bodurlopları kovalayıp üzümlerime dadanmalarını engeller misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200270107,
						200270108
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270107,
					"content": "Tabii ki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200270109
					]
				},
				{
					"id": 200270109,
					"content": "Çok teşekkür ederim evlat! Bu sayede rahat uyuyacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200270108,
					"content": "Mümkün değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200270110
					]
				},
				{
					"id": 200270110,
					"content": "*iç çeker* Kendim yapmayı çok isterdim ama benim yaşımda olunca insanın eski kuvvetinden eser kalmıyor... Senin gibi bir delikanlı için hiç sorun olmayacaktır. Hadi şu ihtiyarın gününü güzelleştir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tunner"
				}
			]
		}
