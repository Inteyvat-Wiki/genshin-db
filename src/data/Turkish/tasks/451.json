			"dialogs": [
				{
					"id": 4510101,
					"content": "Burası Kurtlar Diyarı. Mondstadt'takiler buraya neredeyse hiç uğramaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510102,
					"content": "Şehirden çok uzak olmasa da buraya hiç el değmemiştir. Yani doğa kanunlarının hükmettiği vahşi bir bölgedir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510103,
					"content": "Burası en güçlünün hayatta kaldığı yerdir. Buradaki bodurloplar bile koskocamandır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510104,
					"content": "... Mesela şuradaki aşırı büyük olanlar gibi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510105,
					"content": "... Eyvah, bizi gördüler! Savaşmaya hazırlan!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 45103,
			"completionStepIds": [
				45104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"45104",
							"2"
