			"dialogs": [
				{
					"id": 4510501,
					"content": "... Cidden yardım etmek istiyor musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510502
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510502,
					"content": "Kurtlar içgüdüleriyle avlanır. Hep işe yarar. Ama... Tuzak kurmak da eğlenceli görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510503
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510503,
					"content": "Önce tuzak kurarız. Sonra yaban domuzunu tuzağa doğru kovalarız. Olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510504
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510504,
					"content": "Umarım patlamaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Razor"
				}
			]
		},
