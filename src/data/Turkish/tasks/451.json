				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Razor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4510301,
					"content": "*nefes nefese* Teşekkür ederim. Aaaah! Kurtlar! Kaçın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510303,
					"content": "Endişelenmeyin. Kurtlar dost. Peki ya siz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510304
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510304,
					"content": "Biz buradan geçen her zamanki sıkıcı gezginleriz yalnızca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510305,
					"content": "Kokunuz sıkıcı gelmiyor. Kokunuz... *koklar* Tanıdık geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510306
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510306,
					"content": "... Kokumuz mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510307,
					"content": "Favonius Şövalyeleri gibi kokuyorsunuz. Onlar dosttur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510308,
						4510309
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510308,
					"content": "Senin adın ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4510310
					]
				},
				{
					"id": 4510310,
					"content": "Ben Razor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510311
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510311,
					"content": "Sen de Favonius Şövalyelerinden biri misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510312,
					"content": "Değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510314
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510314,
					"content": "Ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510315,
					"content": "Bu kurt sürüsü de neyin nesi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4510316
					]
				},
				{
					"id": 4510316,
					"content": "Benim kurt sürüm... Onlar benim ailem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510317
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510317,
					"content": "... Ailen mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510318,
					"content": "Evet. Beni onlar büyüttü. Birlikte yaşıyoruz. Biz aileyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510319
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510319,
					"content": "Aklımda o kadar çok soru var ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510320,
					"content": "Bana kızdılar. Size yardım edince pusumuzu açığa çıkardım, yaban domuzu kaçtı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510321
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510321,
					"content": "#Hiç merak etme, {NICKNAME} hemen sizin için başka bir yaban domuzu yakalar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510322,
					"content": "#{NICKNAME} göründüğünden daha güçlüdür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510323,
					"content": "Yok, gerek yok. Şövalyeler yardım etmeye çalışınca kurtlar aç kalır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510324
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510324,
					"content": "Saçmalama! Burada bekle, bu işin altından kalkarız. İzle de gör!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510309,
					"content": "Sen de Şövalyelerden biri misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4510313
					]
				},
				{
					"id": 4510313,
					"content": "Ben Razor'ım. Şövalye değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510314
					],
					"speakerTitle": "Razor"
				}
			]
		},
