			"dialogs": [
				{
					"id": 4510601,
					"content": "Ha ha! Yapabileceğimizi söylemiştim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510602,
					"content": "Teşekkürler ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510603
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510603,
					"content": "... Kurtlar tek avda beş altı tane yakalar... *iç çeker* Bu akşam aç kalacaklar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510604
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510604,
					"content": "Tüh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510605,
					"content": "Üzülmeyin. Elinizden geleni yaptınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510606
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510606,
					"content": "En azından diğer şövalye arkadaştan fazlasını yaptınız... Kırmızılı olan, alevli kız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510607
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510607,
					"content": "O kız burada olsaydı bütün dağ alev alırdı. Bir tane bile yaban domuzu yakalayamazdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510608
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510608,
					"content": "Şimdi gitmem lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510609
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510609,
					"content": "Burası güvenli değil. Dikkat edin. Gözleri hep üzerimizde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510610
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 4510610,
					"content": "Amma tuhaf biri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510611,
					"content": "\"Alevli kız\" mı? Favonius Şövalyelerinden mi? Kimden bahs...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4510612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4510612,
					"content": "#{NICKNAME}, sence kimden bahsediyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
