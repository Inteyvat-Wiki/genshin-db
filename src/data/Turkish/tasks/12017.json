			"dialogs": [
				{
					"id": 120170401,
					"content": "Demek fotoğraf görsel bir temsil... Bir izlenim, gölge yapmak gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170402
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170402,
					"content": "Büyüleyici. Bugün çok şey öğreniyorum. Hadi işe koyulalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ei"
				}
			]
		},
		{
			"id": 1201705,
			"completionStepIds": [
				1201705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201705",
							"2"
						],
						"stepId": 1201705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120170501,
					"content": "Kestik! Bak, işte çektiğimiz fotoğrafın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170502,
					"content": "Vay canına... Bu inanılmaz. Bu bir çeşit sihir falan mı? Sanki... Bir kopyam daha varmış gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170503
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170503,
					"content": "Ama ne hareket edebiliyor ne de konuşabiliyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170504,
						120170505
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170504,
					"content": "Bu sadece bir fotoğraf.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170506
					]
				},
				{
					"id": 120170506,
					"content": "Kendimi kastığım için kötü çıkacağını düşünmüştüm. Ama tahmin ettiğimden çok daha doğal görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170507
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170507,
					"content": "Poz tamamen aynı, arka plandaki manzara da öyle... Bunun nasıl başarıldığını aklım almıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170508
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170508,
					"content": "Onu bu kadar özel kılan da bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170509,
					"content": "Bir dakika, bunu anlamakta hâlâ zorlanıyorum. Tekrar açıklamanızı istiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170510
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170510,
					"content": "Yani, bu fotoğraftakinin ben olmadığımdan emin misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170511
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170511,
					"content": "Eğer ben değilsem o zaman neden bana tıpatıp benziyor? Ya da eğer o gerçekten bensem, o halde... Ben kimim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170512
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170512,
					"content": "#Şey... Tamam, bu Paimon'u biraz aşıyor... Buyur sen anlat {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170513,
					"content": "Bu biraz sen ve Şogun gibi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170514
					]
				},
				{
					"id": 120170514,
					"content": "Aynen öyle! Şogun'u kendin olarak mı görüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170515,
					"content": "Elbette. Niyetim hiçbir zaman Inazuma'nın kontrolünü başka birinin eline bırakmak değildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170516
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170516,
					"content": "Öyleyse bu, tam buradaki ve şu andaki seni kim yapar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170517,
					"content": "Ben hâlâ benim. Buna hiç şüphe yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170518
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170518,
					"content": "Yani varlığın tekil değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170519
					]
				},
				{
					"id": 120170519,
					"content": "Varlığım, hımm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170520
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170520,
					"content": "Galiba anladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170521
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170521,
					"content": "Ben benim. Benden sadece bir tane var ama birçok farklı biçimde var olabilirim. Hangi formda var olduğumun önemi yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170522
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170522,
					"content": "Örneğin Şogun benim var oluş biçimlerimden biri. Onun ben olup olmadığı sorunsalı onu var eden parçalar tarafından belirlenemez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170523
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170523,
					"content": "Bu durumda bu resim de senin varoluş biçimlerinden biri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170524,
					"content": "Yani, Sonsuzluğu arayan ben bile varoluş biçimimi sürekli değiştiriyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170525
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170525,
					"content": "Öyleyse Inazuma'dan ve burada yaşayan herkesin değişmeden kalmalarını nasıl isteyebilirim ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170526,
						120170527
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170526,
					"content": "Inazuma daima Inazuma olacak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170528
					]
				},
				{
					"id": 120170528,
					"content": "Sizinle çıktığım bu yolculukta karşılaştığım her şey mevcut bilgi dağarcığımın çok ötesindeydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170529
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170529,
					"content": "*iç çeker* Bugün birçok defa cahilliğime şahit oldunuz. Belki belli olmuyor ama tüm bunlar bazı şeyleri anlamamı zorlaştırdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170530
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170530,
					"content": "Bugün gördüklerime dayanarak, Inazuma'nın hatırladığımdan tamamen farklı bir yer olduğunu kabul etmek zorundayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170531
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170531,
					"content": "Ancak bundan bugünkü Inazuma'nın artık Inazuma olmadığı sonucunu çıkarmak yanlış olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170532
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170532,
					"content": "Doğru.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170533
					]
				},
				{
					"id": 120170533,
					"content": "Hem Önsezi Avı Fermanı hem de Alemüstü Tanrı'nın Heykeli, Sonsuzluğu getirmenin bir yolu olarak tasarlandı. Ancak Sonsuzluğa gerçekten yaklaşıyor olsaydım bunların hiçbiri olmayacaktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170534
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170534,
					"content": "Hım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170535
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170535,
					"content": "Belki de... Belki de her şeye fazla sıkı sarılıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170536
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170536,
					"content": "Paimon'a göre Ei bir şeyleri çözmüşe benziyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170537
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170537,
					"content": "Bu da demek oluyor ki onun rehberleri olarak harika bir iş çıkardık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170538
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170538,
					"content": "Kamaji Usta! Kamaji Usta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170539
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170539,
					"content": "Aşağısı neden bu kadar gürültülü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170540
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170540,
					"content": "Ippei'nin sesine benziyor. Mesele ne acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170541,
					"content": "Ippei mi? Tenryou Heyetinden biri mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170542
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170542,
					"content": "Evet. Hadi neler oluyor öğrenelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170527,
					"content": "İnsanlar daima insan kalacak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170528
					]
				},
				{
					"id": 120170505,
					"content": "Bu gerçek sen değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170506
					]
				}
			]
		},
		{
			"id": 1201707,
			"completionStepIds": [
				1201707
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201707",
							"2"
						],
						"stepId": 1201707,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ippei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120170701,
					"content": "Hey, Ippei, ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170702,
					"content": "Ah, siz. Ben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170703
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170703,
					"content": "Ha? Yü-Yüce Şogun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170704
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170704,
					"content": "Ustam Kujou Kamaji'yi arıyor olmalısınız. Çok üzgünüm, kendisi şu an burada değil. Ama isterseniz mesajınızı kendisine memnuniyetle iletirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170705
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170705,
					"content": "Sorun değil, onu görmeye gelmedim. Az önce seslendiğini duyduk, bu yüzden neler olup bittiğini görmeye geldik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170706
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170706,
					"content": "Efendini mi arıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170707
					]
				},
				{
					"id": 120170707,
					"content": "Evet. Kamaji Usta hâlâ görüşmelerden dönmedi, ben de endişelenmeye başladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170708
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170708,
					"content": "Dürüst olmak gerekirse, uzun yürüyüşler yapmak ve geç dönmek gibi bir alışkanlığı var. Hoşuna giden bir yer bulup zamanın nasıl geçtiğini fark etmemiş olması gayet mümkün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170709
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170709,
					"content": "Ama nedense, bugün bilhassa gerginim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170710
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170710,
					"content": "Kujou Kamaji... Kujou Klanının soyundan geliyor herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170711
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170711,
					"content": "Doğru. Kusura bakmayın, klan liderinin sağlık durumu pek iyi değil ve Masahito Usta da karargaha nadiren uğrar, bu yüzden Kamaji Usta şu anda Kujou Klanın temsilcisi olarak hizmet veriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170712
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170712,
					"content": "Tenryou Heyetinde bu ara işlerin oldukça çalkantılı olduğunu duydum. Bunun Kujou Kamaji ile bir ilgisi var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170713
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170713,
					"content": "Affedin bizi Yüce Şogun. Kujou Klanı görevinde başarısız oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170714
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170714,
					"content": "Kujou Klanının itibarı zedelendi ve Tenryou Heyeti üzerindeki gücü azalıyor. Siz de, öhöm, Heyetin geleceğine dair henüz bir karara varmadınız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170715
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170715,
					"content": "Bu yüzden de Kamaji Usta, yönetimi devralmaları amacıyla Takatsukasa Klanı ile görüşmeye karar verdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170716
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170716,
					"content": "Böyle bir şeyi karargahlarında görüşüyorlardır herhalde, değil mi? Neden onları burada arıyorsun ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170717,
					"content": "Aslına bakarsanız bu görüşmeyi başka bir yerde yapmaya karar verdiler. Dürüst olmak gerekirse böyle yapmaları kafamı biraz karıştırdı ama üstlerimi sorgulamak bana düşmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170718
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170718,
					"content": "Toplantı yeri Büyük Narukami Tapınağının yakınındaki dağlarda bulunuyor. Sanırım Takatsukasa Klanının orada bir çeşit üssü var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170719
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170719,
					"content": "Takatsukasa... Tanıdık bir isim daha. Bunca yıldır Kujou Klanına sadakatle mi hizmet ettiler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170720
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170720,
					"content": "Evet, evet. Kamaji Usta bu nedenle onlarla görüşmeye karar verdi. Tartışmaları gereken bir sürü konu olmasını anlarım fakat yine de bu kadar uzun sürmesine imkan yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170721
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170721,
					"content": "Şehrin dört bir yanını aradım. Gerçekten hâlâ dönmediyse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170722,
						120170723
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170722,
					"content": "Belki de toplantıyı bitirmediler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170724
					]
				},
				{
					"id": 120170724,
					"content": "Evet, o ihtimal benim de aklıma geldi... Ama benim rütbemdeki birisi Takatsukasa Klanının topraklarına elini kolunu sallayarak giremez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170725
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170725,
					"content": "Senin için gidip neler olduğuna bakabiliriz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170726
					]
				},
				{
					"id": 120170726,
					"content": "Hayır, gerek yok. Muhtemelen biraz büyütüyorum. Ayrıca, hâlâ toplantıya devam ediyorlarsa görüşmelerini böldüğüm için beni suçlayacaklardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170727
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170727,
					"content": "Ben sadece düşük rütbeli bir hizmetkarım ama Kamaji Ustayla birlikte büyüdük... Ona bir şey olursa çok kötü olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170728
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170728,
					"content": "Ben Usta kadar zeki değilim, bu yüzden onun yükünü paylaşamam. Ama bu konuda bir şeyler yapabilecekken ona zarar gelmesi isteyeceğim son şey olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170729
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170729,
					"content": "Hımm... Siz ne düşünüyorsunuz Yüce Şogun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120170730,
					"content": "Gidip neler olduğuna bir bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170731
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170731,
					"content": "Görüşmelerini yarıda kessek bile ben varken seni suçlamaları pek mümkün değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170732
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170732,
					"content": "Ayrıca, ben zamanında karar veremediğim için böyle oldu. Bu mesele benimle başladı ve bitirecek olan da benim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170733,
						120170734
					],
					"speakerTitle": "Ei"
				},
				{
					"id": 120170733,
					"content": "Kendini adamak diye buna denir!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170735
					]
				},
				{
					"id": 120170735,
					"content": "Çok sağ olun Şogun! Ben de bu sırada etrafa bakmaya devam edeceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120170736
					],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170736,
					"content": "Sizin için üssün konumunu işaretleyeyim. Umarım her şey yolunda gider!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ippei"
				},
				{
					"id": 120170734,
					"content": "İyi dedin!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170735
					]
				},
				{
					"id": 120170723,
					"content": "Belki de bir şeyler olmuştur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120170724
					]
				}
			]
		},
