			"dialogs": [
				{
					"id": 150250201,
					"content": "Buraya daha önce gelmedik mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250202,
					"content": "Evet ama seçilmiş kişiler olduğumuzu unutma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250203
					]
				},
				{
					"id": 150250203,
					"content": "İlginçtir ki atalarımız grafitiyi tamamlandıktan sonra da mührü kaldırmamış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250204
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250204,
					"content": "Oda mühürlendiği için içeriye yalnızca yüce şaman Huitzilin girmiş olmalı. O da iki yüz yıl önce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250205
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250205,
					"content": "Dediğine göre grafiti, Kuntur adında bir kahramanın hikayesini anlatıyormuş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250206
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250206,
					"content": "... Neyse, konudan saptım. Kusura bakmayın, grafitilerin büyük hayranıyım da, bir kere konuşmaya başladım mı saatlerce susmuyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250207
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250207,
					"content": "Bizimle gelmek istemediğine emin misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250208,
					"content": "Yok, kalsın. Bir kere içeri girmeye çalıştım ama mühür bana engel oldu. Iktomizorumdan gücünü kullanarak yolu açmasını istedim ama o da işe yaramadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250209
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250209,
					"content": "Atalarımızın bize bıraktığı bir imtihan olmalı bu. İmtihanı geçemezsen onların sanat eserlerine bakmayı hak etmiyorsundur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250210
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250210,
					"content": "Yaa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250211,
					"content": "Beni merak etmeyin siz. İçeri girebiliyor olsam bile bu sefer sizinle gelmezdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250212
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250212,
					"content": "Şefimizin aksine ben geleneklerimize kafa tutacak kadar cesur değilim. Bu görev bizzat Büyük Iktomizor tarafından seçilen kişilere verildi. Ben dahil olursam kötü şeyler yaşanır belki, kim bilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250213
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250213,
					"content": "Pekala. Biz giriyoruz, seni fazla bekletmemeye çalışacağız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
