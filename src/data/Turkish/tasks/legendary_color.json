			"dialogs": [
				{
					"id": 150250101,
					"content": "Yüce Tlapo'nun görevlendirdikleri siz misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250102
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150250102,
					"content": "Evet! Sen kimsin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250103
					],
					"speakerTitle": "Paimon"
				},
				{
