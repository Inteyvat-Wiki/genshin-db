			"dialogs": [
				{
					"id": 150251001,
					"content": "Manzaraya baksanıza. Nasıl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251002
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Gece Rüzgarının Ustaları Şefi"
				},
				{
					"id": 150251002,
					"content": "Muhteşem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251003,
					"content": "Şimdi biraz daha uzağa doğru bakın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251004
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Gece Rüzgarının Ustaları Şefi"
				},
				{
					"id": 150251004,
					"content": "Aaa... Şu grafiti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251005,
					"content": "Kabilemiz kurulduğundan beri o renkler hep bizim hayatımızda oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251006
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Gece Rüzgarının Ustaları Şefi"
				},
				{
					"id": 150251006,
					"content": "Bu kadim kabileye değişim ve reform ile yeni bir soluk getirmek istediğim doğru. Fakat vazgeçemeyeceğimiz bazı temel bileşenlerimiz olduğunu da kabul ediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251007
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Gece Rüzgarının Ustaları Şefi"
				},
				{
					"id": 150251007,
					"content": "Bunların ilki de tarihimizi kaydetme biçimimiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251008
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Gece Rüzgarının Ustaları Şefi"
				},
				{
					"id": 150251008,
					"content": "Mantıklı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251009,
					"content": "En başından beri kabilemiz tarihe renk katmayı kendine hedef bildi. Ben de mirasımızın bu kısmından vazgeçmememiz gerektiğini düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251010
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Gece Rüzgarının Ustaları Şefi"
				},
				{
					"id": 150251010,
					"content": "Yani ne pahasına olursa olsun geleneksel dokuma parşömenlerimizi üretmeye devam edebilmemizin bir yolunu bulmalıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251011
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Gece Rüzgarının Ustaları Şefi"
				},
				{
					"id": 150251011,
					"content": "Haklısın. Paimon söyledikleri için özür diliyor. Haddini aşmış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251012,
					"content": "Sorun değil. Anlatmak istediğimi anlamana sevindim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251013
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Gece Rüzgarının Ustaları Şefi"
				},
				{
					"id": 150251013,
					"content": "Bu sorunu çözmene yardımcı olacağız.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150251014
					]
				},
				{
					"id": 150251014,
					"content": "O halde umarım bir sonraki karşılaşmamızda bu geleneği diriltmeyi başarırız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Gece Rüzgarının Ustaları Şefi"
				}
			]
		},
