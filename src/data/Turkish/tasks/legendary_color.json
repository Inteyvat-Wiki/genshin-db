			"dialogs": [
				{
					"id": 150251801,
					"content": "Bu kabilenin ataları gerçekten çok etkileyici eserler yapmış burada. Ama gördüğümüz kadarıyla sanki hikayenin devamı olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251802,
					"content": "Acaba daha ileride başka eserler de var mıdır? Biraz tuhaf geldi de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251803,
						150251805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251803,
					"content": "Gidip bakabiliriz istersen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150251804
					]
				},
				{
					"id": 150251804,
					"content": "Ha, gerek yok. Paimon sesli düşünüyordu da. Toltec bizi bekliyor, yapmamız gereken bir işimiz de var. Dışarı çıksak mı artık?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251807,
					"content": "Hadi dönüp Toltec ile buluşalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251805,
					"content": "Olabilir ama yapmamız gereken bir iş var. Ona odaklanalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150251806
					]
				},
				{
					"id": 150251806,
					"content": "Evet, haklısın. Bir dahakine artık.",
