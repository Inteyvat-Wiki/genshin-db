			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Biram"
				],
				"points": [
					{
						"sceneId": 1200,
						"position": [
							409.031,
							104.539,
							380.959
						],
						"pointId": 3
					},
					{
						"sceneId": 1200,
						"position": [
							408.885,
							104.539,
							378.134
						],
						"pointId": 5
					}
				]
			},
			"dialogs": [
				{
					"id": 150250701,
					"content": "Şuna bakın, atalarımızın yaptığı bir dokuma parşömen bu. İşte bizim yapmaya çalıştığımız da böyle bir şey.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250702
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Gece Rüzgarının Ustaları Şefi"
				},
				{
					"id": 150250702,
					"content": "Ha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250703,
					"content": "Tasvir edilen kişi efsanevi şaman Huitzilin. İki yüz yıl önce yaşamış kendisi, sizin gibi o da Büyük Iktomizor tarafından seçilmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250704
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Gece Rüzgarının Ustaları Şefi"
				},
				{
					"id": 150250704,
					"content": "Renk manipülasyonu konusunda epey yetenekliymiş, dolayısıyla görevini de kusursuz tamamlamış tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250705
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Gece Rüzgarının Ustaları Şefi"
				},
				{
					"id": 150250705,
					"content": "Bu parşömen onun başardıklarının bir kaydı, muhtemelen kendi eliyle dokudu. Kalitesi bu türden diğer parşömenlere kıyasla bile nefes kesici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250706
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Gece Rüzgarının Ustaları Şefi"
				},
				{
					"id": 150250706,
					"content": "Fakat ne yazık ki kendisi vefat ettiğinden beri Büyük Iktomizor'un seçtiği sonraki herkes, çalışmalarını tamamlayabilmek için \"ruhlardan gelen hediyeler\"e bel bağladı hep.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250707
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Gece Rüzgarının Ustaları Şefi"
				},
				{
					"id": 150250707,
					"content": "Ama şimdi eski bir geleneği diriltmek üzeresin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250708
					]
				},
				{
					"id": 150250708,
					"content": "Güzel söyledin. Ama \"ben\" değil, \"biz\" diriltmek üzereyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250709
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Gece Rüzgarının Ustaları Şefi"
				},
				{
					"id": 150250709,
					"content": "Ayy! Paimon heyecanlandı şimdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250710,
					"content": "Numuneleri getir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250711
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Gece Rüzgarının Ustaları Şefi"
				},
				{
					"id": 150250711,
					"content": "Şefin yardımcısı, boyama testi için numuneleri getirir.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150250712
					]
				},
				{
					"id": 150250712,
					"content": "Şimdi daha önce de söylediğim üzere boyama süreci biraz karışık ama üstesinden geleceğinize eminim. Talimatlarımı harfi harfine uygulamaya çalışın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250713
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Gece Rüzgarının Ustaları Şefi"
				},
				{
					"id": 150250713,
					"content": "Tabii. Hadi başlayalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250714
					]
				},
				{
					"id": 150250714,
					"content": "Numunenin üzerine desen önceden işlendi, sizin yalnızca her parçayı doğru renkle boyamanız gerekiyor. Ama renklerin birbirine karışmaması için her parçayı bitirdikten sonra boyanın oturmasını beklemelisiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250715
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Gece Rüzgarının Ustaları Şefi"
				},
				{
					"id": 150250715,
					"content": "(Kumaşı anlatıldığı gibi boya.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250716
					]
				},
				{
					"id": 150250716,
					"content": "Güzel. Kumaş boyayı tuttu, desen de gayet net görünüyor. Şimdi kalan boyayı da uygulayın, elde etmesi o zor rengin ortaya çıkması gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250717
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Gece Rüzgarının Ustaları Şefi"
				},
				{
					"id": 150250717,
					"content": "Son adıma geldik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250718,
					"content": "(Kalan boyayı uygula.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250719
					]
				},
				{
					"id": 150250719,
					"content": "Iı... Oldu mu? Paimon rengi göremiyor da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250720,
					"content": "Renk ortaya çıkmadı... Boyama başarısız oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250721
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Gece Rüzgarının Ustaları Şefi"
				},
				{
					"id": 150250721,
					"content": "Yanlış bir şey mi yaptım?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150250722
					]
				},
				{
					"id": 150250722,
					"content": "Yok, tekniğin kusursuzdu. Her şeyi tam söylediğim gibi yaptın. Kendim yapsam da bir fark olmazdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250723
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Gece Rüzgarının Ustaları Şefi"
				},
				{
					"id": 150250723,
					"content": "Ne oldu o zaman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250724,
					"content": "Dokuma tekniğinden olabilir, boyanın farklı uygulanması gerekiyor olabilir... Her halükarda bu gizemi çözmeyi başaramadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250725
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Gece Rüzgarının Ustaları Şefi"
				},
				{
					"id": 150250725,
					"content": "Kusura bakma... Keşke daha fazla yardımcı olabilseydik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250726,
					"content": "Asıl siz kusura bakmayın. Sizi bu kadar zahmete soktum boş yere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250727
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Gece Rüzgarının Ustaları Şefi"
				},
				{
					"id": 150250727,
					"content": "Çabalarınızın karşılığını ödeyeceğime dair söz vermiştim, bu sözümü tutacağım elbette. Ama umarım bu görevden henüz vazgeçmezsiniz. Araştırmaya devam etmeyi düşünüyorum, bir gelişme olursa size de haber veririm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250728
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Gece Rüzgarının Ustaları Şefi"
				},
				{
					"id": 150250728,
					"content": "Merak etme, öyle kolay pes etmeyiz biz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250729,
					"content": "Paimon bir şey sormak istiyor ama... Şey, tarihinizi dokuma parşömenlere kaydetme olayı çok karışık geliyor. Neden normal yazmıyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250730,
					"content": "Kendin de söyledin ya, değişiklik ve reform istiyormuşsun. Sence de başlamak için güzel bir yer değil mi? Yazıya dökmek hem işleri kolaylaştırır hem de daha ayrıntılı kayıt tutmanızı sağlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250731
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150250731,
					"content": "... Felsefemi yanlış anlamışsınız sanırım fakat sorun değil. Sorunu yanıtlayacağım ama önce size göstermek istediğim bir yer var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150250732
					],
					"speakerTitle": "Biram",
					"speakerSubtitle": "Gece Rüzgarının Ustaları Şefi"
				},
				{
					"id": 150250732,
					"content": "Ha... Tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
