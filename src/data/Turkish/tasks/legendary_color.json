			"dialogs": [
				{
					"id": 150251501,
					"content": "Demek boya bu mağarada bir yerde, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251502,
					"content": "Size en fazla buraya kadar eşlik edebilirim. Buradan sonrasına yalnızca seçilmiş kişiler geçebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251503
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150251503,
					"content": "Neden ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150251504,
					"content": "Uzun hikaye. Anlatılan o ki bu mağarada yetişen bir meyve varmış, o meyvenin suyundan muhteşem bir boya yapılıyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251505
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150251505,
					"content": "Uzun yıllar önce atalarımız iddialı bir dizi grafiti yapmak istemiş. Grafitiler için bu mağarayı seçmişler, muhtemelen boya burada bulunduğundan dolayı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251506
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150251506,
					"content": "Fakat eserleri tamamlanmadan başkalarının gelip görmesini istememişler. Bu nedenle erişimi kontrol edebilmek için girişi mühürlemişler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251507
					],
					"speakerTitle": "Toltec"
				},
				{
					"id": 150251507,
					"content": "Mührü geçmek için renk algılama sanatında ustalaşmış olmak falan gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150251508
					],
					"speakerTitle": "Toltec"
				},
