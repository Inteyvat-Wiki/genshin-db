			"dialogs": [
				{
					"id": 760600101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600102
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600102,
					"content": "Ha? Bu Maalaus değil mi? Yine ilham aramaya mı çıkmış?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600103,
					"content": "Evet. Ama ufaklık geri döndüğünden beri böyle... Sanki düşüncelere dalmış gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600104
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760600104,
					"content": "Belki de bu sefer çok derin bir şey üzerine düşünüyordur... Hani büyük sanatçılar bazen dünya hakkında temel bir gerçeği anlar ya, aynı onun gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600105,
					"content": "Aslında düşününce, Maalaus bize bir sürü resim verdi. Bu hızla giderse bir sergi bile açabiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600106,
					"content": "Hehe, Paimon herkese küçük ressamımızın bir sanat yıldızına nasıl dönüştüğünü anlatmak için sabırsızlanıyor! Ah, ama önce Columbina'nın iznini almamız gerekir elbette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600107,
					"content": "Hım? Neden ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600108
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760600108,
					"content": "Çünkü neredeyse hepsi senin resimlerin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600109
					]
				},
				{
					"id": 760600109,
					"content": "Ha... Sorun değil, benim için sakıncası yok. Kulağa ilgi çekici geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600110
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760600110,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600111
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600111,
					"content": "Görünüşe göre Maalaus ne çizeceğine karar verdi! Hemen elimizde ne tür boyalar olduğuna bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600112,
					"content": "Bu sefer... Derin ve dingin renkler seçelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
