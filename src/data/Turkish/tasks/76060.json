			"dialogs": [
				{
					"id": 760600301,
					"content": "Tamamdır, bunlar olur. Sen ne dersin Maalaus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600302,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600303
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600303,
					"content": "Evet, Paimon'a oldukça mutlu bir Kuuhenki gibi görünüyor! Hehe, acaba bu sefer nasıl bir resim ortaya çıkacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600304,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600305
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600305,
					"content": "Aa, bitti mi hemen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600306,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600307
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600307,
					"content": "Maalaus biraz üzgün görünüyor. Resimden dolayı mı? Bir bakalım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600308,
					"content": "Tamam, bu Columbina... Geceleyin ay ışığı altında yürüyor ve gökyüzüne bakıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600309,
					"content": "Ah... Sahte gökyüzünün ötesindeki gerçek aya bakıyor olmalıyım. Eskiden sık sık böyle gece yürüyüşleri yapardım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600310
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760600310,
					"content": "Eskiden mi? Ha, doğru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600311,
					"content": "(Columbina şu anda neredeyse bu bahçeye hapsolmuş durumda... Nod-Krai'da doğmuş olmasına rağmen...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600312
					]
				},
				{
					"id": 760600312,
					"content": "Evet, gökyüzüne bakıp merak ederdim... Gerçek Donuk Ayda aslında ne var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600313
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760600313,
					"content": "Belki de buradaki gibi bir sürü küçük hayvanla doludur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600314
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760600314,
					"content": "Belki de... Hiçbir şey yoktur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600315
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760600315,
					"content": "Of...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600316,
						760600319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600316,
					"content": "Yanında birkaç tane götürürsün belki, ha?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600317
					]
				},
				{
					"id": 760600317,
					"content": "Ha... İlginç bir düşünce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600318
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760600318,
					"content": "Ama... Ay, sahte gökyüzünün ötesinde yer aldığı için, böyle bir macerada onları yanımda götürmek gibi bir risk alamam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600322
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760600322,
					"content": "(Biri, hareket etme özgürlüğünün bile olmadığı bir \"ev\"... Diğeri ise hakkında hiçbir şey bilmediği bir \"ev\"...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600323
					]
				},
				{
					"id": 760600323,
					"content": "(...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600324
					]
				},
				{
					"id": 760600324,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600325
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760600325,
					"content": "Maalaus ve diğer Kuuhenkiler seni gerçekten özleyecek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600326,
					"content": "Ben de onları özleyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600327
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760600327,
					"content": "Ama sonuçta, bu sadece benim yapabileceğim bir yolculuk... Ve sonundaki cevap sadece benim arayabileceğim bir cevap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600328
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760600328,
					"content": "Hem kim bilir? O cevap her neyse... Belki de güzel bir şeydir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600329
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760600329,
					"content": "O... O zaman Maalaus ile birlikte seni ziyarete gelmeliyiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600330,
					"content": "Olur tabii. Belki o sanat sergisini ayda düzenleriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600331
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760600331,
					"content": "Evet, harika fikir! Anlaştık o halde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760600332,
					"content": "Evet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600333
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760600333,
					"content": "Umarım öyle olur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760600319,
					"content": "Orada başka sevimli yaratıklar olabilir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600320
					]
				},
				{
					"id": 760600320,
					"content": "Umarım öyledir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600321
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760600321,
					"content": "Ve umarım... Eğer varsa, yaratıklar \"Tanrıça\"larının ani ve beklenmedik dönüşünü memnuniyetle karşılarlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600322
					],
					"speakerTitle": "Küçük Hanım"
				}
			]
		},
