			"dialogs": [
				{
					"id": 706970101,
					"content": "#{NICKNAME}! Seninle Mondstadt'ta karşılaşmak ne hoş sürpriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970102
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970102,
					"content": "Daha önce hiç böyle bir iklimde bulunmamıştım. Çok soğuk! Ama vay be, ne müthiş bir deneyim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970103
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970103,
					"content": "İlk kartopu savaşımı ve ilk kardan adamımı yaptım... Ha, çizgi romanlar da hoş bir sürpriz oldu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970104
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970104,
					"content": "Ruhyakan Destanı Inazuma'da çok popüler ama burada da bir sürü okur bulmayı hiç beklemiyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970105
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970105,
					"content": "Az önce Natlanlı bazı hayranlarla harika bir sohbet ettik. Bu bana gerçekten ilham oldu, ben de... Bir karakter standı yapmaya karar verdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970106
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970106,
					"content": "... Ha, pardon, biraz daha geriden alayım. Ruhyakan Destanı'nı duydun mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970107
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970107,
					"content": "Yoimiya'ya Ruhyakanlar Lejyonunu anlatıyorsun...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706970108
					]
				},
				{
					"id": 706970108,
					"content": "Yok artık! Arkadaşların da mı ilgileniyor? Ne ilginç bir tesadüf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970109
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706970109,
					"content": "Bu durumda sana Fietena'nın bu karakter standını vereyim. Hehe, Ruhyakanlar Lejyonuna çok yakışacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
		}
	]
