			"dialogs": [
				{
					"id": 20021201,
					"content": "Ne? Beidou çoktan gitti mi? Belki de gemisine gitmiştir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021202,
					"content": "Kaptanı mı arıyorsunuz? Leydi Ningguang çağırdı onu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021203
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021203,
					"content": "Anlaşılan Güneyhaçı Yarışması bu sefer çığırından çıktı ve onun ilgisini çekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021204
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021204,
					"content": "Kaptan Beidou, Liyue Limanı'na giderken Ningguang'ın geri kafalı biri olduğuna dair bir şeyler mırıldanıyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021205
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021205,
					"content": "Haha, o ikisinin aralarının bozuk olması görülmemiş bir şey değildir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021206
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021206,
					"content": "Kaptan Beidou, yeni şampiyonun taç giymesine tanık olamadığı için hayal kırıklığına uğradı. Uzun bir süredir bunu dört gözle bekliyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021207
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021207,
					"content": "Aslında Önseziyi çalan kişi, bu kahramanın son turdaki rakibi olacaktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021208
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021208,
					"content": "Karşılaşmayı kazanma şansının olmadığını biliyordu, bu yüzden aklında ödülü çalmak gibi kötü bir fikir vardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021209
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021209,
					"content": "Bu durumda Güneyhaçı Yarışmasının nihai sonucu açıklanmalıdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021210
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021210,
					"content": "Ne? Bu tür durumlarda böyle mi olur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021211
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021211,
					"content": "Aynen, durum bu şekilde ise o zaman kurallar onun diskalifiye olmasını şart koşuyor... Böylece buradaki kahramanımız da şampiyon oluyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021212
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021212,
					"content": "Paimon kazanacağımızı düşünmüştü ama böyle olacağını düşünmemişti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021213,
					"content": "Önemli değil, deyim yerindeyse \"Verilen onur hak edilmiş onurdur.\" Şimdi seni ödüllendirmek için şampiyon madalyasını hazırlayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021214
					],
					"speakerTitle": "Zhuhan"
				},
				{
					"id": 20021214,
					"content": "O zaman biz şimdi Inazuma'ya gidebilecek miyiz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021215
					]
				},
				{
					"id": 20021215,
					"content": "Evet, sanırım öyle. Kaptan Beidou artık burada olmasa da, ben onu haberdar ederim. O, sözünün eridir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021216
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021216,
					"content": "Ama Inazuma'ya gitmek için çok tehlikeli yollardan geçilir. Yolculuk boyunca bitmek bilmeyen bir fırtınaya tutulacaksın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021217
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021217,
					"content": "Aslında dinmeyen yağmurların yağması ve rüzgarların esmesi Şogun Raiden'ın iradesinin vücut bulmuş halidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021218
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021218,
					"content": "Bir saniye, onun sadece zihin gücünü kullanarak hava durumunu değiştirebildiğini mi söylüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021219,
					"content": "Onun, Yedi Hükümdardan biri olduğunu unutmamak gerek. Liyue'nin Morax'ı, taş mızraklarını atarak Guyun Taş Ormanı'nı oluşturabiliyorsa, Şogun Raiden'ın sonsuz bir fırtına çağırabilmesi çok şaşırtıcı olmamalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021220
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021220,
					"content": "Yalnız şu kadarını söyleyeyim, Inazuma'ya gitmek istiyorsanız Alcor'un biraz zamana ihtiyacı olacak. Tüm hazırlıklar tamamlandığında bilgilendirileceksiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021221
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021221,
					"content": "Bu arada ben de bir yolculuğa çıkmayı düşünüyorum. Önseziyi uyandırma umuduyla Liyue'nin engin topraklarının dört bir yanına seyahat edeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021222
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021222,
					"content": "Paimon, senin bir şekilde yolunu bulacağına inanıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021223,
					"content": "Teşekkür ederim. Umarım ikimizin yolculuğu da anlamlı olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021224
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021224,
					"content": "Son bir uyarım olacak. Yolculuğunuzun fırtınadan sonraki kısmı en meşakkatli kısım olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
