			"dialogs": [
				{
					"id": 20020201,
					"content": "Hah, neden hâlâ gelmemiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020202
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020202,
					"content": "#Boş ver, önce senin girişini yaparak başlayalım {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020203
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020203,
					"content": "Herkes dinlesin. Dikkat dikkat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020204
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020204,
					"content": "Güneyhaçı Yarışmasının doruk noktasına ulaştık. Bu, son karşılaşma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020205
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020205,
					"content": "Bugün birçok heyecan verici savaş gördük ve nihayet iki finalist belirlendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020206
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020206,
					"content": "Şimdi sizi ilk savaşçımızla tanıştırmak istiyorum. Çok az kişi onu görmüş olsa da şöhreti sınır tanımıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020207
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020207,
					"content": "#Onun varlığı Osial'ın kalbine korku salıyor ve sadece adının anılması bile Fatui Habercilerinin renginin atmasına neden oluyor... Liyue'nin gezgin kahramanı {NICKNAME} karşınızda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020208
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020208,
					"content": "Vuuuhuuu, vay canına!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020209
					],
					"speakerTitle": "Yarışmacı"
				},
				{
					"id": 20020209,
					"content": "Bu anı uzun zamandır bekliyordum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020210
					],
					"speakerTitle": "Yarışmacı"
				},
				{
					"id": 20020210,
					"content": "Onun yarı finaldeki nefes kesici karşılaşmasını eminim herkes görmüştür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020211
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020211,
					"content": "Ama bugünkü son tur, çıtayı kesinlikle bir üst seviyeye taşıyacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020212
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020212,
					"content": "Diğer savaşçımıza gelince... Şey, henüz gelmemiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020213
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020213,
					"content": "Hadi ama, gelmesi neden bu kadar uzun sürdü ki? Önceki turlarda olduğu gibi savaşa gelmeyerek hükmen mağlup sayılma olamaz... Final bu sonuçta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020214
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020214,
					"content": "Özür dileriz! Lütfen biraz daha sabırlı olun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020215,
						20020216
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020215,
					"content": "Belki karşılaşmanın zamanını karıştırmıştır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020217
					]
				},
				{
					"id": 20020217,
					"content": "Başka seçeneğimiz yok... Gelmezse karşılaşmayı ertelememiz gerekecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020218
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020218,
					"content": "Bir dakika. Bence bu işin içinde bir iş var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020219
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020219,
					"content": "Kaptan Beidou, belki de gidip ödülü bir kontrol etmeliyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020220
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020220,
					"content": "#{NICKNAME}, bizimle gel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020216,
					"content": "Belki finale çıkmaktan korkuyordur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020217
					]
				}
			]
		},
