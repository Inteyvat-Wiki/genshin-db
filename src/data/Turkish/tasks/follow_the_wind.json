					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20021101,
					"content": "Ahhh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021102
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20021102,
					"content": "Hayır, hayır! Ne istersen yap ama alnıma sakın bir şey damgalama, lütfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021103
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20021103,
					"content": "Hım... Yaşam ile ölüm arasındaki o ince çizgiye geldi ve şimdi ölüm tam ensesinde... Ama yine de tanrılar ona lütufta bulunmuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021104
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021104,
					"content": "Önseziyi bırak ve git. Fikrimi değiştirdim. Sana ceza vermeyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021105
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021105,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021106
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20021106,
					"content": "Sorun ne? Cezalandırılmak mı istiyorsun yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021107
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021107,
					"content": "Sen bilirsin. Cezalandırılmak istersen eğer, buna gönüllü olman elbette övgüyü hak eder ve samurayların tarzına daha uygundur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021108
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021108,
					"content": "H-hayır, buna gerek yok. Beni serbest bıraktığın için teşekkürler. Gerçekten çok cömertsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021110
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20021110,
					"content": "Hah, Paimon gerçekten anlamıyor. Sadece onu korkutmaya mı çalışıyordun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021111,
					"content": "Başkalarını korkutmaktan zevk almam. Sadece Önsezi ondayken, elimden geldiğince tüm ihtimalleri deniyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021112
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021112,
					"content": "Amacım onu zorlamaktı. İnsanların en güçlü yanları, köşeye sıkıştırıldıklarında ortaya çıkar. Bunun, Önseziyi uyandırması için bir fırsat olabileceğini düşündüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021113
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021113,
					"content": "Ne yazık ki hiçbir şey olmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021114
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021114,
					"content": "Yani en başından beri bunu mu planlıyordun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021115
					]
				},
				{
					"id": 20021115,
					"content": "Evet, sönmüş bir Önsezinin uyandırılıp uyandırılamayacağını öğrenmek istedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021116
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021116,
					"content": "Önseziyi çaldığı andan itibaren, bu deney için onu kullanmaya karar verdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021117
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021117,
					"content": "Geçmişte başka birçok yöntem denedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021190
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021190,
					"content": "\"Efendisiz bir Önsezinin yeniden uyanmasından\" bahseden çok az hikaye olmasına rağmen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021191
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021191,
					"content": "Birçok elemente hükmettiğini gördükten sonra, hiçbir şeyin imkansız olmadığını anladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021192
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021192,
					"content": "Gel, neden sen de bir denemiyorsun? Bakalım, bana umduğum cevabı verebilecek misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021118,
						20021119
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021118,
					"content": "Deneyeceğim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021120
					]
				},
				{
					"id": 20021120,
					"content": "Hım, Önsezi hiç yanıt vermiyor gibi görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021121,
					"content": "Anladım... O zaman Önseziyi sen de yeniden harekete geçiremiyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021122
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021122,
					"content": "Olsun bakalım, zaten böyle olmasını bekliyordum ben de. Sanırım bu Önsezi şimdilik bende kalmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021123,
						20021124
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021123,
					"content": "Bu Önseziye neden bu kadar bağlısın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021125
					]
				},
				{
					"id": 20021125,
					"content": "Evet, bu Önsezinin hikayesi nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021126,
					"content": "Aslında hikaye ta eski bir arkadaşa dayanıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021127
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021127,
					"content": "Şu anda yaptığım her şeyin, belki bir gün çok manasız olduğunu anlarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021128
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021128,
					"content": "Ama gezgin bir samuray olarak, ben hayatın anlamını seyahat etmekte ve doğanın yol boyunca yayılan güzelliğinde buluyorum; bir yandan da kalbimdeki \"savaşçı yolu\"nu korumaya devam ediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021129
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021129,
					"content": "Kazuha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20021130,
					"content": "Hehe, bu bir nevi \"canım ne isterse onu yaparım\" demenin başka bir yolu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021131
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021131,
					"content": "Tamam o zaman. Geri dönsek iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021132,
						20021134
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021132,
					"content": "Gidelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021133
					]
				},
				{
					"id": 20021133,
					"content": "O halde, bir kez daha bizi götürmesi için rüzgarı çağırayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021134,
					"content": "Daha fazla konuşmak istersen, seni dinleyebilirim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021135
					]
				},
				{
					"id": 20021135,
					"content": "Hislerim senin canını sıkmasın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20021136
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021136,
					"content": "Ama teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20021124,
					"content": "Önseziyi yeniden harekete geçirmeye neden bu kadar kararlısın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021125
					]
				},
				{
					"id": 20021119,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20021120
					]
				}
			]
		},
