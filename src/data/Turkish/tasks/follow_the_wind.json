				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20020901,
					"content": "Bana yetiştin... Bu nasıl mümkün olabilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020902
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020902,
					"content": "Hızlı bir şekilde kaçmak için bir tekne bile ayarlamıştım ama bana yetiştin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020903
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020903,
					"content": "Hiçbir tekne, rüzgarın hızına ulaşamaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020904
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020904,
					"content": "Rüzgar mı? Neden bahsediyorsun sen? Ha, anladım... Önsezin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020905
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020905,
					"content": "Kahretsin, keşke bir Önsezim olsaydı... Ya da bunu etkinleştirebilseydim, o zaman beni yakalayamazdın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020906
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020906,
					"content": "Bunun Önsezilerle bir ilgisi yok. Kalabalıkta kaybolma konusunda becerikli olabilirsin ama kendini doğanın bakışından gizlemeyi pek beceremiyorsun gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020907
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020907,
					"content": "Ayrıca seçtiğin kaçış yolun da çok fazla nedenden dolayı hatalıydı. Üstelik seni takip ederken, böbürlenişini ve kibirli kahkahanı rüzgarda duyabiliyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020908
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020908,
					"content": "Başka bir deyişle, bir soygun için gereken temel kriterlerin hiçbirini sağlayamamışsın; yani hızı, gizliliği ve tarzı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020909
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020909,
					"content": "Sen... Sen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020910
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020910,
					"content": "Ama en hayal kırıklığına uğratıcı şey, elindeki Önsezinin durumu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020911
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020911,
					"content": "Görünen o ki Önsezi, öyle her insanın arzusuna yanıt vermiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020912
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020912,
					"content": "Tamam, tamam! İtiraf ediyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020913
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020913,
					"content": "Uzun süre önce bu Önseziye göz koymuştum. Bu savaş yarışmasının bir grup berbat savaşçıyla dolu olduğunu duyduktan sonra, ben de kaydolmaya karar verdim. Finale kadar geldim ve...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020914
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020914,
					"content": "Aha, o zaman rakibimiz sen olacaktın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20020915,
					"content": "En başından beri yarışmayı yalnızca beceriyle kazanmayı düşünüyordum ama sonra sen ortaya çıktın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020916
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020916,
					"content": "Yarı finali izledikten sonra, sana karşı hiçbir şansım olmadığını anladım. Ama bunca yol kat ettikten sonra Önseziden öyle kolay kolay vazgeçemezdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020917
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020917,
					"content": "Maçta seninle karşılaşmanın hiçbir anlamı olmadığı için, herkes sana ve Beidou'ya bakarken becerilerimi konuşturmaya karar verdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020918
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020918,
					"content": "Kaçışımı özenle planladığıma emindim ama her nasılsa yine de bana yetişmeyi başardın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020919,
						20020921,
						20020927
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020919,
					"content": "Artık kaçamazsın, vazgeç gitsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020920
					]
				},
				{
					"id": 20020920,
					"content": "Of ya... Kahretsin... Bu... Bu çok farklı olabilirdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020923
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020923,
					"content": "Daha fazla direnirsen kötü şeyler olacak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020924
					]
				},
				{
					"id": 20020924,
					"content": "Hah! Boş tehditler bunlar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020928
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020928,
					"content": "Tamam... Ama alavere dalavere yok! Zaten onu aldığımda etkinleşmedi, benim için işe yaramaz bir kabuktan başka bir şey değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020929
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020929,
					"content": "Biliyor musun? Deniz hukukuna göre çalmanın cezası, suçlunun kolunu kırmaktır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020930
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020930,
					"content": "Ne? Ciddi değilsin, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020931
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020931,
					"content": "Çaldığın şeyin aslında bir ödül olduğundan, final karşılaşmasına çıkmadığından ve Güneyhaçı Filosu kaptanının adını lekelediğinden bahsetmiyorum bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020932
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020932,
					"content": "Sanırım sıcak bir demirle alnına \"hırsız\" kelimesini damgalamak daha da adil olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020933
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020933,
					"content": "Hey, hey, o kadar ileri gitmemize gerek yok, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020934
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20020934,
					"content": "Of, bu kadar zalim olabileceğini hiç tahmin etmezdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020935
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020935,
					"content": "Böyle konuşarak beni ikna etmeye çalışıyorsan unut gitsin. Gider savaşırım daha iyi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020921,
					"content": "Önseziyi ver.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020922
					]
				},
				{
					"id": 20020922,
					"content": "Onu almak için yaşadığım onca şeyden sonra mı? Hiç sanmıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020925
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020925,
					"content": "Dediğimizi yaparsan başına bir şey gelmeyecek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020926
					]
				},
				{
					"id": 20020926,
					"content": "G-gerçekten mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020928
					],
					"speakerTitle": "Fei"
				},
				{
					"id": 20020927,
					"content": "Önseziden vazgeçersen gitmene izin veririz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020928
					]
				}
			]
		},
		{
			"id": 200211,
			"completionStepIds": [
				200211
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
