			"dialogs": [
				{
					"id": 20020401,
					"content": "Bakayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020402
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020402,
					"content": "Gitmiş... Önsezi kaybolmuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020403
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020403,
					"content": "Ne? Biri mi çalmış? Kim gündüz gözüyle böyle bir şey yapmaya cesaret edebilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20020404,
					"content": "Tam olarak ne zaman çalındığını bilmiyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020405
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020405,
					"content": "Ne! Buradaki kimsenin Kaptan Beidou'yla karşı karşıya gelmeye cesaret edebileceğini düşünmemiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020406
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020406,
					"content": "Endişelenmenize gerek yok, en düzenbaz hırsız bile doğanın dikkatli bakışlarından kaçamaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020407
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020407,
					"content": "Hım... Suç işleneli çok olmamış. Çok uzağa gitmiş olamazlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020408
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020408,
					"content": "Teklif ettiğim ödül Önseziydi ve ona göz kulak olmak benim sorumluluğumdu. Ne olursa olsun onu geri alacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020409
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020409,
					"content": "İyi madem ısrar ediyorsun, bu meseleyi sana bırakıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020410
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020410,
					"content": "Burada kalıp karşılaşmayı izlemeye gelenlere bir açıklama yapmaya çalışacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020411
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20020411,
					"content": "#İstersen benimle gel {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020412,
						20020413
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020412,
					"content": "Sanırım yapabileceğimiz pek bir şey yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020414
					]
				},
				{
					"id": 20020414,
					"content": "Hım, bir adadayız gerçi, nereye kaçmış olabilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20020415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20020415,
					"content": "Benimle gelin. Rüzgarın geldiğini hissedebiliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20020413,
					"content": "Zaten rakibim gelmedi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20020414
					]
				}
			]
		},
