			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Daipai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110100101,
					"content": "Dikkatli ol Gezgin. Şu an turistik gezi yapacak zaman değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100102
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100102,
					"content": "Neden? Bir şey mi oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100103,
					"content": "Evet. Tuhaf gelebilir ama gören birkaç kişinin verdiği raporlara göre, normal bölgelerinden çok uzak olsa da bu bölgede faaliyet gösteren Harabe Muhafızları olduğu doğrulandı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100104
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100104,
					"content": "Çavuş bu antik makinaların nereden geldiğini öğrenmek için birini gönderdi. Anlaşılan ortada hiçbir neden yokken harabelerini terk ederek gitmişler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100105
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100105,
					"content": "Yani onları birisi mi uyandırmış?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100106,
					"content": "Dediğim gibi neden gittikleri hâlâ belli değil. Elimizde şu an pek bir bilgi yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100107
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100107,
					"content": "Dahası, bahsettiğimiz harabe özellikle korkunç olanlardan. Harabenin içinden sık sık tuhaf sesler duyuluyormuş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100108
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100108,
					"content": "Bu yüzden karargahtan emir gelene kadar inceleme iznimiz yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100109,
						110100110
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100109,
					"content": "Dikkatli olmak gerek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100113
					]
				},
				{
					"id": 110100113,
					"content": "Her durumda şimdilik tek mantıklı strateji Taşordu devriyelerini artırmak. Masum sivillere zarar gelmesine izin veremeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100114
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100114,
					"content": "Haklısın. Harabe Muhafızları sıradan insanlar için epey tehlikelidir muhtemelen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100115,
					"content": "Nasıl yardımcı olabilirim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100116
					]
				},
				{
					"id": 110100116,
					"content": "Şey... Teklif ettiğin için teşekkürler ama bu riske değmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100117
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100117,
					"content": "#Sen onu kafana takma! Harabe Muhafızlarını yenmek {NICKNAME} için çocuk oyuncağı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100118,
						110100120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100118,
					"content": "Ben de kendimi korumayı bilirim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100119
					]
				},
				{
					"id": 110100119,
					"content": "Öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100122
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100122,
					"content": "Peki, gerçekten bunu yapmak istiyorsan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100123
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100123,
					"content": "<color=#00E1FFFF>Tepenin yanında</color> Harabe Muhafızının ayak izlerini gördüm ama o zamandan beri geçenleri uyarmakla meşgul olduğum için kendim inceleyemedim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100124
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100124,
					"content": "Ayak izi mi? İlginç... Sen bu işi bize bırak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100125,
					"content": "Taşordu nöbetteyken kötülük asla kazanamayacak! Taşordu adına seni selamlıyorum Gezgin. Teşekkür ederim. Devriyem biter bitmez yanına geleceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100120,
					"content": "Övünmek gibi olmasın ama kavgada onunuzu dövebilirim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100121
					]
				},
				{
					"id": 110100121,
					"content": "Ahaha, gençler kendilerine çok güveniyor bakıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100122
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100110,
					"content": "Taşordu... Hep yetersiz kalıyorlar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100111
					]
				},
				{
					"id": 110100111,
					"content": "Efendim? Bir şey mi dedin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100112
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100112,
					"content": "Usta Diluc'un Favonius Şövalyeleri hakkında konuşurkenki halini mi taklit ediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100113
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1101002,
			"completionStepIds": [
				1101004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101004",
							"2"
						],
						"stepId": 1101004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Teucer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110100201,
					"content": "Hey siz! Baksanıza, harika değil mi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100202
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100202,
					"content": "Ne giydirmişler ona öyle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100203,
					"content": "Daha önce bunları hiç bu kadar yakından görmemiştim! Siz görmüş müydünüz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100204,
						110100206
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100204,
					"content": "Evet. Bu güçsüz bir Harabe Muhafızı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100205
					]
				},
				{
					"id": 110100205,
					"content": "Anlamadım? Adı Bay Tepegöz onun! \"Harabe Muhafızı\" diye isim mi olur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100208
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100208,
					"content": "Bay Tepegöz mü? Çok tatlıymış... Bir dakika! Cidden öyle mi diyor insanlar bunlara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100209,
					"content": "Tabii! Abim öyle söyledi. O dünyanın en iyi oyuncakçısıdır. Hep bu tür şeyler satar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100210
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100210,
					"content": "Şu an Liyue'deki Oyuncak Araştırma Enstitüsünde. Bay Tepegözler de oradan geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100211
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100211,
					"content": "Oyuncak seven birileriyle tanışmak her zaman güzeldir. Sen oyuncağını nereden aldın? Yeni bir tür galiba. Daha önce uçan ve konuşabilen oyuncak görmemiştim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100212,
						110100214
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100212,
					"content": "Paimon oyuncak değil. Harabe Muhafızları da öyle...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100213
					]
				},
				{
					"id": 110100213,
					"content": "Aynen öyle! Paimon oyuncak değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100216,
					"content": "Merhaba, bir şey buldum galiba... Bu... Bir çocuk mu? N-Ne oluyor burada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100217
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100217,
					"content": "Çocuğu biz bulduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100218,
					"content": "Buralarda dolanmaman gerekir evlat. Etrafta ölümcül makinalar var. Çok tehlikeliler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100219
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100219,
					"content": "Ölümcül makinalar mı? Buna benzeyenlerden mi bahsediyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100220
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100220,
					"content": "Evet, bu da dahil. Şimdi hareket etmiyor ama uyanırsa bunun sonuçları çok kötü olabilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100221
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100221,
					"content": "Sözünü geri al! Bay Tepegöz ölümcül makina falan değil! İyi biri o!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100222
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100222,
					"content": "\"Bay Tepegöz\" mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100223
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100223,
					"content": "Dinlemeyin bu adamı. Bay Tepegöz hakkında kötü şeyler söylediğine göre belli ki o da kötü bir adam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100224
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100224,
					"content": "Sadece yardım etmeye çalışıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100225,
						110100226
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100225,
					"content": "Seni anlamadı galiba...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100227
					]
				},
				{
					"id": 110100227,
					"content": "Çocuklarla aram hiç iyi değildir zaten...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100228
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100228,
					"content": "O zaman neden asıl işine dönüp çocuk bakıcılığını bize bırakmıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100229,
					"content": "Görünüşe göre başka seçeneğim yok... Ben devriyeme devam edeyim. Görüşürüz. Siz de lütfen çocuğu güvenli bir yere götürün. Burası çok tehlikeli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100230
					],
					"speakerTitle": "Daipai"
				},
				{
					"id": 110100230,
					"content": "Hahahaha, güçlü Bay Tepegöz bir kez daha kötüleri korkutup kaçırdı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100231,
						110100232
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100231,
					"content": "Adın ne senin ufaklık?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100233
					]
				},
				{
					"id": 110100233,
					"content": "Adım Teucer! Liyue'de abimi bulmak için ta Snezhnaya'dan geldim ama tek başımayım ve onu nerede bulurum bilmiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100234
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100234,
					"content": "Snezhnaya'dan mı geldin buraya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100235,
					"content": "Sanırım şimdi bunu size vermem gerekiyor... Alın bakalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100236
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100236,
					"content": "Bu da ne? Ağır görünüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100237,
					"content": "Ne!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100238,
						110100239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100238,
					"content": "Çok Mora var burada!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100240
					]
				},
				{
					"id": 110100240,
					"content": "Abim yanıma almamı söylemişti. \"İyi birini bulup bunu ona verirsen sana iyi bakar Teucer.\" demişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100241
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100241,
					"content": "Abin haklıymış... Yine de bunca yolu cebinde sadece birkaç kese Morayla gelmiş olduğuna inanamıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100242,
					"content": "Ailen çok zengin olmalı! Paimon oyuncak satarak bu kadar Mora kazanılabildiğini bilmiyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100243,
						110100244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100243,
					"content": "Memnuniyetle kabul ediyorum!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100245
					]
				},
				{
					"id": 110100245,
					"content": "Yaşasın! Teşekkür ederim, çok kibarsın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100246
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100246,
					"content": "Şimdi de birbirimize söz vermemiz lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100247
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100247,
					"content": "Bak söz verdin sen bana, hep tutacaksın ama. Dönersen bu sözünden, atarım seni buza! Dostlar sözünü tutar, tutmayan buzda donar. Yine yalan söyleme diye, buz dilini dondurur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100248
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100248,
					"content": "Vay be... Söylediği tekerleme Snezhnaya kültürü hakkında çok şey anlatıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100249
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100249,
					"content": "Az önce değilsek bile artık kesinlikle bakıcın olduk! Peki abini nerede arayacağız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100250,
						110100252
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100250,
					"content": "Snezhnaya'yla bağlantısı olan bir yerde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100251
					]
				},
				{
					"id": 110100251,
					"content": "Snezhnaya... <color=#00E1FFFF>Kuzey Bankası</color> olabilir mi, ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100254
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100254,
					"content": "Harika! Sonunda abimi görebileceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100252,
					"content": "<color=#00E1FFFF>Kuzey Bankası</color> nasıl?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100253
					]
				},
				{
					"id": 110100253,
					"content": "İyi fikir. Hadi gidelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100254
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100244,
					"content": "Memnuniyetle kabul ediyorum! (ve abini bulduğumuzda bunu ona vereceğim.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100245
					]
				},
				{
					"id": 110100239,
					"content": "Ne kadar fazla Mora var burada böyle!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100240
					]
				},
				{
					"id": 110100232,
					"content": "Ailen nerede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100233
					]
				},
				{
					"id": 110100226,
					"content": "Belki bunu ben halletsem daha iyi olacak...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100227
					]
				},
				{
					"id": 110100214,
					"content": "Sınırlı sürüm hem de. Kıskandın mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100215
					]
				},
				{
					"id": 110100215,
					"content": "Hey! Sürekli Paimon'la oynayabiliyorsun diye Paimon oyuncak sayılmaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100206,
					"content": "Dikkatli ol evlat, çok güçlüdür bunlar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100207
					]
				},
				{
					"id": 110100207,
					"content": "Ne sandın! Bay Tepegözler inanılmaz kuvvetlidir! Kötüler asla kaçamaz onlardan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100208
					],
					"speakerTitle": "Teucer"
				}
			]
		},
		{
			"id": 1101003,
			"completionStepIds": [
				1101006
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101006",
							"2"
						],
						"stepId": 1101006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Asilzade"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110100301,
					"content": "Bu biraz uygunsuz bir davranış olmadı mı efendim? Ne hakla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100302
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 110100302,
					"content": "Rahatla. Çok sık olmadığı sürece zarar gelmez. Sorun yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100303
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110100303,
					"content": "Ne? O burada ne arıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100304,
					"content": "Yaşasın! Abi! Buldum seni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100305
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100305,
					"content": "Bu sesi tanıyorum... Kardeşim Teucer mı bu yoksa! İnanamıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100306
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110100306,
					"content": "Haha... Bu ne güzel sürpriz Teucer! Eve dönene kadar seni göremeyeceğimi sanıyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100307
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110100307,
					"content": "Diğerleri nasıl? Tonia ve Anthon... Herkes iyi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100308
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110100308,
					"content": "Seni çok özlediler! Tonia her gün akşam yemeğinde senin için dua ediyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100309
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100309,
					"content": "Dur bir dakika. Liyue'de ne işin var Teucer? Niye kimse geldiğini bana söylemedi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100310
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110100310,
					"content": "Şey... Şöyle oldu... Oyuncak satıyor gibi duran bir tekne gördüm ve haliyle senin de teknede olduğunu düşündüm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100311
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100311,
					"content": "Tekneden indiğimde de yürümeye devam ettim ve sonra bir Bay Tepegöz buldum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100312
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100312,
					"content": "#Bay Tepegöz kötü bir adamı korkutup kaçırdı. Sonra da bu kibar {M#beyefendiyi}{F#hanımefendiyi} buldum. O da seni bulmama yardımcı oldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100313,
						110100315
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100313,
					"content": "Teucer kaçak yolculuk yapmış demek!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100314
					]
				},
				{
					"id": 110100314,
					"content": "Teucer ayrıca Asilzade'nin kardeşi miymiş?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100316,
					"content": "Harika! Paimon nedense artık Teucer'ın parasını aldığına pişman değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100317,
					"content": "Teucer, yaptığın çok tehlikeli bir şeydi. İnan bana seni gördüğüme gerçekten çok sevindim ama lütfen bir daha böyle bir şey yapmayacağına söz ver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100318
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110100318,
					"content": "Tamam, söz veriyorum ama lütfen bana kızma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100319
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100319,
					"content": "Sana kızmadım. Sadece iyiliğini düşünüyorum, o kadar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100320
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110100320,
					"content": "Bu iyi insanlara denk gelmesen başına çok kötü şeyler gelebilirdi Teucer. Onlara teşekkür ettin, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100321
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110100321,
					"content": "Evet! Lütfen ve teşekkür ederim demeyi asla unutmam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100322
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100322,
					"content": "Demek burada olduğumuzu fark ettin ama bizi görmezden geliyordun. Anlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100323,
					"content": "Hahaha, kusura bakmayın. Memleketimde aile her şeyden önce gelir. Saygısızlık etmek istemedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100324
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110100324,
					"content": "Bu zamana kadar farklı görüşlerimiz oldu ama birkaç küçük tartışmayı saymazsak iyi anlaşıyoruz değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100325,
						110100326
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110100325,
					"content": "Ciddi misin yoksa anlaşamadığımızı belli etmemeye mi çalışıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100327
					]
				},
				{
					"id": 110100327,
					"content": "Yapmayın. Biliyorsunuz ben bu olayda sadece bir piyonum. Üzerime düşeni yapıyorum. Kimin kazanıp kimin kaybettiğine, iki tarafın da sonuçlarla nasıl başa çıktığına gelince... Orasını oyunu oynayanlara bırakmayı tercih ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100328
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110100328,
					"content": "Ben daha çok ufak dövüşlerimizde kimin kazanıp kimin kaybettiğiyle ilgileniyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100329
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110100329,
					"content": "Yine sana dersini verelim istiyorsun galiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100330,
					"content": "Hah! Benim hakkımda unuttuğunuz bir şey var... Ben, Tartaglia, her saniye daha da güçleniyorum. Bir dahakine işiniz o kadar kolay olmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100331,
						110100332
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110100331,
					"content": "Ben de o zamandan beri oldukça güçlendim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100333
					]
				},
				{
					"id": 110100333,
					"content": "Bekleyin! Şimdi dövüşmeyeceksiniz değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100334,
					"content": "Hahaha... Belki daha sonra. Küçük kardeşim izlerken olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100335
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110100335,
					"content": "Neden bu kibar insanla kavga etmek istiyorsun? Düşman mısınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100336
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100336,
					"content": "#Hayır, hem de hiç değiliz! {NICKNAME}, kardeşime göz kulak olduğun için çok teşekkür ederim. Onun güvende olması benim için çok önemli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100337,
						110100338
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110100337,
					"content": "Yine de gözüm üzerinde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100339
					]
				},
				{
					"id": 110100339,
					"content": "Paimon bir şeyi merak ediyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100340
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100340,
					"content": "Teucer oyuncak sattığından bahsetti... Neden bahsediyor? Sen Fatui'nin On Bir Habercisinden biri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100341
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100341,
					"content": "Öhöm! Evet, şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100342
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110100342,
					"content": "Sessiz olun biraz. Sadece beni örnek alsın diye öyle dedim ona. Bir çocuk için oyuncaklarla çalışmak hayal edebileceği en iyi meslek değil midir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100343
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110100343,
					"content": "Ailemin Fatui'nin... Ya da daha doğrusu Snezhnaya'nın karanlık yüzüne bulaşmasını istemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100344
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110100344,
					"content": "Büyükler zaten Çariçe'ye hizmet ettiğimi biliyor ama Teucer hâlâ çok genç. Onun gözünde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100345
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110100345,
					"content": "Neyse, ne diyordum? Hâlâ Snezhnaya'dan gelen en büyük oyuncak satıcısı benim. Şu an Oyuncak Araştırma Enstitüsünün Liyue Şubesinde çalışıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100346
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110100346,
					"content": "Aynen öyle! Abim en iyisidir! Bay Tepegözün en iyi arkadaşıdır o!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100347
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100347,
					"content": "Lütfen Teucer'ın yanındayken hikayeme arka çıkın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100348
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110100348,
					"content": "Evet Ekaterina. Tamamlanmayan ödemeyle hemen ilgileneceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100349
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110100349,
					"content": "Hey! Kaçıyor musun yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100350
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100350,
					"content": "Ama Usta Asilzade, sizden borç toplamak gibi bir şeyle ilgilenmenizi istemek uygun olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100351
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 110100351,
					"content": "İddia da olsa söz sözdür değil mi? İddiayı kaybettiğime göre en azından biraz egzersiz yapmış olurum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100352
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110100352,
					"content": "Oyuncak mı satacaksın yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100353
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100353,
					"content": "#Aynen öyle! Biraz daha hasret gidermek isterdim seninle Teucer ama iş beklemez! Eminim bu {M#Kibar Beyefendi}{F#Kibar Hanımefendi} benim yokluğumda seninle ilgilenmekten mutluluk duyar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100354
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110100354,
					"content": "Öf. Senin için çocuk bakmaya devam edeceğiz yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100355
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110100355,
					"content": "Olur! Zaten onu çok sevdim. Bana iyi bakacağına söz verdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100356
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110100356,
					"content": "Teucer sizi çok sevmiş galiba. Zaten ona iyi bakacağınıza dair söz vermişsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100357,
						110100358
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110100357,
					"content": "(Herkes bana baskı yapıyor...) Tamam, olur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100359
					]
				},
				{
					"id": 110100359,
					"content": "O zaman size borçluyum. Bunu alın. Teucer'ı eğlendirmek için kullanırsınız. Liyue'deyken iyi vakit geçirmesini istiyorum. Onu istediği her yere götürün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110100360
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110100360,
					"content": "Gerekirse beni <color=#00E1FFFF>Qingxu Göleti'nin</color> yakınındaki nehrin yanında bulabilirsiniz. Görüşürüz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110100358,
					"content": "Tamam, bunu yapacağız ama Teucer için.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100359
					]
				},
				{
					"id": 110100338,
					"content": "Ailenin iyiliğini düşünmeni anlayabiliyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100339
					]
				},
				{
					"id": 110100332,
					"content": "Ne zaman hazırsan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100333
					]
				},
				{
					"id": 110100326,
					"content": "Bu ne yüzsüzlük...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100327
					]
				},
				{
					"id": 110100315,
					"content": "Teucer Asilzade'nin kardeşi miymiş?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110100316
					]
				}
			]
		},
