			"dialogs": [
				{
					"id": 790460901,
					"content": "Gerçi taşa dönen bir Su Damlacığı iksir içebilir mi? Hem zaten su nasıl su içebilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460902,
					"content": "Aa! Belki bu iksir sürülen bir iksirdir! Gidip deneyelim en iyisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7904610,
			"completionStepIds": [
				7904610
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7904610",
							"2"
						],
						"stepId": 7904610,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790461001,
					"content": "Of! Görüş alanlarından kaçmak imkansız! Bu, bildiğin hile sayılır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461002,
					"content": "Paimon şu dev mekanizmaları tekmeleyip devirmek istiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461003,
					"content": "Su Damlacığı, dur! Ne yapıyorsun? Hayaletler var orada, çok tehlikeli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461004,
					"content": "Küstah canlılar, aklınızı mı kaybettiniz? Yoksa tüm umudunuzu kaybettiniz de öbür dünyadaki arkadaşlarınıza mı katılmak istiyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461005
					],
					"speakerTitle": "Öfkeli Hayalet Lideri"
				},
				{
					"id": 790461005,
					"content": "Eyvah! Görüş alanlarını engellemek için bedenini siper etti... Kendini böyle asilce feda etmek alına nereden geldi acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461006
					],
					"speakerTitle": "Mutlu Hayalet Lideri"
				},
				{
					"id": 790461006,
					"content": "Beklenmedik bir gelişme! Yalnız Su Tayfı, kendini hayaletin bakışlarının önüne fırlatarak bedeniyle ölümcül bakışı engelledi ve şu anda yavaşça taşa dönüşüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461007
					],
					"speakerTitle": "Hoparlördeki Anlatıcı"
				},
				{
					"id": 790461007,
					"content": "Su Damlacığı taşa dönüştü... Sırf anahtarı alabilelim diye...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461008,
						790461009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461008,
					"content": "Su Damlacığını hâlâ kurtarabiliriz!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461010
					]
				},
				{
					"id": 790461010,
					"content": "Aa, evet! Doğru! Hayaletlerin görüş alanında uzun süre durmadığımız sürece sorun olmaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461011,
					"content": "Su Damlacığı çözmüş mü bunu yani? Ne kadar akıllı ve cesurmuş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461012,
					"content": "#{NICKNAME}, hadi hemen şu anahtarı bulup ilacı alalım! Su Damlacığını böyle bekletemeyiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461009,
					"content": "Acele etmemiz lazım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461010
					]
				}
			]
		},
		{
			"id": 7904611,
			"completionStepIds": [
				7904612
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
