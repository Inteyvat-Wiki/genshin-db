			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790461101,
					"content": "Hoparlördeki anlatıcı, önünüzde yaşanan tuhaf sahneyi anlatmaya devam eder:\\nİki akıllı bilge, ilacı yavaşça Su Tayflarının taşlaşmış bedenlerine döker ve tuhaf bir şey yaşanır...\\nTaşlaşmış Su Tayfı, zaman adeta geriye akıyormuşçasına normale dönmeye başlar...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790461102
					]
				},
				{
					"id": 790461102,
					"content": "*ağlar* Demek taşa dönmek böyle bir hismiş... Böyle bir acı, böyle bir ızdırap olamaz! Arkadaşlarımın bunu daha fazla çekmesine izin veremem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461103
					],
					"speakerTitle": "Yalnız Su Tayfı"
				},
				{
					"id": 790461103,
					"content": "Su Damlacığı, hiçbir şey söylemeden nasıl atarsın kendini öyle? Paimon korkudan ölecekti! Neyse ki ilacı çabuk bulduk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461104,
					"content": "O hayalet çok korkunçtu, o kadar korktum ki konuşamadım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461105
					],
					"speakerTitle": "Yalnız Su Tayfı"
				},
				{
					"id": 790461105,
					"content": "Üstelik siz o kadar akıllısınız ki bence size bir şey dememe bile gerek yoktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461106
					],
					"speakerTitle": "Yalnız Su Tayfı"
				},
				{
					"id": 790461106,
					"content": "Hem tamamen taşa dönüşseydim bile ilacı aldıktan sonra beni kurtaracağınızı ve her şeyin eski haline döneceğini biliyordum! O yüzden endişelenmeme gerek yoktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461107
					],
					"speakerTitle": "Yalnız Su Tayfı"
				},
				{
					"id": 790461107,
					"content": "Hım... Paimon kendini oyuna fazla mı kaptırdı acaba? Su Damlacığı için o kadar endişelendi ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461108,
						790461109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461108,
					"content": "Rolünü bu kadar benimsemen iyi bir şey bence.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461110
					]
				},
				{
					"id": 790461110,
					"content": "Eh... Paimon buraya eğlenmeye gelen bir misafir tamam ama bu oyunculuk işine kendini biraz fazla kaptırdı... Biraz utanç verici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461111,
					"content": "Neyse ya, başardık sonuçta! Artık ilacı alıp arkadaşlarını kurtarabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461112,
					"content": "Sağ olun, sağ olun! Size... Size yardımlarınız için o kadar çok şey borçluyum ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461113
					],
					"speakerTitle": "Yalnız Su Tayfı"
				},
				{
					"id": 790461113,
					"content": "Dostlarım ile bu yardımlarınızı asla unutmayacağız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461114,
						790461115
					],
					"speakerTitle": "Yalnız Su Tayfı"
				},
				{
					"id": 790461114,
					"content": "Lafı bile olmaz!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461116
					]
				},
				{
					"id": 790461116,
					"content": "Paimon bu hayaletlerin artık başınıza bela olmayacağını umuyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461117,
					"content": "Ormanda oynadığınızda daha dikkatli olun ama! Artık bu kaleye gelmek yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461118,
					"content": "Tebrikler! Akıllı bilgelerin kusursuz planları ve stratejileri ile Su Tayflarının cesareti bir araya gelerek muhteşem bir iş birliği sergiledi! Hayaletlerin lanetleri yakında tamamen ortadan kalkacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461119
					],
					"speakerTitle": "Hoparlördeki Anlatıcı"
				},
				{
					"id": 790461119,
					"content": "Akıllı bilgelerle karşılaşan hayaletler bir daha böyle alçaklıklar yapmayacaktır. Yalnız Su Tayfı ile dostları artık korku ve endişe yaşamadan oyun oynayabilirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461120
					],
					"speakerTitle": "Hoparlördeki Anlatıcı"
				},
				{
					"id": 790461120,
					"content": "Ürkütücü orman giderek huzurlu ve sessiz yanını göstermeye başlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461121
					],
					"speakerTitle": "Hoparlördeki Anlatıcı"
				},
				{
					"id": 790461121,
					"content": "\"Taşlaştıran Bakış\" oyunumuzun sonuna gelmiş bulunuyoruz. İzlediğiniz için teşekkür ederiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461122
					],
					"speakerTitle": "Hoparlördeki Anlatıcı"
				},
				{
					"id": 790461122,
					"content": "Oley, \"Taşlaştıran Bakış\"ı bitirdik! Paimon kendini fena kaptırdı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461123,
					"content": "Hımm... Sahnedeki repliklerle hoparlördeki anlatıcının birleşimi, ortaya çok güzel bir iş çıkardı! Daiya bu tekniği nereden öğrendi acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790461124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461124,
					"content": "Fırsatını bulursak kendisine soralım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790461115,
					"content": "Bu kadar nezakete gerek yok!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461116
					]
				},
				{
					"id": 790461109,
					"content": "Paimon eğleniyor demek ki!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790461110
					]
				}
			]
		},
