			"dialogs": [
				{
					"id": 790460101,
					"content": "Tüm oyuncular geldi, sahne mekanizmaları da düzgün çalışıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460102
					],
					"speakerTitle": "Lunapark Duyuru Hoparlörü"
				},
				{
					"id": 790460102,
					"content": "\"Daiya'nın Üç Günlük Rüyası\"ndan \"Taşlaştıran Bakış\" oyunu başlıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460103
					],
					"speakerTitle": "Lunapark Duyuru Hoparlörü"
				},
				{
					"id": 790460103,
					"content": "Sık ağaçlarla dolu ürkütücü bir ormanın sınırlarında eğitimli iki bilge, tek başına dolanan bir Su Tayfıyla karşılaşır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460104
					],
					"speakerTitle": "Hoparlördeki Anlatıcı"
				},
				{
					"id": 790460104,
					"content": "Lütfen, yardım edin... Yardım edin! Arkadaşlarımı bırakmak istemiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460105
					],
					"speakerTitle": "Yalnız Su Tayfı"
				},
				{
					"id": 790460105,
					"content": "Su Damlacığı mıydı o? Bir dakika, konuşabiliyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460106,
						790460107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460106,
					"content": "Ses hoparlörden geldi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460108
					]
				},
				{
					"id": 790460108,
					"content": "Ha, yani bu Su Damlacığı aslında oyunun ana karakterlerinden biri, öyle mi? Bizim de ona göre davranmamız mı gerekiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460109,
					"content": "Su Tayflarının dilini derinlemesine araştırmış olan bu iki bilge, karşılaştıkları Su Tayfının yardım ricasını anlayabiliyordur neyse ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460110
					],
					"speakerTitle": "Hoparlördeki Anlatıcı"
				},
				{
					"id": 790460110,
					"content": "Bu, kaderde yazılı olan bir karşılaşma olmalı! Böyle bir durumda, bu Su Tayfına yardım etmemek olur mu hiç?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460111
					],
					"speakerTitle": "Hoparlördeki Anlatıcı"
				},
				{
					"id": 790460111,
					"content": "Vay! Bizim de kendi karakterlerimiz mi olacak? Süpermiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460112,
						790460113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460112,
					"content": "Konumuza dönelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460114
					]
				},
				{
					"id": 790460114,
					"content": "Biz... Ormandayken yolumuzu kaybettik ve eski bir kaleye denk geldik. Kalenin içinde uyuyan kötü ruhları uyandırdık yanlışlıkla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460115
					],
					"speakerTitle": "Yalnız Su Tayfı"
				},
				{
					"id": 790460115,
					"content": "Liderlerinden ikisi, bize... Lanetli bir büyü yaptı! Şimdi bir hayalet bizi gördüğü an... Taşa dönüşüveriyoruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460116
					],
					"speakerTitle": "Yalnız Su Tayfı"
				},
				{
					"id": 790460116,
					"content": "Ben kaçmayı zar zor başardım, ama dostlarım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460117
					],
					"speakerTitle": "Yalnız Su Tayfı"
				},
				{
					"id": 790460117,
					"content": "*ağlar* Şu an acı çekiyorlardır kesin... Bizim yüzümüzden mi oldu bu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460118
					],
					"speakerTitle": "Yalnız Su Tayfı"
				},
				{
					"id": 790460118,
					"content": "Tabii ki hayır! Hem o hayaletler bugün ters taraflarından kalkmış olsa bile böyle zalimlik yapılır mı hiç?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460119,
					"content": "Bak sen şu pisliklere! Su Damlacıklarını taşa çevirmek de ne demek? Zalimlik demek hafif kalır! Ne kadar kötülermiş o hayaletler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460120,
						790460121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460120,
					"content": "Kolay kolay unutamayacakları bir ders vereceğiz onlara.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460122
					]
				},
				{
					"id": 790460122,
					"content": "Hayır, hayaletlerin o iki lideri kendilerini hiç göstermediler. Kale de çok büyük... En güçlü ve en yetenekli maceracılar bile o ikisini bulamaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460123
					],
					"speakerTitle": "Yalnız Su Tayfı"
				},
				{
					"id": 790460123,
					"content": "Ama hayaletlerden birinden duydum, kalenin derinliklerinde bir sandık, o sandığın içinde de kadim lanetleri bozabilen bir iksir varmış... Tek umudumuz o...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460124
					],
					"speakerTitle": "Yalnız Su Tayfı"
				},
				{
					"id": 790460124,
					"content": "Sandık gizli bir odanın içindeymiş, o yüzden önce sakladıkları anahtarı bulmak gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460125
					],
					"speakerTitle": "Yalnız Su Tayfı"
				},
				{
					"id": 790460125,
					"content": "Gelin görün ki... Benim üzerimde şu an lanet var, tek başıma gidersem hayaletler beni kesin görür... Sonra da taşa dönüp sonsuza dek mahsur kalırım orada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460126
					],
					"speakerTitle": "Yalnız Su Tayfı"
				},
				{
					"id": 790460126,
					"content": "E kolaymış! Seninle beraber kaleye geliriz, anahtarı buluruz ve iksiri alırız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460127,
					"content": "Şu hayaletlerin bakışlarından kaçtığın sürece hiçbir şey olmaz, değil mi? Kolayca hallederiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460128,
					"content": "Evet, ikiniz... Akıllı bilgelersiniz, yapılması gerekeni biliyorsunuzdur... Lütfen, size yalvarıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460129,
						790460130
					],
					"speakerTitle": "Yalnız Su Tayfı"
				},
				{
					"id": 790460129,
					"content": "Paimon ne çabuk alıştı öyle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460131
					]
				},
				{
					"id": 790460131,
					"content": "Hehe, her şey gayet açık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460132,
					"content": "Asıl kötü liderleri yenemesek bile hayaletleri alt edip Su Damlacığının arkadaşlarını kurtarmak senin için çocuk oyuncağı, öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790460133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460133,
					"content": "Hadi küçük Su Damlacığı, gidip aradığın iksiri bulalım, laneti kaldıralım ve arkadaşlarını kurtaralım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790460130,
					"content": "Hikayenin nereye gittiğini nokta atışı tahmin ettin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460131
					]
				},
				{
					"id": 790460121,
					"content": "Arkadaşlarını kurtarabilir miyiz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460122
					]
				},
				{
					"id": 790460113,
					"content": "Ne oldu arkadaşlarına?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460114
					]
				},
				{
					"id": 790460107,
					"content": "Su Damlacığı konuşuyormuş gibi düşün.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790460108
					]
				}
			]
		},
