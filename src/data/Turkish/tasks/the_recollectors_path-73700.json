			"trigger": {
				"objectNames": [
					"Zurvan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737000101,
					"content": "Daha farkına bile varmadan eğitimin yarısına geldiniz bile. Her şey yolunda mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000102,
						737000103
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737000102,
					"content": "Epey iyi gidiyor diyebiliriz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737000104
					]
				},
				{
					"id": 737000104,
					"content": "Gerçi Sorush hikaye anlatırken kendinden bir şeyler katıyormuş gibi geliyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737000105,
					"content": "Diyalog kurmak Sorush'un öğrenmesi için etkili bir yöntem. Tabii bir de konuştuğu insanlar, Kuşkucular Cemiyetindeki insanlardan daha ilginç olunca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000106
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737000106,
					"content": "#Büyüğüm, çok acımasızsınız... {NICKNAME} gerçekten olağanüstü bir Yasnapati ama Kuşkucular Cemiyetinin tüm üyeleri de öyle dediğiniz kadar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000107
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737000107,
					"content": "Belki de o övgülerinin ve kandırmacalarının haricinde ara sıra da olsa gösterdikleri erdemli hareketler oluyordur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000108
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737000108,
					"content": "Of...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000109
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737000109,
					"content": "#Gördüğüm kadarıyla hâlâ ikna edilmen gerekiyor. Tanıklarımız {NICKNAME} ve Paimon'un senin performansınla ilgili yorumlarını dinleyeceğiz. Tabii sen anlatmayı bitirdikten sonra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 737000103,
					"content": "Hâlâ gelişmemiz gereken konular var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737000104
					]
				}
			]
		},
		{
			"id": 7370006,
			"completionStepIds": [
				7370006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7370006",
							"2"
						],
						"stepId": 7370006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sorush"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737000601,
					"content": "Burası çok sessiz. Hiç kimse yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737000602,
					"content": "Rashnu burada olsaydı da yine çok sessiz olurdu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000603
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737000603,
					"content": "Evet, ama Rashnu burada olsaydı biraz daha sessiz olmamız gerekirdi. Yüzünde hep o uykulu ifade var ve onu Kori Davullarıyla uyandırdığımızda hiç mutlu olmamış gibiydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737000604,
					"content": "Paimon, birisi ne kadar sessizse o kadar fena sinirlenir diye duymuştu. Acaba Rashnu sinirlendiğinde nasıl biri oluyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737000605,
					"content": "O zaman bu doğruysa en çok korkmamız gereken kişi Yasnapatim oluyor, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000606
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737000606,
					"content": "#Hım? Ha, onu en iyi Paimon tanır. {NICKNAME} çok konuşkan değildir ama yine de çok iyi biridir. Değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000607,
						737000609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737000607,
					"content": "Gerçekten çok sinirleneceğim şimdi. *kükrer*",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737000608
					]
				},
				{
					"id": 737000608,
					"content": "Gördün mü? Hiç de korkutucu değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737000611,
					"content": "Yeterli. Hadi işimize dönelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000612
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737000612,
					"content": "Gördüğünüz bu ağacın adı Barsom ve Rashnu da onun hizmetkarı. Kendisi şu an burada değil gerçi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000613
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737000613,
					"content": "Ee?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737000614,
					"content": "Ee mi? O kadar işte. Rashnu ve Barsom hakkında söyleyecek başka bir şey yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000615
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737000615,
					"content": "Bir şeyler saklıyorsun sanki... Evet, Kori Davulları hakkında bir şeyler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737000616,
					"content": "Sa-Saklamak mı? Saçmalama. Hem davullara gelince... Onları zaten çalınırken görmediniz mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000617
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737000617,
					"content": "Rashnu, Kori Davullarını başka bir yere atanın kendisi olduğunu söylemişti sanki. Nasejuna buna gerçekten şaşırmıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737000618,
					"content": "Paimon yanlış hatırlamıyorsa Sorush o sırada çok gergindi, Nasejuna'ya cevap bile vermemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737000619,
					"content": "Duruma bakılırsa Kuşkucular Cemiyetinin arşivleri gerçekten çoook yanlış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737000620,
					"content": "Çalan davullar Rashnu'yu uyandırdı gerçi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737000621
					]
				},
				{
					"id": 737000621,
					"content": "Paimon, Zurvan'ın neden günümüz Kuşkucular Cemiyetine güvenmediğini anlıyor galiba. Bir düşün Sorush. Sana gerçekten yardım ettiler mi? Verdikleri ipuçları doğru bile sayılmazdı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737000622,
					"content": "Şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000623
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737000623,
					"content": "Kuşkucular Cemiyetinde şu anda yetersiz üyeler var ancak tıpkı bir ağaç gibi, ne kadar çok yaprak açarsa açsın her zaman aralarında solup kuruyanlar olacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000624
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737000624,
					"content": "Bu kuru yapraklar bir kez kopup gittiklerinde geriye sağlam, güvenilir yapraklar kalır... Evet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000625
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737000625,
					"content": "Kuşkucular Cemiyeti nasıl bu hale geldi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000626
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737000626,
					"content": "Bunu ben de öğrenmek istiyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737000627
					]
				},
				{
					"id": 737000627,
					"content": "Kuşkucular Cemiyetinde uzun zamandır bulunduğum için yavaş yavaş gerçekleşen bu değişiklikleri fark edemedim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000628
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737000628,
					"content": "Ne zaman ki sizinle ve diğer yabancılarla konuştum, işte o zaman Kuşkucular Cemiyetinin değiştiğini anladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000629
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737000629,
					"content": "Beş yüz yıl geçti. Cemiyetin ismi aynı kalsa da üyeleri birkaç nesil değişmiş olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000630
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737000630,
					"content": "Peşinde koştuğum şöhret, Yasnapatinin beni övmesini beklediğim şöhret de böyle yok olup gidecek mi acaba... Her şey değişince geriye yalnızca içi boş unvanlar mı kalacak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000631
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737000631,
					"content": "Büyüğümün öğrenmemi istediği gerçek bu mu? Hayır, değildir... Ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000632
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 737000632,
					"content": "... Sorush, hemen moralini bozma! Belki de... Belki de Zurvan başka bir şey kastetmiştir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737000633,
					"content": "Sorush'u böyle üzgün görünce Paimon sanki yanlış bir şeyler yapmış gibi hissediyor... Belki Zurvan onun keyfini yerine getirir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737000609,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737000610
					]
				},
				{
					"id": 737000610,
					"content": "#... Tamam {NICKNAME}, bir şeyler söyle artık! Bu sessizlik Paimon'u gerçekten korkutmaya başladı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000611
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}