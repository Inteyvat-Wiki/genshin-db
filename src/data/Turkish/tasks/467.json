					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4671205,
					"content": "Vay canına...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671206
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4671206,
					"content": "Ahh... Şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4671207,
					"content": "O kadar lezzetli ki parmaklarımı yedim resmen! Gerçekten çok yeteneklisin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671208
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4671208,
					"content": "Paimon demişti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4671209,
					"content": "Mutfakta çok beceriklisin, daha zor yemekler denemelisin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671210
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4671210,
					"content": "Çantamda bazı malzemeler var. Bu yemek karşılığında onları alabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671211
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4671211,
					"content": "Onları gerçekten alabilir miyiz? Malzemesiz kalma sonra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4671212,
					"content": "Sorun yok. <color=#00E1FFFF>Vahşi doğayı keşfederken</color> bir sürü malzeme bulmak mümkün. Etrafı dikkatlice incelemeyi unutma yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671213
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4671213,
					"content": "Ayrıca Mondstadt'ta <color=#00E1FFFF>Avcının Yeri</color> olarak bilinen, yiyecek ve malzeme satan bir restoran var. Zamanın olursa oraya da git.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671214
