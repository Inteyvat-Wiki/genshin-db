					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670306,
					"content": "Ahh... Şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4670307,
					"content": "Tadı... Tarif etmesi zor. Olmuş sayılır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670308
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670308,
					"content": "#Ne? {NICKNAME} daha iyisini yapabilir. Bu sayılmaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4670309,
					"content": "Büyük bir potansiyelin var. İhtiyacın olan tek şey biraz daha pratik yapmak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670310
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670310,
					"content": "Çantamda bazı malzemeler var. Bu yemek karşılığında onları alabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670311
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670311,
					"content": "Onları gerçekten alabilir miyiz? Malzemesiz kalma sonra?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4670312,
					"content": "Sorun yok. <color=#00E1FFFF>Vahşi doğayı keşfederken</color> bir sürü malzeme bulmak mümkün. Etrafı dikkatlice incelemeyi unutma yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670313
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670313,
					"content": "Ayrıca Mondstadt'ta <color=#00E1FFFF>Avcının Yeri</color> olarak bilinen, yiyecek ve malzeme satan bir restoran var. Zamanın olursa oraya da git.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670314
					],
					"speakerTitle": "Lynn"
				},
				{
					"id": 4670314,
					"content": "Tamam, bilgi için teşekkürler. *soluk soluğa* Hey! Paimon'a da biraz Tavuk Mantar Şiş bırakın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
