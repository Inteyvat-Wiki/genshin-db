			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Küçük Kujirai",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721760101,
					"content": "#Merhaba {F#abla}{M#abi}! Güzel mallarım var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760102
					],
					"speakerTitle": "Küçük Kujirai"
				},
				{
					"id": 721760102,
					"content": "Sağ ol ben almayayım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760103
					]
				},
				{
					"id": 721760103,
					"content": "Ne yazık, böyle küçük bir yaşta kanunsuz iş yapmaya zorlanmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760104,
					"content": "Düşündüğün gibi değil! Benimle Temari oynar mısın diye sormak istemiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760105
					],
					"speakerTitle": "Küçük Kujirai"
				},
				{
					"id": 721760105,
					"content": "Temari mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760106,
					"content": "#Oldukça basit, ben Temariyi yakınlarda bir yere saklayacağım. Eğer {F#abla}{M#abi} bunu Temari şarkısı bitmeden bulursa kazanır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760107
					],
					"speakerTitle": "Küçük Kujirai"
				},
				{
					"id": 721760107,
					"content": "Temari böyle mi oynanıyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760108
					]
				},
				{
					"id": 721760108,
					"content": "Ha? Harika bir Maceracı Abla öğretmişti. Bir de şey demişti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760109
					],
					"speakerTitle": "Küçük Kujirai"
				},
				{
					"id": 721760109,
					"content": "\"Kujirai, 'oyunu kazanırsan güzel şeyler kazanırsın' demeyi unutma.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760110
					],
					"speakerTitle": "Küçük Kujirai"
				},
				{
					"id": 721760110,
					"content": "#Yani, oyunu kazanırsan güzel şeyler de kazanırsın {F#abla}{M#abi}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760111
					],
					"speakerTitle": "Küçük Kujirai"
				},
				{
					"id": 721760111,
					"content": "#Güzel şeyler! {NICKNAME}, Paimon'a sorarsan çocuklarla oyun oynamak gerek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760112,
						721760115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760112,
					"content": "Ama Temarinin böyle oynandığını zannetmiyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760113
					]
				},
				{
					"id": 721760113,
					"content": "Belki de sadece buradaki yerel halkın bildiği bir oynanış tarzıdır, çok kurcalamayalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760114,
					"content": "Sen Küçük Kujirai'sin değil mi? Seninle oyun oynayacağız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760116,
					"content": "Oley!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Küçük Kujirai"
				},
				{
					"id": 721760115,
					"content": "Haydi öyleyse.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760116
					]
				}
			]
		},
		{
			"id": 7217602,
