			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Küçük Kujirai",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721760202,
					"content": "Çok mu zor geldi acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760203
					],
					"speakerTitle": "Küçük Kujirai"
				},
				{
					"id": 721760203,
					"content": "Paimon ısınıyordu, ondan öyle oldu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760204,
					"content": "#Tekrar denemek istiyor musun {F#abla}{M#abi}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760205
					],
					"speakerTitle": "Küçük Kujirai"
				},
				{
					"id": 721760205,
					"content": "#Tabii ki! {NICKNAME}, Küçük Kujirai'ye ne kadar iyi olduğumuzu göstermeliyiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760206,
					"content": "Bir daha deneyeyim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760207
					]
				},
				{
					"id": 721760207,
					"content": "Yaşasın! Verilen sürede Temariyi bulman gerekiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Küçük Kujirai"
				}
			]
		},
		{
			"id": 7217607,
			"completionStepIds": [
				7217605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217605",
							"2"
						],
						"stepId": 7217605,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Küçük Kujirai",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721760702,
					"content": "#Harikasın {F#abla}{M#abi}, hemen buldun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760703
					],
					"speakerTitle": "Küçük Kujirai"
				},
				{
					"id": 721760703,
					"content": "#Haha, {NICKNAME} daha önce birçok diyar gezmiş tecrübeli bir maceracı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760704,
					"content": "Vay canına! Mondstadt'a da gittin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760705
					],
					"speakerTitle": "Küçük Kujirai"
				},
				{
					"id": 721760705,
					"content": "Elbette gittim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760706
					]
				},
				{
					"id": 721760706,
					"content": "Çok havalıymış! Bahsettiğim abla bana Mondstadt'ta çok uzun kuleleri olan Fırtına Dehşeti Harabeleri gibi güzel yerler olduğunu anlatmıştı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760707,
						721760708
					],
					"speakerTitle": "Küçük Kujirai"
				},
				{
					"id": 721760707,
					"content": "Fırtına Dehşeti'nin İni olacak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760709
					]
				},
				{
					"id": 721760709,
					"content": "Evet! Acaba o kule mi yoksa Yüce Şogun'un Tenshukaku'su mu daha uzun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760710
					],
					"speakerTitle": "Küçük Kujirai"
				},
				{
					"id": 721760710,
					"content": "Küçük Kujirai, şehir dışında tek başına ne yapıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760711,
					"content": "Çünkü ablam balık tutarken balıkları korkutacağımı düşünüp beni dışarıda oyun oynamaya gönderdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760712
					],
					"speakerTitle": "Küçük Kujirai"
				},
				{
					"id": 721760712,
					"content": "Bir keresinde Maceracı Ablayla tanışmıştım. Sıkıldığımı görüp bana bir sürü Temari verdi ve \"oyunu seninle oynayacak açgözlü maceracılar bul\" demişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760713
					],
					"speakerTitle": "Küçük Kujirai"
				},
				{
					"id": 721760713,
					"content": "Açgözlü gezginler...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760714
					]
				},
				{
					"id": 721760714,
					"content": "Biz açgözlü değiliz! Biz endişeliyiz! Paimon, tek başına oynarsan sıkılırsın diye endişelendi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760715,
					"content": "#Doğru, sanırım {F#abla}{M#abi} gerçekten çok kibar. Çok mutluyum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760716
					],
					"speakerTitle": "Küçük Kujirai"
				},
				{
					"id": 721760716,
					"content": "Şehir dışında bir başına...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760717
					]
				},
				{
					"id": 721760717,
					"content": "Şehir dışında çocuk başına dolaşıyorsun. Karşına çıkabilecek tehlikelerden korkmuyor musun? Üstelik üzerinde \"güzel mallar\" da var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760718,
					"content": "#Çok kibarsın {F#abla}{M#abi}. Endişelenme, Maceracı Abla bana gerekenleri öğretti. Gerekli işlemi yaparsam Temari bombaya dönüşebiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760719
					],
					"speakerTitle": "Küçük Kujirai"
				},
				{
					"id": 721760719,
					"content": "Ay bu çok tehlikeli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760720,
					"content": "Tehlikeli falan değil! Bu yolla dağ yabanileri ve bodurloplar gibi bir sürü kötü canavarı havaya uçurdum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760721
					],
					"speakerTitle": "Küçük Kujirai"
				},
				{
					"id": 721760721,
					"content": "Tehlikeli olan sensin zaten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760722
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760722,
					"content": "#Evet {F#abla}{M#abi}, diğer arkadaşlarınla Temari oynamak istersen diye...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760723
					],
					"speakerTitle": "Küçük Kujirai"
				},
				{
					"id": 721760723,
					"content": "Buraya bir Temari bırakıyorum! Kuralları anlatayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760724
					],
					"speakerTitle": "Küçük Kujirai"
				},
				{
					"id": 721760724,
					"content": "Temariyi sakladığında bunu Temari şarkısı bitmeden saklaman gerekiyor. Temariyi arayan kişi de şarkı bitmeden bulmalı. Böylece oyun daha adil oluyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760725
					],
					"speakerTitle": "Küçük Kujirai"
				},
				{
					"id": 721760725,
					"content": "Anladım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760726
					]
				},
				{
					"id": 721760726,
					"content": "Aslında bombalarla oynadığımızı düşünürsek biraz korkutucu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760727,
					"content": "#Korkma {F#abla}{M#abi}. Maceracı Abla bana \"Bunlar muhtemelen sadece kötülerin elinde patlar\" demişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760728
					],
					"speakerTitle": "Küçük Kujirai"
				},
				{
					"id": 721760728,
					"content": "\"Muhtemelen\" mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721760729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721760729,
					"content": "#Başka yerde oyun oynamaya gideyim ben. Güle güle {F#abla}{M#abi}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Küçük Kujirai"
				},
				{
					"id": 721760708,
					"content": "Öyle mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721760709
					]
				}
			]
		}
	]
}