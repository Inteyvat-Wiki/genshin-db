			"dialogs": [
				{
					"id": 200460101,
					"content": "Hadi bakalım, bugün de sıkı çalışalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460102,
						200460106
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460102,
					"content": "Haha, bayağı gaza gelmişsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200460103
					]
				},
				{
					"id": 200460103,
					"content": "Tabii ki! Maceracı olmak hakikaten çok ilgimi çekiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460104
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460104,
					"content": "Ama... Görev yaparken hâlâ neler yapmam gerektiğini tam olarak bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460105
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460105,
					"content": "Gezgin, tekrar benimle gelmek ister misin? Hâlâ sana sormak istediğim şeyler var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460108
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460108,
					"content": "O zaman yola koyulalım. Bugünün görevi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460109
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460109,
					"content": "Ha... Demek bir taşıma balonuna daha eşlik edeceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200460106,
					"content": "Ben de mi geleyim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200460107
					]
				},
				{
					"id": 200460107,
					"content": "Gelir misin? Hehe, olur! Hâlâ senden öğrenebileceğim çok şey var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460108
					],
					"speakerTitle": "Anna"
				}
			]
		},
		{
			"id": 2004602,
			"completionStepIds": [
				2004604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
