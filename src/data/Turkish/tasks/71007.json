			"dialogs": [
				{
					"id": 710070101,
					"content": "Resim nasıl gidiyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710070102
					]
				},
				{
					"id": 710070102,
					"content": "Gözleri parladığından beri, bu iki heykelin yanında resim yapıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070103
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070103,
					"content": "Ama... Nasıl desem... O mükemmel resmi ortaya koyabildiğimi düşünmüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070104
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070104,
					"content": "Eksik bir şeyler varmış gibi geliyor. Anlatabiliyor muyum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070105
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070105,
					"content": "İyi malzemelerle yapılmış, güzel pişmiş bir yemek gibi ama... Sanki içinde eksik bir şey var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070106
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070106,
					"content": "Bu hissi nasıl anlatırım bilmiyorum. Ben de tam kavrayamadım. Çizmekten başka elimden bir şey gelmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070107
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070107,
					"content": "Gülebilirsin, sorun değil. Aslında bu kadar çizim yapmak biraz başımı döndürdü. Kısa bir ara verirdim ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070108
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070108,
					"content": "Gözlerimi her kapadığımda, o heykellerin parlayan gözlerini görüyorum. Sanki canlanmışlar da gözlerimin içine bakıyorlarmış gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070109
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070109,
					"content": "Bu yüzden ara vermek için buraya döndüm. Heykellerin gözlerini buradan göremem muhtemelen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070110
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070110,
					"content": "Bu resmi sana verebilirim. Şu ana kadar yaptıklarımın en iyisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070111
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070111,
					"content": "Başka bir şey yoksa biraz dinleneyim. Çok yoruldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070112
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710070112,
					"content": "Ama resimlerimde ne eksik hâlâ bulamadım. Ne eksik olabilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		}
	]
}