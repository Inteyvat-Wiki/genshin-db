			"dialogs": [
				{
					"id": 200210101,
					"content": "Kanat kullanmak için neden ehliyete ihtiyacımız var ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210102
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210102,
					"content": "Ehliyet sınavına girdin mi Anthony?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210103
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210103,
					"content": "Ben kanat kullanmıyorum, o yüzden sınava da girmedim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200210104,
					"content": "Uçuş ehliyeti sınavına mı girmek istiyorsun Anna?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200210105
					]
				},
				{
					"id": 200210105,
					"content": "Evet. Kanatlar her maceracının kullandığı şeylerden biri. Bu yüzden ben de öğrenmek istiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210106
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210106,
					"content": "Ama uçuş ehliyeti diye bir şey olduğunu hiç düşünmemiştim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210107
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210107,
					"content": "Yani, sınava kaydoldum ama henüz her şeyi tamamen kavramış değilim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210108
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210108,
					"content": "Gezgin, Amber senin ehliyet aldığını söylemişti. Sınava çalışmama yardım eder misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210109,
						200210113
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210109,
					"content": "Sınav gözetmenin Amber mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200210110
					]
				},
				{
					"id": 200210110,
					"content": "Hayır ama kayıt işlemleri esnasında kendisiyle tanıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210111
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210111,
					"content": "Sınav sürecini bana anlatırken senden de bahsetti. Çok başarılı olmuşsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210112
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210112,
					"content": "Ben de bazı sınav soruları için sana danışabilirim diye düşündüm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210115
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210115,
					"content": "Peki, şimdi sana üç tane soru soracağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210116
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210116,
					"content": "İlk olarak... Tek bir kanat havada kaç kişiyi taşıyabilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200210113,
					"content": "Tamam o halde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200210114
					]
				},
				{
					"id": 200210114,
					"content": "Harika! Çok teşekkür ederim Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210115
					],
					"speakerTitle": "Anna"
				}
			]
		},
