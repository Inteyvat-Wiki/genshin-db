					"nextDialogs": [
						221161302
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 221161302,
					"content": "Notlar işte burada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221161303
					]
				},
				{
					"id": 221161303,
					"content": "Harika! Bakalım... Zhihua ve Qiming! Biliyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161304
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 221161304,
					"content": "Hımm... Evet... Bu harika bir malzeme! Şahane!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161305
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 221161305,
					"content": "Sen ciddi misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221161306
					]
				},
				{
					"id": 221161306,
					"content": "Görmüyor musun? Başta çok bariz olmasa da ortada gizli ama güçlü bir çekim var... Bu ikisi arasında bir şeyler olduğu çok net, sadece ikisi de bunu içinde tutuyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161307
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 221161307,
					"content": "Hımm, evet... Sanırım olay örgüsünün başlangıcını buldum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161308
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 221161308,
					"content": "Lütfen bunları al. Yardımın için teşekkür ederim! Şimdi düşünme ve hatta belki de yazma zamanı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dokuzuncu Chang"
				}
			]
		},
