			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dokuzuncu Chang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221160301,
					"content": "Efsanevi savaşlar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221160302
					]
				},
				{
					"id": 221160302,
					"content": "Demek savaşlar... Savaşlar... Bu fikir fena değil gibi. En azından dikkat çekici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160303
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 221160303,
					"content": "Ama öyle bir romanla ilgili ilhamı Qingce Köyü'nde bulmam çok zor... Bırak efsanevi olanları, burada hiç savaş yok ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160304
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 221160304,
					"content": "Benim daha öteye bakmam gerek... Vahşi doğaya! Evet, bu çok iyi olur! Vahşi doğada birçok maceracı olduğunu duymuştum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160305
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 221160305,
					"content": "Hazine arayışında oradan oraya gidiyorlar ve sürekli canavarlarla savaşıyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160306
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 221160306,
					"content": "Tesadüfe bak ki, bolca canavar olan bir yer biliyorum. Hem de öyle bildiğin canavarlar gibi değil, bunlar epey zorlu! Evet! Oraya gidip bir maceracının gelmesini bekleyebilir ve ardından gerçekleşecek savaşa canlı olarak tanıklık edebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160307
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 221160307,
					"content": "Sonra da... Haha, ihtiyacım olan her şeyi almış olacağım! Lafı daha da uzatmadan yola koyulayım! Gitmem gereken epey bir mesafe var, yani siz de çok gecikmeyin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dokuzuncu Chang"
				}
			]
		},
		{
			"id": 2211605,
			"completionStepIds": [
				2211608
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
