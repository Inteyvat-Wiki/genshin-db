					"Dokuzuncu Chang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221161801,
					"content": "Pekala, nasıl gitti? Güzel bir hikaye bulabildin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161802
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 221161802,
					"content": "Notlar işte burada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221161803
					]
				},
				{
					"id": 221161803,
					"content": "Süper! Ama bu hikayede cesaret eksik. Sonuçta bunlar sadece çocuk... Belki birkaç yıl sonra bir romantizm yeşerebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161804
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 221161804,
					"content": "Yine de buradan başlayacağım. Belki hikayenin başlangıcı bu olabilir. Ortada romantizmle dolup taşan bir potansiyel yok ama içinden bir şeyler çıkarmanın yolunu bulabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161805
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 221161805,
					"content": "Ayrıca, lütfen bunları al. Üzerine yazabileceğim bir şeyler bulduğun için teşekkür ederim. Şimdi bunu nasıl geliştireceğimi düşünmem gerek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dokuzuncu Chang"
				}
			]
		},
