				"points": []
			},
			"dialogs": [
				{
					"id": 221160701,
					"content": "Şehre en son gittiğimde bir adamın falcı gibi görünen genç bir hanımla konuştuğunu görmüştüm. Ama adam boş konuşuyordu... Ben de dinleme zahmetinde bulunmadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160702
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 221160702,
					"content": "Sonrasında geveze beyefendinin adının Zhihua, falcı hanımefendinin adının da Qiming olduğunu öğrendim. Belli ki bir geçmişleri var... Gidip onların hikayesini dinlemeye ne dersin? İlginç bir şey çıkarsa da gelip bana anlatırsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dokuzuncu Chang"
				}
			]
		},
		{
			"id": 2211608,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"1",
							"2",
							"22116"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dokuzuncu Chang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221160801,
					"content": "Şimdi düşününce... Sisi'yi tanıyor olabilir misin? Genelde limanın oralarda takılıyor ve Chaoxi adında bir denizciyi bekliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160802
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 221160802,
					"content": "Her gün oraya gidip adamın gelmesini bekliyor. Muhtemelen arkasında yatan bir hikaye vardır değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160803
					],
