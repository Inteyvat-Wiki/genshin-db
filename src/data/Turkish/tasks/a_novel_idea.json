				"points": []
			},
			"dialogs": [
				{
					"id": 221161101,
					"content": "Chaoxi, sonunda döndün! Harika bir yemek tarifi öğrendim. Benimle gelsene, sana pişireyim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161102
					],
					"speakerTitle": "Sisi"
				},
				{
					"id": 221161102,
					"content": "Sisi, daha yeni geldim ve hem kafa hem de fiziksel olarak tükenmiş haldeyim. Şu anda sadece yatıp dinlenmem gerek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161103
					],
					"speakerTitle": "Chaoxi"
				},
				{
					"id": 221161103,
					"content": "Tabii ya, o kadar çalışmanın üstüne yorulmuşsundur. Biraz dinlensen iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161104
					],
					"speakerTitle": "Sisi"
				},
				{
					"id": 221161104,
					"content": "O zaman, dinlendiğinde buluşalım olur mu? İstersen zamanını da şimdi belirleyebiliriz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161105
					],
					"speakerTitle": "Sisi"
				},
				{
					"id": 221161105,
					"content": "Tabii, şahane olur. Ben sana haber veririm. Ama şu anda belirli bir tarih veremiyorum... Yan çizmeye falan çalışmıyorum, sadece tutamayacağım bir söz vermek istemem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161106
					],
					"speakerTitle": "Chaoxi"
				},
				{
					"id": 221161106,
					"content": "*iç çeker* Sisi ben bir denizciyim ve denizle evliyim. Sen daha iyilerini hak ediyorsun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161107
					],
					"speakerTitle": "Chaoxi"
				},
				{
					"id": 221161107,
					"content": "Böyle konuşma Chaoxi... Ben seni anlıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sisi"
				}
			]
		},
