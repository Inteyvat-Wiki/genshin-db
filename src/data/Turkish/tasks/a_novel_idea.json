			"dialogs": [
				{
					"id": 221160901,
					"content": "Limanın orada oyun oynayan üç çocuk var. Meng, Lulu ve Fei. Onları tanıyor olabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160902
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 221160902,
					"content": "Çocuk olduklarını biliyorum ama... Elbet üçünün de anlatacak hikayeleri vardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160903
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 221160903,
					"content": "Bir araştır bakalım. İyi olduğunu düşündüğün konuları not alıp bana getir.",
