			"dialogs": [
				{
					"id": 221161001,
					"content": "Selam Qiming! Bugün ben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161002
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221161002,
					"content": "Bugün bana uymaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161003
					],
					"speakerTitle": "Qiming"
				},
				{
					"id": 221161003,
					"content": "... Ama daha bir şey söylemedim ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161004
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221161004,
					"content": "Gerek yok. Konunun nereye gittiğini zaten öngörebiliyordum. Bugün bana uymaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161005
					],
					"speakerTitle": "Qiming"
				},
				{
					"id": 221161005,
					"content": "Tamamdır, o zaman... Senin için uygun olan gün hangisi? Ya da sen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161006
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221161006,
					"content": "Endişelenme, zamanı gelecek. O zaman benim için de uygun bir gün olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161007
					],
					"speakerTitle": "Qiming"
				},
				{
					"id": 221161007,
					"content": "Hiçbir şey söylemedin ki! Qiming lütfen, bir dinle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161008
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221161008,
					"content": "Teşekkürler, sıradaki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161009
					],
					"speakerTitle": "Qiming"
				},
				{
					"id": 221161009,
					"content": "Ama benim işim bitmedi! Ayrıca \"sıradaki\" de ne demek? Ortada sıra falan yok ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
