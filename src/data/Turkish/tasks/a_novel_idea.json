			},
			"dialogs": [
				{
					"id": 221161201,
					"content": "Lulu, bu defa kaptan olma sırası Fei'de.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161202
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 221161202,
					"content": "Aynen öyle! Hep diyorum zaten, neden sürekli ben ikinci kaptan olmak zorunda kalıyorum ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161203
					],
					"speakerTitle": "Minik Fei"
				},
				{
					"id": 221161203,
					"content": "Meng kaptan olduğunda, herkesin oyuna dahil olması bence daha eğlenceli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161204
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 221161204,
					"content": "Bu biraz adaletsiz Lulu. Bence Fei gayet iyi oynuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161205
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 221161205,
					"content": "Herkes kendi rolünü gayet iyi oynuyor. Sen kaptansın, ben zengin tüccarım ve Fei de ikinci kaptan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161206
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 221161206,
					"content": "Bu sefer şimdiye kadarkilerinin içinde en eğlencelisi olacak! Sen ne dersin Fei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161207
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 221161207,
					"content": "Lulu, hadi ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161208
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 221161208,
					"content": "Yani... Öyle diyorsan, Lulu... Sanırım bana uyar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161209
					],
					"speakerTitle": "Minik Fei"
				},
				{
					"id": 221161209,
					"content": "Fei! Bunu konuşmuştuk ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161210
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 221161210,
					"content": "Yok, sorun değil. Benim için fark etmez. Lulu mutlu olacaksa bana uyar. Hadi oynayalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161211
					],
					"speakerTitle": "Minik Fei"
				},
				{
					"id": 221161211,
					"content": "Kaptan, maptan ne fark eder. Sanki umurumda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161212
					],
					"speakerTitle": "Minik Fei"
				},
				{
					"id": 221161212,
					"content": "Size inanamıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Minik Meng"
				}
			]
		},
