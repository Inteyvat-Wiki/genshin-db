			"dialogs": [
				{
					"id": 221160101,
					"content": "Nereden başlayacağımı bilmiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160102
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 221160102,
					"content": "Şimdi ne yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221160103
					]
				},
				{
					"id": 221160103,
					"content": "Ah, yine sen. Yeni bir roman yazıyorum... Yani yazmaya çalışıyorum. Giriş için merak uyandıran bir fikir bulamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160104
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 221160104,
					"content": "Sabahtan beri kafa patlatıyorum ama tamamen kaybolmuş durumdayım. Böyle giderse, kim bilir ne zaman gerçekten yazmaya başlayabilirim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160105
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 221160105,
					"content": "Sen gezginsin değil mi? Dünyanın nasıl olduğunu biliyorsun. Sence başarılı bir romanın temel içeriği nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160106
					],
					"speakerTitle": "Dokuzuncu Chang"
				}
			]
		},
