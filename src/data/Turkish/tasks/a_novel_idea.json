				{
					"id": 221161704,
					"content": "Bu, romantizm sayılır mı? Hımm... Yine de, romantizm olsun olmasın, en azından burada bir hikaye var. Bu işimi görür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161705
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 221161705,
					"content": "Lütfen bunları al. Üzerine yazabileceğim bir şeyler bulduğun için teşekkür ederim. Şimdi bu hikayeyi ne yönde ilerleteceğime karar vermem gerekiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161706
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 221161706,
					"content": "Bunlar romanda işime yarar gibi duruyor ama hikayenin gerçek hayattaki hali nasıl bitecek diye düşünmek beni ürpertiyor! Muhtemelen Taşordu yaraları sarmaya çalışacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221161707
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 221161707,
					"content": "İkisinin de sonu faciaya doğru gidiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dokuzuncu Chang"
				}
			]
		},
