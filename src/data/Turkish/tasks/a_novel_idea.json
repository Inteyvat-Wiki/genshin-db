					"Dokuzuncu Chang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221160501,
					"content": "Bu harika... Artık efsanevi bir savaşı bizzat deneyimledim diyebilirim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160502
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 221160502,
					"content": "Savaşı sadece uzaktan izlemek istediğini sanıyordum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221160503
					]
				},
				{
					"id": 221160503,
					"content": "Evet, başta fikrim buydu ama gelmesini umduğum maceracılar gelmedi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160504
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 221160504,
					"content": "Canavarların yavaştan harekete geçmeye başladığını gördüm. Hepsi gitseydi, kat ettiğim yolun tümü boşa gidecekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160505
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 221160505,
					"content": "Ben de onlara taş attım. Hikayelerde de hep böyle olmaz mı zaten? Bir taş atıp dikkatlerini falan çekersin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160506
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 221160506,
					"content": "Taşın canavarlardan birinin tam kafasına isabet edeceğini nereden bilebilirdim ki? Sonrasını da zaten biliyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160507
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 221160507,
					"content": "Her neyse, neticeye bakalım. Biraz yara bere aldım ama... Kesinlikle hikayemi de buldum. Buraya gelme amacım da zaten buydu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160508
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 221160508,
					"content": "Sonunda yaratıcılığın damarlarımda aktığını hissedebiliyorum! Bu arada, uğraşların için bunu kabul et. Teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221160509
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 221160509,
					"content": "Bence ilham tıkanıklılığım ölümcül bir darbeyle ortadan kalktı! Artık gitmem gerek, kalemim ve kağıdım beni bekler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dokuzuncu Chang"
				}
			]
		},
