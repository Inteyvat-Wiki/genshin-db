			},
			"dialogs": [
				{
					"id": 760950301,
					"content": "Istoria, üç bölgeyi de büyük ölçüde kurtardık. İnsanların çoğu da artık güvende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950302,
					"content": "Hatta Zeitlind'in kaybettiği her şeyi bulduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950303,
					"content": "Çok teşekkür ederim. Nihilita gözünü açtığından beri insanları çok iyi anlayabilmeye başladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950304
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950304,
					"content": "Pekala, şimdi senin sıran! Daha önce yukarı çıkmanın bir yolu olduğundan ve bunun bir bedeli olduğundan bahsetmiştin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950305,
					"content": "Hodri meydan! Maceraya atılmak ya da üç beş Mora harcamak Paimon'un gözünü korkutmaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950306,
					"content": "Aa! Ya Zeitlind ne olacak? Buradaki işi bitti, onu nasıl geri göndereceğiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950307,
					"content": "Hepsini açıklayabilirim ama önce dinlenmelisiniz. Yarın her şeyi ayrıntısıyla anlatacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950308
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950308,
					"content": "Tamam. Ama... Burada yatak yok. Yiyecek de yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950309,
					"content": "Bu tür arzular burada kaybolup gider. Bir düşün, bunca zamandır buradasın ama acıkmadın, yorgun da değilsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950310
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950310,
					"content": "Ha? O zaman tüm gün dinlenirken Paimon ne yapacak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950311,
					"content": "Burası her yaştan olağanüstü insanlarla dolu. Onlarla sohbet etmek eğlenceli olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950312
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950312,
					"content": "#Pekala, tamam. Ama Paimon istediği zaman uyuyabilir. Yorgun olsun ya da olmasın, Paimon yine de senin başında uyuyacak {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950313,
					"content": "Zeitlind, biraz dinlendikten sonra konuşabilir miyiz? Şu daha önce bahsettiğim, üzerinde düşünmek için zaman istediğim konu hakkında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950314
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950314,
					"content": "Biraz konuşalım mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950315
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950315,
					"content": "Tamam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950316
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950316,
					"content": "#{NICKNAME}, Paimon, yeterince dinlendiğinizde yanıma gelin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Istoria"
				}
			]
		},
