			"dialogs": [
				{
					"id": 760950501,
					"content": "Dinlenebildiniz mi? Konuşmak istediğiniz herkesle konuştunuz mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950502,
						760950504
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950502,
					"content": "Henüz değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760950503
					]
				},
				{
					"id": 760950503,
					"content": "Pekala. Acele etmeyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950506
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950506,
					"content": "Zeitlind, biraz sakin ol ve dinle. Saygısızlık etmek ya da seni boş yere ümitlendirmek gibi bir niyetim yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950507
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950507,
					"content": "Ablan hâlâ hayatta olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950508
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950508,
					"content": "Mezar taşını gördüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950509
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950509,
					"content": "Üzerinde resmi vardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950510
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950510,
					"content": "Ama... İçinde hiçbir şeyin gömülü olmaması da mümkün, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950511
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950511,
					"content": "Paimon bunun doğru olmasını isterdi gerçekten. Ama bu biraz fazla iyimser olmaz mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950512,
					"content": "Bana yazdığı son mektupta ablam çoktan kararını verdiğini söylemişti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950513
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950513,
					"content": "O veda, son bir kez hoşça kal demek için yazılmamıştı, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950514
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950514,
					"content": "Uzak bir yere gideceğini söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950515
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950515,
					"content": "Bana bundan daha önce bahsetmişti. Yaşlanmadan önce dünyayı gezmek istemişti hep.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950516
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950516,
					"content": "Hilda mecazi konuşmuyordu. Gerçekten de sanatoryumdan ayrıldı ve yola koyuldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950517
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950517,
					"content": "Bundan bahsetmiş miydi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950518
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950518,
					"content": "Her zaman çok neşeliydi. Herkesle iyi geçinirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950519
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950519,
					"content": "Öyleyse sana muhtemelen... Birbirimizden başka hiç kimsemizin olmadığını söylemedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950520
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950520,
					"content": "Ben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950521
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950521,
					"content": "Dürüst olmama izin ver. Bir an için soğuk davranabileyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950522
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950522,
					"content": "Gidişi üç ya da dört kişinin yas tutmasına neden olsaydı, bu onun hüznünden daha ağır basabilirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950523
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950523,
					"content": "Ama şimdi sadece ben varım. Benim anlayacağımı, onu affedeceğimi biliyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950524
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950524,
					"content": "Öyle değil. Bu şekilde düşünmemelisin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950525
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950525,
					"content": "Benim için üzülmene gerek yok. Çocukken ve anne babamız yanımızdayken hayat güzeldi. O anılar bizi ileriye taşımak için yeterliydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950526
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950526,
					"content": "Ama büyüdükçe... Dünya zorlaşıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950527
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950527,
					"content": "Ben hep daha içime kapanık biriydim. İş yerinde insanlarla uğraşmak beni gerçekten çok yoruyor. Ablam dışa dönük biri olduğu için onun işinin daha kolay olacağını sanırdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950528
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950528,
					"content": "Ama o bile büyüdükten sonra hep yorgun görünmeye başladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950529
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950529,
					"content": "Hı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950530
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950530,
					"content": "İkinizin hâlâ bir geleceği var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950531
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950531,
					"content": "Ha, o zaman nişanlısından hiç bahsetmemiş olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950532
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950532,
					"content": "İyi bir adamdı. Sıradan biriydi. Nazikti, ilginçti. Bazen keşke öyle olmasaydı diyorum. Eğer kötü bir adam olsaydı işler daha kolay olabilirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950533
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950533,
					"content": "Ailesinde kalıtsal bir rahatsızlık vardı. Garip bir hastalık... Uzun yaşayamıyorlardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950534
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950534,
					"content": "Bazen bu konu hakkında şaka yapardı. Mondstadt'ı fazla iyi planladığı için Rüzgar Hükümdarını suçlar, böylece kendisininki gibi bir ailenin bile asla yok olup gitmediğini söylerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950535
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950535,
					"content": "Bir gün dünyayı kurtaracağını söyledi ve sonra çekip gitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950536
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950536,
					"content": "Dünyayı kurtarmak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950537
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950537,
					"content": "Dünya hâlâ yerinde. Belki de bir yerlerde, kimsenin fark etmediği bir köşede o bunu gerçekten başarmıştır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950538
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950538,
					"content": "Hep dersin ya, sonsuza dek yaşayan biri herkesi sevmez ve herkesçe sevilmezse dünya kedere boğulur diye...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950539
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950539,
					"content": "Sanırım haklısın. Bu da kısa bir hayata bu kadarının bile çok görüldüğü anlamına geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950540
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950540,
					"content": "Hayatını aşka adamak istedi. Ve bu sadece ablamın canını daha çok yaktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950541
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950541,
					"content": "O kadar ki, dağlarda bir sanatoryuma gönderildi. Tam şu an üzerinde durduğumuz, lanetlerle dolu bu yere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950542
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950542,
					"content": "Bana bunlardan hiç bahsetmemişti. Üzgünüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950543
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950543,
					"content": "Tüm bunları öğrenmene rağmen hâlâ onun hayatta olduğunu mu düşünüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950544
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950544,
					"content": "Evet. Çünkü o burada bir şey yaptı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950545
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950545,
					"content": "Ve benim korkum yüzünden yaşamaya devam etmek zorunda bırakıldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950546
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950546,
					"content": "Sana saygım sonsuz Istoria, gerçekten. Ama sanırım tarih boyunca çok fazla acıya tanık oldun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950547
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950547,
					"content": "Dünyayı boğacak kadar büyük bir acı... Benim gibi sıradan biri için bunun küçük bir kısmı bile koca bir hayatı gömmeye yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950548
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950548,
					"content": "Ablamla beni gerçekten anlaman mümkün değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950549
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950549,
					"content": "Peki ölümlü dünyaya nasıl geri döneceğim? Ben ömrü kısa, önemsiz bir varlığım. Sonsuzluk bana göre değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950550
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950550,
					"content": "*iç çeker*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950551
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950551,
					"content": "Bay Istoria?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950552
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950552,
					"content": "Burası eskiden yukarıdaki dünyadan tamamen kopuktu. Ne içeri giriş vardı ne de dışarı çıkış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950553
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950553,
					"content": "Ancak Nihilita düştükten sonra Dex, yaşayan dünyanın insanlarını Sütunlu Salon ile yüzey arasında taşıma yeteneği kazanmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950554
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950554,
					"content": "Yine de buraya gelmek üzere seçilmiş olanları geri döndüremez. O, Gözcü'nün en erken formu, bu kısıtlama da doğasının bir parçası.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950555
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950555,
					"content": "Ne? Yani Dex'in Nihilita ile aynı türden bir varlık olduğunu mu söylüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950556
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950556,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950557
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950557,
					"content": "Aşağı geri dönmek istiyorsak bunun tek bir yolu var. Sahip olduğumuz her anıdan, bildiğimiz her şeyden vazgeçmeli ve en tepeye tırmanmalıyız. Eskiden bu, hanımımızla buluşmak anlamına gelirdi. Şimdi ise bu kişi Melanta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950558
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950558,
					"content": "Yani sizinle gelemem. Ama en azından sizi uğurlayabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Istoria"
				},
				{
					"id": 760950504,
					"content": "Evet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760950505
					]
				},
				{
					"id": 760950505,
					"content": "Pekala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950506
					],
					"speakerTitle": "Istoria"
				}
			]
		},
