			"dialogs": [
				{
					"id": 760950101,
					"content": "#{NICKNAME}, Paimon... Teşekkür ederim. Yolun sonunda sizinle tanıştığım için gerçekten çok mutluyum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950102
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950102,
					"content": "Hehe. Asıl bizim yüzümüzden sen tüm bunlara sürüklenmişsin gibi geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950103,
					"content": "Bir dakika, \"yolun sonunda\" mı? Ne demek istiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950104,
					"content": "Yani... Oldukça tehlikeli maceralara atıldık. Ama pek çok inanılmaz şey görme fırsatım oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950105
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950105,
					"content": "O kadar da kötü değilmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950106
					],
					"speakerTitle": "Zeitlind"
				},
				{
					"id": 760950106,
					"content": "Hey! Paimon'un sorusunu öylece geçiştirme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760950107,
					"content": "Öyle mi yaptım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zeitlind"
				}
			]
		},
