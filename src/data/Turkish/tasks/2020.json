			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Şogun Raiden"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20200301,
					"content": "Merakımı bağışla. Seni bir kez daha burada önümde dururken bulmamın sebebi nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200302
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 20200302,
					"content": "Deli cesaretinin onları koruyacağını mı umuyorsun? Yoksa... Bu, sırf karşıma çıkmak için yaptığın bir şey miydi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200303,
						20200304
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 20200303,
					"content": "Fatui, Şogun Raiden'ı kandırdı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200305
					]
				},
				{
					"id": 20200305,
					"content": "Ne? Sırf bunu söylemek için beni sonsuz meditasyonumdan uyandırmamışsındır herhalde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200306
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 20200306,
					"content": "Öyleyse beni hafife alıyorsun demektir. Önsezi Avı Fermanını çok iyi biliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200307
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 20200307,
					"content": "Dışarıda olan biten her şeyi biliyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200308
					]
				},
				{
					"id": 20200308,
					"content": "Hayır. Sadece sonsuzlukla alakası olan her şeyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200309
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 20200309,
					"content": "Önsezi Avı Fermanında benim gizli onayım var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200310
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 20200310,
					"content": "Fatui'nin şu ana kadarki eylemleri sonsuzluk için bir tehdit oluşturmadı, yoksa... Çoktan sonları gelmiş olurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200311,
						20200312
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 20200311,
					"content": "Ama Önsezi Avı Fermanı zarar veriyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200313
					]
				},
				{
					"id": 20200313,
					"content": "Bireysel hayaller, doğası gereği sonsuzluk ile bağdaşmıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200314
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 20200314,
					"content": "İnsanların hayallerinin peşinden gittiklerinde, kaybedecek çok daha fazla şeyleri olduğunu bilmiyor olabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200315
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 20200315,
					"content": "Şunu göz önünde bulundur... Kimse Önsezisini kaybettiği için ölmeyecek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200316
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 20200316,
					"content": "Hayatlarını kaybedenler, kendi arzularının peşinde koşmakta ısrar edenler değil midir aslında?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200317
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 20200317,
					"content": "Teppei...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200318
					]
				},
				{
					"id": 20200318,
					"content": "Gezgin, senin varoluşun benim gözümde çok eşsiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200319
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 20200319,
					"content": "Senin içinde sınırsız bir belirsizlik var gibi. Bir başka deyişle, sonsuzluğun tam zıddısın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200320
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 20200320,
					"content": "Bu yüzden eylemlerimin anlamını kavraman için ısrar etmeyeceğim. Önemli olan şey, halkımın adına sonsuzluk yolunda yürümemdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200321
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 20200321,
					"content": "Burası senin Zihnin Dinlenme Yerin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200322
					]
				},
				{
					"id": 20200322,
					"content": "Burayı oluşturan şey senin zihnin, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200323
					]
				},
				{
					"id": 20200323,
					"content": "Bu doğru. Bu kadar iyi anlamana şaşırdım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200324
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 20200324,
					"content": "Neyse. İrademi sarsmak için fırsat kolluyorsun... Değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200325
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 20200325,
					"content": "Buraya fikirlerini tartışmaya gelmedim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200326
					]
				},
				{
					"id": 20200326,
					"content": "Onları yok etmeye geldim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200327
					]
				},
				{
					"id": 20200327,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200328
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 20200328,
					"content": "Öyle olsun. Tamam o zaman, sonsuzluğa meydan okuyan kişi... Beni aydınlatma vaktin geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 20200312,
					"content": "Inazuma halkına büyük bir bedel ödetiyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200313
					]
				},
				{
					"id": 20200304,
					"content": "Önsezi Avı Fermanı asla var olmamalıydı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200305
					]
				}
			]
		},
		{
			"id": 202005,
