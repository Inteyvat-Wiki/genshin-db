			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yae Miko",
					"Şogun Raiden"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20200501,
					"content": "Kaybettin Ei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200502
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200502,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200503
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 20200503,
					"content": "... Evet, kaybettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200504
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 20200504,
					"content": "Neden halkına ve halkının hayallerinin gücüne güvenemiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200505
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200505,
					"content": "Bu hayaller, uzay ve zamanın ötesinde. Kimsenin yok edemeyeceği şeyler onlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200506,
						20200507,
						20200508
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200506,
					"content": "İnsanlar tüm güçleriyle çabaladıklarında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200509
					]
				},
				{
					"id": 20200509,
					"content": "Liyue'deki yolculuğunda bunu mu öğrendin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200510
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200510,
					"content": "Evet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200511
					]
				},
				{
					"id": 20200511,
					"content": "İnsanların tanrılarını bir kenara attığı ve ilerlemek için çabaladığı ülkeler mi var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200512
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200512,
					"content": "Yani ilerleme düşüncesinden... Boş hayaller uğruna vaz mı geçeceğiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200513
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200513,
					"content": "... İkimiz de bu ilerlemenin neden olabileceği büyük kayıplara şahit olduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200514
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 20200514,
					"content": "Sonsuzluk... Tek seçenek sonsuzluk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200515
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 20200515,
					"content": "Bana kalırsa Semavi İlkeler... Tutarsız saçmalıklardan ibaret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200516
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200516,
					"content": "Her şey bir yana, tek istediğin şey sevgili Inazuma'yı sonsuza dek korumak. Bu doğru değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200517
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200517,
					"content": "Bu, konuyu biraz basitleştirmek olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200518
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 20200518,
					"content": "Bu ülke sonsuza dek var olmayı hak ediyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200519
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200519,
					"content": "Hayallerinden ve değişim potansiyelinden mahrum kaldıktan sonra, geriye kalan tek şey... Yalnızca var olmak. İçi boş bir ülke olmaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200520
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200520,
					"content": "Hah. Böyle bir ülkenin yok olması kimin umurunda olur ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200521
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200521,
					"content": "Miko, sözlerini geri al.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200522
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 20200522,
					"content": "Halkıma, asla değişmeyecek bir sonsuzluk sözü verdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200523
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 20200523,
					"content": "Ama halkının senin verdiğin sözlere ihtiyacı yok. Onlar senin ilgini... Senin kutsal görüşünü istiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200524
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200524,
					"content": "... Önsezileri mi kastediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200525
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 20200525,
					"content": "İnsanlar hepi topu yüz yıl yaşıyor. Daha fazla şey kaybetmeyi göze alamazlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200526
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 20200526,
					"content": "Ama ben hepsini deneyimledim. Bu yüzden onlara, sonsuzluğa giden yolda öncülük etmeye karar verdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200527
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 20200527,
					"content": "*iç çeker*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200528
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200528,
					"content": "Ama sonsuzluk senin için çok acımasız bir kader, Ei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200529
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200529,
					"content": "Benim için mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200530
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 20200530,
					"content": "Dünyayı umursamayı bıraktığın gibi, kendini de gözden çıkarmışsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200531
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200531,
					"content": "Burada yüzyıllardır tek başına kalmaktan yorulmuş olmalısın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200532
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200532,
					"content": "Ama böyle gerekiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200533
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 20200533,
					"content": "İlerlemeyi reddederek çok şey kaçıracaksın... Kayıpları önlemek istiyorsun ancak burada sonsuza dek sabit kalarak neleri kaçırdığını düşündün mü hiç?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200534
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200534,
					"content": "Yalnız olduğun bariz ama sonsuzluk uğruna yalnızlığını ebediyete sürüklüyorsun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200535
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200535,
					"content": "Bana şunu açıkla. Burada bir zamanlar kapkaranlık olan gökyüzü neden yeniden ışıldıyor? Neden şimdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200536
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200536,
					"content": "Burası senin Zihnin Dinlenme Yerin. Senin iç dünyan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200537
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200537,
					"content": "Yani bunun tek bir anlamı var... Beni yeniden gördüğün için mutlusun. Uzun süredir buradaki yalnızlığa katlanamıyorsun, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200538
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200538,
					"content": "Benim... Buna verecek bir cevabım yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200539
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 20200539,
					"content": "Hehehe, ah, ama benim sana söyleyecek çok şeyim var. Birkaç yüzyıldır olanları sana anlatayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200540
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200540,
					"content": "Anlatman ne kadar sürer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200541
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 20200541,
					"content": "Tilki gibi kurnaz bir elçi olduğumdan mükemmel bir hafızam var. Geçmiş birkaç yüzyılın tüm detaylarını olduğu gibi hatırlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200542
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200542,
					"content": "Yani sana anlatmam da birkaç yüzyıl sürebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200543
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200543,
					"content": "Heh... Hehe... Miko, seninle yeniden böyle görüşebileceğim aklımdan hiç geçmezdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200544
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 20200544,
					"content": "*iç çeker* Seni yeniden görünce sonsuzlukta bir değişiklik oluştu... Ve çok hoş bir sürpriz oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200545
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 20200545,
					"content": "Hehe, bunu itiraf edebildiğine göre hâlâ arkadaş olabiliriz sanırım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200546
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200546,
					"content": "Ne kadar da çocuksu bir sohbet bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200547
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 20200547,
					"content": "Neyse. Sen ve planın beni mağlup ettiğine göre, Önsezi Avı Fermanını kaldırma dileğini yerine getireceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200548
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 20200548,
					"content": "Ama sonsuzluk ve bu ülkenin ilerlemesi konusunda biraz düşünmem gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20200549
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 20200549,
					"content": "Hehe, en başından beri çocuk gibi davranan sendin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20200507,
					"content": "Tanrıların beklentilerini aşabilirler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200509
					]
				},
				{
					"id": 20200508,
					"content": "Ve hatta tanrıların görevini devralabilirler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20200509
					]
				}
			]
		},
