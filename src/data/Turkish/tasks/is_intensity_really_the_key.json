				{
					"id": 751781011,
					"content": "#Sana dur diyorum {REALNAME[ID(2)|SHOWHOST(true)]}, etrafta koşturmayı bırak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781005,
					"content": "Yakındaki yanardağın içinde bolca magma olmalı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751781006
					]
				},
				{
					"id": 751781006,
					"content": "Aa, Paimon buldu! Küçük dostumuza bir tünel kazdırıp, sonra da yanardağ magmasını kullanarak kaplıcayı ısıtabiliriz, değil mi? Hiç fena fikir değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781007,
					"content": "Rarr! Rarr! Rarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781008
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751781008,
					"content": "#... Saçmalama! Aklını başına toplar mısın? O yöntemle insanların hayatını tehlikeye atarız! En kötüsü de, {REALNAME[ID(2)|SHOWHOST(true)]} az kalsın inanıyordu sana!",
					"roleType": "TALK_ROLE_NPC",
