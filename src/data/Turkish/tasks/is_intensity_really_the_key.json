			"dialogs": [
				{
					"id": 751780101,
					"content": "Merhaba! Şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780102,
					"content": "#Ne güçlü bir \"hararet\"! Tam da efsanevi {NICKNAME} ve Paimon'dan bekleneceği üzere! Bunca yolu teptiniz... Sakın bana \"Bereket Kolektifinin en güçlüsü\" unvanını almak için geldiğinizi söylemeyin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780103
					],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780103,
					"content": "\"Bereket Kolektifinin En Güçlüsü\" mü? Bu bildiğimiz \"Savaşçı Mücadelesi\" değil mi? Bak, şurada sırada bekleyen insanlar var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780104,
					"content": "Haha, ikinize kıyasla onların lafı bile edilmez. \"En güçlü\" unvanını almak için şu anki \"en güçlü\" kişiyi yenmeniz gerekir. Bu sıradan insanlara göre bir iş değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780105
					],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780105,
					"content": "Geldiğiniz iyi oldu... Ama maalesef zamanlamanız pek iyi değil. Ustanın şu anda dünyevi meselelerle ilgilenecek vakti yok. Yani şimdilik onunla yüz yüze görüşemeyeceksiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780106,
						751780107
					],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780106,
					"content": "Peki o nerede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780108
					]
				},
				{
					"id": 751780108,
					"content": "Yoksa ustayı bir düelloya davet etmeyi mi planlıyorsunuz? Cesurca bir hareket! O halde, nerede olduğunu sizinle paylaşabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780110
					],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780110,
					"content": "Eğitimin zorlu yollarında ilerlerken \"Hararetli Sularla\" dolu dağlık bir bölgeye denk geleceksin. Belki de orada \"en güçlüye\" dair izler bulabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780107,
					"content": "Pekala, o zaman onun dönmesini bekleriz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780109
					]
				},
				{
					"id": 751780109,
					"content": "\"Hararet\" \"harareti\" çağırır ve \"en güçlüler\" mutlaka \"en güçlüler\" ile karşılaşır. Yani evet, beklemek de bir seçenek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Loshts"
				}
			]
		},
