			},
			"dialogs": [
				{
					"id": 751780701,
					"content": "Çok \"soğuk\"! Çok \"soğuk\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780702
					],
					"speakerTitle": "Ma'chah"
				},
				{
					"id": 751780702,
					"content": "Soğuk mu? Nasıl yani? Kaplıcada olduğunun farkındasın, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780703,
					"content": "Hayır, hayır... Bu yine de yeterli değil! Eğer Bereket Kolektifinin, daha doğrusu Natlan'ın \"en güçlüsü\" olmak istiyorsam bu soğuğu kabul edemem! \"Hararet\"... Hiç de istediğim gibi değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780704
					],
					"speakerTitle": "Ma'chah"
				},
				{
					"id": 751780704,
					"content": "Aa, neden geri oturdun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780705,
						751780707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780705,
					"content": "\"Hararet\" hâlâ yeterli değil sanırım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780706
					]
				},
				{
					"id": 751780706,
					"content": "\"Hararet\" derken tam olarak ne anlatmaya çalışıyorsun? Paimon dediklerinden hiçbir şey anlamıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780709,
					"content": "#Sizler şu meşhur maceracılar {NICKNAME} ve Paimon olmalısınız! Yaşasın! Kurtulduk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780710
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780710,
					"content": "K-Kurtulduk derken? Neler oluyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780711,
					"content": "Pekala, açıklayayım. Usta kendi deyimiyle \"en güçlü\" olmaya çalıştığı bir yola baş koydu ve bu uğurda kendini tamamen kaplıca eğitimine adadı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780712
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780712,
					"content": "Eğitim mi? Kaplıcada bir de?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780713,
					"content": "Evet... Kulağa çılgınca gelebilir ama bunu \"Beş Kaplıcanın Kitabı\" adlı bir dövüş sanatı kitabından öğrendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780714
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780714,
					"content": "Kitapta yazanlara göre, öğretileri takip edersen kendi \"hararetini\" kullanarak <color=#00E1FFFF>soğuk suyu kaynatmayı</color> başarabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780715
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780715,
					"content": "Üstelik asıl bomba bu değil! Kitap, dövüş sanatları efsaneleriyle ilgili akılalmaz hikayelerle dolu. Mesela bir adam tek gecede bir dağı delmiş, diğeri ise çıplak elleriyle kayaları değerli taşlara dönüştürebilmiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780716
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780716,
					"content": "#Paimon böyle muazzam dövüş sanatlarının varlığından bile haberdar değildi! Keşke sen de öğrensen {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780717,
						751780718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780717,
					"content": "Vay canına, sanki bir romandan fırlamış gibi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780719
					]
				},
				{
					"id": 751780719,
					"content": "Biliyorum, kulağa saçma geliyor. Ama bu herhangi bir kitap değil. Ustamız bunu Gece Rüzgarının Ustalarının koleksiyonunda bulmuş, yani kesin bir dayanağı vardır, öyle değil mi? Ve en önemlisi, ustamızın buna inancı tam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780720
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780720,
					"content": "İşte bu yüzden bu özel kaplıcayı, daha doğrusu bu \"soğuk kaynak suyunu\" seçti. Amacı, dondurucu soğuk suyu sadece \"hararetini\" kullanarak gerçek bir kaplıcaya dönüştürmek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780721
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780721,
					"content": "Dur bir dakika... Bu su hakikaten de buz gibi! Ama ne kadar güçlü olursa olsun bu kadar uzun süre suda kalmak onu hasta etmez mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780722
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780722,
					"content": "Kesinlikle öyle! Hasta olmasa bile bu böyle sonsuza kadar devam edemez. \"Savaşçı Mücadelesi\" adlı etkinliğimiz günlerdir askıda ve herkes onun geri dönmesini bekliyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780723
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780723,
					"content": "Ancak usta, yarı yolda pes etmenin yeterli \"hararete\" sahip olmadığı anlamına geleceğini söylüyor. Su kaynayana dek buradan ayrılmayacağına yemin etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780724
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780724,
					"content": "Kaplıca müdürünün suyun neden aniden soğuduğuna dair en ufak bir fikri yok. Keşke yardım edebilecek yetenekli maceracılar olsaydı... Bakın, ödül bile hazırladım! Bu sorunu kim çözerse onun olacak tüm bunlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780725,
						751780726
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780725,
					"content": "Kaplıca Halkından birilerini yardıma çağırabilirsin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780727
					]
				},
				{
					"id": 751780727,
					"content": "(Hey, hayır demek için bu kadar acele etmeyelim. En azından ne teklif ettiğine bir bakalım!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780728,
					"content": "Şey... Telaşlanmayın, bu suyun yeniden ısınmasını sağlayacağız. Hem ustamızın donarak hasta olmasına izin veremeyiz. Maceracılar insanlara yardım etmek için vardır, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780729,
					"content": "Teşekkürler! Size güveniyorum o halde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780730
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780730,
					"content": "Sen burada kal. Biz kısa süre içinde bu işi halledeceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751780726,
					"content": "Beni gerçekten ödülle kandırmaya mı çalışıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780727
					]
				},
				{
					"id": 751780718,
					"content": "Buna gerçekten inanmıyorsun, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780719
					]
				},
				{
					"id": 751780707,
					"content": "Muhtemelen ayakta durduğu için daha da üşüyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780708
					]
				},
				{
					"id": 751780708,
					"content": "Paimon'a da öyle geldi. Tir tir titriyor resmen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780709
					],
					"speakerTitle": "Paimon"
				}
			]
		},
