			"dialogs": [
				{
					"id": 751780201,
					"content": "Yardım edin! Birisi bayıldı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780202
					],
					"speakerTitle": "Yoleehe"
				},
				{
					"id": 751780202,
					"content": "#Eyvah, usta bayılmış! Hadi {NICKNAME} gidip yardım edelim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780203
					]
				},
				{
					"id": 751780203,
					"content": "Görünüşe göre usta sadece sıcaktan bayılmış, ciddi bir şeyi yok. Yoleehe, sizin de yardımınızla baygın ustayı oradan uzaklaştırır...\\nAnlaşılan ustanın \"hararetle\" başa çıkma becerilerini geliştirmesi gerekiyor...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
