			"dialogs": [
				{
					"id": 751781401,
					"content": "Aa, küçük Koholazorun burada ne işi var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781402,
					"content": "Ki'o-ki'o...! Demek buradasın... Siz olmasaydınız ben... Ben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781403
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781403,
					"content": "Ya yaralansaydın? Bir daha öyle kaçıp gitme, tamam mı? *burnunu çeker*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781404
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781404,
					"content": "Hey, neşelen biraz! Küçük Sürüngeninin de keyfi yerinde hem. Ne kadar da enerjik, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781405,
					"content": "Raarr! Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781406
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751781406,
					"content": "Ah, şey... Şimdi daha iyiyim. Ay, kendimi tanıtmayı unuttum. Adım Linaha, Kaplıca Halkındanım. Genelde küçük Koholazorlara bakmakla görevliyimdir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781407
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781407,
					"content": "Tek başına mı? Epey etkileyiciymiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781408,
					"content": "P-Pek sayılmaz... Sizin gibi olsaydım Bayan Paimon, muhtemelen kaçıp gitmezlerdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781409
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781409,
					"content": "Ben de hepsinin çatlakların etrafında oyun oynadığını düşünmüştüm ve görünüşe göre haklıymışım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781410
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781410,
					"content": "Demek kaplıca, küçük Koholazorlar Filojiston çatlaklarını tıkadığı için soğudu ha? Kaplıca görevlisi de bu yüzden bir şey anlamamış!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781411,
					"content": "Aslında... Henüz bulamadığım iki Koholazor daha var. Muhtemelen onlar da Filojiston çatlaklarına saklanmışlardır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781412
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781412,
					"content": "Biz hallederiz! Hem su sıcaklığını ayarlar hem de diğer küçük Koholazorları buluruz, merak etme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781413,
					"content": "Gerçekten mi? Teşekkürler! İyi ki Bayan Paimon yanımızda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781414
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781414,
					"content": "Hehe, lafı bile olmaz! Büyük Paimon gibi efsanevi bir maceracıya her zaman güvenebilirsin. Paimon için çocuk oyuncağı sayılır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751781415,
					"content": "Vay canına! Harikasınız Bayan Paimon! Ben de bir gün sizin gibi olmak istiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751781416,
						751781417
					],
					"speakerTitle": "???"
				},
				{
					"id": 751781416,
