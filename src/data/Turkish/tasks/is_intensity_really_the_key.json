			"dialogs": [
				{
					"id": 751780501,
					"content": "Uzak diyarların savaşçısı, \"en güçlüyü\" bulma yolculuğun nasıl gidiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751780502,
						751780503
					],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780502,
					"content": "Bana \"en güçlünün\" nerede olduğunu söyle...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780504
					]
				},
				{
					"id": 751780504,
					"content": "Dağa doğru ilerlersen \"Hararetli Sularla\" dolu bir bölgeye denk geleceksin. Belki orada \"en güçlüye\" dair izler bulabilirsin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Loshts"
				},
				{
					"id": 751780503,
					"content": "Hâlâ üzerinde çalışıyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751780505
					]
				},
				{
					"id": 751780505,
					"content": "Evet! Böyle devam et!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Loshts"
				}
			]
		},
