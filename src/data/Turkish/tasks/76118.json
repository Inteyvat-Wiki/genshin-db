			"dialogs": [
				{
					"id": 761180401,
					"content": "Döndünüz mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180402
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761180402,
					"content": "Bil bakalım ne oldu Columbina? Haklı çıktın, Lauma bize hiçbir şey anlatmadı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180403,
					"content": "İşi başından aşkın duruyor ama.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180404
					]
				},
				{
					"id": 761180404,
					"content": "Bu yüzden önümüzdeki birkaç gün sana biz eşlik edeceğiz. Sen sadece arkana yaslan ve sürprizlere hazır ol!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180405,
					"content": "Ne tür... Sürprizler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180406
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761180406,
					"content": "Ay! Iı, yok bir şey! Biz hiçbir şey bilmiyoruz, yemin ederiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180407,
					"content": "Hehe... Pekala. Önümüzdeki birkaç günü sizinle geçirmek güzel olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180408
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761180408,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180409
					],
					"speakerTitle": "Uzun Tüylü Leylek"
				},
				{
					"id": 761180409,
					"content": "Ooo, yemeğimiz geldi... Bir dakika. Yemekler nerede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180410,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180411
					],
					"speakerTitle": "Uzun Tüylü Leylek"
				},
				{
					"id": 761180411,
					"content": "Burada \"Vakit geldi.\" yazıyor. Ne anlama geldiğini biliyor musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180412
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761180412,
					"content": "Haaaaaa, Paimon şimdi anladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180413,
					"content": "Columbina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180414
					]
				},
				{
					"id": 761180414,
					"content": "Efendim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180415
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761180415,
					"content": "Sen genelde göz bağı takıyorsun, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180416
					]
				},
				{
					"id": 761180416,
					"content": "Evet. Ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180417
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761180417,
					"content": "Ama yine de Kuuvahki sayesinde dünyayı gözlemleyebiliyorsun, doğru mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180418,
					"content": "Doğru. Hatta bu şekilde her şeyi daha net algılıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180419
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761180419,
					"content": "O zaman, şey, bir süreliğine dışarıdaki değişiklikleri kasıtlı olarak fark etmemeni rica edebilir miyiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180420,
					"content": "Bunun \"hoş bir sürpriz\" olması için mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180421
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761180421,
					"content": "... Anlaşılan sen olayı çoktan tahmin etmişsin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180422,
					"content": "Pekala. Anladım. O halde elimi tutar mısınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Küçük Hanım"
				}
			]
