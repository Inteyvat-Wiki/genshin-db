			"dialogs": [
				{
					"id": 761180301,
					"content": "Kuutar heykelini yenilemek mi istiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180302,
					"content": "Evet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180303
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180303,
					"content": "Artık o, yalnızca tek başına göklerin ötesindeki aya bakan kanatsız Kuu{RUBY#[S]Ay Hanımı}tar değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180304
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180304,
					"content": "Kanatlarını açışına tanık olduk, artık yaşama özgürlüğünü geri kazandığını biliyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180305
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180305,
					"content": "Bu nedenle heykelin de yenilenmesi gerekir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180306
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180306,
					"content": "İyi fikirmiş aslında!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180307,
					"content": "Donuk Ayın Çocuklarına bundan bahsettin mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180308
					]
				},
				{
					"id": 761180308,
					"content": "Evet. Onlara Ay Tanrıçası'nın fedakarlığından ve geri dönüşünden bahsettim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180309
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180309,
					"content": "Ve o zarif ışığın rehberliğinde bu dünyayı kirleten güce nasıl karşı durduğumuzu anlattım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180310
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180310,
					"content": "Onun geri döndüğünü duyan herkes çok sevindi, ben de bu fırsattan istifade onlara Columbina'nın düşüncelerini aktardım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180311
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180311,
					"content": "Bizi bir aile olarak gördüğünü ve bizim de onu aileden biri olarak kabul etmemizi istediğini söyledim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180312
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180312,
					"content": "Ne dediler peki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180313
					]
				},
				{
					"id": 761180313,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180314
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180314,
					"content": "Leydi Ay Tanrıçası...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180315
					],
					"speakerTitle": "Zirnytsia"
				},
				{
					"id": 761180315,
					"content": "Onu aileden biri olarak görmekle... Haddimizi aşmış olmaz mıyız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180316
					],
					"speakerTitle": "Lauha"
				},
				{
					"id": 761180316,
					"content": "Columbina'nın bunu bütün içtenliğiyle dilediğine inanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180317
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180317,
					"content": "(Ay İlahicisi Hanım, Ay Tanrıçamızdan ilk adıyla bahsetti!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180318
					],
					"speakerTitle": "Kunegunda"
				},
				{
					"id": 761180318,
					"content": "Yakın geçmişte söylediğim sözleri hatırlıyorsunuzdur belki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180319
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180319,
					"content": "\"Bugünden sonra yolumuzu gerçeklerle, kendimiz döşeyeceğiz.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180320
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180320,
					"content": "Hepinizden benimle aynı seçimi yapmanızı istemeyeceğim ama bugün sizlerle paylaşmak istediğim bazı sözlerim var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180321
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180321,
					"content": "\"Ay ışığını içeri davet edip bizimle olmasını istiyorsak, önce bir zamanlar sıkı sıkıya kapalı olan kapıları açmalıyız.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180322
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180322,
					"content": "... Böyle işte. Son birkaç günkü durumu düşünürsek işler beklediğimden iyi gitti diyebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180323
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180323,
					"content": "Leydi Lauma. Depoya yeni bir taş sevkiyatı geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180324
					],
					"speakerTitle": "Maciej"
				},
				{
					"id": 761180324,
					"content": "Pekala. Hemen geliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180325
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180325,
					"content": "Söylediklerimi ve gördüklerinizi şimdilik bir sır olarak Columbina'dan saklayabilir misiniz? Bunun ona bir sürpriz olmasını isterim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180326
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180326,
					"content": "Paimon iyi niyetli olduğunu biliyor ama gerçekten de sürprizlere bayılıyorsunuz... Hem siz hem de Ay Tanrıçanız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180327,
					"content": "Benden sır çıkmaz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180328
					]
				},
				{
					"id": 761180328,
					"content": "Şey Lauma, Paimon'un sus payı meselesi... Yani şey, bugün hiç fazladan Ay Şöleni porsiyonunuz kalmamıştır, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180329,
					"content": "Kaldı. Gel sana biraz hazırlayayım. Ha, bir de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				}
			]
		},
