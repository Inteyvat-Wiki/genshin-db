			"dialogs": [
				{
					"id": 761180101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180102
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761180102,
					"content": "Sadece Paimon'a mı öyle geliyor, yoksa sen de lezzetli bir koku alıyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180103,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180104
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761180104,
					"content": "Columbina kendi başına ziyafet çekiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180105,
					"content": "#{NICKNAME}, Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180106
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761180106,
					"content": "Görünüşe göre birilerinin keyfi epey yerinde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180107,
					"content": "Siz de denemek ister misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180108
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761180108,
					"content": "Yok yok, sen ye.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180109
					]
				},
				{
					"id": 761180109,
					"content": "Seni burada yemek yerken pek görmüyoruz! Sırf bunu almak için mi dışarı çıktın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180110,
					"content": "Lauma verdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180111
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761180111,
					"content": "Vay be, sana gerçekten de iyi bakıyor galiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180112,
					"content": "Buradan ayrılmamam koşuluyla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180113
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761180113,
					"content": "Ne? Ev hapsini kabul et diye verilmiş bir rüşvet bu! Üstelik ucuza gitmişsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180114,
					"content": "Bana ilginç kitaplar ve özenle yapılmış oyuncaklar da getirdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180115
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761180115,
					"content": "Şey, şimdi daha ziyade iş seyahatine çıkan bir anne ve evde bıraktığı çocuğu gibi oldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180116,
					"content": "Lauma gerekçesini açıkladı mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180117
					]
				},
				{
					"id": 761180117,
					"content": "Bana şimdilik dışarı çıkmamamı ve özellikle de Donuk Ayın Çocuklarından uzak durmamı söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180118
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761180118,
					"content": "Yemeklerimi getiren hayvanlara sordum ama Lauma onlara konuşmamalarını tembihlemiş, onlar da öyle yaptılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180119
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761180119,
					"content": "Şey, bu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180120,
					"content": "Tahmin yürütecek olursam benimle ilgili bir şeyler hazırlıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180121
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761180121,
					"content": "Merak etmeyin. Zaten burada kalmayı hiç sıkıcı bulmuyorum. Yemekler güzel, tam damak zevkime göre. Dışarı çıkmamak benim için sorun değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180122
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761180122,
					"content": "Ve eğer Donuk Ayın Çocukları gerçekten de bir şey için hazırlanıyorlarsa... Onlara engel olmamamız gerekir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180123
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761180123,
					"content": "Gidip soralım ister misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180124
					]
				},
				{
					"id": 761180124,
					"content": "Evet. Paimon da şimdi biraz meraklandı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180125,
					"content": "Sorabilirsiniz... Ama hazırlıklı olun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180126
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761180126,
					"content": "Muhtemelen beni görmeye geleceğinizi biliyordur, bu yüzden size hiçbir şey anlatmayabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Küçük Hanım"
				}
			]
		},
