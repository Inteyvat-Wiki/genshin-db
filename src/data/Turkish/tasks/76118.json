				},
				{
					"id": 761180504,
					"content": "(Gözlerini gerçekten de açtı!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180505,
					"content": "(Öylesine söylemiştim aslında...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180506
					]
				},
				{
					"id": 761180506,
					"content": "Çok güzel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180507
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761180507,
					"content": "Bu kanatlar heykeli daha bütün göstermiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180508
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761180508,
					"content": "Bu, biz Donuk Ayın Çocuklarından sana bir hediye Columbina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180509
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180509,
					"content": "Artık özgürce uçabilen, parmakları sonunda \"evim\" dediği yere dokunabilen tanrıçamızı kutlamak istedik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180510
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180510,
					"content": "... Eskiden bu heykele her baktığımda aklıma sadece doğduğumda hissettiğim kafa karışıklığı gelirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180511
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761180511,
					"content": "Ama artık bir \"evin\" sıcaklığını hissediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180512
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761180512,
					"content": "Belki de bu heykel gibi ben de artık kanatlarım olmasına rağmen burada kalmayı seçmişimdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180513
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761180513,
					"content": "... Hepinize teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180514
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761180514,
					"content": "Hazırladığımız bir hediye daha var ama benimle biraz yürümen gerekecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180515
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180515,
					"content": "Hı? Bir sürpriz daha mı var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761180516,
					"content": "Donuk Ayın Çocuklarıyla beraber ormanda basit bir hoş geldin yemeği hazırladık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180517
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180517,
					"content": "Bundan sonra burası senin de evin olacak Columbina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180518
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180518,
					"content": "Ne zaman ev hasreti çekersen lütfen burada kal ve naçizane misafirperverliğimizin keyfini çıkar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180519
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180519,
					"content": "Olur, tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180520
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761180520,
					"content": "Aa, bakın. Ay doğmuş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180521
					]
				},
				{
					"id": 761180521,
					"content": "Gidelim o halde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180522
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180522,
					"content": "Umarım her gece o Ay Duası Gecesi kadar harika olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180523
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 761180523,
					"content": "Evine hoş geldin Columbina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				}
