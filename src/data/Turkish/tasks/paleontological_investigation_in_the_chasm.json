				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Khedive"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710500902,
					"content": "Harika. Bu fotoğraflar çok iyi çıkmış!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500903
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500903,
					"content": "Keşif takımının kaynaklarını harcamaya kesinlikle değiyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500904
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500904,
					"content": "Bak, bunlar hep kadim deniz canlılarına ait kemikler. Yapıları açıkça görülebiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500905
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500905,
					"content": "Yani bu yer, Kanyon'a dönüşmeden önce okyanusun dibindeydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500906
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500906,
					"content": "Ne yazık ki Sumeru'da değiliz. Sumeru'da olsak, onları Akademiye taşıtıp hemen araştırmalara başlardım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500907
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500907,
					"content": "Madencilerin yanlışlıkla bu fosillere zarar vermesine izin veremeyiz. Bazı tedbirler almak adına birilerini tutmalıyız. Evet, Bakanlık çalışanlarıyla yapacağım bir sonraki görüşmemde bu konuyu gündeme getireceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500908
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500908,
					"content": "Ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500909,
						710500910
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500909,
					"content": "Ama ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500911
					]
				},
				{
					"id": 710500911,
					"content": "Yok, şey... Bunlarla idare ederim ben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500912
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500912,
					"content": "Daha önce dediğim gibi bu fosiller mükemmel durumda. Bu da tek bir anlama gelebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500913
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500913,
					"content": "Yer altına bir anda gömülmüşler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500914
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500914,
					"content": "Kanyon'da bulduğun fosillerin neredeyse hepsi sabit bir yükseklikte yer alıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500918,
						710500919
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500918,
					"content": "Sabit bir yükseklikte mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500920
					]
				},
				{
					"id": 710500920,
					"content": "Yükseklik farkları, jeolojik açıdan bakıldığında çok küçük.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500915
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500915,
					"content": "Bu da sürecin çabucak gerçekleştiği ve neredeyse tüm bu fosillerin aynı zamanda oluştuğu anlamına geliyor. Yani bir şey, buradaki ekosistemin bir saniye içinde baştan aşağı değişmesine sebep olmuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500916
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500916,
					"content": "Bence buna büyük bir şok dalgası veya ona benzer bir şey sebep olmuş olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500917
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500917,
					"content": "Acaba Kanyon'da ne olmuş olabilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500919,
					"content": "O kadar da sabit değildir herhalde, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500920
					]
				},
				{
					"id": 710500910,
					"content": "Bana daha fazla resme ihtiyacın olduğunu söylemeyeceksin, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500911
					]
				}
			]
		},
