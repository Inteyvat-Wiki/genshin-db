			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Khedive"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710500601,
					"content": "Bulduğumuz o tuhaf kaya hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500602
					]
				},
				{
					"id": 710500602,
					"content": "Bazı tuhaf kayaların resmini çektin demek?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500603
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500603,
					"content": "Bir göster bakayım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500604
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500604,
					"content": "İşte bak...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500605
					]
				},
				{
					"id": 710500605,
					"content": "Ah! Şu resme bak! Çok net. Anlaşılan Fontaine'in yeni Kamera modelleri denildiği kadar var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500606
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500606,
					"content": "Zamanında prototip olanlardan almıştım ama çektiğim fotoğraflar yeterince net değildi. Üstelik tek bir kişinin taşıyamayacağı kadar da hantaldı. Bu yüzden Akademinin bir köşesinde çürüyüp gittiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500607,
						710500608
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500607,
					"content": "Çürüyüp gitmek...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500609
					]
				},
				{
					"id": 710500609,
					"content": "Aynen, onlara vereceğim Morayla karnımı doyurabilirdim... Hımm, sanırım yeni bir Kamera almamın zamanı gelmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500610
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500610,
					"content": "Neyse, konudan uzaklaştım. Bir bakayım. Bu kaya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500611
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500611,
					"content": "Evet, bu bir fosil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500612
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500612,
					"content": "Fosil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500613
					]
				},
				{
					"id": 710500613,
					"content": "Evet, içindeki fosilleşmiş deniz canlılarını görebilirsin... Çok ilginç! Liyue'de bu durum için bir söz vardır. Kelimesi kelimesine hatırlamasam da şöyle bir şeydi: \"Orman ve tarlalar karadadır ama çevreleri okyanusla sarılıdır.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500614
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500614,
					"content": "Kanyon'da fosil bulmamız, bu yaratıkların bir anda yer altına gömüldükleri anlamına geliyor. Yoksa, iskeletleri bu kadar mükemmel durumda olmazdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500615
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500615,
					"content": "Bu arada burada sıklıkla deprem olduğunu duydum. Fosil oluşumunun ön şartlarından biri de yoğun jeolojik hareketlilik olduğu için, bu durum akla daha da yatıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500616
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500616,
					"content": "Bu keşif, bir zamanlar burada yaşayan kadim canlıları anlamamıza kesinlikle yardımcı olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500617
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500617,
					"content": "Yine de birkaç resim daha olsa fena olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500619
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500619,
					"content": "Buna benzer başka fosillerle karşılaşırsan, lütfen benim için birkaç fotoğraf çek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500620
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500620,
					"content": "Kaç tane lazım?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500621
					]
				},
				{
					"id": 710500621,
					"content": "Bir bakayım. Raporum için dört veya beş tane lazım... En iyisi beş diyelim. Bana buna benzer beş kayanın resmini getir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500622
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500622,
					"content": "Tabii ki bunun için makul bir ücret teklif edeceğim. Bu büyük bir keşif, hiç abartmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500608,
					"content": "Ziyan olmuş...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500609
					]
				}
			]
		},
