			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 741500701,
					"content": "(Üzeri tozlanmış, eski püskü ve ağır kutular. Fontaine Şehri'nin tertemiz, pırıl pırıl sokaklarında böyle şeylerin olması gerçekten çok rahatsız edici.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500702
					],
					"speakerTitle": "Tuhaf Kutular"
				},
				{
					"id": 741500702,
					"content": "(Kutuların alt kısımlarında bir sürü su lekesi var. Görünüşe göre yıllarca aşırı nemli bir yerde kalmışlar.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500703
					],
					"speakerTitle": "Tuhaf Kutular"
				},
				{
					"id": 741500703,
					"content": "(Kapıdaki lekeler, bu kutuların vaziyeti yanında devede kulak gibi kalıyor doğrusu.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tuhaf Kutular"
				}
			]
		},
		{
