			"dialogs": [
				{
					"id": 741500101,
					"content": "Çok sağ ol Molli. O parlak eflatun gözlerinden belli oluyor zaten kalbinin güzelliği.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500102
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500102,
					"content": "Hehe, o sizin güzelliğiniz! Geçen sefer size getirdiğim oyuncak bebeği sevdiniz mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500103
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500103,
					"content": "Sevmez miyim hiç, bayıldım. Hatta ona yemek masasında bir yer bile ayırdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500104
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500104,
					"content": "Gerçekten mi? Yaa, ne kadar da mutlu olmuştur şimdi! Peki bugün iyi misiniz? Yürüyüş yaparken kolunuza girmemi ister misiniz? Ya da gazetenizi getireyim size...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500105
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500105,
					"content": "Gözlerim iyi görmüyor derseniz sizin için okuyabilirim de.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500106
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500106,
					"content": "Annemin bir lafı vardır, \"Her güne bir iyilik lazım.\" der hep. Öğretmenim de bu hafta iyi insanlar ve iyiliğin gücü hakkında bir makale yazmamı istedi zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500107
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500107,
					"content": "Şey... Bunu makale yazmam gerektiği için yapmıyorum tabii! Eğer hayır demezseniz size yardımcı olmak isterim sadece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500108
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500108,
					"content": "Haha. Yok evladım, şimdilik bir eksiğim yok. Bana yardım etmek istiyorsan arada bizim eve oynamaya geldiğini ailene haber ver, yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500109
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500109,
					"content": "Biliyorum Bay Leroy, onlara söyledim zaten ama... Bu durumdan pek de hoşlanmadılar sanki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500110
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500110,
					"content": "Yine de ziyaretime geleceksin ama, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500111
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500111,
					"content": "Tabii ki geleceğim, onlar izin versinler vermesinler... O anlaşmayı boşuna mı yaptık?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500112
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500112,
					"content": "Haha, aferin sana. Sözünün eri bir çocuksun, sana çok kanım ısındı benim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500113
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500113,
					"content": "Aa, sizmişsiniz! Hoş geldiniz sevgili çocuklar, hoş geldiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500114
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500114,
					"content": "*öksürür* Şey, lafınızı bölüyoruz ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500115,
					"content": "Araya girmiyoruzdur umarım?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500116
					]
				},
				{
					"id": 741500116,
					"content": "Ne münasebet. Bir şeyi böldüğünüz falan yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500117
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500117,
					"content": "Genç arkadaşım Molli şu sıralar çok meşgul, ödevini bitirmeye çalışıyor. Geçerken de buraya bir uğradı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500118
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500118,
					"content": "Bana biraz iyilik yapmak istiyor, makalesinde materyal olarak kullanacakmış da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500119
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500119,
					"content": "Ama oldu mu şimdi! Ödevimi bitirmek için yardım etmiyorum dedim ya size... Yani sırf o yüzden değil en azından.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500120
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500120,
					"content": "Doğru ya, tabii. Sırf ödev yapacaksın diye bana yardım etmeye niyetlenmedin sonuçta sen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500121
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500121,
					"content": "Bizim bu iki genç misafir gibi sadece iş lazım diye mecburen ev işlerine el atıyor değilsin ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500122
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500122,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500123
					]
				},
				{
					"id": 741500123,
					"content": "Şey... Biz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500124,
					"content": "Aman, takılıyorum size canım! Hemen de dudak büküyorlar... İhtiyar dostunuza bu ufacık şakayı da çok görmeyin lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500125
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500125,
					"content": "Gençlerin elinde vakitten bol şey yok, doğru ama siz bu vakti benimle geçirmeye razısınız. Eh, gençlerle muhabbet etmek benim de keyfimi yerine getiriyor. Ne güzel işte, herkes halinden memnun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500126
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500126,
					"content": "Size hemen bir iki iş vereyim o halde. İnsanlar sürekli kapıdan girip çıkıyor, ortalık hemen toz toprak oluveriyor tabii, günlerdir de kimse burayı süpürmedi. O yüzden rica etsem benim için tekrar temizler misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500127
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500127,
					"content": "Pekala... Tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500128,
					"content": "Sen de kedime göz kulak olur musun Molli? Zahmet olmazsa yanında bir de balık fileto götürüver lütfen. Adı Nana bu arada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500129
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500129,
					"content": "Eskiden Nana adlı bir köpeğim vardı, kedime de onun adını verdim... Kızım evlenince köpeği de yanında götürdü de.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500130
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500130,
					"content": "Pekala Bay Leroy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500131
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500131,
					"content": "Peki o zaman çocuklar. Hadi gidin bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Benoit Leroy"
				}
			]
		},
