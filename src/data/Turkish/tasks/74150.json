			"dialogs": [
				{
					"id": 741500601,
					"content": "Çocuklar evde değil, tek başına da kapının orada ve evin arkasında biriken pisliği temizle temizleyebilirsen... Bu işi size bırakayım en iyisi.",
					"roleType": "TALK_ROLE_NPC",
