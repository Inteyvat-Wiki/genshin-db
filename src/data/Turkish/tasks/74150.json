			"dialogs": [
				{
					"id": 741490601,
					"content": "Gazete mi getirdiniz? Kapıya bırakın. Ben sonra gelip alırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490602
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490602,
					"content": "(Bugün Benoit'ya zaten yardım ettin. İstirahat ederken onu rahatsız etmesen daha iyi. Yarın buluşacaksınız nasıl olsa.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vur"
				}
			]
		},
