			"dialogs": [
				{
					"id": 741500301,
					"content": "Bitirdiniz mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500302
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500302,
					"content": "Her şey tamam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500303
					]
				},
				{
					"id": 741500303,
					"content": "Evet, temizliği hallettik. Molli de kediyi besledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500304,
					"content": "Bu arada evinin yanında bir sürü eski kutu var Benoit, hepsi de pislik içinde. Onları da temizlememizi ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500305,
					"content": "Hah, o kutuları mı diyorsun... İçlerinde eski püskü eşyalar var sadece, bir işe yaradıkları falan yok yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500306
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500306,
					"content": "Bazılarında eski evimden kalan mobilyalar ve ufak tefek eşyalar falan var, atmaya kıyamadım bir türlü... Hepsini içeri getirmeyi planlamıştım aslında da evdeki hesap o eşyalara uymadı diyelim. Ben de ne yapayım, tüm kutuları oraya yığıverdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500307
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500307,
					"content": "Aylardır elimi sürmemiş olabilirim bile. Buranın sakinleri temiz kalpli ve dürüst insanlardır, hırsızlık nedir bilmezler. Kutular orada kalsa da olur yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500308
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500308,
					"content": "Bay Leroy, Bay Leroy! Size yardımcı olabildim mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500309
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500309,
					"content": "Elbette oldun Molli. Ailene benden selam söylemeyi unutma lütfen, işte o zaman bana daha çok yardımın dokunur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500310
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500310,
					"content": "Atıştırmalıklarınız ve harçlığınız da burada. Buyurun alın çocuklar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500311
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500311,
					"content": "Hayır, hayır! Harçlığa ihtiyacım yok. Sadece Nana'yı biraz daha sevmek istiyorum. Sevebilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500312
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500312,
					"content": "Tabii ki, istediğin kadar sevebilirsin. Tırnakları sivridir ama dikkat et. Gitmeden önce de eve bir uğra, sana atıştırmalık bir şeyler ikram edeyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500313
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500313,
					"content": "Neden dışarıya çıktın baba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500314
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500314,
					"content": "Evlatlarım yanımda olmayınca yalnız kaldım tabii, ne yapayım ihtiyar başıma... Dışarı çıkıp biraz temiz hava alayım bari dedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500315
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500315,
					"content": "Görüyor musun Morticia? Altı üstü birkaç günlüğüne dışarı çıkalım dedik, hemen de darılıverdi bize.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500316
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500316,
					"content": "Neyse, küskünlüğü uzun sürmez. Getirdiğimiz hediyeyi görünce hemen barışır kesin bizimle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500317
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500317,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500318
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741500318,
					"content": "Hediye mi? Ne getirdiniz bakayım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500319
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500319,
					"content": "Harika ötesi bir şey tabii ki. Görünce anlayacaksın. Morticia güzel ve pahalı şeyleri ne kadar sevdiğini biliyor. Senin için özellikle seçti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500320
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500320,
					"content": "Teşekkür ederim kızım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500321
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500321,
					"content": "Üstüme düşeni yaptım sadece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500322
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741500322,
					"content": "Heh, doğru ya. Sizi misafirlerimle tanıştırayım, siz yokken çocuklar oynamaya geldi de.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500323
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500323,
					"content": "Selam. Babam cana yakın biridir, çocukları da çok sever. Onu yalnız bırakmadığınız için çok teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500324
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500324,
					"content": "Neyse ki eşim ve ben artık döndük. Bundan sonrasıyla biz ilgileniriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500325
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500325,
					"content": "Evet, ne iyi ettiniz de döndünüz hakikaten. Verin bakalım hediyemi, açıp bir bakayım neymiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500326
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500326,
					"content": "Peki baba. Hadi içeri girelim artık, olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500327
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741500327,
					"content": "Tabii, olur. Misafirlerime ödeme yapmayı ve atıştıracak bir şeyler vermeyi unutma lütfen Athos. Etrafı süpürmeme yardım ettiler, Nana'yı da beslediler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500328
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500328,
					"content": "Şu genç hanıma da biraz atıştırmalık ver bir zahmet. Ben içeri giriyorum artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500329
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500329,
					"content": "Bay Leroy! Nana göbeğini sevmeme izin verdi... Aa. Bay Leroy nereye gitti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500330
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500330,
					"content": "Babamı mı arıyorsun küçük hanım? Ben onun damadıyım... Şey, oğlu olarak da düşünebilirsin yani. Adım Athos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500331
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500331,
					"content": "Damadın ne demek olduğunu biliyorum zaten. Kızının kocası oluyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500332
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500332,
					"content": "Haha, ne de akıllısın sen öyle! Babama eşlik ettiğin için teşekkürler. Kendisi şu an evde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500333
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500333,
					"content": "Bu atıştırmalıkları sana ayırdık. İşlerin geri kalanını eşimle ben hallederiz... Artık uğramasan da olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500334
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500334,
					"content": "Neyse, çok oyalanmadan eve dön bence. Dışarıda çok kalıp da aileni merakta bırakma şimdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500335
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500335,
					"content": "Şey, siz orasını dert etmeyin bayım. Benim için zahmet olmadı, Bay Leroy ile bir anlaşmamız var zaten bizim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500336
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500336,
					"content": "Hem neme lazım, ileride de yardıma ihtiyacı olabilir... Kediyi beslemek, çiçekleri sulamak falan. Bilirsiniz işte! İnsanların yüzünü güldürmek beni de mutlu ediyor, o yüzden mutlaka tekrar geleceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500337
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500337,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500338
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500338,
					"content": "... Aldık mı başımıza belayı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500339
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500339,
					"content": "Efendim? Bir sıkıntı mı var acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500340
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500340,
					"content": "Yok, küçük hanım. Sıkıntı falan yok. Seninle konuşmam gereken önemli bir mesele var sadece. Hımm... Konuşma da denemez gerçi ya. Benim için bir şey yapmanı rica edeceğim senden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500341
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500341,
					"content": "Tabii. Nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500342
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500342,
					"content": "Ben sana biraz atıştırmalık ve harçlık vereceğim, sen de bir daha buraya gelmeyeceksin. Anlaştık mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500343
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500343,
					"content": "Ne? Neden ki? Yanlış bir şey mi yaptım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500344
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500344,
					"content": "Yok canım, ne yanlışı... Babamın sağlığı pek iyi değil, malum. Bir süredir uykusuzluk çekiyor, son zamanlarda da durumu iyice kötüleşti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500345
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500345,
					"content": "Eşim ve ben sağlık durumundan ötürü onun rahat rahat dinlenebilmesini istiyoruz, ortamı huzurlu tutmamız lazım yani. Anlıyorsundur eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500346
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500346,
					"content": "Aa, Bay Leroy hastaymış demek... Anlıyorum. Bir dahaki sefere ona daha fazla Bulle Meyvesi getiririm o zaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500347
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500347,
					"content": "Pastayı çok kaçırınca benim de hep karnım ağrır. Öyle olunca babam da bana tatlıyı azaltıp daha çok meyve yememi tembihler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500348
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500348,
					"content": "Bay Leroy da bol bol meyve yemeyi ihmal etmezse hiçbir şeyciği kalmaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500349
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500349,
					"content": "*iç çeker* Anlaşıldı. Bin dereden su getirmekle olmayacak bu iş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500350
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500350,
					"content": "Siz ikinize gelince... Buyurun, atıştırmalıklarınız ve ödülleriniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500351
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500351,
					"content": "Şimdi lafı hiç uzatmadan sadede geleceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500352
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500352,
					"content": "İleride tekrar buraya gelip huzurumuzu kaçırmayın lütfen. Bunu sadece benim değil, tüm Leroy ailesinin temennisi olarak düşünün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500353
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500353,
					"content": "Yaşınız küçük olabilir ama ne demek istediğimi anlıyorsunuz bence. O yüzden lütfen zahmet edip de bir daha buraya gelmeyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500354
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500354,
					"content": "Ben diyeceğimi dedim. Size elveda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500355
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500355,
					"content": "Hayret bir şey ya! Neden gelemiyormuşuz ki? Bu adam resmen kovaladı bizi, Bay Leroy bize ne kadar iyi davranıyordu halbuki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500356
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500356,
					"content": "Aynen öyle! Kibar kibar konuşuyor falan ama soğuk nevalenin teki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500357
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741500357,
					"content": "Aman canım, neyse... Bana ne onun ne dediğinden! Yarın gelip Bay Leroy'u göreceğim. Siz de gelir misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500358
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500358,
					"content": "Ne olur gelin! Nana öyle sevimli ki gidip biraz daha sevmek istiyorum onu... Bay Leroy da bize biraz daha abur cubur verir hem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500359,
						741500361
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500359,
					"content": "Sona kalan çürük yumurta!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500360
					]
				},
				{
					"id": 741500360,
					"content": "Tamamdır o zaman. Sözünüzden dönmek yok, ona göre! Kediyi sevip Bay Leroy ile oynayacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Molli"
				},
				{
					"id": 741500361,
					"content": "Vakit bulursak olur tabii.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500362
					]
				},
				{
					"id": 741500362,
					"content": "Peki. Tekrar görüşmek üzere o halde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Molli"
				}
			]
		},
