			"dialogs": [
				{
					"id": 726640101,
					"content": "Hımm... Bir dizi hazine sandığı daha yerleştirmem gerekiyor, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640102
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640102,
					"content": "Birinin hazine sandığı dediğini mi duydum?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640103
					]
				},
				{
					"id": 726640103,
					"content": "Ne? Senmişsin Gezgin! Ay Tutkusu Festivaline katılmaya mı geldin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640104
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640104,
					"content": "Öyle denebilir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640105
					]
				},
				{
					"id": 726640105,
					"content": "O halde tam zamanında geldin! Maceracılar Loncası festivali kutlamak için bir etkinlik düzenliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640106
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640106,
					"content": "Daha fazla bilgi ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640107,
						726640108
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640107,
					"content": "Ne tür aktivitelerden bahsediyoruz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640110
					]
				},
				{
					"id": 726640110,
					"content": "Ay Tutkusu Festivali sırasında katılımcıların bulması için Lonca çeşitli yerlere Ay Tutkusu Tılsımı bıraktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640111
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640111,
					"content": "Tılsımları bulanlar bize getirdiğinde karşılık olarak çeşitli ödüller alacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640112
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640112,
					"content": "Ayrıca büyük bir dizi hazine sandığını da kırsal alanda çeşitli yerlere bırakmaları için kalabalık bir grup maceracıyı görevlendirdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640113
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640113,
					"content": "Bu hazine sandıkları yalnızca bu etkinlik için hazırlanmış birbirinden farklı güzel eşyalarla dolu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640114
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640114,
					"content": "Bu iki aktivitenin dışında seçkin maceracılar için zorlu görevlerimiz de var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640115
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640115,
					"content": "Ayrıntılarına gelirsek, şey... Bir dizi canavar kampını işgal etmek gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640116,
						726640117
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640116,
					"content": "Bunun festival ile ne alakası var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640118
					]
				},
				{
					"id": 726640118,
					"content": "Aha... Ahaha... Şey, yani öyle söylersen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640119
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640119,
					"content": "O canavarları yenenlere dağıtılacak ödüller var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640120
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640120,
					"content": "Yahu bunun normal görevlerden bir farkı yok...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640121
					]
				},
				{
					"id": 726640121,
					"content": "Lütfen, bize yardım et. Maceracılarımızın çoğu festivalde eğlenmeye gitti ve görev ilanlarının çoğu öylece duruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640122
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640122,
					"content": "Bir el atsan? Yeteneklerini düşününce hepsi çantada keklik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640123,
						726640124
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640123,
					"content": "Of, tamam...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640125
					]
				},
				{
					"id": 726640125,
					"content": "E-Elbette, emeğinin karşılığını alacaksın Gezgin. Sen hiç merak etme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640126
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640126,
					"content": "Ay Tutkusu Festivali boyunca burada olacağım. Bir sorun olursa doğrudan bana sorabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640127
					],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640127,
					"content": "Sana güveniyoruz Gezgin. O halde... Festivalin tadını çıkar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linyang"
				},
				{
					"id": 726640124,
					"content": "Ödülümü hazırlasan iyi edersin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640125
					]
				},
				{
					"id": 726640117,
					"content": "İyi de bunun Ay Tutkusu Festivali ile hiçbir alakası yok ki!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640118
					]
				},
				{
					"id": 726640108,
					"content": "Ya hayır, yine mi günlük görevler? Günlük görev olmasın da ne olursa olsun...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726640109
					]
				},
				{
					"id": 726640109,
					"content": "Yok, hayır! Bu aktivite tam maceracılara göre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726640110
					],
					"speakerTitle": "Linyang"
				}
			]
		}
	]
}