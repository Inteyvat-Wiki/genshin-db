			"dialogs": [
				{
					"id": 751810101,
					"content": "Nostaljik bir anı gibi bir sahne canlanıyor önünde.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751810102
					]
				},
				{
					"id": 751810102,
					"content": "Sayısız kıvrım üzerinden işlemler akıyor, katmanlı platformlar arasında spektrum yolları geçiyor.\\nBiriken Filojiston ağır basınç altında uçan ve kontrol edilebilen bir ısı topuna dönüşüyor.\\n\"Başardık!\" diye seviniyor kardeşlerin.\\nFakat yıldız dövmekten farksız bu başarıyı planlayan kişi deney alanının dışında durmuş bekliyor, sanki bu muhteşem başarıyla hiçbir ilgisi yokmuşçasına...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751810103
					]
				},
				{
					"id": 751810103,
					"content": "Tebrik etmek gerek. Minyatür bir göksel cisme denk bir şey yaratmak... \"Yıldız Kümesi\" miydi adı? Gerçekten büyük başarı, ayın yeniden inşasıyla kıyaslasak yanlış olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751810104
					],
					"speakerTitle": "Gölete gir"
				},
				{
					"id": 751810104,
					"content": "\"O\" hâlâ aramızda olsaydı kanatlarını çekip seni başıyla tebrik ederdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751810105
					],
					"speakerTitle": "Gölete gir"
				},
				{
					"id": 751810105,
					"content": "\"... Yardım etmeye gönüllü olsaydın çok daha önce tamamlanırdı bu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751810106
					],
					"speakerTitle": "Gölete gir"
				},
				{
					"id": 751810106,
					"content": "İlgimi çekmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751810107
					],
					"speakerTitle": "Gölete gir"
				},
				{
					"id": 751810107,
					"content": "\"... Bana yardım etmelisin Kukulkan. Her Şeyi Yağmalayan'ın elçisini vadilerin en derinliklerine kovduk, fakat efendisi uyandığında...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751810108
					],
					"speakerTitle": "Gölete gir"
				},
				{
					"id": 751810108,
					"content": "\"Halkımıza bir felaket daha yaşatacaktır muhakkak.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751810109
					],
					"speakerTitle": "Gölete gir"
				},
				{
					"id": 751810109,
					"content": "Zavallı kardeşlerini korumak için bu şeyi yaratman ne asil bir davranış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751810110
					],
					"speakerTitle": "Gölete gir"
				},
				{
					"id": 751810110,
					"content": "\"'Bizim' zavallı kardeşlerimiz.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751810111
					],
					"speakerTitle": "Gölete gir"
				},
				{
					"id": 751810111,
					"content": "\"Bu henüz başlangıç, oysa benim günlerim sayılı. Zifiri karanlık gölge hepimizi boğmadan önce Ejder Soyu için yeni bir yol açmam gerek.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751810112
					],
					"speakerTitle": "Gölete gir"
				},
				{
					"id": 751810112,
					"content": "Ya da belki kendi yollarını bulmalarına izin vermen gerek... Dobralığımı affet fakat açmayı planladığın yol türümüz için fazla dar olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751810113
					],
					"speakerTitle": "Gölete gir"
				},
				{
					"id": 751810113,
					"content": "\"O dar yoldan yürümek şart olacak. Vaktin azaldığında... Beklemek bir lüks haline geldiğinde...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751810114
					],
					"speakerTitle": "Gölete gir"
				},
				{
					"id": 751810114,
					"content": "\"Yeterince bekledik bana sorarsan. Bir gün gelecek Kukulkan, günlerin su gibi akıp gittiğinde anlayacaksın. İşte o gün anlayacaksın verdiğim kararı...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751810115
					],
					"speakerTitle": "Gölete gir"
				},
				{
					"id": 751810115,
					"content": "... Kralım, ağabeyim, doğduğu gün bana da hayat veren efendim... Bu konuda sana katılamıyorum maalesef.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751810116
					],
					"speakerTitle": "Gölete gir"
				},
				{
					"id": 751810116,
					"content": "Hım. Bu... Bu alev topu yaratıldığında yaşanan bir şeyi mi gördük?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751810117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751810117,
					"content": "Sen de mi gördün Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751810118
					]
				},
				{
					"id": 751810118,
					"content": "Evet, Paimon bu sefer çok net gördü... Bu platformun etrafındakiler eskiden burada yaşayan ejderhalar olmalı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751810119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751810119,
					"content": "Peki o zaman konuşanlar kimdi? Tuhaf...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751810120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751810120,
					"content": "Grraarr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751810121
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751810121,
					"content": "Neyse, buradaki Yıldız Kümesinin üzerindeki mühür kırılmış olmalı şimdi, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}