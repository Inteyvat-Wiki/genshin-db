			"trigger": {
				"objectNames": [
					"Yanfei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10280601,
					"content": "Böyle bir yerde tutsak kalacağımız kimin aklına gelirdi? Başımıza gelene bak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280602
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280602,
					"content": "Hayatım boyunca yaptığım çalışmalarla insanları nasıl hapse atacağımı öğrendim... Ama hapisten kaçmak hakkında en ufak bir fikrim yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280603
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280603,
					"content": "Hatta \"mutlu bir hayat yaşamak\" için babamla sözleşme bile imzaladım. Buraya kadar gelmişken umudumu yitiremem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280604
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280604,
					"content": "İyimser kalmaya çalış. En azından birkaç eski dostumla tekrardan bir araya geldim ve yeni bir yer keşfedip dünyada daha fazla yer görmüş oldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280605
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280605,
					"content": "Hı hı... Haklısın, hâlâ bir umut ışığı var. Sanırım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanfei"
				}
			]
		},
		{
