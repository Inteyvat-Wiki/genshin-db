				"objectNames": [
					"Arataki Itto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10280801,
					"content": "Bu kadar yeter. Gidip bir daha bakacağım. Ama bu sefer Arataki \"Biricik Oni\" olarak yapacağım şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280802
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280802,
					"content": "Patron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280803
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280803,
					"content": "Hey! Ne oldu asık surat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280804
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280804,
					"content": "Közlenmiş Eflatun Kavun vakti geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280805
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280805,
					"content": "Ha? Burada yerin altına düşmüşüz ve hayatımızı kurtarmaya çalışıyoruz. Paşamız gelip Közlenmiş Eflatun Kavun vakti falan diyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280806
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280806,
					"content": "Möö, möö.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280807
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10280807,
					"content": "İlginç. Duyduğun gibi Ushi tamamen seninle aynı fikirde... Dur biraz, sen kimin tarafındasın Gürbüz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280808
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280808,
					"content": "Möö...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280809
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10280809,
					"content": "Kendimizi yormamamız lazım. Enerjimiz ve moralimiz yerinde olsun ki karşılaşacağımız şeylere hazırlıklı olalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280810
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280810,
					"content": "Ushi bile bunun farkında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280811
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280811,
					"content": "Peki, siz ikiniz... Bir şeyler mi yiyorsunuz siz bakayım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280812
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280812,
					"content": "Dur bakayım, hâlâ sıcak mı? Ah, mis gibi kokuyor... Mmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280813
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280813,
					"content": "Tamam. Hemen az bir şey atıştıralım, sonra çıkışı aramaya devam ederiz. Hey, bitirmeyin. Bana da bırakın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
		{
			"id": 102702,
