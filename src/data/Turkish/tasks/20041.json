			"dialogs": [
				{
					"id": 200410101,
					"content": "Maceradayken mükemmel plan diye bir şey olmaz! Sürekli böyle üzerine düşünürsen nasıl ilerleyeceksin ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410102
					],
					"speakerTitle": "Meraklı Patchi"
				},
				{
					"id": 200410102,
					"content": "Plan kusursuz değilse her şeye hazırlıklı olmalıyız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410103
					],
					"speakerTitle": "Doolan"
				},
				{
					"id": 200410103,
					"content": "Niçin tartışıyorsunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200410104
					]
				},
				{
					"id": 200410104,
					"content": "Ben antik kalıntı araştırmacısıyım ve Bin Rüzgar Tapınağına eğitim gezisi gerçekleştirmek istiyorum ama savaşın dahil olduğu durumlarla nasıl baş edeceğimi bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410105
					],
					"speakerTitle": "Meraklı Patchi"
				},
				{
					"id": 200410105,
					"content": "Bay Doolan bir maceracı ve tapınak araştırması için gereken düzenlemeleri yapıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410106
					],
					"speakerTitle": "Meraklı Patchi"
				},
				{
					"id": 200410106,
					"content": "Amacım asla Doolan'ı eleştirmek değil ve Harabe Muhafızlarının gerçekten de zorlayıcı olabileceğini biliyorum... Ama her ayrıntısına kadar düşünülmüş kapsamlı bir macera planı oluşturmakta ısrarcı ve bunun için de art arda toplantı yapıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410107
					],
					"speakerTitle": "Meraklı Patchi"
				},
				{
					"id": 200410107,
					"content": "İnceleme, araştırma ve düzenlemeler yaptık, sonra ek inceleme, daha fazla araştırma ve ikinci bir düzenleme... Artık katlanamıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410108
					],
					"speakerTitle": "Meraklı Patchi"
				},
				{
					"id": 200410108,
					"content": "Şimdi de tapınağın yakınında canavarların olduğuna dair yeni bir kanıt bulduğunu söylüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410109
					],
					"speakerTitle": "Meraklı Patchi"
				},
				{
					"id": 200410109,
					"content": "Yalvarırım onları benim için ortadan kaldır. Tapınağın içine girmemize faydası olmasa da sırf Doolan artık sussun diye...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410110,
						200410111
					],
					"speakerTitle": "Meraklı Patchi"
				},
				{
					"id": 200410110,
					"content": "Sanırım ne olması gerektiğini anladım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 200410111,
					"content": "Memnuniyetle Doolan'ın toplantılarında senin yerini alırım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200410112
					]
				},
				{
					"id": 200410112,
					"content": "Jest için teşekkür ederim ama söylemiş olayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200410113
					],
					"speakerTitle": "Meraklı Patchi"
				},
				{
					"id": 200410113,
					"content": "Canavarlarla uğraşmak, toplantılarından birine katılmaktan çok daha stressiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Meraklı Patchi"
				}
			]
		},
