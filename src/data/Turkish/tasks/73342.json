			"dialogs": [
				{
					"id": 733420101,
					"content": "Fena değil Sorush! Bölgeyi hemen canlandırmışsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733420102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733420102,
					"content": "Parilerin güçleri gerçekten çok etkileyici.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733420103
					]
				},
				{
					"id": 733420103,
					"content": "Boşuna şaşırıyorsunuz! Güçlerim Sunyata Çiçeğini kurtarmak için yeter de artar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733420104
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733420104,
					"content": "Karanlık aşınma yayılmaya devam ediyor, bu Sunyata Çiçekleri de onun sayısız kurbanlarından yalnızca biri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733420105
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733420105,
					"content": "Diğer çiçek göletleri de kurtulamamış. Sefana şu an büyük telaş içinde olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733420106
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733420106,
					"content": "Bu Sefana dediğin Pari, çiçeklerle özenle ilgilenen iyi bir Pariye benziyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733420107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733420107,
					"content": "#Gidip ona yardım edelim mi {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733420108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733420108,
					"content": "Düşündüm de, büyük çabama uygun bir mola olarak sayabiliriz. Öyleyse Yasnapatim, bu Sunyata Çiçekleriyle ilgilenmeni istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733420109
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733420109,
					"content": "Görürsem söylerim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733420110
					]
				},
				{
					"id": 733420110,
					"content": "Evet! Bu güzel çiçekleri birlikte kurtaralım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
