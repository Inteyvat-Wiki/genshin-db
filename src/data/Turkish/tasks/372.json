			"dialogs": [
				{
					"id": 3720501,
					"content": "Ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720502,
					"content": "Senin... Gerçekten müthiş yeteneklerin var, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720503
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720503,
					"content": "Senin gibi birinin akıbeti bir ozanın dizelerine konu olmak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720504
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720504,
					"content": "Öyle parlak bir kahraman ki o, nasibini almalı ışıklardan. Ama karanlık gölgeler içinde, kaderi bir bıçağın keskinliğinde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720505
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720505,
					"content": "Maalesef, şu anda senin için bir beste yapacak zamanım yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720506
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720506,
					"content": "Neyse, Dvalin yenilmese bile hayatı hep sallantıda olacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720507
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720508,
					"content": "Dvalin için çok üzülüyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720509
					]
				},
				{
					"id": 3720511,
					"content": "Yardım edebileceğim herhangi bir şey var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720512
					]
				},
				{
					"id": 3720514,
					"content": "Bir şövalye olarak, ejderle yeniden yakınlaşmanı öneririm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720515
					]
				},
				{
					"id": 3720507,
					"content": "Öfkesinin alevleri saracak her yanını...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720508,
						3720511,
						3720514
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720509,
					"content": "Bunun için teşekkürler. Gözyaşı Kristalini arındırdığın için de.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720510
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720510,
					"content": "Ama takip etmek istediğim şeylerle ilgili kendi planlarım var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720517
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720512,
					"content": "Gözyaşı Kristalini arındırdığın için sana gerçekten çok teşekkür ederim. Bunun bana çok yardımı oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720513
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720513,
					"content": "Ama artık kendi planımı hayata geçirmeliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720517
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720515,
					"content": "Sence bu gerçekten şart mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720516
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720516,
					"content": "Bizim şimdilik teslim olmamıza gerek yok... Başka bir planım var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720517
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720517,
					"content": "Öyle mi? Nasıl bir planmış bu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720518,
					"content": "Bu gözyaşını görünce aklıma çok sevdiğim bir arkadaşım geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720519
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720519,
					"content": "Arkadaş mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720520,
					"content": "Evet, benim gitmem lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720521
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720521,
					"content": "Bir dakika! Nereye böyle aceleyle!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720522,
					"content": "\"Mondstadt Kahramanının Sembolü\"ne. Hoşça kal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720523
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3720524,
					"content": "Senin de deyiminle bu \"çatlak\". Ona dikkat etsek iyi olacak...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720525
					]
				},
				{
					"id": 3720523,
					"content": "#Of... {NICKNAME}, sen bundan ne anladın şimdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720526,
					"content": "Biliyor musun..?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720527
					]
				},
				{
					"id": 3720525,
					"content": "Ona göre sen de çatlaksın, unutma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3720528,
					"content": "Sesi tanıdık geliyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3720527,
					"content": "Neyi biliyor muyum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720528
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}