			"dialogs": [
				{
					"id": 230220101,
					"content": "Buradaki dayanıklılığı artırırsak şey yapmamız gerekecek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220102
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220102,
					"content": "Bu tasarımda ısrar edersen sonuç bir öncekinden pek farklı olmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220103
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230220103,
					"content": "Hâlâ gemi tasarımı üzerinde mi çalışıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230220104
					]
				},
				{
					"id": 230220104,
					"content": "Ah, senmişsin Gezgin. Evet, önceki denememizin üstüne Qishan ile ben tasarımın bazı önemli noktaları üzerine biraz... Tartıştık diyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220105
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220105,
					"content": "Biraz... Fikir alışverişi yaptık, şimdi de yeni bir tasarım üzerinde anlaşmaya çalışıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220106
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220106,
					"content": "Ama kullanılacak malzemeler konusunda aramızda hâlâ fikir ayrılığı var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220107
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220107,
					"content": "Ama bu kez Qishan'ın tavsiyesini dinledim! Bir sürü sağlam malzeme aldım. Gerçi bana bir servete mal oldu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220108
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220108,
					"content": "Gördüğün üzere ben bunları tek başıma taşıyamam Gezgin. Qishan da yeterince güçlü değil, rica etsem sen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220109,
						230220110
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220109,
					"content": "Beraber yaparız.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230220111
					]
				},
				{
					"id": 230220111,
					"content": "Sana güvenebileceğimi biliyordum! Hadi başlayalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220112
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220112,
					"content": "Qishan malzemeleri kendi elleriyle seçti. Bence bu kez sorun çıkmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220113
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220113,
					"content": "Ayrıca bu kez senin için daha büyük ödüllerim var. Yardımların için teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220110,
					"content": "Pekala, hadi bu işi halledelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230220111
					]
				}
			]
		},
