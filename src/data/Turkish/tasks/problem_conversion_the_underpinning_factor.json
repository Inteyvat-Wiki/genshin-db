					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220502,
					"content": "Qishan'ın seçtiği malzemeler çok hafif... Gerçekten işe yarayacaklarından emin miyiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220503
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220503,
					"content": "Bana güven. Senin daha önce seçtiklerinden daha çok işe yarayacaklar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220504
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230220504,
					"content": "Sanırım bu sefer sen bana can yeleği hazırlayacaksın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220505
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230220505,
					"content": "Sen bana biraz güvensene... Bunlar yeterli olacak.",
					"roleType": "TALK_ROLE_NPC",
