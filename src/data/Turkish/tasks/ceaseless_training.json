			},
			"dialogs": [
				{
					"id": 220310301,
					"content": "Dikkatin dağınık gibiydi. Adımların yanlıştı ve dengesiz bir şekilde saldırıyordun, bazen güçlü bazen güçsüz vuruyordun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310302
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310302,
					"content": "Böyle çalışamayız, lütfen kendini hazır hissettiğinde tekrar gel, o zaman deneyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				}
			]
		},
