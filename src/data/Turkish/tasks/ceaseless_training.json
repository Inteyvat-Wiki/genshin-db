			"dialogs": [
				{
					"id": 220310401,
					"content": "*nefes nefese kalır* Kesinlikle benden çok daha beceriklisin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310402
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310402,
					"content": "Bir dahaki sefer üstüne bu kadar gitmemeye çalışırım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310403
					]
				},
				{
					"id": 220310403,
					"content": "Asla olmaz! Tüm gücünle saldırman gerek yoksa kendimi geliştiremem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310404
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310404,
					"content": "Gücüne bakacak olursak kendini çok uzun süredir eğitiyor olmalısın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310405
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310405,
					"content": "Açık sözlülüğümün kusuruna bakma ama kendini nasıl eğittiğini gerçekten merak ediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310406,
						220310408
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310406,
					"content": "Uçmayı dev bir ejderha sayesinde öğrenmiştim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310407
					]
				},
				{
					"id": 220310407,
					"content": "Sen bir ejderha ile birlikte mi uçtun? İnanılır gibi değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310410
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310410,
					"content": "Büyütülecek bir şey değildi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310411
					]
				},
				{
					"id": 220310411,
					"content": "Hahaha, öyle mi? O halde doğuştan yetenekli olmalısın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310412
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310412,
					"content": "Benimle dövüştüğün için teşekkür ederim. Bana öğrettiklerini asla unutmayacağım. Lütfen bunları kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310408,
					"content": "Dövüş becerilerimi şanlı bir kurt sayesinde geliştirmiştim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310409
					]
				},
				{
					"id": 220310409,
					"content": "Gerçekten çok cesur olmalısın. Keşke seni o şanlı kurtla dövüşürken görebilseydim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310410
					],
					"speakerTitle": "Asakura"
				}
			]
		},
