			"dialogs": [
				{
					"id": 220310101,
					"content": "Mızrağını düz tut, hah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310102
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310102,
					"content": "Bir kez daha dövüşmeye geldim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310103
					]
				},
				{
					"id": 220310103,
					"content": "Ah, sensin! Görevimi yine sen mi aldın? İşte bu çok iyi oldu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310104
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310104,
					"content": "Senin gibi dişli biriyle antrenman yapmak benim için paha biçilemez bir lütuf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310105,
						220310110
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310105,
					"content": "Mızrak becerilerin oldukça gelişmiş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310106
					]
				},
				{
					"id": 220310106,
					"content": "Haha, beni şımartıyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310107
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310107,
					"content": "Duyduğuma göre mızrağın icat edilmesinin sebeplerinden biri, benim gibi silah tutmayı bilmeyenlerin de kolaylıkla savaşmasını sağlayabilmekmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310108
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310108,
					"content": "Sonuçta bu uzun ve keskin bir silah. Kullanan kişi nasıl kullanıldığını bilmese bile öylece sallayıp birilerine saplayarak iş görebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310109
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310109,
					"content": "Tabii bu mantıkla ilerleyecek olursak üç sivri uçlu bahçe çapasının çok daha güçlü olduğunu düşünüyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310110,
					"content": "Silahını daha geri almadın mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310111
					]
				},
				{
					"id": 220310111,
					"content": "Evet, geri aldım ama bu, eğitimimin bittiği anlamına gelmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310112
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310112,
					"content": "Kairagi ile daha önce çarpışmış olsam da bu, gelecekte daha güçlü düşmanlarla yüzleşmem gerekebileceği gerçeğini değiştirmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310113
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220310113,
					"content": "Bir samuray olarak bir daha asla silahımın düşman eline geçmesine ve şerefime leke sürülmesine izin veremem. Kendimi bu samuraylık davasına adamak istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				}
			]
		},
