				{
					"id": 721402301,
					"content": "#Selam {NICKNAME}, seni tekrar görmeyi beklemiyordum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402302
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402302,
					"content": "Epeydir görüşemiyoruz! Yashiori Adası'nın dışında hayat nasıl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721402303,
					"content": "Memleketimden çok daha zengin bir yaşam var diyebilirim. Çok güzel yiyecekler ve yapılacak bir sürü eğlenceli şey var ama... Çok da beğendiğimi söyleyemem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402304
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402304,
					"content": "Öyle mi? Neden ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721402305,
					"content": "Buradaki tüm insanlarda eksik bir şey var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402306
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402306,
					"content": "Yashiori Adası'nda yaşarken Ekselansları bizden uzakta olsa da varlığı içimizi rahatlatıyordu... Nerede olduğu önemli değildi; başımızda bizi izlediğine, koruduğuna, yaşantımızı düzene soktuğuna ve nasıl insanlar olmamız gerektiği konusunda bize rehberlik ettiğine inanıyorduk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402307
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402307,
					"content": "Ama Ekselansları burada her şeye müdahale edip baskı uyguluyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402308
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402308,
					"content": "*iç çeker* Nasıl söylesem bilmiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402309
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402310,
					"content": "Hâlâ uğraşıyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721402311
					]
				},
				{
					"id": 721402309,
					"content": "Bu arada, annemle ilgili herhangi bir bilgiye ulaşabildin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402310
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402311,
					"content": "Sorun değil. Bir şey bulursanız haber verin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chouji"
				}
