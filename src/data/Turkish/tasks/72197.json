			},
			"dialogs": [
				{
					"id": 721401901,
					"content": "Bu kadar Kristal Özü yeter. Şimdi macerama başlama zamanı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401902
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401903,
					"content": "Kendine iyi bak!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401905
					]
				},
				{
					"id": 721401904,
					"content": "Beni haberdar etmeyi unutma!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401905
					]
				},
				{
					"id": 721401902,
					"content": "Paimon bu çocuk için endişelenmeden edemiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401903,
						721401904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401905,
					"content": "Tabii ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401906
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401906,
					"content": "Chouji, ileri geri konuşmayı bırak artık! Bizimle karşılaştığına şükretmelisin... Aksi takdirde dayağı yiyecektin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401907,
					"content": "Ayrıca kötü adamlar senden bilgi almak istiyorsa gerçeği söylememelisin! Bir hikaye falan uydur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401909,
					"content": "Paimon dırdırcı neneye dönüşüyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401910
					]
				},
				{
					"id": 721401908,
					"content": "Bir de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401911,
					"content": "Ben ona güveniyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401912
					]
				},
				{
					"id": 721401910,
					"content": "Böyle küçük bir çocuğun kendi başına maceraya çıktığını kim görse endişelenir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401912,
					"content": "Tabii güveniyorsundur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401913,
					"content": "Hahahaha! Teşekkür ederim! İkinize de teşekkür ederim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401914
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401914,
					"content": "Umarım tekrar karşılaşırız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401915
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401915,
					"content": "Paimon'a söz ver, kendine iyi bakacaksın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401916
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401916,
					"content": "Sorun yok, dikkat ederim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401917
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401917,
					"content": "Şimdi Tatarasuna'ya gideceğim, annem eskiden orada çalışıyordu. Belki birileri oraya uğrayıp uğramadığını söyler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401918
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401918,
					"content": "Sonra da... Narukami Adası'na gidip bir tüccar gemisiyle Snezhnaya'ya gitmeye çalışacağım. Sonra ne olacağını göreceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401919
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401920,
					"content": "Neden bahsettiğinin farkında mısın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401922
					]
				},
				{
					"id": 721401921,
					"content": "Aldığın riskleri anlıyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401922
					]
				},
				{
					"id": 721401919,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401920,
						721401921
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401922,
					"content": "Sırf risklerini bildiği için kimse maceraya çıkmasa... Dünyada hiç maceracı olmazdı değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401923
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401924,
					"content": "Tamam o zaman...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401926
					]
				},
				{
					"id": 721401925,
					"content": "Dikkatli ol yeter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401926
					]
				},
				{
					"id": 721401923,
					"content": "Öf, bu çocuk çoook sinir bozucu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401924,
						721401925
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401926,
					"content": "Ha ha ha, benim için endişelenme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401927
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401927,
					"content": "#Kendinize dikkat edin! Bu arada {NICKNAME}, umarım sen de yakında aileni bulursun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401928
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401928,
					"content": "Teşekkür ederim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
