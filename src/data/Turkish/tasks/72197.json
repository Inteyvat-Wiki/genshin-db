					"nextDialogs": [
						721402003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721402005,
					"content": "Böyle diyecektin değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721402006
					]
				},
				{
					"id": 721402004,
					"content": "\"Paimon'un kristallere hemen ihtiyacı var, ühü ühü...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721402007,
					"content": "Seyahatlerin nasıl gidiyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721402008
					]
				},
				{
					"id": 721402006,
					"content": "Hahaha, elbette hayır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402007
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402008,
					"content": "Güzel ama hâlâ annemin izini bulamadım...",
