					"nextDialogs": [
						721402009
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721402010,
					"content": "Elimizden geleni yapacağız.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721402011
					]
				},
				{
					"id": 721402009,
					"content": "#Sorun değil. Biz sana yardım ederiz. Değil mi {NICKNAME}?",
