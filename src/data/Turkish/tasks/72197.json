			},
			"dialogs": [
				{
					"id": 721401701,
					"content": "#Selam {NICKNAME}! Nasılsınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401702
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401703,
					"content": "Onu ben söyleyecektim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401704
					]
				},
				{
					"id": 721401702,
					"content": "Paimon gayet iyi, sen nasılsın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401705,
					"content": "Paimon fazladan bir yemeğe var mısın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401706
					]
				},
				{
					"id": 721401704,
					"content": "Haha, senden daha hızlıyım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401707,
					"content": "Beni yanlış anladın. Yemeği sen hazırla diye demiştim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401708
					]
				},
				{
					"id": 721401706,
					"content": "Tabii. Paimon her zaman fazladan bir yemeğe açtır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401708,
					"content": "Hiç komik değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401709,
					"content": "Hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401710
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401710,
					"content": "Tamam, tamam, kavga etmeyi bırakın lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401711
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401712,
					"content": "İste tabii. Bu sefer ne istiyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401714
					]
				},
				{
					"id": 721401713,
					"content": "Ne yapabileceğime bir bakarım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401714
					]
				},
				{
					"id": 721401711,
					"content": "Gayet iyiyim fakat senden bir iyilik daha isteyecektim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401712,
						721401713
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401714,
					"content": "#Çok özel bir şey istemeyeceğim. Bana sadece biraz daha kristal getirir misin diyecektim {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401715
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401716,
					"content": "Sana güveniyorum ama...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401717
					]
				},
				{
					"id": 721401715,
					"content": "Emeğinin karşılığını vereceğime emin olabilirsin... Bana güven yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401716
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401718,
					"content": "Neden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401720
					]
				},
				{
					"id": 721401719,
					"content": "Bana bir açıklama yapacağına dair söz vermiştin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401720
					]
				},
				{
					"id": 721401717,
					"content": "Ama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401718,
						721401719
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401720,
					"content": "Aynen. Neden bu kadar çok Kristal Özüne ihtiyacının olduğunu hâlâ söylemedin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401721
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401722,
					"content": "Ancak bütün kristal pazarını Şogunluk kontrol ediyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401724
					]
				},
				{
					"id": 721401723,
					"content": "Bu kristalleri satmak hiç de kolay değil, biliyorsun değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401724
					]
				},
				{
					"id": 721401721,
					"content": "Annemi aramaya çıkmak için paraya ihtiyacım var, o nedenle kristalleri satıp para kazanmaya çalışıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401722,
						721401723
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401725,
					"content": "Ateşle oynuyorsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401727
					]
				},
				{
					"id": 721401726,
					"content": "Güvenliğinden endişe ediyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401727
					]
				},
				{
					"id": 721401724,
					"content": "Biliyorum ama bir yolunu bulacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401725,
						721401726
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401727,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401728
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401728,
					"content": "Biz arkadaş değil miyiz Chouji?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401729,
					"content": "Belki geçen seferki gibi sana yardım edebiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401731,
					"content": "Tam paralı asker mantığı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401732
					]
				},
				{
					"id": 721401730,
					"content": "Ayrıca bize ödül vereceğine söz vermiştin. Senin kazancını ve dolayısıyla ödülümüzü tehlikeye atan bir mesele varsa bilmek hakkımız değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401731
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401732,
					"content": "Pöh... Paimon yine de haklı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401733
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401733,
					"content": "Kristalleri sırf para için toplamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401734
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401734,
					"content": "Annemle babam, herkese olduğu gibi Tatarigami'den kaynaklanan hastalığa yakalansa ne olurdu diye düşünüyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401735
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401735,
					"content": "Belki bu kristallerle ilaç yapılabilir. Sonuçta bunlar dev sürüngenin kemiklerinden geliyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401736
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401736,
					"content": "Ayrıca Bayan Yasumoto bu kristallerin işe yarayabileceğini söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401737
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401737,
					"content": "Ama bunun doğru olduğundan emin olamazsın değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401738
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721401738,
					"content": "Olamam ama elimizde başka bir şey yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401739
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401739,
					"content": "Annemi bulduğumda... Ya da babamı, onları Sumeru'ya götüreceğim. İnsanlar orada bu tuhaf hastalığın tedavisi olduğunu söylüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401740
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401740,
					"content": "Ama oraya götürmeden önce de tedavi bulabileceğime dair umudumu yitirmemeliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401741
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401742,
					"content": "Sormana bile gerek yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401744
					]
				},
				{
					"id": 721401743,
					"content": "Umarım kristaller işine yarar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401744
					]
				},
				{
					"id": 721401741,
					"content": "Neyse, yeterince konuştum. Bana hâlâ yardım etmek istiyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401742,
						721401743
					],
					"speakerTitle": "Chouji"
				},
				{
					"id": 721401744,
					"content": "Teşekkür ederim, bunu unutmayacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chouji"
				}
			]
		},
