				"points": []
			},
			"dialogs": [
				{
					"id": 732100501,
					"content": "Hımm... Paimon burada ne tür hazine bulacağımızı merak ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100502,
					"content": "Raflar ince kitaplarla dolu. Bir göz gezdiriyorsun ve bunların aslında tıbbi kayıtlar ve finansal beyanların yer aldığı hastane kayıtları olduğunu anlıyorsun.\\nHayal kırıklığıyla kapıyı kapatıyorsun.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732100503
					]
				},
				{
					"id": 732100503,
					"content": "Paimon içeride özel bir hazinenin bizi beklediğini düşünmüştü... Maceralarımız sırasında karşılaştığımız tahta fıçı ve kutular bile bundan daha iyidir! En azından içlerinde lahana ve kuş eti vardı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100504,
					"content": "Bu da ne? Buradan düşmüşe benziyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100505,
					"content": "Paimon da bir baksın... Belki bizi hazineye götürür!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100507,
					"content": "Of... Eleazar çok korkunç bir şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100508,
					"content": "Hımm, diğer belgede ne yazıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100510,
					"content": "Hımm... Paimon hiçbir şey anlamadı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100511,
						732100513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100511,
					"content": "Ben de anlamadım açıkçası...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100512,
					"content": "Paimon sadece \"Tanrının sesi bana rehberlik ediyor\" lafını anladı... Bu, bize rehberlik edecek eşsiz seslerin olacağı anlamına mmı geliyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100515,
					"content": "Yer altındaki suyun akışı veya yaratık hareketliliği olabilir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732100516
					]
				},
				{
					"id": 732100516,
					"content": "Evet! Kim bilir, belki de yer altı harabeleri vardır! Sesleri daha dikkatli bir şekilde dinleyelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732100513,
					"content": "Dürüst olmak gerekirse bilmemek daha iyi olabilir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732100514
					]
				},
				{
					"id": 732100514,
					"content": "Ne? Sen anladın mı? Paimon sadece \"Tanrının sesi bana rehberlik ediyor\" lafını anladı... Bu, bize rehberlik edecek eşsiz seslerin olacağı anlamına mmı geliyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732100515
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
