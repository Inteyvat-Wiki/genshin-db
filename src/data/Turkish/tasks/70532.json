			"dialogs": [
				{
					"id": 705320101,
					"content": "Hımm... Bu kartı desteye eklemeli miyim? Ha? Daha kartım varmış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320102
					],
					"speakerTitle": "Frida"
				},
				{
					"id": 705320102,
					"content": "Merhaba Gezgin! Kusura bakma, kart destelerini düşünmekten geldiğini fark etmemişim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320103
					],
					"speakerTitle": "Frida"
				},
				{
					"id": 705320103,
					"content": "Ben Yakarışların Kralı Turnuvasının düzenlenmesine yardımcı olmak için Loncanın tuttuğu bir maceracıyım. Görevim, şey... Özel kuralları olan bir düello etkinliği düzenlemek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320104
					],
					"speakerTitle": "Frida"
				},
				{
					"id": 705320104,
					"content": "Buna \"Zamanın Yakarışı\" ismini verdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320105,
						705320106
					],
					"speakerTitle": "Frida"
				},
				{
					"id": 705320105,
					"content": "Normal düellolardan farkı nedir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705320107
					]
				},
				{
					"id": 705320107,
					"content": "Ah hayır, Zamanın Yakarışı kendi kuralları bulunan, resmi olmayan bir turnuva.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320108
					],
					"speakerTitle": "Frida"
				},
				{
					"id": 705320108,
					"content": "Zamanın Yakarışı düellolarında kendi oluşturduğun desteleri kullanamazsın. Bunun yerine önceden hazırlanan tamamlanmamış sekiz desteden üç tanesini seçerek bir deste oluşturursun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320109
					],
					"speakerTitle": "Frida"
				},
				{
					"id": 705320109,
					"content": "Bu üç deste içinde henüz yeni çıkan bazı kartlar da bulacaksın. Onların tüm gücünü ortaya çıkarman... Kart oyunundaki yeteneklerine bağlı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320110
					],
					"speakerTitle": "Frida"
				},
				{
					"id": 705320110,
					"content": "Diğer kuralların normal düellolardan farkı yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320111
					],
					"speakerTitle": "Frida"
				},
				{
					"id": 705320111,
					"content": "Desteni nasıl oluşturacağına dair bir fikrin yoksa sana her zaman yardımcı olabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320112
					],
					"speakerTitle": "Frida"
				},
				{
					"id": 705320112,
					"content": "Fakat destenin güzel olacağını garanti edemem, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320113
					],
					"speakerTitle": "Frida"
				},
				{
					"id": 705320113,
					"content": "Her neyse, kendi desteni oluşturmanı tavsiye ederim. Onu diğer oyuncularla düello yapmak için kullanacaksın ne de olsa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320114
					],
					"speakerTitle": "Frida"
				},
				{
					"id": 705320114,
					"content": "Yeteneklerine güveniyorsan Turnuvanın düzenlendiği diğer şehirlere gidip Zamanın Yakarışını deneyebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320115
					],
					"speakerTitle": "Frida"
				},
				{
					"id": 705320115,
					"content": "Bu arada rahat olabilirsin. Zamanın Yakarışı düellolarında sonuca bakmaksızın tüm katılımcılar ödül kazanır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320116
					],
					"speakerTitle": "Frida"
				},
				{
					"id": 705320116,
					"content": "İlgini çektiyse gelip mutlaka dene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Frida"
				},
				{
					"id": 705320106,
					"content": "Normal Turnuvadan pek farklı görünmüyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705320107
					]
				}
			]
		}
	]
