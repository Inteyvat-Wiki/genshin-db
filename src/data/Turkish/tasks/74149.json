			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Euphrasie"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741490101,
					"content": "Yeni bir iş var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490102
					]
				},
				{
					"id": 741490102,
					"content": "İş mi istiyorsunuz? Eh, İnsanlık Hikayelerindeki özel görevler sizin için çantada keklik olsa gerek tabii... Son zamanlarda Moraya mı sıkıştınız yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490103,
						741490105
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490103,
					"content": "Fazla Mora göz çıkarmaz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490104
					]
				},
				{
					"id": 741490104,
					"content": "Orası öyle, doğru söze ne denir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490107
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490107,
					"content": "Denizde kum biter, bizde iş bitmez. Hatta Maceracılar Loncasından sonraki en büyük iş dağıtım merkezi Buğukuş desem yeridir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490108
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490108,
					"content": "Şey, böyle diyorum tabii ama şu sosyal hizmet işleri bize kalmasa tadından yenmezdi doğrusu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490109
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490109,
					"content": "Neyse artık. Madem Moraya ihtiyacınız var, gelin ben size uzun vadeli bir iş önereyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490110
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490110,
					"content": "Bay Leroy yaklaşık altı ay önce bize bu notu bıraktı. Bu civarda yaşayan herkes onu iyi tanır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490111
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490111,
					"content": "Gençlik yıllarında adı kötüye çıkmış diyorlar ama son zamanlarda hakkında tatsız bir söylenti falan duymadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490112
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490112,
					"content": "Hayatının çoğunu yalnız geçirdi. Tek bir kızı var, o da artık yanında olmadığı için kimi kimsesi yok sayılır... Kendi yağıyla kavrulmak da bir yere kadar tabii, arada ona yardım edecek saatlik bir çalışana ihtiyacı oluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490113
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490113,
					"content": "Bildiğim kadarıyla hali vakti yerinde kendisinin, o yüzden vereceği ücret de iyi olacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490114
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490114,
					"content": "Maaşı güzel, tehlikeden ziyadesiyle uzak bir iş işte. Siz bunu bir düşünün derim ben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490115
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490115,
					"content": "Ona sadece ev işlerinde yardım edeceğiz yani, öyle mi? Hiç fena değilmiş aslında!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490116,
					"content": "Rica etsem evin adresini verir misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490117
					]
				},
				{
					"id": 741490117,
					"content": "Tabii. İlerleyip iki kez köşeden dönün, sonra da şeyin etrafından... Yok yok, böyle olmayacak. Ben size bir harita vereyim en iyisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490118
					],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490118,
					"content": "Tanışmanıza vesile olduğumu söylemeyi unutmayın sakın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Euphrasie"
				},
				{
					"id": 741490105,
					"content": "Sayılır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490106
					]
				},
				{
					"id": 741490106,
					"content": "Harıl harıl çalışıyoruz bakıyorum... Pekala, istediğiniz yeter ki iş olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490107
					],
					"speakerTitle": "Euphrasie"
				}
			]
		},
		{
			"id": 7414902,
			"completionStepIds": [
				7414902
