			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Benoit Leroy"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741490201,
					"content": "Athos'un gömleği 1.000 Mora... Morticia'nın kolyesi... Cık cık. Bu zamane gençleri de paraları saçıyor resmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490202
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490202,
					"content": "Merhaba Bay Leroy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490203
					]
				},
				{
					"id": 741490203,
					"content": "Selam! Bizi Euphrasie gönderdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490204,
					"content": "Bay Leroy'a neden burada olduğunuzu açıklıyorsunuz.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741490205
					]
				},
				{
					"id": 741490205,
					"content": "Haha, o ilanı vereli nereden baksan altı ay olmuştur herhalde. Euphrasie'nin bu görevi o kadar uzun süre elinde tutacağını düşünmemiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490206
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490206,
					"content": "Saatlik çalışacak birilerini tutmayı düşünmüştüm, doğru. Zaman en becerikli insanların bile saçına ak düşürüyor sonuçta... Bir gün bir bakmışsın, başkalarının yardımına muhtaçsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490207
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490207,
					"content": "Bu evi satın alabilmek için yıllarımı verdim ben ama... Paylaşacak kimsen olmayınca koskoca evde yapayalnız kalıyormuşsun, onu yaşlanınca anladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490208
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490208,
					"content": "Bu gerçeğin farkına varınca da uzun süre üzüntümden kahroldum... Neyse ki sonra kızım ve damadım bana bakmak için yanıma taşındılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490209
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490209,
					"content": "Hayırlı evlatlar işte. Birbirlerini çok seviyorlar, bana da arkadaşlık ediyorlar. Daha ne isteyeyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490210
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490210,
					"content": "Yani demem o ki artık birini işe almama gerek kalmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490211,
						741490212
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490211,
					"content": "E buraya boşu boşuna mı geldik yani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490213
					]
				},
				{
					"id": 741490213,
					"content": "Aman canım, ekşitmeyin suratınızı hemen. Gencecik insanlarsınız. Azıcık yüzünüz gülsün, hayat somurta somurta geçer mi hiç?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490214
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490214,
					"content": "Hem madem bunca yolu geldiniz ve Euphrasie sizi önerdi, size verebileceğim birkaç iş çıkar elbet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490215
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490215,
					"content": "Çocuklar şu an evde değil, ben de buradaki tüm işlere yetişemiyorum. Bana yardım ederseniz emeğinizin karşılığını alırsınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490216
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490216,
					"content": "Aa, süper! Harika birisiniz Bay Leroy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490217,
					"content": "Hahaha, şu tatlı dilliye bak sen! Nasıl da hemen iltifatları sıralıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490218
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490218,
					"content": "E hadi bakalım, kapının oradaki ve evin arkasındaki lekeleri temizlememe yardım edin o zaman. Gelmişken Nana'ya da biraz balık veriverin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490219
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490219,
					"content": "Doğru ya, söylemeyi unutuyordum az kalsın. Nana benim kedim olur. Şu kapının önünde duran var ya hani... Onun adına şimdiden teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490220
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490220,
					"content": "Kolay bir iş gibi. Sorun değil! Hemencecik hallederiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490212,
					"content": "Ah Euphrasie, ah...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490213
					]
				}
			]
		},
		{
			"id": 7414905,
			"completionStepIds": [
				7414905
