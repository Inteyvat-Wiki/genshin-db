			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Benoit Leroy"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741490501,
					"content": "Hallettiniz mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490502
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490502,
					"content": "Ne sandınız Bay Leroy! Bu arada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490503,
					"content": "Ne oldu bakalım? Şeker mi istiyorsunuz? Yoksa harçlığınızı mı isteyeceksiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490504
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490504,
					"content": "İkisine de hayır demeyiz, hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490505,
					"content": "Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490506
					]
				},
				{
					"id": 741490506,
					"content": "Haha, gözün doysun ufaklık! Neyse, sorun değil tabii. Küçük çocukların böyle olması lazım zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490507
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490507,
					"content": "Özellikle de senin gibi sevimli küçük hanımlar leziz makaronları, şirin elbiseleri ve güzel evlerde yaşamayı hak ediyor Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490508
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490508,
					"content": "#Hehe, lafı Paimon'un ağzından aldınız Bay Leroy! {NICKNAME}, acaba biz de şey mi alsak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490509,
					"content": "Olmaz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490510
					]
				},
				{
					"id": 741490510,
					"content": "Üff! Amma cimri çıktın sen de!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490511,
						741490512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490511,
					"content": "Biz maceracıyız Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490513
					]
				},
				{
					"id": 741490513,
					"content": "İyi de bunun makaron, elbise ve güzel, büyük bir ev almakla ne alakası var ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490514,
					"content": "Bak sen, hemen de didişmeye başladılar! Ah, bu çocuklar yok mu... Gerçi arada ufak tartışmalar olur böyle. Çocuksunuz daha, normaldir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490515,
						741490516
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490515,
					"content": "İyi ama ben aslında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490517
					]
				},
				{
					"id": 741490517,
					"content": "Çocukluğunuzu doya doya yaşayın, kıymetini bilin. Sonsuza dek sürmüyor zira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490518
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490518,
					"content": "Neyse. Buyurun, şekerinizi de paranızı da alın bakalım. Yaramazlık ettiğinizi görmeyeyim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490519
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490519,
					"content": "Yaşasın, gelsin abur cuburlar! Teşekkürler Bay Leroy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490520,
					"content": "Bana Benoit de evladım. Leroy benim soyadım olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490521
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490521,
					"content": "Koskoca Fontaine Şehri'nde tek Leroy ben kaldım. Ailemin ismini duyunca bu ihtiyar kalbimi bir hüzün kaplayıveriyor... O yüzden lütfen bana adımla hitap et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490522
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490522,
					"content": "Bay Le... Şey, Benoit... Kızın senin soyadını kullanmıyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490523,
					"content": "Morticia benim öz kızım değil. Kendisini altı ay önce evlat edindim. Tabii öz kızımmış gibi seviyorum onu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490524
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490524,
					"content": "Zahmet olmazsa yarın tekrar gelin... O ve Athos o zamana kadar dönmüş olurlar herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490525
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490525,
					"content": "Kızım sizin gibi iki sevimli çocuğu yemeğe çağırmaktan mutlu olur eminim. Ne de olsa evin türlü türlü işine koştunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490526
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490526,
					"content": "Ara sıra başka çocuklar da geliyor, isterseniz onlarla da oynayabilirsiniz. Çocukları çok severim ben, onlar uğrayınca eve bir canlılık geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490527
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490527,
					"content": "Tekrar geldiğinizde beni göremezseniz kapıyı çalıp beni sorun. Athos size kapıyı açar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490528
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490528,
					"content": "Tamamdır! Yarın tekrar geliriz o zaman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741490529,
					"content": "İyi edersiniz! Oldu o zaman, ben içeri gireyim artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490530
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490530,
					"content": "Yarın görüşürüz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490531
					]
				},
				{
					"id": 741490531,
					"content": "Görüşürüz çocuklar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490516,
					"content": "Biz de böyle anlaşıyoruz işte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490517
					]
				},
				{
					"id": 741490512,
					"content": "Neden yolculuğa çıktığımızı ne çabuk unuttun Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490513
					]
				}
			]
		},
