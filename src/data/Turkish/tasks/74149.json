				{
					"id": 741490701,
					"content": "Yapmanızı istediğim şeyi unuttunuz mu yoksa? Haha, şu çocukların balık hafızası yok mu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490702
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741490702,
					"content": "Önce kapının orayı ve evin arkasını temizlemenizi istemiştim. Sonra da kedim Nana'ya biraz balık vermeniz lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
