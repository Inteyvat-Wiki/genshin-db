			"dialogs": [
				{
					"id": 740730601,
					"content": "Taş oluşumu. Böbrek taşı falan gibi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740730602
					]
				},
				{
					"id": 740730602,
					"content": "Ateş onu yok edemez, ayrıca organlarımız ve dokularımızın içinde kalır, doğru... Ama bir anda da oluşmaz, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740730603,
					"content": "Aa, doğru diyorsun! Sence ne o zaman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
