					"nextDialogs": [
						740730702
					]
				},
				{
					"id": 740730702,
					"content": "Aa, gölge gerçekten doğru cevap galiba! Hayatımız boyunca yanımızdadır ve ateşle de yanmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740730703,
					"content": "Ama zaten çözülmüş bir bilmecenin cevabını neden bulmaya çalıştık ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
