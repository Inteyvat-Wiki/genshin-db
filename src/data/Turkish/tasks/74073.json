				},
				{
					"id": 740732302,
					"content": "Buradakini de mi biri gelip almış?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740732303,
					"content": "Öyle görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732304
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740732304,
					"content": "Bu kim olabilir ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740732305
					]
				},
				{
					"id": 740732305,
					"content": "Jakob.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732306
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740732306,
					"content": "Onunla bir kere Elynas'ta savaşmıştık. Düzeltme: \"Bir kere\" değil, \"daha önce\" olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732307
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740732307,
					"content": "Kapıdaki talihsiz kurbanları görünce bunun onun işi olduğunu anlamıştım. Demek hâlâ iş başında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732308
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740732308,
					"content": "Peki burada topladığı şeylerle ne yapmayı planlıyor olabilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740732309,
					"content": "Oldukça basit. O da Nergis Haçı'nın Kutsal Kılıcını yeniden dövmek istiyor. Derneğin hayali hâlâ gerçekleşmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732310
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740732310,
					"content": "Neyse, şimdi son bölgeye gitmemiz lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tırtıl"
				}
			]
		},
