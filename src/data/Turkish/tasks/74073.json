			"dialogs": [
				{
					"id": 740730101,
					"content": "Ateş hâlâ yanıyor. Bir dakika, neden burada kamp ateşi var ki? Burası sadece bir harabe değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740730102,
					"content": "Taş tablette ne yazdığına bir bakayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730103
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740730103,
					"content": "\"Burası Hatıralar Bölgesi, Hatıralar Salonu ve Hatıralar Odasıdır.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730104
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740730104,
					"content": "\"Bir anda doğar\"... \"Çelişkili de olsa sana ebedi istirahatinde eşlik eder, hiç ayrılmaz\"... \"Ateşte yanmaz\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730105
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740730105,
					"content": "Bilmeceler demek. Kadim Fontaine halkı bilmeceleri çok severdi ve Nergis Haçı Derneği de hakeza öyle. Sırf eski şeyler diye mi ilgileniyorlardı yoksa gerçekten bilmeceleri ilginç mi buluyorlardı bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730106
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740730106,
					"content": "Hepsiyle ilgili anahtar kelimeleri arattım ama cevap bulamadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730107
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740730107,
					"content": "Ama bu bilmece çoktan çözülmüş. Belki de cevabın kamp ateşiyle bir ilgisi vardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730108
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740730108,
					"content": "Çoktan çözülmüş bilmeceler üzerine tekrar düşünmenin bir anlamı var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730109
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740730109,
					"content": "Var tabii. İkimizin de şu anki durumumuza rağmen geçmişte neler yaşandığını araştırmamız gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730110
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740730110,
					"content": "Doğru diyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730111
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740730111,
					"content": "#Sence cevap ne Şövalye {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ann"
				}
			]
		},
