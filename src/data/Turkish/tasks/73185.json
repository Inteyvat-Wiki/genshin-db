			"dialogs": [
				{
					"id": 731850501,
					"content": "Bu... Biraz huysuz görünüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850502,
					"content": "Vay canına... Toynaklarına baksana. Ne kadar da sertler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850503,
					"content": "Tek bir tekmesi bile insanı bayıltmaya yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850504,
					"content": "Onu besleyebilirsin Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850505
					]
				},
				{
					"id": 731850505,
					"content": "Hayır! Sen yap! Acele et!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850506,
						731850507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850506,
					"content": "Afiyet olsun...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850508
					]
				},
				{
					"id": 731850507,
					"content": "Toynakların hakkında kötü bir şey demek istemedim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731850516
					]
				},
				{
					"id": 731850510,
					"content": "Yük Hayvanı yemeğini sakince yer ve artık daha sakin görünür...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731850511
					]
				},
				{
					"id": 731850508,
					"content": "Huysuzluğu biraz geçti sanki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850509,
					"content": "Hadi onu geri götürelim. Dikkat et de çifte yeme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731850511,
					"content": "Yük Hayvanıyla Elber'in yanına dönüyorsunuz...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731850512
					]
				},
				{
					"id": 731850512,
					"content": "Oh... Kaçıp gitti sanmıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850513
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850513,
					"content": "Teşekkür ederim Gezgin. Sana ne kadar teşekkür etsem az.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850514
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850514,
					"content": "Durumu nasılmış bir bakayım. Umarım yaralanmamıştır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850515
					],
					"speakerTitle": "Elber"
				},
				{
					"id": 731850515,
					"content": "Gezgin, lütfen diğer Yük Hayvanını da bulmama yardım et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731850516
					],
					"speakerTitle": "Elber"
				}
			]
