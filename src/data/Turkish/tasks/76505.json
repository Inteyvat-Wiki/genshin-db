			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Varesa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765050101,
					"content": "#{NICKNAME}? Paimon? Bu ne tesadüf! Nod-Krai'a gittiğinizi duymuştum ama bu kadar çabuk karşılaşmayı hiç beklemiyordum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050102
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050102,
					"content": "Evet! Paimon da bir an hayal gördüğünü sandı! Evden bu kadar uzakta ne yapıyorsun Varesa? Seyahate mi çıktın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765050103,
					"content": "Hehe, onun gibi bir şey! Buraya bahçemiz için tarım makinaları almaya geldim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050104
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050104,
					"content": "Babam Nod-Krai'da meyvelerimizi daha iyi ve daha rahat büyütmemizi sağlayabilecek makinalar olduğunu söyledi. Böylece ben de biraz daha fazla uyuyabilir... Ve tabii ki daha fazla idman yapabilirim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050105
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050105,
					"content": "Buraya gelince de Natlan'da bulamayacağın bir sürü lezzetli yemek keşfettim! İş dışındaki tüm vaktimi kendime ziyafet çekerek geçiriyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050106
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050106,
					"content": "... Açıkçası, geri dönme vakti geldiği için biraz üzgünüm. Gitmek istemiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050107
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050107,
					"content": "Vaktim varken biraz daha etrafı gezip, denemediğim her şeyi deneyecek ve görmediğim her şeyi göreceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050108
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050108,
					"content": "#Sen nasılsın? Dur tahmin edeyim... Kahramanımız {NICKNAME}, yeni bir ulusta adalet için savaşıyor. Öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050109,
						765050110
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050109,
					"content": "Şimdilik öylesine etrafa bakınıyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050111
					]
				},
				{
					"id": 765050111,
					"content": "Aa, evet bana da öyle oluyor! Yeni bir yere gidince görülecek sayısız yeni şey oluyor. Her şeyi Kameraya çekmek istiyorsun, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050112
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050112,
					"content": "Aslında... Tabii ya! Benim de yediğim muhteşem yemeklerin fotoğraflarını çekmem lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050113
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050113,
					"content": "Böylelikle eve döndüğümde fotoğrafları Atolli Amca'ya verip aynı yemekleri yapmasını sağlayabilirim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050114
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050114,
					"content": "Kim bilir, belki de kaderinde yemek fotoğrafçısı olmak vardır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050115
					]
				},
				{
					"id": 765050115,
					"content": "Hehe, öyle mi dersin? Ben ve yemek fotoğrafçılığı... Şahane olurdu aslında! Her gün güzel yemeklerle karşılaşıp onların en güzel ve ağız sulandırıcı fotoğraflarını çekmek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050116,
						765050117
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050116,
					"content": "Leziz yemeklerden önce...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050118
					]
				},
				{
					"id": 765050118,
					"content": "Hı? Benim mi fotoğrafımı çekmek istiyorsun? Gerçekten mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050119
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050119,
					"content": "B-Bir saniye. Saçım düzgün mü? Ağzımda yemek kalmış mı? Ah, seninle karşılaşacağımı bilsem dün pazardan aldığım aksesuarlardan takardım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050120,
						765050121
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050120,
					"content": "Şu an harika görünüyorsun!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050122
					]
				},
				{
					"id": 765050122,
					"content": "T-Tamam! Sana bırakıyorum o zaman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varesa"
				},
				{
					"id": 765050121,
					"content": "Gülümseyen yüzün, fotoğraf için fazlasıyla yeterli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050122
					]
				},
				{
					"id": 765050117,
					"content": "Senin fotoğrafını çekebilir miyiz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050118
					]
				},
				{
					"id": 765050110,
					"content": "Bir yandan da fotoğraf çekmek için malzeme arıyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050111
					]
				}
			]
		},
