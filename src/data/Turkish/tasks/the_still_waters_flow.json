						"rawParams": [
							"7223302",
							"3"
						],
						"stepId": 7223302,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7223303",
							"2"
						],
						"stepId": 7223303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tsuyuko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722330201,
					"content": "Buna \"Anahtar Mührü\" diyoruz. Bir zamanlar Enkanomiya'nın her yanında kullanılan bir armaydı. Yalnızca yol açılmak üzereyken yüzeye çıkar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330202
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330202,
					"content": "Bunun Enkanomiya uykusundan uyandığında Watatsumi Adası halkına gönderilen ikinci anahtar seti olduğu söylenir. Kayıtlarımız da toplamda beş tür Anahtar Mührü olduğunu gösteriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330203
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330203,
					"content": "Şu anda Watatsumi Adası'ndaki beş Anahtar Mühründen üçünü bulduk. Daha sonra onları uygun yerlerine geri götürerek mührü kaldırabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330204
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330204,
					"content": "Bulduğumuz üç Anahtar Mührünü anahtar deliklerinden çıkardık ve Watatsumi Adası'nın farklı konumlarına yerleştirdik. Bu şekilde bariyer eski haline dönecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330205
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330205,
					"content": "Elbette bunun amacı çocukların, Fatui casuslarının, Narukami Adası sakinlerinin veya yabancıların izinsiz girmelerini önlemekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330206
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330206,
					"content": "Ama endişelenme, sen \"yabancılar\" kategorisinde değilsin. Hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330207
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330207,
					"content": "Şu anda Maceracılar Loncası ile temasa geçemiyoruz. O nedenle, maceracıların da girmesi yasak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330208
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330208,
					"content": "Maceracıların girmesine hiç izin verdiğiniz oldu mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330209,
					"content": "Bu tür tarihi kayıtlara rastlamadık. Gördüğün üzere her iki taraf için de kazançlı bir anlaşmaya varmaya çalışıyorduk. Senin gibi keşif yapmakta kabiliyetli insanlar bulundurmak her zaman iyidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330210
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330210,
					"content": "Oo, o zaman bu sefer kimse önümüze geçmedi mi demek oluyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330211,
					"content": "Hey Paimon, terbiyeni takın...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330212
					]
				},
				{
					"id": 722330212,
					"content": "Nasıl anlatsam? Bariyeri geçici olarak yeniden oluşturma sürecinin tamamen sorunsuz geçtiğini sanmıyorum. Anahtar Mühürlerinin yerlerini araştırmamızla onları anahtar deliklerinden çıkarmamız arasında bir hayli süre geçti. Bazı sıçanlar bu sırada girmeyi başarmış olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330213
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330213,
					"content": "Sonuçta yeterli insanımız yok. Kısacası Fatui, Hazine Avcıları, Kairagi veya arkadaşlarıyla karşılaşırsan onlara derslerini vermekten çekinme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330214
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330214,
					"content": "Bir dakika. Onlar bu kadar kolay girdiyse biz neden şu şeyi aldık? Mehtaplı Keklerin bir şeyi miydi neydi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330215,
					"content": "Enkanomiya yalnızca Mehtaplı Derinliklerin Anahtarını alırsak uyanır. Benzer şekilde sadece bu Anahtar Enkanomiya'daki imtihan sistemini etkinleştirebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330216
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330216,
					"content": "Watatsumi Goryou Töreninin dışında Enkanomiya'ya giren varsa da... Belki buraya girmenin başka şeytani ve dolambaçlı yolları olabilir. Kim bilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330217
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330217,
					"content": "Her halükarda lütfen adadaki diğer Anahtar Mühürlerini de en kısa zamanda toplayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330218
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330218,
					"content": "Anahtar Mühürleri, Watatsumi'nin Yüzgecine ve Kalbine yerleştirildi. Bunların sunakları ise herhangi bir tapınağı Sangonomiya Tapınağına bağlayan çizginin, Mehtaplı Derinlikleri çevreleyen ikinci dağ duvarıyla kesiştiği noktada bulunabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330219
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330219,
					"content": "Pekala. Aynı yerde haberlerinizi bekleyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				}
			]
		},
