				"points": []
			},
			"dialogs": [
				{
					"id": 722330101,
					"content": "#Merhaba {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330102
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330102,
					"content": "Selam Tsuyuko. O mercan zamazingosunu ortadan kaldırma hazırlıkları nasıl gidiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330103,
					"content": "Ne yazık ki çalışmalarımız sırasında... Sıkıntılarla karşılaştık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330104
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330104,
					"content": "Biliyor musun Tsuyuko? İstediğin kadar üzgün bir yüz ifadesi takın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330105,
					"content": "Ama bize böyle anlamlı bir şekilde bakarak kimseyi ikna edemezsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330106,
					"content": "Anlıyorum. Demek sen de durumumuzun ciddiyetini fark ettin. Artık bunu saklamayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330107
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330107,
					"content": "Hiç saklamıyordun ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330108,
					"content": "Evet, Mehtaplı Derinliklerin Anahtarını elde ettik. Enkanomiya da yavaşça uykusundan uyanmaya başlıyor. Ancak bunun için yeterli insanımız yok. Bu nedenle araştırmalarımız çok yavaş ilerliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330109
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330109,
					"content": "Neticede olağanüstü sıkıntılı zamanlardan geçiyoruz. Narukami Adası ile ilişkilerin gerçekten düzeleceğinden emin değiliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330110
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330110,
					"content": "Yalnızca iki elim olduğunu biliyorsun, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330111
					]
				},
				{
					"id": 722330111,
					"content": "Neyse, bu başka bir konu. Geleneklere göre mercanın elde edilmesinde bir \"kahraman\" hayati rol oynayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330112
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330112,
					"content": "Bir üs kurmalı ve kahramana atalarımızın yollarını izleyerek imtihandan geçmesinde yardımcı olmalıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330113
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330113,
					"content": "Bu sayede zafere emin adımlarla gideceğiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330114
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330114,
					"content": "Yani planınız buydu ama yeterli insanınız olmadığından bunu yapamıyorsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330115,
					"content": "Aynen öyle. Zaten en önemli karakter olan bu \"kahraman\"ın ne saçını ne de sakalını gördük.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330116
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330116,
					"content": "Ancak şimdi görür gibiyim. Kahramanımızın saçı... Evet, kahramanımız sarı saçlı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330117
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330117,
					"content": "Of, bu iş çok sıkıntılı olacak gibi. Paimon bu yolculuğa çıkmanın çok iyi bir fikir olduğunu düşünmüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330118,
					"content": "Ama bu keşif sırasında nadir hazineler bulabilirsin. Tabii bu tür şeylerin genellikle Sangonomiya Klanına verilmesi gerekir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330119
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330119,
					"content": "Fakat bir şey bulursan neden olmasın? Bu seferlik göz ardı edebiliriz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330120,
						722330121
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330120,
					"content": "Kulak ardı da ederseniz sevinirim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330122
					]
				},
				{
					"id": 722330122,
					"content": "Kahramanımız, cesur savaşçımız, kudret abidemiz, kurtarıcımız! Bu, kabul ettiğin anlamına mı geliyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330123
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330123,
					"content": "Ne yapalım? Sangonomiya'yı bu kriz zamanında yalnız bırakacak değiliz ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330124,
					"content": "Harika! Madam Kokomi'nin tavsiye ettiği yöntemler oldukça ikna edici olmuşa benziyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330125
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330125,
					"content": "Beni bulmak için döneceğini bile öngördü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330126
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330126,
					"content": "Bir saniye, ne dedin sen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330127,
					"content": "Yok bir şey. O halde lütfen benimle gel. Sana bir şey göstermek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330128
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330128,
					"content": "Önümüzdeki bölgede yer alan sunakta buluşalım. Göremezsen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330129
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330129,
					"content": "Ya göremezsek?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330130,
					"content": "O zaman güneydoğu yönüne bak ve gözlerini kıs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330121,
					"content": "Biliyor musun? Madam Kokomi ile aramız bayağı iyi aslında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330122
					]
				}
			]
		},
		{
			"id": 7223302,
			"completionStepIds": [
				7223303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
