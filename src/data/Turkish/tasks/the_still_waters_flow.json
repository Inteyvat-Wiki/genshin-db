				},
				{
					"id": 722330502,
					"content": "Byakuyakoku hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330503
					]
				},
				{
					"id": 722330503,
					"content": "Enkanomiya'nın adı bir zamanlar Byakuyakoku'ydu. Yer altı diyarında ne güneş ne de ay vardı. O zamanlar sadece Beyaz Gece ve Ebedi Gece adlı iki gök olayı meydana gelirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330504
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330504,
					"content": "Atalarımdan birisi Eboshi adlı bir tapınak görevlisiydi. Byakuyakoku tarihinde önemli bir role sahipti. Watatsumi Goryou Töreninden sorumlu olmamın sebebi de oydu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				}
			]
		}
	]
