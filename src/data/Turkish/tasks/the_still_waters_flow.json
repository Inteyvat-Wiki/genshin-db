			"dialogs": [
				{
					"id": 722330401,
					"content": "#Bana sormak istediğin başka bir soru var mı {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330402,
						722330406
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330402,
					"content": "Anahtar Mühürleri hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330403
					]
				},
				{
					"id": 722330403,
					"content": "Anahtar Mühürlerini Watatsumi'nin Kalbine ve Yüzgecine yerleştirdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330404
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330404,
					"content": "Dürüst olmak gerekirse mesafe ve gizlilik arasında dengeyi bulmaya çalıştık. Bu iki tapınağı da yeterince iyi gizlenmiş yerler olduğu için seçtik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330405
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330405,
					"content": "Elimizden geleni yaptık. Gerçekten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330406,
					"content": "Sunakları nerede bulabilirim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722330407
					]
				},
				{
					"id": 722330407,
					"content": "Sunaklar kuzeyde ve doğuda yer alıyorlar. Onları Mehtaplı Derinlikleri çevreleyen ikinci dağ duvarı kıyısında bulabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330408
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330408,
					"content": "Sangonomiya Tapınağı ile Watatsumi'nin Kalbi ve Yüzgeci arasında iki çizgi çizdikten sonra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330409
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330409,
					"content": "Bu çizgileri dağ duvarının oluşturduğu kavis boyunca izlersen iki konum elde edersin. İşte sunaklar burada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				}
			]
		},
