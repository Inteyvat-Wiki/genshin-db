			"dialogs": [
				{
					"id": 722330301,
					"content": "Artık mührü kaldırma zamanı geldi. Daha önce edindiğin Mehtaplı Derinliklerin Anahtarını al.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330302
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330302,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330303,
					"content": "Mehtaplı Derinliklerin Anahtarı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330304
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330304,
					"content": "Üç defa daha hızlıca söyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330305,
					"content": "Mehtaplı Derinliklerin Anahtarı, Mehtaplı Derinliklerin Anahtarı, Mehtaplı Gelinliklerin Anahtarı.. Ah! Tamam, biraz tekerlemeye benziyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330306
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330306,
					"content": "Gördün mü? Paimon garip bir isim olduğunu söylemişti. Bunu değiştirmeyi düşünmelisiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722330307,
					"content": "Şimdi ismini değiştirsek bile yalnızca birkaç asır daha önemi olacak. Şimdilik sabret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330308
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330308,
					"content": "*öksürür* Her neyse. Şimdi ayini başlatacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330309
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330309,
					"content": "Maalesef Enkanomiya imtihanının nasıl olacağına dair elimizde hiç bilgi yok. Orada kendi becerilerine güvenmek zorundasın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330310
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330310,
					"content": "Bir suçlu arayacaksak \"gizemleri korumak\" amacıyla sürdürülen aptalca gelenekleri suçlamalıyız. Sana iyi şanslar dilerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722330311
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 722330311,
					"content": "Ayrıca lütfen kendini çok zorlama. Güvenliğin son derece önemli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				}
			]
		},
