			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida",
					"#{REALNAME[ID(1)|HOSTONLY(true)]}"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30320101,
					"content": "#Tekrar hoş geldiniz {NICKNAME}, Paimon ve Kasideci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320102
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320102,
					"content": "Oh be! Paimon uzun bir yolculuktan gelmişiz gibi hissediyor... Paimon çok yoruldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320103,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320104
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320104,
					"content": "Sana bu isimle seslenilmesinden hoşlanmıyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320105
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320105,
					"content": "Sorun değil ama değiştirmem gerektiğini düşünüyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320106
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320106,
					"content": "\"Kasideci\" ismini artık kullanmayacak mısın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320107
					]
				},
				{
					"id": 30320107,
					"content": "\"Doktor\"un yaptığı her şeyi öğrendikten sonra onunla alakalı bir ismi nasıl kullanabilirim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320108
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320108,
					"content": "Fatui'ye geri dönmek gibi bir planım yok, zaten dönsem de beni kabul etmezler. Birçok insan bu olaydan etkilendi, yani dönsem de altıncının kim olduğunu hatırlamıyor olabilirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320109
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320109,
					"content": "Yani Fatui'yi temelli bırakıyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320110,
					"content": "Stratejik geri çekilme diyelim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320111
					]
				},
				{
					"id": 30320111,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320112
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320112,
					"content": "Senin de dediğin gibi Devi Kusanali. Hepsi bir hiç uğruna gibiydi ama anlamsız değildi. En azından birçok insanın beni unutmasını sağladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320113
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320113,
					"content": "Ama bu geçmişinin yok olduğu anlamına gelmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320114
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320114,
					"content": "Elbette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320115
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320115,
					"content": "Ulaşmak için her şeyi feda ettiğin asıl amacın da... Gerçekleşmedi. Umarım bunu görüyor ve anlıyorsundur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320116
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320116,
					"content": "Dünyayı değiştirmek, geçmişi değiştirmek, diğer insanların kaderini değiştirmek... Bunlar yapması kolay şeyler değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320117
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320117,
					"content": "Senin istediğin şey tamamen yok olmak... Ama bu sadece bir hayal. \"Kasideci\" artık var olmasa da dünya senin iradene boyun eğmeyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320118
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320118,
					"content": "... Evet. Haha, ne kadar da saçma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320119
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320119,
					"content": "Tüm bunlardan pişman mısın? Ne de olsa çok az bir şey elde ettin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320120,
					"content": "Tamamen değersiz olsam bile dünyada pişman olunacak hiçbir şey yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320121
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320121,
					"content": "Devi Kusanali, bu bilgiyi bilerek Irminsul'da bırakmıştın, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320122
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320122,
					"content": "Evet ve bu bilgiyi doğal bir şekilde elde etmen için oldukça emek harcadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320123
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320123,
					"content": "Neden bu kadar uğraştın ki? Beni kazanmaya mı çalışıyorsun yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320124
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320124,
					"content": "Dürüst olmak gerekirse geçmiş tecrübelerin seni, Sumeru ve benim için değerli kılıyor. Seni kazanmak planımın bir parçasıydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320125
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320125,
					"content": "Bundan önce geçmişinle ilgili gerçeği seninle paylaşmak istemiştim. Sadece seni kullanmak isteseydim \"Doktor\"dan farkım kalmazdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320126
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320126,
					"content": "Çok akıllısın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320127
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320127,
					"content": "Meziyetlerim arasında bu da var diyebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320128
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320128,
					"content": "Başkalarına yardımcı olmak bana değer katan şeydir. Bunun için işlediğim günahlarla yüzleşmem gerekiyorsa yapacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320129
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320129,
					"content": "Nahida senin hakkında böyle düşünmüyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320130
					]
				},
				{
					"id": 30320130,
					"content": "Ah doğru, az daha unutuyordum... Sizler iyi insanlarsınız. Adaletin peşindesiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320131
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320131,
					"content": "Üzgünüm, biraz farklı bir bakış açım var. Ama oyuna geldiğimi düşünmüyorum. En zeki liderlerin sonunda en iyi yardımcıları olur... Bununla yaşayabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320132
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320132,
					"content": "Bu şekilde düşünebilmene sevindim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320133
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320133,
					"content": "#{NICKNAME}, gelecekte Irminsul'daki daha derinlemesine araştırmaya ve sırları ortaya çıkarmaya devam edeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320134
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320134,
					"content": "Buna Irminsul'da kayıtlı olan ikizinin yolculuğunun başlangıcı da dahil. Bundan önce ve sonra tam olarak ne oldu? Bunu ben de öğrenmek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320135
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320135,
					"content": "Teşekkürler. Umalım da bazı cevaplar bulabilesin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320136
					]
				},
				{
					"id": 30320136,
					"content": "Deneyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320137
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320137,
					"content": "#{NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320138
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320138,
					"content": "Efendim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320139
					]
				},
				{
					"id": 30320139,
					"content": "Irminsul'daki bilgi akımlarına atladıktan sonra neden Inazuma'ya gittin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320140
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320140,
					"content": "Çünkü neyi değiştirdiğini görmek istemiştim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320141
					]
				},
				{
					"id": 30320141,
					"content": "Yani böylece o insanların kaderinin nasıl değiştiğini anlamış oldun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320142
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320142,
					"content": "Pekala, sebebi ne olursa olsun bana bir iyilik yaptın ve ben de karşılığını vermek için her şeyi yapacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320143,
						30320144
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320143,
					"content": "... Tüm bunları senden bir karşılık bekleyerek yapmadım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320145
					]
				},
				{
					"id": 30320145,
					"content": "\"Ödünç almak\" ve \"geri vermek\", bireyler arasındaki tek gerçek ilişkidir. Bir gün ödeşmiş olacağız. Merak etme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320146
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320146,
					"content": "Bu doğru değil. İnsanlar arasındaki ilişkiler öylece ödeşerek kapatılamaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320147
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320147,
					"content": "Bence bunun içten içe farkındasın. Hayatında karşına çıkan insanların su tanecikleri gibi buharlaşıp ortadan kaybolmadığını anlamış olmalısın. Hiçbir zaman \"ödeşme\" diye bir şey olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320148
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320148,
					"content": "Kurtarılamaz ve değiştirilemez olan şeyler vardır. Bundan ötürü insanların dünyasında duygular yer alır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320149
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320149,
					"content": "Hissettiğin her şey gerçek ve kalıcıdır. İçinde eksikliğini çektiğin hiçbir şey tamamlanmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320150
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320150,
					"content": "İnsan olmak kusurlu olmak demektir. İnsan olup olmamayı seçmek ise sana kalmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320151
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320151,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320152
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320152,
					"content": "Ama yüreği olmayan bir insan yoktur, değil mi? Ayrıca, insan olmaktan vazgeçeli uzun zaman oluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320153
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320153,
					"content": "Bir yüreğin olmasa da acıyı çok iyi anlıyorsun. Sadece duygularını inkar ediyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320154
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320154,
					"content": "Geçmişi değiştiremezsin ama devam etmeyi seçebilirsin. Geleceğin yeteri kadar uzunsa bir gün \"geçmiş\", hayatının sadece küçük bir parçası olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320155
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320155,
					"content": "Görünüşe bakılırsa benim için bir gelecek planı yapmışsın bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320156
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320156,
					"content": "Umarım Nahida'ya bir şans verebilirsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320157
					]
				},
				{
					"id": 30320157,
					"content": "Her şey o kadar karıştı ki Paimon nereden başlayacağını bile bilemiyor... Ama senin için şimdi en önemli olan şey Nahida'yı takip etmek. Yoksa tüm çabalarımız boşa gidebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320158
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320158,
					"content": "O zaman sanırım artık size gizliden yardım edeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320159
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320159,
					"content": "Teklifimizi kabul ettiğine sevindim. Neden bunu kutlamak için yeni bir isim seçmiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320160
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320160,
					"content": "Ayyy ayy! Paimon da sana çirkin bir takma ad vermek istiyordu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320161
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320161,
					"content": "Neden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320162
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320162,
					"content": "Çünkü... Çünkü Paimon hâlâ seni o kadar sevmiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320163
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320163,
					"content": "Hıh. O halde birbirimizi gelecekte o kadar sık görmeyiz umarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320164
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320164,
					"content": "\"Bir isim, hayatın ilk hediyesidir.\" Bunu sesli söylememiş olsan da bunu düşündüğünü biliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320165
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320165,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320166
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320166,
					"content": "#{NICKNAME} ve Paimon sana çok yardımcı oldu. Kendine bir isim seçemiyorsan onlardan tavsiye alabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320167
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320167,
					"content": "Ne? Bizim mi karar vermemizi istiyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320168
					]
				},
				{
					"id": 30320168,
					"content": "Olmaz, Paimon sadece takma adlar bulur! Eğer ciddi bir isim arıyorsak... Sen seç!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320144,
					"content": "Senden bir şey elde etmeye çalışıyormuşum gibi konuşma lütfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320145
					]
				}
			]
		},
		{
			"id": 303203,
