			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amane",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30320501,
					"content": "Oh be. Mola verme vaktimiz geldi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320502,
					"content": "Durduğun anda tüm yorgunluğunu ve açlığını hissedeceksin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320503,
						30320504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320503,
					"content": "Dinlen Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320505
					]
				},
				{
					"id": 30320505,
					"content": "Vay canına! Harika!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320506,
					"content": "Ha? Vazoya bak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320507,
					"content": "Nesi var ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320508
					]
				},
				{
					"id": 30320508,
					"content": "Birisi odayı temizlerken falan mı kırdı acaba? Paimon odaya kimsenin girdiğini görmedi ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320509,
					"content": "(Burada kaldığımız gece Paimon, Kasideci ile ilgili bir şeyden korkup masaya çarptı ve vazoyu kırdı.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320510
					]
				},
				{
					"id": 30320510,
					"content": "(Ama Kasideci, varlığını silmişti. Dünyayı değiştirmişti... O halde vazo neden hâlâ kırık?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320511
					]
				},
				{
					"id": 30320511,
					"content": "Kafan karışmış gibi konuşuyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320512
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320512,
					"content": "O kim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320513
					]
				},
				{
					"id": 30320513,
					"content": "Neden dertli olduğunu biliyorum. Bunu bilen herkesin başı ağrır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320514
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320514,
					"content": "Ha? Burada bizimle konuşan biri mi var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320515,
					"content": "Maalesef Teyvat'ın kaderi o kadar kolay değiştirilemez. Bunu bir tanrı bile küçük ihtimalle başarabilir ama tanrı olmayan biri için... Söylemesi zor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320516
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320516,
					"content": "Küçük bir hayvan, ağaca çarparsa ağaç sallanabilir ama yeri değişmez. Bu şey kader için de geçerlidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320517
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320517,
					"content": "Yere düşmüş bir vazo mesela. Bir kuş veya kedi de çarpmış olsa sonuçta kırılmış bir vazo, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320518
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320518,
					"content": "S-Sen de kimsin? Bütün bunları nasıl biliyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320519,
					"content": "Tarih, o kadar kolay değiştirilebilen bir şey değildir ama insanın kalbi değişir. Gördüğünüze inanın. Gördüğünüz şey gerçek. Görmedikleriniz ise bir yanılgıdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320520
					],
					"speakerTitle": "Amane"
				},
				{
					"id": 30320520,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320521
					]
				},
				{
					"id": 30320521,
					"content": "Ses kayboldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320522,
					"content": "O da kimdi şimdi? Bir anda ortaya çıkıp ürkütücü şeyler söylemek de neyin nesi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320523,
					"content": "(Gördüklerime mi inanayım? Yoksa... Hatıralarıma güvenmemi mi ima etti?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320524
					]
				},
				{
					"id": 30320524,
					"content": "Ah, her neyse vazo hâlâ kırık bir şekilde yerde duruyor. Paimon gidip temizlemesi için birini çağırmalı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320525,
					"content": "Orada öyle bırakmak doğru olmazmış gibi. Bir dakika ver, Paimon hemen gidip gelecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320526,
					"content": "(...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320527
					]
				},
				{
					"id": 30320527,
					"content": "(Gelecekte beni başka neler bekliyor acaba?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 30320504,
					"content": "Ödül olarak leziz bir yemek ısmarlayacağım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320505
					]
				}
			]
