				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30320301,
					"content": "Tamam. Romanımın sonunu Mikoshi Nagamasa'nın sözleriyle bitirebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320302
					],
					"speakerTitle": "Sawada"
				},
				{
					"id": 30320302,
					"content": "Hikayedeki diğer herkes öldüğü için mi diyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320303
					],
					"speakerTitle": "Aqaba"
				},
				{
					"id": 30320303,
					"content": "Evet, Mikoshi Nagamasa'nın yaşlılıktan öldüğünü duymuştum. Son sözü söylemek için uygun bence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320304
					],
					"speakerTitle": "Sawada"
				},
				{
					"id": 30320304,
					"content": "\"Kara bulutlar dağıldı ama gelecek yıllarda bu olay Mikoshi Nagamasa'nın aklına takılmaya devam etti.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320305
					],
					"speakerTitle": "Sawada"
				},
				{
					"id": 30320305,
					"content": "\"Yaşlı bir adam olarak bir gece bir rüya gördü. O muhteşem kılıç 'Daitatara Nagamasa'nın dövüldüğü gecede insanlar neşeli bir halde resimler yapıp dans edip içtiler.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320306
					],
					"speakerTitle": "Sawada"
				},
				{
					"id": 30320306,
					"content": "\"... Mutlulukları eriyip ocak ateşine aktı ve Mikoshi Nagamasa'nın hayatında gördüğü son gün doğumunu kaplayan kırmızı bulutlar haline geldi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320307
					],
					"speakerTitle": "Sawada"
				},
				{
					"id": 30320307,
					"content": "\"Hayat anlatılması uzun bir hikayedir, görmek istiyorsan o yolda yürümek gerekir.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320308
					],
					"speakerTitle": "Sawada"
				},
				{
					"id": 30320308,
					"content": "Hıh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				}
			]
		},
		{
			"id": 303204,
