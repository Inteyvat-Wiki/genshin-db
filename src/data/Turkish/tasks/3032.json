			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida",
					"#{REALNAME[ID(1)|HOSTONLY(true)]}"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30320401,
					"content": "İşte, artık senin de bir adın var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320402
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320402,
					"content": "Takma ad ne olacak? Daha karar vermedin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320403
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320403,
					"content": "Ahhh... Paimon hâlâ düşünüyor... Paimon'u acele ettirme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320404,
					"content": "Acele etme. Sen düşünüp karar verene kadar seni görmeme gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320405
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320405,
					"content": "Şimdi ne yapmayı düşünüyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320406
					]
				},
				{
					"id": 30320406,
					"content": "Beni kullanıp acı çektirenler er ya da geç bedelini ödeyecekler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320407
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320407,
					"content": "Fatui'den mi bahsediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320408,
					"content": "En azından Doktor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320409
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320409,
					"content": "Artık tutumun değişti. Geleceğe giden yolunun da değişeceğinden eminim ama bu aniden olmayacak... Hâlâ alışmak için zamana ihtiyacın var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320410
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320410,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320411
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320411,
					"content": "Bir şey daha var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320412
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320412,
					"content": "Inazuma'da yaşayan ve Gokaden Raiden'ın soyundan gelenler var. Bazıları... Gokaden Raiden ile olan ilişkimi biliyor olmalı veya bilmeli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320413
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320413,
					"content": "Sumeru'dan henüz ayrılmayı planlamıyorum. Eğer onları Inazuma'da görürsen onlara Gokaden Raiden'ın çöküşünden sorumlu olanın ben olduğumu söyleyebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320414
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320414,
					"content": "... Tüm o olaylar dünyadan silinmiş olsa da gerçeği bilmeyi hak ediyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320415
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320415,
					"content": "Anlıyorum, sen bilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320416
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320416,
					"content": "Ne? Ama bunu yaparsak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320417,
					"content": "Önemli değil. İsterlerse yüreğime kılıç saplayabilirler. Belki de olması gereken budur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320418,
						30320422
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320418,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320419
					]
				},
				{
					"id": 30320419,
					"content": "O bakış da ne öyle? O ifadeyi takınmana gerek yok. Ne yaptığımı biliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320420
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320420,
					"content": "... O gün gelecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320421
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320421,
					"content": "Pekala, burada işimiz bitti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320425
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320425,
					"content": "Bilge tanrı ve ikiniz, hoşça kalın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320426
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320426,
					"content": "Gitti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320427,
					"content": "Bugün ona olan şey tüm hayatı bir anda yaşamak gibiydi. Sakinleşmek için zamana ihtiyacı var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320428
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320428,
					"content": "Evet, doğru. Ama o kadar olan şeyden sonra artık eskisi gibi sert değil gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320429,
					"content": "Ufak tefek sıkıntılar oldu tabii ama artık her şey bitti!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320430
					]
				},
				{
					"id": 30320430,
					"content": "Artık yemek yemeye gidebiliriz, değil mi? Paimon'un midesi kazınıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30320431,
					"content": "İkinize de teşekkür ederim. Umarım güzel bir yer bulur bir süreliğine dinlenirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30320422,
					"content": "Peki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30320423
					]
				},
				{
					"id": 30320423,
					"content": "Hehe, olur, hoşuma gitti bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320424
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 30320424,
					"content": "Pekala, bugünlük bu kadar yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30320425
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				}
			]
		},
		{
			"id": 303205,
