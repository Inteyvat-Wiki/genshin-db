				]
			},
			"dialogs": [
				{
					"id": 140250301,
					"content": "Görüşmeme hâlâ biraz vakit var, beklerken sohbet edebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250302
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 140250302,
					"content": "Çocuklarımla iyi anlaşmanıza çok sevindim. Bir çocuğun iyi arkadaşlara sahip olması, gelişimi için çok önemli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250303
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 140250303,
					"content": "Çocuklara bir şey yapmayı düşünmüyorsun, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250304,
					"content": "Lyney, Lynette ve Freminet'yi ima ettiğinizi varsayıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250305
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 140250305,
					"content": "Gerçi Filliol ve Nanteuil olayı da var... Hım, son zamanlarda herkeste bir isyankarlık söz konusu herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250306
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 140250306,
					"content": "Her neyse, önemli değil. Ben ayrımcılık yapmam. Yuvaya ihanet eden herkes aynı kaderle yüzleşir. Kimseye müsamaha gösterilmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250307
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 140250307,
					"content": "Öldürecek misin yani onları?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250308,
					"content": "Hım? Onları bağışlamam için yalvaracak mısınız? Kusura bakmayın ama Yuvanın kuralları kimse için değiştirilemez. Benim kurumumda herkes kendi eylemlerinden sorumludur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250309
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 140250309,
					"content": "Ama... Gözünde hiçbir değeri yok mu onların? Sana çok saygı duyuyorlar! Hatta sana \"Baba\" diyorlar! Sen de onlara karşı bir şeyler hissediyorsundur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250310,
					"content": "Duyguların prensiplerin önüne geçtiği kurumlar yıkılmaya mahkumdur. Taş Yuva için de geçerli bu. Prensiplerimiz çoğu kurumdan daha katı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250311
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 140250311,
					"content": "İçinizi bir nebze olsun rahatlatabilirim ama. Misafirimiz olduğunuz için onlarla beraber siz de sorumlu tutulmayacaksınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250312
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 140250312,
					"content": "Bu sorunu çözmenin başka yolu yok mu gerçekten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250313
					]
				},
				{
					"id": 140250313,
					"content": "Lyney, Lynette ve Freminet muhtemelen hayatta kalmayı başaracaklardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250314
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 140250314,
					"content": "Filliol, Nanteuil ve diğerleri ise... Korkarım onların yapabileceği pek bir şey yok. Kaçmaya çalışabilirler ama sırlarımızı öğrenen kimse Yuvadan canlı çıkamaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250315
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 140250315,
					"content": "Ama... Çok korkunç bu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250316,
					"content": "Endişelendiniz sanırım. Misafirlerimin hatırına, yaşanmakta olanları bir süreliğine daha görmezden gelebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250317
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 140250317,
					"content": "Lyney ve diğerleri Clervie'den zamanında kurtulmayı başarırsa yaptıkları yanlışların kanıtları yok olur. Öyle bir durumda kanıtlayamayacağım bir olay için onları cezalandıramam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250318
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 140250318,
					"content": "Fakat çabaları başarısız olursa üçü de sorumlu tutulur ve ağır bir cezayla yüzleşirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250319,
						140250320
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 140250319,
					"content": "Anlaştık öyleyse.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250321
					]
				},
				{
					"id": 140250321,
					"content": "Tabii. Ha, unutmadan... Alın, sanırım size ait bu. Bir dahakine daha iyi göz kulak olun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250322
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 140250322,
					"content": "Böyle bir kuşu eğitmek epey vakit isteyen bir iş. Olur da kaybederseniz... Çok yazık olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250323
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 140250323,
					"content": "Bir dakika, nereden buldun sen onu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250324,
					"content": "Korkarım sohbetimizi burada sonlandırmak durumundayız. Şimdi asıl konuya gelelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250325
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 140250325,
					"content": "Mermonia Sarayı'nda işim olduğu için sizden buraya gelmenizi istedim. İşimin sizinle bir ilgisi yok ama şimdilik yanımda durmanız isabetli bir karar olur bence. Kaçıp Lyney'ye öğrendiklerinizi anlatacak vaktiniz olacak nasıl olsa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250326
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 140250326,
					"content": "Haydi, girelim artık. Sohbetimizi tam zamanında noktalamışız anlaşılan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yaver"
				},
				{
					"id": 140250320,
					"content": "Bu sözlerini hatırlatırız sana!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250321
					]
				}
			]
		},
