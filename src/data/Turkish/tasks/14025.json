			"dialogs": [
				{
					"id": 140250501,
					"content": "Şey... Tam olarak ne konuştunuz içeride?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250502,
					"content": "Paimon nehirlerden, büyük bir su kütlesinden ve... Bir sulama sisteminden bahsettiğini duydu sadece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250503,
					"content": "Gerçekten bilmek istiyor musunuz? Şu an sizin için daha önemli konular vardır diye düşünüyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250504
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 140250504,
					"content": "*iç çeker* Lyney... Her şey yolundadır diye umuyor Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250505,
					"content": "#Aa! Paimon bu bakışını biliyor! Derin düşüncelere daldın yine, değil mi {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250506,
					"content": "(Yaver rahat görünüyordu fakat Yuvaya ihanet edenlerin bu suçun bedelini hayatlarıyla ödeyeceğini söylerken pek şaka yapıyor gibi bir hali yoktu. Bence çocukları cezalandırma konusunda gayet ciddi.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250507
					]
				},
				{
					"id": 140250507,
					"content": "(Nasıl durduracağız onu? Yok, bir dakika, önce çözmemiz gereken başka bir konu var.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250508
					]
				},
				{
					"id": 140250508,
					"content": "(Mermonia Sarayı'nın önünde konuşurken Clervie'nin adını söyledi. Clervie'nin nerede olduğunu bunca zamandır biliyor muydu yani? Hatta belki Lyney ve diğerlerinin ne yapacağını bile tahmin etmiştir önceden...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250509
					]
				},
				{
					"id": 140250509,
					"content": "Aaaaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250510
					],
					"speakerTitle": "Horrer"
				},
				{
					"id": 140250510,
					"content": "Of... Eyvah, iyi misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250511
					],
					"speakerTitle": "Horrer"
				},
				{
					"id": 140250511,
					"content": "Of ya, çok özür dilerim. Gazeteleri satmaya o kadar odaklanmışım ki önüme bakmayı unutmuşum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250512,
						140250513
					],
					"speakerTitle": "Horrer"
				},
				{
					"id": 140250512,
					"content": "Benim hatam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250514
					]
				},
				{
					"id": 140250514,
					"content": "Olsun, en azından telafi edeyim. Al bu gazeteyi, benden olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250515
					],
					"speakerTitle": "Horrer"
				},
				{
					"id": 140250515,
					"content": "(Niyeyse tanıdık geldi...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250516
					]
				},
				{
					"id": 140250516,
					"content": "Bize bir şey vermene gerek yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250517,
					"content": "Lütfen, içimden geldi. Hem daha elimde bir sürü var. Satamadıklarım yarın bir işime yaramayacak sonuçta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250518
					],
					"speakerTitle": "Horrer"
				},
				{
					"id": 140250518,
					"content": "Gerçekten benim hatam ya. Ailem için fazladan Mora kazanmaya çalışıyorum ama boyumu aşan bir işe kalkıştım sanırım. Bugün pek satış yapamadım, hâlâ her yerim gazete dolu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250519
					],
					"speakerTitle": "Horrer"
				},
				{
					"id": 140250519,
					"content": "Ne oluyor burada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250520
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 140250520,
					"content": "Hiç... Kazara arkadaşınıza çarptım da. Neyse, ben artık gideyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250521
					],
					"speakerTitle": "Horrer"
				},
				{
					"id": 140250521,
					"content": "Dur bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250522
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 140250522,
					"content": "Şey... Hatamın karşılığını Morayla da ödemek isterdim ama... Şu an üzerimde hiç yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250523
					],
					"speakerTitle": "Horrer"
				},
				{
					"id": 140250523,
					"content": "Üç gazete alayım. Al bu da parası.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250524
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 140250524,
					"content": "Aa! Kesenize bereket, sağ olun! Hükümdarlar yolunuzu açık etsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250525
					],
					"speakerTitle": "Horrer"
				},
				{
					"id": 140250525,
					"content": "Keşke her gün sizin gibi cömert müşterilerle karşılaşsam... Haha, gerçi yanıma daha az gazete alsam da olur, değil mi? Yakında evleniyorum da, o yüzden bazen ipin ucunu kaçırıyorum... Neyse, ben gideyim. Hoşça kalın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250526
					],
					"speakerTitle": "Horrer"
				},
				{
					"id": 140250526,
					"content": "İşlerim hallolduğuna göre tekneyle Poisson'a dönebiliriz. Yolda okuyacak gazetemiz de oldu hem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250527
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 140250527,
					"content": "Aslında... Acaba... Biraz daha mı dolaşsak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250528,
					"content": "Paimon'un karnı çok acıktı da! Poisson'a aç karınla dönemez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250529,
					"content": "(Paimon bize biraz daha vakit kazandırmaya çalışıyor galiba. Lyney ve diğerleri henüz yeterince ilerleme katedememiştir. Ne yapsak ki...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250530
					]
				},
				{
					"id": 140250530,
					"content": "Sanıyorum ki dönüşümüzü geciktirmenin durumu lehinize çevireceği kanısına kapılmışsınız. Hayallerinizi bozuyorum kusura bakmayın ama bu çabalarınız nafile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250531
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 140250531,
					"content": "Öte yandan Lyney'ye ek süre tanımayı kabul edebilirim... Bir şartım var ama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250532
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 140250532,
					"content": "Şartımı kabul ederseniz bazı sorularınıza cevap da veririm. Clervie'yi çok merak ediyorsunuz, öyle değil mi? Ve onunla aramdaki ilişkiyi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250533
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 140250533,
					"content": "Bir dakika, bir anda nereden çıktı bu cömertlik? Bizden kötü bir şey yapmamızı istemeyeceksin değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250534
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250534,
					"content": "Kendinizi abartıyorsunuz. Kötülük yeteneği yok içinizde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250535
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 140250535,
					"content": "Of, o zaman ne isteyec...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250536
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250536,
					"content": "Bir pazarlıkta en önemli husus iki tarafın da istediği bir şey almasıdır. Talepler ve tehditlerle ancak bir yere kadar ilerleyebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250537
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 140250537,
					"content": "Duyalım şu şartını artık.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250538
					]
				},
				{
					"id": 140250538,
					"content": "Harika. Söylüyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250539
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 140250539,
					"content": "Vakti geldiğinde kendinizce duruma en uygun seçimi yapın ve Taş Yuva'ya yardım edin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250540
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 140250540,
					"content": "Peki... Normal bir istek gibi duruyor... Ama \"vakti geldiğinde\" derken ne kastettin? Nedir bunun anlamı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250541,
					"content": "Onun kararını vermek size kalmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250542
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 140250542,
					"content": "Şartını kabul ediyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250543
					]
				},
				{
					"id": 140250543,
					"content": "Anlaştık o halde. Gelin benimle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yaver"
				},
				{
					"id": 140250513,
					"content": "Ben de dikkat etmiyordum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250514
					]
				}
			]
		},
