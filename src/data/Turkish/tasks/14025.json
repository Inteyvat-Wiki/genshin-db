			},
			"dialogs": [
				{
					"id": 140250201,
					"content": "Demek yine siz geldiniz. Biraz solgun gördüm sizi bugün. Dün gece uyumakta zorlandınız mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250202
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 140250202,
					"content": "Iı... Birazcık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250203,
					"content": "Aklınıza takılan daha az düşünce olsa böyle zorluklar yaşamazsınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250204
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 140250204,
					"content": "Şimdi ne yapmayı planlıyorsunuz? Uyuyacak mısınız? Yoksa soru sormadan önce size düşünmek için biraz vakit mi tanımalıyım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250205
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 140250205,
					"content": "Gerçi merak ettiğim bir konuyu açıkça sormak istiyorum... Asilzade olmadığına göre beni nasıl oyalamayı planlıyorsunuz acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250206
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 140250206,
					"content": "(!!!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250207
					]
				},
				{
					"id": 140250207,
					"content": "Seni oyalıyor muymuşuz biz? Hahaha, güzel şakaymış... Ama yok, şey, biz buraya sadece... Öylesine sohbet etmeye geldik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250208,
					"content": "Hım, düşünmeniz için biraz daha süre gerekiyormuş anlaşılan. Her neyse, önemi yok. Başka bir planınız yoksa bana bir yere kadar eşlik eder misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250209
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 140250209,
					"content": "Merak etmeyin. Planlarını yürüten çocuklara görünmeyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250210
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 140250210,
					"content": "Ay... Okyanus havası ne güzel esiyor bugün...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250211,
					"content": "Her şeyin farkında mısın yani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250212
					]
				},
				{
					"id": 140250212,
					"content": "Çocuklar yetişkinlerden bir şeyler saklayabileceklerini sanırlar hep. Oysa benim dikkatimden hiçbir şey kaçmaz, hele böyle küçük dolaplar asla. Oynamalarına biraz daha izin vereceğim, gerektiğinde çok sabırlı olabiliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250213
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 140250213,
					"content": "Neyse, ben sizi düşüncelerinizle baş başa bırakayım. Gelmek isterseniz sizi Mermonia Sarayı'nın önünde bekleyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250214
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 140250214,
					"content": "Söz dinleyen çocukların başına iyi şeyler gelir. O yüzden umarım bana eşlik etmeyi tercih edersiniz... Sırf arkadaşlarınızın iyiliği için bile olsa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250215
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 140250215,
					"content": "Ne yapacağız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250216,
					"content": "Tüm yaptıklarımızdan haberi var belli ki, az önce bizi tehdit ettiğini söylesek abartmış olmayız herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250217,
					"content": "Lyney'nin bize verdiği güvercini salalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250218
					]
				},
				{
					"id": 140250218,
					"content": "Aa, iyi fikir! Umarım zamanında görür...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250219,
					"content": "Biz en iyisi Mermonia Sarayı'na gidelim. Paimon gitmezsek ne yaşanır öğrenmek istemiyor. Yaver'in sözlerine bakılırsa iyi bir şey yaşanmayacağı kesin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250220,
						140250221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250220,
					"content": "Başka seçeneğimiz yok açıkçası...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250222
					]
				},
				{
					"id": 140250222,
					"content": "Peki o zaman, onu çok bekletmeyelim. Lyney ve diğerlerinin durumu pamuk ipliğine bağlı şu an, onların başını daha fazla belaya sokmamak için elimizden geleni yapalım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250221,
					"content": "Adım adım ilerleyeceğiz mecburen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250222
					]
				}
			]
		},
