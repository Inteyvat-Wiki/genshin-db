			"dialogs": [
				{
					"id": 140250102,
					"content": "Tamam, hepimiz buradayız. Plana başlayabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250103,
						140250104
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250103,
					"content": "Başlamadan önce...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250105
					]
				},
				{
					"id": 140250105,
					"content": "Öyle mi? Nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250106
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 140250106,
					"content": "Yaver ile Doktor hiç birlikte çalıştı mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250107
					]
				},
				{
					"id": 140250107,
					"content": "Niye sordun bunu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250108
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250108,
					"content": "Dün gece Clervie'yle karşılaştık da... O bize öyle dedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250109,
					"content": "Doktor'la Sumeru'da tanışmıştık. Çok tehlikeli biri! Üstelik korkunç işler yaptı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250110,
					"content": "... \"Babamın\" ve Doktor'un arasında bir iş ilişkisi olabilir ama ben \"Babamın\" onunla çalışmak isteyeceğini sanmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250111
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250111,
					"content": "Aynı tarafta sayılmayız onunla, o yüzden aralarında pek güven yok. Öyle olunca da başarılı bir ortaklık söz konusu olamaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250112
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250112,
					"content": "Gerçi duyduğuma göre \"Babam\" Haberci olduğunda ilk başlarda Doktor ona Taş Yuva'yla birlikte çalışmayı teklif etmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250113
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250113,
					"content": "\"Babam\", Doktor'un önerilerinin neredeyse hepsini reddetmiş. Biri hariç... Gizli bir deneyle ilgiliymiş o da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250114
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250114,
					"content": "Gizli deney mi? Clervie ondan bahsediyor olabilir mi acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250115,
					"content": "Sanmıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250116
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 140250116,
					"content": "Deneyin içeriğini hiç bilmiyorum ama tamamen bağımsız bir operasyon olduğunu biliyorum. Doktor sadece araştırma için bir gidişat önerisinde bulunmuş. Başka katkısı olmamış. Bence bu beraber çalışmak sayılmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250117
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250117,
					"content": "Deneyin ayrıntıları gizli olsa da tüm katılımcıların eksiksiz kaydı tutulmuş. Clervie'nin bahsettiği olayda ise böyle bir şey söz konusu değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250118
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250118,
					"content": "Fatui'nin bazı yöntemlerini tasvip etmiyorsunuz biliyorum, etmenizi de istemiyorum. Ama bu konuda bize güvenmenizi istiyorum. Taş Yuva'nın kendi prensipleri vardır. Geçmek istemeyeceğimiz bazı çizgilerimiz var bizim de.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250119
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250119,
					"content": "*iç çeker* Peki. Bunu duymak biraz rahatlattı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250120,
					"content": "Clervie'ye göre Yaver ve Doktor birlikte çalışıp korkunç bir şey yapmış. Eğer bu doğruysa... Paimon bir daha sizin yüzünüze nasıl bakarız bilmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250121,
					"content": "Ama yani... Clervie de yalan söylüyormuş gibi durmuyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250122,
					"content": "Aslında bunun en kolay çözümü gidip Yaver'in yüzüne sormak olurdu ama Paimon bize cevap vereceğini sanmıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140250123,
					"content": "Şimdilik plana odaklanalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250124
					]
				},
				{
					"id": 140250124,
					"content": "\"Babam\" dün gece dönmedi. Muhtemelen hâlâ sahildedir. Yine gidip onu oyalamanızı istiyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250125
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250125,
					"content": "Lynette, sen benimle gel. Freminet, ne yapacağını biliyorsun. Herkes gözünü dört açsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140250126
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250126,
					"content": "Peki o zaman, hadi herkese kolay gelsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140250104,
					"content": "Benim bir sorum var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140250105
					]
				}
			]
		},
		{
