				"objectNames": [
					"Neuvillette"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 140251001,
					"content": "Başkalarının hisleriyle kolay empati kurabildiğimi daha önce söylemiştim size.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140251002
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 140251002,
					"content": "Fakat o Haberciyle yaşadığım görüşmelerin hiçbirinde kendisinin duygusal vaziyetine dair bir his sezemedim. Zihni durgun bir deniz gibi. Derinliklerinde ne karanlıklar yatıyor kim bilir, yüzeyden bakınca hiçbir şey anlaşılmıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140251003
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 140251003,
					"content": "Bu kendisinin doğal hali mi yoksa duyguları üzerinde kontrol sağlayan muhteşem bir güce mi sahip orası net değil. İki durumda da oldukça tehlikeli biri olduğu anlamı çıkıyor ama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140251004
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 140251004,
					"content": "Ona neden eşlik ettiğinize dair bir açıklama beklemiyorum sizden. Gerekçeniz her ne olursa olsun ihtiyatlı davranmanızı tavsiye ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neuvillette"
				}
			]
		}
	]
