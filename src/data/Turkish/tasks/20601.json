			},
			"dialogs": [
				{
					"id": 206010501,
					"content": "*tıslar* Ah... Acıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010502
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010502,
					"content": "Çok sağ ol. Bugün eve dönemeyeceğimi düşünüyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010503
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010503,
					"content": "Nasıl hissediyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010504
					]
				},
				{
					"id": 206010504,
					"content": "Ha, azıcık... *homurdanır* Acıyor işte! Birazcık. İyiyim ben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010505
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010505,
					"content": "Bir dağ yabanisi güruhunun ilerideki kampta toplandıklarını keşfettim. Bir şeylerin peşinde olabileceklerini düşünüp takibe başladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010506
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010506,
					"content": "Ama fazla yaklaştım ve beni fark ettiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010507
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010507,
					"content": "Neyse beni boş ver şimdilik, dağ yabanilerini yenmeme yardım et lütfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010508
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010508,
					"content": "Sayıları gittikçe artıyor. Planlarını gerçekleştirmelerine izin veremeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010509
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010509,
					"content": "Bana gelince... Kendi başımın çaresine bakarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
		{
			"id": 2060106,
			"completionStepIds": [
				2060108
			],
