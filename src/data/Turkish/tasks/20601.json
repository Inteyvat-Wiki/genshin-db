			},
			"dialogs": [
				{
					"id": 206010601,
					"content": "Hepsini temizledin sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010602
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010602,
					"content": "Evet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010603
					]
				},
				{
					"id": 206010603,
					"content": "Çok güçlüsün. Keşke ben de senin gibi yetenekli olabilsem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010604
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010604,
					"content": "Ben de arkamda ejderha öldürmeli, dünya kurtarmalı efsaneler bırakmak isterim. Gel gör ki bir grup dağ yabanisini bile alt edemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010605
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010605,
					"content": "Of... Neyse, ben... Sormaya utanıyorum ama senden bir şey daha istemem gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010606
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010606,
					"content": "Bin Rüzgar Tapınağına geldim çünkü yakında Macera Rütbesi Belirleme sınavına gireceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010607
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010607,
					"content": "Yeteneklerimi şimdiden gösterebilirsem sınavın daha kolay geçebileceğini düşündüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010608
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010608,
					"content": "Ama bırak yeteneklerimi göstermeyi, az kalsın hayatımı kaybedebileceğim aklımın ucundan bile geçmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010609
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010609,
					"content": "C-Cyrus'a bundan bahsetmesen olur mu acaba? Bu olay rütbe belirlemesini etkileyecek olursa ayvayı yerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010610,
						206010612
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010610,
					"content": "Sırrın benimle güvende.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010611
					]
				},
				{
					"id": 206010611,
					"content": "Çok teşekkür ederim! İleride bu kadar pervasız olmayacağım, söz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010612,
					"content": "Bunu yapmam doğru olmaz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206010613
					]
				},
				{
					"id": 206010613,
					"content": "Olmadığını biliyorum. Cyrus da maceracıların kendilerine karşı dürüst olmaları gerektiğini söyler hep.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010614
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 206010614,
					"content": "Ama... *iç çeker* Unut gitsin. Çok kızmasa bari bana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
