						206010704
					]
				},
				{
					"id": 206010704,
					"content": "Yani düşündüğüm gibi. *iç çeker* Söylediğim şeyleri hiç dikkate almamış, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206010705
					],
