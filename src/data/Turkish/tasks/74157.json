			"dialogs": [
				{
					"id": 741570301,
					"content": "Satılık ev. Fiyatı son derece uygundur, ilgileniyorsanız bu fırsatı kaçırmayın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570302
					],
					"speakerTitle": "Satılık Ev Tabelası"
				},
				{
					"id": 741570302,
					"content": "#{M#Bay}{F#Bayan} {NICKNAME}, Bayan Paimon! Siz de Bay Leroy ile konuşmaya mı geldiniz yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570303,
						741570305
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570303,
					"content": "Benoit evde mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570304
					]
				},
				{
					"id": 741570304,
					"content": "Hayır. Babam diyor ki Bay Leroy artık burada yaşamıyormuş, bir daha da geri dönmeyecekmiş. Yer altında yaşamaya gitmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570308
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570308,
					"content": "Cendre Nehri'nde mi yaşayacakmış?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570309
					]
				},
				{
					"id": 741570309,
					"content": "Bu hani şu gittiğimiz Cendre Nehri mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741570310,
					"content": "Şey, hayır... O halde orası değil. Babam onun gittiği yerin çok daha derinlerde olduğunu söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570311
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570311,
					"content": "Buğukuş'ta yazdığına göre Bay Leroy dağa tırmanırken çok yüksek bir yerden düşmüş, sonra da epey yuvarlanmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570312
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570312,
					"content": "Gerçi ben düşmesiyle taşınması arasındaki bağlantıyı anlayamadım ama neyse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570313
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570313,
					"content": "Bu arada Bay Leroy'un damadıyla karşılaştım! Yanında da çok kibar bir hanımefendi vardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570314
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570314,
					"content": "O hanımefendi beni çok sevdi galiba. Üstelik gözleri de tıpkı benimki gibi eflatundu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570315
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570315,
					"content": "Nerede yaşadığımı sordu, vakti olursa gelip beni görmek istediğini söyledi. Benimle arkadaş olmak istiyormuş! Leroy ailesindeki herkes ne iyi kalpli böyle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570316
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570316,
					"content": "*iç çeker* Bay Leroy'a da Bulle Meyvesi getirmiştim aslında ama burada olmadığına göre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570317
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570317,
					"content": "Bu meyveleri size versem olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570318
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570318,
					"content": "Teşekkürler Molli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741570319,
					"content": "Önemli değil! Arkadaşlarımıza karşı cömert olmamız lazım, annemle babam hep öyle der!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570320
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570320,
					"content": "Bugün de bir iyilik daha cepte! Yaşasın! Hemen gidip bunu günlüğüme yazayım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570321
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570321,
					"content": "Molli mutlu bir şekilde sokaktan ayrılır. Böylece Leroy ailesinin hikayesi de burada son bulur.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 741570305,
					"content": "Hiç, öyle geçiyorduk sadece.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570306
					]
				},
				{
					"id": 741570306,
					"content": "Ben de Bay Leroy'un taşındığını size söylesem mi söylemesem mi diye düşünüyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570307
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570307,
					"content": "Babam diyor ki Bay Leroy artık burada yaşamıyormuş, bir daha da geri dönmeyecekmiş. Yer altında yaşamaya gitmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570308
					],
					"speakerTitle": "Molli"
				}
			]
