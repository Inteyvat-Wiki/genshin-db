			"dialogs": [
				{
					"id": 741570201,
					"content": "Satılık ev. Fiyatı son derece uygundur, ilgileniyorsanız bu fırsatı kaçırmayın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570202
					],
					"speakerTitle": "Satılık Ev Tabelası"
				},
				{
					"id": 741570202,
					"content": "#{M#Bay}{F#Bayan} {NICKNAME}, Bayan Paimon! Sanırım Bay Leroy buradan taşınmış! Siz onu hiç gördünüz mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570203
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570203,
					"content": "(Ona doğruyu söylesek mi sence?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570204,
						741570210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741570204,
					"content": "Onunla karşılaştık, evet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570205
					]
				},
				{
					"id": 741570205,
					"content": "Gördünüz demek! Verdiği atıştırmalıkların lezzetli olduğunu da söylediniz mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570206,
						741570208
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570206,
					"content": "Evet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570207
					]
				},
				{
					"id": 741570207,
					"content": "#{M#Bay}{F#Bayan} {NICKNAME}, sizin güvenilir biri olduğunuzu biliyordum işte! Harikasınız! Bulle Meyvesi getirmiştim yanımda, siz de alın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570214
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570214,
					"content": "Molli iç çekerek el sallar. O tam oradan ayrılmak üzereyken...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741570215
					]
				},
				{
					"id": 741570215,
					"content": "Kapı açılır, Autumn ve Athos evden dışarı çıkar.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741570216
					]
				},
				{
					"id": 741570216,
					"content": "Biz de bu sesler ne diyorduk, sizmişsiniz meğer! Yine ne istiyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570217,
						741570219,
						741570222
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570217,
					"content": "Hiç, öyle geçiyorduk sadece.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570218
					]
				},
				{
					"id": 741570218,
					"content": "Gerçekten mi? Dünya küçük işte. Biz de tam Autumn ile yola koyulmak üzereydik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570219
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570219,
					"content": "Ya Benoit?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570220
					]
				},
				{
					"id": 741570220,
					"content": "O çoktan başka bir yere göçtü bile. Onun gittiği yere biz daha uzun yıllar gidemeyiz diyeyim, siz anlayın. Yani yakın zamanda ondan haber alacağınızı sanmam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570221
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570221,
					"content": "Gerçi ne malum yarın gitmeyeceğimiz tabii... Yarın doğacak güneşi görmek nasip olur mu, kim bilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570225
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570225,
					"content": "Benoit'yı göreceğim diye tutturan velet değil mi bu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570226
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570226,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570227
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570227,
					"content": "Merhaba hanımefendi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570228
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570228,
					"content": "Bu nasıl bir benzerlik. Eflatun gözlerin bile aynı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570229
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570229,
					"content": "H-Hanımefendi... Bir sorun mu var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570230
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570230,
					"content": "Sen kaç yaşındasın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570231
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570231,
					"content": "Dokuz yaşındayım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570232
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570232,
					"content": "Annenle babanın isimleri ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570233
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570233,
					"content": "Şey... Siz iyi misiniz hanımefendi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570234
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570234,
					"content": "Yüzün neden düştü öyle? Çocuğu da sorguya çektin birden... Bir dakika. Bu bir tesadüf olamaz herhalde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570235
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570235,
					"content": "Sen evlatlık mısın? Çabuk söyle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570236
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570236,
					"content": "#{M#Bay}{F#Bayan} {NICKNAME}, bu hanımefendiyi tanıyor musunuz? Neler diyor böyle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570237
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570237,
					"content": "Küçücük çocuğa böyle soru mu sorulur yahu? Bırak da ben konuşayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570238
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570238,
					"content": "Hatırladığım kadarıyla babamla çok iyi anlaşıyordunuz, değil mi küçük hanım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570239
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570239,
					"content": "Evet! Bay Leroy bana çok iyi davranır. O artık burada yaşamıyor mu acaba Damat Bey?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570240
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570240,
					"content": "Evet, o artık çok uzaklara gitti. Bir daha da geri dönmeyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570241
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570241,
					"content": "Babamla genelde nelerden bahsedersiniz, bana da anlatır mısın? Olur da görürsem onu ne kadar özlediğini kendisine iletirim mutlaka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570242
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570242,
					"content": "Bay Leroy bana hep atıştırmalık ikram eder. Nana'yı sevmeme izin verir, sonra da gözlerimin çok güzel olduğunu söyler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570243
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570243,
					"content": "Başka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570244
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570244,
					"content": "Bazen de annemle babama selamını iletir tabii ama onlar bundan çok rahatsız oluyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570245
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570245,
					"content": "Hele babam duyunca küplere biniyor. Bay Leroy'un kötü biri olduğunu, onlara \"şantaj\" falan yaptığını söylüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570246
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570246,
					"content": "Aslında buraya gelmemi yasaklamışlardı ama ben Bay Leroy ile bir anlaşma yaptım ve gizlice geldim. Lütfen babama söylemeyin beyefendi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570247
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570247,
					"content": "Tam da ondan beklenecek bir hareket. Nasıl da bulduğu her fırsata yapışıyor, insanın iliğini kurutuyor resmen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570248
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570248,
					"content": "... Alçak herif... Özür dilerim. Konumuza geri dönelim biz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570249
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570249,
					"content": "Beyefendi, hanımefendi... B-Başka bir şey yoksa ben artık evime gideyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570250
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570250,
					"content": "... Annen ve baban seni seviyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570251
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570251,
					"content": "Dünyanın en iyi anne ve babası onlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570252
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570252,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570253
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570253,
					"content": "Güzel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570254
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570254,
					"content": "O zaman ben eve gidiyorum! Hoşça kalın hanımefendi! Hoşça kalın beyefendi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570255
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570255,
					"content": "Güle güle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570256,
						741570257
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570256,
					"content": "Bu şekilde için rahat edecek mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570258
					]
				},
				{
					"id": 741570258,
					"content": "Ne kadar zamandır bunun hayaliyle yaşıyorum ben, bir bilseniz... Yine de onun mutlu olduğunu öğrenmek yeter bana. Onun mutluluğu benim için dünyalara bedel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570259
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570259,
					"content": "Ben... Ben babam gibi değilim. Bir anda çıkıp ailesine sorun yaratmak istemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570260
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570260,
					"content": "Şimdi tadını iyice kaçırmak istemem ama sen onun için bir müzik kutusu almıştın hani... Vermeyecek misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570261
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570261,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570262
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570262,
					"content": "Hayır, gerek yok... Oyuncak eksiği olan bir çocuk gibi durmuyor zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570263
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570263,
					"content": "Daha sonra onu ziyaret etmenin bir yolunu bulurum. Bir ihtiyacı olursa da karşılamak için elimden ne gelirse yaparım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570264
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570264,
					"content": "Bu müzik kutusunu da başka birine veririm artık. Alabilmek için o kadar uğraştım sonuçta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570265
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570265,
					"content": "Affedersin, beyaz saçlı küçük kız... Sen hediyeleri sever misin bakalım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570266
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570266,
					"content": "Paimon'u mu diyorsun? Bir dakika... Bunu Paimon'a mı vereceksin yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570267
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741570267,
					"content": "Evet. Bu sana hediyem olsun, lütfen kabul et. Umarım senin için az da olsa bir kıymeti olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570268
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570268,
					"content": "Özür dilerim Athos ama bir süre daha Fontaine Şehri'nde kalmamız gerekecek galiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570269
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741570269,
					"content": "Canını sıkma sen, benim için hava hoş. Hadi gidelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570270
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570270,
					"content": "Siz arkalarından bakarken ikisi birlikte uzaklaşarak sokaktan ayrılır. Böylece Leroy ailesinin hikayesi de burada son bulur.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 741570257,
					"content": "Ona gerçeği söylemeyecek misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570258
					]
				},
				{
					"id": 741570222,
					"content": "Benoit nasıl?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570223
					]
				},
				{
					"id": 741570223,
					"content": "Bu dünya adaletsizlik, sefalet ve bitmek bilmeyen bir açgözlülük ile dolu. Fontaine yasalarının verdiği cezalar yetersiz kalıyorsa kendi cezamızı kendimiz veririz elbet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570224
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570224,
					"content": "Yani diyorum ki Benoit hak ettiği yere gitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570225
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741570208,
					"content": "Söylemeyi unuttuk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570209
					]
				},
				{
					"id": 741570209,
					"content": "Cidden mi? Tüh... Bay Leroy'a bunu iletme fırsatı elimden tamamen kaçtı o zaman. Bu getirdiğim Bulle Meyvelerini de size vereyim o zaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570214
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570210,
					"content": "Hiç karşılaşmadık onunla.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570211
					]
				},
				{
					"id": 741570211,
					"content": "Hadi ya, hay aksi... Bay Leroy'u bir daha asla göremem de herhalde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570212
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570212,
					"content": "Yanımda ona vermek için birkaç Bulle Meyvesi getirmiştim. Tabii o artık burada yaşamadığına göre... Meyveleri siz alın hadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570213
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741570213,
					"content": "Ne olursa olsun ben Bay Leroy'u asla unutmayacağım! Hadi hoşça kalın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570214
					],
					"speakerTitle": "Molli"
				}
			]
		},
