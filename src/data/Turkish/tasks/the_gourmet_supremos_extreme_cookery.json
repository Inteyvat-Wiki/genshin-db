					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300204
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300204,
					"content": "Lütfen bir kamptaki tüm canavarları halledip diğerini bana bırak.",
