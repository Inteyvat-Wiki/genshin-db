						220300604
					]
				},
				{
					"id": 220300604,
					"content": "Tabii ki de. Çiçek tasarımından çaya, yemek pişirmeden kılıç tekniğine kadar mükemmelliğin peşinde gitmezsen hepsi anlamını kaybeder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300605
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300605,
					"content": "Benim yaşam tercihim \"ekstrem\" olmak. Ancak... Xudong'un farklı bir görüşü var gibi görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300606
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300606,
					"content": "Liyue'de \"kararında\" diye bir kelime olduğunu söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300607
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300607,
					"content": "Yaşarken ya da bazı şeyleri yaparken ekstrem olmaktan kaçınmak demekmiş. İki uca gitmeden kararında kalmak yaşamanın en iyi yoluymuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300608
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300608,
					"content": "Xudong'un tam olarak ne demeye çalıştığını pek anlamadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300609
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300609,
					"content": "Yine de bu tarz bir felsefeye varmak için çok şey yaşadığını düşünüyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300612
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300612,
					"content": "Yemek malzemelerini alıp yemeği pişirdiğimize göre daha fazla vaktini almayayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300613
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300613,
					"content": "Lütfen bunu al, ben de kalanını Xudong'a götüreyim. Eminim keyifle deneyecektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300610,
					"content": "Bu canavarları ne yapsak...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300611
					]
				},
				{
					"id": 220300611,
					"content": "Onların icabına zaten baktım, endişelenmeye gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300612
					],
					"speakerTitle": "Kamei Munehisa"
				}
			]
