			"dialogs": [
				{
					"id": 220300101,
					"content": "Yine karşılaştık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300102
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300102,
					"content": "Cüretimi mazur gör ama bugün bir konuda yardımına ihtiyacım var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300103,
						220300104
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300103,
					"content": "Ne oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300106
					]
				},
				{
					"id": 220300106,
					"content": "Xudong beni işe aldıktan sonra hep onunla ve diğerleriyle seyahat ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300107
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300107,
					"content": "Beni yanına aldığı için ona teşekkürlerimi sunmak adına birkaç hediye yapmak istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300108
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300108,
					"content": "Xudong yemek pişirmeyi dövüş sanatlarına tercih ettiği için bizzat yiyecek hazırlamak istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300109
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300109,
					"content": "Gereken yemek malzemeleri için iki konum buldum ve malzemeler olgunlaşınca onları toplamaya gitmeyi düşünüyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300110
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300110,
					"content": "Ancak bu iki konumu da işgal eden iki farklı canavar grubu var ve hepsi yemek malzemelerine el koymuş durumda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300111
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300111,
					"content": "Yemeği pişirmem için yemek malzemelerinin tazeliği benim için olmazsa olmaz. Malzemeleri önce bir yerden alıp sonra diğerine gitmeyi düşünüyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300112
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300112,
					"content": "Ama şimdi iki canavar grubu da yemek malzemelerini aldığı için yemeği pişirmek adına iki yemek malzemesini de almam gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300113
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300113,
					"content": "Yine de... Aynı anda iki yerde olamam. Canavarların icabına tek yerde bakabilsem bile canavarlar diğer taraftaki yemek malzemelerini mahvedecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300114
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300114,
					"content": "İşte bu yüzden yardımın gerek. Canavarları aynı anda yenerek yemek malzemelerini geri alacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300115,
						220300117
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300115,
					"content": "O zaman bu işi bana bırak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300116
					]
				},
				{
					"id": 220300116,
					"content": "Teşekkür ederim. Gerçekten ne kadar teşekkür etsem az.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300119
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300119,
					"content": "Hımm... Burada yemekten bahsedip durmayalım. Beni takip et de konuşmaya devam edelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300117,
					"content": "Yemeği pişirmen bitince ben de biraz alabilir miyim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300118
					]
				},
				{
					"id": 220300118,
					"content": "Tabii ki, tadına ilk sen bakacaksın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300119
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220300104,
					"content": "Bu kadar kibarlığa gerek yok...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220300105
					]
				},
				{
					"id": 220300105,
					"content": "Senden bir şey istediğim için bu tarz bir nezaket göstermem gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220300106
					],
					"speakerTitle": "Kamei Munehisa"
				}
			]
		},
