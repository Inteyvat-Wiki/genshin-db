					"content": "Bir tane şeker heykelcik lütfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380202
					]
				},
				{
					"id": 760380202,
					"content": "Buyur. Açtıktan sonra hemen ye, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
