				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760380310,
					"content": "(<color=#FFCC33FF>Lauma</color> şeker heykelcik ister mi?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380301
					]
				},
				{
					"id": 760380301,
					"content": "Rica etsem benim için birkaç tane hazırlayabilir misiniz Bayan Hunajatta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380302
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760380302,
					"content": "Tabii ki Bayan Lauma. Çocuklar son sefer götürdüklerinizi beğendiler mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380303
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380303,
					"content": "Hehe, beğendiler. Hatta bazıları bu göz alıcı atıştırmalıkları ancak erimeye yaklaşınca bozmaya ikna oldular.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380304
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760380304,
					"content": "Anladım... Bakın ne diyeceğim. Bir dahaki sefere aletlerimi de alıp sizinle geleyim. Çocuklara canlı istasyon kurarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380305
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380305,
					"content": "Ah, çok hoş olur bu. Çocuklar çok sevinecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380306
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760380306,
					"content": "Ha, şey, konudan saptık galiba. Ben gidip şeker heykelcikleri hazırlayayım. Bittiğinde Donuk Ayın Çocuklarına göndertirim biriyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380307
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380307,
					"content": "Ama ondan önce... Hehe, aklıma güzel bir fikir geldi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380308
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380308,
					"content": "Bir dakika bekleyin Bayan Lauma. Sizin için özel bir şey hazırlayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
		},
