				{
					"id": 760381006,
					"content": "Şey... Haha... Aslında bu sadece görevimden kaynaklanmıyor. Bazen yardıma ihtiyacı olan birine denk geliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381007
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381007,
					"content": "Sen de biliyorsundur, yarısı yenmiş şeker heykelcikleri saklamak zor oluyor. Hani en fazla bir beze sarıp cebime koyuyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381008
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381008,
					"content": "Ama işim bittikten sonra cebimden geri çıkardığımda hepsi eriyip gitmiş oluyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381009
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381009,
					"content": "Anlıyorum... Bir düşüneyim. Küçük bir şeker heykelcik... Hımm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381010
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381010,
					"content": "Buldum! Birden fazla aroması olan küçük bir heykel yapabilirim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381011
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381011,
					"content": "Bu aromayı alta... Sonra bunu da üste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381012
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381012,
					"content": "İşte! Al bakalım, çok aromalı minik bir şeker heykelcik! İstediğin gibi oldu mu sevgili müşterim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381013
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381013,
					"content": "Hah, mükemmel! Teşekkür ederim Bayan Hunajatta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381014
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381014,
					"content": "Lafı bile olmaz. Siz Ratniklere işlerinizde yardımcı olamayabilirim... Ama canınız şeker heykelcik çekerse istediğiniz kadar yaparım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381015
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381015,
					"content": "Bu bizim görevimiz. Çok naziksiniz Bayan Hunajatta... Ben artık gideyim, hâlâ bekleyen işler var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381016
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760381016,
					"content": "Tamam, kendine iyi bak! Bir dahaki sefere canın Şeker Heykelcik çekerse buyur gel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
		},
