						760380603
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380603,
					"content": "Tabii. Bayan Aino için herhalde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380604
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380604,
					"content": "Olumsuz. Aino benden gelip kendime güzel bir şeker heykelcik almamı istedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380605
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380605,
					"content": "Ona göre bu benim \"sosyal aktivite\" eğitimimin bir parçasıymış ve gelecekteki alışveriş deneyimlerimi kolaylaştıracakmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380606
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380606,
					"content": "Anladım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380607
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380607,
					"content": "Ben anlamadım. Bu kadar şeker tüketmeye ihtiyacım yok benim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380608
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380608,
					"content": "Aino'nun bu heykeli gizli gizli yiyeceğinden şüpheleniyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380609
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380609,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380610
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380610,
					"content": "Bayan Hunajatta, rica etsem daha ufak boyutlu bir şeker heykelcik yapabilir misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380611
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 760380611,
					"content": "Aino şekeri seviyor fakat bence daha az miktarda yemeli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380612
					],
					"speakerTitle": "Ineffa"
				},
				{
