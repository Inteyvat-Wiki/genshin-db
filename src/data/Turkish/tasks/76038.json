					"nextDialogs": [
						760380501
					]
				},
				{
					"id": 760380501,
					"content": "Selam patron! Bir şeker heykelcik lütfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380502
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760380502,
					"content": "Aa, Bayan Aino! Ne zamandır göremiyorduk sizi burada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380503
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380503,
					"content": "Hehe. Kasabaya birkaç eşyayı tamir etmeye geldim. Gelmişken uğrayıp şeker alayım dedim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380504
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760380504,
					"content": "Ayrıca Ineffa da yakınlarda değil, o yüzden... Bana fazladan birkaç tane yapar mısın? Ekstra tatlı olsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380505
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760380505,
					"content": "Tabii... Ama yedikten sonra dişlerinizi fırçalayın, olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380506
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380506,
					"content": "Evet evet, biliyorum, biliyorum. Şeker yedikten sonra dişlerimi fırçalarım zaten hep! Dişlerim süper müthiş durumda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380507
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 760380507,
					"content": "Haha... Kısa bir süre bekleteceğim sizi o zaman...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
