			"dialogs": [
				{
					"id": 760381109,
					"content": "(<color=#FFCC33FF>Linnea</color> şeker heykelcik ister mi?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760381101
					]
				},
				{
					"id": 760381101,
					"content": "Aa, merhaba Bayan Linnea! Yine Lumi için şeker heykelcik almaya mı geldiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381102
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381102,
					"content": "Aynen öyle! Lumi senin şeker heykelciklerini o kadar çok seviyor ki yemeye kıyamıyor, sadece bir kez yalayıp saklamam için bana veriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381103
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 760381103,
					"content": "Ama şekerden yapıldıkları için... Eninde sonunda eriyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381104
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 760381104,
					"content": "Size zahmet olmazsa bir tane daha yapar mısınız Hunajatta Hanım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381105
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 760381105,
					"content": "Tabii! Bir saniye lütfen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381106
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381106,
					"content": "(Lumi çok tatlı, onu sevmek istiyorum! Ama bu biraz kabalık olur sanki. Neyse...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381107
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381107,
					"content": "Buyurun Bayan Linnea. Bir adet şeker heykelcik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760381108
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760381108,
					"content": "Teşekkür ederim! Lumi, şeker heykelciğin hazır, şimdi yemek ister... Aaa, uyuyakalmış. Daha sonra veririm artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnea"
				}
			]
		}
