					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760380703,
					"content": "Buraya ilk gelişin değil Jahoda. Bildiğin üzere tüm şeker heykelciklerinin boyutu aynı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380704
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380704,
					"content": "Hadi ama, bugün her şey yolunda gidiyor! Acele et, her zamankinden biraz daha büyük olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380705
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760380705,
					"content": "Her şey yolunda mı gidiyor? Görevin güzel geçti herhalde, öyle mi?",
