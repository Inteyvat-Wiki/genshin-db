					"nextDialogs": [
						760380706
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380706,
					"content": "Hehehe, tabii ki. Basit bir refakatçilik göreviydi. Şipşak hallediverdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380707
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760380707,
					"content": "Müşterinin kılına dahi zarar gelmedi, mallar da aynı şekilde sapasağlam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380708
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760380708,
					"content": "Neyse, bu kadar sohbet yeter. Hadi heykelciği hazırla hemen ama paket olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380709
					],
					"speakerTitle": "Jahoda"
				},
				{
