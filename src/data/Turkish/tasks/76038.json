			"dialogs": [
				{
					"id": 760380409,
					"content": "(<color=#FFCC33FF>Flins</color> şeker heykelcik ister mi?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760380401
					]
				},
				{
					"id": 760380401,
					"content": "Bayan Hunajatta, zahmet olmazsa bana bir şeker heykelcik yapabilir misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380402
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760380402,
					"content": "Tabii. Sen... Ratnik Flins'sin, değil mi? Galiba seni daha önce bizim dükkanda görmüştüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380403
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380403,
					"content": "Görmüşsünüzdür, evet. Bazen uğrayıp malzeme alıyorum. Hatırlanmak benim için bir onurdur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380404
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760380404,
					"content": "Bugün de buradan geçerken şeker şekillendirme sanatındaki ustalığınıza tanık oldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380405
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760380405,
					"content": "Uzun uzun düşündükten sonra sizden bir heykel rica etmeye karar verdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380406
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760380406,
					"content": "Lütfen, bu kadar kibar olmana gerek yok. Beni mahcup ediyorsun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380407
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380407,
					"content": "Bir dakika lütfen, heykel hemen geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760380408
					],
					"speakerTitle": "Hunajatta"
				},
				{
					"id": 760380408,
					"content": "Hımm... İyi kalpli Ratnikimiz için özel bir şey yapsak iyi olur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hunajatta"
				}
			]
