			},
			"dialogs": [
				{
					"id": 710220101,
					"content": "Şey, sıra Tianqiu Vadisi'nde mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220102
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220102,
					"content": "Bir sorun mu var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220103
					]
				},
				{
					"id": 710220103,
					"content": "#Ah, {NICKNAME} gelmiş. Seninle karşılaşmayı beklemiyordum, güzel bir sürpriz oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220104
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220104,
					"content": "Şey, neyse... Yakın zamanda Tianqiu Vadisi ya da Nantianmen civarına uğradın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220107
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220107,
					"content": "Son zamanlarda Loncaya bu bölgede yaşanan depremlerle ilgili bir sürü haber geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220108
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220108,
					"content": "Başlangıçta sadece küçük şikayetlerden ibaretti ama zamanla hem sayıları hem de ciddiyetleri giderek arttı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220109
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220109,
					"content": "Yakın dönemde de güçlü bir deprem yaşandığı, dağların bir kısmının ve bazı harabelerin çöktüğü haberi geldi. Çöküntülerin arasından devasa bir mağara ortaya çıkmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220110
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220110,
					"content": "Raporlara göre bölgede ne olduğu bilinmeyen birtakım canavarlar görülmüş. Görgü tanıklarının tasvirlerine göre bunların bir zamanlar Liyue'de dehşet saçan Toprak Ejderleri ya da Kadim Toprak Ejderleri olma ihtimali çok yüksek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220111
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220111,
					"content": "Yardıma ihtiyacın var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220112
					]
				},
				{
					"id": 710220112,
					"content": "Tianqiu Vadisi'ne gidip mağarayı araştırmanı ve depremin çevreye olan etkisini raporlamanı rica edebilirim senden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220113
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220113,
					"content": "Canavarlara gelince... Söylendiği gibi kalabalık gruplar halinde geziyorlarsa varlıklarını yok sayamayız. Ne gibi önlemler alacağımıza karar vermemiz gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220114
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220114,
					"content": "Tabii ki tüm bunlar resmi bir Lonca işi olacak ve bu bağlamda ödeme alacaksın. Yardım edecek misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220115
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220115,
					"content": "Olur, ederim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220116
					]
				},
				{
					"id": 710220116,
					"content": "Çok teşekkür ederim. Bölgeyi araştırırken dikkati elden bırakma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiping"
				}
			]
		},
