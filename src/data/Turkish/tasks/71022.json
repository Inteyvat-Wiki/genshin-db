				},
				{
					"id": 710220212,
					"content": "Tabii ki tüm bunlar resmi bir Lonca işi olacak ve bu bağlamda ödeme alacaksın. Yardım edecek misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220213
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220213,
					"content": "Yüz ifaden değişti sanki... Bir şey mi oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220214
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220214,
					"content": "Şey, oraya yakın zamanda gittim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220215
					]
				},
				{
					"id": 710220215,
					"content": "Gittin demek? Ne de olsa seçkin bir maceracısın. Tehlikenin kokusunu alıp o tarafa yönelmen gayet doğal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220216
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220216,
					"content": "Tianqiu Vadisi ve Kadim Toprak Ejderleri hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220217
					]
				},
				{
					"id": 710220217,
					"content": "İçinde Kadim Toprak Ejderi olan devasa bir mağara harabesi demek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220218
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220218,
					"content": "Tamamdır. Sanırım anladım. Haber verdiğin için çok teşekkür ederim. Ben belge işlerini halledip Loncaya resmi rapor olarak sunacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220219
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220219,
					"content": "Bu bölge nasıl bu hale gelmiş?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220220
					]
				},
				{
					"id": 710220220,
					"content": "Bazı metinlere göre Tianqiu Vadisi eskiden halkın refah içinde yaşadığı, kadim bir geçmişe sahip olan bir yerleşkeymiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220221
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220221,
					"content": "Bu hale gelme nedeninin kadim bir ejderha kralı olduğu anlatılır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220222
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220222,
					"content": "Olayla ilgili fazla detay yok ancak efsaneye göre Rex Lapis ve Adeptuslar nihayetinde onu bir çeşit Adeptus diyarının içine hapsetmeyi başarmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220223
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220223,
					"content": "Hizmetkarları da yeryüzünün derinliklerine gizlenip ejderha kralın yeniden yükseleceği günü beklemek üzere derin bir uykuya dalmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220224
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220224,
					"content": "Yani o gördüğümüz canavarlar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710220225
					]
				},
				{
					"id": 710220225,
					"content": "Hahaha, bunlar halk efsanelerinden ibaret. Kimse gerçek olup olmadığını bilmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220226
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220226,
					"content": "Yine de bu depremler ve aniden ortaya çıkan canavarlar derhal çözülmesi gereken sorunlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710220227
					],
					"speakerTitle": "Zhiping"
				},
				{
					"id": 710220227,
					"content": "İşte, ödemen de burada. Bilgiler için teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiping"
				}
			]
		},
