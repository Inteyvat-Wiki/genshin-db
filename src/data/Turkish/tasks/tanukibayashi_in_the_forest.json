			"dialogs": [
				{
					"id": 721081101,
					"content": "Burası mıymış? Bunlar sadece taş ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721081102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721081102,
					"content": "Hımm? Büyü mü yapıyor o?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721081103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721081103,
					"content": "Vay canına! Taşlar kayboldu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721081104,
						721081105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721081104,
					"content": "Harika bu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721081106
					]
				},
				{
					"id": 721081106,
					"content": "Bake-danuki büyüsü buymuş demek. Eğlenceli duruyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721081107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721081107,
					"content": "Teşekkürler Kichiboushi! Daha sonra tekrar buluşup yine Saklambaç oynayalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721081108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721081108,
					"content": "Hım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Kichiboushi\""
				},
				{
					"id": 721081105,
					"content": "Biraz ürkütücüydü.",
