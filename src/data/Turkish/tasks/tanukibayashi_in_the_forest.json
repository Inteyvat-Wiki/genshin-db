			"dialogs": [
				{
					"id": 721080931,
					"content": "Ne? Bu kadar önemli olduğunu bilmiyordum. Neden baştan söylemediniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080932
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080932,
					"content": "Off, o kadar uzun süredir burada mühürlüyüm ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080933,
						721080934,
						721080935
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080933,
					"content": "Yüz yıl mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080936
					]
				},
				{
					"id": 721080936,
					"content": "Off! Başıma gelenlerle dalga geçmeyi kesin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080937
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080937,
					"content": "Neyse. Bunları geçmişte bırakalım artık. Ormanın yanındaki bariyerin nerede olduğu hakkında ipucu vereyim size.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080938
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080938,
					"content": "Sinsi Kitsuneyle savaşırken doğu sahilinde bariyeri gördüğümü anımsar gibiyim. Torii kapısı olan bir Yıldırım Kirazına benziyor değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080939
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080939,
					"content": "Adam o tuhaf, şeytan benzeri varlıklarla savaşırken ucunun bize de dokunmasından korktum. Olası bir zararı engellemek için bölgeyi büyüyle mühürledim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080940
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080940,
					"content": "Bir düşüneyim. Mühür yamacın doğuya bakan tarafında olsa gerek... Kichiboushi, onlara yolu gösterip mührü kaldır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080941
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080941,
					"content": "Teşekkürler Ioroi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080942
					]
				},
				{
					"id": 721080942,
					"content": "Tamam tamam. Bu kadar laf salatası yeter. Gidin artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080943
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080943,
					"content": "O sinsi Kitsuneyle karşılaşacak olursanız selamımı iletin. Hatta aynen şunları söyleyin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080944
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080944,
					"content": "\"Beni iyi tongaya getirdin seni aşağılık tilki. Sıkıyorsa gel de dövüş benimle, yarışmamız henüz sona ermedi! Hazır gelmişken mührümü de kır hatta. Ben de kırarım kırmasına ama sonuçta bana iyilik borcun var! Gyoubu Koban da seni özlediğini söylüyor!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080945
					],
					"speakerTitle": "Ioroi"
				},
				{
					"id": 721080945,
					"content": "Yavaş ol biraz, hepsini hatırlayamayız ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721080934,
					"content": "Bin yıl mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080936
					]
				},
				{
					"id": 721080935,
					"content": "Bir milyon yıl mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080936
					]
				}
