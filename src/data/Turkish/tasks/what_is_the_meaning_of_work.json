						240111402
					]
				},
				{
					"id": 240111402,
					"content": "Tamam ama sadece... Onları kovalayın yeter. Kötü bir niyetleri yok, sadece patatesimi istiyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111403
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111403,
					"content": "Yani elbette benim için kötü bir durum ama çok da ciddi bir şey değil, o yüzden... Lütfen sadece onları kovala, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
