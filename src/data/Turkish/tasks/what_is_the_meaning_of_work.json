			"dialogs": [
				{
					"id": 240111201,
					"content": "Iı, başka bir yerde yesen olmaz mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111202
					]
				},
				{
					"id": 240111202,
					"content": "Şimdi yemeğimi yiyebileceğim daha iyi bir yer bulamıyorum. Mermonia Sarayı'na çok yaklaşırsam iş arkadaşlarımdan biriyle karşılaşabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111203
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111203,
					"content": "Karşılaşırsam da tekrar işle ilgili muhabbetlerine katılmam gerekir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111204
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111204,
					"content": "Ama çok uzaklaşırsam da işe yetişemem ve önemli bir şeyi kaçırabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111205
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111205,
					"content": "Bu iki şeyi hesaba katınca burası yemek yiyebileceğim tek yer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				}
			]
		},
