			"dialogs": [
				{
					"id": 240111301,
					"content": "Of, Mor Altın Balıkçı Martı. Patateslerinizi yiyip gidin lütfen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111302,
						240111303
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111302,
					"content": "Durumlar nasıl?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111304
					]
				},
				{
					"id": 240111304,
					"content": "Hayır, hiç yaramadı. Martılar geldiğinde kuyruğunu indirip titreyerek arkama saklandı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111305
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111305,
					"content": "*iç çeker* Köpeği suçlamıyorum. Ne de olsa onun tek görevi sevmek ve sevilmek. Daha önce saldırmayı hiç öğrenmedi ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111306
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111306,
					"content": "Bu bizim de görevimiz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111307
					]
				},
				{
					"id": 240111307,
					"content": "Belki de. Ancak bazı durumlar da sevgi de bir \"haktır\". Ve işin içine bunlar girince genelde her şey daha zor yoldan ilerler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111308
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111308,
					"content": "Pardon, çok konuştum. Bugün çok duygusal anlaşmazlıklara ara buluculuk yapmam gerekti ve henüz kendimi toparlayamadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240111309
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111309,
					"content": "*iç çeker* Ama şimdi asıl mesele bu patatesi nasıl rahatça bitireceğimi bulmak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240111303,
					"content": "Bir köpek sahiplensen iyi olmaz mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240111304
					]
				}
			]
