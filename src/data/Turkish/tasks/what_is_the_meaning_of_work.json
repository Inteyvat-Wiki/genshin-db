			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iaune"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240110101,
					"content": "Ah, güzel martılar. Aç olduğunuzu biliyorum ama ben de henüz yemeğimi yiyemedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110102
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110102,
					"content": "Neyse. Sanırım siz mutlu olduğunuz sürece...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110103
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110103,
					"content": "Ne yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110104
					]
				},
				{
					"id": 240110104,
					"content": "Gezgin? Bu ne büyük sürpriz. Benden bir şey isteyeceksen biraz beklemen lazım. Henüz patateslerimi bitirmedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110105,
						240110107
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110105,
					"content": "Buraya iş için gelmedim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110106
					]
				},
				{
					"id": 240110106,
					"content": "Ah, öyle mi? İyi o halde. Bunları bir an önce yiyip bitirmem lazım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110108
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110108,
					"content": "Yani ana yemeğim bu. Daha sonra Roialte ile bir işe gideceğimiz için bu yemeği hızlıca bitirmem lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110109
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110109,
					"content": "Mermonia Sarayı içinde yemek yemeye alışkın değilim, o yüzden dışarı çıkıp sessiz sakin bir yer bulurum ve yemeğimi hızla yerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110110
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110110,
					"content": "Ama bugün... Bu martıların derdi ne anlayamadım. Birlik olup sürekli patateslerime saldırıp duruyorlar, hiçbir şekilde de doymak bilmiyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110111,
						240110112
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110111,
					"content": "Yani çok martı ama azıcık patates var, gayet normal...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110113
					]
				},
				{
					"id": 240110113,
					"content": "Doğru. Ama okyanustaki tüm martıları da besleyemem ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110114
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110114,
					"content": "Bunlar senin patateslerin, değil mi? Sakın martıların onları böyle almasına izin verme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240110115,
					"content": "Yoksa aç kalırsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110116,
						240110117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240110116,
					"content": "Aslında seni biraz üzgün gördüm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110118
					]
				},
				{
					"id": 240110118,
					"content": "Gerçekten mi? Ben... Evet, aslında pek de iyi değilim. Gözünden hiçbir şey kaçmıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110119
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110119,
					"content": "Sadece... İşimin ne anlamı olduğunu bilmiyorum. Hukuk Dairesinde her gün çalışıyorum ama emeklerimin meyvesini hâlâ alamadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110120
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110120,
					"content": "Kimseye yardım edemedim veya çalışmalarım kimsenin hayatını daha kolay hale getirmedi. Roialte, işimizin çok önemli olduğunu söylüyor ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110121
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110121,
					"content": "Tüm gün daktilonun başında oturup tıkır tıkır yazı yazıyorum. Ama ne için? Bir tane tuş kaybetsem ne olur? En azından Estelle bu şekilde daha fazla Mora kazanabilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110122
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110122,
					"content": "Pardon. Tüm bunları dile getirmemem gerektiğini biliyorum ama şu anda ne yaparsam yapayım kendimi tamamen kaybolmuş hissediyorum. Belki... Belki daha fazla zamana ihtiyacım vardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110123,
						240110124
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110123,
					"content": "Önce yemeğini bitir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110125
					]
				},
				{
					"id": 240110125,
					"content": "Haklısın. Ama biraz daha patates kızartması almak için zamanımız yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110126
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110126,
					"content": "Boş ver, geri kalanını da kuşlara vereceğim. Roialte ile işim bittikten sonra yiyecek bir şey bulurum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110127
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110127,
					"content": "İşimiz ne kadar sürecekti? Yarım gün falan sanırım. O kadar da uzun değil bence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110128
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110128,
					"content": "Yemek yemeden o kadar dayanabilecek misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110129,
						240110130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240110129,
					"content": "Martıları bana bırak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110131
					]
				},
				{
					"id": 240110131,
					"content": "Şey... Çok zahmet etmiş olmaz mısın? Sonuçta birazcık patates kızartması yani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240110132
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240110132,
					"content": "Sen yemeğine bak. Ne kadar meşgul olursan ol aç kalmaman lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240110130,
					"content": "O martıların icabına ben bakarım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110131
					]
				},
				{
					"id": 240110124,
					"content": "Önce senin şu martı sorununu çözelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110125
					]
				},
				{
					"id": 240110117,
					"content": "İyi görünmüyorsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110118
					]
				},
				{
					"id": 240110112,
					"content": "Henüz hepsinin karnı doymadı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110113
					]
				},
				{
					"id": 240110107,
					"content": "Neden burada patates kızartması yiyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240110108
					]
				}
			]
		},
