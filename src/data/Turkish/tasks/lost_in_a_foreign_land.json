			"dialogs": [
				{
					"id": 710580101,
					"content": "*öksürür* B-Bekle! Dur! Sen kimsin? Neden buradasın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580102
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580102,
					"content": "Bana neden saldırıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580103
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580103,
					"content": "Daha konuşuyor bak! Seni buralarda sinsice dolaşırken gördük.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580104,
					"content": "Buradaki kötü adam sensin, önce sen açıkla!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580105
					]
				},
				{
					"id": 710580105,
					"content": "Katarina. Benim adım Katarina Snezhevna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580106
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580106,
					"content": "Adımdan başka bilgi veremem size. Özür dilerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580107
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580107,
					"content": "Sadece ne olup bittiğini bilmek istiyoruz. Seni sorguya çekmeye çalışmıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580108,
					"content": "Ü-Üzgünüm. Gerçekten başka bir şey söyleyemem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580109
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580109,
					"content": "Fatui'nin burada ne işi var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580110
					]
				},
				{
					"id": 710580110,
					"content": "Bu bilgi çok gizli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580111
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580111,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580112
					]
				},
				{
					"id": 710580112,
					"content": "Kötü adamlar da sır saklamaya amma meraklıymış!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580113,
					"content": "Hehe, haklısın. Biz kötü adamlarız ve bizim işimiz bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580114
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580114,
					"content": "Pekala, soru cevap vakti bitti. Misafirlerimiz var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katarina"
				}
			]
		},
		{
