			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katarina",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710580501,
					"content": "Ben de senin gelmeni bekliyordum. Buyur, otur lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580502
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580502,
					"content": "Ne kalmış bakalım. Siyah çay bitmiş. Şeker de bitmiş. Pekala, biraz süt var. Öf, çoktan ekşimiş. Bunu sonra atmam lazım. Hım, pardon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580503
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580503,
					"content": "Bolca Ateş Suyu var. Yanına biraz peksimet ve vişne reçeli de eklersek çay partisi için yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580504
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580504,
					"content": "Vay canına! Bir çay partisinde Ateş Suyu içmek, sizce gerçekten normal mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580505,
					"content": "Evet, bunda ne var ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580506,
						710580508
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580506,
					"content": "Yok, ben almayayım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580507
					]
				},
				{
					"id": 710580507,
					"content": "Ne? Hehe, burada kimse seni içkiden dolayı azarlamaz. Keyfine bak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580510,
						710580511
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580510,
					"content": "Ne yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580512
					]
				},
				{
					"id": 710580512,
					"content": "\"Doğru zamanda yemek ve bilgi paylaşmak, meraktan çatlayanları susturmak için en iyisidir.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580513
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580513,
					"content": "El kitabımızda böyle yazıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580514
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580514,
					"content": "Peki, paylaşacağın bilgi nerede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580515
					]
				},
				{
					"id": 710580515,
					"content": "Bilgi mi? Demin paylaştım ya işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580516
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580516,
					"content": "Ne? Bize bir şey söyledin mi ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580517,
					"content": "Fatui Öncü Takımı El Kitabı, Ek 4-4, 32. Madde: \"Doğru zamanda yemek ve bilgi paylaşmak, meraktan çatlayanları susturmak için en iyisidir.\" Rica ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580518
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580518,
					"content": "Sen benim hayatımı kurtardın, ben de el kitabımızdan gizli bir içeriği paylaştım. Hehe, ne kadar da samimiyim değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580519
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580519,
					"content": "Bu bizim ne işimize yarayacak ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580520,
					"content": "Hehe, şaka bir yana... Esasında yardımların için çok minnettarım. Lütfen iyi niyetimi yanlış yorumlama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580521
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580521,
					"content": "Şimdiye kadar yaptıklarınız göz önüne alındığında, Paimon \"iyi niyetinize\" inanmakta zorluk çekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580522,
					"content": "Gerçekten ne iş çeviriyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580523
					]
				},
				{
					"id": 710580523,
					"content": "Yabancıların Fatui'nin amacını anlamaması şaşırtıcı değil. Hedeflerimizden veya hangi tarafta olduğumuzdan bahsetmediğimizde, bizler de sadece sıradan insanlarız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580524
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580524,
					"content": "Ayrıca yaptığımız her bir iş, nihai savaşa bir hazırlıktan ibaret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580525
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580525,
					"content": "Nihai savaş mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580526
					]
				},
				{
					"id": 710580526,
					"content": "Evet, sonunda hepimiz ortak bir düşmana ve kaçışı olmayan uzun geceye karşı savaşacağız. Snezhnaya'daki herkes bu konuda uyarıldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580527
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580527,
					"content": "Böylece, bu zalim dünya uğruna dökülen hiçbir gözyaşı ve insan kanı boş yere dökülmemiş olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580528
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580528,
					"content": "Hadi kadeh kaldıralım. İstemiyor musun? Pekala, o zaman ben de tek başıma içerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580529,
						710580531
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580529,
					"content": "Yaptığın kötülükleri böyle mi savunuyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580530
					]
				},
				{
					"id": 710580530,
					"content": "Belki de haklısındır... Bilmiyorum ve bilmek de istemiyorum. Bir açıklama istedin, ben de sana istediğini verdim. Açıklamayı beğenip beğenmemekte özgürsün. Hepsi bu kadar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580534
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580534,
					"content": "Tüm bu derin laflar nereden çıktı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580535
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580535,
					"content": "Bu arada ben kendimi tanıttım ama hâlâ senin ismini bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580536,
						710580537
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580536,
					"content": "#{NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580538
					]
				},
				{
					"id": 710580538,
					"content": "Ve Paimon'un adı da Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580539
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580539,
					"content": "Adlarınız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580540
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580540,
					"content": "Hehehe! Teyvat'ın her yanında tanınıyoruz, öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580541,
					"content": "Üzgünüm, ikinizin de adını hiç duymadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580542
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580542,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580543
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580543,
					"content": "Lütfen yanlış anlama. Buraya uzun zaman önce gönderildim. Yüzeyde neler olup bittiği konusunda, tedarik hatlarından aldığımız haberlerden başka hiçbir şey bilmiyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580544
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580544,
					"content": "Yani bu demek oluyor ki...",
