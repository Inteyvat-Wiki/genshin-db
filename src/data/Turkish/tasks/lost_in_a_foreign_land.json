			},
			"dialogs": [
				{
					"id": 710580201,
					"content": "Beni arkadan bıçaklamadığın için teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580202,
						710580203
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580202,
					"content": "Duygularımız karşılıklı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580204
					]
				},
				{
					"id": 710580204,
					"content": "Bu izlenimi nereden edindiğini bilmiyorum ama burası romantizm için hiç uygun bir yer değil. Konuşmak istiyorsan sığınağıma gel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580207
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580207,
					"content": "Katarina gider.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710580205
					]
				},
				{
					"id": 710580205,
					"content": "O bir Fatui Üyesi değil mi? Onu Taşordu'ya göndermek yerine, kaçmasına izin vermek doğru bir şey mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580206,
					"content": "Hıh... Tamam, Paimon anladı. Boş ver. Sonuçta bize zarar vermedi. Bu seferlik onu affedebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710580203,
					"content": "Demek, Fatui'nin hepsi güven sorunu yaşıyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710580204
					]
				}
			]
		},
		{
			"id": 7105805,
			"completionStepIds": [
				7105806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105806",
							"2"
						],
						"stepId": 7105806,
						"stateName": "QUEST_STATE_UNFINISHED"
