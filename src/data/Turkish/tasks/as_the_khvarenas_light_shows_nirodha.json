			"dialogs": [
				{
					"id": 732562701,
					"content": "Notlarda yazdığı gibi... Hım? Ne çabuk döndünüz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562702
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562702,
					"content": "Görünüşünüze bakılırsa ihtiyacımız olan Enerji Blokunu bulmuşsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562703
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562703,
					"content": "Ben de bu Enerji Çekirdeklerini inceledim... Çok iyi durumdalar. Şimdi geriye bir tek Enerji Blokunu Çekirdeklere yerleştirmek kaldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562704
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562704,
					"content": "... Bu işi size bırakıyorum.",
