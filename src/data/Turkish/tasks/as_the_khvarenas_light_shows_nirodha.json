					"Nasejuna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732561001,
					"content": "Enerji Çekirdekleri doldu. Artık kontrol sistemlerini etkinleştirebiliriz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561002
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561002,
					"content": "Hım? Bunu beklemiyordum. Bir yerde sorun mu var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561003
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561003,
					"content": "Aktarıcıların olduğu kontrol merkezine bir daha gitmemiz gerekiyor sanırım. Neyse, zaten sınama alanına giderken yolumuzun üstünde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561004
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561004,
					"content": "Sanırım Kontrol merkezi geldiğiniz yönde kaldı. O zaman beraber gidelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nasejuna"
				}
			]
		},
		{
			"id": 7325612,
			"completionStepIds": [
				7325612
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
