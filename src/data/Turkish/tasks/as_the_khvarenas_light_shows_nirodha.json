					"Sorush"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732561201,
					"content": "Tahmin ettiğim gibiymiş. Sorun aktarıcılarda. Enerji Çekirdeklerinden gelen enerji, aktarıcılara ulaşmıyor. Aralarında bağlantı kurmanın bir yolunu bulmalıyız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561202
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561202,
					"content": "Buradaki aktarıcıların bazıları kristallerle mühürlenmiş ama... Bu harabeler enerji kaynağı olarak kirliliği kullanmadığından Khvarena'nın dikkatini çekmemiş olmalıydı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561203
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561203,
					"content": "Aklıma gelen tek mantıklı açıklama bu yerin Khvarena kullanabilen biri tarafından kasten mühürlendiği. İyi de niye böyle bir şey yapsınlar ki? Saklamaya çalıştıkları bir şey mi var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561204
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561204,
					"content": "Neyse, bunu sonra konuşuruz. Şu an Khvarena'nın gücünü kullanarak bu mühürleri oluşturan Boz Kristalleri kaldırmamız gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561205
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561205,
					"content": "Yakında Khvarena'nın gücünü barındıran Farr Fitilleri olmalı. Siz de hissedebiliyorsunuzdur, değil mi yüce Elçim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561206
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561206,
					"content": "Iıı... Hıh. Tabii ki! Çiçek Muhafızı olarak kudretimden şüphe mi ediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561207
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732561207,
					"content": "Asla, öyle bir şeye cüret edemem! Görkemli Elçimiz, lütfen bize yolu gösterin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732561208
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732561208,
					"content": "Farr Fitillerini bulmamız, Boz Kristalleri kaldırmamız ve sonra karıştırıcıyı bir daha kullanarak bu aktarıcıları bağlamamız gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nasejuna"
				}
			]
		},
