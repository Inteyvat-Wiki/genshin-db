				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732560401,
					"content": "İşte kader anı geliyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560402
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560402,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732560403
					]
				},
				{
					"id": 732560403,
					"content": "Bildiğimiz mekanik bir kapı bu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732560404,
					"content": "Öhöm. Bu mekanik kapıyı açarsak harabelere ulaşabileceğiz anlamında söylemiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560405
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560405,
					"content": "Haha, ilk kez bir Dahri harabesine giriyorum. Heyecanlanmış olmam şaşırtıcı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560406
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560406,
					"content": "Hı? O kadar kendinden emin konuşuyordun ki Paimon bugüne dek bir sürü harabe gezdiğini düşünmüştü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732560407,
					"content": "Hah! Bizzat gezdiğimi söyleyemem. Ama elimde \"Rene'nin Araştırma Notları\" başlıklı muhteşem bir belge var. Eski zamanlarda yaşamış muazzam bir alim tarafından yazılmış. Okuyunca harabeleri kendim gidip gezmiş gibi hissettim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560408
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560408,
					"content": "\"Rene'nin Araştırma Notları\" mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732560409
					]
				},
				{
					"id": 732560409,
					"content": "Hiç duymadınız mı? René kadar büyük bir alimi ancak benim gibi çölün bir köşesinde ve dünyadan uzakta yaşayan biri bilmez sanırdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560410
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560410,
					"content": "Bu notlarda Dahri halkının bıraktığı bir sürü kayıt bulunuyor. Yazar bir keresinde bu harabelerde \"fanilerin boyunu aşan\" bilgiler bulduğunu söylemiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560411
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560411,
					"content": "İnandırıcılığı gittikçe azalıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732560412,
					"content": "Bu konuyu şimdilik bir kenara koyalım. Elimizde bu notlar olduğuna göre Dahri harabelerine girmek çocuk oyuncağı olacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560413
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560413,
					"content": "Bana inanmıyorsanız gelin deneyelim! Mesela bu cihazı açmak istersek... Hah, işte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560414
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560414,
					"content": "<color=#00E1FFFF>\"Çarkları üç run tipi görünene kadar çevirin. Kare runu tabandaki üçgene, üçgeni değiştirmeden bağlayın.\"</color> Bu anlattıklarımı uygularsanız sorunsuzca halletmiş oluruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nasejuna"
				}
			]
		},
