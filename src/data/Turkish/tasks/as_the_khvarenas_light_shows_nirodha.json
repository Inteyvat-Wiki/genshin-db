					"nextDialogs": [
						732560717
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560715,
					"content": "Paimon'a da. Sumeru'nun başka bir yerinde kullandığımız şu dev makinada da benzer cihazlar bulmamış mıydık?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732560716,
					"content": "Demek bu cihazları daha önce gördünüz, öyle mi? Güzel, bu işimizi kolaylaştırır.",
					"roleType": "TALK_ROLE_NPC",
