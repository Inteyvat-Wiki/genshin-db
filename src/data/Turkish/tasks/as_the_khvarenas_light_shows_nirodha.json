			},
			"dialogs": [
				{
					"id": 732562001,
					"content": "Yerden şu tuhaf top çıktı! Topla şuradaki büyük makinayı vurmamız mı gerekiyor acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732562002,
					"content": "Hımm... Cidden düşünülerek yapılmış bir tasarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732562003,
					"content": "Gerçekten sıra dışı bir hayal gücüne sahipsin Beyaz Pofuduk. Bu yerin değiştirilmeden önce makinaları test etmek için bir sınama alanı olduğunu söylememiş miydi Nasuraia?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562004
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732562004,
					"content": "Daha önce açtığımız cihaz meğerse bu sınama alanını etkinleştirmek için kullanılıyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562005
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732562005,
					"content": "Fakat yapılan değişikliklerde belli ki burada önceden bulunan cihazlara dokunulmamış. Faydalı bir keşif oldu bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562006
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732562006,
					"content": "O halde bu topu kullanma şerefi senin Yasnapatim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sorush"
				}
			]
		},
		{
			"id": 7325623,
			"completionStepIds": [
				7325623
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
