			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nasejuna",
					"Sorush"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732562301,
					"content": "Yüce Elçim ve şerefli Yasnapatisi, korkarım size buradan sonra eşlik edemeyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562302
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562302,
					"content": "Bu defa ne oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732562303
					]
				},
				{
					"id": 732562303,
					"content": "Yazanlara göre yolun ilerisinde sıradan fanilerin başa çıkamayacağı tehlikeler kol geziyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562304
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562304,
					"content": "Girdiğimizde Dahrililerin eskiden makinalarını test ettiği bir sınama alanına varacağız. İçlerinde henüz tamamlanmamış devasa bir makina prototipi de var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562305
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562305,
					"content": "Notlarımdaki Dahri kayıtlarında bu alanın canavarlara saldırmak amacıyla bir tahkimata dönüştürüldüğü yazıyor. Fakat pek kullanılmamış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562306
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562306,
					"content": "Tuhaf değil mi? Kirlilik felaketini başlatan Dahrililer neden canavarlarla savaşmak için makinalar üretsin ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562307
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562307,
					"content": "Her neyse, harabelerin kontrol sistemini etkinleştirdiğimize göre sınama alanındaki savunma mekanizmaları da etkinleşmiş olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562308
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562308,
					"content": "Aradığımız Ulu Şarkı o Devin içinde olmalı. Ben çıkmaza girmiş olsam da bunun hepiniz için kolay olacağını sanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562309
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562309,
					"content": "Khvarena'nın tüm Ulu Şarkılarını alabilmemiz için izninizle ben burada sizin dönmenizi bekleyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562310
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562310,
					"content": "Doğru, sen sıradan bir fanisin sonuçta. Böyle bir talepte bulunman doğal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562311
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732562311,
					"content": "Müsaadenizle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562312
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562312,
					"content": "Sanırım Nasejuna son anda tüydü yine. Neyse, ikiniz bir süre ayrı kalacağınız için Paimon daha mutlu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7325624,
