			},
			"dialogs": [
				{
					"id": 732562401,
					"content": "Yüce Elçi ve Yasnapatisi yine şaşırtmadı. Ne Dahri makinaları ne Dhev yaratıkları durdurabildi sizi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562402
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562402,
					"content": "Hı? Sen ne zaman geldin Nasejuna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732562403,
					"content": "Muazzam dövüşünüzü uzaktan izliyordum. Ah, ne kadar görkemliydiniz! Sonra elinizde Ulu Şarkı olduğunu görünce hemen yanınıza koştum tabii!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562404
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562404,
					"content": "Ellerinize sağlık. Hazır konusu açılmışken, Khvarena'nın Ulu Şarkılarını güvende tutmam için bana vermeyi düşünür müydünüz? Yani hani belki... Nasıl desem ki... Bu yüce göreve benim katılmamın da bir anlamı olmuş olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562405
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562405,
					"content": "İyi de başından beridir pek bir şey yapmadın ki. Hem Zurvan bize Khvarena'nın Ulu Şarkılarını başkalarına vermememiz gerektiğini öğütledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732562406,
					"content": "Teessüf ederim. Sonuçta o kadar araştırma yaptım! Biraz inceleyebilirsem eminim ileride faydasını görebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562407
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562407,
					"content": "Örneğin Khvarena'nın Ulu Şarkılarının neden bu harabelere saklandığını öğrenebiliriz, hem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562408
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732562408,
					"content": "Şu an hikaye anlatma sırası değil Nasuraia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562409
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732562409,
					"content": "Evet! Yüce Khvarena bulabileceğimiz bir sonraki yere gitmemiz gerekiyor, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732562410,
					"content": "Şarkıların hepsini topladığımızda hikayelerini anlatabilirsin Nasejuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732562411,
					"content": "Hım... Peki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nasejuna"
				}
			]
		},
