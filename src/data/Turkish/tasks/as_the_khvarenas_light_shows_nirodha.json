				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732560601,
					"content": "Görünüşe göre nihayet bu harabelerin merkezine ulaştık. O zaman şimdi Dahri harabeleri üzerine epey araştırma yapmış biri olarak size biraz bu harabeleri anlatayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560602
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560602,
					"content": "Elimdeki notlara göre burası eskiden Dahrililerin araştırma ve test yaptıkları bir sınama alanıymış. Aradığımız Khvarena'nın Ulu Şarkısı ise bu yerin en derin noktasında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560603
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560603,
					"content": "Oraya ulaşmak istiyorsak önce... Hımm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560604
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560604,
					"content": "Hani dersini önceden çalışmıştın? Şimdiden kem küm etmeye başladın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732560605,
					"content": "Bu harabelerin yapı düzeni çok karmaşık. Kimsenin sırf burada yazan açıklamaları okuyarak Dahrililerin kullandıkları gizemli makinaların çalışma prensiplerini tamamen anlayabileceğini düşünmüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560606
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560606,
					"content": "Bakalım şimdi... Hah, buldum. Görünen o ki şu anda sınama alanının kontrol merkezindeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560607
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560607,
					"content": "Ulu Şarkıya ulaşmak istiyorsak önce bütün harabelerin kontrol mekanizmalarını etkinleştirmemiz gerekiyor. Onun için de çözmemiz gereken bir enerji sorunu var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560608
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560608,
					"content": "Dahri halkının kirliliğin gücünü kullanarak makinaları çalıştırdıkları ve canavarları ehlileştirdikleri söylenir. Bu harabede öyle bir şeye rastlamadım ama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560609
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560609,
					"content": "Hatta aksine, Azosit adında bir enerji biçimi kullanıyorlarmış. Saf element enerjisinden elde edilip sonra blok şekline getiriliyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560610
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560610,
					"content": "O halde bu türden Enerji Bloklarını bulabilirsek bu çekirdeklere güç sağlayabilir ve ardından diğer sorunları da kolayca çözebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560611
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560611,
					"content": "Anlattıkların uğraştıracak gibi. Keşke savaşarak çözebileceğimiz bir husus olsaydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560612
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732560612,
					"content": "Tamam, işe koyulalım o halde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732560613
					]
				},
				{
					"id": 732560613,
					"content": "Ah, dünden hazırsın bakıyorum. Tam da Elçimizin Yasnapatisine yaraşır bir heves.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560614
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560614,
					"content": "Öyleyse Enerji Blokunu arama görevini size bırakıyorum. Bu sınama alanının düzenini gösteren çizimi de size veriyorum. İşinize yarayacağına eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560615
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560615,
					"content": "O sırada benim de incelemem gereken başka şeyler var. O nedenle burada sizi bekleyeceğim. Yanınızda yüce Elçi de olduğuna göre hiç zorlanacağınızı sanmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732560616
					],
					"speakerTitle": "Nasejuna"
				},
				{
					"id": 732560616,
					"content": "Bir sorunla karşılaşırsanız çizimi tekrar dikkatlice incelemenizi öneririm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nasejuna"
				}
			]
		},
