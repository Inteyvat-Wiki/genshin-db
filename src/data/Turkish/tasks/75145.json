			"dialogs": [
				{
					"id": 751450101,
					"content": "Ey Seçilmiş, Ejderhaların Seçilmişi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450102,
					"content": "Kutsal Dağ tam karşında duruyor... Tabii... Eğer... Gölgelerde gizlenen düşmanı yok edebilirsen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450103,
					"content": "Ey Ejderhaların Seçilmişi... Gir... Kutsal Dağ'a gir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450104,
					"content": "Raarr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450105
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450105,
					"content": "Yanardağ... Patladı mı az önce?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450106
					]
				},
				{
					"id": 751450106,
					"content": "Hayır... Gayet sessiz... Sen patladığını mı gördün?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450107,
					"content": "#{NICKNAME}? {REALNAME[ID(2)|SHOWHOST(true)]}? Ne oldu? Niye öyle bakıyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450108,
					"content": "Resimli romanlarda birden katilin kim olduğunu anlayan dedektifler gibi duruyorsunuz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450109,
						751450112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450109,
					"content": "Bir tür \"gerçeği\" gördük...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450110
					]
				},
				{
					"id": 751450110,
					"content": "(Paimon'a ne gördüğünü anlatıyorsun...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450111
					]
				},
				{
					"id": 751450111,
					"content": "#Ne? Natlan'a ilk geldiğimiz zaman {REALNAME[ID(2)|SHOWHOST(true)]} ile karşılaştığımızda da aynı şeyi görmemiş miydin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450118,
					"content": "Ve garip görüntüler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450119,
					"content": "Raarr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450120
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450120,
					"content": "Garip sözcükler gördüğünü söylemiştin... Şey, Paimon bir şey görmediği için emin olamıyor ama... Belki de aynı kişi tarafından yazılmıştır?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450121,
					"content": "Evet, sanırım öyle...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450122
					]
				},
				{
					"id": 751450122,
					"content": "Ama bu kez bir de... Devasa bir harabe ve Hiçliği görmüşsün...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450123,
					"content": "Ve de bir \"Kutsal Dağ\"... Hımm, Natlanlılar şu yanardağa \"Kutsal Dağ\" demiyor mu? Gördüklerinin o yanardağ ile bir ilgisi olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450124,
					"content": "#Paimon şu an bizi {REALNAME[ID(2)|SHOWHOST(true)]} ile bir araya getiren kişinin oraya gitmemizi istediğine dair garip bir hisse kapıldı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450125,
					"content": "#Belki {REALNAME[ID(2)|SHOWHOST(true)]} ve geçmişine dair cevaplar buluruz orada... Hatta belki de ailesiyle tanışırız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450126,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450127
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450127,
					"content": "Her neyse... Yanardağla ilgili bilgi edinmek için gözümüzü dört açalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450128,
					"content": "Hımm. Natlan'ın altı kabilesinden biri olan Bereket Kolektifi yanardağın hemen yanında yaşıyor, değil mi? Belki onlardan yardım isteyebiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450112,
					"content": "Pasta katilinin asıl kimliği... Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450113
					]
				},
				{
					"id": 751450113,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450114
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450114,
					"content": "Of ya! Nasıl bildin? Paimon pastayı yediğini kimsenin görmediğine emindi... Şaka şaka, Paimon aslında Yakıcı Et Yahnisini çaldı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450115,
					"content": "Yani sen... Bir dakika, sen az önce ne gördün?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751450116,
					"content": "(Paimon'a ne gördüğünü anlatıyorsun...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450117
					]
				},
				{
					"id": 751450117,
					"content": "Yine garip sözcükler gördün yani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450118
					],
					"speakerTitle": "Paimon"
				}
			]
		},
