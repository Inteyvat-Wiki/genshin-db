			"dialogs": [
				{
					"id": 760740101,
					"content": "Ne kadar garip bir enstrüman... Paimon ne kadar çalsa da tek bir nota bile çıkmıyor! Acaba bozuk mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760740102,
						760740104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760740102,
					"content": "Önce şu Perileri takip edelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760740103
					]
				},
				{
					"id": 760740104,
					"content": "Ne? Az önce enstrüman sesi duyduğumdan eminim halbuki. Şarkı söyleyen bir ses de vardı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760740105
					]
				},
				{
					"id": 760740103,
					"content": "Evet, şimdilik enstrümanı unutalım. Periyi takip edersek muhtemelen hazineyi buluruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760740105,
					"content": "Gerçekten mi? İyi de Paimon sadece rüzgarı duydu... Bir dakika, bu sadece enstrümanı çalan kişinin şarkıyı işitebildiği durumlardan biri falan mı acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760740106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760740106,
					"content": "Tamam, Paimon da bir denesin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760740107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760740107,
					"content": "Paimon telleri sertçe tıngırdatıyor...\\n",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760740108
					]
				},
				{
					"id": 760740110,
					"content": "#Ne? Hâlâ hiç ses yok! {NICKNAME}, gerçekten bir şey duyduğuna emin misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760740111
					],
					"speakerTitle": "Paimon"
				},
				{
