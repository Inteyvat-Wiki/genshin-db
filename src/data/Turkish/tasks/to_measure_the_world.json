			"dialogs": [
				{
					"id": 230251001,
					"content": "Nasıl? Orada canavarlar mı var? Bu hiç mantıklı değil. Çevresel parametrelerin gösterdiğine göre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230251002
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230251002,
					"content": "İşaretçiler de değişken haline gelmiş olabilir mi? Belki de yaydıkları ses ve titreşimler canavarları oraya çekti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230251003
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230251003,
					"content": "Olamaz, bu şeyler veriyi etkilemiş midir? Özür dilerim, yine kendi kendime konuşuyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230251004
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230251004,
					"content": "Sana fazladan zahmet vermek istemezdim. Özür dilerim, lütfen bunu ödeme olarak kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230251005
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230251005,
					"content": "Bir dahaki sefere ölçümlerimde daha dikkatli olacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
