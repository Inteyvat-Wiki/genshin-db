				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230250701,
					"content": "Nasıl? Tüm işaretçileri yerleştirdin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250702
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250702,
					"content": "Her şey hazır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250703
					]
				},
				{
					"id": 230250703,
					"content": "Çok teşekkürler. Lütfen karşılığında bunu kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250704
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250704,
					"content": "Şimdi tek yapmam gereken işaretçilerin veri toplamasını beklemek, sonrasında çıkarımlarımı doğrulayabileceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250705
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250705,
					"content": "Ama oraya kadar çıkıp işaretçileri nasıl alacağım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				}
			]
		},
		{
