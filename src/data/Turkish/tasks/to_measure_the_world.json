			"dialogs": [
				{
					"id": 230250801,
					"content": "Ah Gezgin, sonunda geldin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250802
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250802,
					"content": "Araştırman nasıl gidiyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250803
					]
				},
				{
					"id": 230250803,
					"content": "Sayende son birkaç gündür büyük ilerleme kaydettim. İşaretçiler şu an biz konuşurken bile veri topluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250804
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250804,
					"content": "Artık tek yapmam gereken verileri almak ve yeni varsayımlarımı doğrulamak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250805,
						230250806
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250805,
					"content": "Bu kadar zamandır sadece varsayımda mı bulunuyordun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250807
					]
				},
				{
					"id": 230250807,
					"content": "Bazı denklemleri düzelttim ve cihazlarımı kalibre ettim. Sonuçta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250808
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250808,
					"content": "İşaretçileri yerleştirdiğin yerlere tırmanamam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250809
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250809,
					"content": "Maalesef senden o işaretçileri getirmeni rica edeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250810,
						230250812
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250810,
					"content": "Pekala, tamamdır...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250811
					]
				},
				{
					"id": 230250811,
					"content": "Lütfen Gezgin! Ödemeyi halledeceğim, hiç merak etme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250812,
					"content": "Bir dahaki sefere işaretçilerin geri getirileceğini de hesaba kat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250813
					]
				},
				{
					"id": 230250813,
					"content": "Aslında birkaç seçeneği gözden geçirdim. İşaretçileri geri getirecek bir cihaz eklentisi yapmak, uygulama alanını genişletmek... Bunun gibi şeyler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250814
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250814,
					"content": "Ama bunlar için daha geniş bir bütçe gerek, ayrıca bunlar verilerin doğruluğunu etkiler mi bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250815
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250815,
					"content": "Her neyse, bu sefer de sana güveniyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250806,
					"content": "Hiç ilerleme kaydetmemişsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250807
					]
				}
			]
		},
