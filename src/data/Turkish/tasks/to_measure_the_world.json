			"dialogs": [
				{
					"id": 230250401,
					"content": "Hımm... Demek öyle. Bu değişkeni hesaba katarsak uyuşmazlıklar açıklanabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250402
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250402,
					"content": "Ama bu diğer çıkarımlarımı etkiler mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250403
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250403,
					"content": "Bir gelişme var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250404
					]
				},
				{
					"id": 230250404,
					"content": "Pardon, senin hâlâ burada olduğunu unuttum... İşte ödemen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250405
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250405,
					"content": "Gelişmeler şöyle... Bazı sorunları çözdüm ama karşıma yeni sorunlar çıktı. Araştırma tam olarak böyle bir şey sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250406
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250406,
					"content": "Kesin bir sonuca varana kadar seni bir süre daha rahatsız edebilirim Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				}
			]
		},
