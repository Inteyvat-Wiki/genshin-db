				{
					"id": 230250513,
					"content": "Aslında ben tüm bu sorulara açıklık getirecek bir model geliştirdim. Sadece bu modeli destekleyecek gözlem verilerine ihtiyacım var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250514,
						230250515
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250514,
					"content": "Yardım lazım mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250523
					]
				},
				{
					"id": 230250523,
					"content": "O halde yardım edecek misin? Çok teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250524
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250524,
					"content": "Aslında çıkarımlarımı desteklemek için gereken ham verileri otomatik olarak toplayacak özel yapım birkaç tane işaretçi sipariş ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250525
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250525,
					"content": "Ham verinin arazinin şartlarından etkilenmemesi için işaretçilerin uçurum kenarları ya da dağ zirveleri gibi yüksek yerlere yerleştirilmesi gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250526
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250526,
					"content": "Ne yazık ki gördüğün gibi tırmanış konusunda pek iyi değilim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250527,
						230250529
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250527,
					"content": "Bana bırak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250528
					]
				},
				{
					"id": 230250528,
					"content": "Teşekkür ederim! Örneklem alanı yakınlarda. İşin bittiğinde bana haber ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250529,
					"content": "İşaretçileri sipariş ederken araziyi hesaba katmamış mıydın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250530
					]
				},
				{
					"id": 230250530,
					"content": "Öhöm... Bu cihazın hassasiyeti öncelikli olduğundan uygulama yapacağım uzaklık doğal olarak azaldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250531
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250531,
					"content": "Nihayetinde hesaplamadaki en ufak bir hata bile sonuçlarda büyük farklılık yaratabilir. Neyse, sana güveniyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250515,
					"content": "İyi şanslar. Görüşürüz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250516
					]
				},
				{
					"id": 230250516,
					"content": "Bekle! Lütfen bir daha düşün. Eğer yaptığım çalışma yayımlanırsa dünyayı yerinden oynatabilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250517
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250517,
					"content": "Sen de bu büyük kuramsal projenin ortağı olacaksın. Ayrıca teşekkür bölümünde de sana yer verebilirim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250518
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250518,
					"content": "Hatta... Ortak yazar bile olabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250519
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250519,
					"content": "Gerçekten bu kadar acil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250520
					]
				},
				{
					"id": 230250520,
					"content": "Bir sonuç elde edemezsem ne yazık ki araştırma için fon bulmakta zorlanacağım. Açıkçası fon bulamamaktansa gökyüzünün tepeme çökmesini yeğlerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250521,
						230250522
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250521,
					"content": "Ortak yazar olmayı talep etmem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250523
					]
				},
				{
					"id": 230250522,
					"content": "Adil bir ödeme almayı tercih ederim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250523
					]
				},
				{
					"id": 230250510,
					"content": "Teknik olarak çökemez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250512
					]
				},
				{
					"id": 230250503,
					"content": "Şu an çok meşgulüm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250504
					]
				},
				{
					"id": 230250504,
					"content": "Lütfen böyle söyleme. Birinin evi başına yıkılacak burada, daha ciddi ne olabilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250505
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250505,
					"content": "Evin... Başına mı yıkılacak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250506
					]
				},
				{
					"id": 230250506,
					"content": "Öhöm... Tabii ki hayır. Ama mesela bir evde yaşıyorsun ve evin her yerini tam olarak görmedin, kimse de sana evin dayanıklı olduğuna dair bir garanti vermedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250507
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250507,
					"content": "Bu şekilde bu evde yaşamak seni her gün endişelendirmez mi? Bu dünyada yaşamak da böyle bir şey işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250508
					],
					"speakerTitle": "Farghani"
				}
			]
		},
