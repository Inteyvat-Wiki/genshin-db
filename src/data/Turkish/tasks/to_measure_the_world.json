			"dialogs": [
				{
					"id": 230250201,
					"content": "Hey arkadaşım, bir dakika bakabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250202,
						230250203
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250202,
					"content": "Ne oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250208
					]
				},
				{
					"id": 230250208,
					"content": "Gökyüzü çökerse ne olur? Hiç düşündün mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250209,
						230250210
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250209,
					"content": "Çok fazla endişeleniyorsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250212
					]
				},
				{
					"id": 230250212,
					"content": "Öyle olabilir. Peki ama gökyüzü neden çökmüyor? Dünya neden yerle bir olmuyor? Elimizde doğru ölçümler olmadan bu sorulara asla cevap veremeyeceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250213
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250213,
					"content": "Aslında ben tüm bu sorulara açıklık getirecek bir model geliştirdim. Sadece bu modeli destekleyecek gözlem verilerine ihtiyacım var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250214,
						230250215
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250214,
					"content": "Yardıma ihtiyacınız var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250223
					]
				},
				{
					"id": 230250223,
					"content": "O halde yardım edecek misin? Çok teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250224
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250224,
					"content": "Gözlem yapmak için çok iyi bir yer seçtim ama orada canavarlar var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250225
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250225,
					"content": "Lütfen onları oradan uzaklaştır ki ben de güvenli bir şekilde gözlem yapabileyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250226,
						230250228
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250226,
					"content": "Tamamdır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250227
					]
				},
				{
					"id": 230250227,
					"content": "Çok teşekkürler. Yola koyulalım o halde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250228,
					"content": "Bizzat orada bulunman gerekiyor mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250229
					]
				},
				{
					"id": 230250229,
					"content": "Hesaplamalarımdaki uyuşmazlığın sebebini bulmak için sahadan almam gereken veriler var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250230
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250230,
					"content": "Bir kağıt yığınına takılıp kalmak seni doğru cevaptan uzaklaştıracaktır, o yüzden hadi yola çıkalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250215,
					"content": "İyi şanslar. Görüşürüz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250216
					]
				},
				{
					"id": 230250216,
					"content": "Bekle! Lütfen bir daha düşün. Eğer yaptığım çalışma yayımlanırsa dünyayı yerinden oynatabilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250217
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250217,
					"content": "Sen de bu büyük kuramsal projenin ortağı olacaksın. Ayrıca teşekkür bölümünde de sana yer verebilirim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250218
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250218,
					"content": "Hatta... Ortak yazar bile olabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250219
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250219,
					"content": "Gerçekten bu kadar acil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250220
					]
				},
				{
					"id": 230250220,
					"content": "Bir sonuç elde edemezsem ne yazık ki araştırma için fon bulmakta zorlanacağım. Açıkçası fon bulamamaktansa gökyüzünün tepeme çökmesini yeğlerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250221,
						230250222
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250221,
					"content": "Ortak yazar olmayı talep etmem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250223
					]
				},
				{
					"id": 230250222,
					"content": "Adil bir ödeme almayı tercih ederim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250223
					]
				},
				{
					"id": 230250210,
					"content": "Teknik olarak çökemez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250212
					]
				},
				{
					"id": 230250203,
					"content": "Şu an çok meşgulüm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250204
					]
				},
				{
					"id": 230250204,
					"content": "Lütfen böyle söyleme. Birinin evi başına yıkılacak burada, daha ciddi ne olabilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250205
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250205,
					"content": "Evin... Başına mı yıkılacak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230250206
					]
				},
				{
					"id": 230250206,
					"content": "Öhöm... Tabii ki hayır. Ama mesela bir evde yaşıyorsun ve evin her yerini tam olarak görmedin, kimse de sana evin dayanıklı olduğuna dair bir garanti vermedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250207
					],
					"speakerTitle": "Farghani"
				},
				{
					"id": 230250207,
					"content": "Bu şekilde bu evde yaşamak seni her gün endişelendirmez mi? Bu dünyada yaşamak da böyle bir şey işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230250208
					],
					"speakerTitle": "Farghani"
				}
			]
		},
