			"dialogs": [
				{
					"id": 740880501,
					"content": "Sanırım burası eskiden Butor'un \"Kurmalı Cihazlar Enstitüsü\" olarak kullanılıyordu. Mösyö Butor, kurmalı makinalar konusunda alanının önde gelen isimlerindendir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880502
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740880502,
					"content": "Maalesef geleneksel kurmalı makinaların gelişimi, bilimsel açıdan tıkanmış durumda. Geleneksel kurmalı makinaların kullanımı bariz bir şekilde işlevselliğini yitirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880503
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740880503,
					"content": "Neyse, hal böyle olunca Mösyo Butor'un programı Enstitü içinde ötekileştirilmeye başlandı. Bütçesi kesildi ve yeni araştırmacılar bulmakta zorlanır oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880504
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740880504,
					"content": "Nihayetinde birtakım talihsiz olayların ardından Mösyö Butor'un grubu dağıldı ve burası tamamen terk edildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740880505
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740880505,
					"content": "*iç çeker* Bana soracak olursanız Mösyö Butor gerçekten çok şanssızdı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nacker"
				}
			]
		},
