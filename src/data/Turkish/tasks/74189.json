			"dialogs": [
				{
					"id": 741890501,
					"content": "Bir dakika lütfen. Hazineyle ilgili bir sırrı öğrenmek ister misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890502
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890502,
					"content": "Ne sırrı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890503
					]
				},
				{
					"id": 741890503,
					"content": "Hazine ve kapının nasıl açılacağı hakkında bir sır. İlginizi çekti mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890504,
						741890505
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890504,
					"content": "Benden tekrar canavarlarla savaşmamı istemeyeceksin, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890506
					]
				},
				{
					"id": 741890506,
					"content": "Elbette hayır! Hanımızda ağırladığımız konuklardan ayak işleri yapmalarını istemeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890507
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890507,
					"content": "Yanımdaki deniz topu ile baktığı molozları görüyor musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890508
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890508,
					"content": "Topu etkinleştirip kayaları patlatın ve orada bulduğunuz tüm hazineler sizin olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890509
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890509,
					"content": "Bu topun adını kim koydu ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890510
					]
				},
				{
					"id": 741890510,
					"content": "Dümenci koydu. Aklına nereden geldi bilmiyorum ama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890511,
						741890512
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890511,
					"content": "Söyle bakalım. Hangi parçaları eksik?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890513
					]
				},
				{
					"id": 741890513,
					"content": "Sanırım yanlış anladınız. Top sapasağlam halde ve tam güçte. Onun bakımını her gün yaparım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890514
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890514,
					"content": "Ama onu etkinleştirmeden önce birkaç soruma cevap vermenizi istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890515
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890515,
					"content": "Bunu dümencinin isteği üzerine yapıyorum. Bunun handaki konuklar için iyi bir eğlence olacağını ve içkilerini daha yavaş içmelerini sağlayarak handa daha fazla vakit geçirmelerini sağlayacağını söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890516
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890516,
					"content": "Cevaplayabileceğimden pek emin değilim ama sor bakalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890517
					]
				},
				{
					"id": 741890517,
					"content": "1. Soru: Paslı Dümen'de kaç tane masa var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890518
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890518,
					"content": "2. Soru: Paslı Dümen'de kaç kişi çalışıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890519
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890519,
					"content": "3. Soru: Paslı Dümen'de ne yoktur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890520
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890520,
					"content": "İşte bu kadar. Bu üç soruya doğru cevap verirseniz topu etkinleştirip molozları havaya uçurabilir ve hazineyi alabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890521
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890521,
					"content": "Hazineyi aldıktan sonra ne olacak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890522
					]
				},
				{
					"id": 741890522,
					"content": "Sonra uygun bir hazine daha bulup onu mağaraya koyacağım ve üstünü molozlarla örteceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890523
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890523,
					"content": "Sonraki hazine de sizden sonra gelecek konuğumuzun topu etkinleştirmesiyle birlikte alınmaya hazır alacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890524,
						741890525
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890524,
					"content": "Biraz fazla çalışmıyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890528
					]
				},
				{
					"id": 741890528,
					"content": "Hepsi bu kadar. Şimdi soruların cevaplarını arayabilirsiniz. Ben burada sizi bekleyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890525,
					"content": "Patronuna çalışmak istemezdim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890526
					]
				},
				{
					"id": 741890526,
					"content": "Yorumunuza katılmadan edemeyeceğim ama topu dümenciye o fark etmeden doğrultmanın yolunu bir türlü bulamadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890527
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890527,
					"content": "Ayrıca topu aceleyle yanlış yere ateşlemek handaki diğer konuklarımıza zarar verebilir ve bu da benim ahlaki ilkelerime ters düşer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741890528
					],
					"speakerTitle": "Permingeat"
				},
				{
					"id": 741890512,
					"content": "Söyle bakalım. Neyle çalışıyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890513
					]
				},
				{
					"id": 741890505,
					"content": "Benden senin için başka birini veya bir şeyi bulmamı istemeyeceksin, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741890506
					]
				}
			]
		}
	]
}