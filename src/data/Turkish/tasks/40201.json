			"dialogs": [
				{
					"id": 402010101,
					"content": "Harikasınız. Tam zamanında geldiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010102,
						402010103
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010102,
					"content": "Vaka nasıl gidiyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010104
					]
				},
				{
					"id": 402010104,
					"content": "Depo olarak kullandıkları tesise sızdığımız günün ertesi günü, Kara Mora Babası'nın iki adamı Corder ve Doddamani malları taşımaya başladılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010105
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010105,
					"content": "Şu gemiyi görüyor musunuz? Malları taşımak için Doddamani ayarladı onu. Hem yolcu hem yük taşıyor güya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010106
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010106,
					"content": "Vay be, ne kadar da büyük! Yüklenecek malların hepsi iskeleye yığılmış! Anlaşılan Lumidouce Limanı'na giden bir sürü yolcu var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010107,
						402010108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010107,
					"content": "Ya onlar gerçek mallar değilse?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010109
					]
				},
				{
					"id": 402010109,
					"content": "İki adım sonrasını düşünüyorsun demek, sevdim bunu. Hızlı kavrıyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010110
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010110,
					"content": "Corder ve Doddamani yetkililerin kendilerini izlediğinden haberdar olduysa Lumidouce Limanı'na gönderdikleri bu mallar işimize yaramayacak bir yığın çer çöp olabilir. Yani sırf kolluk kuvvetleri peşlerini bıraksın diye yem atıyor olma ihtimalleri var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010111
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010111,
					"content": "Dikkatli olmalıyız. Örgütün birkaç üyesi, \"Tokatçı\" olarak bilinen bir Hazine Avcısının Kara Mora Babası'yla bağlantısı olduğunu itiraf etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010112
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010112,
					"content": "Tokatçı hapisten kaçmış bir suçlu ve saklanma konusunda uzman. Önceki araştırmalarımızın sonucunda, Taşordu'nun deniz fenerinde gözlem yapan kişinin o olduğundan eminiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010113
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010113,
					"content": "Tokatçı'nın dikkatini çekmek için bölgede biraz dolaşacağım, o sırada siz de malları inceleyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010114
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010114,
					"content": "Göze batmamaya çalışın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010115,
						402010116
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010115,
					"content": "Tamamdır. Dikkatli olacağım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010117
					]
				},
				{
					"id": 402010117,
					"content": "#Aynen öyle! Ve Paimon da elinden geldiğince... Yere yakın uçacak! {NICKNAME} ile aynı hizada yani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010116,
					"content": "Merak etme, halledeceğim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010117
					]
				},
				{
					"id": 402010108,
					"content": "Ne olur ne olmaz deyip incelesek mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010109
					]
				},
				{
					"id": 402010103,
					"content": "Bir gelişme var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010104
					]
				}
			]
		},
