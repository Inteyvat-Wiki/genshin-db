			"dialogs": [
				{
					"id": 402010201,
					"content": "Değerli yolcularımız, yük ambarındaki sınırlı alan nedeniyle malların bir kısmını güverteye yerleştirmek durumunda kaldık. Verdiğimiz rahatsızlık için özür dileriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010202
					],
					"speakerTitle": "Mürettebat Üyesi"
				},
				{
					"id": 402010202,
					"content": "Lütfen, işinizde başarılı oldunuz diye özür dilemeye ne gerek var canım! Umarım bulaşıcıdır da biz de zengin oluruz! Hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010203
					],
					"speakerTitle": "Dost Canlısı Yolcu"
				},
				{
					"id": 402010203,
					"content": "Görünüşe göre Tokatçı'nın işaretlediği tüm malların gönderici kısmında Corder'in adı yazıyor. Doddamani ise yük ambarında, malların teslimat noktasına sağ salim ulaşmasını sağlıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010204
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010204,
					"content": "Şunlar... Teftiş falan mı yapıyorlar? Kutuları niye altüst ediyorlar ki? Paimon anlayamadı bir türlü!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010205,
					"content": "Şu şifre çözücüyü al. Şifreli mesajlarını çözmene yardımcı olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010206
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010206,
					"content": "Şöyle yapacağız, ben Corder ile Doddamani'nin dikkatini dağıtırken siz de Tokatçı'nın işaretlediği malları inceleyin. Belki işe yarar bir şeyler bulabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010207,
						402010208
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010207,
					"content": "Eğer bir şeyler ters giderse...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010209
					]
				},
				{
					"id": 402010209,
					"content": "Elbette. Muhakemene güveniyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010210
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010210,
					"content": "Ha? B-Bir dakika, bir dakika! Yani oraya gidip onlarla yüz yüze mi konuşacaksın? Yelan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010211,
					"content": "Hım? Affedersiniz beyler ama... Daha önce tanışmış olabilir miyiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010212
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010212,
					"content": "Siz Lyonnais Bölgesi'ndeki meşhur antika koleksiyoneri Bay Corder olmalısınız, öyle değil mi? Sanırım üçümüz daha evvel tanışmıştık. Yanılmıyorsam Yilong Rıhtımı'ndaki Jiulue Çayevinde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010213
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010213,
					"content": "Ha? Siz... Haa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010214
					],
					"speakerTitle": "Doddamani"
				},
				{
					"id": 402010214,
					"content": "... Tabii ya, Yanshang Çayevinin Zar Ustası... Sizi görmek ne hoş Yelan Hanım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010215
					],
					"speakerTitle": "Corder"
				},
				{
					"id": 402010215,
					"content": "Siz de beni tanıyorsunuz demek?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010216
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010216,
					"content": "Evet, bir keresinde orada çok lezzetli bir çay içmiştim. Yanshang Çayevine gidip de sizin efsanevi zar yeteneklerinizi duymayan yoktur herhalde. Durumumuza bakılırsa bizi sürekli bir araya getiren bir şeyler var sanırım. Belki de çay sevgisidir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010217
					],
					"speakerTitle": "Corder"
				},
				{
					"id": 402010217,
					"content": "Evet, ondan olmalı... Yalnız çok iyi bir zamanda denk geldik. Ben de tatil için Fontaine'e gidiyorum gördüğünüz üzere. Gezmemi önerdiğiniz yerler var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010218
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010218,
					"content": "Özel çay setleri bulabileceğim bir yer arıyorum bilhassa... Sanat sergisi gibi yani. Müzayede de olabilir. Fontaine'in siyah çayının eşi benzeri yok diye duymuştum. Çay setleriniz de çok özel parçalardır diye tahmin ediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010219
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010219,
					"content": "Siz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010220
					],
					"speakerTitle": "Doddamani"
				},
				{
					"id": 402010220,
					"content": "Bu beyefendi de mi çay setleriyle ilgileniyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010221
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010221,
					"content": "Ben... Öhöm... Aynen öyle. Sizinle tanıştığıma memnun oldum Yelan Hanım. Ben de Corder'in daveti üzerine Fontaine'e seyahate gidiyorum. Aslına bakarsanız, ben bu geminin sahibiyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010222
					],
					"speakerTitle": "Doddamani"
				},
				{
					"id": 402010222,
					"content": "Yelan sahiden de onlarla konuşuyor! Bunun iyi bir fikir olduğuna emin miyiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010223,
						402010224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010223,
					"content": "Fazla vaktimiz yok!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010225
					]
				},
				{
					"id": 402010225,
					"content": "Pekala! O halde bizi göremeyecekleri bir yere gidip şu kutuları incelemeye başlayalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010226,
					"content": "*öksürür* Bu kutulardan gelen yoğun koku da neyin nesi? Bir sürü şeyi karıştırmışlar galiba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010227,
					"content": "Tuhaf bir not da var. Ama Paimon ne yazdığını okuyamıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010228,
						402010229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010228,
					"content": "Bu yazı şifreli...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010230
					]
				},
				{
					"id": 402010230,
					"content": "Yelan gerçekten de her şeyi düşünmüş! Yalnız, şey... Bu cihazı nasıl kullanacağını biliyorsun, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010231,
					"content": "Ee? Ne yazıyor, ne yazıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010232,
						402010233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010232,
					"content": "Yanlış anlamadıysam malları imha etmeyi planlıyorlar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010234
					]
				},
				{
					"id": 402010234,
					"content": "H-H-H-Havaya mı uçuracaklar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010235,
					"content": "Kafayı mı yemiş bunlar? Paimon tüm bunları yetkililer peşlerini bıraksın diye yaptıklarını düşünüyordu... Daha çok dikkat çekmek için değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010236,
						402010237,
						402010238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010236,
					"content": "Tokatçı'nın en tepedeki kişiyi koruması gerekiyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010239
					]
				},
				{
					"id": 402010239,
					"content": "Yelan haklıymış! Bu herif tam bir akıl hastası!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010240
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010240,
					"content": "Gemide masum insanlar var! O bombaları bir an önce bulup etkisiz hale getirmeliyiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010237,
					"content": "Bu yüzden dikkatleri daha büyük bir meseleye yönlendiriyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010239
					]
				},
				{
					"id": 402010238,
					"content": "Bu sayede, bulduğumuz tüm ipuçlarını da yok etmiş olacak...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010239
					]
				},
				{
					"id": 402010233,
					"content": "... Gemiyi havaya uçuracaklar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010234
					]
				},
				{
					"id": 402010229,
					"content": "Neyse ki şifre çözücümüz var...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010230
					]
				},
				{
					"id": 402010224,
					"content": "Bize bir fırsat sağladı. Bize de faydalanmak düşer!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010225
					]
				},
				{
					"id": 402010208,
					"content": "Doğrudan icabına bakabilir miyim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010209
					]
				}
			]
		},
