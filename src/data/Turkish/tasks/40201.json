					}
				]
			},
			"dialogs": [
				{
					"id": 402010301,
					"content": "Paimon'un ödünü kopardın Yelan! Öylece yanlarına gittin resmen... Ya seni yakalayıp... Akla bile gelmeyecek şeyler yapsalardı, ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010302,
					"content": "Mesele \"yapsalardı\", \"etselerdi\" meselesi değil Paimon. Kim olduğumu anlamışlardır zaten ama kendi iyilikleri için numarayı sürdürmek zorundaydılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010303
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010303,
					"content": "Kara Mora Babası iyice köşeye sıkıştı. Gemide yaşananlar, sırf kendi paçasını kurtarmak adına zararın neresinden dönülse kardır mantığıyla yaptığı bir hamleydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010304
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010304,
					"content": "Onu ele verecek her şeyden kurtulması gerekiyor. Bu yüzden gemiyi patlatmayı planladı. Müzayedeye gitmesi gereken mallar denizin dibini boylayacak, suç da Tokatçı'ya kalacaktı böylece...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010305
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010305,
					"content": "İstediği son şey malların müzayedeye ulaşmasıydı ama korktuğu başına gelecek. Artık sürece ayak uydurmaktan başka çaresi yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010306
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010306,
					"content": "Adamlarından birini müzayedeye göndermemeyi ve mallarının şüphe çekmeyecek biri tarafından satın alınmasını da tercih edebilir. Ancak hatırlatmak isterim ki mallar fahiş fiyatlı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010307
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010307,
					"content": "Alıcının malların iddia edildiği kadar değerli olmadığını anlayıp yetkililere haber vermesi an meselesi olur. Bu durumda Corder, satıcı olarak potansiyel suçlu durumuna düşer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010308
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010308,
					"content": "En iyi senaryoda Kara Mora Babası'nın yeni bir Mora aklama planı bulması gerekir. En kötü senaryoda ise Fontaine'deki en güvenilir adamlarından birini kaybeder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010309,
						402010310
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010309,
					"content": "Müzayedeye katılma kararını sürdürürse de...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010311
					]
				},
				{
					"id": 402010311,
					"content": "Aynen öyle. Kanıtlarımız güvende olacak ve müzayededeki alıcı bizi Kara Mora Babası'na bir adım daha yaklaştıracak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010312
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010312,
					"content": "Peki, şey... O zaman, hım... Yani diyorsun ki... Şunu baştan anlatabilir misin acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010313,
					"content": "#Merak etme. {NICKNAME} eminim Paimon'un anlayacağı şekilde tekrar anlatır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010314
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010314,
					"content": "Artık son düzlükteyiz ve bu müzayedeyi kendi lehimize kullanmamız çok mühim... Bu yüzden iyi hazırlık yapıp bu işi sonlandıralım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010315
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010315,
					"content": "Memur Edler içeri bir muhbir yerleştirdi. Bu davetiyeyi göstererek müzayedeye girebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010316
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010316,
					"content": "İki gün sonra Debord Otelde görüşürüz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010310,
					"content": "İşimize gelir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010311
					]
				}
			]
		},
