			"dialogs": [
				{
					"id": 402010401,
					"content": "Tamamdır, güvertedeki tüm bombalar bu kadar. Peki ya yük ambarı? Yeterli vaktimiz var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010402,
					"content": "Çoktan hallettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010403
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010403,
					"content": "İyi iş çıkardınız. Sakin kalıp hızlı hareket ettiniz. Böyle bir durumda verilebilecek en doğru tepkiyi verdiniz yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010404
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010404,
					"content": "Yok canım! Hepsi senin sayendeydi. Gemiye binmek senin fikrindi bir kere. Ayrıca verdiğin şifre çözücü olmasaydı mesajı asla anlayamazdık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010405,
					"content": "Bir saniye... Corder ve Doddamani nerede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402010406,
					"content": "Heh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010407
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010407,
					"content": "Şoku atlatmaya çalışıyorsunuz sanırım. Birdenbire tehlikeli biri tarafından hedef alınmak... Hazmetmesi zor olsa gerek, öyle değil mi beyler? Tek seferde hem malınızdan hem de canınızdan oluyordunuz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010408
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010408,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010409
					],
					"speakerTitle": "Corder"
				},
				{
					"id": 402010409,
					"content": "Evet. Bu kadar şeytanca bir planı nasıl düşünebilir... Ona ne yaptım da böyle bir şeyi hak ettim, aklım almıyor. Böylesine bir cinayete kalkışması... İnanılır gibi değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010410
					],
					"speakerTitle": "Corder"
				},
				{
					"id": 402010410,
					"content": "Artık korkmanıza gerek yok. Bir an önce Asayiş Dairesine haber verip Lumidouce Limanı'na memur göndermelerini isteyeceğim. İkinizin kesinlikle korunmaya ihtiyacı var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010411
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010411,
					"content": "Mallarınız da inceleme için yetkililere teslim edilecek Bay Corder. Hâlâ bir tehlike barındırıyorlar mı diye kontrol edilmeleri iyi olur. Sonra da Asayiş Dairesi onlara gitmesi gereken yere kadar eşlik edecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010412
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010412,
					"content": "Bu arada... Mallar nereye gidecekti Bay Corder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010413
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010413,
					"content": "... Debord Otele. İki gün sonra bir müzayede var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010414
					],
					"speakerTitle": "Corder"
				},
				{
					"id": 402010414,
					"content": "O halde içiniz rahat olsun. Asayiş Dairesinin memurları işinin ehli ve sorumluluk sahibidir. Mallarınızın bir çizik bile almadan müzayedeye ulaşacağından emin olabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010415
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402010415,
					"content": "Çok teşekkür ederiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010416
					],
					"speakerTitle": "Corder"
				},
				{
					"id": 402010416,
					"content": "Aradan bir süre geçtikten sonra gemi güvenli bir şekilde Lumidouce Limanı'na varıyor. Asayiş Dairesi hızlıca bir güvenlik incelemesi yapıp gemideki tüm malları indiriyor.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402010417
					]
				},
				{
					"id": 402010417,
					"content": "O sırada sen de Yelan'a Tokatçı'nın Corder ve Doddamani için bıraktığı nottan bahsediyorsun.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
