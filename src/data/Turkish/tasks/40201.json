			"dialogs": [
				{
					"id": 402010501,
					"content": "İşin şakası yokmuş cidden. Bu insanlar gerçekten de mallarını bir an önce Fontaine'e ulaştırmak için can atıyorlar...",
					"roleType": "TALK_ROLE_NPC",
