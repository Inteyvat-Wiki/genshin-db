					"Klee"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105020301,
					"content": "Buldum! İşte kutu bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020302
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020302,
					"content": "Patlamalar sırasında hasar görmemesine sevindim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020303,
					"content": "Geri alma işi tamam! Hadi onu geri götürelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				}
			]
		},
		{
			"id": 1050204,
			"completionStepIds": [
				1050207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1050207",
							"2"
						],
						"stepId": 1050207,
