			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mona"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105020401,
					"content": "Nihayet geri döndün. Beklemek aşırı sıkıcıydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020402
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020402,
					"content": "Vakit geçirmek için bir kitap okumaya niyetlendim ama bu sadece saçma bir günlükmüş. İçinde dikkate değer hiçbir şey yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020403
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020403,
					"content": "Klee'nin sırt çantasından düştü, o yüzden birtakım kadim bilgiler içerebilir diye düşündüm ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020404
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020404,
					"content": "Neyse onu boş ver. Ee, kutuyu buldunuz mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020405
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020405,
					"content": "Bulduk. Mükemmel durumda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020406
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020406,
					"content": "Bu harika... Bekle bir saniye... Bu... Bu neden kilitli değil? Ayrıca... Neden içi boş?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020407
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020407,
					"content": "Hııı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020408,
					"content": "Şey... Çünkü bu kutuyu hazinelerimi saklamak için ödünç aldım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020409
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020409,
					"content": "Ödünç mü aldın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020410
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020410,
					"content": "Ama kutu için buraya geldiğinizden tüm hazinelerimi çıkardım. Bu yüzden içi boş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020411
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020411,
					"content": "Eşyalarını saklamak için mi kullandın? O... O halde başlangıçta kutunun içinde olan şeyler nerede? Aradığım şeyler onlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020412
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020412,
					"content": "Ah. Önceden kutunun içinde olan şeyi mi istiyorsun? Öyle söylesene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020413
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020413,
					"content": "Onu... Kırmadın, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020414
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020414,
					"content": "Hayır! Kırık falan değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020415
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020415,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020416
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020416,
					"content": "Elindeki kitap o.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020417
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020417,
					"content": "Neeeeee?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020418
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020418,
					"content": "B-Bu... Yani bu kitap, bu günlük... Bu, o cadalozun... Onun 50 yıl önceki günlüğü mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020419
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020419,
					"content": "50 yıl sonra geri almak istediği şey, gençliğinin karanlık geçmişi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020420
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020420,
					"content": "Ah, ben bittim! Şimdi anlıyorum... Yaşlı kadın ne olursa olsun kutunun içindekine bakmamam gerektiğini yoksa beni paramparça edeceğini söylemişti, şimdi anlıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020421
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020421,
					"content": "Başım... Başım belada mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020422
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020422,
					"content": "Ah! Kutuyu istiyorum diyen sendin. İçindeki şey hakkında hiçbir şey demedin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020423
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020423,
					"content": "Ben hiçbir şey bilmiyorum. Ben gidiyorum! Hoşça kal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020424,
						105020425
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020424,
					"content": "Ne kadar dokunaklı bir son...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020426
					]
				},
				{
					"id": 105020426,
					"content": "Imm... Yani, sen hiçbir şey söylemezsen ustan anlamaz, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020427,
					"content": "İmkansız. Astroloji tüm yalanları görebilir, buna bizzat şahit oldun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020428
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020428,
					"content": "*iç çeker* Tüm Moralarımı Mondstadt'a gelmek için harcadıktan sonra hem hiçbir bilgi edinmedim hem de artık geri dönemiyorum... Bu noktaya nasıl geldik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020429
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020429,
					"content": "Bu çok üzücü... Belki o kitaptaki her şeyi unuttuktan sonra geri dönebilirsin, olmaz mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020430,
					"content": "Bu... Çok zor. Ayrıca Mondstadt'ta kalmak istesem bile, bu çok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020431,
						105020433
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020431,
					"content": "Utanç verici mi olur?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020432
					]
				},
				{
					"id": 105020432,
					"content": "Evet. Bu cahil sürüsünün arasında kalırsam düzgün bir astrolog düşünce yapısını nasıl koruyabilirim ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020435
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020435,
					"content": "O zaman geri dönüp ustanla yüzleşmen gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020436
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020436,
					"content": "B-Bunun hakkında konuşmayı bırak! Ben... Sanırım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020437
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020437,
					"content": "Geçici olarak Mondstadt'ta kalmam gerekiyor. O yaşlı kocakarı son nefesini verdiğinde özgür olacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020438,
						105020439
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020438,
					"content": "Korkutucu bir karar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020440
					]
				},
				{
					"id": 105020440,
					"content": "Ama astroloji araştırmam ne olacak? Hayır, bekle, kalacak bir yerim bile yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020441
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020441,
					"content": "Bununla ilgili olarak gidip <color=#00E1FFFF>Maceracılar Loncasındaki Katheryne</color> ile konuşabiliriz. Bakalım o yardım edebilecek mi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020442
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020442,
					"content": "Maceracılar Loncası mı? Ah, tabii ya. Şey karşılığında onlar için iş yapabilirsin... Neyi kastettiğimi biliyorsun, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020443,
						105020444
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020443,
					"content": "Tabii ki...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020445
					]
				},
				{
					"id": 105020445,
					"content": "Ah. Imm, teşekkürler. Ben... Neyse boş ver, bir şey yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020444,
					"content": "Plan her zaman buydu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020445
					]
				},
				{
					"id": 105020439,
					"content": "Bu gerçekten \"geçici\" mi olacak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020440
					]
				},
				{
					"id": 105020433,
					"content": "Çok mu pahalı olur?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020434
					]
				},
				{
					"id": 105020434,
					"content": "Evet... Yani hayır! Sana bir şey anlatmak gerçekten zor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020435
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105020425,
					"content": "Klee'ye sinirlenmenin bir anlamı yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020426
					]
				}
			]
		},
		{
			"id": 1050205,
			"completionStepIds": [
				1050208
			],
			"beginWay": "TALK_BEGIN_NONE",
