						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Klee"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105020201,
					"content": "Geldiiiik! Burası. Hadi kazıp çıkaralım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020202,
						105020203
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020202,
					"content": "Bu, Doğa Bodurloplarının işi olmalı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020204
					]
				},
				{
					"id": 105020204,
					"content": "Olamaz. Buraya bir tabela koymuştum. Hata falan yo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020205
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020205,
					"content": "Ufff! Doğa Bodurlopları!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105020206
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 105020206,
					"content": "Evet. Doğa Bodurlopları.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020207
					]
				},
				{
					"id": 105020207,
					"content": "*iç çeker* Bunu daha sonra konuşuruz, ilk önce onları ortadan kaldıralım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105020203,
					"content": "Bunu Doğa Bodurlopları yapmış olmalı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105020204
					]
				}
			]
		},
		{
