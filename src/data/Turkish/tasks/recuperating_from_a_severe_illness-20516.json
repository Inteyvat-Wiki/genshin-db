					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160504
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160504,
					"content": "Burada kimsenin beni bulamayacağından emindim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160505
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160505,
					"content": "Doğru ya. Burada olduğumu sana Rahibe Grace söylemiştir. O hep buralara gelir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160506
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160506,
					"content": "Eskiden kullandığım ilaçların çoğunu o göndermişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160507
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160507,
					"content": "Rahibe Grace çok iyi biri... Ama ben sonsuza kadar Mondstadt'ta kalmak istemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160508
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160508,
					"content": "Neyse. Abim beni arıyor değil mi? Az sonra dönerim. Benim için endişelenmesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
