				},
				{
					"id": 205160202,
					"content": "Sakın hasta olma ama.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160203
					]
				},
				{
					"id": 205160203,
					"content": "Ha! Çok korkuttun beni. Nereden çıktın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160204
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160204,
					"content": "Yine abim beni arıyor kesin. Burada olduğumu bilemeyeceğini biliyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160205
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 205160205,
					"content": "Tamam, tamam. Anladım. Biraz sonra dönerim. Abimi endişelendirmem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
			]
		},
