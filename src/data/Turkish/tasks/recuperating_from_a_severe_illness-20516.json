				{
					"id": 205160401,
					"content": "Bu çocuk hasta değil miydi? Öyleyse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160402
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 205160402,
					"content": "Bir kız gördünüz mü?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160403
					]
				},
				{
					"id": 205160403,
					"content": "Ha... Anna'dan bahsediyorsun galiba. Yukarı bak. Rüzgar Hükümdarı heykelinin elinde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160404
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 205160404,
					"content": "Açıkçası yanımdan koşarak geçtiğinde çok şaşırdım. Sonuçta bunca zamandır hastaydı. Bu kadar enerji nereden geliyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160405
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 205160405,
					"content": "Ben kendime gelene kadar Rüzgar Hükümdarı heykelinin eline çıkmıştı bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160406
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 205160406,
					"content": "Kızmadın mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205160407
					]
				},
				{
					"id": 205160407,
					"content": "Kızmak mı? Yani biraz kızdım ama yavrucak hayatı boyunca hastalıkla uğraştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160408
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 205160408,
					"content": "Onu böyle canlı görünce... Nasıl desem? Sinirlenemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205160409
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 205160409,
					"content": "Ama yukarıda rüzgar çok sert eser. Umarım hasta olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				}
			]
		},
