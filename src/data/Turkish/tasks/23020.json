			},
			"dialogs": [
				{
					"id": 230200101,
					"content": "Bu yüzden bu bölgede kullanılacak malzemeden çok kısmamalıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200102
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230200102,
					"content": "Merak etme, gemi yeterince dayanıklı. Gerekli hesaplamaları birçok kez yaptım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200103
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200103,
					"content": "Off, sana daha önce de söyledim. Çoğu problem sadece hesaplama ile çözülmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200104
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230200104,
					"content": "Niçin tartışıyorsunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230200105
					]
				},
				{
					"id": 230200105,
					"content": "Ah, senmişsin. Biz de gemimdeki tasarım sorunlarını tartışıyorduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200106
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200106,
					"content": "Birçok hesaplama yaptım ve tüm bölgelerinin yeterince dayanıklı olduğunu size garanti ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200107
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200107,
					"content": "Ama Qishan inatla hesaplanan dayanıklılığın güvenilir sonuçlar vermeyebileceğini savunuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200108
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200108,
					"content": "Bahsettiğin \"dayanıklılık\" yalnızca teoride olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200109
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230200109,
					"content": "Bu gemi suda basınca karşı koyacak ve bu basınç senin hesaplamalarla ulaştığın sayılardan çok daha fazla olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200110
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230200110,
					"content": "Demek istediğini anlıyorum ama benim bütçem kısıtlı ve...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200111
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200111,
					"content": "Böyle pahalı malzemeler almaya devam edersem bu geminin yalnızca omurgasını bitirebilirim... *öksürür*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200112
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200112,
					"content": "Her neyse! Bu gemi için şimdilik benim planımı uygulayalım. Zaten tüm malzemeleri aldım bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200113
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200113,
					"content": "Gezgin, rica etsem malzemeleri taşımama yardım eder misin? Hepsini tek başıma taşıyamıyorum da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200114,
						230200115
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200114,
					"content": "Tamamdır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230200118
					]
				},
				{
					"id": 230200118,
					"content": "O halde bu işi sana bırakıyorum. Bazı hesaplamalar yapmam gerekiyor. Geri kalanı işim bittikten sonra getireceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200115,
					"content": "Qishan gemi inşaatından anlıyor mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230200116
					]
				},
				{
					"id": 230200116,
					"content": "Evet, anlıyor. Hatta bazı hesaplamaları benden daha hızlı yapıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200117
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200117,
					"content": "Neden burada çırak olarak kalmak istediğini gerçekten anlamıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200118
					],
					"speakerTitle": "Rafiq"
				}
			]
		},
