			"dialogs": [
				{
					"id": 230200501,
					"content": "Ah, teşekkürler Gezgin! İşte ödemen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200502
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200502,
					"content": "Ama bu malzeme beklediğimden çok daha ağır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200503
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200503,
					"content": "Bir an önce çalışmaya başlamalıyım. Çok uzun sürmez, gemi yakında denize elverişlilik testi için hazır olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200504
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230200504,
					"content": "Gemiyi test ederken yanında can yeleği bulundurman gerekecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230200505
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230200505,
					"content": "Bir şey olmayacak, merak etme! Bana biraz güven.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
