					}
				]
			},
			"dialogs": [
				{
					"id": 740350201,
					"content": "Gezgin, tekrar ziyarete gelmişsin, ne güzel. Kahve ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350202,
						740350203
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350202,
					"content": "Şimdi aklıma geldi de...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350204
					]
				},
				{
					"id": 740350204,
					"content": "Doğru! Paimon da sormak istedi bunu ama... Herkes çok yüksek sesle konuşuyordu, Paimon sormaya cesaret edemedi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350243,
					"content": "Kapı dışarı ediliyorum sandım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350205
					]
				},
				{
					"id": 740350205,
					"content": "Niye mi? Hahaha, o da soru mu! Muhafızlar sizi içeri aldığına göre neden durumu sorgulayalım ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350206
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350206,
					"content": "Yetki ve sorumluluk paylaşımına dair çok açık bir örnek. Merhaba Gezgin. Ben Semaine, tanıştığıma memnun oldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350207,
						740350208
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350207,
					"content": "Merhaba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350209
					]
				},
				{
					"id": 740350209,
					"content": "Semaine mahkemede katip yardımcısı olarak çalışıyordu. Birtakım... Karışık durumlardan ötürü yeniden Hukuk Dairesine atandı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350210
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350210,
					"content": "Mantıklı ve keskin çıkarımları sayesinde daha önce pek çok zorlu sorunu çözüme kavuşturmayı başardık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350211
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350211,
					"content": "Rica ediyorum, o kadarı da biraz abartı oldu. Önceki işimde edindiğim deneyimden faydalanarak ve bazı şeylerin değerini kullanarak ilgili konuların önemine dair çıkarım yapıyorum alt tarafı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350212
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350212,
					"content": "Gerçi pratikte önemi hassas şekilde ölçülemeyecek sayısız meseleyle karşılaşıyoruz. Ama bu tür durumlarda Roialte'in başarıyla geliştirdiği insan etkileşimi aksiyomlarını kullanmanın büyük yardımı dokunuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350213
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350213,
					"content": "Af buyur?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350214
					]
				},
				{
					"id": 740350214,
					"content": "Ben özetleyeyim. Semaine çalışırken işin tüm yönlerini ve durumlarını hesaba katmakta oldukça becerikli. Herkesi önemli hissettiriyor. Terazi dengelemek gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350215
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350215,
					"content": "Dengeleme eylemi imkansızsa ben dahil olup \"kelimelerin ağırlığı\" ile terazinin dengesini etkileyebiliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350216,
						740350217
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350216,
					"content": "Iaune gerçekten çok çalışıyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350218
					]
				},
				{
					"id": 740350218,
					"content": "Evet! Bayılmak üzere sanki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350219,
					"content": "Bu eninde sonunda herkesin yürümesi gereken bir yol. Belgeyi yazması için yardım edersem bundan ders çıkaramayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350220
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350220,
					"content": "Hukuk Dairesinde çalışmanın anlamına dair aklında çok idealist hayaller var. Hayaller gençler içindir, Savcılar için değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350221
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350221,
					"content": "Ayrıca o belgeleri yazmayı bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350222
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350222,
					"content": "Ne kadar dobrasın...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350223
					]
				},
				{
					"id": 740350223,
					"content": "Pekala, yolunuzu buraya düşüren nedir? Söyleyin bakalım, belki yardım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350224
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350224,
					"content": "Iaune birden panik içinde koşarak gelir...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740350225
					]
				},
				{
					"id": 740350225,
					"content": "Eyvah! Her şey mahvoldu! Bay Roialte, daktilo için yedek tuş var mıdır sizde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350226
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350226,
					"content": "Tam yazının ortasında bir tuşun kaybolduğunu fark ettim. Ne zaman çıktı hiçbir fikrim yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350227
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350227,
					"content": "Etrafa baktın mı? Belki yere düşmüştür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350228
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350228,
					"content": "Ya da belki bir kitabın arasına kaçmıştır, belki de belgelerin arasında kalmıştır... Buralara baktın mı",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350229
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350229,
					"content": "Ya da belki kalemliktedir. Ya da gömleğinin kolunda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350230
					]
				},
				{
					"id": 740350230,
					"content": "Ya da saçında, belki de çay fincanında!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350231,
					"content": "Her yere baktım! Ceplerime, hatta ayakkabılarımın içine bile baktım, her yeri aradım taradım, bir türlü bulamadım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350232
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350232,
					"content": "Pekala. O zaman gidip Cornelia'yla konuş. Yedek tuşumuz varsa talebini ona bildirmen gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350233
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350233,
					"content": "Gidip kendim satın alsam daha iyi! Estelle'in bana bir tuş yapması uzun sürmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350234
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350234,
					"content": "Sevgili Iaune, gerçekten kendi paranı harcamak istiyor musun? Daktilo ve tuşları Hukuk Dairesinin demirbaşlarıdır, diğer bir deyişle kamu malıdır. Bu işin doğrusu Cornelia'ya başvuruda bulunmak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350235
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350235,
					"content": "Ama çok pahalı bir şey değil ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350236
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350236,
					"content": "Olay pahasında değil. Olay yetki ve sorumlulukta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350237
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350237,
					"content": "Hukuk Dairesine ait kamu malını onarmanın maliyeti Hukuk Dairesi kamu hesaplarından karşılanmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350238
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350238,
					"content": "Bunu kendi paranla ödersen ve tazmin başvurusunda bulunmazsan yıl sonunda giderler denetlenirken bu ekstra paranın nereden geldiğini kimse bulamaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350239
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740350239,
					"content": "İyi! Peki! Gidip Cornelia'yla konuşayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350240,
						740350241
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350240,
					"content": "Bir şey satın almak bile ne kadar zahmetli...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350242
					]
				},
				{
					"id": 740350242,
					"content": "Hukuk Dairesi için aslında gayet normal. Lütfen gelin benimle. Gidip Cornelia'yı bulalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350241,
					"content": "Bir şeyin parasını ödemek bu kadar sinir bozucu olmamalı sanki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350242
					]
				},
				{
					"id": 740350217,
					"content": "Ona yardım edebilir misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350218
					]
				},
				{
					"id": 740350208,
					"content": "Siz ne işle meşgulsünüz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350209
					]
				},
				{
					"id": 740350203,
