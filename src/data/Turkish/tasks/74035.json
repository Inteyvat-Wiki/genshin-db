			"dialogs": [
				{
					"id": 740350401,
					"content": "Merhaba Bay Iaune. Nasıl yardımcı olabilirim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350402
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350402,
					"content": "Size de merhaba Bayan Cornelia. Daktilo için yedek tuşumuz var mıdır?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350403
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350403,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350404
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350404,
					"content": "Daktilomda bir tuş kayıp da, o yüzden yenisini almak için talepte bulunmak istiyorum. Elimizde yoksa... Yenisini satın aldığımda onun ücretini tazmin etseniz de olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350405
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350405,
					"content": "Tuş için masraf yazdırmak... Prensipte sorun olmamalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350406
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350406,
					"content": "Buraya imzanız gerekiyor. \"Daktilo arızası nedeniyle yedek tuş için tazmin talebi\" yazıp yanına adınızı ve ofisinizi yazın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350407
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350407,
					"content": "Tamam. Tuşu bugün alabilirim, değil mi? Acil iş bekliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350408
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350408,
					"content": "Bay Iaune, daha önce hiç kamu malı satın alımı için tazmin talebinde bulunmuş muydunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350409
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350409,
					"content": "İş masrafları için ödeme almak hiç hayal ettiğiniz gibi bir süreç değil... Bir şey satın alıp sonra onun parasını geri almak kadar kolay değil. Tüm tazmin makbuzlarını ve belgelerini her ay toplamamız, özet raporu hazırlamamız, sonra hepsini ay sonunda onay için Sayıştay Dairesine göndermemiz gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350410
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350410,
					"content": "Bu onay süreci de tüm Hukuk Dairesi için maaşların onayı ve ödenmesiyle bağlantılı. Masraf yazdırılan tutar çok fazlaysa Sayıştay Dairesinin onay için masrafı bizzat Mösyö Neuvillette'e göndermesi gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350427
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350427,
					"content": "Resmi olarak ödemeler yalnızca inceleme tamamlandıktan ve her şey imzalandıktan sonra gönderilebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350411
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350411,
					"content": "Mösyö Neuvillette'in de belirli bir masraf hakkında sorusu olursa masraftan sorumlu çalışanın yazılı bir rapor iletmesi gerekiyor... Önümüzdeki birkaç gün içinde toplu masraf raporunun ilk bölümünü yollayacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350412
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350412,
					"content": "Yani diyorsunuz ki şansımın kapanacağı tutarsa daktilo tuşunun parasını almam için bizzat Mösyö Neuvillette'in imzası gerekebilir, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350413
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350413,
					"content": "Kurallar böyle Bay Iaune. Bu ayın da toplam masraf tutarı epey kabarık. Mösyö Neuvillette'in raporları bizzat incelemesi gerekli olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350414
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350414,
					"content": "Mösyö Neuvillette... Bir dakika, Başyargıcınız değil mi o?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350415,
					"content": "Alt tarafı bir tuş... Gidip ondan imza almak... Doğru değil sanki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350416,
						740350417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740350416,
					"content": "Başka yolu yok mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350418
					]
				},
				{
					"id": 740350418,
					"content": "Bence de. Sonuçta alt tarafı bir tuş. Mösyö Neuvillette'e zahmet vermeye ne gerek var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350419
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350419,
					"content": "Doğru, başka yolu var. Evet... Önce kendiniz gidip bir tuş satın alabilirsiniz, sonra size kamu hesaplarında resmi bir borç kabul belgesi hazırlayabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350420
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350420,
					"content": "Tazmin işlemleri kayda geçtikten ve ödeme işlemleri tamamlandıktan sonra alacağınız tutar doğrudan devlet hazinesinden size ödenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350421
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350421,
					"content": "Süper! Öyle yapalım! Sonuçta tuş pahalı bir şey değil, kendim ödeyebilirim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350422
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350422,
					"content": "O zaman lütfen burayı imzalayın. Gerekçe olarak yine \"Daktilo arızası nedeniyle yedek tuş için tazmin talebi\" yazmanız gerekiyor... Yeni tuşu Bayan Estelle'den mi alacaksınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350423
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350423,
					"content": "Evet. Bir sorun mu var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350424
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350424,
					"content": "Öyleyse borç senedini Bay Roialte'e götürüp imzalatayım, sonra Bayan Estelle'e verip satın alma tutarını onaylatayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350425
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350425,
					"content": "Sizin yapacağınız bir şey yok ama, merak etmeyin. Gidip tuşunuzu alın, gerisini ben hallederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350426
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740350426,
					"content": "#Çok sağ olun! Harikasınız Bayan Cornelia. Hemen almaya gidiyorum şimdi... Hadi {NICKNAME}, buradaki işimiz bitti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350417,
					"content": "Bence başka bir şey deneyelim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350427
					]
				}
			]
		},
