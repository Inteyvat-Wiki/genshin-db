			"dialogs": [
				{
					"id": 740350301,
					"content": "Daktilo için tuş... Semaine, bu tür şeyleri masraf yazdırabiliyor muyuz yahu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350302
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740350302,
					"content": "Emin değilim. Ama daktilolar masraf yazdırılıyorsa... Daktilo tuşu için de masraf yazdırılıyor olmalı.",
					"roleType": "TALK_ROLE_NPC",
