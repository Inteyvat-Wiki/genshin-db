					"nextDialogs": [
						740350602
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740350602,
					"content": "Estelle! Daktilo için tuş lazım, ne olur! Sende vardır, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350603
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350603,
					"content": "Var tabii ama daktilolarda bir sürü farklı tuş oluyor. Hangisinin gerektiğine gel kendin bak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350604
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740350604,
					"content": "Iaune etrafta bakınmaya koyulur, ihtiyacı olan tuşu ışık hızında aramaktadır...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740350605
					]
				},
				{
					"id": 740350605,
					"content": "Hah, buldum! İşte bu! Ücretini şöyle vereyim, sağ ol Estelle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350606
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740350606,
					"content": "Geçen sefer benimle tekne turuna çıkmak istediğini söylemiştin... Iaune! HEY! Iaune!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Estelle"
				}
			]
		},
