			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xueyoni"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750330201,
					"content": "Gel bakalım evlat, gel de çocuklarımla birlikte uç. Çiçek Tüyü Klanının en iyileriyle yarışma fırsatı öyle her zaman kapını çalmaz, ona göre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330202
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330202,
					"content": "Parkurda <color=#00E1FFFF>uçan meşaleyi</color> yakalamalısın. İlk yakalayan kazanır. Küçükken de onları bu şekilde eğitirdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330203
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330203,
					"content": "<color=#00E1FFFF>Meşale, kırmızı tüylerle bezeli bir balona bağlı.</color> O balon da bir savaşçıda olması gereken sorumluluk bilincini ve onuru simgeliyor. Evlatlarım için ben hazırlamıştım onu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330204
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330204,
					"content": "Görünce anlarsın zaten. Ee, yarışmaya var mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330205,
						750330207
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330205,
					"content": "Hazırım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330206
					]
				},
				{
					"id": 750330206,
					"content": "Haha, harika! Hadi başlangıç noktasına gidip hazırlanalım o halde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330207,
					"content": "Biraz zamana ihtiyacım var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330208
					]
				},
				{
					"id": 750330208,
					"content": "Hazır olunca söylersin o halde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xueyoni"
				}
			]
		},
