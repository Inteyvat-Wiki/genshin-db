			"dialogs": [
				{
					"id": 750330401,
					"content": "Ne güzel uçtun öyle evlat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330402
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330402,
					"content": "Nasıldı uçuşum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330403,
						750330404
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330403,
					"content": "Harikaydın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330405
					]
				},
				{
					"id": 750330405,
					"content": "Desteğin için sağ olasın ama sen benden en az bir kademe üsttesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330406
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330406,
					"content": "Acomitl...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330407
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750330407,
					"content": "Hayır, hayır, o anlamda demiyorum. Başkalarını geçemediğim için cesaretim kırılmış da değil. Uçabildiğimi biliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330408
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330408,
					"content": "Yine de uzun zamandır formda olmamak özgüvenime zarar verdi açıkçası. Uçma işine sakin yaklaşamıyorum artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330409
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330409,
					"content": "#{NICKNAME} çok farklı biri. Duruşu bile çok daha rahat. Aradaki fark da ayan beyan ortada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330410
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330410,
					"content": "Kardeşim de sen de artık bir karar vermemi ve meseleyi ertelemeyi bırakmamı istiyorsunuz baba, farkındayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330411
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330411,
					"content": "Fakat size bedenimin, beynimin ve kalbimin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330412
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330412,
					"content": "... Hepsinin aslında kaderimde olmayan bir yoldan gitmeyi reddettiğini söylesem yine de destekler miydiniz beni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330413
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330413,
					"content": "Bu kendi kararınsa ve sonuçlarına katlanmaya razıysan sorun yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330414
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330414,
					"content": "Matahga, peki ya sen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330415
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330415,
					"content": "Ayıp oluyor ama! Böyle bir zamanda seni eleştirmeyeceğim tabii ki. Nasıl biri olduğunu hep biliyordum zaten abi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330416
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750330416,
					"content": "Eğer bu işin altından kalkamayacağım diyorsan bu defteri kapat artık. Kendine karşı dürüst olduğun sürece savaşçı olmaya devam edersin. Kimsenin seni eleştirmeye hakkı yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330417
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750330417,
					"content": "Bazen Usta Eğitmenlerin işi son derece kolay oluyor. Savaşçılar için idman planları yapsam da kendim katılmak zorunda değilim mesela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330418
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330418,
					"content": "Ancak ben de eskiden her gün Sürüngenlerle uçardım. Öyle bir yaşamın gerçek yüzünü iyi bilirim yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330419
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330419,
					"content": "Diğerlerini eleştirmek kolaydır. Kendin eyleme geçmek ise her zaman daha zordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330420
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330420,
					"content": "Bir eğitmen olarak takımın hoşuna gitmeyecek olsa bile hem bedenen hem de zihnen toparlanmak için biraz izin almanı öneriyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330421
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330421,
					"content": "Baban olarak ise artık bu yoldan gitmek istemediğini biliyorum ve kararına saygı duyuyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330422
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330422,
					"content": "Artık hava bölüğünün bir parçası olmaman dünyanın sonu değil. Çiçek Tüyü Klanının savaşçıları, değerlerini sadece uçarak kanıtlamak zorunda değil sonuçta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330423
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330423,
					"content": "Teşekkür ederim... Vereceğiniz tepkiden çok çekiniyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330424
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330424,
					"content": "Bu konuyu fazla düşünme. Biz senin aileniz, ne olursa olsun her zaman bir çıkar yol bulmana yardım ederiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330425
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330425,
					"content": "Savaşçı olmak amma zormuş hakikaten! Paimon, Çiçek Tüyü Klanının hava bölüğüne katılmanın bu kadar zor olacağını düşünmemişti doğrusu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330426,
						750330428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750330426,
					"content": "Herkesin kendince çektiği zorluklar var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330427
					]
				},
				{
					"id": 750330427,
					"content": "Doğru! Yolculuğumuz sırasında onca şeyle karşılaştık, hepsinin de üstesinden geldik. Bu da bizim gurur kaynağımız, değil mi ama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750330430,
					"content": "Savaşçı olmak ne kadar zorsa olgunlaşıp savaşçıdan bir kahramana dönüşmek de o kadar zordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330431
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330431,
					"content": "Kahraman olmak için gereken niteliklere sahip olan nice savaşçı tanıdığım için biliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330432
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330432,
					"content": "Sen de sayısız imtihandan geçmiş olmalısın, değil mi evlat? Gözlerinden okunuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330433,
						750330434
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330433,
					"content": "Ne sen sor, ne ben söyleyeyim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330435
					]
				},
				{
					"id": 750330435,
					"content": "Yanılmamışım demek ki. Senin yolun bizimkinden farklı, henüz o yolun sonuna gelmiş de değilsin. Geleceğin kahramanına yardım etmekten memnun olurum tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330436
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330436,
					"content": "Hem sen ailemle tanıştın ve onlara yardımcı oldun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330437
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330437,
					"content": "Buradaki idman parkurunu kullanmak istersen haber ver. Buradan istediğin zaman kalkış yapabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330438
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330438,
					"content": "Teşekkürler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330439
					]
				},
				{
					"id": 750330439,
					"content": "Lafı bile olmaz. Kahramana dönüşeceğin o anı, göklerde ışıl ışıl parıldayışını görmek için sabırsızlanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330434,
					"content": "(Sessiz kal.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330435
					]
				},
				{
					"id": 750330428,
					"content": "Eh, savaşçılık herkese göre değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330429
					]
				},
				{
					"id": 750330429,
					"content": "Bu biraz ağır oldu ama mantıklı da aslında. Neyse, Paimon'un savaşçı olmak istediği de yok zaten. Her gün idman yapmak falan zor iş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750330404,
					"content": "Fena değildin.",
					"roleType": "TALK_ROLE_PLAYER",
