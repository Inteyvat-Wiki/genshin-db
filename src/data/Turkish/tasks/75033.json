			"dialogs": [
				{
					"id": 750330101,
					"content": "Neden direniyorum ki? Neden pes edemiyorum? Yeter ya... Pes ediyorum ben artık! Ne olur yardım et bana Manyoya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330102
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330102,
					"content": "Üff, senin bu hallerinden ben utandım burada! İşler her yolunda gitmeyince çocuk gibi tatava etmeyi bırak artık. Bir de kendine savaşçı mı diyorsun sen? Sana kardeşim demekten utanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330103
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750330103,
					"content": "Pardon da sen hiç mi zora düşmedin hayatında? Hiç mi yardıma ihtiyacın olmadı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330104
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330104,
					"content": "Olmaz olur mu, oldu tabii! Zaten bu yüzden özel idmanımın sonuçlarıyla ilgili babamın ve Manyoya'nın fikrini almaya geldim ya. Kendin gibi korkak mı sandın beni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330105
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750330105,
					"content": "Acomitl, kaptan bu konu üzerinde biraz daha düşünmen için istifanı reddetti bana sorarsan. Sıcağı sıcağına önemli kararlar verme hemen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330106
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330106,
					"content": "Sakin ol ve hangi yolu seçeceğine karar ver. Önemli olan daha sonra pişman olmaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330107
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330107,
					"content": "Emekli olmama rağmen ben bile geleceğin ne getireceğini bilmiyorum. Bu yüzden sana tavsiye verme hakkını da görmüyorum kendimde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330108
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330108,
					"content": "Aa! Siz kardeşsiniz demek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330109,
						750330110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750330109,
					"content": "Şoktayım şu an...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330111
					]
				},
				{
					"id": 750330111,
					"content": "Aa, siz ikiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330112
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330112,
					"content": "Ah, sevgili hayırsever dostum, neler oldu neler... Kaçış planım suya düştü maalesef.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330113,
						750330114
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330113,
					"content": "Pek şaşırmadım doğrusu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330115
					]
				},
				{
					"id": 750330115,
					"content": "Bu acıdan kaçmanın bir yolu yok mudur yahu? Savaşçı olmak hayattan bezdirdi beni. Neden her şey daha basit olamıyor sanki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330116
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330116,
					"content": "Hâlâ hava bölüğünü mü düşünüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330117
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330117,
					"content": "Üzgünüm Acomitl. Deneyimlerime dayanarak konuşacağım, işler asla kolaylaşmıyor maalesef.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330118
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330118,
					"content": "Matahga'nın kolluklarını tamir etmeyi az önce bitirdim. Seninkilere de bakayım mı Manyoya? ... Aa, misafirlerimiz varmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330119
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330119,
					"content": "Onlar evden uzakta idman yaparken tanıştığım maceracılar baba. Acomitl'e bile yardım etmişler hatta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330120
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330120,
					"content": "O halde merhabalar sevgili dostlar. Ben Xueyoni, usta eğitmenim ve bu çocukların babasıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330121
					],
					"speakerTitle": "Xueyoni",
					"speakerSubtitle": "Çiçek Tüyü Klanı Usta Eğitmeni"
				},
				{
					"id": 750330121,
					"content": "Acomitl'in durumu hiç de iyi görünmüyor, yardıma ihtiyacınız olursa haber verin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750330122,
					"content": "Teklifiniz için teşekkürler ama Acomitl gayet iyi durumda bence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330123
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330123,
					"content": "Ne? Onu kendi haline mi bırakacaksınız yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750330124,
					"content": "Haha! Hayır, demek istiyorum ki... Ya da şöyle anlatayım en iyisi. Sizler maceracısınız. Dolayısıyla Maceracılar Loncasına katılmış olmalısınız, öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330125
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330125,
					"content": "Maceracılar Loncası dediğin dört dörtlük bir organizasyondur. Siz maceracıların tutkusu dünyayı gezmek, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330126
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330126,
					"content": "Öyle bile olsa her maceracının kendince bir motivasyonu vardır mutlaka. Kimileri para için, kimisi bilgi için kimisi de boş boş oturmaktan sıkıldığı için keşfe çıkar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330127
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330127,
					"content": "Bu nedenle Maceracılar Loncasının herkesi tek sancak altında toplayabilmiş olması son derece etkileyici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330128
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330128,
					"content": "Mesela ben de hava bölüğünde Sürüngen süvarisi olarak hizmet edip emekli olmuş ve kabilemizin usta eğitmeni olma görevini üstlenmiş yaşlı bir adamım. Buna rağmen altı kabileden de usta eğitmenlerin yer aldığı bir Lonca nasıl olurdu, hayal bile edemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330129
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330129,
					"content": "Şey... Peki bunun Acomitl ile ne alakası var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750330130,
					"content": "Babamız duygularını böyle ifade ediyor işte. Hava bölüğündeyken Gukuzorlar da dahil herkes onun fikirlerini can kulağıyla dinlerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330131
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330131,
					"content": "Şimdi de kabilemizin usta eğitmeni oldu, o yüzden savaşçı olmak isteyen herkes onun öğütlerine kulak verir. Arkanıza yaslanıp dinleyin derim ben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330132
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330132,
					"content": "O dediklerin geçmişte kaldı Manyoya. Yine de başladığım hikayeyi bitireyim en iyisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330133
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330133,
					"content": "Biz usta eğitmenler, \"savaşçı\" idealine ulaşmayı hedefleriz. Bizi bu uğurda zaman ve çaba harcamaya, idman programlarımızı düzenlemeye teşvik eden şey bu hedeftir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330134
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330134,
					"content": "\"Hayalimizdeki savaşçıyı\" görmek isteriz fakat bunun nasıl bir savaşçı olduğuna tek bir kişi karar veremez tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330135
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330135,
					"content": "Usta eğitmenler olarak bırak Lonca kurmayı, kurallar ve prensipler üzerinde bile hemfikir olmakta zorlanıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330136
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330136,
					"content": "İşte o yüzden \"en iyi savaşçının\" sayısız sureti ve kişiliği vardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330137
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330137,
					"content": "Bazen çok güçlü bir iradeye sahip olurlar, bazen de kendilerinden şüphe duyarlar. Nasıl yaşlanacakları ve ölecekleri konusu bile bir endişe kaynağıdır mesela onlar için.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330138
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330138,
					"content": "Savaşçıların tükenmişlik sendromundan kaçabileceğini sanıyorsanız yanılıyorsunuz yani. Size kendinden şüphe etmenin ve aşırı yorgunluğun eninde sonunda herkesi tükettiğine dair birçok dokuma parşömen gösterebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330139
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330139,
					"content": "Çoğu savaşçının iri yarı olduğunu mu sanıyorsunuz? Dev gibi olup beş para etmeyen çok savaşçı tanıdım. Bunlar da dokuma parşömenlerde kayıtlıdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330140
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330140,
					"content": "Ve tabii ki savaşçılar da doğanın kanunu gereği elbet bir gün güçten düşer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330141
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330141,
					"content": "Çocuklarım bana savaşçı diyor ama şu halime bakın. Uçamayan yaşlı bir kuş gibiyim artık, yeterince gücüm yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330142
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330142,
					"content": "Her türlü klişe standart için biçilmiş kaftan olan güzel yüzlü bir savaşçı, Natlan'da bir kahraman olarak görülmeyecektir mesela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330143
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330143,
					"content": "Manyoya, Acomitl, Matahga. Sizi buraya Çiçek Tüyü Klanının kahramanları olmanız, bu diyara yükseklerden bakmanız için getirdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330144
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330144,
					"content": "Endişeleriniz ve arzularınız bir kahramanın uzun yolculuğunda gelip geçici şeylerdir, çözülmesi gereken sorunlar değildir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330145
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330145,
					"content": "Hava bölüğünden ayrılmak artık bir savaşçı olmadığın anlamına mı gelir? Hava bölüğüne katılınca otomatik olarak savaşçı mı sayılırsın? Bu soruların hiçbir anlamı yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330146
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330146,
					"content": "Hedeflerinizin olması, tereddüt etmek ve kaybolmuş hissetmek normaldir. Sizler savaşçısınız ve kahraman olmak için birtakım imtihanlardan geçmeniz gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330147
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330147,
					"content": "Şu anda olduğunuz kişiyi kabullenip bununla yaşamayı öğrenin ve bu tecrübeyi aşın. Asla sizi kontrol etmesine izin vermeyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330148
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330148,
					"content": "Natlan'da işler böyle yürür. Natlan'ın kahramanları yola böyle devam eder. Anlıyor musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330149
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330149,
					"content": "Anladım baba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330150
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750330150,
					"content": "Acomitl, hâlâ tereddütlü gördüm seni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330151
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330151,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330152
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330152,
					"content": "Ailemizde sürekli nasihat verilmez böyle. Gidip küçükken yaptığın gibi kardeşlerinle uç hadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330153
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330153,
					"content": "Bırak zihnin ve bedenin karar vermene yardımcı olsun. Eve tıkılıp kara kara düşünmenin bir faydası olmayacak sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330154
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330154,
					"content": "Anladım baba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330155
					],
					"speakerTitle": "Acomitl"
				},
				{
					"id": 750330155,
					"content": "#Usta Eğitmenler üstü kapalı mı konuşur hep böyle? Paimon dediğinden pek bir şey anlamadı. Sen anladın mı {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330156,
						750330157
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750330156,
					"content": "Evet. Bu iş bir Uçuş Mücadelesi içerecek diyor kısacası.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330158
					]
				},
				{
					"id": 750330158,
					"content": "Maceracı, çocuklarım bana senden bahsetti. Çok enteresan bir gençsin sen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330159
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330159,
					"content": "Manyoya ile yarışacak cesarete sahip olman, küçük Acomitl'e yardım etmen, hatta Matahga'nın bile takdirini kazanman... Gerçek bir savaşçı olduğun ortada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330160
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330160,
					"content": "Seni bu çocuklarla uçmaya davet ediyorum. Ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330161,
						750330162
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330161,
					"content": "Dünden hazırım ben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330163
					]
				},
				{
					"id": 750330163,
					"content": "Haha, pekala. Karar verince gelip bize haber verirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750330164
					],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330164,
					"content": "Üç evladım da Çiçek Tüyü Klanının en iyi havacılarındandır. Birlikte uçarken harika vakit geçireceksiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xueyoni"
				},
				{
					"id": 750330162,
					"content": "Önce biraz düşüneyim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330163
					]
				},
				{
					"id": 750330157,
					"content": "Hayır. Çocuk yetiştirme teknikleri benim için fazla karmaşık...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330158
					]
				},
				{
					"id": 750330114,
					"content": "(Omuz silk.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330115
					]
				},
				{
					"id": 750330110,
					"content": "Ben anlamıştım kardeş olduğunuzu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750330111
					]
				}
			]
		},
		{
			"id": 7503302,
