			"dialogs": [
				{
					"id": 751560101,
					"content": "*ağlar* Sonunda özgürüm! Bu Sürüngen vagonundan kurtuldum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560102
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560102,
					"content": "Of. Ne sıcak, ne havasızdı arabanın içi... Üstelik leş gibi kokuyordu! Yarım gün içinde oturdum ama ömrümden iki üç yıl gitti sanki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560103
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560103,
					"content": "Yine mi sen? Gerçekten mi? Bu sefer ne oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751560104
					]
				},
				{
					"id": 751560104,
					"content": "Aa, senmişsin kurtarıcım! Yolculuklarımız sırasında sana yine rastlamayı... Daha doğrusu, beni yine kurtarmanı beklemiyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560105
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560105,
					"content": "Aa, daha önce adımın Conulaf olduğunu ve Gece Rüzgarının Ustalarından bir rahibe adayı olduğumu söylememiş miydim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560106
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560106,
					"content": "Eğitimim halen devam ediyor, kabilemin büyükleri bana Natlan'ın her yerinde bulunmayı bekleyen ata yadigarı hazineler olduğunu söylediler. \"Git de biraz hazine avla Conulaf!\" dediler bana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560107
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560107,
					"content": "Ve beni eğitim bahanesiyle kabileden kovdular.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560108
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560108,
					"content": "Ve hassas kulaklarım yakınlardaki bir hazineye dair ipuçları yakaladı... Bir hayvanın ayak izlerini takip edersem hazineyi bulacakmışım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560109
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560109,
					"content": "Ancak hayvan dediği Yük Hayvanı olabilir mi? Yoksa Alpaka falan mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560110
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560110,
					"content": "Her neyse, bir Yük Hayvanını bu kişilerin kurduğu kampa kadar takip ettim, ancak beni Yük Hayvanını çalan bir hırsız zannedip hapsettiler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560111
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560111,
					"content": "Gömülü hazineyi ararken az daha ben gömülüyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560112
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560112,
					"content": "Başından beri ipuçlarında eksik varmış zaten...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751560113
					]
				},
				{
					"id": 751560113,
					"content": "Doğru diyorsun! Bir daha bu kadar aceleci davranmayacağım... Hımm. Belki de en kıymetli hazine bu olaydan çıkardığım derstir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560114
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560114,
					"content": "*iç çeker* Bu kokudan kurtulmak için güzelce duş alabileceğim bir yer bulmalıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751560115
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751560115,
					"content": "Çok teşekkür ederim kurtarıcım! Sana olan minnettarlığımı göstermek için sınırlı seyahat bütçemden artırdığım bu hediyeyi kabul et lütfen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Conulaf"
				}
			]
		},
