			"dialogs": [
				{
					"id": 760280301,
					"content": "#Ayyy, işte buradasın, {NICKNAME}! O iki parlayan şey birbirine çarptığında patlama Paimon'u havaya uçurdu! İyi ki yaralanmadı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280302,
					"content": "Paimon'un buraya geri uçması çok uzun sürdü... Paimon iyi olduğun için çok mutlu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280303,
						760280308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280303,
					"content": "Aslında, ben de biraz uçtum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760280304
					]
				},
				{
					"id": 760280304,
					"content": "Paimon anla... Hı? Dur, uçmaktan kastın ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280305,
					"content": "Paimon'a az önce gördüklerini anlatıyorsun...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760280306
					]
				},
				{
					"id": 760280306,
					"content": "#Hımm, Paimon Teyvat'ta böyle bir yer olduğunu duymamıştı hiç... Gördüğün şeyin gerçek olduğundan emin misin {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280307,
					"content": "Her neyse, sen iyi olduğun sürece gerisi önemli değil! Burada çok fazla tuhaf şey oluyor. Çok geç olmadan gidelim buradan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280312,
					"content": "Off, Paimon bu kadar tehlikeli olacaklarını düşünmemişti. Üstelik sonunda hazine bile bulamadık... Böyle bir şey neden burada ortaya çıkmış olabilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760280313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760280313,
					"content": "Ve eğer o parlayan iki şey Peri değilse... O zaman neydi onlar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
