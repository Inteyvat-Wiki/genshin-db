			},
			"dialogs": [
				{
					"id": 200330101,
					"content": "Gezgin, gel de bir bak! Ne düşünüyorsun? Yakışmış mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330102
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330102,
					"content": "Ah, bu üniforma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330103
					]
				},
				{
					"id": 200330103,
					"content": "Aynen öyle! Maceracılar Loncası sınavını geçtim. Artık resmi olarak tanınan bir maceracıyım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330104,
						200330105
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330104,
					"content": "Harika görünüyorsun!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330106
					]
				},
				{
					"id": 200330106,
					"content": "Hehe, teşekkürler. Abimi de sınava girmeye ikna etmeye çalıştım ama ne dediysem reddetti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330107
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330107,
					"content": "Maceralara ilgim yok... Ayrıca ikimiz de maceracı olursak ebeveynlerimizle kim ilgilenecek?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330108
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330108,
					"content": "O zaman onları da yanımızda getirelim! Birlikte dünyayı gezebiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330109
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330109,
					"content": "Sen... Tamam, tamam. Artık bir maceracısın, yani elinden gelenin en iyisini yapmalısın. Evdeki meseleleri bana bırak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330110
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330110,
					"content": "Ama unutma, yaralanma ve kendine aşırı yüklenme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330111
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200330111,
					"content": "Tamam, tamam anladım! Şimdi gidiyorum, bitirmem gereken bir görevim var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330112
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330112,
					"content": "Gezgin, benimle gelmek ister misin? Maceracılıkla ilgili sana sormak istediğim çok şey var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330113,
						200330114
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330113,
					"content": "Elbette.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330115
					]
				},
				{
					"id": 200330115,
					"content": "Bir bakalım. Görevimiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330116
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330116,
					"content": "Taşıma Balonuna Eşlik Etme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200330114,
					"content": "Tamamdır, hadi gidelim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330115
					]
				},
				{
					"id": 200330105,
					"content": "Tebrikler!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330106
					]
				}
			]
		},
