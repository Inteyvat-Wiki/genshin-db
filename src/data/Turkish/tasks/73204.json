			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732040101,
					"content": "Siz veletler burada ne yapıyorsunuz bakayım? \"Taş yetiştiren\" yaşlı adamla dalga geçmeye geldiniz, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040102
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040102,
					"content": "Ben gayet iyiyim bir kere! Köylülerin benim için endişelenmesine gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040103
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040103,
					"content": "Neden bu kadar kızdın ki şimdi bize?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040104,
					"content": "Yanlış anlıyorsun, biz Aaru Köyü'nden değiliz. Seninle dalga geçmeye de gelmedik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040105,
						732040107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040105,
					"content": "Sadece geçiyorduk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040106
					]
				},
				{
					"id": 732040106,
					"content": "Geçiyor muydunuz? Hımm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040110
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040110,
					"content": "Normalde sadece bazı eski dostlarım gelip fidelikten vazgeçmemi ve köye geri dönmemi ister de.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040111
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040111,
					"content": "Bir de birkaç yaramaz çocuk gelir arada. Canımı sıkmak için buralarda koşturup dururlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040112
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040112,
					"content": "İlk defa böyle giyinmiş çocuklar görüyorum. Ne iş yapıyorsunuz siz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040113,
						732040116
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040113,
					"content": "Ben bir gezginim. Ailemi arıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040114
					]
				},
				{
					"id": 732040114,
					"content": "Doğru, bu uğurda çok yol teptik ve birlikte bir sürü maceraya atıldık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040115,
					"content": "#{NICKNAME} her yönden dürüst ve güvenilir biridir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040119,
					"content": "Yalnız ve yaşlı insanlara zorbalık falan etmeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040120,
					"content": "Yani endişelenmene gerek yok, ihtiyar. Niyetimiz kötü değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040121,
					"content": "Öhöm. İki çocuktan özür dilemek zorunda kalmak ne utanç verici... Çok özür dilerim sizden, ön yargılı davranmamam gerekirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040122
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040122,
					"content": "Lütfen bu ihtiyar Affan'ın özrünü kabul edin çocuklar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040123
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040123,
					"content": "Bu genç yaşta başınızın çaresine bakabiliyorsunuz belli ki. Böyle olmanız oldukça etkileyici. Ben sizin yaşınızdayken hiç böyle değildim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040124
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040124,
					"content": "O zaman doğru mu anlıyorum? Çözemediğim bir sorun olduğunda sizden yardım isteyebilirim, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040125
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040125,
					"content": "Oo, bize bir görev mi vereceksin yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040126,
					"content": "Sorun neydi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040127
					]
				},
				{
					"id": 732040127,
					"content": "Benim aslında iki fideliğim vardı. Biri burada, diğeri de köyün batı yakasında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040128
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040128,
					"content": "Artık çok yaşlandım ve ikisiyle birden ilgilenmek gittikçe daha zor olmaya başladı. Diğer fideliğe birkaç gün uğramadım, sonra da garip siyah bir şey yüzünden tüm fidelik mahvoldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040129
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040129,
					"content": "İnanılmaz tehlikeli bir şey olduğu belli. Bir kere girdim ve içinden çıkamayacağım sandım. Bir daha oraya hayatta adımımı atmam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040130
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040130,
					"content": "En büyük dileğim fideliği iyileştirip orada yine çiçek yetiştirmek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040131
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040131,
					"content": "#Çok zormuş gibi durmuyor. Ne dersin? Bu görevi kabul edelim mi {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040132,
					"content": "Elbette.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040133
					]
				},
				{
					"id": 732040133,
					"content": "Fidelik köyün batısında. Kaybolmayın sakın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040134
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040134,
					"content": "Tamamdır! Merak etme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040116,
					"content": "Dünyayı keşfe çıkmış bir maceracıyım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040117
					]
				},
				{
					"id": 732040117,
					"content": "Aynen öyle! Sumeru'ya varmak için tırmanmadığımız dağ, aşmadığımız göl ve deniz kalmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040118,
					"content": "Nasıl derler? Biz, şey... yüce gönüllü iki maceracıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040107,
					"content": "Birileri burada çiçek yetiştiriyormuş diye duydum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040108
					]
				},
				{
					"id": 732040108,
					"content": "Doğru duymuşsun. Taş falan değil, çiçek yetiştiriyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040109
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040109,
					"content": "Düşündüm de... Üff, neyse. Şimdi ne desem bilemedim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040110
					],
					"speakerTitle": "Affan"
				}
			]
		},
		{
			"id": 7320404,
			"completionStepIds": [
				7320404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
