			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732040401,
					"content": "Döndünüz mü? Fidelik ne durumda? Sizce kurtarılabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040402
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040402,
					"content": "Hallettik bile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040403
					]
				},
				{
					"id": 732040403,
					"content": "Affan'a Solduranı anlatıyorsun.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732040404
					]
				},
				{
					"id": 732040404,
					"content": "Anladım. Demek o yüzdenmiş. Topraktan o kadar siyah şey çıkınca bir şeylerin yolunda gitmediğini anlamıştım zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040405
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040405,
					"content": "Güzel. Artık gönül rahatlığıyla tohumlarımı ekebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040406
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040406,
					"content": "Bu tohumlar filizlenecek, çiçek açıp yeniden tohum üretecekler. Ardından o tohumları da tarlaya ekeceğim ve daha sonra bütün arazi bu çiçeklerle kaplanacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040407
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040407,
					"content": "Aa, bu eciş bücüş taşlar da ne böyle? Bunlardan çiçek çıkacak mı sahiden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040408,
					"content": "Bunları nereden aldın Affan Dede? Seni kazıkladılar mı yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040409,
					"content": "Ne kadar temiz kalpli çocuklarsınız siz... Hiç merak etmeyin ama. Bu çiçeğin tohumlarını Morayla bile alamazsınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040410
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040410,
					"content": "Yaşlı... Şey, bir arkadaşım vermişti bana bu kıymetli tohumları. Normal fidelerden biraz farklılar anlayacağınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040411
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040411,
					"content": "Durum gittikçe garipleşiyor... Affan Dede sen tam olarak ne yetiştiriyorsun bakalım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040412,
					"content": "Hehe... Bir arkadaşımın dileğini ekiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040413
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040413,
					"content": "Ne tuhaf bir cevap. Dilekler ekilebilir mi ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040414,
					"content": "Anlatsam da anlayamazsın evlat. Fırsatınız olduğunda yine yanıma uğrayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040415
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040415,
					"content": "Bu arazi şu anda boş görünebilir ama bu üç tohum, bir gün bu fidelikte filizlenip çiçek açacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040416
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040416,
					"content": "İleride daha da fazlası çıkacak üstelik. Haha... Harika bir manzara olacağına hiç şüphem yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040417
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040417,
					"content": "Pekala. Yardımınızı istediğime göre karşılığını da vermeliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040418
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040418,
					"content": "Alın bunu çocuklar. Şu anda bu kadarını verebiliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040419
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040419,
					"content": "Oh, görev bitti! Paimon bu kadar koşturmacadan sonra çok acıktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040420,
					"content": "Koşan bendim aslında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040421
					]
				},
				{
					"id": 732040421,
					"content": "Paimon da koşuşunu yorumluyordu. Bu da yorucu bir iş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040422,
					"content": "Böyle küçük şeyleri kafana takma. Ödeneğimizle yiyecek bir şeyler alsak fena mı olur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040423,
					"content": "Hadi paramızla ne kadar yemek alabileceğimizi hesaplayalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040424,
					"content": "Bir bakalım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040425
					]
				},
				{
					"id": 732040425,
					"content": "Burada Moradan fazla yemek var... Döner Dürüm, Tahçin ve birçok sebze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040426,
					"content": "Bu kadarı da fazla ama. Affan Dede'den tüm günün yemeğini mi aldık?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040427,
					"content": "Ama köyün dışında tek başına yaşıyor. Bu onun için kolay olmamalı, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040428,
					"content": "Morayı boş ver. Bize tüm yemeğini verdiyse... Bunu kabul edemeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040429,
					"content": "Bir de taşa benzeyen tohumlar ekiyordu. Sanırım dilek tutmak için olduklarını söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040430,
					"content": "Çok uzun süre yalnız yaşadığı için hayal görmeye başlamış olabilir mi sence?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732040431,
					"content": "Paimon biraz endişelendi doğrusu. Zamanımız olduğunda yanına tekrar uğrayalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
