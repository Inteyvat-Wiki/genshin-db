			"dialogs": [
				{
					"id": 200440101,
					"content": "Ah, çok sinir bozucu... Bu konuda ne yapmalıyım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440102
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440102,
					"content": "Neler yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200440103
					]
				},
				{
					"id": 200440103,
					"content": "Favonius Şövalyeleri denemelerine hazırlanıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440104
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440104,
					"content": "*iç çeker* Ancak bir türlü Jean kadar güçlü olamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440105
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440105,
					"content": "Güçten çok tekniğe odaklanmanın benim için daha iyi olacağını düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440106
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440106,
					"content": "Mesela tüm tahta hedefleri tek hamlede nasıl kırabileceğimi düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440107
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440107,
					"content": "Boştaysan nasıl altından kalkacağımı bulmama yardım eder misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440108,
						200440109
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440108,
					"content": "Üzerine kafa patlatırım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200440110
					]
				},
				{
					"id": 200440110,
					"content": "Tabii, hiç acele etme. Bu talim hedeflerinin bir yere gittiği yok zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440111
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440111,
					"content": "Bunu nasıl çözeceğim diye düşünüp dururken aynı şey hayatım için de söylenebilir, of...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440114
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440114,
					"content": "Keşke daha büyük bir silahım ya da Jean gibi güçlü bir element yeteneğim olsaydı. Bu tahta hedefleri parçalamak çocuk oyuncağı olurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440109,
					"content": "Beraber denemeye ne dersin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200440112
					]
				},
				{
					"id": 200440112,
					"content": "Takım savaşını seviyorsun demek. Bazıları için iyidir, her zaman destek alabileceğin birileri olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440113
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200440113,
					"content": "Benim gibilerse yalnız savaşçı olarak kendi ayakları üstünde kalabildiği kadar kalmaya çalışır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440114
					],
					"speakerTitle": "Ellin"
				}
			]
		},
