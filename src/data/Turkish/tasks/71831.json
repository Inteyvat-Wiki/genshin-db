			},
			"dialogs": [
				{
					"id": 718310501,
					"content": "Yaktın mı? Nasıl hissediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310502
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310502,
					"content": "Gayet iyiyim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718310503
					]
				},
				{
					"id": 718310503,
					"content": "Buna sevindim. Umarım bu tapınakta tütsüler her daim yanmaya devam eder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310504
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310504,
					"content": "Ben bir süre daha burada kalacağım. Buranın sessizliğinde çalışmayı seviyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310505
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310505,
					"content": "Topladığım şu içerikleri düzenlemem ve Bekçi Yaksha hakkında yazdığım kitabımı derlemeye devam etmeliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310506
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310506,
					"content": "Vaktin olduğunda tapınağa hal hatır sormaya gelebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310507
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310507,
					"content": "Tütsü yakmak istersen gel benden al.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310508
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310508,
					"content": "*iç çeker* Aslında bu bölgenin çevresini de onarmak isterdim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718310509
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 718310509,
					"content": "Yolun yeniden döşenmesi ve iki tarafına da çit çekilmesi lazım. Bir de yakınlarda bir yere çiçek bahçesi yapsak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				}
			]
		},
