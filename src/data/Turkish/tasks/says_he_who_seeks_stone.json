			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Muning",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710740401,
					"content": "Gerçekten de Arkaik Taşlar bulmuşsunuz. Teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740402
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740402,
					"content": "Size gelmekle doğru kararı vermişim. Maceracılar Loncasına gitsem çok daha uzun sürerdi kesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740403
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740403,
					"content": "Hımm... Kim bilir. Belki de Maceracılar Loncası...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740404,
					"content": "Bizi görevlendirebilirdi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740405
					]
				},
				{
					"id": 710740405,
					"content": "Muhtemelen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740406
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740406,
					"content": "Maceracılar... Hımm... Eskiden hep kıskanırdım onları. Yüksek dağlara, derin zindanlara gözlerini kırpmadan girmeleri... Girmeye cesaret edemedikleri bir yer yok gibiydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740407
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740407,
					"content": "Ben hiç öyle biri değilim gerçi, yıllardır burada çalışıyorum ama Kanyon'un en tepesindeki Sülüğen Uçurumuna bir kere bile gitmedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740408
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740408,
					"content": "Ne? Hiç gitmedin mi gerçekten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740409,
					"content": "Sülüğen Uçurumu turist mekanı. Yerliler nadiren gider oraya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740410
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740410,
					"content": "Belki de bu kadar yakın olduğu için hep zamanım olunca giderim diye düşünüyorum ama hiç zamanım olmuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740411
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740411,
					"content": "Neden şimdi gitmiyoruz o zaman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740412,
					"content": "Spontane davranmak lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740413,
					"content": "Yok ben almayayım. Hâlâ işim var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740414
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740414,
					"content": "Ayrıca en iyisi böyle işleri maceracılara bırakmak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740415
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740415,
					"content": "Tehlikeli yerler onların ekmek teknesi sonuçta. Ben aynısını yapsam muhtemelen yaralanırım, yapmasam daha iyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740416
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740416,
					"content": "Mantıklı. Yaralanmak önemli bir sorun olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740417,
					"content": "Ben yaralanırsam kimse aşağıdaki keşif takımını denetlemez ve madencilerin güvenliğini sağlamaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740418
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740418,
					"content": "Bir şey olursa büyük sorun olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740419
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740419,
					"content": "Endişelendiğin konu buymuş desene... Paimon da yaralanmaktan korktuğunu sanmıştı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740420,
					"content": "Kanyon yakınlarındaki heybetli yüksek uçurumlar, dipsiz mağaralar... Rex Lapis'in arkasında bıraktığı kadim savaş alanı, hepsi tehlikeyle dolu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740421
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740421,
					"content": "Böyle yerlere gitmeyi hiç düşünmüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740422
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740422,
					"content": "Alın bakalım, getirdiğiniz üç Arkaik Taşın ödülü. Huishan Salonu daha fazlasını istiyor, bulursanız bana getirin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740423
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740423,
					"content": "Onların karşılığını da alacaksınız elbette. Siz sadece daha fazla Arkaik Taş bulursanız bana gelin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740424
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740424,
					"content": "Bize güvenebilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
