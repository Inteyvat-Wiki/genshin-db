			"dialogs": [
				{
					"id": 710740101,
					"content": "Arkaik Taş... *iç çeker* Kanyon'da çalıştığım onca sene bir tane belki görmüşümdür. Huishan Salonundaki önemli kişiler ne sanıyor acaba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740102
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740102,
					"content": "Bırak işi kendileri yapsın, o zaman anlarlar bu görevin ne kadar imkansız olduğunu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740103
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740103,
					"content": "Muning!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740104,
					"content": "Ha, senmişsin. Neden hâlâ Kanyon'un yukarılarında dolaşıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740105
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740105,
					"content": "Yani... Yanlış anlama beni, seni burada istemediğim için söylemiyorum. Merak ettim sadece... Başka önemli işlerin yok mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740106
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740106,
					"content": "Sana bakmak için geldik, çok üzgün duruyordun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740107,
						710740108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740107,
					"content": "Ne oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740109
					]
				},
				{
					"id": 710740109,
					"content": "*iç çeker* Arkaik Taşı biliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740110
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740110,
					"content": "Nadir görülen bir cevher, hatta o kadar nadir ki belki madende bile bulamazsın. Kanyon'da çalıştığım bunca sene sadece iki veya üç tane görmüşümdür. Hayal edemeyeceğiniz kadar güzel bir taş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740111
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740111,
					"content": "En güzel Arkaik Taşların içine bakarsanız saç teli kadar ince, parlayan ışık hüzmeleri göreceğinizi ve taşların renginin size alacakaranlıkta denizin ufkunu hatırlatacağını söylerler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740112
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740112,
					"content": "Bahsettiğin böyle bir taş mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740113
					]
				},
				{
					"id": 710740113,
					"content": "Ha, sizde... Sizde varmış cidden! Hem de gördüğüm en kaliteli taşlardan biri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740114
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740114,
					"content": "#Bu taşı bana satmaya ne dersin {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740115,
						710740116
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740115,
					"content": "Hayatta olmaz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740117
					]
				},
				{
					"id": 710740117,
					"content": "Evet! Bir arkadaşım hediye etmişti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740118,
					"content": "Ayrıca Paimon bu taşı alabilecek paran olduğunu hiç sanmıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740119,
					"content": "Şöyle ki... Satın almak isteyen bir alıcı tanıyorum, para sorun değil yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740120
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740120,
					"content": "Alıcı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740121,
					"content": "Evet. Huishan Salonundaki önemli kişiler bir şekilde taşı merak etmiş ve analiz etmek istemiş, o nedenle beni Kanyon'a gönderip birkaç örnek bulmamı istediler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740122
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740122,
					"content": "Ama ben işi bitirmeye çalışmakla... Yani... İşimi yapmakla meşgulüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740123
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740123,
					"content": "#Bir anlaşma yapmaya var mısın {NICKNAME}? Arkaik Taş bulursanız bana getirin. Huishan Salonunun vadettiği ödül sizin olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740124
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740124,
					"content": "Arkaik Taş olmaları yeter, sizinki kadar kaliteli olmasa da olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740125
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740125,
					"content": "Huishan Salonu ödülleri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740126,
					"content": "Normalde ben hallederdim ama Kanyon'da bir sürü işim var, lütfen bana yardımcı olun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740127
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740127,
					"content": "*iç çeker*... Tabii kaç tane istediklerini bilmiyorum. Şimdilik üç tane getirin, ne dersiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740128
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740128,
					"content": "Tamam, tamam. Bizde o iş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740116,
					"content": "Hayal kurmaya devam et.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740117
					]
				},
				{
					"id": 710740108,
					"content": "Bir sorun mu var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740109
					]
				}
			]
		},
