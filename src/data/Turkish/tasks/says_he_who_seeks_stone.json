					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740213,
					"content": "Her güzel renkli taş olmaz. O taş olmak zorunda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740214
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740214,
					"content": "#Hazır konusu açılmışken... Şuna ne dersin {NICKNAME}? Sen bu açıklamama uyan taşları bulmama yardım et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740215
					],
					"speakerTitle": "Muning"
				},
				{
