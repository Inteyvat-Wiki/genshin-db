			"dialogs": [
				{
					"id": 710740801,
					"content": "Bu üçünü de ekleyince toplam dokuz ediyor. Bu kadarı yeterli olur herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740802
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740802,
					"content": "Huishan Salonunun ihtiyacını çok hızlı karşıladınız. Sizi bu kadar övmelerine şaşırmamalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740803
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740803,
					"content": "Kolay oldu! Bizim için çantada terlikti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740804,
					"content": "Ona \"çantada keklik\" denir Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740805
					]
				},
				{
					"id": 710740805,
					"content": "Ne? Neyse, sonuçta çantaya terlik de sığar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740806,
					"content": "Şu haline bak. Söylediğini mantığa oturtmaya çalışıyorsun. Etkilendim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740807
					]
				},
				{
					"id": 710740807,
					"content": "Haha. Deniz canavarıyla savaşırken yaptığın kahramanlıkları hepimiz gördük. Bence böyle bir şeyi başarmak senin için hiç zor olmamıştır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740808,
						710740809
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740808,
					"content": "Hem de hiç zor olmadı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740810
					]
				},
				{
					"id": 710740810,
					"content": "Sivil İşler Bakanlığı üyesi olmak böyledir işte. Hâlâ Kanyon'da Arkaik Taş aramak gibi isteklerde bulunuyorlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740811
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740811,
					"content": "Bu arada, eskiden sürekli babanla kavga ettiğini ve işsiz olduğunu söylemiştin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740812,
					"content": "Öyleyse sonradan Bakanlığa nasıl girdin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740813,
					"content": "O zamanlar çok borcum olduğunu hatırlıyor musunuz? Ne gidebileceğim biri vardı ne de eve dönmek istiyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740814
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740814,
					"content": "Sonunda alacaklılar Shenglu Salonuna babamı bulmaya gitmiş. Öğrenince bacaklarımı kırar sanmıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740815
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740815,
					"content": "Ama bacakların iyi duruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740816,
					"content": "Evet. Söylemeye utanıyorum ama babam borcumu kapayıp yanıma geldi. Beni bulduğunda sokakta bitkin düşmüş bir köpek gibi duruyordum. \"Tüm borçlarını üstlendim. Artık borcun bana.\" dedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740817
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740817,
					"content": "Sonrasında beni borcumu ödemek için çalışmaya zorladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740818
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740818,
					"content": "Yani artık baban alacaklı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740819,
					"content": "Öyle denebilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740820
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740820,
					"content": "O zamanlarda alacaklılar peşimdeyken geceleri gözüme uyku girmiyordu. Ben de ikinci bir fırsat bulursam düzeleceğime yemin ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740821
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740821,
					"content": "Tabii bu fırsatı davranışlarımı hiç beğenmeyen babamın vermesini hiç beklemiyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740822
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740822,
					"content": "Bana hiç kızmadı. Bu sefer oturup dürüstçe ve samimiyetle konuştuk. Keşke daha önce de böyle konuşabilseydik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740823
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740823,
					"content": "Eskiden o konuşmak istese bile ben dinlemek istemezdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740824
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740824,
					"content": "Anlaşılan baban sana iyi davranıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740825,
					"content": "Evet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740826
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740826,
					"content": "O nedenle ne olursa olsun işimi iyi yapmam gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740827
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740827,
					"content": "İster Kanyon'daki olay ister Huishan Salonu için Arkaik Taş araması olsun, benim için fark etmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740828
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740828,
					"content": "Bu sefer işi senin yerine ben yaptım ama...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740829
					]
				},
				{
					"id": 710740829,
					"content": "Başkalarına iş yaptırmak da sayılır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740830
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740830,
					"content": "Yine de sorun yaşamadan ilerlememizi sağlayan sensin. Beklediğimden çok daha hızlı oldu bence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740831
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740831,
					"content": "Hımm. Paimon sonunda biraz müteşekkir olduğunu hissediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740809,
					"content": "Aslında biraz zor oldu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740810
					]
				}
			]
		}
	]
}