			},
			"dialogs": [
				{
					"id": 710740601,
					"content": "Üç tane daha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740602
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740602,
					"content": "Ulusumuzu düşünen iki vatandaşımızın verdiği Arkaik Taşları seve seve kabul ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740603
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740603,
					"content": "Bu kadar kısa sürede üç tane bulmanızı beklemiyordum. Ayrıca bunlar daha önce gördüklerimden çok daha kaliteli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740604
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740604,
					"content": "*iç çeker* Bunları görünce eski taşımı hatırladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740605
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740605,
					"content": "Arkaik Taşın mı var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740606,
						710740607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740606,
					"content": "Niye bizi Arkaik Taş aramaya gönderdin o zaman?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740608
					]
				},
				{
					"id": 710740608,
					"content": "Eskiden vardı demek istedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740609
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740609,
					"content": "Zamanında babam Shenglu Salonunda cevher işlerdi. O taş da artan parçalardan biri ve kalitesiz olduğu için babam da oynayayım diye bana verdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740610
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740610,
					"content": "Eskiden sürekli kavga ederdik. Hiç iş bulamıyordum. Daha da kötüsü, çoğunlukla Yanshang Çayevinde zaman geçiriyordum. Öyle olunca borçlarım çok birikti, başım belaya girdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740611
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740611,
					"content": "Hımm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740612,
					"content": "Yaptıkların biraz kötüymüş sanki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740613
					]
				},
				{
					"id": 710740613,
					"content": "Gençken herkes hata yapar... Neyse. Çaresiz kaldığım zamanlarda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740614
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740614,
					"content": "Biri Arkaik Taşım olduğunu görüp iyi bir fiyat teklif etti. Benim için sorun değildi. O zaman içinde bulunduğum durumdan kurtulmamı sağlayabilecek kadar Mora alacaktım. Bence adil bir pazarlıktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740615
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740615,
					"content": "Yine de babam sonraki gün o konuyu açtı. \"Muning, sana verdiğim taşı nereye koydun?\" diye sordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740616
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740616,
					"content": "\"Alt tarafı bir taş. Kaybedeli epey oldu.\" diyebildim sadece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740617
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740617,
					"content": "Öyle desem de kendimi \"Taşı satmasam ne olurdu?\" diye düşünmekten alamadım. Satmasaydım taştan bahsettiği zaman babama gösterebilirdim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740618
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740618,
					"content": "Neyse. Şimdi keşkeleri düşünmenin faydası yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740619
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740619,
					"content": "En azından hayırsız oğlu geri döndü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710740620,
					"content": "Haklısın. Tabii hâlâ borcumu kapatmak için epey uğraşmam lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740621
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740621,
					"content": "Konudan saptım. Daha fazla taş bulursanız getirin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740622,
						710740623
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740622,
					"content": "Bunlar yetmez mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740624
					]
				},
				{
					"id": 710740624,
					"content": "Hımm... Üç tane daha getirseniz yeterli olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740625
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740625,
					"content": "Arkaik Taş nadir bir cevherdir. Huishan Salonu daha fazla taş isterse Kanyon'dan bulabilir miyim bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muning"
				},
				{
					"id": 710740623,
					"content": "Sana kaç tane lazım ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740624
					]
				},
				{
					"id": 710740607,
					"content": "Önce seninkini görelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740608
					]
				}
			]
		},
