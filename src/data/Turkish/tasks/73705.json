			"dialogs": [
				{
					"id": 737050101,
					"content": "#{NICKNAME}, Paimon! Buraya gelin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050102
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737050102,
					"content": "\"Saha Güvenlik Merkezi\" ana üssüne hoş geldiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050103
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737050103,
					"content": "Gördüğünüz üzere ana projeler çoktan faaliyete geçti, o yüzden istediğimiz zaman çalışmaya başlayabiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050104
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737050104,
					"content": "Hım... Burası... Resimli romanlarda geçen yerleri andırıyor. Hani çaylakların bir araya gelip görev yaptıkları macera üsleri olur ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737050105,
					"content": "Aa! Aynı zamanda herkesin öğrenmek ve becerilerini geliştirmek için takımlar kurduğu okul şenliklerine benziyor... Hehe, çok heyecanlı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050106,
						737050107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737050106,
					"content": "Evet, ben de gaza geldim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050108
					]
				},
				{
					"id": 737050108,
					"content": "Burası bir okul şenliği kadar şatafatlı olmasa da Usta Tighnari, Akademinin kaynak konusunda eli açık davranacağını söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050109
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737050109,
					"content": "Neyse, öğrenci ve araştırmacılar tehlikeli görevlere çıkmadan önce buradan tavsiye ve acil durum eğitimi alabilirler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050110
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737050110,
					"content": "Hatta ekiplerine katılarak rehberlik ve güvenlik sağlayacak profesyonellerimiz bile var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050111
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737050111,
					"content": "Aynen, burayı bir \"İleri Harekat Üssü\" gibi düşünebilirsiniz; hem teorik eğitim hem de saha uygulamaları bir arada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050112
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 737050112,
					"content": "Yeni gelenleri vahşi doğadaki olası tehlikelere karşı hazırlayacak ve gerçek bir durumda panik yapmamaları için tatbikatlar yapacağız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050113
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 737050113,
					"content": "Amber? Sen de mi buradasın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050114,
						737050115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737050114,
					"content": "Bizim Kaşifin sorumlulukları mı arttı yoksa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050116
					]
				},
				{
					"id": 737050116,
					"content": "Haha, şaşırdın, değil mi? Ben de öyle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050117
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 737050117,
					"content": "Bugün izinliyim, o yüzden Collei'i ziyaret etmeyi planlıyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050118
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 737050118,
					"content": "Ama bu kadar yoğun olduğunu bilmiyordum! Boş durmayı da sevmediğim için yardım edeyim dedim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050119
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 737050119,
					"content": "Kusura bakma Amber. İzin gününde seni çalıştırmak istemezdim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050120
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737050120,
					"content": "Sorun değil! Hem dinlenip hem faydalı şeyler yapmak benim için harika bir tatil sayılır! Üstelik bir sürü yeni şey de öğrendim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050121
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 737050121,
					"content": "#Ayrıca {NICKNAME} ve Paimon'u da yeniden görmüş oldum! Daha ne isterim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050122
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 737050122,
					"content": "Buradaki işimiz bitince büyük bir ziyafet çekelim. Ne dersiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050123
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 737050123,
					"content": "Hehe, Sumeru'da ve yolculuğumuzun başında ilk tanıştığımız arkadaşlarımızla birlikte ziyafet çekme fikri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737050124,
					"content": "Kocaman bir tabak Karamelize Soslu Rosto kadar güzel geliyor kulağa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050125,
						737050126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737050125,
					"content": "O zaman işe koyulalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050127
					]
				},
				{
					"id": 737050127,
					"content": "Tamamdır! Başlayalım o halde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050128
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 737050128,
					"content": "Collei ve ben, hızlı kaşifler projesinden sorumluyuz. Tehlikeli bölgelerden geçmek, araziyi incelemek ve olası tehditler hakkında bilgi toplamak için cihazlar ve makinalar kullanmaya odaklanıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050129
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 737050129,
					"content": "Ayrıca Amurta araştırmaları, tehlikeli durumlarda sevimli bir yol arkadaşının desteğinin maceraperestlerin zihnini rahatlatarak aşırı gerginliği önlediğini gösteriyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050130
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737050130,
					"content": "Bu yüzden, hem sevimli hem de kullanışlı iki keşif cihazı geliştirmek için Cuilein-Anbar ve Baron Tavşan'dan ilham aldık: \"Cuilein An-bot\" ve \"Bar-dron Tavşan\". Şu ana kadar gelen tepkiler oldukça olumlu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050131
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 737050131,
					"content": "Yeterli veri topladıktan sonra Akademi, Gözcü Yoldaşları geliştirmeye devam edecek ve piyasaya yeni tasarımlar sürecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050132
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737050132,
					"content": "Her yerde Cuilein-Anbarlar ve Baron Tavşanlar koşuşturuyor... Nasıl bir görüntü olacak acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050133,
						737050134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737050133,
					"content": "Gözler bayram edecek kesinlikle!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050135
					]
				},
				{
					"id": 737050135,
					"content": "Hem siz de bu iki küçük gözcümüze rehberlik ederseniz harika veriler elde ederiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050136
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737050136,
					"content": "Saha Güvenlik Merkezi hakkında daha fazla bilgi edindiğinizde gelip onları test etmelisiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050137
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737050137,
					"content": "Şimdi benimle gelin. Sizi diğer danışmanlarla tanıştırayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050138
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737050138,
					"content": "Aa, evet! Oradaki yeşilimsi mavi saçlı kadının da çok sevimli bir cihazı var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050139
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 737050139,
					"content": "Ama o, bizim gözcü yoldaşlarımızdan tamamen farklı bir şey yapıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050140
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 737050140,
					"content": "Onları iş başında görmek için sabırsızlanıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050141
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 737050141,
					"content": "Aa! Tanıdık bir sima daha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737050142,
					"content": "Hadi gidip selam verelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737050134,
					"content": "Paimon pek gözünde canlandıramadı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050135
					]
				},
				{
					"id": 737050126,
					"content": "Sıkı çalışalım ki ziyafetimiz de keyifli olsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050127
					]
				},
				{
					"id": 737050115,
					"content": "Dört bir yandan destek çağırıyorsun Collei!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050116
					]
				},
				{
					"id": 737050107,
					"content": "Ne tür resimli romanları okuyorsun Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050108
					]
				}
			]
		},
