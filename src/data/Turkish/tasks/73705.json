			"dialogs": [
				{
					"id": 737050201,
					"content": "... Gerçekten bu kadar popüler mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050202
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 737050202,
					"content": "İçindeki hareket mekanizması gayet akıllıca, ayrıca arazi tanıma, uzaktan kontrol ve ağırlık algılama modüllerinin uygulanması da fena değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050203
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 737050203,
					"content": "Ama görünüşü... Çocuk oyuncağından hallice. Yok, bu olmaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050204
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 737050204,
					"content": "Madam Faruzan! Müjde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050205
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737050205,
					"content": "#{NICKNAME} ve Paimon da aramıza katıldı! Saha Güvenlik Merkezi seviye atladı resmen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050206
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737050206,
					"content": "Hehe! Merhaba Madam Faruzan! Yardıma geldik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737050207,
					"content": "Kimleri görüyorum böyle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050208
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 737050208,
					"content": "Harika iş çıkardın Collei! Maceracılık konusunda tartışılmaz uzmanlığa sahip iki kişiyi de aramıza katmışsın... Artık ben ne dersem diyeyim Ligden kimse sesini çıkaramaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050209
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 737050209,
					"content": "Söyleyin bakalım... Bu \"Bulmaca Dostu\" hakkında ne düşünüyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050210
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 737050210,
					"content": "Vay canına... Tıpkı sana benziyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050211,
						737050212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737050211,
					"content": "İnsana güven veriyor ve rahat hissettiriyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050213
					]
				},
				{
					"id": 737050213,
					"content": "Bu, Haravatat Darşanındaki genç araştırmacıların, Bulmaca Liginin ve Harabe Mekanizmaları Sempozyumunun ortak çalışması.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050214
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 737050214,
					"content": "Teknolojik açıdan oldukça gelişmiş olduğu açık, ama görünüşü... Bundan daha çocukça olamazdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050215
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 737050215,
					"content": "Anis'i görmeliydiniz! Bu tasarım kararını tezini savunur gibi savunuyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050245
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 737050245,
					"content": "Hıh, zamane gençleri... Her şeyi sevimli yapmakla kafayı bozmuşlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050216
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 737050216,
					"content": "Paimon'un hoşuna gitti aslında!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737050217,
					"content": "Collei ve Amber daha demin sevimli dostların maceracıları nasıl sakinleştirdiğinden bahsediyorlardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737050218,
					"content": "Paimon'un yanında sana benzeyen bir oyuncak bebek olursa, zifiri karanlık bir harabede bile hiç korkmadan maceraya atılabilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737050219,
					"content": "Bu mantıklı bir düşünce aslında. Ve sanırım bu görünümü seçmeleri, duydukları saygının bir göstergesi... Öhöm, yani bana duydukları saygının.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050220
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 737050220,
					"content": "Yine de güvenilirliğe ve teknik özelliklere daha çok önem veren maceracılar da var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050221
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 737050221,
					"content": "Böyle insanlar sadece cihazlarının bir çığdan sağ çıkmasını değil, aynı zamanda öyle görünmesini de ister... Hatta görünümlerinin yüksek teknolojiyi yansıtmasını beklerler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050222
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 737050222,
					"content": "Öte yandan bu Bulmaca Dostunun pofudukluğu güvenilir ve sağlam bir cihaz izlenimi vermiyor. Hatta görünümü dikkat bile dağıtabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050223
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 737050223,
					"content": "Şimdi şunu hayal edin... Kalın metal bir kaplama, kare bir şekil, mat bir yüzey ve içindeki karmaşık teknolojiyi sergileyen açıklıklar... Görsel anlamda bu çok daha etkileyici olurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050224
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 737050224,
					"content": "Ben bunun en iyi örneğiyim. Genç göründüğüm için insanlar beni sorguluyor bazen. Beyaz saçlı olsaydım her şey farklı olurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050225
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 737050225,
					"content": "G-Gerçekten mi? O zaman Paimon'un onları ikna etmesini ister misin? Onun beyaz saçları var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737050226,
					"content": "Ne? Hayır! Bu... Bu aynı şey değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050227
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 737050227,
					"content": "Aa... Bu konuda bu kadar katı olduğunu bilmiyordum Madam Faruzan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050228,
						737050229
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737050228,
					"content": "Bence böyle gayet iyi görünüyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050230
					]
				},
				{
					"id": 737050230,
					"content": "Ha? Yani... Sen bile bu versiyonu mu tercih ediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050231
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 737050231,
					"content": "Öhöm... O halde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050232
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 737050232,
					"content": "Eğer gerçekten böyle düşünüyorsan... Dediğin gibi olsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050233
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 737050233,
					"content": "#O zaman gelip onu bazı bulmacalar üzerinde denemen gerekecek {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050234
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 737050234,
					"content": "Cihazı ne kadar etkili kullandığını değerlendirecek ve performansına göre bir kullanım kılavuzu hazırlayacağım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050235
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 737050235,
					"content": "Görünüşüyle ilgili geliştirmeler içinse uzun süreli gözlem gerekiyor, o yüzden şimdilik onu erteleyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050236,
						737050237
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 737050236,
					"content": "Elimden geleni yapacağım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050238
					]
				},
				{
					"id": 737050238,
					"content": "Şimdiden en uygun Zindanlardan birkaçını seçtim bile, böylece istediğimiz zaman bulmaca çözmeye başlayabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050239
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 737050239,
					"content": "#Teşekkürler Madam Faruzan. Ben de {NICKNAME} ve Paimon'a son projeyi göstereceğim... Ama uzun sürmez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050240
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737050240,
					"content": "Merak etme Collei! Buradaki sorumlu sensin, sadece kendini çok yorma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050241
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 737050241,
					"content": "İşler biraz sakinleşince beni ziyarete gel, biraz sohbet ederiz. Hatta sana eskilerden kalma atıştırmalıklardan da ikram ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050242
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 737050242,
					"content": "Atıştırmalık mı? Paimon da istiyor, Paimon da istiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737050243,
					"content": "Teşekkür ederim Madam Faruzan. Ben de birkaç kutu bitki çayı getiririm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050244
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737050244,
					"content": "Hadi gidin bakalım. Göreyim sizi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 737050237,
					"content": "Bulmaca Dostunun tüm özelliklerini kullanmaya çalışacağım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050238
					]
				},
				{
					"id": 737050229,
					"content": "Belki kare modelini bir dahaki sefere saklarız.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050230
					]
				},
				{
					"id": 737050212,
					"content": "Maceracılık ekipmanına hiç benzemiyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050213
					]
				}
			]
		},
