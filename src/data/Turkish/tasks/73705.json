			"dialogs": [
				{
					"id": 737050301,
					"content": "Bu sonuncusu, Emniyet Birimi adını verdiğimiz uzun vadeli bir proje.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050302
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737050302,
					"content": "General Mahamatra Cyno sayesinde, eğitmen olarak Dehya'yı ve koordinatör olarak Candace'ı göreve getirebildik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050303
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737050303,
					"content": "Şu anda bir savaş testi hazırlıyorlar, ancak birazdan dönerler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050304
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737050304,
					"content": "Hey! Bizi mi arıyordunuz? Görünüşe göre tam zamanında geldik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050305
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 737050305,
					"content": "#Ne, {NICKNAME} ve Paimon da mı katılıyor? Bu, işimizi çok daha kolaylaştıracak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050306
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 737050306,
					"content": "Beklettiğimiz için üzgünüm arkadaşlar ama işe yarar istihbaratlar toplamayı başardık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050307
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 737050307,
					"content": "İstihbarat mı? Vay, bu kulağa heyecan verici gelmeye başladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050308,
						737050309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737050308,
					"content": "Tıpkı büyük bir savaştan önce yapılan hazırlık gibi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050310
					]
				},
				{
					"id": 737050309,
					"content": "Bir tür saldırı mı planlıyoruz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050310
					]
				},
				{
					"id": 737050310,
					"content": "Elbette! Öğrencileri korumanın çöldeki tüm potansiyel tehlikeleri ortadan kaldırmaktan daha iyi bir yolu var mı? Fena plan değil, ha? Ne diyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050311
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 737050311,
					"content": "Şakanın sırası değil Dehya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050312
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 737050312,
					"content": "#Ayrıca, tehlikeyi ortadan kaldırmak söz konusu olduğunda {NICKNAME} biçilmiş kaftandır. Belki teklifini kabul eder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050313
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 737050313,
					"content": "#Tehdit oluşturabilecek her şeyi yok etmek... {NICKNAME} aralıksız çalışsa bile bu yıllar sürebilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737050314,
					"content": "Seyahat etmeyi bırakmamız gerekir... Paimon bunu düşünmek bile istemiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737050143,
					"content": "Sonuçta çöl çok büyük...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 737050144,
					"content": "Kim bilir kaç tane düşman vardır...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 737050315,
					"content": "Zaman, sorunlarımızın en küçüğü olurdu. Yer altına saklanmış akrepler veya ağaçlarda uyuyan korkunç yırtıcı kuşlar gibi bazı tehlikeler gözle görülemiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050316
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737050316,
					"content": "Onlar sana saldırana kadar onlardan kurtulamazsın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050317
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737050317,
					"content": "Bu durumda, Madam Faruzan'ın tavsiyelerini Amber'ın keşif yaklaşımıyla birleştirmeli, düşmanlarla karşılaşma olasılığımızı ve tahmini operasyon sürelerimizi hesaplamalıyız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050318
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737050318,
					"content": "Hey hey hey! Bırakın kalemleri arkadaşlar! Bu sadece bir şakaydı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050319
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 737050319,
					"content": "Emniyet Biriminin amacı aslında çok daha basit. Sadece saha ekiplerinde eğitimli savaş personeli bulunduğundan emin olmak için buradayız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050320
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 737050320,
					"content": "Bu işin bir kısmı Alev Canavarları ve diğer paralı askerlere verildi, ancak savaş testini geçen soruşturma ekibi üyeleri de katılabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050321
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 737050321,
					"content": "Bir soruşturma ekibinin tehlikeli bir alana girmesine izin verilmeden önce, grupta değerlendirmeyi geçmiş en az iki profesyonelin bulunması gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050322
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 737050322,
					"content": "Ben ve Dehya da testin yapılacağı en iyi yeri bulmak amacıyla istihbarat topluyorduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050323
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 737050323,
					"content": "Her seviyeden canavar ve haydutla dolu bir Zindan bulduk. Umarım uğrak mekanlarını bir süreliğine ödünç almamıza aldırış etmezler. Birkaç kafa darbesi alacaklar alt tarafı, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050324
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 737050324,
					"content": "Ha, yani sadece denetlememiz gerekiyor, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737050325,
					"content": "Aynen öyle. Katılımcıların güvenliği en büyük önceliğimiz, bu yüzden vardiyalı çalışacak yetenekli personellerden oluşan bir ekip kuracağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050326
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 737050326,
					"content": "Ancak yine de test ölçütlerimizi belirlememiz gerekiyor. Dövüşmek gerçek sınavdan farklıdır, ayrıca tek bir doğru cevap olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050327
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 737050327,
					"content": "Benim gibi paralı askerlerin kendine özgü bir tarzı vardır. Bu gerçek savaşta sorun yaratmaz, ancak işin içine öğretmek girince... Alıştığımız şeylere çok fazla bağlı kalma eğiliminde oluyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050328
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 737050328,
					"content": "Bu yüzden bize temel sağlayacak birine ihtiyacımız var... Deneyimi olan ama aynı zamanda savaşta daha esnek bir yaklaşım sergileyen birine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050329,
						737050330
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 737050329,
					"content": "İşte o benim uzmanlık alanım! Bu iş bende.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050331
					]
				},
				{
					"id": 737050330,
					"content": "Elimden geldiğince yardımcı olmak için buradayım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050331
					]
				},
				{
					"id": 737050331,
					"content": "#Evet, az önce söylediklerine göre {NICKNAME} bu iş için mükemmel bir aday gibi görünüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737050332,
					"content": "#Harika! Seninle çalışmak her zaman bir zevk {NICKNAME}, kılçıksız balık gibisin desem yeridir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050333
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 737050333,
					"content": "#{NICKNAME} ve Paimon'un ücretini de unutma Dehya. Hesap kitap yapmadan kabul etmiş bulundun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050334
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 737050334,
					"content": "Ha, sorun değil! Sadece Collei'in bizim için topladığı fonları yirmiye seksen olacak şekilde bölüşeceğiz. On bana, on sana, seksen onlara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050335
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 737050335,
					"content": "Biz yüzde seksen mi alacağız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050336,
						737050337
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737050336,
					"content": "Bu biraz fazla gibi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050338
					]
				},
				{
					"id": 737050337,
					"content": "Cömertliğin için teşekkürler Dehya!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050338
					]
				},
				{
					"id": 737050338,
					"content": "Hahaha! Hiç sorun değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050339
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 737050339,
					"content": "Biz sadece uzun vadeli operasyonlardan sorumluyuz. Tüm ölçütleri belirleyecek olan sizsiniz, bu yüzden bence bu anlaşmada karlı çıkan taraf biziz, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050340
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 737050340,
					"content": "Geçmişte bir ortaklıktan söz etmiştik hatırlarsan. İşte bunu başlamak için harika bir fırsat olarak düşünün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050341
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 737050341,
					"content": "P-Pekala, o zaman herkesin net bir şekilde anlaması için ödemenin ayrıntılı bir özetini hazırlayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050342
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737050342,
					"content": "Harika olur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050343
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 737050343,
					"content": "Siz de merak etmeyin Bayan Candace.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050344
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737050344,
					"content": "Akademiye kiraladığınız ve tahıl depolamak için kullanılan o arsa için... Kira ödemesinde yüzde otuzluk bir artış almayı başardım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050345
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737050345,
					"content": "Ah, teşekkür ederim. Bu fonlar, köydeki bazı tesislerin onarımı için kullanılacak, bu da soruşturma ekiplerinin gelecekte orada mola verdiğinde daha rahat etmesini sağlayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050346
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 737050346,
					"content": "#Pekala, savaş testi için düzenlemeleri bitirmeliyiz. Hazır olduğunda yanımıza uğra {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050347
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 737050347,
					"content": "Yakında görüşürüz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050348
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 737050348,
					"content": "Bu operasyonun kalbi sensin Collei! Tüm ekibi bir araya getirmişsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737050349,
					"content": "Ah, yok canım... Sadece elimden geleni yapmaya çalışıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050350
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737050350,
					"content": "Hâlâ öğrenecek çok şeyim, koordine edecek çok işim var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050351
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737050351,
					"content": "Ama şimdilik, birlikte var gücümüzle çalışalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050352
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737050352,
					"content": "Kesinlikle! Hehe, Saha Güvenlik Merkezini olabileceği en iyi yer haline getireceğiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
