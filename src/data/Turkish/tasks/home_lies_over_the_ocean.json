					"Yoh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728020201,
					"content": "Yarın öğlen yemeği için ne kadar yemek yapalım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020202
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020202,
					"content": "Çocuklar bu ara çok yiyor. Biraz daha yapalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020203
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020203,
					"content": "Tanışıyor muyuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020204,
						728020205
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020204,
					"content": "Burası Atsuko'nun evi mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020206
					]
				},
				{
					"id": 728020206,
					"content": "Evet. Nasıl yardımcı olabilirim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020207
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020207,
					"content": "Atsuko size bu mektubu vermemi istedi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020208
					]
				},
				{
					"id": 728020208,
					"content": "Mektup mu? Niye durduk yere bize mektup yazmış ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020209
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020209,
					"content": "Mektup da uzunmuş... Atsuko eve döndü sonuçta. Bir şey söylemek isterse bize doğrudan söylese daha iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020210,
						728020211
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020210,
					"content": "Nasıl yani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020212
					]
				},
				{
					"id": 728020212,
					"content": "Şaşırdın mı Gezgin? Evet, Atsuko şehir dışındaydı ama döndü artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020213
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020213,
					"content": "Zaten yanımıza dönmüşken niye bize mektup göndersin ki? Bizi başkasıyla mı karıştırdın acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020214
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020214,
					"content": "Bir dakika hayatım. Mektubu biraz inceledim. El yazısına ve üslubuna bakılırsa kesinlikle kızımız yazmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020215
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020215,
					"content": "Mektupta ayrıca bir süre geri dönmeyi düşünmediğini yazmış. \"Kendinize iyi bakın,\" diyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020216
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020216,
					"content": "Ne demek şimdi bu? Bu Gezginle mektubu gönderdikten sonra kendi başına mı geldi yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020217
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020217,
					"content": "Bir yanlış anlaşılma olmuş galiba. Atsuko eve gelince sorarız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020218
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020218,
					"content": "Ne yazık ki Atsuko'nun bugün halletmesi gereken bazı işler vardı. Dönünce açıklamasını isteriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020219
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020219,
					"content": "Sana da uygunsa yarın akşam konuşalım. Atsuko'ya söyleriz, sana her şeyi anlatır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020220,
						728020222
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020220,
					"content": "Şimdi nerede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020221
					]
				},
				{
					"id": 728020221,
					"content": "İşi olduğunu söyledi. Kahvaltıdan sonra aceleyle çıktı evden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020224
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020224,
					"content": "Evet. Her gün erken çıkıp geç saatte dönüyor. Sadece akşamları görebiliyoruz. Ne yapıyor biz de bilmiyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020225
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020225,
					"content": "Neyse, lütfen yarın akşam gel. Atsuko yanlış bir şey yaptıysa senden özür diletiriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020226
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020226,
					"content": "Bunca yol geldiğin için üzgünüz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020227
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020227,
					"content": "Ah Atsuko... Biraz daha uslu olsa keşke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020222,
					"content": "Niye akşam?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020223
					]
				},
				{
					"id": 728020223,
					"content": "İşi varmış. Kahvaltıdan sonra akşama kadar eve dönmüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020224
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020211,
					"content": "Atsuko döndü mü?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020212
					]
				},
				{
					"id": 728020205,
					"content": "Siz Atsuko'nun annesi ve babası mısınız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020206
					]
				}
			]
		},
