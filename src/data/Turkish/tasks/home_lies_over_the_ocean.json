			},
			"dialogs": [
				{
					"id": 728020301,
					"content": "Kızımız niye bu mektuptaki imza tarihinden önce döndü acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020302
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020302,
					"content": "Çok kurcalamayalım. Bir yanlış anlaşılma olmuştur muhtemelen. Yarın öğle yemeğine ne pişireceğime karar vermeme yardım etsen daha iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michiru"
				}
			]
		},
		{
			"id": 7280204,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
