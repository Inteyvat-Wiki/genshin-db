			},
			"dialogs": [
				{
					"id": 728020401,
					"content": "Atsuko daha dönmedi. Lütfen akşam tekrar gel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020402
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020402,
					"content": "Akşama kadar bekle. Atsuko o saate gelir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michiru"
				}
			]
		},
		{
			"id": 7280205,
			"completionStepIds": [
				7280205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280205",
							"2"
						],
						"stepId": 7280205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Atsuko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728020501,
					"content": "Atsuko gelmiştir artık. Hadi kapıyı çalalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728020502,
					"content": "Bir şey konuşuyorlar galiba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020503
					]
				},
				{
					"id": 728020503,
					"content": "Bir de kurtardığımız Tanuki ne yapıyor merak ediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020504
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020504,
					"content": "Çok iyi niyetlisin. O Tanuki'nin bacağında sadece küçük bir çizik vardı. Bıraksan çalıların arasında kendiliğinden iyileşirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020505
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020505,
					"content": "Dayanamadım. Gözleri dolu dolu bakıyordu. Çok acınası haldeydi. Vicdanım el vermedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020506
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020506,
					"content": "Neyse. İyilik yapmak yanlış bir şey değil. Sadece Tanuki çok iştahlı, neredeyse benim kadar yemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020507
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020507,
					"content": "Kapıyı çal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020508
					]
				},
				{
					"id": 728020508,
					"content": "Kim o?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020509
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020509,
					"content": "Ben Gezgin. Daha önce de gelmiştim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020510
					]
				},
				{
					"id": 728020510,
					"content": "Hatırladım seni. Lütfen burada bekle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020511
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020511,
					"content": "Me-Merhaba! Ben Atsuko. Önce... dur. Seni tekrar görmek ne güzel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020512
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020512,
					"content": "Kusura bakma, evimi özlemişim. Sana mektubu verdikten sonra fikrimi değiştirip bir gemiyle Inazuma'ya geldim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020513
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020513,
					"content": "Ahaha... Zamanında haber vermeyip bu kadar yol gelmene sebep olduğum için özür dilerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020514
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020514,
					"content": "Inazuma'ya nasıl döndün?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020515
					]
				},
				{
					"id": 728020515,
					"content": "Bir yolunu buldum, haha. Orasını boş ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020516
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020516,
					"content": "Ödemeni hazırladım. Lütfen kabul et. Yardım ettiğin için sağ ol. Çabuk... Şey... Acele et de diğer işlerine bak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020517
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020517,
					"content": "Atsuko'nun bize şimdi söyledikleri öncekilerden nasıl bu kadar farklı olur? Inazuma'ya dönmek bu kadar kolaysa neden bizden yardım istedin ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020518,
						728020520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728020518,
					"content": "Liyue'deki işin ne oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020519
					]
				},
				{
					"id": 728020519,
					"content": "İş mi? Hangi iş? Liyue'de işim mi varmış?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020522
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020522,
					"content": "Öyle şeylerin önemi yok. Hiçbir şey aileden önemli değildir. Zaten hepsini başkasına emanet ettim, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020523
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020523,
					"content": "Bir dakika! Gerçek Atsuko Liyue'de iş bulmakta zorlanıyordu. Bir anda zengin olması imkansız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728020524,
					"content": "Sen kimsin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020525
					]
				},
				{
					"id": 728020525,
					"content": "Ben... Atsuko'yum tabii ki! Atsuko'ya benziyorum. Sesim de benziyor. Şüphelenilecek ne var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020526
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020526,
					"content": "Diretmeyin işte... Neyse. Sizinle konuştuğum yeter. Yarın işim var. Gidiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020527
					],
					"speakerTitle": "Atsuko"
				},
				{
					"id": 728020527,
					"content": "Atsuko! Of be kızım... Niye durduk yere sinirlendi ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020528
					],
					"speakerTitle": "Michiru"
				},
				{
					"id": 728020528,
					"content": "Kusura bakma Gezgin. İşte çok yoruldu herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020529
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020529,
					"content": "Ama siz de gördünüz. Kızımız bu. Belki mektubu gönderdiğini unutmuştur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020530
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020530,
					"content": "Yine de zahmet ettiğin için sana teşekkür ederiz. Ödemeye gelince... Biraz daha bekleyebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020531,
						728020532
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020531,
					"content": "Bir sorun mu var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020533
					]
				},
				{
					"id": 728020533,
					"content": "Hayır, öyle değil. Ödemeye yetecek paramız var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020534
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020534,
					"content": "Atsuko'nun sabahları işe gittiğini söylemiştik ya? Maaş olarak hep tuhaf şeyler alıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020535
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020535,
					"content": "Sürekli değişik tohumlar ya da yabani meyveler getiriyor ama hiç Mora getirmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020536
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020536,
					"content": "Maddi olarak giderleri var tabii ama önce satmamız gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020537
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020537,
					"content": "Sanırım senin gibi bir gezgin için Mora daha uygun olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020538
					],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020538,
					"content": "Lütfen yarın tekrar gel. O zamana kadar sana vereceğimiz Morayı hazırlarız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoh"
				},
				{
					"id": 728020532,
					"content": "Bir sorun varsa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020533
					]
				},
				{
					"id": 728020520,
					"content": "Malikanen ne olacak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728020521
					]
				},
				{
					"id": 728020521,
					"content": "Malikane mi? Ne? Liyue'de malikanem de mi vardı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728020522
					],
					"speakerTitle": "Atsuko"
				}
			]
		},
