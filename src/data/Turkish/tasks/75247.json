					"nextDialogs": [
						752470432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470432,
					"content": "Öhöm... \"Büyük ödül çıksın! Paimon'a layık enfes bir ziyafet olsun!\"",
