					"nextDialogs": [
						752470422
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470422,
					"content": "Sana neyin şans getireceğini düşünüyorsan onu yap.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470423
					]
				},
				{
					"id": 752470423,
					"content": "Anladım. \"Çiçek Tüyü Klanı Devriye Ekibi, aç kapıyı!\"",
