				},
				{
					"id": 752470444,
					"content": "Benny'nin Macera Takımı, toplanın!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470445
					]
				},
				{
					"id": 752470445,
					"content": "Işıltılı Cevherler... Vay canına, bir tatlı daha!",
