					"nextDialogs": [
						752470430
					]
				},
				{
					"id": 752470430,
					"content": "Şekerleri yiyince herkese bir enerji gelir...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 752470431,
					"content": "Sıra Paimon'da, sıra Paimon'da! Hımm, iyi şans için ne söylese acaba... Hah, tamam!",
