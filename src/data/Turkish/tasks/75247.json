						752470405
					],
					"speakerTitle": "Challwa"
				},
				{
					"id": 752470405,
					"content": "Denemesi ücretsiz! Ne dersiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470406
					],
					"speakerTitle": "Challwa"
				},
				{
					"id": 752470406,
					"content": "Demek resim bizi buraya yönlendiriyordu. Sürpriz Yumurta buradan geliyor olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470407,
					"content": "Hehe... Bakalım şansımız daha ne kadar yaver gidecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470408,
					"content": "B-Buyurun! Hediye yumurtalar sahiplerini bekliyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470409
					],
					"speakerTitle": "Challwa"
				},
				{
					"id": 752470409,
					"content": "Hımm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470410
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470410,
					"content": "Önce sen.",
