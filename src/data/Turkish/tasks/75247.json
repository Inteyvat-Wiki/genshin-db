			},
			"dialogs": [
				{
					"id": 752475001,
					"content": "Mutlu musun dostum? Güzel eğlendin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475002
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752475002,
					"content": "Vay canına dostum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475003
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752475003,
					"content": "Bence bu evet demek. Doğum günün kutlu olsun dostum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475004
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752475004,
					"content": "Bu arada bana planından neden bahsetmedin dostum? Cidden ama dostum, dostlar dostlarından böyle şeyleri saklamazlar dostum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475005
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752475005,
					"content": "Haha... Dürüst olmam gerekirse, yıl dönümünü hatırlayıp hatırlamayacağını görmek istedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475006
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752475006,
					"content": "... Sen çok değiştin Ifa. Bir dostuna böyle ihanet eden birine nasıl güvenebilirim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475007
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752475007,
					"content": "Ama sana kapak olsun, hatırladım işte. Cacucu için biraz taze bal ayırmıştım bu yüzden. Yıl dönümünü unutmanın bedelini biliyorum, dolayısıyla yılın geri kalanı boyunca gagalanmaya razı olamazdım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475008
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752475008,
					"content": "Öyle bir şey yapmazdım dostum! Sen harika birisin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cacucu"
				}
			]
		},
		{
			"id": 7524751,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
