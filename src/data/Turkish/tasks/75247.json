				"points": []
			},
			"dialogs": [
				{
					"id": 752475101,
					"content": "Tekrar merhaba dostum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475102
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752475102,
					"content": "Az önce Ifa'ya tarihi yanlış hatırladığını söyleyecektim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475103
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752475103,
					"content": "Ama kendimi durdurdum. Sanırım olgunlaşmak, bazı şeyleri boş vermen gerektiğini bilmeyi de beraberinde getiriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cacucu"
				}
			]
		}
	]
}