					"nextDialogs": [
						752470313
					]
				},
				{
					"id": 752470313,
					"content": "Aa! Bir Sürpriz Yumurta ve bir resim daha! Bu simgeyi Sefa Yeli Pazarının orada görmüştüm sanırım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470314
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470314,
					"content": "Dostum... Neden önümüze bir zorluk daha çıkacakmış gibi hissediyorum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470315
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470315,
					"content": "Ne? Yoksa bu, tatil köyü civarında saklanmış olan gizli bir hazine avı falan mı? Bu ava mutlaka çıkmalıyım!",
