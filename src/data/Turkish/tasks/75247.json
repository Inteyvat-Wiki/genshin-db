			"dialogs": [
				{
					"id": 752470301,
					"content": "*iç çeker*... Sonunda başardık! Amma uğraştırıcıydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470302,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470303
					],
					"speakerTitle": "Cacasha"
				},
				{
					"id": 752470303,
					"content": "Sen Cacasha olmalısın! Cacucu ile birlikte sağlam bir ikili olmuşsunuz! Paimon da güçlü bir ikilinin parçası olduğundan böyle ortaklıkları iyi tanır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470304,
					"content": "Sağlamız dostum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470305
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470305,
					"content": "Ne demek istediğimi anladın mı şimdi? O ikisi bir araya gelince yenilmeleri neredeyse imkansız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470306
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470306,
					"content": "Cacucu, artık bir \"saklanma sanatı\" uzmanı olduğunu rahatlıkla söyleyebilirim. Bundan böyle kendine usta bir üçkağıtçı diyebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470307
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470307,
