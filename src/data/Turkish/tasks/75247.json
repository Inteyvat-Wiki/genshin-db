					"nextDialogs": [
						752470450
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470450,
					"content": "Tamam tamam, öyle olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470451
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470451,
					"content": "Hadi o zaman dostum! \"Tanıştığımıza sevindim dostum!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470452
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470452,
					"content": "Aa... O ne öyle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470453
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470453,
					"content": "İşte bu! İşte bu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470454
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470454,
					"content": "Yok artık, daha neler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470455
					],
					"speakerTitle": "Challwa"
				},
				{
					"id": 752470455,
					"content": "Öhöm... Veee kazanan belli oldu! Bay Cacucu'yu tebrik ederiz, kendisi bugün büyük ödülü kazanan üçüncü müşterimiz oldu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470456
					],
					"speakerTitle": "Challwa"
				},
				{
					"id": 752470456,
					"content": "Bay Cacucu en özel ödülümüz olan bu Minik Asha Böreklerinin yanı sıra hediye yumurtalarımızda yer alan tüm yemeklerden birer porsiyon alma hakkı elde etti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470457
					],
					"speakerTitle": "Challwa"
				},
				{
					"id": 752470457,
					"content": "Cidden mi dostum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470458
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470458,
					"content": "Evet ya, cidden mi? Aramızda en şanslımızın Cacucu olacağını kim tahmin edebilirdi ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470459
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470459,
					"content": "Haha, tebrikler dostum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470460
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470460,
					"content": "Cacucu, dostum... Şey, yani saygıdeğer beyefendiciğim, sizden küçük bir ricam olacaktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470461
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470461,
					"content": "Şansın el sıkışarak başkalarına aktarılabildiği söylenir. Acaba diyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470462
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470462,
					"content": "Haha! Sıkıntı yok dostum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470463,
						752470466
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470463,
					"content": "Önce Ororon, sonra herkes gidip Cacucu'nun kanadına dokunur.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752470464
					]
				},
				{
					"id": 752470464,
					"content": "Bu çok hoş bir his olduğundan bir süre sonra herkes onun başını okşamaya başlar.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752470465
					]
				},
				{
					"id": 752470465,
					"content": "Kafası ne kadar yuvarlak ve yumuşak. Bu an hiç bitmesin istiyorsun.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 752470466,
					"content": "Hehe, bu şans Paimon'a bütün yıl yeter..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470467
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470467,
					"content": "Kesinlikle öyle Paimon. Çünkü çok özel bir yoldaşın var. Tıpkı Cacucu'nun olduğu gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470468
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470468,
					"content": "B-Bana niye öyle bakıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470469
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470469,
					"content": "Bütün bunlar senin planındı, değil mi? Artık doğruyu söylemenin vakti geldi bence, ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470470
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470470,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470471
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470471,
					"content": "Iı, nasıl yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470472,
						752470473
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470472,
					"content": "Yani Cacucu'nun şanslı olmasının...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470474
					]
				},
				{
					"id": 752470474,
					"content": "Tamam tamam. Fazla abartmayın, olur mu? Elbette bizim ufaklık, şansını benim gibi bir dostu olmasına borçlu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470475
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470475,
					"content": "Soruyu geçiştirme de doğru düzgün cevap ver. Her şeyi sen ayarladın, değil mi? Balık tutma, saklambaç...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470476
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470476,
					"content": "Şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470477
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470477,
					"content": "Yani o Mondstadtlı maceracıyı en başından beri tanıyordun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470478
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470478,
					"content": "Tam sayılmaz. Onunla senden bir gün önce tanıştım ve sadece bana ufak bir tavsiye vermesini istedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470479
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470479,
					"content": "Ayrıca evet, Cacucu'nun Asha ve kapibaralarla oynayabilmesi için resimleri falan düzenledim. Bir de sürpriz yumurta işini ayarladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470480
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470480,
					"content": "Vay canına dostum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470481
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470481,
					"content": "Haha... Ama Kapibara Kral olayı biraz yanlış anladı. Eh, sonuçta vahşi hayvan tabii, söylediğin her şeyi anlamıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470482
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470482,
					"content": "Tahminime göre Cacucu için hazırladığım şeyleri çalmaya çalıştığımızı düşünüyordu, o yüzden sinirlendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470483
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470483,
					"content": "Ha, adı gerçekten Kapibara Kral yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470484
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470484,
					"content": "Değil tabii ki. Ona verdiğin adı kullanayım dedim sadece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470485
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470485,
					"content": "Vay canına dostum! Duygulandım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470486
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470486,
					"content": "... Artık öğrendiniz işte! Cacucu ile tanışma yıl dönümümüz yaklaştığı için ona özel bir kutlama hazırlamak istedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470487
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470487,
					"content": "Cacucu'nun gerçek doğum günü ne zaman bilmiyoruz, bu yüzden tanışma yıl dönümümüzü bir doğum günü olarak kutlarız hep.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470488
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470488,
					"content": "Cacucu olgun ve abi rolünü üstlenen bir Sürüngen olsa da aslında içten içe oyun oynamayı çok seven bir yavru gibidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470489
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470489,
					"content": "Senin aslında küçük bir yavru olduğunu biliyorum dostum. İstediğin kadar eğlenebilirsin, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470490
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470490,
					"content": "Dostum, dostum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470491
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470491,
					"content": "Söylemek istediğin bir şey mi var Cacucu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470492
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470492,
					"content": "Dostum, hayır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470493
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470493,
					"content": "Söylemene gerek yok dostum. Ben anladım zaten. Biz de seni seviyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470494
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470494,
					"content": "Evet, utanma dostum. Bu tatil köyündeyken vahşi bir Gukuzor kadar özgür davranabilirsin. Yapman gereken tek şey eğlenmek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470495
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470495,
					"content": "Yıl dönümün kutlu olsun Cacucu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470496
					]
				},
				{
					"id": 752470496,
					"content": "Dostum! Dostum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470473,
					"content": "Tek nedeni...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470474
					]
				},
				{
					"id": 752470440,
					"content": "En iyiyi sona saklayalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470441
					]
				}
			]
		},
		{
			"id": 7524750,
