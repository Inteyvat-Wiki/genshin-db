					"nextDialogs": [
						752470403
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752470403,
					"content": "Sakin ol dostum. Heyecanlandığını biliyorum ama önce durumu öğrenmeliyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470404
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470404,
					"content": "Öhöm... Buyurun değerli müşteriler! Bir yumurta alın, istediğinizi seçebilirsiniz! Hepinize bol şans!",
					"roleType": "TALK_ROLE_NPC",
