					"nextDialogs": [
						752470446
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470446,
					"content": "Hehe, çırağımı yanıma aldığım zamanları hatırlattı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470447
					]
				},
				{
					"id": 752470447,
					"content": "#{M#Dede}{F#Diğer Nine} güzel anılara daldı anlaşılan. Gerçekten de şanslı bir çekiliş oldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470448
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470448,
					"content": "Pekala Cacucu, sıra sende. Göster onlara gücünü!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470449
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470449,
					"content": "Hahaha... Şampiyonluğa oyna dostum! Ya da en azından Ifa'yı geride bırak.",
