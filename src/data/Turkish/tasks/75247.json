					"nextDialogs": [
						752470411
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470411,
					"content": "Cidden mi dostum? Sakın bana \"ilk olmak uğursuzluk getirir\" gibi saçmalıklara inandığını söyleme... Tamam tamam, dediğin gibi olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470412
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470412,
					"content": "Ashanın şansına iyi bir şey çıkar umarım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470413
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470413,
					"content": "Vay canına, Sürüngen Krakerleri! Çok iyi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752470414,
					"content": "Aa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470415
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752470415,
					"content": "Uff...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470416
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752470416,
					"content": "Sürüngen Krakerlerini sevmiyor musun Ifa?",
