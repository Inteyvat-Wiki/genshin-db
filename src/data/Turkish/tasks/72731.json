			"dialogs": [
				{
					"id": 727310201,
					"content": "Hahahahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310202
					],
					"speakerTitle": "Büyük Usta Hanakado"
				},
				{
					"id": 727310202,
					"content": "Müthiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310203
					],
					"speakerTitle": "Büyük Usta Hanakado"
				},
				{
					"id": 727310203,
					"content": "Hahahahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310204
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310204,
					"content": "İnanılmaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310205
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310205,
					"content": "Dövüş tarzın benimkinden çok farklı olsa da Hayalet Böceğine olan tutkunu çok iyi anlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310206
					],
					"speakerTitle": "Büyük Usta Hanakado"
				},
				{
					"id": 727310206,
					"content": "Gelecekte böcek dövüşü camiasının gerçek şampiyonu olacağına şüphem yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310207
					],
					"speakerTitle": "Büyük Usta Hanakado"
				},
				{
					"id": 727310207,
					"content": "Sen de oldukça iyisin! 1.141 dövüşün 570'ini kazanmayı başardın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310208
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310208,
					"content": "Hayatım boyunca katıldığım tüm böcek savaşı yarışmalarında en çok dayanan sen oldun! Etkilendim açıkçası!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310209
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310209,
					"content": "Hayır, 571 defa kazandım, senden ilerideyim yani. Aynı zamanda senin ev sahibi avantajın da var. Bunu da hesaba katarsak aslında üstün olan savaşçı benim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310210
					],
					"speakerTitle": "Büyük Usta Hanakado"
				},
				{
					"id": 727310210,
					"content": "Ne? Neden bu kadar inatçı olmak zorundasın? Puanımızı dün gibi hatırlıyorum, Mamoru da şahidimiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310211
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310211,
					"content": "Doğru değil mi Mamoru?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310212
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310212,
					"content": "Patron, Ben... Daha fazla dayanamayacağım... Lütfen biraz uyumama izin ver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310213
					],
					"speakerTitle": "Mamoru"
				},
				{
					"id": 727310213,
					"content": "Şey... Tüm bu zaman boyunca ara vermemişler miydi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310214,
					"content": "Hiç ara vermediler mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310215,
						727310216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310215,
					"content": "Arena çökmek üzere olmalı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310217
					]
				},
				{
					"id": 727310217,
					"content": "Peki! Cömert biri olduğum için sana bir tur verebilirim, sorun değil. Bir dahaki sefere seni yeneceğim ama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310218
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310218,
					"content": "Halen ikna olmadıysan bir sonraki dövüşü senin evinde yaparız. Bunun yerle ilgisi olmadığını, asıl işin böcek dövüştürende olduğunu sana kanıtlayacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310219
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310219,
					"content": "Peki bana uyar. Beni takip et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310220
					],
					"speakerTitle": "Büyük Usta Hanakado"
				},
				{
					"id": 727310220,
					"content": "Ah? Hey yoldaş, Uçan Eflatun Kavun, sonunda geldiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310221
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310221,
					"content": "Bir saniye, neden Paimon yine Uçan Eflatun Kavun oldu? Paimon'un sadece senin için savaşırken mi güzel isimleri olabiliyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310222,
					"content": "Şey, şimdi bunu boş ver! Anlaştığımız gibi, işte 2 aylık ücretsiz ramen kuponun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310223
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310223,
					"content": "Ramen kuponu mu? Doğru ya! Ramen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310224,
					"content": "Bak bu iyi oldu işte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310225,
						727310226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310225,
					"content": "Kutlama zamanı!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310227
					]
				},
				{
					"id": 727310227,
					"content": "Hayır, hayır, hayır, hayır. Bu sadece alıştırmaydı. Yüce Arataki Sıra Dışı ve Heyecanlı Böcek Dövüşü henüz başlamadı bile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310228
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310228,
					"content": "Ne de olsa izleyiciler olmadan her şey çok sakin geçiyor. Etkinliğin böyle son bulmasına izin veremeyiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310229
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310229,
					"content": "İyi haber şu ki Büyük Usta Hanakado, sonunda gururunu çiğneyerek benim daha güçlü bir böcek dövüştürücü olduğumu kabul etti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310230
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310230,
					"content": "Yine de onunla işimiz henüz bitmedi. Yakında onun evine gideceğim ve onu orada yenip buna bir son vereceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310231
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310231,
					"content": "Ondan sonra da benim emirlerime uyması gerekecek, yani Yüce Arataki Sıra Dışı ve Heyecanlı Böcek Dövüşünü en havalı ve büyük etkinlik yapmamızda bize yardım edecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310232
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310232,
					"content": "Tekrardan ikinize de teşekkür ederim. Şimdi burada bekleyin, en kısa zamanda iyi haberlerle geri geleceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310233
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310233,
					"content": "Görünüşe göre Boşboğaz'ın keyfi yerinde, biz de iki aylık ücretsiz ramen kazandık, hehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310234,
						727310235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310234,
					"content": "Kazan kazan durumu yani!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310236
					]
				},
				{
					"id": 727310236,
					"content": "Patron, Patron! Shinobu'dan mektup var. Şuna bir bak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310237
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 727310237,
					"content": "Ha? Patron nereye gitti? Az önce burada böcek dövüştürüyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310238
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 727310238,
					"content": "Acil bir durum mu vardı? Boşboğaz az önce Büyük Usta Hanakado ile gitti. Dövüşe devam edeceklerini söylemişlerdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310239,
					"content": "Şey, çok da acil bir şey değildi, biraz beklenmedik bir şey oldu sadece...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310240
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 727310240,
					"content": "İsterseniz siz de okuyabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310241
					],
					"speakerTitle": "Akira"
				},
				{
					"id": 727310241,
					"content": "Ne? Yani Büyük Usta Hanakado aslında Arataki Çetesinin bir üyesi mi? Ama... Konuşma tarzı Boşboğaz'a sanki onun ezeli düşmanıymış gibi hissettirdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310242,
					"content": "Aynı Shinobu'nun da düşündüğü gibi, Boşboğaz tüm gününü hiç yemeden, içmeden ve dinlenmeden böcek dövüşü yapmaya harcıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310243,
					"content": "Ama Böcek Dövüşü etkinliğini bize hazırlattırdı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310244,
					"content": "Yine de buna dinlenmek demek pek doğru olmaz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310245
					]
				},
				{
					"id": 727310245,
					"content": "Paimon, Shinobu'nun bu ramen kuponunu daha çok hak ettiğini düşünüyor! Geri döndüğünde onu ramen yemeye götürelim mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310246
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310246,
					"content": "Hımm... Aslında, bir saniye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310247
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310247,
					"content": "Boşboğaz, bu ramen kuponunun hangi dükkanda geçerli olduğunu bize söylemedi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310248
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310248,
					"content": "... Dükkanı bizim mi bulmamız lazım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727310235,
					"content": "Önemli olan herkesin mutlu olması.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310236
					]
				},
				{
					"id": 727310226,
					"content": "\"Heyecanlı Böcek Dövüşü\"nün de sonuna geldik!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310227
					]
				},
				{
					"id": 727310216,
					"content": "Hayalet Böcek yorulmuş olmalı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310248
					]
				}
			]
		},
		{
