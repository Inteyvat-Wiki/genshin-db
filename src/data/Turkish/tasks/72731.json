				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727310701,
					"content": "Anladım. Anladım... Bir kere daha dövüşelim. Bu sefer yöntemlerin bir işe yaramayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310702
					],
					"speakerTitle": "Büyük Usta Hanakado"
				},
				{
					"id": 727310702,
					"content": "Kazanmak veya kaybetmek çok da önemli değil... Eğlencesine dövüşelim, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310703
					],
					"speakerTitle": "Büyük Usta Hanakado"
				},
				{
					"id": 727310703,
					"content": "Böylesine nadir bir rakibi bulmak oldukça zor. Dövüşü bu kadar erken bırakmak bu şansı ziyan etmek olur, öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310704
					],
					"speakerTitle": "Büyük Usta Hanakado"
				},
				{
					"id": 727310704,
					"content": "Elbette! Hodri meydan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310705
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310705,
					"content": "Gizli böcek dövüşü tekniklerimi biraz zor görürsün ama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310706
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310706,
					"content": "Benim daha güçlü bir böcek dövüşçüsü olduğumu kabul edersen seninle istediğin kadar böcek dövüştürürüm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310707
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727310707,
					"content": "Görünüşe göre Boşboğaz ve Büyük Usta Hanakado kapışmaya devam ediyorlar... En iyisi onları kendi hallerine bırakalım! Böcekler bıkana kadar kapışmaya devam etsinler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}