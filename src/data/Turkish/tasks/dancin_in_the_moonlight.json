			"dialogs": [
				{
					"id": 750640801,
					"content": "\"Louis, Louis!\" ... Aaa! Ödümü kopardın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640802
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640802,
					"content": "Hayırdır, fikrinizi mi değiştirdiniz? Yoksa sadece selam vermeye mi geldiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640803,
						750640806
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640803,
					"content": "Selam vermeye ve hazır buradayken yardım etmeye geldik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640804
					]
				},
				{
					"id": 750640804,
					"content": "Huuruu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
