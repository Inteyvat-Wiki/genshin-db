			"dialogs": [
				{
					"id": 750641101,
					"content": "Hımm... Şimdi sırada ay ışığı altında bir Iktomizor var! Evet, kulağa fena gelmedi. Ancak ideal ışığı ayarlamak kolay olmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641102
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641102,
					"content": "#Hımm... Hah! Şimdi kendini gösterme sırası sende küçük dostum {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641103
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641103,
					"content": "Küçük mü? Peh. O senden bile uzun sayılır, haberin olsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641104,
					"content": "Raarr? Ruu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641105
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750641105,
					"content": "Güzel, çok güzel... Zamanlama mükemmel... Haha! Şaheserim neredeyse tamam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641106
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641106,
					"content": "İyi bir çekim yaptığından emin ol, Fontaineli kızları çekiyormuşsun gibi düşün! Hehe, filmin repliğinde böyle diyordu, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641107,
					"content": "Hıruuu, ruuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750641108,
					"content": "Haha, sakin olun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641109
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641109,
					"content": "Ah, işte bu açı! Bu ay ışığı! Of be, tek kelimeyle muhteşem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641110
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641110,
					"content": "Bir saniye, bir bakayım... İki ışık kaynağına daha ihtiyacım olacak. Bir tanesi Iktomizorun yüzünü yandan aydınlatmalı, böylece sıcak ışıkla gece arka planı arasında bir kontrast elde edeceğiz... Ve gizemli bir hava yaratacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641111
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641111,
					"content": "Diğer ışık kaynağı ise Sürüngenin silüetini aydınlatmalı. Anlatması zor bir sebepten değil ama gerekli yine de.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641112
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641112,
					"content": "Evet, evet... Aradığımız şey tam olarak bu! Rüya gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641113
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641113,
					"content": "Hay aksi... Kahretsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641114
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641114,
					"content": "Üzgünüm ama buradaki atmosferik element yoğunluğu Fontaine'dekinden farklı olabilir. Makinada bir sorun var sanırım... Ama acele etmeyin. Ben bir kontrol edeyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641115
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641115,
					"content": "*mırıldanır* Hımm... Burası değil... Burası da değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641116
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641116,
					"content": "Kahretsin! Seni lanet olası şey! Adi, aşağılık pislik! Şımarık geri zekalı seni! Aaaaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641117
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641117,
					"content": "Seni var ya... Seni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641118
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641118,
					"content": "Hey, hey, sakin ol!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641119,
						750641120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641119,
					"content": "Duman çıkıyor resmen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750641122
					]
				},
				{
					"id": 750641122,
					"content": "Şey... Bundan... Hayır gelmez artık, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641123
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641123,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641124,
					"content": "Heh. Bana öyle bakmayın. En azından daha iyi hissediyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641125
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641125,
					"content": "*iç çeker* Gördüğünüz üzere yapay aydınlatmamız bozuldu ve bu uğurda harcadığım Moralar da boşa gitmiş oldu. Hüsrana uğradım. Tıpkı eski eşimle yaşadığım gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641126
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641126,
					"content": "Pekala, önce bir sakin ol ve panik yapma. Biz yardım etmek için buradayız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641127,
					"content": "*iç çeker* Pardon... Of. Pekala. Ne lazımdı? Hah, evet. Işıkların birini <color=#00E1FFFF>Iktomizorun yüzünün sol tarafına</color>, diğerini ise <color=#00E1FFFF>sırt hatlarına</color> doğru tutmalıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641128
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750641128,
					"content": "Sorun yok! Hadi halledelim şu işi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750641129,
					"content": "Böylece, Magnifico bir kez daha Kamerasını tamir etmeye başlar ve sizi, uygun bir ışık kaynağının nasıl oluşturulacağı düşüncesiyle baş başa bırakır...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750641120,
					"content": "Neler oluyor? Boşanıyor musunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750641121
					]
				},
				{
					"id": 750641121,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750641122
					],
					"speakerTitle": "Paimon"
				}
			]
		},
