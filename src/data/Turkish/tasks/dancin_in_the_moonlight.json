			},
			"dialogs": [
				{
					"id": 750640601,
					"content": "Haha, güzel! Aferin benim küçük modelime, hiç bozma... Ne kadar akıllısın sen öyle! Üç, iki, bir, gülümse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640602
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640602,
					"content": "Ah, şuna bakar mısınız? Tam bir şaheser! Peki kimin şaheseri? Tabii ki bendeniz Magnifico de la Magnificans'ın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640603
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640603,
					"content": "Teşekkür ederim, çok teşekkür ederim. Haha! İşte ödemenizin geri kalanı! Hah, bir de bu vardı. Buyurun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640604
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640604,
					"content": "Ooo, kalan ödeme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640605,
					"content": "Nasıl yani? Sadece bir Mora mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640606,
					"content": "Harika... Ve şimdi gerçek kahramanlarımız sahneye çıkıyor! Hadi, utanmayın! Hepiniz birer yıldızsınız, bu yüzden şaşaalı bir giriş yapın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640607
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640607,
					"content": "Oh be, bitti! Bu kopyayı hediye olarak size veriyorum... Fontaine galerilerinden önce bu şahesere sahip olduğunuz için ne kadar şanslı olduğunuzu unutmayın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640608,
						750640610
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640608,
					"content": "Teşekkürler. Ona gözümüz gibi bakacağız.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640609
					]
				},
				{
					"id": 750640609,
					"content": "Peki ya kalan ödeme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640613,
					"content": "Şimdi de şuraya gideceğim... Haritanıza işaretleyeyim hatta. Bakarsınız yollarımız yakında tekrar kesişir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640614
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640614,
					"content": "Kim bilir, belki o zaman sizden tekrar yardım bile isteyebilirim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640615
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640615,
					"content": "Tekrar karşılaşacağımıza kesin gözüyle mi bakıyorsun sen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640616,
					"content": "Yani, karşılaşmamızı ben planlamadım sonuçta. Kaderimizde varmış! Evet, bizi kader bir araya getirdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640617
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640617,
					"content": "Görüşmek üzere ve iyi şanslar dostlarım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640618
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640618,
					"content": "Raaar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640619
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640619,
					"content": "Magnifico bavulunu alır ve sıcak hava balonuna atlar.\\nBalonun başta şiddetli bir şekilde sarsılır ve Magnifico'nun içten bir kahkaha patlatmasına neden olur. Ardından balon hızlıca dengesini yeniden sağlayıp uzaklara doğru yol alır.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750640610,
					"content": "Pek Mora etmez gibi duruyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640611
					]
				},
				{
					"id": 750640611,
					"content": "Ruu? Ruu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640612
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640612,
					"content": "Evet... Paimon da hayal kırıklığına uğradı... Paimon kalan ödemenin depozitodan daha yüklü olacağını düşünmüştü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640613
					],
					"speakerTitle": "Paimon"
				}
			]
		},
