			"dialogs": [
				{
					"id": 750640412,
					"content": "İşte! Işığın ve gölgenin mucizesi! Fontaine'in en yeni endüstriyel başarısı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640413
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640413,
					"content": "Ne? Bu bizim için yeni sayılmaz. Hem daha hangi konuda yardıma ihtiyacın olduğunu söylemedin bize!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640414,
						750640416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640414,
					"content": "Evet, söyle hadi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640415
					]
				},
				{
					"id": 750640415,
					"content": "Görünüşe göre fotoğraf çekmemizi istiyorsun, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640418,
					"content": "Ha, tabii! İşte depozitonuz, buyurun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640419
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640419,
					"content": "Oha, burada çok Mora var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640420,
					"content": "Rraa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640421
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640421,
					"content": "Gördüğünüz üzere birkaç tane Sürüngen fotoğrafı çekmem gerekiyor ama hayvan çizimi kitaplarındaki üç görünüşlü çizimler gibi olsun istemiyorum... Daha canlı bir şeyler olmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640422
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640422,
					"content": "P-Peki, tamamdır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640423,
					"content": "Fakat öte yandan... \"Daha fazla canlılık\" demek \"benden daha az komut almak\" anlamına da geliyor. Bu nedenle, siz sevgili maceracılar için de uygunsa ihtiyacım olan fotoğrafları çekmeme yardım edebilir misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640424
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640424,
					"content": "P-Peki, tamamdır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640425,
					"content": "Elbette yeteneklerinizin ötesinde bir şey yapmak için kendinizi zorlamanıza gerek yok, ancak en azından beni düşman yaşam formlarından koruyabileceğinizi umuyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640426
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640426,
					"content": "Bu yüzden depozito sizde kalsın... Yardım edip etmeme kararını ise size bırakıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640427
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640427,
					"content": "Üf... Bu paralar çantayı epey ağırlaştırdı... Hepsinin bizim olduğuna emin misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640428,
					"content": "Hadi ama, sizi kandırır mıyım hiç? Ama isterseniz meblağı sizin için yeniden kontrol edebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640429
					],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640429,
					"content": "Hehehe... Hahaha! Doğru yere geldin çünkü Paimon, Natlan'da meşhur bir Sürüngen terbiyecisidir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640430,
					"content": "#Hiç merak etme. {NICKNAME} ve Paimon burada olduğu sürece istediğin her Sürüngen gereken terbiyeyi alacaktır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640431,
					"content": "Tepetlizorlar çocuk oyuncağı. Gukuzorlar işten bile değil. Iktomizorlar desen çantada keklik... Ha, ayrıca Koholazorlar, Yumkazorlar ve Tachankazorlar da var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640432,
						750640433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640432,
					"content": "Tachankazorlar da mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640434
					]
				},
				{
					"id": 750640434,
					"content": "... Kocakafazorlar, Ufakkolluzorlar, Kocagözlüzorlar, Korkunçzorlar, Aşırıkorkunçzorlar, Birazkorkunçzorlar, Ucubezorlar, Sıradanzorlar, Sıskazorlar, Tombulzorlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640435
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640435,
					"content": "Huuruu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640436,
						750640437
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640436,
					"content": "Neden bahsediyorsun Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640438
					]
				},
				{
					"id": 750640438,
					"content": "Ve... Rauurazorlar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640439
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640439,
					"content": "Rauu, rauuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640440
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640440,
					"content": "Ve Vıraarazorlar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640441
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640441,
					"content": "Vıraa! Raar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640442
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640442,
					"content": "Neyse işte, hangisini istiyorsan hallederiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640443
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640443,
					"content": "Hırrm, hırmm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640444,
						750640447
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750640444,
					"content": "*iç çeker* Pekala, sana yardım edeceğiz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640445
					]
				},
				{
					"id": 750640445,
					"content": "#Elbette yardım edeceğiz. Yüklü bir depozito aldık sonuçta! Öyle değil mi {REALNAME[ID(2)|SHOWHOST(true)]}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640446
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640446,
					"content": "Ah, harika. Harika!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640447,
					"content": "Affedersin, halletmem gereken başka işler var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640448
					]
				},
				{
					"id": 750640448,
					"content": "Ama depozitoyu aldık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640449
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750640449,
					"content": "Ha, sorun yok. Vaktiniz olduğunda gelirsiniz. Ben de o kadar çaresiz bir durumda değilim zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Magnifico"
				},
				{
					"id": 750640437,
					"content": "Sus da motorun soğusun Paimon. Ağzından çıkanı kulağın duyuyor mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640438
					]
				},
				{
					"id": 750640433,
					"content": "Bir saniye Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640434
					]
				},
				{
					"id": 750640416,
					"content": "Morayı verirsen seve seve yardım ederim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750640417
					]
				},
				{
					"id": 750640417,
					"content": "Biz çok havalıyızdır, bu yüzden Mora peşin, kırmızı meşin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640418
					],
					"speakerTitle": "Paimon"
				}
			]
		},
