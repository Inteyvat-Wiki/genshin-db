			},
			"dialogs": [
				{
					"id": 747140101,
					"content": "#{NICKNAME}, Paimon... Merak etmeyin, durumun ne olduğunu anladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140102
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747140102,
					"content": "Anladığım kadarıyla son zamanlarda etrafta bu kadar çok dalgıç olmasının nedeni, herkesin su altındaki çöpleri temizlemeye çalışması. Çevreyi mümkün olan en kısa sürede normale döndürmeye çalışıyorlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140103
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747140103,
					"content": "Madem öyle, benim de yardım etmek için kolları sıvayıp daha çok çabalamam lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140104
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747140104,
					"content": "Su altı kirliliği kötüye gitmeye devam ederse Romaritime Çiçeklerinin renkleri solacak... Hepsi bununla da kalmayacak üstelik. Yaşanabilecek onca korkunç şeyi aklıma bile getirmek istemiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140105
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747140105,
					"content": "O halde biz de yardım edelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747140106
					]
				},
				{
					"id": 747140106,
					"content": "Hadi birlikte denizi temizleyelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747140107,
					"content": "Baksana Freminet, su altında bu... Havalı zımbırtıyı bulduk. Bir müzik aletinin parçası olabilir diye düşündük. Sen de bir bakar mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747140108,
					"content": "Tabii... Vay canına, ne kadar karmaşıkmış. Epey mekanizma inceledim ama hiç bu kadar ayrıntılı ve eşsiz bir şey görmemiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140109,
						747140110
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747140109,
					"content": "Bence onu buraya koymalıyız.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747140111
					]
				},
				{
					"id": 747140111,
					"content": "Hımm... Bazı parçaları eksik yalnız. Bunu çalışır duruma getirmek istiyorsanız diğer parçalarını da bulmanız gerekecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140112
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747140112,
					"content": "Sorun değil, acelemiz yok. Gerçi Paimon, parçaları birleştirdiğimizde neye benzeyeceğini merak ediyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747140113,
					"content": "Tamam, ben aşağı dönüp temizliğe yardım etsem iyi olacak... Siz dinlenmenizin tadını çıkarın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140114
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747140114,
					"content": "Öyle yapacağız! Sen de kendini çok fazla zorlamamaya çalış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747140115,
					"content": "Ha? Bu şey... Bunu denizden mi çıkardınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140116
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747140116,
					"content": "Evet! Bunun ne olduğunu biliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747140117,
					"content": "Hah, bilmek ne kelime! Kimin olduğunu bile biliyorum! Eskiden her gün bahçede oturup bununla oynardım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140118
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747140118,
					"content": "Ne? Yani bu... Senin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747140119,
					"content": "Bir zamanlar benimdi. Alain'in icat ettiği mekanik bir piyano bu. Elle çalınabiliyor ama otomatik olarak da çalışıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140120
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747140120,
					"content": "Vay canına, bu inanılmaz! Ama neden...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747140121,
					"content": "Alain hastalandığında artık piyano sesine dayanamıyordu, ben de bu yüzden piyanoyu attım. Onu bir daha göreceğimi hiç düşünmemiştim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140122
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747140122,
					"content": "Sanırım her kimin eline geçtiyse bozulana kadar çalmış ama nasıl tamir edeceğini bilmiyormuş. Yoksa asla bu hale gelmezdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140123
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747140123,
					"content": "Onu tamir edebilir misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747140124
					]
				},
				{
					"id": 747140124,
					"content": "Elbette! Böyle bir şeyi tamir etmek çok basit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140125
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747140125,
					"content": "Tek sorun şu ki... Bayağı dağılmış. Ama eksik parçaları bana getirebilirseniz onu hemen geri birleştirebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747140126
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747140126,
					"content": "Tamamdır! Su altındayken gözümüzü dört açacağız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747140110,
					"content": "Ortamın havasına tam uydu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747140111
					]
				}
			]
		}
	]
}