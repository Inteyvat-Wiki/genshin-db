			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaveh",
					"Alhaitham"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130230101,
					"content": "Siraj ismini anımsamıyorum. Senin sınıfında mıydı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230102
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230102,
					"content": "Pek akılda kalıcı biri değil, hatırlamaman normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230103
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130230103,
					"content": "Akademinin, insanları deha olarak yaftalayıp baskı kurmasını kabullenmem hep zor olmuştur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230104
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230104,
					"content": "Ama yine de Akademi sana emanet edilemez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230105
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230105,
					"content": "Veya belki de az da olsa kendini tanıdığın için sevindiğimi söylemeliyim. Eğer Akademidekiler çıldırmasaydı, senden daha iyi bir bilge olacağım kesindi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230106
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230106,
					"content": "Ve sanırım bilge olarak kariyerinin şu sallanan resim gibi tehlikede olduğunu da herkese duyururlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230107
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130230107,
					"content": "İstifasını yeni vermiş birinden bunları duymak ilginç. Birkaç güne yine en dibe, dosyaların arasındaki hayatına döneceksin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230108
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230108,
					"content": "Fakat maaşım büyük ihtimalle aynı kalacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230109
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130230109,
					"content": "Bir dakika, nasıl yani? Neden sana böyle özel muamele yapılıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230110
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230110,
					"content": "En azından müşterilerin yüzü gülsün diye ölene kadar çalışan bir mimari tasarımcı değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230111
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130230111,
					"content": "S-Sen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230126
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230126,
					"content": "Salonu temizlemek için vaktimi ayırdım ve sen bana böyle mi teşekkür ediyorsun? Keşke kendi işlerimi yapsaydım, hâlâ bitirmem gereken tasarımlar var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230112
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230112,
					"content": "Kira borcunu ödesen iyi edersin. O Morayla bazı mobilyalar alacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230113
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130230113,
					"content": "Sen... Beni sinirden öldürmeye mi çalışıyorsun? Giderek daha çirkin eşyalar alıyorsun. İnsan neden evinde böyle sıkıcı ahşap oymalar ister ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230114
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230114,
					"content": "Param var, alıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230115
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130230115,
					"content": "Peki, finansal başarının arkasına saklan bakalım. Fakat bir anlığına Morayı unutsak, hava atacak gerçek bir değerin olur mu acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230116
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230116,
					"content": "Aslında çok fazla seçeneğim var. Öte yandan... Senin hiç kayda değer bir özelliğin var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230117
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130230117,
					"content": "Tabii ki sanatçılığım! İç mekan tasarımı hakkında hiçbir fikrin yok. Yanında ben olmadan rastgele mobilya almaya gitme sakın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230118
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230118,
					"content": "Hem seni götüreceğim, hem de sana içki ısmarlayacağım, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230119
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130230119,
					"content": "Tabii ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230120
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230120,
					"content": "Neden böyle bir şey yapayım ki? Sana yine geri ödemen için borç vermiş olacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230121
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130230121,
					"content": "Bir kerecik bonkörlük yapıp geri Mora istemesen olmaz mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230122
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230122,
					"content": "Borcun olduğunu inkar etmen, başkasının evinde yaşadığını inkar etmenden daha da çılgınca. İnsanların eninde sonuna haberi olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230123
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130230123,
					"content": "Bahsi geçmişken, arkadaşların bir şey söylemezler değil mi? Onlara bunu sır olarak saklamalarını söyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230124
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 130230124,
					"content": "Bu kadar saklamanın alemi yok, bence herkes gerçeği biliyor. İçkiye karşı o kadar zayıfsın ki handa birkaç kadeh içtikten sonra her şeyi dökülüyorsun zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230125
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130230125,
					"content": "Ne? Hayır, olamaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaveh"
				}
			]
		}
	]
}