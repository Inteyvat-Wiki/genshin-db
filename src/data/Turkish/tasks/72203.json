						722030502
					],
					"speakerTitle": "Nonno"
				},
				{
					"id": 722030502,
					"content": "Seni özleyeceğim ama... Bu defa vedalaşmaya geldim. Altın adam gitmemiz gerektiğini söylüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030503
					],
					"speakerTitle": "Nonno"
				},
				{
					"id": 722030503,
					"content": "Ama benim için endişelenme! Gittiğim yerde oynayacak bir sürü kişi var! Keşke sen de gelebilseydin ama altın adam henüz zamanı değil diyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030504
					],
					"speakerTitle": "Nonno"
				},
				{
					"id": 722030504,
					"content": "Tabii hiç sorun değil! Hiç! Orada seni beklerim... Eğer bekleyemezsem de ufak ışık parçalarına dönüşüp rüyalarında seni bulurum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030505
					],
					"speakerTitle": "Nonno"
				},
				{
					"id": 722030505,
					"content": "İyi yolculuklar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722030506
					]
				},
				{
					"id": 722030506,
					"content": "Teşekkür ederim! Seninle oynamak çok eğlenceliydi. Teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030507
					],
					"speakerTitle": "Nonno"
				},
				{
					"id": 722030507,
					"content": "Artık yalnız olmayacağım, harika...",
