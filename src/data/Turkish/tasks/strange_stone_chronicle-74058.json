			"dialogs": [
				{
					"id": 740580201,
					"content": "Vay canına, ne kadar da çok... Çok yardımı dokunacak bunların!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580202
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580202,
					"content": "Cevheri atölyeye gönderdim ama henüz ürün numunesini alamadım. Zanaatkarlar bu tür bir mücevherle çalışmaya alışkın olmadığından bazı sorunlarla karşılaşmış olabilirler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580203
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580203,
					"content": "Ama endişelenecek bir şey yok! Gözlerime güveniyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580204
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580204,
					"content": "Onlardan tüm Fontaine'de yepyeni bir moda olacak takılar üretmeyi planlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580205
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580205,
					"content": "Bir sonraki gelişinizde nihai ürünün nasıl olduğunu görebilirsiniz! O zaman size numunelerden bir hediye de veririm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580206
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580206,
					"content": "Ya da belki... Daha buraya gelmeden bazı en şık soyluların onları taktığını bile görebilirsiniz, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580207
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740580207,
					"content": "Pekala o zaman, sizi yine beklerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chesil"
				}
			]
