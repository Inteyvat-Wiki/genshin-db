			"dialogs": [
				{
					"id": 740580101,
					"content": "Puca, biz geldik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740580102,
					"content": "#{NICKNAME} ve Paimon! Benimle oynamaya mı geldiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580103
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740580103,
					"content": "Hımm, pek sayılmaz aslında! Cevher damarları ve değerli taşlarla ilgili sana sorular sorabileceğimizi söylemiştin, hatırladın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740580104,
					"content": "Evet! Alandaki tüm güzel taşları topladım. Tam olarak ne sormak istiyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580105
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740580105,
					"content": "Geçen sefer bulduğumuz taş hakkında...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740580106,
					"content": "Puca'ya tuhaf cevheri değerli taş tüccarına nasıl sattığınızdan bahsedersiniz...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740580107
					]
				},
				{
					"id": 740580107,
					"content": "Ne? Dışarıdaki insanlar gerçekten de onun değerli olduğunu mu sandı? Ama ben o taşı daha önce kız kardeşime göstermiştim... İnsanları anlamak cidden zor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580108
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740580108,
					"content": "Onun gibi taşlarla dolu çok yer biliyorum! İsterseniz nerede olduklarını gösterebilirim size.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580109
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740580109,
					"content": "Puca, tuhaf cevherin yerlerini haritada işaretler...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740580110
					]
				},
				{
					"id": 740580110,
					"content": "Harika, teşekkürler Puca! Ah bu arada, işte Chesil'in bize avans olarak verdiği Mora. Yarı yarıya paylaşabiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740580111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740580111,
					"content": "Ah, gerek yok. Köyde bize öyle şeyler lazım olmuyor... Bana o kadar yardım ettiniz, benim yaptığım nedir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Puca"
				}
			]
		},
