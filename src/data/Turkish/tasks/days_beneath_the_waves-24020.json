			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yves"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240200101,
					"content": "Ne şans ama! Ben bir daha asla su altına gitmem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200102,
						240200103
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200102,
					"content": "Ne oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200104
					]
				},
				{
					"id": 240200104,
					"content": "Ah, sen miydin? Seni görmek gerçekten güzel! Ben... Ben neredeyse canımdan oluyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200105
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200105,
					"content": "Her zamanki gibi su altında çalışıyordum. Suya daldım, yosunlardan, çöplerden kaçtım ve hiçbir yara bere almadan atlattım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200106
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200106,
					"content": "Tam bir şeyleri toplarken toprağın içinden bir grup canavar çıktı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200107
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200107,
					"content": "Tam olarak ne olduklarını hatırlamıyorum ama hepsi birden bana doğru geliyordu. Ben de var gücümle kaçıp yukarı doğru yüzdüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200108
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200108,
					"content": "Ama çok geçmeden bir grup tuhaf mekanik balığa denk geldim. Beni gördükleri anda kendilerinden geçip saldırmaya başladılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200109
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200109,
					"content": "Kıyıya nasıl vardım bilmiyorum ama yara bere almadan varabildim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200110,
						240200111
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200110,
					"content": "Eğer bu kadar tehlikeliyse muhtemelen bu bölgeden uzak durman gerekiyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200112
					]
				},
				{
					"id": 240200112,
					"content": "Ama yapamam işte! Burası Goldman'ın belirlediği yer... Burada insanlar yaralanmış, hatta kimisi hayatını kaybetmiş, hiç umurunda olmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200113
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200113,
					"content": "Zamanla Goldman'ın maaş kesme tehditleri bile kimseyi buraya eşya aramaya gelmeye ikna edemedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200114
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200114,
					"content": "Bu yüzden o da bir süre sonra taktik değiştirip buraya gelmek isteyenlere üç katı Mora vereceğini söylemeye başladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200115
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200115,
					"content": "Böyle olunca... Ben ve paraya sıkışan birkaç arkadaşım bu işi kabul ettik. Hatta su altında kendimizi koruyabilelim diye birkaç tane zıpkın bile aldık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200116
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200116,
					"content": "Ama daha birkaç gün geçmişti ki zıpkınlarımız ya kırıldı ya kayboldu... Ben burada nöbete kaldım, diğerleri de şehre, yenilerini almaya gittiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200117,
						240200118
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200117,
					"content": "O zaman niye şimdi suya daldın ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200119
					]
				},
				{
					"id": 240200119,
					"content": "Onlar gideli epey zaman geçti! Bir an önce başlamazsak bu gece kaça kadar ayakta kalacağım kim bilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200120
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200120,
					"content": "Sana yardım edeyim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200121
					]
				},
				{
					"id": 240200121,
					"content": "Hayır! Olmaz! Bunlar, gerçekten dövüşülmesi gereken gerçek canavarlar! Maceracılar bile üstesinden gelemez. Olmaz, bunu yapmana müsaade edemem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200122,
						240200123
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200122,
					"content": "Ben sıradan bir maceracı değilim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200124
					]
				},
				{
					"id": 240200124,
					"content": "Şey... Hayır aslında...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200125
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200125,
					"content": "Pekala. Madem ısrar ediyorsun yeri senin için işaretleyeyim... Ama lütfen dikkatli ol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200123,
					"content": "Oradan bakınca sıradan bir maceracı gibi mi görünüyorum?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200124
					]
				},
				{
					"id": 240200118,
					"content": "Neden kendini korumak için elinde bir silah olmadan suya daldın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200119
					]
				},
				{
					"id": 240200111,
					"content": "Bu çok tehlikeli geliyor kulağa. Başka bir yer bulman lazım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200112
					]
				},
				{
					"id": 240200103,
					"content": "Bu defa ne oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200104
					]
				}
			]
		},
