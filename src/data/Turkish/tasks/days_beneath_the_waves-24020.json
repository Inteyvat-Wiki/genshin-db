			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yves"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240200601,
					"content": "Ah, bu ne şanssızlık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200602
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200602,
					"content": "Eşyaları satabildin mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200603
					]
				},
				{
					"id": 240200603,
					"content": "Ah, sen miydin? Unut gitsin. Tam satın alacak birini bulmuştum ki o sırada Goldman evime dalıp o ıvır zıvır kutusunu alıp götürdü!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200604
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200604,
					"content": "Eğer hâlâ onun için çalışmama ihtiyacı olmasa kesin beni döverdi... Bu arada iki aylık maaşımı kesti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200616
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200616,
					"content": "Bu yılın tüm işlerini tamamladıktan sonra bana ödeme yapmak istiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200605
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200605,
					"content": "*iç çeker* Neyse, boş ver. Şans benim gibi bir aptala güler mi hiç? Bir dakika, Goldman gelip kapına dayanmadı, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200606,
						240200609
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200606,
					"content": "Hayır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200607
					]
				},
				{
					"id": 240200607,
					"content": "İyi o zaman. Ben dayak yesem de önemli değil ama senin başını o adamla belaya sokmak istemem hiç.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200608
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200608,
					"content": "Senin bana yardım ettiğinden bahsetmedim ama birinin fark edip anlattığından şüpheleniyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200611
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200611,
					"content": "Yine de, bugün tekrar yardımına ihtiyacım var. Dalgıç giysimi daha tamir edemedim. Ancak Goldman işlerimi tamamlayamadığım günleri telafi etmem için beni zorluyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200612
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200612,
					"content": "Başkasının dalgıç giysisini ödünç almak dışında bir seçeneğim yoktu ama yine de işlerimi yeterince hızlı halledemedim... Ne yazık ki yine senin yardımına güvenmem gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200613,
						240200614
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200613,
					"content": "Sorun yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200615
					]
				},
				{
					"id": 240200615,
					"content": "Teşekkür ederim. Ben söz konusu eşyaların yerini işaretleyeceğim, sonra da ayrılıp ararız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				},
				{
					"id": 240200614,
					"content": "O iş bende.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200615
					]
				},
				{
					"id": 240200609,
					"content": "Bana gelecek olursa dersini veririm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240200610
					]
				},
				{
					"id": 240200610,
					"content": "Lütfen o utanmaz yağ tulumuna bulaşma sen! Senin gibi saygın biri onunla tanışmamalı bile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240200611
					],
					"speakerTitle": "Yves"
				}
			]
		}
	]
