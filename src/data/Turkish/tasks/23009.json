					"id": 230091703,
					"content": "Akim toprağı karıştırmaya başlıyor...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230091704
					]
				},
				{
					"id": 230091704,
					"content": "Tamam, hazır. Lütfen bu toprağı Nima'ya götür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091705
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091705,
					"content": "Çok uzun zamandır bekliyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091706
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091706,
					"content": "Bu çocuk... Şey... Hayal gücü inanılmaz güçlü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091707
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091707,
					"content": "Nima bana konuşabilen ve düşmanları devirebilecek türlü türlü sihirli güce sahip \"kap savaşçıları\" yapmak istediğini söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091708
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091708,
					"content": "Bu savaşçıların gücü gövdelerinin içindeki malzemeye göre değişecekmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091709
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091709,
					"content": "Hatta bu kap savaşçılarına isim bile koydu, Ad... Unuttum gerçi, tam hatırlamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091710
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091710,
					"content": "Maalesef sihirli güçleri olan kap savaşçıları yapamam tabii. Ama yine de ilginç bir fikir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091711
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091711,
					"content": "O yüzden ben de toprağı ona oyuncak olarak hediye etmeyi düşündüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091712
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091712,
					"content": "Böylece kendi kap savaşçılarını yapabilir ve onlara bir general gibi emredebilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091713
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091713,
					"content": "Neyse, lütfen bu toprağı Nima'ya göndermeme yardım et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091714
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091714,
					"content": "Kap savaşçıları tamamlanınca belki bizi de \"kap generali\" yapar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				}
			]
