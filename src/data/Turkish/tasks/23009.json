					"nextDialogs": [
						230091403
					]
				},
				{
					"id": 230091403,
					"content": "Ah! Sen... Senmişsin Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091404
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091404,
					"content": "*iç çeker* Yaptığım Killi Toprakta bir sorun var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091405
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091405,
					"content": "Karışım oranı mı yanlış acaba? Veya yeterince deneme yapmadık mı ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091406
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091406,
					"content": "Killi Toprak kullanarak mutfaklarını inşa eden çoğu müşteri birkaç gün sonra çatlakların oluştuğunu söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091407
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091407,
					"content": "Belki de hava o kadar sıcak oldu ki toprağın bazı kısımları bozuldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091408
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091408,
					"content": "*iç çeker* Neyse, gidip o çatlakları düzeltmem lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091409
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091409,
					"content": "Tamire ihtiyacı olan o kadar çok insan vardı ki kullanılan Killi Toprağın hepsini almam mümkün değildi, ben de kaplara koymalarını istedim. Ve bir sürü kap vardı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091410
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091410,
					"content": "Gezgin, ben diğer eve giderken sen de bu evde kullanılan Killi Toprağı toplamama yardım eder misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091411
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091411,
					"content": "*iç çeker* Neyi yanlış yaptım ki ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				}
			]
