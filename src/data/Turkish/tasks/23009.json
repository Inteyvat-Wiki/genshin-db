					"nextDialogs": [
						230091104
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091104,
					"content": "Çiçek yetiştirmeyi sevdiğini ve onu en çok zorlayan şeyin doğru toprağı bulmak olduğunu söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091114
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091114,
					"content": "Toprağın geçirgenliğinin iyi olması ve yeterli besine sahip olması gerek. Ayrıca suyu tutmalı ama ıslak kalmamalı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091105
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091105,
					"content": "Killi Toprağı bu kadar geliştirdiğimi bildiği için çiçekler için de bir karışım ayarlayıp ayarlayamayacağımı sordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091106
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091106,
					"content": "Bu da bana araştırmaya değer geldi, o yüzden Killi Toprağı geliştirmek için başka malzemeler arıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091107
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091107,
					"content": "Bu sefer verimli toprak bulmama yardımcı olur musun lütfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230091108
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230091108,
					"content": "Senin için toprağın yerini haritada işaretleyeceğim.",
