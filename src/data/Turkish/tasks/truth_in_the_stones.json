			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bravo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210301,
					"content": "Affedersiniz, buradaki işçilerden biri misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210302
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210302,
					"content": "Ah! Evet, evet! Kaybolan kişiler için geldiniz sanırım. Lütfen onları bulun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210303
					],
					"speakerTitle": "Bravo"
				},
				{
					"id": 111210303,
					"content": "Ne oldu bilmiyorum. O gün hava biraz kasvetliydi. Ustabaşı birkaç kişiyle bir yere kadar gitmişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210304
					],
					"speakerTitle": "Bravo"
				},
				{
					"id": 111210304,
					"content": "Diğer dört kişiyle geride kaldım. Bir süre sonra soluklanmak için mola vermeye karar verdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210305
					],
					"speakerTitle": "Bravo"
				},
				{
					"id": 111210305,
					"content": "Ama içerideki sığınakta uyuyakalmışım. Uyandığımda kimse ortada yoktu! Kısa bir süre önce konuşmuştuk, sonra bir baktım... Gözden kaybolmuşlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210306
					],
					"speakerTitle": "Bravo"
				},
				{
					"id": 111210306,
					"content": "Belki... Sıra bana gelmiştir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210307
					],
					"speakerTitle": "Bravo"
				},
				{
					"id": 111210307,
					"content": "Yani işçilerin nasıl kaybolduğunu anlatabilecek tek görgü tanığımız sığınakta uyuyakalmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210308
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210308,
					"content": "Belki madende bir kaza olmuştur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210309
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210309,
					"content": "Bu korkutucu bir düşünce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210310,
					"content": "Madende kaza... Bunu da not alalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1112104,
			"completionStepIds": [
				1112104
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112104",
							"2"
						],
						"stepId": 1112104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210401,
					"content": "Buraya bakın! Bu nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210402,
					"content": "Gömlekler, birkaç pantolon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210403,
					"content": "Günlük eşyalar, Dai Amca'nın ve işçilerin eşyaları olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210404
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210404,
					"content": "Bir, iki, üç, dört...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210405,
					"content": "Hah... Her şey yerli yerinde. On gömlek, on pantolon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210406,
					"content": "Bunlar yedek kıyafetler, değil mi? Bak, Dai Amca'nın kıyafetleri bunlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210407,
					"content": "Dördü altı gündür kayıp, kıyafetlerini değiştirmemişler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210408
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210408,
					"content": "Etrafta birkaç mendil, biraz sabun... Ah, alet kemerleri de var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210409,
					"content": "Şafak vardiyasından önce yüz yıkamak için kullanılan eşyalar... Maden ekipmanı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210410
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210410,
					"content": "O zaman... Yanlarına eşyalarını almamışlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210411,
					"content": "Hımm, evet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210412,
						111210413
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210412,
					"content": "İhtiyaçları mı yoktu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210414
					]
				},
				{
					"id": 111210414,
					"content": "Mümkün değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210415
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210415,
					"content": "Dört kazma kayıp. Maden aletlerini alıp gitmişler gibi görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210416
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210416,
					"content": "Aletlerini almışlar ama günlük eşyalarını bırakmışlar? İlginç.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210417
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210417,
					"content": "Ha... Neden biri aletleri alıp kişisel eşyalarını bırakır?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210418,
					"content": "İki ihtimal var. Yakınlarda çalışıyorlardı ve kişisel eşyalarına ihtiyaç duymadılar ama dönmediklerine göre bunun olması pek muhtemel değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210419
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210419,
					"content": "İkinci ihtimal, zorla götürüldüler ve eşyalarını düşünecek zamanları yoktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210420
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210420,
					"content": "Ah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210421,
					"content": "Biri onları kaçırmış olabilir mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210422
					]
				},
				{
					"id": 111210422,
					"content": "O da bir olasılık. Herhangi bir çıkarımda bulunmadan önce daha fazla ipucu toplamalıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210423
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210423,
					"content": "Ya istekleri dışında zorla götürüldülerse... Not alıp Dai Amca'ya haber verelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210413,
					"content": "Unutmuş olabilirler mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210414
					]
				}
			]
		},
		{
			"id": 1112107,
			"completionStepIds": [
				1112107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112107",
							"2"
						],
						"stepId": 1112107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dai Amca"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210701,
					"content": "Döndünüz! İncelemeler nasıl gidiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210702
					],
					"speakerTitle": "Dai Amca"
				},
				{
					"id": 111210702,
					"content": "Civarda üç ipucu bulduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210703
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210703,
					"content": "Kazmaların dördü kayıp ama günlük eşyalara dokunulmamış. Bu da, adamlarınızın kendi istekleriyle ayrılmadıklarını, zorla götürüldüklerini gösteriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210704
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210704,
					"content": "Zorla götürmek mi? Ama... Kim madencileri kaçırır ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210705
					],
					"speakerTitle": "Dai Amca"
				},
				{
					"id": 111210705,
					"content": "Kim? Gerçekten... Olay sırasında madende beş madenci olduğunu öğrendik. İçlerinden biri dinlenmek için kazı alanından ayrılmış ama uyandığında iş arkadaşları çoktan sırra kadem basmışlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210706
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210706,
					"content": "Çalışmaya devam edenler ortadan kaybolmuş. Erken ayrılan kişinin başına bir şey gelmemiş. Yani olay kazı alanında meydana gelmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210707
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210707,
					"content": "Bravo'nun mola verdiğini söylediğini hatırlıyorum, evet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210708
					],
					"speakerTitle": "Dai Amca"
				},
				{
					"id": 111210708,
					"content": "Biri kazı alanına girip onları öylece götürdü mü yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210709
					],
					"speakerTitle": "Dai Amca"
				},
				{
					"id": 111210709,
					"content": "Bu da bizi üçüncü ipucuna götürüyor. Bay Kun Jun... Uzman teknikleri sayesinde onları bir çocuğun götürdüğü sonucuna vardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210710
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210710,
					"content": "Çocuk mu? Civarda hiç yerleşim yeri yok ki! Hele bir çocuğun madene gelmesine imkan yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210711
					],
					"speakerTitle": "Dai Amca"
				},
				{
					"id": 111210711,
					"content": "Her ne kadar garip olsa da bu sonuca vardık. Adamlarınız bir çocuğu takip ediyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210712,
					"content": "Nereye gittiler peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210713
					],
					"speakerTitle": "Dai Amca"
				},
				{
					"id": 111210713,
					"content": "Kuzey yönüne, madenin dışındaki harabelere gittiklerini düşünüyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210714
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210714,
					"content": "Kuzey! Peki, adamlarımı toplayıp peşlerine düşeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210715
					],
					"speakerTitle": "Dai Amca"
				},
				{
					"id": 111210715,
					"content": "Yardım gerekiyor mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210716
					]
				},
				{
					"id": 111210716,
					"content": "Soruşturmaya katkınız paha biçilemez ama ayak işlerini bize bırakın. Acele edip bir an önce yola çıkarsak belki onları yakalarız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210717
					],
					"speakerTitle": "Dai Amca"
				},
				{
					"id": 111210717,
					"content": "Acele etmeyin. Kaza altı gün önce oldu. Yürüyerek gitseler bile bayağı yol katetmişlerdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210718
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210718,
					"content": "*iç çeker* Haklısın... O zaman B planı. Arama ekibimle uzaktaki yerleşim yerlerine gidip bilgi almaya çalışacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210719
					],
					"speakerTitle": "Dai Amca"
				},
				{
					"id": 111210719,
					"content": "Bu civarda gece konaklayacak sadece birkaç yerleşim yeri var. Oralarda bir şey bulup bulamayacağımıza bakacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210720
					],
					"speakerTitle": "Dai Amca"
				},
				{
					"id": 111210720,
					"content": "O sırada ipuçları aramaya devam edebilirsiniz. Birbirimizi görmezsek yarın akşam Wangshu Hanında tekrar toplanalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210721
					],
					"speakerTitle": "Dai Amca"
				},
				{
					"id": 111210721,
					"content": "Tamamdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210722
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210722,
					"content": "Pekala, ben adamlarımla yola koyuluyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210723
					],
					"speakerTitle": "Dai Amca"
				},
				{
					"id": 111210723,
					"content": "Yani... Biz burada araştırmaya devam ederken onlar yerleşim yeri sakinleriyle konuşacaklar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210724,
					"content": "Evet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210725
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210725,
					"content": "Ama... Madende pek bir şey bulamadık. Kuzeye gitmemiz gerekmiyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210726,
					"content": "Bir saniye... Aramızdan bir kişi eksik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210727
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210727,
					"content": "Ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210728,
					"content": "Ah, Kun Jun nerede? Paimon onun incelemelere devam ettiğine emin. Gidip onu bulalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1112108,
			"completionStepIds": [
				1112108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112108",
							"2"
						],
						"stepId": 1112108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kun Jun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210801,
					"content": "Kun Jun! Ne arıyorsun? Elimizde işe yarar ipucu kalmadı! Devam edelim hadi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210802,
					"content": "Ah, kusura bakmayın, kendim için hızlıca bir şeye bakıyordum. Ejderkapanı olarak bilinen değerli bir taş arıyorum da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210803
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210803,
					"content": "Ejderkapanı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210804,
						111210805
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210804,
					"content": "Hiç duymadım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210806
					]
				},
				{
					"id": 111210806,
					"content": "Ejderkapanı genelde demircilikte kullanılır. Ne işinize yarayacak ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210807
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210807,
					"content": "B-Bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210808
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210808,
					"content": "Ü-Üzgünüm. Onu ne için aradığımı hatırlamıyorum. Kafam çok... Gidip geliyor bu aralar. İsimler ve adresler hariç diğer her şeyi hatırlamakta güçlük çekiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210809
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210809,
					"content": "Hatta bu ara çok... Gerginim. Tamamlamam gereken bir iş varmış da unutmuşum gibi. Biraz... Tatsız bir durum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210810
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210810,
					"content": "Ah, Paimon ne hissettiğini biliyor! Bir şey unuttuğunu biliyorsun ama tam olarak ne olduğunu hatırlamıyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210811,
					"content": "Nereden başlasam bilemedim. Ben... Aylak aylak dolanıp duruyordum. O gün pazardan bir şeyler alırken bir konuşmaya kulak misafiri oldum. Ejderkapanından söz ediyorlardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210812
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210812,
					"content": "Çok tanıdık geldi, o taşın yapmam gereken işle alakası vardı sanki. Ben de birkaç tane bulmaya karar verdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210813
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210813,
					"content": "Belki birkaç tane bulursam ne yapmam gerektiğini hatırlayabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210814
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210814,
					"content": "Anladım. Araştırmamız sırasında mümkün olursa bu taşı aramanıza yardım edeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210815
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210815,
					"content": "Cidden mi? Ah, çok sağ olun Bay Zhongli! Çok naziksiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210816
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210816,
					"content": "Önemli değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210817
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210817,
					"content": "Gidelim mi artık?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210818,
					"content": "Kanyon'dan kuzeye ilerleyip Lingju Geçidi'ne gideceğiz. Gerçekten bu yolu tercih etmişlerse iz bırakmışlardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210819
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210819,
					"content": "Harika! Hadi bir bakalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210805,
					"content": "Uzmanlık alanım değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111210806
					]
				}
			]
		},
		{
			"id": 1112109,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
