			"trigger": {
				"objectNames": [
					"Dai Amca"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210101,
					"content": "Vay be, bu maden çok büyükmüş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210102,
					"content": "Kaza burada oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210103
					],
					"speakerTitle": "Dai Amca"
				},
				{
					"id": 111210103,
					"content": "Altı gün önce grup halinde başka işlerle ilgilenmek için araziden ayrılmıştık. Döndüğümüzde geride bıraktığımız dört kişi ortadan kayboldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210104
					],
					"speakerTitle": "Dai Amca"
				},
				{
					"id": 111210104,
					"content": "Madenin her yerini araması için bir ekip topladım ama hiçbir iz bulamadılar. Sonra da yardım talep ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210105
					],
					"speakerTitle": "Dai Amca"
				},
				{
					"id": 111210105,
					"content": "Dört madenci kayboldu demek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210106
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210106,
					"content": "Evet. Toplam on kişiydik. Long, Gözüpek Cen, Cesur Cen ve Mao vardı. Hepsiyle de çalıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210107
					],
					"speakerTitle": "Dai Amca"
				},
				{
					"id": 111210107,
					"content": "Bu işte çalışanlar genelde hayatlarının baharını yaşayan gençler oluyor. Başka bir madene gitmiş olabilirler mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210108
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210108,
					"content": "Sanmıyorum. Bu civarda kalacak başka yer yok. Buraya gelirken başka bir maden gözümüze çarpmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210109
					],
					"speakerTitle": "Dai Amca"
				},
				{
					"id": 111210109,
					"content": "Ama burası büyük bir maden. Her yerine baktığınıza emin misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210110
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210110,
					"content": "Yer altı, yer üstü... Buranın altını üstüne getirdik. Toprağın derinlerine inmek dışında her şeyi denedik. Dört gürbüz genç yer yarıldı içine girdi sanki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210111
					],
					"speakerTitle": "Dai Amca"
				},
				{
					"id": 111210111,
					"content": "Herhangi bir kanıya varmadan önce araziyi bir de biz inceleyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210112
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210112,
					"content": "Pekala, dilediğiniz yere bakın, ben burada bekliyorum. Herhangi bir ipucu bulursanız hemen bana haber verin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dai Amca"
				}
			]
		},
		{
			"id": 1112102,
			"completionStepIds": [
				1112102
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112102",
							"2"
						],
						"stepId": 1112102,
						"stateName": "QUEST_STATE_UNFINISHED"
