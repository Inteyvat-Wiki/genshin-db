			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kun Jun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111210201,
					"content": "Kun Jun, orada ne var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210202,
					"content": "Ah, tam zamanında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210203
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210203,
					"content": "Bir şey buldun mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210204
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210204,
					"content": "Burada bir cevher parçası var, belki ipucu bulabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210205
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210205,
					"content": "Cevher mi? Kaybolanlarla ne ilgisi var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210206,
					"content": "Göreceğiz. Bir saniye, bir şey deneyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210207
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210207,
					"content": "Tamam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210208
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210208,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210209
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210209,
					"content": "Ah... Şu an öyle bir odaklandı ki... Ne yapıyor acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210210,
					"content": "Dört adam... Madenden çıkıp birini takip ediyorlar... Bir çocuk sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210211
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210211,
					"content": "Çocuk mu? Bir çocuğun madende ne işi olur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210212,
					"content": "Emin değilim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210213
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210213,
					"content": "Ayrıca nasıl oldu da bir şey \"görebildin\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210214,
					"content": "Ah! Gerçekten \"görmeyi\" kastetmedim. Size şimdi söyleyeceklerim aramızda sır olarak kalsın lütfen. Biraz garip bir durum ve... Kimseye söyleme cesaretim olmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210215
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210215,
					"content": "Cevherin anılarını... Sezebiliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210216
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210216,
					"content": "Ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210217,
					"content": "\"Sezmek\" mi? Yani aslında... Varsayımda bulunmuyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210218
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210218,
					"content": "Yani elini taşa koyuyorsun ve... Bam! Öylece oluyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210219,
					"content": "Cevherlerin \"anıları\" olduğunu hep hissetmiştim. Bazen çevrede olup biteni kaydederler. Bir tanesine dokunup odaklanmam yetiyor, anılar zihnimde canlanıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210220
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210220,
					"content": "Harika! O zaman etrafta olup biten her şeyi görebilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111210221,
					"content": "Bu biraz da cevhere bağlı. Bazı cevherlerin hayrete düşüren hafızaları var ama Demir Cevheri ve Beyaz Demir Cevheri gibilerinin hafızaları biraz bulanıktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210222
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210222,
					"content": "Cor Lapislerin ve kristallerin hafızaları daha güçlüdür. Daha çok anı barındırıp daha çok ayrıntı gösterirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210223
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210223,
					"content": "Taş görüsü... Etkileyici. Bulunmaz bir nimet gerçekten. Dai Amca sizi işe almakta akıllılık etmiş Bay Kun Jun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210224
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210224,
					"content": "Haha, yardım edebildiğime sevindim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210225
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210225,
					"content": "Bu yoldan gittiklerini gördüm sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210226
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111210226,
					"content": "Bu yol madenin dışına, kuzeye gidiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111210227
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111210227,
					"content": "Kuzey... Dai Amca için bir ipucu daha bulduk! Not alalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1112103,
			"completionStepIds": [
				1112103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
