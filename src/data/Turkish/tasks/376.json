			},
			"dialogs": [
				{
					"id": 3760701,
					"content": "Galiba bugün canım bir kadeh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760702
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760702,
					"content": "Barın arkasından çaldığın o şişeyi elinden bırak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760703
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760703,
					"content": "... Soğuk bir şey çekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760704
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760704,
					"content": "Pekala. Sorularıma cevap istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760705
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760705,
					"content": "Önce içkimi bitirseydim? Sana karşılığında... Şey, bir gösteri yapabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760706
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760706,
					"content": "Konu para değil. İçki içecek yaşa gelmemişsin daha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760707
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760708,
					"content": "Önce soruma cevap versen nasıl olur?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3760709
					]
				},
				{
					"id": 3760710,
					"content": "Aslında... Evet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3760711
					]
				},
				{
					"id": 3760707,
					"content": "Hiç endişelenme. Ben içmeye başladığımda sen daha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760708,
						3760710
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760709,
					"content": "\"Bu kim?\" diye sormak istiyorsun, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760711
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760711,
					"content": "O Usta <color=#00E1FFFF>Diluc</color>. Bu hanın sahibidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760712
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760712,
					"content": "Çok ünlüdür. Bu arada, karahindiba şarabı favorilerimden biridir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760713
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760713,
					"content": "Gerçi çoğu zaman param bir, bilemedin iki şişeye yeter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760714
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760714,
					"content": "Az önce muhafızların iki hırsızın peşinde olduğunu duydum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760715
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760715,
					"content": "İtiraf etmeliyim ki Göklerin Kutsal Lirini çalmaya cüret edebilmeniz hoşuma gitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760716
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760716,
					"content": "Aptal olsanız bile... Sizin gibilere her gün rastlamıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760717
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760717,
					"content": "Liri biz çalmadık ki! Gerçek hırsız hâlâ sokaklarda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3760718,
					"content": "Bu Favonius Şövalyelerinin yıldızı. Neden böyle üstün bir kişi Mondstadt'ın kutsal hazinesini çalsın ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760719
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760719,
					"content": "Yıldızı, öyle mi? Ah, o sensin demek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760720
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760721,
					"content": "Açıkçası, yakın değiliz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3760723
					]
				},
				{
					"id": 3760722,
					"content": "Bir keresinde sazını çalarken dinlemiştim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3760723
					]
				},
				{
					"id": 3760720,
					"content": "Yani ozanla yakın mısınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760721,
						3760722
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760723,
					"content": "Pekala... Yoldan geçen bir gezgin olmana rağmen ihtiyaç olduğunda Mondstadt'a yardım ettin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760724
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760724,
					"content": "Şövalyelere katılman yazık olmuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760725
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760725,
					"content": "Favonius Şövalyeleri... Tepeden tırnağa basiretsizlik örneği.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760726
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760726,
					"content": "Ve <color=#00E1FFFF>Fatui'ye</color> karşı? Zayıf ve tutucu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760727
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760727,
					"content": "Boş ver. Konuşmak istemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760728
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760728,
					"content": "Favonius Şövalyelerini sevmediğin çok belli oluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760729
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760729,
					"content": "Yaklaşım farklılıkları, diyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760730
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760730,
					"content": "Bu şehir için kendimce umutlarım var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760731
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760731,
					"content": "Şimdi, cevaplara gelelim. Kutsal Liri neden çaldınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760732
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760732,
					"content": "Bilmek istediğinden emin misin? Favonius Şövalyelerinin işlerine bulaşmana neden olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760733
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760733,
					"content": "Sorun değil. Zaten kader beni daima bir şekilde onların işlerine bulaştırıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760734
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760734,
					"content": "Hikayeyi sana bir gösteriyle anlatırsam bana inanır mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760735
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760735,
					"content": "Duruma bağlı. Kendi kararımı veririm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760736
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760736,
					"content": "Peki, para alacak mıyım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760737
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760737,
					"content": "Alacağın ödül beş Mora ile bir Kutsal Lir arasında değişir. Her şey senin hikayene bağlı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760738
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760738,
					"content": "Çok iyi. Bir gösteri yapayım o zaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760739
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760739,
					"content": "Ben az önce neye şahit oldum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760740
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760740,
					"content": "Bu gizli bilgidir. Neden bana söyledin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760741
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760741,
					"content": "Neden? Hım... Belki rüzgarlar değişiyordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760742
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760742,
					"content": "Ne diyorsun, Usta Diluc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760743
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760743,
					"content": "İlginç.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760744
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760744,
					"content": "Bana biraz zaman verin. Birkaç kişiyle bağlantı kuracağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760745
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760745,
					"content": "Yabancı, sen Şövalyelerden biri olduğun için görünüşe göre şüpheli değilsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760746
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760746,
					"content": "Kayıp ilanındaki tek açıklama, sarışın olması. Sen güvendesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760747
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760747,
					"content": "Ama ozan, senin handa kalman daha iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760748
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760748,
					"content": "Haha. Hiç sorun değil! Hanları severim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760749
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760749,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760750
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760750,
					"content": "Tamam. Han kapandıktan sonra bu gece burada buluşalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760751
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4820221,
					"content": "Tamam o zaman. Yapman gereken tek şey <color=#00E1FFFF>işaretli rotayı</color> takip edip bitişe ulaşmak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820222
					],
					"speakerTitle": "Amber"
				}
			]
		}
	]
}