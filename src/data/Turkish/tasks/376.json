			"dialogs": [
				{
					"id": 3760401,
					"content": "Usta Diluc, bu haftanın hesapları.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760402
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 3760402,
					"content": "Hım... Felaket işi çok etkilemiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760403
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760403,
					"content": "Umarım her şey yakında sona erer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760404
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 3760404,
					"content": "Merhaba, şey... En sakin masanızda bir yer istiyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760405
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760405,
					"content": "İkinci kat daha sakin olur. Orada daha rahat edersiniz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760406
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760406,
					"content": "Sen ozan değil misin? Neden göz önünde olmak istemiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760407
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760407,
					"content": "Hahaha, ücretli gösteriyi bir dahaki sefere yapalım. Biz yukarı çıkıyoruz, birazdan görüşürüz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3760408,
					"content": "Hey, gözünün önünden ayırma. O ozanda tuhaf bir şeyler var. Ben etrafa birkaç soru soracağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760409
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760409,
					"content": "Tam olarak kime soracaksın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760410
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 3760410,
					"content": "Mondstadt'ın \"koruyucularına\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				}
			]
		},
		{
			"id": 37605,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
