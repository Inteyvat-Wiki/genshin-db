				"points": []
			},
			"dialogs": [
				{
					"id": 3760601,
					"content": "Ah, Usta Diluc. Buralarda iki hırsız gördün mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760602
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 3760602,
					"content": "Ne oldu? Neden bu kadar muhafız var ortalıkta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760603
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760603,
					"content": "Duymadın mı Usta Diluc? İki hırsız Kutsal Liri çalmaya kalkıştı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760604
					],
					"speakerTitle": "Miles"
				},
				{
					"id": 3760604,
					"content": "Öyle mi? Ne tuhaf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760605
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760605,
					"content": "Değil mi ama? Kutsal Lir, Rüzgar Tanrısı'nın bizzat çaldığı bir hazinedir. Bu kadar değerli bir kültür mirası...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760606
					],
					"speakerTitle": "Miles"
				},
				{
					"id": 3760606,
					"content": "Neden insan satamayacağı bir şeyi çalmak ister? Şarap stokumu çalmak daha mantıklı bir iş olurdu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760607
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760607,
					"content": "Ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760608
					],
					"speakerTitle": "Otto"
				},
				{
					"id": 3760608,
					"content": "Pardon, konumuzdan saptık. Galiba şu tarafa gittiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3760609
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3760609,
					"content": "Anlaşıldı. Teşekkürler Usta Diluc!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Miles"
				}
			]
		},
