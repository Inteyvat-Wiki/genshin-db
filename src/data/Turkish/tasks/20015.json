					"nextDialogs": [
						200150703
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200150703,
					"content": "Doğru ya! Unutmadan, şu dağ yabanisinin verdiği hediyeyi al lütfen.",
