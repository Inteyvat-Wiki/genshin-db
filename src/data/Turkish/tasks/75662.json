			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kinich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 756620101,
					"content": "Kuryelerimizden biri, savaş hazırlığı irtibat görevlimizin harika bir tasdik memuru bulduğunu söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620102
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 756620102,
					"content": "Demek sensin o. İçim rahatladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620103
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 756620103,
					"content": "Cık, onca kişi arasından SENİ mi bulmuşlar? Baksana Kinich, tencere yuvarlanmış kapağını bulmuş resmen. Bu görev manyağı da hayır demesini öğrenemedi bir türlü!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620104
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 756620104,
					"content": "Aa bak, yeni bir görev gelmiş: \"Geveze ejderi sustur.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620105,
						756620107
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 756620105,
					"content": "Ha, o mu? O görevi ben verdim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620106
					]
				},
				{
					"id": 756620106,
					"content": "Sen... Siz... Demek öyle ha? Birlik olup Yüce Ejder Lordu'na çullanırsınız... Bekleyin siz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620109
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 756620109,
					"content": "#Her neyse, konumuza dönelim {NICKNAME}. Bu aşamaları tasdik etmen için yardımına ihtiyacımız var. Zorlukları ve dengeleri uygun olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620110
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 756620110,
					"content": "Zorluk mu? Hani nerede? Saçmalamasana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620111
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 756620111,
					"content": "Sana göre ne zor peki? \"Dangoz bir yoldaşla gözlerin bağlıyken halatla dağdan aşağı inmek\" mi mesela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620112
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 756620112,
					"content": "Hatta bir Yumkazor yoldaş seçebilme olasılığını yüzde on yapalım. Diğer seçenekler de Lav Avatarları ile Toprak Bodurlopları olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620113,
						756620116
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 756620113,
					"content": "Ölüme davetiye çıkarmak olur bu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620114
					]
				},
				{
					"id": 756620114,
					"content": "Haha, benim bu hizmetkarımı artık yeterince tanıdın. Gök Kubbenin Evlatları nelerden hoşlanır bilmezmiş gibi konuşma, tam da onların seveceği bir şey önerdim işte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620115
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 756620115,
					"content": "Belki bize bir göstermek istersin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620120
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 756620120,
					"content": "... Böyle küçük işler Yüce Ejder Lordu'nun şanına yakışmaz. Siz kendi aranızda eğlenin, sefiller sizi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620121
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 756620121,
					"content": "Her neyse, Irade bana güzel bir teklif yaptı. Umarım sen de mücadelenin keyfini çıkarır ve tatmin olacağın bir ödeme alırsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620122,
						756620123
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 756620122,
					"content": "Heyecanla bekliyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620124
					]
				},
				{
					"id": 756620124,
					"content": "Başarılar dilerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kinich"
				},
				{
					"id": 756620123,
					"content": "Bu iş bende Kinich!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620124
					]
				},
				{
					"id": 756620116,
					"content": "Ooo, hadi bakalım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620117
					]
				},
				{
					"id": 756620117,
					"content": "Şuna bakın şuna! İşte güzel zevkleri olan biri. En azından senden her türlü daha iyi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620118
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 756620118,
					"content": "Ama profesyonelin nasıl yaptığını görebilmek için önce Ajaw'ı izlemek isterim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620119
					]
				},
				{
					"id": 756620119,
					"content": "Bu fikre ben de katılıyorum Ajaw. Mücadeleye katılan ortalama birinden daha çeviksin. Şansına canavarlardan biri sana vurabilse dahi hemen yere kapaklanıp Ajaw şeklinde bir delik açmazsın herhalde, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620120
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 756620107,
					"content": "Boş ver, o görevi sonra halledersin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620108
					]
				},
				{
					"id": 756620108,
					"content": "Hıh! Bu saçma iltifatlarla Yüce Ejder Lordu'nun kendini sana borçlu hissedeceğini mi sandın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620109
					],
					"speakerTitle": "Ajaw"
				}
			]
		}
	]
}