			"dialogs": [
				{
					"id": 60280301,
					"content": "İyi misin? Yaraların hâlâ acıyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280302
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60280302,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280303
					]
				},
				{
					"id": 60280303,
					"content": "İyi gelebilecek küçük bir ilaç hazırlattım. İhtiyacın varsa alabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280304,
						60280305
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60280304,
					"content": "Sağ ol...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280306
					]
				},
				{
					"id": 60280306,
					"content": "O halde olaydan sonra Alice ile yaptığımız görüşmenin içeriğinden bahsedeyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280307
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280307,
					"content": "O Dottore cingözün teki... Teyvat'ın sınırlarında büyük bir kargaşa yaratarak Cadılar Meclisinin dikkatini dağıttı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280308
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 60280308,
					"content": "Sebebinin dış dünyadan gelen bir Hiçlik müdahalesi olduğunu varsaymıştım. Doğrusunu söylemek gerekirse bu oldukça sık rastlanan bir durum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280309
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 60280309,
					"content": "Ama Nod-Krai'daki hayaletleri etkilemeyi başardığınızı öğrendikten sonra, bu müdahalenin dışarıdan değil de Teyvat'ın içinden gelmiş olabileceğini fark ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280310
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 60280310,
					"content": "Ama kaderlerini değiştiremedik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280311
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280311,
					"content": "Doğru, hikayelerinin nasıl bittiğini değiştiremediniz. Ama etrafınızda bazı \"değişkenler\" oluşturdunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280312
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 60280312,
					"content": "Değişkenler mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280313
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280313,
					"content": "Evet... Başka türlü öğrenemeyeceğiniz şeyler, aklınızın ucundan bile geçmeyecek fikirler... Bunların hepsi birer \"değişken\"dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280314
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 60280314,
					"content": "Elbette değişkenlerin çoğu, etrafta dolaşan sayısız olasılık karşısında genellikle hafif kalır. Ama onları birer yapı bloku gibi bilinçli olarak üst üste dizmeye başladığın an işler değişir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280315
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 60280315,
					"content": "Dottore'nin yaptığı da buydu. Siz bu gece portalı etkinleştirdiğinizde her şeyin kendi planına göre işlemesi için gereken koşulları bu şekilde sağladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280316
					],
					"speakerTitle": "Alice"
				},
				{
					"id": 60280316,
					"content": "Ancak tam olarak ne yaptığını bilmemizin bir yolu yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280317
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 60280317,
					"content": "Evet. Ayrıca Columbina'nın durumunu da netleştirmemiz gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280318
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280318,
					"content": "Durumun özeti bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280319
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280319,
					"content": "Dottore şüphelendiğim gibi tamamen ortadan kayboldu. İyi yanından bakarsak, Columbina'yı istediği gibi kontrol edemedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280320
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 60280320,
					"content": "Maalesef sebebini düşününce bu çok da büyük bir teselli olmuyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280321
					]
				},
				{
					"id": 60280321,
					"content": "Eyvah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280322,
						60280323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280322,
					"content": "Doktor'un planını bozmak için...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280324
					]
				},
				{
					"id": 60280324,
					"content": "Ne? Ne yaptı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280325,
					"content": "Bir dakika, hiçbiriniz bunu yaptığını görmediniz mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280326
					]
				},
				{
					"id": 60280326,
					"content": "Sadece Dottore'nin ortaya çıkıp bir tür güç kullandığını gördük... Sonra bir de baktık ki o ve Columbina gitmiş, sen de denize düşüyordun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280327,
					"content": "(Anladım... Doktor zamanı dondurdu, bu yüzden sadece ben serbestçe hareket edebildim.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280328
					]
				},
				{
					"id": 60280328,
					"content": "(Onların gözünde savaş ve Columbina'nın kararı aynı anda gerçekleşti.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280329
					]
				},
				{
					"id": 60280329,
					"content": "(Demek üç ayın gücü buymuş. Ama ben neden etkilenmedim? Yoksa bir Gökten Gelen olduğum için mi?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280330
					]
				},
				{
					"id": 60280330,
					"content": "Yani Columbina kasten Ay Kapısını açıp Rerir ile Tholindis'in olduğu gizemli dünyaya kaçmış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280331
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60280331,
					"content": "Bu hiç iyi olmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280332
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280332,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280333,
						60280334
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 60280333,
					"content": "Demek ki bu yüzden Dottore bunca zamandır ortalıkta görünmüyordu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280335
					]
				},
				{
					"id": 60280335,
					"content": "\"Üç Ay Döngüsü\" ve Rerir'in ortaya çıkışı... Bu açıdan bakıldığında her iki olayın arkasında da Dottore olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280336
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 60280336,
					"content": "Bayan Alice'in dediğine göre, kaderini aşmaya ve yalnızca bir tanrının tamamlayabileceği bir deneyi bitirmeye çalışıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280337
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 60280337,
					"content": "... Tam bir kaçık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280338
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 60280338,
					"content": "Bir saniye, Şapkalı Adam nerede? O da katılmak isterdi herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280339,
					"content": "Alice'le konuştuktan sonra Dodokomünikasyon Cihazını alıp gitti. Tek başına araştırmak istediği bir konu olduğunu söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280340
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280340,
					"content": "Yüzündeki ifade korkunçtu... Onu daha önce hiç böyle görmemiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280341
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280341,
					"content": "(Muhtemelen tüm çabalarına rağmen Dottore'nin bir adım önde olmasının getirdiği öfke ve hayal kırıklığından dolayıdır.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280342
					]
				},
				{
					"id": 60280342,
					"content": "(Açıkçası ben de aynı şekilde hissediyorum...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280343
					]
				},
				{
					"id": 60280343,
					"content": "Geldim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280344
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280344,
					"content": "Şapkalı Adam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280345
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280345,
					"content": "Hyperborea hayaletlerini tekrar aramaya gittim. Sanırım işi çözdüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280346
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280346,
					"content": "Onları iletişim hattının diğer ucundaki Nicole ile konuşturdum. Meğer anlattıkları tarih, Nicole'un hatırladığından farklıymış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280347
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280347,
					"content": "Gerçekten mi? Ama nasıl? Nicole yanılmış olamaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280348
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280348,
					"content": "Çünkü kandırılanlar hayaletlerdi. Tarihlerinde ortaya çıkan ve aslında hiç var olmaması gereken bir \"kurtarıcı\"dan bahsediyorlardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280349
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280349,
					"content": "Bu kurtarıcı, sahte gökyüzünde yeni bir ay yaratma ve hatta Ay Tanrıçalarını geri getirme sözü vermiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280350
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280350,
					"content": "Aptallık edip ona inanmışlar ve aylar hakkında bilmek istediği her şeyi anlatmışlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280351
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280351,
					"content": "Bunun Dottore'nin işi olduğu çok açık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280352
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280352,
					"content": "Şimdi sen söyleyince hatırladım... Hyperborea harabelerine ilk girdiğimizde hayaletlerin kendi tarihlerini hakkında tartıştıklarını duymuştuk. Nicole bazı şeylerin kulağa biraz tuhaf geldiğini söylemişti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280353
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60280353,
					"content": "Ama Dottore'nin en başta oraya girememesi gerekiyordu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280354
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280354,
					"content": "Giremedi zaten. Nicole bunun, aynı çağdan Hayaletler arasındaki nedensel bağlantılardaki bozulmaların tetiklediği anormal bir durum olduğunu söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280355
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280355,
					"content": "Dottore'nin yerleştirdiği \"değişkenler\" o kadar önemliydi ki hiç tanışmadığı hayaletleri bile etkiledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280356
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280356,
					"content": "Yani anıları belirsiz değildi... Onlarla oynanmıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280357
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60280357,
					"content": "Dottore'nin yaratmaya çalıştığı olasılık tam olarak buydu. Bu değişkenleri bilgiye dönüştürdü, sonra da tüm bilgi kendi eline geçecek şekilde durumu manipüle etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280358
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280358,
					"content": "Daha sonra da o bilgiyi Ay Duası Gecesinde... Gerçek anlamda bir \"sahte ay\" yaratmak için kullandı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280359
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280359,
					"content": "Öyle bir şey nasıl mümkün olabilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280360
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280360,
					"content": "Tam olarak açıklamam gerekirse, büyünün işleyişindeki zayıf noktadan faydalandı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280361
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280361,
					"content": "Büyü, ayın konumunu tespit etmek için Kuuvahkiyi algılıyor. Yani \"sahte ay\", göklerin ötesindeki Donuk Aya kıyasla daha çok ayı andırdığı sürece...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280362
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280362,
					"content": "O geçit Columbina'yı sahte ayın konumuna... Yani Dottore'nin yanına ışınlayacaktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280363
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280363,
					"content": "Columbina'yı kontrolü altına aldığında ışınlanma büyüsü aktif kaldı ve iki Ay İliğini birden ele geçirmek için onun gücünü manipüle etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280364
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280364,
					"content": "O anda Ay İlikleri gözlerimizin önünde kayboldu... Biz harabelerden ayrılırken bile artık çok geçti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280365
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60280365,
					"content": "O zamana kadar Dottore, üç ayın hepsinin gücünü çoktan toplamıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280366
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 60280366,
					"content": "Peki... Bu durumda ne olacak? Şimdi ne yapacağız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280367
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280367,
					"content": "Kendisine dile getirdiğim endişeler gerçeğe dönüştüğüne göre Majestelerinin ne düşündüğünü öğrenmeyi çok isterim. Ama öylece durup onun bir karar vermesini bekleyemeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280368
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 60280368,
					"content": "Ve her halükarda bizi arkadaşı olarak gören kişi Fatui Habercisi \"Küçük Hanım\" değil, Columbina Hyposelenia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280369
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 60280369,
					"content": "Eğer böylesine ekstrem koşullarda bile Majesteleri, Habercilerin birbirlerine silah çekme yasağını kaldırmayacaksa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280370
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 60280370,
					"content": "O zaman kalbimin sesini dinleyeceğim ve Peruere olarak savaşacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280371
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 60280371,
					"content": "Arlecchino...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280372
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280372,
					"content": "Vaktimiz dar, o yüzden ilk hamleyi ben yapacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280373
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 60280373,
					"content": "Arlecchino bile soğukkanlılığını kaybediyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280374
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280374,
					"content": "(Eminim o da bu olanlardan kendini kısmen sorumlu hissediyordur... Ben de öyle...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280375
					]
				},
				{
					"id": 60280375,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280376
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280376,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280377
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280377,
					"content": "Tamam, tamam, tamam. Şu üzgün bakışlarınızı iki dakikalığına kenara bırakın da bir dinleyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280378
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280378,
					"content": "Durum kötü görünüyor, yalan yok. Hatta çok kötü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280379
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280379,
					"content": "Dottore kirli numaralarla üstünlüğü ele geçirmiş olabilir. Şimdilik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280380
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280380,
					"content": "Durum öyle bir noktaya geldi ki büyücüler bile onun \"değişkenlerinin\" kaderi etkilediğini söylüyor. Ama ben o kadar da emin değilim bundan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280381
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280381,
					"content": "Bana Teyvat'ın kaderinin sabit olduğu çok söylendi ve gerçekten de öyle görünüyor. Peki, Dottore'yi kendisinin bir istisna olacağından bu kadar emin kılan ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280382
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280382,
					"content": "O bu \"değişkenleri\" üst üste dizebildiğine göre, bizim de aynısını yapamayacağımız ne malum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280383
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280383,
					"content": "Hele sen hiç cesaretini kırmamalısın, uzaklardan gelen gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280384
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280384,
					"content": "Bu iş henüz bitmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280385,
						60280386
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280385,
					"content": "Evet...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280387
					]
				},
				{
					"id": 60280387,
					"content": "Bu konuda yalnız değilsin. Buradaki herkes, şu ana kadar konuşmuş olsun ya da olmasın, aynı durumda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280388
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280388,
					"content": "Ama hiçbirimiz öylece oturup güneşin yeniden doğmasını bekleyecek tipler değiliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280389
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280389,
					"content": "Bir şövalyenin yapması gereken de tam olarak budur. Seni yere serseler bile yeniden ayağa kalkar ve mücadeleye devam edersin. Unutma Fahri Şövalye, sen de Mondstadt'ın gerçek bir üyesisin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280390
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280390,
					"content": "Hım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280391
					]
				},
				{
					"id": 60280391,
					"content": "Varka haklı! Bu iş daha bitmedi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280392
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280392,
					"content": "Dottore geçmişteki maskaralıkları yüzünden çoktan bir dayağı hak etmişti. Şimdikilerden sonra ise iki katını hak etti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280393
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280393,
					"content": "Hah, şöyle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280394
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280394,
					"content": "Diğer herkes nasıl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280395
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280395,
					"content": "Columbina'nın nerede olduğunu araştırmak için Kuuvahkiyi kullanacağım. Ben de pes etmeye hazır değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280396
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60280396,
					"content": "İstihbarat toplama işini bana bırakın. Nod-Krai sınırları içinde ne olursa olsun, Sırlar Arşivi bir şeyi öğrenmek istediğinde daima bir yolunu buluruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280397
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60280397,
					"content": "Aino ve ben de size destek olmak için elimizden geleni yapacağız. Dottore'nin eylemlerine tersine mühendislik uygulayıp bu şekilde bir atılım yapmaya çalışacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280398
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60280398,
					"content": "Alice ve Nicole şu anda Teyvat'ın sınırlarındaki bir acil durumla meşguller, bu yüzden henüz geri dönemezler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280399
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280399,
					"content": "Ama ikisi de bu duruma çok öfkeli. Albedo'dan ve benden Cadılar Meclisi adına hareket etmemizi ve Dottore'ye karşı koymak için elimizden gelen her şeyi yapmamızı istediler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280401
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280401,
					"content": "O zaman hazır mısın? İlk aşamalarda bile bir sürü araştırma yapmamız gerekecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280402
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 60280402,
					"content": "Elimden geleni yapacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280403
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 60280403,
					"content": "Bana gelince, Dottore'nin tarzını iyi bilirim, bu yüzden bir sonraki hamlesini tahmin etmeye çalışabilirim. Araştırmanıza yardım edeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280404
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 60280404,
					"content": "Harika. Görünüşe göre temel iş bölümümüzü yaptık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280405
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280405,
					"content": "Flins ve Illuga ile temasa geçip Starşinalarıyla konuşmalarını sağlayacağım. Işık Muhafızlarını da bu işe dahil etmekten zarar gelmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280406
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280406,
					"content": "Aynı zamanda Nod-Krai'daki Şövalyelere talimat verip, burada yaşayanların güvenliğini sağlama konusunda Işık Muhafızlarına ve diğer kuruluşlara yardım etmelerini isteyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280407,
						60280408
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280407,
					"content": "Anlaşıldı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280409
					]
				},
				{
					"id": 60280409,
					"content": "Evet! Ona gününü göstereceğiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280410,
					"content": "O halde hepsi bu kadar. Herkese bol şans.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				},
				{
					"id": 60280408,
					"content": "Her duruma hazırlıklı olmalıyız.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280409
					]
				},
				{
					"id": 60280386,
					"content": "Yine de... Kendimi suçlamadan edemiyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280387
					]
				},
				{
					"id": 60280334,
					"content": "... Planını yürürlüğe koymak için doğru zamanı bekledi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280335
					]
				},
				{
					"id": 60280323,
					"content": "...\"Ayın yansıması\"nın içine kaçtı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280324
					]
				},
				{
					"id": 60280305,
					"content": "Ama az önce olanlar hakkında konuşmayı tercih ederim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280306
					]
				}
			]
		},
