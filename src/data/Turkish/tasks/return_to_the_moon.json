			"dialogs": [
				{
					"id": 60280201,
					"content": "Burası... Burası Hyperborea halkının aylarla iletişim kurduğu yer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280202
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60280202,
					"content": "Ebedi Ay, Donuk Ay, Hareli Ay... Üçünün de gücü birleştiğinde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280203
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60280203,
					"content": "Aylara giden kapı açılacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280204
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60280204,
					"content": "Hıhım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280205
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60280205,
					"content": "Ay İliği hazırlıkları tamamlandı. Geriye sadece son adım kaldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280206
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 60280206,
					"content": "... Eminim Nasha Kasabası şu anda her zamankinden daha hareketlidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280207
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60280207,
					"content": "Evet... Orada olamaman çok yazık. Ama ya şimdi ya hiç, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60280208,
					"content": "Sorun değil. Ben bu durumdan fazlasıyla memnunum... Son eşyam, tek parça eşyam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280209
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60280209,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280210
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60280210,
					"content": "Ayın beni çağırdığını şimdiden hissedebiliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280211
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60280211,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280212
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60280212,
					"content": "Evin bu ışığın öbür tarafında Columbina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280213
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 60280213,
					"content": "Bundan sonra nihayet gerçek aya dua etmek için bir sebebimiz olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280214
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60280214,
					"content": "Columbina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280215
					]
				},
				{
					"id": 60280215,
					"content": "Buyur. Dinliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280216
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60280216,
					"content": "Fırsatın olduğunda bizi görmeye yine gel, tamam mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280217
					]
				},
				{
					"id": 60280217,
					"content": "Ha... Tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280218
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60280218,
					"content": "Ama o fırsat gelmezse... Bu gezegende \"Columbina\"yı özleyecek dostlarının olduğunu unutma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60280219
					]
				},
				{
					"id": 60280219,
					"content": "Unutmayacağım. Benim için yaptığınız her şey için teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280220
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60280220,
					"content": "Ve unutmayın... İster gündüz ister gece vakti, ay ışığı her zaman bir araya getirecek bizi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60280221
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60280221,
					"content": "O zaman... Elveda dostlarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Küçük Hanım"
				}
			]
		},
