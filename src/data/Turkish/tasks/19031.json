			"dialogs": [
				{
					"id": 1903102101,
					"content": "Burada yalnız başına yürümek tehlikeli değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102102
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102102,
					"content": "Kiminle ya da neyle karşılaşacağına dair hiçbir fikrin yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102103,
						1903102104
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102103,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102105
					]
				},
				{
					"id": 1903102105,
					"content": "Hım, oldukça sakin görünüyorsun. Derler ki, \"Ekmek yemek istiyorsan, ellerin hamura bulaşmalıdır.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102106
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102106,
					"content": "Böyle garip ve ürkütücü bir yerde illaki bir şeye rastlayacaksın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102107
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102107,
					"content": "Ve burada karşılaşacağın şey, hayatının sonuna kadar peşini bırakmayacak bir kabusa dönüşebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102108,
						1903102109
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102108,
					"content": "Yaa, gerçekten mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102110
					]
				},
				{
					"id": 1903102110,
					"content": "Peki nasıl bu kadar sakinsin? İnsanlar genelde ben daha cümlemi bitiremeden dehşet içinde kaçarlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102111,
						1903102114
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102111,
					"content": "Çünkü sen bana çok sıradan bir insan gibi geliyorsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102112
					]
				},
				{
					"id": 1903102112,
					"content": "Evet... Ama bir hayaleti oynamaktan daha akıllıca olanı, insanların psikolojik duygularını kullanarak onlar için ürkütücü bir atmosfer yaratmaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102113
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102113,
					"content": "Bu durumda, görünüşüm önemsiz bir hal alıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102117
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102117,
					"content": "*iç çeker* Bir de, senin gibi hayaletlere inanmayan birini nasıl korkutabilirim ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102118
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102118,
					"content": "Bana boş yapıyorsun gibi geliyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102119
					]
				},
				{
					"id": 1903102119,
					"content": "Hey, bu doğru değil! Gideyim de korkutacak birkaç pısırık bulayım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102120
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102120,
					"content": "Geri dönüp ortağını bulmalısın. Şimdiye kadar çoktan dehşete kapılmış bir halde olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102114,
					"content": "Kostümün falan yok mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102115
					]
				},
				{
					"id": 1903102115,
					"content": "Bir tane var ama çok sıcak olduğu için giyemiyorum... Ve ayrıca, bir hayaleti oynamaktan daha akıllıca olanı, insanların psikolojik duygularını kullanarak onlar için ürkütücü bir atmosfer yaratmaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102116
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102116,
					"content": "Bu durumda, görünüşüm önemsiz bir hal alıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102117
					],
					"speakerTitle": "Fu San'er"
				},
				{
					"id": 1903102109,
					"content": "Harbiden anlamıyorum... Sen burada ne yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102110
					]
				},
				{
					"id": 1903102104,
					"content": "Merhaba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102105
					]
				}
			]
		}
	]
