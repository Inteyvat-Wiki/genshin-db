			},
			"dialogs": [
				{
					"id": 735160101,
					"content": "Gördün mü Shriya? Solucanezen Topumuz resmen çığır açtı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160102
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735160102,
					"content": "Umarım tez savunmamızı dinleyen tüm danışmanlar gelip bir bakar ve antika olmuş görüşlerini geliştirirler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160103
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735160103,
					"content": "Gerçekten hiçbir sorun çıkmadı... Sonunun Deney Cihazı 3 gibi olacağını düşünmüştüm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160104
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735160104,
					"content": "Öhöm... Ancak başarısızlıklarımız sayesinde başarıya ulaşırız. Ben de artık eskisi gibi değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160105
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735160105,
					"content": "O sene kaç tane kaza yaşamıştınız? Her neyse, bu deney başarılı oldu ve önemli olan da bu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735160106,
					"content": "Evet, hazır her şey yolunda gidiyorken başka bir yerde tekrar deneyelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160107
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735160107,
					"content": "Görgü tanıklarının bildirdiği kadarıyla bu bölgede onlarca Solucan varmış!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160108
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735160108,
					"content": "Ne... Onlarca mı? Hepsini tek tek öldürmeyeceksin değil mi? Bu cidden çok fazla zaman alır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735160109,
					"content": "Ha? Sorun ne? Solucanezen Topunun durumundan endişe ediyorsan hiç gerek yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160110
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735160110,
					"content": "Dur bir dakika! Bu işlemi tekrar tekrar yapmak çok zaman alacaktır. Makina bozulmasa bile bize bir şeyler olacağı kesin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735160111,
					"content": "Vinayak, herkes senin gibi makina yağı kokusuyla hayata tutunmuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160112
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735160112,
					"content": "Öyle mi? Bir dahaki sefere beyninin performansını da göz önünde bulundurmak gerekiyor anlaşılan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160113
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735160113,
					"content": "Her neyse. Bugünlük bu kadar yeter. Elde edilen veriler ve savaştan sonra toplanan örneklerle bu bulmacayı çözmeye bir adım daha yaklaştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160114
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735160114,
					"content": "Bulmaca mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735160115
					]
				},
				{
					"id": 735160115,
					"content": "Solucanların neden saldırganlaştığını ve anormal çevresel koşulların neden kaynaklandığını çözdüğümüz takdirde, bu sorunun da temeline inebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160116
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735160116,
					"content": "Lütfen bazı araştırmaları tamamlamam için bana bir gün daha verin. Yarın bu saatlerde sonuçları almış oluruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shriya"
				}
			]
		}
	]
}