			"dialogs": [
				{
					"id": 750420101,
					"content": "Merhaba. Görüşmeyeli nasılsınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420102
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750420102,
					"content": "Bana sormak istediğin bir şey mi vardı yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420103,
						750420108,
						750420115
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750420103,
					"content": "Alevlerin Efendisi'nin Lütfu hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750420104
					]
				},
				{
					"id": 750420104,
					"content": "Alevlerin Efendisi'nin Lütfu... Çoğu kişi bunun atalardan kalma bir şey olduğunu düşünüyor çünkü herkes bu gücün çok daha derin ve kadim bir kaynaktan geldiğine inanmış durumda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420105
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750420105,
					"content": "Sürüngen Kalıntıları Derneğinin kayıtlarına göre, üzerinde bu işaretten olan yavru Sürüngenler büyüdükçe kendi bedenlerinde oluşan kontrol edilemeyen güçler tarafından harap ediliyormuş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420106
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750420106,
					"content": "Bu güç bedenlerini yırtıp parçalayarak onları normal bir Sürüngenden çok daha farklı bir hale getiriyormuş... Ve onları çılgına çevirip akıllarını yitirmelerine neden oluyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420107
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750420107,
					"content": "Buna en iyi örnek ise Gukuzor tiran Holawaqa'dır... Bir zamanlar Alevlerin Efendisi'nin Lütfunun ona bahşedildiği söyleniyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750420108,
					"content": "Kabiledekiler o meseleyi nasıl \"hallederdi\" peki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750420109
					]
				},
				{
					"id": 750420109,
					"content": "Onu Gece Krallığı'na geri gönderirlerdi çünkü her ne kadar hayattayken belki ejderhaların veya Gece Krallığı'nın kabulünü göremeyecek olsa da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420110
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750420110,
					"content": "... Bu dünyadan ayrıldığında hiç şüphesiz gecenin karanlığına tekrar dönecek. Çok duygusuzca gelse de orada diğer tüm varlıkların ruhlarıyla bir araya gelecek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420111
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750420111,
					"content": "Haddimi aşıyorsam bağışla ama belki bu da bir çeşit iyilik olarak görülebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420112
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750420112,
					"content": "Nişanla ilgili herhangi bir ipucu var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750420113
					]
				},
				{
					"id": 750420113,
					"content": "Biraz var ancak... Teyit edebilmem için birilerine ulaşmam gerek. Daha sonra belki beni Yankıların Çocuklarının şefi Pacal'ın orada bulabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750420114
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750420114,
					"content": "Her ne kadar biraz... Abartılı biri gibi dursa da tüm samimiyetimle söylüyorum en katı kristallerden bile çok daha güvenilirdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750420115,
					"content": "Başka sorum kalmadı, görüşürüz!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750420116
					]
				},
				{
					"id": 750420116,
					"content": "Daima bekleriz dostum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manqu"
				}
			]
		}
	]
