			"dialogs": [
				{
					"id": 401360101,
					"content": "Biraz daha zaman geçer...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						401360102
					]
				},
				{
					"id": 401360103,
					"content": "Xavier! Ne zamandır görüşemedik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360104,
					"content": "Merhaba. Kusura bakmayın, yanınıza çok uğrayamadım. Yapım sonrası işler de bittiğinden beri tanıtım ve filmi vizyona hazırlama işleriyle boğuşuyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360105
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360105,
					"content": "Ödül töreni bugün, değil mi? Bakalım Furina Ödülünü kazanabilecek miyiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360106,
					"content": "Yüzde doksan biz kazanacağız bence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360107
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360107,
					"content": "Furina! Paimon burada olduğunu bilmiyordu. Herkesten önce gelmişsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360108,
					"content": "Diğerleri de birazdan burada olur herhalde. Hım... Xavier, ödül için sahneye çıkacak olursak ekibimiz için bir isim bulman gerekmez mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360109
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360109,
					"content": "Hı? Ama daha kazanıp kazanamayacağımız bile belli değil. Erkenden kutlayıp da uğur kaçırmak istemem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360110
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360110,
					"content": "Etrafına bir bak! İzleyicilerin tepkilerini görmedin mi? Herkes çok beğendi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360111
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360111,
					"content": "Ayrıca opera salonu çalışanlarıyla da görüştün, değil mi? Gösterim sayısını artıralım demediler mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360112
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360112,
					"content": "Bilet satışından kazandığın Morayla kendi film şirketini açabilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360113
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360113,
					"content": "A-Ama hepsi bu harika ekip sayesinde oldu. Sizin yardımlarınızla çekebildik bu filmi, o yüzden isim bulma işini de tek başıma yapamam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360114
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360114,
					"content": "Sen en iyisi bir düşün. Eminim ekipteki herkes tercihine saygı duyacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360115
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401360115,
					"content": "#Pekala... Ama öncesinde {NICKNAME}, Paimon, zahmet olmazsa ikiniz hızlıca bir Meropide Kalesi'ne gidebilir misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360116
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360116,
					"content": "Ne? Ama ödül töreni ne olacak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360117,
					"content": "Chevreuse'ü de törene davet etmenizi isteyecektim. Sonuçta başrollerimizden biri o.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360118
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360118,
					"content": "Son zamanlarda onu hiç görmedim, o yüzden bizzat davet etme şansım olmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360119
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360119,
					"content": "Gazetedeki habere göre silahlı cinayet davasının sanıkları bugün bizzat Özel Devriye Yüzbaşısı tarafından Meropide Kalesi'ne götürülecekmiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360120
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 401360120,
					"content": "Haa, Paimon şimdi anladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360121,
					"content": "Hemen hallederiz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401360122
					]
				},
				{
					"id": 401360122,
					"content": "Evet! Sen burada bekle Xavier, o sırada birkaç güzel isim düşün hatta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360123,
					"content": "Tamam o zaman, ben sizi tutmayayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
