			"dialogs": [
				{
					"id": 401360201,
					"content": "Benden bu kadar, bu üçü artık sana emanet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360202
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360202,
					"content": "Başka bir işin mi var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360203
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401360203,
					"content": "Sayılır. Bir partiye davetliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360204
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360204,
					"content": "Senden böyle şeyler duymaya alışkın değilim. Yeni bir eğlence mi buldun kendine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360205
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401360205,
					"content": "Yok, sadece bugüne özel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360206
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360206,
					"content": "Chevreuse, Wriothesley!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360207,
					"content": "Festivaller insanları bir araya getiriyor gerçekten. Meropide Kalesi'nde bu kadar ziyaretçi görmeyeli uzun zaman olmuştu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360208
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401360208,
					"content": "Festival ruhu böyle bir şey olsa gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360209
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360209,
					"content": "Evet, öyle. Başhemşiremiz de festivale özel inanılmaz besleyici içecekler hazırladı... Bir yudum aldın mı tüm besin ihtiyacını karşılamış oluyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360210
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401360210,
					"content": "İşten mi bahsediyordunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360211,
					"content": "Tam bitirmiştik. Peki şu \"uyarımla\" ilgili ne düşünüyorsun Bay Wriothesley?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360212
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360212,
					"content": "Hım. Henüz herhangi bir söz vermedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360213
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401360213,
					"content": "Ama reddetmedin de.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360214
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360214,
					"content": "Aklıma bir fikir geldi. Bir gün herkese o günün gazetesini dağıtırsın. Tesadüfe bak ki o gün de gazetenin manşetinde birinin 20 yıl önce işlediği suçlara yer verilmiş olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360215
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360215,
					"content": "Hımm. O zaman birileri Meropide Kalesi'ndeki en şanssız kişi olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360216
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401360216,
					"content": "Diğer ikisi de artık kahraman olarak anılır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360217
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360217,
					"content": "Kahraman demişken, benden bir şey mi isteyecektiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360218
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401360218,
					"content": "Şey, biz aslında...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360219,
					"content": "Beni partiye davet etmek için geldiniz, değil mi? Merak etmeyin, unutmadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360220
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 401360220,
					"content": "Aa, o zaman hadi hemen gidelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360221,
					"content": "Görüşürüz Wriothesley! Fontinalia Festivalin kutlu olsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401360222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401360222,
					"content": "Sizin de.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wriothesley"
				}
			]
		},
