			"dialogs": [
				{
					"id": 150470101,
					"content": "Gelmişsiniz! Görevliler bir süreliğine gitmiş galiba ama nasıl tur atabileceğimizi çözdüm... Öhöm, test amaçlı tabii ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470102
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470102,
					"content": "E süper, o zaman bize de göster!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470103,
					"content": "Şimdi şöyle, bir kişi tekneye biniyor, birisi de Sürüngen görevlilere sinyal gönderiyor. Amacımız takım olarak çalışıp tekneyi güvenli bir şekilde hedefe götürmek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470104
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470104,
					"content": "#Başarabileceğimize güvenim tam, {NICKNAME} ile takım çalışmasında uzmanız ne de olsa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470105
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470105,
					"content": "Öyle mi? Kendine çok güveneyim deme, bakarsın alabora olursun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470106,
					"content": "Ayy, felaket tellallığı yapmasana Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470107
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470107,
					"content": "Tamam, tamam... O zaman Paimon size iyi yolculuklar diliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470108,
					"content": "Hehe, iyi geçeceği kesin zaten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470109
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470109,
					"content": "Hem zaten tekneye binesim var. Sürekli zorlu sörf mücadelelerine katılıyorum, biraz değişiklik iyi gelir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470110,
						150470111
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470110,
					"content": "Ben de Dalgakırandan sıkıldım biraz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470112
					]
				},
				{
					"id": 150470112,
					"content": "Baksana, şimdiden mükemmel uyum yakaladık! Aramızdaki bağın gücünü kanıtlıyor bu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470113
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470113,
					"content": "Can simidimi şişirip tekneye binmek için sabırsızlanıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470111,
					"content": "Sinyalleri ben hallederim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470112
					]
				}
			]
		},
