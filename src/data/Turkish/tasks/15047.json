					"nextDialogs": [
						150470504
					]
				},
				{
					"id": 150470504,
					"content": "#Aa, selam! Oyy, ne tatlı şeysin sen! Bir dakika, {NICKNAME} nereye gitti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470505
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150470505,
					"content": "Şey... Karnı ağrıdığı için tuvalete koşması gerekti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150470506,
					"content": "(Şaka mısın Paimon, böyle bahane mi olur? Neyse, Mualani ikna olduğu sürece sorun yok...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470507
					]
				},
				{
					"id": 150470507,
					"content": "!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470508
					]
				},
				{
					"id": 150470508,
					"content": "Ay, ne kadar da dost canlısıymışsın sen! Parlak Boynuz Mantarı ister misin? Al bakalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
