			"dialogs": [
				{
					"id": 735200101,
					"content": "Benden bilgi satın almaya mı karar verdiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200102
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200102,
					"content": "Hımmm... Paimon, sendeki o seçkin bilgileri çok merak ediyor ama önce fiyatını duymamız gerek! Çok pahalıysa unut gitsin zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200103,
					"content": "Size sabit fiyat, bir milyon Moradan olur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200104
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200104,
					"content": "Çok fazla! Boş ver, bir milyon Morayla bir sürü leziz yemek alınır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200105,
					"content": "Bir saniye... Bakayım... Hı? Paimon bugünkü bin birinci müşterimizmiş. Önceki fiyatı bir milyon Moraydı ama şimdi sana bedava!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200106
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200106,
					"content": "Hı? Paimon'un böyle bir fırsattan haberi bile yoktu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200107,
					"content": "Bir dakika, daha çok Mora harcamamız için bizi kandırmıyorsun, değil mi? Hani belki ilk cümle bedavadır ama sonraki cümleler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200108,
					"content": "İstemiyorsan sorun yok! Sıradaki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200109
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200109,
					"content": "Dur dur dur. Paimon'un söylediklerini unut, seni dinliyoruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200110,
					"content": "Dori'nin özel haberlerinden ilki! Bilgelik Tacını hatırlıyor musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200111
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200111,
					"content": "Paimon, sadece şampiyonun takabildiği bir taç olduğunu hatırlıyor. Çok değerli bir şeye benziyordu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200112,
					"content": "Kesinlikle. Sachin'in Akademiye verdiği taç çok pahalı bir antikaydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200113
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200113,
					"content": "Fakat bu taç Akademiye bağışlandıktan sonra Akademi, bir keresinde bu tacı kaybetti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200114
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200114,
					"content": "Hı? Biz bunu neden duymadık?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200115,
					"content": "Hehe... Bunu herkes bilseydi benim bu haberim \"özel\" sayılır mıydı hiç?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200116
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200116,
					"content": "Bu haber yok yerden çıkmadı tabii, şahitlerim de var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200117
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200117,
					"content": "Şehrin dolaylarında Kashmer adında bir genç var. Bu haberin daha da derinine inmek isterseniz ona sorabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200118
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 735200118,
					"content": "Parola ise \"yirmi yıl önceki o olay!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dori"
				}
			]
		},
