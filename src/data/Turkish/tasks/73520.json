				"points": []
			},
			"dialogs": [
				{
					"id": 735200203,
					"content": "\"Yirmi Yıl Önceki O Olay\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735200204
					]
				},
				{
					"id": 735200204,
					"content": "... Sanırım kimseye söylememeliydim. Geçen sefer çok içmişim ve ağzımdan bir şeyler kaçırmışım. Şimdi herkes beni arıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200205
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200205,
					"content": "Madem merak ettiniz size de anlatayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200206
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200206,
					"content": "Yirmi yıl önce daha altı yaşında bir çocuktum. O zamanlar tam olarak ne olduğunu hatırlamıyorum ama bir süre önce çocukken yazdığım günlüğümü bulup okudum ve o zamanki durumu belli belirsiz hatırlayabildim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200207
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200207,
					"content": "O yıl da Darşanlar Şampiyonası düzenlenmişti. Üç tur vardı ve final turu şehrin dışındaydı. Beni oraya götürmesi için anneme yalvarmıştım, o reddedince ben de gizlice kaçmıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200208
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200208,
					"content": "Sonra ne oldu peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200209,
					"content": "Şehrin dışında kaybolmuştum. Hiç bilmediğim bir yerdeydim ve etrafta kimse yoktu. Gittikçe daha da korkmuş ve ağlamaya başlamıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200210
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200210,
					"content": "Tam da o anda tuhaf yaratıklar gördüm... Neye benzediklerini hatırlamıyorum, sadece çocuk olmama rağmen onlara bakınca hemen ağlamayı kestiğimi hatırlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200211
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200211,
					"content": "Tuhaf yaratıklar... Yoksa onlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200212,
					"content": "(Aranaralar.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735200213
					]
				},
				{
					"id": 735200213,
					"content": "Beni yarışmaya götürdüler ama ne yazık ki oraya vardığımızda yarışma çoktan sona ermişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200214
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200214,
					"content": "Tam moralim bozulmuşken o tuhaf yaratıklardan birinin bir tacı yavaşça sürüklediğini gördüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200215
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200215,
					"content": "Çok güzel bir taçtı ve ay ışığında parlıyordu. Dayanamayıp peşi sıra takip ettim, ufak yaratığın tacı bir ağaç kovuğuna koyduğunu gördüm. Sonrasında da gözden kayboldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200216
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200216,
					"content": "O taca dokunmak istedim ama o anda annemin uzaktan bağırışlarını duydum. Meğer benim kaybolduğumu fark etmiş ve komşuları da alıp beni aramaya koyulmuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200217
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200217,
					"content": "Taca hiç dokunamadım. Büyüyüp bir gün Darşanlar Şampiyonasında, \"Bilgelik Tacı\"nı gördüğümde ikisinin aynı taç olduğunu fark ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200218
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200218,
					"content": "Pekala... O taca daha sonra ne olduğunu hatırlıyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735200219,
					"content": "Muhtemelen Avidya Ormanı'ndadır. Ben birkaç kere gittim ama hiçbir şey bulamadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200220
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200220,
					"content": "Anlatsam bile kimse bana inanmaz. Zaten çok da net hatırlayamıyorum. Belki de çocukken gördüğüm bir rüyaydı sadece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735200221
					],
					"speakerTitle": "Kashmer"
				},
				{
					"id": 735200221,
					"content": "#Hım... Gidip bakalım mı {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
