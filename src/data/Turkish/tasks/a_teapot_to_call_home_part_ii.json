			"dialogs": [
				{
					"id": 716540201,
					"content": "Vay be... Bu çaydanlık Madam Ping'in çaydanlığından daha büyük sanki. Hatta ortada kocaman bir ev bile var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716540202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716540202,
					"content": "Gerçi çevresinde hiçbir şey yok ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716540203,
						716540205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716540203,
					"content": "Keskin bir şey bul Paimon. Bu kayayı yontarak bize bir ev yaparsın artık.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716540204
					]
				},
				{
					"id": 716540204,
					"content": "Paimon öyle bir şey yapamaz! Hem kılıcı olan sensin, sen yap!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716540207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716540207,
					"content": "Ama... Neden bu ev dışında hiçbir şey yok?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716540208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716540208,
					"content": "Bir dakika. O da ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716540205,
					"content": "Şimdilik bir çukur kazıp orada yaşa o zaman, ne dersin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716540206
					]
				},
				{
					"id": 716540206,
					"content": "Hey! Mis gibi ev var işte. Paimon neden çukurda yaşamak zorundaymış?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716540207
					],
					"speakerTitle": "Paimon"
				}
			]
