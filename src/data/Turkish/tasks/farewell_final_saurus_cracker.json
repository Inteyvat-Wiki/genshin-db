			"dialogs": [
				{
					"id": 750870501,
					"content": "Buraya gelmeyi başardığınıza göre artık \"iyi tüccar\" rolünü oynamayı bırakabilirim. Bu aptallarla uğraşmaktan gına gelmişti zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870502
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870502,
					"content": "Ne kötü biri çıktın sen ya! Yaptığın kötülükleri başkasının üstüne yıkarken utanmadın mı hiç? Senin yüzünden ortalıkta adımız çıktı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870503,
					"content": "Ben kötü biriyim. Kötü birinin de kötü şeyler yapması normal değil mi? Hem bak, o üç aptalın sizi yanlış anlaması yaptığım işte iyi olduğumun kanıtı işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870504
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870504,
					"content": "Haha, ayrıca şimdi daha da kötü bir şey yapacağım! Bu sefer elimden kurtulamayacaksınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870505
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870505,
					"content": "Yakala onları Tüylü!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870506
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870506,
					"content": "Guuuuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870507
					],
					"speakerTitle": "Tüylü"
				},
				{
					"id": 750870507,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870508
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870508,
					"content": "#Hadi gidelim {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870509
					]
				},
				{
					"id": 750870509,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}? Kendinden bu kadar büyük biriyle boy ölçüşecek misin cidden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870510,
					"content": "Guruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870511
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870511,
					"content": "Raarr! Raaaarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870512
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870512,
					"content": "Oberon biraz bitap düşmüş gibi. Taruka hakkında endişelendiği için mi, yoksa çok fazla Sürüngen Krakeri yediği için mi acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870513,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} onu neşelendirmek için mi cesurca öne atılıp bizi korumak istedi dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870514,
					"content": "Bu dünyada sadece cesaretin tek başına değiştiremeyeceği şeyler Sumeru'daki kum tanelerinden fazladır. Cesaret gibi soyut bir kavrama kıyasla mutlak kontrol, çok daha sağlam ve güvenilir bir olgu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870515
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870515,
					"content": "Saldır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870516
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870516,
					"content": "#Harika! {REALNAME[ID(2)|SHOWHOST(true)]} saldırıdan kurtuldu! Tepetlizorlar bu işte çok iyiler, göklerin hakimi bile onlara zarar veremez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870517,
						750870519,
						750870522,
						750870526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870517,
					"content": "Saldır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870518
					]
				},
				{
					"id": 750870518,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} saldırmaya hazır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870530
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870530,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870531
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870531,
					"content": "Hah, tam isabet! İyi ama... Neredeyse hiç zarar vermemiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870532
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870532,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870533
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870533,
					"content": "Olsun, isabet etmesi bile oldukça etkileyici! Of! Paimon şimdiden yoruldu... Daha bir tur mu oldu üstelik? Neler oluyor böyle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870534
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870534,
					"content": "Şimdi sıra bende, değil mi? Saldır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870535
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870535,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} düşmanın saldırısını atlatmak için hızla savunmaya geçiyor... Üstelik savunmayı başarıyla gerçekleştiriyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870536
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870536,
					"content": "Hop, Sürüngenin saldırdıktan hemen sonra savunma yaptı! Oyunbozanlık bu, kurallara saygı duyun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870537
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870537,
					"content": "Sıralı saldırıyor olmamız sıraya göre ilerleyeceğimiz anlamına gelmiyor!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870538
					]
				},
				{
					"id": 750870538,
					"content": "Şimdi ne yapacağız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870539
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870539,
					"content": "Raaaaaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870540
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870540,
					"content": "Aa! Oberon kendini toparlamaya başladı galiba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870541
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870541,
					"content": "Raarr! Raaaarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870542
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870542,
					"content": "Paimon ne dediklerini hiç anlamıyor ama... Bir anlaşmaya vardılar sanki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870543,
						750870545,
						750870547,
						750870550
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870543,
					"content": "Ortak Saldırı yap.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870544
					]
				},
				{
					"id": 750870544,
					"content": "İşte böyle! Hünerlerini sergile bakalım uçuş okulunun müstakbel yıldızı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870552
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870552,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870553
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870553,
					"content": "#Oberon düşmanın havadan kaçış yolunu kapattı ve {REALNAME[ID(2)|SHOWHOST(true)]} saldırıya geçti! Fevkalade bir ortak saldırı bu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870554
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870554,
					"content": "Tüylü çok hasar aldı! Ayağından da feci yaralanmış galiba... Ayak parmağını masanın köşesine vurduğunda hissettiğin acı kadar feci bir darbe miydi acaba? Neyse, her halükarda düşman sarsılmış vaziyette ve hareket edemiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870555,
						750870557,
						750870560,
						750870562
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870555,
					"content": "Saldırı zamanı geldi... Ama saldıran ben olacağım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870556
					]
				},
				{
					"id": 750870556,
					"content": "#Saldırabilirsin tabii ama yapma yahu, {REALNAME[ID(2)|SHOWHOST(true)]} nadiren böyle hünerlerini gösterme fırsatı buluyor zaten... Çocuk gibi davranıyorsun, bırak da eğlensin azıcık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870565
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870565,
					"content": "Kraaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870566
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870566,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870567
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870567,
					"content": "#Aa! {REALNAME[ID(2)|SHOWHOST(true)]} ile Oberon'un bir planı var galiba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870568
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870568,
					"content": "Sürüngen Krakerleri mi? Nereden çıktı ki bunlar şimdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870569
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870569,
					"content": "Kuu! Raaaaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870570
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870570,
					"content": "Bir saniye, kanatlarının altından mı çıkardın onları? Seni kurnaz Sürüngen seni... Taruka seninle nasıl baş ediyor böyle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870571
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870571,
					"content": "Guruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870572
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870572,
					"content": "Dur! Onun sırası mı şimdi? Hop, sana diyorum! Dursana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870573
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750870573,
					"content": "Aa, yok artık! Tüylü verilen emirleri dinlemedi ve Sürüngen Krakerlerine doğru koştu! 5 Can yenileme fırsatına karşı koyamamış olmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870574
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870574,
					"content": "Diğer Sürüngenin ona tuzak kurduğundan ise bihaber tabii!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870575
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870575,
					"content": "#Kısacası savaş bu şekilde, tarafların hamlelerini yapmasıyla devam eder.\\n{REALNAME[ID(2)|SHOWHOST(true)]} elbette kendini kanıtlamak istiyormuşçasına cesurca savaşır. Uçuş okulunda örnek öğrenci seçilebilecek biri olmasa da yoldaşlarına destek çıkabilmek için diğer yeteneklerini kullanır.\\nŞaşırtıcı olsa da Oberon'un kilo alması bile işleri kolaylaştırmış gibidir. Artık ortalama bir Gukuzordan daha büyük bir bedeni olduğu için hava sahasını kapatarak Tüylü'ye ağır bir darbe indirir...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750870576
					]
				},
				{
					"id": 750870576,
					"content": "Tüylü artık savaşmak istemeyince savaşta pek de becerikli olmadığı ifşa olan Quilla da oradan kaçar.\\n\"Oyunbozan pislikler sizi! Bir sonraki... Bir sonraki sefere o kadar kolay kazanamayacaksınız! Bekleyin de görün!\"\\nKendisi gibi utanmaz hainlerden beklenecek laflar eden Quilla, ardından yaralı Tüylü ile oradan kaçar.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750870577
					]
				},
				{
					"id": 750870577,
					"content": "Aa! Paimon ona Taruka'nın nerede olduğunu sormayı unuttu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870578
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870578,
					"content": "Guruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870579
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870579,
					"content": "Sen canını sıkma ama. Taruka zeki bir çocuk, başının çaresine bakar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870580
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870580,
					"content": "Raarr! Raaaarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870581
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870581,
					"content": "#Sence de öyle değil mi {REALNAME[ID(2)|SHOWHOST(true)]}? Hadi gel Oberon, önce uçuş okuluna dönelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870557,
					"content": "Düşmanı teslim olmaya ikna et.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870558
					]
				},
				{
					"id": 750870558,
					"content": "Sorunlar konuşarak çözülebilse dünyada bu kadar çatışma olmazdı zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870559
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870559,
					"content": "Öhöm... Şey, yani Paimon'a sorarsan bu yöntem muhtemelen işe yaramayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870565
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870560,
					"content": "Büyülü bir eşya kullanarak onu yakala.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870561
					]
				},
				{
					"id": 750870561,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870565
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870562,
					"content": "Hadi kaçalım artık!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870563
					]
				},
				{
					"id": 750870563,
					"content": "Vuuu... Ruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870564
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870564,
					"content": "#Hadi ama! Senin yüzünden {REALNAME[ID(2)|SHOWHOST(true)]} bile üzülmeye başladı, bak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870565
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870545,
					"content": "Savun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870546
					]
				},
				{
					"id": 750870546,
					"content": "Bekle, durum şu anda ikiye bir. Düşmanımız iki hedefe de aynı anda saldıramaz. Yani savunma yaparak sıramızı boşa harcamış olmuyor muyuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870552
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870547,
					"content": "Bir eşya kullan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870548
					]
				},
				{
					"id": 750870548,
					"content": "5 Can yenilemek için Sürüngen Krakeri ye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870549
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870549,
					"content": "... Gerek olduğundan değil gerçi ama olsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870552
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870550,
					"content": "Kaç.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870551
					]
				},
				{
					"id": 750870551,
					"content": "Ne güzel kazanıyoruz işte! Nereden çıktı şimdi kaçmak falan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870552
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870519,
					"content": "Savun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870520
					]
				},
				{
					"id": 750870520,
					"content": "Ruuu... Raaar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870521
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870521,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} çok fazla savunma yaparsa fırsatı kaçıracağını düşünüyor gibi. Saldırmaya hazırlanıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870530
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870522,
					"content": "Bir eşya kullan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870523
					]
				},
				{
					"id": 750870523,
					"content": "Şu anda kullanabileceğimiz bir eşya yok ki! Ayrıca o Canavar Tuzağını kurmak için biraz geç değil mi sence de?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870524,
					"content": "Ruuu... Raaar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870525
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870525,
					"content": "#Oo! {REALNAME[ID(2)|SHOWHOST(true)]} saldırmaya hazır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870530
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870526,
					"content": "Kaç.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870527
					]
				},
				{
					"id": 750870527,
					"content": "Kaçmanın sırası değil şimdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870528,
					"content": "Ruuu... Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870529
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870529,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} bile anladı! Bak, saldırmaya hazırlanıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870530
					],
					"speakerTitle": "Paimon"
				}
			]
		},
