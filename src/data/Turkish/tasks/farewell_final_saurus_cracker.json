			"dialogs": [
				{
					"id": 750876301,
					"content": "Pakpaka Uçuş Okuluna hoş geldin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750876302,
						750876303
					],
					"speakerTitle": "Cisik"
				},
				{
					"id": 750876302,
					"content": "Burada ne yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750876304
					]
				},
				{
					"id": 750876304,
					"content": "Öğrencilere gerekli yönlendirmeleri ve yardımı sağlıyoruz. İşler çok değişti bu arada. Eskiden öğrenciler böyle sevgi ve ilgi görmezdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750876305
					],
					"speakerTitle": "Cisik"
				},
				{
					"id": 750876305,
					"content": "Bir keresinde koç biraz... Fazla sert konuştu, karşısındaki öğrencinin de tepesi attı... *iç çeker* Anlatması pek eğlenceli bir olay değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750876306
					],
					"speakerTitle": "Cisik"
				},
				{
					"id": 750876306,
					"content": "Neyse, o zamandan beri eğitim politikamız kökten değişti. Sonuçta kimse gülümseyen bir surata tokat atmaz, kimse iltifat almaktan nefret etmez. Haksız mıyım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cisik"
				},
				{
					"id": 750876303,
					"content": "Ben gideyim o zaman.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750876307
					]
				},
				{
					"id": 750876307,
					"content": "Günün güzel geçsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cisik"
				}
			]
		}
	]
