			"dialogs": [
				{
					"id": 750870901,
					"content": "Sürüngen Krakerlerinin burada ne işi var? Peki ya bu mektup...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870902,
					"content": "Demek Paimon'un düşündüğü gibi bu planın arkasındaki Quilla imiş! Gerçi nedense... Ah, Paran cidden çok şanssız biriymiş ya, orası kesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870903,
					"content": "Taruka ve Oberon'un önümüzdeki kampta esir olduğunu düşünmek Paimon'u çok üzüyor... Elimizden de bir şey gelmiyor üstelik. Onların ne suçu vardı da başlarına bu geldi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870904,
					"content": "#Hımm... Hadi onları kurtarmanın bir yolunu bulalım {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870905,
					"content": "<color=#00E1FFFF>Iktomizor devriye ekibinin arasında</color> saklanabilirsek içeri kolaylıkla girebiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
