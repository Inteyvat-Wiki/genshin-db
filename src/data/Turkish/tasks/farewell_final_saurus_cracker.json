			"dialogs": [
				{
					"id": 750870701,
					"content": "Aa! Taruka! Dönmüşsün!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870702,
					"content": "#{NICKNAME} {M#Abi}{F#Abla}! İyi olmana çok sevindim... Ablama ve diğer herkese olanları anlattım. Lamizana tam da düşündüğüm gibi bir ahmak çıktı, görüyorsunuz işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870703
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750870703,
					"content": "Guruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870704
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870704,
					"content": "Evet, senden bile ahmakmış, kuş beyinli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870705
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750870705,
					"content": "Guruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870706
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870706,
					"content": "#Galiba senden bu kadar uzun süre ayrı kalınca huysuzlandı. Bu arada az önce {REALNAME[ID(2)|SHOWHOST(true)]} ile birlikte öyle iyi dövüştüler ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870707,
					"content": "Yine de hâlâ geliştirebileceği yönleri var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870708
					]
				},
				{
					"id": 750870708,
					"content": "Aman ya, minik bir Sürüngenden bahsediyoruz burada! Paimon onun büyüyüp harika bir Gukuzor olacağından emin, sen yeter ki ona iyi bak Taruka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870709,
					"content": "Kraaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870710
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750870710,
					"content": "Hazır konusu açılmışken, buraya nasıl döndün sen? Biri mi bulup kurtardı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870711,
					"content": "Kendim kaçtım. Oberon'u da yanımda götürmek istemiştim ama Sürüngen Krakerlerini yiyip tıkınmakla meşguldü. Ne yaparsam yapayım kaldıramadım yerinden. Ben de sinirlenip tek başıma çektim gittim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870712
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750870712,
					"content": "Hadi ya! O kadar kolay mı oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870713,
					"content": "Sürüngen muhafızların hareket düzenini çözdükten sonra kaçmak için kullanabileceğim bir açıklık olduğunu fark ettim. Sonrası çorap söküğü gibi geldi zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870714
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750870714,
					"content": "Paimon ne yalan söylesin, buradaki en güvenilir kişi sensin galiba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870715,
					"content": "Niye bu kadar uzun sürdü? Ben de o yalancıya haddini bildirmek üzereydim tam... Ş-Şey, sizden de özür dileyecektim tabii ki... Ortada fol yok yumurta yokken kendi kendime masum insanları suçladım bir de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870716,
						750870718
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750870716,
					"content": "Özür dilemek için artık çok geç.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870717
					]
				},
				{
					"id": 750870717,
					"content": "Aynen öyle! Her şey bittikten sonra ortaya çıktın, şimdi de utanmadan yapmadığın şeyler için övgü toplamaya çalışıyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870720,
					"content": "Ne söylesem boş... Anlaştığımız ücreti ya da her ne istiyorsanız onu size ödeyeceğim. Cimrilik yapmaya yüzüm yok zaten. Daha iyi hissedeceksen bana yumruk bile atabilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870721
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750870721,
					"content": "Koskoca adamım, sorumluluklarımdan kaçacak değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870722,
						750870724
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750870722,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} sana yumruğu geçirsin o zaman bir kez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870723
					]
				},
				{
					"id": 750870723,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870726
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870726,
					"content": "Ay! Aman, aman! Henüz tekmelemedi ama şimdiden canım yandı bile bak! Lütfen bana acı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870727
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750870727,
					"content": "\"Koskoca adamım, sorumluluklarımdan kaçacak değilim,\" falan diyordun bir de az önce... Yazık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870728,
					"content": "#Neyse, boş ver. Büyüklük bizde kalsın, değil mi ama {NICKNAME}, {REALNAME[ID(2)|SHOWHOST(true)]}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870729,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870730
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870730,
					"content": "Beni affettiğiniz için sağ olun o zaman. Uçuş okulunun kapısı size her daim açık olacak... Şey, okulun kapısı yok aslında ama siz anladınız ne demek istediğimi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870731
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750870731,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} ile öyle yakın duruyorsunuz ki. Minik Sürüngenlerle anlaşmanın sırrını anlatmanızı istiyordum ben de!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870732
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750870732,
					"content": "Hehe, tamam. Fırsatımız olursa tekrar geliriz buraya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750870724,
					"content": "#Onun yerine {REALNAME[ID(2)|SHOWHOST(true)]} senin ayak parmaklarını tekmelesin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870725
					]
				},
				{
					"id": 750870725,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870726
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750870718,
					"content": "Bize çektirdiklerinizin telafisi olacaktır umarım! Katılım ödülümü de verin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750870719
					]
				},
				{
					"id": 750870719,
					"content": "Katılım ödülünü unutmadın demek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750870720
					],
					"speakerTitle": "Paimon"
				}
			]
		},
