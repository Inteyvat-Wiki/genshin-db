			"dialogs": [
				{
					"id": 201040201,
					"content": "Nasıl geçti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040202
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040202,
					"content": "Hepsinden kurtuldun mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040203
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040203,
					"content": "Sonuncusuna kadar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040204
					]
				},
				{
					"id": 201040204,
					"content": "Vay canına, harikasın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040205
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040205,
					"content": "Gezgin, sen dünyadaki en iyi insansın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040206
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040206,
					"content": "Teşekkürler! Artık Adelinde bize kızmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040207
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040207,
					"content": "Lütfen teşekkür hediyemiz olarak kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040208
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040208,
					"content": "Doğru, şimdi temizlememiz gereken başka yerler var. Tekrar teşekkürler! Görüşürüz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moco"
				}
			]
		},
