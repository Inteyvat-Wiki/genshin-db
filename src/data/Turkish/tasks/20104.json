			"dialogs": [
				{
					"id": 201040301,
					"content": "Bunu neden yaptın? Kuru ot yığınını yaktın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040302
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040302,
					"content": "Sağ ol ya... Şimdi Adelinde kesin kafayı yiyecek, kesin bizi kovacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040303
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040303,
					"content": "Kazara oldu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040304
					]
				},
				{
					"id": 201040304,
					"content": "Ah, teker teker toplamaya devam etmeliydik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040305
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040305,
					"content": "Lanet olsun... Bundan dönüş yok artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040306
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040306,
					"content": "Ben, şey...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040307
					]
				},
				{
					"id": 201040307,
					"content": "Gezgin, buradan gitsen iyi olur. Bu bizim sorumluluğumuzdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040308
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040308,
					"content": "Temizlik konusunda hiçbir şey bilmeyen birinden yardım istemek bizim hatamız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040309
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040309,
					"content": "Adelinde öğrendiğinde ne yapacak kim bilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040310
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040310,
					"content": "Çok sinirlenecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hillie"
				}
			]
