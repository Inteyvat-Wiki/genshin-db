			"dialogs": [
				{
					"id": 201040101,
					"content": "Ne yapacağız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040102
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040102,
					"content": "Adelinde kesinlikle kafayı yiyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040103
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040103,
					"content": "Ne oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040104
					]
				},
				{
					"id": 201040104,
					"content": "Şey... Adelinde, Şaraphanenin etrafını temizlememizi söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040105
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040105,
					"content": "Çoğu yerde sorun yoktu ama buraya bir sürü ot yığılmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040106
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040106,
					"content": "Connor, ihtiyacı olduğu için bunları burada sakladığını söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040107
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040107,
					"content": "Sıkıca bağlanmışlar, en azından rüzgarda sağa sola uçmuyorlar ama kuru otla beraber bir sürü yaprak savrulmuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040108
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040108,
					"content": "Her karışı temizlemekle uğraştık ama hâlâ yaprakları temizlemeyi bitiremedik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040109
					],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040109,
					"content": "Böyle gidersek baş hizmetçi Adelinde kafayı yiyecek. Ne yapacağız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040110,
						201040112
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040110,
					"content": "Bana bırakın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040111
					]
				},
				{
					"id": 201040111,
					"content": "Ciddi misin? Harikasın! Teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moco"
				},
				{
					"id": 201040112,
					"content": "Yapraklardan kurtulmak zor mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201040113
					]
				},
				{
					"id": 201040113,
					"content": "Kuru otla karıştığı zaman zor oluyor. Hepsini bir bir toplamamız gerekiyor, bu da sonsuza kadar sürer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201040114
					],
					"speakerTitle": "Hillie"
				},
				{
					"id": 201040114,
					"content": "Daha iyi bir fikrin varsa dinliyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hillie"
				}
			]
		},
