			"dialogs": [
				{
					"id": 130100610,
					"content": "Bir şey bulabildiniz mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100611
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100611,
					"content": "Hayır, bulamadık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100612,
					"content": "Sadece sıradan görünen Bilgi Kapsülleri var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100613
					]
				},
				{
					"id": 130100613,
					"content": "Muhtemelen Keder Bahçesi hakkında bilgi içeren çok fazla Bilgi Kapsülü yoktu, bu yüzden onları taşıdılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100614
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100614,
					"content": "#Merak etmeyin, başka bir fikrim var. {NICKNAME}, siz ikiniz geldiğimiz yoldan geri dönün. Ben burada saklanacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100615
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100615,
					"content": "Biraz zaman geçtikten sonra gelip benimle burada buluşun. O zamana kadar bir şeyler bulacağımızdan eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100616
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100616,
					"content": "Demek bu yüzden takip cihazını çıkarmamı istemedin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100617
					]
				},
				{
					"id": 130100617,
					"content": "Alelacele toplanmışlar, tüm malları taşıyacak vakitleri olmamış. Öylece bırakıp gidecek halleri yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100618
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100618,
					"content": "Alandan ayrıldığımızı düşündüklerinde eşyalarını almak için geri döneceklerdir. Takip cihazının buradan yeterince uzaklaştığından emin olmalıyız ki geri dönmenin güvenli olduğunu düşünsünler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100619
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100619,
					"content": "Ah, Paimon anlıyor! Buradan ayrıldığımızı düşünsünler diye onları uzağa çekeceğiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100620,
					"content": "Tamam, uzaklaşıyoruz. Burası sana emanet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100621,
					"content": "Evet. Endişe etmeyin, geri dönerlerse kalmaları için elimden geleni yapacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				}
			]
