			"dialogs": [
				{
					"id": 130101001,
					"content": "Of, çok yoruldum... Yeterince ilerlememiş miyizdir artık?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130101002,
						130101004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130101002,
					"content": "Evet, ilerledik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130101003
					]
				},
				{
					"id": 130101003,
					"content": "Yaşasın! Geri dönüp Cyno'yu bulmadan önce biraz dinlenelim hadi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130101006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130101006,
					"content": "Yakınlarda oturup dinleniyorsunuz.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130101007
					]
				},
				{
					"id": 130101007,
					"content": "Müzayedeye dönmenin vakti geldi sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130101008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130101008,
					"content": "Gidelim, belki Cyno ipucu bulabilmiştir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130101004,
					"content": "Biraz daha gidelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130101005
					]
				},
				{
					"id": 130101005,
					"content": "Daha mı? Paimon tek adım atamayacak kadar yoruldu... Burada biraz dinlenmeye ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130101006
					],
					"speakerTitle": "Paimon"
				}
			]
		},
