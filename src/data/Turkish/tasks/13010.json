			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100201,
					"content": "Hava... Çok sıcak... Keşke serinleyecek gölge bir yer bulsak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100202,
					"content": "Biraz ara versek iyi olur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100203
					]
				},
				{
					"id": 130100203,
					"content": "Hâlâ çok yolumuz var, biraz daha dayan. Burası dinlenmek için ideal bir yer değil zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100204
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100204,
					"content": "*nefes nefese kalır* Tamam... Sana sıcak gelmedi mi Cyno?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100205,
					"content": "Geldi ama ben bu tür hava şartlarına alışkınım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100206
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100206,
					"content": "Bir önerin var mı? Paimon birazdan eriyecek de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100207,
					"content": "Sadece odaklanmaya çalış ve zihnine iradenle destek ol. Pes etmeye başladığın anda zayıf düşmeye başlayacaksın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100208
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100208,
					"content": "Adım adım git. Zihnin bedeninin sınırlarını algılayamasın. Dinlenmek için bulacağımız yer güvenli olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100209
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100209,
					"content": "Öyle diyorsan öyle olsun. Peki dinlenecek güvenli yer neresi? Paimon buranın ara vermek için güvenli olduğunu düşünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100210,
					"content": "Etrafa bir baksana, her yer kum ve çöl. Çevrede bir tane bile canavar yok... Eyvah! Bu akrepler de nereden çıktı böyle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100211,
					"content": "Dikkat edin, bunlarda bir tuhaflık var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				}
			]
		},
		{
			"id": 1301004,
			"completionStepIds": [
				1301004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301004",
							"2"
						],
						"stepId": 1301004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100401,
					"content": "Of... Paimon burada bunları görmeyi beklemiyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100402,
					"content": "Bunlar sıradan akrepler değiller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100403
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100403,
					"content": "Bakın, kıskaçları numarayla işaretlenmiş. Birisi tarafından yetiştirilmiş bunlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100404
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100404,
					"content": "Yani diyorsun ki...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100405
					]
				},
				{
					"id": 130100405,
					"content": "Birileri müzayedeye gitmemizi istemiyor. Akrepleri bizi uzak tutmak için göndermişler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100406
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100406,
					"content": "Her yanımız çöl. Öldürülsek kimsenin ruhu duymaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100407
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100407,
					"content": "Burası aşırı tehlikeli! İyi ki tetikteydik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100408,
					"content": "Bir terslik var... Çölde yol falan yok. Bizi nasıl buldular?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100409
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100409,
					"content": "#Hareket etme {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100410
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100410,
					"content": "İşte cevap burada... Bunu üzerine takmış olmalılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100411
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100411,
					"content": "Ne? O da ne öyle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100412,
					"content": "Kshahrewar tarafından yapılmış bir takip cihazı. Bulunduğun konumu belirlemek için kullanılıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100413
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100413,
					"content": "Gerçi bu cihaza seri üretim için lisans verilmemişti. Acaba bunu nereden buldular? Bu olayda Kshahrewar'dan birinin parmağı olabilir mi? Pek olası gelmese de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100414
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100414,
					"content": "#Vay be, Paimon öyle bir şeyin var olduğunu bile bilmiyordu! Bunu takmak için neden {NICKNAME} seçildi peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100415,
					"content": "Muhtemelen bu cihazı Gezgine paralı askerlerle savaşırken takmışlardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100416,
						130100417
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100416,
					"content": "Özür dilerim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100418
					]
				},
				{
					"id": 130100418,
					"content": "O çok kaotik bir dövüştü. Cihazı fark etmemiş olman çok normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100419
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100419,
					"content": "Neyse ki bulduk, Cyno! Hadi kurtulalım şundan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100420,
					"content": "Hımm... Hayır. Şimdilik kalsın. İşimize yarayabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100421
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100421,
					"content": "Müzayedeye doğru yolumuza devam edelim. Burada oyalanmak tehlikeli olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100417,
					"content": "Fark etmedim bile...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100418
					]
				}
			]
		},
		{
			"id": 1301006,
			"completionStepIds": [
				1301009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301009",
							"2"
						],
						"stepId": 1301009,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100601,
					"content": "Çok tuhaf... Müzayede burada mı yapılıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100602,
					"content": "Burada kimse yok ki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100603
					]
				},
				{
					"id": 130100603,
					"content": "Evet, bir kişi bile yok... Belki arada falandırlar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100604,
					"content": "Paralı askerleri yendikten sonra zaman kaybetmeden buraya geldik. Gelişimizi haber almalarının imkanı yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100605
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100605,
					"content": "Öyle bile olsa belli ki geleceğimizi biliyorlarmış. Burada biri takip cihazını izliyormuş. Herkesi burayı boşaltmaları için uyarmış olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100606
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100606,
					"content": "Peki şimdi ne yapacağız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100607,
					"content": "Etrafı arayalım. Bütün Bilgi Kapsüllerini o kadar kısa sürede taşımış olamazlar. Hâlâ işimize yarayacak bir şeyler bulabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100608
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100608,
					"content": "Pekala, hadi etrafı iyice bir arayalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1301007,
			"completionStepIds": [
				1301011
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301011",
							"2"
						],
						"stepId": 1301011,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyno",
					"Bahari"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100701,
					"content": "Ah! Anlaşılan Cyno birini yakalamış!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100702,
					"content": "Tüm bunların arkasındaki kötü adam sensin demek... Paimon'a bildiğin her şeyi anlat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100703,
						130100704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100703,
					"content": "Kaçakçılık hakkında bir şeyler biliyor mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100705
					]
				},
				{
					"id": 130100705,
					"content": "Onu görür görmez harekete geçmedim. Yakınlarda bir yere gizlenip bir süre ne yaptığını gözlemledim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100706
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100706,
					"content": "Çıbanın başı o değil ama çok büyük ihtimalle buradaki önemli satıcılardan biri. Haksız mıyım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100707
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100707,
					"content": "Evet, etkilendim. Şanına yaraşır biriymişsin Cyno. Hâlâ buralarda olduğunu bilseydim açgözlülük etmezdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100708
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100708,
					"content": "Ne? Açgözlülük mü? Ne demek istiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100709,
					"content": "Geldiğini öğrenince tüm Konserve Bilgi satıcıları mallarını bırakıp toz oldu. Anlaşılan her şeyi toparlayacak vakitleri olmamış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100710
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100710,
					"content": "Tüm mallar sahipsiz bırakıldığından geri dönüp alabildiğim kadarını almayı düşündüm. Sonuçta bedava mal iyidir ama... *iç çeker* Sanırım açıklama yapmanın bir faydası yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100711
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100711,
					"content": "Konserve Bilgiyi kimin üretip sattığını biliyor olmalısın, haksız mıyım? Kendi isteğinle söyleyecek misin yoksa ben mi konuşturayım seni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100712
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100712,
					"content": "Hayır hayır, konuşacağım ama konuşmaya başka bir yerde devam etsek olmaz mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100713
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100713,
					"content": "Burada kalırsak birilerinin beni yanınızda görme ihtimali çok fazla. Kendimi ve ailemi tehlikeye atmak istemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100714
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100714,
					"content": "Tamam. Nereye gitmeyi öneriyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100715
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100715,
					"content": "Aaru Köyü'ndeki evime gidebiliriz. Güvenlidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100716
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100716,
					"content": "#Peki, gidelim o halde. Takip cihazını çıkarabilirsin artık {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100704,
					"content": "Müzayedede önemli bir rol üstlenmiş mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100705
					]
				}
			]
		},
		{
			"id": 1301008,
			"completionStepIds": [
				1301008
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301008",
							"2"
						],
						"stepId": 1301008,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Simin",
					"Bahari",
					"Cyno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130100801,
					"content": "Baba, dönmüşsün!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100802
					],
					"speakerTitle": "Simin"
				},
				{
					"id": 130100802,
					"content": "Ah, misafirimiz mi var? Şey, selam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100803
					],
					"speakerTitle": "Simin"
				},
				{
					"id": 130100803,
					"content": "Bu kızım Simin. Biraz utangaçtır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100804
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100804,
					"content": "Hadi kızım sen keyfine bak. Babanın şimdi misafirlerle konuşması lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100805
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100805,
					"content": "Ah... Peki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100806
					],
					"speakerTitle": "Simin"
				},
				{
					"id": 130100806,
					"content": "Bizim işte Cyno'yu herkes tanır ama siz kimsiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100807
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100807,
					"content": "#Paimon'un adı Paimon ve bu da {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100808,
					"content": "Açıkçası yalnız kovboy Cyno'yu ortaklarıyla görmeyi beklemiyordum. Takip cihazı uzaklaşmaya başlayınca eliniz boş dönmeye razı oldunuz sandım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100809
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100809,
					"content": "Beni yakalamış olsanız da hâlâ vaktiniz varken araştırmayı bırakmanız gerektiğini düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100810
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100810,
					"content": "Neden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100811
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100811,
					"content": "Konserve Bilginin üretiminden satışına ve hatta karın bölüşülmesine kadar her şeyde, yani sürecin her adımında onlarca, hatta yüzlerce insan yer alıyor. Kazanılan büyük kazançlar bu işte herkesi bir araya topladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100812
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100812,
					"content": "Kurmaya çalıştığımız bu sektörü korumak için herkes elinden geleni yapacaktır. Senin için bile uzun ve zorlu bir mücadele olacak Cyno.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100813
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100813,
					"content": "Üstelik sonunda kazanmayı başarsan bile kimse sana teşekkür etmeyecektir. Hatta pişman bile olabilirsin... Neden bu işi elimizden almaya bu kadar heveslisin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100814
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100814,
					"content": "Herkesin kendince nedenleri vardır. Ben kendiminkini açıklamak zorunda değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100815
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100815,
					"content": "*iç çeker*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100816
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100816,
					"content": "Çay getirdim baba. Misafirlerimiz için de yaptım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100817
					],
					"speakerTitle": "Simin"
				},
				{
					"id": 130100817,
					"content": "Ah, doğru. Misafirlerimize çay ikram etmek aklımdan çıkıvermiş. Teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100818
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100818,
					"content": "Lafı bile olmaz. Şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100819
					],
					"speakerTitle": "Simin"
				},
				{
					"id": 130100819,
					"content": "Çayımız biraz acıdır. O yüzden tatlansın diye biraz şeker koydum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100820
					],
					"speakerTitle": "Simin"
				},
				{
					"id": 130100820,
					"content": "Aferin kızıma. Başka şekerimiz kalmadıysa alayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100821
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100821,
					"content": "Şeker var. Ben gidip biraz dinleneceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100822
					],
					"speakerTitle": "Simin"
				},
				{
					"id": 130100822,
					"content": "Herkesin büyük kazanç elde etmek için bu işin içinde olduğunu söylememiş miydin? Durum senin için pek öyle değil gibi sanki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100823
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100823,
					"content": "Öhöm, aslında ben de size bundan bahsedecektim. Sizden bir ricada bulunacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100824
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100824,
					"content": "Kızımın kronik bir rahatsızlığı var, kalbi ve ciğerleri çok zayıf. Hafif spor yapmak bile baygınlık geçirmesine, hatta hayatının tehlikeye girmesine yol açabiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100825
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100825,
					"content": "Bu yüzden de hiç arkadaşı olmadı. Oynayacak kimsesi olmadığı için kendini çoğu zaman odasına hapsediyor. Çok fazla ilaç alması gerekiyor ve ilaçlar da hiç ucuz değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100826
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100826,
					"content": "Bana gelince, ortalama bir paralı askerdim. Sabahları erken kalkar, Mora kazanmak için her yeri dolaşırdım ama asla yeteri kadar kazanamazdım. Kızımın sağlığının günden güne kötüye gitmesini izlemekten başka bir şey gelmiyordu elimden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100827
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100827,
					"content": "Ta ki bir gün biri bana gelip gerçekten kazanç elde etmenin yolunu gösterene kadar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100828
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100828,
					"content": "O yol Konserve Bilgi satmak mıydı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100829
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100829,
					"content": "Evet. Kazandığım Morayla sonunda kızımın tedavisini karşılayabilecektim. Beni onun iyi olduğunu görmekten daha mutlu eden bir şey yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100830
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100830,
					"content": "Benim gibi birçok insan var. Konserve Bilgi kaçakçılığı yapmak size affı olmayan bir suç gibi görünebilir ama bizim için hayatta kalmanın bir yolu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100831
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100831,
					"content": "Bunları size belki anlar da fikrinizi değiştirirsiniz diye anlattım. Sen lütfen bu işe karışma Cyno. Bize hayatta kalmamız için bir şans tanı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100832
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100832,
					"content": "Olamaz... Yani Konserve Bilgi satışını engellersek kızı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100833
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100833,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100834
					]
				},
				{
					"id": 130100834,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100835
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100835,
					"content": "Gerçek her neyse bulup çıkarmalıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100836
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100836,
					"content": "Çocuğunu tedavi edecek birini bulabilirim ama kaçakçılığa göz yumamam. Bu ikisi apayrı konular.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100837
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100837,
					"content": "*iç çeker* Nedense bunu söyleyeceğini biliyordum ama kızıma yardım edeceğinin sözünü vermen bile benim için yeterli. Soruşturmaya devam etmeye kararlıysan benim evin arka tarafını bir incele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100838
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100838,
					"content": "En son gelen mallar orada. Malları görünce bence kafanda her şey netleşecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100839
					],
					"speakerTitle": "Bahari"
				},
				{
					"id": 130100839,
					"content": "Cyno ile birlikte evin arka tarafına gidersiniz.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130100840
					]
				},
				{
					"id": 130100840,
					"content": "Vay canına! Şunlara bak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100841
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100841,
					"content": "Hepsi de düzgünce kutulanmış ve dizilmiş. Bu kadar malın tek bir satıcının payına düşen olduğunu düşünürsek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100842
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100842,
					"content": "Küçük üreticiler bu kadar fazla mal hazırlayamaz. Hımm, bu işin ardında Akademi mi var acaba? Bu kadar ürün teftiş sırasında gözden kaçamaz ki ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100843
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100843,
					"content": "Şuna bakın! Gördüğümüz diğer Bilgi Kapsüllerinden farklı bunlar. İçlerinde Keder Bahçesi hakkında bilgiler mi var acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100844
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100844,
					"content": "Evet, olabilir. Bir dakika, bu da ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100845,
						130100846
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100845,
					"content": "Daha önce görmediğimiz bir mühür bu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100847
					]
				},
				{
					"id": 130100847,
					"content": "Evet, bu Matra mührü. Malların Matra kontrolünden geçtiğini gösteriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100848
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100848,
					"content": "Takip cihazını bulduğumuzda Akademiden birinin bu işte parmağı olduğundan şüphelenmiştim ama bu kadar Konserve Bilgiyi Akademiden nasıl çıkarttıklarını anlayamıyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100849
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100849,
					"content": "Şimdi taşlar yerine oturdu. Mallar Matra mührüyle ikinci bir incelemeden geçmeden Akademiden çıkartılmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100850
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100850,
					"content": "Neden bana engel olmaya çalıştıkları şimdi anlaşıldı. Demek yasa dışı işler yapan kişi bir Matra üyesiymiş. İnanılır gibi değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100851
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100851,
					"content": "Ortada bir yanlış anlaşılma olabilir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100852
					]
				},
				{
					"id": 130100852,
					"content": "#Senden bir iyilik isteyebilir miyim {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100853
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100853,
					"content": "Bu Konserve Bilgilerin hepsi Akademiden gelmiş. Keder Bahçesi hakkındaki bilgilerin de Akademi araştırma dosyalarından çıkmış olması gayet mümkün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100854
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100854,
					"content": "Odaya girebilirsek dosyalara kimin eriştiğini bulabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100855
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100855,
					"content": "Ama mevcut durumumu düşününce birdenbire Akademide ortaya çıkarsam boş yere dikkat çekmiş olurum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100856
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100856,
					"content": "Kayıtlara sen bakmalısın. Nabil'e bir mektup yazıp seni oraya götürmesini sağlayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100857
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100857,
					"content": "Merak etme, hallederiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100858
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130100858,
					"content": "Ben de o sırada burada çalışmaya devam edeceğim. Elimizdeki ipuçları Akademideki birine çıkıyor olsa da belli ki Akademi dışında da güçlüler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130100859
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100859,
					"content": "Bahari'den diğer tüccarlar hakkında daha fazla bilgi alabiliriz. Ben burada kalıp hazırlık yapacağım. Bir gelişme olursa burada buluşalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130100846,
					"content": "Ne olduğunu sen biliyor musun Cyno?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130100847
					]
				}
			]
		},
		{
