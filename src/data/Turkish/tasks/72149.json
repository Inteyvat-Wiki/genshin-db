			},
			"dialogs": [
				{
					"id": 721490201,
					"content": "#Tekrar hoş geldin {NICKNAME}. Senin için yapabileceğim bir şey var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490202
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490202,
					"content": "Verdiğin görev hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490203
					]
				},
				{
					"id": 721490203,
					"content": "Dört Ruh İncisini de bulduk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721490204,
					"content": "Öyle mi? Çok teşekkür ederim, size güvenebileceğimi biliyordum! O halde \"kalp\" mührünün kilidini açmamıza bir adım kaldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490205
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490205,
					"content": "Sakıncası yoksa ikinizin de benimle gelmesini rica edeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490206
					],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490206,
					"content": "#Bu kadar gelmişiz, biraz daha yürümekten ne zarar gelir! Değil mi {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490207,
						721490208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721490207,
					"content": "Peki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490209
					]
				},
				{
					"id": 721490209,
					"content": "Kaybedecek vaktimiz yok. Hadi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tsuyuko"
				},
				{
					"id": 721490208,
					"content": "Bence sorun yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490209
					]
				}
			]
		},
		{
