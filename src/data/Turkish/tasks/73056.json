			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Khayyam",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730560401,
					"content": "Ah! Buraya baksanıza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560402
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560402,
					"content": "Yeni bir bitki falan mı? Niye bu kadar heyecanlandın ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560403,
					"content": "Hayır, o değil. Ondan da daha güzel bir şey! Baksanıza, gizli kalemiz işte burada! Haha! Ne hale gelmiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560404
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560404,
					"content": "\"Gizli kale\" mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560405,
					"content": "Haha! İşte Alim Omar geri döndü! Yanında yıldızların sırlarını da getirdi! Neredesin Irfan, neredesin Siman? Bana bir hoş geldin demeyecek misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560406
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560406,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560407,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560408
					]
				},
				{
					"id": 730560408,
					"content": "Öhöm, kusura bakmayın çocuklar. Kendimi biraz kaptırdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560409
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560409,
					"content": "Arada böyle oluyor, yaşlılık işte. Şu anki zaman bulanıklaşıyor, geçmişe duyduğum hasret ise gün geçtikçe artıyor... Hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560410
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560410,
					"content": "Irfan ve Siman benim dostlarım olur. Kaleyi üçümüz birlikte inşa ettik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560411
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560411,
					"content": "O zamanlar Irfan müzisyenimiz, Siman da başkomutanımızdı. Bense astroloji alimiydim. Tabii bazen rollerimizi değişirdik... Çocuklar nasıldır bilirsiniz, hemen sıkılıp başka şey oynamak isterler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560412
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560412,
					"content": "Irfan müzik konusunda yetenekliydi, Siman da herkesten uzun ve güçlüydü. Peki ya ben? Haha, bense Mora sıkıntısı çekmeyen bir ailenin kitap kurdu çocuğuydum sadece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560413,
						730560415
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560413,
					"content": "Çocukken burada evcilik mi oynardınız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560414
					]
				},
				{
					"id": 730560414,
					"content": "Hayır, burası bizim gizli dünyamız. Ciddi diyorum. Birbirimizi asla unutmayacağımıza ve Kurtuluş Ordusunun başına geçip kaleyi geri alacağımıza birbirimize söz vermiştik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560418
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560418,
					"content": "Hehe, aradan 20 yıl geçmişti. Verdiğimiz sözü unutmuş olabilirlerdi... Ardından orası benim ormandaki araştırma kampım oldu. 30 yıl öncesine kadar da çalışır durumdaydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560419
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560419,
					"content": "Tabii sonra Marana bile geldi ama Kurtuluş Ordusu ortaya bile çıkmadı. Hah, ortada garip bir şey yok tabii... Çocukken verdiğimiz o sözler ölüme nasıl karşı koyabilirdi ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560420
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560420,
					"content": "Yine de... Sen onları hatırladığına göre onlar da seni hatırlıyor olmalı! Lütfen umudunu kaybetme Khayyam Dede!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560421,
					"content": "Umut mu? Ne münasebet. Çocukluk hatıraları, ortak \"hayali dostlar\" ve yetişkinlerin giremediği o dünya... Çok yazık oldu diyebilirim ama zamanı geri döndürmek imkansız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560422
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560422,
					"content": "\"Hayali dostlar\" derken Aranaraları mı kastediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560423,
						730560424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560423,
					"content": "Paimon, sessiz ol!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560425
					]
				},
				{
					"id": 730560425,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560426
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560426,
					"content": "Haha... Neredeyse unutuyordum. Yeni yetişen bitkilerden örnek toplamak için yardımınızı istemiştim. Muhabbet etmeye gelmediniz sonuçta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560427
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560427,
					"content": "Çok saçmalarsa bu ihtiyarı mazur görün lütfen. Hadi devam edelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560424,
					"content": "Keşke bazen sussan Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560425
					]
				},
				{
					"id": 730560415,
					"content": "Tüm bunları arkadaşlarınla mı yaptınız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560416
					]
				},
				{
					"id": 730560416,
					"content": "Hayır, hepsini değil. Kurtuluş Ordusunun başına geçip kaleyi geri alacağımıza söz vermiştik. Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560417
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560417,
					"content": "Büyüyünce ben Akademide bir botanik araştırmacısı oldum, sonra bir gün buraya dönüp çekidüzen vermeye karar verdim. Birkaç kez uğradım ve birçok çöpü buradan çıkardım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560418
					],
					"speakerTitle": "Khayyam"
				}
			]
		},
