						730560615
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560615,
					"content": "Ben de onları artık göremiyorum zaten... Hatta var olduklarına bile inanmakta zorlanıyorum. Belki de hepsi çocukken gördüğüm bir hayalden ibarettir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560616
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560616,
					"content": "Yine de pes etmeyeceğim. Bunu onlara götürün çocuklar... Bir daha asla buluşamayacağınız gün gelmeden, bir mucize gerçekleşme ihtimali yok olmadan götürün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560614,
					"content": "Seni unutmuş olabilirler.",
