					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560611,
					"content": "Tabii, götürürüz ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560612,
						730560614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560612,
