						730560711
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560711,
					"content": "Peki ama çok kalmayın burada. Gidin hemen. İyileşiyor orman henüz... Misafir ağırlayamayız bu yüzden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560712
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730560712,
					"content": "Beklesene!",
