				},
				{
					"id": 730560503,
					"content": "Vay be. Bay Khayyam bir anda gençleşiverdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560504,
						730560506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560504,
					"content": "Paimon da bir anda ne demesi gerektiğini öğreniverdi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560505
					]
				},
				{
					"id": 730560505,
					"content": "Ne? O ne demek şimdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560508,
					"content": "Hımm... Yeterince topladık herhalde. Benimle buraya kadar geldiğiniz için teşekkürler. Bütün işlerimizi hallettiğimize göre artık dönebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560509
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560509,
					"content": "Haha, bu harika. Bu örnekler, Solduranın sırları ve zayıflıkları üzerine yaptığım araştırmada çok işime yarayacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560510
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560510,
					"content": "Bu kadar uğraştığınız için teşekkürler. Aynı yoldan dönebiliriz... Size vereceğim bir şey var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560511
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560511,
					"content": "Yaşasın! Ödüller geliyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560512,
					"content": "Hehe, olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560506,
					"content": "Yaşasın!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560507
					]
				},
				{
					"id": 730560507,
					"content": "Paimon hiçbir şey anlamadı ama evet, yaşasın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560508
					],
