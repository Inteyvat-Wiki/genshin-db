				},
				{
					"id": 730560202,
					"content": "Bana eşlik ettiğiniz için de teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560203
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560203,
					"content": "Lafı bile olmaz Bay Khayyam! Javanlar olarak yapmamız gereken bu zaten!",
