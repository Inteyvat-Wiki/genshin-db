			"dialogs": [
				{
					"id": 730560201,
					"content": "Araştırmamda üç ana bölgeye odaklanıyorum. Umarım 30 yıl öncesinin hatıralarını tamamen unutmamışımdır... Yerleri bulabilirim herhalde.",
					"roleType": "TALK_ROLE_NPC",
