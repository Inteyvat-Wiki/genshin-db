			},
			"dialogs": [
				{
					"id": 730560601,
					"content": "İkinize de teşekkür ederim Javanlar. Benim gibi bir ihtiyarla yolculuğa çıkmak zor olmuştur eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560602
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560602,
					"content": "Pek kıymetli değil ama... Bir hatıra olarak kabul edin lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560603
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560603,
					"content": "Vay canına... O ne? O ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560604,
					"content": "Daha önce de görmüşsünüzdür. Küçük, kuru bir çiçek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560605
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560605,
					"content": "Aaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560606,
						730560607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560606,
					"content": "Bu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560608
					]
				},
				{
					"id": 730560608,
					"content": "Evet. Yanılmıyorsam onlar da size aynı şeyi hediye etti, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560609
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560609,
					"content": "Hehe... Biliyordum. Karşılaşmamız bir tesadüf değil... Ben tesadüflere inanmam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560610
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560610,
					"content": "Bu çiçeği size emanet ediyorum. Lütfen bunu ortak dostlarımıza götürün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560611
