						730560713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560713,
					"content": "Sana bir şey vereceğiz!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560714
					]
				},
				{
					"id": 730560714,
					"content": "Bana mı?",
