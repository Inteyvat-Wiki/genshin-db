			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Khayyam",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730560101,
					"content": "Haha, ilginç. Cidden tuhaf. Canlanıyor. Orman canlanıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560102
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560102,
					"content": "Merhaba dede! Kayıp mı oldun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560103,
					"content": "Hımm. Kayık mı? Bana mı diyorsun? Haha, kayıp mı dedin? Hayır, hayır. Kaybolmadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560104
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560104,
					"content": "İyi günler çocuklar. Ben Giyath Khayyam. Amu{RUBY#[S]Biyoloji}rta Dasturuyum. Khayyam deseniz yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560105
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560105,
					"content": "Hımm. Merhaba Bay Khayyam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560106,
					"content": "Hayır. Beni izle. Dilinin ucunu indir. Ortasını kaldır. Haaa. Sonra ağzını yuvarlak yap. Yyaaa. En son dudaklarını zorlamadan kapat. Mmm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560107
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560107,
					"content": "Şey... Hay... Yaaa... Mmm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560108,
					"content": "Doğru! Aferin! Şimdi sen tekrar et altın renkli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560109,
						730560111
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560109,
					"content": "Hay... Yaaa... Mmm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560110
					]
				},
				{
					"id": 730560110,
					"content": "Haha, güzel! Şu ufaklıktan çok daha güzel söyledin! Gördün mü? Fonetik dersi verebilirim demiştim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560113
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560113,
					"content": "Peki kayıp değilseniz burada ne işiniz var Bay Khayyam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560114,
					"content": "Ne mi yapıyorum? Hehe, ben bir orman araştırmacısıyım. Ormanı memleketimiz gibi görürüz. Sonunda döndüğüm memleketimde nasıl kaybolabilirim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560115
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560115,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560116,
					"content": "Bir zamanlar orman, Soldurandan çok muzdaripti. Otuz yıldır bitkilerin türleri ve sayıları hızla azaldı. Kötü Mantar Irkı büyümeye devam etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560117
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560117,
					"content": "Gerçi buralardaki Solduran son zamanlarda ortadan kayboluverdi. Yok olan bitkiler yeniden büyümeye başladı, Mantar Irkı da artık daha yavaş çoğalıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560118
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560118,
					"content": "60 yıldır böyle bir şey görmemiştim... Ben de buraya tahminlerim doğru çıkacak mı diye görmeye geldim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560119
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560119,
					"content": "Paimon anlıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560120,
						730560123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560120,
					"content": "Tahminler derken?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560121
					]
				},
				{
					"id": 730560121,
					"content": "Haha, üzerinden 60 yıl geçti tabii... O kadar da ümitlenme, benim gibi bir ihtiyarın hafızası artık pek iyi değil. Yine de Solduranın ortadan kaybolmasının o konuyla alakalı olduğuna eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560122
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560122,
					"content": "O yüzden örnek toplamak için bu mağaraya girmeye karar verdim. Bu sayede tahminlerim doğru muymuş görebileceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560126
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560126,
					"content": "Paimon anlıyor ama... İçinde Marana olmasa bile mağara çok tehlikeli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560127,
					"content": "Haha. Benim için işten bile değil bu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560128
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560128,
					"content": "Hımm, bir dakika... Daha demin ne dedin? Mağarada ne var dedin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560129,
						730560130
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560129,
					"content": "Marana?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560131
					]
				},
				{
					"id": 730560131,
					"content": "Hımm... Şimdi düşündüm de yardımınıza ihtiyacım olacak gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560132
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560132,
					"content": "Paimon demişti işte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560133,
					"content": "Hehe, kusura bakmayın. Adınızı bile bilmiyorum gerçi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560134
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560134,
					"content": "#Bana {NICKNAME} diyebilirsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560135
					]
				},
				{
					"id": 730560135,
					"content": "Paimon'un adı da Paimon! Paiii... monnn...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560136,
					"content": "Paimon mu? Paimon... Haha, tuhaf bir isimmiş. Daha önce hiç bu isimde bir insanla... ya da periyle tanışmamıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560137
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560137,
					"content": "Ah, kusura bakmayın. Kabalık etmek istememiştim... Şu küçük şeyi kastediyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560138
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560138,
					"content": "Küçük şey mi? Yeterince ayıp etmiş oldun zaten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560139,
					"content": "Neyse, sohbet buraya kadardı. Lütfen beni takip edin Javanlar. Yola çıkma zamanı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560140
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560140,
					"content": "\"Javanlar\" mı? O da ne demek?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560141,
					"content": "Büyüdüğüm yerde kullanılan çok eski bir kelime. \"Cesur gençler\" anlamına geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560142
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560142,
					"content": "Daha da açmak gerekirse... \"En büyük kötülüğü asla görmezden gelmeyen ve bitmek bilmeyen adaletsizlikle yüzleşmekten asla kaçmayan gençler\" demek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560143
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560143,
					"content": "Hehe, bizi tarif ediyorsun işte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560144,
					"content": "Oo, kendinizi öyle mi görüyorsunuz? Öyleyse peşimden gelin bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560145
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560145,
					"content": "Hımm, bize yetişebilecek misin Khayyam Dede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730560146,
					"content": "Haha, neredeyse 30 yıldır bu ormanı araştırıyorum ben. Bu ihtiyarın dayanıklılığını küçümsemeyin sakın! Siz önden gidin, ben biraz sonra yetişirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560130,
					"content": "Solduran?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560131
					]
				},
				{
					"id": 730560123,
					"content": "Yardımımıza ihtiyacın var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560124
					]
				},
				{
					"id": 730560124,
					"content": "Haha, sağ olun yardımsever evlatlarım. Bedenim artık yaşlanmış olabilir ama kafam hâlâ çalışıyor. Beni hafife almayın derim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560125
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560125,
					"content": "Ne de olsa ormanı nasıl memnun edeceğimi iyi bilirim. Bana zarar gelmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560126
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730560111,
					"content": "Burada ne yapıyorsun Khayyam?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730560112
					]
				},
				{
					"id": 730560112,
					"content": "Hımm. Çok hızlı okudun ama sorun değil. Yavaşlatsan yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560113
					],
					"speakerTitle": "Khayyam"
				}
			]
		},
