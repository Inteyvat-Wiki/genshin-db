			"dialogs": [
				{
					"id": 730560501,
					"content": "Buraya bakın hele... Bitkiler öyle güzel büyüyor ki! Marana yüzünden mahvolmuş olsa bile bu topraktan canlı bitkiler yeşerebiliyor demek ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730560502
