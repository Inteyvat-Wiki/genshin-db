			"dialogs": [
				{
					"id": 751270101,
					"content": "Aa, fotoğraf çekmek için mi geldiniz? Buraya daha önce fotoğraf çekmeye gelen yabancı turistler olmuştu. O uçan adanın manzarası muhteşem gerçekten...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270102
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270102,
					"content": "Kamera getirmememiz kötü oldu. Tanıdığım yabancı bir tüccardan bana bir Kamera getirmesini istemek zorunda kaldım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270103
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270103,
					"content": "Nasıl gidiyor sevgili misafir? Fotoğraf çekelim mi? Ancak senin çekmen gerekecek. Ben pek anlamam da bu işlerden...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270104
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270104,
					"content": "Tuhaf, denizin üstünde sis var...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751270105
					]
				},
				{
					"id": 751270105,
					"content": "Sis mi? Nasıl yani? Böyle güçlü bir deniz esintisinde sis olamaz ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270106
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270106,
					"content": "Doğduğum günden beri hiç denizin üstünde sis görmedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270107
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270107,
					"content": "Acaba burayla Tezcatepetonco Dağı'nın altındaki sis kaplı bölgeyi karıştırıyor olabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270108
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270108,
					"content": "Olabilir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751270109
					]
				},
				{
					"id": 751270109,
					"content": "Hehe, bana sorarsan biraz fazla gerginsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751270110
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 751270110,
					"content": "Natlan'a seyahate geldiysen biraz gevşemen lazım.",
					"roleType": "TALK_ROLE_NPC",
