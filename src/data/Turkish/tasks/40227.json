			"dialogs": [
				{
					"id": 402270201,
					"content": "Aino ve Ineffa'yı etkinlik alanına götürüyorsun.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402270202
					]
				},
				{
					"id": 402270202,
					"content": "Hımm... Deneme platformunu buraya koyabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270203
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 402270203,
					"content": "Bu yeni robot çok ilginç görünüyor Aino.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270204,
					"content": "Hehehe! Ne zaman istersen uğrayıp deneyebilirsin! Aklını başından alacak, eminim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270205
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 402270205,
					"content": "Yardımınız için sağ olun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270206
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270206,
					"content": "Rica ederiz! Bu arada, sadece ikinizi mi kaydedeceğiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270207,
					"content": "Hımm... Ben katılacağım ama Aino'yu kaydetmeye gerek yok. Kalabalık ortamlarda bulunmaktan pek hoşlanmıyor. Fuar başlar başlamaz doğruca Atölyeye dönecek zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270208
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270208,
					"content": "Mantıklı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
