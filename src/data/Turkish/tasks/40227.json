			"dialogs": [
				{
					"id": 402270101,
					"content": "Hım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270102
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 402270102,
					"content": "Hey, ikiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270103,
					"content": "#{NICKNAME} ve Paimon, merhaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270104
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270104,
					"content": "Nefer'a fuar işlerinde yardım ediyoruz da, duyduğumuza göre Krumkake Atölyesi de katılıyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270105,
					"content": "Evet. Aino şu anda \"Pata Küte Savunma Robotları\" üzerinde son düzenlemeleri yapıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270106
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270106,
					"content": "Aa, fuarda onu mu satacak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270107,
					"content": "Evet. Köstebekler ve diğer küçük yaratıklar sık sık Atölyeden bir şeyler çalıyor, bu yüzden Aino orayı korumak için onlardan esinlenerek bir savunma robotu tasarladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270108
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270108,
					"content": "Biraz daha test edip robotların ne kadar etkili olduğunu görünce onları geliştirip fuarda görücüye çıkarmaya karar verdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270109
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270109,
					"content": "Bir dakika, yani Aino robotlarından birini gerçekten satışa mı sunacak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270110,
					"content": "Tam olarak öyle değil. Birkaç özel sipariş dışında Aino bitmiş ürünlerini nadiren satar. Fuarda satışa çıkaracağı ürün yalnızca bir taslak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270111
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270111,
					"content": "Haaa... Peki gitmeye hazır mısınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270112,
					"content": "Jahoda işleri biraz hızlandırmamızı istedi. Size on numara bir yer kapmış ama millet işkillenmeye başlamadan orada olmamız lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270113,
					"content": "Ona önce hata ayıklamayı bitirmem gerektiğini söyledim ben! Acele edersem elimde satabileceğim bir şey olmayacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270114
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 402270114,
					"content": "Vay canına, Paimon Aino'yu daha önce hiç bu kadar ciddi görmemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270115,
					"content": "Atölye ciddi bir sermaye sıkıntısı çekiyor. Aino fuarın bizi düzlüğe çıkaracağını umuyor, o yüzden de ince eleyip sık dokuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270116
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270116,
					"content": "Bütün para nereye gitti? Pahalı bir araştırma falan mı yaptınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402270117,
					"content": "Hayır. Asıl sıkıntı tatlı bütçemizde. Şimdiye dek en az 47 defa tatlıya gereğinden fazla para harcandığı için araştırma fonlarımız tükendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270118
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270118,
					"content": "Bu nedenle araştırma ve tatlı bütçelerimizi ayırmaya karar verdim. Aino'nun birinden alıp diğerine aktarma yapması yasak artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270119
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270119,
					"content": "Ve kısa süre önce bu ayın tatlı bütçesini tamamen tüketti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270120,
						402270121
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270120,
					"content": "Anlıyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402270122
					]
				},
				{
					"id": 402270122,
					"content": "İşte bitti! Yüzümü kara çıkarmayın Pata Küte Savunma Robotları!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270123
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 402270123,
					"content": "Artık gidebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 402270121,
					"content": "Hiç şaşırmadım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402270122
					]
				}
			]
		},
