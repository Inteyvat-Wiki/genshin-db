					"Gygax"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706790101,
					"content": "Merhabalar, merhabalar! Yine karşılaştık! Şu tesadüfe bak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790102,
						706790104
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790102,
					"content": "Pardon, çıkaramadım seni ama...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790103
					]
				},
				{
					"id": 706790103,
					"content": "Gygax! Gygax ben! Rüzgar Labirentinden hani! Hatırladın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790106
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790106,
					"content": "Demek sensin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706790107,
					"content": "Tamam, şimdi hatırladım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790108
					]
				},
				{
					"id": 706790108,
					"content": "Öyle diyorsun da yüzündeki ifadeye bakılırsa bir şey hatırladığın yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790109
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790109,
					"content": "Neyse, şuraya bir bak lütfen. En azından Rüzgar Labirentini hatırlıyorsundur, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790110
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790110,
					"content": "Hani önceden oyunu test etmiştin de bana bir sürü tavsiye vermiştin ya? Hepsi de harika fikirlerdi. Onları alıp oyuna ekledim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790111
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790111,
					"content": "Oyunun kurallarını ve oynanışını da bir gözden geçirdim... Şey, birkaç defa geçirdim hatta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790112,
						706790113
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790112,
					"content": "Aşırı karmaşık ve anlaşılmaz hale getirmedin, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790114
					]
				},
				{
					"id": 706790114,
					"content": "Hiç merak etme. Bu yenilikleri seveceğine eminim. Bak sana kısaca bir özet geçeyim hatta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790115
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790115,
					"content": "Şimdi ilk olarak, Rüzgar Labirentinin yeni versiyonuna Sinyal Cihazı diye bir şey ekledim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790116
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790116,
					"content": "Asiler, 4 Sinyal Cihazını etkinleştirebildikleri zaman Avcıyı yenip galip gelmiş olacaklar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790117
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790117,
					"content": "Öte yandan Avcı ise... Şey, Avcı için bir şey değişmedi aslında! Tüm Asileri yakalarsa kazanır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790118
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790118,
					"content": "Ancak Rüzgar Labirentinin bu versiyonunda Asiler, Avcı tarafından yakalanır yakalanmaz oyun dışı kalmayacaklar. Onun yerine \"Gözetim Bölgesi\" dediğimiz yerde tutulacaklar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790119
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790119,
					"content": "Bir süre bekledikten sonra veya diğer Asilerin yardımıyla Gözetim Bölgesinden kaçabilir ve oyuna devam edebilirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790120
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790120,
					"content": "Ama daha önce yakalanan bir Asi ikinci defa yakalanırsa... O zaman tamamen oyun dışı kalır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790121,
						706790122
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790121,
					"content": "Biraz karmaşık sanki...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790123
					]
				},
				{
					"id": 706790123,
					"content": "Merak etme. Böyle anlatınca biraz karmaşık gelmiştir ama birkaç tur oynayınca alışırsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790124,
						706790126
					],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790124,
					"content": "O zaman bir deneyeyim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790125
					]
				},
				{
					"id": 706790125,
					"content": "Tamam! Bu taraftan lütfen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790126,
					"content": "Şimdi olmaz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790127
					]
				},
				{
					"id": 706790127,
					"content": "Sorun değil. Vaktin olunca gelirsin, ben bir süre daha buralarda olacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gygax"
				},
				{
					"id": 706790122,
					"content": "Bir sürü yeni kural gelmiş...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790123
					]
				},
				{
					"id": 706790113,
					"content": "Tuhaf oyun stilleri eklemedin, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790114
					]
				},
				{
					"id": 706790104,
					"content": "Sen... Şu Rüzgar Labirentindeki adamsın!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790105
					]
				},
				{
					"id": 706790105,
					"content": "Adım Gygax! Gerçi haklısın... Ama Rüzgar Labirentinin benden ünlü olmasına üzülmedim, yanlış anlaşılmasın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790106
					],
					"speakerTitle": "Gygax"
				}
			]
		}
	]
}