			"dialogs": [
				{
					"id": 747030101,
					"content": "Bir dakika... Bu rakamlar... Yanlış hesaplamadığınıza emin misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030102
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747030102,
					"content": "Hımm? Bir sorun mu var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747030103,
					"content": "... Gerçekten bu kadar kar mı ettiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030104
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747030104,
					"content": "%30'luk payın konusunda fikrini mi değiştirdin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747030105
					]
				},
				{
					"id": 747030105,
					"content": "O kadar küçük hesapların peşine düşecek biri gibi mi duruyorum? Sadece akvaryumu bu kadar iyi işletmenize şaşırdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030106
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747030106,
					"content": "Paimon bunda Fontinalia Film Festivalinin de payı olduğunu düşünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747030107,
					"content": "Bu kadar gelir... Wingalet'in kirasını ödedikten sonra bile geriye hatırı sayılır bir kar kalıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030108
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747030108,
					"content": "Meslek değiştirme fikri cazip mi geldi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747030109
					]
				},
				{
					"id": 747030109,
					"content": "Alakası bile yok. Ticari zekam konusunda boş sanrılara kapılmış değilim. Benim tutkum makina yapmak ve formüller üzerinde çalışmak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030110
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747030110,
					"content": "Bununla birlikte... Buranın balıksız bir odadan şu anki haline dönüştüğünü görmek gerçekten bir mucize gibi hissettirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030111
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747030111,
					"content": "Hehe, bize bu alanı ödünç verdiğin için sana bir teşekkür borçluyuz! Tüm emeğimizin bunca insana neşe getirdiğini görmek paha biçilemez bir duygu! Sence de öyle değil mi Sandrone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747030112,
					"content": "Hıh. Biraz öyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030113
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747030113,
					"content": "Sadece biraz mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747030114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747030114,
					"content": "Kesin %30'a razı geldiğindendir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747030115
					]
				},
				{
					"id": 747030115,
					"content": "Of, söyledim ya, bu umurumda değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kukla"
				}
			]
		}
	]
