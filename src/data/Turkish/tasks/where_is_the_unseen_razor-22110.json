			"dialogs": [
				{
					"id": 221100301,
					"content": "Harabe Avcısının icabına baktın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100302
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221100302,
					"content": "Evet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100303
					]
				},
				{
					"id": 221100303,
					"content": "Harabe Avcıları senin için sıradan bir iş, desene... Becerilerinden şüphe ettiysem de artık eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100304
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221100304,
					"content": "Kılıçla ilgili hâlâ bir şey yok mu? *iç çeker* Bu soruyu sorarken kendi sesimi duymaktan sıkıldım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100305
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221100305,
					"content": "Endişelenme. Her seferinde sana çeşitli ödemeler sundum, sen de tüm Özel Görevleri başarıyla tamamladın. Bunun için sana teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100306
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221100306,
					"content": "Nereye kayboldun Görünmez Ustura?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100307,
						221100308
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221100307,
					"content": "Onu eninde sonunda bulacaksın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100309
					]
				},
				{
					"id": 221100309,
					"content": "Bana kendimi daha iyi hissettirmeye mi çalışıyorsun? Teşekkür ederim ama bu sadece ufak bir aksilik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100310
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221100310,
					"content": "Ne kadar sürerse sürsün ve bu araştırma beni nerelere sürüklerse sürüklesin... O kılıcı bulacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100311
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221100311,
					"content": "Arama alanımı genişletmeyi düşünüyorum, yani ileride yardımına tekrar ihtiyacım olabilir... Ve tabii ki hizmetlerin için ödeme yapmaya devam edeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100316
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221100316,
					"content": "İşte ödemen. Ben gideyim, beni bekleyen yeni Özel Görevler var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100317
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221100317,
					"content": "Görünmez Ustura... Sonsuza kadar görünmez kalmayacaksın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221100308,
					"content": "Bu Özel Görevlerin kılıçla hiç ilgisi yok sanki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100312
					]
				},
				{
					"id": 221100312,
					"content": "Çünkü kılıçla ilgili tüm Özel Görevleri aldım ama ne yazık ki hiçbir yere varamadık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100313
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221100313,
					"content": "Sonra bir düşündüm... Erkek kardeşimi bu kılıçtan ayıran her ne idiyse, sadece çok tehlikeli durumlarda gerçekleşmiş olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100314
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221100314,
					"content": "Sonra diğer Özel Görevleri, yani Görünmez Usturanın yerine dair ipucu verebilecek kadar tehlikeli olduğunu düşündüğüm görevleri almaya başladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100315
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221100315,
					"content": "Ancak aralarında tek başıma halledemeyeceğim kadar çok sayıda tehlikeli Özel Görev var. Bu yüzden senden yardım istedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100316
					],
					"speakerTitle": "Lahn"
				}
			]
		}
	]
