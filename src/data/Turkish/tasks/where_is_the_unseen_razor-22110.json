				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221100101,
					"content": "İşe yaramaz... Hem de hiç.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100102
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221100102,
					"content": "Sorun ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100103
					]
				},
				{
					"id": 221100103,
					"content": "Cidden yapacak hiç işin yok değil mi? Ya işinde çok iyisin ya da çok yetersizsin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100104
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221100104,
					"content": "Ama ikinci söylediğimin olduğunu sanmıyorum... Çünkü şimdiye kadar sana verdiğim Özel Görevlerin hepsini başarıyla yaptın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100105
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221100105,
					"content": "Şu anda boştaysan, benim için yapabileceğin bir şey var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100106
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221100106,
					"content": "Ama bu görev daha tehlikeli. Bir Harabe Avcısını yenmeni istiyorum. Halledebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100107,
						221100108
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221100107,
					"content": "Oldu bil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100109
					]
				},
				{
					"id": 221100109,
					"content": "Kendinden oldukça eminsin. Erkek kardeşim de öyleydi... Belki bir gün onun eriştiği yüksek mertebeye erişmeyi başarabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100113
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221100113,
					"content": "Hepsi bu kadar. İstikamet Guili Ovası. Hadi, hazırlan ve Harabe Avcısını alt et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100114
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221100114,
					"content": "Onu alt ettiğinde, etrafta kılıca dair eşyalar aramayı unutma. Ne bulursan bana getir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100115
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221100115,
					"content": "Hiçbir şey bulamazsan da kendin gel yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100116
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221100116,
					"content": "Görevinde başarılar. Umarım bu seferki aramandan bir sonuç çıkar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221100108,
					"content": "Kılıca da bakarolayım mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100110
					]
				},
				{
					"id": 221100110,
					"content": "Evet, lütfen. Harabe Avcısını yendiğinde, etrafta kılıç ya da kılıçla ilgili bir şeyler var mı diye bakıver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100111
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221100111,
					"content": "Harabe Avcılarının oldukça zorlu düşmanlar olduğu konusunda seni uyarmış olayım. Yenebilmek için dikkatinin sürekli onlarda olması gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100112
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221100112,
					"content": "Kılıca gelirsek... O konuda herhangi bir şey bulursan şahane olur ama bulamazsan da sorun değil. Harabe Avcısını yendiğin müddetçe ödemeni alacaksın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100113
					],
					"speakerTitle": "Lahn"
				}
			]
		},
