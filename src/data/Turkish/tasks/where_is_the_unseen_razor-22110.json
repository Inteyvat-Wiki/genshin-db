			"dialogs": [
				{
					"id": 221100201,
					"content": "Harabe Avcısının icabına baktın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221100202
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221100202,
					"content": "Henüz değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221100203
					]
				},
				{
					"id": 221100203,
					"content": "Acele etme, Harabe Avcısını alt etmeden önce tamamen hazır olmak gerekir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lahn"
