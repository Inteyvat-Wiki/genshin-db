			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lauma"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765010101,
					"content": "#{NICKNAME}, Paimon siz miydiniz? Kuşlar geleceğinizi fısıldamıştı. Önemli bir mesele mi var? Ya da size yol göstermemi mi isteyeceksiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010102,
						765010103
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010102,
					"content": "Öylesine etrafa bakınıyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010104
					]
				},
				{
					"id": 765010104,
					"content": "Ay ışığı buraya tüm parlaklığıyla lütfunu sunuyor. Burada yaşayan bitkiler ve hayvanlar dünyanın geri kalanından oldukça farklıdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010105
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010105,
					"content": "O yüzden burasının güzel fotoğraflar çekmek için uygun bir yer olduğunu söyleyebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010106
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010106,
					"content": "Şöyle etrafa bir göz atın. Herhangi bir sorunuz olursa bana sorabilirsiniz, elimden geldiğince cevaplamaya çalışırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010107,
						765010108
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010107,
					"content": "Burası gerçekten huzur veriyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010109
					]
				},
				{
					"id": 765010109,
					"content": "Evet. Burası meditasyon yaptığım ve tüm canlılarla fısıldaşarak iletişim kurduğum yerdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010110
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010110,
					"content": "Burada durmak bile içimi rahatlatıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010111
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010111,
					"content": "Hehe, tam bir şairsin Lauma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010112,
						765010113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765010112,
					"content": "Aslında küçük bir isteğim var...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010114
					]
				},
				{
					"id": 765010114,
					"content": "Arka plan ile o kadar uyumlu duruyorsun ki adeta bir tablo gibi! Fotoğrafın harika çıkacağına eminiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765010115,
					"content": "Fotoğrafımı mı çekmek istiyorsunuz? Bu çok ilginç bir deneyim olur. Buranın dingin atmosferiyle suretimi aynı karede ölümsüzleştirmeye değer görüyorsanız seve seve poz verebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010116
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010116,
					"content": "Yolculuğunuzda tatlı bir hatıra daha edinmenizi sağlamaktan da onur duyarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010117
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010117,
					"content": "Size nasıl yardımcı olabilirim? Belirli bir yöne mi bakmamı istersiniz, yoksa olduğum gibi mi kalayım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765010118,
						765010119
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010118,
					"content": "Kendin ol yeter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010120
					]
				},
				{
					"id": 765010120,
					"content": "Tamam o halde, kendimi sana bırakıyorum. Umarım ilham perisi, kısa bir anlığına da olsa seni ziyaret eder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lauma"
				},
				{
					"id": 765010119,
					"content": "En ilham veren anını yakalayacağım, merak etme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010120
					]
				},
				{
					"id": 765010113,
					"content": "Senin bir fotoğrafını çekmek istiyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010114
					]
				},
				{
					"id": 765010108,
					"content": "Genelde buralarda mı oluyorsun Lauma?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010109
					]
				},
				{
					"id": 765010103,
					"content": "Bir yandan da fotoğraf çekmek için malzeme arıyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765010104
					]
				}
			]
		},
