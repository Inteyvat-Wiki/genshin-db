			"dialogs": [
				{
					"id": 705430101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430102
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430102,
					"content": "... Miyav.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430103
					],
					"speakerTitle": "Duman"
				},
				{
					"id": 705430103,
					"content": "... Bu sizsiniz! Ben konuşuyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430104
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430104,
					"content": "Konuşuyorum... Razor, Duman'la mı konuşuyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430105,
					"content": "Miyav, miyav miyav.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430106
					],
					"speakerTitle": "Duman"
				},
				{
					"id": 705430106,
					"content": "Duman herhalde... \"Tamam\" demeye çalışıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430107,
					"content": "Tanıdık bir koku, arkadaş arıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430108
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430108,
					"content": "Güzel. Mutluyum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430109
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430109,
					"content": "Miyav miyav.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430110
					],
					"speakerTitle": "Duman"
				},
				{
					"id": 705430110,
					"content": "Arkadaşlar kokuyu takip etti. Sen de geldin, mutlu oldum. Üzerinde, yağmur ve rüzgarın kokusu var, çok tanıdık geldi... Kedilerin kokusu da çok tanıdık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430111
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430111,
					"content": "Paimon, çok tatlı koku. İyi kokuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430112
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430112,
					"content": "Tatlı mı? Valerina'nın verdiği kreplerden dolayı olabilir mi? Pa-Paimon o kadar çok yedi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430113,
						705430114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430113,
					"content": "Kendi hakkımın yarısını sana vermiştim, hatırladın mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705430115
					]
				},
				{
					"id": 705430115,
					"content": "Gerçekten mi? Paimon hiç farkına bile varmadı... Mmm, hepsi kreplerin suçu, çok lezzetlilerdi Paimon ne yapsın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430116,
					"content": "Hehe, Paimon Çiçekli Tavuklar, Biftekler ve Mücver de yemek istiyor... Ve tabii yanında biraz da Elma Şırası!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430117,
					"content": "#Pekala, sonraki öğünün menüsü bu o zaman! Hadi bakalım {NICKNAME}, gidip Valerina'dan sipariş verelim! Sen de bizimle gel Razor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430118,
					"content": "Teşekkürler... Teşekkür ederim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430119
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430119,
					"content": "Duman bana sürüyle... Fındık getirmiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430120
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430120,
					"content": "Ve kutulu etler... Çok doydum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430121
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 705430121,
					"content": "Valerina'ya verdiğimiz siparişler geldi galiba. Duman, senin yemeklerini de getirdi mi Razor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430122,
					"content": "Miyav miyav. Miyav!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430123
					],
					"speakerTitle": "Duman"
				},
				{
					"id": 705430123,
					"content": "Pisicik Kalesi'nde kedilerin müşterilerle ilgileneceği Paimon'un ölse bile aklına gelmezdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705430124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430124,
					"content": "Görünüşe bakılırsa kedilerle aran epey iyi, ha Razor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705430114,
					"content": "Önemli değil, az önce yediğinin en az üç katını daha yersin sen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705430115
					]
				}
			]
		}
	]
}