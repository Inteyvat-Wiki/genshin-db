					"Haypasia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30000101,
					"content": "Artık Sumeru'da olduğumuza göre Sumeru Şehri'ne gitmemiz ve Devi Kusanali'yle tanışmanın bir yolunu bulmamız gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30000102,
					"content": "Bu arada konu Devi Kusanali'den açılmışken, hakkında pek fazla şey duymamış olsak da, senin kardeşini kaçıran tanrı o değil gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30000103,
					"content": "Sonuçta herkes Sumeru'ya \"Bilgelik Ulusu\" diyor. Bilgelik Tanrısı ile tanışma fırsatı bulursak belki o bize yararlı bilgiler verebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30000104,
					"content": "Tamamdır, güzel plan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000105
					]
				},
				{
					"id": 30000105,
					"content": "Ama, şey... Paimon, Sumeru Şehri'ne nasıl gidileceğini bilmiyor... Şuraya, Yedilerin Heykelinin olduğu yere mi tırmansak? Oradan her şeyi daha rahat görebiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30000106,
					"content": "Şehrin nerede olduğunu göremesek bile yakınlardaki küçük yerleşimleri görebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30000107,
					"content": "Bir saniye, bak! İleride biri var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30000108,
					"content": "İyi denk geldi! Kaybolmuş maceracılar gibi dolanıp durmaktansa yol sorabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30000109,
					"content": "Merhaba. Şey... Biz buraları pek bilmiyoruz ve sanırım kaybolduk... Yol sormak istiyorduk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30000110,
					"content": "Nasıl ya? Paimon'u duymadı mı? HEY! Sana diyorum! Bize yolu tarif edebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30000111,
					"content": "Ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000112
					],
					"speakerTitle": "Haypasia"
				},
				{
					"id": 30000112,
					"content": "Ne oluyor ya? Duymamış olması mümkün değil... Bir saniye! Bizi görmezden geliyor olabilir mi? Bu ne cüret!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000113,
						30000114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30000113,
					"content": "Sakin ol, ortada sinirlenecek bir şey yok...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000115
					]
				},
				{
					"id": 30000115,
					"content": "Hıh! Neyse, belki gittiği yerde yolu tarif edecek başka birilerini bulabiliriz. Mesafemizi koruyarak onu takip edelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30000116,
					"content": "Birilerini görürsek yolu onlara sorarız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30000114,
					"content": "Belki de bizi görmezden gelmesinin bir nedeni vardır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000115
					]
				}
			]
		},
		{
			"id": 300003,
			"completionStepIds": [
				300003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300003",
							"2"
						],
						"stepId": 300003,
						"stateName": "QUEST_STATE_UNFINISHED"
