			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Haypasia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30000301,
					"content": "Nasıl ya? Şu küçük şelalenin yanına gitti ve bir anda ortadan kayboldu! Gidip daha yakından bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30000302,
					"content": "Paimon bu mağaranın köy gibi bir yere çıkacağını düşünmüştü ama anlaşılan öyle değilmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30000303,
					"content": "Bak, orada oturuyor. Bir saniye... O burada yaşıyor olamaz, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30000304,
					"content": "Ah, şimdi ne yapacağız? Ondan yolu tarif etmesini tekrar isteyelim mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000305,
						30000307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30000305,
					"content": "Evet, bir daha deneyelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000306
					]
				},
				{
					"id": 30000306,
					"content": "Pekala, zaten soracak başka kimse de yok... Cana yakın davranmasına da gerek yok, gitmemiz gereken yönü parmağıyla işaret etse bile yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30000309,
					"content": "Mmm! Ne güzel bir koku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30000310,
					"content": "Şuradaki buhurdanlıktan geliyor. Burası bildiğimiz evlere benzemiyor, orası kesin ama sahiden güzel kokuyor! Hımm, belki de burada yaşamak çok da kötü değildir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30000311,
					"content": "Off! Eyvah...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000312
					]
				},
				{
					"id": 30000312,
					"content": "Ne oldu? Pek iyi görünmüyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000313,
						30000314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30000313,
					"content": "Bu koku...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000315
					]
				},
				{
					"id": 30000315,
					"content": "Nasıl yani? Koku seni rahatsız mı etti? Çok tuhaf, Paimon bir şey hissetmiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30000316,
					"content": "(Buradan gitmem gerek!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000317
					]
				},
				{
					"id": 30000317,
					"content": "(Sanırım... Bayılacağım...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000318
					]
				},
				{
					"id": 30000318,
					"content": "#Neler oluyor? {NICKNAME}? Uyumanın sırası değil! Uyansana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30000314,
					"content": "Bunda... Bir terslik var!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000315
					]
				},
				{
					"id": 30000307,
					"content": "Onu rahatsız etmesek daha iyi olur sanki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30000308
					]
				},
				{
					"id": 30000308,
					"content": "Hımm, meditasyon gibi bir şey yapıyor. Onu rahatsız edersek muhtemelen bunu bizim yanımıza bırakmaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30000309
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 300010,
			"completionStepIds": [
				300010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300010",
							"2"
						],
						"stepId": 300010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Collei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30001001,
					"content": "Ciddi bir şey olmadığına emin misin? Gezgin uzun süredir baygın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30001002,
					"content": "Artık rahatlayabilirsin. İnan bana Usta çok bilgilidir. Eğer onun iyi olacağını söylüyorsa, kesinlikle endişelenecek bir şey yok demektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001003
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30001003,
					"content": "Ah, uyandın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001004
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30001004,
					"content": "#Ah, şükürler olsun! Sonunda uyandın {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30001005,
					"content": "Neredeyim ben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001006
					]
				},
				{
					"id": 30001006,
					"content": "Şey, biz... Güzel soru, neredeyiz biz? Paimon o kadar panik oldu ki nerede olduğumuzu sormayı bile unuttu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30001007,
					"content": "Burası Gandharva. Sumerulu alimler tarafından yağmur ormanı içinde bir dinlenme yeri olarak inşa edilmiş. Şimdi ise Orman Muhafızlarının üssü olarak kullanılıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001008
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30001008,
					"content": "Merhaba benim adım Collei. Ben Acemi Orman Muhafızıyım. Ustamla birlikte devriye gezerken seni baygın halde bulduk ve buraya getirdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001009
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30001009,
					"content": "Yardım ettiğiniz için teşekkür ederim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001010
					]
				},
				{
					"id": 30001010,
					"content": "Hayır, hayır, teşekkür etmene gerek yok! Bir şey yapmadık ki. Bu arada nasıl hissediyorsun? Bir rahatsızlığın var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001011,
						30001012
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30001011,
					"content": "Hayır, iyi gibiyim. Sadece...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001013
					]
				},
				{
					"id": 30001013,
					"content": "Haha... O tat Ustanın bitkisel ilacının tadı. Baygınken sana ilaç vermişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001014
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30001014,
					"content": "Unutmadan söyleyeyim, Usta sen uyandıktan sonra tekrar ilaç içmen gerektiğini söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001015
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30001015,
					"content": "Eyvah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001016
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30001016,
					"content": "Collei, ne oldu? İlacı mı almaya çalışıyordun? Sana daha önceden de söyledim, bu konuda dikkatli olmalısın... Buradaki işim bitince getiririm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001017
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30001017,
					"content": "Özür dilerim Usta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001018
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30001018,
					"content": "*iç çeker* \"Avidya Ormanı'ndaki Yenilebilir Mantarlar Rehberi\" artık ilan panosunda net bir şekilde okunabilir. Ama eğer Farbod uzak durması gereken mantarları bir kez daha unutursa rehberi daha görünür bir yere koymam gerekecek. Mesela alnının ortasına asabilirim, böylece etrafındakiler ona dikkatli olması gerektiğini hatırlatabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001019
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30001019,
					"content": "Evet, bu ay ikinci kez gıda zehirlenmesiyle geliyor. Onunla bir konuşsam iyi olacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001020
					],
					"speakerTitle": "Nasrin"
				},
				{
					"id": 30001020,
					"content": "Evet, iyi olur. Farbod'un arzusu, önünde dans eden hayali periler görmekse onu kendi haline bırakırız. Ama bir dahaki sefere bizden ilaç almaya geldiğinde fiyatı da ona göre belirle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001021
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30001021,
					"content": "Pekala, sen nasılsın? Daha iyi hissediyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001022
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30001022,
					"content": "Ah, işte Ustam Orman Gözcüsü Tighnari. Gandharva'daki tüm muhafızların başıdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001023
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30001023,
					"content": "Paimon'a neden bayıldığını açıklamıştım, şimdi sen uyandığına göre sana da açıklayabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001024
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30001024,
					"content": "Bazı Darşanlara mensup Sumerulu alimler arasında yaygın bir uygulama vardır. Ücra yerlerde, özellikle de yakınlardaki ormanlarda kendilerini eğitime ve meditasyona adarlar. Meditasyon yaparken zihinlerini sakinleştirmeye yardımcı olması için Ruhani Borneol adında bir tütsü kullanarak derin bir tefekküre dalarlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001025
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30001025,
					"content": "Yolu sorma umuduyla Haypasia isimli alimi mağarasına kadar takip ettiniz. İçerideyken kokladığın şey ise bahsettiğim Ruhani Borneol tütsüsüydü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001026
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30001026,
					"content": "O tütsü çoğu kişi için zararsızdır. Ama senin de bizzat tecrübe ettiğin gibi bazılarının bilinci üzerinde büyük etkiler bırakabilir. Anlatabiliyor muyum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001027
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30001027,
					"content": "Evet, anladım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001028
					]
				},
				{
					"id": 30001028,
					"content": "Çok iyi. Peki bayıldıktan sonra bir şey hissettin mi? Beden dışı bir deneyim yaşadın mı ya da baygınken herhangi bir şey gördün mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001029
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30001029,
					"content": "Baygınken gördüklerini anlatıyorsun...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						30001030
					]
				},
				{
					"id": 30001030,
					"content": "Hım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001031
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30001031,
					"content": "Collei, diğerlerine haber ver. Devriye kayıtlarını bir süre buraya getirmesinler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001032
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30001032,
					"content": "Hı? N-Neden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001033
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30001033,
					"content": "Çünkü bu ikisi önümüzdeki birkaç gün burada kalacak. Benim odamda kalabilirler, ben de Amir'le kalırım. Şimdi kalk ve sana ne dediysem onu yap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001034
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30001034,
					"content": "Şey, tabii Usta Tighnari!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001035
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30001035,
					"content": "Bir saniye! Bize neler olduğunu anlatır mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001036
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30001036,
					"content": "Tabii, anlatırım. Aslında ilacın bittiğinde seni yolcu etmeyi düşünüyordum. Fakat daha iyi gözlem yapabilmek adına sen toparlanana kadar bir süre daha burada, Gandharva'da kalsan daha iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001037
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30001037,
					"content": "Gözlem mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001038
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30001038,
					"content": "Ama bizim Sumeru Şehri'ne gitmemiz lazım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001039
					]
				},
				{
					"id": 30001039,
					"content": "Aceleci davranmaya gerek yok. Tüm olanları sana açıkladıktan sonra, doğruyu yanlışı ayırt edebildiğin sürece emin ol durumun ciddiyetini anlayacaksın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001040
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30001040,
					"content": "Tütsüyü koklayıp bilincini yitirdikten sonra gördüklerine bakılacak olursa güçlü bir halüsinasyon görmüşsün. Bu da akli durumunun çok da iyi bir halde olmadığını gösterir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001041
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30001041,
					"content": "İnandırıcı gelmediyse şunu bir kokla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001042
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30001042,
					"content": "Aaa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001043
					]
				},
				{
					"id": 30001043,
					"content": "Ayy, sen iyi misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001044
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30001044,
					"content": "Bayıldığın zamana benzer bir şey yaşıyorsun, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001045
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30001045,
					"content": "Durumun şimdilik stabil ama öylece gitmene izin verseydim büyük ihtimalle yine bir yerde bayılıp kalacaktın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001046
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30001046,
					"content": "Yağmur ormanı içinde birçok vahşi hayvan ve tehlikeli bölge var. Orada başına bir şey gelseydi şansın o kadar yaver gitmeyebilirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001047
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30001047,
					"content": "Sen şimdilik her gün ilaçlarını almaya devam et ve tek başına dolaşmamaya özen göster, en azından bu tarz kokuların olumsuz etkilerini yaşamayı bırakana kadar, olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001048
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30001048,
					"content": "Pekala...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001049
					]
				},
				{
					"id": 30001049,
					"content": "Mmm, güzel. Sana bir kase daha ilaç hazırlayacağım, sen de bu sırada dinlenmeye devam et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001050
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30001050,
					"content": "*iç çeker* Sumeru'ya daha yeni geldik. Başımıza gelmeyen kalmadı resmen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001051
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30001051,
					"content": "Paimon Devi Kusanali'yle bir an önce görüşmeye gitmemiz gerektiğini biliyor ama gerçekten iyi görünmüyorsun. Önce seni iyileştirsek daha iyi olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001052
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30001052,
					"content": "Hey! Paimon'u dinliyor musun sen? Paimon burada senin için endişeleniyor yahu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001053
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30001053,
					"content": "Bir tuhaflık var...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001054
					]
				},
				{
					"id": 30001054,
					"content": "Tuhaf mı? Kendini tuhaf mı hissediyorsun yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001055,
						30001056
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30001055,
					"content": "Evet, bedenimde de bir tuhaflık var ama asıl demek istediğim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001057
					]
				},
				{
					"id": 30001057,
					"content": "Gördüğün ağaç kökleri ve kızıl gökyüzünden mi bahsediyorsun? Ama halüsinasyon değilse neydi o zaman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001058
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30001058,
					"content": "Emin değilim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001059
					]
				},
				{
					"id": 30001059,
					"content": "(Bunları görürken yer altının derinliklerindeymişim gibi hissettim. Ama kızıl gökyüzü... Acaba orası Khaenri'ah mıydı?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001060
					]
				},
				{
					"id": 30001060,
					"content": "Senin ne kadar eşsiz biri olduğunu düşününce, Paimon senin vardığın sonuçlara güveniyor. Ama neden bundan Tighnari'ye bahsetmedin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001061
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30001061,
					"content": "Eğer durumunu yanlış değerlendirdiyse daha kötüye gitme ihtimalin de var, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001062,
						30001063
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30001062,
					"content": "Öyle olduğunu sanmıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001064
					]
				},
				{
					"id": 30001064,
					"content": "Nasıl? Tighnari senin gördüklerinin halüsinasyon olmadığını biliyor muydu yani? Eğer öyleyse bunu bizden neden saklamaya çalışsın ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001065
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30001065,
					"content": "Ben de tam olarak bunu merak ediyorum. Bu meselenin özüne inmeliyiz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001066
					]
				},
				{
					"id": 30001066,
					"content": "Paimon şimdi anladı... Demek o yüzden o kadar sessizdin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001067
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30001067,
					"content": "O halde karar verilmiştir. İyice dinlenmek ve gördüğün halüsinasyonları anlamak için burada kalıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001068
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30001068,
					"content": "Ama sanırım artık Tighnari'ye sormak gibi bir seçeneğimiz kalmadı... Sence ne yapmalıyız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001069
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30001069,
					"content": "Collei ile konuşarak başlayabiliriz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001070
					]
				},
				{
					"id": 30001070,
					"content": "İyi fikir. Collei bayağı cana yakın biri... Yarın ondan Doğa Hükümdarı ve Sumeru gelenekleriyle ilgili bilgi alabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30001071
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30001071,
					"content": "Gece boyunca dinleniyorsunuz...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 30001063,
					"content": "O muhtemelen bize doğruyu söylemiyordu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001064
					]
				},
				{
					"id": 30001056,
					"content": "Gördüğüm şeylerin halüsinasyon olduğunu sanmıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001057
					]
				},
				{
					"id": 30001012,
					"content": "Ağzımda bir tat var... Çok acı!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30001013
					]
				}
			]
		}
	]
}