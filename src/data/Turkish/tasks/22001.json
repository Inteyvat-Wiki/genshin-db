					"speakerTitle": "Minik Fei"
				},
				{
					"id": 220010603,
					"content": "Yardımcı kaptan olmaktan nefret ediyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010604
					],
					"speakerTitle": "Minik Fei"
				},
				{
					"id": 220010604,
					"content": "Lulu ve Meng sadece kendilerini düşünüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010605
					],
					"speakerTitle": "Minik Fei"
				},
				{
					"id": 220010605,
					"content": "Arrr! Orada değerli bir şeyler mi görüyorum yoksa? Verin bakalım onları bana!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010606
					]
				},
				{
					"id": 220010606,
					"content": "Aa, merhaba korsan. Üzgünüm, ben fakir bir yardımcı kaptanım, üzerimde çalabileceğin hiçbir şey yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
