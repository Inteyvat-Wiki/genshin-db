			"dialogs": [
				{
					"id": 220010301,
					"content": "İşte geldik! Kaptan bu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010302
					],
					"speakerTitle": "Minik Fei"
				},
				{
					"id": 220010302,
					"content": "Korsanları buraya getirerek ne yaptığını sanıyorsun sen? Lulu ve bana kaçacak zaman kazandırmak için onları oyalaman gerekiyordu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010303
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 220010303,
					"content": "Neden sen ve Lulu kaçıyorsunuz da ben burada korsanları oyalamak zorunda kalıyorum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010304
					],
					"speakerTitle": "Minik Fei"
				},
				{
					"id": 220010304,
					"content": "Daha iyi bir fikrim var. Seni korsanlara teslim edeyim ve Lulu'yla ben kaçayım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010305
					],
					"speakerTitle": "Minik Fei"
				},
				{
					"id": 220010305,
					"content": "Ama... Beidou dostlarını asla terk etme demişti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010306
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 220010306,
					"content": "Hadi ya? Beidou, kaptan tehlikeli bir durumla karşılaşır karşılaşmaz en sevdiği kişiyi alıp kaçmalıdır da demiş miydi acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010307
					],
					"speakerTitle": "Minik Fei"
				},
				{
					"id": 220010307,
					"content": "Seni küçük... Seninle bir daha ASLA Nilüfer Başlarımı paylaşmayacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010308
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 220010308,
					"content": "İYİ! O aptal Nilüfer Başlarını senden başka kimse umursamıyor zaten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010309
					],
					"speakerTitle": "Minik Fei"
				},
				{
					"id": 220010309,
					"content": "Olayı fazla abartıyorlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220010310,
					"content": "Merak etme, bu olayı nasıl çözeceğimizi biliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010311
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 220010311,
					"content": "Bu dünyada en sevdikleri şey Nilüfer Başlarıdır... En sevdikleri yiyeceği verirsek kesin sakinleşirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010312
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 220010312,
					"content": "Birkaç Nilüfer Başı bulabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010313,
						220010315
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 220010313,
					"content": "Tamam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010314
					]
				},
				{
					"id": 220010314,
					"content": "Teşekkür ederim! Biraz çabuk olman lazım ama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 220010315,
					"content": "Nilüfer Başları yüzünden kavga etmiyorlar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010316
					]
				},
				{
					"id": 220010316,
					"content": "Hı... Öyle mi? Niye ediyorlar o zaman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010317
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 220010317,
					"content": "Neyse, birkaç Nilüfer Başı getiriver. Kavga etmelerine bütün gün seyirci kalamayız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Minik Lulu"
				}
			]
		},
