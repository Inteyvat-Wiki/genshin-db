			"dialogs": [
				{
					"id": 220010101,
					"content": "Meng, bugün kaptan ben olabilirim, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010102
					],
					"speakerTitle": "Minik Fei"
				},
				{
					"id": 220010102,
					"content": "Lulu, ben uzun süredir art arda kaptan oluyorum. Artık sıranın Fei'ye gelmesi lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010103
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 220010103,
					"content": "Ama Meng, en iyi kaptan sensin! Ben senin devam etmeni istiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010104
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 220010104,
					"content": "Ne yapıyorsunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010105
					]
				},
				{
					"id": 220010105,
					"content": "Oyun oynamaya çalışıyoruz. Bu sefer kaptan olacağıma söz vermişlerdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010106
					],
					"speakerTitle": "Minik Fei"
				},
				{
					"id": 220010106,
					"content": "Ama Meng kaptan olunca oyun daha eğlenceli oluyormuş, Lulu öyle söylüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010107
					],
					"speakerTitle": "Minik Fei"
				},
				{
					"id": 220010107,
					"content": "*iç çeker* Lulu hep böyle yapıyor... Ama madem öyle istiyor... İyi, öyle olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010108
					],
					"speakerTitle": "Minik Fei"
				},
				{
					"id": 220010108,
					"content": "Hey, bize katılmaya vaktin var mı? Korsan olabilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010109,
						220010111
					],
					"speakerTitle": "Minik Fei"
				},
				{
					"id": 220010109,
					"content": "Tamam...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010110
					]
				},
				{
					"id": 220010110,
					"content": "*iç çeker* Yine her zamanki gibi ben yardımcı kaptan oldum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010113
					],
					"speakerTitle": "Minik Fei"
				},
				{
					"id": 220010113,
					"content": "Geçen seferki gibi, hazır olunca yanımıza gel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Minik Fei"
				},
				{
					"id": 220010111,
					"content": "Ama ben iyilerden biri olmak istiyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010112
					]
				},
				{
					"id": 220010112,
					"content": "*iç çeker* Of, kaptan olmayı o kadar istiyorum ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010113
					],
					"speakerTitle": "Minik Fei"
				}
			]
