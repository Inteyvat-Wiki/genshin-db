					"nextDialogs": [
						220010404
					],
					"speakerTitle": "Minik Fei"
				},
				{
					"id": 220010404,
					"content": "Hayır, sen çok kabasın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010405
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 220010405,
					"content": "Kavga etmeyi bırakın. Yalnızca kendinizi yoruyorsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010406
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 220010406,
					"content": "Bu alt tarafı bir oyun. Bu kadar sinirlenmenin anlamı yok. Hepimiz arkadaşız sonuçta, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010407
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 220010407,
					"content": "Hem bakın bende ne var... Taze toplanmış Nilüfer Başları! Alın hadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010408
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 220010408,
					"content": "Bunları bir yiyin, gerisini hallederiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010409
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 220010409,
					"content": "Hangi sırayla kimin kaptan, kimin yardımcı kaptan olacağına karar vereceğiz. Tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010410
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 220010410,
					"content": "Peki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010411
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 220010411,
					"content": "Tamam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010412
					],
					"speakerTitle": "Minik Fei"
				},
				{
					"id": 220010412,
					"content": "Vay be, gerçekten de işe yaradı! Nihayet huzur geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220010413,
					"content": "Size söylemiştim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010414,
						220010416
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 220010414,
					"content": "İşe yarayacağını nereden bildin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010415
					]
				},
				{
					"id": 220010415,
					"content": "Uzun süredir birlikte oynuyoruz. Böyle şeyleri bilirim ben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 220010416,
					"content": "Aferin sana, çok iyisin Minik Lulu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220010417
					]
				},
				{
					"id": 220010417,
					"content": "Hehe, teşekkürler. Asıl iyi olan Beidou ama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220010418
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 220010418,
					"content": "Umarım büyüyünce onun gibi olabilirim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Minik Lulu"
