			},
			"dialogs": [
				{
					"id": 191010101,
					"content": "Mmm... Kedi Kuyruğu'ndaki içecekler. Fena değil... Hiç fena değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010102
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010102,
					"content": "Kedi Kuyruğu mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191010103
					]
				},
				{
					"id": 191010103,
					"content": "Ah, sen miydin Gezgin? Kedi Kuyruğu'nu hiç duymadın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010104
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010104,
					"content": "Yüzündeki ifadeye bakılırsa orayı gerçekten duymamışsın. Neler kaçırdığını ah bir bilsen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010105
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010105,
					"content": "Kedi Kuyruğu, inanılmaz özel içecekleriyle ünlü bir mekan. Daha önce hiç tatmadığın içeceklerle dolu bir yerden bahsediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010106
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010106,
					"content": "Ayrıca adından da anlayabileceğin üzere Kedi Kuyruğu'nda bir sürü tatlı kedicik var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010107
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010107,
					"content": "Özel bir kokteylin tadını çıkarırken, bir yandan da tatlı kediciklerle oynaşmak... Zamanın nasıl akıp gittiğini fark edemiyorsun bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010108,
						191010109
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010108,
					"content": "Kedi Kuyruğu şu anda hâlâ açık mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191010110
					]
				},
				{
					"id": 191010110,
					"content": "Iı, görünüşe bakılırsa içmeye yaşın tutmuyor gibi ama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010111
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010111,
					"content": "Şey, o sorun olmaz, Diona da orada olacak çünkü. Mondstadt'taki en iyi barmendir o!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010112
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010112,
					"content": "Bir çırpıda alkolsüz bir şeyler hazırlar o sana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010113
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010113,
					"content": "Ah, ayrıca Diona çok tatlı... Minik bir kedicik gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010114
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010114,
					"content": "*hık* Hayır, olamaz... Bunu dışımdan mı söyledim? Iı, lütfen bunu söylediğimi ona söyleme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010115
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010115,
					"content": "Neyse, Kedi Kuyruğu'nu kendin görmek istersen girişi hemen arkada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010116
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010116,
					"content": "Ben gidip... *hık* Biraz ayılacağım, beşinciyi içecek halde değilim şu an sanırım... Zaten çok fazla içtim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 191010109,
					"content": "Gidip görmek isterim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191010110
					]
				}
			]
		}
	]
}