			"dialogs": [
				{
					"id": 761850101,
					"content": "Mmm, çay da atıştırmalıklar da nefis. Beni ağırladığınız için teşekkür ederim Bayan Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850102
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850102,
					"content": "Beğendiğinize sevindim. Ashru'yu da unutmadım tabii, ona da atıştırmalık bir şeyler getirdim. Değil mi Ashru? Gel bakalım buraya. Aferin sana, uslu kedicik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850103
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761850103,
					"content": "Miyav.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850104
					],
					"speakerTitle": "Ashru"
				},
				{
					"id": 761850104,
					"content": "Umarım Nod-Krai'a ve Sırlar Arşivi'ne beslediğiniz samimi duyguların gelecekteki iş birliğimize de faydası dokunur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850105,
					"content": "Ben de öyle umuyorum. Al bakalım Ashru, bunlardan dene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850106
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761850106,
					"content": "Ayrıca daha önce sorduğum meseleye gelirsek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850107
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850107,
					"content": "Hehe, minik patilerin yumuşacık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850108
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761850108,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850109
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850109,
					"content": "Bayan Sandrone... Yoksa bu çay saatini sırf buraya gelip kedimi şımartmak için bir kılıf olarak mı kullandınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850110
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850110,
					"content": "Ne? B-Ben mi? Ne münasebet! Sırlar Arşivi ile olan işlerimi son derece ciddiye alıyorum ben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850111
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761850111,
					"content": "Ashru, gel buraya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850112
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850112,
					"content": "Miyav.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850113
					],
					"speakerTitle": "Ashru"
				},
				{
					"id": 761850113,
					"content": "Yaa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850114
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761850114,
					"content": "O zaman şu \"işlerimizin\" ayrıntılarını bir konuşalım, ne dersiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850115
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850115,
					"content": "... Hıh. N-Ne olmuş yani Ashru'yu birazcık seveyim dediysem... Kim istemez ki bunu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850116
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761850116,
					"content": "Küçük hayvanlar makinalara karşı genelde temkinlidir. Burada numerolojik dizilim üzerinde çalışırken Ashru'nun güvenini kazanmak için az uğraşmadım. Alt tarafı göbeğini şöyle bir iki okşamak istemişim, nesi kabahat ki bunun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850117
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761850117,
					"content": "Hah... Hemen savunmaya geçmenize gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850118
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850118,
					"content": "Git bakalım Ashru. Kiminle haşır neşir olacağını sana söylemek bana düşmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850119
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850119,
					"content": "Miyav.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850120
					],
					"speakerTitle": "Ashru"
				},
				{
					"id": 761850120,
					"content": "Ama sevme faslı bitince konuşmamız gereken işler olduğunu unutmayın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850121
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850121,
					"content": "Dedim ya, işlerimizi gayet ciddiye alıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kukla"
				}
			]
		},
