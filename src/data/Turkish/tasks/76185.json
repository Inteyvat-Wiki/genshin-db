			"dialogs": [
				{
					"id": 761850201,
					"content": "Yanında şöyle işe yarar bir istihbarat olunca çayın tadına doyum olmuyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850202,
						761850203
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850202,
					"content": "(Biraz daha oturalım.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850204
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761850204,
					"content": "Kendinize iyi bakın. Müsait oldukça uğramayı ihmal etmeyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761850203,
					"content": "Yavaş yavaş toparlansam iyi olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761850204
					],
					"speakerTitle": "Kukla"
				}
			]
