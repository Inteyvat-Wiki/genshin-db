			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721150101,
					"content": "#Merhaba sevgili cesur {F#kız}{M#çocuk}! Mikage Ocağı hakkında bir iyi bir de kötü haberim var. Önce hangisini duymak istersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150102,
						721150106
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150102,
					"content": "Önce iyi haberi duyalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150103
					]
				},
				{
					"id": 721150103,
					"content": "İyi haber, çekirdek sadece birkaç ufak hasar almış. Hâlâ onarabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150104,
					"content": "Kötü haber ise oralarda bir şeyler arayan Fatui bu haberi iyi karşılamadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150105
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150105,
					"content": "Pis elleriyle Tatarigami çekirdeğine ulaşmaya çalışıyor gibilerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150111
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150111,
					"content": "Ama biraz daha kurcalamalarına izin verirsek Tatarigami'nin gücü kontrolden çıkacak. Tüm ada bizimle beraber havaya uçacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150112
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150112,
					"content": "Buna karşın sadece Fatui'ye odaklanırsak güvenlik kubbesinin içinde biriken Tatarigami enerjisi sonunda yine sınırına ulaşacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150113
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150113,
					"content": "Yani ikisini aynı anda mı halletmemiz gerekiyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150114
					]
				},
				{
					"id": 721150114,
					"content": "Basitçe anlatmak gerekirse, teorik olarak, nesnel anlamda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150115
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150115,
					"content": "İki farklı sorunla karşı karşıyayız: Fatui ve Tatarigami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150116
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150116,
					"content": "Fakat Mikage Ocağı'ndaki durum göz önüne alındığında hangi sorunu çözmeye karar verirsek verelim, büyük ihtimalle o sırada diğer sorunla da yüzleşmemiz gerekecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150117
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150117,
					"content": "Yani işin aslı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150118
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150118,
					"content": "\"Evet\" demek istedin galiba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150119
					]
				},
				{
					"id": 721150119,
					"content": "Evet, doğru. İkisini aynı anda halletmemiz gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150120
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150120,
					"content": "Adım adım ilerlememiz lazım. Bir Liyue atasözünün de dediği gibi \"Sıcak tofuyu yemek için acele etme, yoksa dilini yakarsın.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150121
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150121,
					"content": "Sen Liyue atasözlerini nereden biliyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150122
					]
				},
				{
					"id": 721150122,
					"content": "Daha önce Liyue'ye gitmiştik. Bu bilgece söz geziden hatıra kaldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150123
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150123,
					"content": "Daha bir sürü var böyle. İtiraf etmeliyim ki Mondstadt'tan aldığım tüm \"hatıralarımı\" çoktan kullandım... Çok iyilerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150124
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150124,
					"content": "Konumuza dönelim. Mikage Ocağı'nı onarmak için ufak bir planım var fakat yardımınıza ihtiyacım olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150125,
						721150127
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150125,
					"content": "Tamamdır!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150126
					]
				},
				{
					"id": 721150126,
					"content": "Dobra ve savaşa hazır! İşte bu yüzden seviyorum seni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150131
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150131,
					"content": "Öhöm. Konudan saptım. Bu Dedektör İşaretçileri al lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150132
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150132,
					"content": "Bunları benim için birkaç yere yerleştirmen gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150133
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150133,
					"content": "Bu Dedektör İşaretçiler, Mikage Ocağı'nın içindeki Tatarigami enerjisinin yoğunluğu ve dağılımı hakkında veri toplayacak. Bu veriyi aldığımızda daha detaylı bir plan yapabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150134,
						721150136
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150134,
					"content": "O zaman bana güvenebilirsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150135
					]
				},
				{
					"id": 721150135,
					"content": "Aynen öyle yapacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150141
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150141,
					"content": "İşaretçilerin yerlerini haritanda işaretleyeceğim. Sana güveniyorum Gezgin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150136,
					"content": "Bu işaretçiler nasıl çalışıyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150137
					]
				},
				{
					"id": 721150137,
					"content": "Basitçe anlatmak gerekirse her türde enerjiyi ölçüp hesaplamak için element enerjisini kullanan araçlar bunlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150138
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150138,
					"content": "\"Basitçe\" dedim ama anlatması o kadar kolay değil aslında... Fakat yedi element teorisinden başlayabiliriz sanırım! Şimdi bak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150139
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150139,
					"content": "Yok, anlatmana gerek yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150140
					]
				},
				{
					"id": 721150140,
					"content": "Nasıl istersen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150141
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150127,
					"content": "Benim kazancım ne olacak peki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150128
					]
				},
				{
					"id": 721150128,
					"content": "Hımm... Adanın keşfedilmemiş hazineleri ve Mikage Ocağı'nın içinde \"kalan malzemeler\"e ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150129
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150129,
					"content": "Mikage Ocağı'nın içinde önemli şeyler olduğuna eminim, Inazuma'daki en büyük üretim tesisi sonuçta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150130
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150130,
					"content": "Tabii Önseziye sahip olmayan biri olarak şu anda Mikage Ocağı'na giremiyorum ve içeride olanları bilemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150131
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150106,
					"content": "*iç çeker* Kötü haberi duyalım hadi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150107
					]
				},
				{
					"id": 721150107,
					"content": "Kötü haber, Fatui hâlâ Ocağın içinde bir şeyler arıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150108
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150108,
					"content": "Pis elleriyle Tatarigami çekirdeğine ulaşmaya çalışıyor gibilerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150109
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150109,
					"content": "İyi haber ise çekirdek çok zarar görmemiş, yani onu onarabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150110
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150110,
					"content": "Tabii bunu duymak Fatui'nin hiç hoşuna gitmeyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150111
					],
					"speakerTitle": "Xavier"
				}
			]
		},
