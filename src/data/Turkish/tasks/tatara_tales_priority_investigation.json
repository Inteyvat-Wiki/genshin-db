			"dialogs": [
				{
					"id": 721150301,
					"content": "İşaretçileri yerleştirdin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150302
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150302,
					"content": "Evet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150303
					]
				},
				{
					"id": 721150303,
					"content": "Güzel, şimdi veri toplamalarını bekleyeceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150304,
						721150308
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150304,
					"content": "İşaretçileri nereye koyacağını nereden bildin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150305
					]
				},
				{
					"id": 721150305,
					"content": "Mikage Ocağı'ndaki tasarım ekibindeydim. İşaretçileri belirlediğimiz yerlere yerleştirerek neredeyse içerideki her bölgeden veri toplayabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150306
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150306,
					"content": "Hımm, bu yerlere arındırıcı cihazlar yerleştirseydik sorunumuz bir gecede çözülebilirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150307
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150307,
					"content": "Bay Flois burada olanları duysa kafayı yerdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150311
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150311,
					"content": "Pekala, yardımların için teşekkürler. Lütfen karşılığında bunları kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150312
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150312,
					"content": "Bir mesele daha var... Sana muhtemelen, belki de, yani kesinlikle birkaç gün içinde o işaretçileri toplamak için tekrar ihtiyacım olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150313
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150313,
					"content": "Benim Önsezim yok sonuçta, o kadar yüksek Tatarigami enerjisinin olduğu bir yere elimi kolumu sallayarak giremem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721150314
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150314,
					"content": "Zorlu Fatui'nin hâlâ orada olduğunu söylememe gerek yok zaten. Bu adada hem onları hem de ocak meselesini aynı anda gerçekten halledebilecek tek kişinin sen olduğunu düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721150308,
					"content": "Bu işaretçiler satılık mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721150309
					]
				},
