			"dialogs": [
				{
					"id": 708250401,
					"content": "*iç çeker* Yardım edecek birkaç kişi daha olsaydı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250402,
						708250406
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250402,
					"content": "Diğer şövalyeler ne yapıyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708250403
					]
				},
				{
					"id": 708250403,
					"content": "Şehrin savunmalarını onarmakla, yıkılan yerleri yeniden inşa etmekle ve birkaç ufak tefek işle uğraşıyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250404
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250404,
					"content": "Her şövalyemiz şu an çok meşgul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250405
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250405,
					"content": "Ana kapıda nöbet tutmak, kısmen daha kolay bir görev oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250406,
					"content": "Maceracılar Loncasından yardım talep edebilirsiniz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708250407
					]
				},
				{
					"id": 708250407,
					"content": "Aslında başından beri yardım ettikleri için çok şanslıyız. Başta, şehirdeki afetzedeleri bulup kurtarmamıza yardım ediyorlardı. Son zamanlarda ise şehir dışındaki canavarların hareketlerini takip etmeye başladılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250408
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250408,
					"content": "Canavarlar şehrin etrafında toplanmaya başladığında, maceracıların keşif sırasında durumu fark edip bize bildirmesi sayesinde net ve etkili savunma planları yapabildik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250409
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250409,
					"content": "Şu an bile şehri eski haline getirmek için yaptığımız çalışmalarda bize çok destek oluyorlar. Onlar olmasa, Şövalyeler bunca yükün altında ezilirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708250410
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 708250410,
					"content": "Zaman ayırıp Cyrus'a teşekkür etmeye gitmeliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
		},
