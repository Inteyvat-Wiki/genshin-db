					"nextDialogs": [
						250290308
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290308,
					"content": "... Evet, biliyorum. Senin için biraz zor olacak galiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290309
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290309,
					"content": "Gidip şu tırmanma süresi konusunda Mayta'dan yardım isteyeceğim sanırım. Belki o bize daha uygun bir idman planı hazırlayabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290310
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290310,
					"content": "Neyse, yardımların için çok teşekkür ederim. Al, bu Cacahuatl senin olsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290311
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290311,
					"content": "Ellerimizle topladık. Taptaze, çok lezzetli çikolata olur bundan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290312
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290312,
					"content": "Aruuuu, aruuuu!",
