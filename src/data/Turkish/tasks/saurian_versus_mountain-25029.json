			},
			"dialogs": [
				{
					"id": 250290201,
					"content": "Uslu çocuk seni, aferin! Bugün karnın doydu, değil mi? İdmana hazır mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290202
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290202,
					"content": "Raarr, aruu, raaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290203
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290203,
					"content": "Bakıyorum da bugün pek bir enerjiğiz! Süper o zaman, hadi başlayalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290204
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290204,
					"content": "Oo, hadi bakalım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290206
					]
				},
				{
					"id": 250290206,
					"content": "Hı? Aa, selam! Dağ tırmanışı idmanı yapıyorduk biz de.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290207
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290207,
					"content": "Raaa! Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290208
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290208,
					"content": "Ruuu, raahh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290209,
						250290212
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290209,
					"content": "İdman nasıl gidiyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290210
					]
				},
				{
					"id": 250290210,
					"content": "Şey... \"İlerleme kaydediyoruz\" diyebilirim. Qica bu sefer çok daha yükseğe tırmandı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290211
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290211,
					"content": "Qica senin dağ tırmanma yöntemini pek bilmiyor da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290216
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290216,
					"content": "Bize bir kez daha gösterebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290217,
						250290221
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290217,
					"content": "Elbette gösteririm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290218
					]
				},
				{
					"id": 250290218,
					"content": "Çok teşekkürler! Bu sefer hareketlerini net bir şekilde görebileceğim bence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290219
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290219,
					"content": "Sen de gözünü dört aç, tamam mı Qica?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290220
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290220,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290223
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290223,
					"content": "Sana güveniyoruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290224
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290224,
					"content": "Bu yüzden sen tırmanırken biz zaman tutalım en iyisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290225
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290225,
					"content": "Hurruu, rruu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290221,
					"content": "Bu sefer dikkatlice izleyin, tamam mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290222
					]
				},
				{
					"id": 250290222,
					"content": "Elbette! Qica ile bu sefer hiçbir şeyi kaçırmayacağız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290223
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290212,
					"content": "Görüyorum ki gittikçe iyileşiyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290213
					]
				},
				{
					"id": 250290213,
					"content": "Aynen öyle. Annem benim de ona giderek daha iyi baktığımı söylüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290214
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290214,
					"content": "Qica öyle gelişme kaydetti ki. Geçen seferkinden çok daha yükseğe tırmanabiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290215
