					"nextDialogs": [
						250290303
					]
				},
				{
					"id": 250290303,
					"content": "Öyle mi? Bundan daha hızlı tırmanabilir misin yani? Vay canına. Gerçekten de usta bir maceracısın demek ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
