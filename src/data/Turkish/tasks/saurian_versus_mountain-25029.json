			"dialogs": [
				{
					"id": 250290101,
					"content": "Hadi hadi, cesaretin kırılmasın hemen. Önce iyileş, sonra denemeye devam edersin! Sonra bir bakmışız, göz açıp kapayıncaya kadar dağın zirvesine çıkmışsın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290102
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290102,
					"content": "Guruuu... Guruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290103
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290103,
					"content": "Aç mısın? Hımm... O halde sana yiyecek bir şeyler getireyim ben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290104
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290104,
					"content": "Huruu... Aruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290105
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290105,
					"content": "Ne yapıyorsunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290106
					]
				},
				{
					"id": 250290106,
					"content": "Arkadaşım Qica ile oynuyorum. Şimdilik ufak tefek bir şey ama annem büyüyünce onun da tıpkı diğer Yumkazorlar gibi olacağını söylüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290107
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290107,
					"content": "Huruu... Rruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290108
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290108,
					"content": "Üzülme canım. Şu anda bedenin çok güçsüz, o yüzden böyle. Daha önce yaralanmıştın üstelik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290109
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290109,
					"content": "Annem iyileşeceğini söylüyor. Güzelce beslenip benimle idman yapman gerek sadece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290110
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290110,
					"content": "Ruu? Rruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290111,
						250290113
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290111,
					"content": "(Qica'yı sev.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290112
					]
				},
				{
					"id": 250290112,
					"content": "Guruuu... Guruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290119
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290119,
					"content": "Haha, zaman su gibi akıp geçmiş resmen. Yakında idmanımız var, bir şeyler yesek iyi olur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290120
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290120,
					"content": "Bu kurutulmuş meyveleri annem hazırladı! Önce onları büyük bir tencerenin içinde kızarttı, sonra da içine bir sürü mis kokulu çeşni ekledi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290121
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290121,
					"content": "Üstüne birazcık da şeker ve yaprak serpiştirdi... Tadı öyle güzel ki! Bekle, sana da biraz vereyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290122
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290122,
					"content": "Bir dakika ya. Kurutulmuş meyvelerim nereye kayboldu? Çantama koyduğumdan eminim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290123
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290123,
					"content": "... Huruu, Raarr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290124
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290124,
					"content": "Yok artık! Qica! Hepsini yedin mi yoksa? Açgözlülük yapma dememiş miydim ben sana? Bu kadar yersen hareket etmekte zorlanırsın bak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290125
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290125,
					"content": "... Raaarr, arruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290126,
						250290127
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290126,
					"content": "İştahlı olmak iyidir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290128
					]
				},
				{
					"id": 250290128,
					"content": "Hraaa, raarrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290129
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290129,
					"content": "Öyle mi? E o zaman ben de Qica gibi olmak istiyorum. Çok yiyip hızlıca büyümek ve anneme yardımcı olmak istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290130
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290130,
					"content": "Peki o zaman Qica! İdmana başlayalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290131
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290131,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290132
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290132,
					"content": "Hımm... Bugün dağa tırmanmayı deneyelim mi, ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290133
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290133,
					"content": "R-Raarr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290134
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290134,
					"content": "Aa, oluyor mu ama böyle? Halledersin sen. Geçen seferki gibi yapacağız, hiç de zor olmayacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290135
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290135,
					"content": "... Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290136
					],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290136,
					"content": "Doğru ya, Yawar Amca geçen sefer bana doğru düzgün idman yapacaksak uygun bir \"idman hedefi\" bulmamız gerektiğini söylemişti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290137
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290137,
					"content": "Keşke gerçek bir maceracı olsa da birkaç hedef belirleme konusunda bana yardım etse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290138,
						250290139
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290138,
					"content": "Gayet gerçek bir maceracıyım aslında ben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290140
					]
				},
				{
					"id": 250290140,
					"content": "Öyle mi? Şey... O zaman bana yardım eder misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290141,
						250290142
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290141,
					"content": "İkinizi dağ tırmanışına mı götürmemi istiyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290143
					]
				},
				{
					"id": 250290143,
					"content": "Dur biraz. Bu işte o kadar iyiysen sana ayak uyduramayız ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290144
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290144,
					"content": "Bu yüzden sen tırmanırken biz zaman tutalım en iyisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290145
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290145,
					"content": "Pekala, şimdi sen şu dağa olabildiğince hızlı tırman. Sana güveniyoruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290146
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290146,
					"content": "Raarr! Raaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qica"
				},
				{
					"id": 250290142,
					"content": "Peki. Beni takip edin de başlayalım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290143
					]
				},
				{
					"id": 250290139,
					"content": "Gerçek bir maceracı mı dedin? Gökte ararken yerde buldun o zaman.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290140
					]
				},
				{
					"id": 250290127,
					"content": "Çok yiyen çok güçlenir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290128
					]
				},
				{
					"id": 250290113,
					"content": "Nasıl yaralandı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250290114
					]
				},
				{
					"id": 250290114,
					"content": "Bilmiyorum... Annem biliyordur belki. Qica'yı eve ilk getirdiğinde zaten hastaydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290115
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290115,
					"content": "Yemek yiyemiyordu, hareket edemeyecek kadar güçsüzdü. Tek yapabildiğim her gün suda ilaç çözündürüp ona içirmekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290116
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290116,
					"content": "Sonunda iyileşti ama... Bedeni hâlâ çok güçsüz. Diğer Yumkazorlar gibi yamaçlarda koşturamıyor haliyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290117
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290117,
					"content": "Onun adına çok üzücü bir durum... O yüzden bir an önce eski haline dönmesine ve tüm Yumkazorlardan güçlü olmasına yardımcı olmaya çalışıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290118
					],
					"speakerTitle": "Tlatem"
				},
				{
					"id": 250290118,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250290119
					],
					"speakerTitle": "Qica"
				}
			]
		},
