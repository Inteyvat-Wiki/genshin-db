			"dialogs": [
				{
					"id": 110400301,
					"content": "Özür dilerim, gerçekten onu başka nasıl tarif ederim bilmiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400302
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400302,
					"content": "Yapabilsem portresini çizerdim size. Ama benim çizim yeteneğim onunkinin yanında hiçbir şey.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sucrose"
				}
			]
		},
		{
			"id": 1104004,
			"completionStepIds": [
				1104004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104004",
