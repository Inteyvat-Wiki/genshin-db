				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rosaria"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110400401,
					"content": "R-Rahibe Rosaria, işte buradasın! Koro provası başlamak üzere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400402
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 110400402,
					"content": "Söyledim ya sana, öyle şeylere katılmam. Yapacak daha önemli işlerim var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400403
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400403,
					"content": "Ama... Bu anma töreni çok önemli. Kilise bütün rahibelerin geleceğini umuyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400404
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 110400404,
					"content": "\"Ummak\" mı? Tuhaf. Başkalarının umutlarını gerçekleştirmek ne zamandan beri benim işim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400405
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400405,
					"content": "Ama... Haklısın ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400406
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 110400406,
					"content": "Ama ne? Töreni sen düzenlemedin mi? Sana da garip gelmiyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400407
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400407,
					"content": "N-Ne demek istiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400408
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 110400408,
					"content": "Mondstadt'a bu kadar uzakta, bu saatte... Şimdi yola çıksan bile eminim açılış törenini kaçırırsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400409
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400409,
					"content": "Kim bilir? Belki birileri seni küçük düşürmek için planlamıştır bunu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400410
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400410,
					"content": "Ne! O-Olamaz ki! İnsanlar öyle şeyler yapmaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400411
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 110400411,
					"content": "Haha! İnsanların ne kadar iyi olduğu yaptıklarıyla anlaşılır, hislerinle değil. *iç çeker* Belki insanlara fazla güveniyorsundur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400412
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400412,
					"content": "Merak etme. Bensiz dönsen bile kimse seni suçlamayacak. Başka kimsenin provaya geleceğimi düşünecek kadar hayalperest olduğunu düşünmüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400413
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400413,
					"content": "Ama biraz daha oyalanırsan gerçekten yetişemeyeceksin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400414
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400414,
					"content": "... Haklısın! Anma töreni çok önemli. Gecikirsem... T-Tamam, gitmem lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400415
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 110400415,
					"content": "Hımm... Anlaşılan şu rahibe insanları istediği şeye inandırmakta çok yetenekli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400416,
					"content": "Bir ses duyduğumu biliyordum. Kimsiniz siz? Neden gizlice beni dinliyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400417
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400417,
					"content": "Dikkatli olalım! Tehlikeli ve kötü biri galiba... Ya da en azından bir sahtekar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400418,
					"content": "Öyle mi? Ben köklü Favonius Kilisesinin bir üyesiyim. Sen ise kim bilir nereden gelen bir cinsin. Bir de BANA MI sahtekar diyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400419
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400419,
					"content": "Nasıl duydu onu? Paimon çok sessizce fısıldamıştı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400420,
					"content": "Şu takip ettiğin yabancıya gelince... Demek sensin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400421
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400421,
					"content": "Bizi Fırtına Dehşeti'nden kurtaran Fahri Şövalye. İtibarından dolayı sana neden beni gizlice dinlediğini sormayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400422
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400422,
					"content": "Aksi takdirde vereceğin yanıta göre seni anında tutuklayabilirdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400423
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400423,
					"content": "Ne! Mondstadt rahibelerinin artık insanları tutuklama yetkisi mi var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400424,
					"content": "Gizli tehlikeleri yok sayamayız değil mi? Rahibeler neden adaletten anlamasın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400425
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400425,
					"content": "Hımm... Mantıklı gelmedi bana. Ama Paimon verecek güzel bir cevap bulamadı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400426,
					"content": "Sana gelince... Senin dağlarda ne işin var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400427,
						110400428
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400427,
					"content": "Albedo'yu arıyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400431
					]
				},
				{
					"id": 110400431,
					"content": "Eğer onu arıyorsanız bıraktığı izleri görmüştüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400432
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400432,
					"content": "Kar fırtınasından sonra çok insan tepeye çıktı. Umarım izler kaybolmamıştır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400433
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400433,
					"content": "Yani... Sen de mi onu arıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400434,
					"content": "Hayır, sadece mesleki bir alışkanlık. Bıraktığı izlerde element kalıntıları hissetmiştim. Tetikte olmaktan zarar gelmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400435,
						110400436
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400435,
					"content": "Bildiğim rahibelere kıyasla epey gizemlisin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400437
					]
				},
				{
					"id": 110400437,
					"content": "Ne düşündüğün beni ilgilendirmez. Haydi o zaman. Albedo'nun ne yaptığını merak ediyordum zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400436,
					"content": "Mesleğin daha çok dedektiflik gibi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400437
					]
				},
				{
					"id": 110400428,
					"content": "Bu dünyanın gerçeklerini araştırıyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400429
					]
				},
				{
					"id": 110400429,
					"content": "Ama sen sadece bir gezginsin. Simyadan pek anlayacağını sanmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400430
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 110400430,
					"content": "Neyse, kimi aradığınızı tahmin edebiliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400431
					],
					"speakerTitle": "Rosaria"
				}
			]
		},
		{
			"id": 1104005,
