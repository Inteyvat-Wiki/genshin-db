			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sucrose"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110400501,
					"content": "Ha? Görünüşe göre Timaeus bugün gelmemiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400502,
					"content": "(Bekle, bu ikisi yoksa...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400503
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400503,
					"content": "#Ah! Şey... Merhaba {NICKNAME}, merhaba Paimon. Timaeus'u mu arıyordunuz acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400504
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400504,
					"content": "Yok, hayır! Sadece burada olmamasına şaşırdık. Paimon onu hep burada görürdü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400505,
					"content": "Anladım. Biraz önce Albedo çağırınca gitti. Benden de dükkana bakmamı rica etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400506
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400506,
					"content": "Eğer yardıma ihtiyacınız olursa seslenebilirsiniz. Olmazsa... Şurada... Kitap okuyacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400507
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400507,
					"content": "#Tamam, teşekkürler! Merak etme, simya konusunda oldukça bilgiliyizdir. Değil mi {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400508,
					"content": "Evet, zahmet etmene gerek yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400509
					]
				},
				{
					"id": 110400509,
					"content": "Fırtına Dehşeti'ni defeden kişinin bunu demesine şaşırmamak lazım sanırım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400510
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400510,
					"content": "Aslında siz... Siz eminim Albedo'ya yardım edebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400511
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400511,
					"content": "İşte yine o isim, \"Albedo\". Sen ve Timaeus geçen sefer buluştuğumuzda da ondan bahsetmiştiniz, değil mi? O da Mondstadt'ta bir simyacı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400225,
						110400226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400225,
					"content": "İsmi tanıdık gelmiyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400227
					]
				},
				{
					"id": 110400227,
					"content": "Özür dilerim, anlatmadım size. Albedo, Favonius Şövalyelerinin Baş Simyageridir. Ayrıca Timaeus ve benim öğretmenimizdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400228
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400228,
					"content": "Ama Paimon sadece Timaeus'un ders verdiğini gördü. Yani... Albedo öğretmenlerin öğretmeni mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400229,
					"content": "Evet. Kendini bu dünyanın gerçeklerini keşfetmeye adamış ve çok sayıda yeni buluşa imza atmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400230
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400230,
					"content": "Genelde Teyvat'ın dört bir yanından simyagerler Mondstadt'a, Albedo'dan yardım istemeye gelir. Bay Albedo'nun vereceği en ufak tavsiyenin en akılalmaz sorunları bile çözmeye yardımcı olduğunu söylerler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400231
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400231,
					"content": "Vay be! Paimon Albedo'nun bu kadar önemli biri olduğunu bilmiyordu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400232,
					"content": "Evet. Yine de son zamanlarda araştırmalarında bir sorun yaşıyor gibi. Her gördüğümde yüzünde endişeli bir ifade oluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400233,
						110400234
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400233,
					"content": "Onun gibi zeki birinin benim yardımıma ihtiyaç duyacağını sanmıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400235
					]
				},
				{
					"id": 110400235,
					"content": "Eminim Albedo inanılmaz hikayelerinizi dinlemek isteyecektir, bunlardan ilham alacağına şüphe yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400236
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400236,
					"content": "Albedo gerçek bir centilmendir. Yardımınızın karşılığını hakkıyla ödeyecektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400237,
						110400239
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400237,
					"content": "Güçlenmemi sağlayabilir mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400238
					]
				},
				{
					"id": 110400238,
					"content": "Neden olmasın? Canlıların kapasitesini zorlamak da Albedo'nun araştırma alanlarından biri sonuçta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400241
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400241,
					"content": "Albedo ve Timaeus şimdi dağlarda deney yapıyordur. İkinizi de Albedo'nun yanına götürmek isterdim ama birilerinin dükkana bakması lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400242
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400242,
					"content": "Ne yazık ki tek başınıza geçidin girişine gidip Albedo'yu aramanız gerekecek. Gerçek bir alim havası olan kaliteli bir centilmen görürseniz odur. Bir de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400243
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400243,
					"content": "... Üzgünüm aklıma başka bir şey gelmedi. Elinizden geleni yapmaya çalışın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400244
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400244,
					"content": "Bırak artık endişelenmeyi! Hallederiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400239,
					"content": "Paimon'u güçlendirebilir mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400240
					]
				},
				{
					"id": 110400240,
					"content": "Paimon'un o konuda yardıma ihtiyacı yok. Fakat Albedo, yardım ettiği için Paimon'a teşekkür etmek isterse birkaç Mora vermesi yeter. Hehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400234,
					"content": "Basit bir şeyler üretecek kadar simya biliyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400235
					]
				},
				{
					"id": 110400226,
					"content": "Daha önce duydum galiba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400227
					]
				}
			]
		}
	]
}