			},
			"dialogs": [
				{
					"id": 110400201,
					"content": "Hımm, görünüşe göre Timaeus bugün gelmemiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400202,
					"content": "(Müşteri!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400203
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400203,
					"content": "Affedersiniz. Timaeus'a mı bakmıştınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400204
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400204,
					"content": "Hayır, hayır! Sadece burada olmamasına şaşırdık. Paimon onu hep burada görürdü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400205,
					"content": "Anladım. Biraz önce Albedo çağırınca gitti. Dükkana bakmam için beni çağırdılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400206
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400206,
					"content": "Ben Sucrose, Albedo'nun asistanıyım. Simyagerlikle ilgili herhangi bir sorunuz olursa her zaman bana sorabilirsiniz. Elimden... Geldiğince yardımcı olurum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400207,
						110400209
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400207,
					"content": "Bir daha alalım, kendine güvenerek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400208
					]
				},
				{
					"id": 110400208,
					"content": "Bu işlerde pek iyi değilim aslında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400211
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400211,
					"content": "Öz-Özür dilerim. Çok dışarı çıkmıyorum. Genelde laboratuvarda dururum. Konuşacak çok insan olmuyor orada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400212
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400212,
					"content": "Eğer yardıma ihtiyacınız olursa seslenebilirsiniz. Olmazsa... Şurada... Kitap okuyacağım. Evet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400213
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400213,
					"content": "#Tamam, teşekkürler! Merak etme, simya konusunda oldukça bilgiliyizdir değil mi {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400214,
						110400215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400214,
					"content": "Evet, zahmet etmene gerek yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400216
					]
				},
				{
					"id": 110400216,
					"content": "#{NICKNAME}... Sen şu efsane Gezgin değil misin? Fırtına Dehşeti'ni engelleyen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400217,
						110400218
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400217,
					"content": "\"Efsane\" biraz fazla olur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400220
					]
				},
				{
					"id": 110400220,
					"content": "Hakkında birçok hikaye duydum! Hep seni yakından incelemek istemiştim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400221
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400221,
					"content": "\"İncelemek\" mi? Nasıl yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400222,
					"content": "Özür dilerim, boş verin. Ne diyorum ben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400223
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400223,
					"content": "Yine de kesinlikle Albedo'ya yardım edebilirsiniz. Efsanesiniz sonuçta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400224
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400224,
					"content": "Yine o isim! \"Albedo\". O da mı Mondstadt'ta bir simyager?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400225,
						110400226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400225,
					"content": "İsmi tanıdık gelmiyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400227
					]
				},
				{
					"id": 110400227,
					"content": "Özür dilerim, anlatmadım size. Albedo, Favonius Şövalyelerinin Baş Simyageridir. Ayrıca Timaeus ve benim öğretmenimizdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400228
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400228,
					"content": "Ama Paimon sadece Timaeus'un ders verdiğini gördü. Yani... Albedo öğretmenlerin öğretmeni mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400229,
					"content": "Evet. Kendini bu dünyanın gerçeklerini keşfetmeye adamış ve çok sayıda yeni buluşa imza atmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400230
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400230,
					"content": "Genelde Teyvat'ın dört bir yanından simyagerler Mondstadt'a, Albedo'dan yardım istemeye gelir. Bay Albedo'nun vereceği en ufak tavsiyenin en akılalmaz sorunları bile çözmeye yardımcı olduğunu söylerler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400231
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400231,
					"content": "Vay be! Paimon Albedo'nun bu kadar önemli biri olduğunu bilmiyordu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400232,
					"content": "Evet. Yine de son zamanlarda araştırmalarında bir sorun yaşıyor gibi. Her gördüğümde yüzünde endişeli bir ifade oluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400233,
						110400234
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400233,
					"content": "Onun gibi zeki birinin benim yardımıma ihtiyaç duyacağını sanmıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400235
					]
				},
				{
					"id": 110400235,
					"content": "Eminim Albedo inanılmaz hikayelerinizi dinlemek isteyecektir, bunlardan ilham alacağına şüphe yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400236
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400236,
					"content": "Albedo gerçek bir centilmendir. Yardımınızın karşılığını hakkıyla ödeyecektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400237,
						110400239
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400237,
					"content": "Güçlenmemi sağlayabilir mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400238
					]
				},
				{
					"id": 110400238,
					"content": "Neden olmasın? Canlıların kapasitesini zorlamak da Albedo'nun araştırma alanlarından biri sonuçta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400241
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400241,
					"content": "Albedo ve Timaeus şimdi dağlarda deney yapıyordur. İkinizi de Albedo'nun yanına götürmek isterdim ama birilerinin dükkana bakması lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400242
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400242,
					"content": "Ne yazık ki tek başınıza geçidin girişine gidip Albedo'yu aramanız gerekecek. Gerçek bir alim havası olan kaliteli bir centilmen görürseniz odur. Bir de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400243
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400243,
					"content": "... Üzgünüm aklıma başka bir şey gelmedi. Elinizden geleni yapmaya çalışın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400244
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400244,
					"content": "Bırak artık endişelenmeyi! Hallederiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400239,
					"content": "Paimon'u güçlendirebilir mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400240
					]
				},
				{
					"id": 110400240,
					"content": "Paimon'un o konuda yardıma ihtiyacı yok. Fakat Albedo, yardım ettiği için Paimon'a teşekkür etmek isterse birkaç Mora vermesi yeter. Hehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110400234,
					"content": "Basit bir şeyler üretecek kadar simya biliyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400235
					]
				},
				{
					"id": 110400226,
					"content": "Daha önce duydum galiba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400227
					]
				},
				{
					"id": 110400218,
					"content": "Evet, hem de imza isteyenlerden para bile almıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400219
					]
				},
				{
					"id": 110400219,
					"content": "Teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400220
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 110400215,
					"content": "Ben tekrar bir baksam iyi olur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400216
					]
				},
				{
					"id": 110400209,
					"content": "Stres yapmana gerek yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400210
					]
				},
				{
					"id": 110400210,
					"content": "Ne? S-Stresli mi duruyorum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400211
					],
					"speakerTitle": "Sucrose"
				}
			]
		},
