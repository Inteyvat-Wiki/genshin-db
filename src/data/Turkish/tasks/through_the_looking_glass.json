			"dialogs": [
				{
					"id": 741401101,
					"content": "Yine karşılaştık... Aa, bu sefer Paimon'la mı geldin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401102
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401102,
					"content": "Ne? En son meditasyon yaptığımızda Paimon da buradaydı zaten...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401103,
					"content": "Öyle mi? Hiç hatırlamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401104
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401104,
					"content": "Neyse artık. Sayenizde Sırlar Aynasının ve açmak üzere olan çiçeklerin yerini bulabildim, burası hakkında da çok daha fazla şey öğrendim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401105
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401105,
					"content": "Hımm... Canotila'yı anlamak her zamanki gibi zor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401106,
					"content": "Hav!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401107
					]
				},
				{
					"id": 741401107,
					"content": "Efendim? İyi ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401108
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401108,
					"content": "Hav, hav!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401109
					]
				},
				{
					"id": 741401109,
					"content": "Tamam, tamam! Seni anladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401110
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401110,
					"content": "(Yavru köpekle mi konuşuyor o? Melusinalar köpeklerle iletişim kurabiliyor mu yoksa?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401111,
					"content": "(Akılalmaz bir durum.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401112
					]
				},
				{
					"id": 741401112,
					"content": "Eh, öyle olsun o zaman. Sonra görüşürüz. Hıh! Ne dersen de... Seninle oynamaya yine geleceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401113
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401113,
					"content": "#Hadi gidelim {M#Bay}{F#Bayan} {NICKNAME}, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				}
			]
		},
