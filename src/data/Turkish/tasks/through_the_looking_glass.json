					}
				]
			},
			"dialogs": [
				{
					"id": 741401301,
					"content": "İşte yine geldik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401302
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401302,
					"content": "Ne oldu ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401303,
					"content": "Sizler bana o kadar iyi davranıyorsunuz ki bunu söylemeye dilim varmıyor resmen ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401304
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401304,
					"content": "Sizce de gerçek dünya korkunç sıkıcı bir yer değil mi? Kitapta anlatılan dünya buraya bin basar bence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401305,
						741401307,
						741401309
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401305,
					"content": "Bence de.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401306
					]
				},
				{
					"id": 741401306,
					"content": "Gerçekten mi? Sen de mi öyle düşünüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401311,
					"content": "Bana sorarsanız en güzeli Esinleme Kitabında anlatılan dünya. Orada her yer çiy taneleriyle ıslanmış yapraklarla dolu. Üstelik yavru köpekle arkadaş da olabildim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401312
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401312,
					"content": "Yavru bir köpek... Iıı, sen köpeklerle konuşabiliyor musun Canotila?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401313,
					"content": "Ne? Yok canım, nasıl konuşayım. Esinleme Kitabındaki köpek özel de o yüzden. Hımm... Ya da belki özel olan benimdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401314
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401314,
					"content": "Kitaptaki saklı o dünyaya girebilmek için meditasyon yapıyordum. Derken bir gün bir baktım, sürekli havlamalarını duyduğum köpeği artık anlayabiliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401315
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401315,
					"content": "Ne konuştuğumuzu soracak olursanız... Buradan git ve bir daha gelme dedi bana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401316
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401316,
					"content": "Ama ben ayçiçeklerinin açacağı anı görmek istiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401317
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401317,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401318
					]
				},
				{
					"id": 741401318,
					"content": "Şey... Demek öyle! O zaman hadi kendine iyi bak Canotila! Biz gidelim artık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741401307,
					"content": "Bana pek öyle gelmiyor doğrusu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401308
					]
				},
				{
					"id": 741401308,
					"content": "Öyle mi? Haklı olabilirsin tabii. Belki bende bir tuhaflık vardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401311
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741401309,
					"content": "Benim için her türlü hava hoş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741401310
					]
				},
				{
					"id": 741401310,
					"content": "#{M#Bay}{F#Bayan} {NICKNAME} rakip tanımıyor tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741401311
					],
					"speakerTitle": "Canotila"
				}
			]
		}
	]
