			"dialogs": [
				{
					"id": 746950101,
					"content": "Selamlar Leydi Trismegistus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950102
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950102,
					"content": "Ha? Ne kusursuz bir telaffuz... Ortak bir dostumuz var anlaşılan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950103
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950103,
					"content": "Hizmetlerinizi Bayan Columbina önerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950104
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950104,
					"content": "Bayan Columbina gerçekten öngörülemeyen biri. Eminim sürprizlerle dolu bir karşılaşma olmuştur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950105
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950105,
					"content": "Hem de nasıl. \"Öngörülemeyen\" mükemmel bir kelime seçimi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950106
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950106,
					"content": "Tanıştığımıza memnun oldum. Ben Wriothesley.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950107
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950107,
					"content": "Demek su altının dükü kanlı canlı karşımda. Sizinle tanışmak bir zevk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950108
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950108,
					"content": "Sizin gibi büyük bir büyücünün beni duymuş olabileceğini hiç düşünmezdim. Onur duydum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950109
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950109,
					"content": "Yoksa gelişimi yıldızlardan mı okudunuz Leydi Trismegistus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950110
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950110,
					"content": "Hehe... Madem birbirimizi tanıyoruz, resmiyeti bir kenara bırakalım. Bana Barbeloth diyebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950111
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950111,
					"content": "O zaman sen de bana Wriothesley de. Madem resmi bir iş yapmıyoruz, unvanlara da lüzum yok. Ben sadece mesai dışındaki vaktinin tadını çıkaran sıradan bir Fontaine vatandaşıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950112
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950112,
					"content": "Buraya gelirken fırından yeni çıkmış sıcacık Kabuk Madlen Kekler gördüm. Büyücülerin çay keyfi yapmayı sevdiğini duymuştum, buyur bir tane al lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950113
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950113,
					"content": "Ah, bizim çay saatlerinin en gözde tatlılarından biridir bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950114
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950114,
					"content": "Epeydir buradayım ve pek çok kişinin falına baktım ama ilk defa biri böyle eli dolu geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950115
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950115,
					"content": "Çok sağ ol Bay Wriothesley. Bunu Alice ve diğerleriyle de paylaşacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950116
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950116,
					"content": "... Kulaklarım mı çınlıyor ne? Barbie! Mutlaka bana da ayır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950117
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950117,
					"content": "Sakın Nicole ben gelmeden hepsini silip süpürmesin! Daha önce yaptı sonuçta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950118
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950118,
					"content": "Öhöm! Tamam tamam, sana da biraz ayırmasını söylerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950119
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950119,
					"content": "Cidden bula bula bu zamanı mı buldun? Ben burada yeni dostumuzun karşısında Cadılar Meclisinin itibarını korumaya çalışıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950120
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950120,
					"content": "Hiç sorun değil. Ne zararı olabilir ki? Güçlü insanların her zaman ciddi olması gerekmiyor sonuçta. Herkesin kendi kişiliğini biraz da olsa yansıtmaya hakkı var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950121
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950121,
					"content": "Aynen öyle! Aslına bakarsan iyimserlik ve neşe, Cadılar Meclisine kabul edilmenin olmazsa olmaz şartlarıdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950122
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950122,
					"content": "Ben bunu ilk defa duyuyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950123
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950123,
					"content": "Şimdi uydurduğum yeni bir kural bu! Sonuçta Cadılar Meclisinin dünyaya mutluluk getirmesi gerek. Haliyle neşeli ve iyimser olmamızdan daha doğal ne olabilir ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950124
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950124,
					"content": "Kendi adıma konuşacak olursam, herkes hayatın tadını dilediği gibi çıkarabilmeli diye düşünüyorum. Tabii hiçbir yasanın çiğnenmemesi şartıyla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950125
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950125,
					"content": "Alice'in o şarta uymasını sağlamak biraz zor olabilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950126
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950126,
					"content": "Oo, bu olmadı işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950127
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950127,
					"content": "Hâlâ burada olduğumun farkındasınız, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950128
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950128,
					"content": "Hem zaten Meropide Kalesi'nin müdürünün gözü önünde yasa dışı bir işe kalkışacak değilim ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950129
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950129,
					"content": "... Hem kalkışsaydım bile, muhtemelen odalarınız Favonius Şövalyelerinin hücrelerinden daha ferahtır. Öyle değil mi Bay Wriothesley?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950130
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950130,
					"content": "Haha! Sanki basit bir hücre hapsi senin gibi efsanevi bir büyücüyü zapt edebilirmiş gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950131
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950131,
					"content": "Leydi Alice'in, o dillere destan alçak gönüllülüğü ve sarsılmaz dürüstlüğüyle bu cezayı kendi rızasıyla kabul ettiğinden en ufak bir şüphem yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950132
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950132,
					"content": "Kesinlikle. Çok doğru dedin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950133
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950133,
					"content": "Lütfen yapma Bay Wriothesley. Ona yüz vermesen iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950134
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950134,
					"content": "Keyfi bir yerine geldi mi Alice'in ne yapacağı hiç belli olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950135,
						746950136
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950135,
					"content": "Ne demek istediğini çok iyi biliyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950137
					]
				},
				{
					"id": 746950137,
					"content": "#Aynen öyle! {NICKNAME} Favonius Şövalyelerinin Fahri Şövalyesi sonuçta! Öyle hücre hapsi odasının arkasından atıp tutmak yok, hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746950138,
					"content": "Yani kaçan büyücülerin peşine düşmek Fahri Şövalyeye mi kaldı? Harika bir gösteri olacak desenize. Lütfen beni de davet etmeyi unutmayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950139
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950139,
					"content": "Ortalığın karışmasını izlemekten resmen keyif alıyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746950140,
					"content": "Yine de Paimon senin buraya kendi başına gelmeni beklemiyordu Wriothesley. Bizi seni almak için ta su altına inme zahmetinden kurtardın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746950141,
					"content": "Kehanetin gücü olsa gerek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950142
					]
				},
				{
					"id": 746950142,
					"content": "Ha, bu arada işe koyulma vaktimiz geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950143
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950143,
					"content": "Bay Wriothesley, ister Bayan Columbina'nın hatırına ister o tatlı ikramına teşekkür olarak lütfen bir Ay Arkanası çek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950144
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950144,
					"content": "Belki de içinde kaderin bir armağanı gizlidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950145
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950145,
					"content": "Bu bir kehanet sayılır mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950146
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950146,
					"content": "Öyle denebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950147
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950147,
					"content": "Öyleyse hiçbir Fontainelinin bunu ciddiye almama ihtimali yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950148
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950148,
					"content": "Kart çekme işini ne kadar ciddiye alacağını söyledikten sonra Wriothesley doğrudan en üstteki karta uzanır...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						746950149
					]
				},
				{
					"id": 746950149,
					"content": "Bu kartlara pek aşina olduğum söylenemez. Galiba bu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950150
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950150,
					"content": "Düz İmparator...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950151
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950151,
					"content": "Nutkun tutuldu sanki... Yoksa kötü bir kart mı? Merak etme, her ne söyleyeceksen kaldırabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950152
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950152,
					"content": "... Tam aksine. Bu kart sonsuz bir hakimiyetin ve sarsılmaz bir iktidarın habercisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950153
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950153,
					"content": "Eğer bu senin geleceğini temsil ediyorsa hedefine çoktan ulaşmışsın demektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950154
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950154,
					"content": "Ancak... Hehe, kaderin durmadan ilerlemeye ve sürekli değişmeye devam ediyor, ki bu da tek bir anlama gelebilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950155
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950155,
					"content": "Belki de asıl değişenin insanın kendisi değil, çevresi olduğu anlamına mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950156
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950156,
					"content": "Hıhı... En azından şimdilik gerçekten de böyle bir eğilim var gibi duruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950157
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950157,
					"content": "Öyleyse sanırım bundan böyle içgüdülerimi dinlerken biraz daha özgüvenli olabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950158
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950158,
					"content": "Daha önce resmi bir görevle Nod-Krai'da bulunmuş ve epey bir fikir edinmiştim. O gün bugündür ister istemez oranın yerel haberlerini takip ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950159
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950159,
					"content": "Sonra bir gece, her zamankinden daha parlak bir aya bakarken dünyanın artık değiştiğini düşünmeden edemedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950160
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950160,
					"content": "Dünya zaten sürekli değişiyor ama işin içine bu kadar büyük değişkenler girince, hepimizin bizi bekleyen bilinmezliğe hazır olması lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950161
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950161,
					"content": "Gerçi seçtiğin karta bakarsak senin pek dert etmene gerek yok. Etrafında ne değişirse değişsin, ya ayak uydurmanın ya da direnmenin bir yolunu bulabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950162
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950162,
					"content": "Ne güzel! Demek ki o yumruğu boşuna yememişim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950163,
						746950164
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950163,
					"content": "Güzel dileklerle atılmış bir yumruktu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950165
					]
				},
				{
					"id": 746950165,
					"content": "Haddimi aşmak gibi olmasın ama merak ettiğim bir şeyi sormak istiyorum... Umarım kusura bakmazsın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950166
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950166,
					"content": "Pek kurnazsın! Bizi bilerek meraklandırıyorsun Bay Wriothesley! Mecburen sorman için ısrar edeceğiz artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950167
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950167,
					"content": "O zaman açık konuşayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950168
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950168,
					"content": "Hep merak etmişimdir... Bir kehanet tam olarak nasıl kendi kendini gerçekleştiriyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950169
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950169,
					"content": "Mesela beni düşün. Falıma göre durumum gayet stabil kalacakmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950170
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950170,
					"content": "Ama ya bu kehaneti duyduktan sonra aniden asi bir dürtüye kapılır da hiç düşünmeden bir delilik yapıverirsem? O zaman ne olacak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950171
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950171,
					"content": "Mesela, ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950172
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950172,
					"content": "Ya Meropide Kalesi'ni havaya uçurursan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950173
					]
				},
				{
					"id": 746950173,
					"content": "Aynen, öyle diyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950174
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950174,
					"content": "Cidden yine o mevzuyu mu açıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950175
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746950175,
					"content": "Oooo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950176
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950176,
					"content": "Hayır, sakın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950177
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950177,
					"content": "Haha! Ne güzel tesadüf! Şans bu ya, çok becerikli bir patlayıcı uzmanı tanıyorum. Onu gözüm kapalı tavsiye ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950178
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950178,
					"content": "Ama o zaman Fahri Şövalye kesin ona göz kulak olur, kötü bir şey olmasın diye en kritik anda müdahale eder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950179
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950179,
					"content": "... Ve kehanet de işte böyle gerçekleşir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950180
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950180,
					"content": "Tam bir yıkım makinası gibi duruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950181
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950181,
					"content": "Ayrıca sevimli de. Çok sevimli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950182
					]
				},
				{
					"id": 746950182,
					"content": "Bir dakika, Klee'den mi bahsediyoruz? Wriothesley, Klee'nin Alice'in kızı olduğunu bilmiyordur herhalde, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950183
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746950183,
					"content": "Aslına bakarsan onun tam unvanı Diyarların Büyük Maceracısı, Dodo-Kral ve Eski Mondstadt'ın Koruyucusunun Kızı oluyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950184
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950184,
					"content": "Şimdi bunlarla uğraşacak vaktimiz yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950185
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950185,
					"content": "Peki... Dodo-Kral Alice'in En Sevimli Çocuğu, Gerçek Kıvılcım Şövalyesi Klee diyelim o zaman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950186
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950186,
					"content": "Bence cidden asıl planıma dönüp herkese şöyle harika bir parti vermeliyiz ki hepinizi birbirinizle doğru düzgün tanıştırabileyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950187
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950187,
					"content": "Böylece Klee Fontaine'e geldiğinde beraber çay içebileceği bir sürü yeni arkadaşı olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950188
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746950188,
					"content": "Harika bir fikir. Dört gözle bekliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746950189
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950189,
					"content": "Ne de olsa güzel demlenmiş bir çaya hayır diyecek biri değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 746950164,
					"content": "Büyük badireler atlatanların yüzüne iyi talih gülermiş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950165
					]
				},
				{
					"id": 746950136,
					"content": "Hücre hapsine biraz saygın olsun lütfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746950137
					]
				}
			]
		},
