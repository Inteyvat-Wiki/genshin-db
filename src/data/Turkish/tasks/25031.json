			"dialogs": [
				{
					"id": 250310401,
					"content": "Yardımın için sağ ol...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310402
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310402,
					"content": "Şu lanet çantadan kurtulabilseydim kendi başımın çaresine bakabilirdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310403
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310403,
					"content": "Saçmalama! Natlan'a boşuna gelmiş olurduk o zaman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310404
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310404,
					"content": "Pardon, sen... Alrani misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310405
					]
				},
				{
					"id": 250310405,
					"content": "#Hı? Sen {NICKNAME} değil misin? Evet, sensin gerçekten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310406
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310406,
					"content": "Bu yanındaki hanımefendi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310407
					]
				},
				{
					"id": 250310407,
					"content": "Hazine Avcısı Narzam. Daha önce tanışmıştık. Unuttun mu beni yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310408
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310408,
					"content": "Vay be... Resmen kurtarıcımsın sen! Beni kaçıncı kurtarışın oldu bu? Bir, iki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310409
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310409,
					"content": "Benimle olduğun zamanı saymıyorsundur umarım. Kalmakta ısrar ettiğin için yaşanmıştı çünkü o durum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310410
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310410,
					"content": "Tabii ki saymıyorum onu. Ayrıca kalmakta ısrar ettin ne demek? Paranı ödemiştim zaten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310411
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310411,
					"content": "Evet, yiyecek içeceğimi karşılayacak kadardı ama sadece...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310412
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310412,
					"content": "Yine tezin için mi geldin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310413
					]
				},
				{
					"id": 250310413,
					"content": "Hehe, yani... Harcadığımız saatleri düşünürsek boşa gitmesine izin veremezdim, öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310414
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310414,
					"content": "Bu sefer Akademiden özel bütçe başvurusunda bulundum, hatta olabilecek en orijinal araştırma konusunu da seçtim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310415
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310415,
					"content": "Üstelik Narzam bana korumalık yapıyor. Tüm kötü adamları kovaladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310416
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310416,
					"content": "Zahmete girmelerine değecek bir şey taşımadığımız için de olabilir o...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310417,
						250310418
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310417,
					"content": "Ama sonuç olarak...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310419
					]
				},
				{
					"id": 250310419,
					"content": "... Yankıların Çocuklarından yola çıktığımızdan beri bunca zamandır bu kız, belgelerinin olduğu o çantayı sanki bebeğiymiş gibi sıkı sıkı tutuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310420
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310420,
					"content": "Açıkçası ben bile hazinesine tutunan bir ahmak olduğunu düşünürdüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310421
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310421,
					"content": "Etraf ıssız, elinde hazine, yanında yalnızca bir koruma... Herkes bir şansını denemek ister yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310422
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310422,
					"content": "Bir konuda haklısın... Çantam gerçekten de hazine dolu! Saha röportajlarımın kayıtlarını geçtim, başka belgelerin de kopyaları var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310423
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310423,
					"content": "Bende böyle hazineler varken tezimi yazmakta zorlanmam ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310424
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310424,
					"content": "Ayrıca seçtiğim tez konum da \"Kutsal Alevin Dönüşü Yolculuğu\". Çok önemli bir konu olduğu için kesin bu sefer mezun olacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310425
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310425,
					"content": "Tabii Tahmures olmadan başaramazdım. Bu fikir ondan çıktı zaten! Gerçekten çok iyi bir dost...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310426
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310426,
					"content": "#Sana da tekrar teşekkür ederim {NICKNAME}. Sen olmasaydın o kötü adamlar hem kitaplarımı mahveder hem de paramı çalarlardı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310427
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310427,
					"content": "Geçenlerde bazı kitapların ve materyallerin düzenlenmesine yardım ederek kendime harçlık çıkardım. Çalınsaydı yeni materyal satın alacak param kalmazdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310428
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310428,
					"content": "Doğru ama sen yine de tüm paranı kitaplara harcardın. Cüzdanına el koymamış olsam şimdiye açlıktan kırılmıştık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310429
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 250310429,
					"content": "B-Ben o kadar kitap satın almıyorum ki... Alıyor muyum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310430
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310430,
					"content": "Neyse, sohbetimizi burada sonlandıralım artık. Daha Kaplıca Halkına gidip materyal toplamamız gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310431
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310431,
					"content": "Elveda o zaman! Bir dahaki görüşmemizde tezimi tamamlamış olacağım. Kesin diyorum bak! Üstelik sana yemek de ısmarlayacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alrani"
				},
				{
					"id": 250310418,
					"content": "Başın yine de belaya girdi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310419
					]
				}
			]
		},
