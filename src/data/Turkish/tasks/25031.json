			"dialogs": [
				{
					"id": 250310501,
					"content": "Ee, nasıl geçti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250310502,
						250310503
					],
					"speakerTitle": "Tahmures"
				},
				{
					"id": 250310502,
					"content": "Alrani güvende.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250310504
					]
				},
				{
					"id": 250310504,
					"content": "Of... Çok endişelendim. Biraz daha geç kalsan bizzat ben aramaya çıkacaktım!",
					"roleType": "TALK_ROLE_NPC",
