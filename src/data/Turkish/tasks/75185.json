			"dialogs": [
				{
					"id": 751850401,
					"content": "Helal olsun size! Mücadeleyi göz açıp kapayıncaya kadar bitirdiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850402
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850402,
					"content": "Şimdi bir bakalım... Vay be, rengi ve kokusu... Şimdiden karnım acıktı! Hadi, sıcakken deneyin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850403
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850403,
					"content": "Hah, tarifini de vereyim. Bir dahaki sefere Magma Yumurtası yemek istediğinizde nasıl yapacağınızı biliyor olacaksınız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Runtuma"
				}
			]
		},
