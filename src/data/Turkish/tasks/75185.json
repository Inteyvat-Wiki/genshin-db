			"dialogs": [
				{
					"id": 751850701,
					"content": "Aa, uzaklardan gelen şu iki hünerli gezginsiniz siz! Magma Yumurtası yapmayı denediniz mi hiç?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850702,
						751850705,
						751850710
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850702,
					"content": "Denedim! Çok enerji verici bir yemek!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850703
					]
				},
				{
					"id": 751850703,
					"content": "Değil mi? Her lokmasında yanardağın gücü saklı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850704
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850704,
					"content": "Her gün yersen güçlenirmişsin, öyle diyorlar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850705,
					"content": "Ben biraz fazla pişirmişim... Yedikten sonra az kalsın bayılıp düşecektim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850706
					]
				},
				{
					"id": 751850706,
					"content": "Haha, tadı damağında kalıyor, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850707
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850707,
					"content": "Alıştıktan sonra o kadar da kötü değil ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850710,
					"content": "Henüz değil. Bir dahaki sefere deneriz belki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850711
					]
				},
				{
					"id": 751850711,
					"content": "Anladım, tamamdır. İyi yolculuklar diliyorum size o zaman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Runtuma"
				}
