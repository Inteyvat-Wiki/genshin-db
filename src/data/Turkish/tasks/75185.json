			"dialogs": [
				{
					"id": 751850301,
					"content": "Bu yumurtalar da ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751850302
					]
				},
				{
					"id": 751850302,
					"content": "Şöyle ki... Onlar sadece yanardağ bölgemize has bir lezzet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850303
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850303,
					"content": "Kuş yumurtalarını havalandırma çatlaklarına bırakıyoruz, Filojiston onları pişiriyor ve ısı ile zamanlama tutunca ortaya kusursuz bir Magma Yumurtası çıkıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751850304
					],
					"speakerTitle": "Runtuma"
				},
				{
					"id": 751850304,
					"content": "Ama benden söylemesi, çok uzun süre bekletirseniz tadı biraz... Değişik olacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Runtuma"
				}
			]
		},
		{
