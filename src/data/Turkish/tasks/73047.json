				"points": []
			},
			"dialogs": [
				{
					"id": 730470101,
					"content": "#Tekrar karşılaştık Nara {NICKNAME} ve Paimon. Hehehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470102
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470102,
					"content": "Çok neşeli görünüyorsun Araja!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730470103,
					"content": "Haha, Vanarana'nın bu kadar canlı olmasına ve bu kadar çok Aranaranın eve dönmesine gerçekten çok sevindim. Utsava Festivaline bizzat katılabileceğimi hiç düşünmemiştim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470104,
						730470105
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470104,
					"content": "Daha önce hiç katılmamış mıydın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730470107
					]
				},
				{
					"id": 730470107,
					"content": "Anlatılanlara göre katılmışım ama çok uzun zaman önceymiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470108
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470108,
					"content": "Ben, Aramuhukunda, Arana, Araji ve Aranaraların çoğu Nara Varuna'yla Utsava Festivalini kutladık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470109
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470109,
					"content": "Çok zor zamanlarmış ama biz yine de Utsava Festivalinde birlikte gülüp şarkı söylemişiz. Bu en sevdiğim hikayelerden biri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470110
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470110,
					"content": "Hımm. Yani katılmışsın değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730470111,
					"content": "Evet, hikayelere göre katılmışım ama artık hatırlamıyorum. O hikayeleri bana daha sonra Arana ve diğerleri anlattı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470112
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470112,
					"content": "Hımm. Araja dede gibi konuşuyor. Belki de Araja çok yaşlanmıştır ve net hatırlayamıyordur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730470113,
					"content": "#Belki böylesi daha iyidir. Neyse, bunu alır mısınız Nara {NICKNAME} ve Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470114
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470114,
					"content": "Çiçek bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730470115,
					"content": "Evet. Umarım bu çiçek bundan sonraki yolculuklarınızda sizi takip eder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470116,
						730470117
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470116,
					"content": "Kabul ediyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730470118
					]
				},
				{
					"id": 730470118,
					"content": "Naraların vakti Aranaraların vaktinden çok daha değerli, o yüzden eğlenmenize engel olmayacağım. Sonra gidip Arakavi'yi bulun. O da Utsava Festivali törenine hazırlanıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araja"
				},
				{
					"id": 730470117,
					"content": "Teşekkürler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730470118
					]
				},
				{
					"id": 730470105,
					"content": "Ben de çok sevindim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730470106
					]
				},
				{
					"id": 730470106,
					"content": "Paimon da çok sevindi! Daha önce Utsava Festivaline hiç katılmamış mıydın Araja?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470107
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}