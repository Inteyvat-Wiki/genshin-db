				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790700201,
					"content": "Estampe! Nerelerdeydin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700202
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700202,
					"content": "Şey... Bu civarda dolaşıyordum da imtihanı bir deneyeyim dedim. Eğlenceliydi eğlenceli olmasına ama geçmek için farklı bir yaklaşım denemem gerekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700203
					],
					"speakerTitle": "Estampe"
				},
				{
					"id": 790700203,
					"content": "Tüm olanları Bay Horellou'dan dinledim bu arada. Sen de az değilmişsin Muhafız Efendi. Kabullendin mi sonunda ne kadar yetenekli olduğunu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700204
					],
					"speakerTitle": "Estampe"
				},
				{
					"id": 790700204,
					"content": "S-Sen... Yanımda olsan var ya, seni öyle bir itip kakardım ki! Elime bir geçsen seni on kez dürtüp iteklemiştim bile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700205
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700205,
					"content": "Ben de o yüzden imtihana katılmaya karar verdim ya işte. Bunu başarabileceğini hep biliyordum dostum Faurobert. Haklı da çıktım, bak... Başardın işte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700206
					],
					"speakerTitle": "Estampe"
				},
				{
					"id": 790700206,
					"content": "Hahaha, siz yok musunuz siz... Gülmekten kırıp geçirdiniz beni. Bugün göletimiz için uğurlu bir gün oldu desenize!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700207
					],
					"speakerTitle": "Horellou"
				},
				{
					"id": 790700207,
					"content": "Sonunda gerçek bir şampiyonumuz var. Bay Faurobert henüz prensesi kurtarmamış olabilir ama fırsatın bacaklarına kadar geleceğinden eminim ben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700208
					],
					"speakerTitle": "Horellou"
				},
				{
					"id": 790700208,
					"content": "*iç çeker* İyi ama Bay Horellou... Her şeyi Majesteleri halletti zaten, durup onu izlemek dışında bir şey yapmadım ben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700209
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700209,
					"content": "E ne güzel işte! Prensesin tehlikeye girmesini istemediğin için göz kulak olmuşsun ona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700210
					],
					"speakerTitle": "Horellou"
				},
				{
					"id": 790700210,
					"content": "Ben... Şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700211
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700211,
					"content": "Hadi hadi, çok uzatma Bay Faurobert. Cibrelus amacımıza ulaşma işini sana bizzat emanet etti, daha ne olsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700212
					],
					"speakerTitle": "Horellou"
				},
				{
					"id": 790700212,
					"content": "O da saçmalığın daniskası! Hem kendisinin Cibrelus olduğu ne malum ki? İsmini biliyorum falan ama konuştuğunu hiç duymadım sonuçta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700213
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700213,
					"content": "Prensesin imtihanını bile kabul ettin. Senden ala şampiyon mu var şu noktada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700214
					],
					"speakerTitle": "Estampe"
				},
				{
					"id": 790700214,
					"content": "Bunu... Bunu şimdi konuşmasak olmaz mı? Lütfen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700215
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700215,
					"content": "Neyse, durumu özetlemek gerekirse Yağmur Şarkısı Göleti'nin geleceği artık senin hünerli ellerinde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700216
					],
					"speakerTitle": "Horellou"
				},
				{
					"id": 790700216,
					"content": "Artık sadece keyif için sıçramanın tadını çıkarabiliriz! Geri döndüğümde komiteye bundan sonra gözümüzü \"eğlenceye\" çevirmeyi teklif edeceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700217
					],
					"speakerTitle": "Horellou"
				},
				{
					"id": 790700217,
					"content": "Heh, ben bu teklifin altına imzamı atarım işte! Hadi artık geri dönelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700218
					],
					"speakerTitle": "Estampe"
				},
				{
					"id": 790700218,
					"content": "Durun, beni burada bırakmayın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Faurobert"
				}
			]
		},
		{
			"id": 7907003,
