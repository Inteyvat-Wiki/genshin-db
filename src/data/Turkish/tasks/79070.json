				"points": []
			},
			"dialogs": [
				{
					"id": 790700301,
					"content": "Majesteleri... Hem siz hem de o kağıt kurbağa Muhafız olarak kabul mü gördünüz yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700302
					],
					"speakerTitle": "Saborn"
				},
				{
					"id": 790700302,
					"content": "İnanılmaz! Daha önce böyle bir şey yaşandığını hiç duymadım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700303
					],
					"speakerTitle": "Souffache"
				},
				{
					"id": 790700303,
					"content": "İmtihanda değişiklikler yapmanız gerekecek o halde... Hayır, ne olur durun Majesteleri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700304
					],
					"speakerTitle": "Saborn"
				},
				{
					"id": 790700304,
					"content": "Böyle kadim bir geleneği fevri bir kararla değiştirmek olmaz Majesteleri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700305
					],
					"speakerTitle": "Souffache"
				},
				{
					"id": 790700305,
					"content": "Tamam canım, tamam. Sessiz olun. Kulaklarım acıdı sizin yüzünüzden...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700306
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700306,
					"content": "Karar çoktan verildi bile. Artık hem bir prenses hem de yadigarın tanıdığı bir Muhafız olduğuma göre, beni durdurabilecek bir konumda değilsiniz zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700307
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700307,
					"content": "İyi ama Majesteleri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700308
					],
					"speakerTitle": "Saborn"
				},
				{
					"id": 790700308,
					"content": "İçiniz rahat olsun. Krallığı koruyabilecek çok sayıda güvenilir uçan sincap yetiştirmek için bir tören düzenleyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700309
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700309,
					"content": "Krallıktan ayrılma işini ondan sonraya bıraktım anlayacağınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700310
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700310,
					"content": "Majesteleri, biz... *iç çeker* Siz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
