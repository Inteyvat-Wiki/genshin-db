				"points": []
			},
			"dialogs": [
				{
					"id": 790700101,
					"content": "Majesteleri, Yeller ve Çanlar Krallığı'nın adına sizi selamlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700102
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700102,
					"content": "Şimdi ne yapacaksınız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700103
					]
				},
				{
					"id": 790700103,
					"content": "Hımm... Öncelikle halkıma yadigarın bir karara vardığını duyuracağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700104
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700104,
					"content": "Muhafız olarak da... Çok uzaklardan gelen Bay Faurobert'in seçildiğini söyleyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700105
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700105,
					"content": "Ne? Neden ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790700106,
					"content": "Yaşadığımız her şeyi açıklamaya çalışsak ortalık yangın yerine döner de o yüzden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700107
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700107,
					"content": "Ayrıca benim hem prenses hem Muhafız olduğumu anlat anlatabilirsen şimdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700108
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700108,
					"content": "Bu olanların hepsinin ayrıntılı bir kaydını tutup zamanı geldiğinde halkıma yazılı olarak bildireceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700109
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700109,
					"content": "Tabii o zamana kadar da krallığın işlerini \"Prenses\" unvanı altında yürütmeye devam edeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700110
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700110,
					"content": "\"İmtihan alanı\" resmi olarak \"talim kampına\" dönüştürüldüğünde de yola düşme zamanım gelmiş olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700111,
						790700112
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700111,
					"content": "Yola düşmek derken?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700113
					]
				},
				{
					"id": 790700113,
					"content": "Majesteleri... Mağaradayken yadigarın asıl kimin için parladığını hatırlıyor musunuz acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700114
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700114,
					"content": "Hımm... Kimin için parladığını mı dedin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700115
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700115,
					"content": "Evet, o an ikimiz de yanındaydık. Majesteleri elbette ki Muhafız olarak tanınmayı hak ediyor ama ben... Ben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700116
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700116,
					"content": "Bir şampiyon tarafından tanınmış bir şampiyonsun sen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700117
					]
				},
				{
					"id": 790700117,
					"content": "Evet, söz konusu şampiyon bilhassa senin yardımını istemeye geldi üstelik! Bu unvanı sen hak etmeyeceksin de kim hak edecek?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790700118,
					"content": "*iç çeker* Majesteleri, belki de ışıl ışıl parladığınız için herkes yanılmıştır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700119
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700119,
					"content": "Haha... E madem öyle, bir imtihana daha var mısın Bay Şampiyon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700120
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700120,
					"content": "Yeller ve Çanlar Krallığı'nın Prenses Cimest'si olarak, bu yadigarla ulaştığın başarılara bizzat tanıklık edeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700121
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700121,
					"content": "Evet, evet! Tabii ki! Tabii ki varım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700122,
						790700123
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700122,
					"content": "Hele bir sakin ol canım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700124
					]
				},
				{
					"id": 790700124,
					"content": "Hehe, Faurobert de prensesin adını duyduğu anda gaza geliveriyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790700125,
					"content": "Yanlış anlamayın tabii canım! Bunu Yağmur Şarkısı Göleti'nin amacını gerçekleştirmek için yapıyorum ben! Tüm o idmanlar Majestelerini kurtarmak... Şey, yani korumak içindi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700126
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700126,
					"content": "Bu o kadar önemli bir görev ki her şeyin tıkırında gittiğinden emin olmam lazım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700127
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700127,
					"content": "Majesteleriyle seyahate çıkacak mısın yani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700128
					]
				},
				{
					"id": 790700128,
					"content": "Şey... E-Evet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700129
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700129,
					"content": "Hehe... Bunu duymak güzel. Peki o zaman \"Şampiyon\" Faurobert, imtihanıma hazır mısın bakalım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700130
					],
					"speakerTitle": "Cimest"
				},
				{
					"id": 790700130,
					"content": "Hazırım Majesteleri! Ne zaman isterseniz başlayalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790700131
					],
					"speakerTitle": "Faurobert"
				},
				{
					"id": 790700131,
					"content": "Aa! Yadigar yine ışıldamaya başladı... Bu sefer aşırı parlak üstelik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790700123,
					"content": "Off... Kulaklarım acıdı ya!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700124
					]
				},
				{
					"id": 790700112,
					"content": "Ne yapacaksınız ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790700113
					]
				}
			]
		},
		{
			"id": 7907002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
