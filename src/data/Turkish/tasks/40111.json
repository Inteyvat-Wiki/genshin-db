			"dialogs": [
				{
					"id": 401115201,
					"content": "General Kujou, biraz konuşabilir miyiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115202
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401115202,
					"content": "Evet. Kazandığınız için sizi tebrik ederim Sangonomiya Kokomi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115203
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401115203,
					"content": "Düellodan önce verdiğiniz tavsiye için teşekkür etmek istemiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115204
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401115204,
					"content": "Bir şey değil. Aklı başında olan herkes, yeteneğin ve stratejinin kazananı belirlediğini bilir. Her halükarda heyecanlı bir düelloydu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115205
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401115205,
					"content": "Keşke siz de turnuvaya katılsaydınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115206
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401115206,
					"content": "Korkarım ki size rakip bile olamam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115207
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401115207,
					"content": "Öyle demeyin. Benden çok farklı değilsiniz... Oyundaki yeteneğinizi geliştirmeye çalışıyor, karşı önlemler alıyor ve diğerleriyle arkadaşmış gibi rekabet ediyorsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115208
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401115208,
					"content": "... Haklı olabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115209
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401115209,
					"content": "O halde Narukami Adası'ndan gitmeden önce bir el Dehanın Yakarışı oynayalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115210
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 401115210,
					"content": "Memnuniyetle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				}
			]
