				"points": []
			},
			"dialogs": [
				{
					"id": 401111301,
					"content": "Selam. Konuşmak istediğin bir şey mi vardı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111302,
						401111306,
						401111310
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111302,
					"content": "Dehanın Yakarışı Kart Oyunu hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111303
					]
				},
				{
					"id": 401111303,
					"content": "Oyun son zamanlarda çok popüler oldu. Günlük hayatın bir parçası haline geldi, nereye gidersen git düello yapan insanları görebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111304
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111304,
					"content": "Aslında bazı insanlar oyuna daha iyi odaklanabilmek için içki içmeyi bile bıraktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111305
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111305,
					"content": "Hehe, eminim Diona bunu duyduğunda çok sevinecektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111306,
						401111310
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111306,
					"content": "Favonius Şövalyeleri nasıl gidiyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111307
					]
				},
				{
					"id": 401111307,
					"content": "Endişelenmene gerek yok, herkes iyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111308
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111308,
					"content": "Aslında Jean'i bir düello için ikna etmiştim ama daha oyunun yarısına gelmişken onu çağırdılar. Daha sonra düelloyu ikimiz için de bitirmem gerekti. *iç çeker* Yapacak bir şey yok, herkesin önce işiyle ilgilenmesi lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111309
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111309,
					"content": "Ancak turnuvanın ne kadar başarılı olduğunu ve herkesin ne kadar eğlendiğini gördükten sonra endişelenecek bir şeyi kalmamıştır diye umuyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111302,
						401111310
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401111310,
					"content": "Sonra tekrar görüşelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401111311
					]
				},
				{
					"id": 401111311,
					"content": "Tabii. Fırsatın olduğunda bir el Dehanın Yakarışı Kart Oyunu oynarız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				}
			]
		},
