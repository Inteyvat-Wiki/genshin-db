					"id": 401115301,
					"content": "Az önce rakibine \"Kitsune Youkai\" dediğini duydum, bana bundan biraz daha bahsedebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115302
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401115302,
					"content": "Lütfen hiçbir ayrıntıyı es geçme. Haberime ekleyebileceğim bir şeyler olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115303
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401115303,
					"content": "Ah! Anlatmasam daha iyi olur, yanlış bir şey söylemek istemiyorum. Ayrıca sorularına cevap verebilecek nitelikte bir youkai değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115304
					],
					"speakerTitle": "Kirara"
				},
				{
					"id": 401115304,
					"content": "Peki, o zaman belki bir Kitsunenin neden Kızarmış Tofuya ilgisi olduğunu anlatabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115305
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401115305,
					"content": "Ah, şimdi de soruların karnımı acıktırıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115306
					],
					"speakerTitle": "Kirara"
				},
				{
					"id": 401115306,
					"content": "Seni Inazuma'da Kitsune Ramen yemeye götürsem nasıl olur? Yerken konuşabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kirara"
				}
