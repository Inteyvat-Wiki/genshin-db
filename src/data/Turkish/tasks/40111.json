			"dialogs": [
				{
					"id": 401111501,
					"content": "\"Göldeki Şehir Dehanın Yakarışı Turnuvası Yetenekleriyle Dolup Taşarken Genç Dahi, Favonius Süvari Yüzbaşısını Yendi\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111502
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401111502,
					"content": "Hımm, başlık Şövalyelerin itibarını koruyor ama biraz \"çekici\" olmadı sanki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111503
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401111503,
					"content": "\"Favonius Şövalyelerinin En İyi Stratejisti, Köprü Çocuğuna Karşı Beş Turda Kaybetti\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111504
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401111504,
					"content": "\"Yüzbaşının Şampiyonluk Umutlarını Sürpriz Oyuncu Yıktı\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111505
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401111505,
					"content": "Hımm... Belki ilk taslağı kullansam daha iyi olur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Charlotte"
				}
			]
		},
