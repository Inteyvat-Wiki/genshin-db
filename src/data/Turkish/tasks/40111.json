			"dialogs": [
				{
					"id": 401113301,
					"content": "Merhaba, benim adım Charlotte. Buğukuş'un gazetecisiyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113302
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401113302,
					"content": "Kısa bir röportaj için vaktiniz var mı acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113303
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401113303,
					"content": "*iç çeker* Tabii, buyur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113304
					],
					"speakerTitle": "Qian Birader"
				},
				{
					"id": 401113304,
					"content": "Turnuvaya iddialı bir giriş yaparak birçok yarışmacıyı finallere çıkarken geride bıraktınız ve şampiyonluğu kıl payı Wangsheng Cenaze Evi Müdürü Hu Tao'ya karşı kaybettiniz. Zafere bu kadar yakınken kaybetmek sizin için zor olmuş olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113305
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401113305,
					"content": "Bunları göz önünde bulundurduğunuzda, yapılan son düello hakkında düşüncelerinizi bizimle paylaşabilir misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113306
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401113306,
					"content": "Şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113307
					],
					"speakerTitle": "Qian Birader"
				},
				{
					"id": 401113307,
					"content": "Affedersin, medyaya göre mi cevap vereyim yoksa gerçek düşüncelerimi mi söyleyeyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113308
					],
					"speakerTitle": "Qian Birader"
				},
				{
					"id": 401113308,
					"content": "Lütfen gerçek düşüncelerinizi söyleyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113309
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 401113309,
					"content": "*iç çeker*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113310
					],
					"speakerTitle": "Qian Birader"
				},
				{
					"id": 401113310,
					"content": "Kart oynamanın yüzde yetmişinin beceri ve yüzde otuzunun ise şans olduğunu söylemişimdir hep ama... Rakibin aynı element türünden altı zarı attığında bundan geri dönüş yoktur, Adeptus seviyesindeki biri bile bundan kurtulamaz... O yüzden benim gibi bir maceracının hiç sansı yoktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qian Birader"
				}
			]
		},
