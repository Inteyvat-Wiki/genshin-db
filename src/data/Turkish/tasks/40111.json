				"points": []
			},
			"dialogs": [
				{
					"id": 401115101,
					"content": "Ay, o tilki kadınla balık kadının düellosu beni çok heyecanlandırdı! Alnımdaki ter adeta buhar olup uçuyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115102
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401115102,
					"content": "Evet, evet. Ritou'daki herkes senin ne kadar heyecanlı olduğunu eminim biliyordur ama tüm çete bizi bekliyor. Geri dönmeye başlasak iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115103
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401115103,
					"content": "Eh, biraz daha bekleyebilirler. En azından yoldaşımla bir düello daha yapmama izin ver! Buna hayır diyemezsin... Lütfen ama lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115104,
						401115107
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401115104,
					"content": "Tamam, hadi bir el oynayalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401115105
					]
				},
				{
					"id": 401115105,
					"content": "İşte benim yoldaşım! Düello yapmak istediğini biliyordum! Benim gibi sıkı bir Kart Oyunu oyuncusunu zaten ancak sen anlardın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115106
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401115106,
					"content": "Gerçekten, ben ikinizle ne yapacağım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401115107,
					"content": "Belki bir dahaki sefere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401115108
					]
				},
				{
					"id": 401115108,
					"content": "... Pekala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401115109
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401115109,
					"content": "Önemli değil, seni suçlamıyorum ama... Gitmen gerekebilir. Yetişkin bir Oni'nin ağlamasını görmek istemeyebilirsin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
