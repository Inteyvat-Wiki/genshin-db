				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mika",
					"Huffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401111201,
					"content": "Bir dakika, neden herkes gidiyor? Kaçırdım mı yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111202
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401111202,
					"content": "Ah Mika, keşke sen de görseydin. Üzgünüm ama... Yüzbaşı Kaeya kaybetti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111203
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 401111203,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111204
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401111204,
					"content": "Bana her şeyi anlat! Ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111205
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401111205,
					"content": "Şahsen Dehanın Yakarışı hakkında pek bir bilgim yok ama herkesin ne dediğini dinlemeye çalıştım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111206
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 401111206,
					"content": "Yüzbaşı Kaeya, daha en başta Timmie'nin bir karakter kartını saf dışı bırakarak ona karşı erken bir avantaj sağlamış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111207
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 401111207,
					"content": "Ancak rakibinin stratejisi tam da buymuş... Timmie ilk birkaç tur elinde kart biriktirdikten sonra, en son büyük bir saldırı yaparak oyunun dengesini kendi lehine çevirmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111208
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 401111208,
					"content": "Hımm, ama belki de bu düello yazı tura atılıp da Kaeya'nın ikinci olarak başlamasına karar verildiği anda çoktan bitmişti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111209
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 401111209,
					"content": "*iç çeker* Bir şeyler içmem lazım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111210
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 401111210,
					"content": "Sakin ol kardeşim. Şimdi kederle kadeh tokuşturmanın sırası değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111211
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401111211,
					"content": "Yüzbaşı Kaeya, kaybettiği için üzülmeni istemez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111212
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401111212,
					"content": "Hey, bu oyunu biz de öğrenebiliriz. Belki bir gün Yüzbaşı Kaeya ile düello yaparız! Hehe... Ama eminim ona karşı çok kötü kaybederiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401111213
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401111213,
					"content": "Hah, evet haklısın, Mika. Fena bir plan değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
		},
		{
			"id": 4011113,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
