			"dialogs": [
				{
					"id": 401113101,
					"content": "Bu arada Kaptan Beidou, Dehanın Yakarışı Kart Oyunu oynuyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113102
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401113102,
					"content": "Evet. Aslında Güneyhaçı Filosunun en iyi oyuncularından biridir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113103
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 401113103,
					"content": "Araya girebilir miyim Kazuha? Uzun zamandır Kaptan Beidou'nun hayranıyım. Her zaman onunla arkadaş olmak istemişimdir ama bunun için bir türlü fırsatım olmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113104
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401113104,
					"content": "Tabii ama lütfen onu Dehanın Yakarışı düellosunda yendiğinde kibar ol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				}
			]
		},
