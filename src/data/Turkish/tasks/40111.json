			"dialogs": [
				{
					"id": 401113201,
					"content": "Resmi olmayan Dehanın Yakarışı turnuvasına bile çok kişinin katıldığını duymuştum. Birçok sağlam oyuncu hem resmi hem de resmi olmayan turnuvalara kaydolmuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113202
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401113202,
					"content": "Bana gelirsek... Her ne kadar satrancı tercih etsem de zaman zaman farklı oyunları da denerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401113203
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401113203,
					"content": "Oyunlar söz konusu olduğunda, aralarında ne tür farklar olursa olsun hepsinin çok önemli tek bir ortak noktası var. O da arkadaşları bir araya getirmeleri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				}
			]
		},
