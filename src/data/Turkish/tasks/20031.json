			"dialogs": [
				{
					"id": 200310201,
					"content": "#İyi iş çıkardın {NICKNAME}! Bunun ilk seferin olduğunu düşünürsek muhteşem bir performans sergiledin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310202
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310202,
					"content": "Talebi gönderen kişi kendi adına sana teşekkür etmemi bile istedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310203
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310203,
					"content": "Ayrıca söz verdiğim üzere ödülünü alacaksın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
