			"dialogs": [
				{
					"id": 200310101,
					"content": "Yollarımız yeniden kesişti hevesli maceracı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310102,
					"content": "Maceraların sorunsuz geçiyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310103,
						200310105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310103,
					"content": "Tıkır tıkır çalışan bir macera makinası gibiyim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310104
					]
				},
				{
					"id": 200310104,
					"content": "İşte aradığım ruh, böyle devam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310107,
					"content": "Oldukça tecrübe kazanmış gibi duruyorsun. Artık seni Loncaya resmi olarak tanıtabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310108,
					"content": "Lonca her gün her yerden talepler alıp duruma göre maceracılara <color=#00E1FFFF>görev</color> ataması yapıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310109,
					"content": "Görev olarak verilen bu maceralar lonca üyelerimizin ödemelerinin kaynağını oluşturur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310110,
					"content": "Ne tür görevlerden bahsediyoruz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200310111,
					"content": "Ortaya karışık diyebiliriz! Yurttaşlardan birinin gündelik işlerine yardımdan tut da canavarların icabına bakmaya kadar birçok şey. Bazıları basit işlerken bazıları da oldukça tehlikeli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310112
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310112,
					"content": "Ama benim lafıma göre hareket etme tabii, gidip kendin keşfetmelisin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310113
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310113,
					"content": "Burada günün görevlerinin ayrıntılarını bulabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310114
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310114,
					"content": "Lütfen tamamladığında bana bildir. Cömert ödüller seni bekliyor olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310115,
						200310117
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310115,
					"content": "O iş bende.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310116
					]
				},
				{
					"id": 200310116,
					"content": "#Harika! Sana güvenebileceğimi biliyordum {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310119
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310119,
					"content": "#Dönüşünü büyük bir hevesle bekliyorum {NICKNAME}. Yıldızlar ve hiçlik yoldaşınız olsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310117,
					"content": "Ne kadar cömert ödüllerden bahsediyoruz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310118
					]
				},
				{
					"id": 200310118,
					"content": "Sabır erdemdir! Yakında öğreneceksin. Hayal kırıklığına uğramayacağına eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310119
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310105,
					"content": "Aslında maceracılık oldukça zorlu bir iş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310106
					]
				},
				{
					"id": 200310106,
					"content": "İlk başlarda hep öyle olur. Maceraya gitmeden önce hazırlanmak işlerin daha sorunsuz ilerlemesini sağlayabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310107
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
