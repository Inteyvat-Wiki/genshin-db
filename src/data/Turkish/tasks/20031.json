			"dialogs": [
				{
					"id": 200310301,
					"content": "Hiç gereği yoktu! Yani illaki vardı da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200310302,
					"content": "Bunu Loncanın duyduğu minnetin bir göstergesi olarak kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310303
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310303,
					"content": "Her gün bir sürü yeni görev alıyoruz ve maceracılarımızın her birinin çabası olmadan tümüne yetişebilmemiz mümkün değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310304
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310304,
					"content": "Her gün yeterince görev tamamlarsan benden özel bir ödül alabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310305
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310305,
					"content": "Maceracı El Kitabın her gün kaç macera tamamladığının kaydını tutar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310306
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310306,
					"content": "Yeterince macera tamamladığın günlerde günlük ödüllerini almayı unutma. Sınırlı sayıda ödül olduğundan, o gün aldığın ödüllere sahip çıkmazsan ödül hakkını kaybedersin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310307,
						200310309
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310307,
					"content": "Tamamdır, açıklama için teşekkür ederim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310308
					]
				},
				{
					"id": 200310308,
					"content": "Rica ederim, ne demek. Ne de olsa esas bana yardım eden sensin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310312
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310312,
					"content": "Ayrıca başka bir maceracının görevlerini tamamlamasına yardım edersen gündelik ödüle daha çok yaklaşırsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310313
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310313,
					"content": "Diğer maceracılarla birlikte çalışmanı öneririz. Yıldızlar ve hiçlik yoldaşınız olsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310309,
					"content": "Günde sadece bir ödül mü var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200310310
					]
				},
				{
					"id": 200310310,
					"content": "Şu anki durumda öyle, evet... Üzgünüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310311
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310311,
					"content": "Ama tüm maceracıların adil ve yeterli şekilde ödüllendirilmesini sağlamak adına her gün Karargaha baskı yapıyoruz, emin olabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310312
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
