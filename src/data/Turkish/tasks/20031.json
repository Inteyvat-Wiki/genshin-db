			"dialogs": [
				{
					"id": 200310401,
					"content": "#Üzüm asmalarının arasından kulağıma bir şey çalındı {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310402
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310402,
					"content": "Duyduğuma göre bir <color=#00E1FFFF>görev</color> tamamlamışsın. Talepte bulunan kişi teşekkürlerini iletti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310403,
						200310406
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310403,
					"content": "Hangi görev olduğunu bana hatırlatabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310404
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310404,
					"content": "Yoldayken yardıma ihtiyacı olan birine yardım etmişsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310405
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310405,
					"content": "Aslında tanışacağın çoğu kişi yardım için Loncaya görev vermiş olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310408
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310408,
					"content": "Loncanın sistemini sana daha ayrıntılı bir şekilde anlatayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310409
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310409,
					"content": "Lonca her gün her yerden talepler alıp duruma göre maceracılara görev ataması yapıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310410
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310410,
					"content": "Görev olarak verilen bu maceralar lonca üyelerimizin ödemelerinin kaynağını oluşturur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310411
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310411,
					"content": "Ödeme demişken, Loncanın sana ufak bir hediyesi olduğunu söylemek isterim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310406,
					"content": "Sadece bir Hayırsever olarak görevimi yapıyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310407
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200310407,
					"content": "Bu da seni bizim yeni ve hevesli maceracımız yapıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200310408
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
