			},
			"dialogs": [
				{
					"id": 732750501,
					"content": "Halk şarkısı hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732750502
					]
				},
				{
					"id": 732750502,
					"content": "Aa, bak hatırlıyorsun işte! O şarkıyı bilen bir genç daha varmış meğer, harika.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750503
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750503,
					"content": "\"Ey güzeller güzeli gül, yerine getir dileklerimi. Taştan biten Altın Gül bana bir şarkı söyledi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750504
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750504,
					"content": "\"Diyarlar değil şarkılar sırtlar benim ruhumu. Şarkılar meydan okur yazgıma ve reddeder bu kötü kaderi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750505
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750505,
					"content": "\"Beni ve zamanı geride bırakıp hayatın ebedi solgunluğunu geride bırakacaklar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		},
