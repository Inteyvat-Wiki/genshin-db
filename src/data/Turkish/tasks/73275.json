			"dialogs": [
				{
					"id": 732750102,
					"content": "Altın Güller filizlenip fide oldular, evet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732750103
					]
				},
				{
					"id": 732750103,
					"content": "Bu tohumlar... Bu tohumları nereden bulduğunu merak ediyorum açıkçası.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750104
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750104,
					"content": "Çok uzak bir yerden getirdim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732750105
					]
				},
				{
					"id": 732750105,
					"content": "Öyle mi? Sanırım Shafaqat amcanın ektiği tohumlar çölün dört bir yanına dağıtıldıktan sonra bile dönüp dolaşıp buraya geldi. Yol uzun olmuş olsa da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750107
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750107,
					"content": "Bu fidelerle ilgileneceğiz. Onları genç Sabbah'a bırakmayı düşünüyorum. Bir gün ben de gittiğimde bu çiçekler onun olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750108
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750108,
					"content": "Teşekkürler evlat. Sana verebileceğim çok az şey var ama lütfen bu meyveleri ve çiçekleri al.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		},
