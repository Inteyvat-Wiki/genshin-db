				{
					"id": 732750307,
					"content": "Bu fidelerle ilgileneceğiz. Onları genç Sabbah'a bırakmayı düşünüyorum. Bir gün ben de gittiğimde bu çiçekler onun olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750308
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750308,
					"content": "Bu yaşlı adama çok yardımın dokundu ve ödül bile istemedin. Ama sana ufak bir şey vermezsem bu akşam gerçekten uyuyamam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750309
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750309,
					"content": "Bu fide topraktan daha yeni çıktı ve Sabbah bunu sana vermemi önerdi. Senin için özenli bir şekilde sardı bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732750310
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732750310,
					"content": "Bu, sende bizden bir hatıra olarak kalsın. Umarım bu fide kadar dirençli olursun ve hep inanırsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
