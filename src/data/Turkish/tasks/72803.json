			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yayoi Nanatsuki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728030501,
					"content": "Neye üzüldün Shouta? Birisi sana kötü bir şey mi yaptı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030502
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030502,
					"content": "Şehirdeki herkesin tanrılardan yardım istemek için tapınağa adak adadığını biliyorsun değil mi Nanatsuki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030503
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030503,
					"content": "Adağı içtenlikle adayıp tanrılara cevap vermeleri için geçerli bir sebep sunduğumuz sürece her dilek gerçek olabilir değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030504
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030504,
					"content": "Ne? Bu nereden geldi şimdi aklına? Bir şey mi oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030505
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030505,
					"content": "Şöyle ki...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030507
					]
				},
				{
					"id": 728030507,
					"content": "Shouta... Tapınağa böyle bir şey için mi hevesle gittin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030508
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030508,
					"content": "Evet! Adaklarımı içtenlikle tanrıya sundum ama adaklar sürekli çalınıyordu. Ben de tanrı bundan beni sorumlu tutup bir daha beni korumayacak sandım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030509
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030509,
					"content": "Saf çocuk... Merak etme. Tanrı böyle ufak bir şey yüzünden sana kızmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030510
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030510,
					"content": "Gerçekten mi? Sevindim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030511
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030511,
					"content": "Ama tanrı, adak verdi diye birine yardım da etmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030512
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030512,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030513
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030513,
					"content": "İnsanlar dilekleri gerçek olsun diye adak adayıp yardım istemiyor. Tanrıya olan güvenlerini sağlamlaştırmak için adak adıyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030514
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030514,
					"content": "Güven mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030515
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030515,
					"content": "\"Tanrıya dileklerimizi söyledikten sonra o dileklerin gerçekleşmesi için elimizden geleni yapmalıyız.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030516
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030516,
					"content": "\"Tanrı bizi gözetiyor, biz de emek sarf edersek kesinlikle başarılı oluruz.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030517
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030517,
					"content": "Böyle bir özgüvenle insanlar, dileklerini gerçekleştirmek için ellerinden geleni yapmaya hazır olurlar. İşte bu sebeple tapınaklara adak adarlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030518
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030518,
					"content": "Sonuçta dünyaya yön verenlerdir insanlar. Tanrılara dua edip hiçbir şey yapmazsak tanrı yardım etmek istese bile ne yapması gerektiğini bilemeyecektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030519
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030519,
					"content": "Ama... Daha önce tapınağa adak adadığımda tanrı hep bana yardım etmişti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030520
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030520,
					"content": "Şu yangın çıktığı zaman... Daha güçlü olmak isteyen adam... Bir de şu çizgi romanım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030521,
						728030522
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030521,
					"content": "(Hâlâ tanrılardan bahsediyor.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030523
					]
				},
				{
					"id": 728030523,
					"content": "Hımm... Haklısın. Sanırım senin tanrın dilekleri daha hızlı gerçekleştiriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030524
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030524,
					"content": "Ama, ama... Hâlâ sınav olmamın yanında o kaba kız da değişmedi. Her gün ödevlerimi yapmamı söylüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030525
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030525,
					"content": "Bir dakika. Şu sana kötü davranan kızın adı ne? Ne zaman geldi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030526
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030526,
					"content": "Adı... Adı şey... Neydi ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030527
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030527,
					"content": "Galiba okula benimle aynı anda başladı. Hayır, hayır. Biraz daha önce. Sonra mıydı yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030528
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030528,
					"content": "Tuhaf. Niye hiçbir şey hatırlamıyorum? Tek hatırladığım şey bir kızın bana ders çalışmamı söylemesi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030529
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030529,
					"content": "Anlaşılan tanrı yine dualarına cevap vermiş. Şu an sınav nefretini aşmana yardım ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030530
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030530,
					"content": "O kızdan mı bahsediyorsun? Tanrı beni ders çalışmaya zorlamak için sürekli bana kötü davranan kızı mı göndermiş?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030531
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030531,
					"content": "Hayııır! Ders çalışmak istemiyorum. Sınava girmek istemiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030532
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030532,
					"content": "Olamaz! Yine geldi. Şurada. Sokağın karşısından buraya geliyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030533,
						728030534
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030533,
					"content": "Nerede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030535
					]
				},
				{
					"id": 728030535,
					"content": "Kızı görmüyor musun? Elinde bir dolu sınav kağıdıyla buraya geliyor! Hayır! Sınava girmek istemiyoruuum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030536
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030536,
					"content": "Bu tanrı işine kendini bayağı adamış anlaşılan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030537,
						728030538
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030537,
					"content": "Bu tanrının tarzı farklı demek ki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030539
					]
				},
				{
					"id": 728030539,
					"content": "Tabii bu tanrının gözetiminde Shouta sınavlarından başarıyla geçebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030540
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030540,
					"content": "Tanrılar bile Shouta'nın dırdırından sıkılabilir sonuçta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030541
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030541,
					"content": "Ne? Bir dakika. Yolda neden yaprak var? Az önce yoktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 728030538,
					"content": "Bir tanrının yapacağı bir şey gibi gelmedi bana.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030539
					]
				},
				{
					"id": 728030534,
					"content": "Kimseyi görmüyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030535
					]
				},
				{
					"id": 728030522,
					"content": "(İkisi de farklı telden çalıyor.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030523
					]
				}
			]
		}
	]
}