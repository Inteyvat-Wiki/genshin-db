			"dialogs": [
				{
					"id": 728030401,
					"content": "Merhaba. Nasıl yardımcı olabilirim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030402
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030402,
					"content": "Tapınaktaki adaklar hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030403
					]
				},
				{
					"id": 728030403,
					"content": "Evet, tapınak... Ben de birkaç kere gittim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030404
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030404,
					"content": "Büyüyünce dünyayı gezip görebilmek için tanrının beni kutsamasını istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030405
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030405,
					"content": "Yine de adak adamak bir tür ibadet sonuçta. Çok çalışmam gerektiğini değiştirmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030406
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030406,
					"content": "Annemler, gezmek istiyorsam önce yeteri kadar para kazanmam gerektiğini söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030407
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030407,
					"content": "Tanrı seni kutsadığı sürece hayallerin gerçek olur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030408
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030408,
					"content": "Ben o kadar emin değilim. Sonuçta dünyayı gezecek olsam Inazuma tanrılarının beni koruyabileceğini sanmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030409
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030409,
					"content": "Annemle babam tanrılara adak adamanın biraz kafanı boşaltmaya yaradığını söylerdi. Dileklerinin gerçek olması yine de ne kadar çabaladığına bağlıdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030410
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030410,
					"content": "Ben konuyu o kadar iyi açıklayamıyorum. Daha fazla şey öğrenmek isterseniz Nanatsuki ile konuşun. Bu konuda bilgilidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030411
					],
					"speakerTitle": "Kouichi"
				},
				{
					"id": 728030411,
					"content": "Hımm... Hadi gidip Nanatsuki'yi bulalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
			]
		},
		{
			"id": 7280305,
