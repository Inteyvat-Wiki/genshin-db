			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Alaycı Hazine Avcısı"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728030201,
					"content": "Sizi hırsızlar! Bütün adaklarımı çaldığınız için tanrı bana cevap vermiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030202
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030202,
					"content": "Adak mı? Tapınağın yanında duran şeylerden mi bahsediyorsun? Hediye edilse bile kabul etmeyiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030203
					],
					"speakerTitle": "Alaycı Hazine Avcısı"
				},
				{
					"id": 728030203,
					"content": "Ayrıca tapınağa öyle değersiz adaklar adıyorsan tanrının sana cevap vermesi bile mucize!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030204
					],
					"speakerTitle": "Alaycı Hazine Avcısı"
				},
				{
					"id": 728030204,
					"content": "Ne-Ne dedin sen? Adaklarım değersiz değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030205
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030205,
					"content": "Neyse. Seninle uğraşacak zamanımız yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030207
					],
					"speakerTitle": "Alaycı Hazine Avcısı"
				},
				{
					"id": 728030207,
					"content": "Adaklarım değersiz değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030208
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030208,
					"content": "Bize dileklerini söyler misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030209
					]
				},
				{
					"id": 728030209,
					"content": "Peki. Madem böyle oldu... Zaten dileğim gerçekleşmeyecek muhtemelen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030210
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030210,
					"content": "İki basit dileğim var. İlki bir daha sınava girmemek! Sınava girmezsem azarlanmam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030211
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030211,
					"content": "Bir de... Okuldaki kaba kızın bana zorbalık yapmamasını istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030212,
						728030214
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030212,
					"content": "Ben de sınavları sevmem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030213
					]
				},
				{
					"id": 728030213,
					"content": "Evet! Sınavlar çok sıkıcı. Ama o kız beni daha çok rahatsız ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030216
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030216,
					"content": "Birkaç kere tapınakta dilek dilediğimi görmüş. Sınav olmak istemediğimi söylediğimi duyunca öğretmenlerime gidip sınav sonuçlarımı istemiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030217
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030217,
					"content": "Sonra sürekli zamanımı tapınakta dua ederek harcamak yerine dersi dinlersem daha iyi olacağını söylemeye başladı. Ayrıca o kadar ısrarcı olursam tanrıların bile benden sıkılacağını söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030218
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030218,
					"content": "Hatta acınacak halde olduğumu bile söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030219
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030219,
					"content": "Tanrıya fazla bel bağlamak iyi bir şey değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030220
					]
				},
				{
					"id": 728030220,
					"content": "Ama yetişkinler bir zorlukla karşılaşınca hep tapınağa adak adıyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030221,
						728030222
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030221,
					"content": "Dilek tutuyorlar sadece.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030223
					]
				},
				{
					"id": 728030223,
					"content": "Hımm... Anlamadım... Herkesin tanrıdan yardım istemek için tapınaklara adak adadığını sanıyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030224
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030224,
					"content": "Hadi başkasına soralım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030225
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030225,
					"content": "Hımm... Peki. Neyse, zaten dileğim gerçekleşmeyecek artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				},
				{
					"id": 728030222,
					"content": "Sonuçta sorunlarını yine kendi başlarına çözmeleri gerekiyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030223
					]
				},
				{
					"id": 728030214,
					"content": "Kaba kız mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030215
					]
				},
				{
					"id": 728030215,
					"content": "Sınıfımdaki bir kız. Asla rahat bırakmıyor beni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030216
					],
					"speakerTitle": "Shouta"
				}
			]
		},
