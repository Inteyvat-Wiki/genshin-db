			"dialogs": [
				{
					"id": 737130101,
					"content": "Ta-da! Geldik işte! Şu sığ kısımdan girelim. Sanki gözlerimizin önüne serilen bir tablonun içine yürüyormuşuz gibi hissedeceğiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737130102,
					"content": "Ah... Siz miydiniz? Yanınızda yeni yoldaşlar mı getirdiniz? Onlar... Mantar mı? Mantarlar hakkında bir şeyler okumuştum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130103
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130103,
					"content": "Burada takılan bir Melusina var! Ne hoş bir sürpriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130104,
						737130105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737130104,
					"content": "Seni tekrar görmek güzel Marine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130106
					]
				},
				{
					"id": 737130106,
					"content": "Ben \"takılmıyorum\", bu yılın turşusunu kurmak için Tidalga topluyorum. Köydekilerin de çoğu yardım etmek için geri döndü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130107
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130107,
					"content": "Hem Enghiene hem de küçük Roxane izin alıp yardıma geldiler. Şu an harıl harıl çalışıyorlar, ben de birazdan suya gireceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130108
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130108,
					"content": "Biliyor musun... Enghiene haksız değil. Mavi mantarlar gerçekten de biraz Tidalgaya benziyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130109
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130109,
					"content": "Yiyecek anlamında değil! Şirin olduklarını kastetmiştim sadece, başka bir şey değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130110
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130110,
					"content": "♫♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130111
					],
					"speakerTitle": "Davul Kafa"
				},
				{
					"id": 737130111,
					"content": "Hehe, sevimlilikten anlıyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130112,
						737130113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737130112,
					"content": "Mantar dostlarımız gerçekten çok sevimli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130114
					]
				},
				{
					"id": 737130114,
					"content": "Her neyse, sizinle tanışmak çok güzeldi. Artık gitmem gerek, buradaki zamanınızın tadını çıkarın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737130115
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 737130115,
					"content": "Pekala, biz de gidelim mi? Mantar dostlarımızla Fontaine'de harika su altı fotoğrafları çekeriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737130113,
					"content": "Melusinalar da bir o kadar sevimli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130114
					]
				},
				{
					"id": 737130105,
					"content": "Merhaba yeni Melusina arkadaşım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737130106
					]
				}
			]
		}
	]
