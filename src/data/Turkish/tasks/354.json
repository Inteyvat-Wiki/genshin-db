			"dialogs": [
				{
					"id": 3540401,
					"content": "Rüzgar Tanrısı seni korusun, yabancı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540402
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540402,
					"content": "Benim adım Amber, Favonius Şövalyelerinin Kaşifiyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540403
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540403,
					"content": "Mondstadt şehrinin sakinlerine benzemiyorsunuz. Kim olduğunuzu açıklayın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540404
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540404,
					"content": "Bela aramıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3540405,
					"content": "Tüm bela çıkaranlar öyle söyler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540406
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540406,
					"content": "#Merhaba, benim adım {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540407
					]
				},
				{
					"id": 3540407,
					"content": "Kulağıma buralara ait bir isim gibi gelmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540408
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540408,
					"content": "Ve bu... Maskot, bunun olayı ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540409,
						3540412
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540409,
					"content": "Biz arkadaşız.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540410
					]
				},
				{
					"id": 3540410,
					"content": "Yalnızca iki aydır yol arkadaşıyız ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3540411,
					"content": "Çoktan birbirimizin en yakın arkadaşı olduk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3540414,
					"content": "Yani, özetleyecek olursak, yol arkadaşlarısınız, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540415
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540415,
					"content": "Eh bakın, son zamanlarda Mondstadt çevresinde büyük bir ejder görüldü. Siz en iyisi bir an önce şehrin içine girin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540416
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540416,
					"content": "Şehir buradan çok uzak değil. Oraya kadar size eşlik edeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540417
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540417,
					"content": "Ha? Buraya gelmenin başka bir sebebi yok muydu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3540418,
					"content": "Öyle. Ama endişelenmeye gerek yok, o işi yaparken de her ikinizi güvende tutabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540419
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540419,
					"content": "Ayrıca... Siz ikinize güvenip güvenemeyeceğimden hâlâ emin değilim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540420,
						3540421
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540420,
					"content": "Neden bu kadar şüphecisin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540422
					]
				},
				{
					"id": 3540422,
					"content": "Ah, ahh... Özür dilerim. Muhtemelen bir şövalye olarak söylememem gereken bir şeydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540423
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540423,
					"content": "Sizden özür diliyorum, ıh... Tuhaf ama... Saygıdeğer gezginler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540424
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540424,
					"content": "Bu kulağa çok yapmacık geldi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3540425,
					"content": "Favonius Şövalyeleri El Kitabında belirtilen dil kullanımına karşı söyleyecek bir şeyiniz mi var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3540421,
					"content": "Misafirlerle böyle konuşmak oldukça kaba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540422
					]
				},
				{
					"id": 3540412,
					"content": "Acil durum yiyeceği.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540413
					]
				},
				{
					"id": 3540413,
					"content": "Hey! Bu bir maskot olmaktan bile daha kötü!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540414
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}