			},
			"dialogs": [
				{
					"id": 730230101,
					"content": "Hey, sen! Sırtında mantar taşıyan yaban domuzunu avlayan kişi... Buraya gelir misin? Seninle konuşmam gereken bir şey var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shefket"
				}
			]
		},
		{
			"id": 7302303,
			"completionStepIds": [
				7302303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302303",
							"2"
						],
						"stepId": 7302303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Shefket",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730230301,
					"content": "Rahatsız ettiysem gerçekten çok özür dilerim, bir şey konuşmaya gelmiştim de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230302
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230302,
					"content": "Şu avladığın Küflü Domuzdan bir parça alabilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230303
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230303,
					"content": "Küflü Domuz... Şu sırtında mantar olan yaban domuzunu mu diyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730230304,
					"content": "Evet, aynen. Sumeru çamurlarında yuvarlanıp durdukları için, sporlar kürklerine yapışır, orada büyür ve mantar olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230305
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230305,
					"content": "Haha, kimilerine göre mantarlar büyüdükçe üzerine yapıştığı yaban domuzunu yermiş. Aynı şekilde mantar aroması Küflü Domuz etine eşsiz bir tat veriyor ve bu yüzden de çok pahalı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230306,
						730230307
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230306,
					"content": "Ürperticiymiş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730230308
					]
				},
				{
					"id": 730230308,
					"content": "Haha! Bunlar sadece dedikodu. Küflü Domuzlar kış mevsiminde ya da yiyecek bir şey bulamadıklarında, birbirlerinin sırtındaki mantarlarla beslenebiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230309
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230309,
					"content": "Mantarlar ise yaban domuzları sayesinde sporlarını daha fazla alana yayabiliyor. Sağlıklı bir simbiyotik ilişki var aralarında...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230310
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230310,
					"content": "Ah, kusura bakmayın kendimi tanıtmayı unuttum. Adım Shefket, peki ya siz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230311
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230311,
					"content": "Ben Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730230312,
					"content": "#Ben de {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730230313
					]
				},
				{
					"id": 730230313,
					"content": "#{NICKNAME} ve Paimon, anladım. O Küflü Domuzu avlarken ne kadar çevik olduğunuzu gördüm, sıradan insanlar olmadığınız aşikar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230314
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230314,
					"content": "Aslına bakarsanız ben de şu sıralar vahşi hayvanlar üzerine bir araştırma yürütüyorum ama... *iç çeker* Bir türlü Küflü Domuz yakalayamadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230315
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230315,
					"content": "Beni görür görmez ya üzerime doğru koşuyor ya da kaçıyorlar. Böyle giderse, daha araştırmama başlayamadan belimden olacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230316
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230316,
					"content": "Bu yüzden de sizi o Küflü Domuzu avlarken görünce, etin birazını satın alabilir miyim diye sormak istedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230317
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230317,
					"content": "Özel bir et mi bu? Görünürde normal yaban domuzu etinden bir farkı yok bence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730230318,
					"content": "Aradaki farkları öğrenmek için araştırma yürütüyoruz! Bana satarsanız, size iyi bir ödeme yaparım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230319
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230319,
					"content": "(Küflü Domuz etini ona ver...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730230320
					]
				},
				{
					"id": 730230320,
					"content": "Çok teşekkür ederim! Artık araştırmama devam edebilirim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230321
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230321,
					"content": "Shefket nasıl bir araştırma yapıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730230322,
					"content": "Standart ekolojik araştırmalar. Bazen hayvanları yakalayıp onların büyüme süreçlerini analiz ediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230323
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230323,
					"content": "Tek bir hayvan bile bana tüm koloninin büyüyüşü hakkında birçok bilgi veriyor. Gerçekten de mucize gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230324
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230324,
					"content": "Paimon, hayvanları ne kadar çok sevdiğini görebiliyor Shefket!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730230325,
					"content": "Evet. Ben... Kendimi bildim bileli hayvanları çok severim. Onlar hakkında çalışmalar yapmak için çok zaman harcadım. Sumeru ormanlarının ekolojisi gerçekten büyüleyici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230326
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230326,
					"content": "Pekala, Küflü Domuz etini buldum. Şimdi sıra Alacakaranlık Kuşunda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230327
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230327,
					"content": "#Daha önce hiç Alacakaranlık Kuşu gördün mü {NICKNAME}? <color=#00E1FFFF>Apam Ormanı'nın güneyinde</color> yaşayan muhteşem bir kuştur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230328
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230328,
					"content": "Sumeru'ya özgü bir kuş türüdür. Akademi araştırmacıları tarafından sık sık mesaj iletmek için kullanılır. Uzun mesafe yolculuk edebilse de yağmurdan hiç hoşlanmaz, yağışlı günleri saklanarak geçirir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230329
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230329,
					"content": "Gitme vaktim geldi. Alacakaranlık Kuşunu... Umarım kendi başıma yakalayabilirim. Haha, sürekli insanlardan yardım isteyemem sonuçta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230330
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230330,
					"content": "Ama el atmak isterseniz de... Öhöm... Hayır demem aslında. Yakalayacağınız Alacakaranlık Kuşlarından satın alabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230307,
					"content": "Korkutucuymuş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730230308
					]
				}
			]
		},
		{
			"id": 7302308,
			"completionStepIds": [
				7302308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302308",
							"2"
						],
						"stepId": 7302308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Shefket"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730230801,
					"content": "Ah, o saha araştırmacısı demek sensin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730230802,
					"content": "Saha araştırmacısı derken? Haha, adım Shefket. Daha önce tanıştık. Bana biraz Küflü Domuz eti satmıştınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230803,
						730230805
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230803,
					"content": "Gerçekten mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730230804
					]
				},
				{
					"id": 730230804,
					"content": "Evet! Hatta normal yaban domuzu etinden çok daha fazla para vermişti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730230807,
					"content": "Burada ne yapıyorsun Shefket?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730230808,
					"content": "Hahaha! Bunu söylemek biraz utanç verici ama araştırmam hâlâ devam ediyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230809
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230809,
					"content": "İhtiyacım olan Alacakaranlık Kuşunu hâlâ yakalayamadım. Araştırmamın ilerleme hızı endişe verici... Ve en kötü kısmı bu değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230810
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230810,
					"content": "En kötü kısmı bu değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730230811,
					"content": "Münzevilerle bile karşılaştım. Beni görür görmez silahlarını çektiler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230812
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230812,
					"content": "Ah, demek Münzeviler seni biz sandı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730230813,
					"content": "Ne? Öyle mi? Sanırım... Muhtemelen Alacakaranlık Kuşlarını korumaya çalıştığımı anlamadılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230814
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230814,
					"content": "Bence bu Münzeviler Alacakaranlık Kuşlarını kendi malı olarak görüyor. Bu yüzden araştırmalarım için örnek toplamama karşılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230815
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230815,
					"content": "Malum, Alacakaranlık Kuşunun tüyleri oldukça pahalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230816
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230816,
					"content": "Alacakaranlık Kuşlarının ormanda kamufle olmak için özellikle renkli tüyler çıkarttığını biliyor muydunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230817
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230817,
					"content": "Ama maalesef o güzel, rengarenk tüyleri insanlar tarafından avlanmalarına yol açıyor. Çok üzücü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230818
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230818,
					"content": "Olamaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730230819,
					"content": "Benim sizler gibi Münzevilere göğüs gerecek cesaretim yok... *iç çeker*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230820
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230820,
					"content": "Bana yakaladığınız Alacakaranlık Kuşunun bir tüyünü satabilir misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230821
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230821,
					"content": "Geçen seferki gibi çok cömert bir ödeme yapacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230822
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230822,
					"content": "(Alacakaranlık Kuşu tüyünü ona ver...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730230823
					]
				},
				{
					"id": 730230823,
					"content": "Haha, Alacakaranlık Kuşu tüyü de tamam... Araştırmamın yarısı bitti sayılır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230824
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230824,
					"content": "Ama bu tüy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230825
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230825,
					"content": "Ne oldu? Bir sorun mu var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230826
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730230826,
					"content": "Hayır, yok. Kalitesi pek iyi değil. Bölgede yaşayan Alacakaranlık Kuşlarının pek iyi büyüyemediğinin bir göstergesi bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230827
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230827,
					"content": "Biraz daha dolaşıp daha çok tüy toplamam gerek. Alacakaranlık Kuşu kolonisine neler olduğunu öğrenmenin tek yolu bu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230828
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230828,
					"content": "<color=#00E1FFFF>Apam Ormanı'nın kuzeyinde</color> farklı bir Alacakaranlık Kuşu kolonisi varmış. Sanırım oraya gidip Alacakaranlık Kuşu aramam gerekecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230829
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230829,
					"content": "#Artık gitme vakti! Yine görüşmek dileğiyle {NICKNAME} ve Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730230805,
					"content": "Evet, hatırladım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730230806
					]
				},
				{
					"id": 730230806,
					"content": "Evet, Paimon şimdi hatırladı! Bu hayvansever Shefket!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230807
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7302312,
			"completionStepIds": [
				7302312
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302312",
							"2"
						],
						"stepId": 7302312,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Orhan",
					"Paimon",
					"Pamuk"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730231201,
					"content": "Kesin şunu! Kesin şunu! Niye yine burada Alacakaranlık Kuşu avlıyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231202
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231202,
					"content": "Şimdi anladım! Siz burayı mesken tutan kaçak avcılarsınız! Benim Alacakaranlık Kuşlarıma dadanmışsınız yine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231203
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231203,
					"content": "Dur bakalım! Bu Alacakaranlık Kuşları sana ait değil! Onları sen büyütmedin, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730231204,
					"content": "Büyütmedim ama... Bu Alacakaranlık Kuşları yine de bana ait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231205
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231205,
					"content": "Onları korumaktan ben sorumluyum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231206
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231206,
					"content": "Onları korumaktan mı sorumlusun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730231207,
					"content": "Evet. Adım Orhan. Otuzlu Teşkilat emirleri çerçevesinde Alacakaranlık Kuşu kolonisini kaçak avcılardan korumakla görevliyim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231208
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231208,
					"content": "Bana inanmıyor musun? İşte, Otuzlu Teşkilat Şerifi tarafından imzalanmış Emirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231209
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231209,
					"content": "Orhan sana Emirleri gösterir. Belgelerin üzerinde Otuzlu Teşkilatın imzası var.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730231210
					]
				},
				{
					"id": 730231210,
					"content": "Ne? Ama kulağımıza böyle bir şey gelmedi ki... Alacakaranlık Kuşları üzerine ekolojik bir çalışma yapılmıyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730231211,
					"content": "Öyle bir şey yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231212
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231212,
					"content": "Shefket bizi kandırdı mı yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730231213,
					"content": "Shefket... Yine mi şu Shefket... Doğa Hükümdarı aşkına! Eleman sizi aptal yerine koymuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231214
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231214,
					"content": "İnsanları kandırmak için Orman Muhafızı kılığına giriyor ama büyük ihtimalle aslında Hazine Avcılarıyla çalışıyor. Nadir görülen hayvan ürünlerinin satışını yapıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231215
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231215,
					"content": "Nasıl olur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231216,
						730231217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730231216,
					"content": "Kabul etmeliyim ki...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231218
					]
				},
				{
					"id": 730231218,
					"content": "Ona kanan ilk maceracılar değilsiniz. Her zaman maceracıları gizlice takip edip onlardan yardım isteme bahanesiyle yanaşıyor. Yılan gibi sinsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231219
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231219,
					"content": "#Ne yapacağız {NICKNAME}? Bir sürü Alacakaranlık Kuşu yakaladık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231220,
						730231223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730231220,
					"content": "Umarım hapishane yemekleri güzeldir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231221
					]
				},
				{
					"id": 730231221,
					"content": "HAYIR! Paimon, Otuzlu Teşkilat tarafından hapse atılmak istemiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730231222,
					"content": "Durum o kadar ciddi değil aslında. Alacakaranlık Kuşu kolonisi epey büyük, yani nesilleri göründüğü kadar tükenme tehlikesi altında değil. Hem sizi de kandırmış, hapse atılacak kadar ciddi bir durum yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231228
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231228,
					"content": "Paimon anladı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730231229,
					"content": "Ama cezadan da kaçamazsınız. Demek istediğim şu ki... Öhöm, kendinizi affettirmenin bir yolu var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231230
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231230,
					"content": "Kendimizi affettirebilir miyiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730231231,
					"content": "Evet. Neden bilmiyorum ama Shefket'in bol miktarda Alacakaranlık Kuşu tüyüne ihtiyacı var. Tüyleri koz olarak kullanabiliriz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231232
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231232,
					"content": "<color=#00E1FFFF>Apam Ormanı'nın doğusunda</color> devasa bir Alacakaranlık Kuşu yuvası olduğuna dair bir dedikodu yayarsak bunu hemen yutacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231233
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231233,
					"content": "Ama çok sinsi biridir. En ufak bir hareketimiz bile şüphelenmesine yeter de artar. Bu noktada siz ikiniz devreye giriyorsunuz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231234
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231234,
					"content": "#Hımm... Duyduğum kadarıyla sarışının adı {NICKNAME}. Uçanın adı neydi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231235
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231235,
					"content": "Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730231236,
					"content": "#Tamamdır, {NICKNAME} ve Paimon. Sizden Shefket ile iletişim kurmanızı istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231237
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231237,
					"content": "Paimon anladı. Bizim yanımızda gardını indirecek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730231238,
					"content": "Aynen öyle. Biz pusu kuracağız, onu oyalama işi de size kalacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231239
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231239,
					"content": "Buluştuğunuzda işaret vermek için \"Yaptığın her şeyi biliyoruz!\" diye bağırın, biz de hemen gelip enseleyelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231240
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231240,
					"content": "Ne dersiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231241
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231241,
					"content": "Tamamdır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231242
					]
				},
				{
					"id": 730231242,
					"content": "Hadi yapalım şunu! Haberi yaymaya başlayın. Sumeru Şehri'ni ben hallederim. Ferit, sen Gandharva'ya gidip fırsattan istifade Hazine Avcıları için çalışanların kimliklerini tespit etmeye çalış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231243
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231243,
					"content": "Pamuk, sen Vimara Köyü'ne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231244
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231244,
					"content": "Tamamdır Patron! Merak etme, sahte bilgileri hızla yayacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231245
					],
					"speakerTitle": "Pamuk"
				},
				{
					"id": 730231245,
					"content": "Bu sefer o kaçak avcı avucumuzun içinde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231246
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231246,
					"content": "#Gerisi size emanet {NICKNAME}. Onu saklandığı yerden çıkarmamız gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231223,
					"content": "Sumeru'dan kaçmak için çok mu geç kaldık?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231224
					]
				},
				{
					"id": 730231224,
					"content": "Kaçamayız. Sumeru'nun henüz keşfetmediğimiz bir sürü yeri var. Eninde sonunda geri dönmek zorunda kalacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730231225,
					"content": "Öylece kaçıp gitmenize izin veremem. Zaten Otuzlu Teşkilat da artan kaçak avcılık olaylarıyla mücadele etmek için bu bölgeyi çepeçevre sarmış durumda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231226
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231226,
					"content": "Hayııır! Otuzlu Teşkilat tarafından hapse atılmak istemiyorum!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231227
					]
				},
				{
					"id": 730231227,
					"content": "Sakin ol. Alacakaranlık Kuşu kolonisi epey büyük, yani nesilleri göründüğü kadar tükenme tehlikesi altında değil. Hem sizi de kandırmış, hapse atılacak kadar ciddi bir durum yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231228
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231217,
					"content": "Shefket bizi kandırmış...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231218
					]
				}
			]
		},
