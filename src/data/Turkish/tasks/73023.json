						"stepId": 7302316,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ferit",
					"Pamuk",
					"Paimon",
					"Orhan",
					"Shefket"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730231601,
					"content": "Hazine Avcılarını bir çırpıda alt ediyorsunuz.\\nFerit ve Pamuk da gelir...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730231602
					]
				},
				{
					"id": 730231602,
					"content": "Patron!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231603
					],
					"speakerTitle": "Ferit"
				},
				{
					"id": 730231603,
					"content": "Kusura bakmayın, biraz geç kaldık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231604
					],
					"speakerTitle": "Pamuk"
				},
				{
					"id": 730231604,
					"content": "Biraz geç mi kaldınız? Biz her şeyi çoktan hallettik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730231605,
					"content": "Tüh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231606
					],
					"speakerTitle": "Ferit"
				},
				{
					"id": 730231606,
					"content": "Nereye kayboldunuz siz? Her yeri didik didik aradım, sizi bulamadım. Öff! Leş gibi içki kokuyorsunuz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231607
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231607,
					"content": "Hehe... Bilgi yaymanın en kolay yolu sarhoş taklidi yapmaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231608
					],
					"speakerTitle": "Ferit"
				},
				{
					"id": 730231608,
					"content": "Bu sayede sahte bilgiler her yere yayılır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231609
					],
					"speakerTitle": "Pamuk"
				},
				{
					"id": 730231609,
					"content": "Siz harbiden sarhoşsunuz...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231610
					]
				},
				{
					"id": 730231610,
					"content": "#*iç çeker* {NICKNAME} olmasaydı, o Hazine Avcılarından temiz bir dayak yerdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231611
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231611,
					"content": "#İtiraf etmeliyim ki {NICKNAME} Hazine Avcılarını bu kadar hızlı yenince çok şaşırdım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231612
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231612,
					"content": "#Gayet normal! {NICKNAME} göründüğünden daha güçlüdür!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730231613,
					"content": "Ona ne şüphe. Seni daha önce durdurmaya çalışırken beni de kolaylıkla yenmiştin ama bu... Beklentilerimi biraz aştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231614,
						730231615
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231614,
					"content": "Çok naziksin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231616
					]
				},
				{
					"id": 730231616,
					"content": "#Pekala Shefket. Bizim sayemizde... Yani {NICKNAME} sayesinde, o çok güvendiğin Hazine Avcıları tek tek yenildi. Söyleyecek başka sözün kaldı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231617
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231617,
					"content": "Ben, şey... Çok zorlu bir çocukluk geçirdim, çok travma yaşadım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231618
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730231618,
					"content": "Müsaadenizle açıklamak istiyorum... Henüz yeni yürümeye başlamıştım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231619,
						730231620
					],
					"speakerTitle": "Shefket"
				},
				{
					"id": 730231619,
					"content": "Umurumuzda değil!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231621
					]
				},
				{
					"id": 730231621,
					"content": "Adamımızı yakalayıp suçlarınızın kefaretini ödediniz. Bir dahaki sefere kime güveneceğinizi iyi seçin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231622
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231622,
					"content": "En başında beni dinleseydiniz böyle olmazdı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231623
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231623,
					"content": "Hey! Hiçbir şey söylemeden bize saldırdın, ne yapsaydık?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231624
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730231624,
					"content": "Kabul ediyorum... Bazen biraz gergin olabiliyorum. Ben de bir dahaki sefere daha sakin olmaya çalışacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231625
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231625,
					"content": "Ama umarım bir daha böyle bir şey yaşanmaz. Dikkatli olun, herkese güvenmeyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231626
					],
					"speakerTitle": "Orhan"
				},
				{
					"id": 730231626,
					"content": "Anladık, anladık!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231627
					]
				},
				{
					"id": 730231627,
					"content": "Paimon bunu aklında tutacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231628
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730231628,
					"content": "Orhan, Shefket'le birlikte yanınızdan ayrılır...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 730231620,
					"content": "Maval okumayı bırak artık!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231621
