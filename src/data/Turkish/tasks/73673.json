				"points": []
			},
			"dialogs": [
				{
					"id": 736730101,
					"content": "Selamlar, Regzar Kalesi'ne hoş geldiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730102
					],
					"speakerTitle": "Effendi"
				},
				{
					"id": 736730102,
					"content": "Burası Otuzlu Teşkilatın irtibata geçip bir çalışma düzeni sağladığı yerdir. Kıyafetine bakılırsa onlardan biri değilsin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730103
					],
					"speakerTitle": "Effendi"
				},
				{
					"id": 736730103,
					"content": "Ha, şimdi anladım. İş ilanı için geldin, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730106,
						736730104
					],
					"speakerTitle": "Effendi"
				},
				{
					"id": 736730106,
					"content": "Evet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736730107
					]
				},
				{
					"id": 736730107,
					"content": "Peki o zaman. Her ihtimale karşı ben sana kısaca açıklayayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730108
					],
					"speakerTitle": "Effendi"
				},
				{
					"id": 736730108,
					"content": "Adım Effendi. Akademi ve Otuzlu Teşkilat arasındaki iş birliğini koordine etmek üzere Akademi tarafından gönderildim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730109
					],
					"speakerTitle": "Effendi"
				},
				{
					"id": 736730109,
					"content": "Akademinin Otuzlu Teşkilatı tüm Sumeru Şehri'ni koruması için tuttuğunu duymuş olabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730110
					],
					"speakerTitle": "Effendi"
				},
				{
					"id": 736730110,
					"content": "Kendileri ayrıca Sumeru sakinlerinin bazı gündelik sorunlarına yardım etmekle de yükümlüler. Bu da haliyle iş yüklerini iyice artırıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730111
					],
					"speakerTitle": "Effendi"
				},
				{
					"id": 736730111,
					"content": "Omuzlarındaki yükü azaltmak için Parchamdar'a danışıp işe bir asistan almaya karar verdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730112
					],
					"speakerTitle": "Effendi"
				},
				{
					"id": 736730112,
					"content": "Şehrin savunmasıyla ilgilenmene gerek yok. Şehir sakinlerinin özel görevlerini tamamlamamıza yardım etsen yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730113
					],
					"speakerTitle": "Effendi"
				},
				{
					"id": 736730113,
					"content": "İşin detaylarına gelecek olursak... Çoğu görev uğraştırıcı ve çok ayrıntılı. Örneklerle açıklayayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Effendi"
				},
				{
					"id": 736730104,
					"content": "İş ilanı mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736730105
					]
				},
				{
					"id": 736730105,
					"content": "Hiç incelemeden mi geldin yoksa? Neyse, ben sana açıklayayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730108
					],
					"speakerTitle": "Effendi"
				}
			]
		},
		{
			"id": 7367302,
