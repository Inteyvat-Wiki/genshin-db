			},
			"dialogs": [
				{
					"id": 736730201,
					"content": "Görevler genel hatlarıyla böyle. Vaktin varsa ve almak istersen şahane olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730202
					],
					"speakerTitle": "Effendi"
				},
				{
					"id": 736730202,
					"content": "Tamamlayacağın her görevin karşılığını adil bir şekilde alacaksın, lojistik memuru ve ben bu konuda mutabıkız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730203
					],
					"speakerTitle": "Effendi"
				},
				{
					"id": 736730203,
					"content": "Bu özel görevler çok önemsiz duruyor olabilir ama umarım bu işin ne kadar mühim olduğunu anlamışsındır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730204
					],
					"speakerTitle": "Effendi"
				},
				{
					"id": 736730204,
					"content": "Yardımcı olduğun kişiler seni hem takdir edecek hem de sana saygı duyacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730205
					],
					"speakerTitle": "Effendi"
				},
				{
					"id": 736730205,
					"content": "Görevleri yapmaya devam edersen şehir sakinleri arasındaki İtibarın da artacak ve seni kolayca aralarına kabul etmeye başlayacaklar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730206
					],
					"speakerTitle": "Effendi"
				},
				{
					"id": 736730206,
					"content": "Ben de sana daha önemli ve karmaşık işler vermeye başlayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730207
					],
					"speakerTitle": "Effendi"
				},
				{
					"id": 736730207,
					"content": "İş genel olarak böyle. Umarım bir düşünüp değerlendirirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736730208
					],
					"speakerTitle": "Effendi"
				},
				{
					"id": 736730208,
					"content": "İşi kabul edersen özel görevleri de almaya başlayabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Effendi"
				}
			]
		}
	]
}