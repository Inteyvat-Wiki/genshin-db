			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111130601,
					"content": "Sonunda! Paimon o tuhaf yerde sonsuza dek hapsolacağımızı sanıyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130602,
					"content": "Demek istediğim de buydu. İzinsiz girenler hep en sonunda korkup kaçıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130603
					]
				},
				{
					"id": 111130603,
					"content": "Yani tuhaf şeyler yolumuzdan çekildi, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130604,
					"content": "Aynen, buradan aşağı atlamanız gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130605
					]
				},
				{
					"id": 111130605,
					"content": "Neee?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1111307,
			"completionStepIds": [
				1111307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111307",
							"2"
						],
						"stepId": 1111307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111130701,
					"content": "Sanırım seni mutlu etmek için yapabileceğimiz her şeyi yaptık, sence de öyle değil mi Koca G?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130702
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130702,
					"content": "Ama... Olur da bir gün kötü bir ruh olup aklında fena saçmalıklarla geri dönersen o zaman arkadaşlığımızı unutup seni daha nahoş bir vedayla gönderirim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130703
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130703,
					"content": "Olmayacağım, söz! Benim için yaptığınız her şey için teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130704
					],
					"speakerTitle": "Koca G"
				},
				{
					"id": 111130704,
					"content": "Artık arkadaşlarımın da iyi olduğunu bildiğime göre, onları rahatsız etme gibi bir niyetim yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130705
					],
					"speakerTitle": "Koca G"
				},
				{
					"id": 111130705,
					"content": "Ben de teşekkür etmek istiyorum. Sayende benim de hayalim gerçek oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130706
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111130706,
					"content": "Sen de benim uyarılarımı dikkate almalısın Meng. Geçmişin peşini bırakmazsan ikinizi sandığından daha kısa süre içerisinde bir araya getirebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130707
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130707,
					"content": "Böyle korkunç bir şeyi yüzünde gülücüklerle nasıl söyleyebiliyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130708
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111130708,
					"content": "Hahaha, o zaman sonuncu ama en önemli şeyi yapalım, Koca G'ye veda edelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130709
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130709,
					"content": "Görüşürüz Koca G!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130710,
					"content": "Öyle değil! Onunla \"görüşmeyeceksin\" ki. Elveda gibi sözcüklerle devam edelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130711
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130711,
					"content": "Hahaha, sorun yok. Ben artık gideyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130712
					],
					"speakerTitle": "Koca G"
				},
				{
					"id": 111130712,
					"content": "Üzgünüm. O gün haykırdığımız tüm o dilekler içinde bir tek bizimkiler gerçekleşmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130713
					],
					"speakerTitle": "Koca G"
				},
				{
					"id": 111130713,
					"content": "Üzülme. Pişmanlığın olmadığı bir hayat yok. Artık huzur içinde gidebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130714
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111130714,
					"content": "Pekala, hiçbirinizi unutmayacağım... Elveda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130715
					],
					"speakerTitle": "Koca G"
				},
				{
					"id": 111130715,
					"content": "Gitti... *iç çeker*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130716
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111130716,
					"content": "Bu sonun beni rahatlatacağını sanıyordum ama şimdi hissettiğim tek şey... Boşluk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130717
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111130717,
					"content": "Peki, ikinizin dileği neydi? Daha önce duyma şansımız olmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130718,
					"content": "\"İkimiz de birer aile ve iş kurduğumuzda, ailelerimizin Fener Şenliğinde birlikte vakit geçirmesini istedik.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130719
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111130719,
					"content": "Bu sebeple arkadaşlarıma imreniyorum. Minik Wu ve diğerleri dileklerini yerine getirme şansına sahip oldular. Ama benimki bir hayal olarak kalacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130720,
						111130721
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111130720,
					"content": "Neşelen biraz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130722
					]
				},
				{
					"id": 111130722,
					"content": "Aynen öyle! Ayrıca şunu da unutma; Bir gün herkes kül olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130723
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130723,
					"content": "Yani yapabiliyorken hayatın tadını çıkar ve yaşama görevin sona erdiğinde öbür dünyada istediğin kişiyle buluş. Harika değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130724
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130724,
					"content": "Şeeey... T-Teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130725
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111130725,
					"content": "Öyle ya da böyle, bir daha Wuwang Tepesi'ne döneceğimi sanmıyorum. Sindirmem gereken çok fazla duygu var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130726
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111130726,
					"content": "Sorun yok, tatile çıkman için işte sana fırsat. İznin onaylandı. Ah, elbette bu durum önceki anlaşmamızın şartlarını değiştirmez. Ücretsiz izin olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130727
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130727,
					"content": "Şey... Bir şey unutmadın mı acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130728,
					"content": "Arayışımızda bize yardım edeceğine söz vermiştin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130729
					]
				},
				{
					"id": 111130729,
					"content": "Sizi \"sınıra\" götürdüm ve etrafa bakmanızı sağladım, değil mi? Ama tepkinize bakılırsa aradığınız şeyi bulamamışsınız. Çok üzücü gerçekten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130730
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130730,
					"content": "Asıl üzücü olan senin yardım etmiyor olman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130731
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130731,
					"content": "Hahaha, ulaşamadığınız kanallar aracılığıyla sizin için ağız yokluyordum. Ancak maalesef takip etmeye değer bir ipucu bulamadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130732
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130732,
					"content": "Bir şey çıkarsa diye gözlerimi dört açacağım. Yani bir şey olursa sizi haberdar ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130733
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130733,
					"content": "Pek de ciddi gibi değilsin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130734,
					"content": "Hehe, yaşayanların izini bulma konusunda uzman değilim. Ancak \"sınırın\" diğer tarafından birini çağırmamı isterseniz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130735
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130735,
					"content": "Of, ürkütücü şeyler söylemeyi kes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130736
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130736,
					"content": "Sakin ol! Onları aramanıza yardım edeceğim, size söz. Hıh, benim üstün mizah anlayışım yine takdir görmüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130737,
						111130738
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130737,
					"content": "İşini gerçekten seviyorsun gibi görünüyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130739
					]
				},
				{
					"id": 111130739,
					"content": "Haha... Kendimce nedenlerim var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130740
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130740,
					"content": "Nedenler mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130741
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130741,
					"content": "Sınırın yakınında gördüğümüz ruhlar, yaşayanlar dünyasına özlem duymaya devam eden ölüler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130742
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130742,
					"content": "Ama eski müdürleri orada hiç görmedim, bir kez bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130743
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130743,
					"content": "Bu da demek oluyor ki Wangsheng Cenaze Evi Müdürü olmak onlar için doğru karardı ve pişmanlıkları olmadan göçtüler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130738,
					"content": "Görünüşe bakılırsa bir cenaze evi müdürü olmak sana çok yakışıyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130739
					]
				},
				{
					"id": 111130721,
					"content": "Önünde hâlâ çok uzun bir yol var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130722
					]
				}
			]
		},
