			"dialogs": [
				{
					"id": 111130801,
					"content": "Vay, üstünde beşimizin isimleri bile yazıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130802
					],
					"speakerTitle": "Koca G"
				},
				{
					"id": 111130802,
					"content": "Hehe, muhteşem. Aa, her yıl fener bıraktığını söylememiş miydin? Önümüzdeki yıllarda daha fazla isim eklemeyi düşünüyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130803
					],
					"speakerTitle": "Koca G"
				},
				{
					"id": 111130803,
					"content": "Minik Wu'nun çocukları ve Mumu'nun eşi gibi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130804
					],
					"speakerTitle": "Koca G"
				},
				{
					"id": 111130804,
					"content": "Aslında, iyi bir haberim var. Mumu yakında baba olacak. Son zamanlarda tek konuştuğu şey bu. Aynı anda hem heyecanlı hem de gergin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130805
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111130805,
					"content": "Hahaha, onun gibi bir mankafadan iyi bir baba olur mu merak ediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130806
					],
					"speakerTitle": "Koca G"
				},
				{
					"id": 111130806,
					"content": "Hayır, hayır, şimdi nasıl zehir gibi olduğuna şaşırırsın. Sana anlatayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Meng"
				}
			]
		},
