			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Koca G (Hatıra)",
					"Minik Wu (Hatıra)",
					"Mumu (Hatıra)",
					"Congzi (Hatıra)",
					"Meng (Hatıra)"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111130401,
					"content": "Yine Fener Şenliği zamanı. Günün birinde fenerleri kendimiz görsek güzel olmaz mıydı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130402
					],
					"speakerTitle": "Minik Wu (Hatıra)"
				},
				{
					"id": 111130402,
					"content": "Fener olmadan da dilek tutabilirsin. Annem demişti, gerçekten yüksek sesle bağırdığında ileride dileğin gerçek olurmuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130403
					],
					"speakerTitle": "Congzi (Hatıra)"
				},
				{
					"id": 111130403,
					"content": "Bağırmak mı? Bu biraz... Utanç verici değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130404
					],
					"speakerTitle": "Koca G (Hatıra)"
				},
				{
					"id": 111130404,
					"content": "İlk kişi bağırır bağırmaz herkes katılır ve böylece kimse utanmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130405
					],
					"speakerTitle": "Meng (Hatıra)"
				},
				{
					"id": 111130405,
					"content": "Evet. Minik Wu, sen başla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130406
					],
					"speakerTitle": "Congzi (Hatıra)"
				},
				{
					"id": 111130406,
					"content": "Pekala... Asla bitmeyen yemek ve atıştırmalıkların olduğu devasa bir restoran açmak istiyorum, böylece her gün Acılı Jueyun Tavuğu yiyebilirim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130407
					],
					"speakerTitle": "Minik Wu (Hatıra)"
				},
				{
					"id": 111130407,
					"content": "Hahaha, dileğin bu mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130408
					],
					"speakerTitle": "Mumu (Hatıra)"
				},
				{
					"id": 111130408,
					"content": "Bu kadar komikse senin dileğin ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130409
					],
					"speakerTitle": "Minik Wu (Hatıra)"
				},
				{
					"id": 111130409,
					"content": "Zengin olmak tabii ki! Büyük işler yapmak ve yığınla Mora kazanmak! Mora ile her istediğini yapabilir ve mutlu olabilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130410
					],
					"speakerTitle": "Mumu (Hatıra)"
				},
				{
					"id": 111130410,
					"content": "Evet, zengin olursan o süper pahalı oyuncak kutusunu alabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130411
					],
					"speakerTitle": "Meng (Hatıra)"
				},
				{
					"id": 111130411,
					"content": "Bir tane de değil... Herkese birer tane. Hayır, herkese sürüyle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130412
					],
					"speakerTitle": "Mumu (Hatıra)"
				},
				{
					"id": 111130412,
					"content": "Mumu iş adamı olacaksa benim para kazanmama gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130413
					],
					"speakerTitle": "Congzi (Hatıra)"
				},
				{
					"id": 111130413,
					"content": "Dur bakalım, zengin olmak kolay değil. Tüm yükü bana yıkma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130414
					],
					"speakerTitle": "Mumu (Hatıra)"
				},
				{
					"id": 111130414,
					"content": "Bana gelince, ben Mingxiao Fenerlerini yapmayı öğrenmek istiyorum, en kocamanından! Ve Xiao Feneri de. Çevredeki en iyi fener ustası olacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130415
					],
					"speakerTitle": "Congzi (Hatıra)"
				},
				{
					"id": 111130415,
					"content": "Evet, böylece Xiao Fenerlerini bırakmak için Liyue Limanı'na gitmemize gerek olmaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130416
					],
					"speakerTitle": "Koca G (Hatıra)"
				},
				{
					"id": 111130416,
					"content": "Her neyse, dileklerimiz bunlar. Meng, Koca G, peki ya siz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130417
					],
					"speakerTitle": "Minik Wu (Hatıra)"
				},
				{
					"id": 111130417,
					"content": "Ben mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130418
					],
					"speakerTitle": "Koca G (Hatıra)"
				},
				{
					"id": 111130418,
					"content": "Aa, hepsi kayboldu... Tam da dileğini dileyecekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130419,
					"content": "Anılarım canlandı! Bu, beşimizin beraber geçirdiği son Fener Şenliğiydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130420
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111130420,
					"content": "Çok zaman geçti... Herkes büyümüş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130421
					],
					"speakerTitle": "Koca G"
				},
				{
					"id": 111130421,
					"content": "Tüm o dilekler gerçekten gerçekleşti mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130422,
						111130423
					],
					"speakerTitle": "Koca G"
				},
				{
					"id": 111130422,
					"content": "Gerçekleşti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130424
					]
				},
				{
					"id": 111130424,
					"content": "Her birinden senin için veda hediyesi vermelerini istedik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130425,
					"content": "Minik Wu şef oldu, Mumu başarılı bir iş adamı oldu ve Congzi de harika Xiao Fenerleri yapıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130426,
					"content": "Cidden mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130427
					],
					"speakerTitle": "Koca G"
				},
				{
					"id": 111130427,
					"content": "Vay canına...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130428
					],
					"speakerTitle": "Koca G"
				},
				{
					"id": 111130428,
					"content": "Çocukluk hayallerimizi hiç unutmadık. Bu hayalleri birbirimize verdiğimiz sözler olarak kalplerimizde taşıdık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130429
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111130429,
					"content": "Her neyse. Bu feneri bırakma zamanı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130430
					],
					"speakerTitle": "Meng"
				},
				{
					"id": 111130430,
					"content": "#Hey {NICKNAME}, imayı anlasana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130431
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130431,
					"content": "Hadi onlara eski güzel günlerini yad etmeleri için biraz müsaade edelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130423,
					"content": "Sana kanıtlayabiliriz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130424
					]
				}
			]
		},
		{
			"id": 1111305,
			"completionStepIds": [
				1111305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111305",
							"2"
						],
						"stepId": 1111305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hu Tao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111130501,
					"content": "\"İmayı anla\" mı? Gerçekten mi? Hepimiz içinde, ima nedir öğrenmesi gereken asıl sensin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130502,
						111130504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130502,
					"content": "Senin \"sınırı koruman\" gerekmiyor mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130503
					]
				},
				{
					"id": 111130503,
					"content": "Meng \"sınırı\" zaten geçti, Koca G'yi göndermenin tek yolu bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130506
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130506,
					"content": "Söylediğim gibi, bir zamanlar Wangsheng Cenaze Evi gerçek bir cenaze evinden çok bir doktor muayenehanesine benziyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130507
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130507,
					"content": "Hükümdarlar Savaşı sırasında toprak, ceset yığınlarıyla kaplanmıştı. İnsanlar sefalete ve ızdıraba sürüklenmişti. Hastalık tüm diyara yayılmıştı. Ölüm, yaşayanların dünyasını viraneye çevirmişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130508
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130508,
					"content": "İşte Wangsheng Cenaze Evinin ilk kurulduğu zamanlar böyle zamanlardı. Kurucuları insan oldukları için önemsiz addedilmişlerdi, ancak yavaş yavaş ölümü uzaklaştırmayı başardılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130509
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130509,
					"content": "Bunun için büyük bir bedel ödemiş olmalılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130510,
					"content": "Liyue Limanı nesillerdir bolca ün ve Mora hayali kuran insanları kendine çeken işlek bir refah merkezi oldu. Ama nihayetinde bazı çılgınlar ölülerin \"mirasını\" uyandırdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130511
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130511,
					"content": "Yani, dünyayı yakıp yıkan ve yenilgiye uğrayan tanrıların kalıntılarından bahsediyorum. Konunun ayrıntılarına girmeyeceğim ama şu kadarını söyleyeyim; son kertede her şey ölümle yaşam arasındaki ince çizgide gidip geliyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130512
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130512,
					"content": "Dengeyi sağlamak ve \"sınırı\" eski haline getirmek düşündüğünüzden daha uzun, hatta çok daha uzun sürdü. Sınır olmadan Liyue Limanı da bugün bildiğimiz gibi olmazdı. Tabii, Wangsheng Cenaze Evi, siz veya ben de öyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130513,
						111130515
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130513,
					"content": "Senin böyle güzel hikayeler anlatabileceğin hiç aklıma gelmezdi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130514
					]
				},
				{
					"id": 111130514,
					"content": "Hahaha, önceki müdürlerin hepsi bu hikayeyi anlatmaya bayılıyordu. Tabii, bana sorarsan en iyi ben anlatıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130517
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130517,
					"content": "Sözlerimle ne yaptığınız size kalmış. Umarım çoğu, zihninizden silinip gitmiştir. Wangsheng Cenaze Evi tam da bu, bir cenaze evi. Başka bir şey değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130518,
						111130519
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130518,
					"content": "Belki de böylesi daha iyidir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130520
					]
				},
				{
					"id": 111130520,
					"content": "Huzurlu zamanlardayız ama yaşam ve ölüm arasındaki bu ahenkle dolu eş varoluşun değeri asla hafife alınmamalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130521
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130521,
					"content": "Zamanı geldi. Hadi gidelim! Onları \"her şeyin başladığı ve sona erdiği yere\" götürelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130522
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130522,
					"content": "Nasıl bir yer orası öyle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130523,
					"content": "Birbirimize ilk rastladığımız yeri kastettim sadece. Bazen bazı şeylere komik isimler uyduruyorum, tamam mı? Ağzımdan çıkan her laf için beni soru yağmuruna tutmana gerek yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130519,
					"content": "Katılıyorum. Geri dönme zamanı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130520
					]
				},
				{
					"id": 111130515,
					"content": "Biraz daha anlatabilir misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130516
					]
				},
				{
					"id": 111130516,
					"content": "Kesinlikle olmaz! Biliyorsun, merak insanın başına iş açar. Uyarımı unutma, ne kadar az bilirsen o kadar iyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130517
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130504,
					"content": "İşinin kapsamı hiç düşündüğüm gibi değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130505
					]
				},
				{
					"id": 111130505,
					"content": "Cidden mi? Gerçi sonuç aynı. Tam olarak ne yaptığım ve nasıl yaptığım yalnızca ufak teknik detaylar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130506
					],
					"speakerTitle": "Hu Tao"
				}
			]
		},
		{
			"id": 1111306,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1111303",
