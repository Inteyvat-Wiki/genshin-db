			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Minik Wu",
					"Mumu",
					"Congzi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111122301,
					"content": "Biliyor musunuz, şimdi fark ettim... Benim verdiğim eşya doğrudan satın alınan tek şey. İkinizinki de el yapımı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111122302
					],
					"speakerTitle": "Mumu"
				},
				{
					"id": 111122302,
					"content": "Ama seninkinin değeri çok daha fazla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111122303
					],
					"speakerTitle": "Minik Wu"
				},
				{
					"id": 111122303,
					"content": "Burada önemli olan, eşyanın Mora olarak karşılığı değil. Bu şeylerin hepsi çocukluğumuzun büyük bir parçası oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111122304
					],
					"speakerTitle": "Congzi"
				},
				{
					"id": 111122304,
					"content": "Sözümüzü asla unutmayacağımızı gösteriyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Congzi"
				}
			]
		},
		{
			"id": 1111304,
			"completionStepIds": [
				1111304
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
