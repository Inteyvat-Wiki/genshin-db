			"dialogs": [
				{
					"id": 111131001,
					"content": "Siz... Müşteri misiniz? Kusura bakmayın, bu biraz beklenmedik oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111131002
					],
					"speakerTitle": "Lanxi"
				},
				{
					"id": 111131002,
					"content": "Sizi Hu Tao'nun getirdiğini görmek içime su serpti... Ama korkarım burada misafirleri eğlendirecek bir şeyimiz yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111131003
					],
					"speakerTitle": "Lanxi"
				},
				{
					"id": 111131003,
					"content": "Sen kimsin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111131004
					]
				},
				{
					"id": 111131004,
					"content": "Adım Lanxi, uzun zamandır birini bekliyorum. Tam olarak ne kadar süredir beklediğimi bilemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111131005
					],
					"speakerTitle": "Lanxi"
				},
				{
					"id": 111131005,
					"content": "Herkes beklemenin zor olduğunu söylüyor ama yürümek, izlemek, yeni gelenlerle ve eski kalabalıklarla konuşmak... Bunlar zaman geçirmeme yardımcı oluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111131006
					],
					"speakerTitle": "Lanxi"
				},
				{
					"id": 111131006,
					"content": "Beklemeye devam edebilirim ama beklediğim şeyin olup olmayacağını kim bilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111131007
					],
					"speakerTitle": "Lanxi"
				},
				{
					"id": 111131007,
					"content": "Benim için fark etmiyor, tek yapabildiğim şey beklemek zaten. Ama eğer siz de sizin için önemli birini arıyorsanız sonsuza dek beklememek en iyisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lanxi"
				}
			]
		},
