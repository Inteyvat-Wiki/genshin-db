			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hu Tao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111130101,
					"content": "Ah! Döndünüz mü? Beklediğimden daha kısa sürdü!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130102
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130102,
					"content": "Ağzından bir şey kaçırmadın, değil mi Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130103
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130103,
					"content": "Paimon sence o kadar güvenilmez birisi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130104,
					"content": "Hehe, şaka yapıyorum. Her neyse, görünüşe göre size birkaç hatıralık vermek istemişler. Sanırım olayı anladılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130105
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130105,
					"content": "Yine de konu hayaletler ve hortlaklar, ruhlar ve ruhsal varlıklar gibi şeylere gelince herkesin bildiği tek şey ne bekleyeceğini asla bilemeyeceğindir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130106
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130106,
					"content": "Bu da onların, hikayenin tamamını kurcalayıp öğrenme konusunda neden isteksiz olduklarını açıklıyor. Bence iyi olmuş, çünkü öğrenmeye çalışsalardı... Uğraşmam gereken çok şey olacaktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130107,
						111130108
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130107,
					"content": "Kulağa ürkütücü geliyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130109
					]
				},
				{
					"id": 111130109,
					"content": "\"Yaşam ve ölüm arasındaki sınırı korumak...\" Bu Wangsheng Cenaze Evinin en önemli sorumluluğu. Ve ben de pek çoğundan daha katıyım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130110
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130110,
					"content": "Peki ya biz? Bizim \"sınırı\" geçmemizin bir önemi yok mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130111,
					"content": "Elbette hayır. Ne de olsa siz tüm olana bitene zaten dahil oldunuz, tıpkı Meng gibi. Perdenin arkasına bir göz atmanız dünyanın sonu olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130112
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130112,
					"content": "Gittiğimiz yerde gördüklerinize veya olabileceklere şaşırmayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130113
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130113,
					"content": "Tüm bunlar yaşayanlar ve ölüler arasındaki sınır dahilinde oluyor, aslında sıradan bir yer. Orasıyla ilgili tek özel şey kimsenin orayı bilmiyor olması.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130114
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130114,
					"content": "Ne yaparsanız yapın, telaşa kapılmayın, tamam mı? Yoksa çıktığımızda hafızanızı silmek zorunda kalırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130115
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130115,
					"content": "Yani söylediğim her şeyi dinleyin. Hadi gidelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130116
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 111130116,
					"content": "P-Paimon korkuyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111130117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130117,
					"content": "Ama Hu Tao'nun da dediği gibi, buna zaten dahil olduk. Sonuna kadar gitsek iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111130108,
					"content": "Artık ciddi olup olmadığını anlayamıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111130109
					]
				}
			]
		},
		{
			"id": 1111302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
