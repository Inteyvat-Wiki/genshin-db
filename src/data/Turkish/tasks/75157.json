			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Conulaf"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751570101,
					"content": "*ağlar* Bu kafese hapsolmayı beklemiyordum... Gece Rüzgarının Ustalarının bir üyesi olarak itibarımı kaybettim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570102
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751570102,
					"content": "Kabilenin yüz karasıyım resmen, yüz karası...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570103
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751570103,
					"content": "Yine mi sen? Bu sefer ne oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751570104
					]
				},
				{
					"id": 751570104,
					"content": "Aa, kurtarıcım, yine karşılaştık... *iç çeker* Beni bu halde gördüğün için üzgünüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570105
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751570105,
					"content": "Aa, daha önce adımın Conulaf olduğunu ve Gece Rüzgarının Ustalarından bir rahibe adayı olduğumu söylememiş miydim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570106
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751570106,
					"content": "İsminden de anlayacağın üzere şu anda rahibelik eğitimi alıyorum. Ve... Şey, kabilemin büyükleri bana atam Sanhaj'ın eskiden diğer kabileden insanlarla bahislere girdiğini ve onları sürekli kandırdığını söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570107
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751570107,
					"content": "Ve büyüklerim bana \"Git ve biraz bahis kazan! Gerçek bir Gece Rüzgarının Ustası olmanın yegane yolu budur!\" dediler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570108
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751570108,
					"content": "Ben de o yüzden buradan geçerken bir turnuvaya rast gelince düşündüm ve... Ben de bir bahse girdim. Yani, ister \"son şampiyon Tepetlizor\" olsun ister \"son on yılın en güçlü çaylağı Gukuzor\" olsun, ne fark eder ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570109
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751570109,
					"content": "En güçlü Sürüngenler tabii ki bizim Iktomizorlarımızdır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570110
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751570110,
					"content": "Ben öyle düşünmüştüm en azından... Ama yanlış Sürüngene oynadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570111
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751570111,
					"content": "Bir sürü borca girmekle kalmadım, üstüne bir de beni buraya tıktılar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570112
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751570112,
					"content": "Bana \"Iktomizor kazanırsa sana on kat Mora vereceğiz ama kaybederse bu kafeste kalacaksın, tamam mı?\" diye sordular.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570113
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751570113,
					"content": "Şimdi ne yapacağım? Keşke bu iki Sürüngene haddini bildirecek bir Iktomizor olsaydı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570114
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751570114,
					"content": "Böylece buradan çıkar ve on kat Mora kazanırdım! ... Şey, yani daha da önemlisi, şu iki kabilenin bizim müthiş Iktomizorlarımızı küçük görmelerine izin vermemiş olurduk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570115
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751570115,
					"content": "*ağlar* Lütfen sevgili kurtarıcım. Eğer böyle bir Iktomizor bulabilirsen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570116
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751570116,
					"content": "*iç çeker* Ben de saçma sapan konuşuyorum işte. Sen bizim kabilemizden bile değilsin ki. Iktomizoru nereden bulacaksın? Gökten inecek değil ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570117
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751570117,
					"content": "Bulmaya çalışacağım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751570118
					]
				},
				{
					"id": 751570118,
					"content": "G-Gerçekten bulabilir misin? Öyleyse bu kafeste kalıp senden haber bekleyeceğim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Conulaf"
				}
			]
		},
