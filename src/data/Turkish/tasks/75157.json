			},
			"dialogs": [
				{
					"id": 751570201,
					"content": "Iktomizor ani ve hızlı bir giriş yaparak önceki şampiyon \"Kızıl Dansçı\"yı mağlup eder.\\nKararlaştırıldığı üzere organizatör, Gece Rüzgarının Ustalarından olan tedbirsiz genç hanımı serbest bırakır...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751570202
					]
				},
				{
					"id": 751570202,
					"content": "*ağlar* Offf... Beni kafesin içinde eve göndereceklerini ve borçlarımı zorla aileme ödeteceklerini sanmıştım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570203
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751570203,
					"content": "Kafesteyken birdenbire atalarımızın bahis oynamadan önce hileyi hazırladıklarını hatırladım, bu şekilde kazanıyorlarmış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570204
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751570204,
					"content": "Özetle, kafesteyken düşünmek için çok zamanım oldu. Başkalarını kendi oyunlarında yenmek gibi gerçekçi olmayan beklentilere girdiğimi fark ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570205
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751570205,
					"content": "Bu kadar güçlü bir Iktomizoru bulmayı nasıl başardığını anlayamadım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570206
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751570206,
					"content": "Sonuç olarak sana minnettarım! Yardımın sayesinde hem yatırdığım parayı kurtardım hem de üstüne on kat Mora kazandım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570207
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751570207,
					"content": "Üstelik tüm bunlar kılımı bile kıpırdatmadan gerçekleşti... Ama şimdi yumuşak bir yatak bulmam lazım kendime. Yarım gün kafeste yattığım için sırtımın her yeri ağrıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751570208
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 751570208,
					"content": "Bu arada kazançlarımı senin almanı istiyorum sevgili kurtarıcım! Büyüklerim bana beklenmedik kazançların uğursuzluk getireceğini, bu yüzden onları başkasına vermenin daha hayırlı olacağını söylemişlerdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Conulaf"
				}
			]
		},
