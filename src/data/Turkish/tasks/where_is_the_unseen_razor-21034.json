					"nextDialogs": [
						210340607
					]
				},
				{
					"id": 210340607,
					"content": "Hımm... Bir kılıç parçasına benziyor. Teşekkürler. Yanıma alıp daha yakından inceleyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
