			"dialogs": [
				{
					"id": 210340101,
					"content": "Hımm, buralarda bir yerde olsa gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340102,
						210340103
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 210340102,
					"content": "Lahn?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340104
					]
				},
				{
					"id": 210340104,
					"content": "Seninle burada karşılaşmayı beklemiyordum Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340105
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 210340105,
					"content": "Geçen sefer bulduğun kılıç kabzasını hatırlıyor musun? İşte o gerçekten de Görünmez Usturanın bir parçasıymış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340106
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 210340106,
					"content": "İşin komik yanı, onu hatırlamamın tek sebebi üzerine çocukken gizlice kazıdığım bir işaretti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340107
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 210340107,
					"content": "Abime, eğer başka kılıç kullanmaya karar verirse Görünmez Usturanın benim olacağını söylediğimi hatırlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340108
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 210340108,
					"content": "Hehe. Sanırım olayların nasıl gelişeceğini ikimiz de bilemezdik... Görünmez Usturayı bu şekilde bulduğuma inanamıyorum. Kılıç gerçekten de... parçalanmış gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340109
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 210340109,
					"content": "Her neyse. Burada olduğuna göre artık sadede geleyim. Yeniden yardımına ihtiyacım var gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340110
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 210340110,
					"content": "İleride bir yerlerde iki grup canavar dolaşıyor. Kamplarında hatırı sayılır miktarda hasarlı silah biriktirmişler. Sebebini tam olarak bilemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340111
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 210340111,
					"content": "Maceracılar Loncası onların çevrelerinde hasara yol açmasından endişeleniyor ve aslında bu durumu çözmek için bir görev ilanı vermeyi düşünüyordu. Fakat detaylara baktığımda düşündüm ki... Belki orada Görünmez Ustura parçalarından bazılarını bulabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340112
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 210340112,
					"content": "Gezgin, ikimiz de onların birer kampını temizleyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340113
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 210340113,
					"content": "Soldaki kampta bir grup dağ yabanisi var. Tek başlarına senin için hiç problem olmazlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340114
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 210340114,
					"content": "Fakat sayıları çok fazla. Hepsiyle birden ve doğrudan yüzleşirsen, senin bile galip gelmen zor olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340115
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 210340115,
					"content": "Sağ tarafta ise bir Taş Sırtlı Dağ Reisi var. Onunla karşılaşmanın ne kadar tehlikeli olduğunu anlatmama gerek yok sanırım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340116
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 210340116,
					"content": "Yardımını ben istedim, bu yüzden en azından hangi kampa gideceğine sen karar verebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lahn"
				},
				{
					"id": 210340103,
					"content": "Burada ne yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340104
					]
				}
			]
		},
