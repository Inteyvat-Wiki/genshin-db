					"nextDialogs": [
						210340804
					]
				},
				{
					"id": 210340804,
					"content": "Gezgin? Seninle tekrar burada karşılaşmak ne hoş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340805
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 210340805,
					"content": "Evet. Bazı uygun görevler sayesinde birkaç yeni parça almayı başardım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340806
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 210340806,
					"content": "Durum öncekiyle aynı. Seni, birlikte canavarları yenmeye davet etmek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340807
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 210340807,
					"content": "Soldaki kampta bir grup dağ yabanisi var. Tek başlarına senin için hiç problem olmazlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340808
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 210340808,
					"content": "Fakat sayıları çok fazla. Hepsiyle birden ve doğrudan yüzleşirsen, senin bile galip gelmen zor olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340809
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 210340809,
					"content": "Sağ tarafta ise bir Taş Sırtlı Dağ Reisi var. Onunla karşılaşmanın ne kadar tehlikeli olduğunu anlatmama gerek yok sanırım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340810
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 210340810,
					"content": "Yardımını ben istedim, bu yüzden en azından hangi kampa gideceğine sen karar verebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lahn"
				},
