				},
				{
					"id": 210340502,
					"content": "Hallettim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340504
					]
				},
				{
					"id": 210340504,
					"content": "Sıradan canavarlar. Benim çok vaktimi almadılar. Ayrıca şansıma değerli bir uzun kılıç da buldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340505
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 210340505,
					"content": "Ben henüz bir şey bulamadım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340506
					]
				},
				{
					"id": 210340506,
					"content": "Merak etme. Yanlış tespit edilen bir yeri elememi sağladın. Teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340507
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 210340507,
					"content": "Al, bunu hak ettin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340508,
						210340509
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 210340508,
					"content": "Eğer tüm parçaları bulursak...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340510
					]
				},
				{
					"id": 210340510,
					"content": "Tek dileğim var... Görünmez Usturayı yeniden dövmek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340511
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 210340511,
					"content": "Fakat Görünmez Usturanın nasıl yapıldığı ve kullanılan malzemelerin olduğu taslak kayıp... Bir yolunu bulacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340512
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 210340512,
					"content": "Eğer Görünmez Usturayı yeniden dövebilirsem, o zaman abim de *iç çeker*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lahn"
				},
				{
					"id": 210340509,
					"content": "Onlarla ne yapacaksın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340510
					]
				},
				{
					"id": 210340503,
					"content": "Senin tarafta işler nasıl gidiyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340504
					]
				}
			]
