			"dialogs": [
				{
					"id": 210340401,
					"content": "Nasıl gidiyor? Kendi tarafındaki canavarları temizledin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340402
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 210340402,
					"content": "Bölgedeki tüm canavarları çoktan yendin mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210340403
					]
				},
				{
					"id": 210340403,
					"content": "Hı? Tabii ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210340404
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 210340404,
					"content": "Yani, ben de Liyue Maceracılar Loncası başkanıyım. Canavarlarla ilgilenmek benim için normal bir şey.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lahn"
