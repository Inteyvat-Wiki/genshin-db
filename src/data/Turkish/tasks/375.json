			"dialogs": [
				{
					"id": 3750101,
					"content": "İşe yaramadı... Biliyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750102
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750102,
					"content": "Biliyor muydun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3750103,
					"content": "#Sadece Favonius'un en becerikli Şövalyesi {NICKNAME} ne kadar etkili, onu görmek istedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750104
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750104,
					"content": "En iyi savaşçının her zaman en iyi kılıçla kuşanması gerekir, ama gel gör ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750105
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750105,
					"content": "Hikayeden uygun bir şarkı çıkmıyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750106
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750106,
					"content": "Ne demek istiyorsun? Yeterince iyi değil miyiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3750107,
					"content": "Hayır, onu demiyorum. Mondstadt'ın gözünün önünde duran savaşçıyı görememesinden bahsediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750108
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750108,
					"content": "Pekala. Görünüşe göre onu almamız mümkün değil. Çalmamız gerekecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750109
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750110,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750111
					]
				},
				{
					"id": 3750109,
					"content": "Tüm fikirlere açığız! Peki, nasıl çalacağımız konusunda bir önerin var mı acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750110
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750112,
					"content": "Ben hiçbir şey çalmak istemiyorum!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750113
					]
				},
				{
					"id": 3750111,
					"content": "Hadi ama, bir şey söyle. Fikirlerini söylemekte özgürsün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750112
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750113,
					"content": "Hahaha, haline bak. Daha başlamadan gözün korktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750114
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750114,
					"content": "Cidden, bu işe benden daha uygunsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750115
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750115,
					"content": "Şarkı söylemek dışında başka bir yeteneğim yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750116
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750116,
					"content": "Ayrıca, yakalanırsam korkunç bir adaletsizlikle tutuklandığımda kimse bana yardım etmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750117
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750117,
					"content": "Ayan beyan çalarken yakalanırsan nasıl \"korkunç bir adaletsizlikten\" söz edilebilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3750118,
					"content": "#Ama {NICKNAME} için durum farklı. Sen Favonius Şövalyelerinin yıldızısın. Mondstadt'a çok katkın oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750119
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750119,
					"content": "Yakalanırsan paçayı sıyırman çok kolay olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750120
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750140,
					"content": "Görünüşe göre muhafızlar gece nöbet tutmuyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750141,
					"content": "Bu fırsatı değerlendirebilirsek buradan kolayca sıyrılırız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750120,
					"content": "Yakalanmaktan bahsedip durmasana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3750122,
					"content": "Üzgünüm, bir dakika... Sen az önce... Barbatos olduğunu mu söyledin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750123
					]
				},
				{
					"id": 3750121,
					"content": "#Ee, ne diyorsun {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750122
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750123,
					"content": "Evet. Galiba öyle dedim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750124
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750125,
					"content": "Gerçekten tanrıysan eğer seni öylece bırakıp gidemeyiz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750126
					]
				},
				{
					"id": 3750124,
					"content": "Amacın nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750125
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750126,
					"content": "Kararın neden benim tanrı olup olmamama bağlı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750127
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3750128,
					"content": "Eğer bir tanrı değilsen o zaman yine de Dvalin'e yardım edeceğim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3750129
					]
				},
				{
					"id": 3750127,
					"content": "#Zamanımız olduğunda Paimon sana {NICKNAME} ve geçmişi hakkında bilgi verecek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3750130,
					"content": "Sana Göklerin Kutsal Lirini getireceğim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3750131,
					"content": "Başka bir ayrılık daha görmek istemiyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3750129,
					"content": "Ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3750130,
						3750131
					],
					"speakerTitle": "Venti"
				}
			]
		},
