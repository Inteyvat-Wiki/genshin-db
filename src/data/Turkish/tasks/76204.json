			},
			"dialogs": [
				{
					"id": 762040301,
					"content": "Tebrikler! Şimdi, bir bakayım... Hım, aferin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040302
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040302,
					"content": "Şimdiki Cadının Bahçesinin aksine, ben henüz bir melekken bu tapınakta kalırdım. Burası epey bir süre benim evimdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040303
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040303,
					"content": "Ne kadar da çok melek var! Anlaşılan çok popülermişsin Nicole!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762040304,
					"content": "Kendimi övmek gibi olmasın ama herkes hikayelerimi dinlemeye bayılırdı. Özellikle de insanların arasında yaşayıp onlara alametler gönderdiğim ve büyük medeniyetler kurmaları için onlara rehberlik ettiğim zamanlarla ilgili hikayeleri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040305
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040305,
					"content": "Ne zaman hikayenin güzel bir kısmına gelsem diğer melekler tüm işlerini bırakıp nefeslerini tutar, ağzımdan çıkacak her kelimeye odaklanırlardı. Bir arp telinin titrediğini ya da bir fırçanın tuvale sürtündüğünü bile duyamazdınız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040306
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040306,
					"content": "Ve ardından, iç içe geçmiş renkler ve tonlar çiçeklenirdi. Her şeyi altın rengi ihtişamıyla aydınlatan müzik ve ışık yayılırdı. Tam bir neşe ve sevinç coşkusu yaşanırdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040307
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040307,
					"content": "Aaa, ne güzelmiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762040308,
					"content": "Öyleydi Paimon... Öyleydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040309
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040309,
					"content": "O harika günler geride kalmış olsa da hayat hâlâ mutlu sürprizlerle dolu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040310
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040310,
					"content": "Bir saniye... Ben gazete okurken birisi heykellerimi çalmaya mı cüret etmiş? İşin bitti benim küçük ahmak arkadaşım! Sana Meropide Kalesi'ne kadar eşlik edeceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040311
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040311,
					"content": "Bir saniye... Ben gazete okurken birisi heykellerimi çalmaya mı cüret etmiş?",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762040312
					]
				},
				{
					"id": 762040312,
					"content": "İşin bitti benim küçük ahmak arkadaşım!",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762040313
					]
				},
				{
					"id": 762040313,
					"content": "Sana Meropide Kalesi'ne kadar eşlik edeceğim!",
					"roleType": "TALK_ROLE_NONE",
