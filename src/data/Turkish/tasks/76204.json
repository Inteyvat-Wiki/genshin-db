			"dialogs": [
				{
					"id": 762040201,
					"content": "Nicole! İlginç, burada da değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762040202,
					"content": "Stüdyoma geldiniz mi yoksa? Çiçek koleksiyonumu fark ettiniz mi? Dünyanın dört bir yanından topladığım örnekleri yetiştiriyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040203
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040203,
					"content": "*iç çeker* Korkarım şu anda gelemem. Fontaine'de bir heykel tezgahı açtım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040204
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040204,
					"content": "Şey... Yardım etmemizi ister misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762040205
					]
				},
				{
					"id": 762040205,
					"content": "Hayır, sağ olun. Çoğunlukla sayıları not ediyor olsam da elime kalem almak için tek fırsatım bu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040206
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040206,
					"content": "Ama biliyorum ki ziyaret etmek için pek vaktiniz olmuyor, o yüzden bensiz başlamaktan çekinmeyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040207
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040207,
					"content": "Bu arada size bir parşömen bıraktım. Sanırım onu batı duvarının yakınındaki bir serçe heykelinin yanına koydum. Bir bakın bakalım bulabilecek misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040208
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762040208,
					"content": "Bulduk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762040209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762040209,
					"content": "O zaman sessiz rehberim size yol göstersin... İyi şanslar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
