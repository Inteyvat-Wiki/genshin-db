					}
				]
			},
			"dialogs": [
				{
					"id": 705510201,
					"content": "Bunu denemek ister misiniz Bayan Emilie?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510202
					]
				},
				{
					"id": 705510202,
					"content": "Zanaatını izlemek gerçekten büyük bir zevk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510203
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510203,
					"content": "Hımm... Tadı Lumidouce Alacakaranlığının yerel bir versiyonu gibi. Doğru bildim mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510204,
						705510205
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510204,
					"content": "Tam isabet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510206
					]
				},
				{
					"id": 705510206,
					"content": "Hafif, rafine aroması ve belirgin katmanları, Mondstadt'ın kendine has kokusuyla bütünleşerek hiçbir uyumsuzluğa yer vermeyen, son derece davetkar bir lezzet yaratmış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510207
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510207,
					"content": "Ama bu kadar ihtiyatlı olmana gerek yok bence. Geleneksel sınırları zorlayan tatlara karşı toleransım oldukça yüksektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510208,
						705510209
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510208,
					"content": "Yani bu biraz fazla mı geleneksel kaçtı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510210
					]
				},
				{
					"id": 705510210,
					"content": "Hazırladığın içecek güzeldi ama biraz daha... Derinliği olsa mükemmel olurdu. Senin o eşsiz yorumunu gösteren ve Mondstadt hakkındaki izlenimimi pekiştirecek bir kokteyl mesela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510211
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510211,
					"content": "Üzerine düşünmek için zamana ihtiyacın varsa belki havadan sudan bir sohbet aradığın ilhamı verir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510212
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510212,
					"content": "Bu çiçekleri yeni mi aldın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510213
					]
				},
				{
					"id": 705510213,
					"content": "Bunlar çiçekçi dükkanının sahibinden aldığım ödülün bir parçası. Parfüm yapmak için oldukça önemli malzemelerdir. Kedi Kuyruğu'nun verdiği görevi bunlar sayesinde tamamlayabildim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510214
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510214,
					"content": "Yıllar önce Mondstadt'ın Sesilya çiçekleri üzerine çalışmıştım. Aslında Sesilya kokusu bazı alanlarda Mondstadt'la özdeşleşmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510215
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510215,
					"content": "Ancak bu özel bir durum. Bazı kediler Sesilya kokusundan hiç hoşlanmıyor ve onların tercihlerine özellikle dikkat etmemiz gerekiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510216,
						705510217
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510216,
					"content": "Peki bu sefer koku için ne kullandın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510218
					]
				},
				{
					"id": 705510218,
					"content": "Rüzgargülü Çiçeği.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510219
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510219,
					"content": "Rüzgargülü Çiçeğinin çeşitli kısımları, özlerini çıkarmak için öğütülüp toz haline getirilebiliyor. Sonrasında da taç yapraklar ile gövde yapraklarının kokularını harmanladım. Elde ettiğim karışım, bal şarabının mest edici tatlılığını barındırırken, çiçeğin sap ve yapraklarındaki taze notaları da ön plana çıkarıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510220
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510220,
					"content": "Kedi Kuyruğu'nda kısa bir deneme yaptım, kedilerin gerçekten hoşuna gitmiş görünüyordu. Müşteriler ise kokunun hem rahatlatıcı hem de canlandırıcı olduğunu düşündü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510221
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510221,
					"content": "Sıradan, göz ardı edilen malzemelerden enfes kokular elde etmek... İşte bu bana gerçekten neşe veriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510222
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510222,
					"content": "Bugün hava çok güzel...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510223
					]
				},
				{
					"id": 705510223,
					"content": "(Demek klasik bir konuyla sohbete başlamak böyle hissettiriyormuş...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510224
					]
				},
				{
					"id": 705510224,
					"content": "Gerçekten de öyle! Az önce yastık gibi yumuşacık görünen o güzelim bulutların süzülüp geçişini izledim... Havada pek nem yok, tatlı bir rüzgar esiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510225
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510225,
					"content": "Bu koşullar altında insanın koku alma duyusu keskinleşir ama aşırı bir seviyeye ulaşmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510226
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510226,
					"content": "Kokular iyi harmanlandığında çevresel dokuyla doğal biçimde bütünleşir ve oldukça güçlü izlenimler bırakır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510227,
						705510228
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510227,
					"content": "Kokuların hava durumundan bu kadar etkilendiğini hiç fark etmemiştim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510229
					]
				},
				{
					"id": 705510229,
					"content": "Anlaşılan benzer durum kokteyl yapımı için de geçerli. Uygun sertlikte bir baz seçersen farklı aromalar birbirine muhteşem karışır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510230
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510230,
					"content": "Doğru şekilde karıştırıldığında tüm malzemeler bir bütün halinde çalışarak damağında eşsiz bir senfoni yaratır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510231,
						705510232
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510231,
					"content": "Anlıyorum, demek kilit nokta tatların birleşimi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510233
					]
				},
				{
					"id": 705510233,
					"content": "Evet... Aynen öyle! Düşünüyorum da farklı aromaları katmanlandırma fikri benim damak zevkime pek hitap etmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510234
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510234,
					"content": "Genelde ne içersin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510235
					]
				},
				{
					"id": 705510235,
					"content": "Genelde, hımm... İşten sonra Asayiş Dairesindeki arkadaşlar bazen bana bir şeyler ısmarlar. Ben meyve çayından şaşmam, bu sayede sonrasında rahatça işimin başına geçebiliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510236
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510236,
					"content": "Eğer tatil öncesiyse ve arkadaşlarımın keyfi de yerindeyse bazen küçük bir kadeh köpüklü meyve şarabı sipariş ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510237
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510237,
					"content": "Turenna diye bir memur vardı, bana yıllanmış Corte şarabı ısmarlardı hep. Ancak Özel Güvenlik ve Teftiş Devriyesine tayini çıktığından beri görüşmeye fırsat bulamadık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510238,
						705510239
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510238,
					"content": "Aa, ara sıra alkol de içiyorsun yani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510240
					]
				},
				{
					"id": 705510240,
					"content": "Yüksek dereceli alkol bilim dünyasında yaygın kullanılan bir çözücüdür. Artık kokusuna epey alıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510241
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510241,
					"content": "Ayrıca hafif çakırkeyif olduğumda ruh halim değişiyor, bu da parfümlere yaklaşımımı değiştiriyor... Sonucun iyi ya da kötü olması önemli değil, önemli olan yeni bir şeyler denemek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510242
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510242,
					"content": "Yani biraz alkol içeren içeceklerle bir derdim yok ama çok sert tariflerden hoşlanmam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510243
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510243,
					"content": "Son zamanlarda parfümcülük işlerin nasıl gidiyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510244
					]
				},
				{
					"id": 705510244,
					"content": "Ah, sorduğun için teşekkürler. İşler iyi gidiyor ama bu Mondstadt gezisi... Bazı beklenmedik zorluklar çıkardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510245
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510245,
					"content": "Buraya ilk geldiğimde Mondstadt bölgesinde potansiyeli olan parfüm malzemelerini tespit etmek için \"Aromatik Maddelere ve İnsan Duyularına Genel Bakış\" kitabına başvurmuştum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510246
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510246,
					"content": "İlginçtir ki, Valyemiş bazlı deneme parfümüm han ortamına fazla ağır geldi ve insanları o kadar \"dinlendirdi\" ki uykularını getirdi... Hatta o güzel kulaklı barmen, barın ortasında uyuyakaldı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510247,
						705510248
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510247,
					"content": "Valyemişlerin böyle bir etkisi olabileceğini hiç bilmezdim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510249
					]
				},
				{
					"id": 705510249,
					"content": "Tatlılık söz konusu olduğunda \"elini korkak alıştırmama\" yöntemi her zaman işe yaramıyor diyelim. Uygun bir denge sağlamak hem bedene hem de zihne iyi geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510250
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510250,
					"content": "Günlük hayatımda da tatlı yiyecekleri nadiren tüketirim, böğürtlenler gibi yüksek şeker içeren meyvelerden uzak durmaya çalışırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510251
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510251,
					"content": "Sonuç olarak Valyemişten tamamen vazgeçip Rüzgargülü Çiçeğine yöneldim. Bunun da nispeten başarılı olduğunu söyleyebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510252
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510252,
					"content": "Sanırım içeceğini nasıl geliştireceğimi buldum. Tarifi güncelleyeyim, biraz bekle lütfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510253
					]
				},
				{
					"id": 705510253,
					"content": "Hımm? Şu kısacık sohbetimizden yola çıkarak şimdiden yeni bir kokteyl mi tasarladın yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510254
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510254,
					"content": "Bu tür yaratıcı işler için doğuştan yetenekli olabilir misin acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510248,
					"content": "Valyemiş parfümü fikri de böylece rafa kalkmıştır herhalde...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510249
					]
				},
				{
					"id": 705510239,
					"content": "Alkol duyularını fazla uyarır diye çekinmiştim açıkçası...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510240
					]
				},
				{
					"id": 705510232,
					"content": "Birbiriyle iyi harmanlanmış tatları tercih ediyorsun demek...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510233
					]
				},
				{
					"id": 705510228,
					"content": "Bunu hiç duymamıştım... Ne kadar ilginç.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510229
					]
				},
				{
					"id": 705510217,
					"content": "Onun yerine hangi çiçeği kullandın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510218
					]
				},
				{
					"id": 705510209,
					"content": "Daha yenilikçi bir şeyler mi arıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510210
					]
				},
				{
					"id": 705510205,
					"content": "Senden kaçmaz tabii.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510206
					]
				}
			]
		},
