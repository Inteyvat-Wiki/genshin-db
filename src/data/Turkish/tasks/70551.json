				]
			},
			"dialogs": [
				{
					"id": 705510101,
					"content": "#Kolay gelsin {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510102
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510102,
					"content": "... \"Uyum sağlama\" yeteneklerine burada, Mondstadt'ta tanık olma şerefine erişeceğimi hiç düşünmezdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510103,
						705510104
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510103,
					"content": "Tatile mi geldin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510105
					]
				},
				{
					"id": 705510105,
					"content": "Aslında her ikisi de.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510106
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510106,
					"content": "Kendine büyücü diyen bir kadın benden çiçek dükkanını yönetmemi istedi. Aynı zamanda Kedi Kuyruğu'ndakiler de işletmeleri için yeni bir koku yaratmamı istedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510107
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510107,
					"content": "Günün yoğun temposunu senin elinden bir içecekle sonlandırmak gerçekten harika bir ödül olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510108,
						705510109
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510108,
					"content": "Elimden gelenin en iyisini yapacağım, söz!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510110
					]
				},
				{
					"id": 705510110,
					"content": "Seçimine güveniyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510111
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510111,
					"content": "(Emilie aromalara karşı çoğu insandan daha hassas. Eğer karışımın kokusu dengesiz olursa onu rahatsız edebilir...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510112
					]
				},
				{
					"id": 705510112,
					"content": "(Sonuç olarak kokuları birbirini tamamlayan malzemeler kullanmalı ve biraz da Fontaine havası katmaya çalışmalıyım.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510113
					]
				},
				{
					"id": 705510113,
					"content": "(\"Lumidouce Alacakaranlığı\"nın Mondstadt yorumuyla başlayalım.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705510109,
					"content": "Sana özel bir tarif hazırlayacağım şimdi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510110
					]
				},
				{
					"id": 705510104,
					"content": "Yoksa iş için mi buradasın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510105
					]
				}
			]
		},
		{
			"id": 7055102,
