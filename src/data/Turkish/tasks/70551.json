			"dialogs": [
				{
					"id": 705510301,
					"content": "Al bakalım. Emilie'den ilham alarak geliştirdiğim yeni bir \"Lumidouce Alacakaranlığı\". Henüz bir isim bulamadım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510302
					]
				},
				{
					"id": 705510302,
					"content": "Renkleri daha serin ve ferahlatıcı, kokusu da görüntüsüne yaraşır şekilde hafif ve hoş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510303
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510303,
					"content": "Bu yüzeydeki parlak noktalar, ezilmiş Rüzgargülü Çiçeğinin gövde ve taç yaprakları mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510304,
						705510305
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510304,
					"content": "Evet. Sen kesinlikle bu işten anlıyorsun!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510306
					]
				},
				{
					"id": 705510306,
					"content": "Tadı harikadır kesin... Bir deneyeyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510307
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510307,
					"content": "Mmm... Çiçeklerin dilinde Rüzgargülü Çiçeği, \"Görülebilir Rüzgarlar\"ı temsil eder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510308
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510308,
					"content": "Bu kokteyl sadece onların biçimini değil, taşıdıkları kokuyu da muhteşem yansıtmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510309
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510309,
					"content": "O nedenle bu içeceğe \"Rüzgarla Gelen Buket\" adını vermeni öneriyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510310
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510310,
					"content": "Mondstadt'ın rüzgarları ve bulutları bardağın içinde birbirine karışıp geride büyüleyici koku izleri bırakmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510311,
						705510312
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510311,
					"content": "Parfüm ustasından mükemmel bir isim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510313
					]
				},
				{
					"id": 705510313,
					"content": "Sahiden mi? Mesleki alışkanlık herhalde. Beğenmene sevindim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510314
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510314,
					"content": "Şimdi bu şaheserin tadını usul usul çıkarma zamanı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510315
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510315,
					"content": "#Çok sağ ol {NICKNAME}. Bu Mondstadt gezisi benim için gerçekten pek tatmin edici oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510316
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510316,
					"content": "Bu hayatımda içtiğim en unutulmaz kokteyl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510317
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510317,
					"content": "Fontaine'e döner dönmez bu anı hem bir koku hem de bir parfüm olarak yeniden yaratmaya çalışacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510318,
						705510319
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510318,
					"content": "Onur duyarım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510320
					]
				},
				{
					"id": 705510320,
					"content": "Tarifleri mükemmelleştirdiğimde bu yeni ürünleri deneyen ilk müşterim olma onurunu senin bahşetmeni isterim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705510321
					],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510321,
					"content": "O zaman Fontaine Şehri'nde görüşmek üzere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Emilie"
				},
				{
					"id": 705510319,
					"content": "Bu fikre çok yükseldim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510320
					]
				},
				{
					"id": 705510312,
					"content": "Zarif ve oldukça şık!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510313
					]
				},
				{
					"id": 705510305,
					"content": "Mondstadt'ın sembolü olan çiçek!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705510306
					]
				}
			]
		}
	]
