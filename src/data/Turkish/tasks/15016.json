			"dialogs": [
				{
					"id": 150160101,
					"content": "Hah, gelmişsiniz. Her şey halloldu. Ben de tam gidip dinlenmek üzereydim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160102
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150160102,
					"content": "Tlazolli'ye ne oldu? Cezalandırılacak mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150160103
					]
				},
				{
					"id": 150160103,
					"content": "Kabile o konuyu hâlâ tartışıyor. Yani, Kadim Ad kullanarak suç işleyen pek olmadı bugüne kadar tabii... Pacal'ın işi zor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160104
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150160104,
					"content": "Tlazolli'nin atölyesinin kalıcı olarak kapatılacağını ve yarım kalan Alevtaşı Yazıtlarının yok edileceğini biliyorum ama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160105
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150160105,
					"content": "Tamamlanmış olan Alevtaşı Yazıtları ile ben ilgileneceğim. *iç çeker* Bir de bu çıktı başımıza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160106
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150160106,
					"content": "Neyse, en azından Kadim Adı duruyor, ona bir şey olmuş olsa çok daha karmaşık bir meseleyle karşı karşıya kalırdık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160107
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150160107,
					"content": "Hah, Kadim Adların konusu açılmışken iyi bir haberim var. Alevtaşı Yazıtları tarafından toplanan anılar sahiplerine geri dönebilecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160108
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150160108,
					"content": "Tüm Alevtaşı Yazıtları çalışmayı durdurduğunda anılar ait oldukları kişilere dönecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160109,
						150160110
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150160109,
					"content": "Yani insanların Nechca'ya dair anıları...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150160111
					]
				},
				{
					"id": 150160111,
					"content": "Aa, evet... Teyzem Nechca'yı geri getirebilmek için tüm kabilenin onu unutmasına yol açtı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160112
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150160112,
					"content": "Şimdi Nechca temelli gitti fakat herkes onu hatırlamak üzere... Ne tuhaf bir sonuç oldu bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160113
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150160113,
					"content": "Nepecha nasıl?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150160114
					]
				},
				{
					"id": 150160114,
					"content": "Atölyemde dinleniyor. Kabileden birileriyle konuştum, Nepecha'nın geçmişine dair resmi bir araştırma planladığımı söyledim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160115
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150160115,
					"content": "Kabile henüz bir yanıt vermedi, o yüzden şimdilik ben bakacağım ona. Zanaatkarlık da öğretirim hem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160116
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150160116,
					"content": "Neyse, daha sonranın konusu bu. Şimdilik dinlenip uyusun bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150160117
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150160117,
					"content": "Sonuçta onu bekleyen hareketli bir gelecek var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150160110,
					"content": "Geri mi gelecek?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150160111
					]
				}
			]
		}
	]
}