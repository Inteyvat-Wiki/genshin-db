			},
			"dialogs": [
				{
					"id": 110440141,
					"content": "Döndüm. İlginç bir şey gördünüz mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440142,
						110440144
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440142,
					"content": "Hiçbir şey anlayamadık.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440143
					]
				},
				{
					"id": 110440143,
					"content": "Endişelenmeyin, hepsi simyagerlik için. Normal hayatta kullanılabilmeleri çok zor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440146
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440146,
					"content": "Peki, araştırmaya devam edelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440101
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440101,
					"content": "Farklı dünyalar arasında büyük farklar olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440102
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440102,
					"content": "Örnek olarak Teyvat'a bakalım. Burada Önsezi sahibi olanlar elementleri kontrol edebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440103
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440103,
					"content": "Ama tek bir kişinin veya belki de herkesin bu yeteneğe sahip olduğu dünyalar olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440104
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440104,
					"content": "#Elementleri bir kenara bırakırsak... Özel yeteneğin var mı {NICKNAME}? Bu dünyada olmayan bir yetenek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440105
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440105,
					"content": "Sanırım bu sorunun cevabına da geçen sefer kullandığımız yöntemle ulaşabiliriz. Başka bir deyişle bir deney daha yapmanın zamanı geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440106,
						110440107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440106,
					"content": "Yine bodurloplarla mı dövüşeceğim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440108
					]
				},
				{
					"id": 110440108,
					"content": "Hayır, hayır! Bu sefer o kadar yorulmana gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440109
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440109,
					"content": "Şuradaki sütunu görüyorsun. İradeni kullanarak bunu kırmayı deneyeceksin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440110,
						110440113
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440110,
					"content": "Üzgünüm. Yapamam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440111
					]
				},
				{
					"id": 110440111,
					"content": "Elinden bu kadar mı geldi? Hımm... İşe yaramayacak sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440112
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440112,
					"content": "Neden şaşırdın ki? Bunu yapmak imkansız değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440116,
					"content": "Element gücünü yemeklerde denedin mi hiç? Pişirmek için demiyorum... Gücünü malzemelere aktarmak gibi mesela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440117
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440117,
					"content": "Tat veya dokuda nasıl bir değişiklik olacak merak ediyorum. Çoğalmasına bile yarayabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440118,
						110440119
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440118,
					"content": "Simyagerlerin hayal gücü gerçekten geniş oluyormuş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440120
					]
				},
				{
					"id": 110440120,
					"content": "Haha, başkalarının şaşırtıcı bulduğu şeyleri merak ediyorum sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440121
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440121,
					"content": "Neyse, bize bir Tereyağlı Izgara Balık yap bakalım. Tarifi yeni hazırladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440151
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440151,
					"content": "Yemek pişirmek mi? Paimon bilim adamı çılgınlığı bekliyordu daha çok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440122,
					"content": "Bu tarif hem benim özel tarifim hem de deney yapmaya değer, çok da besleyici!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440123
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440123,
					"content": "Hımm... Paimon'a sorarsan acıkmışsın sen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440124,
					"content": "Kulağa lezzetli geliyor ama... Tamam, Paimon onayladı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440125,
						110440126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440125,
					"content": "Ne demek istediğini anladım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440127
					]
				},
				{
					"id": 110440127,
					"content": "Tamam. İyi arkadaşlar hep anlar birbirini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440128,
					"content": "Öyleyse seni meşgul etmeyelim. Sonuçları sabırsızlıkla bekliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440130
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440130,
					"content": "Yemekten artan olursa belki Timaeus'a da birkaç lokma götürebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440131
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440131,
					"content": "Hımm... Paimon öyle bir derdimiz olacağını düşünmüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440126,
					"content": "Sana da bir iki yüzgeç bırakırım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440127
					]
				},
				{
					"id": 110440119,
					"content": "Aç olduğun için bunu istiyor olmayasın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440120
					]
				},
				{
					"id": 110440113,
					"content": "Bir de sen denesene Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440114
					]
				},
				{
					"id": 110440114,
					"content": "Paimon nasıl yapılacağını biliyor mudur sence?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440115,
					"content": "Elinden bu kadar mı geldi? Hımm... İşe yaramayacak sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440116
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440107,
					"content": "Çok içtim, almayayım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440108
					]
				},
				{
					"id": 110440144,
					"content": "Eşyaların pek düzenli değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440145
					]
				},
				{
					"id": 110440145,
					"content": "Hımm, doğru. Biraz zamanım olsa düzenlemeyi çok isterdim; ama önce deneyler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440146
					],
					"speakerTitle": "Albedo"
				}
			]
		},
		{
			"id": 1104403,
			"completionStepIds": [
				1104403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104403",
							"2"
						],
						"stepId": 1104403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110440320,
					"content": "İnanamıyorum, bulmuşsunuz. Harika! Çok teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440321
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440321,
					"content": "Merak ediyorum da şu Element Görüşü var ya... Malzemelerin yerini ve benim dağın neresinde olduğumu onunla buldunuz, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440322
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440322,
					"content": "Evet! O da bir süper güç sayılır, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440323,
					"content": "Ne yazık ki Element Görüşü nadir de olsa görülür. Teyvat'ta bilinmeyen bir şey değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440324
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440324,
					"content": "Sadece daha önce görülmemiş, başka bir dünyaya ait bir güç benim araştırmama yarar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440325
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440325,
					"content": "Yani... Yine mi başaramadık?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440326,
					"content": "Moralinizi bozmayın. Beklentilerim de bu yöndeydi. Ayrıca bu eşyaları bulmanıza bakarsak bence çok faydalı bir deney oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440301
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440301,
					"content": "Malzemelerde element kalıntıları bulunacağı çıkarımınızı takdir ediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440302
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440302,
					"content": "Tamam o zaman. Şimdiye kadar araştırmamız başka bir dünyadan olmana odaklıydı. Aramızdan biri olmana dair araştırmamız yeni başlıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440303,
						110440304
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440303,
					"content": "Sonuna kadar yanındayım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440305
					]
				},
				{
					"id": 110440305,
					"content": "Esasen insanlar arasındaki farklar entelektüel ve fiziksel becerilerimizde kendini gösteriyor. Fiziksel olanla başlayalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440306
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440306,
					"content": "Durduğumuz yerden bakınca Sucrose'un ne yaptığını görebiliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440307
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440307,
					"content": "Hayır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440308
					]
				},
				{
					"id": 110440308,
					"content": "Peki buradan uçarak şu uçuruma insen... Tam şuradaki uçuruma. O zaman görebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440309
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440309,
					"content": "Hayır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440310
					]
				},
				{
					"id": 110440310,
					"content": "Ya şu dağa bir yumruk atsan ve dağ milyonlarca parçaya ayrılsa? O zaman görebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440311,
						110440312
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440311,
					"content": "Hayır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440313
					]
				},
				{
					"id": 110440313,
					"content": "Hımm, öyleyse çok şey beklemeyeyim. Yine de bir deney yaparak daha iyi anlarız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440314
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440314,
					"content": "Fiziksel deney için mükemmel bir yer biliyorum. Lütfen beni takip edin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440312,
					"content": "Süper güç deneyi bitmemiş galiba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440313
					]
				},
				{
					"id": 110440304,
					"content": "Nasıl kurtulacağım bu deneylerden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440305
					]
				}
			]
		},
		{
			"id": 1104405,
			"completionStepIds": [
				1104405,
				1104416
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104416",
							"2"
						],
						"stepId": 1104416,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110440501,
					"content": "Hımm, iyi bir tarife göre ortalama bir yemek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440502
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440502,
					"content": "Çoğalma hipotezi konusunda pek bir sonuç elde edemedik. Anlaşılan yemek senin dünyanda da bizimkinde olduğu kadar sorun çıkarıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440503
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440503,
					"content": "Tabii... Bu dünyanın doğa kanunları senin özel yeteneklerini sınırlandırıyor olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440504
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440504,
					"content": "Element gücünü yemeğe nasıl aktaracağımızı bilmiyorduk. Ot ve baharat eklemekten biraz daha zor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440505,
					"content": "Endişelenmeyin, en azından yemek boşa gitmedi. Moralinizi bozmayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440506
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440506,
					"content": "İşte sizinki burada. Afiyet olsun! İsterseniz paket yapabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440507
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440507,
					"content": "Oley! Teşekkürler. İyi ki unutmamışsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440508,
						110440509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440508,
					"content": "Paimon çok sevdi seni.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440510
					]
				},
				{
					"id": 110440510,
					"content": "İyi arkadaş olduğunuz belli oluyor. Paimon deney boyunca hep sana göz kulak oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440511
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440511,
					"content": "İşler kötüye gitse Paimon'un elinden pek bir şey gelmezdi ama olsun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440512
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440512,
					"content": "Hey! Az önce iyi davranıyordun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440513,
					"content": "Fakat verdiğin tarif lezzetli olduğu için Paimon affetti seni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440514,
					"content": "Ayrıca haklısın, iyi arkadaşız. Senin de iyi arkadaşların, iyi öğrencilerin var değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440515,
					"content": "... Evet! Ben de şanslıyım galiba. Neyse, diğer deneye geçelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440516
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440516,
					"content": "Burada her türden simya malzemesi var. Hepsini yerine koymak hiç de kolay olmuyor. Bir süre önce bir kısmını kaybettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440517
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440517,
					"content": "Çoğunu bulabildim ama iki şişeyi bulamıyorum. Rüzgar Kristal Kelebeği element özü ve Elektrik Hipostazı tozu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440518
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440518,
					"content": "Paimon yemeğini yeni bitirdi. Yine gidip malzeme toplamamızı mı istiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440519,
					"content": "Merak etmeyin, bulamazsanız yenisini almayı düşünüyorum zaten. Tabii bulabilirseniz uğraşmamış olurum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440520
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440520,
					"content": "Gece görüşü veya titreşimsel algı gibi \"süper güçlerim\" olsa hiçbir şeyi kaybetmezdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440521
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440521,
					"content": "Az önce baktığınız bölgede bir yerlerde düşürmüşümdür muhtemelen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440522
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110440522,
					"content": "O zaman... Gidip bir bakalım mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110440523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440523,
					"content": "Kaybolan malzemelerde element kalıntıları olmalı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440524
					]
				},
				{
					"id": 110440524,
					"content": "Evet! Element Görüşünü kullanabilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110440509,
					"content": "Paimon'a bu kadar ilgi gösteren çok insan yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110440510
					]
				}
			]
		},
