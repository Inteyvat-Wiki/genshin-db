			"dialogs": [
				{
					"id": 760520401,
					"content": "Hımm, bu kokuyu bir yerden hatırlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520402
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760520402,
					"content": "Sahiden mi? Nereden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520403,
					"content": "Sandrone'nin odasından. Böyle kokan bir şey içiyordu. Kokusu dikkatimi çekmişti, o da bunu fark edince... İçeceği bitirmeden uzun süre elinde tuttu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520404
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760520404,
					"content": "Sanki... Ona sormamı bekliyor gibiydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520405
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760520405,
					"content": "Ee... Sordun mu peki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520406
					]
				},
				{
					"id": 760520406,
					"content": "Evet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520407
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760520407,
					"content": "Ne sordun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520408,
					"content": "\"Bunun yerine motor yağı içmen gerekmiyor mu?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520409
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760520409,
					"content": "Peki o nasıl cevap verdi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520410
					]
				},
				{
					"id": 760520410,
					"content": "Şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520411
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760520411,
					"content": "Oldukça tatsız bir şey söyledi. Tekrarlamaya değmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520412
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760520412,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520413
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760520413,
					"content": "Tek yudumda ilgini mi kaybettin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520414,
					"content": "Üzgünüm, biraz acıydı... Ama sonuç olarak pek iyi değildi. Sandrone'nin içerken yüzünü ekşitmesine şaşmamalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520415
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760520415,
					"content": "Paimon bunun başka nedenleri olabileceğini düşünüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
