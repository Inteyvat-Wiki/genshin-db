			"dialogs": [
				{
					"id": 760520101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520102
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760520102,
					"content": "Columbina, iyi misin? Keyifsiz görünüyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520103,
					"content": "Ah, siz mi geldiniz? İyiyim ben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520104
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760520104,
					"content": "(Yine ayı mı düşünüyor acaba?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520105
					]
				},
				{
					"id": 760520105,
					"content": "Yardım edebileceğimiz bir şey var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520106
					]
				},
				{
					"id": 760520106,
					"content": "Ben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520107
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760520107,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520108
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760520108,
					"content": "Sorun değil, bize anlatabilirsin! Önemsiz bir şey bile olsa anlatınca çok daha iyi hissedeceksin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520109,
					"content": "Ben... Bir handa içki içmek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520110
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760520110,
					"content": "... Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520111,
					"content": "... *iç çeker*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520112
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760520112,
					"content": "Affedersin... Paimon biraz şaşırdı sadece. Kendin için bir şey istediğini hiç söylemezdin de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520113,
					"content": "Hepsi bu mu? Sadece... Bir içki mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520114,
					"content": "Daha büyük bir şey mi istemesini bekliyordun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520115
					]
				},
				{
					"id": 760520115,
					"content": "Evet, en azından daha iddialı bir şey beklerdi Paimon... Mesela \"Bana ayı getirin!\" falan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520116,
					"content": "Ama şimdi düşününce mantıklı aslında. Columbina istediği gibi dışarı çıkamıyor, o yüzden bir hana gitmek onun için aya gitmek gibi bir şey olsa gerek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520117,
					"content": "Sadece şimdi de değil. Fatui'deyken bile, beni yakalama emri olmamasına rağmen ne zaman yürüyüşe çıksam herkes benden uzak duruyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520118
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760520118,
					"content": "(Fatui Habercilerinin üçüncüsü... Bu unvan bile onu tanımayanları korkutmaya yeter.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520119
					]
				},
				{
					"id": 760520119,
					"content": "Dur bir dakika, aslında düşününce... Belki de bu, Paimon'un ilk düşündüğü kadar zor değildir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520120,
					"content": "#Han belki biraz zor olur ama sadece içkiyse... Onu ayarlayabiliriz! {NICKNAME} halleder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520121,
					"content": "... Gerçekten mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520122
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760520122,
					"content": "Evet ama beklentilerini çok yüksek tutma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520123,
					"content": "Bir aroma tercihin var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520124
					]
				},
				{
					"id": 760520124,
					"content": "Aroma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520125
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760520125,
					"content": "İçki sipariş etme deneyimim olmadı daha önce, bu yüzden pek bilemiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520126
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760520126,
					"content": "Çok ağır olmayan bir şey olsa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520127
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760520127,
					"content": "Iıı, \"ağır\"dan kastın nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520128,
					"content": "Yani... Fatui paltosu gibi ağır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520129
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760520129,
					"content": "Bu karşılaştırma daha da kafa karıştırıcı oldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520130,
						760520131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520130,
					"content": "O zaman hafif ve lezzetli bir şey olsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520132
					]
				},
				{
					"id": 760520132,
					"content": "Tamamdır. Sen nasıl dersen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760520131,
					"content": "Ben halledeceğim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520132
					]
				}
			]
		},
		{
