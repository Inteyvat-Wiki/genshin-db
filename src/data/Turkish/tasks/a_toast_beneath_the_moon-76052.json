			},
			"dialogs": [
				{
					"id": 760520201,
					"content": "Hımm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520202
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760520202,
					"content": "Ee, nasıl buldun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520203,
					"content": "Bana eski zamanları hatırlattı, Donuk Ayın Çocukları ile birlikte yaşadığım günleri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520204
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760520204,
					"content": "Oradaki insanlar taze nane yaprakları, baharatlar ve kurutulmuş meyveleri kullanarak çay demlerlerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520205
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760520205,
					"content": "Ne zaman evlerinin önünden geçsem pencerelerinden bitki çayı kokusu gelirdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520206
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760520206,
					"content": "Hiç denemiş miydin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520207,
					"content": "Çok istedim ama hiç fırsatım olmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520208
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760520208,
					"content": "Aa, neden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520209,
					"content": "Bir \"Tanrıça\" kapına gelip \"Çayınızdan tadabilir miyim?\" diye sorunca, kimse kendisi için yaptığı o \"basit çayı\" ikram etmeye cesaret edemiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520210
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760520210,
					"content": "Ha... Öyle demek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520211,
					"content": "Sonunda aldığım şey, süslemeleriyle vesaire bir tanrıçaya sunulan bir \"adak\" gibiydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520212
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760520212,
					"content": "Tadı kötü değildi aslında... Ama o \"ev\" hissi eksikti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520213
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760520213,
					"content": "Pekala, bunu telafi edebiliriz!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520214
					]
				},
				{
					"id": 760520214,
					"content": "Hımm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520215
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760520215,
					"content": "Tadı çok hoş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520216
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760520216,
					"content": "... Gerçi, süt ekleme fikri bana biraz garip geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520217
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760520217,
					"content": "Şey, bu bir Mondstadt tarifi. Oradakiler çaylarına süt, krema ve şeker eklemeyi severler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520218,
					"content": "Garip... Ama hoşuma gitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520219
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760520219,
					"content": "Oh, Paimon beğenmene sevindi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520220,
					"content": "Teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520221
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760520221,
					"content": "Görünüşe göre geçmişi görmenin tek yolu ay ışığı değil. Basit bir içeceğin kokusu bile uzun süre önce unutulmuş anıları canlandırabiliyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Küçük Hanım"
				}
			]
		},
