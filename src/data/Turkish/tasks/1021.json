			"dialogs": [
				{
					"id": 10210201,
					"content": "Hey! Sadece Paimon'a mı öyle geldi yoksa havada tatlı bir koku mu var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210202,
					"content": "Hı? Şunu duydun mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210203,
						10210205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210203,
					"content": "Birisi yardım istiyor gibiydi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210204
					]
				},
				{
					"id": 10210204,
					"content": "Sanki şuradaki harabelerden geliyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210207,
					"content": "Ay, görünüşe göre Hazine Avcıları birilerini içeri kilitlemiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210205,
					"content": "Birisi şarkı söylüyor gibiydi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210206
					]
				},
				{
					"id": 10210206,
					"content": "Ah hayır! Kesinlikle birinin başı dertte! Ses şuradaki harabelerden geliyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210207
