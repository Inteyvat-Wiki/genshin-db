				"objectNames": [
					"Ningguang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210601,
					"content": "Yihuu! Ne büyük bir salon! Paimon daha önce hiç bu kadar şık bir yer görmemişti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210602,
					"content": "İkiniz de rahat olun. Kendi evinizdeymiş gibi rahat edebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210603
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210603,
					"content": "Gerçekten mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210604,
					"content": "İkinizi buraya arkadaşım olarak davet ettim. Arkadaşlar vakit geçirmeye geldiğinde doğal olarak eğlenmemiz gerekir, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210605
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210605,
					"content": "Yoksa o, düşündüğüm şey mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210606
					]
				},
				{
					"id": 10210606,
					"content": "Ah! Oradaki şey efsanevi duvar, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210607,
					"content": "Görüyorum ki her şeyi biliyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210608
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210608,
					"content": "Biliyorum çünkü hikayeciler bile bundan söz ediyor. Herkes o duvardan bir kağıt parçası kapmak istiyor. İnanılmaz bir ünü var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210609,
					"content": "Çünkü o duvarda Liyue'nin sırları kayıtlı. Tüccarlar da her zaman sırlara meraklı olmuştur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210610
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210610,
					"content": "Fakat asıl senin ilgini çeken tüccarlar dünyasının sırları değil, öyle değil mi Gezgin? Sen oldukça özelsin ve bence bunun da farkındasın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210611
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210611,
					"content": "Mümkünse güvenini kazanmak isterim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210612
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210612,
					"content": "Fakat beni mi yoksa Keqing'i mi daha güvenilir bulduğuna gelince...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210613,
						10210614
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210613,
					"content": "Senin düzene bağlı onun ise düzen karşıtı olması düşünülürse...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210615
					]
				},
				{
					"id": 10210615,
					"content": "Haha... Keqing'i mi seçerdin? Bunu tahmin etmiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210616
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210616,
					"content": "İlk başta onun biraz... Dik kafalı olduğunu düşünmüştüm. Yedi Yıldızda onun gibi birisi varken perde arkasında fazladan birkaç pislik daha temizlemem gerekecekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210617
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210617,
					"content": "Fakat bir gün şöyle dedi: \"Adeptusların zamanı çoktan geçti. Liyue'nin Yedi Yıldızı bile bu gerçekle yüzleşmek istemiyorsa Liyue'yi nasıl bir gelecek bekliyor?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210618
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210618,
					"content": "Ondan sonra birçok şüphemin kaybolduğunu söylemeliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210619
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210619,
					"content": "Rex Lapis'in ölümünün bize avantaj sağladığı izlenimi yarattığını inkar etmeyeceğim. Fakat Liyue'nin iyiliği için, gücü ele geçireceğimize dair yayılan söylentilerin bizi engellemesine izin veremeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210620
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210620,
					"content": "Fatui'nin de bu söylentilerde rolü olduğunu sanıyorum, doğru mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210621
					]
				},
				{
					"id": 10210621,
					"content": "Evet, bu doğru. En baştan beri söylemek istediklerimi anladığını görüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210622
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210622,
					"content": "Durumu geçici olarak kontrol altına almak ve bunun yanı sıra Mondstadt'ta benzer bir olayın yaşanmaması adına konuşma yasağını getiren ve Exuvia'nın saklanmasını isteyen bendim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210623
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210623,
					"content": "Rex Lapis'in ölümüyle birlikte Fatui, diplomatik sınırlarının ötesinde çok sayıda gizli eyleme bulaştı. Liyue'den sorumlu Tianquan olarak onlarla mücadele ederken, bunun dışarıdan nasıl göründüğünü açıkçası pek de umursamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210624
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210624,
					"content": "Veda Ayininin yapılmasına izin vermek de Liyue'nin yönetimini ele almak konusunda bize zaman kazandırmak için yapılmış bir hamleydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210625
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210625,
					"content": "Tam da Zhongli'nin dediği gibi. Yedi Yıldız, tören alanının kullanılmasına yalnızca bizi kendi amaçları için kullanmak istediğinden dolayı izin verdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210626,
					"content": "Bir dakika, doğru ya! Amaç demişken... Paimon bir şey daha diyebilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210627,
					"content": "Elbette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210628
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210628,
					"content": "Paimon'un duyduğuna göre tanışma hediyesi verenler karşılığında bir şey alırmış... Bu bizim için de geçerli mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210629,
					"content": "Paimon, sen ciddi misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210630
					]
				},
				{
					"id": 10210630,
					"content": "Ha ha, önemli değil. Açık konuşan kişileri severim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210631
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210631,
					"content": "Şey, son zamanlarda size biraz sorun çıkarmış olabiliriz. Şuna ne dersiniz? Buradan istediğiniz bir eşyayı seçebilir ve yanınızda götürebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210632
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210632,
					"content": "Yaşasın! Paimon tam da bunu söylemeni bekliyordu! Ne alsak acaba? Bir bakalım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210633,
					"content": "O duvardaki <color=#00E1FFFF>sayfalardan</color> birini istiyoruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210634
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210634,
					"content": "???",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210635
					]
				},
				{
					"id": 10210635,
					"content": "Paimon'a öyle bakmasana! Paimon'un tırnağı kadar bile olsa bu kağıt parçalarından biri bile inanılmaz fiyatlara satılabilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210636
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210636,
					"content": "Düşünsene... Yırtılmamış bir sayfa kim bilir kaç Moraya satılır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210614,
					"content": "Keqing ve ilahi olan ile ilgili şüpheciliğini tercih ederim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210615
					]
				}
			]
		},
		{
			"id": 102108,
			"completionStepIds": [
				102108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102108",
							"2"
						],
						"stepId": 102108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Meng Dan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210801,
					"content": "Of... Yardımınız için teşekkür ederim iyi kalpli gezginler. Yardımıma gelmeseydiniz bu hücrede çürüyüp gidecektim! Şu Hazine Avcıları... Keyifleri yerindeyse şu Tatlı Çiçek saksılarının, keyifleri yerinde değilse de ağzımın burnumun yerini değiştirirlerdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210802
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 10210802,
					"content": "Ah hiç sorun değil. Hepimize birden teşekkür etmen gerekmez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210803,
					"content": "Ha ha, anlıyorum. Merak etmeyin, her ikinize de güzel bir hediye vereceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210804
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 10210804,
					"content": "Gerçekten gerek yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210805
					]
				},
				{
					"id": 10210805,
					"content": "Öyle demeyin! Bu durumdan sizin sayenizde kurtuldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210806
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 10210806,
					"content": "Adım Meng Dan, Liyue Limanı'nda Mingxing Mücevheratın tedarikçilerinden biriyim. Genellikle bu dağlarda gezer antika eşyalar ararım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210807
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 10210807,
					"content": "Bu Hazine Avcılarının benimle aynı harabelere göz koymasını beklemiyordum. Bir anda beni yakalayıp esir aldılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210808
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 10210808,
					"content": "Aradığınız herhangi bir şey var mı? Antikalar, hazineler, farklı ıvır zıvırlar, ne isterseniz! Yani elimdekiler ilginizi çekerse tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210809
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 10210809,
					"content": "Güzel dileklerin benim için yeterli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210810
					]
				},
				{
					"id": 10210810,
					"content": "Bir dakika! Aslında bir şey arıyoruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210811,
					"content": "Ne? Peki ne arıyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210812
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 10210812,
					"content": "İçine hediye koyabileceğimiz bir kutun var mı? Güzel bir kutu arıyoruz... İçine atıştırmalık koyabileceğin bir kutu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210813,
					"content": "Elbette var! Antikalar hediye kutusu olmadan nasıl satılabilir? <color=#00E1FFFF>Mingxing Mücevheratta</color> yedi ulustaki en iyi hediye paketleme hizmetini sunuyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210814
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 10210814,
					"content": "Bana bir saniye verin, patrona bildireyim. O kutuya ihtiyacınız olduğunda gidip patronumu görebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210815
					],
					"speakerTitle": "Meng Dan"
				},
				{
					"id": 10210815,
					"content": "Harika! Paimon'un Bodurlop Jölesi artık harika bir hediye paketinde olacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 102111,
			"completionStepIds": [
				102111
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
