					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 10211201,
					"content": "Ha? Çok aramamız gerekmedi. En büyük sayfa en bariz yerde duruyor işte. Gidip şunu alalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211202,
					"content": "Lay lay lay lay... Bakalım ne yazıyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211203,
					"content": "Ha? Orada bir yer çember içine alınarak işaretlenmiş. Ah, hazine olabilir mi acaba? Her neyse bizi zengin etse iyi olur! Bakalım ne yazıyormuş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211204,
					"content": "\"Yetki...\" \"Mührü...\" Falan filan... \"Fatui...\" \"araştırma...\" \"kopya...\" Ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211205,
					"content": "Ay, hazineye falan benzemiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211206,
					"content": "Bu kağıt parçası bir Yedi Yıldız casusunun <color=#00E1FFFF>Yetki Mührü</color> ile ilgili gizli bir Fatui araştırmasının izlerini keşfettiğini gösteriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211207,
					"content": "Ah. Ningguang, Fatui'nin Liyue'nin gölgelerinde söylentiler yaymaktan, hükümdarın bedenini ele geçirmeye kadar her türlü kötülüğü yapmaya hazır olduğunu söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211208,
					"content": "Yetki Mührü ile ilgili bir araştırma mı? Paimon neler çevirdiklerini merak ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211209,
					"content": "#Hazır konusu açılmışken; {NICKNAME}, sen ve Yetki Mührü arasında da bir bağlantı var. Sanırım keşfetmemiz gereken daha çok şey var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211210,
						10211211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211210,
					"content": "İşlerin gidişatı sanki gereğinden fazla mükemmel.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211212
					]
				},
				{
					"id": 10211212,
					"content": "Ah? Gerçekten öyle mi düşünüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211213,
					"content": "Şey... O zaman, gitmeyelim mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211214,
					"content": "Hayır, şunu demek istiyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211215
					]
				},
				{
					"id": 10211215,
					"content": "Yani Ningguang'a tamamen güvenemeyeceğimiz için söylediklerinin doğru olup olmadığını gidip kendimiz doğrulamamız gerek diyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211216,
					"content": "Hım... Bu iş Paimon'un boyunu aşar. Paimon, onun bize hep iyi davrandığını düşünüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211217,
					"content": "Neyse, bir ipucu yakaladın mı göreceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211218,
					"content": "Şey, Dihua Bataklığı'nda Zhongli'yi aramaya başlamadan önce bu kağıtlarda işaretli yerlere gidelim ve Fatui'nin gerçekten bir iş çevirip çevirmediğini görelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211211,
					"content": "Ningguang kesinlikle bizi buraya yönlendirmeye çalışıyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211212
					]
				}
			]
		},
		{
			"id": 102113,
			"completionStepIds": [
				102113
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102113",
							"2"
						],
						"stepId": 102113,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ningguang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10211301,
					"content": "Hükümdarlar Savaşı'nı hiç duydunuz mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211302,
						10211303
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211302,
					"content": "Ah... Kulağa tanıdık geliyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211304
					]
				},
				{
					"id": 10211304,
					"content": "Bu dünyada birçok tanrı dolaşıyordu ve 2.000 yıl önce yatışana kadar aralarında sayısız uzun savaş yaşanıyordu. Çok kan döküldü ve sayısız can yitirildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211305
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211305,
					"content": "Sonunda Teyvat'ta sadece yedi muzaffer tanrı kaldı. Mağlupların cesetleri üzerine şehirler ve uluslar inşa ettiler, böylece Yediler çağı başladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211306
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211306,
					"content": "Guyun Taş Ormanı'nı buradan görebiliyorsun, değil mi? Aslında doğal bir kaya oluşumu değil, onlar savaş sırasında Rex Lapis tarafından fırlatılan dev taş mızraklar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211307
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211307,
					"content": "Mızrakların altında ise o zamanlarda Rex Lapis'in devirdiği, Hükümdar unvanını ele geçiremeyen tanrılar yatıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211308
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211308,
					"content": "Tanrıların ölebileceği gerçeğinin yanı sıra geçtiğimiz iki bin yıl süresince Yedilerin de değişebileceğini gördük. Rex Lapis'in ölümü Liyue için akılalmaz bir felaket ancak Yedilerin düzeni sadece bu yüzden yok olup gitmeyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211309
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211309,
					"content": "Er ya da geç başka bir Toprağın Efendisi ortaya çıkacak fakat Rex Lapis'i nasıl unutabiliriz? O zaman geldiğinde Liyue halkı, tanrılar ve Adeptuslar arasındaki ilişki öncekinden çok farklı olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211310
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211310,
					"content": "Yeni bir çağda bile Liyue'nin Yedi Yıldızı, Rex Lapis'in eski tebaası olarak kalacak... Onun ölümünde bir rol alabileceğimizi gerçekten düşünüyor musun? Bazı sonuçları göremeyecek kadar öngörüsüz olduğumuzu mu düşünüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211311
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211311,
					"content": "O zaman Exuvia'yı neden sakladınız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211312
					]
				},
				{
					"id": 10211312,
					"content": "Heh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211313
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211313,
					"content": "O gün Yujing Terası'nda her şey çok ani gelişti. Ben bile hazırlıksız yakalandım. Sen oradaydın, eminim görmüşsündür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211314
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211314,
					"content": "Fakat düşmanımız çok uzun süredir limanda gizleniyor. Onlara karşı hemen harekete geçmezsek üstünlüğü ele geçireceklerine eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211315
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211315,
					"content": "Exuvia'yı gizlemek, inisiyatifi geri kazanmak, rakiplerimiz sağa sola koştururken örümcek gibi ağ örmek için gerekli bir hamleydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211316
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211316,
					"content": "Bahsettiğin bu \"düşman\" kim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211317,
					"content": "Sen ne düşünüyorsun Gezgin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211318,
						10211319
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211318,
					"content": "\"O\" mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211320
					]
				},
				{
					"id": 10211320,
					"content": "Ne? Siz ikiniz neden bahsediyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211321,
					"content": "Güzel yanıt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211322
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211322,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211323,
					"content": "Hah... Buradaki manzara gerçekten bir harika ancak rüzgar biraz sert. Konuklarımızı içeride ağırlamak için hazırlıklarımız tamamlandı, bu taraftan lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10211319,
					"content": "\"O\", değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211320
					]
				},
				{
					"id": 10211303,
					"content": "Şöyle böyle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211304
					]
				}
			]
		},
