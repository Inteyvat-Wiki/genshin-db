					"Ningguang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10213101,
					"content": "Pekala, bir seçim yaptınız mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10213102
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10213102,
					"content": "Bana sormanız gerekmez. Birini seçin ve alın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10213103
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10213103,
					"content": "Ardından neden bir süre Yeşim Konak'ta oturmuyorsunuz? Ya da etrafı da gezebilirsiniz? Dinlenmek yolculuk için çok önemlidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10213104,
						10213106
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10213104,
					"content": "Konukseverliğiniz için teşekkür ederiz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10213105
					]
				},
				{
					"id": 10213105,
					"content": "Haydi, bu kadar resmi olman gerekmez. Gevşe biraz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10213106,
					"content": "Harekete geçmenin zamanı geldi. Görüşürüz...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10213107
					]
				},
				{
					"id": 10213107,
					"content": "Tamam o zaman. Umarım bir dahaki karşılaşmamızda ya çoktan doğru şeyi yapmış ya da doğru seçimi yapmak üzere olursun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				}
			]
		}
	]
