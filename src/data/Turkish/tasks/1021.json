				{
					"id": 10213001,
					"content": "Meng Amca'yı kurtardığınız için teşekkür ederiz. Kendinize dikkat edin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10213002
					],
					"speakerTitle": "Xingxi"
				},
				{
					"id": 10213002,
					"content": "Evet... Sıra çömleği temizlemeye geldi...",
					"roleType": "TALK_ROLE_NPC",
