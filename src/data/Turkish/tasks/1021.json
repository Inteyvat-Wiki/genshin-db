			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xingxi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10211101,
					"content": "Merhaba! Meng Dan adlı biri mağazanızdan son derece şık bir kutu alabileceğimizi söyledi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211102,
					"content": "Meng Amca bana olanları anlattı. Onu kurtardığınız için ikinize de teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211103
					],
					"speakerTitle": "Xingxi"
				},
				{
					"id": 10211103,
					"content": "Mağazamızdaki en iyi parçaların çoğunu Meng Amca bulmuştur. Ona bir şey olsaydı bu mağazayı açık tutmamız mümkün olmazdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211104
					],
					"speakerTitle": "Xingxi"
				},
				{
					"id": 10211104,
					"content": "İşte, en az 140 yıllık tarihi olan antika bir kutu. Önceden temizlemiştik... İşinizi görür mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211105
					],
					"speakerTitle": "Xingxi"
				},
				{
					"id": 10211105,
					"content": "Evet, evet, evet! Bu harika!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211106,
					"content": "Bir saniye. Bir şey daha ödünç alabilir miyiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211107,
					"content": "Tabii, keyfinize bakın. Raflarımızdan ne istiyorsanız alabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211108
					],
					"speakerTitle": "Xingxi"
				},
				{
					"id": 10211108,
					"content": "#{NICKNAME}, bu kil çömlek gerçekten harika görünüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211109,
					"content": "Karıştırmak için antika bir kap kullanırsak harika bir atıştırmalık pişirebiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211110,
					"content": "Tamam! İşte Bodurlop Jölesi! Dikkatli ol. Kutuya koyalım ve üzerine biraz daha toz şeker dökelim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211111,
					"content": "İşte bu. İstersen yeni toplanmış bu iki çiçekle de süsleyebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211112
					],
					"speakerTitle": "Xingxi"
				},
				{
					"id": 10211112,
					"content": "Ooo! Çok güzel görünüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10211113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10211113,
					"content": "(Bu hediye fikri hâlâ aklıma yatmıyor...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10211114
					]
				},
				{
					"id": 10211114,
					"content": "Harika! Elimizdekileri bu kutuya koyduğumuza göre Ningguang'ı görmek için Yeşim Konak'a gidelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
