			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ningguang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210401,
					"content": "Sizi, Jueyun Gölü'nden dönmenizi bekliyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210402
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210402,
					"content": "Ah, Ningguang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210403,
					"content": "Bu ilk görüşmemiz olduğundan... Şey, bir hediye hazırladık! Umarım beğenirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210404,
					"content": "Benim için mi? Çok teşekkür ederim. Konuklarım olmanıza karşın sizin için işleri biraz zorlaştırdım sanki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210405
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210405,
					"content": "Ha ha... Ah, hiç önemli değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210406,
						10210408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210406,
					"content": "Bu Yeşim Konak pek bir güzelmiş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210407
					]
				},
				{
					"id": 10210407,
					"content": "Ha ha. Beğenmene sevindim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210409
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210409,
					"content": "Bu saray gökyüzünde, herhangi bir dağın zirvesinden daha yüksekte duruyor. Bu noktadan tüm Liyue'yi görmen mümkün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210410
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210410,
					"content": "Tüccarlık zanaatını öğrenmeye başladığım günden beri bunu inşa etmek için gereken parayı topluyordum. Tianquan olduktan sonra da genişletmek adına zanaatını en iyi uygulayanları tutmak için hiçbir masraftan kaçınmadım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210411
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210411,
					"content": "İlk başta sadece bir odadan ibaretti. Şimdi ise Liyue'nin gökyüzündeki ayı kapatacak kadar büyük.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210412
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210412,
					"content": "Bir gün, gölgesinin yedi ulusun tamamını kaplayacağına inanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210413
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210413,
					"content": "(Bu Tianquan ne kadar hırslıymış...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210414
					]
				},
				{
					"id": 10210414,
					"content": "Liyue dışından gelen kimseler genellikle Yeşim Konak'a yükselme hakkını kazanamaz. Fakat sizden övgüyle söz eden Favonius Şövalyelerinin Büyük Kumandan Vekili ile iletişim halindeydim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210415
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210415,
					"content": "Gördüğünüz üzere Liyue'ye geldiğinizden beri dört bir yanı izlemeye ve dinlemeye başladım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210416
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210416,
					"content": "Ne!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210417,
					"content": "Sonunda sizi Wangshu Hanına giderken buldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210418
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210418,
					"content": "Bir dakika. Verr Goldet sana mı çalışıyordu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210419,
					"content": "Sadece Verr Goldet mi? Hayır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210420
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210420,
					"content": "Wangshu Hanındaki herkes bizden biri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210421
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210421,
					"content": "##@&%*!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210422,
					"content": "Ayrıca kısa süre önce Yuheng'e de rastladık...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210423
					]
				},
				{
					"id": 10210423,
					"content": "Guizhong Balistasında, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210424
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210424,
					"content": "Ah... Tüm bu sürede bizi gökyüzünden izlemiyordun... Değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210425,
					"content": "Ha ha... Korkarım bu yükseklikten izlemek biraz zor olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210426
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210426,
					"content": "Dört bir yana saldığım gözlerimiz ve kulaklarımız fazlasıyla yeterli. Ne de olsa ikiniz çok ilginç tiplersiniz. İlgi çekmeniz son derece doğal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210427
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210427,
					"content": "Keqing, Yedi Yıldızın Rex Lapis'in kötülüğünü istemeyeceğini söylemişti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210428
					]
				},
				{
					"id": 10210428,
					"content": "Adeptuslarla bizden daha fazla bir araya geldiğiniz düşünülürse bize güvenmenizi beklemiyorum. Sizi buraya bazı yanlış anlaşılmaları gidermek için davet ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10210408,
					"content": "İlk kez bu kadar yüksekte bir yere geliyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10210409
					]
				}
			]
		},
		{
			"id": 102106,
