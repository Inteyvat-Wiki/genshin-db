			"dialogs": [
				{
					"id": 10210301,
					"content": "(Keqing'e göre şöyle demeliyiz...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210302,
					"content": "Pardon, burada ay satıyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210303,
					"content": "Evet. Kaç tane istersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210304
					],
					"speakerTitle": "Bu'yun"
				},
				{
					"id": 10210304,
					"content": "Burada rakam dile getirmek uygun olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210305,
					"content": "Ah, doğru dedin. Konağa yükselmek için lütfen bunu kullanın... Ah evet. Yeri gelmişken, Leydi Ningguang'ın bugün görüşeceği iki konuk siz misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210306
					],
					"speakerTitle": "Bu'yun"
				},
				{
					"id": 10210306,
					"content": "Evet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10210307,
					"content": "(Fakat konukların kullandığı kodu değil Yuheng'in kullandığı kodu kullandılar. Burada neler dönüyor?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bu'yun"
				}
			]
		}
