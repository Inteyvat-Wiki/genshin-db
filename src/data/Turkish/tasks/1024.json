				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10240201,
					"content": "*nefes nefese kalır* Paimon yoruldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240202,
					"content": "Altın Ev'den çıkarken Yeşim Konak'ın üzerimizden uçarak geçtiğini görmeseydik ne yöne gideceğimizi bilemeyecektik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240203,
					"content": "Öf, yetişebildik mi? Girdabın Lordu hâlâ denizde mi? Henüz Liyue'yi yok etmedi, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240204,
					"content": "Burada... Ne yapıyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240205
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10240205,
					"content": "Ha... Bir saniye! Adeptuslar! Yeşim Konak'ta ne işiniz var? Paimon sizin Yedi Yıldız ile tartıştığınızı sanıyordu... Savaş bitti mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240206,
					"content": "Böyle büyük ölçekli bir felaketle karşı karşıya kalınca fikir ayrılıklarımızı şimdilik bir kenara koyduk ve ortak düşmanımıza karşı birleştik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240207
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10240207,
					"content": "Hıh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240208
					],
					"speakerTitle": "Ay Oymacısı"
				},
				{
					"id": 10240208,
					"content": "Ah, Paimon anladı... Peki Liyue'yi nasıl savunacaksınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240209,
					"content": "Of... Bu Girdabın Lordu denen tipi bu kadar uzaktan görmek bile Paimon'un midesini ağrıtıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240210,
					"content": "Sadece sen değilsin. Taşordu'nun acemi askerleri hazır olda bile titreyerek duruyor. Görünüşe göre kadim bir tanrının varlığından yayılan kudreti normal insanlar kaldıramıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240211
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10240211,
					"content": "İşte bu yüzden o canavarı Liyue Limanı'na daha fazla yaklaşmadan durdurmamız gerekiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240212
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10240212,
					"content": "Yani iki bin yıl önce Hükümdarlar Savaşı böyle düşmanlara karşı mı verildi? Çok korkunçmuş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240213,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240214
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 10240214,
					"content": "Peki Yedi Yıldız, Taşordu ve Adeptusların gücü o tanrıyı durdurmaya yetecek mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240215,
					"content": "Bunu zaten aramızda görüştük ve vardığımız sonuca göre... Pek mümkün değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240216
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10240216,
					"content": "Ne? Fakat hepinizin Liyue'nin koruyucuları olmanız gerekiyor. Bir şey düşünemez misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240217,
					"content": "Birileri düşünebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240218
					],
					"speakerTitle": "Bulutlar Hakimi"
				},
				{
					"id": 10240218,
					"content": "Nasıl yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10240219,
					"content": "Yedi Yıldız bir zamanlar ilginç buldukları için Guizhong Balistası üzerinde araştırmalar yapmıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240220
					],
					"speakerTitle": "Bulutlar Hakimi"
				},
				{
					"id": 10240220,
					"content": "Ne kadar şanslıyız ki Guizhong Balistasını kendi elleriyle inşa eden kişi burada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240221
					],
					"speakerTitle": "Bulutlar Hakimi"
				},
				{
					"id": 10240221,
					"content": "Siz faniler Adeptus mekanizmalarından ne öğrenebilirsiniz ki? Fakat bu balistayı en çılgın hayallerinizin bile ötesinde bir savaş makinasına dönüştürmek için küçük bir değişiklik yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240222
					],
					"speakerTitle": "Bulutlar Hakimi"
				},
				{
					"id": 10240222,
					"content": "Hah, sanırım Adeptuslara bize böyle bir lütuf bahşettikleri için teşekkür etmeliyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240223
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10240223,
					"content": "Öyle olsun. O tanrıyla savaşmak için güçlendirilmiş Guizhong Balistasını kullanalım. Buradaki tüm Adeptuslar balistayı çalıştırmak için bize destek verebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240224
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 10240224,
					"content": "Kaybedecek bir anımız bile yok. Savaşımız şimdi başlıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ningguang"
				}
			]
		},
