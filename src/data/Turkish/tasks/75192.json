			"dialogs": [
				{
					"id": 751920401,
					"content": "Sıvı Filojistona girdiğinde zihninde samimi anılara benzer görseller canlanıyor peş peşe.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751920402
					]
				},
				{
					"id": 751920402,
					"content": "Ateşin Ejderha Hükümdarı ile ilk insan tanrının birlikte yanardağın derinliklerine düşüşünün üzerinden çok yıllar geçti.\\nKutsal Şehir, mühürlendiğinden beri zifiri karanlık içinde. Ejderhalar kadim ateşin kaybından dolayı ya da insanların yönettiği dünyaya uyum sağlamak için bilgeliklerinden ve bedenlerinden vazgeçtiler, bazılarıysa göğüslerinde yanan ocaktan dolayı küle döndü.\\nGümüş beyaz gölge, ıssız şehirdeki çalkantılı ve yakıcı havuza adım atıyor.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751920403
					]
				},
				{
					"id": 751920403,
					"content": "Havuzdan artık yeni bir irfan alamayacağını biliyor.\\nAma nedenini soruyor kendine.\\n\"Belki de anı, elde edilmesi zor bir deneyim olduğu içindir.\"\\nBu cevabı vererek kendiyle alay ediyor, çünkü pek çok figürü artık yalnızca burada görebilir.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		}
	]
