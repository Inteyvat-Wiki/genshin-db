			"dialogs": [
				{
					"id": 751920201,
					"content": "Sıvı Filojistona girdiğinde zihninde samimi anılara benzer görseller canlanıyor peş peşe.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751920202
					]
				},
				{
					"id": 751920202,
					"content": "Çok eski bir hatıra. Bir zamanlar uzun boynuzlarıyla dünyayı aydınlatan yüce hükümdar, kanatlarının tek hareketiyle bu dağın görüntüsünü değiştiriyor.\\nIşık ve sıcaklık birer ulak, birer elçi gibi pek çok şekildeki alevlere emirler iletiyor.\\nArdından yüce kral burada tüm hatıraların ve bilgilerin saklanacağı bir yer kuruyor.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751920203
					]
				},
				{
					"id": 751920203,
					"content": "Böylece Kutsal Şehir Tollan ortaya çıkıyor ve asıl şeklini alıyor.\\nYakıcı alevler gölünde saklanan ilk hatıra bu.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
