			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tanjiyy"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733380101,
					"content": "Merhaba, yabancı dostum! Bu yollardan sık sık geçen bir gezgin misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380102
					],
					"speakerTitle": "Tanjiyy"
				},
				{
					"id": 733380102,
					"content": "Seni yolundan alıkoyduğum için kusura bakma ama... Şey, burada olan olaylardan bahsedebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380103
					],
					"speakerTitle": "Tanjiyy"
				},
				{
					"id": 733380103,
					"content": "#Ben {NICKNAME}. Tanıştığıma memnun oldum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733380104
					]
				},
				{
					"id": 733380104,
					"content": "Tanjiyy, Vahumana Dasturu hizmetinde. Buraya eğitim yardımı sağlamak için geldim... Ah, evet Tanit'e.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380105
					],
					"speakerTitle": "Tanjiyy"
				},
				{
					"id": 733380105,
					"content": "Bütün bu olanlar çok tuhaf. Burası doğru yer olmalı ama... Ah, işler nasıl bu noktaya geldi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380106,
						733380108
					],
					"speakerTitle": "Tanjiyy"
				},
				{
					"id": 733380106,
					"content": "Uzun hikaye...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733380107
					]
				},
				{
					"id": 733380107,
					"content": "Bir kabile savaşı olabilir mi? Ya da bir tür iç çatışma, hı? Çok ilginç. Bu kumlarda tüm kabilenin birden yok olduğu bir çatışma yaşanalı yüzyıllar olmuştu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380110
					],
					"speakerTitle": "Tanjiyy"
				},
				{
					"id": 733380110,
					"content": "Ayrıca çok uğursuz izler de buldum... Gidip bakmamanı tavsiye ederim... Çok iğrenç, muhtemelen miden bulanır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380111
					],
					"speakerTitle": "Tanjiyy"
				},
				{
					"id": 733380111,
					"content": "Belki içlerinden bazıları hayatta kaldı ve... Geride kalan eşyaların çoğunu toplamak için geri döndüler. Ne yazık ki emin olamıyorum. Her türlü çok endişe verici bir görüntüydü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380112
					],
					"speakerTitle": "Tanjiyy"
				},
				{
					"id": 733380112,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733380113
					]
				},
				{
					"id": 733380113,
					"content": "*iç çeker* Böyle bir şeye nasıl denk geldim? Adeta tarih kitaplarına konu olacak bir olaya rastlamışım gibiydi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380114
					],
					"speakerTitle": "Tanjiyy"
				},
				{
					"id": 733380114,
					"content": "Öhöm. Neyse... Kart oyunu oynamak ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380115
					],
					"speakerTitle": "Tanjiyy"
				},
				{
					"id": 733380115,
					"content": "O çadırlarda birkaç deste buldum. Biraz temizlemem gerekti ama oldukça iyi durumdalar. Eğer istersen bir iki tur oynayabiliriz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tanjiyy"
				},
				{
					"id": 733380108,
					"content": "Belki de... Göç etmişlerdir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733380109
					]
				},
				{
					"id": 733380109,
					"content": "Göç mü etmişlerdir? Hayır. Bak, malzemeleri ve çadırları olduğu gibi duruyor. Küller ve burada yaşadıklarına dair izler de her yerde... Hım. Açıkçası daha çok, büyük bir felaket gelip onları bir anda hayattan koparmış gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380110
					],
					"speakerTitle": "Tanjiyy"
				}
			]
		},
