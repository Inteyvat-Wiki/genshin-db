			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Maddah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230000500,
					"content": "Bir keresinde Liyue'de...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000501
					]
				},
				{
					"id": 230000501,
					"content": "Ne? Liyue mi? Kervancılara göre hükümdarları düştüğünde çeşitli gruplar birbirleriyle mücadeleye girdiler ve birbirlerine karşı planlar yaptılar. Bundan güzel bir hikaye çıkar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000502
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000502,
					"content": "Gerçi kervanlardan elde edebileceğin tek şey bölük pörçük efsanelerdir ki bunların çoğu da uydurmadır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000503
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000503,
					"content": "\"Veda Ayinini düzenleyen Gezgin, tüm kesimlerce aranan bir figür haline geldi\" gibi bir şey mesela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000504,
						230000505
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000504,
					"content": "Veda Ayinine katıldım, ben düzenlemedim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000506
					]
				},
				{
					"id": 230000506,
					"content": "Pekala, şöyle olsun \"Girdabın Lordu ile denizlerin üzerinde karşılaştı ve kılıcının gücüyle Yeşim Konak'ı bile silip süpürdü!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000507,
						230000508
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000507,
					"content": "Girdabın Lordu'yla gerçekten de karşılaştım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000509
					]
				},
				{
					"id": 230000509,
					"content": "Gerçekten mi? Peki buna ne dersin? \"Sonunda Gezgin tüm anlaşmazlıkları tek başına çözdü ve Liyue Limanı'nda yepyeni bir dönem başlattı.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000510,
						230000511
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000510,
					"content": "Anlaşmazlıklar hakikaten çözüldü...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230000511,
					"content": "O olayda Liyue'deki herkesin emeği var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230000508,
					"content": "Yeşim Konak, Lordu yenmek için büyük öneme sahipti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000509
					]
				},
				{
					"id": 230000505,
					"content": "Aslında yanımda biri daha vardı ve başka işler yapıyorduk...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000506
					]
				}
			]
		},
		{
			"id": 2300006,
