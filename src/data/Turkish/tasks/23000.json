			"dialogs": [
				{
					"id": 230001601,
					"content": "Peki o zaman, bugünkü hikayemiz uzak bir ülkede geçiyor. Karşınızda \"Inazuma'daki Yabancı Silahşor\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001602
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230001602,
					"content": "... Gök gürültüsü uzak denizlerden bile duyuluyordu... Seçilmiş Gezgin neredeyse varmak üzereydi. Yıldırım hızıyla adaları dolaştı, başardığı harika işler herkesin dilindeydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001603
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230001603,
					"content": "... Haberci, tahtın önünde diz çöktü. Kibri, sonunu hazırlamıştı. Gezginin arkadaşları yardıma koşmuş, tanrının gök gürültüsü darbesini durdurmuştu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001604
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230001604,
					"content": "... Boş kalmış toprakların üzerinde sayısız yıldız dönüp durdu... Yıldızların her biri bir ölümlünün dileğiydi. İşte böylece o diyarda yaşayanlar, tanrının kutsal gücüne karşı gelebildi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001605
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230001605,
					"content": "İşte böyle! İlginç hikaye diye buna derim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001606
					],
					"speakerTitle": "Nayab"
				},
				{
					"id": 230001606,
					"content": "Hımm... Zorlukları arkadaşlarla beraber aşmak. Kahramanlık hikayelerinde böyle şeylerden bahsedilmeli işte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001607
					],
					"speakerTitle": "Izem"
				},
				{
					"id": 230001607,
					"content": "Hikayemiz burada bitiyor. Lütfen yine gelin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maddah"
				}
			]
