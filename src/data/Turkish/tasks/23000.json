			"dialogs": [
				{
					"id": 230000701,
					"content": "Anladım... Abartılı kısımlar biraz kırpılmış olsa da bu hikayeler insana aslında daha \"doğru\" geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000702
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000702,
					"content": "Gerçekten olaylara bizzat tanık olmuş biriyle konuşuyor gibi hissettim! Artık bu efsaneler bana daha mantıklı gelmeye başladı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000703
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000703,
					"content": "Teşekkür ederim Gezgin. Şimdi artık her şeyi öğrendiğime göre yarın gece hikayelerimi dinlemeye gel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maddah"
				}
			]
		},
