			"dialogs": [
				{
					"id": 230000801,
					"content": "Anladım... Yani efsaneler esasında gerçek miymiş? Vay canına, bazen hakikat kurgudan daha tuhaf olabiliyormuş gerçekten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000802
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000802,
					"content": "Yani bu hikayeler baştan sona büyüleyici olmasaydı bu kadar yayılmazdı değil mi? Sanırım bir şeyler daha ekleyebilir, biraz daha heyecan katabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000803
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000803,
					"content": "Teşekkür ederim Gezgin. Sanırım artık hepsini öğrendim. Yarın gece hikayelerimi dinlemeye gel!",
