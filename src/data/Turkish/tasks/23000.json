				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230001501,
					"content": "Evet! Bugünkü hikayemiz uzak bir ülkede geçiyor. Karşınızda \"Altın Saçlı Kahramanın Hikayesi\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001502
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230001502,
					"content": "... Exuvia gökyüzünden aniden düştüğünde kadim Taş Limana kaos hakimdi ve Bulut Denizi gölgelerin arasında çalkalanıyordu. İşte Gezgin böyle bir zamanda geldi ve kendini bu girdabın içine çekilmiş buluverdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001503
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230001503,
					"content": "... Çıkan birçok anlaşmazlık, paylaşılan yurdu savunmak için bir kenara bırakıldı. Girdabın Osial'ı deniz suları arasında belirdi ve ayın şavkı göklerdeki Yeşim Konak'a vurdu. Kırılgan yapısı sel sularına gömüldüyse de bu büyük bedel karşılığında düşmana bitirici darbe indirilmişti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001504
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230001504,
					"content": "... Liyue, Toprak Hükümdarı'nın hükmü boyunca tüm insanlara açık bir yer olmuştu. Hükümdarları olmadan yeni bir döneme başlamak da imkansız değildi! Yavru kuşlar şimdi kendi başlarına uçuyor... Ve Kadim Taş Liman yeniden ışıldıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001505
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230001505,
					"content": "İşte böyle! İlginç hikaye diye buna derim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001506
					],
					"speakerTitle": "Nayab"
				},
				{
					"id": 230001506,
					"content": "Karşıt gruplar iş birliği yaparak güven inşa ediyor. İşte inandırıcı olay örgüsü diye buna derim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001507
					],
					"speakerTitle": "Izem"
				},
				{
					"id": 230001507,
					"content": "Hikayemiz burada bitiyor. Lütfen yine gelin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maddah"
				}
			]
		},
