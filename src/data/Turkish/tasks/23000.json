				"points": []
			},
			"dialogs": [
				{
					"id": 230000600,
					"content": "Bu maceramız Inazuma'da geçiyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000601
					]
				},
				{
					"id": 230000601,
					"content": "Ne? Inazuma mı? Elektrik Hükümdarı'nın kutsal toprakları mı? Kervancıların dediğine göre birisi Hükümdarın Önsezi Avı Fermanına karşı gelmiş. Bundan çok güzel bir hikaye çıkar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000602
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000602,
					"content": "Gerçi kervanların hikayeleri bölük pörçük, kulağa pek olası gelmeyen hikayeler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000603
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000603,
					"content": "Bilirsin işte, \"Bir Yabancı, bir Fatui Habercisi ile düello yaptı ve rakibini tek hamlede küle çevirdi!\" gibi şeyler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000604,
						230000605
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000604,
					"content": "Düelloyu kazandığım doğru...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000606
					]
				},
				{
					"id": 230000606,
					"content": "Ya da şöyle olsun, \"O, yüreklere korku salan Şogun'a karşı geldi ve Musou no Hitotachisinden bir çizik bile almadan kaçtı!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000607,
						230000608
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000607,
					"content": "Kaçtım, doğru...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000609
					]
				},
				{
					"id": 230000609,
					"content": "Gerçekten mi? Peki ya şu nasıl? \"O, sonunda Alemüstü Tanrı'nın Heykeli ile güçlenmiş ve hatta bir Hükümdarın emrini bile değiştirmişti...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000610,
						230000611
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000610,
					"content": "Şogun'un fikrini değiştirdim cidden...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230000611,
					"content": "Gerçek anahtar herkesin \"dilekleriydi.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230000608,
					"content": "Saldırıyı başka biri engelledi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000609
					]
				},
				{
					"id": 230000605,
					"content": "Cezayı uygulayan Şogun'un kendisiydi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000606
					]
				}
			]
		},
