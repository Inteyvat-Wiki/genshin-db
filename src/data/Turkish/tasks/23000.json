			"dialogs": [
				{
					"id": 230001701,
					"content": "Ah, demek geldin Gezgin! Bugünkü hikaye nasıldı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001702,
						230001703
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230001702,
					"content": "İlginç bir hikayeydi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230001704
					]
				},
				{
					"id": 230001704,
					"content": "Haha, demek sen de diğerleri gibi düşünüyorsun? Bu yeni dönemde yeni kahramanlarımız ve hikayelerimiz olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001705
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230001705,
					"content": "Onlar sayesinde benim gibiler hayatını sürdürecek parayı kazanabiliyor... Tabii senin sayende de sonunda güzel bir bardak kahve alabiliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001706
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230001706,
					"content": "Benimle paylaştığın hikayeler için teşekkür ederim. Lütfen bunu hikayelerinin karşılığı olarak al.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001707
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230001707,
					"content": "Yeni hikayelerle karşılaştığında bana da anlatmayı unutma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230001703,
					"content": "Güzel anlatılmış bir hikayeydi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230001704
					]
				}
			]
		}
	]
