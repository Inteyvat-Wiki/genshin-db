			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Maddah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230000400,
					"content": "Bir keresinde Mondstadt'ta...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000401
					]
				},
				{
					"id": 230000401,
					"content": "Ne? Mondstadt, Rüzgar Hükümdarı'nın pek sevdiği yer mi? Kervandakilerden orada fırtına çağıran bir ejder olduğunu duymuştum. Bence bundan çok güzel bir hikaye çıkar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000402
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000402,
					"content": "Gerçi kervanlardan elde edebileceğin tek şey bölük pörçük efsanelerdir ki bunların çoğu da uydurmadır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000403
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000403,
					"content": "\"Kanatlı bir gezgin, on binlerce metre yukarıda gökyüzündeki ejderhanın peşinde düşmüş bir şekilde göklerde belirdi!\" ya da buna benzer bir şey mesela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000404,
						230000405
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000404,
					"content": "Aslında, gökyüzünde bir kovalamaca olmuştu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000406
					]
				},
				{
					"id": 230000406,
					"content": "Hımm, buna ne dersin? \"Tek başına Katedrale sızdı ve Rüzgar Hükümdarı'nın kudretiyle kutsanmış güçlü bir silahı çaldı!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000407,
						230000408
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000407,
					"content": "Aslında gerçekten Katedrale sızdım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000409
					]
				},
				{
					"id": 230000409,
					"content": "Gerçekten mi? Şu nasıl peki? \"Sonunda ejderhanın zayıf noktasını buldu ve onu eski yarasının olduğu yerden vurdu. Ejderha kanıyla yıkanan kahramanımız ölümsüz biri oldu!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000410,
						230000411
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000410,
					"content": "Belirli bir noktayı hedef almamıştım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230000411,
					"content": "Ben sadece ejderhanın zihnini ele geçirmiş zehri temizliyordum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230000408,
					"content": "Göklerin Kutsal Liri bir silah değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000409
					]
				},
				{
					"id": 230000405,
					"content": "Gökyüzü kovalamacası kanat sayesinde oldu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000406
					]
				}
			]
		},
		{
			"id": 2300005,
			"completionStepIds": [
				2300001
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
