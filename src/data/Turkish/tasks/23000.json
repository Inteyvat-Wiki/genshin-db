			"dialogs": [
				{
					"id": 230001001,
					"content": "Öhöm, bugünkü hikayemiz uzak bir diyarda geçiyor. Karşınızda \"Rüzgar ve Ejderhanın Şarkısı\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001002
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230001002,
					"content": "... Ejderha geldiğinde kimse adını bilmiyordu. Mondstadt'ı felaketten kim kurtaracaktı? Oradaki canlıları kim koruyacaktı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001003
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230001003,
					"content": "... Seçilmiş savaşçı elinde Göklerin Kutsal Liri, evet, Rüzgar Hükümdarı'nın lirinin ta kendisi ile kanatlarını açtı. Lirin telleri, dağları titreten kudretiyle bin rüzgar getirdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001004
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230001004,
					"content": "... Savaşçı haykırıyordu, kılıcı kayan bir yıldız gibi alev alevdi! Ejderha harabelerin arasında mağlup şekilde uzanmış yatarken onu öldüren kişi her zamankinden daha güçlüydü artık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001005
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230001005,
					"content": "Hikaye... Oldukça yeni ve olaylarda pek konu bütünlüğü yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001006
					],
					"speakerTitle": "Nayab"
				},
				{
					"id": 230001006,
					"content": "Kahramanımız tek bir kelime etmeden dövüşe başladı ve ejderhayı çabucak yendi... Biraz garip sanki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230001007
					],
					"speakerTitle": "Izem"
				},
				{
					"id": 230001007,
					"content": "Ah... Şey... Bugünün hikayesi burada sona erdi! Lütfen yine gelin! Haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maddah"
				}
			]
