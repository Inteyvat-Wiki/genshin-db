			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Maddah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230000301,
					"content": "Ah, herkes hemen gidiyor mu? Daha hikayeme başlamamıştım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000302
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000302,
					"content": "Aman, bu gidişle kahve alacak param kalmayacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000303
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000303,
					"content": "Sorun nedir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000304
					]
				},
				{
					"id": 230000304,
					"content": "Şey, sen... Gezgin misin? *iç çeker* Gördüğün gibi bu kahve dükkanında kahve içebilmek için hikayeler anlatıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000305
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000305,
					"content": "Yakın zamanda dinleyicilerimin sayısı azaldı... Böyle giderse kahve köpüğüne bile param yetmeyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000306,
						230000307
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000306,
					"content": "Demek Mondstadtlı bir ozansın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000308
					]
				},
				{
					"id": 230000308,
					"content": "Şey... Hiç denk gelmedim ama benziyoruzdur sanırım, evet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000309
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000309,
					"content": "Kadim kahraman efsaneleri ilgi çekicidir ama her gün anlatırsan bütün hikayeler sıkıcı olur. Yeni bir konu bulmak zorundayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000310
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000310,
					"content": "*iç çeker* Sumeru'nun dışında geçen hikayeler en iyisidir. Bir kere yeni ve ilgi çekicidirler. Ayrıca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000311
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000311,
					"content": "İstediğim kadar değişiklik yapabilirim. Dinleyenler bunun farkına bile varmaz çünkü kimse aslında neler olup bittiğini bilmiyor... *öksürür*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000312
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000312,
					"content": "Yine de anlatmayı düşündüğüm hikayeleri öncelikle kendim anlamam lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000313
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000313,
					"content": "Dünyanın dört bir yanından hikayeler topladım; Dvalin'in hikayesi, Veda Ayini ve benzeri hikayeler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000314
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000314,
					"content": "Ama tüm bunları başkalarından dinledim ve eminim ki bana gelene kadar bir sürü eklemeler yapılmıştır. O yüzden bunlara çok da güvenmem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000315
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000315,
					"content": "Gezgin, Maceracılar Loncasından duyduğuma göre dünyayı dolaşıyormuşsun. Bu doğru mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000316
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000316,
					"content": "Öyleyse bana deneyimlerinden bahsedebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000317
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000317,
					"content": "Böylece hikayelerimi gerçeğe yakın hale getirip onları bir şekilde daha inandırıcı yapabilirim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000318
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000318,
					"content": "Anlattığım hikayelerden kazandıklarımı da bölüşürüz tabii!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000319,
						230000321
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000319,
					"content": "Sana yardım edebilirim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000320
					]
				},
				{
					"id": 230000320,
					"content": "Teşekkürler! Nereden başlıyoruz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000325
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000325,
					"content": "Her yerden hikaye dinlemek mümkün. Bunu biliyorsun, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000326
					]
				},
				{
					"id": 230000326,
					"content": "Aslında dünyanın dört bir yanından hikayeler topladım; Dvalin'in hikayesi, Veda Ayini ve benzeri hikayeler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000327
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000327,
					"content": "Ama tüm bu hikayeler defalarca anlatılarak benim kulağıma geldi ve eminim ki bana gelene kadar bir sürü eklemeler yapılmıştır. O yüzden bunlara çok da güvenmem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000328
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000328,
					"content": "Senin gibi bir gezginin anlattığı hikayelerse böyle durumlarda çok işe yarar. Senin de yardımınla hikayelerimi düzenleyip onları daha inandırıcı hale getirebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000321
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000321,
					"content": "Ne kadar bir eklemeden bahsediyoruz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000322
					]
				},
				{
					"id": 230000322,
					"content": "Yani, demek istediğim sıradan dinleyicilere bile biraz saçma geliyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000323
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000323,
					"content": "Hahaha... Mesela kanatları olan bir şövalyenin ve tek başına tanrıyı yenen bir kılıç ustasının hikayeleri gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230000324
					],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000324,
					"content": "Pekala, başlayalım. Hangi hikayeni paylaşmak istersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maddah"
				},
				{
					"id": 230000307,
					"content": "Demek Liyueli bir hikaye anlatıcısısın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230000308
					]
				}
			]
		},
		{
			"id": 2300004,
