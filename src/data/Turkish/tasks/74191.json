			"dialogs": [
				{
					"id": 741910201,
					"content": "İmparatorumuz! İyi misiniz? Yine rüya mı gördünüz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910202
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910202,
					"content": "Off, çok gürültü var. Neler oluyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910203
					]
				},
				{
					"id": 741910203,
					"content": "Halk büyük salonda toplandı. Sanırım size sormak istedikleri şeyler var İmparatorumuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910204
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910204,
					"content": "Son zamanlarda Phobos'un melodisi birçok defa kesintiye uğradı, bu konuda herkes endişeleniyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910205
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910205,
					"content": "Bunu yapmaktan başka çarem yok...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910206
					]
				},
				{
					"id": 741910206,
					"content": "Sizin bilge kararlarınıza elbette güveniyorum. Son zamanlarda yaşanan olaylar hakkında bazı duyumlar aldım... Phobos'ta bir sorun mu var acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910207
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910207,
					"content": "Phobos tüm insanlık mutlu olabilsin diye herkes için bir yol çizdi. Sybilla'nın sınır tanımayan hesaplama gücü sayesinde de herhangi bir sorun çıkmamış olsa gerek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910208
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910208,
					"content": "Ama müziğin içinden hazin çığlıklar geldi kulağıma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910209
					]
				},
				{
					"id": 741910209,
					"content": "Phobos'un bestelerini birileri gizlice değiştirmiş olabilir mi? Hayır hayır, böyle bir şeyi benden ve diğer Harmostlardan başka kimse yapamaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910210
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910210,
					"content": "Kahin bizden bir şeyler saklamış olabilir mi peki? Bence imkansız! Sırf bunun için tüm hayatını feda etmedi mi zaten? Kehanetinin doğruluğu Suların Hanımı tarafından da onaylandı, bu tür bencilce bir plan yapacağını sanmam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910211
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910211,
					"content": "Belki tam da bencilce hiçbir isteği olmadığındandır...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910212
					]
				},
				{
					"id": 741910212,
					"content": "Bugün herkes Phobos'un onlar adına yargıda bulunmasına ve karar vermesine bel bağlamış durumda. Olur da bir şeyler ters giderse yurttaşlar her şeyin büyük bir kaosa dönüşmesinden korkuyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910213,
						741910214
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910213,
					"content": "Şu körü körüne inananların bulunduğu yere gitmeni istiyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910215
					]
				},
				{
					"id": 741910215,
					"content": "Bir aksilik yaşanmasın diye benim melodimi Yüce Senfoniden ayırmak istediğinizi mi söylüyorsunuz yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910216
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910216,
					"content": "Hayır hayır, daha çok erken. Ruhumun henüz böyle büyük bir kadere dayanabileceğini sanmıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910217,
						741910218
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910217,
					"content": "Sana inanıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910219
					]
				},
				{
					"id": 741910219,
					"content": "... Anlıyorum. O halde ben hazırım. İsteğiniz buysa yerine getirmek boynumun borcudur İmparatorumuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910220,
						741910221
					],
					"speakerTitle": "Cassiodor"
				},
				{
					"id": 741910220,
					"content": "Ouranopolis... Geleceğin şehri...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910222
					]
				},
				{
					"id": 741910222,
					"content": "████ gittikten sonra altın koridorlardan geçiyorsun, harıl harıl tartışan insanların sesi gitgide yaklaşıyor.\\nAna salonun ortasındaki podyuma ulaştığında ortam az da olsa sessizleşiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910223
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910223,
					"content": "Ey Yüce Sebastos! Lütfen bize yol gösterin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910224
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910224,
					"content": "Son zamanlarda çoğu kişi Phobos'un melodisini duyamıyor. İnsanlar korkuyor İmparatorumuz, hem korkuyorlar hem de kafaları çok karışık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910225
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910225,
					"content": "Büyük planımız, olması gerektiği gibi ilerliyor. Gölgelerde gizlenen barbarlar birer birer yok ediliyor, kirlenen sular ise İkhor tarafından arındırılıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910226
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910226,
					"content": "Lakin yine de sebepsiz yere onurlu savaşımızı durdurma emri verdiniz İmparatorum. Bunu neden yaptınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910227
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910227,
					"content": "Durdurulması gerektiği kanısına vardım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910228
					]
				},
				{
					"id": 741910228,
					"content": "Yüce Sebastos, niyetim otoritenize karşı gelmek değil. Gelgelelim onlara yeterince merhamet gösterdiğinizi düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910229
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910229,
					"content": "Diyara muazzam bir ahenk getirdik. Remuria'nın kapıları, altın düzenimize katılmak isteyen herkese açık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910230
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910230,
					"content": "Fakat onların yaptıklarına bir baksanıza... Kulelerimizi yıkıp müzisyenlerimizi katlettiler. Onların o yozlaşmış ruhları kurtarılmayı hak etmiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910231
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910231,
					"content": "Onların barbar topraklarını kanla arındırdık, yıkımdan sonra nizam ve medeniyet yeniden yeşerecektir elbet. O densiz yabanilere gösterilebilecek en büyük merhameti gösterdik zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910232
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910232,
					"content": "Böyle olmasını istememiştim hiç...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910233
					]
				},
				{
					"id": 741910233,
					"content": "Güneşin altında bir parça gölgenin bile yeri yoktur. Sizin büyük ideallerinizden biri bu değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910234
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910234,
					"content": "Cüretimi mazur görün İmparatorumuz fakat tüm Remurialıların dileği bu yönde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741910235
					],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910235,
					"content": "Sebastos, lütfen emri verin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Boethius"
				},
				{
					"id": 741910221,
					"content": "Yeni adın bu olsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910222
					]
				},
				{
					"id": 741910218,
					"content": "Tabii bundan sonra \"bizden\" biri olmayacaksın artık...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910219
					]
				},
				{
					"id": 741910214,
					"content": "Bu sebepten ötürü sana özgür bir irade vermeliyim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741910215
					]
				}
			]
		}
	]
}