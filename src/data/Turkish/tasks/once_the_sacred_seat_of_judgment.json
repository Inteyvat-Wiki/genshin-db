					}
				]
			},
			"dialogs": [
				{
					"id": 751890601,
					"content": "\"İşte orada, teraziyi etkinleştirebilecek o ışık. İzin o...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890602
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751890602,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890603
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890603,
					"content": "Vay be, buradan bakınca tüm Kutsal Şehir görünüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890604,
					"content": "\"Doğru, ihtişamlı ve bir o kadar da mutsuz geçmişinin bir gölgesi kalmış geriye artık...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890605
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751890605,
					"content": "Rroo... Raarr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890606
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890606,
					"content": "\"O duruşmanın sonucunu mu merak ediyorsun? Haha...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890607
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751890607,
					"content": "\"Tabii ki kutsal yargıyı isteyenler tüm ışığın ve alevin ustasının ölümünün sahte olduğunu biliyordu fakat yalnızca nadiren aklı başında görülen gerçek kral bizzat gelince...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890608
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751890608,
					"content": "\"Önceden susmak bilmeyen On Üç Lord ve Üç Prens bir anda kılıçlarını çektiler ve duruşma bir saçmalığa dönüştü, dolayısıyla dağıldı...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890609
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751890609,
					"content": "Rraaa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890610
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890610,
					"content": "\"Daha sonraları Üç Prens insanlığa karşı olan savaşta öldü, On Üç Lordun onu ise Kutsal Şehir Tollan çökünce öldü, biri Chichen Uctokah'da kaldı...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890611
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751890611,
					"content": "\"Bugün ise bir lord hâlâ hayatta...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890612
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751890612,
					"content": "\"Fakat sahip olmak istediği formda değil şüphesiz...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890613
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751890613,
					"content": "\"Pekala. Kutsal Dağ'ın Kalbi'ne ilerleyelim. Her şey orada gömülü... Bu yolculuğun sonunu getirme isteği de öyle.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890614
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751890614,
					"content": "\"Görevim yakında tamamlanacak... Ejderhaların Seçilmişi, keşke burayı en ihtişamlı halinde, en hakiki güzelliğinde görebilseydin...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890615
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751890615,
					"content": "\"Hadi, ateş işlemeli ışığa dokun... Kutsal Dağ'ın Kalbi'ne ulaşmak için gereken izni al...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890616
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751890616,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890617
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890617,
					"content": "Awanyu... Aa, yine gitmiş! Paimon tam bu adı kullanmaya alışmıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890618,
					"content": "Nihayet Kutsal Dağ'ın Kalbi'ne girmek için gereken izni aldık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890619,
					"content": "Rraarr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890620
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890620,
					"content": "Bu taraftaki ışık... Gitmiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
