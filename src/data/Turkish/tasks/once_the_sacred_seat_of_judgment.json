			"dialogs": [
				{
					"id": 751890501,
					"content": "\"Geleceğini biliyordum, o nedenle duruma yaraşacak ihtişamlı bir karşılama hazırladım...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890502
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751890502,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890503
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890503,
					"content": "\"Kibarlık ettiğini bilsem de seni gördüğüme sevindim.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890504
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751890504,
					"content": "Aa, demek sensin! Ee, bu sefer adın ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890505,
					"content": "\"Bu seferki adım Müzakere Odasındaki bir katibe aitti. Gerçekte kendisi kaleme veya mürekkebe nadiren dokundurdu, en azından Gizli Kaynak Hizmetkarları icat edildikten sonra yani.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890506
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751890506,
					"content": "\"Awanyu... Bana bu adla seslenebilirsiniz.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890507
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751890507,
					"content": "Pekala Awanyu. Bize bu \"Kutsal Dağ'ın Kalbi'ne Giriş İzni\" konusunda yardım etmeye mi geldin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890508,
					"content": "\"İzin olmadan Kutsal Dağ'ın Kalbi'nin içindeki Yıldız Kümeleri, izinsiz giren herkese saldırır...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890509
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751890509,
					"content": "\"... 'Awanyu'nun kayıtlarını taradım. Bu kayıtlara göre Kutsal Dağ'ın Kalbi'ne girmek için gereken izin Müzakere Odasının üstünde bir konuma yerleştirilmiş.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890510
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751890510,
					"content": "\"Bundan ötürü buraya adım atmak zorundayım... Kibirli ahmakların güçsüzlüklerinden zevk aldığı bu zavallı yere.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890511
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751890511,
					"content": "\"Kendi soydaşlarını yargılama hakları olduğunu iddia eden sahtekarlara değinmiyorum bile...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				}
			]
		},
		{
			"id": 7518906,
