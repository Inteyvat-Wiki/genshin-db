			"dialogs": [
				{
					"id": 751890401,
					"content": "Oh be, nihayet bitti! \"Kutsal Dağ'ın Kalbi\"ne girmek için gerekli izni sonunda aldık galiba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890402,
					"content": "\"Hayır. Dedim ya, bu iznin boş kabuğundan ibaret...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890403
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751890403,
					"content": "\"Tek bir puldan yapılmış, sahibi hakkında hiçbir bilginin bulunmadığı bir cihaz bir izne dönüştürülemez.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890404
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751890404,
					"content": "\"Aksi takdirde herhangi bir ejderhanın kullanabileceği bir ana anahtar olmaz mıydı?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890405
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751890405,
					"content": "Çabuk, uygun statüye sahip bir ejderha getirelim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751890406
					]
				},
				{
					"id": 751890406,
					"content": "#Nereden bulacağız ejderhayı... Aa, bir dakika! {REALNAME[ID(2)|SHOWHOST(true)]} sayılır mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890407,
					"content": "Raarr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890408
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890408,
					"content": "\"Şu an sayılmaz, hayır...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890409
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751890409,
					"content": "Öyleyse ne yapacağız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890410,
					"content": "\"Uzun zaman önce, yüce hükümdar Kutsal Dağ'ın Kalbi'ne girdikten sonra bu izni etkinleştirme yetkisi olanlar geldi fakat hiçbiri izni etkinleştirmedi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890411
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751890411,
					"content": "\"Belki bu ilginç zat da tam olarak bu amaç için buraya yerleştirilmiştir...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				}
			]
		},
