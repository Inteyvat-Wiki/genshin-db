			"dialogs": [
				{
					"id": 751890701,
					"content": "Gölge düşmanı tehdidi tespit edildi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890702
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751890702,
					"content": "İç güvenlik... Otomatik onarım modu etkinleştirildi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890703
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751890703,
					"content": "Aa! Paimon, böyle bir yerde bu tarz mekanizmaların olacağını hiç düşünmemişti... O canavarlar kısa sürede yok oldu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890704,
					"content": "\"Burası öyle sağlam bir yer ki ebediyen ayakta kalabilir. Sadece savunma yapmakla kalmıyor, aynı zamanda kendini onarma becerisi de var...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890705
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751890705,
					"content": "Parlak altın renginde... Paimon dokunmak istiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890706,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890707
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890707,
					"content": "\"Haha, yapmasan daha iyi... Dost düşman ayırt etmez... Daha doğrusu, dokunduğu her şeyi yutar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890708
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751890708,
					"content": "\"Kaba ve acımasız bir yaklaşım. Hıh, bu aptalların tasarımları...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890709
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751890709,
					"content": "Yine de izni koruyan kalkanı açmak için onu kullanabiliriz, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890710,
						751890712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890710,
					"content": "Denemeye değer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751890711
					]
				},
				{
					"id": 751890711,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890716
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890716,
					"content": "Neyse... Bu şeyi yükseltmenin bir yolunu bulalım hadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890712,
					"content": "Sevgili Paimon'dan duymaya alışık olmadığımız bir öneri...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751890713
					]
				},
				{
					"id": 751890713,
					"content": "Gırrr, rraarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890714
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890714,
					"content": "\"Doğru. Ben de beyaz elçimizin bu kadar derin fikirleri olabileceğini bilmezdim... Nasıl bir irfan gizliymiş meğer içinde. Şaşırtıcı.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890715
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751890715,
					"content": "... Paimon neye bu kadar şaşırdığınızı anlamadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890716
					],
					"speakerTitle": "Paimon"
				}
			]
