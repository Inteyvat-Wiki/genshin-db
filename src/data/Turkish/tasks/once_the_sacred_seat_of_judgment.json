			},
			"dialogs": [
				{
					"id": 751890301,
					"content": "\"Gidelim. İzni nereye sakladıklarını görelim bakalım...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890302
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751890302,
					"content": "\"Şuraya bırakmışlar galiba... Saklamayı hiç düşünmüşler mi acaba?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890303
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751890303,
					"content": "\"İçi boşmuş ama...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890304
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751890304,
					"content": "Bu Hiçlik Kurtları nereden çıktı böyle? Of, demek ki izin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890305,
					"content": "\"Kapı güvenliği devre dışı bırakılmış olabilir, içeri o sayede girmişlerdir.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890306
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751890306,
					"content": "B-Bir dakika, ne yapacağız o zaman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751890307,
					"content": "\"Önemi yok. Müzakere Odasının onarım ve arındırma işlevlerini etkinleştirmemiz yeterli olacaktır.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890308
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751890308,
					"content": "\"Şuradalar...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				}
			]
		},
