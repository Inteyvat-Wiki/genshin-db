			},
			"dialogs": [
				{
					"id": 750690801,
					"content": "(Quenin'e benzeyen soğuk, heykeli andıran bir beden. Nasıl olduysa çürümeden kalmış, zamanda donmuş gibi...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690802
					],
					"speakerTitle": "Soğuk Beden"
				},
				{
					"id": 750690802,
					"content": "(Ve etrafa bakıldığında, çok uzun süredir bu şekilde durduğu çıkarımı yapılabilir...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soğuk Beden"
				}
			]
