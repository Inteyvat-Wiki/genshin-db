						750691204
					]
				},
				{
					"id": 750691204,
					"content": "Ben... Macera takımının bir savaşçısıyım, tabii liderimiz Lord Taika kadar güçlü sayılmam. Ancak benim de güçlü olduğum alanlar var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691205
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691205,
					"content": "Kampımızı korurum... Bazen geceleri uyuyamadığımda kampı güvende tutmak için devriye gezerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691206
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691206,
					"content": "Bunun ne zaman başladığını bilmiyorum ama kamptaki insanların sayısı her gün giderek azalmaya başladı... Çok tuhaf... Şu an neden buradayım ki?",
					"roleType": "TALK_ROLE_NPC",
