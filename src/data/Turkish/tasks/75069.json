			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Quenin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750690201,
					"content": "Ah, buraya... Pek ziyaretçi gelmez... Tehlikeli bir yer sonuçta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690202
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750690202,
					"content": "Sen de macera takımından mısın? Hıh, Tonatiuh'dan kara bir yılanın gölgesinin indiği söylenir... Dikkatli olmalısın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690203
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750690203,
					"content": "Hatta hâlâ gidebiliyorken git. Macera takımında saklanan insan dışı varlıklar var... Sesler, lanetler... Çok gürültülü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690204
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750690204,
					"content": "Şelale sağ olsun, burası epey sessiz. Haha... Suların gürültüsü tüm sesleri bastırıyor, başka hiçbir şey duyamıyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		},
		{
			"id": 7506905,
			"completionStepIds": [
				7506903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7506903",
							"2"
						],
						"stepId": 7506903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750690501,
					"content": "(Başında düzgünce yazılmış yazıların bulunduğu yırtık bir sayfa...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690502
					],
					"speakerTitle": "Quenin'in Günlüğü"
				},
				{
					"id": 750690502,
					"content": "\"... Hiçlik canavarlarının sayısı beklendiği üzere artıyor... Macera takımı sonunda başarısız oldu ve şu anda bir geri çekilme planı uygulanıyor.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690503
					],
					"speakerTitle": "Quenin'in Günlüğü"
				},
				{
					"id": 750690503,
					"content": "\"Kalan üyelerin sağ salim tahliye edildiklerinden emin olmalıyız. Geceleri ortadan kaybolanlara ya da ışıksız yerlerden dönenlere karşı temkinli ol.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690504
					],
					"speakerTitle": "Quenin'in Günlüğü"
				},
				{
					"id": 750690504,
					"content": "\"... Hiçlik canavarları daha sık görünmeye başladı. Kale yakında keşfedilebilir, ancak onun öncesinde...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690505
					],
					"speakerTitle": "Quenin'in Günlüğü"
				},
				{
					"id": 750690505,
					"content": "(El yazısı eğri büğrü olmaya başlıyor...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690506
					],
					"speakerTitle": "Quenin'in Günlüğü"
				},
				{
					"id": 750690506,
					"content": "\"Uf, soğuk... Çok soğuk... Şurada, şurada kan damlıyor...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690507
					],
					"speakerTitle": "Quenin'in Günlüğü"
				},
				{
					"id": 750690507,
					"content": "\"Şelalenin sesi, çok yüksek... Evet, böyle iyi. Şelalenin altında... Kaldığım sürece sessiz olacak... Soluk yüzler, açılmış ağızlar, çekilmiş kanlar...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690508
					],
					"speakerTitle": "Quenin'in Günlüğü"
				},
				{
					"id": 750690508,
					"content": "\"Tam şurada... Tam... Şurada... Bir şey... Bir şey var şurada...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750690509
					],
					"speakerTitle": "Quenin'in Günlüğü"
				},
				{
					"id": 750690509,
					"content": "\"Şelalenin altında şelalenin altında şelalenin altında şelalenin altında şelalenin altında şelalenin altında...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin'in Günlüğü"
				}
			]
		},
		{
