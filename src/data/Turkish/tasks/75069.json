					"nextDialogs": [],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691307,
					"content": "Başka sesler duyuyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750691308
					]
				},
				{
					"id": 750691308,
					"content": "Evet, sadece şelalenin orada suyun sesi diğer sesleri bastırıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691309
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691309,
					"content": "Duymuyor musun? Biri sanki ölüyormuş ama çığlık atamıyormuş gibi kulağının dibinde inliyor. Sadece nefes almaya çalışan akciğerlerinin sesi geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691310
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691310,
					"content": "Daha sonra sana öfkeyle bakan solgun bir yüz göreceksin. Sanki... Senin yüzün gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691311
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691311,
					"content": "Yalnızca şelalede, yalnızca orada bu rahatsız edici seslerden kaçabiliyorum. Hehe, sesleri duyamıyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750691312
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691312,
					"content": "Burada çok uzun süre kalırsan cesur savaşçı, sonun benim gibi olur. O yüzden, hâlâ gidebiliyorken git.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750691313,
					"content": "Yok, bir şey lazım değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750691314
					]
				},
				{
					"id": 750691314,
					"content": "Demek öyle... Bak cesur savaşçı, benden sana bir tavsiye. Burayı derhal terk et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
