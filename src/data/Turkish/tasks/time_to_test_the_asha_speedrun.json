					"content": "Şimdi sıra Bennett'te, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150480305,
					"content": "Evet! Isındım, açma germe hareketlerimi tamamladım, şimdi harekete geçmeye hazırım! İnanın bana, bu iş bende!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480306
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480306,
					"content": "Dikkatli ol.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150480307
					]
				},
				{
					"id": 150480307,
					"content": "#Beni düşündüğün için sağ ol {NICKNAME}! Ama merak etme, dikkatli olurum!",
