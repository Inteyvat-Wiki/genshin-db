			"dialogs": [
				{
					"id": 150480101,
					"content": "... Üzgünüm, böyle bir risk almanıza izin veremeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480102
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480102,
					"content": "Ama az önce böyle dememiştiniz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480103
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480103,
					"content": "Çok özür dileriz. Zamanımız kısıtlı ama ziyaretçilerimizin güvenliği her şeyden önce geliyor. Umarım anlayışla karşılarsınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480104
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480104,
					"content": "#Hah, tam zamanında geldin {NICKNAME}! Bu beyefendiyi ikna etmeme yardımcı olur musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480105
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480105,
					"content": "Test için birine ihtiyaçları vardı, ben de macera tecrübemi sıraladım ve her türlü riski kabul ettiğimi açıkça belirttim. Her şey iyi gidiyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480106
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480106,
					"content": "Ama geçmişte birkaç kez ölümle burun buruna geldiğimi duyunca katılmamı doğrudan reddetti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480107
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480107,
					"content": "Beyefendi, hevesinizi gerçekten takdir ediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480108
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480108,
					"content": "Ama dediğiniz gibi sağlam taş köprülerde yürürken bile nehre düşmeye meyilliyseniz biraz daha rahat bir aktivite denemeniz daha iyi olabilir. Şuradaki şezlonglardan birine uzanmaya ne dersiniz mesela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480109
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480109,
					"content": "*iç çeker* Ama ben gerçek bir maceracıyım, testin gereksinimlerini de karşılıyorum! Sadece geçmişte şansım yaver gitmedi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480110
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480110,
					"content": "Yardım etmeyi çok istiyorum. Bana güvenebilirsiniz, söz veriyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480111,
						150480112
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480111,
					"content": "Ben kefil olurum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150480113
					]
				},
				{
					"id": 150480113,
					"content": "Peki, Natlan'ın kurtarıcısı öyle diyorsa bize söz düşmez... Şöyle yapalım, testin ilk turunu sizden önce Asha yoldaşınız tamamlasın. Olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480114
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480114,
					"content": "Böylece kenardan izleyip rotayı öğrenirsiniz. Her şey yolunda giderse de testin ikinci turuna katılabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480115
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150480115,
					"content": "Bu sana uyar mı dostum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480116
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480116,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150480117
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150480117,
					"content": "Tamamdır o zaman! Bu işi sana bırakıyorum ortak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150480112,
					"content": "Ona güvenim tam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150480113
					]
				}
			]
		},
