			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10100501,
					"content": "Bay Zhongli, Wangsheng olarak bilinen bir kurumun danışmanı... Ayrıca Fatui'nin güvenilir bir ortağı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100502,
						10100503
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10100502,
					"content": "Fatui'nin ortağı mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100504
					]
				},
				{
					"id": 10100504,
					"content": "Evet. Wangsheng'in yaptığı işler bazen... Biraz hassas olabiliyor. Gizliliğe büyük saygıları var dememiz yeterli olacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100505
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10100505,
					"content": "Fatui olarak biz de, gölgelerde yürüyen dostlarla iş yapmaktan her zaman memnunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100506
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10100506,
					"content": "G-Gölgelerde yürüyen mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100507,
					"content": "Sizinle tanışmak bir şeref. Mondstadt'tan geldiğinizi duydum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100508
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100508,
					"content": "Gizlilik... Gölgeler... Ha! Acaba Wangsheng insanların... \"icabına bakmakla\" ilgili bir işletme mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100509,
					"content": "Aynen öyle, doğru tahmin ettin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100510
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100510,
					"content": "Ayy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100511,
					"content": "Wangsheng Cenaze Evi defin organizasyonu yapar. Vefat edenlerin huzur içinde olduğundan emin oluruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100512
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100512,
					"content": "Nasıl yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100513,
					"content": "Haha, kiralık katil falan mı olduğunu düşündünüz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100514
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10100514,
					"content": "Fatui'nin o tarzda birçok dostu var ancak Wangsheng Cenaze Evi bu tarz işlerle uğraşmıyor... Yani görünüşte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100515
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10100515,
					"content": "Görünüşte...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100516
					]
				},
				{
					"id": 10100516,
					"content": "Yani yine de... Neyse çok detay vermemeliyim. Bay Zhongli'yi görüşmeye getirdim çünkü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100517
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10100517,
					"content": "Çünkü seni Rex Lapis'in bedeninin olduğu yere götürebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100518
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100518,
					"content": "Ne!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100519,
					"content": "Bu kadar şaşırma. Toprak Hükümdarı'nın bedeni Tianquan Ningguang'ın emriyle yastık altı edilmiş olabilir... Ama önce Bay Zhongli'nin söyleyeceklerini bir dinleyelim, ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100520
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10100520,
					"content": "Rex Lapis, Adeptusların Başı olabilir ancak nihayetinde bir Adeptus. Çoğu Adeptus geçtiğimiz bin yılda aramızdan ayrıldı... Bu değiştirilemez bir durum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100521
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100521,
					"content": "Artık devir değişti... Sen de Jueyun Gölü'nde bunu hissetmişsindir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100522,
						10100523
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100522,
					"content": "Doğru, Adeptuslar Liyue'den uzak duruyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100525
					]
				},
				{
					"id": 10100525,
					"content": "Gördüğün üzere Adeptusların dönemi son buluyor ve insanlığın zamanı ufukta belirmeye başlıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100526
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100526,
					"content": "Geçmişte Liyue geleneğine göre her Adeptusun vefatında büyük bir anma töreni yapılırdı. Şimdi Yedi Yıldız, bu geleneğe saygı göstermeyi denemedi bile. Bu kutsal değerlere bir hakaret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100527
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100527,
					"content": "Bir de şu kutsalın düşmanı meselesi var...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100528
					]
				},
				{
					"id": 10100528,
					"content": "Evet, katil henüz yakalanmadı bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100529,
					"content": "Kutsalın Düşmanı olup olmaması fark etmez. Wangsheng Cenaze Evinin endişesi, bu tanrının gelişi krallara yaraşır bir ayinle kutlanırken son vedasında kimsenin olmaması çok daha korkunç bir durum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100530
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100530,
					"content": "Gezgin, Asilzade bana senden bahsetti. Senin Rüzgar Hükümdarı'yla geçmişin olduğuna göre bana Toprak Hükümdarı'nın son veda ayinini hazırlarken yardım edebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100531,
						10100534,
						10100536
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100531,
					"content": "Bunun üzerine biraz düşünmem lazım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100532
					]
				},
				{
					"id": 10100532,
					"content": "#Yani... {NICKNAME}, şu durumda başka bir seçeneğimiz varmış gibi durmuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100533
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100533,
					"content": "Aynen öyle, üzerine ne kadar düşünürsen düşün sonuç aynı olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100539
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10100539,
					"content": "Tianquan Ningguang, herhangi birinin Rex Lapis'in bedenini görmesini tamamen yasakladı... Tabii ki Yedilerin tümüyle tanışma hedefini gerçekleştirmek istiyorsan senin ona erişmen gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100540
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10100540,
					"content": "Aynen öyle. Rex Lapis'in bedenini yalnızca Veda Ayinine katılarak tekrar görebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100541
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100541,
					"content": "Başka seçenek yok gibi duruyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100542
					]
				},
				{
					"id": 10100542,
					"content": "Anlaştıysak benimle gel. Yürürken ayrıntıları konuşuruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100543
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100543,
					"content": "(Ortam kararır. Zhongli ortadan kaybolur.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100544
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100544,
					"content": "Tamamdır, benim aracılık işim buraya kadardı. Fena olmadı değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100545
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10100545,
					"content": "İstersen gidebilirsin, benim için endişelenme. Ben biraz daha içeceğim... Aynı zamanda da \"yemek çubuğu\" dedikleri şeylere alışmaya çalışacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10100534,
					"content": "Davetini kabul ediyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100535
					]
				},
				{
					"id": 10100535,
					"content": "Akıllıca bir karar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100539
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10100536,
					"content": "Asilzade çok detay veriyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100537
					]
				},
				{
					"id": 10100537,
					"content": "Öyle mi? Bizim iş dünyamızda bu sözler beni susturmak istediğin anlamına geliyor... İlginç. Kılıcını çek. Şimdi sana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100538
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10100538,
					"content": "Şaka yapıyordum. Devam edelim mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100539
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10100523,
					"content": "Toprak Hükümdarı da mı Adeptus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100524
					]
				},
				{
					"id": 10100524,
					"content": "Hükümdarların birçok adı var. Sözleşme Tanrısı, Ticaret Tanrısı, Savaşçı Tanrı, Morax, Rex Lapis... Adeptus unvanının da olması fikri tuhaf mı geldi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100525
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100503,
					"content": "Wangsheng mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100504
					]
				}
			]
		},
		{
			"id": 101006,
			"completionStepIds": [
				101006
			],
