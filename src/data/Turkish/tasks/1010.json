					"Asilzade"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10100301,
					"content": "Gelmişsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100302
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10100302,
					"content": "Söz verdiğim gibi sana yardımcı olabilecek birini buldum. Liyue Yedi Yıldızının Toprak Hükümdarı'nın bedenini neden sakladığının gizemini çözebilecek birisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100303
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10100303,
					"content": "Bu kişi nerede? <color=#00E1FFFF>Liuli Konağı'nda</color> mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100304,
					"content": "Aynen öyle. Gel de sizi tanıştırayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100305
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10100305,
					"content": "Liyue geleneklerine göre bir iş yemeği ayarlama inisiyatifinde bulundum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asilzade"
				}
			]
		},
		{
			"id": 101005,
			"completionStepIds": [
				101005
