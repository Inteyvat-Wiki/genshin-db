				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10100601,
					"content": "Hükümdarsız toprakları gördükten sonra Liyue'de hükümdarımızın ve Adeptuslarımızın varlığını hissetmek nasıl oldu Gezgin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100602,
						10100605
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100602,
					"content": "Mondstadt'ın atmosferini tercih ederim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100603
					]
				},
				{
					"id": 10100603,
					"content": "Anladım, demek o tarz bir insansın. Bu da kötü bir şey değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100604
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100604,
					"content": "Ancak sanırsam henüz Liyue'nin üç bin yedi yüz yıllık kutsallığının özünü deneyimleyemedin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100607
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100607,
					"content": "Veda Ayinini organize etmek, seyahatlerinin aydınlatıcı bir parçası olacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100608
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100608,
					"content": "Tanrılar tarafından korunan ve Yedi Yıldız tarafından yönetilen Liyue, yedi ulustan en müreffeh olandır. Bu yüzden Fatui'nin diplomatik sinsilikleri buraya işlemedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100609
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100609,
					"content": "Yedi Yıldızdan Ningguang her zaman Fatui'ye karşı nöbette. Muhtemelen bu yüzden Asilzade, Wangsheng Cenaze Evinin bağlantılarını kullanmak istiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100610
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100610,
					"content": "Veda Ayinini yapmamızda Asilzade'nin çıkarı ne ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100611,
					"content": "Ne biliyorum ne de bilmek istiyorum. Benim bildiğim kadarıyla Fatui sadece işin para kısmında. Ben Liyue'nin geleneklerinin devam etmesini istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100612
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100612,
					"content": "(Zhongli oyuncuya bir torba dolusu para verir.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100613
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100613,
					"content": "Bunlar Asilzade'nin verdiği avans parası. Hepsini harcadığında kendisine gidip ek kaynak için başvurabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100614
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100614,
					"content": "Vay canına...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100615,
					"content": "O zaman biz artık gidelim. Hazırlıklarımızın ilk adımı olarak tanrılara yaraşır bir nesne olan <color=#00E1FFFF>Gece Parlayan Yeşim</color> bulmamız gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10100605,
					"content": "Liyue daha iyi bir yer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100606
					]
				},
				{
					"id": 10100606,
					"content": "Aynen öyle. Üç bin yedi yüz yıllık tarihin ağırlığı, Liyue'nin gerçek kutsallığının derinlerinde yatıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100607
					],
					"speakerTitle": "Zhongli"
				}
			]
		},
