				"points": []
			},
			"dialogs": [
				{
					"id": 10100201,
					"content": "#Hoş geldin Asilzade'nin dostu {NICKNAME}. Fatui'deki şanlı kariyerinin başlangıcı için seni tebrik ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100202,
						10100203
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10100202,
					"content": "Asilzade'yi arkadaşım olarak görmüyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100204
					]
				},
				{
					"id": 10100204,
					"content": "Kendinden oldukça emin konuşuyorsun... Unutma, bizler ölümlüyüz... Fikirlerimiz su gibi akışkan. Yalnızca Çariçe'nin donmuş toprak kadar katı bir iradesi var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100205
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10100205,
					"content": "Ancak elimizdeki meseleye dönecek olursak, Asilzade anlaşmanın kendisine ait olan kısmını tamamladığını söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100206
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10100206,
					"content": "Ne anlaşması? Bize bir kişi bulmayla ilgili olan mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100207,
					"content": "Aynen öyle. Asilzade ikilemi çözecek birilerini bulacağına söz vermişti ve Haberciler sözlerini öyle pek kolay bozmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100208
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10100208,
					"content": "Bu kişi nerede peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100209,
					"content": "Asilzade şu anda <color=#00E1FFFF>Liuli Konağı'nda</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100210
					],
					"speakerTitle": "Ekaterina"
				},
				{
					"id": 10100210,
					"content": "Liuli Konağı mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100211
					]
				},
				{
					"id": 10100211,
					"content": "Paimon bu yeri biliyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100212,
					"content": "*boğazını temizler* Liyue'de Li stili ve Yue stili olarak bilinen iki farklı yemek pişirme tarzı var. Bu yöntemler yüzyıllardan beri birbiriyle yarışır ancak henüz biri diğerine tam olarak üstün gelmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100213,
					"content": "Li stilinde en iyi pişiren restoran Liuli Konağı. Mekanın sahibi restoranı özellikle Feiyun Yamacı'nda açmak istedi. Böylece Yue tarzının en iyi restoranı Xinyue Köşkü'yle karşı karşıya rekabet edebilecekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10100214,
						10100215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100214,
					"content": "Böyle şeyleri bilmene şaşırmıyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100216
					]
				},
				{
					"id": 10100216,
					"content": "Paimon'a öyle deme! Her neyse, Paimon acıktı. Hadi gidelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10100215,
					"content": "Ne zaman yemekten bahsetsek böyle oluyorsun...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100216
					]
				},
				{
					"id": 10100203,
					"content": "Fatui'ye katılma niyetim yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10100204
					]
				}
			]
		},
