			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Köpek"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732941001,
					"content": "Garip. Köpeğin ne işi var ki burada? Üstelik bir şey koruyor galiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941002,
					"content": "(Sizi dikkatlice izliyor.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941003,
						732941005
					],
					"speakerTitle": "Köpek"
				},
				{
					"id": 732941003,
					"content": "Akıllı köpek!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941004
					]
				},
				{
					"id": 732941004,
					"content": "(Havlıyor.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941007
					],
					"speakerTitle": "Köpek"
				},
				{
					"id": 732941007,
					"content": "Aa doğru, Julien'ın kampında mama kabı görmemiş miydik? Belki o kap bu dostumuza aittir! Tuhaf. Julien hayvan dostu olmadığını söylemedi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941008,
					"content": "*inler*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941009
					],
					"speakerTitle": "Köpek"
				},
				{
					"id": 732941009,
					"content": "Köpek kampa doğru koşar...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732941010
					]
				},
				{
					"id": 732941010,
					"content": "Gitti... Döndüğümüzde Julien'a soralım bunu. Şimdi... Bu kum yığının altında ne var acaba? Bir bakalım mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941005,
					"content": "Bu başıboş köpek nereden geldi acaba...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941006
					]
				},
				{
					"id": 732941006,
					"content": "(Size hırlıyor.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941007
					],
					"speakerTitle": "Köpek"
				}
			]
		},
		{
			"id": 7329412,
			"completionStepIds": [
				7329412
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329412",
							"2"
						],
						"stepId": 7329412,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732941201,
					"content": "Biz geldik! Ha, demek bu köpek seninmiş Julien!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941202,
					"content": "(Tehditkar bir şekilde hırlar.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941203
					],
					"speakerTitle": "Köpek"
				},
				{
					"id": 732941203,
					"content": "Aferin sana Tarçın... Bana hırlamaya başladın demek, öyle mi? Burada karnımızı kimin doyurduğunu unuttun herhalde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941204
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941204,
					"content": "(Aa, demek ismi varmış! Diğer bir yandan... Bu adam gerçekten bir köpekle mi tartışıyor?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941205,
						732941207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941205,
					"content": "(Çok yakınlar galiba.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941206
					]
				},
				{
					"id": 732941206,
					"content": "(\"Yakın\" olmak senin için böyle bir şey mi?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941244,
					"content": "Hey, Julien! Kaybettiğin şeyi bulduk! Tarçın senin evcil hayvanın, değil mi? Niye bize yalan söyledin ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941209,
					"content": "Bu nankör şeyin dostum olması yerine... Bir Hiçlik Kurdunu sahiplenmeyi yeğlerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941210
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941210,
					"content": "Arkadaşlığınızın çok uzun süreceğini sanmıyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941211
					]
				},
				{
					"id": 732941211,
					"content": "Aynen öyle. Senin gibi açlıktan bayılan birinin karşısına Hiçlik Kurdu çıksa o durum öyle Teyvat Usulü Yumurtayla çözülmez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941212,
					"content": "Bu arada köpek sahilde bir çizim tahtasını koruyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941213,
						732941215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941213,
					"content": "Saklamak istemiş olabilir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941214
					]
				},
				{
					"id": 732941214,
					"content": "Kötü köpek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941217,
					"content": "(İtiraz edercesine havlıyor.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941218
					],
					"speakerTitle": "Köpek"
				},
				{
					"id": 732941218,
					"content": "Utanmadan bir de sızlanıyor musun? Seni buralara kadar takip etmeseydim geldiğim yoldan Fontaine'e çoktan dönmüştüm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941219
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941219,
					"content": "Hı? Hani manzara görmek istediğin için su yoluyla dönmeye karar vermiştin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941220,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941221
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941221,
					"content": "İyi tamam... Aslında Sumeru'nun manzaralarının keyfini çıkarmaya bile fırsatım olmadı. Sadece bu köpeği takip ettim ve kendimi burada buldum. Buradaki yollar çok dolambaçlı olduğu için kaybolmamak neredeyse imkansız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941222
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941222,
					"content": "Demek öyle... İyi de bunu bize en başından söyleseydin ya! Niye söylemedin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941223,
					"content": "Iı... Çünkü... Meşhur bir sanatçı olduğumdan imajımı korumaya çalışıyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941224
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941224,
					"content": "Of, öyle kekelediğinde bizi kandırmaya çalışıyormuşsun gibi duruyor. Hem beceremiyorsun da zaten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941225,
					"content": "#Ayrıca Sumeru'daki manzaralardan konu açılmışken {NICKNAME} ve Paimon'un bildiği güzel yerler var. Seni götürebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941226,
					"content": "Sorun değil. Şey, yani... Teklifiniz için teşekkür ederim ama ben meşhur bir sanatçıyım ne de olsa. Resmetmeye değer manzaraları sanatçının kendisinin keşfetmesi gerektiğini düşünüyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941227
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941227,
					"content": "Hah, çay da hazır. Biraz daha yumurtanız var mı? Çayın yanında iyi gider...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941228,
						732941230
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941228,
					"content": "Biraz alışılmadık değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941229
					]
				},
				{
					"id": 732941229,
					"content": "#Evet ya! {NICKNAME} tam bir şeftir! Başka bir şey de yiyebiliriz yani, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941232,
					"content": "Çaylarınızı içip yanında birkaç atıştırmalık yiyorsunuz.\\nÇayın tadını anlatmak zor...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732941233
					]
				},
				{
					"id": 732941233,
					"content": "Şey, bu çay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941234,
					"content": "Bir arkadaşım sattı bana. Dediğine göre insanlardaki potansiyel bilgeliği ortaya çıkarabiliyormuş. Bence tadı harika.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941235,
						732941237
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941235,
					"content": "Neyse ki böyle arkadaşlarım yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941236
					]
				},
				{
					"id": 732941236,
					"content": "Niye öyle dedin ki? Arkadaşlar iyidir. Hatta Sumeru'ya da bir arkadaşın tavsiyesi üzerine geldim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941240
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941240,
					"content": "Bugünkü yardımınız için teşekkür ederim size. Umarım bu ödül beklentilerinizi karşılamaya yetmiştir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941241
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941241,
					"content": "Sorun değil, merak etme... Peki ilham aramak için yardımımızı istemediğine emin misin? Paimon kaybolabileceğini düşünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941242,
					"content": "Kutsal yolculuğun... Yani şey, seyahat etmenin anlamı kişinin kendi yolunu bulmasında yatar. Size daha fazla zahmet vermeyeyim. Kendim hallederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941243
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941243,
					"content": "Tamam, madem öyle diyorsun. Yolda yine açlıktan bayılmak yok ama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941237,
					"content": "Bir fincan daha alabilir miyim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941238
					]
				},
				{
					"id": 732941238,
					"content": "#Tat algında bir sorun olmadığına emin misin {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941239,
					"content": "Hahaha, cimrilik etmek gibi olmasın ama daha bir süre Sumeru'da olacağım. O nedenle birazını kendime saklamam lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941240
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732941230,
					"content": "Daha çok beklersin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941231
					]
				},
				{
					"id": 732941231,
					"content": "Hımm... Ama çay tek başına gitmiyor ki, bir şey eksik sanki, anlatabildim mi? Çabucak bir şeyler hazırlayalım işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941215,
					"content": "Çizim tahtasını çalınmasın diye koruyor olabilir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941216
					]
				},
				{
					"id": 732941216,
					"content": "Ama biz bulur bulmaz kaçtı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732941207,
					"content": "(Burnuma şarap kokusu gelmedi...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732941208
					]
				},
				{
					"id": 732941208,
					"content": "(Genel olarak böyle biri mi acaba? Biraz baş ağrıtan birine benziyor...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732941244
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}