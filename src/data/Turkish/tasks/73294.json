		{
			"id": 7329405,
			"completionStepIds": [
				7329405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329405",
							"2"
						],
						"stepId": 7329405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732940501,
					"content": "Ne basit bir kamp... Paimon buna kamp denir mi bilemedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940502,
					"content": "Yani, manzara gayet hoş, üstelik insan sahile gidince içine bir ferahlık doluyor. Fontaine'deki günlerimden çok daha rahatlatıcı açıkçası.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940503
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940503,
					"content": "Orada nasıl bir hayat yaşıyordun ya? Paimon... Meşhur bir sanatçıdan bunu duymayı beklemiyordu hiç.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940504,
					"content": "Ben Fontaine'de çok küçük bir yerde yaşıyordum... Şey, yani çok mütevazı olduğumdan dolayı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940505
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940505,
					"content": "Ama yaban maceracılarının kampları bile buraya kıyasla malikane sayılır. Hı? Bu... Hayvan dostun mu var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940506,
					"content": "Şey, hayvan dostum yok. Bir maceracı falan bırakmış sanırım. Konusu açılmışken...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940507
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940507,
					"content": "Sizi daha iyi şartlarda karşılamayı çok isterdim, ama salım parçalanınca valizimdeki eşyaların çoğu suya düştü. Malum ben de yüzme bilmiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940508
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940508,
					"content": "Kayıp valizimi bulabilirseniz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940509
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940509,
					"content": "O kadar ıslandıktan sonra kullanılır halde olacak mı ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940510
					]
				},
				{
					"id": 732940510,
					"content": "Her şeyi özenle sarmıştım, ama bazıları... *iç çeker* Neyse, kaybettiysem kaybetmişimdir. Tekrar çizebilirim... Evet, tekrar çizebilirim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940511
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940511,
					"content": "#Hım, belki de yardım etsek iyi olur {NICKNAME}. Adam zor bir durumda kalmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940512,
					"content": "Burada güvenebileceğim başka kimse yok, yardım isteyebileceğim bir siz varsınız. Ben burada güzel bir çay demleyip sizi bekleyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julien"
				}
			]
		},
		{
			"id": 7329410,
