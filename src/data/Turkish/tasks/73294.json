			},
			"dialogs": [
				{
					"id": 732940101,
					"content": "Of...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940102
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940102,
					"content": "#Durumu pek iyi görünmüyor... Açlıktan kırılmış olmalı! Yanımızdaki yemeklerden verelim mi {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940103,
						732940105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940103,
					"content": "Bu yemek ona güç verir umarım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940104
					]
				},
				{
					"id": 732940104,
					"content": "Taraflı görünmek gibi olmasın ama Paimon senin çok iyi yemek yaptığını düşünüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940107,
					"content": "Baygın adama Teyvat Usulü Yumurta veriyorsunuz.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732940108
					]
				},
				{
					"id": 732940108,
					"content": "Hayat... Hayattayım! Yaşıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940109
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940109,
					"content": "Vay be, cidden açlıktan kırılmış. Bir tanecik yumurta yedi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940110,
					"content": "Ah, kelimelere sığmayan bu lezzet ölüyü bile diriltir! Sahanda yumurtanın böylesi muhteşem bir tadı olabileceğini bilsem şu adamdan o gizemli yumurtayı satın alırdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940111
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940111,
					"content": "Ne gizemli yumurtası?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940112,
					"content": "Yediğinde yumurtanın seni bir gün boyunca bahtsızlığa karşı koruduğu söyleniyor. Bir tane alsaydım keşke... Ya da on ikili kutu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940113
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940113,
					"content": "Iı, kulağa çok şüpheli geldi. Paimon dolandırıcılık gördüğünde anlar. Neyse, ne oldu da buraya geldin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940114,
					"content": "Şöyle ki... Fontaineli meşhur bir sanatçıyım ben. Sumeru'ya da eserlerim için ilham aramaya geldim. Adım Julien.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940115,
						732940117
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940115,
					"content": "İlham mı? Burada mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940116
					]
				},
				{
					"id": 732940116,
					"content": "Evet. İlham alınacak daha uygun yerler yok mu? Hani daha güzel manzaralı ve daha güvenli yerler mesela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940119,
					"content": "Ayrıca Fontaineli bir sanatçıysan elin niye boş? Fatui'ye çalışan bir köstebek misin yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940120,
					"content": "Ne kadar aşırı bir düşünce yapısı bu? Hatta o kadar aşırı ki böyle düşünecek ne olaylar yaşadığınızı merak ediyor insan! Lakin ben yalnızca ve yalnızca bir sanatçıyım maalesef.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940121
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940121,
					"content": "Neyse... Burada yeterince ilham topladım aslında, Fontaine'e dönmeye hazırlanıyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940122
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940122,
					"content": "Sumeru'nun havasının bu kadar kuru olmasını beklemiyordum! Chenyu Vadisi'nin havası bile buraya göre daha nemliydi. Ben daha sınırdan geçer geçmez kum fırtınaları başladı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940123
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940123,
					"content": "Daha nemli iklimlere alışık olduğumu belirtmeliyim, bu nedenle farklı manzaralar görebilmek amacıyla Fontaine'e su yoluyla dönmeyi planlıyordum. Ne yazık ki bindiğim sal alabora oldu, ben de yüzmeyi bilmiyorum. Öyle işte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940124
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940124,
					"content": "Yüzme bilmiyorsan Fontaine'de hayatın zor olmalı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940125
					]
				},
				{
					"id": 732940125,
					"content": "Doğrudur, tabii yüzme bilmemekle ilgili değil yalnızca... *iç çeker* Boş verin. Su kenarında dinlenecek bir yer ve kuru çay yaprakları buldum. Müsaade ederseniz size teşekkür edeyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940126
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940126,
					"content": "Bizi çay içmeye mi davet ediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940127,
					"content": "Ha, tabii ki, tabii ki! Sahanda yumurta hediyenize olan minnettarlığımı göstermeliyim ne de olsa. Size nasıl hitap edeyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940128
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940128,
					"content": "Aa doğru, Paimon kendimizi tanıtmayı unuttu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940129,
						732940130,
						732940132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940129,
					"content": "#Ben {NICKNAME}, bu da Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940134
					]
				},
				{
					"id": 732940134,
					"content": "Ah, ne kadar muazzam isimler. Her neyse, gelin çayımı için. Kampım yakında. Hatta geldik sayılır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julien"
				},
				{
					"id": 732940130,
					"content": "Adaletin elçisi ve onun refakatçisi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940131
					]
				},
				{
					"id": 732940131,
					"content": "#Biz {NICKNAME} ve en süper yol arkadaşı Paimon'uz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940132,
					"content": "Bize Altın Parıltı ve Gümüş Işıltı diyebilirsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940133
					]
				},
				{
					"id": 732940133,
					"content": "#Biz Altın Parıltı {NICKNAME} ve Gümüş Işıltı Paimon'uz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940117,
					"content": "Kendine \"meşhur\" der mi insan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940118
					]
				},
				{
					"id": 732940118,
					"content": "Bence de!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732940105,
					"content": "Ee, o sen değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732940106
					]
				},
				{
					"id": 732940106,
					"content": "Aşk olsun! Herkes hayatında bir kere de olsa açlıktan bayılmıştır, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732940107
					],
					"speakerTitle": "Paimon"
				}
			]
		},
