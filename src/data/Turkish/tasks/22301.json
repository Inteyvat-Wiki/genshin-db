							"22301"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Çay Ustası Liu Su"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223015201,
					"content": "... Guhua öğrencisi, dövüş sanatlarında ustaydı. Özel kılıç hareketi yarıda kesildiği için savunmasız hale düştü ve kendini korumak için hızla kabzasını kaldırıp birkaç adım geriye çekildi. Geriye doğru tökezlediğinde dengesini korumakta zorlanmış olsa da, kendi gizli silahından üç atış yapabilmişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015202
					],
					"speakerTitle": "Çay Ustası Liu Su"
				},
				{
					"id": 223015202,
					"content": "Ama tekrar saldırmak üzere hazırlanamadan, silahsız kalan rakibin iyice doğrulduğunu ve beline davrandığını gördü. Bileğiyle bir ani hamle daha yaptı ve elinde bir talim kılıcı belirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015203
					],
					"speakerTitle": "Çay Ustası Liu Su"
				},
				{
					"id": 223015203,
					"content": "Guhua öğrencisinin geriye doğru tökezlediğini gören rakibin yüzünde tehditkar bir gülüş belirdi. Saldırıya geçti, dövüşte üstün gelmeye başladı. Guhua öğrencisi hazırlıksız yakalanmış ve kendisini savunmakta zorlanıyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015204
					],
					"speakerTitle": "Çay Ustası Liu Su"
				},
				{
					"id": 223015204,
					"content": "Savunmaya geçen Guhua öğrencisi, rakibiyle kılıç çarpıştırırken yorgun düşmüştü. Aniden yüksek bir çınlama sesiyle rakibi kılıcı elinden düşürmüş ve rakibin güçlü yumruğu tam göğsüne oturmadan önce karşılık verecek zaman bulamamıştı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015205
					],
					"speakerTitle": "Çay Ustası Liu Su"
				},
				{
					"id": 223015205,
					"content": "Guhua öğrencisi tekrar geriye doğru sendeledi. Bu defa kılıcının yere düşme sesi duyulmuştu. Rakibi, yüzündeki kendini beğenmiş ifadesiyle ve tatmin olmuş bir duyguyla kılıcını öğrencinin kafasına götürdü... Rakibin bu hamleyle birlikte, öğrencinin canını alarak işleri bitirmeye niyetli olduğu şüphesizdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015206
					],
					"speakerTitle": "Çay Ustası Liu Su"
				},
				{
					"id": 223015206,
					"content": "Ancak Guhua öğrencisi kafasını kaldırdı ve rakibine parmağını sallayarak kahkahalara \"Gerçekten iyi dövüştü! Cidden iyiydi. Ama tam da şimdi kaybedeceksin...\" dedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Çay Ustası Liu Su"
				}
			]
		},
