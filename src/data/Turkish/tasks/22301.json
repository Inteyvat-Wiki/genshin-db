				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Çay Ustası Liu Su"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223015101,
					"content": "... Guhua'nın genç öğrencisi kılıcını, ağaçların arasından esip geçen bir rüzgar çabukluğuyla savurdu. Art arda sayısız kılıç darbesini kusursuzca sıraladı, sanki binlerce yağmur damlası birleşerek bir gölet oluşturmuştu. Kendisinden iri olan rakibinin gözüne, yalnızca genç öğrencinin arada güneş ışığında parlayan kılıcı çarpıyordu. Öğrenci dağı parçalarken yoluna çıkan her şeye hükmetmeye hazırdı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015102
					],
					"speakerTitle": "Çay Ustası Liu Su"
				},
				{
					"id": 223015102,
					"content": "Rakip, birdenbire elinde bir acı hissetti. Kılıcı artık kendisinden uzakta yerde duruyordu, çünkü Guhua öğrencisinin çevik kılıç hareketleriyle elinden sökülüp atılmıştı. Bu ani ve bariz yenilgiye öfkelenen rakip, dövüş başlamadan pes etmeye hiç niyetli değildi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015103
					],
					"speakerTitle": "Çay Ustası Liu Su"
				},
				{
					"id": 223015103,
					"content": "Rakip, Guhua öğrencisinin kusursuz bir darbe yaptıktan sonra soluklanmak için duraksadığını gördü. Aniden, rakibin elindeki gizli silah koyu yeşil parlamaya başladı ve bir bilek hareketiyle elinden üç buz ışını fırlayarak Guhua öğrencisinin yüzüne doğru gitti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015104
					],
					"speakerTitle": "Çay Ustası Liu Su"
				},
				{
					"id": 223015104,
					"content": "Rakibin acımasız misillemesini tetikleyen neydi? Dahası, Guhua öğrencisine ne olacaktı? Tüm bunlar Guhua Klanının kaderini nasıl etkileyecekti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Çay Ustası Liu Su"
				}
			]
		},
		{
			"id": 2230152,
			"completionStepIds": [
				2230152
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
