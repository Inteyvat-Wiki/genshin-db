			"dialogs": [
				{
					"id": 223011101,
					"content": "İhtiyar Liu gerçekten çok duygusal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011102
					],
					"speakerTitle": "Fan Er'ye"
				},
				{
					"id": 223011102,
					"content": "Daha önce hiç Liu Su'nun hikayelerini dinledin mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223011103
					]
				},
				{
					"id": 223011103,
					"content": "İhtiyar Liu'dan mı bahsediyorsun? Onun anlattığı hikayelerin eşi benzeri yoktur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011104
					],
					"speakerTitle": "Fan Er'ye"
				},
				{
					"id": 223011104,
					"content": "En son onu dinlemeye gittiğimde <color=#00E1FFFF>Haishan'ın Gazabı'nı</color> anlatıyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011105
					],
					"speakerTitle": "Fan Er'ye"
				},
				{
					"id": 223011105,
					"content": "Hikaye tüm şiddetiyle esen fırtınanın ortasında başlıyor. Uğuldayan rüzgarlar, kıyıyı yalayan koca dalgalar, fırtına, gök gürültüsü ve kader. Güneyhaçı bastırmaya devam ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011106
					],
					"speakerTitle": "Fan Er'ye"
				},
				{
					"id": 223011106,
					"content": "Donanmanın başında, pruvada tüm haşmetiyle elinde kılıcıyla duran biri var. Bu, Güneyhaçı'nın kaptanı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011107
					],
					"speakerTitle": "Fan Er'ye"
				},
				{
					"id": 223011107,
					"content": "Kaptan, dalgaların yükselerek gökyüzünü kaplayışını ve bu devasa gölgelerin okyanusun karanlık derinliklerinden uğultuyla yükselişini izliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011108
					],
					"speakerTitle": "Fan Er'ye"
				},
				{
					"id": 223011108,
					"content": "İşte ihtiyar Liu tam bu noktada durup hikayenin kalanını sonraki kısımda anlatacağını söylüyor. Umarım anlatır! Şimdiye kadar hikayeyi bu kadar heyecanlı yerde kesen kimseyi görmedim ben. Günlerdir bekliyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fan Er'ye"
				}
			]
		},
