				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Çay Ustası Liu Su"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223010101,
					"content": "Keşke nerede kaldığımı hatırlayabilsem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010102
					],
					"speakerTitle": "Çay Ustası Liu Su"
				},
				{
					"id": 223010102,
					"content": "Sorun ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010103
					]
				},
				{
					"id": 223010103,
					"content": "Merhaba! Hikaye saati için mi geldin, yoksa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010104
					],
					"speakerTitle": "Çay Ustası Liu Su"
				},
				{
					"id": 223010104,
					"content": "Ben mi? Ben hikayeciyim. Cep harçlığı çıkarmak için hikaye anlatıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010105
					],
					"speakerTitle": "Çay Ustası Liu Su"
				},
				{
					"id": 223010105,
					"content": "Sorun şu ki, çok fazla hikaye anlatıp sürekli bunlar arasında geçiş yaptığım için bir şeyleri karıştırıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010106
					],
					"speakerTitle": "Çay Ustası Liu Su"
				},
				{
					"id": 223010106,
					"content": "Örneğin geçen gün kalabalığın bir kısmı Güneyhaçı hikayesi \"Haishan'ın Gazabı\"nı anlatmam için tezahürat ederken, diğerleri de Guhua klasiklerinden \"Kılıç Yağmuru Efsanesi isteriz!\" diye bağırıyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010107
					],
					"speakerTitle": "Çay Ustası Liu Su"
				},
				{
					"id": 223010107,
					"content": "Sonuçta benim de ekmeğimi çıkarmam gerek, değil mi? Bu nedenle herkes mutlu olsun diye iki hikayeden de en iyi hatırladığım kısımları seçtim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010108
					],
					"speakerTitle": "Çay Ustası Liu Su"
				},
				{
					"id": 223010108,
					"content": "Beklenmedik bir başarıydı... O kadar çok sevdiler ki, hikayenin geri kalanını anlatmam için beni sıkıştırıp durdular!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010109
					],
					"speakerTitle": "Çay Ustası Liu Su"
				},
				{
					"id": 223010109,
					"content": "Kitapların ikisini de yıllardır okumamıştım. Etrafı biraz kurcalayınca kitapları buldum. Hafızamı tazelemek için şöyle bir göz gezdirdim ve şimdi hikayeye devam etmeye hazır sayılırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010110
					],
					"speakerTitle": "Çay Ustası Liu Su"
				},
				{
					"id": 223010110,
					"content": "Ancak... İki hikayede de nerede kaldığımı bir türlü hatırlayamıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010111
					],
					"speakerTitle": "Çay Ustası Liu Su"
				},
				{
					"id": 223010111,
					"content": "Kalabalığa sorup hikayelerde en son nerede kaldığımı hatırlayan var mı, öğrenir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010112,
						223010114
					],
					"speakerTitle": "Çay Ustası Liu Su"
				},
				{
					"id": 223010112,
					"content": "Tamam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010113
					]
				},
				{
					"id": 223010113,
					"content": "Hayatımı kurtardın! Zor bir iş olduğunu biliyorum ama bunu kendim sorsam, hikayecilik kariyerimi sonlandırmış olurdum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010118
					],
					"speakerTitle": "Çay Ustası Liu Su"
				},
				{
					"id": 223010118,
					"content": "Şimdi düşününce, sorabileceğin üç kişi var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010119
					],
					"speakerTitle": "Çay Ustası Liu Su"
				},
				{
					"id": 223010119,
					"content": "İlk kişi <color=#00E1FFFF>Soylu Maocai</color>. Hikaye saatlerini hiç kaçırmıyor. İkincisi <color=#00E1FFFF>Fan Er'ye</color>, kendisi bu çay dükkanının patronu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010120
					],
					"speakerTitle": "Çay Ustası Liu Su"
				},
				{
					"id": 223010120,
					"content": "Üçüncüsü Bayan <color=#00E1FFFF>Jiangzhou</color>. Geçen defa durup dinlediğini gördüğüme eminim ama sanırım hikayenin sonu gelmeden gitmişti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Çay Ustası Liu Su"
				},
				{
					"id": 223010114,
					"content": "Hikayelere baştan başlasan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010115
					]
				},
				{
					"id": 223010115,
					"content": "Onu da düşündüm! İnsanlardan aynı hikaye için tekrar ücret almak gibi geldi bana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010116
					],
					"speakerTitle": "Çay Ustası Liu Su"
				},
				{
					"id": 223010116,
					"content": "Ama Fan Er'ye bunu yanıma kar bırakmazmış gibi hissediyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010117
					],
					"speakerTitle": "Çay Ustası Liu Su"
				},
				{
					"id": 223010117,
					"content": "Acaba bir soruşturur musun? Nerede kaldığımı bulduğunda bana da söyle ki hikayeye nasıl devam edeceğimi düşüneyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010118
					],
					"speakerTitle": "Çay Ustası Liu Su"
				}
			]
		},
