					"Soylu Maocai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223011401,
					"content": "Bu Dr. Liu cidden sinir bozucuymuş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011402
					],
					"speakerTitle": "Soylu Maocai"
				},
				{
					"id": 223011402,
					"content": "Daha önce hiç Liu Su'nun hikayelerini dinledin mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223011403
					]
				},
				{
					"id": 223011403,
					"content": "Elbette. Ama Dr. Liu beni sinir ediyor! Kendisini en son Heyu Çayevinde dinlemeye gitmiştim. <color=#00E1FFFF>Kılıç Yağmuru Efsanesi'ni</color> anlatıyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011404
					],
					"speakerTitle": "Soylu Maocai"
				},
				{
					"id": 223011404,
					"content": "Tam da Guhua Klanının düşüşte olduğu kısma gelmişti. Guhua'nın kendi öğrencileri sinek gibi bir bir düşerken, gelen dövüş sanatı ustaları Guhua sahasında ustaya meydan okumuştu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011405
					],
					"speakerTitle": "Soylu Maocai"
				},
				{
					"id": 223011405,
					"content": "Sonuna kadar dayanabilen birkaç öğrenci okulu savunabilmeyi ummuştu ama nafile. Guhua Klanı yenilgi ardına yenilgi alıyordu ve sonunda hatta biri Guhua tabelasını bile kırmıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011406
					],
					"speakerTitle": "Soylu Maocai"
				},
				{
					"id": 223011406,
					"content": "Guhua Klanının ustası, artık umut kalmadığını düşünüyordu. Okuldan ayrılıp hayatının kalanını inzivada geçirmeye hazırlanıyordu ama tam çıkacakken genç bir kılıç ustası okul kapısından içeri girdi. Kılıcını kimsenin görmediği bir ustalıkla kullanan mucizevi biriydi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011407
					],
					"speakerTitle": "Soylu Maocai"
				},
				{
					"id": 223011407,
					"content": "... Ve hikayeyi kesebileceği onca yer varken, tuttu tam da orada kesti! \"Devamı sonraki kısımda açıklığa kavuşacak.\" dedi... Bu gerilim beni öldürüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011408
					],
					"speakerTitle": "Soylu Maocai"
				},
				{
					"id": 223011408,
					"content": "Aha da buraya yazıyorum, bu adamı sonraki görüşümde hikayenin nasıl çözümlendiğini anlatmadan bırakmayacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soylu Maocai"
				}
			]
		},
