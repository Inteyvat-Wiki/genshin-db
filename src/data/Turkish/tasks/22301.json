			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Çay Ustası Liu Su"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223015401,
					"content": "... Simsiyah fırtına bulutları gökyüzünü sarmalarken donanmanın üzerinde devasa dalgalar belirdi. Artık Güneyhaçı'nın korkmak için bir nedeni vardı. Deniz üzerinde yelken açmış en iyi gemilere ve dümen başında durabilecek en iyi tayfaya sahip olsalar da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015402
					],
					"speakerTitle": "Çay Ustası Liu Su"
				},
				{
					"id": 223015402,
					"content": "... Doğa ana bastırdığı öfkesini açığa çıkardığında, en büyük gemiler bile suyun yüzeyinde oradan oraya savrularak okyanusun oyuncağı haline gelir. Bu gazap dolu dalgalar daha küçük gemilerle buluştuğunda, bu gemileri şiddetli bir şekilde hiçliğin derinliklerine gömer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015403
					],
					"speakerTitle": "Çay Ustası Liu Su"
				},
				{
					"id": 223015403,
					"content": "Ama dertlerin en büyüğü henüz başa gelmemişti. Kule gibi yükselmiş dalgaların içinden gözleri kor gibi yanan devasa bir canavar belirmişti. Dehşete düşen denizciler, canavarın gözüne bakmaya cüret edemeyerek Toprağın Efendisi'nin kendilerini kurtarması çaresizlik içinde için haykırmaya başladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015404
					],
					"speakerTitle": "Çay Ustası Liu Su"
				},
				{
					"id": 223015404,
					"content": "Ancak en öndeki geminin pruvasında korkusuzca dikilen ve kılıcına yaslanan biri duruyordu. Bu kahraman kişi, öfkeli sulara ve suyun yüzeyinde dağ gibi yükselen devasa canavara bakarak, güler bir yüzle parmağını salladı ve \"Yakaladım seni! Bu defa beni epey uğraştırdın ama!\" diye bağırdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223015405
					],
					"speakerTitle": "Çay Ustası Liu Su"
				},
				{
					"id": 223015405,
					"content": "Bu kahraman kimdi? Devasa canavar neyin nesiydi? Peki aralarındaki bu düşmanlık nereden gelmekteydi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Çay Ustası Liu Su"
				}
			]
		},
