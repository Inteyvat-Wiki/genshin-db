				"points": []
			},
			"dialogs": [
				{
					"id": 223011701,
					"content": "*iç çeker* Keşke daha fazla boş vaktim olsa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011702
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 223011702,
					"content": "Daha önce hiç Liu Su'nun hikayelerini dinledin mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223011703
					]
				},
				{
					"id": 223011703,
					"content": "Hangi Liu? Liu Su mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011704
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 223011704,
					"content": "Evet, şimdi hatırladım. Geçenlerde durup biraz dinlemiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011705
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 223011705,
					"content": "Pek bir şey hatırlamıyorum. Sanırım hikayenin adı <color=#00E1FFFF>Kılıç Yağmuru Efsanesi</color> gibi bir şeydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011706
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 223011706,
					"content": "Her neyse, bir sebepten ötürü Guhua Klanı zor durumdaydı ve bu büyük olay onları iyice zorlayacaktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011707
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 223011707,
					"content": "Ama hikaye başladıktan çok sonra oraya varmıştım, yani nasıl bu noktaya geldiğini sorma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011708
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 223011708,
					"content": "Ancak... İyi adam kazanmak üzereyken birden biri ona saldırdı. Artık köşeye sıkışmış durumdaydı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011709
					],
					"speakerTitle": "Jiangzhou"
				},
				{
					"id": 223011709,
					"content": "Sonrasında da işten çağırdılar beni. Akabinde ne olacağını dinlemeyi çok isterdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangzhou"
				}
			]
		},
