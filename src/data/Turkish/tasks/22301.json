				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223010401,
					"content": "Ah, hâlâ buradasın! Haha. Sence nasıldım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010402,
						223010405
					],
					"speakerTitle": "Çay Ustası Liu Su"
				},
				{
					"id": 223010402,
					"content": "Devamında ne olacak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010403
					]
				},
				{
					"id": 223010403,
					"content": "*cık* Hem \"Haishan'ın Gazabı\" hem de \"Kılıç Yağmuru Efsanesi\" oldukça uzun metinler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010404
					],
					"speakerTitle": "Çay Ustası Liu Su"
				},
				{
					"id": 223010404,
					"content": "Önümüzdeki birkaç saati, sana hikayelerin devamını anlatarak geçirmeyeceğim tabii. İlgini çektiyse, daha sonraki hikaye saatlerine gelebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010407
					],
					"speakerTitle": "Çay Ustası Liu Su"
				},
				{
					"id": 223010407,
					"content": "Yardımın için teşekkür ederim. Al bakalım, uğraşlarının karşılığı. Umarım sonraki hikaye saatlerine de gelirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Çay Ustası Liu Su"
				},
				{
					"id": 223010405,
					"content": "\"Her şey sonraki bölümde açıklığa kavuşacak...\" demiştin sanki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010406
					]
				},
				{
					"id": 223010406,
					"content": "Hahaha... Kavuşacak tabii! Gelip sonraki bölümü dinlemen gerek... Bir de ondan sonrakini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010407
					],
					"speakerTitle": "Çay Ustası Liu Su"
				}
			]
		},
		{
			"id": 2230105,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
