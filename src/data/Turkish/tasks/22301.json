			},
			"dialogs": [
				{
					"id": 223010201,
					"content": "Geri gelmişsin. Harikasın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010202
					],
					"speakerTitle": "Çay Ustası Liu Su"
				},
				{
					"id": 223010202,
					"content": "Ne kadar hikaye anlatırsam, o kadar çok şey unuttuğum gerçeğini değiştiremiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010203
					],
					"speakerTitle": "Çay Ustası Liu Su"
				},
				{
					"id": 223010203,
					"content": "Dinleyicilere sordun mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Çay Ustası Liu Su"
				}
			]
		},
		{
			"id": 2230104,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
