			"dialogs": [
				{
					"id": 1903201201,
					"content": "Off... Pestilim çıktı. Sonunda, mola zamanı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201202
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201202,
					"content": "*iç çeker* Çok mu ileri gittim acaba? Birkaç kişi korkudan aklını yitirmiş gibiydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201203
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201203,
					"content": "Kimsin sen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201204
					]
				},
				{
					"id": 1903201204,
					"content": "Hey, ne işin var senin burada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201205
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201205,
					"content": "*iç çeker* Neyse. Beni yine de duyduğunu varsayıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201206
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201206,
					"content": "Burada bir hayalet olarak çalışıyorum ama şu an moladayım, bu yüzden de kostümümü çıkarttım. Kostüm acayip sıcak ve çok havasız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201207,
						1903201208
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201207,
					"content": "Yani burada gerçek hayalet yok mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201209
					]
				},
				{
					"id": 1903201209,
					"content": "Tabii ki, burada gerçek bir hayalet nasıl olabilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201210
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201210,
					"content": "Kimse gerçek bir hayalet görmek istemez. Ne biz, ne de bu etkinliğe katılanlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201211
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201211,
					"content": "Buraya sadece atmosferi yaşamak için gelirler... Herkes bu heyecan coşkusunu tatmak ister.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201212
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201212,
					"content": "İnsanlar korktukları bir duruma düştüklerinde, normalde asla cesaret edemeyecekleri şeyler söylerler. Cesaret Sınavının bütün olayı da budur zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201213,
						1903201214
					],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201213,
					"content": "Sanırım anladım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201215
					]
				},
				{
					"id": 1903201215,
					"content": "*iç çeker* Tamam... Artık işime dönmeliyim. Umarım sen ve beraberinde kimi getirdiysen, hepiniz eğlenmişsinizdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhouliang"
				},
				{
					"id": 1903201214,
					"content": "(Chongyun çok büyük hayal kırıklığına uğrayacak.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201215
					]
				},
				{
					"id": 1903201208,
					"content": "Hepsi insanları korkutmak için mi planlandı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201209
					]
				}
			]
		}
	]
