					"Araminali"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000101,
					"content": "#Nara {NICKNAME} \"hazine sandığını\" açmak mı istiyor? Ama Vana'da hâlâ yardıma ihtiyaç duyan bir sürü Aranara var. Altın Nara o Aranaralara yardımcı olabilirse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000102
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000102,
					"content": "Araminali \"hazine sandıklarını\" hazineyle dolduracak! İçine Aranimba'nın gönderdiği \"güzel şeylerden\" de koyacak. \"Hazine sandıkları\" birbirinden güzel şeylerle dolu olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araminali"
				}
			]
		},
		{
			"id": 7310002,
			"completionStepIds": [
				7310014
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
