			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Araminali"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000301,
					"content": "#Araminali, Nara {NICKNAME} Vana'da \"marifetleriyle şov yapmış\" diye duydu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000302
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000302,
					"content": "#\"Hazine\", \"sandığa\" koyuldu. Nara {NICKNAME} artık \"hazine sandığını\" açabilir, \"rica ederim\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araminali"
				}
			]
		},
		{
			"id": 7310004,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310014",
							"3"
						],
						"stepId": 7310014,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_GREATER",
						"rawParams": [
							"73100",
							"32"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Araminali"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000401,
					"content": "#Nara {NICKNAME}, Paimon! Acele edin! Araminali'nin hazine sandıkları hazır ve Araminali çok uzun zamandır bekliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000402
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000402,
					"content": "Aranaraların dostları. \"Hazine sandıkları\" doldu ve onları açma vakti geldi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araminali"
				}
			]
		},
		{
			"id": 7310005,
			"completionStepIds": [
				7310015
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310015",
							"2"
						],
						"stepId": 7310015,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Araminali",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000501,
					"content": "#Birçok Aranara, Araminali'ye Nara {NICKNAME} ve Paimon'un nice güzel şeyler yaptığını anlattı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000502
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000502,
					"content": "Araminali bunu zaten biliyordu. O övgü sözleri ormandaki dalların arasından geçti, damla olup damladı, rüzgara katılıp esti ve Araminali'nin \"mutlu yuvasına\" doldu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000503
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000503,
					"content": "#O yüzden bu kez Araminali \"sandıkları\" doldurdu ve Nara {NICKNAME} açsın diye bekledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000504
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000504,
					"content": "#Aranimba'nın yanında getirdiği parlak şeyler de \"sandıklara\" dolduruldu. Belki de Nara {NICKNAME} onları sever?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000505
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000505,
					"content": "Aranimba geri dönmedi mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731000506
					]
				},
				{
					"id": 731000506,
					"content": "Derin kökleri olan büyük bir ağacın aksine, Aranimba yerinde hiç durmayan bir Aranaradır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000507
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000507,
					"content": "Araminali burada yalnızlık çekmeyecek mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731000508,
					"content": "\"Yalnızlık\" ne demek?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000509
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000509,
					"content": "Yani, şey... Tek başına kaldığın zaman yanında birisi olsun istersin ya. Öyle bir şey.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731000510,
					"content": "Vanarana'da bir sürü Aranara dolu. Araminali bu yüzden hiç \"yalnızlık\" çekmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000511
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000511,
					"content": "Lafı açılmışken söyleyeyim, Arayama ve Aranimba artık Vanarana'da değil. Bu üç Aranara birbirinin yanından hiç ayrılmazdı ve ne yaparlarsa yapsınlar çok mutlulardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000512
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000512,
					"content": "Arayama'nın Ararakalarisi çok güçlü. Güçsüz Nara bu konuda hiçbir şey yapamaz. Aranimba resim çizmekte çok iyi, her şeyi çizer ve hepsi çok güzel görünür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000513
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000513,
					"content": "Oysa artık burada sadece Araminali ve onun \"hazine sandığı\" var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000514
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000514,
					"content": "Araminali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731000515,
					"content": "Sorun yok. Araminali'de bir sürü \"hazine sandığı\" var. Gerçi Araminali, Naraların sandık açmayı neden bu kadar sevdiğini hiç bilmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000516
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000516,
					"content": "Ama Araminali \"hazine sandıklarının\" sahibi. Hazine sandıklarını seven Nara, Araminali'yi de seviyordur değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000517
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000517,
					"content": "Yine de Araminali'de daha fazla \"hazine\" kalmadı. Yani \"sandıkları\" bir süre boş kalacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731000518
					],
					"speakerTitle": "Araminali"
				},
				{
					"id": 731000518,
					"content": "#Araminali'nin \"hazine sandığı\" neredeyse boş ama Nara {NICKNAME} hâlâ Aranaranın dostu olmaya devam edecek değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araminali"
				}
			]
		},
