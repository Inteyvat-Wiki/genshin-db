				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Araminali"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731000201,
					"content": "#Araminali, Altın Naranın Aranaralara yardım eden iyi Nara olduğunu biliyor. Bu yüzden, Araminali'nin \"hazine sandıkları\" Nara {NICKNAME} için ayrıldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araminali"
				}
			]
		},
		{
			"id": 7310003,
			"completionStepIds": [],
