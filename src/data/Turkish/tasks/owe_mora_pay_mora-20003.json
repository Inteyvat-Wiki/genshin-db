					],
					"speakerTitle": "Wyratt"
				},
				{
					"id": 200031005,
					"content": "Genelde buraya gelip bazı metinler hakkında bir şeyler sorar. Bütün gününü bir şeyler okuyarak geçirir, buranın müdavimidir kendisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200031006
					],
					"speakerTitle": "Wyratt"
				},
				{
					"id": 200031006,
					"content": "Yine de bir süredir buraya uğradığını görmedim. Onu burada bulabileceğinizi sanmıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200031007
					],
					"speakerTitle": "Wyratt"
				},
				{
					"id": 200031007,
					"content": "Biraz geciktik sanırım.",
