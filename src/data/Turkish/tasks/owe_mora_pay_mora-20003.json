			},
			"dialogs": [
				{
					"id": 200030101,
					"content": "*iç çeker* Sanırım bu işi kendi başıma çözmek zorundayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030102
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030102,
					"content": "Of, yaşlı bedenim buna daha fazla dayanamaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030103
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030103,
					"content": "Acil bir durum mu var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030104
					]
				},
				{
					"id": 200030104,
					"content": "Seni görmeyi beklemiyordum Gezgin. \"Acil\" olmasa da işin çığırından çıktığı kesin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030105
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030105,
					"content": "Bildiğin üzere Fatui otelimdeki bütün odaları rezerve etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030106
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030106,
					"content": "Yine bildiğin gibi Goth Grand Otelin sahibi olarak ben de onlarla ilgilenmek zorundayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030107
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030107,
					"content": "Bunun yanı sıra yemek servisini, tamirat işlerini ve diğer işleri de yönetiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030108
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030108,
					"content": "Son zamanlarda bazı odalarımızdaki mobilyalar zarar gördü. Marangozlara uygun kütük getirmesi için görüşülmesi gereken kişilerle de görüştüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030109
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030109,
					"content": "Daha kiralarının toplanması gereken birkaç daire de var. Oğlum Marvin'i ise hiçbir yerde bulamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030110
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030110,
					"content": "*iç çeker* Bu kadar şeye daha ne kadar dayanabilirim ya da oğlumun aklı başına ne zaman gelir bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030111,
						200030112
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030111,
					"content": "Size yardım edeceğim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030113
					]
				},
				{
					"id": 200030113,
					"content": "Yardım etmek mi istiyorsun? Şükürler olsun... *iç çeker* Keşke oğlum da senin gibi aklı başında biri olsaydı. Benim için her şey daha kolay olurdu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200030114
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030114,
					"content": "O zaman benim için biraz Köknar Kütüğü ve Huş Ağacı Kütüğü toplar mısın? Onları en kısa süre içerisinde marangozlara göndermem gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Goth"
				},
				{
					"id": 200030112,
					"content": "İsterseniz önce biraz dinlenin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200030113
					]
				}
			]
		},
