			"dialogs": [
				{
					"id": 200280101,
					"content": "Teşekkürler efendim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280102
					],
					"speakerTitle": "Korkak Morrow"
				},
				{
					"id": 200280102,
					"content": "Mesleğim avcılık olmasına rağmen bu kahrolası bodurloplar beni bayağı zorladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280103
					],
					"speakerTitle": "Korkak Morrow"
				},
				{
					"id": 200280103,
					"content": "Onların yüzünden bu avdan elim boş dönüyorum. Hiçbir şey yakalayamadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280104
					],
					"speakerTitle": "Korkak Morrow"
				},
				{
					"id": 200280104,
					"content": "Umarım diğer avcılar benim kadar talihsiz değildir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280105
					],
					"speakerTitle": "Korkak Morrow"
				},
				{
					"id": 200280105,
					"content": "Bodurloplardan falan bahsetmişken... Benim için bir etrafı kolaçan eder misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280106
					],
					"speakerTitle": "Korkak Morrow"
				},
				{
					"id": 200280106,
					"content": "Hayal görüyor da olabilirim ama... Bu kasabanın etrafına gitgide daha fazla bodurlop toplanıyor sanki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280107
					],
					"speakerTitle": "Korkak Morrow"
				},
				{
					"id": 200280107,
					"content": "Yolun ilerisinde bodurlop var mı diye bakar mısın? Herhangi bir bodurlop görürsen... Ne yapacağını biliyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280108,
						200280109
					],
					"speakerTitle": "Korkak Morrow"
				},
				{
					"id": 200280108,
					"content": "Tabii ki, zamanım var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200280110
					]
				},
				{
					"id": 200280110,
					"content": "Gerçekten çok yardımın dokunuyor. Geri dönüp Draff'a bunu bildireyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280111
					],
					"speakerTitle": "Korkak Morrow"
				},
				{
					"id": 200280111,
					"content": "Umarım çok sarhoş değildir de söylediklerim bir kulağından girip diğerinden çıkmaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Korkak Morrow"
				},
				{
					"id": 200280109,
					"content": "Üzgünüm, geri dönmem gerek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200280112
					]
				},
				{
					"id": 200280112,
					"content": "Lütfen efendim, bu, beni geçtim, Pınarköy'deki herkesin iyiliği için.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Korkak Morrow"
				}
			]
		}
	]
