			"dialogs": [
				{
					"id": 761870301,
					"content": "Bayan Sandrone, bu nazik davetiniz için Bayan Mamere adına size en içten teşekkürlerimi sunarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870302
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870302,
					"content": "Mmm, bu yiyecekler tek kelimeyle enfes. Ellerine sağlık Sandrone, mutfakta ne kadar hünerliymişsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870303
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761870303,
					"content": "Beğenmene sevindim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870304
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761870304,
					"content": "İyi de Prototip 4ACV07, yanılmıyorsam biz ilk defa karşılaşıyoruz. Beni nereden tanıdın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870305
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761870305,
					"content": "Vay canına, daha önce kimsenin Seymour'a böyle hitap ettiğini duymamıştım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870306
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761870306,
					"content": "Olumlu. O eşsiz şefkatinize ve ışıltınıza çok aşina olsam da sizi daha önce hiç kanlı canlı görmemiştim Bayan Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870307
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870307,
					"content": "Sizi tanıyabiliyorum çünkü görünüşünüz ustam Bayan Mary-Ann Guillotin'in bire bir aynısı. Onun sureti hafıza birimime kalıcı olarak kazınmış durumda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870308
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870308,
					"content": "Bayan Mary-Ann bana sizden bahsetmişti. Görünüşünüz onunkiyle aynı olduğundan, sizi tanımak için basit bir mantık yürütmem yeterli oldu Bayan Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870309
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870309,
					"content": "Hah, Alain'in ilk eseri bile muazzam. Gerçi görünüşe bakılırsa üstünde birtakım geliştirmeler yapılmış... Sanırım artık sana Seymour diye hitap etmem gerekecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870310
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761870310,
					"content": "Beni karşında görünce kafan karıştı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870311
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761870311,
					"content": "Olumsuz. Öncelikli görevim Alain Guillotin adına Bayan Mary-Ann'e eşlik edip onu korumak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870312
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870312,
					"content": "Haliyle Bayan Mary-Ann hakkında her şeyi biliyorum. Sonlu boyutlu vektör uzaylarının mantıksal analizine göre, sizinle Bayan Mary-Ann arasında dağlar kadar fark var Bayan Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870313
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870313,
					"content": "Tıpkı Chenyu Vadisi'nin çay yapraklarıyla Beril Bölgesi'nin Bulle Meyvesi arasındaki fark gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870314
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870314,
					"content": "Sandrone çay mı oluyor yoksa Bulle Meyvesi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870315
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 761870315,
					"content": "Aranıyor... Yetersiz veri. Cevap verilemedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761870316
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 761870316,
					"content": "(*iç çeker*... İyi ki Alain beni yaratana kadar dil modülü tasarımını iyice geliştirmiş.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kukla"
				}
			]
		},
