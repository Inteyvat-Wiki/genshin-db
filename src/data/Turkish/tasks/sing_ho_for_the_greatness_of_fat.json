					"Suriqui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650701,
					"content": "\"Hiç fena değil ama bana yetişmek için biraz daha çalışman lazım.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650702
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650702,
					"content": "Hafif tombul görünüyorum ama hiçbir zaman idmanımı aksatmadım. Çevikliğim ve darbe gücüm o beceriksiz çam yarmalarının çok üstünde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650703
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650703,
					"content": "Kaslı biri olma hayallerinin peşini bırak, bana katıl ve birlikte yağlı vücutları yüceltelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Suriqui"
				}
			]
		},
		{
			"id": 7516508,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
