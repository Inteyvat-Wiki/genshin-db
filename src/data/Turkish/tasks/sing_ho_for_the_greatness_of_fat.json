		{
			"id": 7516502,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7516502",
							"2"
						],
						"stepId": 7516502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Suriqui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650201,
					"content": "Ey cesur yolcu, Teteocan'a kadar geldiğine göre güç peşinde olmalısın, haksız mıyım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650202
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650202,
					"content": "Bereket Kolektifi tarafından güçlü kabul edilenleri çoktan görmüş olmalısın. Hah. Bana sorarsan hepsi sadece iri kıyım mankafalar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650203
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650203,
					"content": "Ama ya sen? Oldukça ince yapılısın. Her gün ağırlık kaldırıp göğüs antrenmanı yapmaya takıntılı olan o spor bağımlılarından değilsin herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650204
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650204,
					"content": "Tüm bunların birer tuzak olduğunu söyleyebilirim sana. Sakın onlara kanma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650205,
						751650206
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650205,
					"content": "Spor yapmaktan nefret mi edersin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650207
					]
				},
				{
					"id": 751650207,
					"content": "İşler o kadar basit değil aslında. Ama kas takıntısı ve kasların gücün temel kaynağı olduğu iddiaları da saçmalıktan ibaret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650208
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650208,
					"content": "Eski kahramanların vücutları sadece deri, kemik ve kaslardan ibaret değildi, bunu biliyorsundur herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650209
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650209,
					"content": "Bizden çok daha zor koşullarda yaşıyorlardı. Hayatta kalmak ve kendilerini savunmak onlar için çok daha önemliydi. Gerçek bir savaşta hayatta kalabilmek için kesinlikle koruyucu bir yağ tabakasına sahip olmaları gerekiyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650210
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650210,
					"content": "Bedenleri daha çok benimkine benziyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650211
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650211,
					"content": "Evet, eski zaman kahramanlarının da böyle etine dolgun, işlevsellik ve çevikliği dengeleyen bir yapısı vardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650212
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650212,
					"content": "Ne yazık ki bu kabilenin insanları gerçeği göremeyecek kadar aptal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650213
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650213,
					"content": "Tam olarak ikna olmadın sanırım... Hımm, şöyle yapalım o zaman...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650214
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650214,
					"content": "Tasarladığım çömlek kırma mücadelesini denemek ister misin? Burayı kendimi geliştirmek için yaptım ama istersen sen de deneyebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650215
					],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650215,
					"content": "Bunu denedikten sonra gerçek bir savaşta iri bir vücuda sahip olmanın neye benzediğini görebilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Suriqui"
				},
				{
					"id": 751650206,
					"content": "Kaslardan nefret mi edersin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650207
					]
				}
			]
		},
		{
			"id": 7516503,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
