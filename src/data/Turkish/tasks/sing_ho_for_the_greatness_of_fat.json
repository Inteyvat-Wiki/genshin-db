			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Illimani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751650401,
					"content": "Selam cesur yolcu, evet evet, sen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650402
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650402,
					"content": "Çok zayıf görünüyorsun... Beslenmene dikkat ediyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650406,
						751650404
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650406,
					"content": "Ama... Tüm yemekleri rehberim Paimon yedi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650403
					]
				},
				{
					"id": 751650403,
					"content": "Koşullar ne olursa olsun ilk kural: İyi beslenmen lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650408
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650408,
					"content": "Teteocan'a geldiğine göre Bereket Kolektifi savaşçılarını da görmüşsündür herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650409
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650409,
					"content": "İyi niyetimden ötürü sana bir tavsiye vereyim. Asla kas takıntısı olanlara güveneyim deme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650410
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650410,
					"content": "Yüce Hükümdar tarafından bizlere bahşedilen yağ, bedenimiz için paha biçilemez bir hediyedir. Neden birbirinden lezzetli yemeklere sırt çevirip yağlarımızı eritelim ki, kaslı bir vücutla gösteriş yapmak için mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650411
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650411,
					"content": "Bu çok aptalca, ormandaki yaban domuzları bile sana acırdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650412
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650412,
					"content": "Açıkçası, görünüş konusunda konuşacak olursak bu kas takıntısı son birkaç yıldır popüler oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650413
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650413,
					"content": "Dedemin söylediğine göre insanlar onun zamanlarında daha dolgun vücut tiplerini tercih edermiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650414
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650414,
					"content": "Kimsenin dolduruşuna gelerek kilo vereyim demeyin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650415
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650415,
					"content": "Ama bir gün sen de Bereket Kolektifindeki akrabalarım gibi güç uğruna kilo vermeye karar verirsen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650416
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650416,
					"content": "Sakın şunu unutayım deme; biraz tombul savaşçılar da bir balık kadar çevik olabilir. Maksat güç kazanmaksa şu sıska herifler bizimle boy ölçüşemez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650417
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650417,
					"content": "Kanıt arıyorsan talim kampındaki çömlekleri incele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650418
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650418,
					"content": "Vücut yapım sayesinde kolaylıkla <color=#00E1FFFF>tek bir çömleği bile kırmadan koşup geçebilirim</color>. Böylesi bir çeviklik çelimsiz sıska tiplerde bile görülmez, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650419
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650419,
					"content": "Ah, gülmemeye çalıştığını görebiliyorum! Peki... Bana inanmıyorsun demek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650420
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650420,
					"content": "Hadi, sen de bir dene! Talim kampında olabildiğince hızlı koş ama dikkat et, <color=#00E1FFFF>hiçbir çömleği kırmamalısın</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650421
					],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650421,
					"content": "Bakalım ne durumdasın ve rekorumu kırabilecek misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illimani"
				},
				{
					"id": 751650404,
					"content": "Ne? Bana yemek mi ısmarlıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751650407
					]
				},
				{
					"id": 751650407,
					"content": "Bunu demek istememiştim ama gerçekten çok açsan çantamda ızgara et var. Neyse, şimdilik bunları bir kenara bırakalım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751650408
					],
					"speakerTitle": "Illimani"
				}
			]
		},
