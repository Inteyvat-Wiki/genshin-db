			"dialogs": [
				{
					"id": 220150301,
					"content": "Bayan Sango. Bu doğru mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150302
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150302,
					"content": "Şehirdeki seri hırsızlıklar gerçekten Hazine Avcılarının işi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150303
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150303,
					"content": "Kesinlikle öyle. Sana kanıtları az önce gösterdim, profesyonel içgüdülerinle bunu çoktan anlamalıydın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150304
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150304,
					"content": "Hazine Avcıları... Buna nasıl cüret ederler? Bize hiç saygıları yok, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150305
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150305,
					"content": "Amano! Geri dönüp bunu rapor edelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150306
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150306,
					"content": "Devriyelerimizi artırmalıyız. Bu pisliklere tek bir açık bile veremeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150307
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150307,
					"content": "Bayan Sango, kanıtları ödünç alabilir miyiz? Yetkilileri harekete geçmeye ikna etmek için kanıtlara ihtiyacımız var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150308
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150308,
					"content": "Sorun değil, alabilirsiniz. Hazine Avcıları ile ilgilenmek büromuzun yetkisi dahilinde değil. Bunun için polise güvenmek zorundayız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150309
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150309,
					"content": "Lütfen içiniz rahat olsun! Hazine Avcılarının elimizden kaçmasına izin vermeyeceğiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150310
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150310,
					"content": "Teşekkür ederim. Şimdi... Her şey hazır olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150311,
						220150313
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150311,
					"content": "Hazır mısın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150312
					]
				},
				{
					"id": 220150312,
					"content": "Evet. Karakoldaki bu iki Doushin, bu vakanın kapatılması için bizim \"yardımcılarımız\" olacaklar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150316
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150316,
					"content": "İki Doushin devriyelerini artırdıktan sonra şehirdeki Hazine Avcıları tetikte olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150317
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150317,
					"content": "Ryuuji, gitmeni istediğim yerde Hazine Avcıları ile savaştın, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150318
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150318,
					"content": "Evet. Gezgin ile beraber onlarla savaştık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150319
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150319,
					"content": "Hımm... İyi olmuş. Muhtemelen dikkatlerini oldukça çekmemizi sağladınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150320
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150320,
					"content": "Artık elimize geçecek fırsatı beklemekten başka yapabilecek bir şeyimiz yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150321
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150321,
					"content": "Yardımın için teşekkürler, Gezgin. İşte ücretin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150322
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150322,
					"content": "Pek yardımım dokunduğunu sanmıyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150323
					]
				},
				{
					"id": 220150323,
					"content": "Öyle deme. Bir yabancı olarak Andou'nun dikkatini çektin. Amano ile beraber seni takip etmesini ve Ryuuji ile buluşmasını sağladın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150324
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150324,
					"content": "Şimdi Hazine Avcıları tehdidini kendi gözleriyle gördüler ve devriyelerini artırdılar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150325
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150325,
					"content": "Bu sadece senin yapabileceğin bir şeydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150326
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150326,
					"content": "Ne de olsa Doushinin Hazine Avcılarının yaptıklarına bizzat tanık olmasını sağlamak, benim onlara anlatmamdan daha etkili oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150327
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150327,
					"content": "Her neyse, bunları al. Kim bilir? Belki bir ara yine yardımına ihtiyacım olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150313,
					"content": "Ne planlıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150314
					]
				},
				{
					"id": 220150314,
					"content": "Ben bir dedektifim. Tabii ki vakayı çözmeyi planlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150315
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150315,
					"content": "Karakoldaki bu iki Doushin, bu vakanın kapatılması için bizim \"yardımcılarımız\" olacaklar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150316
					],
					"speakerTitle": "Sango"
				}
			]
		},
