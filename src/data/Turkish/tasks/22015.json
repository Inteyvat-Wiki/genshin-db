			"dialogs": [
				{
					"id": 220150205,
					"content": "Ah. Sango'nun bahsettiği asistan sen misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150206
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150206,
					"content": "Geleceğimi tahmin ediyor muydun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150207
					]
				},
				{
					"id": 220150207,
					"content": "Pek değil. Sadece Sango birinin yardıma geleceğini söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150208
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150208,
					"content": "Hey, siz ne yapıyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150209
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150209,
					"content": "Bunlar Hazine Avcıları mı? Neden şehrin bu kadar yakınındalar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150210
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150210,
					"content": "Ryuuji, neden buradasın? Peki ya şu şüpheli yabancı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150211,
						220150213
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150211,
					"content": "Bana mı diyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150212
					]
				},
				{
					"id": 220150212,
					"content": "Evet. Yani, buradaki tek yabancı sensin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150215
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150215,
					"content": "Pekala, havadan nem kapmaya gerek yok. Ryuuji, seni buraya getiren nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150216
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150216,
					"content": "Sango'nun talimatlarına göre burada bir şüpheliyi takip ediyordum ama sonra Hazine Avcılarına rastladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150217
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150217,
					"content": "Gezgin, Sango'nun davet ettiği bir asistan. Az önce birlikte Hazine Avcılarını kovaladık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150218
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150218,
					"content": "Anlıyorum... Fakat Hazine Avcıları neden buralarda olsun ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150219
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150219,
					"content": "Ryuuji, az önce bazı şüphelileri takip ettiğinden bahsettin... Gerçekten mi? Hazine Avcılarını şehrin içinden buraya kadar takip mi ettin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150220
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150220,
					"content": "Sanırım. Sango bir seri hırsızlık vakasıyla uğraşıyor. Onun içgüdülerine dayanarak şehri araştırıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150221
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150221,
					"content": "Kısa bir süre sonra Hanamizaka yakınlarında şüpheli bir adam gördüm. Ben birkaç soru sorunca paniğe kapılıp uzaklaştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150222
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150222,
					"content": "Onu şehir dışına kadar takip ettim. Sonrasında ne olduğunu hepiniz biliyorsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150223
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150223,
					"content": "Hımm... Ryuuji, nasıl bir anda konuşkan birine dönüştün? Eskiden lafı ağzından kerpetenle alıyorduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150224
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150224,
					"content": "Sango ile çalışmak seni iyi bir konuşmacı yapmış, sen ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150225,
						220150228
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150225,
					"content": "Siz ikiniz burada ne yapıyorsunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150226
					]
				},
				{
					"id": 220150226,
					"content": "Andou, şehirde dolaşan şüpheli sarışın bir yabancı olduğunu söyledi, biz de bakmaya geldik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150227
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150227,
					"content": "Bu yüzden seni takip ettik. Sango'nun asistanı olduğunu bilmiyordum. Yanlış anlaşılma için özür dilerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150232
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150232,
					"content": "Ah... Ryuuji, şüpheli kişiyi şehirde bulduğunu söylememiş miydin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150233
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150233,
					"content": "Doğru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150234
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150234,
					"content": "Şehrimize ayak basmaya nasıl cüret ederler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150235
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150235,
					"content": "Evet. Ama sadece biz... Biz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150236,
						220150237
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150236,
					"content": "(Neden bir anda konuşmayı unutmuş gibi davranmaya başladı?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150238
					]
				},
				{
					"id": 220150238,
					"content": "Hımm... Yine de, sadece bir veya iki Hazine Avcısını kendi başımıza geldiği yere gönderebiliriz. Hepsinden kurtulmak için size güveniyoruz arkadaşlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150239
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150239,
					"content": "Kanıtı görmek istiyorsanız şehre gidip Sango'yu arayabilirsiniz. Size her şeyi ayrıntılı olarak açıklayacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150240
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150240,
					"content": "Hımm... Amano, hadi gidip Sango'yu arayalım. Kasabada gerçekten Hazine Avcıları varsa bir şeyler yapmalıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150241
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220150241,
					"content": "Evet... Evet, aynen öyle! Gidip Sango'yu bulalım. Ryuuji, sen de yakında geri dönmelisin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150242
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150242,
					"content": "... Aman be.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150243
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150243,
					"content": "Geri dönelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150244
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150244,
					"content": "Az önce söylediklerin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150245
					]
				},
				{
					"id": 220150245,
					"content": "Sango söylememi istedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150246
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150246,
					"content": "Biz üzerimize düşeni yaptık, artık geri dönelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220150237,
					"content": "(Söyleyeceği şeyi unutmuşa benziyor...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150238
					]
				},
				{
					"id": 220150228,
					"content": "Sen de mi şüpheli birini buraya kadar takip ettin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150229
					]
				},
				{
					"id": 220150229,
					"content": "Öyle denebilir. Peşinde olduğumuz şüpheli kişi aslında sendin. Öhöm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150230
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150230,
					"content": "Andou, şehirde dolaşan şüpheli sarışın bir yabancı olduğunu söyledi, biz de bakmaya geldik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150231
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150231,
					"content": "Bu yüzden seni takip ettik. Sango'nun asistanı olduğunu bilmiyordum. Yanlış anlaşılma için özür dilerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150232
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220150213,
					"content": "Ben Sango'nun asistanıyım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150214
					]
				},
				{
					"id": 220150214,
					"content": "Sango'nun asistanı mı? İş daha şüpheli bir hal aldı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150215
					],
					"speakerTitle": "Andou"
				}
			]
		},
