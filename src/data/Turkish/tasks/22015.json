						220150819
					]
				},
				{
					"id": 220150819,
					"content": "Birlikte her şeyi gözden geçirdik. Beklenmedik bir şey olursa başa çıkabilecektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150820
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150820,
					"content": "Daha çok aradığımı bulup bulmaması beni endişelendiriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150826
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150826,
					"content": "Senden haber bekleyeceğim. Tabii ki ücretini alacaksın. Ayrıca bir dedektifin yaşamını görmek için iyi bir şans.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150821,
					"content": "Başına bir şey gelmemiştir, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150822
					]
				},
				{
					"id": 220150822,
					"content": "Sanmam. Birlikte her şeyin üzerinden geçtik.",
