					"nextDialogs": [
						220150802,
						220150807
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150802,
					"content": "Dedektif olabilir miyim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220150803
					]
				},
				{
					"id": 220150803,
					"content": "Dedektif olmak ister misin? Bu zorlu bir iş; polisiye romanlarında göründüğü gibi değil.",
