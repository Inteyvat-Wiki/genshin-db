					"nextDialogs": [
						220150805
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150805,
					"content": "Gerçek dedektiflik işi daha çok oda dolusu dosyalarla, çamurlu dağ yollarıyla ve hiç iz bırakmayan şüphelilerle uğraşmayı gerektirir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150806
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150806,
					"content": "Sadece anlatmam yeterli olmayabilir... Elimde küçük bir vaka var. Biraz deneyim kazanmaya ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150815
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150815,
					"content": "Asistanım Ryuuji bir süre önce ipuçlarını toplamak için çıktı ve hâlâ geri dönmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220150816
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220150816,
					"content": "Şimdiye kadar yeterince ipucu toplamış olması lazım.",
