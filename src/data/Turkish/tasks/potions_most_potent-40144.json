			"dialogs": [
				{
					"id": 401440701,
					"content": "#Merhaba Fahri Şövalye! Merhaba Paimon! Ben Freda. Lojistik Bölüğünde şövalyeyim. Meşhur {NICKNAME} ve onun sadık hizmetkarı ile tanışmak ne büyük bir onur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440702
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440702,
					"content": "Vay be, Paimon'un namı her yere yayılmış, hehe! Ama küçük bir düzeltme yapayım. Paimon onun hizmetkarı değil, yoldaşı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440703,
					"content": "Aa, özür dilerim. Galiba maceralarınızı dinledikten sonra kendimi kaptırdım biraz. Adeta romandan fırlamış gibisiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440704
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440704,
					"content": "Artık siz birer efsane sayılırsınız. Kıskanmadım desem yalan olur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440705
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440705,
					"content": "Hikayelerdeki kahramanlar gibi ben de maceralara atılıp diyar diyar gezmek isterdim! Çok eğlenceli olsa gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440706,
						401440708
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440706,
					"content": "Belki bir gün sen de fırsatını bulursun!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440707
					]
				},
				{
					"id": 401440707,
					"content": "Evet! Ben de öyle umuyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440710
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440710,
					"content": "Neyse, tamamlamamız gereken hazırlıklar var şimdi, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440711
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440711,
					"content": "Büyük Kumandan Vekilinden aldığım emre göre işinize elimden geldiği kadar destek olmam gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440712
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440712,
					"content": "Bir şey lazım olursa bana söylemeniz yeterli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440713,
						401440715
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440713,
					"content": "Malzeme alımı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440714
					]
				},
				{
					"id": 401440714,
					"content": "Şanslısınız! Daha yeni bir parti gelmişti! Lütfen işinize yarar bir şey var mı bir bakın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440715,
					"content": "Hoşça kal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440716
					]
				},
				{
					"id": 401440716,
					"content": "İşinizde bol şans diliyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freda"
				},
				{
					"id": 401440708,
					"content": "O kadar da eğlenceli değil aslında.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440709
					]
				},
				{
					"id": 401440709,
					"content": "Evet, doğrudur. Hikayelerde de kahramanlar sürekli türlü tehlikeyle karşı karşıya kalıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440710
					],
					"speakerTitle": "Freda"
				}
