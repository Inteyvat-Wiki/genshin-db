			"dialogs": [
				{
					"id": 401440401,
					"content": "Ooo, bakıyorum her şey yolunda gidiyor. İlk iksirlerini çoktan satmışsın bile. Hiç fena bir başlangıç değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440402
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440402,
					"content": "Bundan sonra hazırlanması gereken iksirlere gelince, piyasadan gelen haberlere bir bakmamız gerekecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440403
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440403,
					"content": "İnsanların ihtiyaçlarını tespit edebilmek için güncel haberlere ve trendlere hakim olmak gerekiyor. Söz konusu ticaret olduğunda en zaruri becerilerden biri bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440404
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440404,
					"content": "Biraz zormuş sanki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440405,
					"content": "Hehe... Merak etmeyin. Ben sizin için tüm haberleri derledim bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440406
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440406,
					"content": "Ne dersin? Sırada ne tür iksirler satacağına dair bir fikir oluştu mu aklında?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440407
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440407,
					"content": "İstersen biraz şifalı bitki yetiştirmeyi dene. Biyo-simya ile bitkilere farklı özellikler ve etkiler kazandırılabiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440408
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440408,
					"content": "İksir yaparken farklı bitkiler kullandığında iksirin etkilerinde değişiklikler olur. Yani denenebilecek bir sürü kombinasyon var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440409
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440409,
					"content": "Pekala tatlım, sen başla istersen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				}
			]
