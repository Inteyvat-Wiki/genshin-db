					"content": "Dükkan burası işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440202
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440202,
					"content": "Vay be! Daha şimdiden bir sürü hazırlık yapılmış bile! Hepsini tek başına mı yaptın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440203,
					"content": "Yok, tek başıma değil. Bir sürü şövalyenin emeği var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440204
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440204,
					"content": "Jean dükkanı açabilmek için bütçe sağladı. Albedo ve Sucrose da iksirleri hazırlamak için gereken malzemeleri ve ekipmanı getirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440205
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440205,
					"content": "Lojistik Bölüğü de bundan sonra yapılacak tüm malzeme tedarikini üstleniyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440206
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440206,
					"content": "Şimdi sizin de yardımınızla yüküm biraz daha hafifledi sanki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440207
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440207,
					"content": "Şövalyeler son birkaç gündür dükkanımızı duyurmakla meşguller. Son hazırlıkları da tamamlayıp açılışa hazır olmalıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440208
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440208,
					"content": "Daha fazla bekletmeyelim insanları öyleyse. Bu malzemeleri alıp bir iksir hazırlamak ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				}
			]
		},
