			"dialogs": [
				{
					"id": 401440601,
					"content": "Yetiştirme sürecini kavramışsın bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440602
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440602,
					"content": "Hah, aklıma gelmişken söyleyeyim, Lojistik Bölüğünden bir şövalye geldi. Tüm malzemelerin tedarikinden o sorumlu olacak. Gidip onunla konuşabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440603
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440603,
					"content": "Ondan sonra da sahne sizin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440604
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440604,
					"content": "E bir dakika, sen ne yapacaksın Lisa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440605
					]
				},
				{
					"id": 401440605,
					"content": "Evet! Sahne zamanı geldi demedin mi? Sahne üçümüzün değil mi? Senin rolün ne olacak bu sahnede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440606,
					"content": "Benim rolüm mü? Benim rolüm başarılı olmanız için gereken tüm iş ve simya bilgisini size aktarmaktı tabii ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440607
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440607,
					"content": "Haydi, ben arkanızdayım! Bol şans!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440608
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440608,
					"content": "Paimon böyle olacağını biliyordu...",
