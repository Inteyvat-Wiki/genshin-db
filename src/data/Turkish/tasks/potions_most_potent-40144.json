			"dialogs": [
				{
					"id": 401440101,
					"content": "Ah, siz miydiniz canlarım? Bu ziyaretinizi neye borçluyuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440102
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440102,
					"content": "Kütüphaneyi kullanmak için mi geldiniz? Ya da birini ziyaret etmeye mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440103,
						401440105
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440103,
					"content": "Tabii ki seni görmek için geldik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440104
					]
				},
				{
					"id": 401440104,
					"content": "Hehe, her zamanki gibi pek incesin bakıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440107
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440107,
					"content": "Şansa bak... Ben de tam önemli bir işle uğraşıyordum. Size başka zaman bir beş çayı ısmarlayayım artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440108
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440108,
					"content": "Bir dakika, cidden işin mi var? Bildiğimiz iş yani? Nadir görülecek bir sahne doğrusu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440109,
					"content": "Haha, haklısın. Araştırma yapmakla en son Akademideyken bu kadar meşgul olmuşumdur herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440110
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440110,
					"content": "Uzun zaman olmuştu bir konuya bu kadar kafa yormayalı. Epey yorucuymuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440111,
						401440112
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440111,
					"content": "Tez mi yazıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440113
					]
				},
				{
					"id": 401440113,
					"content": "Hehe, bu kadar ilgilendiğine göre sen de katılmak ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440114
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440114,
					"content": "Ne dersin? Eski Akademi günlerime dönmeme yardım etmek ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440115
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440115,
					"content": "İşini böyle başkasının üstüne yıkmak kabalık olur yalnız, biliyorsun değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440116,
					"content": "#Yani cevabın hayır mı {NICKNAME}? Birlikte çalışma fırsatı her gün geçmez elimize... Hem karşılığında cömert bir ödül de alacaksın. Ama tabii istemiyorsan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440117,
						401440118
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440117,
					"content": "Dinliyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440119
					]
				},
				{
					"id": 401440119,
					"content": "Muhtemelen biliyorsunuzdur, Favonius Şövalyeleri uzun zamandır simya üzerine araştırmalar yürütüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440120
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440120,
					"content": "Ancak bu araştırmalar çoğunlukla laboratuvarda yapılıyor. Halkın simyaya dair pek bir bilgisi yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440121
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440121,
					"content": "Yani şu ana kadar yaptığımız araştırmaların ve keşiflerin insanların günlük hayatına pek bir katkısı olmadı. Bu araştırmalar için çok fazla Mora harcadık ancak çabalarımızın sonucunu gösterecek çok az şey var elimizde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440122
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440122,
					"content": "Jean aradaki bu kopukluğu fark edince emeklerimizin karşılığında aldığımız sonuçları insanlarla paylaşabileceğimiz bir girişim başlatmaya karar verdi. Şimdilik planımız insanlara birkaç farklı simya iksiri tanıtmak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440123
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440123,
					"content": "Aslında benim bu konuda biraz tecrübem var. Şu anda kütüphanede çalışıyor olsam da zamanında Şövalyelerin iksir tedarikini yönetmekle de uğraşmıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440124
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440124,
					"content": "Ayrıca iksircilik benim akademik ihtisas alanlarımdan da biriydi. Jean de o yüzden bu iş için beni uygun gördü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440125
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440125,
					"content": "Ancak insanların günlük hayatta işlerine yarayacak pratik iksirler yapmak için önce kullanılan malzemelerde çeşitli ayarlamalar yapmamız ve simya sürecini olabildiğince basitleştirmemiz gerekiyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440126
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440126,
					"content": "Yani kısacası, görece basit bir araştırma projesi olarak başlamıştık ancak çok geçmeden karmaşık bir hal aldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440127
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440127,
					"content": "Araştırmana yardım etmemizi mi istiyorsun yani? Çünkü öyleyse bizim simya uzmanı olmadığımızı belirtmekte fayda var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440128,
					"content": "Hehe, sorun yok. Ben tam ikinize uygun bir görev buldum bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440129
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440129,
					"content": "Simya uygulamaları her geçen gün gelişmeye devam etse de araştırmalarımızla halk arasında bir kopukluk söz konusu. O yüzden insanlardan geri bildirim toplamamız gerekiyor. Yoksa onların isteklerini karşılayabilen bir iş çıkarıp çıkarmadığımızı bilemeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440130
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440130,
					"content": "Tabii hem araştırmaya devam edip hem geri bildirim toplamak istiyorsak bu işi daha verimli ilerletmemiz lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440131
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440131,
					"content": "Ben de en iyi çözümün bir simya dükkanı açmak olduğunu düşündüm! Bu sayede hem simya işlerini devam ettirebileceğiz hem de insanlarla iç içe olacağımız için onların ihtiyaçlarını daha iyi anlayabileceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440132
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440132,
					"content": "Bir taşla iki kuş diyorsun yani! İyi fikir Lisa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440133,
					"content": "#Tabii ki! Ve bu işi aramızdaki en başarılı şövalyelerden birinin üstlenmesi mantıklı olur... Evet, seni diyorum {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440134
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440134,
					"content": "Ben Akademideyken öğrenciler sıklıkla birbirlerinin araştırma projelerine yardım ederlerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440135
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440135,
					"content": "Eminim benim canlarım da böyle bir gençlik hevesini bizzat yaşama fırsatını kaçırmak istemezler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440136
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440136,
					"content": "Pekala... İyi diyorsun, hoş diyorsun da Paimon yine de işini başkasına yıkmaya çalıştığını düşünüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440137,
						401440139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401440137,
					"content": "Lisa için bir iyilik olarak düşünebiliriz bence.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440138
					]
				},
				{
					"id": 401440138,
					"content": "Hehe, sana güvenebileceğimi biliyordum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440141
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440141,
					"content": "İşlerimiz bittiğinde size cömert bir ödül verilmesini bizzat isteyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440142
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440142,
					"content": "Tüm ön hazırlıklar tamamlanmış durumda, dükkana gidebiliriz. Konuşmamıza oraya varınca devam ederiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440139,
					"content": "Yeni mücadelelere hayır demem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440140
					]
				},
				{
					"id": 401440140,
					"content": "Bak bu hevesini sevdim işte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440141
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401440118,
					"content": "Önce bir ayrıntıları duyalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440119
					]
				},
				{
					"id": 401440112,
					"content": "Bir araştırma projesi üzerinde mi çalışıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440113
					]
				},
				{
					"id": 401440105,
					"content": "Öyle buralardan geçiyorduk da...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401440106
					]
				},
				{
					"id": 401440106,
					"content": "Uğrayıp sohbet etmeye mi karar verdiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401440107
					],
					"speakerTitle": "Lisa"
				}
			]
		},
