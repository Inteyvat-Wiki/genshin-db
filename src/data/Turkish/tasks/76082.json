				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Maite"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760141401,
					"content": "Ne oldu kardeşim? Söylemek istediğin başka bir şey mi var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141402,
						760141406,
						760141409,
						760141413,
						760141426
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141402,
					"content": "Şu yengeç hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141403
					]
				},
				{
					"id": 760141403,
					"content": "*iç çeker* Korkunç gibi duruyor ama hep uysaldı aslında. Taşı çıkardığımız için normale döner şimdi muhtemelen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141404
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141404,
					"content": "Ama şimdilik onu bırakalım da yaptıklarını bir düşünsün. Manipüle edilmiş olsa da olan oldu ve o küçük yengeçlere zarar verdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141405
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141405,
					"content": "Tıpkı ayna büyüsünün etkisindeki o nemrut valinin Reed Miller'a karşı çıktığı gibi... Bahaneler, yanlışlarını eylemle düzeltmen gerektiği gerçeğini değiştirmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141406,
					"content": "Şu tuhaf taş hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141407
					]
				},
				{
					"id": 760141407,
					"content": "Hehe, insanların kalplerini edebilen bir arzu t{RUBY#[D]Twardowska'nın Taşı}aşı o. Hidimbi Abla adının o olduğunu söylemişti en azından.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141408
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141408,
					"content": "Öhöm. Neyse, tıpkı Donuk Ayın Çocuklarının yaşadığı devasa kaya gibi gökten düştü o da. Uçup gittiği için artık güvendeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141409,
					"content": "Deniz Kabuğu Çetesi hakkında bilgi verebilir misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141410
					]
				},
				{
					"id": 760141410,
					"content": "Hı? Bizim hakkımızda bilgi mi almak istiyorsun kardeşim? Tabii ki. Zaten arkadaşımız olduğun için istediğini sorabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141411
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141411,
					"content": "Biz... Aynı yaştan benzer fikirli insanlar için bir ortak yardım ve koordinasyon topluluğu sayılırız. Bize katılmak için fazla yaşlısın ne yazık ki ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141412
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141412,
					"content": "Nasha Kasabası'nda herhangi bir şeyle ilgili yardıma ihtiyacın olursa ve ben de oradaysam mutlaka bana ulaş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141413,
					"content": "Daha önce gördüğümüz şu tuhaf kişi hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141414
					]
				},
				{
					"id": 760141414,
					"content": "Ha, mor saçlı rahibeyi diyorsun. Henüz bize karşı harekete geçmedi, şimdilik düşmanımız değil o yüzden. Ama olabildiğince işine karışmasak iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141415
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141415,
					"content": "Merak, sonumuz olabilir. Katya Abla bizi Donuk Ay kaçıklarıyla iletişim kurmamamız konusunda uyardı. İyi ki de uyarmış, benim gibi bir usta hırsız bile bir keresinde neredeyse yakalanıp onların Ay Tanrıçası'na kurban edilecekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141416
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141416,
					"content": "Kurban mı edilecektin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141417
					]
				},
				{
					"id": 760141417,
					"content": "Evet, çok tuhaf tipler onlar. Farklı insanlardan kan alıp... Off, düşünmek bile tüylerimi diken diken ediyor. Burada bırakalım en iyisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141418
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141418,
					"content": "Neyse ki beni küçük, saf bir kız yakalamıştı. Ona bir iki hikaye anlatınca gitmeme izin verdi. Yoksa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141419
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141419,
					"content": "Korkmamıştım aslında. Usta hırsızlar asla korkmaz! Yine de benden size tavsiye, onlardan uzak durun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141420
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141420,
					"content": "Ah, neredeyse size söz verdiğim istihbarat kaynağını unutuyordum. Donuk Ayın Çocuklarıyla ilgili her şeyi Hidimbi Abla'dan öğrendim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141421
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141421,
					"content": "Onu bulmak istiyorsanız hâlâ Nasha Kasabası taraflarında sanırım. Çevredekilere sorarsanız bulursunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141422,
						760141424
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141422,
					"content": "Uzun bir mola verecekmiş...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141423
					]
				},
				{
					"id": 760141423,
					"content": "Ne? Onunla çoktan tanıştınız demek. Mola vereceğinden bahsetmemişti... Neyse, bunu sonra konuşuruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141424,
					"content": "Kulağa pek güvenilir gelmiyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141425
					]
				},
				{
					"id": 760141425,
					"content": "Merak etmeyin. Son derece güvenilir biridir. Maite'ye güvenin siz! Endişelenmeyi bırakın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141426,
					"content": "Görüşürüz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141427
					]
				},
				{
					"id": 760141427,
					"content": "Pekala. İyi yolculuklar dostum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maite"
				}
			]
		},
		{
			"id": 7601417,
			"completionStepIds": [
				7608202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7608202",
