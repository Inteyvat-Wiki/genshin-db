			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Maite",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760141701,
					"content": "Vay canına! Bu arkadaş eskisinden de mi irileşti sanki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760141702,
					"content": "Hehe, tabii ki. Binbir güçlükle bulduğum tüm Lakka Böğürtlenlerini yedikten sonra Çar Hazretleri artık senden bile daha tombul Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141703
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141703,
					"content": "Yeter ama! Şu saçma sapan kıyaslamalarına bir son ver artık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760141704,
					"content": "#Ne oldu yahu? Bir anda enerji patlaması yaşadın resmen... Daha doğrusu seninle göz göze gelince heyecanlandı {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141705
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141705,
					"content": "Sana meydan okumak istiyor galiba... Hah, daha önce hakkından geldi diye sindiremedin mi yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141706,
						760141708
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141706,
					"content": "Hodri meydan!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141707
					]
				},
				{
					"id": 760141707,
					"content": "Dikkatli ol. Öncekine kıyasla çok daha güçlü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141708,
					"content": "Ne? Şimdi mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760141709
					]
				},
				{
					"id": 760141709,
					"content": "İsteklerine uymak zorunda değilsin aslında. Meydan okumasını istediğin zaman kabul edebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141710
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141710,
					"content": "O artık benim korumam altında, lafımı dinleyecektir o yüzden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141711
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141711,
					"content": "Uslu dur bakalım. Otur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760141712
					],
					"speakerTitle": "Maite"
				},
				{
					"id": 760141712,
					"content": "Evcil köpeğinmiş gibi konuşuyorsun... Dur biraz, yengeçler zaten hep oturmuyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
