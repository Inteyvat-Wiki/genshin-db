					"Cyrus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980401,
					"content": "İşte başlıyoruz! Bu kadar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980402
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980402,
					"content": "Kriz! Tehlike! Macera heyecanı!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980403
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980403,
					"content": "Maceracılar Loncası! Nihayet kayıp kedi köpek yavrularını kurtarma günlerimiz sona erdi! Macera çağı bizi bekliyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980404
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980404,
					"content": "Haydi bakalım gençler, bugün Maceracılar Loncasına katılın! Bu büyük değişim zamanlarında bir araya toplanmalı, ejdere karşı koymalı ve muhteşem şehrimiz Mondstadt'ı kurtarmalıyız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980405
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980405,
					"content": "Evet, o konuda...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980406
					]
				},
				{
					"id": 3980406,
					"content": "... Ne!? NE!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980407
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980407,
					"content": "Fırtına Dehşeti tehdidi çözüldü mü? Büyük Kumandan Vekilinin konuşmasını mı kaçırdım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980408
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980408,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980409
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 3980409,
					"content": "... Aman! Fırtına Dehşeti savaşta daha çok mücadele etmeliydi! Buna katılamadık çünkü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
			]
		},
		{
			"id": 39807,
			"completionStepIds": [
				39807
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
