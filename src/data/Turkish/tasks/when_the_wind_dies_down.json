			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sara",
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980701,
					"content": "Selamlar, siparişini alabilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980702
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 3980702,
					"content": "Neden bu kadar soğuk ki? Yakın arkadaşlara böyle mi selam verilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980703,
						3980705
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980703,
					"content": "Ah hey, seni orada göremedim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980704
					]
				},
				{
					"id": 3980704,
					"content": "Hahaha. Görünüşe göre, büyük savaşın sadece savaş yeteneklerini değil zekanı da geliştirmiş. Tam bir şövalye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980707
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980707,
					"content": "Mondstadt'ın yeni büyük kahramanının huzurunda bulunmak moralimizi yükseltecek. Bu sözler bir şövalyeden geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980708
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980708,
					"content": "Tatlı dilli Yüzbaşı Kaeya göz boyamaya bayılır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980709,
					"content": "Haha, saçmalık! Kalpten söylüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980710,
						3980714
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980710,
					"content": "Ne işin var burada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980711
					]
				},
				{
					"id": 3980711,
					"content": "Kafamı toplamak için sessiz bir yer arıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980712
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980712,
					"content": "Diğer tüm şövalyeler savaş sonrası ortalığı toparlarken...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980713,
					"content": "Düşünmek çok zorlu olabilir. İnan bana, çöpü çıkarmayı tercih ederim daha iyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980717
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980717,
					"content": "Peki öyleyse ne düşünüyorsun o zaman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980718,
					"content": "Hiçlik Tarikatı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980719
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980719,
					"content": "Bir ejderha Mondstadt'ı yerle bir ediyor ve Büyük Kumandan Vekili tehditle savaşmak için şehri terk ediyor. Stratejik olarak, bu durum Hiçlik Tarikatının hamle yapması için mükemmel bir an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980720
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980720,
					"content": "Hiçlik Tarikatından olsaydın, bu altın fırsatı birkaç dağ yabanisinden başka birilerini göndermeyerek harcar mıydın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980721,
						3980722
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980721,
					"content": "Haklısın, mantıksız bir şeyler var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980723
					]
				},
				{
					"id": 3980723,
					"content": "İşin aslını öğrenmek için beklemeye karar verdim. Bu yüzden bekledim ve bir sonraki hamlelerini izledim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980724
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980724,
					"content": "Sonra Fırtına Dehşeti'nin İninde kıyametlerin koptuğu gün geldi, aynı şehir kapısından gelen dağ yabanilerinin çığlıkları gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980725
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980725,
					"content": "Aynı gün, şehirde gizlenen kimliği belirsiz kişiler gördüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980726
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980726,
					"content": "Şehrin içinde mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980727,
					"content": "Evet, diğer şövalyeler dışarıda düşmanla savaşıyordu. Tahmin edebileceğin gibi bu durum şehrin içini tamamen korumasız bıraktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980728
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980728,
					"content": "Tabii ki benim dışımda. Ve ben de... Hımm, biraz arkadaşlık adı altında Hiçlik Tarikatına sızanlarla yakınlaştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980729
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980729,
					"content": "Çeşitli yollarla oldukça ilginç bilgiler toplamayı başardım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980730
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980730,
					"content": "Durum şöyle: Hiçlik Tarikatı... Tek bir lider altında birleşti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980731
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980731,
					"content": "Hiçlik Tarikatının lideri mi var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980732
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980732,
					"content": "Evet. Dvalin'in bir savaş silahına dönüştürülmesi planı da aynı lidere aitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980733
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980733,
					"content": "Bunu öğrenmek için tam olarak ne yapman gerekti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980734,
					"content": "Hehehe... Ağzım iyi laf yapıyor diyebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980735
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980735,
					"content": "#Dahası da var... Hiçlik Tarikatının bu lider için kullandığı bir ad var... Ona şöyle diyorlar: {F#\"Prens\".}{M#\"Prenses\".}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980736
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980736,
					"content": "#{F#Prens...}{M#Prenses...}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980737
					]
				},
				{
					"id": 3980737,
					"content": "Şimdi, bu istihbarat brifingini kısa kestiğim için üzgünüm ama Amber'ı bu tarafa doğru gelirken gördüm sanki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980738
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980738,
					"content": "Sanırım saldırı sırasında savunma çabalarındaki yokluğum yüzünden bana hâlâ kızgın. Fark edilmeden sıvışsam iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980739
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980739,
					"content": "Bir anlığına Kaeya'yı gördüm, sonra kaçıp gitti! Vicdan azabının davranışlara yansıması...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980740,
						3980742
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980740,
					"content": "Perde arkasında çok şey yapıyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980741
					]
				},
				{
					"id": 3980741,
					"content": "Emin misin? Çünkü bu tam da kendini beladan kurtarmak için onun söyleyebileceği bir şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980744
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980744,
					"content": "Ama unutalım onu. Bugün çok çalıştım ve karnım gurulduyor. Haydi sipariş verelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980745
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980745,
					"content": "Merhaba Sara! Bir Karamelize Soslu Rosto lütfen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980742,
					"content": "Biliyorum! Ne alçak ama!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980743
					]
				},
				{
					"id": 3980743,
					"content": "Katılıyorum. Süvari Yüzbaşısı olan birisi için korkunç bir örnek oluşturuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980744
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980722,
					"content": "Bu hikayede başka şeyler de olmalı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980723
					]
				},
				{
					"id": 3980714,
					"content": "Bu sefer ne planlıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980715
					]
				},
				{
					"id": 3980715,
					"content": "Ben mi? Hiçbir şey. Tam tersi, başkalarının ne planladığını anlamaya çalışıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980716
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980716,
					"content": "Bu yüzden buradayım, düşüncelerimi toplayabileceğim sessiz bir yerde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980717
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3980705,
					"content": "Ah, yakışıklı Bay Kaeya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980706
					]
				},
				{
					"id": 3980706,
					"content": "Demek bana karşı bir şeyler hissediyorsun. Halbuki insanlar cazibemin sahte olduğunu söyler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980707
					],
					"speakerTitle": "Kaeya"
				}
			]
		},
		{
			"id": 39809,
			"completionStepIds": [
				39809
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"39809",
							"2"
						],
						"stepId": 39809,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980901,
					"content": "İşte böyle... Fırtına Dehşeti tehdidini ardımızda bıraktık, sonraki adım için planların ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980902
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980902,
					"content": "Paimon, Mondstadt'tan ayrılma zamanının geldiğini düşünüyor. Onun kardeşi hakkında ipuçlarına ulaşana kadar yedi ulusu incelemeye devam etmeliyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980903,
					"content": "Hı, gerçekten mi? Ha... Evet, sanırım şimdilik bu bir veda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980904,
						3980905
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980904,
					"content": "Mondstadt'ı özleyeceğim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980906
					]
				},
				{
					"id": 3980906,
					"content": "Hey, moralini bozma! Her zaman Favonius Şövalyelerinin dostu ve Fahri Şövalyemiz olacaksın. Nereye gidersen git ve rüzgar ne yöne eserse essin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980907,
						3980908
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980907,
					"content": "Rüzgar rehberin olsun!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980909
					]
				},
				{
					"id": 3980909,
					"content": "Aynen böyle! Unutma, Mondstadt her zaman seni hoş karşılayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980910
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980910,
					"content": "Peki, şimdi yemeğimiz soğumadan yiyelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980911
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980911,
					"content": "Mmm, bu güzelmiş! Paimon'a not, Amber'ın tavsiyeleri için beklemeye değer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980912,
					"content": "Elbette! Mutfakta kendime güvenmiyor olabilirim, ama bana menüde her zaman güvenebilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980913
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980913,
					"content": "Ha, az kalsın unutuyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980914
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980914,
