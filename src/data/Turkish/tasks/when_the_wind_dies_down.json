				"points": []
			},
			"dialogs": [
				{
					"id": 3980301,
					"content": "Yaşasın kahramanlar! Nihayet bitti, teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980302
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 3980302,
					"content": "Fırtına Dehşeti olayı yüzünden pek çok ticaret yolu kapandı. Taze sebze ve meyve olmadan şimdilik idare edebiliriz... Ama şarap stokları tükenirse hepimiz mahvoluruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980303
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 3980303,
					"content": "Şarapsız bir dünya hayal edemem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980304
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 3980304,
					"content": "Umarım ticaret yollarını kısa süre içinde tekrar açarlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nimrod"
				}
			]
		},
		{
			"id": 39804,
			"completionStepIds": [
				39802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
