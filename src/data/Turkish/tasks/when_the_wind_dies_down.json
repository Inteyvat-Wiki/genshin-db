			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980101,
					"content": "Geri döndünüz çocuklar! Fahri Şövalye zafer kazanmış olarak döndü!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980102,
					"content": "#Evet, {NICKNAME} Dvalin ile oldukça iyi zaman geçirdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980103,
					"content": "Daha dün döndün, değil mi? Önce Jean döndü ve bize kahramanlıklarından bahsetti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980104
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980104,
					"content": "*iç çeker* Acaba ben de böyle bir fırsat yakalayabilecek miyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980105,
						3980108
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980105,
					"content": "Hepsi tavsiyen sayesinde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980106
					]
				},
				{
					"id": 3980106,
					"content": "Bunun konuyla ilgisi yok. Krizi çözdüğünüz için tüm takdirleri hak ediyorsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980107
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980107,
					"content": "O gün seni şehre getirdiğimde sadece Kaşif olarak görevimi yapıyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980111
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980111,
					"content": "Rica ederiz! ... Ama, bunca zamandır bizi burada mı bekliyordun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980112,
					"content": "Tabii ki hayır! Ön saflarda olmamam, yapacak işim olmadığı anlamına gelmez... Aslında, biz konuşurken krizin sonuçlarıyla ilgileniyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980113
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980113,
					"content": "Sonuçlar mı? Burada mı? Mondstadt'ta ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980114,
					"content": "Kumandan Jean buralarda yokken, yakınlarda gizlenen canavarlar şehre eş zamanlı bir saldırı düzenledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980115
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980115,
					"content": "Neyse ki, tamamen hazırlıksız yakalanmadık. Bir süre önce dağ yabanilerinin şehre yaklaştığını fark ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980116
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980116,
					"content": "Ha evet! Paimon hatırlıyor. İlk tanıştığımızda, onların kamplarından birini ortadan kaldırıyordun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980117,
					"content": "Kesinlikle. O zamanlar hazırlanmaya başlamasaydık Mondstadt şu anda çok daha büyük bir tehlikede olurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980118,
						3980121
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980118,
					"content": "Onları uzakta tutabilmene sevindim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980119
					]
				},
				{
					"id": 3980119,
					"content": "Ben de. Ama içimde henüz düzlüğe çıkmadığımıza dair garip bir his var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980120
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980120,
					"content": "Dağ Yabanileri genellikle böyle eş zamanlı hareket edemezler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980123
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980123,
					"content": "En iyi tahminimiz bu işin arkasında Hiçlik Tarikatının olduğu yönünde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980124
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980124,
					"content": "Dağ yabanilerini ele mi geçirmişler? Hım... Dvalin'i kurtarmamız iyi oldu, yoksa onu da ele geçirebilirlerdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980125,
					"content": "Bu doğru. Ve ben Şövalyelerin Kaşifi olduğumdan, bundan böyle Hiçlik Tarikatını izlemek bana düşer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980126
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980126,
					"content": "Of, üzgünüm. Tüm bu iç karartıcı konuşmaları dinlememeli, bunun yerine zaferini kutluyor olmalıydın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980127
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980127,
					"content": "Hım... Sana Karamelize Soslu Rosto ısmarlamak için seni dışarı çıkaracağıma söz vermiştim, değil mi? Hepimiz Fırtına Dehşeti krizine yakalanmadan önce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980128
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980128,
					"content": "Anı yaşamak gibisi yok değil mi? Millet! Siz aç mısınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980129
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980129,
					"content": "Hem de nasıl! Belki sen şu ana kadar unutmuş olabilirsin ama bunca zamandır Paimon'un hiç aklından çıkmadı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3980130,
					"content": "Harika, haydi gidelim! Karamelize Soslu Rosto yemeyeli çok uzun zaman oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980131
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980131,
					"content": "<color=#00E1FFFF>Avcının Yeri'nde</color> beni bekle. Hemen geliyorum, burayı çabucak temizlemem gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980121,
					"content": "Neden dağ yabanileri bunu yapsın ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980122
					]
				},
				{
					"id": 3980122,
					"content": "Biliyorum, bu garip. Dağ Yabanileri genellikle böyle eş zamanlı hareket edemezler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980123
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980108,
					"content": "Güven bana, bu çok sık isteyebileceğin bir fırsat değil...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980109
					]
				},
				{
					"id": 3980109,
					"content": "Aslında haklısın. Barış zor kazanılıyor ve bunu hafife almamalıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980110
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3980110,
					"content": "Ve bu sefer, hepimizin minnettar olması gereken kişi sensin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980111
					],
					"speakerTitle": "Amber"
				}
			]
		},
