			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Grace"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980201,
					"content": "Yani Fırtına Dehşeti'nin gerçek kimliği Dvalin, Dört Rüzgardan birisi! Mondstadt için yaptığı fedakarlığı asla unutmamalıydık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980202
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 3980202,
					"content": "Her bulutun bir umut ışığı var, şanslıyız ki Doğu'nun Ejderi ile olan ilişkimiz düzeltilemeyecek kadar bozulmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980203
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 3980203,
					"content": "Bunun için sana teşekkür etmeliydik. Ve Jean'e de, bitmek bilmez bağlılığı için.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980204
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 3980204,
					"content": "Favonius Şövalyeleri bizimle olduğu sürece, Mondstadt'ta barış ve özgürlük hep üstün gelecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				}
			]
		},
