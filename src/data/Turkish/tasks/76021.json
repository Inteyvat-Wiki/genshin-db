			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ilmari"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760210401,
					"content": "Bugün de elim boş dönüyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210402,
						760210405,
						760210412,
						760210417,
						760210421
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210402,
					"content": "Burada ne yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760210403
					]
				},
				{
					"id": 760210403,
					"content": "Balık tutuyorum. Gerçi balık dışında her şeyi yakaladım herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210404
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210404,
					"content": "Gemi enkazlarından çıkan ıvır zıvır olsa yine işime yarardı, gezgin tüccarlara falan satardım. Bir keresinde bir çizme tutmuştum mesela, yarısına kadar... Of, boş verin. Susayım da balıklar korkup kaçmasın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210405,
					"content": "Yakınlarda dikkate değer bir şeyler var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760210406
					]
				},
				{
					"id": 760210406,
					"content": "Yine mi hazine avı? \"Büyük Hazine\"nin ayın doğusunda ve güneşin batısında olduğu söylenir... Doğru yerde olmadığınız belli oluyordur herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210407
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210407,
					"content": "Bu sularda birçok gemi enkazı var. Dalgaların altında hazine olabilir ama ona ulaşmanın kolay olacağını sanmam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210408
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210408,
					"content": "Bir keresinde handa da o tarz bir şey duymuştum, batan gemilerinden kurtulan denizciler anlatıyordu. O gece ay görünmemesine rağmen dalgaların arasında parlayan bir şey varmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210409
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210409,
					"content": "Bunun ayı bile yutabilecek kadar heybetli bir canavar olan tek gözlü Kratti olduğuna yemin ediyorlardı. Dev bir deniz yılanının bölgesini ele geçirmek için onunla savaşıyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210410
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210410,
					"content": "O günden sonra okyanusun bu kısmı uzun bir süre boyunca tamamen karanlığa gömüldü. Hiçbir gemi buradan geçmeye cesaret edemiyordu. Herkes dalgaların altındaki kayıp ruhların onları derinlere sürükleyeceğinden korkuyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210411
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210411,
					"content": "Belki de o ruhlar hâlâ buralarda dolaşıyordur, kim bilir? Ben göremiyorum sonuçta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210412,
					"content": "O ağaç hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760210413
					]
				},
				{
					"id": 760210413,
					"content": "Bu ağaç lanetli. Eskiden burada bir girdap vardı, denizciler ona Kratti'nin Gözü derlerdi. Sonra bir gün bu ağaç tam da girdabın ortasından büyümeye başladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210414
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210414,
					"content": "Ama o zamanlar yaşanan tek garip olay bu değildi. Şimdi düşünüyorum da, her şey o kayalar gökyüzünden düştükten sonra başladı... Kim bilir? Belki bu ağaç da onlarla aynı yerden gelmiştir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210415
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210415,
					"content": "Bir de arada bir görünen şu parlak küçük şeyler var. Çok nadir rastlanır onlara. Ben de belki farklı balık türleri gelmiştir diye düşünüp şansımı denemeye geldim buraya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210416
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210416,
					"content": "Eskiden birlikte balık tuttuğum bir arkadaşım vardı. Sürekli tuhaf şarkılar duyduğunu söylüyordu. O kadar korktu ki bir daha hiç gelmedi. Hah, aslında sadece yarı Donuk Ayın Çocuğu ama nasıl olduysa tuhaf huyları tamamen onlara çekmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210417,
					"content": "Bilginliğin İspatları hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760210418
					]
				},
				{
					"id": 760210418,
					"content": "\"Bilginliğin İspatları\", ayın doğusunda ve güneşin batısında yatan \"Büyük Hazine\"... Bana soracak olursan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210419
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210419,
					"content": "Açgözlülükle başkalarının malının peşine düşenler nadiren iyi bir sona ulaşır. Atlas'ı ele alalım mesela. Duyduğuma göre Kaptan Grettir tüm o hazine muhabbetlerinden büyülenmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760210420
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210420,
					"content": "Sonunda da kaderi denizin dibinde son bulmuş. Hazineyi de mezara falan götürmemiş yani. Boşuna o kadar çabalamış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760210421,
					"content": "Kusura bakma, rahatsız ettim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760210422
					]
				},
				{
					"id": 760210422,
					"content": "Sorun değil. Zaten balık malık geldiği yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				}
			]
		}
	]
}