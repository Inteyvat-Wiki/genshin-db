						706960202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706960202,
					"content": "Onları Ruhyakanlar Lejyonunun kampındaki kitaplığın yanına koyalım. Böylece herkes kolayca göz atabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706960203,
					"content": "Bir kitaplık ödünç alıp Miko'nun çizgi romanlarını raflara yerleştiriyorsun.",
