			"dialogs": [
				{
					"id": 706960101,
					"content": "Merhaba ufaklık. Bu ne hoş bir sürpriz böyle. Son zamanlarda nerelere seyahat ettin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960102
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960102,
					"content": "Miko'ya Minnie'yi, Ruhyakanlar Lejyonunu ve Ejdersırtı Kros Yarışını anlatıyorsun.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706960103
					]
				},
				{
					"id": 706960103,
					"content": "Yaa. Hepsi pek sevimliymiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960104
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960104,
					"content": "Kafa dengi arkadaşlarıyla buluşmak için dünyanın dört bir yanından sınırları aşıp gelmek onlar için büyük bir macera olmuştur... Ah, gençlik romantizmiyle dolu bir hikaye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960105
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960105,
					"content": "Ruhyakan Destanı'nın oldukça kuvvetli bir takipçi kitlesi var anlaşılan. Belki yeni baskılar çıkarmanın zamanı gelmiştir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960106
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960106,
					"content": "Bu kadar sadık bir hayran kitlesi varken onlara minnettarlığımızı göstermemiz gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960107
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960107,
					"content": "Ücretsiz çizgi roman mı versek? Hımm... Oldukça kalabalık bir grupsunuz, herkese yetecek kadar olduğundan emin olmalıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960108,
						706960109
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960108,
					"content": "Teşekkürler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706960110
					]
				},
				{
					"id": 706960110,
					"content": "Bunlar ilk baskı bu arada. Hiçbir yerde bulamazsın yani. Onlara gözün gibi bak, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 706960109,
					"content": "Bunları herkesle paylaşacağım, merak etme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706960110
					]
				}
			]
		},
