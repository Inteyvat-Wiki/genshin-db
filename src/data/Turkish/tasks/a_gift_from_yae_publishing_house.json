			"dialogs": [
				{
					"id": 706960201,
					"content": "Miko bize oldukça cömert bir çizgi roman koleksiyonu verdi. Madem bunları grupla paylaşacağız, o halde herkesin görebileceği bir yerde sergilemesek mi?",
					"roleType": "TALK_ROLE_NPC",
