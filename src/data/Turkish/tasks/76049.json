				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Küçük Hanım"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2130.918,
							108.955,
							11206.71
						],
						"pointId": 360300003
					}
				]
			},
			"dialogs": [
				{
					"id": 760490101,
					"content": "... Hımm, belki de yarım adım fazla ileri gittim. Hadi tekrar deneyelim, olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490102
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760490102,
					"content": "Selam Columbina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490103,
					"content": "Bir dakika, sen... Kuuhenkilere lir çalmayı mı öğretiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490104,
					"content": "Evet. Onarılmasına o kadar sevindiler ki, neredeyse yanımdan hiç ayrılmadılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490105
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760490105,
					"content": "Gerçi lir çalmak benim güçlü yanım olmadı hiç. Ben daha çok başkalarının çalmasını dinlemeye alışkınım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490106
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760490106,
					"content": "Ha, demek öyle! Bir grubun olsaydı kesinlikle vokalde olurdun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490107,
					"content": "#Ancak enstrümanlara gelince... {NICKNAME} bir dahi sayılır! Lirden tut da Juju Davuluna kadar eline aldığı her şeyi çalabilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490108,
						760490109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490108,
					"content": "Herkes kadar işte...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490110
					]
				},
				{
					"id": 760490110,
					"content": "Öyle mi? Bu durumda... Belki onlara öğretebilirsin, ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490111,
						760490112
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760490111,
					"content": "Tabii, neden olmasın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490113
					]
				},
				{
					"id": 760490113,
					"content": "Genelde söylediğim şarkıyı çaldırıyordum onlara. Belki hatırlıyorsundur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490114
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760490114,
					"content": "Veya... Farklı bir melodi de olur. Kuuhenkiler başka yerlere ait müzikleri pek dinleme fırsatı bulamıyor. Ben de dinlemeyi çok isterim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490115
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760490115,
					"content": "(Hımm, ne çalsam acaba...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490202,
						760490801
					]
				},
				{
					"id": 760490202,
					"content": "Columbina'nın hep söylediği şarkıyı deneyelim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490201
					]
				},
				{
					"id": 760490201,
					"content": "(Acaba nasıl bir tonda çalsam...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490603,
						760490701
					]
				},
				{
					"id": 760490603,
					"content": "Sakin ve nazik bir tonda çalmayı deneyeyim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490604
					]
				},
				{
					"id": 760490604,
					"content": "Çok güzeldi. Gerçekten de şarkımı ezberlemişsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490605
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760490605,
					"content": "Hehe, sadece çok güzel söylediğin için! Sesini duyduğumuzda, sadece dinlemek için durduğumuz oluyor bazen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490606,
					"content": "Kuuhenkiler de performansından oldukça etkilenmiş görünüyorlar. Belki birkaç şey öğrenmişlerdir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490607
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760490607,
					"content": "Gelecekte onlara bir şeyler öğretmen için yine yardımına ihtiyacım olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490608
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760490608,
					"content": "Al hadi, elini uzat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490609
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760490609,
					"content": "Ha? Hayır hayır, bu ücretsiz bir performanstı. Eğitim ücreti gerekmiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490610,
					"content": "Hım? Eğitim ücreti mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490611
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760490611,
					"content": "Ben sadece... Ay ışığının nazik parıltısının böylesine güzel bir melodiye çok yakışacağını düşündüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760490701,
					"content": "Neşeli bir tonda çalalım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490702
					]
				},
				{
					"id": 760490702,
					"content": "Aa, bitti mi hemen? Sonsuza kadar dinleyebilirdim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490703
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760490703,
					"content": "Daha önce de söylediğim gibi, hatırladığım tek ninni bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490704
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760490704,
					"content": "Anlamını henüz tam olarak anlamamış olsam da senin çalışını dinledikten sonra ayda beni bekleyen cevap her ne ise... En azından güzel bir şey olmalı gibi hissediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490705
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760490705,
					"content": "Bana elini ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490706
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760490706,
					"content": "Sorun değil. Cidden, bize karşılığında bir şey vermene gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490707,
					"content": "Ah, niyetim o değildi... Sadece melodini nazik bir ay ışığıyla süslemek istedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760490801,
					"content": "Başka bir ulustan bir şey deneyelim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490802
					]
				},
				{
					"id": 760490802,
					"content": "Ne ilginç... Daha önce buna benzer melodiler duymuştum, ancak senin çalman bambaşka bir boyut katıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490803
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760490803,
					"content": "#Belki de {NICKNAME} o yere olan duygusal bağını yansıttığı için...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490804,
					"content": "Ne ilginç... Sadece melodiyi dinleyerek manzarayı gözümde canlandırabiliyorum. Acaba gerçekte nasıl bir yer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490805
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760490805,
					"content": "Bir gün mutlaka gidip görmelisin! Sana rehberlik edebiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490806,
					"content": "Evet... Belki. Eğer öyle bir gün gelirse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760490112,
					"content": "Ama ne çalacağım?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490113
					]
				},
				{
					"id": 760490109,
					"content": "Arada deniyorum bir şeyler...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490110
					]
				}
			]
		},
