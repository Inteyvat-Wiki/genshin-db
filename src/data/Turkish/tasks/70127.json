			"dialogs": [
				{
					"id": 701270101,
					"content": "\"Bu mesajı okuyorsan umarım sen, beklediğim kişisindir.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270102
					],
					"speakerTitle": "Sürüklenen Şişe"
				},
				{
					"id": 701270102,
					"content": "\"Bunun kaçıncı mektup olduğunu unuttum. Acaba daha ne kadar gidip hangi kıyıya varacak?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270103
					],
					"speakerTitle": "Sürüklenen Şişe"
				},
				{
					"id": 701270103,
					"content": "\"Tekrar karşılaşacak olursak taştan dağ şehrinden ve kuzeyin kar fırtınalarından yine bahset. Ya da karahindibadan ve şaraptan da bahsedebilirsin, ne dersin?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270104
					],
					"speakerTitle": "Sürüklenen Şişe"
				},
				{
					"id": 701270104,
					"content": "\"Her zaman olduğu gibi yanıtını bekleyeceğim.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sürüklenen Şişe"
				}
			]
		},
		{
			"id": 7012702,
			"completionStepIds": [
				7012702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 701270201,
					"content": "\"Bu mesajı okuyorsan umarım sen, beklediğim kişisindir.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270202
					],
					"speakerTitle": "Sürüklenen Şişe"
				},
				{
					"id": 701270202,
					"content": "\"Bir zamanlar savaşın yalnızca peri masallarında ve efsanelerde olduğunu düşünürdük ama artık hepimiz Ekselanslarının kükreyen öfkesi karşısında titriyoruz.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270203
					],
					"speakerTitle": "Sürüklenen Şişe"
				},
				{
					"id": 701270203,
					"content": "\"Eskiden gittiğimiz kumsal mühürlendi ama yine de bu mektubu göndermenin bir yolunu buldum.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270204
					],
					"speakerTitle": "Sürüklenen Şişe"
				},
				{
					"id": 701270204,
					"content": "\"Endişelenme ya da bunun için kendini suçlama. Bir zamanlar yanında seyahat etmiş benim gibi biri için önemsiz bir iş.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701270205
					],
					"speakerTitle": "Sürüklenen Şişe"
				},
				{
					"id": 701270205,
					"content": "\"Tek bir kelime yazsan bile yanıtını bekleyeceğim.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sürüklenen Şişe"
				}
			]
		}
	]
}