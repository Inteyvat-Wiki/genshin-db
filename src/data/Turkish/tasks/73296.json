				},
				{
					"id": 732961402,
					"content": "Fakat ne yazık ki savaş veya aşçılık becerim hiç yok. Benim gibilere \"şehir çocuğu\" diyorlar sanırım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
