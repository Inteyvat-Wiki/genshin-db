				},
				{
					"id": 732961602,
					"content": "Anlaşılan bu yine de Julien'a biraz fazla geldi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732961603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732961603,
					"content": "Şey, ben... Daha yeni iyileştim... *nefes nefese kalır*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732961604
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732961604,
					"content": "Ama buradaki manzaraların gerçekten eşi benzeri yok. Bunu daha önce fark etmemiş olmam ne garip...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732961605
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732961605,
					"content": "İleride de çok güzel manzaralar var. Oraya gidelim. Dikkatli ol ama, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
