			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732960201,
					"content": "#Paimon, {NICKNAME}, gelmişsiniz! Ah, dışarıda maceradayken arkadaş gerekiyor insana gerçekten de.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960202
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960202,
					"content": "Ee, sana yolu göstermeyi kabul ettik sonuçta, değil mi? İnsanlara rehberlik etmek bizim için çocuk oyuncağı! Her ne kadar çölde yürüyecek olsak da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960203,
					"content": "Peki Fontaine'e hemen dönmek istediğine emin misin? Ne de olsa bunca yolu katedip Sumeru'ya geldin. Burada daha görecek çok şey var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960204,
						732960206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960204,
					"content": "Yağmur ormanında güzel manzaralar var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960205
					]
				},
				{
					"id": 732960205,
					"content": "Birçok ağaç ve nehirler var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960208,
					"content": "Hepsi kulağa çok hoş geliyor tabii ama ben... Yola çıkmak için gerekli hazırlıkları yapmadım. Bu yolculuk bir başarısızlık olabilir ama en azından bir iki şey öğrendim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960209
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960209,
					"content": "Ah, şey... O halde yakınlarda da görülecek çok şey var! Bunları kaçırırsan çok yazık olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960210,
					"content": "Paimon'un tavsiyeleri asla şaşmaz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960211
					]
				},
				{
					"id": 732960211,
					"content": "Madem ısrar ediyorsunuz... Reddetmek kabalık olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960212
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960212,
					"content": "Hehe. Paimon Teyvat'ın bir numaralı rehberidir, rehberliği Paimon'a bırak! Hızımıza ayak uydurmaya çalış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960206,
					"content": "Çölde güzel manzaralar var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960207
					]
				},
				{
					"id": 732960207,
					"content": "Göz alabildiğine kumlar ve harabeler var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960208
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7329603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
