			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732960401,
					"content": "Burası doğanın kokularıyla dolu! İnsanın çizim yapası gelmiyor mu? İlham almış hissetmiyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960402,
					"content": "İşte klişe dediğin budur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960403
					]
				},
				{
					"id": 732960403,
					"content": "Şey... Ama gerçekten Paimon'un eline fırça alası geldi! Burası o kadar yaşam dolu, renkler o kadar canlı ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960404,
					"content": "Öhöm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960405
					]
				},
				{
					"id": 732960405,
					"content": "Ha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960406,
					"content": "Paimon özür diliyor... Paimon o anlamda demedi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960407,
					"content": "Haha, sorun yok. Ben farklı bir şey görüyorum sadece. Ama sonuçta ikimiz de bakınca güzel bir şey görüyoruz, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960408
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960408,
					"content": "Doğru! Paimon burayı çok seviyor. Kalbi ve ruhu arındırıyor sanki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960409,
					"content": "Senin kalbin ve ruhun zaten temiz Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960410
					]
				},
				{
					"id": 732960410,
					"content": "Dostlarım, en başından doğruyu söylememiş olmama rağmen bana gösterdiğiniz samimiyet için size çok minnettarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960411
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960411,
					"content": "Gerçekten temiz kalplisiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960412
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960412,
					"content": "Hehe... O kadar da abartmaya gerek yok şimdi. Ah, bundan daha güzel manzaralar da var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960413,
					"content": "#Paimon'un nereden bahsettiğini anlamışsındır {NICKNAME}. Hadi Julien'a da gösterelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
