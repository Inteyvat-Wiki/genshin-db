			]
		},
		{
			"id": 7329608,
			"completionStepIds": [
				7329608
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329608",
							"2"
						],
						"stepId": 7329608,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732960801,
					"content": "Nasıl? Çok güzel değil mi? Tarçın da çok mutlu görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960802,
					"content": "Karşımdaki güzelliği anlatmaya kelimeler kifayetsiz. Tırtıl haklıymış. Metal kutumun dışında devasa bir dünya varmış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960803
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960803,
					"content": "Metal kutu mu? Fontaine'de çok küçük bir yerde yaşadığını söylemiştin, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960804,
					"content": "Öhöm. Sumeru'da görülecek çok yer var, öyle değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960805
					]
				},
				{
					"id": 732960805,
					"content": "Ah, evet, doğru! Julien düzgün bir sanatçı olmaya karar verdiğine göre manzarayı değiştirip... Ne deniyordu... Hah, ufkumuzu genişletelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960806,
					"content": "Pes etmek istediğini söylemiş olabilir ama Paimon henüz erken olduğunu düşünüyor! Fikrini değiştirmen için vakit var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960807,
					"content": "İyi düşün Julien! Bunun gibi başka muhteşem manzaralar, hatta daha da muhteşem manzaralar olabilir. Daha önce hiç görmediğin yerleri bir düşün! Belki aradığın ilhamı oralarda bulursun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960808,
					"content": "Renk algın konusunda da... Kendin dedin ya işte! Sadece \"farklı şeyler görüyoruz\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960809,
					"content": "Ama ikimiz de bakınca güzel bir şey görüyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960810
					]
				},
				{
					"id": 732960810,
					"content": "Değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960811,
					"content": "Evet... Söylediklerinde haklısın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960812
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960812,
					"content": "Bunlar senin sözlerin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960813,
					"content": "Demek... Hahaha, farkındaymışım demek ki. Farkındaymışım, ama yanlış yolda yürümeye devam etmişim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960814
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960814,
					"content": "Tarçın seni buraya getirmemiş olsaydı tanışamazdık, değil mi? O yüzden buraya \"yanlış yol\" demek doğru olmaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960815,
					"content": "Gerçi Okeanidlerin kutsal yolunu bulmana yardımcı olamadığımıza üzüldü Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960816,
					"content": "Öyle bir yol gerçekten var mı ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960817
					]
				},
				{
					"id": 732960817,
					"content": "Bence var ama... Onu bulmak için becerimin veya daha ziyade beceriksizliğimin önemsiz olduğuna karar verdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960818
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960818,
					"content": "Sonuçta aradığım cevabı buldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960819
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960819,
					"content": "Teşekkür ederim dostlarım. *iç çeker* Size minnettarlığımı nasıl gösterebilirim ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960820
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960820,
					"content": "Keşke şu gizemli kuş yumurtalarından alsaydım... Kötü talihi kovabilen büyülü bir eşya sizin gibi maceracıların çok işine yarardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960821,
						732960823
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960821,
					"content": "Yazık olmuş, evet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960822
					]
				},
				{
					"id": 732960822,
					"content": "#Bir dakika, öyle bir şeyin gerçek olduğuna inanıyor musun {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732960825,
					"content": "Ben bir süre daha burada kalacağım. İnsanın ruhunu dinlendiriyor burası. Düşüncelere dalmak için ideal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960826
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960826,
					"content": "Bu sefer biraz daha farklı bir şey çizebileceğimi hissediyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960827
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960827,
					"content": "Teşekkür ederim size dostlarım. Umarım yolculuğunuz güzel geçer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julien"
				},
				{
					"id": 732960823,
					"content": "Olabilir, ama gerekli değil bence.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960824
					]
				},
				{
					"id": 732960824,
					"content": "Neden ki? Kötü talihi kovamasa bile belki... Belki normal yumurtadan yüz kat daha lezzetlidir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960825
					],
					"speakerTitle": "Paimon"
				}
			]
		},
