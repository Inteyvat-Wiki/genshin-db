			"dialogs": [
				{
					"id": 732960601,
					"content": "Önce hazırlık yapmamız lazım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960602
					]
				},
				{
					"id": 732960602,
					"content": "Tamam. Hazır olunca gideriz!",
					"roleType": "TALK_ROLE_NPC",
