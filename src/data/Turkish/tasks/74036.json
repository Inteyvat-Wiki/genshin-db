			"dialogs": [
				{
					"id": 740360301,
					"content": "Tamam! Tüm damgaları bastık, belgeyi ciltleyip zımbaladık, artık Bay Difor'a teslim edip kurtulabiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360302
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360302,
					"content": "Bu gece bebekler gibi mışıl mışıl uyuyacağım ve yaşadığımız bu kabusu unutacağım. Yarın da bir gün izin alıp Estelle'e gideceğim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360303
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360303,
					"content": "Bay Iaune, bir dakikanız var mıydı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360304
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740360304,
					"content": "Tabii, ne oldu? Geri ödeme bu kadar hızlı onaylanmamıştır herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360305
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360305,
					"content": "Yok, o değil de... Mösyö Neuvillette birini yolladı, o da gelip size bir şey sormamı istedi... Neden daktilonun tamamını değil de sadece bir tane tuşunu masraf gösterdiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360306
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740360306,
					"content": "Çünkü... E yani sadece bir tane tuş kayboldu da ondan! Neden yeni bir daktilo aldırayım ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360307
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360307,
					"content": "Hım, mantıklı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740360308,
					"content": "Olabilir, fakat durum şöyle ki, tazmin edilebilir kalemler listemizde daktilo var ama tekli daktilo tuşu yok. Dolayısıyla daktilo tuşu yeni bir ödeme kalemi sayılıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360309
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740360309,
					"content": "O nedenle Mösyö Neuvillette'e bir yazı gönderip neden yalnızca tek bir tuşu masraf gösterdiğinizi ayrıntılı biçimde açıklamanız gerekiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360310
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740360310,
					"content": "Bu iş iyice eşek şakası gibi gelmeye başladı, resmi devlet işleri gerçekten böyle mi yürüyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360311,
						740360312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740360311,
					"content": "Buna gerek var mı cidden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360313
					]
				},
				{
					"id": 740360313,
					"content": "Yani şimdi benden... Başyargıca ayrı bir rapor yazıp tek bir tuşu nasıl kaybettiğimi açıklamamı mı istiyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360314
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360314,
					"content": "Sayıştay Dairesi bu talebin bizzat Mösyö Neuvillette'ten geldiğini söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360315
					],
					"speakerTitle": "Cornelia"
				},
				{
					"id": 740360315,
					"content": "Kesin öyledir! Sayıştay Dairesi her şeye \"bizzat Mösyö Neuvillette'in talebi\" diyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360316
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360316,
					"content": "Ama kimse işin aslı öyle mi diye sorgulamaya cüret edemiyor. Haydi Iaune, sakin ol. Bak beni dinle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360317
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740360317,
					"content": "Hukuk Dairesinin bir Savcısı olarak Başyargıçtan gelen talepler yönetimin ağırlığını taşıyor ve bir emir olarak görülüyor. Kısacası o raporu yazmaktan başka çaren yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360318
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740360318,
					"content": "Kötü bir şey değil bu ama! Bu fırsatı kullanarak Mösyö Neuvillette'e el yazının güzelliğini gösterebilirsin. Kendisine özel bir yazılı rapor gönderme fırsatı herkese kısmet olmuyor sonuçta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360320
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740360320,
					"content": "Ama ben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360319
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360319,
					"content": "Eyvah...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360321
					]
				},
				{
					"id": 740360321,
					"content": "Merhaba arkadaşlar, haberler iyi! Kamerayla gizli bilgi sızdıran birini suçüstü yakaladık! Teklifte yer verebileceğimiz muhteşem bir negatif örneğimiz oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360322
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740360322,
					"content": "Yasaları bilen fakat buna rağmen göz göre göre çiğnemeyi tercih eden bu suçlu ise gizli bilgilerin ifşa edilmemesi için çalışanlara Kamera getirmemelerini öğütleyen Bay Carsix'den başkası değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360323
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740360323,
					"content": "O mu? Iaune onun yüzünden tüm gece uyanık kalıp teklifi bitirmekle uğraştı! Şimdi de kuralları çiğneyen ilk o çıktı, inanılmaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740360324,
					"content": "Kamera kullanarak ofisinin birkaç fotoğrafını çekmiş ve bu fotoğrafları gazetecilere dağıtmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360325
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740360325,
					"content": "Fotoğraflardan birinde kendi yazdığı toplantı notları görünüyormuş. Bunun sonucunda halk, Bay Carsix'nin toplantı notlarında yazanların konuşmalarında söylediklerinden son derece farklı olduğunu öğrenmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360326
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740360326,
					"content": "Söylentiler deli gibi yayıldı. Görünüşe göre Bay Carsix'nin ofisi Fontaine'de en büyük dalga konusu olacak... Yine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360327
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740360327,
					"content": "Bir dakika! Toplantı notlarının yaptığı konuşmayla ne ilgisi var ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740360328,
					"content": "Konuşmasında söylediği neredeyse her şey o toplantılarda belirleniyor. Tabii ki ilgisi olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360329
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740360329,
					"content": "Neden notlarla konuşma arasında bu kadar fark var peki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360330
					]
				},
				{
					"id": 740360330,
					"content": "E gayet normal. Toplantıların ve alınan notların amacı, Bay Carsix'nin konuşmasında yer alamayacak konuları belirlemek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360331
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740360331,
					"content": "Carsix'nin ne diyeceğine dair en ufak bir fikri yok, hatta kendine ait bir düşüncesi bile yok ki. Her şeyini ona bağlı çalışanlar yazıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360332
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740360332,
					"content": "E bir dakika, Bay Carsix nerede şu an?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360333
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360333,
					"content": "Kendisi soruşturulmak üzere ofisimde bekliyor. Sonuçta hem gizli belgeleri ifşa etti hem de şehirde epey gündem oldu... O ofisten bir süre çıkabileceğini sanmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360334
					],
					"speakerTitle": "Gattineo"
				},
				{
					"id": 740360334,
					"content": "Peki ya benim belgem? Yazmayı bitirdim, damgalattım, her şeyi hazır... Ben... *öksürük krizine girer*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360335
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360335,
					"content": "H-Hey, sorun değil, yazdın sonuçta. Eninde sonunda yayınlanacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360336,
						740360337
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740360336,
					"content": "Emeğin boşa gitmedi, merak etme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360338
					]
				},
				{
					"id": 740360338,
					"content": "Iaune! Iaune, burada mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360339
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740360339,
					"content": "Bay Semaine, nihayet geldiniz! Lütfen yardım edin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360340
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360340,
					"content": "Boş ver onu şimdi! Senin şu kayıp tuş vardı ya, masraf yazdırdın mı onu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360341
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740360341,
					"content": "Sizce? Hatta bizzat Mösyö Neuvillette'e raporunu bile yazmam gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360342
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360342,
					"content": "Hadi ya... Tüh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360343
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740360343,
					"content": "Şuna baksana bir. Kaybolan tuş bu mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360344
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740360344,
					"content": "Siz... Nerede buldunuz bunu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360345
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360345,
					"content": "Masamın altında. Temizlik personeli etrafı süpürürken yanlışlıkla benim masama doğru süpürmüş. Biri görüp masama koymuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360346
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740360346,
					"content": "Benim daktilomun tuşu sandım, o yüzden kenara koydum. Bugün bir baktım da... Daktilomda eksik tuş yokmuş meğer, o yüzden...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360347
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740360347,
					"content": "Bu kabus... Hiç bitmeyecek mi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360348
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360348,
					"content": "#{NICKNAME}, benim yaptığım bu işin anlamı ne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360349
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360349,
					"content": "Iaune bayılıp düşer...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740360350
					]
				},
				{
					"id": 740360350,
					"content": "Iaune? Iaune!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360351
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740360351,
					"content": "Iaune aceleyle doktora götürülür...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740360352
					]
				},
				{
					"id": 740360352,
					"content": "Ah ah, benim hatam! Tuşu daha erken fark etseydim işler bu raddeye gelmezdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360353
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740360353,
					"content": "Bu sorunun nedeni tuş mu sizce?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360354
					]
				},
				{
					"id": 740360354,
					"content": "Aynen! Her şey o kadar karmaşık ki. Iaune ne yapacağını bilemedi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360355
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740360355,
					"content": "Gattineo ve Difor da ortalıktan kayboldu... Nesi var bunların?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360356,
						740360357
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740360356,
					"content": "Iaune yaptığı işin anlamına önem veriyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360358
					]
				},
				{
					"id": 740360358,
					"content": "*iç çeker* O çocuk sürekli öyle şeyler düşünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360359
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740360359,
					"content": "\"İşin anlamı\"... Büyük bir konu. Öyle kolayca birkaç kelimeyle açıklanamaz ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360360
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740360360,
					"content": "Bu tür sorulara sürekli kafa yorarsan üzerindeki baskıyı daha da artırırsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360361
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740360361,
					"content": "E cevabı biliyor musun peki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360362
					]
				},
				{
					"id": 740360362,
					"content": "Hayır. Cevabını hiç düşünmedim. Çalışıyorum sadece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360363
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740360363,
					"content": "Benim arada bir düşündüğüm oluyor... Ama stresle başa çıkmak için kendi yöntemlerim var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360364
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740360364,
					"content": "Cevabı gerçekten bulmak istiyorsan belki bir ara vakit bulup konuşabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360365
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740360365,
					"content": "Ama şu an biraz meyve alıp ve Iaune'u ziyarete gitmem lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360366
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740360366,
					"content": "Şu an önemli olan konu bu. Bir de Iaune yerine hastalık iznine başvuracağım. Cidden dinlenmesi lazım biraz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360367
					],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740360367,
					"content": "E süper, herkesin bir görevi oldu. İşler böyle halledilir işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360368
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740360368,
					"content": "#O halde sonra görüşürüz {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360369
					],
					"speakerTitle": "Roialte"
				},
				{
					"id": 740360369,
					"content": "Hım? Garip... Hastalık izni formunu nereye koymuştum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Semaine"
				},
				{
					"id": 740360357,
					"content": "Iaune yaptığı işin anlamını bilmiyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360358
					]
				},
				{
					"id": 740360337,
					"content": "Lütfen sakin ol, bir yolunu buluruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360338
					]
				},
				{
					"id": 740360312,
					"content": "Biraz saçma geldi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360350
					]
				}
			]
