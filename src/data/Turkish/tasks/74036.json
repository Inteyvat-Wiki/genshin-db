					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360102,
					"content": "Iaune?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360104
					]
				},
				{
					"id": 740360104,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360105
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360105,
					"content": "Iaune!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360106
					]
				},
				{
					"id": 740360106,
					"content": "Hı? Ne? Evet evet, bitirdim, yazıyı bitirdim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360107
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360107,
					"content": "Benim ben! Yazıyı bitirdin mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360108
					]
				},
				{
					"id": 740360108,
					"content": "Ha, sen miydin... Ya ben... Uyuyakalmışım. Kusura bakma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360109
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360109,
					"content": "Bay Roialte ve Bay Semaine akşam benimle kaldılar. Onların rehberliği sayesinde teklifi bitirmeyi başardım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360110
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360110,
					"content": "Ama o kadar yoruldum ki azıcık gözlerimi dinlendireyim dedim, bu kadar uyuyacağımı düşünmüyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360111
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360111,
					"content": "Önce gidip Bay Thales'i bulmalıyım, bu teklifi Hukuk Dairesinin resmi mührüyle damgalaması lazım. Sonra Bay Difor'a gidip onun mührünü almalıyım, ondan sonra nihayet resmi olarak yazdırmaya başlayabiliriz... Nihayet kurtulacağız bu işten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360112,
						740360113
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360112,
					"content": "Kolaymış.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360114
					]
				},
				{
					"id": 740360114,
					"content": "Evet. Her neyse, Bay Thales'in mühür damgalamak için yeni bir makina getirdiğini duydum. Hem kolay hem de gizlilik dikkate alınarak tasarlanmış, öyle diyorlar. Tüm Hukuk Dairesinde kullanıma sunmayı planlıyorlarmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360115
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360115,
					"content": "Baksana, Bay Roialte bana anahtar verdi! Her departmanın damga makinasını etkinleştirmek için bu anahtarı kullanması gerekiyor... Neyse, çok resmi şeyler işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360116
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360116,
					"content": "Biraz daha mı uyusan acaba? Doğru düzgün yürüyemiyorsun bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740360117,
					"content": "Neyse, sadece bir belge damgalamamız gerekiyor. Damgayı vuran da makina olduğuna göre acele etmemize gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740360118,
					"content": "Hayır! Daha fazla gecikemeyiz. Hemen gidelim, dediğin gibi alt tarafı bir damga. Çok sürmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360113,
					"content": "Geçenki kadar karmaşık durmuyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360114
					]
				},
				{
					"id": 740360103,
					"content": "Yazmayı bitirdin mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360104
					]
				}
			]
		},
		{
