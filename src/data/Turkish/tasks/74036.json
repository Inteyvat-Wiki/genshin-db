			},
			"dialogs": [
				{
					"id": 740360201,
					"content": "Thales, belgelerimi damgalatabilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360202
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360202,
					"content": "Evet! Tabii ki. Anahtarı getirdin mi? Bir de lütfen şurayı imzala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360203
					],
					"speakerTitle": "Thales"
				},
				{
					"id": 740360203,
					"content": "Makina olduğuna göre imza atmamız gerekmez diye düşünmüştüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360204
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360204,
					"content": "Yani şimdi... Sonuçta makinayı birinin kullanması gerekiyor, o yüzden imza vermen lazım. Değil mi? Güvence olsun diye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360205
					],
					"speakerTitle": "Thales"
				},
				{
					"id": 740360205,
					"content": "Ama bu makina gizliliği korumak için kusursuz! Anahtar olmadan ben bile çalıştıramıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360206
					],
					"speakerTitle": "Thales"
				},
				{
					"id": 740360206,
					"content": "Belgeler şuraya konuluyor, doğru hizaladığına emin ol. Sonra anahtarı anahtar deliğine yerleştir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360207
					],
					"speakerTitle": "Thales"
				},
				{
					"id": 740360207,
					"content": "Şu bahsi geçen... Otomatik damgalama makinası bu mu? Ne kadar... Sıradan duruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740360208,
					"content": "Böyle mi? Şimdi anahtarı çeviriyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360209
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360209,
					"content": "Dur! Hiç kıpırdama, öyle bekle! Fotoğrafını çekeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360210,
						740360211
					],
					"speakerTitle": "Thales"
				},
				{
					"id": 740360210,
					"content": "Sızıntı riskinden korkmuyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360212
					]
				},
				{
					"id": 740360212,
					"content": "Bu makinaları ilk geliştirdiğimizde Bay Carsix özellikle bunun talimatını verdi. Belge damgalatmaya gelen herkesin fotoğrafını Kamerayla çekmemizi istedi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360253
					],
					"speakerTitle": "Thales"
				},
				{
					"id": 740360253,
					"content": "Şuraya geçmem lazım... Bu belge fotoğrafta çıkmamalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360213
					],
					"speakerTitle": "Thales"
				},
				{
					"id": 740360213,
					"content": "Geçenlerde biri Hukuk Dairesinde Kamera ile sızdırılan gizli bilgilere dair yeni bir belge yayınlanacağını söyledi. Ceza alan ilk kişi olmak istemem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360214
					],
					"speakerTitle": "Thales"
				},
				{
					"id": 740360214,
					"content": "#Biz dışarıda bekleyelim {NICKNAME}. Fotoğrafta görünürsek sonra kendimizi \"gizli bilgi sızıntısı\" gibi bir şeyin ortasında buluruz kim bilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360255
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740360255,
					"content": "Thales dikkatlice fotoğraf çeker...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740360215
					]
				},
				{
					"id": 740360215,
					"content": "... Tamamdır, fotoğrafı çektim. Lütfen makinayı başlat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360216
					],
					"speakerTitle": "Thales"
				},
				{
					"id": 740360216,
					"content": "Anahtarı döndürdüm ya işte! Niye çalışmıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360217
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360217,
					"content": "Yok artık! Daha yeni tamir ettim. Yine bozulmuş olamaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360218
					],
					"speakerTitle": "Thales"
				},
				{
					"id": 740360218,
					"content": "Thales makinayı incelemeye başlar...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740360219
					]
				},
				{
					"id": 740360219,
					"content": "Garip, bir sorun göremedim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360220
					],
					"speakerTitle": "Thales"
				},
				{
					"id": 740360220,
					"content": "Anahtarı çıkarıp tekrar taksan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360221
					]
				},
				{
					"id": 740360221,
					"content": "Tamam, hadi bakalım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360222
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360222,
					"content": "Iaune anahtarı çıkarır, tekrar takar fakat makina yine de çalışmaz...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740360223
					]
				},
				{
					"id": 740360223,
					"content": "Çalışmıyor Thales, bir şeyler yap!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360224
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360224,
					"content": "Belgeyi düzgün hizalamamış olabilir misin? İşaretli yerlere denk getirmen lazım. İçeride gizli tetikleme mekanizmaları var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360225
					],
					"speakerTitle": "Thales"
				},
				{
					"id": 740360225,
					"content": "Makinanın çalışmamasıyla belgenin bir ilgisi var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360226
					]
				},
				{
					"id": 740360226,
					"content": "Var tabii! Öyle olmasa makina, damgalanmayı bekleyen belgeler olduğunu nereden bilsin? Sonuçta otomatik bir makina. Ben kullanmıyorum ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360227
					],
					"speakerTitle": "Thales"
				},
				{
					"id": 740360227,
					"content": "Yahu, sabır... Tamam be, tamam! İşaretlere göre hizalayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360228
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360228,
					"content": "Iaune belgeyi çıkarıp tekrar yerleştirir. Makina hâlâ sessizdir...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740360229
					]
				},
				{
					"id": 740360229,
					"content": "Olmadı! Hâlâ çalışmıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360230
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360230,
					"content": "Nasıl ya? Gerçi geçen sefer böyle yaptığında şöyle hafif bir vurmuştum, çalışmıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360231
					],
					"speakerTitle": "Thales"
				},
				{
					"id": 740360231,
					"content": "Ben bir vurayım o zaman.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360232
					]
				},
				{
					"id": 740360232,
					"content": "Başka seçeneğimiz yok gibi. Herhalde bu işin sonu makina çalışsın diye dua etmeye doğru gidiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360233
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360233,
					"content": "Haklısın, dua edebiliriz. Değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360234
					],
					"speakerTitle": "Thales"
				},
				{
					"id": 740360234,
					"content": "(Makinaya hafifçe vur.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360235
					]
				},
				{
					"id": 740360235,
					"content": "(Makina karşılık olarak sessizliğini koruyor...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360236
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360236,
					"content": "(Hafifçe vuruşunun şiddetini biraz artır.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360237
					]
				},
				{
					"id": 740360237,
					"content": "(Makina, çabana karşılık vermeye üşenecek kadar tembel duruyor.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360238
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360238,
					"content": "(Makinaya yıllar boyu unutamayacağı bir tokat geçir!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360239
					]
				},
				{
					"id": 740360239,
					"content": "(Makina sessizliğini bozar ve sert, sinirli bir ses çıkarır. Çok uykusu olan biri yataktan düşmüş gibi...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360240
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360240,
					"content": "Aaa! Bu ses neydi? Makina tamamen bozuldu demeyin sakın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740360241,
					"content": "(... Sonra makina sanki uykulu uykulu terliklerini bulup giymiş ve ışığı açmaya gitmiş gibi, vızıltı ve gümbürtü sesleri çıkararak çalışmaya başlar.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360242
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360242,
					"content": "S-Sonunda çalıştı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740360243,
					"content": "Damgamatik biraz yorgun dursa da yavaş ve düzenli şekilde çalışır.\\nÇaresizliğin eşiğindeki birkaç kişinin yalvarırcasına bakışlarına rağmen makina damgayı yavaşça indirir, adeta yokuş yukarı tırmanan yaşlı bir Çadır Kaplumbağası gibidir. Kağıda ilk adımını atan damga, belgenin üzerinde bir süre duraksar, ardından yavaşça yerleşir ve nihayet işini tamamlar. Ardından makina titreyip sarsılarak damgayı usul usul geri çekmeye başlar...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740360244
					]
				},
				{
					"id": 740360244,
					"content": "Haha, işe yarar DEDİM ben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360245
					],
					"speakerTitle": "Thales"
				},
				{
					"id": 740360245,
					"content": "Bu makinanın nesi bu kadar süper anlamıyorum. Hesapta otomatik ama şunun işini elle yapsak çok daha hızlı olurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360246
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360246,
					"content": "Ama gizliliği korumak açısından mükemmel bir çözüm! Baksana etrafına. İstesek bile mührü alıp kendi amaçlarımız için izinsiz kullanamayız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360247
					],
					"speakerTitle": "Thales"
				},
				{
					"id": 740360247,
					"content": "Şöyle abartıp durma! Ya makina tamamen bozulursa ve Bay Carsix de burada olmazsa? O zaman ne yapacaksın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360248
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360248,
					"content": "Hımm... Sorun olmaz ki yine. Yedek anahtarım var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360249
					],
					"speakerTitle": "Thales"
				},
				{
					"id": 740360249,
					"content": "Makinayı açmak için mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360250
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360250,
					"content": "Hayır, Bay Carsix'nin ofisindeki bir kutuyu açmak için. Kutuda yedek mühür var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360251
					],
					"speakerTitle": "Thales"
				},
				{
					"id": 740360251,
					"content": "... Gezgin, acele edelim! Bay Difor'a teslim etmeden önce belgeyi ciltleyip zımbalamalıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740360252
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360252,
					"content": "Şu kabus bitsin istiyorum artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 740360211,
					"content": "Neden fotoğraf çekmek istiyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740360212
					]
				}
			]
		},
