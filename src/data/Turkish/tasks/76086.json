			"dialogs": [
				{
					"id": 760540301,
					"content": "Acaba... Böyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540302
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540302,
					"content": "Hımm, bir düşüneyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540303
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540303,
					"content": "Ha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540304
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540304,
					"content": "Aylar... Aylar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540305
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540305,
					"content": "Burası nasıl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540306
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540306,
					"content": "Bu turu ben kazandım gibi görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540307
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540307,
					"content": "Benim üç ayım bağlantılı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540308
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540308,
					"content": "Hım, böyle kazanıyor olmam lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540309
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540309,
					"content": "Hım... Aylar sonsuz bir döngüde büyüyüp küçülüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540310
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540310,
					"content": "Görünüşe göre her iki ay seti de tutulmayı reddediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540311
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540311,
					"content": "Yoksa... Berabere mi kalacağız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540312
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540312,
					"content": "Anladığım kadarıyla kararlarını vermeden önce dikkatlice tartıyorsun. Acele etme tabii, vaktimiz bol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540313
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540313,
					"content": "Aylarını gece göğüne nasıl yerleştireceğini mi unuttun? Yardım etmemi ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540314
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540314,
					"content": "Bu oyunu sevmiyor musun? Hımm... Bence oldukça eğlenceli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540315
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540315,
					"content": "Hım? Bana mı bakıyorsun? Pek gizlemiyorsun da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540316
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540316,
					"content": "Bana bakıyorsun... Ayların hakikati yüzümde mi yazıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540317
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540317,
					"content": "Bu arada, tahta şurada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540318
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540318,
					"content": "Hım, ayların hizalanmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540319
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540319,
					"content": "Gece göğü senin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540320
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540320,
					"content": "Aa... Bir yerde... Hata yapmış olmalıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540321
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540321,
					"content": "Columbina ile oyun oynarken harika zaman geçiriyorsun...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760540322
					]
				},
				{
					"id": 760540322,
					"content": "Teşekkürler, çok eğlendim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540323
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540323,
					"content": "Daha sonra... Ne zaman istersen bana eşlik edebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540324
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540324,
					"content": "Al bakalım, bunu sözümüzün bir nişanesi olarak kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Küçük Hanım"
				}
			]
		}
