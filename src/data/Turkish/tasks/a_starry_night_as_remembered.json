				]
			},
			"dialogs": [
				{
					"id": 790540101,
					"content": "Sen buraya neden geldin bakayım? Burada ray hattı yok ki. Hem burası Serap'ın tepesinde, en ücra köşelerinden birinde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540102
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540102,
					"content": "İnsanlar buraya nadiren uğrar. Idyia bile buranın varlığından haberdar olmayabilir hatta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540103
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540103,
					"content": "Burada hiçbir şey yoksa sen neden buradasın Jeroney?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540104,
					"content": "Biraz temiz hava almak için geldim... Bana öyle bakma yahu! \"Yine Ferdinand ile tartıştıktan sonra evden kaçıp buraya gelmişsin\" diye düşündüğün yüzünden okunuyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540105
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540105,
					"content": "Cidden diyorum, tartışmadık. Ben... Ne bileyim, canım istediği için bir gezintiye çıkayım dedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540106
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540106,
					"content": "Sanırım şu Çuf Çuf Vagon fikrinin bana ait olduğunu biliyorsunuz. O zamanlar aklımda tek bir şey vardı, yüksek bölgelere ulaşabilecek bir şey tasarlamak istiyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540107
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540107,
					"content": "O yüzden ben de... Yani Jeroney de göklere ve yüksekliklere olan sevgisi için Çuf Çuf Vagonu ve rayları üretme fikrini ortaya attı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540108
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540108,
					"content": "Saçma geliyor, değil mi? Inazuma'da ünlü bir deyiş vardır, \"Sadece aptallar ve duman böyle yüksekten uçabilir\" derler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540109,
						790540110
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540109,
					"content": "Çuf Çuf Vagon fikrini bulmuş olman harika.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540111
					]
				},
				{
					"id": 790540111,
					"content": "Ama sadece Veluriyam Serabı içinde var olabiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540112
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540112,
					"content": "Neyse, bu konuyu kapatalım. Buraya biraz da yıldızları seyretmek için gelmiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540113
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540113,
					"content": "Bu yıldızlar Serap'ın dışındaki yıldızların silik bir gölgesi, bunun farkındayım ama bana yetiyor da artıyorlar bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540114
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540114,
					"content": "Yıldızlı gecelerde gökyüzüne her baktığımda içimi bir huzur kaplıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540115
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540115,
					"content": "Peki yıldızlı gökyüzünü seven... Jeroney mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540116
					]
				},
				{
					"id": 790540116,
					"content": "Bu yıldızlı gökyüzünü kim görse hayran kalır gerçi. Keşke yıldızları gündüz de görebilsem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540117
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540117,
					"content": "Hatta keşke her gün buraya tırmanmak zorunda kalmasam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540118
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540118,
					"content": "Dur bir dakika! Bu gayet mümkün! Paimon'un bir fikri var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540119,
					"content": "Nasıl yani? Gerçekten mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540120
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540120,
					"content": "Bir fotoğraf çekelim işte...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540121
					]
				},
				{
					"id": 790540121,
					"content": "Foto... Fotoğraf mı? Gelişmiş bir teknoloji ürünü falan mı o?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540122
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540122,
					"content": "Evet, Jeroney için yıldızlı gökyüzünün bir fotoğrafını çekelim hadi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540123,
					"content": "Gerçekten bunu yapabilir misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540124
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540124,
					"content": "Tabii ki!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540125
					]
				},
				{
					"id": 790540125,
					"content": "İyi ama... Paimon yıldızlı gökyüzünün fotoğrafını çekmek için en güzel neresi olur bilmiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540126,
					"content": "Burası! Geceleri buradaki platformda yıldızların en güzel manzarasını görebilirsiniz! İlk önce buraya gelmemin sebebi de bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540127
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540127,
					"content": "Gerçekten mi? Harika! Jeroney, fotoğrafımızı bekle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540110,
					"content": "Bence çok eğlenceli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540111
					]
				}
			]
		},
