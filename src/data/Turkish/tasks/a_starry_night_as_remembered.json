			"dialogs": [
				{
					"id": 790540401,
					"content": "Fotoğraf... Böyle muhteşem bir şeyin icat edildiğine inanamıyorum. Artık tüm muhteşem manzaraları kaydedip saklamak mümkün demek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540402
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540402,
					"content": "#Şey, {NICKNAME}, fotoğraf çekme işi bitti mi? Yıldızların fotoğrafta nasıl çıktığını görmek için sabırsızlanıyorum!",
