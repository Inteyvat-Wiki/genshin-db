			"dialogs": [
				{
					"id": 790540301,
					"content": "Jeroney, biz geldik! Bak, işte fotoğraf! Gel de gör!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540302,
					"content": "Vay be... Kendi gözlerimle gördüğümün aynısı resmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540303
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540303,
					"content": "Bu fotoğrafı gerçekten bana mı veriyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540304
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540304,
					"content": "Tabii ki. Bunu senin için çektik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790540305,
					"content": "Haha, teşekkür ederim... Çok sağ olun. Böyle muhteşem bir cihaza şahit olacağım hiç aklıma gelmezdi. Teknoloji bu kadar geliştiyse belki bir gün Serap'ın dışında da bir Çuf Çuf Vagon inşa edebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540306
					],
					"speakerTitle": "Jeroney"
				},
				{
					"id": 790540306,
					"content": "Ne muhteşem bir gece manzarası... O zamanlarda elimizde böyle bir teknoloji olsaydı... O da istediği zaman bu güzel manzarayı görebilirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeroney"
				}
			]
		},
