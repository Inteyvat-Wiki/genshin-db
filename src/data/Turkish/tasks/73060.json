			"dialogs": [
				{
					"id": 730600201,
					"content": "Hiçbir şeyden korkmuyor gibisin Altın Nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600202
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730600202,
					"content": "Altın Nara cesur bir Nara. Tıpkı Nara Varuna gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600203
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600203,
					"content": "Arapandu, Dahri Harabeleri'ndeki Arabalika ve Düşler Korusu'ndaki Arakunti için endişeleniyor. Yine de Altın Naranın yardımıyla her şey düzelecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600204
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600204,
					"content": "Artık Varuna Mekanizması iyileştiğinde kötü niyetli kişiler fideliklere zarar veremeyecek. Aranakula buradaki çiçekleri ona vermek istiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				}
			]
		},
