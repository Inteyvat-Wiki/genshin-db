				{
					"id": 730600601,
					"content": "Yasna Abidesi'nde bir sürü kötü adam vardı ama Aranakula geri döndü. Güzel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600602
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730600602,
					"content": "Altın Nara, Aranakula'yla beraber kötülerden kaçtı ve Taş Hatırasını temizledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600603
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730600603,
					"content": "Varuna Mekanizması iyileştiğinde fidelikteki çiçekler geri gelecek. Aranaralar da unutmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600604
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730600604,
					"content": "Geriye sadece Düşler Korusu'ndaki Arakunti kaldı. Arakunti döndüğünde gidip Varuna Mekanizmasının köklerini kemiren kötü böceklerin icabına bakabiliriz...",
