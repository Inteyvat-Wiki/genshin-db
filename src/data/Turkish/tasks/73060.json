			},
			"dialogs": [
				{
					"id": 730600301,
					"content": "Arabalika'nın durumu iyi ama Yasna Abidesi'ndeki Aranakula ve Düşler Korusu'ndaki Arakunti için çok endişeleniyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600302
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600302,
					"content": "Aranakula... Etrafta çok fazla kötü mantar var. Eğer Aranakula tekrar yakalanırsa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600303
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600303,
					"content": "Fazla endişenin faydası olmaz. Altın Nara çok güçlü, o Büyük Demir Parçasını çürümüş bir ağacı deviren güçlü bir rüzgar gibi yıkıverdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600304
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730600304,
					"content": "Tek yapmamız gereken Varuna Mekanizmasını iyileştirmek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				}
			]
		},
