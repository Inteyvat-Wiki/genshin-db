			"dialogs": [
				{
					"id": 730600401,
					"content": "Düşler Korusu... Hafif bir melodi, suyun sesi, kuşların kanat çırpışları, dallara basınca gelen çıtırtı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600402
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730600402,
					"content": "Nara ve Paimon ile sohbet etmek... Paimon çok eğlenceli ama ne yazık ki Paimon tohuma dönüşmek istemiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600403
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730600403,
					"content": "Paimon Aranara değil de o yüzden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600404
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600404,
					"content": "Düşler Korusu artık iyi. Arabalika şu an Dahri Harabeleri'nde ama Arapandu onun için endişelenmiyor. Arapandu asıl Aranakula için endişeleniyor. Yasna Abidesi'nde çok Mantar var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				}
			]
		},
