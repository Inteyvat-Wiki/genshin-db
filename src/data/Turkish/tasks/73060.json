			"dialogs": [
				{
					"id": 730600501,
					"content": "Arabalika yakında Dahri Harabeleri'nden döner. Arabalika'nın Ararakalarisi varken Demir Parçaları ve Mantarlar kimseyi korkutamaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600502
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730600502,
					"content": "Aranakula, Arabalika'nın yarısı kadar güçlü olsaydı fideliği koruyabilirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600503
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730600503,
					"content": "Ne yazık ki Aranakula, Arabalika'nın gücünün çeyreğine bile sahip değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600504
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730600504,
					"content": "*ağlar*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730600505
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730600505,
					"content": "Aranakula da Altın Nara gibi cesur olabilir. Sadece zamana ihtiyacı var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
