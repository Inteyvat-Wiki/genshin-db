			"dialogs": [
				{
					"id": 745240401,
					"content": "Vaay, ufaklık. Bu ne tesadüf? Yoksa günlük programımı duydun da hemen koşup geldin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240402,
						745240403
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240402,
					"content": "Az önce Şogun'u görmeye mi gittin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240404
					]
				},
				{
					"id": 745240404,
					"content": "Burnun de pek hassasmış. Sadece dışarı çıkmayı çok sevmeyen bir arkadaşıma biraz atıştırmalık ve popüler resimli romanlar götürüyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240405
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240405,
					"content": "Ei de en son serileri takip ediyor mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240406
					]
				},
				{
					"id": 745240406,
					"content": "Dediğine göre \"Inazuma halkının eğlence ve boş zaman tercihlerindeki son değişimleri öğrenmek\" istiyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240407
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240407,
					"content": "Bu konuyu benimle de tartıştı. İlk başta sadece ciddi bir şekilde okuyucu tercihlerini analiz ediyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240408
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240408,
					"content": "... Ama çok geçmeden bana aniden şunu sordu: \"Peki sonunda o karaktere ne oldu?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240409
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240409,
					"content": "Hehe, görünüşe göre kudretli Ei Raiden bile heyecan verici bir hikayenin cazibesine karşı koyamıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240410,
						745240411
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240410,
					"content": "Az önce yüzündeki o ifade...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240412
					]
				},
				{
					"id": 745240412,
					"content": "Öyle mi? Buraya gelmenin asıl amacı bu mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240413
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240413,
					"content": "Bu fotoğrafları çekmek istediğine göre seyahatlerin sırasında beni çok özlemiş olmalısın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745240414
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240414,
					"content": "Çek o zaman. Ama açıları seçerken dikkatli ol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 745240411,
					"content": "... Gerçekten hatırlanmaya değer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240412
					]
				},
				{
					"id": 745240403,
					"content": "Tatlı bir koku alıyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745240404
					]
				}
			]
		}
	]
