				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730552501,
					"content": "... Ah, sen gelmişsin. Konuşmak istediğin başka bir şey mi var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552502,
						730552507,
						730552511
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552502,
					"content": "Jebrael hakkında konuşalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552503
					]
				},
				{
					"id": 730552503,
					"content": "Başından sonuna kadar ondan şüphelendiğime inanamıyorum. Çok kötü biriyim ben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552504
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552504,
					"content": "Artık ona karşı sadece şükran duyuyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552505
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552505,
					"content": "Daha önce ne akademide ne de hayatta kendimi bir şeye adayamamıştım... Bu burada son buluyor. Ne kadar zor olursa olsun, inandığım yolda yürüyeceğim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552506
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552506,
					"content": "Ona olan borcumu ancak böyle ödeyebilirim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552507,
					"content": "Kral Deshret hakkında konuşmak istiyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552508
					]
				},
				{
					"id": 730552508,
					"content": "Dürüst olmak gerekirse okuduğum makalelerin doğruluğundan şüphe etmeye başladım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552509
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552509,
					"content": "O dua... Tam olarak çözemediğim garip bir his uyandırıyor bende. Samail de aynı şekilde... Söylediği o sözler... Döndüğümde bunu daha detaylı araştırmalıyım sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552510
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552510,
					"content": "Elbette asıl hedefim en başta planladığım gibi makalemi yazmak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552511,
					"content": "Biraz Jeht hakında konuşalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552512
					]
				},
				{
					"id": 730552512,
					"content": "*iç çeker* Keşke ben de onun için bir şey yapabilsem ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552513
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552513,
					"content": "Yapamam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552514
					],
					"speakerTitle": "Tirzad"
				},
				{
					"id": 730552514,
					"content": "Ağzından laf almak mümkün değil. Ne istediğini söylese, ona yardım etmek için elimden gelen her şeyi yapmaya hazırım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tirzad"
				}
			]
		},
		{
			"id": 7305526,
