			"dialogs": [
				{
					"id": 730552701,
					"content": "Omid ve Mirsad nerede? Yoksa onlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552702
					],
					"speakerTitle": "Bonifaz"
				},
				{
					"id": 730552702,
					"content": "Merak etme, ikisi de iyi. Sadece... Başka planları var, bu yüzden artık bizimle çalışmayacaklar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552703
					],
					"speakerTitle": "Nachtigal"
				},
				{
					"id": 730552703,
					"content": "Ne? Biz ne yapacağız? İkimiz bütün işlerin altından kalkamayız ki. Daha fazla insanı işe almamız gerek! Ama kim Aaru Köyü'ne gelmek ister ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552704
					],
					"speakerTitle": "Bonifaz"
				},
				{
					"id": 730552704,
					"content": "Boş ver, bunu sonra konuşuruz. Neyse ki Cyrus da sağ salim döndü. Bir daha böyle tehlikeli bir yere gitmesine asla izin vermeyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552705
					],
					"speakerTitle": "Bonifaz"
				},
				{
					"id": 730552705,
					"content": "Sen neden bahsediyorsun? Bizler Yük Hayvanı tüccarlarıyız. Yük Hayvanlarımız çalışmazsa ne yer ne içeriz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552706
					],
					"speakerTitle": "Nachtigal"
				},
				{
					"id": 730552706,
					"content": "Rüzgarla öylece karnını doyuramazsın. Bunu yapabilsen bile, ağzını açtığında rüzgar yerine kum yiyeceğinden eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552707
					],
					"speakerTitle": "Nachtigal"
				},
				{
					"id": 730552707,
					"content": "Cyrus'un bu riski almasına izin veremeyiz. Oldukça güçlü görünüyorsun, neden malları bizim için taşımıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552708
					],
					"speakerTitle": "Bonifaz"
				},
				{
					"id": 730552708,
					"content": "?",
