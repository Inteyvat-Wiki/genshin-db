			},
			"dialogs": [
				{
					"id": 730552601,
					"content": "Özür dilerim... Hâlâ duygularımı kontrol etmekte güçlük çekiyorum da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552602
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 730552602,
					"content": "Özür dilemene gerek yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730552603
					]
				},
				{
					"id": 730552603,
					"content": "Evet... Zor bir dönemden geçtiğini biliyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730552604,
					"content": "Teşekkür ederim... Yolunuz açık olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730552605
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 730552605,
					"content": "Paimon, senin için de her şeyin yolunda gitmesini umuyor... Her şey düzelecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
