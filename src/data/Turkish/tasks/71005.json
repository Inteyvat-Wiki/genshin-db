			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710051201,
					"content": "\"Açgözlülük, nostalji, önsezi, kıskançlık, öfke, hırs, kendini egoya kaptırma, rekabet, telaş...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710051202
					],
					"speakerTitle": "Yazıt"
				},
				{
					"id": 710051202,
					"content": "\"Bu dokuz ölümlü arzusu dünyayı iyileştirebileceği gibi büyük zararlar da verebilir. Bunların alevi asla dinmez veya kaybolmaz... Bu nedenle, huzur getirmesi adına dokuz sütun dikerek dünyayı veba gibi sarmalayan çatışmalara son vermeyi amaçlıyoruz.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710051203
					],
					"speakerTitle": "Yazıt"
				},
				{
					"id": 710051203,
					"content": "\"Bizden sonra gelenler bu sütunları yıkıp içeriye girerse dünya tekrardan savaşa sürüklenecek.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710051204
					],
					"speakerTitle": "Yazıt"
				},
				{
					"id": 710051204,
					"content": "\"Ey bu tableti okuyan, buradaki hazineyi al ve Liyue'ye barış getir.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yazıt"
				}
			]
		},
