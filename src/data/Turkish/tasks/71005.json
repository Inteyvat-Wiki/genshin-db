			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bolai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710050301,
					"content": "Bu antikayı incelememize yardım eder misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050302
					]
				},
				{
					"id": 710050302,
					"content": "Antikalar mı? Pek anlamam ama bir bakayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050303
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050303,
					"content": "Bu yüzüğün... Üzerinde çok kaliteli bir yeşim cevheri var. Sırf cevher bile epey para eder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050304
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050304,
					"content": "Üzerine de bir yazı oyulmuş... \"Dünyanın dört bir köşesinde felaketler baş gösteriyor ve yaşayan herkes acı içinde...\" Bu yüzüğü nereden buldun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050305
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050305,
					"content": "Cuijue Yamacı'nın yakınında bir harabede.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050306
					]
				},
				{
					"id": 710050306,
					"content": "Cuijue Yamacı demek... Tüh, Jueyun Gölü de çok yakında halbuki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050307
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050307,
					"content": "Eğer bu yüzük Jueyun Gölü'ndeki bir harabeden gelseydi fiyatı cidden çok fazla olurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050308
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050308,
					"content": "Ne yazık ki kökeni hakkında bir hikaye olmayınca fiyat çok düşüyor ama yine de kalitesi çok yüksek. Eminim birileri yine de bu yüzüğü isteyecektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050309
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050309,
					"content": "Şöyle yapalım, ben sana bu yüzük için <color=#00E1FFFF>180.000 Mora</color> teklif edeyim, ek olarak birkaç şey daha eklerim. Sen de yüzüğü bana sat, olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
			]
		},
