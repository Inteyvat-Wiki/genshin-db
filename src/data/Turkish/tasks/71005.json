					"Linlang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710050901,
					"content": "Bu antikayı incelememize yardım eder misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050902
					]
				},
				{
					"id": 710050902,
					"content": "Antika mı? O zaman doğru kişiye geldin. Böyle şeylere fiyat biçme konusunda tüm Liyue'de en adil davranan benimdir diyebilirim. Bir bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050903
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050903,
					"content": "Hımm, hem değerli taş hem de yüzüğün kendisinin kalitesi iyi, oldukça antik bir yüzük... Bir de iyi saklanmış, oldukça alışılmadık bir durum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050904
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050904,
					"content": "Yine de bu cümleyi daha önce hiç duymamıştım \"Dünyanın dört bir köşesinde felaketler baş gösteriyor ve yaşayan herkes acı içinde.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050905
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050905,
					"content": "Onu boş verelim de, bu yüzüğü nereden buldun sen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050906
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050906,
					"content": "Cuijue Yamacı'nın yakınında bir harabede.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050907
					]
				},
				{
					"id": 710050907,
					"content": "Sen... Bu işin beceriklilerindensin değil mi? Orada hazine avına gidebilecek pek kişi yoktur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050908
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050908,
					"content": "Bu harabeler, ortasında duran bir taş tabletle beraber etrafı dokuz sütunla çevrilmiş olabilir mi acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050909
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050909,
					"content": "O kadar şaşırma. Benimle iş yapmaya gelen bir sürü insanın buradan bahsettiğini duymuştum. Böyle bir yerde kesin hazine de olacağını söylüyorlar hep.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050910
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050910,
					"content": "Hatta bu sütunların ve harabenin de çatışmayı hafifletmek için Liyue'nin ataları tarafından yapıldığı söylenir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050911
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050911,
					"content": "Ama sanırım bu yalnızca bir efsane. Sonuçta dokuz taş sütun çatışmaları yatıştırabilse tüm dünya uzun zaman önce barış içinde yaşamaya başlardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050912
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050912,
					"content": "Bu efsanenin doğru olup olmaması önemli değil, yüzük harabenin içinde bulunduysa efsaneyle bir alakası var demektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050913
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050913,
					"content": "Bir adı ve ardında yatan bir geçmişi var. Çok iyi bir fiyat verebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050914
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050914,
					"content": "... Rahat ol, oraya nasıl girdiğini sormayacağım. Ben sadece işime bakarım, diğer meseleler beni bağlamaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050915
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710050915,
					"content": "Her şeyi göz önünde bulundurunca <color=#00E1FFFF>200.000 Mora</color> eder. Ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				}
			]
		},
