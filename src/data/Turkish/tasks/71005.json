				"points": []
			},
			"dialogs": [
				{
					"id": 710050201,
					"content": "Bu harabe Paimon'u korkutuyor. Ama herhalde burası sonuncusu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710050202,
					"content": "Ayrıca çabalarımız sonucunda bir miktar hazine de bulduk. Şu yüzük mesela!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710050203,
					"content": "Hadi gidip <color=#00E1FFFF>antikalardan anlayan</color> birini bulalım da bunu kaça satacağımızı öğrenelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7100503,
