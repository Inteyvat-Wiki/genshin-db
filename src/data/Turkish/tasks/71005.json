					"nextDialogs": [
						710050402
					]
				},
				{
					"id": 710050402,
					"content": "Harika! Ne kadar da kararlı bir hareket. İşte para, hepsi senin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050403
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050403,
					"content": "Bu yüzük gerçek bir hazine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050404
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050404,
					"content": "Harabelerin arasında benzer cevherler de vardır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
			]
		},
