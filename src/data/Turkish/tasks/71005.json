			},
			"dialogs": [
				{
					"id": 710050501,
					"content": "Biraz düşüneyim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710050502
					]
				},
				{
					"id": 710050502,
					"content": "Sen... Neyse, tamam. Biraz düşün bakalım. Belki de teklifim şimdiye kadar aldıklarının en iyisi değildir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050503
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050503,
					"content": "Ama mevzu iş olunca yüzüğü bana satmaya karar verirsen haksızlık yapmam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050504
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050504,
					"content": "Bir düşün. Bu yüzüğün son durağı ben değilim. Şimdi bana satarsan sence ileride yapacağım işlemlerden seni haberdar etmez miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050505
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050505,
					"content": "Ayrıca başka şeyler eklemeye de varım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710050506
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 710050506,
					"content": "Etraflıca düşün ve satmaya karar verirsen tekrar bana gel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
			]
		},
