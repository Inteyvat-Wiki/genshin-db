			"dialogs": [
				{
					"id": 401300201,
					"content": "Pardon! Kimse var mı? Madam Destree'nin evi burası mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300202,
					"content": "Siz kimsiniz? Yatakta sessizce istirahat etmesi gereken bir hastam var. Acil bir durum yoksa lütfen bize müsaade edin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300203
					],
					"speakerTitle": "Jalacan"
				},
				{
					"id": 401300203,
					"content": "Hasta kim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401300204
					]
				},
				{
					"id": 401300204,
					"content": "Kısa bir sessizliğin ardından kapı açılır. Şaşkın gözlerle bir adam çıkar...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401300205
					]
				},
				{
					"id": 401300205,
					"content": "Burası Zuria Destree'nin evi. Ben de kendisinin aile doktoru Jalacan. Sorunuzla ne ima ettiniz. Başka kim olabilir hastam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300206
					],
					"speakerTitle": "Jalacan"
				},
				{
					"id": 401300206,
					"content": "Hastanız... Zuria'nın oğlu, değil mi? Oğlunun Yalnızlık Sendromuna yakalandığını söylemişti bize kendisi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300207,
					"content": "Yok haklısınız, genç efendi Lescot da bir zamanlar aynı hastalıktan muzdaripti ama... Genç efendi artık aramızda değil. Şimdi Madam da aynı hastalığa yakalandı. Siz... Kendisinin arkadaşları mısınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300208
					],
					"speakerTitle": "Jalacan"
				},
				{
					"id": 401300208,
					"content": "Doktora son birkaç günde yaşadıklarınızı anlatıyorsunuz...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401300209
					]
				},
				{
					"id": 401300209,
					"content": "Ha... Demek geçtiğimiz günlerde dışarı çıkmak için izin istemesinin sebebi sizinle vakit geçirmekmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300210
					],
					"speakerTitle": "Jalacan"
				},
				{
					"id": 401300210,
					"content": "Yanlış anlamadıysam... Kontrol edilemeyen sanrılar çeken kişi aslında Madam mı? Oğlunun hâlâ hayatta olduğunu mu düşünüyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300211
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300211,
					"content": "Evet. Genç efendiyi kaybettiğimiz gün Madam, onun için özel hazırladığı bir sanat sergisiyle uğraşıyordu. Ama o gün evden çıkması gerektiği için oğlunu son kez göremedi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300212
					],
					"speakerTitle": "Jalacan"
				},
				{
					"id": 401300212,
					"content": "Pişmanlığını bu olay tetiklemiş olabilir. Veya genç efendinin kaybından sonra ailenin yalnızlık ve kedere boğulması kaçınılmazdı belki de. Önce oğlu, sonra annesi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300213
					],
					"speakerTitle": "Jalacan"
				},
				{
					"id": 401300213,
					"content": "Ama nasıl... Her şey kontrolündeymiş gibi davranıyordu. Çok hoş gülümsüyordu, bize iyimser kalmamızı söyledi hatta. Şimdi siz diyorsunuz ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300214,
					"content": "Bu davranışları, artık kurguyu gerçekten ayıramadığının net bir göstergesi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300215
					],
					"speakerTitle": "Jalacan"
				},
				{
					"id": 401300215,
					"content": "O zaman... Oğluyla ilgili bize anlattıkları... Onlar da mı kurguydu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300216,
					"content": "Hayır, onlar gerçekti fakat genç efendi aramızdan ayrılmadan önce yaşandı hepsi. Oğlunu kaybettiğinden beri Madam tabiri caizse o günlerde takılıp kaldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300217
					],
					"speakerTitle": "Jalacan"
				},
				{
					"id": 401300217,
					"content": "Anladım, yani oğlunu kaybettikten sonra hâlâ beraber oldukları bir hayal dünyası yarattı. Bizimle karşılaştığında oğlunun hastalığına çare arıyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300218
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300218,
					"content": "Peki Zuria'nın durumu şu an nasıl?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401300219
					]
				},
				{
					"id": 401300219,
					"content": "Son birkaç gündür keyfi yerinde, hatta yürüyüşten döndükten sonra bir şarkı mırıldandı. Hastalığı hafifletmek için kasıtlı yönlendirme yöntemine başvurmayı konuşmaya başladık. Her şey yolunda gidiyordu fakat dün gece...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300220
					],
					"speakerTitle": "Jalacan"
				},
				{
					"id": 401300220,
					"content": "... Dün tüm geceyi genç efendinin ardında bıraktığı kabuğa ve üzerine kazıdığı sözcüklere bakarak geçirdi... Sonra yine çöktü. Biraz yatıştırıcı verdim, şu an dinleniyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300221
					],
					"speakerTitle": "Jalacan"
				},
				{
					"id": 401300221,
					"content": "Ama... Ne yapacağız o zaman şimdi? Ona nasıl yardım edebiliriz? Elimizden gelen bir şey olmalı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300222,
					"content": "Paniğe kapılma Paimon... Korkunç bir haber bu elbet ama önce sakinleşmeliyiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300223
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300223,
					"content": "(Ne yapsak? Düşüneyim... Eski Taş Yuva'yı hatırlamam, orada yaşayan çocukları düşünmem gerek... O hastalara doktorlar ne diyordu... Hah! Acaba...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300224
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300224,
					"content": "Dr. Jalacan, buralarda bir resimli kitap gördünüz mü? Madam yanında getirmiş olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300225
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300225,
					"content": "Hımm... Bana bahsettiği yönlendirme terapisini uygulamayı mı düşünüyorsunuz? Denemeye değer... Gidip getireyim kitabı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300226
					],
					"speakerTitle": "Jalacan"
				},
				{
					"id": 401300226,
					"content": "Doktor hızlıca kitabı getirip Freminet'ye verir.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401300227
					]
				},
				{
					"id": 401300227,
					"content": "Evet... Bu kitap işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300228
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300228,
					"content": "Macerayı bitirip resimli kitabı tamamlamamız mı gerek?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401300229
					]
				},
				{
					"id": 401300229,
					"content": "Evet. Dr. Jalacan'ın dedikleri doğruysa demek ki son birkaç gün Zuria'ya çok iyi gelmiş. O yüzden bu yolculuğu tamamlamalıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300230
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300230,
					"content": "Kurduğu hayal dünyasında çocuğunun mutlu bir sona ulaştığını göstermeliyiz ona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300231
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300231,
					"content": "Ama... O zaman gerçekliği kabul etmekte daha da zorlanmaz mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300232,
					"content": "İnsanın gerçekliği kabul etmesi için önce onunla yüzleşmesi gerekir. Madam, hissettiği kederin ağır yükünü sırtladığı için gerçeklikle yüzleşemiyor. Birincil önceliğimiz onu bu durumdan çıkarmak olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300233
					],
					"speakerTitle": "Jalacan"
				},
				{
					"id": 401300233,
					"content": "Doğru... Buraya gelene kadar Thelxie'nin Fantastik Maceraları'nı oğlunu kurtarmak için kullanmak istediğini sanıyordum. Şimdi düşününce asıl kendini kurtarması için ona ihtiyacı var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300234
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300234,
					"content": "Macerayı tamamlayabilirsek hem ona ilham verir hem de bu defteri kapatması için bir imkan sunabiliriz. Belki bunları hissederse gerçeklikle tekrar yüzleşecek cesareti bulabilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300235
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300235,
					"content": "Denememiz gerek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401300236
					]
				},
				{
					"id": 401300236,
					"content": "Boşa harcayacak vaktimiz yok... Hemen yola koyulalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freminet"
				}
			]
		},
