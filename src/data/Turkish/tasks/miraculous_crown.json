			"dialogs": [
				{
					"id": 401300501,
					"content": "İşte yine geldik... Thelxie'nin yolculuğunun son bölümündeyiz ama en önemli kişi eksik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300502,
					"content": "-.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300503
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401300503,
					"content": "Millet... Lütfen moralinizi bu kadar bozmayın. Bize dediğini unuttunuz mu? Biz üzgün görünürsek hasta da endişelenir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300504
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300504,
					"content": "Aa, haklısın, Paimon'un gülümsemesi gerek! Zuria'ya bir şey vereceksek tebessümlerimizi vermeliyiz! Bu macera bitene kadar gülümsemeye devam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300505,
					"content": "Böylece iyileşebilir, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300506,
					"content": "Kesinlikle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401300507
					]
				},
				{
					"id": 401300507,
					"content": "Evet, iyileşeceğine eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freminet"
				}
			]
		},
