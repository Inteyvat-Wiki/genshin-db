			},
			"dialogs": [
				{
					"id": 401300646,
					"content": "Üç gün sonra, Freminet'nin kampında...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401300647
					]
				},
				{
					"id": 401300647,
					"content": "#{NICKNAME}, Paimon... Hoş geldiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300648
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300648,
					"content": "Freminet! Niye aceleyle çağırdın bizi? Zuria'dan haber mi var? Off, iyi bir haber değilse Paimon duymak istemiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300649
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300649,
					"content": "Merak etmeyin, çok iyi bir haberim var. Madam bugün doktoruyla burayı ziyarete geldi. Yüzüne renk gelmiş, sesi de enerjikti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300650
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300650,
					"content": "Şehre dönüp resim sergisini düzenlemeye devam etmek istiyormuş ama bu sefer doktoruyla beraber çalışarak hastalıkla ilgili bazı resimli kitaplar sergileyecekmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300651
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300651,
					"content": "Tabii Thelxie'nin Fantastik Maceraları ve yönlendirme terapisi de sergide yer alacakmış. Yaşadığı deneyimi kullanarak başkalarına yardımcı olmak istiyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300652
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300652,
					"content": "Ne güzel! Oh be, kötü haber değilmiş neyse ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300653
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300653,
					"content": "Evet. Alın, bu resimli kitap sizde kalsın lütfen. Madam öyle istedi. Olur da ileride benzer sorunlar yaşayan birileriyle karşılaşırsanız kitabın faydasının dokunmasını umuyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300654
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300654,
					"content": "Hı? Ama bu oğlunun hikayesi değil mi? Kitabı bize vermesi sorun olmaz mı ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300655
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300655,
					"content": "Merak etmeyin, kitabın kopyası bu. Orijinali onda. Onun için çok önemli sonuçta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300656
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300656,
					"content": "Tamam o zaman, sorun yok! Ah, önemli bir şeye katkıda bulunmuş olmak ne güzel. Paimon hayali bir maceranın bu kadar faydalı olacağını tahmin etmezdi hiç... Paimon olaylar kötü sonuçlanabilir diye korkuyordu açıkçası. Sonuçta hayaldi hepsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300657
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300657,
					"content": "Paimon, Madam ne dedi biliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300658
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300658,
					"content": "Dedi ki... Thelxie'nin başına tacı yerleştirdiği an çok güzel bir şey gördüğünü hissetmiş. Çocuğu dönmüş ve ona onu çok sevdiğini söylemiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300659
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300659,
					"content": "O da çocuğuna nihayet veda etme fırsatını bulmuş. İşte o an gizemli bir güç tarafından iyileştirildiğini ve tepeden tırnağa cesaretle dolduğunu hissetmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300660
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300660,
					"content": "Aa! Gerçekten mi? Peki bunlar da hayal dünyasının bir parçası olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300661
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300661,
					"content": "Olabilir ama hayal sadece hayalden ibaretse, hayal dünyası da gerçek değilse bize gerçek dünyada kullanabileceğimiz bu güçleri nasıl veriyor olabilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300662
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300662,
					"content": "Yani... Hayal sadece hayalden ibaret değil belki de.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401300663
					]
				},
				{
					"id": 401300663,
					"content": "B-Başka ne olabilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300664
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300664,
					"content": "Bir masal dünyasının gerçek dünyada zuhur etmesidir belki. O muhteşem masal dünyası bir süreliğine gerçeğe dönüşmüş ve dünyamızdaki gerçek şeyleri etkilemiş olabilir. Öyle olmalı yani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300665
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300665,
					"content": "Sen de gördün, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300666
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300666,
					"content": "Öyle bir şey olamaz ama, değil mi? İmkansız! Dediklerin gerçekten yaşanmış olsa bir mucize sayılmaz mıydı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300667
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300667,
					"content": "Evet... Mucize sayılırdı sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300668
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300668,
					"content": "Umarım kendini karanlıkta bulan herkes bir gün güzel bir şey görür ve bir mucizeyi tecrübe eder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freminet"
				}
			]
		},
