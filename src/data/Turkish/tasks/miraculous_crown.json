			"dialogs": [
				{
					"id": 401300801,
					"content": "Selam Freminet! Thelxie! Biz geldik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300802,
					"content": "#Merhaba Paimon. Merhaba {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300803
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300803,
					"content": "-.. -... .-- -...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300804
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401300804,
					"content": "Taç hazır mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300805,
					"content": "Evet, Zuria'yı bekliyoruz şimdi. Henüz gelmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300806
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300806,
					"content": "O zaman biraz daha bekleyelim! Ya da acaba yanına mı gitsek? Evi buradan çok uzakta değil sonuçta. Hemen şuradaki tepeye taşındıklarını söylememiş miydi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300807,
					"content": "#Hey, {NICKNAME}! Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300808
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 401300808,
					"content": "Hehe, bakın kim geliyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300809,
					"content": "Buldum sizi nihayet... İyi olmanıza çok sevindim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300810
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 401300810,
					"content": "Hı? Niye buradasınız Bayan Delaroche? Neden iyi olmayalım ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300811,
					"content": "Neden mi iyi olmayasınız? O Su İfriti Thelxie yüzünden tabii ki! Geçen gün size verdiğim görevden sonra beni bir endişe sardı, kaybolan çocuğu sordum etraftakilere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300812
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 401300812,
					"content": "Ha, o mu? O işi çözdük, merak etmeyin! Duyduğunuz çocuk Freminet'ymiş. Balıklar da onun yüzünden kaybolmuş hatta. Merak etmeyin, şu işimiz bitince balıkları geri getirmenize yardım edeceğiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300813,
					"content": "Kusura bakmayın, bölgede dalış yapıyordum da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300814
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300814,
					"content": "Hı? Freminet mi? Dalış mı? Yok hayır... Alakası yok. Ben bambaşka bir hikaye duydum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300815
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 401300815,
					"content": "Bir ay önce çocuğun biri bedenine ağır deniz kabukları bağlayıp bu suya girmiş. Bir daha da geri dönmemiş... Su İfritinin işi değil de ne bu şimdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300816
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 401300816,
					"content": "Ne? Emin... Emin misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300817,
					"content": "Yüzde yüz eminim! Tanıdığım usta balıkçılara da sordum, onlar da doğruladı. Çocuk daha sekiz yaşındaymış... Adı da Lescot'ymuş. Lescot Destree.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300818
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 401300818,
					"content": "Bir dakika... Lescot Destree mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300819
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300819,
					"content": "Evet! Destree diye bir yerden geldikleri için aile ismini oradan almış. Neyse, annesi çok ünlü bir sanat simsarıymış. Babası ise yıllar önce bir kazada hayatını kaybetmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300820
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 401300820,
					"content": "*iç çeker* Tabii doğal olarak annesi bu olaydan sonra mahvolmuş ve fena bir hastalığa yakalanmış. Fontaine Şehri'ni terk ettiğini söylüyorlar ama nereye gittiğini kimse bilmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300821
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 401300821,
					"content": "Bu olamaz... Değil mi? Lescot Destree... Zuria Destree... Tesadüf olsa gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300822
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300822,
					"content": "Biz gidip Destree'lere bir uğrayalım en iyisi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401300823
					]
				},
				{
					"id": 401300823,
					"content": "Kusura bakmayın hanımefendi! Gidip bir şeye bakmamız lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300824
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300824,
					"content": "Ha, peki... Tamam, buyurun tabii. Ben ikiniz de iyi misiniz diye bakmaya gelmiştim. Döneyim o zaman... Dikkatli olun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Delaroche"
				}
			]
		},
