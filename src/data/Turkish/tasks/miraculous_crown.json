			"dialogs": [
				{
					"id": 401300601,
					"content": "Kusura bakmayın... Gitmem gerek. Arkadaşlarıma sözüm vardı, çok geç kaldım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300602
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401300602,
					"content": "Ama Madam, siz hâlâ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300603
					],
					"speakerTitle": "Jalacan"
				},
				{
					"id": 401300603,
					"content": "Beni durdurmaya çalışmayın! Bugün Thelxie'nin tedavisi için en önemli gün! Yönlendirme metodunu kullanacağız. Sen de işe yarayacağını söylememiş miydin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300604
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401300604,
					"content": "Sizi durdurmaya çalışmıyorum Madam. Ancak... Çocuğunuzun adını söyler misiniz bana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300605
					],
					"speakerTitle": "Jalacan"
				},
				{
					"id": 401300605,
					"content": "Dr. Jalacan, kendi hastanızın adını nasıl unutabilirsiniz? Adı Thelxie! Su İfriti Krallığı'nın Prensi! Bugün tacını geri almaya gidiyoruz, sonra da taç giyme törenine katılacağız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300606
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401300606,
					"content": "Anladım... Madam... Merak etmeyin, her şey planladığınız üzere ilerliyor. Arkadaşlarınız çoktan tacı bulmaya... Bir dakika... Bakın! Dönmüşler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300607
					],
					"speakerTitle": "Jalacan"
				},
				{
					"id": 401300607,
					"content": "Zuria, Zuria! Tacı aldık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300608,
					"content": "Aa, Paimon... Millet... Alabildiniz mi gerçekten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300609
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401300609,
					"content": "Evet ama taç giyme törenini henüz gerçekleştirmedik, töreni senin yönetmen gerektiğini düşündük...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300610
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300610,
					"content": "Harika, harika! Thelxie... Evladım... Evladım, duyuyor musun bak? Kaybettiğin her şeyi geri kazanmak üzeresin. Yakında, çok yakında bir daha asla yalnız kalmayacaksın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300611
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401300611,
					"content": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300612
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401300612,
					"content": "Resimli kitabın son sayfası... Çizip renklendirmeni bekliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300613
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300613,
					"content": "Evet doğru, resimli kitap... Resimli kitap vardı. Ama son sayfaya ne çizsem bilmiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300614
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401300614,
					"content": "Merak etme, Thelxie ve dostları ne çizeceğini biliyor! Sen hazırlan Zuria, biz sana hepsini anlatırız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300615,
					"content": "Peki... Tamam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300616
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401300616,
					"content": "Öhöm... Thelxie ve dostları nihayet krallığı istila eden son canavarları da kovmayı ve muhteşem bir zafer elde etmeyi başardı. Galibiyete erdiler ve göz kamaştıran tacı geri kazandılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300617,
					"content": "Nihayet yuvalarına dönen Su İfritleri, kendilerini karşılayan Prenslerine sevgi ve övgü yağdırdı. Prense bir kez daha değerli kabuklarını teklif ettiler ve eski gökkuşağı köprüsünü yeniden inşa ettiler. Onları izleyen Prens ise köprünün güzelliğinden etkilenmeden edemedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300618
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300618,
					"content": "#Çevresindekilerin mutluluğuyla duygulanan Prens, gökkuşağı köprüsüne çıktı ve kendisiyle bu maceraya çıkan dostlarına iyice baktı. İşte {NICKNAME}, Tanrıça Paimon, Freminet ve...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300619,
					"content": "Fakat o da ne? Son kişi neredeydi? Prens telaş içinde etrafına bakındı fakat en çok görmek istediği kişiyi bir türlü göremedi. Bahsi geçen kişi işte tam o an köprünün diğer ucunda belirdi. Prense doğru bir tebessümle yürüdü ve yavaşça yüzündeki tülü kaldırdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300620,
					"content": "Prens tutamadı gözyaşlarını. Bunca zamandır onun yanından ayrılmayan gizemli kişinin bizzat annesi olduğunu gördü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300621
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300621,
					"content": "Zuria köprüyü geçti ve Prensin başına tacı yerleştirdi. Prense bakarak gülümsedi ve dudaklarından şu sözler döküldü: \"Prensim, kralım. Artık asla ama asla yalnız hissetmeyeceksin.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300622
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300622,
					"content": "İşte hikaye böyle sona erdi Zuria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300623
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300623,
					"content": "Sağ olun... Hepiniz sağ olun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300624
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401300624,
					"content": "Özür dilerim evladım, anneciğin seninle daha fazla vakit geçirmeliydi... Duydun mu hikayeyi? Bir daha asla yalnız hissetmeyeceksin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300625
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401300625,
					"content": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300626
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401300626,
					"content": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300627
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401300627,
					"content": "Evet! Anneciğin de seni seviyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300628
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401300628,
					"content": "N-Ne oluyor? Zuria, Thelxie ile mi konuşuyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401300629,
					"content": "Thelxie ne diyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401300630
					]
				},
				{
					"id": 401300630,
					"content": "Çabuk, dalgıç kaskımı tak! Thelxie'nin sinyal çıktısıyla uyumlu bir deşifre modülü var içinde. Onu kullanarak Thelxie'nin dediklerini anlayabilirsin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300631
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300699,
					"content": "Freminet sana doğru yürür ve dalgıç kaskını çıkarıp senin başına takar.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 401300631,
					"content": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300632
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401300632,
					"content": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300633
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401300633,
					"content": "Seni seviyorum anne!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300634
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401300634,
					"content": "Demek Thelxie bunu diyormuş...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401300635
					]
				},
				{
					"id": 401300635,
					"content": "Anneciğin... Anneciğin de seni seviyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300636
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401300636,
					"content": "Ben seni daha çok seviyorum anneciğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300637
					],
					"speakerTitle": "Lescot Destree"
				},
				{
					"id": 401300637,
					"content": "Bir dakika, bu ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401300638
					]
				},
				{
					"id": 401300638,
					"content": "Ne oldu? Bir şey mi gördün?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300639
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401300639,
					"content": "Anneciğim, biraz uykum geldi... Yatma vakti geldiyse bana bir ninni mırıldanabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300640
					],
					"speakerTitle": "Lescot Destree"
				},
				{
					"id": 401300640,
					"content": "Tabii ki canım evladım... Sen yeter ki iste, anneciğin sana her daim mırıldanır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300641
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401300641,
					"content": "♪♫♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300642
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401300642,
					"content": "Sağ ol anneciğim! Bu ninniyi hep çok severdim. Şimdi duyduğuma göre rüyama dönüp huzur içinde Su İfriti Krallığı'na gidebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300643
					],
					"speakerTitle": "Lescot Destree"
				},
				{
					"id": 401300643,
					"content": "Ah zavallı bebeğim... Unutma lütfen, seni hep çok seveceğim... Sana olan sevgim... Su İfriti Krallığı'ndan katbekat büyük...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300644
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401300644,
					"content": "Unutmayacağım anneciğim... Benim de sana olan sevgim Su İfriti Krallığı'ndan katbekat büyük.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300645
					],
					"speakerTitle": "Lescot Destree"
				},
				{
					"id": 401300645,
					"content": "İyi geceler anneciğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lescot Destree"
				}
			]
		},
