			"dialogs": [
				{
					"id": 230175001,
					"content": "Merhaba? Şey... Ne öğrenmek istiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175002
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175002,
					"content": "Bay Garcia'yla nasıl tanıştınız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230175003
					]
				},
				{
					"id": 230175003,
					"content": "Lafı hiç dolandırmayı sevmiyorsun galiba, değil mi? Bir maceracıdan da bu beklenirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175004
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175004,
					"content": "Garcia'yla, topluluk yöneticimiz onu muhasebeci olarak işe aldığında tanıştık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175005
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175005,
					"content": "Haha, açıkçası topluluğumuzda onun kadar uyumsuz birini görmedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175006
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175006,
					"content": "Müzik yapar, dans eder, içer, şarkı söylerdik ama o bir köşede sessizce Lutong'la birlikte hesap yapardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175007
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175007,
					"content": "Onu bir keresinde üzerinde çizimler olan tuhaf bir giysiyle gördüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175008
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175008,
					"content": "Merak edip çizimlerin ne anlama geldiğini sordum. O da bir makinanın taslağı olduğunu söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175009
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175009,
					"content": "O sırada birine makinayı anlatıyormuş ama yanında kağıt kalem olmadığı için taslağı giysisine çizmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175010
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175010,
					"content": "Taslağı göstermek ve açıklamak için kömür kullanarak giysisinin üzerine çizmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175011
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175011,
					"content": "Sonrasında o giysi ve makinası hakkında uzun uzun konuştuk. Tabii konuşan taraf çoğunlukla oydu, ben de daha çok dinleyen taraftım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175012
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230175012,
					"content": "Hehe, o gerçekten tuhaf... Ama aynı zamanda çok da çekici biri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaia"
				}
			]
		},
