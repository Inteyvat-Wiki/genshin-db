					"nextDialogs": [
						230170302
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230170302,
					"content": "İşte ödemen. Lütfen bunu kabul et...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170303
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230170303,
					"content": "Gezgin, bana neden öyle bakıyorsun? Beni tedirgin ediyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
