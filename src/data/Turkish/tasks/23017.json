			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Garcia",
					"Lutong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230170101,
					"content": "G-Gezgin! Tam zamanında geldin. Kaia Hanım ile bir kahve molası verdik, ben de şimdi işe dönüyordum. Seni tanıştırayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170102
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230170102,
					"content": "Demek Garcia'nın bahsettiği Gezgin sensin. Tanıştığımıza memnun oldum, ben Kaia... Ben bir... Şey... Dans ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170104
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230170104,
					"content": "Merhaba, sanırım Garcia senden daha önce bahsetmişti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230170105
					]
				},
				{
					"id": 230170105,
					"content": "Hehe, öyle mi? Bunu duyduğuma sevindim. Ben de aklında makinası ve Lutong'u dışında başka hiçbir şeye yer olmadığını düşünmeye başlamıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170106
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230170106,
					"content": "Onun aklında bana da yer olmadığına emin olabilirsiniz hanımefendi. Bay Garcia'nın da böyle düşündüğüne inanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170107
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230170107,
					"content": "Öyle olduğunu sanmıyorum. Sen olmasan eminim Garcia beş parasız kalırdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170108
					],
					"speakerTitle": "Kaia"
				},
				{
					"id": 230170108,
					"content": "Üzgünüm hanımefendi ama size katılmıyorum. Eminim Bay Garcia ne olursa olsun iki fincan kahve için kenara bir miktar ayırır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170109
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230170109,
					"content": "Hayır, üç fincan için!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170110
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230170110,
					"content": "Çok düşüncelisiniz Bay Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170111
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230170111,
					"content": "Pekala, iş konuşalım! Hazine Avcılarının yanında taşıdığı nişanlara hâlâ ihtiyacım var Gezgin. Eğer bulabilirsen onları senden satın alabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170112
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230170112,
					"content": "Şey... Son zamanlarda biraz Mora kazandım. Bu yüzden ödemeyle ilgili endişe etmene gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
		},
