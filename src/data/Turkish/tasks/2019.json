				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20190101,
					"content": "İnsanlar keyiflerince içeri dalıveriyorlar, medeniyet görmemişler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190102
					],
					"speakerTitle": "Sinyora"
				},
				{
					"id": 20190102,
					"content": "Buranın Tenshukaku olduğunu bilmesem, pazar yeri falan zannederdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190103
					],
					"speakerTitle": "Sinyora"
				},
				{
					"id": 20190103,
					"content": "Aklın başına geldi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190104
					],
					"speakerTitle": "Sinyora"
				},
				{
					"id": 20190104,
					"content": "Olamaz, Kujou Sara'ya ne yapmış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20190105,
					"content": "Inazumalılara suçlarının cezasını sadece ben verebilirim. Sen değil, Sinyora.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190106
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 20190106,
					"content": "... Öyleyse özür diliyorum Yüce Şogun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190107
					],
					"speakerTitle": "Sinyora"
				},
				{
					"id": 20190107,
					"content": "Sinyora!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190108
					]
				},
				{
					"id": 20190108,
					"content": "Biliyorum, biliyorum, aklından beni çıkaramıyorsun. Ama sürekli adımı sayıklamana gerek yok ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190109
					],
					"speakerTitle": "Sinyora"
				},
				{
					"id": 20190109,
					"content": "Seni burada gördüğüme şaşırdığımı zannetme sakın. Benden nefret ettiğini çok iyi biliyorum, gölgem gibi peşimden ayrılmıyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190110,
						20190111
					],
					"speakerTitle": "Sinyora"
				},
				{
					"id": 20190110,
					"content": "Gizlice Sanrı dağıtıyorsun...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190112
					]
				},
				{
					"id": 20190112,
					"content": "Ah, yani Şogun'un karşısında suçlarımı ifşa etmeye mi geldin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190113
					],
					"speakerTitle": "Sinyora"
				},
				{
					"id": 20190113,
					"content": "Hehehe... Ben sadece Snezhnayalı bir diplomatım. Ne yazık ki neden bahsettiğini hiç bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190114
					],
					"speakerTitle": "Sinyora"
				},
				{
					"id": 20190114,
					"content": "Bizi hiç ciddiye almıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190115,
						20190116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20190115,
					"content": "Önsezilerini kaybetmiş herkes için...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190117
					]
				},
				{
					"id": 20190117,
					"content": "İnsanlardan ve zerre umurumda olmayan şeylerden bahsetmeyi kes.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190118
					],
					"speakerTitle": "Sinyora"
				},
				{
					"id": 20190118,
					"content": "Onlar, başından beri bir hiçti ve kimse adlarını bile hatırlamayacak. Ama artık sonsuzluğu gerçeğe dönüştürecek olan büyük devrimin yolunda bir basamak olma fırsatına sahipler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190119
					],
					"speakerTitle": "Sinyora"
				},
				{
					"id": 20190119,
					"content": "O küçük, zavallı hayatlarında bundan büyük şeref mi olur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190120
					],
					"speakerTitle": "Sinyora"
				},
				{
					"id": 20190120,
					"content": "Yüce Şogun... Haksızsam beni düzeltin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190121
					],
					"speakerTitle": "Sinyora"
				},
				{
					"id": 20190121,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190122,
						20190123
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 20190122,
					"content": "Venti'nin Gnosis'i için...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190124
					]
				},
				{
					"id": 20190124,
					"content": "Onlar geçmişte kaldı. Kin tutmayı ne kadar çok seviyormuşsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190125
					],
					"speakerTitle": "Sinyora"
				},
				{
					"id": 20190125,
					"content": "Çariçe'nin hayali, tüm dünyadaki en soylu ve saf şeydir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190126
					],
					"speakerTitle": "Sinyora"
				},
				{
					"id": 20190126,
					"content": "Sürekli bahsedip durduğun bu sıkıcı detaylar... Onlar sadece yapılması gerekli olan fedakarlıklardı. O kadar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190127
					],
					"speakerTitle": "Sinyora"
				},
				{
					"id": 20190127,
					"content": "Bunu durdurmamın vakti geldi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190128
					]
				},
				{
					"id": 20190128,
					"content": "Sen mi beni durduracakmışsın? Hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190129
					],
					"speakerTitle": "Sinyora"
				},
				{
					"id": 20190129,
					"content": "Ben de seni ortalıkta görmekten sıkılmıştım zaten. Ama bu kadar gözü kara olduğunu düşünmemiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190130
					],
					"speakerTitle": "Sinyora"
				},
				{
					"id": 20190130,
					"content": "Pişman olacağın bir şeyler söylemeden önce, Inazuma'nın en aranan suçlusu olduğunu unutma... İçinde bulunduğun durumu çok iyi değerlendirmeni öneririm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190131
					],
					"speakerTitle": "Sinyora"
				},
				{
					"id": 20190131,
					"content": "Tenshukaku'ya davetsiz girip Şogun'un karşısında bana nutuk atman, hiç akıllıca değildi. Boşa kürek çekmeyi bırakmasan mı artık?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190132
					],
					"speakerTitle": "Sinyora"
				},
				{
					"id": 20190132,
					"content": "Aramızda ne kadar büyük bir statü ve... Güç farkı olduğunu göremiyorsun sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190133
					],
					"speakerTitle": "Sinyora"
				},
				{
					"id": 20190133,
					"content": "Seni...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190134
					]
				},
				{
					"id": 20190134,
					"content": "... Sarayda bir düelloya davet ediyorum!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190135
					]
				},
				{
					"id": 20190135,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190136
					],
					"speakerTitle": "Sinyora"
				},
				{
					"id": 20190136,
					"content": "Devam edin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190137
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 20190137,
					"content": "Tanrım, bugün beni çok şaşırtıyorsun... Demek bu toprakların kanunlarını da kendi tarafına çekmeyi başardın, hı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190138
					],
					"speakerTitle": "Sinyora"
				},
				{
					"id": 20190138,
					"content": "İtiraf edeyim, ikimizin de eşit bir konumda olduğu bir duruma düşeceğimi hiç düşünmemiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190139
					],
					"speakerTitle": "Sinyora"
				},
				{
					"id": 20190139,
					"content": "Kaybedenin... Ölmesi gerektiğinin farkında mısın? Bunu istediğine emin misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190140
					],
					"speakerTitle": "Sinyora"
				},
				{
					"id": 20190140,
					"content": "#{NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20190141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20190141,
					"content": "Hehehe... O zaman sana bu son dansı bahşedeceğim... Ölüm bizi ayırana dek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sinyora"
				},
				{
					"id": 20190123,
					"content": "Ve tehlikeye attığın Liyue halkı için...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190124
					]
				},
				{
					"id": 20190116,
					"content": "Sanrılar yüzünden zarar görmüş herkes için...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190117
					]
				},
				{
					"id": 20190111,
					"content": "Inazuma'nın kontrolünü ele geçirmeye çalışıyorsun...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20190112
					]
				}
			]
		}
	]
}