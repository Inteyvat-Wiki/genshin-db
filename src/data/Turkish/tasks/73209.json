			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Affan",
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732090701,
					"content": "Umudumu kaybetmek üzereydim. Bu çiçeğin aslında büyümesini beklemiyordum. Yaşadığımız sürece başımıza daima harika şeyler gelebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090702
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090702,
					"content": "Ufaklık, hâlâ Shafaqat amcaya mı üzülüyorsun? Merak etme. Yaşayanlar, ölenlerin dileklerini hayatta tutmalı. Onları yüzüstü bırakamayız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090703
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090703,
					"content": "Bay Affan... Artık o kadar genç değilim. Birlikte büyüdüğüm o arkadaşlarımın çocukları bile artık bakkaldan baharat alacak yaşa gelmiştir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090704
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090704,
					"content": "Ama katılıyorum. Hâlâ hayatta olduğumuza göre, mutlu olmak için elimizden geleni yapmamız gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		}
	]
}