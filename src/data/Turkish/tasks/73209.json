					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732090302
					]
				},
				{
					"id": 732090302,
					"content": "\"Taştan biten Altın Gül bana bir şarkı söyledi.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
