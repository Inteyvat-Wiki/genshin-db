				"points": []
			},
			"dialogs": [
				{
					"id": 732090601,
					"content": "Bu ilk fidanlar sağlıklı büyürse, daha fazla Altın Gül ekebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090602
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090602,
					"content": "Ama önce bu güller açsın. İçim o zaman biraz daha rahatlayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		},
		{
			"id": 7320907,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
