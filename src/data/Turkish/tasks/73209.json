			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732090101,
					"content": "Geldiniz mi? Ne güzel, biz de güllerle birlikte sizi bekliyorduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090102
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732090102,
					"content": "Sabbah da erkenden geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732090103,
					"content": "Son zamanlarda buraya sık gelmeye başladım ve Bay Shafaqat'ın bıraktığı notları okudum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090104
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090104,
					"content": "Eskiden Aaru Köyü'nde kendimi yalnız hissederdim ama artık öyle hissetmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090105
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090105,
					"content": "En azından yapayalnız değilim. Bu güller var, sizinle ve Bay Affan'la geçirdiğim anılar var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090106
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090106,
					"content": "Hayatımda hâlâ güzel şeyler var ve bunu düşündükçe kendimi daha az yalnız hissediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090107
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090107,
					"content": "Bay Affan'la konuştuk. Altın Güllere bakmasına ben de yardım edeceğim artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090108
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090108,
					"content": "Bütün fidelik bu güllerle dolana kadar yetiştirmeye devam edeceğiz. Ama önce şunlar bir açsın da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090109
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090109,
					"content": "Sumeru Güllerimin açmasını nasıl sağladığını hatırlıyor musun? Aynı yöntemi kullanalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732090110
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732090110,
					"content": "Biz de yardım edelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732090111
					]
				},
				{
					"id": 732090111,
					"content": "Tamam, gerisi size kalmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		},
		{
