					"nextDialogs": [
						105011209
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011209,
					"content": "Pekala. Bir kase vejetaryen eriştesi, değil mi? Lütfen biraz bekleyin, birazdan servis yapacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011210
					],
					"speakerTitle": "Yuhua"
				},
