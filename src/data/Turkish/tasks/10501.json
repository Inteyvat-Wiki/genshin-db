					"nextDialogs": [
						105010504
					]
				},
				{
					"id": 105010504,
					"content": "Bir astrolog için bu tarz şeyler oldukça basittir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010505
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010505,
					"content": "Astroloji karşısında yalanlar hiçbir işe yaramaz. Kader ve gerçekler, yıldızlarda yazılıdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010506
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010506,
					"content": "Detayları anlamak biraz zaman alabilir ancak bir durumu genel olarak ilk bakışta kavrayabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010507
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010507,
					"content": "Ama yolda biraz tökezledin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010508,
					"content": "Çünkü Teyvat'ın yıldızları sadece \"bu dünyanın\" kaderlerini ve gerçeklerini gösterebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010509
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010509,
					"content": "Seninle ilgili herhangi bir şey, benim bile delip geçemeyeceğim bir sis perdesinin ardında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010510
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010510,
					"content": "Bu yüzden o halefle tanışmam gerekiyor. Bilgilerimizi birleştirdiğimizde kaderin hakkında yeni şeyler öğrenebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010511,
						105010512
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010511,
					"content": "Biraz heyecanlıyım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010513
					]
				},
				{
					"id": 105010513,
					"content": "Hah. Ne olursa olsun bu gezinin sana kazandıracağı çok şey var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010514
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010514,
					"content": "Pekala, ben dinlendim. <color=#00E1FFFF>Mondstadt'a</color> olan yolculuğumuzu bir an önce tamamlayalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010515
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010515,
					"content": "*iç çeker* Keşke bir arabamız olsaydı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010516,
					"content": "Yorgun değilsin sanıyordum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010512,
					"content": "Çok fazla ümitlenmiyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010513
					]
				},
				{
					"id": 105010503,
					"content": "O haydutların niyetini anlaman etkileyiciydi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010504
					]
				}
