					"content": "Bunu duydum! Ben ısmarlıyorum dedim. Neden Mora kadar önemsiz bir şeyi umursayayım ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011214
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011214,
					"content": "Bir astroloğun zihni, yıldızları incelemeye odaklanmıştır. Bu kadar sıradan meselelerden kolay bir şekilde rahatsız olsaydım muhakeme yeteneğimi kaybederdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011215
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011215,
					"content": "Özellikle de kişinin Mora ile kendini aşırı bir şekilde yüceltmesi. Bu hem ilkel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011216
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011216,
					"content": "*mide guruldaması*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011217
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011217,
					"content": "... Hem de tehlikeli bir şey.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011218
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011218,
					"content": "O halde söylediğimiz yemekleri yememek de astroloğun gururunun bir parçası mı? Paimon anlamıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105011219,
					"content": "Ama sadece bizim ziyafet çekiyor olmamız biraz kötü hissettiriyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105011220,
					"content": "Senin için bir şeyler hazırlayayım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011221
					]
				},
				{
					"id": 105011221,
					"content": "Ah evet! Bunu yapabiliriz! Bize bir dakika ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
