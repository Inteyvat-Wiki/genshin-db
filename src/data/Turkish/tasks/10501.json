					"nextDialogs": [
						105011506
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011506,
					"content": "Pekala. Talebem bu kadar zaman ve çaba sarf ettiği için her ne kadar zor olsa da kabul etmeliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011507
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011507,
					"content": "... Aah! Leziz! Son zamanlarda yediğim en lezzetli şey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011508
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011508,
					"content": "Ah, ımm, yani... *öksürür* Talebemin bu kadar becerikli olduğunu bilmiyordum. Ustan olarak çok rahatladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011509,
						105011510
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011509,
					"content": "En azından doyurucu bir öğün.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105011511
					]
				},
				{
					"id": 105011511,
					"content": "Sanırım buna Liyue'nin özel lezzetleri demek abartı olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011512
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011512,
					"content": "Sanırım bunlar için bu kadar Mora harcamak abartı olmadı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011513
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011513,
					"content": "Ah, hiç değil. Hem de hiç. Artık karnımız doyduğuna göre gitmeliyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011514
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011514,
					"content": "Buradan kuzeye seyahat edersek <color=#00E1FFFF>Taş Geçit'e</color> ulaşırız ve oradan da Mondstadt sınırlarına girmiş oluruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105011515
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011515,
					"content": "Hangi derin gizemlere dair bilgiler edineceğiz? *kıkırdar* Dört gözle bekliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 105011510,
					"content": "Böyle diyorsun ama yemeği çok sevdiğin belli oluyor.",
