			"dialogs": [
				{
					"id": 105010401,
					"content": "Uff. Yorucu bir yolculuktu ama nihayet Mondstadt'a ulaştık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010402
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010402,
					"content": "Bilgiye uzanan yolculuk hiç de kolay sayılmaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010403
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010403,
					"content": "Paimon yorgun değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010404,
					"content": "Üf, çünkü havada süzülüyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010405
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010405,
					"content": "Yani, astrologlar da olağanüstü şeyler gibi görünmüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010406,
					"content": "Çünkü astroloji hakkında bir sürü gerçekçi olmayan hayallerin var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010407
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010407,
					"content": "Siz de burada ayaklarınızı mı dinlendiriyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010408
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010408,
					"content": "Siz kimsiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010409,
					"content": "Ah, kardeşlerim ve ben tüccarız. Liyue'deki işlerimizi bitirdik ve Mondstadt'a geri dönmek için hazırlanıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010410
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010410,
					"content": "Biraz yorgun görünüyorsun. Kiraladığımız araba birazdan gelir, yola bizimle devam etmeye ne dersiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010411,
						105010413
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010411,
					"content": "Şey, ben biraz yoruldum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010412
					]
				},
				{
					"id": 105010413,
					"content": "Para vermem gerekiyor mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010414
					]
				},
				{
					"id": 105010412,
					"content": "Haha, hadi gidelim o zaman. Yolda muhabbet edebiliriz, birlikte daha eğlenceli olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010415
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010414,
					"content": "Gerek yok, gerek yok, zaten o yöne gidiyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010415
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010415,
					"content": "Gerek yok. Hadi ikileyin. Yolumuzdan çekilin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010416
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010416,
					"content": "Hı? Hanımefendi... Ters giden bir şey mi var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010417
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010417,
					"content": "Numarayı bırak haydut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010418
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010418,
					"content": "Yolda savunmasız görünen kişileri alıp arabadan indiklerinde onları soyup soğana çevirmek ve ardından onları tenha bir yerde bırakmak mı yani? Olayınız bu mudur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010419
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010419,
					"content": "N-Ne diyorsun? Buraya sohbet etmeye geldik ve böyle mi ödüllendiriliyoruz? Hakaretlerle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010420
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010420,
					"content": "Binmek istemiyorsan binme! Çatlak kız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010421
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010421,
					"content": "Peki o zaman, üzerindekilerden hangilerinin çalıntı olduğunu söyleyeyim mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010422
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010422,
					"content": "Herhangi bir itirazın varsa söylediklerimi doğrulaması için insanları buraya getirebiliriz ve her şey açığa çıkar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010423
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010423,
					"content": "Ben kaybedersem yirmi bin Mora vereceğim. Ancak kazanırsam bu gece Liyue Limanı'nda hapishane yemekleri yiyor olursun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010424
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010424,
					"content": "Ne diyorsun? Gerçekten iş adamıysanız korkacak bir şey yok, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010425
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010425,
					"content": "Sen... Sen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010426
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010426,
					"content": "Çok ileri gittin seni velet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010427
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010427,
					"content": "Nasıl öğrendin bilmiyorum ama senden kurtulduğumuz sürece başkası öğrenemeyecektir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010427,
						105010428
					],
					"speakerTitle": "Tyler"
				},
				{
					"id": 105010428,
					"content": "Dikkatli ol Mona!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010430
					]
				},
				{
					"id": 105010429,
					"content": "Ona elini bile süremezsin!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010430
					]
				},
				{
					"id": 105010430,
					"content": "Endişelenme, sadece birkaç haydut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010431
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105010431,
					"content": "Daha önce astrologların olağanüstü bir taraflarının olmadığını söylemiştin... Peki o zaman, ustanın neler yapabileceğini göstermenin zamanı geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
