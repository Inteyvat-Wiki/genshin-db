			"dialogs": [
				{
					"id": 105010201,
					"content": "Merhaba, nasıl yardımcı olabilirim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010202
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 105010202,
					"content": "Buradaki mutfağı kullanmak istiyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010203,
						105010204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010203,
					"content": "Bir arkadaşım özel bir yemek yemek istiyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010205
					]
				},
				{
					"id": 105010205,
					"content": "Ah, anlıyorum. Madem öyle bir durum var, elbette. Kendi malzemelerini hazırladıysan mutfağı kullanmaktan çekinme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010206
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 105010206,
					"content": "Tadına bakabilir miyim... Aşçılık sanatında deneyimli olmalısın, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010207,
						105010209
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 105010207,
					"content": "Tabii ki. Yaptığım her şey lezzetli olur!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010208
					]
				},
				{
					"id": 105010208,
					"content": "Haha, yetenekli olduğun kesin. Aslında küçük bir öneride bulunacaktım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010211
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 105010211,
					"content": "Giysilerinize bakılırsa buralı değilsiniz. Ancak Liyue'ye geldiğinize göre Liyue usulü yemekler yapmayı denemek ister misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010212
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 105010212,
					"content": "Bir Altın Yengeç tarifim var. Tam bir Yue mutfağı klasiği.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010213
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 105010213,
					"content": "Yengeç etini una bulayıp derin yağda kızartırsın, ardından zencefil ve sarımsak ile tavada pişirirsin. Tabağa koyduğunda yengeç, altının üzerinde duruyormuş gibi görünür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010214
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 105010214,
					"content": "Altın... Yengeç!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010215,
						105010216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010215,
					"content": "Kulağa karmaşık geliyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010217
					]
				},
				{
					"id": 105010217,
					"content": "#Altın Yengeç {NICKNAME}! Altın Yengeç!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010218,
						105010219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010218,
					"content": "Anladım, anladım. Altın Yengeç.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010220
					]
				},
				{
					"id": 105010220,
					"content": "Heheh. O halde başlayalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010221,
					"content": "Mutfaktaki becerilerin sayesinde bu çok kolay olacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105010219,
					"content": "... Sanırım biraz da senin için öğreniyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010220
					]
				},
				{
					"id": 105010216,
					"content": "Mona için yepyeni bir yemeği öğrenmek biraz...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010217
					]
				},
				{
					"id": 105010209,
					"content": "Pek sayılmaz...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010210
					]
				},
				{
					"id": 105010210,
					"content": "Haha, ne kadar mütevazısın. Aslında küçük bir önerim var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105010211
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 105010204,
					"content": "Arkadaşım benim yaptığım bir yemeği yemek istiyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105010205
					]
				}
			]
		},
