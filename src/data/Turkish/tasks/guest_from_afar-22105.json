			"dialogs": [
				{
					"id": 221050101,
					"content": "Ne kadar gergin bir durum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050102
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050102,
					"content": "Sorun ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221050103
					]
				},
				{
					"id": 221050103,
					"content": "Canımı sıkan bir şeyler var. Nasıl açıklayacağımı bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050104
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050104,
					"content": "Misafirlerimizin de son derece ihtiyatlı olması durumu daha da kötüleştiriyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050105
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050105,
					"content": "En ufak bir sorun çıktığında pencereler, kapılar, hatta parkeler bile kırılıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050106
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050106,
					"content": "En azından misafirler kendileri tamir ediyor fakat farklı parçalarla yapılan tamirler yüzünden her yer yamalı bohça gibi oldu ve gerçekten çok rahatsız edici görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050107
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050107,
					"content": "Acaba hanın çevresine bir göz atar mısın? Ters giden bir şeyler görürsen de... İcabına bak lütfen. Benim misafirlerle ilgilenmem lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050108,
						221050109
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050108,
					"content": "Tamam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221050110
					]
				},
				{
					"id": 221050110,
					"content": "Teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050109,
					"content": "Bu insanların nesi var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221050111
					]
				},
				{
					"id": 221050111,
					"content": "O kadar da kötü değiller canım. Sonuçta dışarıda hayatta kalmaya çalışıyorlar. Tetikte oldukları için onları suçlayamayız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050112
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221050112,
					"content": "Lütfen çevreye bir göz at. Merak etme, çok korkunç bir şeyle karşılaşmazsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				}
			]
		},
