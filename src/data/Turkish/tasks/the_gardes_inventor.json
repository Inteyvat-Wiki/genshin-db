			"dialogs": [
				{
					"id": 745110101,
					"content": "Merhaba arkadaşlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110102
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745110102,
					"content": "Hım, Jandarmanın bizimle ne işi var ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745110103,
					"content": "Hehe. Sen bir tahmin yürüt bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110104,
						745110105
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745110104,
					"content": "Şehirde uçup duvarlara tırmanmamızla mı ilgili?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745110106
					]
				},
				{
					"id": 745110106,
					"content": "Ah, demek onu da yaptınız, öyle mi? Durun, bunu hemen not alayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110107
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745110107,
					"content": "Bir dakika, bizi kandırmaya çalışıyorsun sen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745110108,
					"content": "Yok, şaka yapıyorum sadece. Kendimi tanıtayım öyleyse. Ben Chenee, bu da benim üstüm Frejus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110109
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745110109,
					"content": "Frejus'un test edilmesi gereken yeni bir icadı var. Siz yardımcı olmak ister misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110110
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745110110,
					"content": "Yeni bir icat mı? Nasıl bir şey bu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745110111,
					"content": "Uzaktan kumandalı bir top.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110112
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745110112,
					"content": "Gördüğünüz gibi önceki taret modellerinin hepsinin yanında onu kullanan biri olması gerekiyor. Bu yüzden bir düşmanın, ikisinden de kurtulmak için topu hedef alması yeterli oluyor. Ancak bu tür silahlar uzaktan kontrol edilebilirse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110113
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745110113,
					"content": "Kayıp sayısını en aza indirebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110114
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745110114,
					"content": "Hemencecik de tasarlayıverdin! Sana boşuna \"Fontaine Araştırma Enstitüsünü üç defa reddeden Jandarma\" demiyorlarmış!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110115
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745110115,
					"content": "Üç defa mı reddettin? Enstitüyü mü?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745110116
					]
				},
				{
					"id": 745110116,
					"content": "Yani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110117
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745110117,
					"content": "Aynen öyle! Anlatayım hemen, onu gözlerine kestirmişlerdi ve üst düzey araştırmalar yapması için yüklü bir ödeme yapacaklardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110118
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745110118,
					"content": "Ancak bunca zamandır hep reddetti çünkü işini seviyordu! Ah, çok dokunaklı değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110119
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745110119,
					"content": "Yine de yeteneklerinin boşa gitmesine dayanamadı ve zaman zaman işimizde bize yardımcı olması için yeni icatlar yapıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110120
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745110120,
					"content": "Çok iyi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745110121,
					"content": "Öhöm, beni şımartıyorsun Chenee. Ne dediğimi hatırlıyor musun? Kişinin zekası kadar mütevazı olmayı bilmesi de önemlidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110122
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745110122,
					"content": "Anlaşıldı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110123
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745110123,
					"content": "Neyse, sizden bu topu test ederek uygulanabilirliğini doğrulamamıza yardımcı olmanızı istiyoruz. Biz çoktan \"alanı\" ve \"hedefleri\" ayarladık. Ayrıca iyi bir ödeme yapılacağından da şüpheniz olmasın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110124
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745110124,
					"content": "Hehe, o zaman tam da doğru maceracılara geldiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745110125,
					"content": "Yolculuklarımız sırasında her türlü şeyle karşılaştık. İcadınızın kullanıma uygun olup olmadığını sizin için test edebiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745110126,
					"content": "Harika! Öyleyse bol şans!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110127
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745110127,
					"content": "Pekala... Bu taraftan lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745110105,
					"content": "Şehirde kılıç talimi yapmamla mı ilgili?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745110106
					]
				}
			]
		}
	]
}