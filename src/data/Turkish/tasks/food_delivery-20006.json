			"dialogs": [
				{
					"id": 200060101,
					"content": "Paket servis siparişi",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060102
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060102,
					"content": "Avcının Yeri'ne hoş geldiniz... Ah, merhaba Gezgin! Tam vaktinde geldin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060103
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060103,
					"content": "Üzgünüm, aç olduğunu biliyorum ama senden bir şey isteyebilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060104
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060104,
					"content": "Pınarköy'den Bayan Orlean bir <color=#00E1FFFF>Karamelize Soslu Rosto</color> siparişi verdi fakat Pınarköy şu sıralar bodurlop kaynıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060105
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060105,
					"content": "O yüzden oraya tek başıma gitmeye cesaret edemem... Acaba benim için bu siparişi <color=#00E1FFFF>Pınarköy'deki Orlean'a</color> götürebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060106,
						200060107
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060106,
					"content": "Tabii, ama...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060108
					]
				},
				{
					"id": 200060108,
					"content": "Geri döndüğünde seni sıcacık ve lezzetli bir yemek bekliyor olacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060109
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060109,
					"content": "Sana güveniyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				},
				{
					"id": 200060107,
					"content": "Buraya sadece yemek yemeye gelmiştim, açlıktan ölüyorum!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060110
					]
				},
				{
					"id": 200060110,
					"content": "İstediğimi yaptıktan sonra sana Avcının Yeri'nin özel menüsünden bir şeyler ısmarlarım! Şimdiden teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
		},
