					"content": "Kan şekerim bu kadar düşük olmasaydı onlara gününü gösterirdim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060203
					],
					"speakerTitle": "Neşeli Orlean"
				},
				{
					"id": 200060203,
					"content": "Yemeğiniz, hanımefendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060204
					]
				},
				{
					"id": 200060204,
					"content": "Mis gibi havuç ve et kokuyor... Yemeğim daha erken gelmiş olsaydı ve o bodurloplarla tok karnına savaşmış olsaydım günlerini gösterirdim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060205
					],
					"speakerTitle": "Neşeli Orlean"
				},
				{
					"id": 200060205,
					"content": "Olan oldu artık. Yemeğin ücretini Sara'ya götürürseniz sevinirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neşeli Orlean"
