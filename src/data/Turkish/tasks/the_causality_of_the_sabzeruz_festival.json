				{
					"id": 30111113,
					"content": "Şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111101,
						30111102
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30111101,
					"content": "Zaman döngüsü içinde değiliz...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30111103
					]
				},
				{
					"id": 30111103,
					"content": "Ah! Yani her gece duyduğumuz bip sesi anılarımızın silindiği anlamına geliyor, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30111104,
					"content": "O yüzden uyandığımızda herkes o gün Sabzeruz Festivali olduğunu düşünüyor. Çoktan ertesi gün olmuş ama herkes bir gün öncesi sanıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30111105,
					"content": "Fakat kas hafızası silinemez. Bu yüzden Dehya, büyük kılıcını gittikçe daha da iyi kullanabilir hale geliyor! Şimdi her şey açıklık kazandı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30111106,
					"content": "Hımm, çok zekice bir çıkarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111107
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30111107,
					"content": "Nahida, haklı mıyız değil miyiz söyle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30111108,
					"content": "Basitçe şöyle söyleyeyim... Ateş Kristal Kelebeğini gece gördüğünüz Ateş Böceğiyle karıştırıyor gibisiniz. Parlaması o kadar ilginizi çekiyor ki hayvanın gerçek doğasını unutuyorsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111109
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30111109,
					"content": "Hiç de basit olmadı bu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30111110,
					"content": "Hâlâ doğru cevabı bulamadık demek...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30111111
					]
				},
				{
					"id": 30111111,
					"content": "Bayan Dehya'yla tekrar konuşmayı denesenize. Belki yeni bir şey öğrenirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30111112
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30111112,
					"content": "Doğru, sonuçta son ipucunu bulmamıza yardımcı olmuştu. Gidelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30111102,
					"content": "Yine de her günün sonunda anılarımız siliniyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30111103
					]
				}
			]
		},
