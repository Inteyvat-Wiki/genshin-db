					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30110101,
					"content": "Hâlâ aynı gündeyiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110102,
					"content": "Beklediğimiz gibi, bu iş düşündüğümüz kadar basit değilmiş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110103
					]
				},
				{
					"id": 30110103,
					"content": "Dün gece samsara döngüsünü kıramadığımızı zaten biliyormuşsun Nahida! Neden bize söylemedin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110104,
					"content": "Bir anlamı olur muydu ki? Gece endişelenip duracaktınız ve yarın yine gelmeyecekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110105
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110105,
					"content": "Durum böyleyken o umutlu anda biraz dinlenin dedim. Böyle bir fırsat insanın karşısına çok sık çıkmıyor ve düşüncelerinizi toplamanıza yardımcı olur diye düşündüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110106
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110106,
					"content": "Paimon bunun tuvalete gittiğimiz için olduğunu düşündü! Ah neyse, yani sen bizi kolluyordun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110107,
					"content": "Hehe, elbette. Birlikte geçirdiğimiz zamanda ikiniz benim her şeyimdiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110108
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110108,
					"content": "Şey... Paimon onur duydu ama belki biraz ağırdan mı alsak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110109,
					"content": "Hehehe... Yani demek istediğim, sizden bu bilmeceyi çözmenizi istedim ama hâlâ beni görebilen ve varlığımı sezebilen sadece ikinizsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110110
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110110,
					"content": "Yani siz burada olmasaydınız ben de var olamazdım. İşte bu yüzden ikiniz benim her şeyimsiniz. Anlatabildim mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110111
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110111,
					"content": "Ahh, Nahida yine kafa karıştırıcı şeylerden bahsediyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110112,
					"content": "Neyse, bu kadar muhabbet yeter. Ne diyorsun Gezgin? Dün elde ettiğin yeni ipuçları sayesinde durumu daha iyi anlamayı başardın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110113
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110113,
					"content": "Gerçekten de zaman döngüsü teorisi doğru değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110114
					]
				},
				{
					"id": 30110114,
					"content": "Ne? Niye önceki teorini çöpe atıyorsun ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110115,
						30110116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110115,
					"content": "Dehya'nın dövüş becerileri iyileşiyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110117
					]
				},
				{
					"id": 30110117,
					"content": "Doğru, haklısın! Ah, Biz bunu nasıl fark edemedik? Basit bir zaman döngüsü olsaydı insanların fiziksel özellikleri de her gün sıfırlanırdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110118,
					"content": "Yeni hipotezin ne peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110116,
					"content": "Dunyarzad'ın hastalığı kötüye gidiyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110117
					]
				}
			]
		},
		{
			"id": 301102,
			"completionStepIds": [
				301102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
