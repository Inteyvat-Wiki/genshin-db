					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30110401,
					"content": "Biz geldik Nahida!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110402,
					"content": "Bugün erken dönmüşsünüz. Yeni bir şey mi buldunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110403
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110403,
					"content": "Öyle de denebilir. Artık bir zaman döngüsü içinde olmadığımızdan neredeyse eminiz ama gerçek dünyada da değiliz. Bu defa yeni bir sorumuz var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110404,
						30110405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110404,
					"content": "Şehirden ayrılmayı denersek ne olur acaba?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110406
					]
				},
				{
					"id": 30110406,
					"content": "Şehirden ayrılmak mı? Hatırladığım kadarıyla bu plandan iki defa bahsetmiştiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110407
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110407,
					"content": "?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110408
					]
				},
				{
					"id": 30110408,
					"content": "Bahsetmiş miydik? Bununla ilgili hiçbir şey hatırlamıyoruz! Bu plandan bahsetmemizin ardından ne oldu peki? Geri döndüğümüzde ne dedik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110409,
					"content": "Bir düşüneyim... Sanırım sonucun ne olduğunu bana hiç anlatmadınız. Daha doğrusu her ikisinde de tüm gece dönmediniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110410
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110410,
					"content": "Gerçi ikinizin de bazen geceyi dışarıda geçirdiğiniz oluyor, o yüzden ben de bu konuda fazla üstelemedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110411
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110411,
					"content": "Bazen araştırma yaparken zamanın nasıl geçtiğini fark etmediğimiz oluyor gerçekten. Bir bakıyoruz gün bitmiş. Yine de ikimiz de şehirden ayrıldığımızı hiç hatırlamıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110412,
					"content": "Gerçekten mi? Bu tuhaf işte. Anılarınızı canlandırdığım için teoride her şeyi hatırlamanız gerekirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110413,
						30110414
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30110413,
					"content": "Yarın tekrar deneyelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110415
					]
				},
				{
					"id": 30110415,
					"content": "Evet! Burada kesinlikle şüpheli bir şeyler oluyor. Yarın bu işi araştıralım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110416,
					"content": "*bip*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110414,
					"content": "Belki de anahtar budur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110415
					]
				},
				{
					"id": 30110405,
					"content": "Şehirden ayrılmayı daha önce denedik mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110406
					]
				}
			]
		},
