			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dehya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30110201,
					"content": "İşte buradasınız. Sizi bulmam gerçekten de vaktimi aldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110202
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110202,
					"content": "Beklediğimiz gibi Dehya bugün de yaralanmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110203,
					"content": "Yaralanmak mı? Niye yaralanayım ki? Beni küçümsemeyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110204
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110204,
					"content": "Yani hâlâ yeni büyük kılıcına alışıyorsun, o yüzden...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110205,
					"content": "Doğruyu söylemek gerekirse bu oldukça tuhaf bir durum. Kılıç birden elime çok tanıdık geldi. Durun biraz! Yeni bir kılıcım olduğunu nereden biliyorsunuz? Hiç kimseye söylememiştim bunu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110206
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110206,
					"content": "Gezgin, durumu bugün ona sen açıklayabilir misin? Paimon, her gün bunu yapmaktan usandı artık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110207,
						30110208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110207,
					"content": "Aslında her şeyi açıklamak zorunda değiliz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110209
					]
				},
				{
					"id": 30110209,
					"content": "Olur tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110210,
					"content": "Yeni büyük kılıcınla aniden daha iyi dövüşmeye başladın çünkü...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110211,
						30110212
					]
				},
				{
					"id": 30110211,
					"content": "Aynı günü birden çok kez yaşayıp duruyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110213
					]
				},
				{
					"id": 30110213,
					"content": "Ben yokken ne oldu size böyle? Bir tarikata falan mı katıldınız? Beyniniz mi yıkandı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110214
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110214,
					"content": "Bunu çok düşünmemeye ve söylediğimizi gerçekten kabul etmeye çalış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110215,
					"content": "Peki, öyle olsun. Doğru mu anladım? Bedenimin büyük kılıcı kullanmaya alıştığını ama zihnimin bunu hatırlamadığını söylüyorsunuz, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110216
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110216,
					"content": "Evet çünkü hafızan her gün siliniyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110217,
					"content": "İşte buna katılamayacağım. Bu imkansız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110218
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110218,
					"content": "Ha? Sence bunun nedeni ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110219,
					"content": "Her gün Sabzeruz Festivalini tekrar tekrar yaşıyorsak kullandığımız şeylere, harcadığımız paralara, yediğimiz yemeklere ne oluyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110220
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110220,
					"content": "Bu doğru olsaydı mantıken cüzdanımın çoktan boşalmış olması gerekirdi ve bunu fark ederdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110221
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110221,
					"content": "Bunu ben de düşündüm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110222,
						30110223
					]
				},
				{
					"id": 30110222,
					"content": "Yine de eğer bu işin arkasında bilgeler varsa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110224
					]
				},
				{
					"id": 30110224,
					"content": "Doğru. O gün herkesin neler yaptığını kaydetmek için Akaşa'dan yararlanabilir, sonra da her şeyi yenilemek için şehrin kaynaklarını kullanabilirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110225,
					"content": "Çok olası görünmüyor ama imkansız da değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110226,
					"content": "Hayır, bu imkansız. Üstelik kanıtım da var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110227
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110227,
					"content": "Kanıtın mı var? Nerede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110228,
					"content": "*iç çeker* Bu saçma sapan tartışmayı sürdürme konusunda kararlı gibisiniz. Öyle olsun, biraz daha oynayalım bakalım bu oyunu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110229
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110229,
					"content": "Gelin benimle. Bayan Dunyarzad, lütfen siz de gelin. Hâlâ buraların güvenli olup olmadığından emin değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110223,
					"content": "Şehrin tüm kaynaklarını ve Akaşa'nın onlara verdiği bilgileri kullanıyorlarsa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110224
					]
				},
				{
					"id": 30110212,
					"content": "Anılarımız da her gece sıfırlanıyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110213
					]
				},
				{
					"id": 30110208,
					"content": "Hemen konuya girelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110209
					]
				}
			]
		},
		{
			"id": 301103,
			"completionStepIds": [
				301103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301103",
							"2"
						],
						"stepId": 301103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dehya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30110301,
					"content": "İşte kanıt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110302
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110302,
					"content": "Ne? Bu ahşap talim kuklası mı? Nesi kanıt bunun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110303,
					"content": "Üzerindeki çizikleri görüyor musunuz? İşte bunlar günlerce süren çalışmanın eserleri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110304
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110304,
					"content": "Bilgelerin bunu her gün yenilemediğini varsayalım. O zaman paramparça olmaz mıydı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110305
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110305,
					"content": "Olurdu. Peki ya yeniliyorlarsa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110306,
					"content": "O zaman bilgelerin bu talim hedefine vurarak yaptığım her çiziği tek tek baştan oluşturmaları gerekirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110307
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110307,
					"content": "Ben profesyonel bir savaşçıyım. Dövüş sanatları okulundayken bizlere daima hassas bir kontrole sahip olmamız gerektiğini söylerlerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110308
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110308,
					"content": "Her vuruşun gücü, açısı, rakibe isabet ettiği nokta bilinçli bir şekilde hesaplanmalı. Bu yüzden bu talim hedefi üzerindeki her izi ve her vuruşum sırasında zihinsel olarak ne durumda olduğumu hatırlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110309
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110309,
					"content": "Hep söylendiği gibi, her kılıç ustasının kendi benzersiz stili vardır ve aynı kılıç ustası bile aynı darbeyi iki kez vuramaz. Yani bu çizikleri kopyalamak imkansızdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110310
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110310,
					"content": "Gerçekten imkansız mı? Her çiziği oymak için bir makina falan kullanmış olamazlar mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110311,
					"content": "Bir kameranın çektiği fotoğrafın asla bir ressamın resmi kadar iyi olamayacağını çünkü fotoğrafın ruhu olmadığını söylerler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110312
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110312,
					"content": "Burada da aynı şey geçerli. Oyulmuş çiziklerle dövüş talimi sırasında ortaya çıkmış çizikleri bir bakışta ayırt edebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110313,
						30110314
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110313,
					"content": "Bu mantıklı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110315
					]
				},
				{
					"id": 30110315,
					"content": "Umarım artık kafanızda soru işareti kalmamıştır. Baksana, bu alimler arasında çok popüler olan yeni Zeka Oyunu değil mi? Şaşırtıcı şekilde eğlenceli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110316
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110316,
					"content": "Neyse, geç oluyor. Ben Bayan Dunyarzad'a Nilou'nun sahnesine kadar eşlik edeyim. Sonra görüşürüz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110317
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30110317,
					"content": "Pekala, yine başa döndük. Anıların silindiğine dair teorimiz de mi hatalı yani? *iç çeker*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110318,
					"content": "En azından şimdilik birkaç sonuca ulaştık, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110319,
						30110320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110319,
					"content": "Zaman döngüsünde değiliz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110321
					]
				},
				{
					"id": 30110321,
					"content": "Öyle. Peki başka yeni fikrimiz var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110322,
						30110323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110322,
					"content": "Bir düşüneyim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110324
					]
				},
				{
					"id": 30110324,
					"content": "Tuhaf mı? Paimon'a göre son zamanlarda her şey bir tuhaf zaten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110325,
					"content": "Neden hiç şehirden ayrılmayı düşünmedik?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110326
					]
				},
				{
					"id": 30110326,
					"content": "Şehirden ayrılmak mı? Doğru ya, haklısın! Bu kadar basit bir çözümü hiç düşünmemiş olmamız gerçekten garip. Şehrin dışında zamanın normal aktığını görürsek birçok şey netleşir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110327,
					"content": "Paimon buna inanamıyor! Kendi teorilerimize kendimizi kaptırdığımız için mi yoksa çok yorulduğumuz için mi düşünemedik bunu sence?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30110328,
						30110329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110328,
					"content": "Bu gerçekten tuhaf.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110330
					]
				},
				{
					"id": 30110330,
					"content": "Gidip Nahida'ya sormaya ne dersin? Belki şehirden ayrılmakla ilgili bir şeyi unutmuşuzdur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30110329,
					"content": "Bunu uzun zaman önce düşünmeliydik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110330
					]
				},
				{
					"id": 30110323,
					"content": "Birden tuhaf bir şey fark ettim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110324
					]
				},
				{
					"id": 30110320,
					"content": "Gerçek dünyada değiliz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110321
					]
				},
				{
					"id": 30110314,
					"content": "Sanırım bu teoriden de vazgeçmemiz gerekiyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30110315
					]
				}
			]
		},
		{
			"id": 301104,
			"completionStepIds": [
				301104
			],
