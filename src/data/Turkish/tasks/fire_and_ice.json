			"dialogs": [
				{
					"id": 761830101,
					"content": "Davetin için teşekkürler Sandrone. Bu yemeğin tadı tıpkı hatırladığım gibi. Beni resmen eski günlere götürdü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830102
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 761830102,
					"content": "Rica ederim. İstersen Snezhnaya'ya döndüğümde daha sık bir araya gelebiliriz. Tıpkı eski günlerdeki gibi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830103
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761830103,
					"content": "Tabii isterim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830104
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 761830104,
					"content": "Snezhnaya'dan bahsetmişken, senin tarafında işler nasıl gidiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830105
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761830105,
					"content": "Majesteleri Çariçe'nin planlarında biraz yol katettik ancak Stuzha Projesini hayata geçirmek Başkanın umduğundan çok daha çetrefilli bir hal alıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830106
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 761830106,
					"content": "O zaman bundan sonra ikimiz de meşgul olacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830107
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761830107,
					"content": "Yine de arada sırada soluklanıp bir fincan çay içecek, hatta Korolevskiy Topluluğunun bir gösterisini izleyecek vaktimiz olur elbet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830124
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 761830124,
					"content": "Orası kesin. Yine de arada sırada soluklanıp bir fincan çay içecek, hatta Korolevskiy Topluluğunun bir gösterisini izleyecek vaktimiz olur elbet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830108
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 761830108,
					"content": "Odette hâlâ bale yapıyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830109
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761830109,
					"content": "Evet. Onu her gördüğümde kendini daha da aşıyor sanki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830110
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 761830110,
					"content": "Harika. Geri döndüğümde onu yeniden sahnede izlemeyi çok isterim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830111
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761830111,
					"content": "Gerçekten çok enteresan. Sanatını Rosalyne'in yanında öğrenmiş olmasına rağmen mizaçları ve tarzları birbirlerinden çok farklı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830112
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761830112,
					"content": "Bu ille de kötü bir şey demek değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830113
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 761830113,
					"content": "Haklısın... Rosalyne alev gibi bir tutkuyla dans ederdi, Odette ise kaskatı bir buz kütlesi kadar soğuk ve donuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830114
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761830114,
					"content": "Sanki omuzlarında ağır bir yük taşıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830115
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 761830115,
					"content": "Yine de sahneye çıktığında hareketleri öylesine duru ki, sanki yüreğinde zerre kadar leke yokmuş gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830116
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761830116,
					"content": "Ya da belki o tarz şeyleri kimsenin göremeyeceği kadar derinlere gömmüştür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830117
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 761830117,
					"content": "Belki de. Sonuçta buzun yaptığı da bu değil midir, çatlakları dondurup örter. Ama o öyle kırılgan biri değil, aksine sarsılmaz bir iradesi var. Hatta bana sorarsan tehlikeli biri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830118
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761830118,
					"content": "En azından bu yönüyle Rosalyne'i andırıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830119
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 761830119,
					"content": "Tehlikeli olduğu için mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830120
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761830120,
					"content": "İradesi bakımından.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830121
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 761830121,
					"content": "Sanırım haklısın. \"La Sinyora\" unvanını devralacak en güçlü aday olduğu söylentilerine şaşmamalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830122
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761830122,
					"content": "Hah... Onunla biraz daha kaynaşırsak çay partilerimize davet edebiliriz. Umarım bizi reddetmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830123
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761830123,
					"content": "Ben de öyle umuyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830124
					],
					"speakerTitle": "Yaver"
				}
			]
		},
