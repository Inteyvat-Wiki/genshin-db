			"dialogs": [
				{
					"id": 761830201,
					"content": "Arada bir kafa dinlemeye de vakit ayırmak lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830202,
						761830203
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 761830202,
					"content": "(Biraz daha oturalım.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830204
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761830204,
					"content": "Pekala öyleyse, Snezhnaya'da görüşmek üzere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yaver"
				},
				{
					"id": 761830203,
					"content": "Yavaş yavaş toparlansam iyi olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830204
					],
					"speakerTitle": "Kukla"
