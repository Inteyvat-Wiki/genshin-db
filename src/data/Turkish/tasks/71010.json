			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710100101,
					"content": "Yoldaşım ve ben çocukluğumuzdan beri savunma sanatlarına çalıştık. Görevimiz, kötülüğe karşı savaşmak ve bu dünyanın tüm kutsal değerlerini korumaktı. Ama Önsezimiz olmadan, bu görev hiç kolay olmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100102
					],
					"speakerTitle": "Harabe Hazinesi"
				},
				{
					"id": 710100102,
					"content": "Kendimizi daha da geliştirmek ve aradığımız Önsezileri bulmak için buraya sığındık. Uğraşlarımızın göstergesi olarak bu abideyi diktik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100103
					],
					"speakerTitle": "Harabe Hazinesi"
				}
			]
		},
		{
			"id": 7101002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7101006",
