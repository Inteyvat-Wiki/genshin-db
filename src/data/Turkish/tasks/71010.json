				{
					"id": 710100301,
					"content": "Canavarlar bu dünyada yaşamı değerli kılan her şeyi yok ediyorlar. Eli kılıç tutanlar, canavarların kökünü kurutmakla yükümlüdür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100302
					],
					"speakerTitle": "Harabe Hazinesi"
				},
				{
					"id": 710100302,
					"content": "Canavarlar kötüdür! Acımasız şekilde öldürülmekten başka bir şey hak etmiyorlar!",
