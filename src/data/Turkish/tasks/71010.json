			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710100201,
					"content": "Ama yoldaşım kendi Önsezisine kavuştuktan sonra, canavarlarla savaşmak yerine bana \"Canavarlar doğaları gereği mi kötüdür?\" diye sordu. Ben de cevap olarak \"Tüm dünyayı yakıp yıkıyorlar. Sonuçlarına ise masum insanlar katlanıyor. Bu yaptıkları, onlara karşı savaşmanı gerektirecek kadar kötü değil mi?\" dedim. Sanırım fazla meditasyondan beyni yandı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100202
					],
					"speakerTitle": "Harabe Hazinesi"
				},
				{
					"id": 710100202,
					"content": "Ben yine de bu canavarlarla savaşacağım. O gelse de gelmese de. Hatta Önsezim olmasa bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100203
					],
					"speakerTitle": "Harabe Hazinesi"
				}
			]
		},
		{
			"id": 7101003,
