			},
			"dialogs": [
				{
					"id": 735030101,
					"content": "Hah, işte bu güzel oldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030102
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030102,
					"content": "Yine mi bilmece hazırlıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030103
					]
				},
				{
					"id": 735030103,
					"content": "Gezgin! Tam zamanında geldin! Yeni bir bilmece serisi tasarlamak üzereyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030104
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030104,
					"content": "Buradaki arazi biraz karmaşık. Gördüğün gibi Kutsal Ağacın devasa köklerinin bir parçası limanın bir yanından suya giriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030105
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030105,
					"content": "Diğer yanında ise devasa bir nilüfer yaprağı ve limandan ayrılmayı bekleyen bir sürü gemi var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030106
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030106,
					"content": "Sence limanın hangi yanı bilmecenin teması için daha uygun Gezgin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030107,
						735030110,
						735030113
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030107,
					"content": "Kökün olduğu taraftan başlamak daha mantıklı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030108
					]
				},
				{
					"id": 735030108,
					"content": "Gerçekten mi? Kutsal Ağacın devasa kök sistemi oldukça dikkat çekici. Bilmecenin \"giriş noktası\" olarak da hemen göze çarpacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030109
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030109,
					"content": "Pekala! Kök sistemini tema olarak kullanarak bir bilmece yazacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030115,
						735030116
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030115,
					"content": "Hehe, ben bir tane yazayım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030115,
						735030116
					]
				},
				{
					"id": 735030116,
					"content": "Hehe, bana bırak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030117
					]
				},
				{
					"id": 735030117,
					"content": "Hey! Neden öyle sırıtıyorsun yahu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735030118,
					"content": "Bitti. Gel de bir bak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030119
					]
				},
				{
					"id": 735030119,
					"content": "\"Bilginin denize döküldüğü yerde, yelkenlerin yanında durur bir hazine.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030120
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030120,
					"content": "Okuması çok zevkli! Üstelik insanın aklına hemen \"limanı\" getiriyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030121
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030121,
					"content": "\"Bilginin denize döküldüğü yerde\" deyince bahsedilen yerin Akademide veya Sumeru Şehri'nde olduğunu anlamak da kolay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030122
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030122,
					"content": "Böyle bir yeteneğin olduğunu bilmiyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030123
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030123,
					"content": "Bekle bir dakika. Bu bilmeceyi herkesin kolayca keşfedebileceği bir yere yapıştıracağım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030124
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030124,
					"content": "Ne? Bu bölgede bir yere mi yapıştıracaksın? İyi ama bilmecedeki yer buraya yakın sayılır. Cevabı hemen bulurlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735030125,
					"content": "Hahaha, bilmeceyi çözecek kişilere belirli bir alan sunmak lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030126
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030126,
					"content": "Bunu yapmazsam alan aşırı büyük olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030127
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030127,
					"content": "Drusus bilmeceyi asar...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735030128
					]
				},
				{
					"id": 735030128,
					"content": "Pekala, bu alanın bilmecesi tamam. Bir sonraki yere gidelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030129
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030129,
					"content": "Ne? Bir sonraki yer mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735030110,
					"content": "Nilüfer yaprağı ve gemiler ilgi çekici olur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030111
					]
				},
				{
					"id": 735030111,
					"content": "Doğru... İkisi arasında bir bağlantı kurmak eğlenceli olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030112
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030112,
					"content": "Tamamdır. Bu temayı kullanarak bir bilmece hazırlayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030115,
						735030116
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030113,
					"content": "Bu temalar fazla kolay!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030114
					]
				},
				{
					"id": 735030114,
					"content": "Kolay mı? Senin fikirlerini duyalım o zaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030115,
						735030116
					],
					"speakerTitle": "Drusus"
				}
			]
		},
		{
			"id": 7350302,
