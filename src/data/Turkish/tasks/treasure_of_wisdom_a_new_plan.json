			"dialogs": [
				{
					"id": 735030201,
					"content": "Evet, ikinci bilmeceyi de buraya kuralım. Bu bilmeceyi çözen kişi son sandığı da bulabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030202
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030202,
					"content": "Son hazineyi... Şuraya yerleştireceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030203
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030203,
					"content": "Hımm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735030204,
					"content": "Şey...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030205
					]
				},
				{
					"id": 735030205,
					"content": "İyi de burası yanında sıradan küçük bir şelale olan sıradan küçük bir tepe sadece...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735030206,
					"content": "Evet, doğru! Tabii bilmecelerimiz sayesinde artık sıradan olmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030207
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030207,
					"content": "Peki bu bilmece için ne önerirsin Gezgin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030208,
						735030211,
						735030214
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030208,
					"content": "Bu seferki daha kolay anlaşılır olsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030209
					]
				},
				{
					"id": 735030209,
					"content": "Öyle mi dersin? Hımm... Doğru, bilmeceyi çözen kişiler buraya vardıklarında çok yorgun olurlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030210
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030210,
					"content": "Pekala, o zaman kolay anlaşılır olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030219,
						735030220
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030219,
					"content": "Bu konuda eğitim almış sayılmam...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030219,
						735030220
					]
				},
				{
					"id": 735030220,
					"content": "İşleyen demir ışıldar diyelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030221
					]
				},
				{
					"id": 735030221,
					"content": "Anladım. Tam da Gezginden beklenecek türde bir bilgelik... Tamam, yazdığın bilmeceyi buraya asacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030222
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030222,
					"content": "Drusus bilmeceyi asar...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735030223
					]
				},
				{
					"id": 735030223,
					"content": "Tamamdır! Bu ufak bildiri panosu iş görür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030224
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030224,
					"content": "O zaman hadi gidip son hazine sandığını da ayarlayalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030211,
					"content": "Şelaleyi tema olarak kullanalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030212
					]
				},
				{
					"id": 735030212,
					"content": "Hımm... Şelale gerçekten de çok net bir tema olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030213
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030213,
					"content": "Bana uyar, şelaleyi tema olarak kullanalım. Son bilmecenin zorluğuna gelecek olursak... Biraz kolaylaştırırsak daha iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030219,
						735030220
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030214,
					"content": "Hehe, ben bir tane yazayım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030215
					]
				},
				{
					"id": 735030215,
					"content": "Sen de gittikçe daha çok gülmeye başladın he!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735030216,
					"content": "Bitti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030217
					]
				},
				{
					"id": 735030217,
					"content": "\"Yeşil şemsiye incili perdeyi süzer.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030218
					],
					"speakerTitle": "Drusus"
				},
				{
					"id": 735030218,
					"content": "Hımm... Bu bilmece çok özel görünüyor. Bir yerden mi öğrendin yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030219,
						735030220
					],
					"speakerTitle": "Drusus"
				}
			]
		},
		{
			"id": 7350303,
