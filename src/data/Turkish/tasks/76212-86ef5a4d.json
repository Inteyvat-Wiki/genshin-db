			},
			"dialogs": [
				{
					"id": 762120301,
					"content": "Bir taraftaki kitaplığın en tepesinde duruyorsunuz...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762120304
					]
				},
				{
					"id": 762120304,
					"content": "Burası güvenli. Ne oldu altın dostum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120305,
						762120306
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120305,
					"content": "Hiç. Sadece seni biraz merak ettim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762120308
					]
				},
				{
					"id": 762120308,
					"content": "Burası yüksek, üstelik her yeri görebiliyorum. Saklanmak için iyi bir yer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120309
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120309,
					"content": "Bizim Calpul{RUBY#[D]Kabile}li'mizde yerde olmak tehlikeli kabul edilir. Üstümüzdeki Yüce {RUBY#[S]Hükümdar Lordlar}Hükümdarlar bizi anlık bir hevesle yok etmeye karar vermeseler bile diğer Calpul{RUBY#[D]kabileler}li'ler yine de bizi yağmalamaya gelebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120310
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120310,
					"content": "Quetzallar gibi uçurumlara ve ağaçlara tünemek, felaket baş göstermeden kaçmamızı sağlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120311
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120311,
					"content": "Ayrıca Vindia beni uçarken görmek istediğini söylüyor. Bir macera hikayesinde dev bir kuşa binmekle ilgili bir şarkı {RUBY#[D]yazmak}söylemek istiyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120312
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120312,
					"content": "Seninle dalga geçmediğinden emin misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762120313
					]
				},
				{
					"id": 762120313,
					"content": "Yok, hayır. Vindia çok iyi bir insandır, hatta belki de Kesişen Yolların Efendisi kadar iyidir. İkisi de pek kibar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120314
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120314,
					"content": "Bu arada sizin de bu kadar yükseğe uçabilmeniz inanılmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120315
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120315,
					"content": "Bu sizin için. Arkadaşlığımızın bir kanıtı olarak düşünün. Şimdi tehlikeden uzak kalmak için nasıl daha da yükseğe uçabileceğimizi düşünmem gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120316
					],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120316,
					"content": "Burada Yüce {RUBY#[S]Hükümdar Lordlar}Hükümdarlar ya da deri yüzmekten zevk alan istilacılar olmasa da... Nerede olursam olayım bir kaçış yolumun olmasına alıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quiauhquetzal"
				},
				{
					"id": 762120306,
					"content": "Yüksekte mahsur kalıp kalmadığını merak ettim de...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762120307
					]
				},
				{
					"id": 762120307,
					"content": "Teşekkür ederim ama hayır, burada mahsur kalmadım. Yüksekteyken güvendeyim. Burada öldüremezler beni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762120308
					],
					"speakerTitle": "Quiauhquetzal"
				}
			]
		}
	]
}