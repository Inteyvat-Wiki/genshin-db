			"dialogs": [
				{
					"id": 401181101,
					"content": "İlk defa tadı böyle bir çay içtim. Inazuma çayı, Sumeru çayından çok daha farklıymış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181102
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401181102,
					"content": "Ah, evet, Sumeru'da insanlar çaylarına baharat katıyorlar, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181103
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401181103,
					"content": "Evet, doğru! Gerçi ben buna hâlâ alışamadım... Bir seçim şansım olsaydı bazen uykusuzluk yapsa da kahveyi seçerdim.",
					"roleType": "TALK_ROLE_NPC",
