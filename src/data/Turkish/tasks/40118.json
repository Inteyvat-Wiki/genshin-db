			"trigger": {
				"objectNames": [
					"Klee",
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401181001,
					"content": "Bayan Generalle Çuf Çuf Vagona binmek istiyorum! Yukarı, yukarı, yukarı ve sonra... Yehuuu! Ama sanırım bu onun biraz başını döndürüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181002
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401181002,
					"content": "Aa, fark ettin demek? Çok iyisin. Bunu onun gözlerinde dönen yıldızlardan mı anladın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181003
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401181003,
					"content": "Hı hı, dün etrafında bir sürü altın yıldız döndüğünü söylemişti. Bugün çok daha iyi görünüyor ama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401181004
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401181004,
					"content": "Annem burada olsaydı yıldızların bulutlara düşen balıklar olduğunu söylerdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				}
			]
		},
