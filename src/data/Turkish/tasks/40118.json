			},
			"dialogs": [
				{
					"id": 401180901,
					"content": "Şanlı Lawrence Klanının soyundan gelen birisi olarak yolculuğum sırasında birçok yeni beceri edindim, mesela... Ekmek yapmak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180902
					],
					"speakerTitle": "Lessig"
				},
				{
					"id": 401180902,
					"content": "Güzel, şimdi tam ideal sıcaklıkta olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180903
					],
					"speakerTitle": "Lessig"
				},
				{
					"id": 401180903,
					"content": "Fırın kullanmayı bildiğini bilmiyordum... Asla mutfağa yaklaşmayan tiplerden olduğunu sanıyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180904
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401180904,
					"content": "Şey, bir süredir sormak istiyordum da... Daha sonra müsait olur musun? Bana o enfes atıştırmalıkları nasıl yaptığını öğretebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180905
					],
					"speakerTitle": "Lessig"
				},
				{
					"id": 401180905,
					"content": "Hı? Bu çok uzun sürebilir. Ayrıca buraya bir aile olarak birbirimizi daha iyi tanımaya gelmedik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401180906
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401180906,
					"content": "Yine Lawrence ailesindeki bağımızı düşünüyorsun... Sadece sıradan insanlar olduğumuzu sen söylememiş miydin? Neden sıradan kuzenler gibi birbirimizden bir şeyler öğrenmiyoruz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lessig"
				}
			]
		},
		{
			"id": 4011810,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
