					],
					"speakerTitle": "Oku"
				},
				{
					"id": 790490102,
					"content": "Demek şu dışarıdaki büyük, taş plakayı Idyia ressama tuval olarak vermiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790490103
					],
					"speakerTitle": "Oku"
				},
				{
					"id": 790490103,
					"content": "Hımm, belli ki ressam Veluriyam Serabı'nda hem çok sevdiği manzaralar bulmuş hem de Su Damlacıklarıyla arkadaş olup resimleri için yeni bir ilham edinmiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790490104,
						790490105
					],
					"speakerTitle": "Oku"
				},
				{
					"id": 790490104,
					"content": "Rastlantının bu kadarı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790490106
					]
				},
				{
					"id": 790490106,
					"content": "Ayy! Sen böyle deyince Paimon'un aklına başarısız oldukları için aklını yitiren kişiler geldi! Kendilerini kaybedene kadar pes etmeden çalışıyorlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790490107
					],
					"speakerTitle": "Oku"
				},
				{
					"id": 790490107,
					"content": "Bu ressam ise Idyia'nın verdiği resim malzemeleri ve Su Damlacıklarının arkadaşlığı sayesinde akıl sağlığını koruyabilmiş olmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
