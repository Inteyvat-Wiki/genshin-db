				"objectNames": [
					"Dokuzuncu Chang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120000501,
					"content": "*iç çeker* Gökler beni cezalandırıyor... Paramparça ediyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000502
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 120000502,
					"content": "Pardon, Dokuzuncu Chang siz misiniz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000503
					]
				},
				{
					"id": 120000503,
					"content": "Aha! Ne istiyorsunuz? Hadi çıkarın ağzınızdaki baklayı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000504
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 120000504,
					"content": "Etrafa yayılmış tonlarca eski kitabın olduğunu duyduk ve Teyvat Seyahat Rehberinin Liyue cildini ödünç almak istiyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000505,
					"content": "Hımm. Beni kitaplarım hakkında konuşturmayın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000506
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 120000506,
					"content": "Kanyon kapatıldıktan sonra aile yadigarı madencilik işi kötüleşmeye başladı. Ardından Fatui, beni sabote etme çalışmalarına başladı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000507
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 120000507,
					"content": "Borçlarımı ödemek için çok sevdiğim kitap koleksiyonumu rehin vermekten başka şansım yoktu. Tüm kitapları! Bunun ne anlama geldiğine dair bir fikriniz var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000508,
						120000509
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 120000508,
					"content": "Şu anda okuyacak hiçbir şeyin olmadığı için üzgün müsün?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000510
					]
				},
				{
					"id": 120000510,
					"content": "Hayır! Bu, benim hayatımın işiydi! Tüm hayatımı kitapları iyileştirmeye, koleksiyonculuğa, korumaya adadım... Ama artık hepsi gitti! Size söylüyorum, gittiler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000511
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 120000511,
					"content": "*iç çeker* Size böyle bağırarak söylenmenin bir yararı yok. Onları geri almak için tek yapabileceğim şey yeterince Mora biriktirmek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000512
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 120000512,
					"content": "Burada başka işiniz yoksa sizinle konuşmamız bitti. Hoşça kalın! Hadi artık gidin! Hadi, gidin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000513
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 120000513,
					"content": "Lütfen bana Parçalanmış Baltalı Mızrak Efsanesinin altıncı cildini rehin vermediğini söyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000514
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000514,
					"content": "Parçalanmış Baltalı Mızrak Efsanesi... Uzun zamandır duymadığım bir ad. İyi bir zevkin var evlat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000515
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 120000515,
					"content": "Nasıl yani, bizim iyi bir zevkimiz yok mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000516,
					"content": "O eser, çığır açan bir başyapıttı. Rehin verdim, yayınlandığında neredeyse bilinmiyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000517
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 120000517,
					"content": "Ama zamanla savaş sanatı roman türünün tanımı haline gelen bir eser oldu ve birçok taklit eserin çıkmasına yol açtı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000518
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 120000518,
					"content": "İlk baskının neredeyse hiçbir kopyası basılmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000519
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 120000519,
					"content": "Sonraki baskı yayınlanır yayınlanmaz tuhaf bir şekilde tükendi ama iddialara göre orijinal hikayeye ekleme yaptığı düşünüldüğünde bu bir utanç.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000520
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000520,
					"content": "Evet! Bu doğru, nasıl unuturum? Bu eserin orijinal baskı altıncı cildi çok nadirdir, paraya ne kadar ihtiyacım olursa olsun onu asla rehin vermeye gönlüm el vermedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000521
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 120000521,
					"content": "Yani... Yani o kitap hâlâ sende mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000522
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000522,
					"content": "Evet. O, geriye kalan biricik hazinem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000523
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 120000523,
					"content": "Hey! Chang!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000524
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000524,
					"content": "Beni ve patronumu bu şekilde beklettiğine göre epey cesur olmalısın. Bir yanıta ihtiyacım var! Cor Lapisi satacak mısın yoksa satmayacak mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000525
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000525,
					"content": "Soylu Maocai'a bulaşırsan Fatui'ye de bulaşmış olacağını hatırlatmama gerek yoktur sanıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000526
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000526,
					"content": "*iç çeker* Yine sen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000527
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 120000527,
					"content": "Ama fiyatta yüzde yetmişlik bir indirimi karşılayamayacağımı biliyorsun... Koleksiyonumu asla geri satın alamayacağım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000528
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 120000528,
					"content": "Bu senin sorunun. Asıl soru şu, kitaplarını mı istiyorsun yoksa tabağında yemek görmek mi? Belki de erkenden mezara girerek kitaplarını yanına almayı tercih ediyorsundur, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000529
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000529,
					"content": "*Ahh* Sen... *iç çeker*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000530
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 120000530,
					"content": "Hey, dostum. Hadi ama. Bu beyefendi, bir anlaşma yapmaya istekli olabilir de olmayabilir de. İsteğinin dışında onu satmaya zorlayamazsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000531
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000531,
					"content": "Sen kim olduğunu sanıyorsun? Başka insanların işlerine burnunu sokma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000532
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000532,
					"content": "Efendim, bu beyefendiye ihtiyacı olduğunda yardıma gelen biriyim. Ben Guhua Klanı üyesi Xingqiu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000533
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000533,
					"content": "Ahahahahahahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000534
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000534,
					"content": "\"Guhua Klanı\"! Bu soytarıyı duydunuz mu? Kendisinin bir Guhua ustası olduğunu sanıyor! Bu günde ve bu çağda! Hahahahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000535
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000535,
					"content": "Guhua'nın son atalarının şimdiye dek ölüp gittiğini düşünüyordum. O zaman sen kimsin, bir çeşit Guhua mesihi falan mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000536
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000536,
					"content": "Adalet, geçmişimizi göz ardı eder dostum. Bu da beni, doğru şeyi yapmaya çalışan biri yapıyor. Ya sen? Kaplanın emrine itaat eden gelincik ustasından daha az güçlü olabilir ama daha az suçlu değildir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000537
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000537,
					"content": "Şu çocuğa da bakın! Sen bekle bakalım, beni karşına aldığına üzüleceksin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000538
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000538,
					"content": "Ve sen Chang... İstesen de istemesen de o Cor Lapisi satacaksın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000539
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000539,
					"content": "*iç çeker* Kurtlar, düşmüş kaplanı nasıl yiyip bitirirse öyle bir durum. Günlerim sayılı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000540
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 120000540,
					"content": "... O zaman daha önce konuştuğumuz konuya geri dönelim, o kitabı ödünç alma konusunda bir evet ya da hayır alabilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000541,
						120000542
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000541,
					"content": "Hayret bir şey, adama biraz süre ver!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000543
					]
				},
				{
					"id": 120000543,
					"content": "Ah, şu anda ne anlamı var ki? Birinin beni önemsemesini bekleyemiyorum artık. Ama beni savunduğun için lütfen bu kitabı al ve beni rahat bırak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000544
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 120000544,
					"content": "Üç koca yıl boyunca bugünü bekledim! Kelimeler, minnettarlığımı ifade edemez... Ben Xingqiu, bu büyük cömertliğin karşılığını vermeye ant içiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000545
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000545,
					"content": "Pekala, artık huzur ver! Bitirdiğinde geri getirmen yeterli. Üzgünüm ama kendini Guhua üyesi ilan eden birine umut bağlamam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000546
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 120000546,
					"content": "Hey! Nereye gidiyorsun? Burada hâlâ yapılacak işimiz var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000542,
					"content": "İki kelime: Durumsal farkındalık...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000543
					]
				},
				{
					"id": 120000509,
					"content": "Okuyacak hiçbir şeyin olmadığı için şu anda sıkılıyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000510
					]
				}
			]
		},
		{
			"id": 1200006,
