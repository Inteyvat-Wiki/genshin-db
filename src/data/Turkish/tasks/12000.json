			"dialogs": [
				{
					"id": 120000201,
					"content": "Wanwen Kitabevi... Sanırım burası, Liyue'de kitap satın almaya gittiğimiz yer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000202,
					"content": "Teyvat Seyahat Rehberinin Liyue cildinin bir kopyası olup olmadığını buraya soralım mı? Son derece ilginç bir kitap!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1200003,
			"completionStepIds": [
				1200003
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200003",
							"2"
						],
						"stepId": 1200003,
						"stateName": "QUEST_STATE_UNFINISHED"
