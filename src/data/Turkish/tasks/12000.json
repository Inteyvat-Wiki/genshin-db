				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jifang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120000301,
					"content": "Çevreye göz atmaktan çekinmeyin, satın almak zorunda değilsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000302
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000302,
					"content": "Teyvat Seyahat Rehberinin Liyue cildini arıyoruz. Elinizde var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000303,
					"content": "Üzgünüm canım, çok uzun zaman önce stoklara almayı bıraktık. Pek satmıyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000304
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000304,
					"content": "Hı? Ama Mondstadt cildi çok ilginçti! Kahretsin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000305,
					"content": "Şöyle ki, yazar onu çok kişiselleştirdi ve sonuç olarak pek de bir rehber niteliğinde değildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000306
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000306,
					"content": "Zar zor birkaç kopya sattı ve sonrasında onu satın alan birkaç yolcu şikayette bulundu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000307,
						120000308
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000307,
					"content": "Aşırı tutkuluydu ama yeterince anlaşılır değildi, öyle mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000309
					]
				},
				{
					"id": 120000309,
					"content": "Aslında yazık oldu. Mondstadt cildi, bir maceracının günlüğü olarak bile iyi bir kitaptı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000310,
					"content": "Kitabın elimde olmadığı gerçeği değişmiyor. Onu okumanız gerekiyorsa Dokuzuncu Chang'ın evinde şansınızı deneyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000311
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000311,
					"content": "Dokuzuncu Chang kim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000312,
					"content": "Qingce Köyü'nde yaşayan bir kitap koleksiyoncusu. Tam bir huysuzdur ancak konu kitaplar olunca dilinden bal damlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000313
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000313,
					"content": "Liyue Limanı'nda yaşarken buranın düzenli bir müşterisiydi ve hâlâ ona arada sırada baskısı tükenmiş tuhaf bir iki kitap gönderirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000324
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000324,
					"content": "Yaşadığı yere ulaşılması zordur. Qingce Köyü'nün tam arkasındaki dağa gitmeniz gerekir, sonrasında yol boyunca ağaçlı yolu takip edin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000314
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 120000314,
					"content": "Biri \"baskısı tükenmiş kitaplar\" mı dedi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000315
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000315,
					"content": "\"Parçalanmış Baltalı Mızrak Efsanesi\"nin altıncı cildinin de koleksiyonunda olma ihtimali var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000316,
						120000317
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000316,
					"content": "Kimsin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000318
					]
				},
				{
					"id": 120000318,
					"content": "Üzgünüm efendim, görgüsüzlük yaptım. Benim adım Xingqiu, yoldan geçen mütevazı bir edebiyat hayranıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000319
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000319,
					"content": "İkimiz de kayıp kitapların peşinde olduğumuza göre Qingce Dağı'na beraber seyahat edip Dokuzuncu Chang'ı ziyaret etmeye ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000320,
						120000322
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000320,
					"content": "Kulağa mantıklı geliyor. Lütfen önden buyur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000321
					]
				},
				{
					"id": 120000321,
					"content": "Zevkle, kitapsever dostum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000322,
					"content": "Bilmiyorum, kulağa oldukça uzun ve zorlu bir yolculukmuş gibi geliyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000323
					]
				},
				{
					"id": 120000323,
					"content": "Bunu Liyue Limanı'nın koşuşturmacasında biraz soluklanmak için bir şans olarak değerlendirin. Arada bir hepimizin buna ihtiyacı var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000317,
					"content": "İnsanlara böyle gizlice yaklaşmamalısın!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000318
					]
				},
				{
					"id": 120000308,
					"content": "İçerik biraz fazla abartılıydı, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000309
					]
				}
			]
		},
		{
			"id": 1200005,
