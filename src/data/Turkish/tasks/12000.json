				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120000601,
					"content": "Okumayı seviyorsun, değil mi? Bay Beş Saniyelik Kahraman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000602,
					"content": "Ha ha, harika... Bunu HİÇ beklemiyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000603
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000603,
					"content": "Merhaba! Xingqiu! Orada kimse var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000604,
					"content": "Bu kitabın peşine düşülmesine şaşmamalı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000608
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000608,
					"content": "AH!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000605,
						120000606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000605,
					"content": "Dokuzuncu Chang'ın evindeki o adam oldukça sertti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000607
					]
				},
				{
					"id": 120000607,
					"content": "Zavallı yaşlı Dokuzuncu Chang'a nasıl böyle zorbalık yapıp onu cevherini yok pahasına satmaya zorlarlar? Bu güpegündüz soygun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000609,
						120000611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000609,
					"content": "İkimiz birlikte Dokuzuncu Chang'a yardım etmenin bir yolunu bulmalıyız.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000610
					]
				},
				{
					"id": 120000610,
					"content": "Beni unutmayın. Ben de bu işte varım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000613
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000613,
					"content": "Ha, demek ŞİMDİ ne dediğimizi duyabiliyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120000614,
					"content": "Bu kitabı ödünç almamın nedeni şuydu; Dokuzuncu Chang bunu rehin vermek zorunda kalırsa gerçekten çok yazık olacaktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000615
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000615,
					"content": "Dokuzuncu Chang'a söylediklerimin arkasındayım. İyiliğinin karşılığını vereceğim. Yapılması gereken şey budur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000616
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000616,
					"content": "Bu kitabın koruyucusu olacağım ve koleksiyonunun geri kalanını satın almanın bir yolunu bulmaya yardım edeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000617,
						120000618
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000617,
					"content": "Zaten bir planın var, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000619
					]
				},
				{
					"id": 120000619,
					"content": "Elbette var. Ama sadece bir başlangıç planı. Hâlâ detaylar üzerinde çalışmam gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000620
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000620,
					"content": "Düşünmem için bana biraz süre verin. Uzun sürmeyecek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000621
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000621,
					"content": "Hâlâ burada mısınız? Nedir bu, sizin için bir oyun mu? Kimsenin gerçekten incinmeyeceğini mi düşünüyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000622
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000622,
					"content": "Hıh. Ahmak Klanına hakkını vermeliyim... Sayı ve yetenek eksikliğinizi cesaretle kapatıyorsunuz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000623
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000623,
					"content": "Ah, üzgünüm. Ahmak Klanı mı dedim? Guhua Klanı demek istemiştim... Bu, siz ahmakların verdiği isimdi, değil mi? Hahahahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000624
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000624,
					"content": "Şöyle bir söz vardır: \"Küçük dağları ben yarattım sanıp kendini fasulye gibi nimetten saymak.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000625
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000625,
					"content": "Atasözlerinden alıntı yapmayı bırak seni soytarı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000626
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000626,
					"content": "Lütfen burayı terk edin. Dürüst bir tüccara baskı yapma girişimine izin vermeyeceğim, özellikle de tehdit etmeye kalkıştığınız kişi, minnettarlık borcum olan kişi olduğunda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000627
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000627,
					"content": "Chang için kendini tehlikeye atman çok tatlı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000628
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000628,
					"content": "Ama yanlış zamanı seçtin seni küçük serseri! Arkamı kollaması için Fatui'yi getirdim. Küçük Guhua dostlarından oluşan ordun artık sana yardım edemeyecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000629
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000629,
					"content": "Genç olabilirim efendim ama seçtiğim yol nedeniyle çatışmalara yabancı değilim. Neden kötülük karşısında korkudan sineyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000630
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000630,
					"content": "Güzel konuşmaydı. Ama artık dersini alma zamanı geldi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120000618,
					"content": "Hiçbir planın yok, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000619
					]
				},
				{
					"id": 120000611,
					"content": "O zaman sanırım Operasyon: Liyue Seyahat Rehberini bir kenara bırakıyoruz, öyle mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000612
					]
				},
				{
					"id": 120000612,
					"content": "Neden kitap arayışını bu kadar çabuk bırakıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120000613
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120000606,
					"content": "Chang'ın evindeki o sert adam, \"Soylu Maocai\" için çalışıyor gibiydi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120000607
					]
				}
			]
		},
		{
			"id": 1200010,
