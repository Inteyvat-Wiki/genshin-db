			},
			"dialogs": [
				{
					"id": 120001001,
					"content": "Taktığın şeyin sıradan bir kolye olduğunu düşünmüştüm, bir Önsezi olduğunu değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001002
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120001002,
					"content": "Bu turu kazandın ama arkanı kollasan iyi edersin! Bu iş bitmedi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001022
					],
					"speakerTitle": "Changhu"
				},
				{
					"id": 120001022,
					"content": "Derslerini aldıklarını ummak çok mu fazla olur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001003,
						120001005
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120001003,
					"content": "O zaman sen bir Önsezi taşıyıcısısın!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120001004
					]
				},
				{
					"id": 120001004,
					"content": "Evet ama onu kullanmaktan kaçınmaya çalışıyorum. Rakiplerime karşı bana verdiği haksız avantajı sevmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001008
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120001008,
					"content": "Şimdilik gittiler ama çok geçmeden daha fazla sorun çıkarmak için geri dönecekler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120001009,
					"content": "Bana nezaket gösteren kişilere hiç zarar gelmeyeceğinden emin olacağım. Bu işi yapmanın bir adil bir de adil olmayan bir yolu var. Sorunun en iyi şekilde çözülmesini sağlayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001010
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120001010,
					"content": "Fatui'nin bir iş anlaşmazlığı durumunda taraf seçme lüksü yok. Ama ayakçılarının kendinden emin davranışı, sözlerinin gerçek olduğunu gösteriyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001011
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120001011,
					"content": "Buradaki işte daha derin bir gizli anlaşma olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001012
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120001012,
					"content": "Soylu Maocai'dan bahsetmişti. Bu adı biliyorum... Liyue Limanı'nda görkemli bir evi var. Belki ikiniz gidip araştırabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001013
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120001013,
					"content": "Bu fikir güzel... Ama sen ne yapacaksın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001014
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120001014,
					"content": "Ben mi? Araştırmam gereken başka şeyler var... Sonrasında Liyue Limanı'ndaki Yujing Terası'nda buluşalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001015
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120001015,
					"content": "Gerçekten yapacak işlerin mi var? Bizi ayakçıların olarak kullanmadığına emin misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120001016,
					"content": "Vay canına... Demek böyle sonuçlandı! Tüm bu metin... Olağanüstü!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001017
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120001017,
					"content": "AHH! Bu adam ÇOK SİNİR BOZUCU! Paimon, onun aptal yüzünün tam ortasına vurmak istiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001018,
						120001019
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120001018,
					"content": "İlk önce Dokuzuncu Chang'a yardım edelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120001020
					]
				},
				{
					"id": 120001020,
					"content": "Hımm. İYİ! Ama geleneğe göre Paimon, ona çirkin bir lakap takmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001021
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120001021,
					"content": "Şu andan itibaren şöyle bilinecek... Guhua İneği!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120001019,
					"content": "Xingqiu hemen intikam almayabilir ama elbet gerçekleşecek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120001020
					]
				},
				{
					"id": 120001005,
					"content": "Guhua, görünenden daha fazlası!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120001006
					]
				},
				{
					"id": 120001006,
					"content": "H-Hayır, hayır, yanlış anladınız. O adamın ağzı bozuk olduğu kesin ama Guhua Klanının durumuna dair yorumu, şey... Tam olarak yanlış değil sanırım. *iç çeker*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001007
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120001007,
					"content": "Guhua'yı eski görkemine kavuşturmayı çok istesem de bu hiç kolay bir görev değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120001008
					],
					"speakerTitle": "Xingqiu"
				}
			]
