			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80010101,
					"content": "Şu işe bak, yine karşılaştık... Tahmin ettiğimden de çabuk oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010102
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010102,
					"content": "Hey, bu Dain!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010103,
					"content": "Görünüşünüze bakılırsa az önce başınıza oldukça tuhaf bir şey gelmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010104
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010104,
					"content": "Acaba o harabelerde bir Hiçliğin Habercisi ile karşılaşmış olabilir misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010105
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010105,
					"content": "Nasıl? Nereden bildin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010106,
					"content": "Hiçliğin Habercisinin izini sürüyordum. Sizi burada bulmayı beklemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010107,
						80010108
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010107,
					"content": "Aslında, tek karşılaştığımız Hiçliğin Habercisi değildi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010109
					]
				},
				{
					"id": 80010109,
					"content": "Ters çevrilmiş bir Yedilerin Heykeli... Elinde Hiçliğin gücünü mü tutuyordu? Hayır, Hiçliğe karşı savaştığım süre boyunca böyle bir şeyi hiç görmedim... Bazı şüphelerim olmasına rağmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010110
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010110,
					"content": "Orada olanların tamamını anlatın bana. Hiçlik gücüyle dolu harabelerden kaçtınız, peki sonra ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010111
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010111,
					"content": "Sonrasında çıkışa doğru yaklaştık ve bir Hiçliğin Habercisi aniden belirerek önümüzü kesti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010112,
					"content": "O şeyle savaşımız zordu. Henüz çok uzaklaşmış olamaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010113,
					"content": "Evet, bu oldukça nadir bir fırsat. Gelin, onu yakalayalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010114,
						80010115
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010114,
					"content": "Evet efendim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010116
					]
				},
				{
					"id": 80010116,
					"content": "Hadi gidelim! Bu nadir bir fırsat! Dain'in yardımıyla Hiçliğe dair sırları çözebiliriz belki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010115,
					"content": "Bir saniye, sana görev veren bendim hani...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010116
					]
				},
				{
					"id": 80010108,
					"content": "Harabelerde Hiçliğin Habercisinden çok daha tuhaf bir şey vardı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010109
					]
				}
			]
		},
		{
			"id": 800102,
			"completionStepIds": [
				800103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
