				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80010201,
					"content": "Şu Hiçlik Büyücüleri... Az önce bizi pusuya düşürmeyi mi denediler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010202,
					"content": "Hayır, şu terk edilmiş Harabe Muhafızlarını kazıp geçerek değerli bir şeyleri bulmanın peşindeydiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010203
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010203,
					"content": "Ah, demek öyle... Buradaki Gezgin de bunu çok yapıyormuş gibi duruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010204,
					"content": "Kaos Cihazlarını, Kaos Devrelerini aramak... Bilirsin işte, o tarz şeyler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010205,
						80010206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010205,
					"content": "Evet, onlar önemli malzemeler!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010207
					]
				},
				{
					"id": 80010207,
					"content": "Bu tarz sıradan nesnelerin peşine düşmüş olamazlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010208
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010208,
					"content": "Aslında, Hiçlik Büyücüleri keşif amacıyla sıklıkla o harabelerden çıktığı için çevrede araştırma yapıyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010209
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010209,
					"content": "Değerli bir nesneyi bulup harabelere geri götürmek için Harabe Muhafızlarının kalıntılarını arıyor gibiydiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010210
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010210,
					"content": "Fakat hayal kırıklıkları yüzlerinden okunuyordu, herhalde aradıklarını henüz bulamamışlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010211
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010211,
					"content": "Peki öyleyse neden şimdi bir tanesini yakalayıp ne işler karıştırdıklarını sormadın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010212,
						80010213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010212,
					"content": "Evet, Usta Diluc daha önce öyle yapmıştı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010214
					]
				},
				{
					"id": 80010214,
					"content": "Hiçlik canavarlarına karşı hiç de vicdanlı olmak gibi bir niyetim yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010215
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010215,
					"content": "Ama şu nesneyle ilgili planlarının bütün Hiçlik Tarikatı için büyük bir öneme sahip olduğunu düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010216
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010216,
					"content": "Sorgulayarak bunun arkasındaki gerçeğe ulaşamazsınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010217
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010217,
					"content": "Aksine, Hiçlik Büyücülerinin acı dolu bir sorgulamadan daha çok korktukları bir şey olabilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010218,
						80010219
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010218,
					"content": "Korku...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010220
					]
				},
				{
					"id": 80010220,
					"content": "Ah... Bunu düşündükçe Paimon'un tüyleri diken diken oluyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010221,
					"content": "Pekala, burada çok fazla zaman kaybetmeyelim. Aramaya devam edelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010219,
					"content": "Harabelerde gördüklerimizle ilgili bir şey mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010220
					]
				},
				{
					"id": 80010213,
					"content": "Onlara karşı daha sert olmalısın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010214
					]
				},
				{
					"id": 80010206,
					"content": "Hiçlik Büyücüleri öyle şeyleri aramıyordur muhtemelen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010207
					]
				}
			]
		},
		{
			"id": 800103,
			"completionStepIds": [
				800105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800105",
							"2"
						],
						"stepId": 800105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80010301,
					"content": "Vay canına... Hiçlik Tarikatının yanı sıra Harabe Muhafızları da burada cidden aktif durumda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010302,
					"content": "Görünüşüne göre nerede bir Hiçlik Büyücüsü sığınağı bulsak orada sıklıkla çevrede dolaşan bir grup Harabe Muhafızı da oluyor. Bu bir tesadüf mü? Yoksa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010303,
					"content": "Dünyada tesadüf diye bir şey yoktur. Hepsi çok uzun zaman önce atılan tohumların meyvesi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010304
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010304,
					"content": "Tıpkı o handa bulunmanız gibi... Zaman, o tohumların filizlenmesini bekliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010305,
						80010306
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010305,
					"content": "Ama ben şans eseri senin adını duydum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010307
					]
				},
				{
					"id": 80010307,
					"content": "Unut gitsin. Sadece gereksiz fikirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010308
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010308,
					"content": "Hiçlik Tarikatı ile Harabe Muhafızları arasındaki bağlantı tesadüf olamaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010309
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010309,
					"content": "Aksine, bu ikisi aynı kökten büyüyen ağacın dalları.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010310
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010310,
					"content": "\"Dallar\" mı? \"Kök\" mü? Tam olarak ne demek istiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010311,
					"content": "Her ikisinin de kökeni 500 yıl önce yok olmuş kadim bir ulusa dayanıyor, Khaenri'ah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010312
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010312,
					"content": "Hı? Khaenri'ah mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010313,
					"content": "Gerçekten mi? Hiçlik Tarikatı ve Harabe Muhafızları o ulustan geriye kalan şeyler mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010314,
					"content": "Ah... Khaenri'ah demişken, bu gerçekten çok eski bir ad...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010315,
					"content": "Evet, tamam. Rehberin olarak, Paimon biraz açıklamada bulunsun. Uzun bir zaman önce, Khaenri'ah ulusu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010316,
					"content": "Khaenri'ah'yı biliyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010317
					]
				},
				{
					"id": 80010317,
					"content": "... Ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010318,
					"content": "Khaenri'ah'ya dair anılarım var çünkü.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010319
					]
				},
				{
					"id": 80010319,
					"content": "Orada olduğuna dair anıların mı var? Ama o ulus 500 yıl önce yok oldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010320,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010321
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010321,
					"content": "Öyle mi? Pekala herkesin bir sırrı vardır. Sen benimkileri kurcalama, ben de seninkileri kurcalamayayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010322
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010322,
					"content": "Ama anlatmak istersen dinlerim... Peki, gördüğün Khaenri'ah neye benziyordu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010323,
						80010324,
						80010325,
						80010362
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010323,
					"content": "(Pekala, artık bunu ondan daha fazla saklayamam...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010326
					]
				},
				{
					"id": 80010326,
					"content": "Demek tüm hikaye bu, öyle mi? Paimon, ilk olarak o bilinmeyen tanrıyla karşılaştığını düşünmüştü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010327,
					"content": "#Anlıyorum... Yani, bu dünyaya gelişine dair ilk hatıran {F#erkek kardeşin}{M#kız kardeşin} tarafından o gök taşı içerisinde uyandırılman...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010328
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010328,
					"content": "#Görünüşe göre ilk önce {F#erkek kardeşin}{M#kız kardeşin} uyanmış ama esas soru senden ne kadar önce uyandığı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010329,
					"content": "Sonra da, sana Khaenri'ah'nın yıkılışının tüm dünyayı kaosa sürüklediğini ve ikinizin Teyvat denilen bu dünyadan gitmeniz gerektiğini mi söyledi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010330
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010330,
					"content": "\"Khaenri'ah'nın yıkılışı\" mı? Öyle mi dedi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010331,
						80010332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010331,
					"content": "Evet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010333
					]
				},
				{
					"id": 80010333,
					"content": "Tanık olduğun o yıkım... 500 yıl öncesinin tarihi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010334
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010334,
					"content": "Anlattığına bakılırsa bu dünyada uyandığın tarih gerçekten de o dönemmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010335
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010335,
					"content": "Hım... Kardeşin bu dünyayı senden daha iyi anlamış olacak ki ilk önce o uyanmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010336,
					"content": "Çok kısa bir süre sonra da önünüzü kesen bilinmeyen bir tanrıyla karşılaşmışsınız ve sen de kaçamamışsın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010337
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010337,
					"content": "Şey, Paimon bu kısmı çok iyi biliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010338,
					"content": "Anlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010339
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010339,
					"content": "O anda kalkıp aceleyle diğer bir dünyaya kaçmaya çalıştığında Khaenri'ah hakkında hiçbir şey bilmiyordun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010340
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010340,
					"content": "Ama şimdi, Teyvat'a dair bazı şeyleri öğrendiğin için yıllar önce tanık olduğun o savaşın Khaenri'ah'nın sonunu getiren savaş olduğunu tahmin edebiliyorsun... Yanılıyor muyum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010341
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010341,
					"content": "Ah! Öyleyse, geçtiğimiz birkaç aydan beri maceraların boyunca bulduğun her kitabı incelemiş olmalısın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010342
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010342,
					"content": "Mondstadt'a gitmeden önce bazı tuhaf şeylere bakmıştın. Sonrasında Mondstadt ve Liyue'nin dört bir yanından bir sürü eski kitabı toplamayı başardık ama sen Paimon'a bunların gereksiz olduğunu söyledin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010343,
					"content": "Yani bunca zamandır kardeşini bulmak için Khaenri'ah'ya dair daha fazlasını öğrenmeye çalışıyordun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010344,
						80010345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010344,
					"content": "Yedilerin peşine düştükten sonraki en ümit verici ikinci ipucu bu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010346
					]
				},
				{
					"id": 80010346,
					"content": "Ah tabii... Yedileri bulmak için yedi ulusu dolaşabilirsin ama 500 yıl önce yıkılmış bir ulusu bulmak için nereye gidebilirsin ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010347
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010347,
					"content": "Muhtemelen Khaenri'ah hakkında ikinizin bildiğinden daha fazla şey biliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010348
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010348,
					"content": "Khaenri'ah tanrısız bir ulustu, tanrı öldüğü ya da onları terk ettiği için değil hiçbir zaman bir tanrıları olmadığı için.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010349
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010349,
					"content": "Yalnızca insanlar tarafından inşa edilmiş kudretli bir medeniyetti, eşi benzeri görülmemiş bir şekilde gelişen şanlı bir medeniyetti. İnsanoğlunun gurur kaynağıydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010350
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010350,
					"content": "Bir ulus... Tanrısız nasıl olabilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010351
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010351,
					"content": "Sonrasında olaylar tam da hatırladığın gibi gelişti. Her şey harap edildi... Tanrılar tarafından.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010352
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010352,
					"content": "Yani diyorsun ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010353
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010353,
					"content": "500 yıl önce tanrılar dünyaya indi ve Khaenri'ah'yı yerle yeksan etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010354
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010354,
					"content": "\"İnsanoğlunun gururu\" yerinden sökülüp atıldı ve yok edildi. Tanrıların bahçesindeki bir ayrık otu gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010355
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010355,
					"content": "Bu nasıl olabilir? Tarih kitapları bu olay hakkında hiçbir şeyden bahsetmiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010356,
						80010357
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010356,
					"content": "Bu korkunç...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010358
					]
				},
				{
					"id": 80010358,
					"content": "Evet. Pekala, geçmiş hakkında konuşmaya devam etmek ruhumuzu sıkmaktan başka bir işe yaramayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010359,
						80010360
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010359,
					"content": "(Ama bir daha Venti'yi ya da Zhongli'yi görürsem...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010361
					]
				},
				{
					"id": 80010361,
					"content": "Yolumuza devam edelim. Aramaya devam ederken bilmek istediklerine dair daha fazlasını anlatacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010360,
					"content": "(Tanrıların yaptıklarına dair söyleyeceklerini duymam gerek.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010361
					]
				},
				{
					"id": 80010357,
					"content": "Ne tehlikeli bir dünya... Elimi çabuk tutup kardeşimi bulmalıyım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010358
					]
				},
				{
					"id": 80010345,
					"content": "Elimizde sadece gidilecek bir yer adı olmasına rağmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010346
					]
				},
				{
					"id": 80010332,
					"content": "O zaman duyduğum buydu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010333
					]
				},
				{
					"id": 80010324,
					"content": "(Dain ve Khaenri'ah... Denemeye değer.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010326
					]
				},
				{
					"id": 80010325,
					"content": "(Beni uykumdan uyandıran kişi...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010326
					]
				},
				{
					"id": 80010362,
					"content": "(Sonra şu alev denizi...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010326
					]
				},
				{
					"id": 80010306,
					"content": "Hiç anlamıyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010307
					]
				}
			]
		},
		{
			"id": 800104,
			"completionStepIds": [
				800107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800107",
							"2"
						],
						"stepId": 800107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80010401,
					"content": "Hı? Şu Hiçlik Büyücüsü bir tılsım düşürdü... Bir çeşit iletişim yöntemi falan olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010402,
					"content": "Hım, tılsımın Hiçliğin Habercisi ile bağlantısı varmış gibi görünüyor. İyi ama neden bir Hiçlik Büyücüsü bunu taşısın ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010403
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010403,
					"content": "Belki de gerçekten de operasyonlarına dair bilgiler içeriyordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010404
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010404,
					"content": "Ama Paimon üzerindeki yazıyı okuyamıyor... *iç çeker* Khaenri'ah'nın kullandığı alfabe mi bu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010405,
					"content": "#\"... Düşmanın inancını alevlerle sar ve {F#Prens hazretlerine}{M#Prenses hazretlerine} şan ve şeref getir...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010406
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010406,
					"content": "Ne? Öyle mi yazıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010407,
					"content": "\"...'Kaderin Ağları', ilk operasyon.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010408
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010408,
					"content": "Hiçlik büyük bir operasyon yürütüyor gibi duruyor. Buradaki anahtar kelime ise \"Kaderin Ağları\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010409
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010409,
					"content": "Görünüşe göre hâlâ operasyonu düzenleme aşamasındalar ya da daha doğrusu, ilk denemeleri gerçekleştiriyorlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010410
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010410,
					"content": "\"Kaderin Ağları\" mı? Bu da ne? Gerçek manada kader ağları ören bir makina mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010411,
						80010412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010411,
					"content": "Hiçlik Büyücüsü bu harabelerden geldi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010413
					]
				},
				{
					"id": 80010413,
					"content": "Paimon'un hissettiği korkuya bakılırsa, bu ürkütücü harabelerin kader değiştiren operasyonla ilgili olması çok muhtemel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010414,
					"content": "Peki Dain, bu tılsım nasıl bir mesaj içeriyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010415,
					"content": "Şimdi okuyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010416
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010416,
					"content": "Hım... İddialı bir operasyon ama bazı kısımlarını anlaması güç.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010417
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010417,
					"content": "Nasıl yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010418,
					"content": "Kısacası, planın ilk kısmı Girdabın Lordu Osial ile ilgili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010419
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010419,
					"content": "Girdabın Lordu mu? Okyanustaki tanrıyı mı kastediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010420,
						80010421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010420,
					"content": "Geçen sefer onu yok etmeyi başaramadık...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010422
					]
				},
				{
					"id": 80010422,
					"content": "Osial'den ne istiyorlar? Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010423,
					"content": "Dvalin ile aynı olabilir mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010424
					]
				},
				{
					"id": 80010424,
					"content": "Dvalin ile ilgili kahramanca geçmişini biliyorum, ayrıca Fırtına Dehşeti olayında Hiçlik Tarikatının rolünü de biliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010425
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010425,
					"content": "Her ne kadar o zaman farkında olmasan da, şimdikine benzer bir Hiçlik Tarikatı operasyonunu sekteye uğratıyordun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010426
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010426,
					"content": "Geçen seferki Venti'nin eski bir arkadaşıydı, şimdi ise devasa bir kadim tanrı... Hiçlik Tarikatı kozu sürekli artırıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010427,
					"content": "Hiçlik Tarikatı, Dvalin'e yaptıkları gibi, yalanlar ve kara büyülerle Osial'ı yozlaştıracak mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010428,
					"content": "Hayır... Tılsımda yazılanlara bakılırsa bu operasyon bir adım daha ileriye gidiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010429
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010429,
					"content": "Osial'ın zihnini yozlaştırmakla kalmayacaklar. Aynı zamanda \"Biçerdöverler\"de kullanılan kadim teknolojiyi kullanarak Osial'ın bedenini tamamen değiştirmeyi planlıyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010430
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010430,
					"content": "Bu... Böyle bir şey mümkün mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010431,
					"content": "Yani şimdi, Hiçlik Tarikatı bir tür... Sibernetik Toplu Yıkım Ahtapot Tanrısı mı yaratmak istiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010432,
						80010433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010432,
					"content": "Öyle görünüyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010434
					]
				},
				{
					"id": 80010434,
					"content": "Günümüzde çok az insan Khaenri'ah medeniyetini gerçekten anlıyor, tabii bu anlayışın ne kadar doğru olduğuna karar vermek de zor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010435
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010435,
					"content": "Sadece Hiçlik Tarikatı istikrarlı bir şekilde Khaenri'ah'nın kalıntılarını arayıp durdu. İnsan olmaktan çok uzak olmalarına karşın bu yitik insan medeniyetini oldukça ısrarlı bir şekilde arıyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010436
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010436,
					"content": "Tılsımdaki mesaj açıkça diyor ki, Kirli Heykeli iskelet gibi kullanıp Osial'in uzuvlarını ekleyerek mekanik bir tanrı yaratacaklar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010437
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010437,
					"content": "Yeni çekirdek de Yedilerin Heykelinin her zaman elinde tuttuğu kürenin yerine geçecek... Onun için de ilk Biçerdöverin gözünü kullanacaklar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010438
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010438,
					"content": "\"İlk Biçerdöverin gözü\" mü? Paimon anladı! Tüm o Hiçlik Büyücüleri bu özel gözün peşinde, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010439
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010439,
					"content": "Öyle görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010440,
						80010441
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010440,
					"content": "Henüz bulamadılar. Daha vaktimiz var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010442
					]
				},
				{
					"id": 80010442,
					"content": "Bütün bu olanlar daha da karmaşık bir hal almaya başlıyor. Ama esasen hepsi o gördüğümüz uğursuz Yedilerin Heykeliyle ilgili, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010443
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010443,
					"content": "Evet. Tılsıma göre göz, Kirli Heykelin eline yerleştirilmeli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010444
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010444,
					"content": "Böylelikle yeni doğacak tanrıya \"Kutsal Diyar'ın semavi tahtlarını yıkmak\" için gereken gücü verecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010445,
						80010446
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010445,
					"content": "(Kutsal Diyar...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010447
					]
				},
				{
					"id": 80010447,
					"content": "Vay canına... Hiçlik Tarikatı bu planı hayata geçirmekte tereddüt etmiyor gibi görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010448
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010448,
					"content": "Hım. Kimse ilk Biçerdöverin nerede olduğunu bilmediğine göre, araştırmamıza heykele dair bilgi edinerek başlasak nasıl olur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010449,
						80010450
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010449,
					"content": "Şu heykel... Rüzgar Hükümdarı'na benziyordu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010451
					]
				},
				{
					"id": 80010451,
					"content": "Evet, o Detone Ozan'ı bulmak da çok zor zaten. İlk önce <color=#00E1FFFF>Katedrale</color> gidelim ve çevredekilere soralım, belki bir şeyler öğreniriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010452
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010452,
					"content": "Katedral... Hım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010453
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010453,
					"content": "Ne? Sorun nedir, Dain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010454
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010454,
					"content": "Hiç. Hadi gidelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010450,
					"content": "Favonius Kilisesine mi sorsak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010451
					]
				},
				{
					"id": 80010446,
					"content": "(Semavi tahtları yıkmak...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010447
					]
				},
				{
					"id": 80010441,
					"content": "Gözü onlardan önce bulalım hadi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010442
					]
				},
				{
					"id": 80010433,
					"content": "Şu isimler gitgide uzuyor!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010434
					]
				},
				{
					"id": 80010421,
					"content": "Yeşim Konak tarafından ezilmişti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010422
					]
				},
				{
					"id": 80010412,
					"content": "Şu ters çevrilmiş heykelle mi alakalı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010413
					]
				}
			]
		},
		{
			"id": 800105,
			"completionStepIds": [
				800108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800108",
							"2"
						],
						"stepId": 800108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80010501,
					"content": "Bakın! Harabe Muhafızları ve Hiçlik Büyücüleri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010502,
					"content": "Dain de bu kadim makinaların Khaenri'ah'dan kaldığını söylüyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010503,
					"content": "Yani... Khaenri'ah'nın korunacak bir sürü harabesi mi vardı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010504,
					"content": "Hayır. \"Harabe Muhafızı\" modern insanların taktığı bir isim. 500 yıl önce kimse böyle demiyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010505
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010505,
					"content": "Harabe Muhafızları Khaenri'ahlılar tarafından \"Biçerdöverler\" olarak biliniyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010506
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010506,
					"content": "\"Biçerdöverler\" mi? Ne tuhaf bir isim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010507,
						80010508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010507,
					"content": "Bunlar tarım aletleri miydi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010509
					]
				},
				{
					"id": 80010509,
					"content": "Düşündüğünüz gibi değil. Biçerdöver sadece bir kod adı. Khaenri'ahlılar silahlarına kod adı vermekten hoşlanırdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010510
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010510,
					"content": "\"Toprak, tarım aletleriyle sürülmek için değildir; çelik ve kanla uğruna savaşılmalıdır.\" \"Biçerdöver\" adı da böyle ortaya çıktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010511
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010511,
					"content": "\"Çelik ve kanla uğruna savaşmak\" mı? Toprağı sürmenin ilginç bir yorumu olmuş... Paimon'a göre bu çok da olumlu bir yorum değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010512,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010513
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010513,
					"content": "Khaenri'ah'nın yıkılışından sonra bu sahipsiz \"Biçerdöverler\" tamamen kontrolden çıktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010514
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010514,
					"content": "Yüzyıllar boyunca amaçsızca dolandılar ve günbegün Teyvat'ın her bir köşesine yayıldılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010515
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010515,
					"content": "Muhtemelen zamana yenik düşen diğer medeniyetlerin acılarını hissederek çevredeki harabeleri bulup buralara yerleştiler ve sessizce beklediler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010516
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010516,
					"content": "Bu... Kulağa çok üzücü geliyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010517,
						80010518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010517,
					"content": "500 yıldır amaçsızca dolaşan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010520
					]
				},
				{
					"id": 80010520,
					"content": "Daha fazlasını öğrendiğiniz zaman bu ayrıntılar size pek bir şey ifade etmeyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010521
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010521,
					"content": "Geçmişleri her ne olursa olsun, onlardan geriye kalan tek şey, yarattıkları tehlike... O yüzden, hepsini yok edin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80010518,
					"content": "Acılarına bir son vermemiz gerekiyor anlaşılan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010519
					]
				},
				{
					"id": 80010519,
					"content": "Evet... Paimon bu konuda gerçekten iyi iş çıkardığını düşünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80010508,
					"content": "Peki ya ölümcül silahlar niye?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010509
					]
				}
			]
		}
	]
}