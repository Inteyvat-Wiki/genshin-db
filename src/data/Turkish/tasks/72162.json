			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Fujiwara Toshiko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721620101,
					"content": "T-Teşekkür ederim... Ah, bu yaratıklar nasıl beni gafil avladı, hayret bir şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620102,
						721620103
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620102,
					"content": "Sen kimsin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620104
					]
				},
				{
					"id": 721620104,
					"content": "Adım Fujiwara Toshiko. Burada... Şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620105
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620105,
					"content": "Neyse. Beni kurtardığınıza göre size söyleyebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620106
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620106,
					"content": "Buraya atalarımdan kalan hazineyi bulmaya geldim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620107
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620107,
					"content": "H-Hazine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721620108,
					"content": "Buldun mu peki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620109
					]
				},
				{
					"id": 721620109,
					"content": "Hahaha, tabii ki buldum. Hazinenin konumuna giden bazı ipuçlarını takip ettim, sonra oraya nasıl gireceğimi belirledim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620110
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620110,
					"content": "Ama tam kolu indirip hazinenin olduğu yere giriyordum ki bu canavarlar gizlice yaklaşıp bana saldırdılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620111
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620111,
					"content": "Canavarları kovaladınız, size hayatımı borçluyum. Teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620112
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620112,
					"content": "Şey, yani, ben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620113
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620113,
					"content": "Beni bir süre daha korumanızı isteyebilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620114
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620114,
					"content": "Hazineyi bulmam gerekiyor ama bunca canavarla tek başıma baş edebileceğimi sanmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620115
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620115,
					"content": "Hatta... Hazinenin bir kısmını sizinle paylaşırım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620116,
						721620117
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620116,
					"content": "Burada gerçekten hazine var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620118
					]
				},
				{
					"id": 721620118,
					"content": "Eminim bulurum! Güven bana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620119
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620119,
					"content": "Hazinenin saklandığı yere girmemizi sağlayacak kolu buldum bile. Hemen şurada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620120
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620120,
					"content": "Gerçi mekanizma hemen açabileceğimiz bir şeye benzemiyor. Etkinleştirilmesi için özel bir yöntem kullanmamız gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620121
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620121,
					"content": "Atalarımdan kalan bir haritayı yanımda getirdim. Bu mekanizmayı anlamamıza yarayacak bazı ipuçları yazılı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620122
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620122,
					"content": "Ama... Heh, hâlâ çözemedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620123
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620123,
					"content": "Bir de sen bak istersen. Kim bilir, belki sen nasıl olacağını anlarsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620124
					],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620124,
					"content": "*iç çeker* Cidden nasıl çözeceğim ki bu bulmacayı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fujiwara Toshiko"
				},
				{
					"id": 721620117,
					"content": "Bulabilecek misin hazineyi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620118
					]
				},
				{
					"id": 721620103,
					"content": "Burada ne yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620104
					]
				}
			]
		},
