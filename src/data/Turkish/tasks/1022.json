					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10220601,
					"content": "Onlar Parlak Zambak değildi! Parlak Zambaklar insanlara vurmaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220602,
					"content": "Doğrusu o çiçekler iyi savaştı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220603
					]
				},
				{
					"id": 10220603,
					"content": "Bu minik canavara \"Yalancı Çiçek\" denir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220604
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220604,
					"content": "Hım... Garip. Yaprakları ilginç görünüyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220605
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220605,
					"content": "Gizlenmek için kullandıkları Parlak Zambaklar çok uzun süredir Yalancı Çiçek ile birlikte gömülüymüş. Sonuçta tedavi edici etkileri çok güçlü oluyor. Gidip şu yaprakları toplayalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220606
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220606,
					"content": "Her şey iyi güzel de bu yapraklar Veda Ayininde kullanılabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220607,
					"content": "Ne yazık ki hayır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220608
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220608,
					"content": "Ah, ne yazık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220609,
					"content": "Özür dilerim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220610
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220610,
					"content": "Parlak Zambak mı arıyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220611
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220611,
					"content": "Ah, hey! Adı neydi... Ah, Paimon hatırlayamıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220612,
						10220614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220612,
					"content": "Merhaba Ganyu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220613
					]
				},
				{
					"id": 10220613,
					"content": "Merhaba gezgin. Adımı hatırlamana şaşırdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220617
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220617,
					"content": "Ah! Aklıma gelmişken; Yeşim Konak'a yaptığın ziyaret keyifli geçti mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220618
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220618,
					"content": "Şey, oraya nasıl çıkacağımızı söyleseydin daha iyi geçerdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220619,
					"content": "Size yolu tarif etmedim mi? Ettim canım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220620
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220620,
					"content": "Hayır, yolu kendimiz bulduk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220621,
						10220622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220621,
					"content": "Sır falan değildi ki, o nedenle bildiğimizi mi düşündün acaba?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220623
					]
				},
				{
					"id": 10220623,
					"content": "Ah, anlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220624
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220624,
					"content": "(Ay, sanırım gerçekten onlara söylemeyi unuttum...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220625
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220625,
					"content": "Hah, Ganyu biraz garip görünüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220626,
					"content": "İlk karşılaşmamıza göre farklı davranıyor... O ciddi tavrı nereye kayboldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220627,
					"content": "Ah neyse, sizinle o zaman karşılaştığımda Tianquan'ın bir elçisiydim. Şimdi ise çiçekleri görmek için gezintiye çıktım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220628
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220628,
					"content": "Bunca yolu çiçekleri görmek için mi geldin? Neden şehirdeki bahçelere gitmedin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220629,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220630
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220630,
					"content": "Rex Lapis, Yujing Terası'nda hayatını kaybetti. O kasvetli bahçelerde gezinmeye dayanamazdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220631
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220631,
					"content": "Bugünlerde görevim nedeniyle ne zaman Yujing Terası'na yakın bir yerlere gitmem gerekse bahçeleri görmemek için pencereleri örtüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220632
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220632,
					"content": "Ah... Üzgünüm, bu konuyu açmamalıydım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220633,
					"content": "Hayır, sorun değil. Sadece henüz duygularımla yüzleşemedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220634
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220634,
					"content": "Hükümdarlar Savaşı iki bin yıl önce sona erdiğinde ilk bir araya gelen Yediler Liyue'de toplanıp Rex Lapis ile oturup yiyip içerdi. Fakat orijinal Yedilerin beşi zaten Rex Lapis'ten önce göçüp gitmişti. Aslında bir görev devri gerçekleşti diyebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220635
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220635,
					"content": "Yani bunun anlamı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220636
					]
				},
				{
					"id": 10220636,
					"content": "Evet. Rex Lapis'in ruhu göklere geri döndüğüne göre ilk Yedilerden geriye sadece Mondstadtlı Barbatos kaldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220666
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220666,
					"content": "Inazuma'nın Şogun Raiden'ı da dahil olmak üzere diğer beşi, iki bin yıl önceki aynı dostlar değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220637
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220637,
					"content": "Şu anda Yedi Hükümdardan en genci Sumeru'nun Doğa Tanrısı sadece beş yüz yaşında. Rex Lapis ise öldüğünde altı bin yaşındaydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220638
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220638,
					"content": "Bu, Liyue'nin 3.700 yıl önce ilk kurulduğunda Rex Lapis'in hükümdarlığında olduğu anlamına geliyor. Bu şehir hiçbir zaman ilahına veda etmek zorunda kalmamıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220639
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220639,
					"content": "Peki bu \"veda\" hakkında ne düşünüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220640
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220640,
					"content": "Ha? Bu... Bu biraz ani oldu, ben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220641
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220641,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220642
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220642,
					"content": "Bir fani olarak Liyue'yi Rex Lapis'siz düşünmeye cesaret bile edemezdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220643
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220643,
					"content": "Fakat bir Adeptus olarak... Sanırım yakında bu gerçeğe alışacağım. Rex Lapis göçüp gittiğinden beri Liyue'nin tanrılarla ve Adeptuslarla sözleşmesi artık sona erdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220644
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220644,
					"content": "Ha? Sen az önce \"Adeptus olarak\" mı dedin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220645
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220645,
					"content": "Evet, ben... Ben insan ve Qilin meleziyim. Damarlarımda Adeptus kanı dolaşıyor. Hükümdarlar Savaşı sırasında Rex Lapis ve Liyue şehri için savaştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220646
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220646,
					"content": "Savaş sona erdiğinde Rex Lapis ile bir sözleşme imzaladım ve Yedi Yıldız için sekreter konumuna getirildim. Bu görevi bugüne kadar yerine getirmeye devam ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220647,
						10220648
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220647,
					"content": "Yani sen yarı Qilin misin? Boynuzların nedeni anlaşıldı!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220649
					]
				},
				{
					"id": 10220649,
					"content": "Şey... Bu konuşmaya başka bir gün devam edelim. Buraya Parlak Zambak bulmaya geldiğini söylemiştin, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220650
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220650,
					"content": "Ayrıca Yabani Parlak Zambakların nerede bulunabileceğini biliyorum. Az önce kendim için bir tane topladım. İşte, istersen alabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220651
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220651,
					"content": "Nasıl reddedebiliriz ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220652
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220652,
					"content": "Ah, zambağı toplamadan önce ona şarkı söyledin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220653
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220653,
					"content": "Elbette söyledim. Bu geleneği biliyorum. Aslında ona yerel bir Liyue şarkısı söyledim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220654
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220654,
					"content": "Oo, işini biliyorsun! Teşekkürler Ganyu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220655
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220655,
					"content": "Hayır, ben size teşekkür ederim. Karşıma çıkmasaydınız, kadim lordumuz için hazırlanan vedaya asla katkıda bulunamayacaktım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220656
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220656,
					"content": "Şimdi izin verirseniz işime dönmeliyim. Size bol şans dilerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220657
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220657,
					"content": "Sanırım her şey tamam. Veda Ayini ile ilgili hazırlıklarımız neredeyse bitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220658
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220658,
					"content": "Parlak Zambakları kolayca topladığımız düşünülürse sanırım birçok yönden işlerimize uygun bir son oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220659
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220659,
					"content": "Zhongli, sanırım tarımsal geliştirme işinde çalışabilirsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220660
					]
				},
				{
					"id": 10220660,
					"content": "Evet, Paimon onu Liyue'de kendi işletmesini kurarken hayal edebiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220661
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220661,
					"content": "Hah, hayatımda zaten yeterince hareket var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220662
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220662,
					"content": "Yeni bir işe girişmek başta zordur ve çok çaba ister. Fakat işi tam olarak oturtursan stresi seni sadece zaman içinde yorar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220663
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220663,
					"content": "Bu nedenle ara sıra geriye çekilip kendini yeniden gözden geçirmek için zaman ayırman gerekir. Bunu yapmazsan kalbindeki yorgunluk iyileştirilemeyecek boyuta gelebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220664
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220664,
					"content": "İnanılmaz! Görüyor musun? Zhongli her şeyi görmüş geçirmiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220665
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220665,
					"content": "Tamam, artık Liyue Limanı'na geri dönme zamanı geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220648,
					"content": "Peki sen kaç yaşındasın? Unutkanlığın nedeni anlaşıldı!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220649
					]
				},
				{
					"id": 10220622,
					"content": "Sanırım hata bizde, sana sormadık.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220623
					]
				},
				{
					"id": 10220614,
					"content": "Merhaba Yangu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220615
					]
				},
				{
					"id": 10220615,
					"content": "\"Yangu\" mu? Yangu da ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220616
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 10220616,
					"content": "Hah... Adımı tamamen unuttun, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220617
					],
					"speakerTitle": "Ganyu"
				}
			]
		},
		{
