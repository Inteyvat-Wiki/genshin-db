			},
			"dialogs": [
				{
					"id": 10220801,
					"content": "Wangsheng Cenaze Evinin danışmanı Bay Zhongli sizsiniz, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220802
					],
					"speakerTitle": "Felix"
				},
				{
					"id": 10220802,
					"content": "Taşordu artık her hareketimizi izliyor. Zor zamanlardan geçiyoruz, acele hareket etmemeliyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220803
					],
					"speakerTitle": "Felix"
				},
				{
					"id": 10220803,
					"content": "Zor zamanlar mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220804
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220804,
					"content": "Jueyun Gölü Adeptusları sonunda harekete geçti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220805
					],
					"speakerTitle": "Felix"
				},
				{
					"id": 10220805,
					"content": "Kuvvet kullanmayı mı düşünüyorlar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220806
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220806,
					"content": "Büyük olasılıkla. Yedi Yıldızın bazı üyelerinin onlarla görüşmek için yola çıktığını duydum... \"Görüşmek\" diyorum ama büyük olasılıkla şehrin dışındaki Adeptusları biraz yavaşlatmaya çalışacaklar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220807
					],
					"speakerTitle": "Felix"
				},
				{
					"id": 10220807,
					"content": "Bununla birlikte iki taraf da keçi gibi inatçı ve bir açmaza girdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220808
					],
					"speakerTitle": "Felix"
				},
				{
					"id": 10220808,
					"content": "Mevcut durum düşünülürse kaçınılmaz görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220809
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220809,
					"content": "Adeptuslar Yedi Yıldızı tanımıyor, sadece Toprak Hükümdarı'nın sözleşmelerini tanıyorlar. İki taraf çarpışmaya başlayacak olursa Liyue Limanı onları durduracak konumda değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220810
					],
					"speakerTitle": "Felix"
				},
				{
					"id": 10220810,
					"content": "Liyue'nin Yedi Yıldızı o kadar kolay teslim olacak gibi görünmüyor, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220811
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220811,
					"content": "Hıh. Taş kafalılıkları herkesçe bilinir. Fakat bu inatçılıkları nedeniyle faniler ve Adeptuslar birbiriyle çatışmak üzere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220812
					],
					"speakerTitle": "Felix"
				},
				{
					"id": 10220812,
					"content": "Peki şimdi ne olacak? Nasıl oldu da Fatui ateş hattında kaldı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220813
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220813,
					"content": "Hıh... O da Ningguang'ın eseri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220814
					],
					"speakerTitle": "Felix"
				},
				{
					"id": 10220814,
					"content": "\"Bu zorlu süreçte Taşordu, Fatui'nin eylemlerini dizginlemelidir.\" diye buyurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220815
					],
					"speakerTitle": "Felix"
				},
				{
					"id": 10220815,
					"content": "Fakat şimdi de bizi izlemeye mi çalışıyorlar? Hah! İşte sana Yedi Yıldız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220816
					],
					"speakerTitle": "Felix"
				},
				{
					"id": 10220816,
					"content": "Her neyse Bay Zhongli, siz Asilzade'nin ortaklarından birisiniz. Eylemlerinizin bize yansımaları olacağını lütfen unutmayın. Kimsenin sizi hazırlıksız yakalamasına izin vermeyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220817
					],
					"speakerTitle": "Felix"
				},
				{
					"id": 10220817,
					"content": "Görünüşe göre Liyue Limanı'nda işler kızışıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220818,
						10220819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220818,
					"content": "Yapabileceğimiz bir şey var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220820
					]
				},
				{
					"id": 10220820,
					"content": "Tarafsızlığını kullanarak iki taraf arasında aracı olmayı mı düşünüyorsun? Yoksa kılıcını kullanarak dengeleri değiştirecek misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220821
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220821,
					"content": "İki seçenek de oldukça çetrefilli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220822
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220822,
					"content": "Ah bu arada Bay Zhongli, Wangsheng Cenaze Evinin de bütün bu olan bitenin ortasında kaldığını duyduk. Şu anda kapıda yetkililerle kapışıyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220823
					],
					"speakerTitle": "Felix"
				},
				{
					"id": 10220823,
					"content": "İşler kötüye gidiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220824
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220824,
					"content": "Korkarım Wangsheng Cenaze Evindeki işlerle ilgilenmek için geri dönmeliyim. Umarım Müdür Hu işleri kontrol altında tutabilmeyi başarmıştır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220825
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220825,
					"content": "#Bir sonraki adımını çok dikkatli düşün {NICKNAME}. Bir patlamayı önlemek istiyorsan en önemlisi önce fünyeyi bulmaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220827
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220827,
					"content": "Öf... Fatui ile bağlantıda olmak iki ağzı keskin kılıçtan farksız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220828
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220828,
					"content": "Zhongli \"fünye\"yi bulmak derken neyi kastediyordu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220829,
						10220830,
						10220831
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220829,
					"content": "Asilzade.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220832
					]
				},
				{
					"id": 10220832,
					"content": "Aa, Paimon anladı! Tüm şehrin tepetaklak olmasını isteyen biri varsa o da Asilzade'dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220833
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220833,
					"content": "Gerçekten kötü bir şey yapmak için kimsenin fark etmeyeceği bir anı bekliyor olmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220834
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220834,
					"content": "Fakat şimdi onu nasıl bulabiliriz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220835
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220835,
					"content": "Böyle bir zamanda nereye gitmiş olabilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220836,
						10220837
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220836,
					"content": "Beni takip et.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 10220837,
					"content": "Gidebileceği sadece bir yer var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
