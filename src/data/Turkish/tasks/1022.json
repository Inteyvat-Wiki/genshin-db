			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 10220201,
					"content": "Burada ne kadar çok tılsım var! Boş kağıt yığınları da var! Hım, bunların burada ne işi var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220202,
						10220203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220202,
					"content": "Görünüşe göre tılsımdaki deseni kopyalıyorlar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220204
					]
				},
				{
					"id": 10220204,
					"content": "Paimon bu deseni daha önce gördü! Ama nerede...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220205,
					"content": "Ah Paimon biliyor! Asilzade'nin sana verdiği Yetki Mührüne benziyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220206,
					"content": "Hım, fakat Adeptuslara ait bir yadigar nasıl oldu da Asilzade gibi birinin eline geçti? Şüpheli bir durum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220207,
					"content": "Bu sadece bir yadigar değil...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220208
					]
				},
				{
					"id": 10220208,
					"content": "Ah, tabii ya. Bulutlar Hakimi, Toprağın Efendisi Yetki Mührünü yarattığında onun eski bir yadigardan çok daha fazlası olduğunu söylemişti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220209,
					"content": "Bu gibi tılsımlar bir zamanlar Hükümdarlar Savaşı'nda kutsal güçleri yönlendirmek için kullanılıyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220210,
					"content": "Acaba Fatui de benzer bir etki yaratmak umuduyla Yetki Mührünü kopyalıyor olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220211,
					"content": "Savaşta kutsal güçleri yönlendirmek... Vay be, oldukça tehlikeli olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220212,
						10220213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220212,
					"content": "Görünüşe göre Fatui bir işler çeviriyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220214
					]
				},
				{
					"id": 10220214,
					"content": "Olaylar gelişiyor... Asilzade'ye dikkat etmemiz gerekiyor, orası kesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220215,
					"content": "Hım, pekala. Burada yeterince zaman harcadık. Yakında Zhongli ile görüşmemiz gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220216,
					"content": "Veda Ayini ile ilgili hazırlıklarda son durağımız... Dihua Bataklığı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220217,
					"content": "Haydi bakalım! Paimon geç kalmaktan nefret eder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220213,
					"content": "Belki bu kağıt çok daha büyük bir planın sadece küçücük bir kısmı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220214
					]
				},
				{
					"id": 10220203,
					"content": "Belki de tılsımı yeniden oluşturmaya çalışıyorlardır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220204
					]
				}
			]
		},
		{
			"id": 102203,
			"completionStepIds": [
				102203
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102203",
							"2"
						],
						"stepId": 102203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10220301,
					"content": "Tam zamanında. Ben de birkaç saniye önce geldim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220302
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220302,
					"content": "Yeşim Konak'a yaptığın ziyaret keyifli geçti mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220303
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220303,
					"content": "Koocamandı ve çook güzeldi ve çook pahalıydı... Paimon daha önce hiç o kadar şıkır şıkır bir yer görmemişti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220304,
					"content": "Doğru. Liyue'de eşi benzeri yoktur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220305
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220305,
					"content": "O zaman Ningguang ile tanıştın, öyle mi? Onunla ne konuştun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220306
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220306,
					"content": "O çok zengin ve çok cömert. Paimon onun çok dost canlısı olduğunu düşünüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220307,
					"content": "Çıkarları söz konusu olunca iş insanları her zaman \"dost canlısı\" olur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220308
					]
				},
				{
					"id": 10220308,
					"content": "Evet, onun Ningguang ile ilgili düşünceleri Paimon'unkilerden çok farklı. Şu kaba Yuheng'in bile ondan daha güvenilir olduğunu düşünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220309,
					"content": "Ah, demek Keqing'le de tanıştın. Ne söyledi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220310
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220310,
					"content": "\"Adeptusların zamanı çoktan geçti. Liyue'nin Yedi Yıldızı bile bu gerçekle yüzleşmek istemiyorsa Liyue'yi nasıl bir gelecek bekliyor?\" dedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220311,
					"content": "Ha ha, ilahi olana hiç saygısı yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220312
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220312,
					"content": "Evet, cesur Keqing'in aksine Ningguang daha çok bir iş insanı gibi hareket eder. Fakat her ikisi de Yedi Yıldızın üyesidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220313
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220313,
					"content": "Dost canlısı olmasına karşın gerçek niyetini net olarak anlamak mümkün değildir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220314,
						10220315
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220314,
					"content": "Ningguang son derece zeki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220316
					]
				},
				{
					"id": 10220316,
					"content": "Evet, şu anki konumuna bileğinin hakkıyla geldi. Normal biri bunu asla başaramazdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220317
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220317,
					"content": "Onun için hayattaki en önemli ikinci şeyin Yeşim Konak olduğunu ve sürekli genişlemesinden onun sorumlu olduğunu söylerler. Tianquan konumunu bırakacak olsa bile Yeşim Konak'tan asla vazgeçmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220318
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220318,
					"content": "Yeşim Konak sadece ikinci mi? Onun için en önemli şey nedir öyleyse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220319,
					"content": "Mora tabii ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220320,
						10220321
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220320,
					"content": "Mantıklı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220322
					]
				},
				{
					"id": 10220322,
					"content": "Ningguang sadece Fatui'den söz edip durdu, Fatui şöyle Fatui böyle... Rex Lapis öldürüldükten sonra Fatui'nin Liyue'yi ele geçirmeye çalıştığını ve güvenilmez olduklarını söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220323,
					"content": "Fatui hep böyle olmuştur. Hiç şaşırtıcı değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220324
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220324,
					"content": "Şimdi de Yetki Mührünü yeniden oluşturmaya çalışıyorlar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220325
					]
				},
				{
					"id": 10220325,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220326
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220326,
					"content": "Planları ne olursa olsun Fatui'ye karşı dikkatli olman gerek. Her zaman tetikte ol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220327
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220327,
					"content": "Veda Ayini için Dihua Bataklığı'ndan edinmemiz gereken başka bir şey var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220328,
					"content": "Evet, aslında var. Bugün Parlak Zambak toplayacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220329
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220329,
					"content": "Parlak Zambak mı? İyi de neden buralara kadar geldik? Yujing Terası'ndaki bahçede yok muydu? Qingce Köyü bile Parlak Zambak dolu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220330,
					"content": "Tamam! Paimon, Madam Ping'in hep çiçeklerle ilgilendiğini hatırlıyor. Belki de ona sormalıyız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220331,
					"content": "Hayır, dediğin zambakları insanlar yetiştiriyor. İşe yaramazlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220332
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220332,
					"content": "Eskiden Dihua Bataklığı Parlak Zambakla doluydu. İnsanların şarkılarını dinleyen eğlenceli bir çiçektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220333
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220333,
					"content": "Hükümdarlar Savaşı'ndan önce Dihua Bataklığı tamamen kuru ve verimli topraklardan oluşuyordu. Fakat savaş heyelanlara neden oldu, toprağı sel aldı ve bugün gördüğün bataklığa dönüştürdü. Neredeyse tüm Parlak Zambaklar yok oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220334
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220334,
					"content": "Elbette bazı çiçek türleri korundu ve insanlar tarafından yetiştirildi. Bununla birlikte Parlak Zambakların hâlâ doğada bulunduğunu çok az insan biliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220335
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220335,
					"content": "En güçlü kokuyu Yabani Parlak Zambaklar yayar. Veda Ayinini gerçek geleneklere göre gerçekleştirmek için parlak zambakları ezmemiz ve tozunu Ebedi Tütsü buhurdanlığına koymamız gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220336
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220336,
					"content": "Fakat bu çiçekleri toplamak için yardımına ihtiyacım olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220337,
						10220339
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220337,
					"content": "Yani onları toplamamı mı istiyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220338
					]
				},
				{
					"id": 10220338,
					"content": "Hayır, gidip onlara şarkı söylemelisin. Çiçeklere şarkı söylemek kokularını artırıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220341
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220341,
					"content": "#Ah... {NICKNAME}, senin sesin nasıl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220342,
						10220343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220342,
					"content": "Detone olmam herhalde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220344
					]
				},
				{
					"id": 10220344,
					"content": "Gerçekten mi? Paimon neden sana inanmıyor acaba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10220345,
					"content": "Ancak şarkı söylemeye başladığında anlayabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220346
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220343,
					"content": "Ben profesyonelim. Geri çekil ve kulağını iyi aç!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220344
					]
				},
				{
					"id": 10220339,
					"content": "Yani onlara... Şarkı mı söylememi istiyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220340
					]
				},
				{
					"id": 10220340,
					"content": "Evet. Şarkılarının çiçeklerin en güçlü kokuyu yaymasını sağlayacağına eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220341
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 10220321,
					"content": "Hiç şaşırtıcı değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220322
					]
				},
				{
					"id": 10220315,
					"content": "Ningguang son derece hırslı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220316
					]
				}
			]
		},
