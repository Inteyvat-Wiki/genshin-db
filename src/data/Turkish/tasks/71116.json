			"dialogs": [
				{
					"id": 711160601,
					"content": "İki muhteşem kahraman! Size çok şey borçluyum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160602
					],
					"speakerTitle": "Demir Ming"
				},
				{
					"id": 711160602,
					"content": "Lafı bile olmaz! Nerede nasıl bir sözleşme yapılırsa yapılsın, sözleşmenin maddelerine uyulması gerekir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160603,
					"content": "Hehe, bu küçük kahramanın da bilmediği yok! İkiniz de sözleşmemiz hakkında epey bir bilgiye sahip gibisiniz. Nasıl oluyor bu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160604
					],
					"speakerTitle": "Demir Ming"
				},
				{
					"id": 711160604,
					"content": "Demir Dou'er bahsetmişti. Korsancılık falan yaptığını söyledi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160605,
					"content": "\"Korsancılık\" ne demek?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160606,
					"content": "Bir çeşit yasa dışı ticaret işte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160607
					]
				},
				{
					"id": 711160607,
					"content": "O halde size bir teşekkür borçluyum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160608
					],
					"speakerTitle": "Demir Ming"
				},
				{
					"id": 711160608,
					"content": "Çocuklar! Onları sıkıca bağlayın ve denize atın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160609
					],
					"speakerTitle": "Demir Ming"
				},
				{
					"id": 711160609,
					"content": "Ayaklarına birkaç kaya parçası bağlamayı da unutmayın. Demir ve Tuz Çetesine o kadar iyilik yaptılar, bu işi kısa yoldan yapalım, çok acı çekmesinler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160610
					],
					"speakerTitle": "Demir Ming"
				},
				{
					"id": 711160610,
					"content": "Ne? Bize NE yapacaksın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160611,
					"content": "Benim küçük kahramanım, az önceki söylediklerinden sonra çoktan anlamışsındır diye düşünmüştüm. Liyue, gerçekten de sözleşmeler konusunda çok net çizgileri olan bir yer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160612
					],
					"speakerTitle": "Demir Ming"
				},
				{
					"id": 711160612,
					"content": "Kanun kaçaklarıyla yasa dışı ticaret yapmak eninde sonunda \"susturulmak\" demektir. Bu da gayet iyi bilinen ve dile getirilmeyen bir sözleşme türüdür, öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160613
					],
					"speakerTitle": "Demir Ming"
				},
				{
					"id": 711160613,
					"content": "Böyle bir sözleşme türünü daha önce hiç duymadık! Yaptığımız onca iyiliğin karşılığı bizi öldürmek mi? Asıl sözleşme ihlali bu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160614,
					"content": "Lütfen daha fazla zorluk çıkarmayın. Kendi ellerimle yaparsam daha çok acı çekersiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160615,
						711160616
					],
					"speakerTitle": "Demir Ming"
				},
				{
					"id": 711160615,
					"content": "Benim kim olduğumu biliyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160617
					]
				},
				{
					"id": 711160617,
					"content": "Kesin sesinizi! Demir Dou'er, Demir Chuan'er, daha ne bekliyorsunuz! Yakalayın şunları!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160618
					],
					"speakerTitle": "Demir Ming"
				},
				{
					"id": 711160618,
					"content": "Patron Demir Ming... Gerçekten çok kalpsiz ve adaletsizsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160619
					],
					"speakerTitle": "Demir Chuan'er"
				},
				{
					"id": 711160619,
					"content": "Sırf senin gibi kötüler yüzünden Liyue'nin adına gölge düşüyor zaten. Sizlerden kurtulduğumuzda bunca çabamız boşa gitmemiş olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160626
					],
					"speakerTitle": "Demir Dou'er"
				},
				{
					"id": 711160626,
					"content": "Etraflarını sarın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160620
					],
					"speakerTitle": "Demir Dou'er"
				},
				{
					"id": 711160620,
					"content": "N-Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160621
					],
					"speakerTitle": "Demir Ming"
				},
				{
					"id": 711160621,
					"content": "Demir Ming, seni aşağılık pislik! Gözlerini iyi aç da bize bir bak! Biz kimiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160622
					],
					"speakerTitle": "Demir Dou'er"
				},
				{
					"id": 711160622,
					"content": "Ta-Taşordu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160623
					],
					"speakerTitle": "Demir Ming"
				},
				{
					"id": 711160623,
					"content": "Hey hey, ağır olun biraz! Neler oluyor? Ne oldu da birden...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160624
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160624,
					"content": "Ben sizin yeni gelen acemiler olduğunuzu sanıyordum, lanet birer ajan olabileceğiniz hiç aklıma gelmemişti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160625
					],
					"speakerTitle": "Demir Ming"
				},
				{
					"id": 711160625,
					"content": "Öyle elim kolum bağlı sessizce duracağımı sanmayın sakın! Hodri meydan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Demir Ming"
				},
				{
					"id": 711160616,
					"content": "Olamaz, ödüm koptu resmen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160617
					]
				}
			]
		},
		{
