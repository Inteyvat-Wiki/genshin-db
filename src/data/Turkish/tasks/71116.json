			"dialogs": [
				{
					"id": 711160202,
					"content": "Aynı yolun yoldaşları birbirlerine iyilik yaptıklarında \"teşekkür etmezler\". Başın beladaysa çağırırsın ve o sorun anında çözülür!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160203
					],
					"speakerTitle": "Demir Dou'er"
				},
				{
					"id": 711160203,
					"content": "Vay canına, ne kadar da naziksin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160204,
						711160207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160204,
					"content": "O zaman ben direkt sadede geleyim. Son zamanlarda elim biraz sıkışık.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160205
					]
				},
				{
					"id": 711160205,
					"content": "Mora mı lazım? Haha, işte o biraz sıkıntı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160206
					],
					"speakerTitle": "Demir Dou'er"
				},
				{
					"id": 711160206,
					"content": "Elimizdeki tüm Morayı o kodaman aldı. Biz de burada meteliğe kurşun atıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160210
					],
					"speakerTitle": "Demir Dou'er"
				},
				{
					"id": 711160210,
					"content": "Kodaman mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160211
					]
				},
				{
					"id": 711160211,
					"content": "Bizim Patron işte, Demir ve Tuz Çetemizin lideri. Uçurumun alt tarafında birkaç Fontaineli adamla birlikte bir işler çeviriyor. Bizi de etrafı kolaçan edelim diye burada bıraktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160212
					],
					"speakerTitle": "Demir Dou'er"
				},
				{
					"id": 711160212,
					"content": "Ama ne olduğunu siz de gördünüz, değil mi? O Fontaine kurbağaları kodaman uzaktayken içeri sızdılar ve bizi kıçımızdan bıçakladılar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160213
					],
					"speakerTitle": "Demir Dou'er"
				},
				{
					"id": 711160213,
					"content": "Iyy... Kıçınızdan mı bıçakladılar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160214,
					"content": "Amanın!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160215
					]
				},
				{
					"id": 711160215,
					"content": "Ne yani, bizi dünkü çocuk mu sandılar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160216
					],
					"speakerTitle": "Demir Dou'er"
				},
				{
					"id": 711160216,
					"content": "Amaçlarını belli edip gerçek yüzlerini gösterdiklerine göre, büyük ihtimalle Patronumuzu da kandıracaklar. Ne diyorsunuz? Moraysa Mora, onursa onur, ne isterseniz vereceğiz. Var mısınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160217
					],
					"speakerTitle": "Demir Dou'er"
				},
				{
					"id": 711160217,
					"content": "Patron güvende olduğu sürece en lezzetli yemekleri yiyeceğinize ve iyi bir hayat yaşayacağınıza kefilim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160218
					],
					"speakerTitle": "Demir Dou'er"
				},
				{
					"id": 711160218,
					"content": "Patronun nerede? Gidip bir bakayım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160219
					]
				},
				{
					"id": 711160219,
					"content": "Uçurumun altındaki sahilde. Gittiğinizde görürsünüz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160220
					],
					"speakerTitle": "Demir Dou'er"
				},
				{
					"id": 711160220,
					"content": "Siz önden gidin, ben de işlerimi halledince ardınızdan gelirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Demir Dou'er"
				},
				{
					"id": 711160207,
					"content": "Adaleti sağlamak için üstüme düşeni yapıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160208
					]
				},
				{
					"id": 711160208,
					"content": "Son derece onurlu ve eşsiz bir dürüstlük! O halde size cazip bir teklifim var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160209
					],
					"speakerTitle": "Demir Dou'er"
				},
				{
					"id": 711160209,
					"content": "Şu bizim kodaman var ya... Sanırım başı epey sıkıntıdaymış ve yardıma ihtiyacı varmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160210
					],
					"speakerTitle": "Demir Dou'er"
				}
			]
		},
