			"dialogs": [
				{
					"id": 711160401,
					"content": "Biz dostuz Johnnie, son zamanlarda büyük sıkıntılar yaşadığını biliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160402
					],
					"speakerTitle": "Demir Ming"
				},
				{
					"id": 711160402,
					"content": "Doğruca bana gelip olan biten her şeyi anlatabilirdin, bunca kargaşaya ne gerek vardı? Kalbimi kırdığına değdi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160403
					],
					"speakerTitle": "Demir Ming"
				},
				{
					"id": 711160403,
					"content": "Dostum, sen de gayet iyi biliyorsun ki artık işler eskisi gibi değil. Spina di Rosula yükselişte ve kardeşlerimin huzuru biraz kaçmış durumda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160404
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160404,
					"content": "Ama yine de adamlarımın hepsinin karnını doyurmak zorundayım. Ancak böyle giderse yiyecek bir tek kırıntı bile bulamayacaklar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160405
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160405,
					"content": "Birlikte iyi iş yapıyoruz ancak keşke bana biraz daha destek çıksan... Gün gelir ben de seni kollarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160406
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160406,
					"content": "Kollamazsam da... Haha, elini sallasan ellisi Demir Ming, sana arkadaş mı yok?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160407
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160407,
					"content": "Sanırım son teklifin bu, değil mi Johnnie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160408
					],
					"speakerTitle": "Demir Ming"
				},
				{
					"id": 711160408,
					"content": "Teklifimi beğenmedin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160409
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160409,
					"content": "Benimle dalga mı geçiyorsun Bay Fontaine? Derdin ne senin? Üç beş Mora ile kimi kandıracağını sanıyorsun? Kes şu zırvalığı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160410
					],
					"speakerTitle": "Demir Chuan'er"
				},
				{
					"id": 711160410,
					"content": "Kapa çeneni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160411
					],
					"speakerTitle": "Demir Ming"
				},
				{
					"id": 711160411,
					"content": "Dinle Johnnie. Don Pesci ailesi bana kutu başına 58.000 Mora veriyor, De Niro ise 70.000 veriyor. Onların Lumidouce Limanı'nda ne kadar nüfuzlu bir aile olduklarını anlatmama gerek yok herhalde, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160412
					],
					"speakerTitle": "Demir Ming"
				},
				{
					"id": 711160412,
					"content": "Ama ben senden kutu başına sadece 1.000 Mora istedim, üzerine bir de kapıdan kapıya teslimat hizmetini de ekledim... Peki bunu neden yapıyorum? Sırf seni çok sevdiğimden ve arkadaşım olduğun için.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160413
					],
					"speakerTitle": "Demir Ming"
				},
				{
					"id": 711160413,
					"content": "Bunu sürekli vurgulamama gerek yok... İstersen biraz daha düşünebilirsin! Hadi gel konuşurken bir şeyler içelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160414
					],
					"speakerTitle": "Demir Ming"
				},
				{
					"id": 711160414,
					"content": "Hehe, gerek yok. Siz Liyuelilerin sözleşme konusundaki tavırlarınızı biliyorum. Sözleşmede en önemli olan şey adilliktir, arkadaşlık sonra gelir. Hem ne demişler, iş başka arkadaşlık başka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160415
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160415,
					"content": "Hehe, Johnnie! Sözleşmelerin ruhundan resmen anlıyorsun dostum... Adamlarımın senden öğreneceği çok şey var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160416
					],
					"speakerTitle": "Demir Ming"
				},
				{
					"id": 711160416,
					"content": "Sadece... En azından bu konuda sözleşmeye saygı göstermenizi istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160417
					],
					"speakerTitle": "Demir Ming"
				},
				{
					"id": 711160417,
					"content": "Tabii ki, tabii ki! Bu konuda çok haklısın, ayrıca Liyue'nin sözleşmelere sadık kalma konusundaki kadim geleneğine büyük hayranlık duyuyoruz. Sanırım bir yolunu bulup iyi niyetimi kanıtlamam gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160418
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160418,
					"content": "Walker, sence teklifimizi biraz artıralım mı? Mesela, ürün başına bir Mora nasıl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160419
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160419,
					"content": "Çok cömertsin Bay Johnnie. Liyue'nin bu iyi insanları bizim için o kadar emek harcıyor, ürün başına fazladan bir Mora vermek çok iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160420
					],
					"speakerTitle": "Walker"
				},
				{
					"id": 711160420,
					"content": "Sizi Fontaine kurbağaları! Ne işler çeviriyorsunuz burada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160421
					],
					"speakerTitle": "Demir Chuan'er"
				},
				{
					"id": 711160421,
					"content": "Hadi ama dostum, oradan bakınca ne kadar samimi olduğum belli olmuyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160422
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160422,
					"content": "Yoksa aklından anlaşmamızı bozmak mı geçiyor Johnnie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160423
					],
					"speakerTitle": "Demir Ming"
				},
				{
					"id": 711160423,
					"content": "Ne? Ben mi? Sence ben öyle bir şey yapar mıyım Walker?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160424
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160424,
					"content": "Bay Johnnie, elini sallasan ellisi. Sana iş mi yok, arkadaş mı yok?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160425
					],
					"speakerTitle": "Walker"
				},
				{
					"id": 711160425,
					"content": "Senden utanıyorum Walker. Liyueli arkadaşımızı nasıl böyle aşağılayabilirsin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160426
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160426,
					"content": "Ne de olsa yakın zamanda onların topraklarını ele geçireceğiz, yani az da olsa minnet duysak iyi olmaz mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160427
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160427,
					"content": "Özür dilerim Bay Johnnie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160428
					],
					"speakerTitle": "Walker"
				},
				{
					"id": 711160428,
					"content": "Sizi şerefsizler! Böyle bir şeye nasıl cüret edersiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160429
					],
					"speakerTitle": "Demir Chuan'er"
				},
				{
					"id": 711160429,
					"content": "Hey hey, şu hakaretlerden vazgeçin! Kabalaşmaya gerek yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160430
					]
				},
				{
					"id": 711160430,
					"content": "Hey, bu iki genç de kim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160431
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160431,
					"content": "İlginç! Liyue'nin tüm çocukları böyle cesur mu? Walker!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160432
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160432,
					"content": "Hey, sümüklüler! Nereden böyle? Alın şu Morayı da kendinize süt alıp için!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160433
					],
					"speakerTitle": "Walker"
				},
				{
					"id": 711160433,
					"content": "Aa! Hepiniz ne kadar terbiyesizsiniz öyle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160434,
					"content": "Siz kimsiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160435,
						711160436
					],
					"speakerTitle": "Demir Ming"
				},
				{
					"id": 711160435,
					"content": "Biz buraya şöyle fiyakalı bir yemek yemeye geldik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160437
					]
				},
				{
					"id": 711160437,
					"content": "Hahaha! Söylediklerinize bakılırsa... Bay Demir Ming'e yardıma gelmiş paslı yardımcılar olmalısınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160438
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160438,
					"content": "Demek senin de aklından aynı fikirler geçiyordu Bay Demir Ming! Biz de elimiz boş gelmedik herhalde. Walker!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160439
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160439,
					"content": "Hadi çocuklar, vakit geldi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160440
					],
					"speakerTitle": "Walker"
				},
				{
					"id": 711160440,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160441
					],
					"speakerTitle": "Demir Chuan'er"
				},
				{
					"id": 711160441,
					"content": "Ah, sanırım bizim daha çok adamımız var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160442
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160442,
					"content": "Çok özür dilerim Bay Demir Ming. Bu buluşmamızdan önce bazı ayarlamalar yaptım, kampını koruyan adamlarının icabına çoktan bakıldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160443
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160443,
					"content": "Şimdi sıra sende. Merak etme, işlerinle çok güzel ilgileneceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160444
					],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160444,
					"content": "\"Patron\" Johnnie... İşimizi elimizden alma niyetindeysen eğer, bu o kadar kolay olmayacak bilesin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160445
					],
					"speakerTitle": "Demir Ming"
				},
				{
					"id": 711160445,
					"content": "Umarım bu lafların altı boş değildir. Yakalayın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Johnnie"
				},
				{
					"id": 711160436,
					"content": "Birilerine süt içirmeye geldik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160437
					]
				}
			]
		},
