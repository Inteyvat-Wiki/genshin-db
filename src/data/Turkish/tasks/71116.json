			"dialogs": [
				{
					"id": 711160801,
					"content": "Bu yolculuk gerçekten amacına ulaştı. Hem aradığımız kişiyi bulduk hem de ünlü Gezgin ile tanıştık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160802
					],
					"speakerTitle": "Demir Chuan'er"
				},
				{
					"id": 711160802,
					"content": "Bizi tanıyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711160803
					]
				},
				{
					"id": 711160803,
					"content": "Tabii ki. Liyue Limanı'nda akrabalarım var, hakkınızda çok şey duydum. Sizi bir bakışta tanıdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160804
					],
					"speakerTitle": "Demir Dou'er"
				},
				{
					"id": 711160804,
					"content": "Ancak orada çok fazla kişi vardı ve onları tedirgin etmek istemedim. O yüzden de kendimi belli etmedim. Kusura bakmayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160805
					],
					"speakerTitle": "Demir Dou'er"
				},
				{
					"id": 711160805,
					"content": "Yani bu, yasa dışı bir ticaret değil de bir çeşit baskın mıydı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711160806,
					"content": "Aynen. Uzun zamandır bu kaçakçıların peşindeydik ve kısa süre önce harika bir zamanlamayla ancak içlerine sızmayı başarabildik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160807
					],
					"speakerTitle": "Demir Chuan'er"
				},
				{
					"id": 711160807,
					"content": "O zamandan bu yana neredeyse bir ay oldu, bugün Demir ve Tuz Çetesi ile büyük Fontaine patronunu tek bir hamlede yakalamayı başardık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160808
					],
					"speakerTitle": "Demir Chuan'er"
				},
				{
					"id": 711160808,
					"content": "#O Fontainelilerin kirli oyunlarıyla bizi neredeyse alt etmelerinden hiç bahsetmiyorum bile. Neyse ki sen vardın {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160809
					],
					"speakerTitle": "Demir Dou'er"
				},
				{
					"id": 711160809,
					"content": "Ne yazık ki sözünü verdiğimiz fiyakalı yemekten vazgeçmek durumunda kalabilirsiniz. Onun yerine şu Morayı alın lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160810
					],
					"speakerTitle": "Demir Dou'er"
				},
				{
					"id": 711160810,
					"content": "Reddetmeyi aklınızdan bile geçirmeyin. Başkalarına yardım etmenin karşılığı elbette bir ödül olmalı. Bu, herkesin uyması gereken bir sözleşmedir. Yoksa, bundan böyle kim kime yardım eli uzatır ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711160811
					],
					"speakerTitle": "Demir Dou'er"
				},
				{
					"id": 711160811,
					"content": "Pekala, işin geri kalanını biz hallederiz. Sizi daha fazla tutmayalım.",
