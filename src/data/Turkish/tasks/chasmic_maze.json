			"dialogs": [
				{
					"id": 10280701,
					"content": "Durum hiç iç açıcı değil. Şimdilik buradan çıkamayacağız gibi. Burada daha uzun süre kalmak için hazırlık yapmamız lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280702
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280702,
					"content": "Neyse ki yeterli erzakımız var ve bizimki kadar uyumsuz bir ekip bile bir amaç uğruna ortak paydada buluşabiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280703
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280703,
					"content": "Kendinize dikkat edin, yeter. Gerisi bende.",
					"roleType": "TALK_ROLE_NPC",
