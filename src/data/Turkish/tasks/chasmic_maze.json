			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yanfei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10280401,
					"content": "N-Ne! Ha? Bir saniye, olamaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280402
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280402,
					"content": "Ah, nasıl buraya geri geldik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280403,
					"content": "Zaten burada mıydık?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280404
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280404,
					"content": "Evet, tam olarak buradan yola çıktık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280405
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280405,
					"content": "Ama yanlış bir yola sapmadık ki. En başından beri aynı yolda gidiyorduk. Hiç geri dönmedik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280406
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280406,
					"content": "Evet, ben de onu düşünüyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280407
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280407,
					"content": "Gezgin, doğru yoldan gidiyorduk, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280408
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280408,
					"content": "Evet, öyle sanıyordum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280409
					]
				},
				{
					"id": 10280409,
					"content": "Çok garip...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280410,
					"content": "Bir Inazuma efsanesi vardır. Günlerden bir gün, akşam vakitlerinde bir bake-danuki tüccarın birini kandırmış ve bu tüccar bütün gece boyunca aynı yerde dönüp durmuş. Sabaha kadar aramışlar ama çıkış yolunu bulamamışlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280411
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280411,
					"content": "Evet, Paimon bu efsaneyi duymuştu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280412,
					"content": "Hepimiz bu efsaneyi duyduk mu? Güzel, çünkü şu an yaşadığımız şeyin tam olarak bu olduğuna eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280413
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280413,
					"content": "Ama korkmaya gerek yok. Youkaileri ve ruhları falan kovabilen bir yardımcım var. Hemencecik bir çağırayım onu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280414
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280414,
					"content": "Kötü ruh kovucu arkadaşı olan bir Oni... Duy da inanma. Ne açık görüşlü bir adam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280415,
					"content": "Patronuma göre cehalet erdemdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280416
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280416,
					"content": "Hadi bakayım Ushi, yakala şu ruhu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280417
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280417,
					"content": "Möö!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280418
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10280418,
					"content": "Bu Ushi, Arataki Çetesinin yardımcı üyesi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280419
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280419,
					"content": "Möö, möö.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280420
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10280420,
					"content": "Haha. Eh, Ushi hepinize selam veriyor. Ona \"Ushi\" ya da \"Gürbüz\" diyebilirsiniz. Yön duyusu epey iyidir. Yol tarifini ona bırakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280421
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280421,
					"content": "Çetelerde yardımcı üye olduğunu bilmiyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280422
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280422,
					"content": "Bu hiç işe yarayacak bir şeymiş gibi gelmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280423
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280423,
					"content": "Bir de bana sor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280424
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280424,
					"content": "Pekala, hadi Ushi! Bizi buradan çıkar bakalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280425
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280425,
					"content": "Möö!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280426
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10280426,
					"content": "Ushi gizli çıkışı aramaya koyulur...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						10280427
					]
				},
				{
					"id": 10280427,
					"content": "Möö... Möö, möö... Möö!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280428
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10280428,
					"content": "Ha? Ne oldu? Ne! Ah, olamaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280429
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280429,
					"content": "Bir sorun mu var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280430,
					"content": "Ushi her yeri aradığını ama çıkış olmadığını söylüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280431
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280431,
					"content": "Hiç mantıklı değil. Bir şekilde buraya girdiysek çıkış yolu da olması lazım. Durun, ben bir daha bakayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280432
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280432,
					"content": "Bir şey diyeceğim, şunu fark eden oldu mu? En başta buraya yukarıdan düştüğümüzü düşündük. O sırada yukarıda bir çıkış vardı ama şimdi o çıkış bile yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280433
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280433,
					"content": "Benim aklım almıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280434
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280434,
					"content": "Sanırım bu yer altı yapılarında bizim göremediğimiz şeyler var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280435
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280435,
					"content": "Etrafa bir daha bakacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280436
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280436,
					"content": "Nereye baksak her yerden kaya çıkıyor. Ah, belki de yanlış hatırlıyoruzdur. Belki de yürümeye başladığımız yer burası değildir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280437,
					"content": "Ne o, korktun mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280438
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280438,
					"content": "H-Hayır, Paimon çok cesur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280439
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280439,
					"content": "Möö...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280440
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10280440,
					"content": "Öyle mi? Ushi de senin korktuğunu düşünüyormuş. Sorun değil, korktuğunu itiraf etmekten... korkma. Biz seni koruruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280441
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280441,
					"content": "Ben de yanındayım Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280442
					]
				},
				{
					"id": 10280442,
					"content": "#Burada öylece oturup hiçbir şey yapmadan bekleyemeyiz. Çıkışı aramaya devam edelim. Shinobu, sen burada kıymetli kurtarıcımla birlikte kal. {NICKNAME} ve Paimon da benimle gelir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280443
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280443,
					"content": "Tamamdır. Dikkatli olun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280444
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280444,
					"content": "Lütfen ama... Bana \"kurtarıcı\" deyip durmanıza gerek yok. Yanfei demeniz yeterli. Bay Arataki, Arataki Çetesinin başı olduğunuza göre iyi bir lidersiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280445
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280445,
					"content": "Ne kadar da kibar. Bana Itto de. Artık bir ekip olduğumuza göre birbirimizi kollamalıyız. Paimon, tekrar korkarsan senin yerine gözlerini kapayabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280446
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280446,
					"content": "Etrafı araştırmak için gruplara ayrıldınız ama hiçbir şey bulamadınız...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						10280447
					]
				},
				{
					"id": 10280447,
					"content": "... *iç çeker*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280448
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280448,
					"content": "Buradan çıkış yok sanırım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280449
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280449,
					"content": "Möö!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280450
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10280450,
					"content": "Burayla ilgili hâlâ içimde kötü bir his var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280451
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280451,
					"content": "Patron, siz bir şey bulabildiniz mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280452
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280452,
					"content": "Hayır, bulamadık.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280453
					]
				},
				{
					"id": 10280453,
					"content": "Sanki her şey yetmezmiş gibi bir de biraz önce birkaç tane gölge gördüm... Burası hayaletli falan değildir umarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280454
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280454,
					"content": "Muhtemelen bunu sormanın sırası değil ama Paimon kendini tutamayacak. Itto, hani sen bir Onisin ya... Senin bulunduğun her yer zaten hayaletli sayılmıyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280455
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280455,
					"content": "Hayır! Kırmızı boynuzlara takılma sen, tamam mı? Ben şu ürkütücü, uçan ve bir görünüp sonra kaybolan hayaletlerden bahsediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280456
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280456,
					"content": "Ah, Itto? Yoksa sen... Hayaletlerden korkuyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280457
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280457,
					"content": "Eyvah Patron. Anladılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280458
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280458,
					"content": "Ne, ben mi? Yok daha neler! Dalga mı geçiyorsun? Biraz ciddiyetini takın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280459
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10280459,
					"content": "Hehe, sana bakınca Paimon'un korkusu hemen uçup gitti... Hey Boşboğaz, korkarsan Paimon senin yerine gözlerini kapatabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280460
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280460,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280461
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280461,
					"content": "Vaktimi daha iyi değerlendirmem lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280462
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280462,
					"content": "(Hımm. Shinobu gidip biraz taş topladı ve cebinden birkaç tane çubukla Eflatun Kavun çıkardı. Ne?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280463
					]
				},
				{
					"id": 10280463,
					"content": "Biraz tuz... Biraz da karabiber.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280464
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280464,
					"content": "Közde Eflatun Kavun mu yapıyorsun sen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280465
					]
				},
				{
					"id": 10280465,
					"content": "Evet. Közlenmiş Eflatun Kavun epey lezzetlidir. Pişince bir tat istersen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280466
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280466,
					"content": "Olur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280467
					]
				},
				{
					"id": 10280467,
					"content": "Ha dur, iki türü var bunun. Tatlı ya da tuzlu. Hangisini istersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280468
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280468,
					"content": "İkisi de uyar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280469
					]
				},
				{
					"id": 10280469,
					"content": "Pekala, ikisini de denersin o zaman. Sakinliğimizi korumamız önemli. Özellikle de şu anki gibi çetrefilli bir durumun içindeyken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280470
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280470,
					"content": "Yanlışım varsa düzeltin ama sizin konuşmanız gereken meseleler var sanırım. Anladığım kadarıyla patronla beni ilgilendirmeyen meseleler. Sorun değil, ben patronu oyalarım. Siz de o sırada konuşursunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280471
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280471,
					"content": "Oh, burnuma yemek kokuları mı geliyor yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280472
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280472,
					"content": "Gel beraber yiyelim Yanfei.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280473
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280473,
					"content": "Yok, sağ ol. Ben tokum. Size afiyet olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280474
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280474,
					"content": "Ah, seninle de epeydir görüşmemiştik Shinobu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280475
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280475,
					"content": "Evet, bayağı oldu değil mi? En son ben Liyue'de okurken bir hocanın yerine dersime girmiştin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280476
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280476,
					"content": "Hocanın yerine... Evet evet, şimdi hatırladım. Kış vaktiydi, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280477
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280477,
					"content": "Evet, herkes senin dersini epey ilgi çekici bulmuştu. Yalnız şimdi bir düşününce... Ben sana \"Ustam\" desem daha iyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280478
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280478,
					"content": "Ah, öyle deyince hoşuma gitti bak. Hehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280479
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280479,
					"content": "Hep birlikte kendinizi böyle bir çıkmazın içinde bulacaksınız deseler inanmazdım. Kader işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280480
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280480,
					"content": "Yanfei ders de mi veriyor yani? Çok iyiymiş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280481
					]
				},
				{
					"id": 10280481,
					"content": "Ayrıca bir şeyler anlatırken epey komik ve sempatik oluyor. E haliyle öğrencileri de onu çok seviyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280482
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280482,
					"content": "Haha! Yaa, şımardım bak şimdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280483
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280483,
					"content": "Bakıyorum da herkes hâlâ burada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280484
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280484,
					"content": "Yelan, gruplara ayrılıp her tarafı aradık ama çıkışa dair hiçbir şey bulamadık. Sen ne yaptın? Bir şey bulabildin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280485
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280485,
					"content": "Hayır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280486
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280486,
					"content": "Yalnız... Bunu söylemek istemezdim ama hazırlıklı olsak iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280487
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280487,
					"content": "Çıkışı bulamazsak bir süre yerin altındayız demektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280488
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280488,
					"content": "Haklısın galiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280489
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10280489,
					"content": "Anlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280490
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 10280490,
					"content": "Hımm, girişi olan ama çıkışı olmayan, yer altında bir yer... Hiç mantıklı değil ama ben bir şekilde halledeceğim. Biraz zamana ihtiyacım var sadece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280491
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280491,
					"content": "Çıkışa dair herhangi bir şey gören olursa daha fazla ilerlemeden önce tüm önlemleri alsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280492
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10280492,
					"content": "(Aklıma ne geldi, Xiao da buradaydı. Başınız derde girerse beni çağırabilirsiniz demişti.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280493
					]
				},
				{
					"id": 10280493,
					"content": "(Belki denemeye değer...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280494
					]
				},
				{
					"id": 10280494,
					"content": "Hey Gezgin? Daldın gittin. Bir planın mı var yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280495
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280495,
					"content": "Aklıma Xiao geldi de. O da buradaydı, hatırlıyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280496
					]
				},
				{
					"id": 10280496,
					"content": "Xiao... Ah, doğru! Ondan yardım mı isteyeceksin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280497
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280497,
					"content": "En azından denemeye değer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280498
					]
				},
				{
					"id": 10280498,
					"content": "Bence de. Bir deneyelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280499
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280499,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280500
					]
				},
				{
					"id": 10280500,
					"content": "Xiao, beni duyabiliyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280501
					]
				},
				{
					"id": 10280501,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280502,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280503
					]
				},
				{
					"id": 10280503,
					"content": "Şey, Xiao?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280504
					]
				},
				{
					"id": 10280504,
					"content": "Tüh, cevap yok... Paimon nerede olursak olalım Xiao gelir sanmıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280505,
					"content": "Olamaz. Yoksa Xiao bile burada olduğumuzu hissedemiyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10280506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10280506,
					"content": "(...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10280507
					]
				},
				{
					"id": 10280507,
					"content": "(Öyleyse işimiz zor... Nasıl bir yere düştük böyle?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
