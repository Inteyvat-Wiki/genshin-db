			"dialogs": [
				{
					"id": 220140601,
					"content": "Bu bambu filizleri güzel görünüyor. Biraz çıkarayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140602
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140602,
					"content": "Ha? Sen mi geldin? Seni buraya hangi rüzgar attı? Yine lezzetli bir şeyler hazırlamamı ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140603,
						220140604
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140603,
					"content": "Aslında bir konuda yardımın gerek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140607
					]
				},
				{
					"id": 220140607,
					"content": "Vay be, Inazuma yemek malzemelerini Liyue teknikleriyle hazırlamak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140608
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140608,
					"content": "Hehe, tam da şefini buldunuz! Yemek malzemelerini una bulayıp kızarttığın bir Inazuma tekniği duymuştum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140609
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140609,
					"content": "Tempura diyorlar, yanında özel bir dip sosuyla servis ediliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140610
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140610,
					"content": "Tempura yaparken özellikle dip sosu ilgimi çekmişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140615
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140615,
					"content": "Bir sürü yemek malzemesi denedim: Yalancı Çiçek Nektarı, Alev Çiçeği...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140611
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140611,
					"content": "Bodurlop Özüyle yapılıyor olabilir mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140612
					]
				},
				{
					"id": 220140612,
					"content": "Yok, Bodurlop Özü bu yemek için uygun değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140616
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140616,
					"content": "Yine de daha katmanlı bir dokusu olması için Elektrik Cicini kanatlarının tozunu eklemeyi tercih ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140613
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140613,
					"content": "Unutursan diye yazayım, sen sonrasında Xudong'a gösterirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140614
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140614,
					"content": "*iç çeker* Keşke Inazuma'ya gidebilsem. Orada daha önce hiç kullanmadığım bir sürü yemek malzemesi vardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140604,
					"content": "Tıpkı Şef Mao gibi tepki verdin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140605
					]
				},
				{
					"id": 220140605,
					"content": "Ha, restorana mı gittin? Hımm. Şimdi tekrar bakınca, yemeğe gelmiş gibi durmuyorsun hiç.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140606
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 220140606,
					"content": "O zaman mutfakla ilgili bir sorunun mu var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140607
					],
					"speakerTitle": "Xiangling"
				}
			]
