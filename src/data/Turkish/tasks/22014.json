			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Şef Mao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220140201,
					"content": "Ha? Gezgin, burada ne işin var? Yine lezzetli bir şeyler mi hazırlayayım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140202
					],
					"speakerTitle": "Şef Mao"
				},
				{
					"id": 220140202,
					"content": "Aslında senden tavsiye almaya geldim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140203
					]
				},
				{
					"id": 220140203,
					"content": "Xudong yemek yapmak için Inazuma'ya mı gitti? Bu nasıl bir kararlılıktır böyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140204
					],
					"speakerTitle": "Şef Mao"
				},
				{
					"id": 220140204,
					"content": "Onu tanıyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140205
					]
				},
				{
					"id": 220140205,
					"content": "Sayılır. Zamanında bir yemek pişirme yarışı yapmıştık... Beraberlikle sonuçlanmıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140206
					],
					"speakerTitle": "Şef Mao"
				},
				{
					"id": 220140206,
					"content": "Yenilik peşinde dünyayı gezmek istediğini söylemişti... Gerçekten yapacağını hiç düşünmemiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140207
					],
					"speakerTitle": "Şef Mao"
				},
				{
					"id": 220140207,
					"content": "Demek yine de bir noktada duvara tosladı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140208,
						220140210
					],
					"speakerTitle": "Şef Mao"
				},
				{
					"id": 220140208,
					"content": "Onun işine yarayacak bir şey biliyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140209
					]
				},
				{
					"id": 220140209,
					"content": "İşe yarayacağının garantisini veremem ama elimden geleni yaparım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140214
					],
					"speakerTitle": "Şef Mao"
				},
				{
					"id": 220140214,
					"content": "Yosun... Deniz Mantarı... ve... Kiraz Çiçeği mi? Bunlar tuhaf yemek malzemeleriymiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140215
					],
					"speakerTitle": "Şef Mao"
				},
				{
					"id": 220140215,
					"content": "Yosun ve Deniz Mantarıyla bir yemek yapabilirim ama birkaç şey daha lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140216
					],
					"speakerTitle": "Şef Mao"
				},
				{
					"id": 220140216,
					"content": "Gezgin, bana Jueyun Biberi ve Kuş Eti bulabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140217,
						220140219
					],
					"speakerTitle": "Şef Mao"
				},
				{
					"id": 220140217,
					"content": "Tamamdır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140218
					]
				},
				{
					"id": 220140218,
					"content": "Teşekkürler, malzemeleri bulunca bana getirirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Şef Mao"
				},
				{
					"id": 220140219,
					"content": "Klasik yemek malzemeleri...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140220
					]
				},
				{
					"id": 220140220,
					"content": "Hahaha, aynen öyle. Mahvetmesi en zor malzemeler bunlar. Bulunca bana getirirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140221
					],
					"speakerTitle": "Şef Mao"
				},
				{
					"id": 220140221,
					"content": "Bununla beraber Kiraz Çiçeğini nasıl pişireceğimi hiç bilmiyorum... Inazuma'daki şeflerin bu malzemeyi nasıl kullandığını da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Şef Mao"
				},
				{
					"id": 220140210,
					"content": "Belki de Xiangling sorununu nasıl çözeceğini biliyordur...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140211
					]
				},
				{
					"id": 220140211,
					"content": "Xiangling... Doğru, kendisini bildim bileli yaratıcı bir aşçıydı. Belki o bir çözüm bulur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140212
					],
					"speakerTitle": "Şef Mao"
				},
				{
					"id": 220140212,
					"content": "Ama Xiangling, Qingce Köyü'ne bambu filizi toplamaya gitti, yani burada değil. Kendisini bulmamız biraz zaman alır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140213
					],
					"speakerTitle": "Şef Mao"
				},
				{
					"id": 220140213,
					"content": "Xudong gergin bir şekilde bekliyor olsa gerek. Bakalım sorununu çözebilecek miyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140214
					],
					"speakerTitle": "Şef Mao"
				}
			]
		},
