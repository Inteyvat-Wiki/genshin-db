			},
			"dialogs": [
				{
					"id": 220140401,
					"content": "Bu kadarı yeter. Bir saniye. Şimdi bu yemek malzemeleriyle ne yapabileceğime bir bakayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140402
					],
					"speakerTitle": "Şef Mao"
				},
				{
					"id": 220140402,
					"content": "Bitti. Yine de normalde yaptığım yemeklerden çok da farklıymış gibi hissetmiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140403
					],
					"speakerTitle": "Şef Mao"
				},
				{
					"id": 220140403,
					"content": "Yemeği Xudong'a geri götür. Umarım bu sorununu çözer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Şef Mao"
