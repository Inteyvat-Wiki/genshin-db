			"dialogs": [
				{
					"id": 200600701,
					"content": "Ah şu Tunner...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600702
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600702,
					"content": "İlaç hazırlatmaya geldim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600703
					]
				},
				{
					"id": 200600703,
					"content": "Sen yenisin, Moco ve Hillie nerede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600704
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600704,
					"content": "Malzemeleri de getirmişsin. Bir bakayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jilliana"
				}
			]
		},
		{
			"id": 2006008,
			"completionStepIds": [
				2006009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
