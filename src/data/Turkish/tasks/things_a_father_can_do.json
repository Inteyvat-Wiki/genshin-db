				"points": []
			},
			"dialogs": [
				{
					"id": 200600401,
					"content": "Bir saniye... Yeteri kadar tatlı çiçek toplamışız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200600402,
					"content": "Bunları <color=#00E1FFFF>Rahibe Jilliana'ya</color> götürelim mi yoksa daha fazla toplamak ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
