					"Guy"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200600501,
					"content": "Selam! Elindekiler tatlı çiçek mi? Umarım hadsizlik etmiyorumdur ama birini satın alabilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600502
					],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600502,
					"content": "Babamın geçmeyen bir öksürüğü var. Jilliana'dan öksürük ilacı yapmasını istedim ama elinde malzeme kalmamış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600503,
						200600506
					],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600503,
					"content": "Ben de ilaç almaya gidiyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600504
					]
				},
				{
					"id": 200600504,
					"content": "Ah, anlıyorum... O zaman boş ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600505
					],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600505,
					"content": "Zamanını aldım, özür dilerim. Katedrale hemen gitsen iyi edersin, Jilliana'yı orada görürsün muhtemelen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600506,
					"content": "Tatlı çiçek bulmak oldukça kolay.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600507
					]
				},
				{
					"id": 200600507,
					"content": "Ha? Anladım... Ne yazık ki kapıda nöbet tutmam gerek. Görev yerimden ayrılamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600508
					],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600508,
					"content": "Jilliana'yı görmeye gitmek için öğle arasında izin almam gerekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600509
					],
					"speakerTitle": "Guy"
				},
				{
					"id": 200600509,
					"content": "Ama ilacı sen de götürebilirsin sanırım. Daha zamanını almayayım. Katedrale çabucak gidersen Jilliana'yı orada görürsün muhtemelen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Guy"
				}
			]
		},
