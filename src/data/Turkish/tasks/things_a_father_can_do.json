					"content": "Sanırım yeterince topladık. Şimdi gidip <color=#00E1FFFF>Rahibe Jilliana'yı</color> bulalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 2006004,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
