			"trigger": {
				"objectNames": [
					"Tunner"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200600101,
					"content": "Selam sayın ziyaretçi! Oğlum Guy'ı tanıyor musun? *öksürür*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600102
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600102,
					"content": "Sorun nedir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600103
					]
				},
				{
					"id": 200600103,
					"content": "Bir şey yok, inatçı soğuk algınlığı işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600104
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600104,
					"content": "<color=#00E1FFFF>Kilisede</color> rahibelere göründüm ama iyileştiremediler, öyle olunca da semptomları hafifletmek için ilaç yazdılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600105
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600105,
					"content": "*iç çeker* Ama yaşlanmaya başladım, bu yüzden pek uzağa yürüyemiyorum. Geçmişte ilaçlarımı almama hep Moco ve Hillie yardım ederdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600106
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600106,
					"content": "Bugün meşguller... *öksürür* <color=#00E1FFFF>Jilliana</color> ne yapılacağını biliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600107
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600107,
					"content": "Birinin malzemeleri ona götürmesi yeter, böylece o da ilaçları hazırlayabilir. Tek ihtiyacı olan <color=#00E1FFFF>Üç Tatlı Çiçek</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600108,
						200600110
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600108,
					"content": "Tamam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600109
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600109,
					"content": "*öksürür* Teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600112
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600112,
					"content": "Üç dal tatlı çiçek bulup bunları Rahibe Jilliana'ya ver, o da ilacı hazırlasın. <color=#00E1FFFF>Guy'a sakın bir şey söyleme.</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600113
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600113,
					"content": "Kilisenin Favonius Şövalyeleriyle bağlantısı olduğunu duydum. Artık o da Şövalye olduğuna göre nasıl konuşup davrandığına dikkat etmesi gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600114
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600114,
					"content": "Sırf babası yüzünden aptalca bir şey yapmasını hiç istemem. Çok kötü olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600115
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600115,
					"content": "Üzgünüm, dırdırımı yeterince dinledin. Hadi git yoluna. İyi yolculuklar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600110,
					"content": "Oğlun Guy ne yapıyor peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600111
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 200600111,
					"content": "*iç çeker* Yani, çocuk gidip canavarlarla savaşmak istiyorsa niye engel olayım ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600112
					],
					"speakerTitle": "Tunner"
				}
			]
		},
