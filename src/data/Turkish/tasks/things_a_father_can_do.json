					"Jilliana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200600801,
					"content": "İlaç hazır ama bu sadece rahatlatır, hastalığını tedavi etmez. Gerçekten iyileşmek istiyorsa ilaçlarını alıp bolca dinlenmesi gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600802
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600802,
					"content": "Bin kere söyledim ama bir kulağından girip diğerinden çıkıyor işte. Kim ne derse desin, \"İyi olurum, iyileşirim.\" deyip duruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600803
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600803,
					"content": "Peki o zaman. Tunner'a bir an önce ilacını vermelisin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600804,
						200600806
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600804,
					"content": "Teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600805
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600805,
					"content": "Rica ederim. Yalnızca görevimi yapıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600806,
					"content": "Teşekkürler, umarım seni işinden alıkoymamışımdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600807
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200600807,
					"content": "Lafı bile olmaz. *iç çeker* Bay Tunner'a bakan biri olsaydı bu ilaca devam etmek zorunda kalmazdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jilliana"
				}
			]
		},
