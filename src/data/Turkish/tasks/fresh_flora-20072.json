			"dialogs": [
				{
					"id": 200720301,
					"content": "Ejdersırtı'nda sakladığımız çiçekler ne durumda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720302
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720302,
					"content": "Hepsini getirdim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200720303
					]
				},
				{
					"id": 200720303,
					"content": "Hepsini mi? Harika! Dur bir bakayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720304
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720304,
					"content": "Hehe, hiç fena değil. Hımm... Bu yöntem gerçekten işe yarıyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720305
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720305,
					"content": "Sorun şu ki Ejdersırtı, Mondstadt'a çok uzak. Seni de sürekli bunun için rahatsız edemem. Bir dahakine farklı bir yol bulmalıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720306
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720306,
					"content": "Çok teşekkürler. İşte ödülün, lütfen al!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
