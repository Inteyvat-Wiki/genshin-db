			"dialogs": [
				{
					"id": 200720101,
					"content": "Ejdersırtı'nda sakladığımız çiçekler ne durumda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720102
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720102,
					"content": "Yalnızca bir paket getirebildim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200720103
					]
				},
				{
					"id": 200720103,
					"content": "Diğerlerini toplayamadın, öyle mi? Tamam o zaman. Dağdaki koşulları tahmin etmek oldukça zor ne de olsa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720104
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720104,
					"content": "Sadece bir paketi alabildiysen karşılaştırma yapamayız ama. Sanırım tekrar denemek için başka bir fırsat doğana kadar beklemek zorundayız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720105
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720105,
					"content": "Zahmete girdiğin için teşekkür ederim. İşte, ödül olarak sana bunları hazırladım. Gelecekte tekrar yardımına ihtiyaç duyabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
		{
			"id": 2007202,
			"completionStepIds": [
				2007210
