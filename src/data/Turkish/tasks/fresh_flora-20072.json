			},
			"dialogs": [
				{
					"id": 200720401,
					"content": "Bu tarafa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720402
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720402,
					"content": "Senden Ejdersırtı'na gömmeni istediğim çiçekleri hatırlıyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720403
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720403,
					"content": "Üzerinden bir gün geçti. Buzluk denemeleri sonuç vermiş mi görmek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720404
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720404,
					"content": "Dağa çıkıp çiçekleri geri getirmem için bana yardım edebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720405,
						200720407
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720405,
					"content": "O iş bende.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200720406
					]
				},
				{
					"id": 200720406,
					"content": "O zaman sana güveniyorum. Burada bekleyeceğim, çabuk dön.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720407,
					"content": "Çiçekleri nereye gömmüştüm?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200720408
					]
				},
				{
					"id": 200720408,
					"content": "Unuttun mu? Birini <color=#00E1FFFF>Yedilerin Heykelinin yakınına</color>, birini <color=#00E1FFFF>dağdaki bir su kaynağının yanına</color> ve sonuncusunu <color=#00E1FFFF>bir mağara girişinin yakınına</color> gömmüştün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200720409
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200720409,
					"content": "Dur, senin için haritanda yerlerini işaretleyeyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		}
	]
