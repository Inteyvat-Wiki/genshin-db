			"dialogs": [
				{
					"id": 752780101,
					"content": "Siz ikiniz! O-Orada durun bakalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780102
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780102,
					"content": "Sana nasıl yardımcı olabiliriz küçük hanım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780103,
					"content": "\"Çiçek açan Guiztlinin mucizesine tanıklık et, Kutsal Alev tebessümünü aydınlatacak elbet!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780104
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780104,
					"content": "Hı? Nasıl yani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780105,
					"content": "\"Sefa Yeli Tatil Köyü adına sana bir hoş geldin dansı sunuyorum! Göster kendini Pipilpan İdolü!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780106
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780106,
					"content": "Iyy! Yine mi bu sözler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780107,
					"content": "#Evet benim, \"Chiton\"! Hehe, epeydir görüşmedik {M#Bay}{F#Bayan} {NICKNAME} ve Bayan Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780108
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780108,
					"content": "Aa, sen miydin \"Chiton\"? Paimon yine korkunç biriyle karşılaştık sandı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780109,
						752780110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780109,
					"content": "Pek mutlu görünüyorsun. Haberler iyi mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752780111
					]
				},
				{
					"id": 752780111,
					"content": "Hehe, bilin bakalım ne oldu? Performansçı olabilmem için babam beni kendisi eğitecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780112
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780112,
					"content": "Gördün mü? Sert davranıyor ama aslında seni önemsiyor! Paimon onun sadece... Biraz daha normal yöntemlerle öğretmesini isterdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780113,
					"content": "Hah, neredeyse unutuyordum. Bu sizin için!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780114
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780114,
					"content": "Dur biraz, bu senin performans giysin değil mi? Ama sen bu olmadan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780115,
					"content": "Merak etmeyin! Babam üzerime daha iyi oturan bir giysi yaptı. Artık sahneden düşmek yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780116
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780116,
					"content": "Bu eski kostümü anı olarak alın lütfen. Arkadaşlığımızın bir sembolü olarak kabul edin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780117
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780117,
					"content": "Bir dahaki buluşmamızda yeni kostümümle sizin için dans edeceğim. Geleceğinize söz verin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780118
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780118,
					"content": "Tamam, söz veriyoruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780119,
					"content": "\"Chiton\"! İdman zamanı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780120,
					"content": "#Pekala, kaslarımı çalıştırma zamanı geldi. Hoşça kalın {M#Bay}{F#Bayan} {NICKNAME} ve Bayan Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780121
					],
					"speakerTitle": "\"Chiton\""
				},
				{
					"id": 752780121,
					"content": "Güle güle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752780122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780122,
					"content": "(Gerçekten gidecek misin?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752780123
					]
				},
				{
					"id": 752780123,
					"content": "Tabii ki! Ama... Normal bir idol performansı izlemek de güzel olurdu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752780110,
					"content": "Durumlar nasıl?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752780111
					]
				}
			]
		}
	]
}