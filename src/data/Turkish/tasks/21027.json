			"dialogs": [
				{
					"id": 210270101,
					"content": "Tam zamanında geldin Gezgin! Ben de tam seni arıyordum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270102
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210270102,
					"content": "Öyle mi? Hayırdır Minik Meng?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270103,
					"content": "İçine endişelerimi yazıp koyduğum bir şişeyi nehre bırakmak için senden yardım istemiştim, hatırlıyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270104
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210270104,
					"content": "Pek umudum yoktu açıkçası...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270105
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210270105,
					"content": "Ama birkaç gün önce babamın birkaç iş ortağı babamı görmeye geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270106
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210270106,
					"content": "Babamın dediğine göre mantar işine girmeyi düşünüyorlarmış ve piyasa araştırması yapmak için Sumeru'ya gitmeyi planlıyorlarmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270107
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210270107,
					"content": "Babama da onlarla birlikte gitmek ister mi diye sordular.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270108
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210270108,
					"content": "Hatta beni de yanlarında götürebileceklerini söylediler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270109
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210270109,
					"content": "Babam ilk başta kabul etmedi ama arkadaşlarından biri bir mektup çıkardı ve babamla özel konuşmak istediğini söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270110
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210270110,
					"content": "Bir süre konuştular, sonra babam Sumeru'ya beni de götürebileceğini söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270111
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210270111,
					"content": "Şey, fikrini neden bu kadar çabuk değiştirdi bilmiyorum ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270112
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210270112,
					"content": "Artık Sumeru'ya gidebilirim! Sumeru'ya gidiyoruz! Vuhuuuuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270113,
						210270115
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210270113,
					"content": "Gözün aydın!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270114
					]
				},
				{
					"id": 210270114,
					"content": "Yolladığımız şişe sayesinde oldu kesin, eminim buna! Çok teşekkür ederim Gezgin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270117
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210270117,
					"content": "Babam Sumeru'ya gittikten sonra Qiaoying Köyü diye bir yere de gideceklerini söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270118
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210270118,
					"content": "Qiaoying Köyü mü?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270119
					]
				},
				{
					"id": 210270119,
					"content": "Evet. Babamın söylediğine göre orası bayağı yüksek kalitede çay yaprakları olan bir sürü çay ağacının dikili olduğu bir çay köyüymüş. İsmini telaffuz etmesi biraz zor gerçi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270120
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210270120,
					"content": "Neyse, bunu sonra düşünürüz. Önce Sumeru'ya gitmemiz lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270121
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210270121,
					"content": "Buradan epey uzakmış. Bir süre yollarda olacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270122
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210270122,
					"content": "Ama duyduğuma göre yolculuk sırasında neyle karşılaşacağın belli olmadığı için bir sürü hazırlık yapmak gerekiyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270123
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210270123,
					"content": "Sen sık sık seyahat eden birisin. Uzun yolculuklar için bana birkaç püf nokta verebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270124
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210270124,
					"content": "Şey, mesela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270125
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210270125,
					"content": "Mesela seyahat ederken genelde ne yiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270126
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210270126,
					"content": "Babam herkesin kendi pişirdiği yemekleri yediğini söyledi. Ama ben sadece birkaç kolay yemeği yapmayı biliyorum. Onları da güzel yapabilir miyim emin değilim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270127
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210270127,
					"content": "#Ohohoho! Yemek yapmak! Tam bizim uzmanlık alanımız {NICKNAME}, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270128,
						210270129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270128,
					"content": "Aynen öyle. Sana öğretebilirim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270130
					]
				},
				{
					"id": 210270130,
					"content": "O zaman Paimon yemek yapabileceğimiz bir yer bulmamız gerektiğini düşünüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270131,
					"content": "Hımm, bir süreliğine Şef Mao'nun mutfağını kullanmaya ne dersiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270132,
					"content": "Şef Mao mu? Şey... Genelde korkutucu biri değil mi ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270133
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210270133,
					"content": "Şef Mao mu? Korkutucu mu? Yok canım, çok iyi biridir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270134,
					"content": "G-Gerçekten mi? Ama babamla oraya gittiğimizde ne zaman yemeğimdeki Qingxini çıkartsam kaşlarını çatıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210270129,
					"content": "Aynen öyle. Bu iş bende!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270130
					]
				},
				{
					"id": 210270115,
					"content": "Biliyor musun? Belki ben de Sumeru'ya gidebilirim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270116
					]
				},
				{
					"id": 210270116,
					"content": "Gerçekten mi? O zaman orada buluşalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270117
					],
					"speakerTitle": "Minik Meng"
				}
			]
		},
