					"content": "Bakın kimler gelmiş! Gezgin ve Minik Meng! Ne istersiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270202
					],
					"speakerTitle": "Şef Mao"
				},
				{
					"id": 210270202,
					"content": "Ha? Ben, şey... Gezgin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270203
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210270203,
					"content": "Mutfağını bir süreliğine kullanabilir miyiz rica etsek?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270204
					]
				},
				{
					"id": 210270204,
					"content": "Tabii, gerçi biraz emrivaki oldu ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270205
					],
					"speakerTitle": "Şef Mao"
				},
				{
					"id": 210270205,
					"content": "Ha. Öyle mi? Tamamdır, buyurun, kendi mutfağınızmış gibi kullanın lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270206
					],
					"speakerTitle": "Şef Mao"
				},
				{
					"id": 210270206,
					"content": "Minik Meng, seyahat ederken yemek konusunda çok seçici davranma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270207
					],
					"speakerTitle": "Şef Mao"
				},
				{
					"id": 210270207,
					"content": "T-Tamamdır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270208
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210270208,
					"content": "Gezgin, bana lezzetli bir yemek öğret lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270209
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210270209,
					"content": "Yoldayken Babamı şaşırtmak istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270210
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210270210,
					"content": "Tabii!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210270211,
					"content": "#Bakalım... {NICKNAME}, ne yapsak acaba?",
					"roleType": "TALK_ROLE_NPC",
