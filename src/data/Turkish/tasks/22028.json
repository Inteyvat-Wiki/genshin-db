					"content": "Sanırım hükümdarın çok net standartları yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280907
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280907,
					"content": "Öyle ya da böyle herkes bunun hükümdarın işi olduğu düşünmüş. Bu nedenle bu tapınakta dilek dilersem gerçekleşeceğine inanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280908
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280908,
					"content": "Her neyse, olan olmuş artık, bu sefer ne adasak acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280909
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280909,
					"content": "Belki o adam gibi Demir Cevheri adarsak ilahlar sesimizi duyabilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280910
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280910,
					"content": "Demircinin girişine yakın bir yerlerde onlardan birkaç tane görmüştüm. Çok kaliteli görünmüyorlardı, o nedenle demirci onları bana vermekte sakınca görmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280911
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280911,
					"content": "Buralardan da biraz taze yosun topladım. Onları pişirip üzerlerine biraz da şeker serpiştirirsem kesin tatlı bir şeye dönüşecektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280912
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280912,
					"content": "Tabii hükümdar böylesine küçük ve soğuk yemekleri sever mi bilmiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280913
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280913,
					"content": "#Sen ne dersin {F#abla}{M#abi}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280906,
					"content": "Diğer insanlar geride kalırken ilerlemenin bir anlamı var mı ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280907
					],
					"speakerTitle": "Shouta"
				}
			]
		},
