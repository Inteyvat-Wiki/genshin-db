			"dialogs": [
				{
					"id": 220280101,
					"content": "#{F#Abla}{M#Abi}, dinle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280102
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280102,
					"content": "En son tapınağa adak adadıktan sonra küçük bir kısmı da olsa dileğim gerçekleşti! Sadece küçük bir kısmı gerçekleşti ama... Hükümdar bana cevap vermiş olmalı, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280103
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280103,
					"content": "Ne dilemiştin ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220280104
					]
				},
				{
					"id": 220280104,
					"content": "Şey... Okuduğum manganın yazarının daha yaratıcı olmasını dilemiştim. İki günde bir yeni bir şeyler çıkarsa harika olur diyordum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280105
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280105,
					"content": "Sonra da yazar tek sayıda yayınladığı içeriği gerçekten iki katına çıkardı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280106
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280106,
					"content": "Fakat gel gör ki 3 sayı boyunca ara vereceğini duydum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280107,
						220280108
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280107,
					"content": "Her şeyde olması gerektiği gibi mükemmel şekilde dengeli. Sanırım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220280109
					]
				},
				{
					"id": 220280109,
					"content": "Neyse, en azından hükümdar sesimi duydu. Bu da dileklerimin gerçekleşmesi için yeteri kadar adak adamadığım anlamına geliyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280110
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280110,
					"content": "O sebeple bugün diğer tapınaklara da adak adayacağız! Böylece dileklerim eksiksiz bir şekilde gerçekleşecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280111
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280111,
					"content": "Annemle babam bana burada iki tapınak daha olduğunu söyledi. Biri Komore Çayevinin orada, diğeri de şehrin dışındaymış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220280112
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280112,
					"content": "#Sence ilk hangisine gidelim {F#ablacığım}{M#abiciğim}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220280108,
					"content": "Sanırım toplamda sadece bir sayı eksik olacak...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220280109
					]
				}
			]
		},
