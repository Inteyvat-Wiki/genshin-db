			"dialogs": [
				{
					"id": 715340101,
					"content": "Hımm, önce diğer zarflara baksam iyi olacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340102
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340102,
					"content": "#Aa, {NICKNAME}! Görüşmeyeli uzun zaman oldu... Niye bu kadar şaşkınsın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340103
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340103,
					"content": "Beklemiyordum sadece...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715340104
					]
				},
				{
					"id": 715340104,
					"content": "Benim gibi Fener Şenliğinin keyfini çıkaran bir savaşçı görmeyi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340105
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340105,
					"content": "Seni keyif yaparken hiç görmedim sanırım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715340106
					]
				},
				{
					"id": 715340106,
					"content": "Tenryou Heyetinin halka karşı büyük bir sorumluluğu var. Heyetin bir üyesi olarak ben de vaktimi aylaklık ederek geçiremem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340107
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340107,
					"content": "Belki de insanlar beni hayatta yalnızca tek bir gayesi olan ve Hanamizaka gibi şenlikli, nezih mahallerde yeri olmayan bir savaşçı olarak görüyorlardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340108
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340108,
					"content": "Fakat gardımı düşürürsem suçlulara gün doğar... Bu yalnızca benim görevime değil aynı zamanda Hanamizaka'nın ortamına da zarar verir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340109
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340109,
					"content": "Yapabileceğim tek şey önüme çıkan boş zamanları değerlendirmek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340110
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340110,
					"content": "Affedersin. Tatil zamanı böyle ciddi meselelerden bahsetmemeliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340111
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340111,
					"content": "Bir hediye zarfı yapmaya çalışıyorum ama bir türlü olmuyor. Bana biraz tavsiye verebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715340112
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 715340112,
					"content": "Tabii, bir düşüneyim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
