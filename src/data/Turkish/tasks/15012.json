				{
					"id": 150120701,
					"content": "Mesleği neden bıraktı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120702
					]
				},
				{
					"id": 150120702,
					"content": "... Kızından dolayı. Zavallı Nechca amansız bir hastalığa tutuldu ve Tlazolli de onunla ilgilenmek için her şeyden vazgeçti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120703
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120703,
					"content": "Nechca'nın hastalığı kötü seyrettiğinde dahi Tlazolli asla pes etmedi. Karanlık her yandan bastırdığında dahi iradesi, geceyi aydınlatan bir meşale gibi parlaktı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120704
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120704,
					"content": "Sonuca bakmak lazım aslında! Doktorun verdiği ilaçlar ve Yüce Ruh'un himayesi sayesinde Nechca'nın alevi yeniden canlandı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120705
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120705,
					"content": "Durumu günbegün iyiye gidiyor. Tabii hâlâ çok zayıf ve evde dinlenip kendini toparlaması gerekiyor... Ancak mektup yazabilecek güce kavuştu bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120706
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120706,
					"content": "Sık sık Xilonen'e yazar. Hayali bir gün Kadim Ad zanaatkarı olmak. Tıpkı annesi gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120707
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120707,
					"content": "Doğum gününe birkaç gün kaldı, o yüzden Tlazolli hediye olarak ona saf bir Volkanik Kristal bulmamı istedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120708,
						150120709
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120708,
					"content": "Demek bu yüzden geldin buraya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120710
					]
				},
				{
					"id": 150120710,
					"content": "Evet, çok önemli bir cevher parçasıymış! Ne güzel bir hediye, Paimon onun daha iyi hissetmesini umuyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120711,
					"content": "Hem kendisi hem de annesi iyi dileklerinden ötürü çok memnun olacaklar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120712
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120712,
					"content": "Pekala, hadi geri dönelim. Imix meraktan ölmek üzeredir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120713
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120713,
					"content": "Aslında, yarın benimle Tlazolli'yi ziyaret etmeye gelsenize.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120714
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120714,
					"content": "Kristali sizin sayenizde geri götürebiliyorum ne de olsa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120715
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120715,
					"content": "Bizim için bu kadar önemli olan bir şeyi korumamıza yardım ettiğiniz için bir ödülü hak ediyorsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120716
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120716,
					"content": "Umarım Nechca mutlu olur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120717
					]
				},
				{
					"id": 150120717,
					"content": "Aynen. Keyfin yerinde olduğu müddetçe çabucak iyileşirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120718,
					"content": "Ve tabii... Biz de küçük bir hediyeye hayır demeyiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120719,
					"content": "Haha, merak etmeyin. Seveceğinizden eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120720
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120720,
					"content": "Ama ne olduğunu size Tlazolli söyleyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120709,
					"content": "Kristali arkanda bırakmamana şaşmamalı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120710
					]
				}
			]
		},
