			"dialogs": [
				{
					"id": 150120401,
					"content": "Pek de mücadele etmediler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120402,
						150120403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120402,
					"content": "Sanırım kime karşı olduklarını biliyorlardı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120404
					]
				},
				{
					"id": 150120404,
					"content": "Oh... İkinize de teşekkür ederim. Bu dağdan canlı çıkamayacağımı sanmıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120405
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120405,
					"content": "#{NICKNAME} tarafından kurtarıldım... Bugün şans benden yana olsa gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120406
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120406,
					"content": "Ah pardon, kendimi tanıtayım. Ben Cheven, bir mücevher ustasıyım. İşlerim genelde bu kadar yolunda gitmez ama belki de şansım dönmek üzeredir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120407
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120407,
					"content": "Bizi Imix yardıma gönderdi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120408
					]
				},
				{
					"id": 150120408,
					"content": "Demek öyle... *iç çeker* Onu endişelendirmek istememiştim. En fazla iki gün kalırım diye planlamıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120409
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120409,
					"content": "Fakat sonra Gölge İğnesi yakınında yeni bir Volkanik Kristal damarı buldum... Çok büyük bir rezerv ve saflığı olağanüstü seviyede.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120410
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120410,
					"content": "Bir sürü kazıp çıkardım ve tam geri dönmek için hazırlanıyordum ki kristallerin içerisindeki Filojiston canavarların dikkatini çekti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120403,
					"content": "İtibarın getirdiği avantajlar işte...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120404
					]
				}
			]
		},
