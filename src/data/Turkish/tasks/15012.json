			"dialogs": [
				{
					"id": 150120501,
					"content": "Panikledim ve kaçmak için dar bir patikaya doğru koştum... Tam kurtuldum derken o haydutlarla karşılaştım... Tam zamanında geldiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120502
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120502,
					"content": "Madem durum o kadar tehlikeliydi, neden kristalleri bırakıp kaçmadın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120503,
					"content": "Çoğunu geride bıraktım, inan. Yalnızca en saf parçayı aldım. Ne pahasına olursa olsun onu yanımda götürmeliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120504
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120504,
					"content": "... Tlazolli ve zavallı minik Nechca için.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120505
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120505,
					"content": "Onlar kim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120506
					]
				},
				{
					"id": 150120506,
					"content": "Ha doğru ya, siz tanımazsınız onları. Tlazolli, bir zamanlar Kadim Ad zanaatkarıydı, Nechca ise onun kızı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120507
