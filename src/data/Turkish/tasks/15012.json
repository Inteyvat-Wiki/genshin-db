			"dialogs": [
				{
					"id": 150120101,
					"content": "H-Henüz geri dönmedi. Cheven Usta'ya bir şey olmamıştır umarım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120102
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120102,
					"content": "Hey, şuradaki çocuk ağlıyor. Ne oldu acaba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120103,
					"content": "Gel gidip nesi var bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120104,
					"content": "Merhaba. Bir şey mi oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120105
					]
				},
				{
					"id": 150120105,
					"content": "*ağlar* C-Cheven Usta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120106
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120106,
					"content": "Volkanik Kristal toplamaya gitmişti... Ama henüz geri dönmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120107
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120107,
					"content": "Muhafızlara söyledim ama şu anda ellerinde gönderecek adam yokmuş. Arazi de çok tehlikeliymiş, her yerde canavarlar ve kötü adamlar kaynıyormuş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120108
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120108,
					"content": "Onu kurtarmaya gitmeden önce birtakım hazırlıklar yapmaları gerekiyormuş... Ama o zamana kadar çok geç olur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120109,
						150120110
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120109,
					"content": "Merak etme, biz ararız onu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120111
					]
				},
				{
					"id": 150120111,
					"content": "Yardım edecek misiniz yani? Harika! Muhafızların gittiği yeri hızlıca çizeyim size.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120112
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120112,
					"content": "Cheven Usta'nın şurada bir yerde olabileceğini söylediler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120113
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120113,
					"content": "Gölge İğnesinin yakınına gitmek zorunda kalmış olabilir. Eğer öyleyse... O zaman... *burnunu çeker*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120114
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120114,
					"content": "Lütfen! Onu kurtarmanız lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Imix"
				},
				{
					"id": 150120110,
					"content": "Yine kahramanlık vakti geldi galiba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120111
					]
				}
			]
		},
