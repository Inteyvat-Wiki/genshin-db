						150120827
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120827,
					"content": "Ama ne olduğunu size Tlazolli söyleyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150120823,
					"content": "Bir Kadim Ad mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120824
					]
				},
				{
					"id": 150120824,
					"content": "Hey, Ateş Hükümdarı bununla ilgili Xilonen'le konuştuğunu söylemişti zaten. Ortalığı karıştırmayalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150120825,
					"content": "Öyle büyük bir şeye gerek yok. Normal bir hediye yeterli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120826
					],
					"speakerTitle": "Paimon"
				},
				{
