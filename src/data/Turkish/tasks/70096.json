			"dialogs": [
				{
					"id": 700960301,
					"content": "Ineffa! Ineffa! Şu yel değirmenini gördün mü? Nasıl çalıştığını kaydetmeni istiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960302
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960302,
					"content": "Anlaşıldı. Yel değirmeninin fotoğrafını çekmeye hazırlanıyorum. Bu sefer fotoğrafta yer almak ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960303
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960303,
					"content": "#Hı? {NICKNAME}, Paimon? Lohen? Selam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960304
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960304,
					"content": "Haaaa... Nod-Krai'dan gelen güçlü ve kadim bir ejderha demek... Paimon neler olduğunu anladı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960305,
					"content": "Durum değerlendirmesi yapıyorum... Görünüşe göre Bay Lohen benimle dövüşmeyi umuyor. Bu doğru mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960306
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960306,
					"content": "Özetle evet, umduğum şey tam olarak buydu. Sefer kuvvetleri Nod-Krai'dayken böyle olağanüstü bir geçmişin olduğundan hiç şüphelenmemiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960307
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960307,
					"content": "Ama hepsi bir yana... Becerilerimi epeydir sana karşı test etmek istiyordum, o yüzden... Ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960308
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960308,
					"content": "Hehe! Ineffa, göster ona gününü!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960309
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960309,
					"content": "Özür diliyorum, bugünkü programımıza göre bazı özel bileşenleri toplamak için Mondstadt'ı ziyaret etmemiz gerekiyor. Değerlendirmelerime göre şu an sizinle savaşmak sonraki faaliyetlerimizi etkileyebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960310
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960310,
					"content": "Aa, evet... Neredeyse unutuyordum! Mondstadt'ta devasa bir robot olduğunu duyduk... O yüzden buradayız! Ama sonra biraz dikkatim dağıldı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960311
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960311,
					"content": "Sorun değil... Anlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960312
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960312,
					"content": "Lohen... Cidden böyle pes mi edeceksin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960313,
					"content": "Harabe Muhafızlarını halletmene yardım edersem programın boşalır, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lohen"
				}
			]
		},
