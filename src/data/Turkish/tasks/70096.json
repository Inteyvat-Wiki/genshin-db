				"points": []
			},
			"dialogs": [
				{
					"id": 700960201,
					"content": "Bizim komutanımız sadece kuvvetli değil, aynı zamanda Hiçliğe karşı koyan bir bileşik geliştirdi! Bundan haberin yoktu, değil mi ukala? Bir de gelip benim hiçbir şey bilmeyen \"sahte\" bir uzman olduğumu söylüyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960202
					],
					"speakerTitle": "Slazhnev"
				},
				{
					"id": 700960202,
					"content": "Peki senin Büyük Kumandanımızın akılalmaz hızından haberin var mı? Ley Hatlarını kullanarak Nod-Krai'dan Mondstadt'a kadar olan yolu senin bağcıklarını bağlamandan daha kısa sürede katetti. Bağlamayı biliyorsan tabii!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leifhelm"
				}
			]
		},
