			"dialogs": [
				{
					"id": 700960401,
					"content": "Hareketlerin ne kadar akıcı... Bir makina olduğunu asla tahmin edemezdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960402
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960402,
					"content": "Sizin de saldırılarınız da çok isabetli Bay Lohen. Neredeyse mekanik denecek derecede hatta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960403
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960403,
					"content": "Vuhuuu, yeni parçalar, hehe! Bunlarla mükemmel yeni modüller yapabilirim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960404
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960404,
					"content": "Peki... Şey... O zaman artık müsaitliğin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960405
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960405,
					"content": "Ineffa, daha fazla parça ara! Alabildiğimiz kadar parça istiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960406
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960406,
					"content": "Anlaşıldı... Özür dilerim Bay Lohen. Bu konuyu daha sonra konuşuruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960407
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960407,
					"content": "Uzun bir keşiften sonra...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						700960408
					]
				},
				{
					"id": 700960408,
					"content": "Zzz... Zzz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960409
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 700960409,
					"content": "Aino uyumuş... Dornman Limanı'nda oynarken fazla mı yoruldu acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960410,
					"content": "Genelde böyledir, pili çabuk biter. Özür dilerim Bay Lohen ama korkarım ki şu anda kalkamam. Aino derin bir uykuya dalana kadar burada kalmalıyım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960411
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960411,
					"content": "... Hiç sorun değil. Ne kadar yetenekli olduğunu anlayacak kadar şey gördüm zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960412
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960412,
					"content": "... Umarım savaş verilerim size faydalı bilgiler sunar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960413
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 700960413,
					"content": "Bu arada, bize bu özel mekanizmalardan bahseden kişi Ejdersırtı'nı da söyledi. Oraya gidip bir göz atmak isteyebilirsiniz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ineffa"
				}
			]
		},
