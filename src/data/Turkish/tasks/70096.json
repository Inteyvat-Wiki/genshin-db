			"dialogs": [
				{
					"id": 700960601,
					"content": "Harika... Şimdi, Barbeloth'un kehanetine göre, rehberliğe ihtiyacı olan insan gelmek üzeredir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960602
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960602,
					"content": "Giriş replikleri... Ezberlendi. Giriş efektleri... Onaylandı. Hehe, bu sefer hiçbir şey ters gidemez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960603
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960603,
					"content": "Şey... Sizce \"son kehanet\" neden Lohen'in buraya gelmesini gerektiriyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960604,
					"content": "Eyvah, geldiler mi? Durin repliklerini henüz bitirmedi mi? Of... Sessiz kalmalıyım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960605
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960605,
					"content": "Son \"ejderhanın kudreti\", Dvalin'den mi bahsediyor acaba? Gerçi bugün burada değil sanki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960606,
					"content": "Teknik olarak Nod-Krai'dan eve ilk döndüğümde onu zaten görmüştüm. Sizin tam yanınızdaydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960607
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960607,
					"content": "Aa, evet! Kurtlar Diyarı'nda, Varka için mektupları teslim ederken hani! Dur bir dakika... Yoksa bu, kehanetin çoktan gerçekleştiği anlamına mı geliyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960608,
					"content": "Biraz geniş yorumlarsak teknik olarak \"ejderhanın gücüyle üç kez karşılaştım\" sayılır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960609
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960609,
					"content": "Peki \"kuvvetin gerçek anlamını kavradın\" mı henüz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960610
					]
				},
				{
					"id": 700960610,
					"content": "Sanırım kehanet beni bu yüzden buraya getirdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960611
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960611,
					"content": "Burası Fırtına Dehşeti'nin İni olarak bilinmeden önce Fırtına Tanrısı Decarabian'ın bölgesiydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960612
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960612,
					"content": "Fakat dünyayı dışarıda bırakacak fırtınalar yaratabilen kudretli tanrı, kendi rüzgar duvarlarının içindeki özgürlük hasretini dindiremedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960613
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960613,
					"content": "Yine de bir zamanlar onunla kutsal taht için yarışmış olan Kuzey Rüzgarı Tanrısı, her zaman aradığı cevabı ancak gücünden vazgeçtikten sonra buldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960614
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960614,
					"content": "Hı? Görünüşe göre bu çocukta Varka'nın bana anlattığından daha fazlası var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960615
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960615,
					"content": "Şafağın Aynası, Durin... Bir zamanlar onlar da kafa karışıklığı ve şüphe içinde kaybolmuşlardı. Onları güce kavuşturan, kudretten daha fazlasıydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960616
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960616,
					"content": "Bak sen... Gerçekten de anlamaya başlıyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960617
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960617,
					"content": "Bir de Ursa vardı, bir zamanlar melek olan o canavar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960618
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960618,
					"content": "... Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960619
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960619,
					"content": "Paimon'a göre doğru yoldasın Lohen... Ama şey... Biraz garip konuşuyorsun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960620,
						700960621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960620,
					"content": "Önce Durin... şimdi de Lohen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960622
					]
				},
				{
					"id": 700960622,
					"content": "\"Gücü seçen melek, insanlığa yakın kalmayı arzulamaya devam etti ve sonunda acınası bir canavara dönüştü...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960623
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960623,
					"content": "\"Ey tüm bunlara tanıklık eden insanlar, hâlâ güç peşinde misiniz?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960624
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960624,
					"content": "Hey! Onlar benim repliklerimdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960625
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960625,
					"content": "Aaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960626,
					"content": "Tüh ya... Sırrımız artık ortaya çıktı, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960627
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960627,
					"content": "Sizinle tanıştığıma memnun oldum Leydi Nicole. Senaryonuzu okudum, çok etkilendiğimi söylemek isterim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960628
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960628,
					"content": "*iç çeker*... Neden içimden bir ses Durin'in kendi nüshasını düşürdüğünü söylüyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960629
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960629,
					"content": "Hım? Demek o da kehanetin bir parçasıydı, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960630
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960630,
					"content": "Hiç de bile. Önceden bilseydim öylece... *öksürür*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960631
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960631,
					"content": "Her neyse, iyi yazılmış bir senaryoydu. Tabii ki iç ısıtan küçük bir peri masalı olarak çok eğlenceliydi. Ama söylemeliyim ki ders verilmesinden pek hoşlanmam... Bir melek tarafından bile olsa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960632
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960632,
					"content": "... Bunun eski meslektaşımı, yani kuvveti seçen kişiyi hedef aldığına inanmayı tercih edeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960633
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960633,
					"content": "Senaryomu okuduğuna göre, söyleyeceğim her şeyi zaten biliyorsundur, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960634
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960634,
					"content": "Kesinlikle, bunu değerli bir tavsiye olarak göreceğim. Şimdi, başka bir konu var mıydı yoksa Zorlu Düşmanlar Saha Kitabı'nı derlemeye geri dönebilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960635,
						700960636
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960635,
					"content": "(Bu tavsiyeye uyacağını söylemedi...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960637
					]
				},
				{
					"id": 700960637,
					"content": "Ama itiraf etmeliyim ki oldukça verimli bir gündü. En azından birazcık daha kuvvetlenmiş olmalıyım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960638
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960638,
					"content": "Hepinize teşekkür ederim... Ve prodüksiyon ekibine de selamlarımı iletin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960639
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960639,
					"content": "*iç çeker*... İnsanlarla uğraşmak neden hep bu kadar zor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960640
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960640,
					"content": "Şey, biri Paimon'a neler olduğunu söyleyebilir mi? Paimon'un... Kafası çok ama çok karıştı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960641,
					"content": "Mondstadt'ta Dottore'yle ve Ursa'nın arkasında bıraktığı zehirle uğraştığını hatırlıyor musun? Duyduğuma göre o zamanlar Lohen de payına düşen acıyı çekmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960642
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960642,
					"content": "Bu felakete eski bir melek sebep olduğu için olayları düzeltme görevi de doğal olarak şimdiki bir meleğe düştü... Gerçi \"olaylar\" tam da planladığım gibi gitmedi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960643
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960643,
					"content": "Görünüşe göre insanlığın kaderi giderek daha da öngörülemez oluyor... Meleklerin rehberliği artık onları geleceğe taşıyan yegane unsur değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960644
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960644,
					"content": "Ama bütün o sonsuz olasılıklar... Belki de insanlığın gerçek kuvveti tam da burada yatıyordur, olamaz mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 700960636,
					"content": "(Nicole ne derse desin, Lohen büyük ihtimalle saha kitabını derlemeye devam edecek...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960637
					]
				},
				{
					"id": 700960621,
					"content": "Neden herkes bir senaryodan replik okuyormuş gibi konuşuyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960622
					]
				}
			]
		},
