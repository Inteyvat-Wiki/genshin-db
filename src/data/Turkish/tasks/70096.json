			"dialogs": [
				{
					"id": 700960501,
					"content": "... Güç Arayan, Kaderin Takipçisi, nihayet geldin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960502
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960502,
					"content": "Durin... Paimon hiç şaşırmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960503,
					"content": "Konuşma tarzı bir tuhaf ama...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960504
					]
				},
				{
					"id": 700960504,
					"content": "Bir hükümdar lord, bir büyücünün eseri ve meleklerin soyundan gelen biri... Üçü de birbirinden farklı güçlere sahip olsalar da ejderha olarak taç giydiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960505
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960505,
					"content": "... Çünkü ejderhalar gücün sembolüdür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960506
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960506,
					"content": "Yani \"büyük ejderhalarla savaşmak\", kuvvetini kanıtlamanın bir yolu haline geldi, öyle mi? Hım. Sanırım kurucu Büyük Kumandanı biraz daha iyi anlamaya başlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960507
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960507,
					"content": "... Hı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960508
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960508,
					"content": "Görüyorum ki hâlâ söyleyecek çok sözün var ama bunun yerine kılıçlarımızı çarpıştırmamızı öneririm. Ne de olsa tek bir kılıç darbesi bin söze bedeldir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960509
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960509,
					"content": "D-Dur! G-Genç insan, aradığın imtihan buradan çok uzakta. Fırtına Dehşeti'nin İni'ne gitmeli ve son kehanetle yüzleşmelisin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960510,
						700960511
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960510,
					"content": "Neden bu kadar hızlı konuşuyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960512
					]
				},
				{
					"id": 700960512,
					"content": "İyi misin Durin? Bugün biraz tuhaf konuşuyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960513,
					"content": "(Offf, oh be... Bayağı bir şeyi atlamak zorunda kalmış olsam da sanırım önemli kısımları söyledim!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960514
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960514,
					"content": "Şey, sanırım Albedo bir deney için yardıma ihtiyacı olduğunu söylemişti, o yüzden artık geri dönsem iyi olacak. Kusura bakmayın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960515
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 700960515,
					"content": "Alelacele gitti... Tüh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960516
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960516,
					"content": "Aa, bu ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960517
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960517,
					"content": "Şey... Durin tam olarak neden buradaydı? \"Fırtına Dehşeti'nin İni'ne gitmekten\" bahsettiği son repliğini saymazsak dümdüz saçmalıyor gibiydi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700960518,
						700960519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700960518,
					"content": "İçimden bir ses diyor ki...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960520
					]
				},
				{
					"id": 700960520,
					"content": "İlginç. Bu \"kehanetin\" tam olarak nasıl gerçekleşeceğini merak etmeye başladım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lohen"
				},
				{
					"id": 700960519,
					"content": "... Sırf bir sonraki ejderha üçüncü sayılsın diye buradaydı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960520
					]
				},
				{
					"id": 700960511,
					"content": "Sahneden bir an önce inmek isteyen bir aktör gibi sanki!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700960512
					]
				}
			]
		},
