					"nextDialogs": [
						222000602
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000602,
					"content": "Bunların düşüncesi bile beni... *GURULDAR*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000603
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000603,
					"content": "Lütfen bana bu yemeklerden birini getir... Şimdilik karnım *GÜRLER* sussa yeter...",
