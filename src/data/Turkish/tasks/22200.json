					]
				},
				{
					"id": 222000505,
					"content": "Wanmin Restoranındaki Şef Mao'nun Kara Sırtlı Levrek Yahnisi yapmayı bildiğini duymuştum... Ona sorabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000506
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000506,
					"content": "Nilüfer Tohumlu Yumurta Çorbası tariflerini de Otacı Gui biliyordur. Soracak olursan kendisi Yujing Terası'ndaki Bubu Eczanesinde çalışıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000507
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000507,
					"content": "Bir tüccardan da Mondstadt'taki Avcının Yeri'nde çok iyi Krep yapıldığını duymuştum, hem doyurucuymuş da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000508
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000508,
					"content": "Tavuk Mantar Şişlerine gelince... Onu yapmak çok da zor değildir herhalde.",
