			"dialogs": [
				{
					"id": 222000301,
					"content": "Doyurucu bir yemek bulabildin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000302,
						222000304
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000302,
					"content": "Evet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						222000303
					]
				},
				{
					"id": 222000303,
					"content": "Harika, tadına bakayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000304,
					"content": "Henüz değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						222000305
					]
				},
				{
					"id": 222000305,
					"content": "Tamamdır. Balıkçı Tostu almak istersen Wanmin Restoranında bulabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000307
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000307,
					"content": "Mondstadt'ta bir tüccar, Yeri'nde Gelin Çiçekli Yengeç Çorbası diye bir yemekten bahsediyordu. Sanırım güzel olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000308
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000308,
					"content": "Mondstadt yemeklerinden bahsetmişken, Izgara Balık ve Çiçekli Tavuk yemeklerini yapmak çok zor olmamalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000309
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000309,
					"content": "*GURULDAR* Sırf bu yemeklerin isimlerini söylemek bile beni daha da acıktırıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yicheng"
				}
			]
		},
