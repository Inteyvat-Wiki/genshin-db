			"trigger": {
				"objectNames": [
					"Yicheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 222000101,
					"content": "Selam, sen... *GURULDAR*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000102
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000102,
					"content": "Karnım yine şu korkunç gürültüyü çıkarıyor. Şey diyordum, şeye ihtiyacın var mı... *GURULDAR*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000103
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000103,
					"content": "Pardon, ne diyordun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						222000104
					]
				},
				{
					"id": 222000104,
					"content": "*iç çeker* Her acıktığımda karnım böyle yapıyor. Şöyle guruldayayım, yok aman böyle guruldayayım. Bir de çok yüksek sesle gurulduyor. Kendi sesimi bile duyamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000105
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000105,
					"content": "Bubu Eczanesine *GURULDAR* gidip kontrollerimi yaptırdım ama doktor hasta olmadığımı, sadece acıktığımı söyledi. Yani bunun bir *GÜRLER* tedavisi yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000106
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000106,
					"content": "Doktor, öğünlerimi sağlam yemem gerektiğini söyledi ama... Ben genelde herkesten çok... *GURULDAR*. Yani her defasında tam doyana kadar yesem, cüzdanım iflas eder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000107
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000107,
					"content": "Jiayi, şu anki öğünlerimin yetersiz olmasının işimi etkilememesi için, boşlukları dolduracak bir şeyler alıp yemem gerektiğini söylüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000108
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000108,
					"content": "\"Boşlukları doldurmak\" diyor da, yemek istediklerimin listesi oldukça uzun ve ben de midemi doldurmak için hangisinin en iyi seçenek olduğunu bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000109
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000109,
					"content": "Gezgin, senin dışarıda yaşama tecrüben var, hangi yiyeceklerin doyurucu olduğunu biliyorsundur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000110
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000110,
					"content": "Listemdeki en doyurucu ve lezzetli yiyeceği seçmeme yardım eder misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000111
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000111,
					"content": "Şu anda ne yemek istersin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						222000112
					]
				},
				{
					"id": 222000112,
					"content": "Bir sürü seçenek var... Düşüneyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yicheng"
				}
			]
		},
