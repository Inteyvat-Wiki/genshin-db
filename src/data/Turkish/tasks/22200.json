				"points": []
			},
			"dialogs": [
				{
					"id": 222000201,
					"content": "Mondstadt'ta tadı şahane olan yemekler olduğunu duydum... Çiçekli Tavuk, Mondstadt Usulü Izgara Balık, Balıkçı Tostu, Gelin Çiçekli Yengeç Çorbası...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000202
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000202,
					"content": "Midemi en iyi dolduracak yemeği seçsen yeter. Yardımın için teşekkür ederim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000203
					],
					"speakerTitle": "Yicheng"
				},
				{
					"id": 222000203,
					"content": "Bunu yersem en azından midem tüm gün ses çıkarıp durmaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yicheng"
				}
			]
		},
