			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Urubamba"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750460101,
					"content": "Yuhhoov! Ufaklıklar, geri dönün! Size diyorum! Yuhhoov!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460102
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460102,
					"content": "Merhaba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460103
					]
				},
				{
					"id": 750460103,
					"content": "Yuhhoooov! *iç çeker*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460104
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460104,
					"content": "Çok kötü hissediyorum. Çok ama... Çok üzgünüm. Bunu... Nasıl düzeltebilirim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460105
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460105,
					"content": "Biraz saman getirmeye çıkmıştım, bir baktım ki sekiz küçük Tatankazorum kaçmış gitmiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460106
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460106,
					"content": "Hâlâ çok küçükler! Ya dağ yabanileri onlara eziyet ederse... Ya kaybolurlarsa... Ya da bir yerlerde sıkışıp kalırlarsa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460107
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460107,
					"content": "Sevgili dostum, küçük Tatankazorlarımı gördün mü acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460108
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460108,
					"content": "Tam olarak neye benziyorlar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460109
					]
				},
				{
					"id": 750460109,
					"content": "Annelerini ben büyüttüm. O benim kızım sayılır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460110
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460110,
					"content": "Anneleri, Bereket Kolektifinin en güzel Sürüngenlerinden biriydi. Hatta bölgesel güzellik yarışmasında ödül kazanmışlığı bile var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460111
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460111,
					"content": "O sekiz küçük haylazın hepsi de annelerinin güzelliğini almış. Güzel, pembe derileri ve yelpaze şeklinde kusursuz boynuzları var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460112
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460112,
					"content": "Küçük dostlarımı görürsen lütfen onları bana getirir misin? Sana güveniyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460113
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460113,
					"content": "Küçük Sürüngenlerim... Söz veriyorum, artık size eskisi kadar sert davranmayacağım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460118
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460118,
					"content": "Gözümü dört açarım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460119
					]
				},
				{
					"id": 750460119,
					"content": "İyi kalpli dostum, çok teşekkür ederim. Umarım bugün her zamankinden daha fazla göğüs basabilirsin, barfikslerin krampsız, karın kasların taş gibi olsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Urubamba"
				}
			]
		},
