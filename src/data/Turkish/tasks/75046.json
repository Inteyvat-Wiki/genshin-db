						750460414
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460414,
					"content": "İşte hepsi geri döndü.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750460415
					]
				},
				{
					"id": 750460415,
					"content": "Onları sen mi geri getirdin? Gerçekten çok teşekkür ederim! Minnettarlığımın göstergesi olarak lütfen şu sandıklardaki ödülleri al.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460416
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460416,
					"content": "Birazdan gidip onları göreceğim. Ah benim küçük Sürüngenlerim, canım Sürüngenlerim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750460417
					],
					"speakerTitle": "Urubamba"
				},
				{
					"id": 750460417,
					"content": "Artık yeniden bir eğitmen olmaya odaklanabilirim. Bu arada, eğer Savaşçı Mücadelesine katılmak isterseniz gelip beni bulabilirsiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Urubamba"
				}
			]
