				"points": []
			},
			"dialogs": [
				{
					"id": 756600101,
					"content": "Ah... Hava ne güzel. Dışarı çıktığıma değdi gerçekten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600102
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600102,
					"content": "Hı? Gözlerim beni yanıltıyor mu yoksa bizim \"Tu{RUBY#[D]Umut}maini\"yi mi görüyorum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600103,
						756600104
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600103,
					"content": "Xilonen, bu ne tesadüf.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600105
					]
				},
				{
					"id": 756600105,
					"content": "Xilonen'e Irade ve sınav aşamalarından bahsediyorsun...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						756600106
					]
				},
				{
					"id": 756600106,
					"content": "Hımm, anladım... Unutmuşum, geçen ben de ona yardımcı oldum. Bizim kabilenin aşaması neredeyse hazır hatta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600107
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600107,
					"content": "Başta ona sadece \"Tetlahuitl Felaketi\" Nkunga ile \"Seit'aad'ın Kum Hançeri\" Amuru yardımcı oluyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600108
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600108,
					"content": "Fakat onlar \"hareketlilik\" konusunda pek iyi değiller, daha çok doğrudan çarpışmayı severler. Bu yüzden geri bildirimleri biraz taraflı oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600109
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600109,
					"content": "Bunu duyduktan sonra Pacal hemen benim tavsiye vermemi istedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600110,
						756600113
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600110,
					"content": "Mevcut aşamayı sen mi yaptın yani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600111
					]
				},
				{
					"id": 756600111,
					"content": "Öyle sayılır. Pacal ve Irade'la birlikte görüşüp birkaç değişiklik yaptık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600112
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600112,
					"content": "Bu aşamalar genel olarak savaş esnasında hızlıca avantajlı bir mevziye geçip dengeyi kendi lehine çevirmekle ilgili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600116,
						756600117
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600116,
					"content": "Öyleyse sınavına girmeme müsaade et!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600118
					]
				},
				{
					"id": 756600118,
					"content": "Bırak şimdi, Natlan'daki herkes senin gücüne şahit oldu. Dünyada senin zorlanacağın bir mücadele olduğunu sanmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600119
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600119,
					"content": "Neyse, aşama şurada. İstersen deneyebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600117,
					"content": "Umarım çok zor hazırlamamışsındır...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600118
					]
				},
				{
					"id": 756600113,
					"content": "Elinden gelmeyen iş yok gerçekten, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600114
					]
				},
				{
					"id": 756600114,
					"content": "Eh, birkaç basit cihaz alt tarafı. Yapması o kadar da zor olmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600115
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600115,
					"content": "Kabilemizden sürekli daha güçlü savaşçılar çıkması için sadece bir defalığına uğraşmam gerekti, o kadar. Bence bu zahmete değer, hem kalan boş vaktimde de geciktirdiğim siparişler üzerinde çalışabildim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756600116,
						756600117
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 756600104,
					"content": "Irade'dan görev aldım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756600105
					]
				}
			]
		}
	]
}