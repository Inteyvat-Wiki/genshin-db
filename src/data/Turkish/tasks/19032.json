			"dialogs": [
				{
					"id": 1903203101,
					"content": "*ağlar* Ne? Hıı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203102
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203102,
					"content": "Şey... Bana... B-Bana yardım edebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203103,
						1903203104
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203103,
					"content": "Yardım mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203105
					]
				},
				{
					"id": 1903203105,
					"content": "Şu mavi saçlı kötü ruh kovucu ne kadar da korkunç!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203106
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203106,
					"content": "Onu buradan uzaklaştırır mısın? Tüylerimi diken diken ediyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203107,
						1903203108
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203107,
					"content": "Onun o yang enerjisi seni de etkiliyor mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203109
					]
				},
				{
					"id": 1903203109,
					"content": "Yaklaşmaya cesaret bile edemezdim... Enerjisi... Çok korkunç! Beni yok edecek kadar yüksek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203110
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203110,
					"content": "... Yok olmak istemiyorum! Lütfen, yardım et...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203111,
						1903203112
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203111,
					"content": "Acaba seni kötü ruh olarak mı görüyor ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203113
					]
				},
				{
					"id": 1903203113,
					"content": "Şey... B-Bir fikrim var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203114
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203114,
					"content": "M-mavi saçlı kötü ruh kovucuyu birkaç dakika önce şurada biriyle tartışırken gördüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203115
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203115,
					"content": "Ben sorun çıkaranları korkuturum ama senin de kötü ruh kovucuyu durdurman gerekiyor, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203116,
						1903203118
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203116,
					"content": "Doğruyu mu söylüyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203117
					]
				},
				{
					"id": 1903203117,
					"content": "T-tabii ki... Qianqian asla yalan söylemez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203120
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203120,
					"content": "Şey, eee... Ne diyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203121
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203121,
					"content": "Ne yapacağına kendisi karar verecek ama durumu elimden geldiğince izah etmeye çalışırım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203122
					]
				},
				{
					"id": 1903203122,
					"content": "Tamam... Bunu \"evet\" olarak kabul ediyorum o zaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203123
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203123,
					"content": "Umarım mavi saçlı kötü ruh kovucu iyi bir insandır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203124
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203124,
					"content": "Yani ben ona yardım edeceğim, sen de gidip onunla konuşacaksın. Sonrasında umarım beni rahat bırakır... Ne diyorsun, uyar mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203118,
					"content": "Ben onu beladan kurtarabilirim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203119
					]
				},
				{
					"id": 1903203119,
					"content": "Evet ama... biraz karışık olacak. Benim aklımda zaten bir plan var, bana inanman yeterli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203120
					],
					"speakerTitle": "Qianqian"
				},
				{
					"id": 1903203112,
					"content": "Ne yapacağına kendisi karar verir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203113
					]
				},
				{
					"id": 1903203108,
					"content": "Hele canım bütün gün ortalıklarda yoktun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203109
					]
				},
				{
					"id": 1903203104,
					"content": "Niye ben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203105
					]
				}
			]
		}
	]
}