			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200300201,
					"content": "Öyleyse lafı daha uzatmadan, resmi olarak Loncaya hoş geldin diyebiliriz, yeni ve hevesli maceracı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300202
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300202,
					"content": "Bu da <color=#00E1FFFF>Maceracı El Kitabın</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300203,
						200300205
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300203,
					"content": "Artık bunun için bir el kitabı mı var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300204
					]
				},
				{
					"id": 200300204,
					"content": "Aramıza yeni bir üyenin katılması çok önemli bir olay! Ufak bir seremoniyi hak ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300207
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300207,
					"content": "Üzerinde mevcut görevler ve ödülleri yazıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300208
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300208,
					"content": "Ayrıca üyeliğinin de bir kanıtı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300209
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300209,
					"content": "Bir şey daha var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300210
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300210,
					"content": "Bazen belirli bir Macera Rütbesinde sıkışıp kalabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300211
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300211,
					"content": "Böyle olduğunda Loncada tanınırlığını artırmak için etkileyici ve cesaret isteyen işler yapman gerekir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300212
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300212,
					"content": "Cesaret isteyen işler mi? Yeni gelenler için bir kabul sınaması gibi duruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200300213,
					"content": "Bunlar, tamamlandığında sonraki Macera Rütbesine yükselmeni sağlayan belirli maceralar. Bunlara Yükseliş maceraları diyebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300214
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300214,
					"content": "Ama bu konuya sonra geliriz. Daha fazla maceracı deneyimi kazandıkça bilinirliğini artırmak için yeni fırsatlarla karşılaşacaksın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300215
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300215,
					"content": "Bugünlük bu kadar yeter. Gelecekte tekrar görüşmek için bolca fırsatımız olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300216
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300216,
					"content": "Yıldızlar ve hiçlik yoldaşın olsun Maceracı! Yeterince çabayla yıldızlara ulaşıp hiçliği fethedebilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300205,
					"content": "Daha çok pazarlama broşürü gibi duruyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300206
					]
				},
				{
					"id": 200300206,
					"content": "Bir nevi öyle sayılır ama daha kullanışlı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300207
					],
					"speakerTitle": "Katheryne"
				}
			]
		}
	]
