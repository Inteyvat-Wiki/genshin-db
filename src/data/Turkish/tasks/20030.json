			},
			"dialogs": [
				{
					"id": 200300101,
					"content": "<color=#00E1FFFF>Maceracılar Loncasına</color> hoş geldin. Aslında seni bir süredir gözlemliyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300102,
					"content": "#Yani {NICKNAME} bir süredir izleniyor mu? Bir sorun falan mı çıkardı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200300103,
					"content": "Demek istediğim o değildi. İyi maceracıları takip etmek işimin bir parçası.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300104,
					"content": "Sana baktığımda, efsanevi maceracılara rakip olacak türde bir potansiyel görüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300105,
					"content": "Paimon da bu potansiyeli görüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200300106,
					"content": "#Paimon {NICKNAME} ile seyahat ederken hep güvende hissediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200300107,
					"content": "Yine de maceracılar için deneyim potansiyelden çok daha önemli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300108,
					"content": "<color=#00E1FFFF>Macera Rütbeni</color> yükseltmek için <color=#00E1FFFF>Macera TP</color> toplaman gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300109,
					"content": "Kaybedecek vakit yok, şimdi sana durumu özetleyeyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300110,
					"content": "Dur! Yani şimdi biz gerçek maceracılar mıyız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200300111,
					"content": "Endişelenme, Maceracılar Loncası herhangi bir üyelik ücreti almıyor ya da üyelerine görev dayatmıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300112
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300112,
					"content": "Kısacası üye olmanın bir sürü avantajı var ve kötü bir yani yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300113,
						200300114
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300113,
					"content": "Tamam o zaman...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300116
					]
				},
				{
					"id": 200300116,
					"content": "Temel olarak Maceracılar Loncası Macera Rütben her yükseldiğinde seni ödüllendirir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300117
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300117,
					"content": "Bu yeni üyelik hediyen. Gelecekte ödüllerini almak için buraya dönmen gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300118
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 200300118,
					"content": "Macera Rütbesi Ödülleri",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 200300114,
					"content": "O zaman ödeneklerimi ver, hemen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200300115
					]
				},
				{
					"id": 200300115,
					"content": "Haha... Bugünlerde loncaya yeni katılanlar lafı hiç dolandırmıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200300116
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
		{
			"id": 2003002,
			"completionStepIds": [
				2003003,
				2003004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2003003",
							"2"
						],
						"stepId": 2003003,
						"stateName": "QUEST_STATE_UNFINISHED"
