			"dialogs": [
				{
					"id": 140030101,
					"content": "Çok özür dilerim Charlotte ama bugün kardeşimle programımız çok yoğun. Ne yazık ki bu röportajı reddetmek durumundayız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030102
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030102,
					"content": "Ay, lütfen Lyney! Sadece birkaç dakika sürecek, rica ediyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030103
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030103,
					"content": "Hım. Neler oluyor burada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030104,
					"content": "Bütün gece Hayalet Gelincik hakkındaki yazımı yazdım, bu sabah baskıya girecekti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030105
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030105,
					"content": "Ama tam şafak vaktinde Cesar'ın nişanlısı Jemma'dan bir haber geldi. Jandarmalara ihbarda bulunmuş ve en başından beri Hayalet Gelincik'in kendisi olduğunu itiraf etmiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030106
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030106,
					"content": "Vay, bu ne hız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030107,
					"content": "Öhöm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030108
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030108,
					"content": "Hımm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030109
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030109,
					"content": "Artık çok geç.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030110
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 140030110,
					"content": "Hohoho! \"Bu ne hız\" mı dedin? Görünüşe göre bilmediğim şeyler var! Lütfen beni aydınlat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030111
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030111,
					"content": "Hehe, tüh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030112,
					"content": "Aha! İçgüdülerim beni yanıltmadı, KESİN bir şey saklıyorsunuz! Jemma'nın kendisini ele vermesiyle dün akşam Lyney'nin gösterisi arasında kesin bir bağlantı var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030113
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030113,
					"content": "Belki yüksekten kaçış numaramı izlemek Cesar'la geçirdiği güzel günleri hatırlatmıştır ve vicdanının sesini daha fazla duymazdan gelememiştir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030114
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030114,
					"content": "Hım, peki o zaman... Bir dakika, hayır hayır, bundan daha fazlası olmalı! Fikrini değiştirmesi madem bu kadar kolaydı, o zaman nasıl oldu da bunu yapması on yıl sürdü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030115
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030115,
					"content": "Iı... Şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030116
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030116,
					"content": "(Charlotte'un gazeteci ruhu yanıp tutuşuyor, onun bir şekilde dikkatini dağıtmamız gerek...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140030117
					]
				},
				{
					"id": 140030117,
					"content": "Hah, şimdi hatırladım! Gösteriden sonra Jemma ile ortalıktan kayboldunuz... Aranızda neler oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030118
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030118,
					"content": "Soru yağmuru! Gösteriden sonra nereye gittiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030119
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030119,
					"content": "Ha, mezarlığa gittik, Lyney orada bize özel bir sihir numarası gösterdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030120,
					"content": "İyi ki konusunu açtın hatta, şimdi Paimon bir şey hatırladı. Lyney sihir numaralarında Gökkuşağı Gülleri kullanmaya başladı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030121,
					"content": "*öksürür*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030122
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030122,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030123
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 140030123,
					"content": "Senden hiç Gökkuşağı Gülü aldığımı hatırlamıyorum ben. Yani onlar senin için kendi kız kardeşinden daha mı önemli o zaman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030124
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 140030124,
					"content": "Hayır! Ş-Şey, ben, ııı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030125
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030125,
					"content": "#Hayda... Ne oldu? Paimon yine yanlış bir şey mi söyledi {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030126,
					"content": "#Çok garip oldu... Ne yapacağız {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030127,
					"content": "*iç çeker* Görünüşe göre bu röportajın yapılacağı yok. Her neyse, bir dahakine artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030128
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030128,
					"content": "Israrımı bağışla ama bu kadar ses getirecek bir haber varken fırsatı kaçıramam! Jemma hakkındaki haberler çoktan bomba etkisi yarattı, bu işin özünü öğrenmek için elimden geleni ardıma koymayacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030129
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030129,
					"content": "Görünüşe göre Jandarmalara \"Lorenzo'yu son bir kez daha görmek istediğini\" söylemiş. *iç çeker* Karmaşık ilişkiler yaşandığı gayet net... Merakımdan dolayı beni suçlamayın sakın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030130
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030130,
					"content": "Pekala, ben gideyim de siz konuşmanıza rahat rahat devam edin. Şimdilik hoşça kalın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030131
					],
					"speakerTitle": "Charlotte"
				},
				{
					"id": 140030131,
					"content": "Şey, Lynette, Paimon öyle demek iste...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030132,
					"content": "Merak etme, kızmadım. Sadece onun dikkatini dağıtmaya çalışıyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030133
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 140030133,
					"content": "Ha, gerçekten mi? Çok şükür. Paimon'u korkuttun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140030134,
					"content": "Beni de korkuttu Paimon, beni de... En azından işe yaradı ama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030135
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140030135,
					"content": "... Lütfen o Gökkuşağı Gülüne iyi bakın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140030136
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 140030136,
					"content": "Kaybederseniz çok üzülürüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lynette"
				}
			]
		}
	]
}