			"dialogs": [
				{
					"id": 120230601,
					"content": "Hoş geldiniz! Taze meyve ve sebzem var, ister misiniz? Eti fazla kaçırdıysanız tam olarak doğru adrestesiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230602
					],
					"speakerTitle": "Kabasawa"
				},
				{
					"id": 120230602,
					"content": "Ne var ne yok? Rapor edeceğiniz bir şey var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230603
					]
				},
				{
					"id": 120230603,
					"content": "Tenryou Heyeti ile Fatui arasındaki olaydan mı bahsediyorsunuz? Kulağıma birkaç söylenti geldi fakat çok da bir bilgim yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230604
					],
					"speakerTitle": "Kabasawa"
				},
				{
					"id": 120230604,
					"content": "Askerlerin tedirgin olduğunu söylemen tuhaf aslında, çünkü ben de aynı şeyi düşünüyorum. Şuradaki adamı görüyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230605
					],
					"speakerTitle": "Kabasawa"
				},
				{
					"id": 120230605,
					"content": "Son günlerde bir garip davranıyor. Yapacak bir şey bulamayınca elinde mızrağıyla sağa sola sataşıyor. Birkaç kere cidden ödümü kopardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230606
					],
					"speakerTitle": "Kabasawa"
				},
				{
					"id": 120230606,
					"content": "Neyse... Zaten savaşın sona ermesi mucize gibi bir şey. Umarım artık başımıza yeni bir bela açmayız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230607
					],
					"speakerTitle": "Kabasawa"
				},
				{
					"id": 120230607,
					"content": "İstediğiniz bilgileri veremediğim için üzgünüm. İstiyorsanız o adamla da bir konuşun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230608
					],
					"speakerTitle": "Kabasawa"
				},
				{
					"id": 120230608,
					"content": "#Ondan bir şeyler öğrenebiliriz gibi. Hadi bir bakalım {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
