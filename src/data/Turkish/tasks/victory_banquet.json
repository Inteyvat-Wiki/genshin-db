			},
			"dialogs": [
				{
					"id": 120230501,
					"content": "Watatsumi Adası sonunda huzura kavuştu ve hepsi Ekselansları Sangonomiya sayesinde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230502
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230502,
					"content": "Ne var ne yok? Rapor edeceğiniz bir şey var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230503
					]
				},
				{
					"id": 120230503,
					"content": "Şu sıralar mı? Hımm, bir düşüneyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230504
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230504,
					"content": "Şu sıralar tekrardan okyanusta balık tutabilmek bizim için en büyük olay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230505
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230505,
					"content": "Çatışmalar sırasında denizin açıklarında hep savaş gemileri oluyordu. Bizler de kıyıdaki küçük balıklar ve karideslerle idare etmek zorunda kalıyorduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230506
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230506,
					"content": "Bazen de elimiz boş dönüyorduk ve hepimiz aç kalıyorduk. Zavallı çocuklar sürekli ağlıyordu ama elimizden bir şey gelmiyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230507
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230507,
					"content": "Açlıktan bütün gece bir o yana bir bu yana dönüyorduk. Sabaha kadar sabretmemiz gerekiyordu. En azından şimdi işler yoluna giriyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230508
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230508,
					"content": "Yanılmıyorsam siz Kılıç Balığı II'de Yüzbaşısınız, değil mi? Hizmetleriniz için teşekkürler. Buyurun, bir balık benden olsun! Daha yeni tuttuk bunları. Taptaze anlayacağınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230509
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230509,
					"content": "Ah, hayır, hayır lütfen, kabul edemeyiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230510,
					"content": "Lafı bile olmaz. Hem siz olmasaydınız muhtemelen hâlâ aç yatıyor olurduk. Ekselansları bize her zaman yapılan iyiliği karşılıksız bırakmamamızı öğretir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230511
					],
					"speakerTitle": "Hirai"
				},
				{
					"id": 120230511,
					"content": "#Peki o halde. Teşekkürler. Hadi {NICKNAME} başkalarıyla da konuşalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
