					"Sangonomiya Kokomi",
					"Denjirou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230101,
					"content": "Ziyafet için her şey yerli yerinde gibi ama başlamadan önce kısa bir konuşma yapmam gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230102
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230102,
					"content": "Acaba ne kadar enerjiye ihtiyacın var bunun için? Şu anki enerjin yeterli olacak mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230103,
					"content": "Yeter de artar bile. Sizin sayenizde normalden daha hızlı toparladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230104
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230104,
					"content": "Harika! Arkandayız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230105,
					"content": "Hepiniz hoş geldiniz. Bugün hep beraber kazandığımız zaferi kutluyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230106
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230106,
					"content": "Şogun Ordusuyla yaptığımız savaş kısa süre önce sona erdi ve sonunda Önsezi Avı Fermanı yürürlükten kalktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230107
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230107,
					"content": "Inazuma'nın gelecekte nelerle karşılaşacağını bilemeyiz. Ancak yarın barış görüşmeleri için Tenryou Heyetiyle buluşacağım. Size söz veriyorum, Watatsumi Adası'nın barış ve huzur içinde varlığını sürdürmesi için elimden gelen her şeyi yapacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230108
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230108,
					"content": "Bugüne kadar tüm cesaretinizle gösterdiğiniz çaba için hepinize minnettarım. Gerçek şudur ki, sizin çabalarınız olmasaydı bu zorlu savaşta galip gelmemiz mümkün olmazdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230109
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230109,
					"content": "Bu ziyafet, burada toplanan herkesin onuruna düzenleniyor. Umarım biraz rahatlayıp zorluklarla kazandığımız zaferin tadını çıkartırsınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230110
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230110,
					"content": "Yaşasın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230111
					],
					"speakerTitle": "Denjirou"
				},
				{
					"id": 120230111,
					"content": "Geceyi bir sorun yaşamadan atlattık gibi. Her şey yolunda gittiği için çok mutluyum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230112
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230112,
					"content": "#İnsanlar moralleri yüksek olunca konuşmaya daha meyilli olurlar. {NICKNAME}, rica etsem onlarla konuşup biraz bilgi toplayabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230113
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230113,
					"content": "Tenryou Heyeti ve Fatui arasındaki olası bir gizli anlaşmaya dair hâlâ elimde ipucu yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230114
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230114,
					"content": "O yüzden yarınki barış görüşmelerinde bir şeylerin ters gitmesinden endişeliyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230115
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230115,
					"content": "Tabii ki. İnsanlarla konuşuruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
