			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120230401,
					"content": "Yeni bilgiler edindik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230402,
					"content": "Tenryou Heyeti ve Fatui arasındaki gizli iş birliği tamamen bir yalanmış! Hepsini uydurmuşlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230403,
					"content": "Barış görüşmelerinin durmasını ve savaşın devam etmesini istiyorlarmış. Ne yaparsak yapalım artık bunu engellemek için çok geçmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230404,
					"content": "Hımm. Anlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230405,
						120230406
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230405,
					"content": "Ne düşünüyorsun Kokomi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230407
					]
				},
				{
					"id": 120230407,
					"content": "İyiyim. Endişelenmeyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230408
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230408,
					"content": "Benim hatam. Bu konu hakkındaki hislerini daha önceden anlayabilseydim olaylar bu kadar büyümezdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230409
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230409,
					"content": "Kouzen'in artık çok geç demesinin sebebini anladım sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230410
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230410,
					"content": "Görüşmeler yarından önce başlamayacak fakat her iki taraf da muhafızlarını güvenliği sağlamak için buluşma noktasına gönderdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230411
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230411,
					"content": "Kouzen'in savaş yanlısı iş birlikçilerinden biri yarınki görüşmeler sırasında olay çıkartmak için muhafızların arasına sızmayı planlıyor olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230412
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230412,
					"content": "Bu hiç iyi olmadı. Oraya gidip muhafızları değiştirmemizi ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230413,
					"content": "İşe yaramaz. Zaten tarafsız görüşmelere yeni bir muhafız grubu götürmek iki tarafı da oldukça tedirgin eder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230414
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230414,
					"content": "Böyle bir şey yaparsak savaş yanlısı grubu harekete geçirmiş oluruz. Tenryou Heyetinin muhafızlarına saldırmaları bizi yeni bir savaşın eşiğine getirir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230415
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230415,
					"content": "Watatsumi Adası'ndan kaç tane asker olaya dahil oldu bilmiyoruz zaten. Aceleyle muhafızları değiştirirsek kime güveneceğimizi şaşırırız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230416
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230416,
					"content": "Oldukça çetrefilli bir durum... Yani yapabileceğimiz hiçbir şey yok mu diyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230417,
					"content": "Canınızı sıkmayın artık, olan oldu. Hımm... Şu anda bir karşı plan yapmak bana düşüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230418
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230418,
					"content": "Bu askerler sınırı aştı fakat bütün suç onların değil. Ne olursa olsun bir yol bulmalı ve onlara zarar gelmediğinden emin olmalıyım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230419
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230419,
					"content": "Yarın tekrar burada buluşalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120230406,
					"content": "İyi misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230407
					]
				}
			]
		},
