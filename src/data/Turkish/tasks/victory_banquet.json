				"points": []
			},
			"dialogs": [
				{
					"id": 120230301,
					"content": "Kuvvetli bir savaşçıymışsın... Ekselanslarının seni neden seçtiği belli oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230302
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230302,
					"content": "Sende gerçekten de bir savaşçı iradesi varmış... O halde belki bizi anlayabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230303
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230303,
					"content": "Yüzbaşı, yoldaş... Bize katılacak mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230304
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230304,
					"content": "Önce bana neler döndüğünü anlatman lazım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230305
					]
				},
				{
					"id": 120230305,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230306
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230306,
					"content": "Tenryou Heyeti ve Fatui hakkındaki söylentiler... Onları biz uydurduk. Ortada öyle bir şey yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230307
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230307,
					"content": "NE? Zavallı Kokomi ne kadar endişelendi senin haberin var mı? Her şey sizin başınızın altından mı çıktı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230308,
					"content": "Aklınızı mı kaybettiniz siz? Tenryou Heyetiyle tekrar savaşa girebileceğinizi hiç düşünmediniz mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230309,
					"content": "Aksine. Tam olarak da bunu istiyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230310
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230310,
					"content": "Barış görüşmeleriymiş! Hıh... Herkes kendini bu fikre kaptırmış. Watatsumi Adası'nın geleceği bu yüzden tehlikede.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230311
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230311,
					"content": "Tenryou Heyetinin bizi sırtımızdan bıçaklamayacağı ne malum? Şogun Raiden'ın yeni bir Önsezi Avı Fermanı çıkarmasına ne engel olacak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230312
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230312,
					"content": "Biz direnişiz! Her şey içimizdeki savaşçı iradesine bağlı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230313
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230313,
					"content": "Tenryou Heyetine veya Şogun Raiden'a güvenemeyiz ama kendimize olan inancımız tam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230314
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230314,
					"content": "Bu konuda hemfikir olduğumuzu düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230315
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230315,
					"content": "Haklı olduğu noktalar yok değil ama Paimon yanlış bir şeyler olduğunu hissediyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230316,
					"content": "Uzun lafın kısası... Siz sadece savaşmak istiyorsunuz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120230317
					]
				},
				{
					"id": 120230317,
					"content": "Evet! Söylediğin her şey sadece varsayımdan ibaret, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230318,
					"content": "Gerçekten de böylesine bir söylenti uydurup herkesin canını dişine takarak kazandığı barışı mahvetmek mi istiyorsunuz? Hem de sadece hayal ürünü olabilecek nedenlerden ötürü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230319,
					"content": "Bana üstünlük taslamayı bırak! Sen ne anlarsın ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230320
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230320,
					"content": "Zafer uğruna her zerremizle savaşçının iradesini özümsedik. Anlıyor musun? Varımızı yoğumuzu ortaya koyduk. Şimdiyse bize bunların artık önemi olmadığını söylüyorlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230321
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230321,
					"content": "Bana silahımı bırakıp sıradan bir insan gibi hayatıma devam etmemi söylüyorsunuz. Söylemesi kolay tabii. Ben... Ben hâlâ her gözümü kapattığımda savaşta kaybettiğim dostlarımın yüzlerini görüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230322
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230322,
					"content": "Her gözümü kapattığımda zihnimde beliriyorlar. Bu yüzden ne Tenryou Heyetini ne de Önsezi Avı Fermanını affedebilirim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230323
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230323,
					"content": "Görünen o ki bizden biri değilmişsin... Her neyse, isterseniz gidip Sangonomiya'ya haber verin ama artık bizi durdurmak için çok geç...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230324
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230324,
					"content": "Çok mu geç? Ne demek istiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230325,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230326
					],
					"speakerTitle": "Kouzen"
				},
				{
					"id": 120230326,
					"content": "Kahretsin! Cevap vermeyecek tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120230327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120230327,
					"content": "#Şimdi ne yapacağız {NICKNAME}? Bu iş şakaya gelmez! Kokomi'ye hemen her şeyi anlatmalıyız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1202304,
			"completionStepIds": [
				1202306,
				1202307
