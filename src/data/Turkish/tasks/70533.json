			"dialogs": [
				{
					"id": 705330101,
					"content": "Ne kadar şaşırtıcı. İcadımın bu şekilde kullanılacağını düşünmezdim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330102
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330102,
					"content": "Ah, Gezgin! Demek yeniden karşılaştık... *öksürür*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330103,
						705330105
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330103,
					"content": "Mondstadt'tan ayrıldığını sanıyordum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705330104
					]
				},
				{
					"id": 705330104,
					"content": "Planım buydu, evet... Ama işler değişti işte, bilirsin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330108
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330108,
					"content": "*öksürür* Neyse, konumuza dönelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330109
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330109,
					"content": "Bu sefer Mondstadt Maceracılar Loncası tarafından davet edildim. Birleştirilip parçalanabilen kart tasarımları yaratmamı istiyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330110
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330110,
					"content": "Şu kart oyunu, neydi adı... Ah evet, Dehanın Yakarışı Kart Oyunu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330111
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330111,
					"content": "Tablolar, Yakarışların Kralı Turnuvasına heyecan katmak için bir çeşit mini oyun olarak kullanılacakmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330112
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330112,
					"content": "*iç çeker* Bu işler benim için fazla karmaşık. Aslında sadece icatlarıma odaklanmalıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330113
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330113,
					"content": "Ah Evet, Mondstadt'taki mekanik tablolar yanımda. Eğer onlara göz atmak istersen hiç çekinme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330105,
					"content": "İcadınla ilgili bir sorun mu var yine?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705330106
					]
				},
				{
					"id": 705330106,
					"content": "Yo, hayır! Bu sefer sorun bu değil... Bir sorun da yoktu aslında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330107
					],
					"speakerTitle": "Félix Yogue"
				},
				{
					"id": 705330107,
					"content": "Geçen sefer yardımını istediğimde sorunum canavarlarla ilgiliydi, icadımla değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705330108
					],
					"speakerTitle": "Félix Yogue"
				}
			]
