			},
			"dialogs": [
				{
					"id": 223008001,
					"content": "Tanrım, ne kadar süredir konuşuyorum? Zaman su gibi akıp gitmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008002
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008002,
					"content": "Umarım bu konuşmanın ardından Toprağın Efendisi hakkında daha fazla bilgi edinmişsindir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008003
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008003,
					"content": "En azından üzerine düşünecek kadar şey öğrendim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223008004
					]
				},
				{
					"id": 223008004,
					"content": "Tabii bu, Toprak Hükümdarı hakkındaki bilginin yalnızca ufak bir kısmı. Daha fazlasını dinlemek için tekrar yanıma uğra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008005
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008005,
					"content": "Vay be, not bile almışsın... Anlattığım öyküleri cidden beğendin demek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008006
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008006,
					"content": "Sen o notları bana bırak, ben de boş vaktim oldukça senin için daha fazla hikaye yazayım olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008007
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008007,
					"content": "Notların tümü bir araya geldiğinde de güzel bir koleksiyonun olmuş olur. Derlemeyi tamamladığımda, sana hediye etmekten memnuniyet duyarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008008
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008008,
					"content": "Ama Rex Lapis ile ilgili anlatılacak bunca hikayenin üzerinden geçmek biraz zaman alacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008009
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223008009,
					"content": "Al bakalım, bunlar sana. Harika bir dinleyici olduğun için teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		}
