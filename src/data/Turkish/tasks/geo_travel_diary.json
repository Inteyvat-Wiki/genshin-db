			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Musheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223001301,
					"content": "Demek yemek seven birisin! Liyue Limanı yiyecek konusunda kesinlikle çok iyidir. Yerel tatları denemekte fayda var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001302
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001302,
					"content": "Bunun Toprağın Efendisi'yle alakası ne mi? Sandığından çok daha alakalı! Liyue Limanı'ndaki restoranların çoğunda asılı bayrakları görmüşsündür. O bayraklar restoranların köklü geçmişini belirtmek için asılıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001303
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001303,
					"content": "Sahibine gidip restoranın ne zamandan beri açık olduğunu sorarsan, sana hemen Toprağın Efendisi'nin restoranı ne zaman, nasıl ziyaret ettiğini, ne sipariş ettiğini ve yiyecekleriyle ilgili neler söylediğini anlatır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001304
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001304,
					"content": "Bu hikayelerin gerçek olup olmaması bir yana, herkes Toprağın Efendisi'nin çok ama çok uzun süredir Liyue Limanı'nda olduğu konusunda hemfikir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001305
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001305,
					"content": "Liyue'deki bazı tarihçiler, Toprağın Efendisi'nin yaşayan en yaşlı insan olduğunu iddia ediyor ve ona Tarih Tanrısı olarak tapıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001306
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001306,
					"content": "Ama tam olarak ne kadar süredir dünyada yaşadığıyla ilgili, kimsenin tam olarak bilgi sahibi olduğunu sanmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		},
