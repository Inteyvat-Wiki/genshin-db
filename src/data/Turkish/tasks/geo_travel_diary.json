			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Musheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223000101,
					"content": "... Tek isteğim bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000102
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000102,
					"content": "Ne yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223000103
					]
				},
				{
					"id": 223000103,
					"content": "Toprağın Efendisi'ne dua ediyorum. Sanırım buralı değilsin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000104
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000104,
					"content": "Burası Yiyan Tapınağı. Liyue Limanı'ndan insanlar buraya Toprağın Efendisi'ne tütsü yakmak ve iyi şans için dua etmeye gelir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000105
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000105,
					"content": "Çok uzaklarda yaşadığım için her zaman buraya gelip tütsü yakma imkanım olmuyor. O yüzden her gelişimde bunu telafi etmek için daha fazla zaman ayırıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000106
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000106,
					"content": "Toprağın Efendisi'yle ilgili çok fazla antik yazı okudum ve okudukça azameti karşısında daha da hayrete düşüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000107
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000107,
					"content": "Onun Liyue Limanı için yaptıklarını düşününce, tütsü yakmak için geldiğim fazladan yol onun için ödediğim ufak bir bedel olarak kalıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000108
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000108,
					"content": "Muhtemelen Toprağın Efendisi'yle ilgili pek bir şey bilmiyorsundur, değil mi? İstersen ben anlatabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000109
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000109,
					"content": "Tabii sadece benim anlattıklarımı dinlemek, bilginin kalıcı olmasını sağlamaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000110
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000110,
					"content": "Hımm... Bir fikrim var. <color=#00E1FFFF>Liyue Limanı yakınlarına</color> bakıp sahne dekoru olarak kullanabileceğim şeyler toplasana. Dekor da olursa, anlatımım daha gerçekçi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000111,
						223000113
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000111,
					"content": "Tamam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223000112
					]
				},
				{
					"id": 223000112,
					"content": "Harika. Fazla gecikme. Burada bekliyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000113,
					"content": "Ne gibi şeyler toplamalıyım?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223000114
					]
				},
				{
					"id": 223000114,
					"content": "<color=#00E1FFFF>Liyue Limanı</color> ya da <color=#00E1FFFF>Toprağın Efendisi</color> ile bağlantılı olduğunu düşündüğün ne varsa iş görür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000115
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000115,
					"content": "Ama şimdi düşününce, o kadar da fazla hikaye bilmiyorum... Ayrıca her şey anlatmaya değer değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000116
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223000116,
					"content": "Neyse, onu zamanı gelince düşünürüz. Şimdilik... Hadi dekor toplamaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		},
