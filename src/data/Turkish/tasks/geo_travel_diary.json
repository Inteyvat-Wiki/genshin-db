			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Musheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223001101,
					"content": "Bunu kırsal bir yerde bulmuş olmalısın. Almak için çok yol kat ettiğin belli. Aferin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001102
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001102,
					"content": "Gördüğün üzere Liyue Limanı geniş bir şehir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001103
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001103,
					"content": "Ama en büyük şehirlerin bile inşası tek bir tuğla ile başlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001104
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001104,
					"content": "İlk yerleşimciler buraya geldiğinde, bugün Liyue Limanı olarak bildiğimiz yerden eser yoktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001105
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001105,
					"content": "Bu cesur yerleşimciler, alın terleri ve emekleriyle toprağı parça parça işleyip sonunda bu büyük şehri inşa etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001106
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001106,
					"content": "Bildiğin üzere Liyue Limanı çevresindeki arazi kayalık ve dağlık. Bu nedenle burada toprak işlemek oldukça zor ama yine de bu inatçı bitkiler dağlara inat yetişmeye devam ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001107
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001107,
					"content": "Bu bitkilerin her biri, buranın ilk yerleşimcileri için oldukça faydalı özelliklere sahipti. Bu, Toprağın Efendisi'nin ilahi takdiriydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001108
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001108,
					"content": "Yerleşimcilerin başarı hikayeleri Liyue Limanı'nda hep anlatılır. Günümüzde bile Liyue'nin maceracıları, atalarının yaptıklarından ilham alır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001109
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001109,
					"content": "Kendilerini atalarının keşifçi ruhunun ve azminin mirasçıları olarak görüyorlar. Aynı şekilde Toprağın Efendisi'ne de \"Çığır Açan\" olarak tapıyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001110
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001110,
					"content": "Liyue'nin maceracıları, karşılaşacakları her zorluk karşısında dağ gibi durmak ister.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		},
