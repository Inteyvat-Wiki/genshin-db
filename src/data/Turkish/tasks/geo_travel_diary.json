				{
					"id": 223001201,
					"content": "İlginç... Bunu nereden buldun acaba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001202
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001202,
					"content": "Günümüzde bunun sadece Yujing Terası'nda bulunduğunu duymuştum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001203
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001203,
					"content": "Bu tam da Toprağın Efendisi'nden bahsederken kullanılacak bir dekor. Üzerine düşünülmüş bir seçim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001204
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001204,
					"content": "Bu Parlak Zambak, bugün Liyue Limanı'nı bu kadar uğrak kılan şey için hayati önem taşıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001205
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001205,
					"content": "Kafan mı karıştı? Bir düşünelim, Parlak Zambağı bu kadar özel kılan şey nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001206
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001206,
					"content": "O kesinlikle kıymetli bir çiçek. Parlak Zambak oldukça değerlidir, iyi bir fiyata satıp bolca Mora kazanabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001207
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001207,
					"content": "Moranın adı Toprağın Efendisi'nin isimlerinden biri olan Morax'tan gelmektedir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001208
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001208,
					"content": "Bu nedenle çoğu kişi için Toprağın Efendisi, Bolluk Tanrısıdır. Liyue'deki hemen her tüccar, ne kadar büyük ya da başarılı oldukları fark etmeksizin, iş yapmaya gitmeden önce Toprağın Efendisi'ne tütsü yakar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001209
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001209,
					"content": "Bunun sebebi de temelde Toprağın Efendisi'nin tüm dünyadaki en varlıklı kişi olmasıdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001210
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001210,
					"content": "Yedilerin arasında bile... En varlıklı Hükümdar odur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		},
		{
			"id": 2230013,
