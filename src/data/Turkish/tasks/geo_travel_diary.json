		},
		{
			"id": 2230010,
			"completionStepIds": [
				2230010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2230010",
							"2"
						],
						"stepId": 2230010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Musheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223001001,
					"content": "Hah, madenlerden çıkarılan cevher! Demek ki Toprak kelimesinin anlamıyla ilgili bir şeyler biliyormuşsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001002
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001002,
					"content": "Eskiden Liyue'de yaşayanlar, içindeki metali çıkarmak için cevherleri eritmeyi öğrenmişti. Ama bu, cevherin çok daha önemli ve farklı bir kullanımını keşfetmeden önceydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001003
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001003,
					"content": "İlk insanlar buraya gelip toprağı işlemeye başladığında, ocak yapmak için taşları üst üste dizdi ve ateş yakmak için taşları birbirine sürttü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001004
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001004,
					"content": "Ateş sayesinde yemek pişirmeye başladılar ve pişmiş yemek sayesinde de çalışacak güç kazandılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001005
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001005,
					"content": "Bunların tümü, Toprağın Efendisi'nin hediyesi topraktaki taşlardan geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001006
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001006,
					"content": "Toprağın Efendisi, o zamanlarda yazılan metinlerin çoğunda Ocak Tanrısı olarak geçmeye başladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001007
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001007,
					"content": "Yeni açılan restoranların ve meyhanelerin tümü Toprağın Efendisi'ne tütsü yakar ve ocaklarındaki ateşin sönmemesi için dua eder, böylece işletmelerinin bereketi eksik olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001008
					],
					"speakerTitle": "Musheng"
				},
				{
					"id": 223001008,
					"content": "Bir dahaki sefere Liyue Limanı'ndaki restoranlardan birini ziyarete gittiğinde, sen de Toprağın Efendisi'ne sessizce dua etmeyi unutma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Musheng"
				}
			]
		},
		{
			"id": 2230011,
			"completionStepIds": [
				2230011
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
