			"dialogs": [
				{
					"id": 721650101,
					"content": "Dönmüşsünüz. Sizin için yapabileceğim bir şey var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650102
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650102,
					"content": "Lütfen falıma bakar mısın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721650103
					]
				},
				{
					"id": 721650103,
					"content": "#Paimon da {NICKNAME} bugün ne kadar şanslı olacak öğrenmek istiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650104,
					"content": "Hımm... Ruhbitki yapraklarının desenine bakılırsa... Bahtın açık olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650105
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650105,
					"content": "Watatsumi Adası'ndaki en yüksek noktada, tanrılara adanmış yerde hazine bulacaksın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650106
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650106,
					"content": "Hımm... Paimon niye bunları göremiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650107,
					"content": "Hehe, yaşın getirdiği bilgelik diye buna deniyor işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650108
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650108,
					"content": "Paimon'u kandırmaya çalışıyormuş gibi konuşuyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
