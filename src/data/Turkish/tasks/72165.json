					"nextDialogs": [
						721650203
					]
				},
				{
					"id": 721650203,
					"content": "Hehe, bugün şansımız nasıl olacak bakalım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650204,
					"content": "Ruhbitkileri... Bugün şans senden yana değil diyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650205
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650205,
					"content": "Watatsumi Adası'nın güneyindeki bir mağarada beklemediğin bir anda alçak, kötü niyetli adamlarla karşılaşacaksın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650206
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650206,
					"content": "Ne, kötü şans mı? Öyle bir yere gitmesek daha iyi, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650207,
					"content": "Hehe. Ancak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650208
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650208,
					"content": "Kötü şansın hakkından gelirsen şans yüzüne gülebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650209
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650209,
					"content": "Şans mı? Hazine mi diyorsun? Hazine mi olacak yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650210,
					"content": "Öyle bir şey demedim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650211
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650211,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721650212,
					"content": "Ama öyle bir şey olmayacak da demedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650213
					],
					"speakerTitle": "Komaki"
				},
				{
					"id": 721650213,
					"content": "Ah be nine, niye hep böyle yapıyorsun?",
