			"dialogs": [
				{
					"id": 747000101,
					"content": "Hehe, Paimon bu akvaryumu doldururken çok eğleniyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000102,
					"content": "Madem Sandrone sorun etmiyor, birkaç balıkçık daha yakalayıp burayı iyice güzelleştirelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000103,
					"content": "Hey, siz ikiniz. Buraya gelin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000104
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747000104,
					"content": "Ha? Bir sorun mu var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000105,
					"content": "Alın, bu sizin için.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000106
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747000106,
					"content": "... Bu ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000107,
					"content": "Bu, üzerinde çalıştığım bir su altı hareket cihazı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000108
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747000108,
					"content": "Ha? Vay canına, çok naziksin Sandrone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000109,
					"content": "Alt tarafı basit bir mekanik cihaz. Balık yakalama şeklinizi gördüm de, nasıl desem... Biraz... İlkel kaçıyordu. Açık konuşmak gerekirse izlemesi tam bir işkenceydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000110
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747000110,
					"content": "G-Gerçekten o kadar kötü müydü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747000111,
					"content": "Verimsiz, acemice ve tamamen zarafetten yoksundu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000112
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747000112,
					"content": "Seni buna maruz bıraktığımız için... Özür dilerim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747000113
					]
				},
				{
					"id": 747000113,
					"content": "Özür dilemene gerek yok. Her yiğidin bir yoğurt yiyişi vardır. Ama madem akvaryumu doldurmaya niyetlisiniz, bu cihazı kullansanız daha iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000114
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747000114,
					"content": "Fontaine sularında sadece zararsız süs balıkları yüzmüyor. Size ciddi zarar verebilecek bir sürü yırtıcı da kol geziyor. Bu cihaz sadece balık tutmanıza değil, başınız sıkıştığında kaçmanıza da yardımcı olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000115,
						747000116
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747000115,
					"content": "Çok teşekkür ederiz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747000117
					]
				},
				{
					"id": 747000117,
					"content": "Pekala. Yüzmeye gidecekseniz gidin şimdi. Cihaz hakkında ne düşündüğünüzü bana söylemeyi de unutmayın. Bir geri bildiriminiz olursa gerekli ayarlamaları yaparım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747000116,
					"content": "Mutlaka kullanacağım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747000117
					]
				}
			]
		}
	]
}