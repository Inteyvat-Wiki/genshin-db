			"dialogs": [
				{
					"id": 220340203,
					"content": "Tabanları yağladılar bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340204
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340204,
					"content": "Muhtemelen bizi ihbar etmeye gittiler. Amacımıza ulaştık diyebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340205
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340205,
					"content": "Çabaların için teşekkür ederim Gezgin. Lütfen bunları kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340206
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340206,
					"content": "Sango'ya gidip rapor versem iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340207
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340207,
					"content": "Acaba şimdiye dek bir şeyler bulabilmiş midir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				}
			]
		},
