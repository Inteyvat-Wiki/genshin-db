			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220340101,
					"content": "Gezgin lütfen bekle. Sango yardımını istiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340102
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340102,
					"content": "Davada ilerleme kaydedebildiniz mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340103
					]
				},
				{
					"id": 220340103,
					"content": "Bilmiyorum ki. Bana sadece hâlâ yapması gereken hazırlıklar olduğunu söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340104
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340104,
					"content": "Ayrıca sana benimle şehrin dışında arama yapmaya gelir misin diye sormamı istedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340105,
						220340107
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340105,
					"content": "Bununla neyi başarmayı amaçlıyor ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340106
					]
				},
				{
					"id": 220340106,
					"content": "Açıkçası benim de hiçbir fikrim yok... Fakat davaları genelde Sango'nun sözünden çıkmadığımızda çözüyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340112
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340112,
					"content": "Neyse, artık iş konuşsak iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340113
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340113,
					"content": "Sango'ya göre, Amano ve Andou yaşanan olayı rapor ettiğinden beri şehirdeki devriyelerin sayısı artırıldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340114
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340114,
					"content": "İlginç olan, tüm bu önlemlere rağmen şehirdeki tüccarlar hâlâ hırsızlığa kurban gidiyor ve failler gözüne kestirdiği birkaç eşya dışında başka hiçbir şeyle ilgilenmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340115
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340115,
					"content": "Durum bu. Sango bu suçları işlemek için Hazine Avcılarının şehre gizlice girmiş olma ihtimalinin pek olmadığını düşünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340116
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340116,
					"content": "Suçlunun ya da suçluların amacı çok belli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340117
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340117,
					"content": "Muhtemelen bunca zamandır şehirde dışarıya bilgi sızdıran bir köstebek vardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340118
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340118,
					"content": "Bu, Doushinlerin boşa çalıştığı anlamına gelmiyor mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340119
					]
				},
				{
					"id": 220340119,
					"content": "Aslında tam istediğimiz gibi çalışıyorlar. Suçlumuz Doushinlerin onu aramadığının farkında olmalı. Bu durumda, aranmadığı için de suç işlemeye devam edecektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340120
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340120,
					"content": "Ne kadar çok suç işlerse kendini ele verme ihtimali de bir o kadar artacak, Sango'nun da suçlunun kimliğini ortaya çıkarması kolaylaşacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340121
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340121,
					"content": "Bu durumda hırsızın gardını indirmesini bekleyene kadar bir şey bilmiyormuş gibi davranmaya devam etmeliyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340122
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340122,
					"content": "Gezgin, tam olarak bu sebepten dolayı şehrin dışındaki Hazine Avcılarıyla ilgilenmeni istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340123
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340123,
					"content": "Bunun karşılığında sana ödeme de yapacağız ve... dava sonuçlandığında sana bir hediyemiz olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340124
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340124,
					"content": "Bunları söylemeni de Sango mu istedi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340125
					]
				},
				{
					"id": 220340125,
					"content": "Bunu nereden anladın? Sezgilerin güçlü olmalı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340126
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340126,
					"content": "Bunları söylememi gerçekten de Sango istemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340127
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340127,
					"content": "Sana karşı dürüst olduğuma inan lütfen. Hatta ücretini bile yanımda taşıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340128
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340128,
					"content": "Gezgin, lütfen bize yardım et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340129
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340129,
					"content": "Tam olarak ne yapmamı istiyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340130
					]
				},
				{
					"id": 220340130,
					"content": "Çok zor bir şey değil, sadece... Hazine Avcılarına dalaşmanı istiyoruz. Arbede ne kadar büyük olursa o kadar iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340131
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340131,
					"content": "Sango Hazine Avcılarının kamplarını harita üzerinde işaretledi bile. Ben de onları senin için haritana işaretledim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340132
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340132,
					"content": "Tamamdır, iş bittikten sonra burada buluşuruz. Artık işe koyulalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340107,
					"content": "O niye gelmiyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220340108
					]
				},
				{
					"id": 220340108,
					"content": "Bunu huy edinmiş artık. Kendisinin \"düşünmekte iyi, icraatta zayıf\" olduğunu söylüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340109
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340109,
					"content": "Geçenlerde bir yazar onunla röportaj yapmaya geldi. Hikayesini bir romana çevirmek istediğini söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340110
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340110,
					"content": "Hatta Sango için \"masabaşı dedektifi\" diyordu. Bu ismi çok sevmiş olacak ki o zamandan beri kendine bir masa almak istiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340111
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220340111,
					"content": "Bütçemiz kısıtlı olduğu için daha alamadık tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220340112
					],
					"speakerTitle": "Ryuuji"
				}
			]
		},
