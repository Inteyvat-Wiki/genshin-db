			"dialogs": [
				{
					"id": 30230401,
					"content": "Son birkaç gündür hayatımda giriştiğim en zorlu işlerden biriyle uğraşıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230402
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30230402,
					"content": "Ve hiçbiri bana tek bir Mora bile kazandırmayacak... Buna inanamıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230403
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30230403,
					"content": "İyi tarafından bak Dehya! Belki de tüm bunlar bittiğinde çoook büyük bir ödül kazanırız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30230404,
					"content": "Hımm, haklısın. Yarın sabah uyandığınızda harcayamayacağınız kadar çok Moranız olsaydı ne yapardınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230405
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30230405,
					"content": "Paimon tonlarca lezzetli atıştırmalık alırdı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30230406,
					"content": "Bu kadar mı yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230407
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30230407,
					"content": "Şey... Belki bir de lezzetli içecekler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30230408,
					"content": "Hahaha, ne kadar tatlısın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230409
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30230409,
					"content": "İşte, tüm bu güzel isteklerimiz için... Gerçekleşme şansları varsa elimden geleni yapacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230410
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 30230410,
					"content": "Ve umuyorum ki şu andan itibaren yaptığımız her şey bu dünyayı daha da iyileştirecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dehya"
				}
