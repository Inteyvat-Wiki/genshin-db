			},
			"dialogs": [
				{
					"id": 30230301,
					"content": "Yardım edebileceğim bir şey olursa bana kesin haber verin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230302
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 30230302,
					"content": "Aaru Köyü'nden ayrılamasam da... Gözlerinizdeki ışıltıyı görünce... Bilmiyorum nedendir kalbim güm güm atıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230303
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 30230303,
					"content": "Geçmişte tek başıma savaşırken bile hiç bu kadar heyecanlanmamıştım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230304
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 30230304,
					"content": "Yoldaşlığın gücü bu olsa gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Candace"
				}
			]
		},
