				"points": []
			},
			"dialogs": [
				{
					"id": 30230201,
					"content": "Acele etme. Bu büyük bir mesele, karşımıza çıkacak şeylerle ilgili yapacağımız plan ve hazırlıklar biraz vakit alacak. Buna hiç şüphe yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230202
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30230202,
					"content": "Ağırdan al. Bu planı olabildiğince etkili hale getirmeliyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230203
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30230203,
					"content": "Yine kitabını okumaya başladı! Bizi dinliyor musun sen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30230204,
					"content": "Sana da okuman için bir şeyler vereyim mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230205
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30230205,
					"content": "Hayır! Senin kitapların Paimon'un seveceği türden değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30230206,
					"content": "Şaka yapıyordum. Benim kitaplarım sana ağır gelir, ayrıca onları ödünç vermek gibi bir niyetim de yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230207
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 30230207,
					"content": "Of! Çok sinir bozucusun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
