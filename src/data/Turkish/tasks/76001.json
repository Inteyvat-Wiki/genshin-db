			},
			"dialogs": [
				{
					"id": 760010101,
					"content": "Bir saniye lütfen! Paimon size bir şey sormak istiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760010102,
					"content": "Daha önce elde ettiğiniz eşyaları iki Işık Muhafızına sunuyorsun. Ayrıca onlara Işık Muhafızı kıyafeti giymiş tuhaf birinin Vahşi Avı püskürtmek için yanında savaştığını anlatıyorsun...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760010103
					]
				},
				{
					"id": 760010103,
					"content": "... Sigurd olabilir mi? Şimdi bile huzur içinde yatamıyor. Keşke...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010104
					],
					"speakerTitle": "Lushne"
				},
				{
					"id": 760010104,
					"content": "Böyle düşünme Lushne, bunu tek başına üstlenmene gerek yok. Vahşi Av var olduğu sürece Sigurd savaşmaya devam edecek. Bizim tek yapabileceğimiz, görevimizi olabildiğince iyi yerine getirmek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010105
					],
					"speakerTitle": "Sukhovykh"
				},
				{
					"id": 760010105,
					"content": "Ah... Şu Sigurd... Eskiden Işık Muhafızı mıydı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760010106,
					"content": "Evet. Muhteşem bir Starşina'ydı. Vahşi Av Nod-Krai'ı işgal ettiğinde son nefesine kadar savaştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010107
					],
					"speakerTitle": "Sukhovykh"
				},
				{
					"id": 760010107,
					"content": "Uyarı çanları çaldığında akılsız canavarlar bile irkilirmiş. Öyle ki duyan kimse ilerlemeye cesaret edemezmiş... Buna rağmen yadigarlarını bulabilmeniz ne kadar ilginç...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010108
					],
					"speakerTitle": "Sukhovykh"
				},
				{
					"id": 760010108,
					"content": "Mümkünse lütfen yadigarları mezarına götürün. Yeri Lempo Adası'nda, doğudaki savaş alanı harabelerinin yakınında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760010109
					],
					"speakerTitle": "Sukhovykh"
				},
				{
					"id": 760010109,
					"content": "Tamamdır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760010110
					]
				},
				{
					"id": 760010110,
					"content": "Teşekkürler. Umarım yakında ruhu huzura erebilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sukhovykh"
				}
			]
		},
