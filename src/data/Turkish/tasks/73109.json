			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Javi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731090301,
					"content": "Olamaz. Bu benim Hayal Kutum değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090302,
						731090304
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090302,
					"content": "Bir kutu bulduk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090303
					]
				},
				{
					"id": 731090303,
					"content": "Haha... Ben de bir tane buldum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090305
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090305,
					"content": "Açtım ve üstünde Ami'nin adının yazılı olduğu bir kağıt parçası buldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090306
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090306,
					"content": "O çocuğu hatırlıyorum, Jahangir'in kızıydı ve hep yiyecek dükkanının oralardaydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090307
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090307,
					"content": "Demek çiçekçi olmayı hayal ediyormuş, çiçekleri ne kadar çok seviyorsa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090308
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090308,
					"content": "Bunu beklemiyordum. Jahangir'in dükkanını kızına devredeceğini düşünürdüm hep.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090309,
						731090310
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090309,
					"content": "İlk önce senin hayalini görelim bakalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090311
					]
				},
				{
					"id": 731090311,
					"content": "Ah! Neredeyse unutuyordum, kendi hayalime ilk olarak ben bakmalıyım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090312
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090312,
					"content": "Bir bakayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090313
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090313,
					"content": "\"Sonsuza dek ormanda yaşayan bir Vanara olurum umarım...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090314
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090314,
					"content": "Çocukluk hayalim bu muymuş? Aman tanrım, bunu istediğime inanamıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090315
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090315,
					"content": "Hadi ama... Evlat, Vanara olmak cebini doldurmaz ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090316,
						731090317
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090316,
					"content": "Bunda herhangi bir kötülük göremiyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090318
					]
				},
				{
					"id": 731090318,
					"content": "Alt tarafı çocukça fikirler. Benim yaşımda birisi içinse hayaller...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090319
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090319,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090320
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090320,
					"content": "Daha çok nasıl Mora kazanılır onu düşünmek gerek, insana huzur veren budur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090321
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090321,
					"content": "Benim sıkıcı hayalimi boş verelim, Ami'yi konuşalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090322
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090322,
					"content": "Rızası olmadan \"Hayal Kutusu\"nu açtığım için mutlaka bunu telafi edecek bir şeyler yapmalıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090323
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090323,
					"content": "Bir düşüneyim... Çiçekçi olmak için öncelikle çiçek yetiştirmeyi öğrenmek gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090324
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090324,
					"content": "Ona verebileceğim boş bir saksım var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090325
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090325,
					"content": "Gezgin, çiçek tohumu bulabileceğim bir yer biliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090326,
						731090327
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090326,
					"content": "Bana bırak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090332
					]
				},
				{
					"id": 731090332,
					"content": "Tohumlar konusunda sana güveniyorum Gezgin. Jahangir'in dükkanının orada görüşürüz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090327,
					"content": "Bunu neden yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090328
					]
				},
				{
					"id": 731090328,
					"content": "Hahaha... Spontane yaşıyorum diyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090329
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090329,
					"content": "Yaşım epey ilerledi ve ben hayalimi asla gerçekleştiremeyeceğim... Zaten artık benim için önemi de yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090330
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090330,
					"content": "Ancak Ami hâlâ genç. Hayalini gerçekleştirmeyi deneyebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090331
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090331,
					"content": "Sıkıcı bir yetiştin olarak elimden gelen tek şey ona bir saksı hediye etmek. Umarım bu, ona olan desteğimi gösterir ve onu teşvik eder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090332
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090317,
					"content": "Hayaller kötü ya da iyi değildir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090318
					]
				},
				{
					"id": 731090310,
					"content": "\"Hayal Kutun\" burada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090311
					]
				},
				{
					"id": 731090304,
					"content": "Sen de mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090305
					]
				}
			]
		},
		{
			"id": 7310905,
			"completionStepIds": [
				7310905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310905",
							"2"
						],
						"stepId": 7310905,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ami",
					"Javi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731090501,
					"content": "Bu benim için mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090502
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090502,
					"content": "Ne kutu ne de kağıt konusunda ciddi değildim! O yüzden sorun değil, özür dilemene gerek yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090503
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090503,
					"content": "Endişelenme, bu saksıya ihtiyacım yoktu zaten. Lütfen bunu kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090504
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090504,
					"content": "Birisinden tohum bulmasını rica ettim. Her an burada olabilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090505,
						731090506
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090505,
					"content": "Tohumlar geliyor!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090507
					]
				},
				{
					"id": 731090507,
					"content": "Ne? Ne zaman geldin? Fark etmedim bile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090508
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090508,
					"content": "Öhöm... Ami, çiçekçi olmak istiyordun, değil mi? Bunları ekerek başlayabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090509
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090509,
					"content": "Teşekkürler... Ama bunu babamın dükkanının yakınında yaparsam saksı böceklenebilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090510
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090510,
					"content": "Saksıdaki böcekler ve yiyeceklerinde böcek bulan yetişkinler için oldukça kötü olurdu bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090511
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090511,
					"content": "Çiçekleri biraz uzağa taşırsam onlara bakmayı unutabilirim. Bu da kötü olur çünkü kuruyan çiçekler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090512
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090512,
					"content": "Ayrıca babam hep meşguldür ve uzaklaşmama asla izin vermez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090513
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090513,
					"content": "Şey... Sen de istersen çiçeklere birlikte bakabiliriz. Ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090514
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090514,
					"content": "Sadece işten sonra ziyaret edebilecek olsam da biraz boş vaktim var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090515
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090515,
					"content": "Harika! Ama babam izin vermeyebilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090516
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090516,
					"content": "Bay Jahangir ve ben arkadaşız. Birlikte konuşursak kabul edecektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090517
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090517,
					"content": "Harika! Ben... Daha fazla çiçek isterim o zaman! Sumeru Gülü en sevdiğimdir! Günün birinde... Babamın dükkanını Sumeru Gülleri ile çevreleyeceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090518
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090518,
					"content": "Güzel, bu harika bir hayal küçük kız. Bunun için elimizden geleni yapalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090519,
						731090520
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090519,
					"content": "Bana da bir tane ayır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090521
					]
				},
				{
					"id": 731090521,
					"content": "Teşekkürler! Bir düşüneyim... Tatlı Çiçek de istiyorum ve bir de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090522
					],
					"speakerTitle": "Ami"
				},
				{
					"id": 731090522,
					"content": "Çocuk gerçekten de çiçekleri seviyormuş. Umarım hayalinin peşinden gider...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090523
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090523,
					"content": "Haha... Umarım benim gibi bir yetişkin olmaz; sıradan ve sıkıcı biri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090524
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090524,
					"content": "Öhöm... Yardımın için teşekkürler Gezgin. Lütfen uğraşlarının karşılığı olarak bunu kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090525,
						731090526
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090525,
					"content": "Yüreğinin sesini dinleyerek yaşamak sıradanlık değildir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090527
					]
				},
				{
					"id": 731090527,
					"content": "Teşekkürler. Şikayetçi değildim aslında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090528
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090528,
					"content": "Sadece... Kutuya koyduğum hayali gördükten sonra bazı düşüncelere daldım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090529
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090529,
					"content": "Pekala, artık gitsem iyi olacak. Bugünkü yardımın için teşekkür ederim Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090530
					],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090530,
					"content": "Belki de... Başka bir \"hayal\" yazıp tekrar oraya gömmeliyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Javi"
				},
				{
					"id": 731090526,
					"content": "Yüreğinin sesini dinleyerek yaşamak asla sıkıcı değildir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090527
					]
				},
				{
					"id": 731090520,
					"content": "Yapabilirsin!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090521
					]
				},
				{
					"id": 731090506,
					"content": "Buyur, çiçek tohumları.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090507
					]
				}
			]
		},
