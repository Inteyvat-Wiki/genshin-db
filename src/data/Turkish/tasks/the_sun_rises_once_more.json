			"dialogs": [
				{
					"id": 766550101,
					"content": "Flins! Geldin demek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766550102,
					"content": "Tabii ki. İkinize de teşekkür borcum var sonuçta. Bu deniz feneri siz ilgilendiğinizden beri pek güzel duruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550103
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550103,
					"content": "Hehe, rica ederiz! Gerçi çalışan bir deniz feneri olmasına rağmen burası hâlâ çok karanlık. Işığın ulaşamadığı yerler var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766550104,
					"content": "Doğru. Mezarlıktayken zaman, o geceki savaştan sonra akmayı durdurmuş gibiydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550105
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550105,
					"content": "Bunu değiştirme niyetim yoktu aslında fakat deniz fenerini yakarak zamanın tekrar akmasını sağladınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550106,
						766550108
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550106,
					"content": "Yaşantını etkileyecek mi bu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766550107
					]
				},
				{
					"id": 766550107,
					"content": "Bana zorluk çıkaracak mı diye soruyorsan cevabım hayır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550110
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550110,
					"content": "Hayat döngülerden ibarettir. Biz olmasak bile buradaki hayaletler yavaşça dağılacak ve Ley Hatlarına geri dönecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550111
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550111,
					"content": "Dolayısıyla bu deniz fenerinin adadaki her bir köşeyi aydınlatmamasına takılmayın. Hayaletler kayboldukça bölgeyi kaplayan sis de dağılacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550112
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550112,
					"content": "Elbet bir gün güneş doğar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				},
				{
					"id": 766550108,
					"content": "Kusura bakma, isteyerek olmadı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766550109
					]
				},
				{
					"id": 766550109,
					"content": "Özür dileme lütfen, bu değişikliğe karşı değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766550110
					],
					"speakerTitle": "Flins"
				}
