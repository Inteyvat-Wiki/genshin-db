							-778.945
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705490301,
					"content": "Pekala, bu yeni içeceğin adı... \"Aylak Yıldırım\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490302
					]
				},
				{
					"id": 705490302,
					"content": "Sadece Düello Şampiyonlarına özel bir kokteyl. Afiyet olsun!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490303
					]
				},
				{
					"id": 705490303,
					"content": "Hım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490304
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490304,
					"content": "Hımm? Mm... Meyve şarabı mı ekledin? Tadı harika... Tam bana göre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490305
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490305,
					"content": "Meyvenin mayhoşluğu ve karamelin tatlılığıyla müthiş uyum sağlamış hafif bir tuzluluk var. Her yudumda kusursuzluğun ince çizgisi hissediliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490306
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490306,
					"content": "Şarabın rengi de ismiyle gayet uyumlu, yıldırım görselleri ise Karamel Alevinin o yanıcı doğasıyla tezat oluşturuyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490307
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490307,
					"content": "Peki \"aylak\" kısmı nereden geliyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490308,
						705490309
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490308,
					"content": "Sence de Mondstadt tam aylaklık edilecek bir yer değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490310
					]
				},
				{
					"id": 705490310,
					"content": "Anlıyorum... Bu kokteylin bende bıraktığı izlenimle örtüşüyor kesinlikle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490311
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490311,
					"content": "Eşsiz aroması ve tadı, Mondstadt'taki anılarımda özel bir yere sahip olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490312,
						705490313
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490312,
					"content": "Beğenmene sevindim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490314
					]
				},
				{
					"id": 705490314,
					"content": "Bir fırsat çıksaydı başka bir yerde içki hazırlamak ilgini çeker miydi? Mesela bir kafede ya da Debord Otel'de?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490315
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490315,
					"content": "Hı? Neden sordun ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490316
					]
				},
				{
					"id": 705490316,
					"content": "Navia ve Bayan Furina için aslında... Ama tabii senin diğer spesiyallerini denemekten ben de büyük mutluluk duyarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490317,
						705490318
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490317,
					"content": "Elbette! Herkesin tariflerimi tatmasını çok isterim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490319
					]
				},
				{
					"id": 705490319,
					"content": "Anlıyorum, seni zorlamayacağım... Neyse, konukseverliğine gerçekten minnettar kaldım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490320
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490320,
					"content": "Sayende, Keşif Bölüğünün güçlü Yüzbaşısıyla karşılaştığımda veya Favonius Şövalyeleri ile strateji tartıştığımda formumun zirvesinde olacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490321
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490321,
					"content": "Sayende, Bayan Eula ile yaptığım düellodan edindiğim önemli çıkarımları özetlerken veya Favonius Şövalyeleri ile strateji tartışırken formumun zirvesinde olacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clorinde"
				},
				{
