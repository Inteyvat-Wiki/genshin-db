			"dialogs": [
				{
					"id": 705490101,
					"content": "Şüphelerim doğru çıktı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490102
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490102,
					"content": "Bölgede devriye gezerken tanıdık birini hissettiğimden emindim, bu yüzden bakmaya geldim ve beklediğim üzere karşıma sen çıktın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490103,
						705490104
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490103,
					"content": "Merhaba Clorinde!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490105
					]
				},
				{
					"id": 705490105,
					"content": "Bayan Charlotte seni bu halde görseydi yüz tane fotoğrafını çeker ve bir de haberini yazardı herhalde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490106
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490106,
					"content": "#\"Kılıç Ustası {NICKNAME} Ek İş Peşinde: Teyvat'ın Sıra Dışı Kaşifinden Özel Kokteyller\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490107
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490107,
					"content": "Tüm büyük gazetelerin manşetlerine çıkardın, içecek standına akın eden Fontaineli turistler de Mondstadt sokaklarını felç ederdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490108,
						705490109
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490108,
					"content": "Bence biraz abartı oldu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490110
					]
				},
				{
					"id": 705490110,
					"content": "Şansına Bayan Charlotte'un bana eşlik etme isteğini geri çevirdim, bu yüzden öyle şeyler yaşaman pek olası değil. Gel bu huzur anını sessizce kutlayalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490111
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490111,
					"content": "Hımm, bu arada bir bardak Karamel Alevi istiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490112
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490112,
					"content": "... Bir sürü soru sormak istiyormuşsun gibi bir hal var yüzünde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490113,
						705490114
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490113,
					"content": "Önce sana bir kokteyl hazırlayayım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490115
					]
				},
				{
					"id": 705490115,
					"content": "Gayet sakin ve rahatsın... Bu işin piriymişsin de haberimiz yokmuş, şu an hayretler içerisindeyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490114,
					"content": "Sohbet ederken içersin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490115
					]
				},
				{
					"id": 705490109,
					"content": "Öyle bir şey yaşansa başa çıkamazdım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490110
					]
				},
				{
					"id": 705490104,
					"content": "Lütfen oturun sayın müşterimiz!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490105
					]
				}
			]
		},
