					}
				]
			},
			"dialogs": [
				{
					"id": 705490201,
					"content": "Karamel Alevin hazır. Hepsini tek dikişte bitirme ama...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490202
					]
				},
				{
					"id": 705490202,
					"content": "Adının hakkını veriyor doğrusu. Rengi alev alev yanan bir ateşi andırıyor, kokusuysa... Resmen insanı çarpıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490203
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490203,
					"content": "Öhöm... Bayağı sertmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490204,
						705490205
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490204,
					"content": "İyi misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490206
					]
				},
				{
					"id": 705490206,
					"content": "İyiyim, sadece alışmak için biraz zamana ihtiyacım var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490207
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490207,
					"content": "Hatırladığım kadarıyla en son geçen yıl Navia'nın beni davet ettiği bir şarap tadım etkinliğinde alkol almıştım. Sadece küçük bir yudum Sassica Şarabı içmiştim ve o bile senin bu karışımın kadar sert değildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490208,
						705490209
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490208,
					"content": "Yani sen normalde hiç içki içmiyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490210
					]
				},
				{
					"id": 705490210,
					"content": "Tamamen mantıksal açıdan konuşacak olursam alkol baş dönmesine yol açabiliyor ve çalışma yetisini zayıflatabiliyor, bu yüzden en iyisi hiç içmemek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490211
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490211,
					"content": "Ama Bayan Furina beni rıhtımdan uğurlarken Mondstadt'ın \"şarap ve şiir diyarı\" olduğunu söyledi. Hazır buradayken en azından yerel spesiyalleri denemeliyim diye düşündüm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490212,
						705490213
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490212,
					"content": "Mantıklı. Denememek olmazdı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490214
					]
				},
				{
					"id": 705490214,
					"content": "Aslında aldığım istihbarata göre idman dövüşü yapmaya hazırlandığım Keşif Bölüğü Yüzbaşısının... Kaliteli şaraba yönelik oldukça rafine bir zevki varmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490215
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490215,
					"content": "Kamuya açık savaş raporları gerçekten görülmeye değer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490216
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490216,
					"content": "Aslında bugün idman yaptığım Yüzbaşı Eula'nın... Kaliteli şaraba yönelik oldukça rafine bir zevki varmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490217
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490217,
					"content": "Artık Fontaine'de üretilmeyen ve sadece denizaşırı yerlerde bulunabilen bir şişe Romaritime Çiçeği Meyve Özü hediye etti bana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490218
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490218,
					"content": "Onun becerilerine duyduğum derin saygıdan ötürü Mondstadt şarapları konusundaki bilgimi derinleştirmem gerektiğini düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490219,
						705490220
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490219,
					"content": "Sana bir içki daha hazırlamadan önce iyice bir düşüneyim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490221
					]
				},
				{
					"id": 705490221,
					"content": "Sana da zahmet oldu, çok sağ ol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490222
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490222,
					"content": "Mondstadt'ı iyice gezdin mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490223
					]
				},
				{
					"id": 705490223,
					"content": "Az bir kısmını gördüm. Geldiğim ilk gün şehirde ufak bir gezintiye çıktım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490224
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490224,
					"content": "Navia burası hakkında oldukça kapsamlı bir araştırma yapmış. Masa Oyunu Topluluğu için hazırlanan sahnelerin ve çizimlerin çoğunda Mondstadt manzaralarından esinlenilmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490225
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490225,
					"content": "Ancak kendi dünyasını oluştururken tarif ettiği atmosfer gerçek Mondstadt'tan oldukça farklı. Buraya geldiğimden beri edindiğim en derin izlenim kılıçlar ve kalkanlar üzerine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490226,
						705490227
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490226,
					"content": "Kılıçlar ve kalkanlar mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490228
					]
				},
				{
					"id": 705490228,
					"content": "Hımm, belki de çoğu zaman sadece demirciye ve talim kampına gittiğim içindir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490229
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490229,
					"content": "Son zamanlarda Mondstadt'ta üretilen yeni silahlar ve zırhlar, Fontaine'dekilere kıyasla tamamen farklı bir ısıl işleme tabi tutularak üretiliyor ve yüzey katmanlarındaki karbon oranı daha yüksek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490230
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490230,
					"content": "Bu durum genel dayanıklılıklarını biraz azaltmış olsa da darbe mukavemetleri büyük ölçüde arttı. Bu yeni silahlar etrafa fazla demlenmiş kahve gibi bir koku yayıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490231,
						705490232
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490231,
					"content": "Ben... Bunu fark etmemiştim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490233
					]
				},
				{
					"id": 705490233,
					"content": "Hımm... Belki de o kokunun bende bıraktığı ilk izlenim fazlasıyla olumlu olduğu içindir. Şöyle ki, Fontaine'in imza niteliğindeki metal işçiliği genellikle Marcotte içeren koruyucu bir maddeyle kaplı olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490234
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490234,
					"content": "Zamanla bu hafif koku aşırı tatlılaşıyor... Ve nedense dişlerimde tuhaf bir his bırakıyor. Mondstadt'ın kılıçlarının ve kalkanlarının kokusunun bu kadar rahatsızlık vereceğini sanmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490235,
						705490236
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490235,
					"content": "Ne hoş, bugün de yeni bir şey öğrendim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490237
					]
				},
				{
					"id": 705490237,
					"content": "Tabii bu sorunun da bir çözümü var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490238
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490238,
					"content": "Bir dahaki sefer Fontaine'e yolun düştüğünde sana önerebileceğim başka bir koruyucu madde daha var. Su gibi nötr, içinde hiç ağır koku barındırmayan türden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490239
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490239,
					"content": "Eğer sen de tatlılığa boğulmaktan hoşlanmıyorsan bu koruyucu madde hoşuna gidecektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490240
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490240,
					"content": "Genelde ne içersin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490241
					]
				},
				{
					"id": 705490241,
					"content": "Hımm... Çalışırken sık sık kahve içerim ama yemek yerken daha hafif bir şey tercih ederim, mesela Bulle Meyvesi Suyu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490242
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490242,
					"content": "Çok et tükettiğim için meyve suyunun hafif asiditesi yağlı tadı dengeliyor. Zamanla ekşi tadına alıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490243
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490243,
					"content": "Kılıç ustalığı gösterisinden sonra Favonius Şövalyeleri sağ olsunlar beni geleneksel Mondstadt mutfağından yemeklerle ağırladılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490244
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490244,
					"content": "Sekiz farklı et yemeği yedim, hepsi mükemmeldi. Porsiyonlar kocamandı ve etler on numaraydı. Her şey tam ayarında pişirilmişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490245
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490245,
					"content": "Tabii yine de geliştirilmeye açık noktaları vardı. Mesela Karamelize Soslu Rosto ve \"Festival Kulesi\" turistlere biraz daha hafif bir sosla servis edilebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490246,
						705490247
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490246,
					"content": "Kokar derler ama yenecek et rostodur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490248
					]
				},
				{
					"id": 705490248,
					"content": "Tüm kırmızı et yemeklerini denedim. Sanırım üç gün aralıksız çalışmama yetecek kadar kalori aldım, bu yüzden sonraki tüm yemek davetlerini reddetmek zorunda kaldım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490249
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490249,
					"content": "Dürüst olmak gerekirse hâlâ yağın tadını alabiliyorum. Ağzımın tadını değiştirmenin bir yolu olmalı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490250
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490250,
					"content": "Şövalyelerin hediyesi mi bu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490251
					]
				},
				{
					"id": 705490251,
					"content": "Aynen öyle. \"Fındık 3\" ve \"Fındık 5\" kod adlı şövalyeler bu armayı bana verdiler. Müthiş bir şey gerçekten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490252
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490252,
					"content": "Tasarımın daha yeni tamamlandığını söylediler, anlaşılan bu arma sadece önemli misafirlere veriliyormuş. Senin için de bir rozet yaptıklarını söylediler ama henüz bitmemiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490253,
						705490254
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490253,
					"content": "Fındık mı? Nedense daha önce hiç duymadım bu ikisini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490255
					]
				},
				{
					"id": 705490255,
					"content": "... Haklısın. Mermonia Sarayı'ndaki her görevlinin adını aklımda tutamıyorum ben de mesela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490256
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490256,
					"content": "Ama onları yakında tanıyacağına eminim. Belli ki işinin ehli ve tecrübeli kimseler. Üstelik masa başında çalışmalarına karşın tam donanımlı zırhlarını üzerlerinden çıkarmıyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490257
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490257,
					"content": "Benim işlerimi hallettikten sonra dün geceki \"düello\"larına devam etmek ve kimin alkol toleransı daha yüksek görmek için handa toplandılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490258
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490258,
					"content": "Önceki gece fıçı fıçı bira içip sabahına bana mısın demeden berrak bir kafayla çalışabilmeleri... Pes doğrusu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490259,
						705490260
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490259,
					"content": "Mondstadt böyle bir yer işte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490261
					]
				},
				{
					"id": 705490261,
					"content": "Yani diyorsun ki Mondstadtlılar gamsız görünseler de iş içmeye geldiğinde sınırlarını çok iyi biliyorlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490262
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490262,
					"content": "Ha bu arada, Bayan Emilie de buradaydı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490263
					]
				},
				{
					"id": 705490263,
					"content": "Hı? Yani görevini çoktan tamamladı mı? Tam bir iş bitirici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490264
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490264,
					"content": "Fontaine'e döndüğümde belki Sigewinne'e, Emilie'nin en yeni parfümünü almak istediğimi söyleyebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490265
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490265,
					"content": "Öyle mi? Onu yakından tanıyor gibi konuştun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490266
					]
				},
				{
					"id": 705490266,
					"content": "Öyle diyemem aslında...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490267
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490267,
					"content": "Mondstadt'a gelirken tesadüfen aynı gemiye bindik. Haliyle biraz sohbet ettik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490268
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490268,
					"content": "Sigewinne'in onun çalışmalarını övdüğünü çok duydum. Buraya gelirken onunla sohbet ettikten sonra şunu rahatlıkla söyleyebilirim ki... Kendisi gerçekten de eşine az rastlanır ve zarif birisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490269,
						705490270
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490269,
					"content": "Zarif mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490271
					]
				},
				{
					"id": 705490271,
					"content": "Nazik ve soğukkanlı ama yine de başkalarıyla arasına mesafe koymayı biliyor... Belki de mesleği yüzündendir. Bence bu doğru bir yaklaşım, insanın iç huzurunu daimi kılıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490272,
						705490273
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490272,
					"content": "Kulağa sanki... Bir buluşma ayarlamamı istiyormuşsun gibi geliyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490274
					]
				},
				{
					"id": 705490274,
					"content": "Teşekkür ederim ama gerçekten bir şey ayarlamana gerek yok. İşlerimiz pek kesişmiyor, sosyal çevrelerimizin de birbiriyle pek örtüştüğünü söyleyemeyiz. Ne demek istediğimi anlamışsındır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490275
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490275,
					"content": "En iyisi her şeyi doğal akışına bırakmak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490276
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490276,
					"content": "Emilie çay içmeyi sever. Peki ya sen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490277
					]
				},
				{
					"id": 705490277,
					"content": "Daha gerçekleşip gerçekleşmeyeceği bile belli olmayan buluşmamızın ayrıntılarını mı planlıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490278
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490278,
					"content": "Alkolle ilgili önceki deneyimlerime dayanarak toleransımın Emilie'ninkine benzer olduğunu tahmin ediyorum. Meyve liköründen öteye geçemem muhtemelen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490279
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490279,
					"content": "O yüzden zamanı geldiğinde ikimize de benzer içecekler hazırlaman iyi olur sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490280
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490280,
					"content": "Galiba daha çok hoşuna gidecek bir içecek buldum. Az bekle lütfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490281
					]
				},
				{
					"id": 705490281,
					"content": "Pekala, kendimi zihinsel olarak hazırlayayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705490282
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490282,
					"content": "Biraz sert olsa da bitirmek için elimden geleni yapacağım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 705490273,
					"content": "Bir dahaki sefere Fontaine'e geldiğimde hep birlikte buluşalım mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490274
					]
				},
				{
					"id": 705490270,
					"content": "Çok \"zarifçe\" ifade ettin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490271
					]
				},
				{
					"id": 705490260,
					"content": "Mondstadtlıların iş çıkışı bir şeyler içip yorgunluklarını atmak kadar sevdikleri hiçbir şey yoktur!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490261
					]
				},
				{
					"id": 705490254,
					"content": "Favonius Şövalyeleri epey büyük bir örgüt gerçi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490255
					]
				},
				{
					"id": 705490247,
					"content": "Mondstadt'ın meşhur etli yemeklerinin hepsini denedin mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490248
					]
				},
				{
					"id": 705490236,
					"content": "Kılıç yapımının bu kadar karmaşık olduğunu hiç bilmezdim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490237
					]
				},
				{
					"id": 705490232,
					"content": "Bayağı iddialı bir benzetme...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490233
					]
				},
				{
					"id": 705490227,
					"content": "Neden ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490228
					]
				},
				{
					"id": 705490220,
					"content": "Yüzde yüz memnun kalman için tarifi biraz değiştirmem gerekiyor!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490221
					]
				},
				{
					"id": 705490213,
					"content": "Sınırlarını aşmadığın sürece bir sorun yaşamayacağına eminim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490214
					]
				},
				{
					"id": 705490209,
					"content": "İstemiyorsan kendini içmeye zorlama.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490210
					]
				},
				{
					"id": 705490205,
					"content": "Biraz su ister misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705490206
					]
				}
			]
		},
		{
			"id": 7054903,
