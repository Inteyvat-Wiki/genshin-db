			"dialogs": [
				{
					"id": 701080301,
					"content": "İşaretçiyi yerine koydun mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080302
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701080302,
					"content": "Evet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701080303
					]
				},
				{
					"id": 701080303,
					"content": "Harika! Teşekkür ederim, artık dağın yükseklik ölçümünü güvenilir bir şekilde yapabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080304
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701080304,
					"content": "Ödemeye gelirsek, Cyrus'tan bir şeyler hazırlamasını istedim. Şehre gittiğinde ondan isteyebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080305
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701080305,
					"content": "Sen onu benden önce göreceğin için bu mektubu da ona verir misin? Dağa giden ikinci keşif takımıyla ilgili beni bilgilendireceğini söylemişti ama sonra hiç haber almadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080306
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701080306,
					"content": "Kalan işaretçilerim de tamir olduğunda tekrar yukarı çıkıp onları kurmam gerek. Dağda hâlâ gözetlenmesi gereken bir sürü şey var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Esther"
				}
			]
		},
		{
			"id": 7010804,
			"completionStepIds": [
				7010805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
