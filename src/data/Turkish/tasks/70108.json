				"objectNames": [
					"Cyrus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701080401,
					"content": "Merhaba, nasıl yardımcı olabilirim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080402
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080402,
					"content": "Sana bir mektup getirdim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701080403
					]
				},
				{
					"id": 701080403,
					"content": "Mektup mu? Aa, ondan gelmiş. Eminim yine sonraki keşif takımını soruyordur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080404
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080404,
					"content": "*iç çeker* Ne yapabilirim bilmiyorum. Son zamanlarda dağa çıkmayı kabul edecek bir takım bulmak zor. Orası çok tehlikeli bir dağ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080405
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080405,
					"content": "Durumu izah etmek için hemen bir mektup yazacağım. Bunu teslim etmek üzere bunca yol geldiğin için teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080406
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080406,
					"content": "Mektuptan bahsetmişken, kısa süre önce sana bir ödül hazırlamamı söyleyen başka bir mektup göndermişti. İşte, lütfen bunu kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080407
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080407,
					"content": "Son bir şey daha var... Zaten zorlu tiplerden olduğun belli ama yine de dağlarda dikkatli olmanı öneririm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701080410
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 701080410,
					"content": "Ejdersırtı... Orada bizzat kaşif takımı yönetme fırsatım olsa hemen değerlendirirdim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
			]
		},
