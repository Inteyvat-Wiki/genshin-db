			"dialogs": [
				{
					"id": 740741901,
					"content": "Mekanizmanın üzerini dikkatlice inceliyorsunuz ama hiçbir şey bulamıyorsunuz.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740741902
					]
				},
				{
					"id": 740741902,
					"content": "Burada hiçbir şey yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740741903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740741903,
					"content": "Sanki daha önceden burada bir şey varmış da birisi onu alıp götürmüş gibi görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740741904
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740741904,
					"content": "Bir dakika, planımız çoktan suya mı düştü yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740741905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740741905,
					"content": "\"Mantığın\" doğuşu için dört Bölgenin birleşmesi lazım. Diğerlerini alabilirsek hâlâ başarma şansımız var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740741906
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740741906,
					"content": "O halde hadi hemen diğer bölgeye gidelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ann"
				}
			]
		},
