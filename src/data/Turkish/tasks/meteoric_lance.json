					"nextDialogs": [
						740742104
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740742104,
					"content": "Bu kim olabilir ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740742105
					]
				},
				{
					"id": 740742105,
					"content": "Jakob.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742106
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740742106,
					"content": "Onunla bir kere Elynas'ta savaşmıştık. Düzeltme: \"Bir kere\" değil, \"daha önce\" olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742107
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740742107,
					"content": "Kapıdaki talihsiz kurbanları görünce bunun onun işi olduğunu anlamıştım. Demek hâlâ iş başında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742108
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740742108,
					"content": "Peki burada topladığı şeylerle ne yapmayı planlıyor olabilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740742109,
					"content": "Oldukça basit. O da Nergis Haçı'nın Kutsal Kılıcını yeniden dövmek istiyor. Derneğin hayali hâlâ gerçekleşmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740742110
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740742110,
					"content": "Neyse, şimdi son bölgeye gitmemiz lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tırtıl"
				}
			]
