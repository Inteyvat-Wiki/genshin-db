			"dialogs": [
				{
					"id": 740740101,
					"content": "... Görüş açından ziyade yerde yatan kişiye odaklansan daha iyi olmaz mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740102
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740740102,
					"content": "Hı? Ay! Ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740103,
					"content": "Pardon Hanımefendi. Taş tableti önceliğimiz olarak almıştım. Hemen bir tarama gerçekleştiriyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740104
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740740104,
					"content": "... Özür dilerim Hanımefendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740105
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740740105,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740106,
					"content": "Hâlâ canlı olsa da yaşam nefesini kaybetmiş. Bunu daha önce görmüştüm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740107
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740740107,
					"content": "Ayy! Paimon bakmak istemiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740108,
					"content": "Ona yardım etmeliyiz! Onu bu şekilde burada bırakamayız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740109,
					"content": "Hep birlikte baygın adamı Lumidouce Limanı'na getiriyorsunuz.\\nOradaki insanlar onu hemen tedavi altına alıyorlar.\\nEmin ellerde olduğunu bilerek önceden bulunduğunuz yere geri dönüyorsunuz.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740740110
					]
				},
				{
					"id": 740740110,
					"content": "Tamam! Şimdi şu taş tablete bir göz atalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740111,
					"content": "\"Burası Dilekler Bölgesi, Dilekler Tapınağı ve Dilekler Odasıdır...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740112
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740740112,
					"content": "\"Çelişkili de olsa\"... \"Bir anda doğar, sana ebedi istirahatinde eşlik eder, hiç ayrılmaz\"... \"Günahların kirli meyveleri\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740113
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740740113,
					"content": "Bir bilmece daha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740114
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740740114,
					"content": "Bu neden bu kadar korkunç ki? Cevapla bir ilgisi mi var acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740740115,
					"content": "Iıı, Fontaineliler \"günahkardır\", hayatları ilk günahla kirlenmiştir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740116
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740740116,
					"content": "Bu yüzden bilmecenin cevabı \"hayat\". Öyle olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740117
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740740117,
					"content": "Emin misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740118
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740740118,
					"content": "Nergis Haçı Derneğinin kelime oyunlarını iyi bilirim. Cevabın bu olduğuna eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740740119
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740740119,
					"content": "Tamamdır, şimdi kaybettiğimiz zamanı telafi etmemiz lazım. Acele edelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tırtıl"
				}
			]
		},
