			},
			"dialogs": [
				{
					"id": 750680101,
					"content": "Bu insanlık dışı yaratıklar gerçekten çok güçlüler... Gerçi canavar demek daha doğru olur. Merhaba cesur savaşçı... Ben Quenin, bu macera takımındanım. Görevim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680102
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680102,
					"content": "Görevim... Bu canavarlardan kurtulmak. Evet, ben macera takımının bir savaşçısıyım. Dikkatli ol cesur savaşçı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680103
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680103,
					"content": "Bu canavarlar... Tilki gibi kurnazlardır. Kılık bile değiştirebilirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680104
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680104,
					"content": "Her gece uykuya dalmaya çalışırken... Onların bu kadim harabelerde saklanırken çıkardıkları sesleri duyuyorum. Bu yüzden... Kampta uyuyamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680105
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680105,
					"content": "Burası canavarlarla kaynıyor. Sen de... Dikkatli olmalısın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		},
