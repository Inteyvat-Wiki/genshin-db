			},
			"dialogs": [
				{
					"id": 750680401,
					"content": "Demek hâlâ buradasın cesur savaşçı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680402
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680402,
					"content": "Alimlere göre, bir zamanlar bu Kül Şehir'in kadim ve zalim Lordu, Hiçlik aşınmasını durdurmanın... Bir yolunu biliyormuş. Bu nedenle biz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680403
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680403,
					"content": "Fakat burada gerçekten insanı tedirgin eden bir şeyler var cesur savaşçı. Son zamanlarda ben de biraz... Garip hissetmeye başladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680404
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680404,
					"content": "Bazen uyandıktan sonra, bir gün önce sapasağlam duran bir yolun çökmüş ve paramparça olmuş olduğunu görüyorsun... Mesela o taş evler başından beri böyle miydi? Sanki... Daha bütün bir halde olmalıydılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680405
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680405,
					"content": "Bazense, uyandığımda, artık burada olmaması gereken arkadaşlarımı görüyorum... Onlar canavar mı? Öyle olmalılar... Arkadaşlarımın kılığına girmiş canavarlar olmalılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680406
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680406,
					"content": "Benim... Buradaki görevim bu canavarlardan kurtulmak... İyi de neden? Neden bunu yapmak zorundayım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750680407
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750680407,
					"content": "Neyse işte, sonuç olarak burası çok garip bir yer. Gitmelisin... Hem de bir an önce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		},
