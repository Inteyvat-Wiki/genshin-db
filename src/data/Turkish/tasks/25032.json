				},
				{
					"id": 250323007,
					"content": "Arkalarına \"Keşke siz de burada olsaydınız.\" falan yazıp Bakanlığa gönderirim. Hediye olduğu için kimse bir şey diyemez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250323008
					],
					"speakerTitle": "Zicheng"
				},
				{
