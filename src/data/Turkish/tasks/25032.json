			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zicheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250320601,
					"content": "Dönmüşsün! Fotoğrafı çektin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320602
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320602,
					"content": "Çektim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320603
					]
				},
				{
					"id": 250320603,
					"content": "Vay be, iyiymişsin cidden. Asistanımdan çok daha iyi olduğun kesin. Araştırma yaptığımız yerlerin doğru düzgün bir fotoğrafını yakalayabilmek için en az birkaç çekim yapması gerekiyor onun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320604
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320604,
					"content": "Araştırma ekibimizde sen olsaydın kesin daha az Kamera bozardık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320605
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320605,
					"content": "Bu, şiir yazmana yardımcı olacak mı cidden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320606
					]
				},
				{
					"id": 250320606,
					"content": "Olacak sanırım. İşe yaramazsa resmi kartpostal olarak kullanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320607
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320607,
					"content": "Arkasına \"Keşke siz de burada olsaydınız.\" falan yazıp Bakanlığa gönderirim. Hediye olduğu için kimse bir şey diyemez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320608
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320608,
					"content": "*öksürür* O son çare olacak tabii. Bu sırada \"iyi bir şiir yazma\" meselesini güzelce bir düşüneceğim ben de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320609
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320609,
					"content": "Beş rüzgar akın eder... Yok yok, \"esip gürler\" mi desem acaba? Bir dakika ya. Natlan'da kaç kabile vardı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zicheng"
				}
			]
		},
