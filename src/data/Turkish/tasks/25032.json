			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zicheng"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250320101,
					"content": "Hımm... Resimle bir şiir yaratmak mı, yoksa şairane bir resim yapmak mı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320102
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320102,
					"content": "Hımm... Yok canım, bu ikisi aynı anlama gelmiyor mu zaten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320103,
						250320104
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320103,
					"content": "Neden bahsediyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320105
					]
				},
				{
					"id": 250320105,
					"content": "Merhaba. Evet, doğru bildin. Natlan'ın manzaralarına dair bir şiir yazmaya çalışıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320106
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320106,
					"content": "Ama işte... Dürüst olmak gerekirse buranın manzaraları Liyue'den epey farklı. Bölgenin tarihine de aşina değilim, nereden başlayacağımı bilemiyorum o yüzden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320107
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320107,
					"content": "Profesyonel bir şair veya tanınmış bir halk ozanı falan da değilim ayrıca... Nükteli şiirlerimle birilerini güldürebilmişliğim bile yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320108
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320108,
					"content": "*iç çeker* Yine de memleketime elim boş dönemem. Sivil İşler Bakanlığındaki meslektaşlarım benimle kafa bulur sonra. \"Oraya ilham bulmaya mı, yoksa keyif çatmaya mı gittin?\" falan derler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320109
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320109,
					"content": "Bakanlıkta mı çalışıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320110
					]
				},
				{
					"id": 250320110,
					"content": "Evet... Öyle sayılır. Bir süre önce arazi etütleri yapmak için işe alındım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320111
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320111,
					"content": "*iç çeker* Kısaca açıklamam gerekirse suyun ve toprağın değişip değişmediğine bakmak için birilerini Liyue'de gezdiriyordum... Ya da haritaların güncellenmesi gerekip gerekmediğini falan kontrol ediyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320112
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320112,
					"content": "Bunu bir tur yapmak bile aşırı yoruyordu beni, o turlar yüzünden kaç ayakkabı eskittim bilmiyorum... Bu yüzden biraz tatil yapayım dedim. Değişiklik olsun diye yani, anlarsın ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320113
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320113,
					"content": "Sorun şu ki... Aklımdan ne geçiyordu bilmiyorum ama izin isteme sebebimi şöyle açıkladım: \"Şiir yazasım geldi. İlham bulmaya gidiyorum.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320114
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320114,
					"content": "İzinleri onaylama yetkisi olan kişinin işi ciddiye alıp \"Şiirsel güç seninle olsun.\" demesini ve bana on beş gün izin vermesini beklemiyordum tabii...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320115,
						250320117
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320115,
					"content": "Bu iyi bir şey değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320116
					]
				},
				{
					"id": 250320116,
					"content": "Kim olsa öyle düşünür, evet... Gel gör ki şimdi tüm Bakanlık neden tatile çıktığımı biliyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320119
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320119,
					"content": "*iç çeker* Eğlenceli de oldu tabii, ona şüphe yok. Manzara güzel, yemekler oldukça iyi. Burada bir sürü ilginç canlı türü de var üstelik, hele şu bebek Sürüngenler öyle sevimli ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320120
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320120,
					"content": "Tüm bunlara rağmen bir satır bile şiir yazamadım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320121
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320121,
					"content": "İlham bulurum belki diye bir Kamera bile ödünç aldım ama pek faydasını göremedim doğrusu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320122
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320122,
					"content": "Doğal manzaralar yine idare eder ama işin içine dükkanlar ve kalabalıklar girince ortalık karışıyor. O tarz fotoğraflardan hiçbir şey çıkaramıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320123,
						250320124
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320123,
					"content": "Sana yardımcı olayım o halde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320125
					]
				},
				{
					"id": 250320125,
					"content": "Ne diyorsun, yardım eder misin cidden? Şükürler olsun... Öyle veya böyle ilham bulmam lazım benim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320126
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320126,
					"content": "Bir düşüneyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320124,
					"content": "Fotoğraf çekme konusunda çok yetenekliyimdir ben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320125
					]
				},
				{
					"id": 250320117,
					"content": "Peki iyi bir şair olduğunu kanıtladın mı bari?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320118
					]
				},
				{
					"id": 250320118,
					"content": "Keşke... Ne var ki tatile çıktığımı ve bunun nedenini duymayan kalmadı. Şimdi Bakanlıktaki herkes neden Natlan'a geldiğimi biliyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320119
					],
					"speakerTitle": "Zicheng"
				},
				{
					"id": 250320104,
					"content": "Şiir mi yazıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320105
					]
				}
			]
		},
		{
			"id": 2503206,
