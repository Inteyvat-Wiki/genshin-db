							9642.107
						],
						"pointId": 9945
					}
				]
			},
			"dialogs": [
				{
					"id": 751260601,
					"content": "Tüm bunların yaşanmış olduğunu düşününce... Milchi ve bu notları geride bırakan kişi... Herkes çok cesurmuş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751260602,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260603
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751260603,
					"content": "Bu... Bu, notlarda geçen uyuyan Sürüngen yumurtası!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751260604,
					"content": "#Yumurtayı çatlatmak için kuluçka makinasını kullanmamız gerektiğini mi söylüyorsun {REALNAME[ID(2)|SHOWHOST(true)]}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751260605,
					"content": "Rarr! Rarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260606
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751260606,
					"content": "Hımm, yumurta iyi durumda görünüyor, ayrıca kuluçka makinasının kullanım kılavuzu da var. Bir deneyelim hadi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751260607,
						751260608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751260607,
					"content": "Çalışacağından emin değilim ama deneyebiliriz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751260609
					]
				},
				{
					"id": 751260609,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
