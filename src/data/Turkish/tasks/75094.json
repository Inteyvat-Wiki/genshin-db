					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"#{REALNAME[ID(2)|SHOWHOST(true)]}",
					"Paimon"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							229.674,
