		{
			"id": 7509406,
			"completionStepIds": [
				7509406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7509406",
							"2"
						],
						"stepId": 7509406,
						"stateName": "QUEST_STATE_UNFINISHED"
