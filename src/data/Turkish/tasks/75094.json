				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"#{REALNAME[ID(2)|SHOWHOST(true)]}",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750940601,
					"content": "Of... Bu canavarlar çok korkutucuydu. Nereden hortlayıp saldırıya geçtilerse artık... Neyse ki çok güçlüyüz, öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940602,
						750940604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940602,
					"content": "Sanırım bir dahaki sefere sana güveneceğim Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940603
					]
				},
				{
					"id": 750940603,
					"content": "Ha? Yok, yok yok, Paimon'a güvenemezsin! Paimon o korkunç canavarlarla asla savaşamaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940606,
					"content": "Rarr! Rarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940607
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940607,
					"content": "Heh, bizim ufaklık endişelenmeye başladı galiba. Hadi önce yumurtayı çatlatmanın bir yolunu bulalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940608,
					"content": "Kuluçka makinasını etkinleştir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940609
					]
				},
				{
					"id": 750940609,
					"content": "Kuluçka makinası yeniden çalıştı...\\nŞimdi tek yapmanız gereken beklemek...\\nSaatler geçmesine rağmen Sürüngen yumurtasında hiçbir değişiklik olmadı...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750940610
					]
				},
				{
					"id": 750940610,
					"content": "Err... Errr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940611
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940611,
					"content": "Tuhaf. Hiçbir şey olmadı. Atladığımız bir şey mi var acaba? Tekrar deneyelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940612,
						750940632
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940612,
					"content": "Tekrar deneyelim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940613
					]
				},
				{
					"id": 750940613,
					"content": "Kuluçka makinasını talimatlara göre yeniden çalıştırıyorsunuz...\\nAncak tıpkı önceki denemede olduğu gibi, Sürüngen yumurtasına hiçbir şey olmuyor...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750940614
					]
				},
				{
					"id": 750940614,
					"content": "Of ya... Daha ne kadar bekleyeceğiz? Paimon'un göz kapakları indi inecek... Ayrıca Paimon'un başı döndü ve karnı acıkmaya başladı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940615,
					"content": "Raa... Gurr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940616
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940616,
					"content": "Ha? Hey! Bak! Yumurta hareket etti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940617,
						750940627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940617,
					"content": "Biraz daha bekleyelim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940618
					]
				},
				{
					"id": 750940618,
					"content": "Uzun bir süre sonra...\\nSürüngen yumurtasında hâlâ bir değişiklik yok. Ne bir hareket var ne de yumurtadan çıkma belirtisi.",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750940619
					]
				},
				{
					"id": 750940619,
					"content": "Hâlâ bir hareket yok... Kuluçka makinası bozulmuş olmasın? Gerçi ışıkları yanıyor. Hımm. Belki de sorun yumurtadadır, ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940620,
					"content": "... Hımm, bekleyip durmanın bir faydası yok... Yumurtayı yanımızda götürelim mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940621,
						750940624
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940621,
					"content": "Ne kadar aç olursan ol yumurtayı yemeyi aklından bile geçirme...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940622
					]
				},
				{
					"id": 750940622,
					"content": "Vıraa! Vıraa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940623
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940623,
					"content": "#Paimon yumurtayı tabii ki yemeyecek! Ayrıca senin yüzünden {REALNAME[ID(2)|SHOWHOST(true)]} tuhaf fikirlere kapılacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940626,
					"content": "Ufaklık, Paimon diyor ki... Eğer sorun yumurtadaysa belki de hiçbir zaman...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940634
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940634,
					"content": "Ruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940635
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940635,
					"content": "#Üzülme {REALNAME[ID(2)|SHOWHOST(true)]}. Yapabileceğimiz bir şey yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940636,
						750940637
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940636,
					"content": "Belki de ortam uygun değildir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940638
					]
				},
				{
					"id": 750940638,
					"content": "Tabii ya, haklısın! Belki de yumurta, Natlan'ın değişmediğini ve kendisi için uygun bir yuva olmadığını düşündüğü için çatlamıyordur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940639
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940639,
					"content": "Ne de olsa bunca zamandır içeride saklanıyor, değil mi? Doğal olarak, Natlan'ın ne kadar harika bir yer haline geldiğinden haberi yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940640
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940640,
					"content": "O halde onu geri götürelim ve ona gözümüz gibi bakalım! Ona her gün güzel manzaralar, heyecan verici maceralar ve tanıştığımız muhteşem insanlar hakkında hikayeler anlatalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940641,
					"content": "Kısacası ona Natlan'ın şu anda ne kadar mükemmel bir yer olduğunu anlatalım. İlgisini çektiğinde mutlaka çatlayacaktır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940642
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940642,
					"content": "... Bıraar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940637,
					"content": "Belki de... Yumurta henüz doğru zamanın geldiğini düşünmüyordur...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940638
					]
				},
				{
					"id": 750940624,
					"content": "#Sen ne dersin {REALNAME[ID(2)|SHOWHOST(true)]}?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940625
					]
				},
				{
					"id": 750940625,
					"content": "Err... Errr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940626
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940627,
					"content": "Hayır, öyle bir şey olmadı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940628
					]
				},
				{
					"id": 750940628,
					"content": "#Ha? Ama... Daha demin.. Paimon hayal mi görüyordu? Hayır, olamaz. Sen de gördün mü {REALNAME[ID(2)|SHOWHOST(true)]}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940629,
					"content": "Err... Errr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940630
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750940630,
					"content": "#Aa... Sen de mi görmedin? Paimon hayal mi gördü yani? Ee, şimdi ne yapıyoruz {NICKNAME}? Bekleyişe devam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940631,
					"content": "Yoksa... Sorun gerçekten yumurtada mı? A-Ama öyleyse, yumurta hiçbir zaman çatlamayacak mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940634
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940632,
					"content": "Sorun muhtemelen yumurtada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940633
					]
				},
				{
					"id": 750940633,
					"content": "Ha? Yani bu... Yumurtanın hiçbir zaman çatlamayacağı anlamına mı geliyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940634
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750940604,
					"content": "Hıh, ellerinden gelen bu muymuş yani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750940605
					]
				},
				{
					"id": 750940605,
					"content": "Aynen öyle! Paimon o korkunç tiplerini görünce bunların feci güçlü düşmanlar olduğunu sanmıştı ama küçük dostumuz bile onlardan sert vuruyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750940606
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7512606,
