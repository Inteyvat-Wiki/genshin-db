			"dialogs": [
				{
					"id": 240190301,
					"content": "Ne diyordum? Ha, gerçekten kibarlar. Mermonia Sarayı'nın etrafındaki o zorbalardan çok daha efendiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190302
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190302,
					"content": "Gerçekten çok kibarlardı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190303
					]
				},
				{
					"id": 240190303,
					"content": "Değil mi? Sadece burada oturmak bile beni rahatlatıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190304
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190304,
					"content": "Yani, kendini bir an için martı olarak hayal et. İnsanlar gelip karnını doyuruyor zaten, tek yapman gereken güneşlenip hayatın anlamını sorgulamak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190305
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190305,
					"content": "*iç çeker* Ben neden Mor Altın Balıkçı Martı olmak varken Savcı oldum ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				}
			]
		},
