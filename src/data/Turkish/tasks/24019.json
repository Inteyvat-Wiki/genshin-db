			"dialogs": [
				{
					"id": 240190801,
					"content": "Sen... Bunu nasıl yaparsın? Onlar Mermonia Sarayı'nın önündeki zorbalardan değiller, biliyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190802
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190802,
					"content": "Özür dilerim, yanlışlıkla oldu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190803
					]
				},
				{
					"id": 240190803,
					"content": "*iç çeker* Seni durdurmaya zamanım olmadı bile. Neden yaptın ki? İçlerinden biri sana mı saldırdı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190804
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190804,
					"content": "Her neyse, gittiler zaten. Ah, birkaç gün içinde tekrar gelip onlara özür mahiyetinde biraz yemek vermem lazım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				}
			]
