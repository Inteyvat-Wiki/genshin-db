			},
			"dialogs": [
				{
					"id": 240190101,
					"content": "Elimdeki tüm yemek buydu. Umarım hepsi doymuştur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190102
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190102,
					"content": "Ne yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190103
					]
				},
				{
					"id": 240190103,
					"content": "Martıları besliyorum. Bak, hepsi neredeyse doydu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190104
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190104,
					"content": "Vay canına, ne ara bu kadar yakınlaştınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240190105,
					"content": "Onlar senin patateslerini çalmamış mıydı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190106
					]
				},
				{
					"id": 240190106,
					"content": "Hayır. Anlaşılan insanlar özel olarak gelip onları besliyorlar o yüzden patateslerime göz dikmediler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190107
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190107,
					"content": "Ama iş yerinden çok uzaklaşırsan işe yetişemeyeceğini söylememiş miydin sen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240190108,
					"content": "Hahaha, sorun yok. Bugün benim izin günüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190109
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190109,
					"content": "Burada hiçbir arkadaşım gelip beni işle ilgili sohbetlere çekemez ve herhangi biri ya da bir hayvan gelip patates kızartmalarımı çalamaz... Evet, en uygun yer burası.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190110
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190110,
					"content": "Martılar çok dost canlısı. Patates kızartmalarımı çalmıyorlar ya da bana saldırmıyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190111
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190111,
					"content": "Onları birkaç defa kendim beslediğimden beri beni tanır hale geldiler. Tüylerine dokunduğumda bile kaçmıyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190112
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190112,
					"content": "Hatta Mermonia Sarayı'ndakilere kıyasla çok efendi olduklarını söyleyebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190113
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190113,
					"content": "Bir de pençeleriyle daktilo kullanabilseler bizi işimizden bile edebilirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190114,
						240190116
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190114,
					"content": "Mor Altın Balıkçı Martılar insan işlerine yardım edemezler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190115
					]
				},
				{
					"id": 240190115,
					"content": "Ama en azından daha kötü bir hale de getiremezler. Ve herkes bilir ki bazı şeyler onlar için çok zordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190118
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190118,
					"content": "Neyse bunu şimdi bir kenara bırakalım. Bu kibar martılarla arkadaş olmayı denemek ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190119
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190119,
					"content": "Vay, demek senin gözünde nazik kuşlar oldular, ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190120,
						240190122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240190120,
					"content": "Yanlarına gitsem kabalık etmiş olur muyum?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190121
					]
				},
				{
					"id": 240190121,
					"content": "Hayır, gayet hoşgörülüdürler. Tüylerine dokunmadığın sürece sorun olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190124
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190124,
					"content": "Gel sana özel olarak işlediğim bu balığı vereyim. Bunu sadece al ve şuradaki kaseye koy.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190125
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190125,
					"content": "Sakin ol. Mor Altın Balıkçı Martılar çok hoşgörülüdürler, onları besleyen herkesi severler. Hem üzümünü yer bağını sormazlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190122,
					"content": "Onlarla arkadaşlık kurarken dikkat etmem gereken başka bir şey var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190123
					]
				},
				{
					"id": 240190123,
					"content": "Pek bir şey yok aslında. Sadece doğrudan tüylerine dokunma yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190124
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 240190116,
					"content": "Mor Altın Balıkçı Martılar bizim dilimizi konuşmazlar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190117
					]
				},
				{
					"id": 240190117,
					"content": "Ben o kadar emin değilim. Belki de daha rahat yaşamak için öyle davranıyorlardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190118
					],
					"speakerTitle": "Iaune"
				}
			]
		},
