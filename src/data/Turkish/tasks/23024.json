			"dialogs": [
				{
					"id": 230240101,
					"content": "Ah, sonunda geldin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240102
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240102,
					"content": "Harika zamanlama. Her şey hazır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240103
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240103,
					"content": "Neden bu kadar heyecanlısın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240104
					]
				},
				{
					"id": 230240104,
					"content": "Güller açmak üzere olduğu için olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230240105,
					"content": "Evet, hahaha! Bunu sen olmadan başaramazdık Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240106
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240106,
					"content": "Gül henüz tam açmadı ama ne kadar canlı olduğunu görebilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240107
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240107,
					"content": "İstersen gel de yakından bak Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240108
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240108,
					"content": "Belki de gözünün önünde bir anda açabilir bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240109
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240109,
					"content": "Bunu hayatta kaçırmam...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240110
					]
				},
				{
					"id": 230240110,
					"content": "Ne? Gerçekten mi? Hemen şimdi mi yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230240111,
					"content": "Hehe, Paimon da heyecanlanmaya başladı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
