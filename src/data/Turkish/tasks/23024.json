			"dialogs": [
				{
					"id": 230240201,
					"content": "Gel, eğilip bakarsan her bir ayrıntısını net bir şekilde görebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240202
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240202,
					"content": "Şifalı bitki yetiştiricileriyle birlikte gülün goncasını inceliyorsunuz...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230240203
					]
				},
				{
					"id": 230240203,
					"content": "Hiçbir şey olmuyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240204,
						230240205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230240204,
					"content": "Ben hiçbir şey görmüyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240206
					]
				},
				{
					"id": 230240206,
					"content": "Yani... Sanırım siz baktığınız için biraz utandı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240207
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240207,
					"content": "Ama merak etmeyin. Güllerin yaşam döngüsüne bakacak olursak göreceksiniz, en geç yarın açmış olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240208
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240208,
					"content": "Pekala, o halde lütfen yarın tekrar gel Gezgin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240205,
					"content": "Bacaklarım uyuştu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240206
					]
				}
			]
		},
