					"speakerTitle": "Vardan"
				},
				{
					"id": 230240402,
					"content": "Sayende hayatımda gördüğüm en güzel güle bakıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240403
					],
					"speakerTitle": "Gurgen"
				},
				{
					"id": 230240403,
					"content": "Çok teşekkür ederim. Minnettarlığımın göstergesi olarak lütfen bunu kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240404
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240404,
					"content": "Tebrikler!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230240405
					]
				},
				{
					"id": 230240405,
					"content": "Hehe, biz de gülün açmasına çok sevindik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230240406,
					"content": "Oh be... Gülleri Bimarstan'a zamanında teslim edebileceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230240407
					],
					"speakerTitle": "Vardan"
				},
				{
					"id": 230240407,
					"content": "Umarım güllerin onlara bir faydası dokunur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vardan"
				}
