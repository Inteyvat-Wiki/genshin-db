			},
			"dialogs": [
				{
					"id": 710500701,
					"content": "İşte istediğin mantarlar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500702
					]
				},
				{
					"id": 710500702,
					"content": "Teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500703
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500703,
					"content": "Sayende araştırmam, Liyue'de dedikleri gibi \"kanatlanıp uçacak!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500704
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500704,
					"content": "Kanatlanıp uçacak mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500705
					]
				},
				{
					"id": 710500705,
					"content": "Evet, kanatlanıp uçacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500706
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500706,
					"content": "Bu mantarlara ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500707
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500707,
					"content": "Çok tuhaf. Floresin haricinde neredeyse Sumeru'ya özgü bir mantar türüyle birebir aynı. Niye böyle olmuş acaba? Karanlıkta evrimleştikleri için olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500708
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500708,
					"content": "İyi de, evrim geçirince görünümleri niye aynı kalsın ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500709,
						710500710
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500709,
					"content": "Bu konulardan hiç anlamam...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500711
					]
				},
				{
					"id": 710500711,
					"content": "Hımm... Basitçe anlatacak olursam eğer, mantarlar bulundukları çevreye adapte olacak şekilde evrimleşir ama bu mantar türü, orman ekosisteminde yaşamaya daha uygun görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500712
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500712,
					"content": "İşte bu yüzden Sumeru kökenli olduklarından bu kadar eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500713
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500713,
					"content": "Peki neden parlıyorlar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500714
					]
				},
				{
					"id": 710500714,
					"content": "Kanyon'a özgü bir mantar türü olmadığı için, parlayacak şekilde evrimleşmemiş. Daha ziyade anormal bir ekolojik olay yüzünden parlıyorlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500715
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500715,
					"content": "Muhtemelen gökyüzünden düşen o parça yüzündedir. Onun enerjisini emdikten sonra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500716,
						710500717
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500716,
					"content": "Parça mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500718
					]
				},
				{
					"id": 710500718,
					"content": "Öhöm... Ne? Ne dedin? \"Parça\" mı dedin? Yani mantarların parçaları gökyüzünden düştüğünde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500719
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500719,
					"content": "Tuhaf bir mutasyona uğramış olsalar gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500720
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500720,
					"content": "Sebebi bu olmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500721
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500721,
					"content": "Şey... Mantarları topladığın için teşekkür ederim. Yoğun bir gündü. Lütfen gidip biraz dinlen. Bunu hak ettin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500722
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500722,
					"content": "Şimdi mantarları inceleyeceğim. İzninle biraz yalnız kalmam gerekiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500717,
					"content": "Ne parçası?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500718
					]
				},
				{
					"id": 710500710,
					"content": "Aklına yatmayan bir şey mi var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500711
					]
				}
			]
		}
	]
}