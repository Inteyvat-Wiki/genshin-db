			"dialogs": [
				{
					"id": 710500401,
					"content": "Bu mantarlar hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500402
					]
				},
				{
					"id": 710500402,
					"content": "Bu kadar kısa süre içinde yenilerini bulabildiğine göre, gerçekten de dedikleri gibi deneyimli bir maceracı olmalısın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500403
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500403,
					"content": "Ne? Onları burada bulduğundan emin misin? Çok tuhaf...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500404
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500404,
					"content": "Yer altında mantar yetişmesi tuhaf bir şey mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500405
					]
				},
				{
					"id": 710500405,
					"content": "Onu kastetmedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500406
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500406,
					"content": "Bu mantarlar Sumeru'ya özgü bir mantar türüne çok benziyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500407
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500407,
					"content": "Elimizdekilerin ne olduğundan henüz tam olarak emin olamıyorum. Belki elimde yeterince numune olursa, bir sonuca varabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500408
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500408,
					"content": "Lafı açılmışken... Bunlardan bulduğuna göre, daha fazlasının nerede bulunabileceğini de biliyorsundur. Bana yardım edebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500409
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500409,
					"content": "Bana yeterince mantar getirirsen, emeğinin karşılığını ziyadesiyle veririm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500410
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500410,
					"content": "Kaç tane istiyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500411
					]
				},
				{
					"id": 710500411,
					"content": "Hımm... Bir düşüneyim. İlk olarak lütfen sekiz tane getir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500412
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500412,
					"content": "Merak etme. Onları bana getirdiğin sürece karşılığını alacaksın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				}
			]
		},
		{
			"id": 7105007,
			"completionStepIds": [
				7105003
			],
