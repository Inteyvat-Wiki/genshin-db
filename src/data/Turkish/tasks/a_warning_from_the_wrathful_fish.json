			"dialogs": [
				{
					"id": 747120101,
					"content": "#{NICKNAME}, Paimon, size harika haberlerim var. Sonunda her şey hazır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120102
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747120102,
					"content": "Saldırgan Balıkları Yatıştırma Operasyonu başarıyla tamamlandı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120103
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747120103,
					"content": "Dalgıçlar su altındaki tüm enkazı temizleyip hastalarımız da biraz daha rahatladığında onları vahşi doğaya geri döndürebileceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120104
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747120104,
					"content": "Tüm emekleriniz için çok teşekkürler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747120105
					]
				},
				{
					"id": 747120105,
					"content": "Hehe, sen de bizim kadar sıkı çalıştın Sigewinne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747120106,
					"content": "Bir olay raporu yazıp Mermonia Sarayı'na sundum. Bu alandaki bir uzman ilgili düzenlemeleri hazırlıyor olmalı, yakında gerekli kurumlara haber verecektir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120107
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747120107,
					"content": "Kulağıma çalınanlara göre, bazı gazeteciler ve en az bir yönetmen bu konuya epey ilgi duyuyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120108
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747120108,
					"content": "Kim bilir, belki bir gün su ortamlarını korumanın önemi hakkında bir film bile izleriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120109
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747120109,
					"content": "Bu süper olurdu! İnsanlara istediğin kadar dil dök, asla laf dinlemeyen vurdumduymaz veya inatçı tipler her zaman olacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747120110,
					"content": "Gerçekten ödlerini koparacak bir şey görmeleri lazım... Çevre tamamen harabeye dönerse balıkların... Mutasyona uğrayıp devasa, yenilmez canavarlara dönüşeceğine ve ortalığı yerle bir edeceğine inandırsak mesela!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747120111,
					"content": "Denize çöp atan herkese en korkunç, en kan donduran kabusları yaşatmak lazım. Doğaya saygı duymayı öğrenirler o zaman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747120112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747120112,
					"content": "Mükemmel bir fikir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sigewinne"
				}
			]
		}
	]
