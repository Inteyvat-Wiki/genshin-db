			"dialogs": [
				{
					"id": 701120101,
					"content": "Pekala Dexter, devir değişti. Sanırım çocukluğunu geride bırakma zamanı geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120102
					],
					"speakerTitle": "Josephus"
				},
				{
					"id": 701120102,
					"content": "Sen de rüşdünü ispat etmeli, sadece yetişkinlerin bildiği meseleleri öğrenmelisin. Gözünü dört aç çünkü bunu sadece bir kez göstereceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120103
					],
					"speakerTitle": "Josephus"
				},
				{
					"id": 701120103,
					"content": "Neden son sözlerini söylüyormuş gibisin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 701120104,
					"content": "İşte son dersin. Benimle birlikte oku: \"Elementlerin sınıflandırılması.\" Hadi, sıra sende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Josephus"
				}
			]
		},
