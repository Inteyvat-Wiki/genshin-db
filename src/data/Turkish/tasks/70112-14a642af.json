						701120202
					],
					"speakerTitle": "Josephus"
				},
				{
					"id": 701120202,
					"content": "Bir saniye. Tam olarak kimi övdün şimdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 701120203,
					"content": "Pekala, bir sonraki adım nesnelerin birbirini nasıl etkilediğini düşünmek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120204
					],
					"speakerTitle": "Josephus"
				},
				{
					"id": 701120204,
					"content": "Element tepkimelerini, uzun menzilli kuvvetleri ve kısa menzilli kuvvetleri incele. Gereksiz müdahalelerden kaçınmayı unutma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120205
					],
					"speakerTitle": "Josephus"
				},
				{
					"id": 701120205,
					"content": "Iıı, şu an hangi dilde konuşuyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
