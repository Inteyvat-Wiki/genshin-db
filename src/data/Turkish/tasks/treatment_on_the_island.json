			},
			"dialogs": [
				{
					"id": 721380501,
					"content": "Oh... Oh be... Kalbim çıkacaktı az daha. Hayatımı kurtardığın için teşekkür ederim. Hiç unutmayacağım bunu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380502
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380502,
					"content": "Bu normal bir olay. Tatarigami tarafından etkilenen canlılar bilinçsizce uğursuz enerjiye çekilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380503
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380503,
					"content": "Bu ilaç Tatarigami enerjisi ile doymuş olduğu için onları çekmesi normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380504
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380504,
					"content": "Off, neyse... Sanırım nasıl düzelteceğimi biliyorum artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380505
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380505,
					"content": "Ama son başarısız denememde taze bitkileri kullandım. Yeni ilacımın denemelerine devam etmek için biraz daha bitkiye ihtiyacım var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380506
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380506,
					"content": "#Lütfen çıkacağın yolculukta adadaki faydalı bitkilere dikkat et {NICKNAME}. Sabahları evin önündeki bambu sepete bırakabilirsin bulduklarını.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380511
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380511,
					"content": "Sana söz verdiğim ödülü vereceğim. Ama korkarım biraz beklemen gerekecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380507
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380507,
					"content": "#Meşgulsen sorun değil {NICKNAME}. Belki de bana yardım edebilecek başka birini bulabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380508,
						721380509
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380508,
					"content": "Tabii!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380510
					]
				},
				{
					"id": 721380510,
					"content": "#Görüşürüz gezgin {NICKNAME}. Yashiori Adası'ndaki yolculuğun güvenli geçer umarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380509,
					"content": "Tamam, hallederim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380510
					]
				}
			]
