					"nextDialogs": [
						721380704
					]
				},
				{
					"id": 721380704,
					"content": "Yani... Öhöm, acı bir tadı var ve dilim uyuştu. Bölgesel felç Tatarigami yüzünden olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
