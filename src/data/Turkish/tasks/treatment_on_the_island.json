				7213807
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7213807",
							"2"
						],
						"stepId": 7213807,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7213802",
							"3"
						],
						"stepId": 7213802,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yasumoto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721380301,
					"content": "Evet, evet kökü ve yaprakları sağlam duruyor ve tazeler... Çok teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380302
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380302,
					"content": "Hepsi bu kadar, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380303
					]
				},
				{
					"id": 721380303,
					"content": "Evet. Bu kadarı yeterli. Yeni tedavileri araştırmaya başlayabilirim artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380304
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380304,
					"content": "Her şey için tekrar teşekkürler. İşte sana söz verdiğim ödül. Umarım yeterli gelir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380305
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380305,
					"content": "Bu arada, yabancı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380306
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380306,
					"content": "Pardon. Seni çok uğraştırdım ama hâlâ ismini bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380307
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380307,
					"content": "#Bana {NICKNAME} diyebilirsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380308
					]
				},
				{
					"id": 721380308,
					"content": "#{NICKNAME}, bana tekrar yardım etmek istersen lütfen daha sonra yine uğra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380309
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380309,
					"content": "Tabii ki karşılığını vereceğim. Haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasumoto"
				}
			]
		},
