			"dialogs": [
				{
					"id": 721380401,
					"content": "#Teşekkürler {NICKNAME}. Sana rahatsızlık verdiysem üzgünüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380402,
						721380403
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380402,
					"content": "Hayır, sorun yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380404
					]
				},
				{
					"id": 721380404,
					"content": "Topladığın bitkilerle yeni bir ilaç hazırladım. Ama ilacın etkisini ölçebileceğim biri yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380405
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380405,
					"content": "#{NICKNAME} acaba sen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380406
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380406,
					"content": "Lütfen açık konuş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380407
					]
				},
				{
					"id": 721380407,
					"content": "#{NICKNAME} yeni ilacımın etkisine bakmanı isteyebilir miyim senden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380408
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380408,
					"content": "Yeni ilaç hâlâ düzgün etki etmiyor ve en kötü sonuçları tahmin etmek mümkün değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380409
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380409,
					"content": "O yüzden, en azından umarım birileri başarıma tanıklık eder... Veya durum kötüleşirse sonuçlarla başa çıkmama yardım eder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380410
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380410,
					"content": "Peki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721380403,
					"content": "Önemli bir şey değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380404
					]
				}
			]
		},
