	"talks": [
		{
			"id": 7213801,
			"completionStepIds": [
				7213801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7213801",
							"2"
						],
						"stepId": 7213801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Yasumoto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721380101,
					"content": "Ben... Şüphelenmeniz gereken biri değilim, yemin ederim! Buranın doktoruyum ben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380102
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380102,
					"content": "Bana inanmıyorsanız sizi evime götüreyim. Ne istiyorsanız alın. Beni bırakın sadece, ne olur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380103
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380103,
					"content": "Ya da beni General Lord Kujou'ya götürün! O tanır beni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380104,
						721380105
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380104,
					"content": "Sanırım burada bir yanlış anlaşılma var...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380106
					]
				},
				{
					"id": 721380106,
					"content": "Ha? Sen Şogunluktan veya Sangonomiya'dan biri gibi durmuyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380107
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380107,
					"content": "Yabancı mısın? Burada ne işin var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380108,
						721380109
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380108,
					"content": "Şey...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380110
					]
				},
				{
					"id": 721380110,
					"content": "Neyse, buradan bir an önce gitsen iyi olur. Yashiori Adası artık çok tehlikeli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380111
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380111,
					"content": "Şu ana kadar Tatarigami'nin yok olacağına dair bir işaret yok ve Tenryou Heyeti de yakın zamanda çekilecek gibi durmuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380112
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380112,
					"content": "Bu adayı gezmeyi bırak artık burada yaşanmaz bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380113
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380113,
					"content": "Heyet başkanının seni tutuklamaması için kaçıyorsan batıya git.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380144
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380144,
					"content": "Tenryou Heyeti yabancı kaçakları sevmez. Ama korsanlar alabilir seni yanlarına.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380114,
						721380115
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380114,
					"content": "Adada neler oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380116
					]
				},
				{
					"id": 721380116,
					"content": "Hımm, kendin bak. Şehirlilerin ve Sangonomiya halkının bize yaptıklarını kendin gör!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380117
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380117,
					"content": "Her şey Tatarasuna'daki patlama ile başladı. Gökyüzü o gece garip renklere boyandı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380140
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380140,
					"content": "Birçok akrabam ve arkadaşım işini kaybetti ve zor geçiniyor. Diğer birçok insan da ağır yaralandı ve eve döndüklerinde yüzlerine bile bakamadık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380141
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380141,
					"content": "Birçok arkadaşım... Kaçmayı başaramadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380118
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380118,
					"content": "Daha sonra Sangonomiya halkı Yılanın kalıntılarını bastıran tılsımları yok etti. Tatarigami ortaya çıktı ve adadaki herkes panik halinde kaçtı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380119
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380119,
					"content": "Tatarigami'nin getirdiği tuhaf hastalıklar da yayılıyor. Burada oturanların çoğu çok hastalandı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380142
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380142,
					"content": "Korkarım ki iki ordunun kampına yayılması an meselesi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380143
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380143,
					"content": "Neredeyim ben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380120
					]
				},
				{
					"id": 721380120,
					"content": "Burası Inazuma Yeşim Çeliğinin yapımında kullanılan kristalin üretildiği önemli yerlerden biriydi. Kristal tükenmediği sürece şehir halkının kısıtlamasına maruz kalmadan rahatça yaşayabilirdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380121
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380121,
					"content": "Ama şimdi? Adada yaşayan bir insan bulmak bile zor. Benim gibi, normal konuşabilen insanlardan bahsediyorum tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380122
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380122,
					"content": "Neden gitmiyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380123
					]
				},
				{
					"id": 721380123,
					"content": "Gitmek istemediğimi mi sanıyorsun? Tenryou Heyet Başkanının oğlu daha önce davet etti beni... Hâlâ orduda savaşı yönetiyor olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380124
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380124,
					"content": "\"Tıbbi bilgin var, herkesten farklısın. Adada kalman tehlikeli. Gelip benim doktorum olmaya ne dersin? Seni babama önerebilirim.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380145
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380145,
					"content": "En azından o böyle söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380125
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380125,
					"content": "Savaştan önce bir Heyet Başkanını tedavi edebilmek benim gibi bir köy doktoru için hayal bile edilemeyecek bir onurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380126
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380126,
					"content": "Ama şimdi... Bir düşünsene. Heyet Başkanı kolaylıkla iyi bir doktor bulabilir. Peki ya Yashiori Adası? Buradaki hastaların güvenebileceği tek insan benim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380127
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380127,
					"content": "O yüzden gitmeyeceğim. Savaşın iki tarafını da tedavi etmeyeceğim. Tek düşmanım Tatarigami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380128
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380128,
					"content": "Benim yardımcı olabileceğim bir şey var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380129
					]
				},
				{
					"id": 721380129,
					"content": "Hayır, yok... Aslında, böyle demedim say. Dürüst olmak gerekirse yardıma ihtiyacım var gerçekten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380130
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380130,
					"content": "Tatarigami'nin sebep olduğu tuhaf hastalıkları tedavi edebilmek için bazı özel bitkilere ihtiyacım var. İşe yarayacağından emin değilim ama denemekten zarar gelmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380131
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380131,
					"content": "Sorun şu ki... Bana lazım olan bitkiler \"Tatarigami\" tarafından kirletildi ve genellikle tehlikeli yerlere dağılmış durumda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380146
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380146,
					"content": "Su ile önleri kesilmediği zamanlarda buralar canavar kaynıyor... Ayrıca bu bölgelerde Tatarigami daha da yoğun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380132
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380132,
					"content": "Benim bunu halledebilecek ne cesaretim ne de yeteneğim var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380133
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380133,
					"content": "Ve bir doktor olarak birkaç bitki toplamak için böyle bir riski alamam. O yüzden yavaş etki eden temkinli tedavilere başvurmak zorunda kaldım ve geliştirdiğim ilaçları uzun zamandır test etme fırsatım olmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380134
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380134,
					"content": "Yabancı, yanında kanat getirmişsin. Tecrübeli bir gezgin olduğun belli. Böylesine bir tehlikeyle başa çıkabileceğine eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380135
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380135,
					"content": "Umarım buradaki doğru malzemeleri toplamama yardım edebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380136
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380136,
					"content": "Bitkileri topladıktan sonra burada buluşalım. Ödülün hakkında endişelenme. Biriktirdiğim paranın birazı duruyor hâlâ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380137
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380137,
					"content": "Görev sana bir yabancı tarafından verilse de umarım kabul etmeyi düşünürsün. Çok teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380138
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380138,
					"content": "Bu arada lütfen dikkatli ol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380115,
					"content": "Üzgün görünüyorsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380116
					]
				},
				{
					"id": 721380109,
					"content": "Uzun hikaye...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380110
					]
				},
				{
					"id": 721380105,
					"content": "Ne kadar da şüpheli bir durum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380106
					]
				}
			]
		},
		{
