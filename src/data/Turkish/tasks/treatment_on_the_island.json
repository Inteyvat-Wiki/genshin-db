					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380705,
					"content": "Tadı çok kötü. Ama bir zararı yok gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380706
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380706,
					"content": "İlacın yan etkilerini gözlemlemek biraz uzun sürebilir. Bilmiyorum... Hey?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380707
					],
					"speakerTitle": "Yasumoto"
				},
				{
					"id": 721380707,
					"content": "#Bize... Bize doğru geliyorlar! {NICKNAME}! Kurtul şunlardan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasumoto"
