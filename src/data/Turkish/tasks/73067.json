			},
			"dialogs": [
				{
					"id": 730670701,
					"content": "Paimon tahmin yürütmüştü ama... Tüylü Maskeli İblis Kral aslında bir dağ yabanisiymiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670702,
					"content": "Dağ yabanisi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670703
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670703,
					"content": "Evet. \"Tüylü Maskeli İblis Kral\" aslında bir dağ yabanisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670704,
					"content": "Tüm Yağ Dabanileri \"Tüylü Maskeli İblis Kral\" mı yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670705
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670705,
					"content": "Hayır, değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670706,
					"content": "Bu kadarını bilmen yeterli Arashakun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670707
					]
				},
				{
					"id": 730670707,
					"content": "Pekala, Arashakun anlıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670708
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670708,
					"content": "#Nara {NICKNAME} ve Paimon'un yardımıyla Arashakun önden hücum edecek ve yenilmez olacak! O hilekar Tüylü Maskeli İblis Kral bile karşı koyamayacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670709
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670709,
					"content": "Arashakun bugün kocaman bir yazı yazacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670710
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670710,
					"content": "Kocaman bir yazı mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670711
					]
				},
				{
					"id": 730670711,
					"content": "Evet. Kocaman el yazısıyla kocaman bir yazı yazacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670712
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670712,
					"content": "\"Cesaretli\" Arashakun ve utangaç Arashakun iki farklı Aranara gibi sanki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670713,
					"content": "Cesaretsiz Arashakun'un elleri ve kolları zayıf ama cesaretli Arashakun'un bir sürü inanılmaz yeteneği var!",
