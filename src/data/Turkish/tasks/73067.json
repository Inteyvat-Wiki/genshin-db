			"dialogs": [
				{
					"id": 730670301,
					"content": "Yani tüm bunları yazan Aranara \"Arashakun\" mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670302,
					"content": "Bu günlükteki yazılar bir büyüyüp bir küçülüyor. Büyük olanlar iyi ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670303,
					"content": "Açıkçası küçük yazılar Paimon'un gözlerini biraz yoruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670304,
					"content": "Küçük Paimon küçük yazıları okurken zorlanıyor, öyle mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670305
					]
				},
				{
					"id": 730670305,
					"content": "Paimon normal boyuttaki yazıları gayet rahat okuyor! Paimon sadece ufacık yazıları okumaya alışık değil, o kadar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670306,
					"content": "Hımm. Şu Arashakun son sayfaları yazdıktan sonra dönmemiş mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670307,
					"content": "Hadi gidip şu doğudaki mağaraya bir bakalım. Arashakun günlükte cesaretinin ortadan kaybolduğunu yazıyordu. Cesaret sahiden de ortadan kaybolabilen bir şey mi ki? Paimon merak etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7306704,
