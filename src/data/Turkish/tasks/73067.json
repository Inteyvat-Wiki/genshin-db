			},
			"dialogs": [
				{
					"id": 730670201,
					"content": "(İlk birkaç sayfada çok küçük ve zor okunan yazılar var.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670202
					],
					"speakerTitle": "Tutarsız Yazılmış Notlar"
				},
				{
					"id": 730670202,
					"content": "\"Ahh... Arashakun'la arkadaş olmak isteyen bir Nara olduğuna inanamıyorum. Ne kadar iyi bir Nara! İyi Nara utangaç Arashakun'dan rahatsız olmadı. Hatta Arashakun'a Nara kelimelerini nasıl yazacağını bile öğretti.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670203
					],
					"speakerTitle": "Tutarsız Yazılmış Notlar"
				},
				{
					"id": 730670203,
					"content": "\"Arashakun başına düşen bir yapraktan korktuğunda iyi Nara Arashakun'u sakinleştirdi. İyi Nara sonsuza dek Arashakun'un arkadaşı!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670204
					],
					"speakerTitle": "Tutarsız Yazılmış Notlar"
				},
				{
					"id": 730670204,
					"content": "(Sonraki sayfalarda el yazısı gittikçe küçülüp bozuluyor.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670205
					],
					"speakerTitle": "Tutarsız Yazılmış Notlar"
				},
				{
					"id": 730670205,
					"content": "\"Ah olamaz... Tüylü Maskeli İblis Kral, Nara arkadaşımı götürdü! Kolları çok uzundu. Ne kadar korkunç...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670206
					],
					"speakerTitle": "Tutarsız Yazılmış Notlar"
				},
				{
					"id": 730670206,
					"content": "\"Ama Narayı kurtarmalıyım... Ahh...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670207
					],
					"speakerTitle": "Tutarsız Yazılmış Notlar"
				},
				{
					"id": 730670207,
					"content": "(Sonraki sayfalar büyük, sert bir el yazısıyla yazılmış.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670208
					],
					"speakerTitle": "Tutarsız Yazılmış Notlar"
				},
				{
					"id": 730670208,
					"content": "\"Tüylü Maskeli İblis Kral yenildi! Nara arkadaşımı kurtardım. Nara arkadaşım Arashakun'a 'cesaret' verdi! Arashakun artık eski utangaç Arashakun değil.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670209
					],
					"speakerTitle": "Tutarsız Yazılmış Notlar"
				},
				{
					"id": 730670209,
					"content": "\"Arashakun artık 'cesur'. Tüylü maskeli canavarlara karşı cesurca savaştı. Bundan sonra yakınlardaki hiçbir Naranın tüylü maskeli canavarlardan korkmasına gerek kalmayacak!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670210
					],
					"speakerTitle": "Tutarsız Yazılmış Notlar"
				},
				{
					"id": 730670210,
					"content": "(Son sayfalarda el yazısı yine küçülüyor.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670211
					],
					"speakerTitle": "Tutarsız Yazılmış Notlar"
				},
				{
					"id": 730670211,
					"content": "\"Ah olamaz... Neden böyle oldu ki? Arashakun'un cesareti kayboldu. Naranın Arashakun'a verdiği cesaret... Cesaretimi Tüylü Maskeli İblis Kral çalmış olmalı.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670212
					],
					"speakerTitle": "Tutarsız Yazılmış Notlar"
				},
				{
					"id": 730670212,
					"content": "\"Tüylü Maskeli İblis Kralın kolları çok uzun ve çok korkutucu ama Arashakun 'cesaretini' kaybetmişken hiçbir şey yapamaz... Arashakun gidip cesaretini <color=#00E1FFFF>doğudaki mağarada</color> arayacak.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tutarsız Yazılmış Notlar"
				}
			]
		},
