			},
			"dialogs": [
				{
					"id": 730670601,
					"content": "Evet, bu. İşte bu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670602
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670602,
					"content": "\"Cesaret Tılsımı\" bu! Çiçek Arashakun'dan birkaç gün uzak kalınca biraz solmuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670603
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670603,
					"content": "Ama sorun değil! Arashakun bundan sonra onu çok iyi koruyacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670604
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670604,
					"content": "\"Arashakun cesur ve iyi bir Aranara. Utangaç bir Aranara değil!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670605
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670605,
					"content": "#Çok teşekkür ederim Nara {NICKNAME} ve Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670606
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670606,
					"content": "Arashakun'un cesareti geri geldi. Hiçbir şey beni durduramaz! Tüylü Maskeli İblis Kralı daha önce bir kez yendim. Bir daha yeneceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670607
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670607,
					"content": "(Vay be. Arashakun'un tavrı ve yaklaşımı tamamen değişiverdi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670608,
					"content": "#Tüylü Maskeli İblis Kral çok kötülük yaptı. Lütfen benimle gelin Nara {NICKNAME} ve Paimon. Sizin yardımınızla onu mutlaka yeneriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670609
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670609,
					"content": "Arashakun hissedebiliyor. Bugün bu iş sona erecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670610
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670610,
					"content": "#Peki. Hadi gidip şu Tüylü Maskeli İblis Kral neymiş görelim {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7306707,
