			"dialogs": [
				{
					"id": 730670101,
					"content": "Aa, şu dağ yabanileri tuhaf bir şey düşürdü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670102,
					"content": "Çiçeklerden yapılmış gibi duruyor. Tuhaf, bu çiçekler gayet sıradan duruyor. Toplanalı biraz olmuş ama hâlâ solmamışlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670103,
					"content": "Paimon bunun üzerinde yoğun bir Doğa enerjisi olduğunu hissediyor. Hem de buraya öylece atılmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670104,
						730670106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670104,
					"content": "Aranaralara ait herhalde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670105
					]
				},
				{
					"id": 730670105,
					"content": "Evet, olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670108,
					"content": "Hımm. Bu çiçekli şeyde o kadar çok Doğa enerjisi var ki dağ yabanilerinin elindeyken bile solmamış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670109,
						730670110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670109,
					"content": "Belki de hep yanlarında taşımışlardır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670111
					]
				},
				{
					"id": 730670111,
					"content": "Evet. Bunu çabucak o Aranaraya verelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670112,
					"content": "#Hadi eve girelim {NICKNAME}. Belki sahibi bunu kaybettiği için çok üzülmüştür!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670110,
					"content": "Çok değerli bir şey olabilir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670111
					]
				},
				{
					"id": 730670106,
					"content": "Bir Doğa yabanisinin de olabilir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670107
					]
				},
				{
					"id": 730670107,
					"content": "Ne alaka ya? Buralarda yaşayan bir Aranaranın olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670108
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
