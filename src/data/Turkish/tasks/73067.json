			},
			"dialogs": [
				{
					"id": 730670401,
					"content": "Arashakun sen misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670402,
					"content": "*ağlar* Evet, adım Arashakun... Ay! Bir anda o kadar yaklaşmayın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670403
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670403,
					"content": "Beni kurtardığınız için çok teşekkür ederim ama yine de biraz uzak durmanızı isteyeceğim sizden... *ağlar*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670404
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670404,
					"content": "Öyle olursa Arashakun daha rahat hisseder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670405
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670405,
					"content": "Nasıl yani? Az önce hayatını kurtardık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670406,
					"content": "Özür dilerim! Kabalık ediyorum, özür dilerim. Sizi sinirlendirdiğim için de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670407
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670407,
					"content": "Ben burada mahsur kaldım.. Hâlâ da sakinleşemedim. *ağlar* Lütfen beni affedin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670408
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670408,
					"content": "Tamam tamam, sorun değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670409,
					"content": "Peki, teşekkür ederim. Arashakun'a isminizi söyler misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670410
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670410,
					"content": "Ben Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670411,
					"content": "#Ben de {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670412
					]
				},
				{
					"id": 730670412,
					"content": "#Altın Nara {NICKNAME} ve Paimon... Peki Arashakun'un adını nereden biliyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670413
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670413,
					"content": "Evdeki günlükte okuduk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670414
					]
				},
				{
					"id": 730670414,
					"content": "#Altın saçlı Nara {NICKNAME} günlüğü okuyup Arashakun'u aramaya mı geldi? Sonra da mahsur kalan Arashakun'u kurtardı mı? Ne kadar güçlü ve kibar bir Nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670415
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670415,
					"content": "*ağlar* Arashakun cesaretini kaybetmese bu kadar çaresiz olmazdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670416
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670416,
					"content": "Günlükte onu da okuduk. \"Cesaretim kayboldu\" derken ne demek istedin Arashakun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670417,
					"content": "Çok ama çok eski bir hikaye...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670418
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670418,
					"content": "Aylar önce Arashakun aynı şimdiki gibiydi. Cesaretsizdi. O zamanlar geceleri bir dalın kırıldığını bile duysa uyuyamazdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670419
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670419,
					"content": "Tabii utangaç Arashakun'un bile bir Nara arkadaşı vardı. Bu Nara arkadaş, kudretli Nara Varuna gibi değildi belki ama yine de çok iyi bir Naraydı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670420
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670420,
					"content": "Utangaç Arashakun'la hiç alay etmezdi. Arashakun korktuğunda Arashakun'un elini tutardı. Arashakun'un asla unutmayacağı bir arkadaştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670421
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670421,
					"content": "Ancak Tüylü Maskeli İblis Kral bir gün o Narayı kaçırdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670422
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670422,
					"content": "Bir dakika. Şu Tüylü Maskeli İblis Kral kim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670423,
					"content": "Tüylü Maskeli İblis Kral maske takan tüylü bir iblis kral.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670424
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670424,
					"content": "Şey... Peki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670425,
						730670427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670425,
					"content": "Ne olduğunu biliyor musun Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670426
					]
				},
				{
					"id": 730670426,
					"content": "Paimon'un bunu bilmesi imkansız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670429,
					"content": "Tüylü Maskeli İblis Kral, Arashakun'un arkadaşını yakaladı demek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670430,
					"content": "Tüylü Maskeli İblis Kral çok kurnazdı. Düşüncesi bile Arashakun'u ürpertmeye yetiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670431
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670431,
					"content": "*ağlar* Nara arkadaşı kaçırıldığında Arashakun, Tüylü Maskeli İblis Kral tarafından dövülmekten korktu. Yine de Nara arkadaşını bir daha görememek daha korkutucuydu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670432
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670432,
					"content": "O yüzden Arashakun kendini çok zorladı! Gözlerini kapadı! Dişlerini sıktı! Elleriyle vurdu, vurdu, vurdu! Sonra da Nara arkadaşını kurtardı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670433
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670433,
					"content": "Sonra Nara arkadaşı çiçeklerden bir \"Cesaret Tılsımı\" yaptı ve Arashakun'a şöyle dedi: \"Arashakun cesur ve iyi bir Aranara. Utangaç bir Aranara değil!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670434
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670434,
					"content": "O günden sonra Arashakun \"cesaretli\" oluverdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670435
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670435,
					"content": "\"Gözlerini kapadı! Dişlerini sıktı! Elleriyle vurdu, vurdu, vurdu!\" kısmı zaten cesurca değil mi peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670436
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670436,
					"content": "Hayır. Arashakun'un \"cesareti\" Nara arkadaşı verdikten sonra doğdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670437
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670437,
					"content": "İyi ama arkadaşını kurtarman zaten cesurcaymış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670438
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670438,
					"content": "Hayır, hayır. Arashakun Nara arkadaşını kurtarırken çok korktu. Elleri, kolları hep titredi ama \"cesareti\" aldıktan sonra Arashakun'un elleri ve kolları güçleniverdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670439
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670439,
					"content": "Hımm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670440,
						730670441
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670440,
					"content": "Tılsım sadece bir sembolmüş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670442
					]
				},
				{
					"id": 730670442,
					"content": "#*ağlar* Nara {NICKNAME} durumu çok karmaşıklaştırıyor. Arashakun'un cesareti sadece elinde \"Cesaret Tılsımı\" olunca var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670443
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670443,
					"content": "\"Cesareti\" çalındıktan sonra Arashakun, Tüylü Maskeli İblis Kralın mağarasını aramaya geldi. Arashakun, \"cesaretini\" tekrar bulmak için ipucu bulmayı umuyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670444
					],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670444,
					"content": "Ama mağarada Arashakun'un etrafını bodurloplar sardı. Neyse ki Tüylü Maskeli İblis Kral fark etmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670445
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670445,
					"content": "#Bu arada... Şu dağ yabanilerinden aldığımız şeyi hatırlıyor musun {NICKNAME}? Sence tılsım o mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670446
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670446,
					"content": "Kaybettiğin cesareti bulduk galiba Arashakun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670447
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730670447,
					"content": "#Öyle mi? Gerçekten Arashakun'un cesaretini buldunuz mu Nara {NICKNAME} ve Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arashakun"
				},
				{
					"id": 730670441,
					"content": "Cesaret başından beri senin içindeymiş!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670442
					]
				},
				{
					"id": 730670427,
					"content": "Tam bir Aranara cevabı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730670428
					]
				},
				{
					"id": 730670428,
					"content": "Paimon bu Tüylü Maskeli İblis Kralın ne olduğunu anlamadı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730670429
					],
					"speakerTitle": "Paimon"
				}
			]
		},
