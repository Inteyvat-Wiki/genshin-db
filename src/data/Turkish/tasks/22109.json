			"dialogs": [
				{
					"id": 221090101,
					"content": "*iç çeker* Hâlâ yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090102
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221090102,
					"content": "Sorun ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090103
					]
				},
				{
					"id": 221090103,
					"content": "Yine siz ikiniz. Herhalde sizi meşgul tutmaya yetecek kadar lonca görevi yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090104
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221090104,
					"content": "İlginizi çekerse eğer, benim verebileceğim başka bir Görev var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090105
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221090105,
					"content": "Bir grup dağ yabanisi okçusu Guili Ovası'nın ortasında toplanmış, gelip geçenlere sorun çıkarıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090106
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221090106,
					"content": "Sadece dağ yabanisi olsalar da, sayıları çok fazla olduğu için üstün gelebilirler. Sıradan bir maceracı onların karşısında çaresiz kalabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090107
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221090107,
					"content": "Bu okçulardan çabucak ve etkili bir şekilde kurtulmanı istiyorum. Sonrasında seni bekleyen yüklü bir ödeme olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090108
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221090108,
					"content": "Ayrıca yolda kılıçla ilgili herhangi bir şeye rastlarsanız, lütfen bana getirin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090109,
						221090110
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221090109,
					"content": "Görevi alabilirim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090111
					]
				},
				{
					"id": 221090111,
					"content": "Bu görevi üstlenmedeki hevesinin gençliğinin verdiği saflıktan mı, yoksa sınırsız cesaretinden mi geldiğini anlamıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090112
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221090112,
					"content": "Ama bir şeyden eminim, o da gerçek bir Maceracı ruhun olduğu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090115
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221090115,
					"content": "Söyleyeceklerim bu kadar. Şimdi hazırlanma zamanı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221090110,
					"content": "Bu kılıcın dağ yabanileri için önemi ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090113
					]
				},
				{
					"id": 221090113,
					"content": "Hiçbiri. İkisi de birbirinden alakasız. Sadece kılıçla ilgili bir şey var mı diye etrafa bakarolun. Bir şey bulursanız bana getirin, bulamazsanız da sorun yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090114
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221090114,
					"content": "Bu görevin amacı dağ yabanilerini yenmek. Onları yendiğinde ödülünü alabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090115
					],
					"speakerTitle": "Lahn"
				}
			]
		},
