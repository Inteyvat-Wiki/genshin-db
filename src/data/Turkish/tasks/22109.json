			"dialogs": [
				{
					"id": 221090301,
					"content": "Dağ yabanisi okçuları yendin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090302
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221090302,
					"content": "Evet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090303
					]
				},
				{
					"id": 221090303,
					"content": "Aferin. Umarım sana çok zorluk çıkarmamışlardır. Yani çıkardıklarını sanmıyorum, kibarlık olsun diye söyledim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090304
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221090304,
					"content": "Hâlâ kılıçla ilgili bir şey yok mu? *iç çeker* Aman ne sürpriz... Yine başarısız bir arama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090305
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221090305,
					"content": "Yine de teşekkür ederim, işte ödemen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090306
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221090306,
					"content": "Aklın niye sürekli bu kılıçla meşgul?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090307
					]
				},
				{
					"id": 221090307,
					"content": "Sanırım sana söylemekten zarar gelmez. Bu kılıcın adı Görünmez Ustura. Sahibi de abimdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090308
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221090308,
					"content": "Ancak vefat ettiğinde bu kılıç üzerinde çıkmamıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090309
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221090309,
					"content": "Bu kılıç normalde hep yanında olurdu. Her zaman. Yani bu kılıcı ondan alacak bir şey yaşanmış olabileceği gerçeği, o zamandan beri aklımı kurcalıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090310
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221090310,
					"content": "Ne yazık ki kılıcın nerede olabileceğiyle ya da abimin ölmeden önce neyle karşılaştığıyla ilgili hiçbir ipucu bulamadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090311
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221090311,
					"content": "Durum bu. İyi günler demekten başka söyleyeceğim bir şey yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lahn"
				}
			]
		}
	]
