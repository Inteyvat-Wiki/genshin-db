			"dialogs": [
				{
					"id": 221090201,
					"content": "Dağ yabanisi okçuları yendin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090202
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221090202,
					"content": "Henüz değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221090203
					]
				},
				{
					"id": 221090203,
					"content": "Göreve çok dikkatle hazırlandığın için mi, yoksa oyalandığından mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221090204
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221090204,
					"content": "Yoksa ikisinden de azar azar mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lahn"
				}
			]
		},
