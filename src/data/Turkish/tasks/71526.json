			},
			"dialogs": [
				{
					"id": 716663001,
					"content": "Kediler ve köpekler nasılsa Hayalet Böcekler de bizim dostumuz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663002
					],
					"speakerTitle": "Tatlı Bela"
				},
				{
					"id": 716663002,
					"content": "Yine mi bir çocuk? Of, geçen sefer de aynısını yaşamadık mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663003
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716663003,
					"content": "Yani evet ama Büyük Usta Hanakado da çocuk. Üstelik geçen seferki diğer çocuklardan biri de iyi dövüşmüştü. Demek ki böcek dövüşü yeteneğinin yaşla bir ilgisi yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663004,
					"content": "Aslında... Tatlı Bela'nın daha önce böcek dövüşü deneyimi olmamış ama seçtiği Hayalet Böcekte çok cesur bir savaşçı havası var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663005
					],
					"speakerTitle": "Büyük Usta Hanakado"
				},
				{
					"id": 716663005,
					"content": "Ne diyorsunuz, anlamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663006
					],
					"speakerTitle": "Tatlı Bela"
				},
				{
					"id": 716663006,
					"content": "Hayalet Böceğimi bana babam hediye etti. Son gezisinde tanıştığı bir arkadaşı vermiş ona da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663007
					],
					"speakerTitle": "Tatlı Bela"
				},
				{
					"id": 716663007,
					"content": "Oo, baban da ne iyi bir adammış!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663008
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716663008,
					"content": "Peki o zaman, bu dövüşü Gök Yaran Beyaz Demir Eflatun Kavun'a verelim. Zorbalık söylentileri yayılsın istemeyiz sonra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663009
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716663009,
					"content": "Bizim ekibin en zayıf halkası Paimon'muş gibi konuştun sanki ama neyse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663010,
					"content": "Paimon en güvenilir tercih muhtemelen... Çünkü siz iki manyak rekabete kendinizi kaptırınca hem kendinize hem çevrenize tehlike teşkil ediyorsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663011,
					"content": "Gerilme genç hanım! Alt tarafı bir oyun, eğlenmeye bak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
