				]
			},
			"dialogs": [
				{
					"id": 716663101,
					"content": "Of... Paimon az kalsın batırıyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663102,
					"content": "Az kalsın kalpten gidiyordum! O küçük canavar ne fenaymış! Ben bile çok zorlanırdım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663103
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716663103,
					"content": "Bu kadar iyi dövüşmeyi sıfır eğitimle nasıl öğrendin? Liyue'de herkes savaşçı falan mı doğuyor, nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663104
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716663104,
					"content": "Hayalet Böcekler birbirleriyle böyle mi oynuyormuş? Şimdi anladım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663105
					],
					"speakerTitle": "Tatlı Bela"
				},
				{
					"id": 716663105,
					"content": "Biraz daha oynayalım mı? Ayrıca ben sizi de oynarken izlemek istiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663106
					],
					"speakerTitle": "Tatlı Bela"
				},
				{
					"id": 716663106,
					"content": "Tatlı Bela doğuştan yetenekli çıktı... Biraz korkunç!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663107,
					"content": "Boşboğaz, sende böyle bir yetenek olsaydı sırf Guoba'nın Kristal Kasırga'yla konuşmasını dinleyerek kabuklu canlılarla iletişim kurabilmeyi öğrenirdin muhtemelen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716663108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716663108,
					"content": "Ha... Haha... Evet, keşke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
