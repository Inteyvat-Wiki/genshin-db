					"Yae Miko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120420101,
					"content": "Birilerinin morali bozulmuş. Tahmin edeyim, yine zor durumda kaldınız ve benim çözmemi istiyorsunuz değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420102
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420102,
					"content": "Ne kadar şanslı olduğunuzun farkındasınızdır umarım. Başkası olsa birkaç seferden sonra gülümseyerek selam verecek sabrım kalmazdı herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420103
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420103,
					"content": "Ama sen hep gülüyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120420104,
					"content": "Lafın gelişi öyle dedim. Anladın mı? Lafımda kusur arıyorsun. Bu ne küstahlık?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420105
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420105,
					"content": "Konuya gel Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420106
					]
				},
				{
					"id": 120420106,
					"content": "Ha, evet! Çok önemli bir şey oldu! Ei... Şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120420107,
					"content": "Yae Miko'ya olanları anlatıyorsunuz.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						120420108
					]
				},
				{
					"id": 120420108,
					"content": "Peki, anladım. Demek Ei, Inazuma'yı insanlara bırakmaya karar verip ne zaman biteceği belli olmayan zor bir savaşa girdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420109
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420109,
					"content": "Çok inatçı. Akla gelebilecek en aşırı yöntem neyse hemen onu seçiyor. Sadece iradesiyle işin içinden çıkabileceğini sanıyor. Hem de yeteneğini sonuna kadar kullanmazsa başarısız olacağı, neredeyse imkansız bir amaç için. Ei böyledir işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420110
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420110,
					"content": "Hep böyle olduğunu benim kadar iyi biliyorsunuz. Niye şimdi dert etmeye başladınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420111,
						120420112
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420111,
					"content": "Bu düello şu ana kadarki her şeyden daha ciddi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420113
					]
				},
				{
					"id": 120420113,
					"content": "Düşünmeden mi girişti? Hehe, haklısın. Bazen çocuk gibi davranır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420114
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420114,
					"content": "Yardım edebileceğimi düşündünüz sanırım ama bana danışma fikri nereden çıktı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420115
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420115,
					"content": "Salağa mı yatıyor? Bilerek yaptığına eminim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120420116,
					"content": "Öğreniyorsun ufaklık. Ama Makoto Raiden'ın zihin diyarını ben de sizin kadar biliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420117
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420117,
					"content": "Sadece Kutsal Kiraz Ağacının temelinin orası olduğu biliyorum. Bir de Ei'in \"Zihnin Dinlenme Yeri\"nden biraz farklı olduğunu duydum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420118
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420118,
					"content": "Makoto Raiden artık hayatta olmadığı için mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120420119,
					"content": "Sadece o yüzden değil. O yerin doğası da nedense çok farklı. Sadece tahmin yürütebiliyorum tabii. Oraya giden sizsiniz. Siz anlatın. Nasıldı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420120,
						120420121
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420120,
					"content": "Ben bir fark göremedim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420122
					]
				},
				{
					"id": 120420122,
					"content": "Neyse, detaylara o kadar çok takılmayalım. İleride bir şeyleri açıklamak biraz daha zor olur sadece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420123
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420123,
					"content": "O zaman beni takip edin. Girişe gidelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420121,
					"content": "Dikkat etmiyordum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420122
					]
				},
				{
					"id": 120420112,
					"content": "Düşünmeden girişti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420113
					]
				}
			]
		},
		{
			"id": 1204202,
			"completionStepIds": [
				1204204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1204204",
							"2"
						],
						"stepId": 1204204,
						"stateName": "QUEST_STATE_UNFINISHED"
