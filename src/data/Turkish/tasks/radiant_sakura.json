					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						120420502
					]
				},
				{
					"id": 120420502,
					"content": "Böylece şimdiki Ei, zihin diyarına Kutsal Kiraz Ağacını dikti ve ağacın kökleri Inazuma'nın geçmişini gösterdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420503
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420503,
					"content": "Ne açıdan bakarsan bak epey etkileyici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420504
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420504,
					"content": "Tüm bunlar Makoto'nun gücü sayesinde oldu. Onun sonsuzluk anlayışı benimkinden çok daha geniş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420505
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420505,
					"content": "Sonsuzluk, zamanla yakından ilgili olan bir kavram. Sonsuzluğa dokunduğunda zaman kavramı bulanıklaşır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420506
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420506,
					"content": "Orada harika şeyler gördüm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420507
					]
				},
				{
					"id": 120420507,
					"content": "Zaman aynı anda hem ileri hem geri akıyordu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420508
					]
				},
				{
					"id": 120420508,
					"content": "Zamanın anlamsız ve mantık dışı olduğu bir yer... Hissettiğim \"düzensizlik\" buymuş demek ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420509
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420509,
					"content": "Belki de zamanda tam bu ana sorunsuz bir şekilde dönebilmenin sebebi de budur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420510
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420510,
					"content": "Gerçi o his artık tamamen kayboldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420511
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420511,
					"content": "Henüz durumu tam olarak anlayamadım fakat içgüdülerim bana her şeyin sebebinin... O tohum olduğunu söylüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420512
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420512,
					"content": "Hımm, Makoto'nun gücü bu kadarını yapabilir mi emin değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420513
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420513,
					"content": "Ne demek istediğini anlıyorum. Belki de gerçekten yardım eden daha ulvi bir{RUBY#[S]Istaroth} güç vardı. Yine de ne olursa olsun Makoto'nun bulduğu çözüm hepimizi kurtardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420514
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420514,
					"content": "Kutsal Kiraz Ağacı olmasaydı Inazuma büyük ihtimalle asırlar önce çıkan o felaketin ve pisliğin içinde boğulmuş olurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420515
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420515,
					"content": "Sen hep Kutsal Kiraz Ağacının özel bir tarafı olduğunu söylerdin, farkındayım ama bana göre o ağaç zaten hep oradaydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420516
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420516,
					"content": "Geçmişte bana Kutsal Kiraz Ağacı ve Makoto'nun bilinci arasında bir bağ olduğunu kanıtlamaya çalışmıştın. Gerçi bir türlü ikna edememiştin, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420517
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420517,
					"content": "Doğru ama şimdi neden edemediğimi anlıyorum. O sırada Kutsal Kiraz Ağacı henüz dikilmemişti bile, o yüzden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420518
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420518,
					"content": "Şey, peki sizce de o ağaç şu anda olduğundan daha farklı görünmüyor muydu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120420519,
					"content": "Kutsal Kiraz Ağacı tapınakta olduğu için benim gözetimim altında. Elbette keyfime göre budayacağım, ne sandın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420520
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420520,
					"content": "Hah... Demek bu da senin başının altından çıktı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120420521,
					"content": "Şaka yapıyorum. Bu ağaç filizlendiği günden beri çok şey görüp geçirdi. Bugünkü görünüşünü ağaçla yıllardır ilgilenen sevgi dolu Kitsunelere borçluyuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420522
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420522,
					"content": "Ben de üstüme düşeni yaptım tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420523
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420523,
					"content": "O diyardan geri döndüğünüz andan yeniden içeri girdiğiniz ana kadar çok az vakit geçti diyebilirim. Yine de o kısa süre içinde yüzyıllarca devam eden bir dövüş gerçekleşti diyorsunuz yani, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420524
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420524,
					"content": "Gezgin... Sen o sırada içinden kendi kendine dileklerini tekrarlıyordun herhalde, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420525,
						120420526
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420525,
					"content": "Evet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420527
					]
				},
				{
					"id": 120420527,
					"content": "O sırada Ei'in nerede olduğunu hissedebiliyordum ama bulunduğu yerdeki zaman akışında anormallik olduğunun da farkındaydım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420528
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420528,
					"content": "Yani zaman, Ei'i arayışımıza yepyeni bir boyut kazandırdı diyebiliriz. Sadece bulunduğu yeri bilmemiz yeterli değildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420529
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420529,
					"content": "Neyse ki iraden yeterince güçlüydü ve düzensizlik seni, dileklerinin kesişme ihtimali en yüksek olan noktaya götürdü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420530
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420530,
					"content": "Düzensizliğin akışı Makoto'nun etkisi olabilir tabii fakat eninde sonunda Ei'e yardım edebilmek için herkesin ortak bir çaba göstermesi gerekti. O yüzden size bir teşekkür borçluyuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420531
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420531,
					"content": "Yani... Oraya son düello sırasında varmamız bir tesadüf değil miydi? En başından beri olanlara zaten şahitlik etmemiz gerekiyordu, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420532,
						120420533
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120420532,
					"content": "Belki Şogun da bunu kastetmiştir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420534
					]
				},
				{
					"id": 120420534,
					"content": "Zamanın akışı içeride de dışarıda da aynı sanıyordum. O yüzden Gezgin bir anda yeniden belirdiğinde gerçekten çok şaşırdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420535
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420535,
					"content": "\"Yoksa Inazuma'nın başına bir felaket mi geldi?\" diye düşündüm hemen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420536
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420536,
					"content": "Oysaki beni kurtarmaya gelmişsiniz... Sayenizde bu durum mümkün olan en iyi sonla bitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420537
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420537,
					"content": "İkinize teşekkür borçluyum. Benim için yaptığınız şeylerin haddi hesabı yok... Asla unutmayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420538
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420538,
					"content": "Şu an nasıl hissediyorsun Ei?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420539
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420539,
					"content": "Vücudum tamamen iyileşti diyebilirim. Şogun'un iradesi de artık bana karşı koymuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420540
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420540,
					"content": "Sağlığın yerinde olduğu için mutluyum tabii ama duygusal açıdan nasıl hissediyorsun demek istemiştim. Sakinleşebildin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420541
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420541,
					"content": "Sonuçta orada Makoto'yu gördün, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420542
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420542,
					"content": "Gördüm diyemem... Sadece sesini duydum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420543
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420543,
					"content": "İyi olacağım. Elbette bu olanlar bana bazı anılarımı hatırlattı ama artık geleceğe odaklanmaya karar verdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420544
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420544,
					"content": "Ancak bu durum bana Makoto'nun ne kadar zeki biri olduğunu bir kez daha hatırlattı. Inazuma'nın geleceğinde meydana gelebilecek her türlü olayı yıllar öncesinden öngörebilmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420545
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420545,
					"content": "Benim çocukça davranma ihtimalimi bile planına dahil etmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420546
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420546,
					"content": "Inazuma'nın bugünlere gelmesini ona borçluyuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420547,
						120420548
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420547,
					"content": "Makoto harika biriymiş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420549
					]
				},
				{
					"id": 120420549,
					"content": "Ben sadece bir tohum ektim, o kadar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420550
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420550,
					"content": "Senin iraden de bu iş için zaruriydi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420551
					]
				},
				{
					"id": 120420551,
					"content": "Evet! Yaptıkların sayesinde onu tekrar görme fırsatın oldu. Harika bir şey bu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420552,
						120420553
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120420552,
					"content": "Belki son aşama kolaydı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420554,
						120420555
					]
				},
				{
					"id": 120420554,
					"content": "Neden ve sonucun sırası tersine dönmüş olabilir ama...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420556
					]
				},
				{
					"id": 120420556,
					"content": "#Teşekkür ederim {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420557
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420557,
					"content": "Bugün Inazuma ve sen nihayet yüzyılların üzerinize düşürdüğü karanlıktan kurtuldunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420558
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420558,
					"content": "Makoto ile ikiniz Inazuma'nın geçmişi ve geleceğisiniz. Inazuma'nın ikinize de ihtiyacı var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420559
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420559,
					"content": "Senden böyle teselli edici sözler duymaya alışık değilim. Teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420560
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420560,
					"content": "Hah, eskiden hiçbir lafımı dinlemezdin ki. O yüzden nadir olduğunu düşünüyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420561
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420561,
					"content": "Makoto da aynı şeyi söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420562
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120420562,
					"content": "Aklın yolu birdir işte. Birkaç günlüğüne de olsa Şogun rolünü üstlenebilecek kadar nitelikli olduğumun bir göstergesi mi bu acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420563
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420563,
					"content": "Ay, neyse, vazgeçtim. Zahmete girmeye değmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420564
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420564,
					"content": "Artık sohbeti burada bitirmemiz lazım. Daha yapılması gereken çok iş var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420565
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420565,
					"content": "Şogun ve ben Inazuma'nın şu anki halini yakından inceleyip işlerin ne durumda olduğuna bakacağız. Ardından gelecek hakkında düşünmeye başlayacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420566
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420566,
					"content": "Ondan sonra da... Sakoku Fermanını yürürlükten kaldıracağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420567
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420567,
					"content": "Gerçekten mi? Bu çok önemli bir gelişme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420568
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120420568,
					"content": "Artık durağanlık ile tanımlanan bir sonsuzluğun peşinde değilim. O yüzden ulusu kilit altında tutmanın da bir anlamı kalmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420569
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420569,
					"content": "İleride Inazuma'nın geçmesi gereken pek çok imtihan olacağından şüphem yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420570
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420570,
					"content": "Yine de bu imtihanlardan yeni fırsatlar doğacak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420571
					]
				},
				{
					"id": 120420571,
					"content": "Heyecanla bekliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420555,
					"content": "Bu süreçte oynadığın rolü küçümsememelisin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420556
					]
				},
				{
					"id": 120420553,
					"content": "Yine de o noktaya kadar gelebilmek yoğun bir çabanın sonucuydu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420554,
