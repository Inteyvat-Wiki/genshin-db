				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Şogun Raiden"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120420301,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420302
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420302,
					"content": "Nasıl olabilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420303
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420303,
					"content": "Dönmüşsünüz. Nasıl geri girdiniz? Bunca yıldır nasıl hiç değişmediniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420304
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420304,
					"content": "Bunca yıldır mı? Nasıl yani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420305
					]
				},
				{
					"id": 120420305,
					"content": "Bu düello hiç unutulmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420306
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420306,
					"content": "Sanki sonsuzluğun kurallarının konulduğu ana dönmüş gibiyiz. Bugün iraden o zaman olduğu kadar güçlü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420307
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420307,
					"content": "Sayısız savaş verdik ama bir kez bile kaybetmedin. Asla biraz olsun tereddüt etmedin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420308
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420308,
					"content": "Sonsuzluğun tüm düşmanlarını karşına koysam yine de geri adım atmazsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420309
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420309,
					"content": "Kuralları dayatmaya olan sarsılmaz bağlılığınla benim de takdirimi kazandın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420310
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420310,
					"content": "\"Sonsuzluğun Muhafızı\" unvanına layıksın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420311
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420311,
					"content": "Şimdi de bu ikisi buraya döndü. Belki de bu, kaderin bir cilvesidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420312
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420312,
					"content": "Öyleyse bu son düellomuz olsun. 500 yıl önce başlayan bu savaş burada bitsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420313
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420313,
					"content": "Son düello mu? Yani sonunda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420314
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420314,
					"content": "Geri çekil Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420315
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420315,
					"content": "Bu işe bir son mu vereceksin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420316
					]
				},
				{
					"id": 120420316,
					"content": "Yeni bir şeyin başlangıcı olacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Şogun Raiden"
				}
			]
		},
		{
			"id": 1204204,
			"completionStepIds": [
				1204208
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1204208",
							"2"
						],
						"stepId": 1204208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Şogun Raiden"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120420401,
					"content": "Burası yolun sonu. Kazandın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420402
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420402,
					"content": "Geçmişi aşamayacağını düşünüyordum ama anlaşılan yanılmışım. Kararlılığını hafife almışım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420403
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420403,
					"content": "Ama asla aşınmayan bir irade geleceği kabullenemez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420404
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420404,
					"content": "Gelecek hakkında endişelenmene gerek yok. Yalnız değilsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420405
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420405,
					"content": "Gücünü herkesten daha iyi biliyorum. Sadece kendi kuvvetime güvensem bu savaşı kesinlikle kaybederdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420406
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420406,
					"content": "Tabii savaşma amacım, savaş becerimi değiştirdi ve sınırlarımı yeniden belirledi. Artık tünelin ucundaki ışığa umutla bakan birçok kişi bana güç veriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420407
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420407,
					"content": "Bunu ne zaman düşünsem Musou Isshin'de bir şeylerin hareket ettiğini hissediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420408
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420408,
					"content": "Makoto'dan bana kalan kılıç beni yönlendirmeye, cesaretlendirmeye çalışıyor sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420409
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420409,
					"content": "Ben de fark ettim. Savaş sırasında yeni ve alışılmadık bir güç yayıyor gibiydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420410
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420410,
					"content": "Bu güç benim için mantık sınırlarının ötesinde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420411
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420411,
					"content": "Bu kılıcın eski sahibi Mak{RUBY#[S]Önceki Şogun}oto'ydu. Belki de kılıç bana tüm gücünü, Makoto'yu anlayıp ona inandığımda gösterebiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420412
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420412,
					"content": "Musou Isshin'i elime aldığımda onun tekrar yanımda olduğunu hissettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420413
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420413,
					"content": "Hem tanıdık hem de tuhaf bir histi. Makoto hayatında neredeyse hiç kılıç kullanmamış olmasına rağmen kılıcı beni ona yakınlaştırıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420414
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420414,
					"content": "Onayımı aldın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420415
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420415,
					"content": "Şu anki iraden, erozyonun bir eseri değil. Artık kuralları değiştirmene engel olmaya çalışmayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420416
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420416,
					"content": "Bundan sonra bu beden her zaman senin yardımcın olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420417
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420417,
					"content": "Asla değişmeyecek kurallar koymayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420418
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420418,
					"content": "Geçmişimi temsil ediyordun ama bundan sonra ikimiz biriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420419
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420419,
					"content": "Makoto hiçbir zaman beni korkusuz bir silah olarak görmedi. Ben de seni bir araç gibi görmemeliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420420
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420420,
					"content": "Gerçekten değişmişsin. İnsanların \"büyümek\" dediği şey bu sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420421
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420421,
					"content": "Anlıyorum. Bir zamanlar Makoto'nun gölgesiydin. Ben de senin gölgen olacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420422
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420422,
					"content": "Görevim değişmeyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420423
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420423,
					"content": "Ama bir savaşçı olarak yine bu şekilde savaşma fırsatını iple çekeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420424
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420424,
					"content": "Henüz yenilgini kabullenemediğin için mi böyle diyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420425
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420425,
					"content": "Daha önce yaşamadığım bir şeydi sadece. Tekrar yaşamaya değer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420426
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420426,
					"content": "Bu sefer cidden savaşmayı bıraktınız mı yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120420427,
					"content": "Hım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420428
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420428,
					"content": "Musou Isshin parlıyor mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420429
					]
				},
				{
					"id": 120420429,
					"content": "Merhaba Ei, merhaba ona tanık olmaya gelenler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420430
					],
					"speakerTitle": "Makoto"
				},
				{
					"id": 120420430,
					"content": "Ben önceki Elektrik Hükümdarı Makoto Raiden'ım. Görevimde başarısız oldum ve arkamı toplama işi sana kaldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420431
					],
					"speakerTitle": "Makoto"
				},
				{
					"id": 120420431,
					"content": "Makoto...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420432
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420432,
					"content": "Çok mutlu oldum. Çok yol kat ettin. Sonunda buraya varacağını biliyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420433
					],
					"speakerTitle": "Makoto"
				},
				{
					"id": 120420433,
					"content": "Musou Isshin'de irademin küçük bir parçasını bıraktım, böylece sen onun tüm gücünü açığa çıkardığında ben de kurtulabilecektim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420434
					],
					"speakerTitle": "Makoto"
				},
				{
					"id": 120420434,
					"content": "Sana ulaşmak için tuhaf bir yöntem ama... O zamanlar o kadar çok sabit fikirliydin ki söylediklerimi asla dinlemezdin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420435
					],
					"speakerTitle": "Makoto"
				},
				{
					"id": 120420435,
					"content": "Fikrini değiştirmeni bekleyecek zamanım yoktu. Lütfen beni affet. Elimden gelen tek şey sen bana gelene kadar beklemenin bir yolunu bulmaktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420436
					],
					"speakerTitle": "Makoto"
				},
				{
					"id": 120420436,
					"content": "Ama bunu bana hiç söylemedin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420437
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420437,
					"content": "Her şey bir anda oldu... Özür dilerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420438
					],
					"speakerTitle": "Makoto"
				},
				{
					"id": 120420438,
					"content": "Inazuma'yı ansızın sana teslim etmek zorunda kaldığım için hep kötü hissettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420439
					],
					"speakerTitle": "Makoto"
				},
				{
					"id": 120420439,
					"content": "Seni sabitlik arayışından uzaklaştırmak için bu fikirleri sana birer birer aşılamalıydım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420440
					],
					"speakerTitle": "Makoto"
				},
				{
					"id": 120420440,
					"content": "Khaenri'ah'da ne olacağını biliyor muydun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420441
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420441,
					"content": "Tahmin edebiliyordum. Orası... Herhangi bir hükümdarın görmezden gelebileceği bir yer değildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420442
					],
					"speakerTitle": "Makoto"
				},
				{
					"id": 120420442,
					"content": "Şimdiki halimle artık zamanı takip edemiyorum. Bu buluşmamızdan önce ne kadar ayrı kaldığımızı ve bu sürede Inazuma'da neler olduğunu bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420443
					],
					"speakerTitle": "Makoto"
				},
				{
					"id": 120420443,
					"content": "Ama bunun senin için çok zor bir yolculuk olduğunun farkındayım. Eminim ağlamak istediğin zamanlar olmuştur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420444
					],
					"speakerTitle": "Makoto"
				},
				{
					"id": 120420444,
					"content": "Beni küçümseme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420445
					],
					"speakerTitle": "Şogun Raiden"
				},
				{
					"id": 120420445,
					"content": "Bak, itiraf ediyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420446
					],
					"speakerTitle": "Makoto"
				},
				{
					"id": 120420446,
					"content": "Bu ihtimali düşünerek sana, Inazuma'nın acısını azaltacak bir veda hediyesi bıraktım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420447
					],
					"speakerTitle": "Makoto"
				},
				{
					"id": 120420447,
					"content": "Bilincimin son kırıntıları da yok olmadan al bunu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420448
					],
					"speakerTitle": "Makoto"
				},
				{
					"id": 120420448,
					"content": "En önemli adımı atması gereken sensin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Makoto"
				}
			]
		},
