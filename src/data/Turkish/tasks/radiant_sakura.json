				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yae Miko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120420201,
					"content": "Şimdi... Her zaman kendi yöntemim vardır. Ne kadar yaratıcı olmam gerektiğine göre değişir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420202
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420202,
					"content": "Yabancılar için zihin diyarı çok soyut bir kavram. Neyse ki ben Ei'in hizmetkarıyım. Bu sayede nerede olduğunu hissedebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420203
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420203,
					"content": "Yani bu diyarın tam olarak nerede olduğunu bilemesem de sizi Ei'in yanına gönderebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420204
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420204,
					"content": "Yani soyut ama bir yeri mi var? Nerede olduğunu bilmiyorsun ama bizi oraya gönderebiliyorsun. Nasıl yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120420205,
					"content": "Evet. Anlamaya çalışmana gerek yok. Basitçe anlatayım. Şu an Ei kaos içinde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420206
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420206,
					"content": "Her şey karmaşık ve düzensiz. Zorla girmeye çalışırsanız dev bir dalga sizi alıp zamanın ve mekanın bilinmez bir yerine atabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420207
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420207,
					"content": "Bu sebeple Zihnin Dinlenme Yerine girmeden önce bilincinizi fiziksel bir nesneye yerleştirmek çok daha güvenlidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420208
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420208,
					"content": "Ne? Peki. Paimon burada kalacak o zaman. İkiniz girebilirsiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420209,
						120420210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120420209,
					"content": "Rüyanda görürsün.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420211
					]
				},
				{
					"id": 120420211,
					"content": "Sen bilirsin. En kötü ihtimalle Ei'i kaybederiz. Çok da büyük bir sorun değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420212
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420212,
					"content": "Ya... Off! Paimon ikinize de dayanamıyor artık! Peki. Paimon da gelecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120420213,
					"content": "Öyle mi? Peki, son kararınsa tamam. Şimdi sizi oraya göndereceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420214
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420214,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420215
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420215,
					"content": "Hımm. Acaba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420216
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420216,
					"content": "Ne oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420217
					]
				},
				{
					"id": 120420217,
					"content": "Hiç. Sadece normalde olduğundan daha çok kaos var gibi. Şüphelerim doğruymuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420218
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420218,
					"content": "Bu arada... İçerideyken her zaman en içten dileklerinize odaklanmayı unutmayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420219
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420219,
					"content": "Soyut mekanın dev dalgalarında kaybolmaktan sadece güçlü bir iradeyle kurtulabilirsiniz. Sizi doğru yere götürebilmem için yeterince güçlü olmanız gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420220
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420220,
					"content": "Tamam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420221
					]
				},
				{
					"id": 120420221,
					"content": "Peki o zaman. Kapı açık. Geçin bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420222
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420222,
					"content": "Ben dışarıda kalıp sabit tutmaya çalışacağım. Bir şey olursa karşılık vermeye hazırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420223
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420223,
					"content": "#Tanrımı sana emanet ediyorum {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420224
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420224,
					"content": "Benim için, Inazuma için lütfen onu geri getir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420225
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420225,
					"content": "Umarım ne yapacağını biliyorsundur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120420226,
					"content": "Başarısız olmayacağız.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420227
					]
				},
				{
					"id": 120420227,
					"content": "Bu kadar muhabbet yeter. İşe koyulun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120420210,
					"content": "Beni terk etmeyeceksin değil mi Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420211
					]
				}
			]
		},
		{
