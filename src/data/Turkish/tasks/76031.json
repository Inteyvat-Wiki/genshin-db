			"dialogs": [
				{
					"id": 760310301,
					"content": "... Bu yeterli. Sağ ol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310302
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310302,
					"content": "İster gündüz ister gece vakti, ay ışığı bir araya getirsin bizi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310303
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310303,
					"content": "... Hımm? Bu söz son duyduğumdan bu yana değişmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310304
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760310304,
					"content": "Hah! Yanındaki gitti. Acele edin, fırsat bu fırsat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310305,
					"content": "Leydi Lauma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310306
					],
					"speakerTitle": "Maciej"
				},
				{
					"id": 760310306,
					"content": "Cidden mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310307,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310308
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310308,
					"content": "... Emekleriniz için sağ olun. İzninizle. Birazdan döneceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310309
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310309,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310310
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310310,
					"content": "Etrafta kimse yok. Çıkabilirsiniz artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310311
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310311,
					"content": "Burada olduğumuzu biliyor muydun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310312,
					"content": "\"Kuu{RUBY#[S]Ay Hanımı}tar\"ı ve onun Kuuvahkisini hissetmemem mümkün mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310313
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310313,
					"content": "Ancak... Beni neden takip ettiğinizi anlamadım. Çalışırken \"izlenmek\" biraz gericiymiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310314
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310314,
					"content": "Şey... Pardon. Sana sormak istediğimiz bir şey vardı ama fırsat bulamadık bir türlü... Paimon seni çok strese sokmamışızdır diye umuyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310315,
					"content": "Anladım... Tamamdır. Ben halledeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310316
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310316,
					"content": "Açıkçası ne kadar meşgul olduğunu gördükten sonra, senden daha fazla iş yapmanı istemek Paimon'u kötü hissettirecek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310317,
					"content": "Hiç sorun değil. Ay İlahicisinin görevi bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310318
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310318,
