			"dialogs": [
				{
					"id": 760310101,
					"content": "Columbina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310102,
					"content": "Zzz... Zzz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310103
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760310103,
					"content": "Şekerleme yapıyor galiba. Daha sonra gelelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310104,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310105
					],
					"speakerTitle": "Şık Porsuk"
				},
				{
					"id": 760310105,
					"content": "Dur, bekle! Oraya gitme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310106,
					"content": "... Of!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310107
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760310107,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310108
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760310108,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310109
					],
					"speakerTitle": "Şık Porsuk"
				},
				{
					"id": 760310109,
					"content": "Ayağın mı kaydı? Merak etme, yaralanmadım. Hım? Aa, siz de gelmişsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310110
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760310110,
					"content": "Ay Tanrıçası da olsan canın yanabiliyormuş demek ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310111,
					"content": "Yaydıkları Kuuvahki kötü niyet taşımadığı sürece küçük yaratıkların bana çarpmasından rahatsız olmuyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310112
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760310112,
					"content": "Bir şey mi oldu? Neden bu kadar korktun ufaklık?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310113
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760310113,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310114
					],
					"speakerTitle": "Şık Porsuk"
				},
				{
					"id": 760310114,
					"content": "Hım, anladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310115
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760310115,
					"content": "Aa, bu hayvanların dediklerini de anlayabiliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310116,
					"content": "Ay, Nod-Krai'ın üzerinde parlıyor. Kuuvahkinin ışığının altında büyüyen tüm hayvanlar \"Ay Tanrıçası'nın yoldaşları\" sayılır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310117
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760310117,
					"content": "Ee, bu ufaklık ne dedi peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310118,
					"content": "Yaşadığı yerde canavarlar belirmiş. Lauma'yı aramaya çıkmış ama canavarlar onu buraya kadar kovalamış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310119
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760310119,
					"content": "Aaa... Bu kadar korkmasına şaşmamalı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310120,
					"content": "Onu nereye götüreceğiz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760310121
					]
				},
				{
					"id": 760310121,
					"content": "Lauma'ya götürmek en iyisi olur sanırım. O ne yapacağını bilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310122
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760310122,
					"content": "Bize yine yol göründü. Kendini iyi sakla ama, tamam mı? Donuk Ayın Çocuklarına gidiyoruz ne de olsa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
