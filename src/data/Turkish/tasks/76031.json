			"dialogs": [
				{
					"id": 760310201,
					"content": "... İyi fikir. Birazdan Kunegunda'dan meyve getirmesini rica ederim. Önümüzdeki iki gün boyunca dinlenmesi gerekecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310202
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310202,
					"content": "Lauma meşgul duruyor. Biraz bekleyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310203,
					"content": "Uzun yıllar önce, Donuk Ayın Çocukları için Ay İlahicisinin ne kadar önemli olduğunu fark ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310204
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760310204,
					"content": "Hatta görevinin bir tanrınınkinden bile daha zor olduğunu düşünüyorum bazen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310205
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760310205,
					"content": "Sonunda boş kalabildi! Hadi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310206,
					"content": "Hanımım, şuradaki savunma yapılarına bakmanız gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310207
					],
					"speakerTitle": "Vanamo"
				},
				{
					"id": 760310207,
					"content": "Tabii. Hemen ilgileneceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310208
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760310208,
					"content": "Yine gidiyor! Hiç dinlenmeye fırsat bulamıyor, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760310209,
					"content": "Peşlerinden gidelim. Ama sessiz olun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
