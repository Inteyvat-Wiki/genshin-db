			},
			"dialogs": [
				{
					"id": 727340101,
					"content": "Disiplinsiz, kaba, basit, yavan ve tamamen plansız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340102
					],
					"speakerTitle": "Tefeci Büyücü"
				},
				{
					"id": 727340102,
					"content": "Hey, neden şikayet edip duruyorsun? Bir düşüneyim, tüm takım arkadaşların yenildiği için mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340103
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727340103,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340104
					],
					"speakerTitle": "Tefeci Büyücü"
				},
				{
					"id": 727340104,
					"content": "Dövüş tarzından bahsediyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340105
					],
					"speakerTitle": "Tefeci Büyücü"
				},
				{
					"id": 727340105,
					"content": "Ne? Bir Uçarlop kafana falan mı çarptı yoksa? Burası bir sirk değil dostum! Tarzımı mı görmek istiyorsun? Muazzam güç, sarsılmaz irade ve yenilmez böcekler benim tarzımdır! İstersen sana ücretsiz bir deneyim sunabilirim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340106
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727340106,
					"content": "Of, kötü hatıralarımı canlandırdın... Senin gibi gürültülü ve çirkin tiplerle uğraşmayı hiç sevmem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340107
					],
					"speakerTitle": "Tefeci Büyücü"
				},
				{
					"id": 727340107,
					"content": "Ama bu sarışın oldukça yaklaşılabilir görünüyor... Ona meydan okuyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340108
					],
					"speakerTitle": "Tefeci Büyücü"
				},
				{
					"id": 727340108,
					"content": "Hahahahahahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340109
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727340109,
					"content": "Hahahaha! Hey yoldaş, bu soytarının ne dediğini duydun mu? Senin kolay lokma olduğunu sanıyor! Hadi ona Arataki Çetesinin hoşgörüsünü tattır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340110,
						727340111
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727340110,
					"content": "Haha, zevkle!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727340112
					]
				},
				{
					"id": 727340112,
					"content": "Paimon bu olayı hiç anlamadı... Bu insanlar rakiplerini hiç araştırmıyorlar mı? Tek yaptıkları teker teker gelip bize yenilmek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727340113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727340113,
					"content": "Büyük Usta Hanakado'nun takım üyeleri gerçekten çok dağınık! İş stratejiye geldiğinde bize rakip bile olamazlar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727340111,
					"content": "Hayır olamaz! Lütfen beni ezme...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727340112
					]
				}
			]
		}
	]
}