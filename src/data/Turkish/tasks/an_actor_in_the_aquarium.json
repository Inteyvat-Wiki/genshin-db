			},
			"dialogs": [
				{
					"id": 747070101,
					"content": "... Tamam, bu harikaydı! Bir çekim daha yapalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070102
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070102,
					"content": "Güzel. Veee... Kestik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070103
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070103,
					"content": "Furina! Aa, Columbina ve Chiori de yanında! Hâlâ burada mısınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747070104,
					"content": "Hı hı! Ek çekimlerimizi daha yeni tamamladık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070105
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070105,
					"content": "Aa! Şu balıkçık oyunculuğu işini mi diyorsun? Nasıl geçti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747070106,
					"content": "Sayenizde rol için uygun bir oyuncu bulduk. Çekimler sorunsuz geçti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070107
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070107,
					"content": "İkiniz bu akvaryum işinde cidden yeteneklisiniz. Furina daha demin sizin ona su altı belgeseli çekme konusunda ilham kaynağı olduğunuzu anlatıyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070108,
						747070109
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 747070108,
					"content": "Çok naziksin!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747070110
					]
				},
				{
					"id": 747070110,
					"content": "Ben de beğendim. Küçük balıkların etrafta yüzerken ne kadar mutlu olduklarını hissedebiliyorum. İhtiyaçlarını karşılama konusunda harika bir iş çıkarmışsınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070111
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 747070111,
					"content": "Keşke bu akvaryum sonsuza dek burada kalsa. Böylece istediğim zaman gelip ziyaret edebilirdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070112
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070112,
					"content": "Madem bu kadar çok özleyeceksin, filme birkaç manzara karesi daha eklesene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070113
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 747070113,
					"content": "Haklısın. O zaman birkaç tane daha ekleyelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070114
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070114,
					"content": "Balık mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070115
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 747070115,
					"content": "Hayır, kesit! Hadi bakalım, ışık, kamera... Senaryo sorumlum nerede benim? Herkes yerlerine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070116
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747070116,
					"content": "Paimon hazır! Yalnız, balık oyuncular için çekim anonsu yapmak... Cidden yepyeni bir deneyim, orası kesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747070109,
					"content": "Beğenmenize çok sevindik!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747070110
					]
				}
			]
		}
	]
}