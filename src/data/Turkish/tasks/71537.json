					"nextDialogs": [
						715370103
					]
				},
				{
					"id": 715370103,
					"content": "Evet. Sonunda tatilde buraya gelme fırsatı bulabildim ve gelmişken Favonius Şövalyeleri için birkaç hediye almak istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370104
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 715370104,
					"content": "Buranın halkının Fener Şenliğinde birbirlerine hediye verirken yanında bu zarflardan da verdiklerini öğrendim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370105
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 715370105,
					"content": "Ben de geleneği bozmayıp birkaç hediye zarfı yapmak istedim. Ama beklediğim gibi olmadılar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370106
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 715370106,
					"content": "Hediye zarflarımın güzel olmalarını istiyorum! Nasıl yapacağımı gösterir misin Fahri Şövalye?",
