			"dialogs": [
				{
					"id": 200500101,
					"content": "Ah, çok sinir bozucu... Bu konuda ne yapmalıyım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500102
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500102,
					"content": "Neler yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200500103
					]
				},
				{
					"id": 200500103,
					"content": "Favonius Şövalyeleri denemelerine hazırlanıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500104
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500104,
					"content": "*iç çeker* Ancak bir türlü Jean kadar güçlü olamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500105
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500105,
					"content": "Güçten çok tekniğe odaklanmanın benim için daha iyi olacağını düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500106
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500106,
					"content": "Mesela tüm tahta hedefleri tek hamlede nasıl kırabileceğimi düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500107
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500107,
					"content": "Boştaysan nasıl altından kalkacağımı bulmama yardım eder misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500108,
						200500109
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500108,
					"content": "Üzerine kafa patlatırım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200500110
					]
				},
				{
					"id": 200500110,
					"content": "Tabii, hiç acele etme. Bu talim hedeflerinin bir yere gittiği yok zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500111
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500111,
					"content": "Bunu nasıl çözeceğim diye düşünüp dururken aynı şey hayatım için de söylenebilir, of...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500114
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500114,
					"content": "Elementlerin özel şekillerde etkileşime geçebildiğini duydum. Acaba bu maltızda ateş kullanarak ufak bir patlama meydana getirebilir miyiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500115
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500115,
					"content": "Ama önce maltızda ateş olması gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500109,
					"content": "Beraber denemeye ne dersin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200500112
					]
				},
				{
					"id": 200500112,
					"content": "Takım savaşını seviyorsun demek. Bazıları için iyidir, her zaman destek alabileceğin birileri olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500113
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200500113,
					"content": "Benim gibilerse yalnız savaşçı olarak kendi ayakları üstünde kalabildiği kadar kalmaya çalışır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200500114
					],
					"speakerTitle": "Ellin"
				}
			]
		},
