				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728010501,
					"content": "Bu sahilde su çok berrak. Kumun rengi çok beyaz. Açık denize hiç benzemiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010502
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010502,
					"content": "Buradan denize açılmak, havalanmak çok güzel olurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010503
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010503,
					"content": "Manzara çok güzel. Defterime yazayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010504
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010504,
					"content": "Lütfen biraz bekle gezgin. Gezi günlüğümü nasıl yazacağımı düşünmem lazım. Etrafı gezip manzaranın tadını çıkarabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010505
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010505,
					"content": "Ama lütfen benden çok uzaklaşma. O Heihachi denen adam beni takip ediyor. Yakınlarda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ramsay"
				}
			]
		},
