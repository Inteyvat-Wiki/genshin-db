			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ramsay"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728010301,
					"content": "Sen... Gezgin misin? Nasıl yardımcı olabilirim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010302
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010302,
					"content": "Gezi günlüğü hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010303
					]
				},
				{
					"id": 728010303,
					"content": "Midori için yazdığımdan bahsediyorsun sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010304
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010304,
					"content": "Son zamanlarda günlük tutamayacak kadar meşguldüm. Endişelenmeye başlamıştır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010305
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010305,
					"content": "Seyahat günlüklerinde yazanlar gerçek mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010306
					]
				},
				{
					"id": 728010306,
					"content": "Hahaha, sence?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010307,
						728010309
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010307,
					"content": "Bence değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010308
					]
				},
				{
					"id": 728010308,
					"content": "Çok gezip gördüğün belli oluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010311
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010311,
					"content": "Haklısın. Aslında gezi günlüklerindeki hiçbir şey gerçek değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010312
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010312,
					"content": "Bazı yerler ve karakterler hayal ürünü olmasa da... İçeriğin büyük kısmı benim hayal gücümün eseri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010313
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010313,
					"content": "Tabii tamamen kurgu olmayan yerleri de var. Mesela şu an yazdığım günlükte birisi bir süper balon yapıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010314
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010314,
					"content": "Sonra arkadaşlarını toplayıp balonuyla Teyvat'ı 80 günde gezmeyi planlıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010315
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010315,
					"content": "Ayrıca bu balonu kullanmak için Önsezi gerekmiyor. Tek gereken biraz teknik bilgi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010316
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010316,
					"content": "Dünyayı balonla geziyorlar. Yolculuklarında birçok tuhaf şey ve olay görüyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010317
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010317,
					"content": "Bunu Midori için yazacaktım ama nedense kısa bir paragraf yazmaya bile zamanım yetmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010318
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010318,
					"content": "Neden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010319
					]
				},
				{
					"id": 728010319,
					"content": "Şu koridordaki adamı görüyor musun? Adı Heihachi. Uzun zamandır beni izliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010320
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010320,
					"content": "Gezi günlüğüm için ilham bulmaya çıkacaktım ama nereye gitsem beni takip ediyor. Ne yapmaya çalışıyor anlamadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010321
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010321,
					"content": "Kötü niyetli olmasından endişeleniyorum. Dışarı çıkmaya korkuyorum. Gezi günlüğü bu yüzden gecikti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010322
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010322,
					"content": "İyi ki geldin Gezgin. Benimle ilham aramaya çıkar mısın? Sen varken bana bir şey yapmaya cesaret edebileceğini sanmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010323,
						728010325
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010323,
					"content": "Hallederim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010324
					]
				},
				{
					"id": 728010324,
					"content": "Teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010327
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010327,
					"content": "Hani \"Yabancılara karşı dikkatli olmak gerekir.\" derler ya. Birisi gizlice beni izliyorsa ne olursa olsun kendimi korumam gerekir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010328
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010328,
					"content": "Lütfen ilham ararken beni koru gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010329
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010329,
					"content": "Aslında aklımda birkaç yer vardı. Hadi gidelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010330
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010330,
					"content": "İlk yer sahilin orada. Hadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010325,
					"content": "Niye öyle yapsın ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010326
					]
				},
				{
					"id": 728010326,
					"content": "Bilmiyorum ama... Bir insanın diğerine kötülük yapması için bir sebep gerekmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010327
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728010309,
					"content": "Umarım gerçektir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010310
					]
				},
				{
					"id": 728010310,
					"content": "Hahaha, ben de yazdıklarım gerçek olsun isterdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010311
					],
					"speakerTitle": "Ramsay"
				}
			]
		},
