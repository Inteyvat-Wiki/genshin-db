			"dialogs": [
				{
					"id": 728010201,
					"content": "Komore Çayevine hoş geldin! Nasıl yardımcı olabilirim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010202
					],
					"speakerTitle": "Kozue"
				},
				{
					"id": 728010202,
					"content": "Ramsay hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728010203
					]
				},
				{
					"id": 728010203,
					"content": "Ha, şu iş adamı... Evet, içeride ama son zamanlarda biraz gergin. Ne oldu bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728010204
					],
					"speakerTitle": "Kozue"
				},
				{
					"id": 728010204,
					"content": "Konuşmak istiyorsan içeri gir. Görürsün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kozue"
				}
			]
		},
		{
			"id": 7280103,
			"completionStepIds": [
				7280103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
