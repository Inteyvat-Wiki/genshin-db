					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011402,
					"content": "Birkaç paragraf yazmıştım. Lütfen Midori'ye önce bu paragrafları götür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011403
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011403,
					"content": "Hikayeyi bitirdiğimde birinden Midori'ye gezi günlüğümün tamamlanmış halini götürmesini isterim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011404
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011404,
					"content": "Gezi günlüğüymüş... Hah. Öyle diyor ama ya başka bir amacı varsa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011405
					],
					"speakerTitle": "Heihachi"
				},
				{
					"id": 728011405,
					"content": "Neden bahsediyorsun sen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728011406
					]
				},
				{
					"id": 728011406,
					"content": "Diyorum ki bu adam gezi günlüğünü başka amaçlarla yazıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011407
					],
					"speakerTitle": "Heihachi"
				},
				{
					"id": 728011407,
					"content": "Öyle saçmalıkları kim umursar ki? Önsezi kullanmadan Teyvat'ı sıcak hava balonuyla gezmek de neymiş?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011408
					],
					"speakerTitle": "Heihachi"
				},
				{
					"id": 728011408,
					"content": "Gizli bir amacı vardır kesin. Henüz ortaya çıkmadı ama eninde sonunda çıkacak.",
