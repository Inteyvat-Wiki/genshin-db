					"content": "Daha bitirmemiş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728011506
					]
				},
				{
					"id": 728011506,
					"content": "Öyle mi? Ramsay Amca bitirene kadar bekleyip sonra okurum. Kouichi'ye anlatacak yeni bir hikayem olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011507
					],
					"speakerTitle": "Midori"
				},
				{
					"id": 728011507,
					"content": "Teşekkür ederim Gezgin. Bunlar senin için. Lütfen kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
