					"speakerTitle": "Midori"
				},
				{
					"id": 728011504,
					"content": "Bu neden bu kadar ince? Diğer gezi günlükleri çok daha kalındı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011505
					],
					"speakerTitle": "Midori"
				},
				{
