			"dialogs": [
				{
					"id": 728011301,
					"content": "Dağın tepesinde durunca Narukami Adası'nın neredeyse tamamı görülüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011302
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011302,
					"content": "Dağın tepesinde rüzgar epey sert esiyor. Yükseklik de havalanmak için mükemmel. Hiçbir engel yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011303
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011303,
					"content": "Ayrıca Inazuma buraya çok uzak. Doushin ya da istemediğim insanlar beni rahatsız edemez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011304
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011304,
					"content": "Gerçekten güzel bir yer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728011305
					]
				},
				{
					"id": 728011305,
					"content": "Sonuçta oradan uçmak güzel olur. Gezi günlüğüne yazmak için de güzel bir yer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011306
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011306,
					"content": "Şu adam hâlâ bizi takip ediyor. Bırakmadı peşimizi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011307
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011307,
					"content": "Ben hallederim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728011308
					]
				},
				{
					"id": 728011308,
					"content": "Sorun değil. Endişelenme. Sen varken sorun çıkarmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011309
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011309,
					"content": "Karşında böyle biri varsa konuşmaya çalıştığında rahatsızlık vermeye devam eder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728011310
					],
					"speakerTitle": "Ramsay"
				},
				{
					"id": 728011310,
					"content": "Neyse, bugünlük bu kadar yeter. Hadi Komore Çayevine dönelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ramsay"
				}
