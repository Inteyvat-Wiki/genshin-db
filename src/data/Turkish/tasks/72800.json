			},
			"dialogs": [
				{
					"id": 728000301,
					"content": "Birkaç taze yemek malzemesi arıyordum... Neyse, bunlar da işe yarar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000302
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000302,
					"content": "Üzgünüm. Senin için güzel bir şeyler pişirmek istemiştim ama sanırım şimdilik bunlarla idare etmemiz gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000303,
						728000306
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000303,
					"content": "Önemli değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000304
					]
				},
				{
					"id": 728000304,
					"content": "Bize eşlik ederken çok yoruldun. \"Önemli değil\" cevabını kabul etmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000305
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000305,
					"content": "Bunu unutmayacağım ve sonrakine sana lezzetli bir öğün hazırlayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000308
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000308,
					"content": "Julie, çorba hazır mı? Sakın Parvaneh'e...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000309
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000309,
					"content": "Hayır, hayır, bırak da çorba az daha kaynasın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000310
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 728000310,
					"content": "Sorun yok. Çorbayı kendi geliştirdiğim tarife göre lezzetlendiriyorum. Yalnızca biraz baharat ekleyeceğim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000311
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000311,
					"content": "Senin geliştirdiğin tariften bir şey anlamadım! Bırak şunu! Xudong, Xudong, buraya gel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000312
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 728000312,
					"content": "Parvaneh! Hey! Çorbaya attığın bu tuhaf baharat da neyin nesi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000313
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000313,
					"content": "Tuhaf baharat mı? Bu benim özel sosum! Bu sosu tez araştırmam sonucunda buldum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000314
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000314,
					"content": "Buna gerek yok! Bugünlük sıradan bir şey yiyelim. Julie, şunu durdursana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000315
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000315,
					"content": "Hıh, siz ne anlarsınız... O zaman izin verin de halledeyim. Ekleyeceğim nihai baharatlarla hiçbir yemeğin lezzetsiz olma imkanı yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000316
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000316,
					"content": "Nihai baharatlar mı? Öyle bir şey var mı ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000317
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000317,
					"content": "Hayır, yok ve ben de zaten bunun için uğraşıyorum ya! Akademide bana inanmayan dik kafalılara göstereceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000318
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 728000318,
					"content": "Haha... Dört gözle bekliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000319
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000319,
					"content": "Bu arada gezgin, bunca zamandır bir oraya bir buraya bizimle koşturduğun için teşekkür ederim. Sağ ol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000320
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000320,
					"content": "Sana bir paket hazırlayayım. Maceraya çıkarken yanında yeterli yiyecek olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000321
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000321,
					"content": "Sonraki buluşmamızda sana güzel bir öğün hazırlayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 728000306,
					"content": "Bir dahaki sefere bana bir ziyafet hazırlaman için seni bulacağım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728000307
					]
				},
				{
					"id": 728000307,
					"content": "Hahaha, tamam. Bunu kenara not ettim. Bir dahaki sefere sana kesinlikle lezzetli bir öğün hazırlayacağım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728000308
					],
					"speakerTitle": "Xudong"
				}
			]
		}
	]
}