					"nextDialogs": [
						721640302,
						721640311
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640302,
					"content": "Adın hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640303
					]
				},
				{
					"id": 721640303,
					"content": "Adım Neko, Hibiki'nin bahşettiği bir isim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640304
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640304,
					"content": "Tapınakta misafirleri genelde o karşılardı, yani böylesi işlerle benim ilgilenmem gerekmezdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640305
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640305,
					"content": "O zamanlar ne adım ne de unvanım vardı. İstediği yerde uyur, dilediği kişiyle oynardım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640306
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640306,
					"content": "Bir gün, uyku alışkanlığımdan dolayı Hibiki artık bana \"Neko\" diye sesleneceğini söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640307
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640307,
					"content": "Hibiki şu an yok ama başrahibesiz tapınak olmaz, o nedenle bu görevi ben devraldım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640308
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640308,
					"content": "Hibiki dönmeden tapınağı eskisi gibi canlandırmayı umuyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640309
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640309,
					"content": "Döndüğünde hemen kucağında uyuyabilirim. Ayrıca Bağış Kutusunu onarmasını veya dökülen yaprakları temizlemek için o uzun çubuğunu kullanmasını beklemem de gerekmeyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640310
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640310,
					"content": "Şimdi bu işleri size bırakıyorum. Tapınağa gizlice giren böcekler var, kovulmaları gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640311,
					"content": "Eskiden tapınağı kim temizliyordu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640312
					]
				},
				{
					"id": 721640312,
					"content": "Hibiki. Bazen Domeki de yardım ederdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640313
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640313,
					"content": "Hibiki hep o çubuğu alıp güneş doğmadan önce ileri geri sallardı. Yere su da dökerdi. Iyy, su...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640314
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640314,
					"content": "Bir dakika. Önce suyu mu döküyordu? Hangi sırayla yaptığını hatırlamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640315
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640315,
					"content": "Arada Domeki de gelirdi, çapraz metal levhaları kıt kıt birbirine vururdu. Sonra da dallar ve yapraklar aşağı düşerdi.",
					"roleType": "TALK_ROLE_NPC",
