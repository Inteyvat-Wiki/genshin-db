			"trigger": {
				"objectNames": [
					"Neko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721640101,
					"content": "Miyav, miyav... Şu kutu cidden çok işe yaradı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640102,
					"content": "Ah, dönmüşsünüz. Tamir ettiğiniz şu kutu epey işime yaradı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640103
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640103,
					"content": "Siz gider gitmez yeşil kıyafetli iki insan geldi tapınağa, miyav.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640104,
					"content": "Biraz Mora vermek istediler istemesine ama uzun olan daha çok benim konuşmamla ilgilendi. Siz insanları afallatmak çok kolay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640105,
					"content": "Her neyse, Bağış Kutusu son derece harikulade bir yadigar. Bir tane daha onarırsanız daha fazla insan çekeriz belki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640106,
					"content": "O işler öyle olmuyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640107
					]
				},
				{
					"id": 721640107,
					"content": "Öyle mi? İnsani mevzular çok can sıkıcı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640108,
					"content": "Paimon, tapınağın şu anki durumuyla ilgilenmemiz gerektiğini düşünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721640109,
					"content": "Nesi varmış tapınağımın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640110,
						721640111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640110,
					"content": "Biraz pis...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640112
					]
				},
				{
					"id": 721640112,
					"content": "Bak sen... Şu veletler yaprak kümeleri içinde oynamayı pek seviyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640113,
					"content": "Yanlış hatırlamıyorsam Hibiki eskiden yaprakları kümelemek için sivri, uzun bir çubuk kullanırdı. O öyle yapıyorsa doğrusu da öyledir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640114,
						721640115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640114,
					"content": "Neyin süpürülmesi gerekiyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640116
					]
				},
				{
					"id": 721640116,
					"content": "İnsanların nerede ne yaptıklarını ben nereden bileyim? Yine de... Hibiki olsaydı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640117
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640117,
					"content": "Hibiki hep o çubuğu alıp güneş doğmadan önce ileri geri sallardı. Ben de çubuğu kovalamayı çok severdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640118
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640118,
					"content": "Ama şimdi geçici başrahibe olduğuma göre öyle hareketler bana yakışmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640119
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640119,
					"content": "Hibiki'nin yere su döktüğünü de hatırlıyorum. Pek yanlış bir hareket.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640120
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640120,
					"content": "Arada Domeki de gelirdi, çapraz metal levhaları kıt kıt birbirine vururdu. Sonra da dallar ve yapraklar aşağı düşerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640121,
						721640123
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640121,
					"content": "Domeki mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640122
					]
				},
				{
					"id": 721640122,
					"content": "Pek uzun ve yüksek sesle konuşan bir insan. Hibiki'yle oyun oynayıp dururlardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640125
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640125,
					"content": "Hah. O velet en sevdiğim dalları kesip dururdu. Beni çileden çıkarırdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640126
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640126,
					"content": "Dediklerine bakılırsa temizlik yapıyorlarmış. Gerçi buna ortalığı toplamak da denebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721640127,
					"content": "Yerleri süpürmek, suyla yıkamak, dalları kırpmak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721640128,
					"content": "İyi bildiğimiz işler...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640129
					]
				},
				{
					"id": 721640129,
					"content": "Demek buna \"temizlik\" deniyor. Anladım. O halde siz de ondan yapar mısınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640130
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640130,
					"content": "Ah, evet. Kıt kıt yapmasanız da olur. Ben dalları oldukları gibi seviyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640131
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640131,
					"content": "Uzun çubuk, yapraklar ve su yeterli. Dediklerimi anladınız mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640132,
						721640133
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640132,
					"content": "Hallederiz, merak etme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640144
					]
				},
				{
					"id": 721640144,
					"content": "Miyav! Evet, bu görevi bana bizzat Hibiki verdi. Sadece benim yapmam gereken hayati bir görev.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640133,
					"content": "Hibiki'nin kim olduğunu sorsam?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640134
					]
				},
				{
					"id": 721640134,
					"content": "Hibiki, Hibiki'dir. Asase Tapınağının başrahibesi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640135
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640135,
					"content": "Peki senin adın...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640136
					]
				},
				{
					"id": 721640136,
					"content": "Adım Neko, Hibiki'nin bahşettiği bir isim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640137
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640137,
					"content": "Tapınakta misafirleri genelde o karşılardı, yani böylesi işlerle benim ilgilenmem gerekmezdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640138
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640138,
					"content": "O zamanlar ne adım ne de unvanım vardı. İstediği yerde uyur, dilediği kişiyle oynardım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640139
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640139,
					"content": "Bir gün, uyku alışkanlığımdan dolayı Hibiki artık bana \"Neko\" diye sesleneceğini söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640140
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640140,
					"content": "Hibiki şu an yok ama başrahibesiz tapınak olmaz, o nedenle bu görevi ben devraldım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640141
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640141,
					"content": "Hibiki dönmeden tapınağı eskisi gibi canlandırmayı umuyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640142
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640142,
					"content": "Doğru! Döndüğünde hemen kucağında uyuyabilirim. Bağış Kutusunu onarmasını veya yaprakları temizlemek için o uzun çubuğunu kullanmasını beklemem de gerekmeyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640143
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640143,
					"content": "Şimdi bu işleri size bırakıyorum. Tapınağa gizlice giren böcekler var, kovulmaları gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640144
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640123,
					"content": "Kıt kıt mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640124
					]
				},
				{
					"id": 721640124,
					"content": "Neko galiba dalların kırpılmasını kastediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721640115,
					"content": "Tam olarak ne yapılması gerekiyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640116
					]
				},
				{
					"id": 721640111,
					"content": "Temizlenmesinden zarar gelmez...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640112
					]
				}
			]
		},
