			"dialogs": [
				{
					"id": 721640201,
					"content": "\"Temizlik\" işin bitti mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640202
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640202,
					"content": "Her yer pırıl pırıl.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640203
					]
				},
				{
					"id": 721640203,
					"content": "Miyav, miyav. Güzel. Ben de börtü böceği kovaladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640204
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640204,
					"content": "Burası tapınağa benzemeye başladı cidden. Kutu onarıldı, tapınak da temizlendi... Evet, bu kez kesin daha çok insan gelip saygılarını sunacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640205
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640205,
					"content": "Miyav, miyav... Bu tapınağı eski günlerine döndürmemiz gerek, evet... Miyav...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640206
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640206,
					"content": "Şimdilik burada bırakalım. Yardımınız için teşekkürler... miyav, miyav...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640207
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640207,
					"content": "Dilinizi konuşmak... çok yorucu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640208
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640208,
					"content": "Ben biraz dinleneceğim. İleride tekrar yardımına ihtiyacım olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640209
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 721640209,
					"content": "Zamanı geldiğinde buraya dön. Miyav, miyav...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
