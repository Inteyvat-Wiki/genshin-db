					"nextDialogs": [
						190961104
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 190961104,
					"content": "Toplantı, birkaç şaraphanenin iş birliğiyle yeni içkilerin bulunması ve üretilmesi üzerine olacak. Zaten o yüzden benim katılmam daha yerinde olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190961105
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 190961105,
					"content": "Ben yokken Kaeya'ya istediğini sorabilirsin. Şaraphanenin her köşesini adı gibi bilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				}
