					"nextDialogs": [
						190961103
					]
				},
				{
					"id": 190961103,
					"content": "Şimdi şaraphanenin gündelik işleriyle uğraşıyorum. Biraz sonra Elzer'ın yerine bir toplantıya katılacağım.",
