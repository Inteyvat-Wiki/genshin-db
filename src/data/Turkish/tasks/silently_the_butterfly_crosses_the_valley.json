			"dialogs": [
				{
					"id": 711151201,
					"content": "Vay canına, tamamen değişti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711151202,
					"content": "Otacı Efendi ağacı bana emanet ettiği için gözümün önünde öyle solmuş bir şekilde durmasına dayanamıyordum! İkinize de çok teşekkür ederim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151203
					],
					"speakerTitle": "Kaygısız Suret"
				},
				{
					"id": 711151203,
					"content": "Sihirli sözleri hatırlayamadın bile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711151204,
					"content": "Ah, küçük detaylara takılmayalım lütfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151205
					],
					"speakerTitle": "Kaygısız Suret"
				},
				{
					"id": 711151205,
					"content": "Bu arada, isterseniz size gizli bir ipucu verebilirim! Bir dalı koparıp evin dışındaki kırık kavanozun içine koyduğunuzda taş kapı açılır...",
					"roleType": "TALK_ROLE_NPC",
