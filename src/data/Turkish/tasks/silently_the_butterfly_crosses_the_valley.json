					}
				]
			},
			"dialogs": [
				{
					"id": 711150501,
					"content": "Hah, işte bunun gibi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150502
					],
					"speakerTitle": "Kaygısız Suret"
				},
				{
					"id": 711150502,
					"content": "Otacı Efendi önceleri bu kelebekleri kullanarak kapısını süslerdi, ancak söz konusu mekanizma daha sonra yok oldu. Bu renkli kelebekler ve ilaç kavanozu da... Aslında Adeptus ağacını beslemek için kullanılıyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150503
					],
					"speakerTitle": "Kaygısız Suret"
				},
				{
					"id": 711150503,
					"content": "Adeptus ağacı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150504,
					"content": "Evet! O zamanlar Otacı Efendi bu Adeptus ağacını kendi elleriyle dikmişti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150505
					],
					"speakerTitle": "Kaygısız Suret"
				},
				{
					"id": 711150505,
					"content": "Şimdiye çoktan solardı ancak Otacı Efendi burada kelebekler olduğu sürece ağacın hep canlı duracağını söylemişti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150506
					],
					"speakerTitle": "Kaygısız Suret"
				},
				{
					"id": 711150506,
					"content": "*iç çeker* Artık insan formunu koruyacak gücü kalmadığında buradan ayrıldı. Acaba şu anda ne halde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150507
					],
					"speakerTitle": "Kaygısız Suret"
				},
				{
					"id": 711150507,
					"content": "\"Renkli kelebekler kavanozda toplandıkça, solmuş ağaç yeniden hayat bulacaktır...\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150508
					]
				},
				{
					"id": 711150508,
					"content": "Çok doğru! Ama siz bunu nereden biliyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150509
					],
					"speakerTitle": "Kaygısız Suret"
				},
				{
					"id": 711150509,
					"content": "Neyse ne, boş verin! O renkli kelebekler kavanoza girdiği müddetçe solmuş ağacı besleyebiliriz! Bu konuda size güveniyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaygısız Suret"
				}
			]
		},
