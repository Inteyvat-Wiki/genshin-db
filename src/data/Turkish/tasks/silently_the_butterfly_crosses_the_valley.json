			},
			"dialogs": [
				{
					"id": 711150601,
					"content": "Hah, işte bunun gibi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150602
					],
					"speakerTitle": "Kaygısız Suret"
				},
				{
					"id": 711150602,
					"content": "Otacı Efendi önceleri bu kelebekleri kullanarak kapısını süslerdi, ancak o mekanizma daha sonra yok oldu. Bu renkli kelebekler ve ilaç kavanozu da aslında Adeptus ağacını beslemek için kullanılıyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150603
					],
					"speakerTitle": "Kaygısız Suret"
				},
				{
					"id": 711150603,
					"content": "Adeptus ağacı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150604,
					"content": "Evet! O zamanlar Otacı Efendi bu Adeptus ağacını kendi elleriyle dikmişti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150605
					],
					"speakerTitle": "Kaygısız Suret"
				},
				{
					"id": 711150605,
					"content": "Şimdiye çoktan solardı ancak Otacı Efendi burada kelebekler olduğu sürece ağacın hep canlı duracağını söylemişti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150606
					],
					"speakerTitle": "Kaygısız Suret"
				},
				{
					"id": 711150606,
					"content": "*iç çeker* Artık insan formunu koruyacak gücü kalmadığında buradan ayrıldı. Acaba şu anda ne halde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150607
					],
					"speakerTitle": "Kaygısız Suret"
				},
				{
					"id": 711150607,
					"content": "Peki benim ne yapmam lazım?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150608
					]
				},
				{
					"id": 711150608,
					"content": "Ah, kusura bakma. Otacı Efendi aklıma geldi de bir an dalıp gitmişim öyle geçmişe doğru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150609
					],
					"speakerTitle": "Kaygısız Suret"
				},
				{
					"id": 711150609,
					"content": "Öhöm! Şimdi beni iyi dinleyin! O renkli kelebekler kavanoza girdiği müddetçe solmuş ağacı besleyebiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150610
					],
					"speakerTitle": "Kaygısız Suret"
				},
				{
					"id": 711150610,
					"content": "Heh, Otacı Efendi'nin tasarladığı mekanizma bu işte! Çok etkileyici, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150611,
						711150613
					],
					"speakerTitle": "Kaygısız Suret"
				},
				{
					"id": 711150611,
					"content": "Deneyeyim bakalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150612
					]
				},
				{
					"id": 711150612,
					"content": "Tabii ki! Size güveniyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaygısız Suret"
				},
				{
					"id": 711150613,
					"content": "Neden renkli kelebekler peki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711150614
					]
				},
				{
					"id": 711150614,
					"content": "Evet, sebebini ben de merak ediyorum. Belki de yalnızca Otacı Efendi renkli kelebekleri çok sevdiğindendir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150615
					],
					"speakerTitle": "Kaygısız Suret"
				},
				{
					"id": 711150615,
					"content": "Her neyse, kelebekleri kavanoza geri koyma işi sizde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaygısız Suret"
				}
			]
		},
