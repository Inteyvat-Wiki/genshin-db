			"dialogs": [
				{
					"id": 711150401,
					"content": "Ne? Siz kim oluyorsunuz da benim güzellik uykumu bölüyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150402
					],
					"speakerTitle": "Kaygısız Suret"
				},
				{
					"id": 711150402,
					"content": "Hı? O da kim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150403,
					"content": "Ah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150404
					],
					"speakerTitle": "Kaygısız Suret"
				},
				{
					"id": 711150404,
					"content": "Eyvaahh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150405,
					"content": "Hahahahaha! Evet, işte böyle! Benden korkmanız çok normal! Bu taşa hapsolmuş olmasaydım şu anda çoktan mideme inmiştiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150406
					],
					"speakerTitle": "Kaygısız Suret"
				},
				{
					"id": 711150406,
					"content": "Ne? Demek sadece konuşan bir heykelsin... Paimon da seni canavar falan sanmıştı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150407,
					"content": "Hıh! \"Sadece konuşan bir heykel\" de ne demek? Konuşan bir heykel yeterince korkunç bir şey değil mi zaten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150408
					],
					"speakerTitle": "Kaygısız Suret"
				},
				{
					"id": 711150408,
					"content": "Daha önce senin gibi o kadar çok heykelle karşılaştık ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150409,
					"content": "Ge-Gerçekten mi? *iç çeker* Peki, görünüşe bakılırsa sizi korkutmak imkansız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150410
					],
					"speakerTitle": "Kaygısız Suret"
				},
				{
					"id": 711150410,
					"content": "İlla birilerini korkutman mı gerekiyor? Sonuçta sadece taştan bir heykelsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150411,
					"content": "Hıh! \"Sadece taştan bir heykel\" olsam bile, Otacı Efendi'nin evinde olduğunuzu unutmayın sakın! O buradayken, başkalarının gelip de huzurunu bozmasından asla hoşlanmazdı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150412
					],
					"speakerTitle": "Kaygısız Suret"
				},
				{
					"id": 711150412,
					"content": "İşte bu yüzden burada durup gelip geçenleri korkutuyorum ki huzurumuzu kaçırmasınlar. Her ne kadar Otacı Efendi artık burada olmasa da bunu yapmaya devam edeceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150413
					],
					"speakerTitle": "Kaygısız Suret"
				},
				{
					"id": 711150413,
					"content": "Her neyse, siz diğer sıradan ölümlülerden daha farklı geldiniz bana. Madem benden korkmuyorsunuz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150414
					],
					"speakerTitle": "Kaygısız Suret"
				},
				{
					"id": 711150414,
					"content": "O zaman sizden bir iyilik isteyebilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150415
					],
					"speakerTitle": "Kaygısız Suret"
				},
				{
					"id": 711150415,
					"content": "İyi de biz sana nasıl yardım edebiliriz ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711150416,
					"content": "Öhöm... Şu renkli kelebeklere bir bakın! Otacı Efendi gittiğinden beri her taraf kelebek doldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711150417
					],
					"speakerTitle": "Kaygısız Suret"
				},
				{
					"id": 711150417,
					"content": "Şşş... Kıpırdama, kafanda bir tane var! Dur, yakalayalım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
