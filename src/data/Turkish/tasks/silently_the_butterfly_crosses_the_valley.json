			"dialogs": [
				{
					"id": 711151101,
					"content": "Hey! Seni yalancı! Tüm kelebekleri kavanoza geri koyduk ama Adeptus ağacı hâlâ aynı duruyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711151102,
					"content": "Hımm! Siz kim oluyorsunuz da beni rahatsız ediyorsunuz? Ah, sizmişsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151103
					],
					"speakerTitle": "Kaygısız Suret"
				},
				{
					"id": 711151103,
					"content": "Şey, renkli kelebeklerin hepsini yakalayabileceğinizi düşünmemiştim! Öylesine ağzımdan çıkıvermişti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151104
					],
					"speakerTitle": "Kaygısız Suret"
				},
				{
					"id": 711151104,
					"content": "Yani şey... Adeptus enerjisini çoktan hissettim, ancak Adeptus ağaçlarının canlanabilmesi için Otacı Efendi'nin bıraktığı sihirli sözleri söylememiz lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151105
					],
					"speakerTitle": "Kaygısız Suret"
				},
				{
					"id": 711151105,
					"content": "Bir saniye, sözler nasıldı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151106
					],
					"speakerTitle": "Kaygısız Suret"
				},
				{
					"id": 711151106,
					"content": "\"Kışın doğarsın, zamanla gelişir ve solarsın. Güzelliğinin yeniden açacağı bahar günleri için duamdasın...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711151107
					],
					"speakerTitle": "Kaygısız Suret"
				},
				{
					"id": 711151107,
					"content": "Uçun, uçun kelebekler... Gerisini hatırlamıyorum ancak en sonunda her şey yeniden canlanıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaygısız Suret"
				}
			]
		},
