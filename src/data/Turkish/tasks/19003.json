				"objectNames": [
					"Victoria"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190030301,
					"content": "Ah, demek döndün. Rahibe Barbara'yı görmeye geldiysen... O henüz geri dönmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030302,
						190030303
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030302,
					"content": "Barbara'yı Kurtlar Diyarı'nda bulduk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030304
					]
				},
				{
					"id": 190030304,
					"content": "Anladım... Barbatos'a şükürler olsun ki durumu iyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030305
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030305,
					"content": "Ama bir süre için geri dönemeyecek gibi görünüyor... Belki de o zamana kadar Katedraldeki sorumluluklarını başkasına devretmeliyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030306
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030306,
					"content": "Biz yardımcı olabiliriz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030307
					]
				},
				{
					"id": 190030307,
					"content": "Ah, çok naziksiniz. Size rahatsızlık vermek istemem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030308
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030308,
					"content": "Hm... Biraz düşüneyim... Ah evet, Katedralin çevresini temizlemeye yardımcı olabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030309
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030309,
					"content": "İnsanlar dışarıdaki tüm pisliği Katedrale getiriyorlar, bu nedenle de yerler çok çabuk kirleniyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030310
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030310,
					"content": "Temizlik ve düzen gibi işler hep Rahibe Barbara'nın sorumluluğundaydı. O da gittikten sonra her yer kirlenmeye başladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030311
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030311,
					"content": "Barbara bu koca mekanı tek başına mı temizliyordu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030312
					]
				},
				{
					"id": 190030312,
					"content": "Evet. Barbara hep bu işi tek başına yapabileceğini ve kimsenin yardımına ihtiyacı olmadığını söylerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030313
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030313,
					"content": "Ama işlerini bitirdiğinde hep çok bitkin görünürdü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030314
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030314,
					"content": "Açıkçası yardım etmek istemenize çok şaşırdım. Daha doğrusu, Barbara'nın ona yardım etmenizi kabul etmesine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030315
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030315,
					"content": "Ancak bu onun yükünü hafifletecektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030316
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030316,
					"content": "Her neyse, şimdilik bu temizlik işini yapmanıza izin vereceğim Fahri Şövalye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030303,
					"content": "Barbara Şafak Şaraphanesinde Tunner'ı kontrol ediyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030304
					]
				}
			]
		},
