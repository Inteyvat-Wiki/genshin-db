			},
			"dialogs": [
				{
					"id": 190030601,
					"content": "Ee evlat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030602
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030602,
					"content": "Barbara'nın izin günlerine gelince...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030603
					]
				},
				{
					"id": 190030603,
					"content": "Ha evet. Rahibe Barbara az önce yarım gün izin almak istediğini bildirdi. Bir arkadaşıyla programı varmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030604
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030604,
					"content": "Bu arada, Barbara'nın sırf bir arkadaşıyla görüşmek için izin istemesinin de çok nadir bir durum olduğunu belirtmeliyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030605
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030605,
					"content": "Fakat şu anki konumuz bu değil. Bana ne soracaktın sen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030606
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030606,
					"content": "\"Fantastik Yaz - Nadir Bulunan Mercan Işıltılı Çay\" hakkındaydı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030607
					]
				},
				{
					"id": 190030607,
					"content": "Ne yani, bu özel içeceği almak için Barbara'nın aslında seninle buluşacağını mı söylüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030608
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030608,
					"content": "O zaman onun bahsettiği arkadaş sen olmalısın ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030609
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030609,
					"content": "Hm, Fahri Şövalye olduğuna göre, sanırım bunda bir sakınca yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030610
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030610,
					"content": "Tamam o zaman, Rahibe Barbara'ya iyi bak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030611
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030611,
					"content": "Barbara neden planlarını hep başkalarıyla paylaşır ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190030612
					]
				},
				{
					"id": 190030612,
					"content": "Senin de bildiğin gibi, Rahibe Barbara bazı nedenlerden ötürü Mondstadt'ta oldukça popüler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030613
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030613,
					"content": "Buradaki insanlar iyi niyetlerinden böyle davranıyorlar ama sayıları o kadar fazla ki Rahibe Barbara hangisiyle baş edeceğini şaşıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030614
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030614,
					"content": "Barbara Kilisede çalışırken eğer onlar çıkıp gelirlerse, biz de gelip olaya dahil olabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030615
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030615,
					"content": "Ama izindeyken halen hayranları peşini bırakmazsa, o zaman kendi işini kendi halletmesi gerekecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030616
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030616,
					"content": "Onun ne kadar nazik biri olduğundan bahsetmeye gerek yok sanırım. Normal mesaisinden daha çok yorucu olsa bile, Mondstadt halkının her isteğini yerine getirmeye çalışır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030617
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030617,
					"content": "Biz de bu nedenle, gerektiğinde gelip onu kalabalıktan kurtarabilmemiz için Rahibe Barbara'nın gittiği yerleri bize mutlaka söylemesi gerektiğini düşünüyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190030618
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 190030618,
					"content": "Umarım Rahibe Barbara başkaları için saçını süpürge etmekten vazgeçer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Victoria"
				}
			]
		},
