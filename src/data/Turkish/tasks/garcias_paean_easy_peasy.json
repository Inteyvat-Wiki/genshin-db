			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ahangar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230160201,
					"content": "Sana ne dedim ben? Bir saniye... Ah, sen miydin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160202,
						230160203
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160202,
					"content": "Bay Garcia adına bazı sorular sormaya geldim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160204
					]
				},
				{
					"id": 230160204,
					"content": "Demek gerçekten gidip kendisi yapmaya başladı. Ne tuhaf bir tip.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160205
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160205,
					"content": "Ben çok uzun yıllardır demirciyim. Bu kadar katı talimatları olan birini ilk kez görüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160206
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160206,
					"content": "Demir boruların bağlantı yerlerini ve vidalar arasındaki mesafeyi ölçmek için yanında bir cetvel bile getiriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160207
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160207,
					"content": "Artık ona katlanamıyorum, bu yüzden gidip kendisinin yapmasını söyledim. Peki sonra ne oldu dersin? Ertesi gün geldi ve benden ona demircilik hakkında bir şeyler öğretmemi istedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160208
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160208,
					"content": "Artık gerçekten onun için yapabileceğim bir şey kalmadı, ben de onu kendi haline bıraktım. Malzemelerin parasını verdiği sürece istediği aletleri kullanmasına izin vereceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160209
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160209,
					"content": "*iç çeker* O adamın kafasından neler geçiyor hiç bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160210,
						230160211
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160210,
					"content": "Muhteşem bir makina yapıyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160212
					]
				},
				{
					"id": 230160212,
					"content": "O makina her neyse tuhaf bir şey olduğu kesin. Buraya demircilik hakkında bir şeyler sormaya geldin, değil mi? Açıkçası çark yapma konusunda öğretebileceğim fazla bir şey yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160213
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160213,
					"content": "Öte yandan istediği çarklarda bir detay gözüme çarptı. Çarkların uçları sivri ama ortaları içe doğru bombeli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160214
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160214,
					"content": "Hazır kalıplar bu tarz özel şekilli çarklar için yeterli değildir, bu yüzden daha sonrasında o çarkları tekrar şekillendirmesi gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160215
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160215,
					"content": "Ona zaten teknikleri ayrıntılı bir şekilde anlattım. Sen sadece ona şunu söyle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160216
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160216,
					"content": "İlk olarak, ocağa ikinci kez koymadan önce <color=#00E1FFFF>ateşi iyice harlamak için yeterince yakıt eklemeli.</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160217
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160217,
					"content": "Daha sonra işlemek için çıkardığında <color=#00E1FFFF>içeriden dışarıya doğru dövmeli.</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160218
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160218,
					"content": "Her şey anlaşıldı mı? Anladıysan gidip ona anlatabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160219
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160219,
					"content": "Gerçekten tuhaf bir tip...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230160211,
					"content": "Tuhaf bir makina yapıyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160212
					]
				},
				{
					"id": 230160203,
					"content": "O kadar demir dövdükten sonra Bay Garcia'nın elleri uyuştu, biraz dinlenmesi lazım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160204
					]
				}
			]
		},
		{
			"id": 2301603,
