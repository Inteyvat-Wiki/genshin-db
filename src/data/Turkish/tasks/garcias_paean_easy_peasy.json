			"dialogs": [
				{
					"id": 230160301,
					"content": "Lutong! Bu çarkı kalıptan çıkarma zamanı geldi! Gelip bana yardım et!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160302
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160302,
					"content": "Gezgin, döndün demek. Bay Ahangar sana tüm püf noktalarını öğretti, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160303
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160303,
					"content": "O halde söyle bakalım, bu çarkı nasıl işlemeliyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
		},
