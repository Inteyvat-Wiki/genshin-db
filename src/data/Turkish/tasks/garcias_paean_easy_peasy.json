						230165102,
						230165105
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230165102,
					"content": "Garcia uzun zamandır burada mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230165103
					]
				},
				{
					"id": 230165103,
					"content": "Evet, oldukça uzun zamandır diyebilirim. O adamdaki tutku bazı çıraklarımda bile yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165104
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230165104,
					"content": "Gerçi hayatını demirci olarak geçirmek isteyecek birine de benzemiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230165105,
					"content": "Onu benim dışımda ziyaret eden biri var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230165106
					]
				},
				{
					"id": 230165106,
					"content": "Hımm... Onu sık sık görmeye gelen bir kadın var, gelirken yanında bir sürü şey getiriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165107
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230165107,
					"content": "Bana o kadının adının Kaia gibi bir şey olduğunu söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165108
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230165108,
					"content": "Bir türlü anlamıyorum. Bu insanlar demirci de değiller. Neden benim demirci dükkanımda takılıyorlar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ahangar"
				}
