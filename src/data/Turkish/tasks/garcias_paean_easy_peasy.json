			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Garcia",
					"Lutong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230160101,
					"content": "Ellerim... Of! Ellerim tamamen uyuştu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160102
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160102,
					"content": "Daha sonra Kaia Hanım için hesap yapmanız gerek efendim. Lütfen kendinizi çok yormayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160103
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230160103,
					"content": "Şu an olmaz Lutong! Ben de farkındayım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160104
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160104,
					"content": "Tabii yapamayacaksanız sizin yerinize ben de yapabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160105
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230160105,
					"content": "Hayır! Kendim yapacağım. Benim sadece... Birkaç çark daha yapmam gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160106
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160106,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160107
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160107,
					"content": "Pekala, pes ediyorum, devam edemeyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160108
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160108,
					"content": "Şimdi ne yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160109
					]
				},
				{
					"id": 230160109,
					"content": "Ah, merhaba Gezgin... Of... Ellerim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160110
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160110,
					"content": "Durum şu... Bay Ahangar başka işlerle de meşgul olduğu için ondan ihtiyacım olan parçaları yapmasını her zaman isteyemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160111
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160111,
					"content": "Bir de onun yaptığı parçalarla benim aklımda canlandırdıklarım arasında çok az fark oluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160112
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160112,
					"content": "Bu yüzden ben de bu parçaların tam olarak doğru üretildiğinden emin olmak için parçaları kendim üretmeye karar verdim ve Bay Ahangar'dan bana demircilik becerilerini öğretmesini rica ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160113
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160113,
					"content": "Neyse ki Fontaine'de bu konuda tecrübe edinmiştim ama Bay Ahangar'ın anlattığı tekniklerden bazılarını hatırlamak çok zor. Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160114
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160114,
					"content": "Gezgin, lütfen gidip Bay Ahangar'dan demircilik tekniklerini öğrenebilir misin? Benim biraz dinlenmem lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160115,
						230160116
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160115,
					"content": "Siz burada güzelce dinlenin Bay Garcia.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160121
					]
				},
				{
					"id": 230160121,
					"content": "Yardım etmeyi kabul ettiğin için teşekkürler. Of... Ellerim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160116,
					"content": "Kaia kim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230160117
					]
				},
				{
					"id": 230160117,
					"content": "Bir iş ortağı! Bir... Iıh... Daha doğrusu çok yetenekli ve zengin bir iş ortağı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160118
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160118,
					"content": "Onunla uzun vadeli bir muhasebe sözleşmesi yaptık! Onunla bu kadar sık görüşmemin sebebi de bu. Eminim Lutong da bu söylediğimi destekleyecektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160119
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230160119,
					"content": "Söylediğiniz tam olarak doğru efendim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230160120
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230160120,
					"content": "Şimdilik durum bu... Gezgin, bir an önce Bay Ahangar'ı bulmamıza yardım et. Ben burada bekleyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
		},
		{
			"id": 2301602,
			"completionStepIds": [
				2301602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
