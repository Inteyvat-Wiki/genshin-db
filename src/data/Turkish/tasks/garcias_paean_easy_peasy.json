			"dialogs": [
				{
					"id": 230163901,
					"content": "Garcia çalışmaya başlıyor...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230163902
					]
				},
				{
					"id": 230163902,
					"content": "İşte! Başardım! Kendim yaptım diye demiyorum ama bu çark gerçekten güzel oldu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163903
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230163903,
					"content": "Dişleri arasındaki boşluklar... Kalınlığı... Boyutları... Hemen gidip bir cetvel getirmeliyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163904
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230163904,
					"content": "Bırakalım da Bay Garcia ölçümlerini yapsın. Gezgin, işte ödemen. Lütfen bunu al.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163905
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230163905,
					"content": "Hâlâ temkinli bir umutsuzluk içinde misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230163906
					]
				},
				{
					"id": 230163906,
					"content": "Evet, hep öyleyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163907
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230163907,
					"content": "Bay Garcia ve ben bir süredir dev bir dağın karşısındayız ve tek yapabildiğimiz dağın eteğindeki küçük bir taşı oynatmak oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163908
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230163908,
					"content": "Doğrusunu söylemem gerekirse henüz dağı aşmamızı sağlayacak bir yol bulamadık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163909
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230163909,
					"content": "Umarım Bay Garcia'nın yetenekleri bizi doğru yola çıkarır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230163910
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230163910,
					"content": "Yoksa kendime \"Yoluna bir dağ çıktıysa onu aşmanı sağlayacak bir yol da çıkar.\" sözünü hatırlatıp durmam gerekecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				}
			]
		},
