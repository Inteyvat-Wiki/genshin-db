					"id": 230165001,
					"content": "Efendim, acaba yaklaşımımızı değiştirmemizi önerebilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165002
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230165002,
					"content": "Yaklaşımımızı mı değiştirelim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165003
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230165003,
					"content": "Belki daha az karmaşık ama bir o kadar da detaylı bir şey yapabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165004
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230165004,
					"content": "İnanıyorum ki sizin bu tür makinalar yapma yeteneğiniz sayesinde biz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165005
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230165005,
					"content": "Sevgili Lutong'um, bu konuyu daha önce konuşmuştuk. Cevabımı biliyorsun. Yine de seçimlerine her zaman saygı duyarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165006
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230165006,
					"content": "Belki de bunun yerine Kaia Hanım ile sonraki buluşmanızda nerede yemek yiyeceğinizi konuşsak daha iyi olur efendim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165007
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230165007,
					"content": "Teşekkürler Lutong.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230165008
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230165008,
					"content": "Memnuniyetle efendim. Sözleşmemiz henüz sona ermedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				}
