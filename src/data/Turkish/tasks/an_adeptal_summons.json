			"dialogs": [
				{
					"id": 718021001,
					"content": "Jueyun'a gelip de Adeptusları aramak hiç kolay bir şey değildir. Ama yine de gelmişsiniz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021002
					],
					"speakerTitle": "Adeptusun evini ziyaret et",
					"speakerSubtitle": "Değişik Gelen Ses"
				},
				{
					"id": 718021002,
					"content": "Aaa! L-Liyue Limanı'na gitmemiş miydi o? Gizlice geri mi döndü acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021003,
					"content": "Sesi... Tuhaf geliyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021004
					]
				},
				{
					"id": 718021004,
					"content": "Iı, şey, biri evinden bir şeyler çalarsa diye endişe etmiştik aslında. Amacımız seni rahatsız etmek değildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021005,
					"content": "... Şahsım size bir görev verecek. Başarıyla tamamladığınız takdirde içeri girebileceksiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021006,
						718021007
					],
					"speakerTitle": "Adeptusun evini ziyaret et",
					"speakerSubtitle": "Değişik Gelen Ses"
				},
				{
					"id": 718021006,
					"content": "Şu anda kendi kendine konuşuyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021008
					]
				},
				{
					"id": 718021008,
					"content": "Şey, yani şu an onunla değil de burada bıraktığı bir makinayla mı konuşuyoruz diyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718021009,
					"content": "Bir keresinde şahsım kendi mekanik çalışmalarında mütevazı bir atılım yapmış ve kendisi için havada asılı duran Bulutlardaki Meskeni inşa etmişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021010
					],
					"speakerTitle": "Adeptusun evini ziyaret et",
					"speakerSubtitle": "Değişik Gelen Ses"
				},
				{
					"id": 718021010,
					"content": "Ve bu Mesken tamamlandığında şahsım, bir Adeptusla karşılaşma ihtimalinin ne kadar az olduğunu düşündü. Sonra da kaderinde olan birinin alacağını umarak taslağı orada bıraktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021011
					],
					"speakerTitle": "Adeptusun evini ziyaret et",
					"speakerSubtitle": "Değişik Gelen Ses"
				},
				{
					"id": 718021011,
					"content": "Taslağı oradan aldığınızda tekrar şahsımın meskenine girebilirsiniz. O zaman daha fazla konuşuruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021012
					],
					"speakerTitle": "Adeptusun evini ziyaret et",
					"speakerSubtitle": "Değişik Gelen Ses"
				},
				{
					"id": 718021012,
					"content": "Iıı, Leydi Adeptus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021013
					]
				},
				{
					"id": 718021013,
					"content": "Bulutlar Hakimi? Xiany... Iıı, Bayan Xianyun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021014
					],
