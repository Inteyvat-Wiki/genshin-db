				"points": []
			},
			"dialogs": [
				{
					"id": 718020201,
					"content": "Bunlar gerçekten de Bulutlardaki Meskenin taslakları. Yüce Olan memnun kaldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020202
					],
					"speakerTitle": "Bulutlar Hakimi"
				},
				{
					"id": 718020202,
					"content": "Ne yapacağını hâlâ söylemedin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718020203
					]
				},
				{
					"id": 718020203,
					"content": "Beni sorgulamaya devam edecek misin? *iç çeker* Pekala, bir adak sunduğunu düşünürsek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020204
					],
					"speakerTitle": "Bulutlar Hakimi"
				},
				{
					"id": 718020204,
					"content": "Yüce Olan, Liyue'nin üzerinde havada asılı duran ve ölümlülerin elleriyle inşa edilmiş Yeşim Konak'ı duydu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020205
					],
					"speakerTitle": "Bulutlar Hakimi"
				},
				{
					"id": 718020205,
					"content": "Yüce Olan ayrıca ölümlülerin boyuta her şeyden çok değer verdiğini ve bu nedenle söz konusu konağın tüm dünyada eşi benzeri olmadığını söylemeye başladığını da duydu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020206
					],
					"speakerTitle": "Bulutlar Hakimi"
				},
				{
					"id": 718020206,
					"content": "Peh! Ölümlülerin idrak becerileri o denli kısıtlı ki Adeptusların maharetini kavrayabilmeleri söz konusu değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020207
					],
					"speakerTitle": "Bulutlar Hakimi"
				},
				{
					"id": 718020207,
					"content": "Yeşim Konak imiş! En önemsiz mekanik eserlerim bile Yeşim Konak'ın son derece sıkıcı ve sıradan bir eser olduğunu gözler önüne serer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020208
					],
					"speakerTitle": "Bulutlar Hakimi"
				},
				{
					"id": 718020208,
					"content": "Kaybetmeyi hazmedemiyorsun sanki...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718020209
					]
				},
				{
					"id": 718020209,
					"content": "Saçmalık! Ne kaybederim ne de hazım sorunları yaşarım... Ahmaklara acıyorum yalnızca! Adeptusların maharetine karşı kör olan bu ölümlülerin gözleri, zerre zarafet içermeyen bir eser görünce kamaşıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020210
					],
					"speakerTitle": "Bulutlar Hakimi"
				},
				{
					"id": 718020210,
					"content": "Korkarım bu durum, ölümlüler arasındaki işleyişlerin yanlış yönde gelişmesine neden olacak. Onları doğru yola yönlendirmek bana düşüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020211
					],
					"speakerTitle": "Bulutlar Hakimi"
				},
				{
					"id": 718020211,
					"content": "Konu kapanmıştır. Derhal huzurumdan ayrıl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulutlar Hakimi"
				}
			]
		},
		{
			"id": 7180203,
			"completionStepIds": [
				7180207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
