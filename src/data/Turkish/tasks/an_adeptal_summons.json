				"points": []
			},
			"dialogs": [
				{
					"id": 718020301,
					"content": "Talebini belirt! Yüce Olan'ın ilgilenmesi gereken pek çok mesele var. Bir Adeptusun değerli vaktini boşa harcama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020302
					],
					"speakerTitle": "Adeptusun evini ziyaret et"
				},
				{
					"id": 718020302,
					"content": "Nasılsın diye soracaktım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718020303
					]
				},
				{
					"id": 718020303,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020304
					],
					"speakerTitle": "Adeptusun evini ziyaret et"
				},
				{
					"id": 718020304,
					"content": "Garip bir talep... Başka herhangi bir isteğin olmadan yalnızca bana iyi dileklerini iletmeye mi geldin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020305
					],
					"speakerTitle": "Adeptusun evini ziyaret et"
				},
				{
					"id": 718020305,
					"content": "Pekala, öyle olsun! Ölümlülere akıl sır ermiyor. Anlamaya çalışmak gibi bir niyetim yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020306
					],
					"speakerTitle": "Adeptusun evini ziyaret et"
				},
				{
					"id": 718020306,
					"content": "Madem şu anda bir işin yok... Bana küçük bir iyilik yapmak ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020307
					],
					"speakerTitle": "Adeptusun evini ziyaret et"
				},
				{
					"id": 718020307,
					"content": "Mekanik çalışmalarımda makul düzeyde ilerleme kaydettiğim bir gün kendime havada asılı duran Bulutlardaki Meskeni inşa ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020308
					],
					"speakerTitle": "Adeptusun evini ziyaret et"
				},
				{
					"id": 718020308,
					"content": "Bulutlardaki Mesken, çok sayıda dahice tasarımla birlikte plaustrit kullanılarak inşa edildi... Hatta en muazzam özelliği de... Boş ver, açıklasam bile anlamazsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020309
					],
					"speakerTitle": "Adeptusun evini ziyaret et"
				},
				{
					"id": 718020309,
					"content": "Bulutlardaki Meskenin inşası tamamlandıktan sonra taslakları orada bıraktım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020310
					],
					"speakerTitle": "Adeptusun evini ziyaret et"
				},
				{
					"id": 718020310,
					"content": "Ayrıca taslakları edinmeye kafayı takan birinin başarıya ulaşamaması için taslaklara mühür ekledim. Bugüne dek işe yaradı, mühür hâlâ duruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020311
					],
					"speakerTitle": "Adeptusun evini ziyaret et"
				},
				{
					"id": 718020311,
					"content": "Taslakları orada saklamama artık gerek yok. Benim için onları Bulutlardaki Meskenden alabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020312,
						718020314
					],
					"speakerTitle": "Adeptusun evini ziyaret et"
				},
				{
					"id": 718020312,
					"content": "Elbette!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718020313
					]
				},
				{
					"id": 718020313,
					"content": "Ne kadar isteklisin. O halde gecikme, taslakları bulduğunda mevcut meskenime getir. Seni orada bekleyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adeptusun evini ziyaret et"
				},
				{
					"id": 718020314,
					"content": "Taslaklarla ne yapacaksın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718020315
					]
				},
				{
					"id": 718020315,
					"content": "Kendi nedenlerim var. Ama lütfen bir Adeptusun zihninde tasarladığı fikirleri irdeleyebileceğini sanma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020316
					],
					"speakerTitle": "Adeptusun evini ziyaret et"
				},
				{
					"id": 718020316,
					"content": "Daha fazla gecikme. Bulduğunda taslakları mevcut meskenime getir, seni orada bekleyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adeptusun evini ziyaret et"
				}
			]
		},
