			"dialogs": [
				{
					"id": 718020401,
					"content": "Taslakları hâlâ almadınız mı? Yapmanız gereken tek şey Bulutlardaki Meskene gitmek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020402
					],
					"speakerTitle": "Adeptusun evini ziyaret et"
				},
				{
					"id": 718020402,
					"content": "Of, taslakları henüz getirmediğimizi nereden bildi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718020403,
					"content": "O taslaklar benim eserim, yakınımda olup olmadıklarını hissedebilmem gayet normal değil mi? Şimdi onları getirin hemen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adeptusun evini ziyaret et"
				}
			]
		},
