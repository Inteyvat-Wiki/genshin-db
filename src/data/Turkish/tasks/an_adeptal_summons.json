					"nextDialogs": [
						718021307
					],
					"speakerTitle": "Bulutlar Hakimi?"
				},
				{
					"id": 718021307,
					"content": "Tehlikelere karşı sarsılmaz bir iradeyle ayakta kaldınız... Gerçekten nadir görülecek bir yetenek. Bu hazineyi alabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
