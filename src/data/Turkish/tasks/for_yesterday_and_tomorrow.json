			"dialogs": [
				{
					"id": 741850101,
					"content": "Este, biz döndük!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850102,
					"content": "Aa, kimler ge... Hımm, bir saniye. Siz kimsiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850103
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850103,
					"content": "#Ne? Ne çabuk unuttun bizi ya! Biz {NICKNAME} ve Paimon'uz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850104,
					"content": "#{NICKNAME} ve Paimon... Bu isimleri tabii ki duydum ama bir rüyadaydı sanırım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850105
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850105,
					"content": "Şey... İyi ama o sırada gayet de uyanıktın Este! Hatta aşağıya indiğimizde şeyi bile görmüştük ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850106,
					"content": "*iç çeker* Rüyamda kasabadaki herkesin taş kesildiğini, heykele dönüştüğünü ve çaresiz, yapayalnız kaldığımı gördüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850107
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850107,
					"content": "En sonunda da iki cesur kahraman gelip herkesi kurtarma yükünü omuzladı... Hımm, rüya değil miydi yoksa bu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850108,
						741850109
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850108,
					"content": "Olabilir de olmayabilir de.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850110
					]
				},
				{
					"id": 741850110,
					"content": "Evet. Artık herkes normale döndü sonuçta, öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850111,
					"content": "Evet ama herkes son derece tuhaf rüyalar görmüş. Ne oldu böyle, anlamadım gitti. Topluca hipnotize falan mı edildik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850112
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850112,
					"content": "Bunu açıklamaya bir başlasak günler sürer... O yüzden sen şimdilik hipnoz meselesini unut gitsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850113,
					"content": "Öyle mi? Hipnoz demişken... Yanınızda kedi bile getirmişsiniz! Ne kadar da akıllı duruyor öyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850114,
						741850116
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850114,
					"content": "Göründüğünden de akıllıdır o.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850115
					]
				},
				{
					"id": 741850115,
					"content": "Hem de kendisi bizim yoldaşımız olur! Ne yazık ki tekrar yola koyulduğumuzda yanımıza alamayacağız onu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850118,
					"content": "Şu tesadüfe bak, bizim kulübümüzde boş bir kedi yatağı var. Hipnoz üzerine araştırma yapan arkadaşımız seyahate çıkıp kedisini de yanında götürdüğünden beri boş duruyor orası.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850119
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850119,
					"content": "Sizin için de uygunsa onu bize bırakın. Onunla biz ilgileniriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850120
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850120,
					"content": "Nasıl mümkün olduğunu anlayamıyorum ama birbirimize bir kader bağıyla bağlıymışız gibi hissediyorum. Sizin için ona gözüm gibi bakacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850121
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741850121,
					"content": "Kedi evi binanın öteki tarafında. Oraya varınca görürsünüz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Este"
				},
				{
					"id": 741850116,
					"content": "O bizim yoldaşımız.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850117
					]
				},
				{
					"id": 741850117,
					"content": "Evet, öyle ama tekrar yola koyulduğumuzda yanımıza alamayacağız onu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850109,
					"content": "Onun bir önemi yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850110
					]
				}
			]
		},
