			"dialogs": [
				{
					"id": 741850301,
					"content": "İşte burası artık senin yuvan olacak Osse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850302,
					"content": "Miyaaav?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850303
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741850303,
					"content": "Yine de bu işte bir tuhaflık var. Cassiodor buradan çoktan ayrılmış olmalı, değil mi? Bu Osse kim o zaman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850304,
					"content": "Cassiodor tarafından ele geçirilmemiş olan asıl kedi mi, yoksa bizimle birlikte onca maceraya atılan Mösyö Os mu bu? Off, Paimon'un beyni ağrımaya başladı bile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850305,
						741850307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850305,
					"content": "Sen kafanı böyle şeylere yorma Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850306
					]
				},
				{
					"id": 741850306,
					"content": "Paimon'un aklı ermiyor cidden bu işe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850309,
					"content": "Neyse, Osse'ye şimdilik yeni bir yuva da bulduk! Zaman bulabilirsek gelip onunla oynarız belki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741850310,
					"content": "Miyav miyav!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Osse"
				},
				{
					"id": 741850307,
					"content": "\"Osse\", \"Osse\" işte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850308
					]
				},
				{
					"id": 741850308,
					"content": "Paimon hâlâ tam anlamadı ama dediğin mantıklı da geliyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850309
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
