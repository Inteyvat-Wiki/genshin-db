					"nextDialogs": [
						705310102
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310102,
					"content": "Biraz vaktin varsa eğer sana Maceracılar Loncasının düzenlediği \"Harikalar Turu\" etkinliğinden bahsetmek isterim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310103,
						705310104
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310103,
					"content": "Hımm... Tabii ki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705310105
					]
				},
				{
					"id": 705310105,
					"content": "Teşekkür ederim! Önce basitçe etkinliği tanıtarak başlayayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310106
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310106,
					"content": "Özetle, Maceracılar Loncası Mondstadt'ın farklı noktalarına Manzara Noktaları yerleştirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310107
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310107,
					"content": "Tek yapman gereken bu Manzara Noktalarını bulup her noktadaki anı damgalarını Gezi Rehberine eklemek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310108
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310108,
					"content": "Tüm Manzara Noktalarını bulup tüm damgaları topladığında mücadele tamamlanmış sayılacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310109
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310109,
					"content": "Tam da Maceracılar Loncasının düzenleyeceği bir etkinliğe benziyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705310110
					]
				},
				{
					"id": 705310110,
					"content": "Hehe... Manzara Noktalarını yerleştirirken epey kafa yorduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310111
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310111,
					"content": "Ancak... Bunlardan bazıları uzak bölgelerde ve hiç canavar olmadığını da garanti edemem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310112
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310112,
					"content": "Ama senin gibi tecrübeli biri için o canavarların icabına bakmak çocuk oyuncağı olsa gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705310113
					],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310113,
					"content": "Benden bu kadar! İşte Gezi Rehberin burada. İyi eğlenceler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Onnea"
				},
				{
					"id": 705310104,
					"content": "Tamam, anlat bakalım...",
