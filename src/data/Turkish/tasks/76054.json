			},
			"dialogs": [
				{
					"id": 760540101,
					"content": "Aa, Columbina nerede? Paimon onu hiçbir yerde göremiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540102,
					"content": "Buradayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540103
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540103,
					"content": "Vay canına! Orada ne yapıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540104,
					"content": "Buraya gelin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540105
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540105,
					"content": "Bu sefer kendimizi neyin içine sokuyoruz acaba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540106,
					"content": "Geçen sefer topladığımız taşları hatırlıyor musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540107
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540107,
					"content": "Geçen sefer mi? Ha, Kuuvahki emdikten sonra parlayan cevherleri mi kastediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540108,
					"content": "Evet. Ondan sonra Kuuhenkiler biraz daha topladılar ve onları koyu ve açık renk olanlar diye ikiye ayırdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540109
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540109,
					"content": "Koyu ve açık renk mi? Neden ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540110,
					"content": "Ay Satrancı oynamak için tabii ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540111
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540111,
					"content": "Ha... \"Ay Satrancı\" da nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540112,
					"content": "Aa, hiç oynamadınız mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540113
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540113,
					"content": "... Hayır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760540114
					]
				},
				{
					"id": 760540114,
					"content": "Anlıyorum... Donuk Ayın Çocuklarının yere çizdikleri kareleri gördüğümden beri hep denemek istemişimdir. Ama hiç oynayacak kimsem olmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540115
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540115,
					"content": "Kuralları nasıl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540116,
					"content": "Hım... Gösterirsem daha kolay olur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540117
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540117,
					"content": "Vay canına! B-Bu harika! Nasıl yaptın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540118,
					"content": "Hım? Biraz Kuuvahki ile elbette... Siz yapamıyor musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540119
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540119,
					"content": "Hahaha... Beklentilerini biraz düşürsen iyi olur. Hepimiz ay tanrıçası değiliz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540120,
					"content": "Nasıl istersen. Buna tahta denir ve \"gece göğünü\" temsil eder. Her oyuncunun kontrol ettiği taşlar ise \"ayları\" temsil eder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540121
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540121,
					"content": "İki oyuncu sırayla aylarını gökyüzüne yerleştirir ve arka arkaya üç ay alan ilk kişi kazanır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540122
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540122,
					"content": "Haa! Bu bildiğin üç taş oyununun başka bir versiyonu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540123,
					"content": "Demek buna Nod-Krai'da \"Ay Satrancı\" deniyor... Yerel bir dokunuş olmuş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540124,
					"content": "Anlıyorum. Buradaki versiyonda aylar döner, bu da gökyüzünde aynı anda üç aydan fazla olamayacağı anlamına gelir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540125
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540125,
					"content": "Yani gece göğündeki aylar belirli bir sayıya ulaştığında ilk yükselen ay kaybolur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540126
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540126,
					"content": "Bu... Çok mantıklıymış... Ve oyunu çok daha zorlaştırıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540127,
					"content": "Denemek ister misiniz? Benim de ilk oynayışım olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540128
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760540128,
					"content": "(Anlaşılan oynamayı dört gözle bekliyor...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760540129
					]
				},
				{
					"id": 760540129,
					"content": "#Hehe, kulağa eğlenceli geliyor! Paimon hakem olacak! Ama {NICKNAME} çok zekidir, dikkat et!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760540130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760540130,
					"content": "Tamamdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Küçük Hanım"
				}
			]
		},
