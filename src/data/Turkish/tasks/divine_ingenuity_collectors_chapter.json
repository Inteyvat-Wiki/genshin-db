			},
			"dialogs": [
				{
					"id": 706740101,
					"content": "Neden bu sefer Mondstadt'a geldi acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740102,
						706740103
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 706740102,
					"content": "Honglang?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706740104
					]
				},
				{
					"id": 706740104,
					"content": "Gezgin? Bu ne tesadüf! Burada olmanı beklemiyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740105
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 706740105,
					"content": "Şu anki durumdan bahsedecek olursam... Şu yanımdaki kapıya bakar mısın? Şimdiden anladığını sanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740106,
						706740107
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 706740106,
					"content": "Yine öyle bir Zindan mı ortaya çıktı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706740108
					]
				},
				{
					"id": 706740108,
					"content": "Aynen öyle. Yardımların sayesinde önceki Zindandan çeşitli önemli verileri toplama imkanımız olmuştu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740109
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 706740109,
					"content": "Ancak dışarıdan o Zindan hakkında daha fazla işe yarar bilgi almak mümkün değildi. Lonca da denedi ama nafile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740110
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 706740110,
					"content": "Bu yüzden biz de içeri daha fazla insan göndermeye hazırlanıyorduk. Diğer Loncalardan da birilerini çağırdık hatta ama sonra... O kayboldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740111
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 706740111,
					"content": "Bugün Mondstadt'ta yeniden belirene kadar ondan hiç haber alamamıştık. Neyse ki Mondstadtlı dostlarımızın vaktinde haber vermesi sayesinde ben de buraya zamanında gelebildim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740112
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 706740112,
					"content": "İncelemeye başladın mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706740113
					]
				},
				{
					"id": 706740113,
					"content": "Tabii ki. Avım tam karşıma çıkmışken neden geri çekileyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740114
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 706740114,
					"content": "Zindanın kuralları çok değişmemiş. Hâlâ içeri girenlerin hayal gücüne bağlı olarak farklı şeyler yaratıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740115
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 706740115,
					"content": "Ancak derinlerine indikçe bu Zindanın artık belirli \"düşmanlar\" yaratabildiğini keşfettik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740116
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 706740116,
					"content": "Bize saldırıyorlardı ve bunu yaptıklarında gerçek acı da hissettik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740117
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 706740117,
					"content": "Nasıl desem... Gerçek bir savaştan hiçbir farkı yoktu. Diğer maceracılar bunu çok ilginç buldular.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740118
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 706740118,
					"content": "Fakat bazıları yenemeyecekleri düşmanların yaratılmasına sebep oldular ve yardım istemek zorunda kaldılar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740119
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 706740119,
					"content": "*öksürür* Neyse, boş ver. Bizimle beraber tekrar bu Zindanı keşfetmek ister misin Gezgin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740120,
						706740122
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 706740120,
					"content": "Olur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706740121
					]
				},
				{
					"id": 706740121,
					"content": "Hahaha, muhteşem! Yardımınla eminim sorunsuz bir şekilde ilerleme kaydedebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Honglang"
				},
				{
					"id": 706740122,
					"content": "Çok tehlikeli olmayacak değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706740123
					]
				},
				{
					"id": 706740123,
					"content": "Hımm, sana bir şey olmayacağından eminim. Sadece dikkatli ol!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706740124
					],
					"speakerTitle": "Honglang"
				},
				{
					"id": 706740124,
					"content": "Her halükarda, eğer bizimle Zindanı keşfe çıkarsan eminim sorunsuz bir şekilde ilerleme kaydedebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Honglang"
				},
				{
					"id": 706740107,
					"content": "Önceden araştırdığın o Zindan ile aynı mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706740108
					]
				},
				{
					"id": 706740103,
					"content": "Bu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706740104
					]
				}
			]
		}
	]
}