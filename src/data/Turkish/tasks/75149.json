			"dialogs": [
				{
					"id": 751491101,
					"content": "Raaa... Rrarrr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491102
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751491102,
					"content": "Neyin var? Pek iyi görünmüyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751491103,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491104
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751491104,
					"content": "Hiçlik mi şu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751491105,
					"content": "\"Evet... Hiçlik canavarları, Kutsal Şehir Tollan'ı dermansız bir salgın gibi istila etti.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491106
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751491106,
					"content": "\"Şu aşamada bizzat Kutsal Dağ'ı yıkmadan onların ilerleyişini tamamen engellemek imkansız olabilir...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491107
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751491107,
					"content": "Eğer bir Hiçlik canavarı görürsen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751491108
					]
				},
				{
					"id": 751491108,
					"content": "\"O yapışkan siyah haydutlar evini çoktan istila etmiş olabilir...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491109
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751491109,
					"content": "Raarr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751491110,
					"content": "Öf, bu kadar ürkütücü şeyler söylemenize gerek var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751491111,
					"content": "Kıralım şunların bacaklarını, bakalım o zaman ilerleyebilecekler mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751491112
					]
				},
				{
					"id": 751491112,
					"content": "Oo, ne kadar akıllıca bir öneri, o halde gel bacaklarını bulalım... Hah! Paimon gülmeden duramadı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751491113,
					"content": "Raarr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491114
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751491114,
					"content": "\"Haha. Üzgünüm ufaklık ama çoğu Hiçlik canavarı bacağı olmadan da ilerleyebilir.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491115
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751491115,
					"content": "\"... Yalnızca yolumuzu kapayan gölge düşmanı yok ederek buradan geçebilir ve Kutsal Dağ'ın Kalbi'ne ulaşabilirsiniz.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491116
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751491116,
					"content": "\"Bu yıkılmış kadim şehre eski ihtişamını tekrar kazandırmak için yapabileceğiniz hiçbir şey yok. Fakat cesedi bu karanlık canavarların insafına terk edilmemeli.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491117
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751491117,
					"content": "Bir dakika, sen alev topu fırlatmıyor muydun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751491118
					]
				},
				{
					"id": 751491118,
					"content": "Evet. Hiçlikle öyle savaşmıyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751491119,
					"content": "\"Alev topu derken... Yıldız Kümelerinden mi bahsediyorsunuz? Hayır, onlar ancak Hiçlik ile temasa geçtiğinde birbirlerini yok edebilirler. Yoksa karanlık onları yozlaştırıp sarar...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491120
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751491120,
					"content": "\"Ne yazık ki bu şehir uzun zamandır mühürlü... Şehrin dengesini korumak için Yıldız Kümelerinin özgür hareket etmesi yasaklandı...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491121
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751491121,
					"content": "\"Ey Ejderhaların Seçilmişi...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491122
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751491122,
					"content": "Raarr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491123
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751491123,
					"content": "\"Tollan kurulduktan sonra Kutsal Dağ'ın Kalbi yeniden kazıldı... Ve ilk Gizli Kaynak Ejderha Heykeli koruyor onu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491124
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751491124,
					"content": "\"Kalbe erişmek için izin alman gerekiyor...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491125
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751491125,
					"content": "\"Ama Heykelin güç kaynağı da bozulmuş. Yeniden etkinleştirmenin bir yolunu bulmalıyız...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491126
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751491126,
					"content": "\"Onlar...\" Uyarı. İşlevler hasarlı. Yakında kapanacak... \"Ah, görünüşe göre bu makina...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491127
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751491127,
					"content": "Amaru? Hey, Amaru! Ne izni? Hadi ama, daha bir şey söylemedin sayılır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751491128,
