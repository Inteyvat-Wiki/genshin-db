						],
						"pointId": 910101004
					}
				]
			},
			"dialogs": [
				{
					"id": 751490301,
					"content": "\"Bu arada adını resmen sana söylemiş miydim? Sanırım söylemedim...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490302
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751490302,
					"content": "\"Neyse. İlk Kutsal Şeh{RUBY#[D]Kadim Ateş Diyarı}ir Tollan'a hoş geldiniz.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490303
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751490303,
					"content": "Vay be... Paimon yanardağın içinin böyle görüneceğini tahmin etmezdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751490304,
					"content": "Burası gerçekten yanardağın içi mi? Yoksa kraterden geçerken farklı bir noktaya mı fırlatıldık?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751490305,
					"content": "Rarr... Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490306
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751490306,
					"content": "\"Burası kesinlikle Kutsal Dağ'ın içi, ama ben bile... Böyle bir manzara ne zamandır görmemiştim.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490307
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751490307,
					"content": "\"Ah... Ancak ışık tekrar üzerine düşünce gördüm ne kadar çürüdüğünü...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490308
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751490308,
					"content": "Ehecatl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751490309,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490310
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751490310,
					"content": "Raarr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490311
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751490311,
					"content": "\"Ah, özür diliyorum. Bir an sebepsiz yere duygularıma kaptırdım kendimi...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490312
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751490312,
					"content": "Enerji düzeyi düşük... Uyku moduna girilecek. Lütfen enerji depolama cihazını... Değiştirin veya bağlayın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490313
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751490313,
					"content": "\"Haha. Görünüşe göre sevgili Ehecatl'ın uzun süren 'sürgünü' yüzünden çok az vakti kalmış...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490314
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751490314,
					"content": "Bir saniye, nasıl yani? Ehecatl... Ölecek mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751490315,
					"content": "\"Sizin Ehecatl dediğiniz... Uzun zaman önce yaşama veda etti... Özetlemek gerekirse Tollan'ın yeniden başlaması için çok fazla enerjiye ihtiyacı var, hiçbir israfa göz yumulamaz. Sizin yapmanız gereken...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490316
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751490316,
					"content": "\"Diğer iki 'Yıldız Kü{RUBY#[D]Tzitzimimeh}mesinden ilkinin mührünü kırın... Diğerininkini de... Ancak o zaman ortadaki Semavi Ekseni etkinleştirebilirsiniz...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490317
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751490317,
					"content": "\"Şey...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490318
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751490318,
					"content": "İyi misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751490319
					]
				},
				{
					"id": 751490319,
					"content": "\"... İyiyim. Tekrar... Karşılaşacağız...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490320
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751490320,
					"content": "\"*iç çeker*... Pekala Ejderhaların Seçilmişi, yola devam... Heyhat, canlılığını yitiren bir bedenin acısı... Bunca yıl sonra bile... Alışabilmiş değilim...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490321
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751490321,
					"content": "Raarr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490322
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751490322,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490323
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751490323,
					"content": "Ehecatl'ın etrafındaki ışık gitti... Artık hareket de etmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751490324,
					"content": "Paimon'un kafası hâlâ biraz karışık... Konuşan gerçekten Ehecatl mıydı, yoksa Ehecatl üzerinden başka biri mi konuşuyordu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490325,
						751490326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751490325,
					"content": "Yakında öğreniriz...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751490327
					]
				},
				{
					"id": 751490327,
					"content": "Tamam. Bu arada, bahsettiği Yıldız Kümeleri... Acaba şu büyük alev topları gibi bir şeyden mi söz ediyordu? Bir de \"Semavi Eksen\" nedir? Hiçbir fikrimiz yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751490328,
					"content": "Neyse, hadi etrafa bir bakalım ve söylediği tuhaf şeyleri bulmaya çalışalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751490329,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751490326,
					"content": "Şimdilik ilerlemeye devam edelim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751490327
					]
				}
			]
		},
