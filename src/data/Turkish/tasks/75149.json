			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ehecatl",
					"#{REALNAME[ID(2)|SHOWHOST(true)]}"
				],
				"points": [
					{
						"sceneId": 101,
						"position": [
							561.16,
							819.386,
							-45.567
						],
						"pointId": 52
					},
					{
						"sceneId": 101,
						"position": [
							562.786,
							818.938,
							-45.043
						],
						"pointId": 910101004
					}
				]
			},
			"dialogs": [
				{
					"id": 751490201,
					"content": "\"Buranın her zaman bu kadar karanlık olmadığını belirtmem gerek... Her ne kadar bir yanardağın 'içi' olsa da...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490202
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751490202,
					"content": "\"Fakat savaş bittiğinde şehrin tamamı yerle bir olmuştu. Bunun üzerine böyle devasa bir mekanik yapı da işlerliğini yitirdi...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490203
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751490203,
					"content": "Savaş mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751490204,
					"content": "\"Evet, geriye kalan Ejder Soyu ile insanlar arasında geçen, alevlerin gerçek efendisinin öldürüldüğü savaş...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490205
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751490205,
					"content": "\"Bu yerin efendisi uzun zaman önce öldü ve sadece şehir hayatta kalabildi... Tabii kim bilebilir, belki şehir de yaşamaktan vazgeçmiştir çoktan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490206
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751490206,
					"content": "\"... Hımm. Belki de geçmişte var olduğunu sandığımız birçok şey yanılsamadan ibaretti.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490207
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751490207,
					"content": "Raarr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490208
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751490208,
					"content": "\"Bu işten ikimiz de karlı çıkacağız ufaklık. Sen istediğini alacaksın, ben de kendi dertlerime çare bulmak için senin gücünü kullanacağım...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490209
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751490209,
					"content": "\"Kutsal Dağ'ın Kalbi'ne ulaşmalısın... Ama ne yazık ki savaş sırasında Kutsal Dağ'ın gücü kesildi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490210
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751490210,
					"content": "\"Mühürlerin gücü, yalnızca bir çocuğu yakalayacak kadar zayıf olsa da yemin, yalnızca bir 'insanın' onları etkinleştirebileceğini söylüyor...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490211
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751490211,
					"content": "\"İlginçtir ki bu yöntemi kullanarak Kutsal Dağ'a sızan zavallı çocuk, daha sonra bire bir aynı yöntemi kullanan başka biri tarafından harap edildi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490212
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751490212,
					"content": "\"Hehe. Her zaman böyle olmuştur... Örneğin bir tiranın müritleri kahramanlar tarafından kovulur, uzun yıllar dolandıktan sonra onların soyundan gelenler de başka bir diyarda başka bir tiranlığı bitirirler...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490213
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751490213,
					"content": "\"Dünya bir sahne, yaşananlar ise bir tiyatro oyunu gibidir. Sebep ve sonuç, intikam ve isyan... Hepsi sonsuza dek tekrarlanır durur...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490214
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751490214,
					"content": "\"Ah, konudan saptım galiba... Neyse. Etkinleştir şunu, can çekişen bu başkent bir süre daha kıvransın. Senden başka bunu yapabilecek kimse yok.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ehecatl"
				}
			]
		},
		{
			"id": 7514903,
