					}
				]
			},
			"dialogs": [
				{
					"id": 751491001,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}? Ne oldu? Bir şey mi buldun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751491002,
					"content": "Roaarrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491003
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751491003,
					"content": "Hımm. Bu... Gukuzorun taşıdığı heykel. Demek o da buraya düşmüş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751491004,
					"content": "#Aslında biraz sana benziyor {REALNAME[ID(2)|SHOWHOST(true)]}, ama kulaklarının daha büyük ve top olmuş hali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751491005,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491006
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751491006,
					"content": "Gerçekten mi? Katılmıyor musun? Paimon'a göre gayet de benziyor işte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751491007,
					"content": "Aa! Hareket ediyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751491008,
					"content": "*cızırtı*... *çıkıt*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491009
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751491009,
					"content": "Kontrol yapılıyor... Eklemlerde orta miktarda toz algılandı... Depolama ortamı etkinleştirildi... Konuşma... Uzaktan çıkarma... Geçersiz kılma izni verildi... *çıkıt*... Kişilik modülü düzeltildi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491010
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751491010,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491011
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751491011,
					"content": "Raarr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491012
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751491012,
					"content": "Hımm, demek bu bir heykel değilmiş, bir tür mekanizmaymış... Şu Gizli Kaynak Mekanizmalarına benziyor. Ayrıca etrafında garip bir ışık var... Daha önce bir yerde görmüştük sanki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751491013,
					"content": "Hımm? Neden durdu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491014
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751491014,
					"content": "\"Aaaaaaa!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491015
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751491015,
					"content": "Ayyy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751491016,
					"content": "\"Ah. Ses modülüm çalışıyor anlaşılan. Pekala saygıdeğer konuklar. Uzun zamandır sizi bekliyordum... Pardon, bir sorun mu var acaba?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491017
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751491017,
					"content": "O kadar yüksek sesle bağırman gerekiyor muydu? Paimon'un ödü koptu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751491018,
					"content": "\"Öyle mi? Güzel o zaman. Kalıcı bir izlenim bırakabilmem için dinamik bir giriş yapmam gerekiyordu. Yoksa sizi görmezden geldiğimi düşünebilirdiniz...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491019
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751491019,
					"content": "Şey... Sen kimsin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751491020,
					"content": "\"Kim miyim? Bu bedenin adı Ehecatl, dilerseniz öyle seslenebilirsiniz fakat adlar burada pek bir anlam ifade etmez...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491021
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751491021,
					"content": "Bireysel tahsis değişikliği talebi... Kayıtlar aracılığıyla... Savaştan 150 yıl sonra... Tahsis için kayıp listesinden biri seçildi: Ehecatl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491022
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751491022,
					"content": "\"Aynen öyle. O zamandan beri bu bedenin adı Ehecatl...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491023
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751491023,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491024
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751491024,
					"content": "\"Evet, sizi buraya ben çağırdım. Hadi Kutsal Dağ'ın Kalbi'ne gidelim... Çok geç olmadan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751491025
					],
					"speakerTitle": "Ehecatl"
				},
				{
					"id": 751491025,
					"content": "\"Gerçi henüz acele etmemize gerek yok. İzninizle Ehecatl önünüzdeki karanlığın en azından bir kısmını temizlesin. Şüpheleriniz olduğunu biliyorum ama lütfen şimdilik beni takip edin.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ehecatl"
				}
			]
		},
		{
