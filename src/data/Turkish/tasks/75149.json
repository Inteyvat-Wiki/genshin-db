			"dialogs": [
				{
					"id": 751490601,
					"content": "Rruu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490602
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751490602,
					"content": "*çıkıt çıkıt*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490603
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751490603,
					"content": "\"Görünüşe göre iki Yıldız Kümesini de normal faaliyete döndürdünüz... Yakında buradaki Filojiston yoğunluğu, iletişim cihazını yeniden etkinleştirmeye yetecek seviyeye ulaşacak...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490604
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751490604,
					"content": "\"Lütfen biraz daha bekleyin. Zaten bir insana göre fazlasıyla iyi iş çıkardınız.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490605,
						751490606
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751490605,
					"content": "Bir dakika, yine mi konuşuyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751490607
					]
				},
				{
					"id": 751490607,
					"content": "\"Değilim. Ehecatl'ın varlığı tamamen yok oldu... Hatta kısa bir süre önce yaşandı bu. Adların burada pek bir anlamı olmasa da bu bedene kalan ad...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490608
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751490608,
					"content": "\"'Kutsal Lord Yüce Amaru'... *iç çeker* Bu adın asıl sahibi tam bir şapşaldı.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490609
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751490609,
					"content": "\"Adına kısaca 'Amaru' diyebilirsiniz.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490610
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751490610,
					"content": "Amaru mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751490611,
					"content": "Raarr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490612
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751490612,
					"content": "\"Hayattayken kibirliydi, dobraydı, beyinsizdi ve sinir bozucuydu... Ama savaşta son nefesine kadar mühürlü Semavi Ekseni korudu...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490613
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751490613,
					"content": "\"İşte orası tam burasıydı, bir zamanlar onu bekleyen Gizli Kaynak Hizmetkarını da bu nedenle buraya yerleştirdim... Ustasının yokluğunda Ekseni korumaktan mutluluk duyduğunu düşünmek istiyorum.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490614
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751490614,
					"content": "Filojiston yoğunluğunda artış algılandı... Devre kontrolü tamamlandı... *cızırtı*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490615
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751490615,
					"content": "Asansör ve Semavi Eksen yeniden başlatıldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490616
					],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751490616,
					"content": "\"İşimiz bitti sayılır. Lütfen daha derinlere ilerleyin.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gizli Kaynak Hizmetkarı"
				},
				{
					"id": 751490606,
					"content": "... Sen Ehecatl mısın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751490607
					]
				}
			]
		},
