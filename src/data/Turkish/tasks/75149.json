					"content": "Rruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490907
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751490907,
					"content": "Başın iyi mi? Çok yüksekten düştün de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751490908,
					"content": "Yaralanmadın, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751490909,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490910
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751490910,
					"content": "#Hımm, iyi görünüyorsun. Peki ya sen {NICKNAME}? İyi misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490911,
						751490913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751490911,
					"content": "Tek parçayım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751490912
					]
				},
				{
					"id": 751490912,
					"content": "\"Tek parçayım\" mı? Esprinin zamanı mı şu an? *iç çeker* Paimon iyi olduğuna sevindi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751490915,
					"content": "Bu yanardağın altında böyle devasa bir yerin olacağı kimin aklına gelirdi? Çok karanlık ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490916,
						751490918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751490916,
					"content": "Hadi parılda Paimon! Aydınlat yolu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751490917
					]
				},
				{
					"id": 751490917,
					"content": "Tabii ya, Paimon şimdi hemen... YOK YA! Paimon'un parlayan bir peri olmadığını biliyorsun! Aydınlatma için kullanabileceğimiz hiçbir şey yok, tek çaremiz ateş yakmak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490920
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751490920,
					"content": "Önce biraz etrafı inceleyelim, olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490921
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751490921,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751490918,
					"content": "Meşaleyi uzat Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751490919
					]
				},
				{
					"id": 751490919,
					"content": "Tabii, sanki meşalemiz var da... Belki büyülü bir meşale ortaya çıkıverir birazdan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490920
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751490913,
					"content": "O kadar korktum ki dışarı bir şey sızdırdım... Etrafta ruhumu gördün mü hiç?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751490914
					]
				},
				{
					"id": 751490914,
					"content": "Ha ha, çok komikmiş! Eğer böyle şakalar yapabiliyorsan durumun gayet iyi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751490915
					],
					"speakerTitle": "Paimon"
				}
			]
		},
