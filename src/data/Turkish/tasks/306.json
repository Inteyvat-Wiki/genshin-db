			"dialogs": [
				{
					"id": 3061101,
					"content": "İşte bu. Terk edilmiş <color=#00E1FFFF>Dört Rüzgarın tapınaklarından</color> biri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061102,
					"content": "Bu tapınaklar yıllardır harap olmaya bırakıldı. Mondstadt halkı buraya neredeyse hiç gelmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061103
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061103,
					"content": "İçeride bir canavar yuvası veya bir dağ yabanisi kampı olma ihtimali var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061104
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061104,
					"content": "Fırtına Dehşeti bile kendi tapınağından vazgeçti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061105,
						3061106
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061105,
					"content": "\"Fırtına Dehşeti mi?\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3061107
					]
				},
				{
					"id": 3061107,
					"content": "... Evet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061108
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061108,
					"content": "Ben de bunu kabullenmeyi zor buluyorum ama... Fırtına Dehşeti bir zamanlar Dört Rüzgardan biriydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061109,
					"content": "Nee?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3061110,
					"content": "Dur bir dakika... Az önce onu hissettin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061111
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061111,
					"content": "Buradaki rüzgar... Ters giden bir şeyler var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3061112
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061112,
					"content": "#Haydi içeri girip bir göz atalım, {NICKNAME}. Dikkatli ol, ejderin gücü bu alanın huzurunu kaçırıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3061106,
					"content": "Dur bir dakika, az önce \"kendi tapınağı\" mı dedin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3061107
					]
				}
			]
		},
