				]
			},
			"dialogs": [
				{
					"id": 401870101,
					"content": "#Selamlar {NICKNAME}ve Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870102
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870102,
					"content": "Selam Xiangling! Nasıl gidiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870103,
					"content": "İyi gitmiyor! Şu yemeği artık yesek diyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870104
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870104,
					"content": "Ha, evet. Onun zamanı geldi artık.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870105
					]
				},
				{
					"id": 401870105,
					"content": "E yani! Vaktiniz vardır umarım. Baştan söyleyeyim, bu sefer yırtmak için çok sağlam bir mazeret bulmanız lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870106
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870106,
					"content": "Vakti olmayan Hu Tao'ydu bir kere, biz değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870107,
					"content": "Hiç sorma... Müdür olduğu için bizi es geçebileceğini düşünüyor. Sanki yeterince insan yoksa vaktimi harcamaya değmezsiniz der gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870108
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870108,
					"content": "Ama o devir kapandı. Artık hiçbir bahanesini kabul etmeyeceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870109
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870109,
					"content": "\"Etmeyeceğiz\" derken tam olarak kimlerden bahsediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870110,
					"content": "Hehe, Xingqiu ve ben tabii ki! Uzun zamandır herkesi bir araya toplamak istiyordu ama büyük dedesinin durumundan ötürü vakit bulamamıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870111
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870111,
					"content": "Ancak Fener Şenliği gecesi büyük dedesi birdenbire iyileşti! Xingqiu çok sevindi ve sonunda evden çıkabildi. Biz de hemen buluştuk ve plan yaptık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870112
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870112,
					"content": "Vay canına! Büyük dedesi tamamen iyileşti mi yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870113,
					"content": "Evet. Doktor da gelip iyice muayene etmiş. Hiçbir sorunu kalmamış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870114
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870114,
					"content": "Xingqiu'nun dediğine göre dedesi iyileştiğinden beri iştahı Paimon'u aratmıyormuş... Şu anda ailesinin tek endişesi hazımsızlık yaşama ihtimali.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870115
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870115,
					"content": "Hımm... Bu iyi bir haber tabii ama Paimon'u pek iyi göstermedi nedense...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870116,
					"content": "Kesinlikle iyi gösterdi! Senin iştahın hayata pozitif bakmanın bir timsali adeta: \"Her zaman doya doya ye, yoksa yemek çubukları arkandan ağlar!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870117
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870117,
					"content": "İyi konuştun Xiangling! Paimon'u bugün olduğu kişi yapan tam olarak bu felsefe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870118,
					"content": "Öyle mi? Ben niye ilk defa duyuyorum o halde?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870119
					]
				},
				{
					"id": 401870119,
					"content": "Evet, öyle. Xiangling'in de dediği gibi her zaman doya doya ye, yoksa yemek çubukları... Gerisi nasıldı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870120,
					"content": "Haha, boş ver Paimon. Enerjini sofraya sakla en iyisi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870121
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870121,
					"content": "Hehe, anlaştık! Peki nerede yiyeceğiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870122,
					"content": "Bu akşam Yilong Rıhtımı'nda. Xingqiu ve diğerleri hâlâ oradalar. Ayrıca Hu Tao özel bir misafirimiz olduğunu söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870123
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870123,
					"content": "Kimmiş?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870124
					]
				},
				{
					"id": 401870124,
					"content": "Gidince görürsün!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870125
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870125,
					"content": "Haaa, Paimon'un aklına biri geldi... Ama şimdilik kendine saklayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870126,
					"content": "Benim de aklımda biri var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870127
					]
				},
				{
					"id": 401870127,
					"content": "Öyle mi? Kim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870128,
					"content": "Ben de kendime saklayacağım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870129
					]
				},
				{
					"id": 401870129,
					"content": "Hıh! Kim doğru tahmin etmiş bu akşam görürüz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
