			},
			"dialogs": [
				{
					"id": 401870701,
					"content": "Wangsheng Cenaze Evindeki şu genç kız çok etkileyici biri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870702
					],
					"speakerTitle": "Xianyun"
				},
				{
					"id": 401870702,
					"content": "Rex Lapis onu danışmanı olarak seçtiğinde merakımı cezbetmişti. Ama bu kararının ardındaki gerçek niyeti şahsım şimdi anlıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870703
					],
					"speakerTitle": "Xianyun"
				},
				{
					"id": 401870703,
					"content": "Katılıyorum. Ancak yine de Bulutlar Hakimi'nden böyle bir övgü almak sık rastlanan bir şey değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870704
					],
					"speakerTitle": "Ay Oymacısı"
				},
				{
					"id": 401870704,
					"content": "Nasıl yani? Biraz daha net açıklar mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870705
					],
					"speakerTitle": "Xianyun"
				},
				{
					"id": 401870705,
					"content": "Eskiden şöyle bir şey söylemiştin: \"Genç kız yetenekli biri olabilir ama onun yerinde Shenhe ya da Ganyu olsaydı da bir şey değişmezdi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870706
					],
					"speakerTitle": "Dağkesen"
				},
				{
					"id": 401870706,
					"content": "Hıh! Şahsım kendi çocuklarını överken asla başkalarını hor görmez. Wangsheng Cenaze Evinin genç kızı büyük bir kararlılık ve cesaret ortaya koydu. Biraz da olsa övülmeyi hak etmiyor mu yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870707
					],
					"speakerTitle": "Xianyun"
				},
				{
					"id": 401870707,
					"content": "Hehehe, kesinlikle hak ediyor. Ve bu ilk kez de olmuyor. Uzun süredir Liyue Limanı'nda yaşıyorum ve Wangsheng Cenaze Evinin nesiller boyunca müthiş müdürler yetiştirdiğini rahatlıkla söyleyebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870708
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 401870708,
					"content": "Sokak Gezgini haklı. Tanrı Tao Dou bizim dostumuz değildi ama düşmanımız da değildi. Tüm canlılara karşı büyük bir şefkat duymasaydı ve dünyayı huzura kavuşturmak için kendini arındırmaya razı olmasaydı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870709
					],
					"speakerTitle": "Ay Oymacısı"
				},
				{
					"id": 401870709,
					"content": "Sekiz Adepti bırak, Sekiz Adeptus gelse bile onu alt edemezlerdi. Sınıra dönüştüğü zaman, ölümlülerin onun yeni formunu bu kadar uzun süre koruyup devam ettireceğini muhtemelen hiç hayal etmemişti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870710
					],
					"speakerTitle": "Ay Oymacısı"
				},
				{
					"id": 401870710,
					"content": "Bu arada, cenaze evindeki genç kızın adını hâlâ bilmediğimi fark ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870711
					],
					"speakerTitle": "Dağkesen"
				},
				{
					"id": 401870711,
					"content": "Müdürün soyadı Hu, adı ise Tao.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870712
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 401870712,
					"content": "Hu... Aa! Yani \"kelebek\" için kullandığımız kelime gibi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870713
					],
					"speakerTitle": "Ay Oymacısı"
				},
				{
					"id": 401870713,
					"content": "Hayır, \"baş belası\" anlamındaki Hu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870714
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 401870714,
					"content": "O halde \"Tao\" da dilimizdeki baş belası anlamına gelen \"Tao\" olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870715
					],
					"speakerTitle": "Ay Oymacısı"
				},
				{
					"id": 401870715,
					"content": "Hayır. Aslına bakarsan \"Tao Dou\"nun Tao'su o.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870716
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 401870716,
					"content": "Hımm. Yani kelebek anlamındaki \"Hu\" ve \"Tao Dou\"nun Tao'su. Güzel isimmiş. Gayet uygun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870717
					],
					"speakerTitle": "Dağkesen"
				},
				{
					"id": 401870717,
					"content": "Hayır. \"Baş belası\", \"durmadan rahatsız eden\" ve \"doymak bilmeyen\" anlamındaki Hu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870718
					],
					"speakerTitle": "Xianyun"
				},
				{
					"id": 401870718,
					"content": "Ben sadece ortamı neşelendirmeye çalışıyorum. Hu Tao'nun baş belası olmasına izin var da bana niye yokmuş?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870719
					],
					"speakerTitle": "Dağkesen"
				},
				{
					"id": 401870719,
					"content": "İpucu ismin içinde saklı. Dağkesen'i Baş Belası olarak değiştirmek istiyorsun buyur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870720
					],
					"speakerTitle": "Xianyun"
				},
				{
					"id": 401870720,
					"content": "Hehe, biraz çay içer misiniz? Bu, Rex Lapis'in Qingce Köyü'nden getirdiği nadir çıkan \"Ruh Filizi\" bitkisinden. Bunu içmemek olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870721
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 401870721,
					"content": "Önümüzdeki sene paylaşacağımız daha çok güzel çayımız olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870722
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 401870722,
					"content": "Olur mutlaka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		}
	]
