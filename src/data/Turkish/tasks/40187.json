			"dialogs": [
				{
					"id": 401870401,
					"content": "#O gün {NICKNAME} ile birlikte sınıra gitmeliydin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870402
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 401870402,
					"content": "#{NICKNAME} iyi olsun istiyorsun biliyorum ama bir faydam olmazdı. Bir sorun çıktığında ayak bağı olurdum sadece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870403
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 401870403,
					"content": "Hem Ningguang planı değiştirip beni Kanyon'a gönderdi. Aynı anda iki yerde de olacak halim yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870404
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 401870404,
					"content": "Bu durumdan memnun değilsen Yujing Terası'na bir şikayet dilekçesi gönderebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870405
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 401870405,
					"content": "Tianquan'ı Tianquan'a mı şikayet edeceğim yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870406
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 401870406,
					"content": "Benim aklımda Yuheng vardı aslında. Yüzleşmekten de kaçınmaz hem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870407
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 401870407,
					"content": "... Neyse. Herkes iyi olduğuna göre bu konuyu unutabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870408
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 401870408,
					"content": "Evet. Wangshu Hanının konumu bayağı iyi bu arada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870409
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 401870409,
					"content": "Liyue'nin her yeri bayağı iyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870410
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 401870410,
					"content": "Haha, doğru dedin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870411
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 401870411,
					"content": "Patron, bir porsiyon Çiy Kaplı Karides daha lütfen. Banmak için sos da getirir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870412
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 401870412,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870413
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 401870413,
					"content": "Bir tane de Badem Tofusu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yelan"
				}
			]
		},
