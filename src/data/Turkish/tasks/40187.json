					}
				]
			},
			"dialogs": [
				{
					"id": 401870501,
					"content": "Tianquan, kriz çözüldü ama hâlâ yüzünden düşen bin parça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870502
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 401870502,
					"content": "#Müdür Hu ve {NICKNAME} sayesinde felaket önlendi. Ancak krize asıl neyin yol açtığını hâlâ bilmiyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870503
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401870503,
					"content": "Senin kulağın kesiktir Kaptan. Natlan ulusunun son zamanlarda Ley Hatları ve ölüm yaşam konularıyla alakalı büyük sorunlarla yüzleştiğini biliyorsundur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870504
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401870504,
					"content": "Daha derin bir düzlemde bu sorunların birbiriyle bağlantılı olup olmadığını merak ediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870505
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401870505,
					"content": "Eğer bağlantılıysa bu iş Liyue'yi de, Natlan'ı da aşıyor demektir. İş ortaklarıma haber salıp onlardan diğer uluslardaki benzer hadiselere kulak kabartmalarını isteyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870506
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 401870506,
					"content": "Ama şimdi... Bu endişeleri bir kenara bırakalım ve şenlik bitmeden bu müthiş manzaranın keyfini çıkaralım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870507
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 401870507,
					"content": "Hehe, tabii ki. Bana iş ve özel hayat dengesini öğretmeye kalkma ama, ben Keqing değilim sonuçta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870508
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401870508,
					"content": "Öyle mi? O zaman niye hâlâ o eski tokayı takıyorsun? Benim payımla kendine yeni bir toka almanı söylememiş miydim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870509
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 401870509,
					"content": "Son bir onay almadan Kaptan Beidou'nun Moralarını harcamaya cesaret edemedim. Belki de şakasına söyledin, nereden bilebilirim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870510
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401870510,
					"content": "Hahaha, illa gidip benim almam gerekiyor yani, öyle mi? Tamam, öyle olsun. Gidip panayırda bir tur atalım öyleyse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870511
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 401870511,
					"content": "Aferin sana... Açık sözlü Kaptanımız ne zamandan beri ima edileni anlayabiliyormuş bakayım, ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870512
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 401870512,
					"content": "Hahaha, bu kadar yeter. Geliyor musun, gelmiyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870513
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 401870513,
					"content": "Geliyorum tabii ki. Hadi gidelim.",
					"roleType": "TALK_ROLE_NPC",
