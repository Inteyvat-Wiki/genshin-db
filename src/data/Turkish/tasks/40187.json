				]
			},
			"dialogs": [
				{
					"id": 401870301,
					"content": "En güçlü olanı arıyorsak... Rüzgar Okuyucu derim. Sonuçta Qimen Falcılığının kurucu ustası.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870302
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 401870302,
					"content": "Evet, benim oyum da ondan yana. Hem atam olduğu için hem de gümüş kırlangıçtan dolayı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870303
					],
					"speakerTitle": "Lan Yan"
				},
				{
					"id": 401870303,
					"content": "O halde ben oyumu Lianshan'ın İki Bilgesinden yana kullanıyorum. İnzivada yaşayıp yeteneklerini sergilemeyenler aslında en güçlü olanlardır hep. En azından kitaplarda öyle oluyor. Ne diyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870304
					],
					"speakerTitle": "Gaming"
				},
				{
					"id": 401870304,
					"content": "Bu bir dövüş sanatı romanı olsaydı haklı olabilirdin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870305
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 401870305,
					"content": "Ancak \"Mehtaplı Bambu Ormanı\"nı okuduktan sonra bu unvanı Tao Dou'nun Üç Ölümsüzünden biri olan Beyaz Atın hak ettiğini düşünüyorum. Mutlaka bir sırrı olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870306
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 401870306,
					"content": "Ha? Hiç kimse Yunlai Balıkçısını seçmeyecek mi? Yuheng bile dövüş stilinin Yunlai Balıkçısının olta kullanma tekniklerine dayandığını söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870307
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870307,
					"content": "Söyledi söylemesine ama... Balıkçılık ne alaka? Bu hikayede pek yeri yok gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870308
					],
					"speakerTitle": "Gaming"
				},
				{
					"id": 401870308,
					"content": "Hımm... Sandığının aksine balıkçılar göründüklerinden daha fazlası olabilirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870309
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 401870309,
					"content": "Hepiniz yanılıyorsunuz! En iyileri tabii ki İhtiyar Wuwang ve Yalnız Kelebekti. Onlar olmasaydı bugün Wangsheng Cenaze Evi de var olmazdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870310
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870310,
					"content": "Buna diyecek bir şey yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870311
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 401870311,
					"content": "Aa, herkes gelmiş bile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870312,
					"content": "#{NICKNAME}, Paimon, sonunda aramızdasınız! Hoş geldiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870313
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870313,
					"content": "Hu Tao, şapkan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870314,
					"content": "Gözünden kaçmadı Paimon. Evet, bir erik dalı daha ekledim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870315
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870315,
					"content": "#Aa, {NICKNAME} ile uyumlu olmuşsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870316,
					"content": "Neyse, nasılsınız bakalım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870317,
					"content": "Sekiz Adept içinde en iyisinin hangisi olduğunu tartışıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870318
					],
					"speakerTitle": "Lan Yan"
				},
				{
					"id": 401870318,
					"content": "Hahaha, bitmeyecek bir tartışma desek daha doğru. Havanda su dövüyoruz sadece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870319
					],
					"speakerTitle": "Gaming"
				},
				{
					"id": 401870319,
					"content": "Aynen. Böyle bir tartışma ancak resimli romanlarda geçen o bir bakışta kişinin gücünü gösterebilen özel gözlüklerden varsa bir sonuca bağlanabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870320
					],
					"speakerTitle": "Chongyun"
				},
				{
					"id": 401870320,
					"content": "Haha, seni resimli romanlara Xingqiu mu bulaştırdı yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870321
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870321,
					"content": "#Hoş geldin {NICKNAME}. Ailemin dediğine göre Hu Tao ile birlikte çok riskli bir tören gerçekleştirmiş ve büyük dedemin hastalığını iyileştirmişsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870322
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 401870322,
					"content": "Sana ne kadar teşekkür etsem az. İleride başına ne gelirse gelsin Feiyun Ticaret Loncasının kapısı sana daima açık olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870323
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 401870323,
					"content": "Bu bir ekip çalışmasıydı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870324
					]
				},
				{
					"id": 401870324,
					"content": "Evet, biliyorum. Babam ve abim ilerleyen günlerde herkese bizzat teşekkür edecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870325
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 401870325,
					"content": "Neden bu kadar zahmete giriyorsun Xingqiu? Yalnız Kelebek ve İhtiyar Wuwang'ın Sekiz Adeptin en güçlüleri olduğunu kabul et ve ödeşmiş olalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870326
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870326,
					"content": "Hadi artık, bu tartışmaya bir son verelim. Herkes buradaysa yemeğe geçebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870327
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870327,
					"content": "Hadi Paimon, şu müthiş yaşam felsefeni herkesle paylaşma zamanı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870328
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870328,
					"content": "Ha... T-Tamam, şey... Bir saniye... Her zaman doya doya ye, yoksa... Pardon, gerisi neydi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870329,
					"content": "Yoksa yemek çubukları arkandan ağlar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870330
					]
				},
				{
					"id": 401870330,
					"content": "Hah, aynen! Tam olarak ondan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870331,
					"content": "Böyle olmaz Paimon, yaşam felsefeni simgeleyen bir sloganın sonunu getirememek kötü şans demektir. Hayatın boyunca sonu gelmeyen engellerle karşılaşırsın sonra. Hadi baştan, bu kez yapabilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870332
					],
					"speakerTitle": "Gaming"
				},
				{
					"id": 401870332,
					"content": "Her zaman doya doya ye! Yoksa yemek çubukları arkandan ağlar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870333,
					"content": "İşte budur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870334
					]
				},
				{
					"id": 401870334,
					"content": "Artık yumulabilir miyiz peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870335,
					"content": "Paimon, özel misafirimizi unuttun mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870336
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 401870336,
					"content": "Ha, evet. Paimon hatırlıyor. Aslında Paimon kim olduğunu tahmin etti ama yüksek sesle söylemeye gerek yok şimdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870337
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870337,
					"content": "Hımm? Tahminine güvenmiyorsun galiba... Hiçbir fikrin yok, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870338
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870338,
					"content": "#Hayır, biliyorum! Kim olduğu belli. Şey işte... {NICKNAME}, yardım etsene birazcık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870339,
					"content": "Yun Jin mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401870340
					]
				},
				{
					"id": 401870340,
					"content": "Doğru cevap! Tabii ki Yun Jin. Geçen sefer verdiği sözü unutmamışsın sen de.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870341
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870341,
					"content": "Bakın, sahneye çıkıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870342
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870342,
					"content": "Vay canına! Yun-Han Opera Topluluğunun direktörü değil mi o?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870343
					],
					"speakerTitle": "Lixing"
				},
				{
					"id": 401870343,
					"content": "Harika! Onu Yilong Rıhtımı'nda görmeyi asla ummazdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870344
					],
					"speakerTitle": "Jiewu"
				},
				{
					"id": 401870344,
					"content": "Herkese merhaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870345
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870345,
					"content": "Fener Şenliği sırasında aramızda olamayan dostlarım için \"Tao Dou'nun Arındırılması\"nı bir kez daha icra edeceğim. Daha büyük bir sahne ayarlayamadığım için affınıza sığınıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870346
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870346,
					"content": "Ne kadar da düşünceli! Geçen sefer katılamayanlar için bir performans daha sergileyecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870347
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401870347,
					"content": "Şşş! Başlıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870356
					],
					"speakerTitle": "Hu Tao"
				},
				{
					"id": 401870356,
					"content": "Tao Dou hakkındaki cesur iddiaları hatırla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870348
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870348,
					"content": "Ahenksiz sesler, trajik kaderler ve iki dünyanın ruhları, duyun sesimi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870349
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870349,
					"content": "Nasıl bir sanrıdır ki bu, kan ve kemikle ateşe veriyorsunuz ülkeyi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870350
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870350,
					"content": "Zamanla kaybolur savaşın gölgeleri ve sonsuzluğa uzanır kurtuluş hikayeleri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870351
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870351,
					"content": "Karşı gelinmez yaşam ve ölümün kurallarına, dökülen kanların bedeli ödenir mutlaka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870352
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870352,
					"content": "Gökyüzü her daim gösterir hakikati, bencilce arzular ancak kıyamete sürükler sizi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870353
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870353,
					"content": "Kötülüğün hakkından gelmek için yeminler edildi, Sekiz Adept kılıçlarını Tao Dou'ya çevirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870354
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870354,
					"content": "Beden tükenir ve ruh göçüp gider, lakin asla bitmez yollar ve hayaller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870355
					],
					"speakerTitle": "Yun Jin"
				},
				{
					"id": 401870355,
					"content": "Nasıl ki o günü unutmaz gözyaşları ve dallar, yeni yuvaları için döner elbet bir gün kırlangıçlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yun Jin"
				}
			]
		},
