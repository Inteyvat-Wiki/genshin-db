			},
			"dialogs": [
				{
					"id": 401870601,
					"content": "Hâlâ çalışıyor musun Ganyu? Bu kadar yoğun olmana üzüldüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870602
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 401870602,
					"content": "#Ha? Keqing... Yok ya, sorun değil, her zamanki işler işte. Bu senenin gerçek yıldızları {NICKNAME} ve Müdür Hu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870603
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 401870603,
					"content": "Kendi katkılarını küçük görmene gerek yok. Tabii ki onlar en büyük kahramanlar ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870604
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 401870604,
					"content": "Hepimiz üzerimize düşeni layığıyla yaptık. Sivil İşler Bakanlığı olarak rekor bir hızla yanıt verdik, öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870605
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 401870605,
					"content": "Dışarıdan bakıldığında bu olay Hükümdarlar Savaşının felaketlerine kıyasla önemsiz görünebilir ancak gerçekten bıçak sırtındaydık. Bir çözüm bulamamış olsaydık durum hayal edilemeyecek kadar kötü sonuçlanabilirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870606
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 401870606,
					"content": "Haklısın... Bu arada, kullandığımız Yedi ve Sekiz Kapı Yöntemi hakkında bir sorum var. Daha önce Yuehai Konağı'nda neden bununla alakalı bir kayıt görmedim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870607
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 401870607,
					"content": "Ha, dizilimin nereden geldiğini mi öğrenmek istiyorsun? Onu Ningguang uydurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870608
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 401870608,
					"content": "... Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870609
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 401870609,
					"content": "Haha. Şaka yapıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870610
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 401870610,
					"content": "İşin aslı, en çok ihtiyaç duyduğumuz o günde Yujing Terası'na birdenbire tüm kritik bilgileri içeren bir mektup geldi. Yelan bile mektubun nereden geldiğini tespit edemedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870611
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 401870611,
					"content": "Nasıl yani... Bilgiler yoktan mı var oldu? Bu durumda... Ningguang'ın yaptığı riskli bir hamle sayılmaz mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870612
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 401870612,
					"content": "Öyle görünebilir ama dikkatli düşündüğünde her şey giderek anlamlı hale gelmeye başlıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870613
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 401870613,
					"content": "Liyue'de kaç kişi hem krizden hem de gizli sanattan haberdar olup, üstüne bir de iz bırakmadan mektup gönderebilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870614
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 401870614,
					"content": "Ha... Yani... Usta ve arkadaşları mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401870615
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 401870615,
					"content": "Anladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ganyu"
				}
			]
		},
