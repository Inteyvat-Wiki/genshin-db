							"1200308",
							"2"
						],
						"stepId": 1200308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xingqiu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120030801,
					"content": "Etkileyici. Sıradan insanlar değilsiniz... Bu savaşa devam etmek, kabul edebileceğimden daha fazla kayıpla sonuçlanır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030802
					],
					"speakerTitle": "Tetikçi"
				},
				{
					"id": 120030802,
					"content": "Güçleri neredeyse tükendi! İşlerini bitirin! Cor Lapisi ele geçirmek üzereyiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030803
					],
					"speakerTitle": "Soylu Maocai"
				},
				{
					"id": 120030803,
					"content": "Fatui'nin seninle olan ilişkisinin yalnızca iş konularıyla ilgili olduğunu hatırlatmak isterim! Adamlarımı sana emrindeyken sorunlara karıştır diye vermedim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030804
					],
					"speakerTitle": "Tetikçi"
				},
				{
					"id": 120030804,
					"content": "N-Ne diyorsun? Usta, her şeyi yaptım, aklımdaki tek şey olan emri yerine getirmek için yaptım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030805
					],
					"speakerTitle": "Soylu Maocai"
				},
				{
					"id": 120030805,
					"content": "O zaman bunu kendi başına hallet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030806
					],
					"speakerTitle": "Tetikçi"
				},
				{
					"id": 120030806,
					"content": "Gi-Gitme! Usta! Bekleee...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030807
					],
					"speakerTitle": "Soylu Maocai"
				},
				{
					"id": 120030807,
					"content": "Lordum! Burada ne yapıyorsunuz? Yaralandınız mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030808
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 120030808,
					"content": "#Bu cesur genç {F#kadın}{M#adam} sayesinde burnum bile kanamadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030809
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030809,
					"content": "\"Lordum\" mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030810,
						120030811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030810,
					"content": "\"Lordum\" mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030812
					]
				},
				{
					"id": 120030812,
					"content": "Sen... Feiyun Ticaret Loncasının varisi misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030813
					],
					"speakerTitle": "Soylu Maocai"
				},
				{
					"id": 120030813,
					"content": "Evet efendim. Ben Guhua Klanı üyesi ve Feiyun Ticaret Loncası yöneticisinin ikinci oğlu Xingqiu'yum ve bunu saklamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030814
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030814,
					"content": "Kahretsin! Beni parmağında oynattın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030815
					],
					"speakerTitle": "Soylu Maocai"
				},
				{
					"id": 120030815,
					"content": "Soylu Maocai, baskı ve tehdit; saygın bir iş adamının özellikleri değildir. İş uygulamalarınızın yarattığı sorunları, kendi işim aracılığıyla çözmeye çalıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030816
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030816,
					"content": "Cor Lapislerini tedarik edemezsen Fatui'nin sana yapacaklarını düşünmek bile istemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030817
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030817,
					"content": "İşlere burnunu sokan domuz! Pekala, devam et! Söylesene, onu bana ne karşılığında satacaksın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030818
					],
					"speakerTitle": "Soylu Maocai"
				},
				{
					"id": 120030818,
					"content": "Dokuzuncu Chang'dan yüzde yetmişlik bir indirim istediğin için ateşe ateşle karşılık verelim, olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030819
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030819,
					"content": "Piyasa fiyatının üç katı adaletli olabilir, sence de öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030820
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030820,
					"content": "Bana böyle bir kötülüğü nasıl yaparsın? Bu, beni bitirmek için kasıtlı ve planlı bir eylem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030821
					],
					"speakerTitle": "Soylu Maocai"
				},
				{
					"id": 120030821,
					"content": "... Şimdi derin nefes al. Bu basit bir karar. Satın alacak mısın yoksa almayacak mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030822
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030822,
					"content": "Ben... Ah, tamam, istediğin gibi olsun! Parayı bir şekilde bulacağım. Artık mutlu musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030823
					],
					"speakerTitle": "Soylu Maocai"
				},
				{
					"id": 120030823,
					"content": "Feiyun Ticaret Loncası adına satın alımın için teşekkür ederim ve umarım gelecekte de bizimle çalışmaya devam edersin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030824
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030824,
					"content": "Sen mi? Komik konuşan, kitap okuyan, Guhua ineği Xingqiu... Feiyun Ticaret Loncasının varisi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030825,
					"content": "Yani bir günde devasa miktarda harcamamıza izin verdiğin Mora zulası, o senin özel kasandan mıydı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030826
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030826,
					"content": "Öyleydi ama önemsiz bir miktardı. Soylu Maocai'a haddini bildirirken çok iyi bir yatırım yaptım. Klasik bir taşla iki kuş vurma durumuydu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030827,
						120030829
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030827,
					"content": "Görünüş gerçekten aldatıcı olabiliyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030828
					]
				},
				{
					"id": 120030828,
					"content": "Çok naziksin. Yüreğinde cesaret var ve bu da hayranlık duymaya değer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030831
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030831,
					"content": "Ayy! Paimon, bunca zamandır sana Guhua İneği diyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030832
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030832,
					"content": "Paimon, şu dövüş ustası romanlarından birinde senin gibi zengin varislerin birine sinirlendiğinde onun kollarını ve bacaklarını kestiğini okumuştu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030833
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030833,
					"content": "Ayyy, Paimon'un başı büyük belada! Üzgünüm! Çok üzgünüm! Lütfen Paimon'u incitme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030834
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030834,
					"content": "Sakin ol. Uçabildiğin için zaten bacaklara ihtiyacın yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030835
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030835,
					"content": "#AHH! Kurtar beni {NICKNAME}, kurtar beni! Bu bir oyun değil. Tekrar söylüyorum, bu bir oyun değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030836,
						120030837
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030836,
					"content": "Besbelli şaka yapıyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030838
					]
				},
				{
					"id": 120030838,
					"content": "Şaka bir yana, bu başarılı sonuçtan dolayı ikinize teşekkür ediyorum. Gerçekten çok yardımcı oldunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030839
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030839,
					"content": "Bu arada Parçalanmış Baltalı Mızrak Efsanesi, gerçekten sürükleyiciydi. Bunu benim için Dokuzuncu Chang'a geri verirseniz çok sevinirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030840
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030840,
					"content": "Bize başka bir getir götür işi daha mı yaptırıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030841
					]
				},
				{
					"id": 120030841,
					"content": "Hiçbir şey yapmadım ve bu yüzden onun minnetini hak etmiyorum. Ama ikiniz, durumlara yabancıyken bile gelip günü kurtardınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030842
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030842,
					"content": "Böylesine cesur ve mert arkadaşlar kazanmak, benim için yeter de artar bile sadık dostlarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030843
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030843,
					"content": "Lordum, böldüğüm için üzgünüm... Babanız hakkında bir durum var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030844
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 120030844,
					"content": "Lütfen babama şunu iletin: Bir felaketi önledim ve bu süreçte büyük bir miktar para kazandım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030845
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030845,
					"content": "Bu değerli hareket, önceki hatalarımı telafi edip bir ihtimal bana birkaç gün daha özgürlük kazandırabilir mi acaba? Parçalanmış Baltalı Mızrak Efsanesi, araştırmayı çok istediğim bir zindandan bahsediyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030846
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030846,
					"content": "Tüm o akıllı uzun sözlerinin altında sen aslında sadece çalışmak istemeyen bir tembelsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030847
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030847,
					"content": "Hahaha... Peki ya Dokuzuncu Chang'ın sarayında sizi sadece onun minneti değil ayrıca bir ödülün beklediğini söylesem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030848
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030848,
					"content": "Bir ödül! Hımm.. Bu, teklifi bir miktar daha çekici hale getirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030849
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030849,
					"content": "*iç çeker* Görünüşe göre ne söylersem söyleyeyim sizi kalmaya ikna etmenin yolu yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030850
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 120030850,
					"content": "Neden bize Xingqui'nun Feiyun varisi olduğunu söylemedin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030851
					]
				},
				{
					"id": 120030851,
					"content": "Ah, bilmediğinizi fark etmemiştim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030852
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 120030852,
					"content": "Kitabı benim yerime geri verdiğiniz için şimdiden teşekkürler. Belki yeniden karşılaşırız tüccar dostlarım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030837,
					"content": "Bunu ne tür bir kitapta okuduğunu söylemiştin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030838
					]
				},
				{
					"id": 120030829,
					"content": "Siz zengin çocukları, genç yaştan itibaren güzel yazı dersleri almıyor musunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030830
					]
				},
				{
					"id": 120030830,
					"content": "Hahahaha, çok komik... Ailem her zaman bana el yazımın şüphesiz mükemmel özelliklerimden biri olduğunu söyler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030831
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030811,
					"content": "... Böyle bir şey olacağını DÜŞÜNMEMİŞTİM!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030812
					]
				}
			]
		},
		{
			"id": 1200309,
			"completionStepIds": [
				1200309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
