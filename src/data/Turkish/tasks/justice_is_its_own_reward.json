			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dokuzuncu Chang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120030901,
					"content": "Sonunda geri döndünüz! Bu sabah, tefeci geldi ve tüm koleksiyonumu geri verdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030902
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 120030902,
					"content": "Yine bunun arkasında sizin olduğunuzdan eminim. Teşekkür ederim, tüm kalbimle teşekkür ederim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030903,
						120030904
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 120030903,
					"content": "Önemli değil, memnuniyetle yardım ettik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030905
					]
				},
				{
					"id": 120030905,
					"content": "Lütfen böyle söylemeyin. Bunun benim için ne kadar değerli olduğunu bilemezsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030906
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 120030906,
					"content": "Chang ailesi, bir zamanlar Liyue'deki prestijli bir aileydi. Ne yazık ki aile sorunlarını varis olarak devraldığımda bir dizi iş aksaklığı, servetimizi bir çırpıda yok etti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030907
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 120030907,
					"content": "O zamandan beri evin eski görkemini geri getirme umuduyla yıllardır biriktiriyorum... Sonunda her şey, bu Cor Lapis anlaşmasına bağlıydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030908
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 120030908,
					"content": "Siz olmasaydınız dağlardaki bu çorak arazi, ebedi istirahatgahım olurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030909
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 120030909,
					"content": "Vay canına, bu kasabada tanıştığımız ikinci varis!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030910,
					"content": "Pardon, ne dedin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030911
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 120030911,
					"content": "... Hı, hiçbir şey! Ah, işte kitabını geri getirdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030912,
					"content": "Harika, Parçalanmış Baltalı Mızrak Efsanesi! Guhua serserisinin beni kandırdığını düşünmeye başlamıştım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030913
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 120030913,
					"content": "İnsanlar gerçekten Guhua Klanını bu kadar çok küçümsüyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030914
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030914,
					"content": "Aslında sanat yüzlerce yıllıktır ve bir zamanlar el üstünde tutulurdu. Ama artık gözden düşerek tanınmaz hale geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030915
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 120030915,
					"content": "Canlanmasını sağlamak için biraz taze kan vermeniz gerekir ama tomurcuklanan genç yetenekleri ölmekte olan bir sanata çekmek zordur. Böylece bir kısır döngü oluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030916
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 120030916,
					"content": "Her durumda günümüzdeki Guhua çocukları... Mesela o genç serseri Xingqiu'yi düşünün, iyiliğe iyilikle karşılık vermek ve benzeri şeyler hakkındaki tüm konuşmasından sonra bunu göstermek için ne yaptı? Gerçek sorumluluk duygusunu gösteren sizlersiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030917,
						120030918
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 120030917,
					"content": "O, düşündüğünden daha iyi biri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030919
					]
				},
				{
					"id": 120030919,
					"content": "Ah, ne fark eder ki? Neyse, Teyvat Seyahat Rehberinin Liyue cildini istiyordunuz, değil mi? Onu sizin için gidip getireceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030920
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 120030920,
					"content": "Bu, sizindir. Ayrıca büyük cömertliğinizin karşılığında küçük bir minnettarlık göstergesi ama işte sizin için bir şey.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030921,
						120030922
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 120030921,
					"content": "Sonunda. Her şeye rağmen yolculuğumuz buna değdi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030923
					]
				},
				{
					"id": 120030923,
					"content": "Cevherim satıldı ve değerli kitaplarım geri geldi, inanamıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030924
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 120030924,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030925
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 120030925,
					"content": "O da neydi? Paimon, bir şeyin düştüğünü gördü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030926
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030926,
					"content": "Hıh. Hiçbir şey, hiçbir şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030927
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 120030927,
					"content": "(O küçük serseri... Yoksa sakın...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 120030922,
					"content": "Neredeyse unutuyordum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030923
					]
				},
				{
					"id": 120030918,
					"content": "Belki bir Guhua rönesansı gerçekleşmek üzeredir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030919
					]
				},
				{
					"id": 120030904,
					"content": "Aslında biz yapmadık.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030905
					]
				}
			]
		}
