			"dialogs": [
				{
					"id": 120004501,
					"content": "Sana yeterince teşekkür edemiyorum, bununla birlikte sonunda işim için tekrardan umut var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120004502
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 120004502,
					"content": "Daha önce sana karşı çok nazik davranmadım, gerçekten üzgünüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dokuzuncu Chang"
				}
			]
		},
		{
			"id": 1200304,
			"completionStepIds": [
				1200304
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200304",
							"2"
						],
						"stepId": 1200304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xingqiu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120030401,
					"content": "Hoş geldiniz. Bu oyunun son perdesi, siz ikiniz burada seyirci olmadan tamamlanmış sayılmazdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030402
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030402,
					"content": "Buna emin olabilirsin! Tüm işi yapan bizdik! Peki sen bunca zaman boyunca tam olarak ne yapıyordun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030403,
					"content": "Ah, tamam... Doğal olarak zamanımı kendimi tamamen Parçalanmış Baltalı Mızrak Efsanesine kaptırmak için harcadım. Kitabı bitirmeyi başardım ve her bir dakikasından keyif aldım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030404
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030404,
					"content": "Kutsal Baltalı Mızrak ve Uğursuz Kılıç, Mir ve Weiyang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030405
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030405,
					"content": "Hikayenin ilk beş cilt boyunca gelişme şekli... Tam anlamıyla örnek gösterilecek nitelikte. Ama altıncı cilt... Söyleyecek pek bir şeyim yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030426
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030426,
					"content": "Böyle eserlerle dünyamızı onurlandıran böylesine bir yazarımız olduğu için ne kadar şanslıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030427
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030427,
					"content": "Bu da Soylu Maocai ile ilişkili... Peki nasıl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030406,
					"content": "İlişkili değil ama bir şey beklentileri bu kadar aştığında, kişi takdirini göstermelidir..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030407,
						120030409
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030407,
					"content": "Her şeyin nasıl bittiğini gördün.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030408
					]
				},
				{
					"id": 120030408,
					"content": "Yardımınız sayesinde her şey tıpkı öngördüğüm gibi gerçekleşecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030411
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030411,
					"content": "... Neden Paimon, neler olduğunu anlamayan tek kişi olmak zorunda? Hiç adil değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030412,
					"content": "Ahh... O zaman devam et, anlat bana. Burada ne yapıyoruz? Beklenen bu heyecanlı büyük karşılaşma nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120030413,
					"content": "Bir düşünsene. Soylu Maocai, tüm Liyue Limanı'nda Cor Lapisi aramaya gidiyor ama tek bir tane bulamıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030414
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030414,
					"content": "Panikliyor, mallar olmadan sözleşme şartlarını yerine getiremez ve sözleşme şartlarını yerine yetiremezse Fatui ile olan iyi ilişkileri bozulur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030415
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030415,
					"content": "Sonra Feiyun Ticaret Loncasının mesul olduğu söylentisini duyuyor. Paniklemenin yerini kuşku alıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030416
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030416,
					"content": "Soylu Maocai, iş dünyasında çok güçlü bir figür. Kimse onu böyle hedef seçmeye cesaret etmemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030417
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030417,
					"content": "Aradığı ister intikam olsun ister hızlı bir çözüm, şundan emin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030418
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030418,
					"content": "Sizdiniz demek! Dokuzuncu Chang için kendilerini tehlikeye atanlar sizdiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030419
					],
					"speakerTitle": "Soylu Maocai"
				},
				{
					"id": 120030419,
					"content": "İti an çomağı hazırla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030420
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030420,
					"content": "Feiyun Ticaret Loncasının çılgınca hepsini satın aldığını fark etmeden önce Cor Lapis satan birini bulmak için her yere gittim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030421
					],
					"speakerTitle": "Soylu Maocai"
				},
				{
					"id": 120030421,
					"content": "Cor Lapis, nadir bir maden değildir ama yine de birden tüm stokları tükenmiş, işte böyle! Açıklama yapın! Bu eziyetin anlamı nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030422
					],
					"speakerTitle": "Soylu Maocai"
				},
				{
					"id": 120030422,
					"content": "Sana eziyet etmiyoruz ama bir başkasını, borçlu olduğum kişiyi koruyoruz. Bir adaletsizliğe şahit olduktan sonra haksızlığa uğramış kişinin yardımına koşmak oldukça normal bir tepkidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030423
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030423,
					"content": "Bu işin bitmediğini söyleyen, senin adamlarından biri değil miydi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030424
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120030424,
					"content": "Belli ki senin için iyi olan şeyi bilmiyorsun. Sözü uzatmayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030425
					],
					"speakerTitle": "Soylu Maocai"
				},
				{
					"id": 120030425,
					"content": "Ustam, müsaadenizle. Cor Lapislerine el koyun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soylu Maocai"
				},
				{
					"id": 120030409,
					"content": "Kitabın sonu iyi miydi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120030410
					]
				},
				{
					"id": 120030410,
					"content": "Bu oldukça iyiydi, teşekkürler... Umarım planımız sonuca ulaştığında beklentilerini karşılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120030411
					],
					"speakerTitle": "Xingqiu"
				}
			]
		},
		{
