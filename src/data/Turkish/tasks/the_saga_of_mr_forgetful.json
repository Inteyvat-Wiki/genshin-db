			"dialogs": [
				{
					"id": 721750401,
					"content": "Selam! Duvar resimlerini bulabildiniz mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750402,
						721750405
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750402,
					"content": "Hayır, henüz değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750403
					]
				},
				{
					"id": 721750403,
					"content": "Aceleye gerek yok, ben burada bekliyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750404
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750404,
					"content": "Bu arada bana verdiğiniz Fosforlu Mantarlar için teşekkür ederim. Hepsi çok taze!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750407
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750407,
					"content": "Senin için söylemesi kolay tabii. O mantarları sana biz verdik zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750408,
					"content": "Aşk olsun, böyle küçük şeyleri kafana takma. Sonuçta mantarları yemiyor muyum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750409
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750409,
					"content": "Seni... unutkan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750405,
					"content": "Hâlâ üzerinde çalışıyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750406
					]
				},
				{
					"id": 721750406,
					"content": "Yorgunsanız burada dinlenin isterseniz, hem belki birkaç Fosforlu Mantar yemek istersiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750407
					],
					"speakerTitle": "Roald"
				}
			]
		},
		{
			"id": 7217506,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
