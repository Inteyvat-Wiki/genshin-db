			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Roald",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721751801,
					"content": "#Tekrar selam sana {NICKNAME} ve yanındaki... Şeye...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751802
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751802,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751803,
					"content": "Bu uçan arkadaşını kaça satarsın? Bence kendisi çok ilginç birisi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751804
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751804,
					"content": "Ne!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751805,
						721751807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751805,
					"content": "İyi misin sen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751806
					]
				},
				{
					"id": 721751806,
					"content": "İyi olmadığı belli! Baksana yine hafızasını kaybetmiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751809,
					"content": "Siz ne diyorsunuz be... *hıçkırır*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751810
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751810,
					"content": "*hıçkırır*... Hahahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751811
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751811,
					"content": "??",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751812,
					"content": "???",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751813
					]
				},
				{
					"id": 721751813,
					"content": "Hahahaha! *öksürür* Ahahaha! Keşke yüzünüzdeki ifadeyi görebilseydiniz! Hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751814
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751814,
					"content": "Tamam... Gülmekten bittim resmen... Kusura bakmayın... Hahaha, bu \"şakayı\" yapmaya bayılıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751815
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751815,
					"content": "Hiç komik değildi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751816,
						721751817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751816,
					"content": "Bunda bu kadar gülünecek ne olduğunu anlayamadım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751818
					]
				},
				{
					"id": 721751818,
					"content": "*öksürür* Tamam, bu kadar şaka yeter. Kusura bakmayın tekrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751819
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751819,
					"content": "Paimon senin gibi meşhur bir maceracının çok daha ciddi birisi olmasını beklerdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751820
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751820,
					"content": "Hahaha. Maceracılar hakkında kafanda belli bir kalıp oluşturmasan iyi edersin. Lonca zaten gariplikler yuvası olarak biliniyor, ben bile onların arasında kendimi \"normal\" görüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751821
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751821,
					"content": "Paimon onlardan çok da farklı olmadığını düşünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751822
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751822,
					"content": "Mantarlar için tekrar teşekkür ederim. Şimdiye kadar elle tutulur bir faydası olmadı. Belki etki etmeleri için devamlı kullanmak gerekiyordur, belki de tedavi edici bir özellikleri yoktur... Yine de tatları oldukça lezzetli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751823
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751823,
					"content": "Hepsini yemeyeyim. Tedavi edici özelliği olup olmadığını araştırması için Sumeru'daki bir arkadaşım için de birkaç mantar ayırmam gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751824
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751824,
					"content": "Bunu yapmayı unutacakmışsın gibi hissediyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751825,
					"content": "*öksürür* Öhöm, neyse, konumuza dönelim. Duvar resimlerine bakmaya gittiniz mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751826
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751826,
					"content": "İstediğin fotoğrafları getirdik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751827
					]
				},
				{
					"id": 721751827,
					"content": "Bu cömert yardımınız için çok teşekkür ederim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751828
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751828,
					"content": "Bakalım. İlginç, çok ilginç... Hımm... Başka duvar resmi buldunuz mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751829,
						721751830
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751829,
					"content": "Hepsi bu kadar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721751831
					]
				},
				{
					"id": 721751831,
					"content": "Bak bu çok daha ilginçmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751832
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751832,
					"content": "Nasıl yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751833
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751833,
					"content": "Tsurumi Adası halkı eskiden Elektrik gücüne sahip korkunç bir kuşa taparmış. Bundan dolayı da uygarlıkları ayinler ve törenler üzerine kuruluymuş. Biraz dahi tarih bilen herkes bu konuda hemfikir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751834
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751834,
					"content": "Bana gösterdiğiniz duvar resimlerinin hiçbirinde Yıldırım Kuşu'na dair bir iz yok. Sanki o insanlar başka bir şeye tapıyorlarmış gibi duruyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751835
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751835,
					"content": "Güneşe, aya, yıldızlara... Bir de şu simgeler her neyi temsil ediyorsa ona. Tsurumi Adası halkı Yıldırım Kuşu'nun gelişinden önce belli bir medeniyet seviyesine ulaşmış olabilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751836
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751836,
					"content": "Bir de sis ve ay ışığı, yıldızlar ve karanlık... Bunları nasıl açıklayacağımı bilmiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751837
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751837,
					"content": "Kafanı bu kadar yormasan iyi edersin Roald. Hafızanı kötü etkileyebilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751838
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751838,
					"content": "Haklısın, pardon. Düşüncelere daldım bir an. Burada olduğunuzu bile unutmuşum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751839
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751839,
					"content": "Çabanız için teşekkür ederim. Yazacağım bir sonraki günlük için bu kadarı yeterli olur herhalde... Bir gün tarihçiler günlüğüm üzerine makale yazarsa teşekkür bölümüne sizin de adınızı yazdıracağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751840
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751840,
					"content": "Tamam o zaman. Ben gidip Loncaya rapor vereyim. Size de zahmet verdim, kusura bakmayın. Tekrar görüşürüz umarım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751841
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751841,
					"content": "Ne kadar meşgul biri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751842
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721751842,
					"content": "Sizden bir şey daha isteyecektim. Büyük bir şey değil. Benim için birini bulabilir misiniz? Hani bir çocuktan bahsetmiştim. Adı şeydi... Bir saniye...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751843
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721751843,
					"content": "Hah, \"Ruu\" adı, hatırladım. Gelirken onun için yanımda birkaç yiyecek getirmiştim... Umarım bayatlamamışlardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721751844
