			},
			"dialogs": [
				{
					"id": 721750601,
					"content": "#Selam {NICKNAME}, sana da selam onun geveze peri arkadaşı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750602
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750602,
					"content": "Sana da merhaba Unutkan Bey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750603,
					"content": "Paimon'un adı Paimon! Bunu sakın unutayım deme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750604,
					"content": "Unutmam Minik Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750605
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750605,
					"content": "Bir dakika, Paimon ile dalga mı geçiyorsun sen? Hiç utanman yok mu senin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750606,
					"content": "#{NICKNAME}, adama şu garip mantarları bir an önce verir misin? Paimon onunla konuşmak istemiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750607,
					"content": "Bu kadarı yeter mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7217518,
			"completionStepIds": [
				7217509
