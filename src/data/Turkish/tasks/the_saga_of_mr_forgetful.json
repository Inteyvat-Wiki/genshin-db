			},
			"dialogs": [
				{
					"id": 721750101,
					"content": "Demek siz de adayı hâlâ terk etmediniz. Ne güzel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750102
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750102,
					"content": "Görüşmeyeli nasılsınız? Şaşırtıcı bir şeyler keşfettiniz mi? Keşfettiyseniz duymak isterim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750103,
						721750105
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750103,
					"content": "Pek şaşırtıcı bir şey bulamadık.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750104
					]
				},
				{
					"id": 721750104,
					"content": "Normaldir, kendinizi çok yormayın. Bu tür adalar gizemli şeylerle doludur. Eninde sonunda bir şey bulacağınızdan eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750107
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750107,
					"content": "Aslında Paimon bir soru sormak istiyordu. Sen burada ne yapıyorsun Roald?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750108,
					"content": "Ben mi? Eşyalarımı toplayıp gitmeye hazırlanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750109
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750109,
					"content": "Buradaki sis çok tuhaf. İçine bir adım attığın anda kayboluyorsun... Kaybolduğunun farkına varmadan kendini başladığın yerde buluyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750110
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750110,
					"content": "Kama'nın bana gösterdiği yolu unuttum. Ben de yol sormak için adanın yerlilerini bulmaya çalıştım ancak ne yaparsam yapayım bir yol bulamadım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750111
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750111,
					"content": "Pusuladan tutun gölgelere kadar her şeyi denedim ancak hiçbiri bana yolu gösteremedi... Ayakkabılarımı kullanmayı bile denedim ama olmadı! Sisin ardına tek bir adım dahi atamadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750112
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750112,
					"content": "Ayakkabılarını mı kullandın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750113,
					"content": "Geçtiği yerleri işaretlemek için kullanmış yani.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750114
					]
				},
				{
					"id": 721750114,
					"content": "Nasıl yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750115,
					"content": "#Haha, beni hiç şaşırtmadın {NICKNAME}! Maceracılıkta uzmansın! Senin ise daha öğrenecek çok şeyin var Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750116
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750116,
					"content": "Evet, çok şey var öğreneceğin Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750117
					]
				},
				{
					"id": 721750117,
					"content": "Bırakın ya, şansını denemek denir buna! Paimon'un onu öğrenmesine gerek yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750118,
					"content": "Neyse, siste bir türlü ilerleyemedim işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750119
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750119,
					"content": "*iç çeker* Ağaçlardan birine ip bağlayıp diğer ucunu da elime alarak ilerlemeye çalışsaydım belki birkaç kez daha deneyebilirdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750120
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750120,
					"content": "Neden tekrar denemedin o zaman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750121,
					"content": "Nereye gittiğimi göstermek için yedek ayakkabılarımı kullandım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750122,
						721750124
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750122,
					"content": "Onlardan başka ayakkabın yok yani...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750123
					]
				},
				{
					"id": 721750123,
					"content": "Aslında vardı ama... Birçoğunu fırlatıp sonrasında geri almayı unuttum... Bir baktım ayakkabım kalmamış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750126
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750126,
					"content": "Bir dakika, sonunda hatırladım! Sizden bir iyilik isteyecektim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750127
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750127,
					"content": "Vay be, ne kadar şaşırdım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721750128,
					"content": "Hahaha, kusura bakmayın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750129
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750129,
					"content": "Bildiğiniz üzere sürekli bir şeyleri unutmak gibi kötü bir alışkanlığım var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750130
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750130,
					"content": "Bir maceracı olduğumdan beri bu zayıf hafızam başımı pek çok kez belaya soktu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750131
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750131,
					"content": "Tsurumi Adası'na gelme amaçlarımdan birisi aslında Fosforlu Mantar diye bir mantar toplamaktı. Sango'nun dediğine göre bu mantarlar hafızayı geliştiriyor ve kişinin beynindeki gerginliği azaltıyormuş. Hatta gözlere iyi geldiği de söyleniyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750132
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750132,
					"content": "Buraya en son Kama ile birlikte geldiğimde \"yerlilerle tanışmakla\" o kadar meşguldüm ki mantar toplamayı unuttum... *iç çeker*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750133
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750133,
					"content": "Hem bu adaya tek başıma gelince bu kadar sorunla karşılaşmayı da beklemiyordum. Çok yazık oldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750134
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750134,
					"content": "Bu bölgede hâlâ maceraya çıkmaya düşünüyorsanız benim için şu Fosforlu Mantarlardan toplayabilir misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750135,
						721750137
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750135,
					"content": "Tabii, olur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750136
					]
				},
				{
					"id": 721750136,
					"content": "Çok sağ olun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750137,
					"content": "Bir gün beni de unutma yeter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750138
					]
				},
				{
					"id": 721750138,
					"content": "Hahaha, unutmam merak etme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750124,
					"content": "Yazık olmuş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750125
					]
				},
				{
					"id": 721750125,
					"content": "*iç çeker* Oldu gerçekten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750126
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750105,
					"content": "Adayı hâlâ araştırıyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750106
					]
				},
				{
					"id": 721750106,
					"content": "Öyle mi? Haha, daha fazla vaktinizi çalmayayım o zaman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750107
					],
					"speakerTitle": "Roald"
				}
			]
		},
		{
			"id": 7217503,
			"completionStepIds": [
				7217510
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217517",
							"3"
						],
						"stepId": 7217517,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7217510",
							"2"
						],
						"stepId": 7217510,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Roald"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721750301,
					"content": "Hımm, bu kadar mantar yeterli olur. Çok sağ ol!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750302
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750302,
					"content": "Bu arada adanın tören alanının yakınlarında ilginç bir şeyler bulursanız beni de çağırmayı unutmayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750303
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750303,
					"content": "Hımm. Sanırım yanınızda Fontaine yapımı bir Kamera var, değil mi? Oldukça pahalı bir alet... Bütçem yetse ben de almak isterdim ama çok pahalılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750304
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750304,
					"content": "Bazı yerel tarihçiler Tsurumi Adası'nın eski yerlilerinin kadim ve unutulmuş tarihi olayları mağara duvarlarına resmettiklerini ve bu duvar resimlerinin bin yıldan daha eski olduklarını söylüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750305
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750305,
					"content": "Burayı en son ziyaret ettiğimde o resimleri tören ateşinin ışığında görme fırsatı yakalamıştım... Aklımdan çıkmadılar, kaç gece uyku uyuyamadım. Resimleri unutmak gerçekten hiç kolay değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750306
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750306,
					"content": "Bugüne dek kimsenin o duvar resimlerinin tamamını gördüğünü sanmıyorum. Resimlerin varlığına dair kanıt getirirseniz Maceracılar Loncasının tarih alanında büyük bir ilerleme kaydetmesini sağlarsınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750307
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750307,
					"content": "Dediğim bu efsanevi duvar resimlerini bulacak olursanız bir sürü net fotoğrafını çekin. Günlüklerimde kullanmak için fotoğrafları makul bir fiyat karşılığında satın alırım. Emekleriniz için sizi ek olarak ödüllendiririm de.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750308
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750308,
					"content": "Ne dersiniz? Bu anlaşma sizin için uygun mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721750309,
						721750311
					],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750309,
					"content": "Uygun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750310
					]
				},
				{
					"id": 721750310,
					"content": "Çok sağ olun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Roald"
				},
				{
					"id": 721750311,
					"content": "Günlüğünü yine kaybetmediğin sürece uygun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721750312
					]
				},
				{
					"id": 721750312,
					"content": "Elimden geleni yapacağım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Roald"
				}
			]
		},
		{
			"id": 7217504,
