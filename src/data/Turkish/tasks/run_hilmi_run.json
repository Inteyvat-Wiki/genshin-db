					"nextDialogs": [
						230390404
					]
				},
				{
					"id": 230390404,
					"content": "Haha, iyi olduğumu söylemiştim sana! Beni hafife alma sakın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390405
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390405,
					"content": "Yine de işte bu kadar hızlı koşsam bile Habachi'yi geçemiyorum. Nedenini anlayamadım gitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390406,
						230390407
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390406,
					"content": "Belki kestirme bir yol vardır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390408
					]
				},
				{
					"id": 230390408,
					"content": "Öyle mi? Etrafta kestirme bir yol olduğunu sanmıyorum gerçi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390409
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390409,
					"content": "#{F#Abla}{M#Abi}, sonra tekrar bizimle oynar mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390410
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390410,
					"content": "Yani, şey... Gelip bizimle idman yap demek istedim! \"Vahşi doğada iz sürme\" idmanı falan yaparız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390411
					],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390411,
					"content": "Doğru diyorsun! Habachi'yi geçemiyorsak etrafından dolanırız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390412
					],
					"speakerTitle": "Ebeid"
				},
				{
					"id": 230390412,
					"content": "Onu daha önce de denedik ya. Şu ana kadar işe yaramış değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hilmi"
				},
				{
					"id": 230390407,
					"content": "Hile yapıyor olabilir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390408
					]
				},
				{
					"id": 230390403,
					"content": "Uçtun resmen...",
					"roleType": "TALK_ROLE_PLAYER",
