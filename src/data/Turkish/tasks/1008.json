			"dialogs": [
				{
					"id": 10080601,
					"content": "Kardeşimi kurtardığınız için teşekkür ederim aydınlanmış Adeptusların kudretli ulakları.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080602
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080602,
					"content": "Buralarda hiç Adeptus gördün mü?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080603
					]
				},
				{
					"id": 10080603,
					"content": "Ne? Hayır... Yani, herkes gibi biz de Hulao Dağı'nda bir Adeptusun yaşadığını duyduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080604
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080604,
					"content": "Ancak bizim gibi normal insanlar asla onlarla karşılaşamaz. İmkanı yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080605
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080605,
					"content": "Sizin dışınızda tabii... Sizler Adeptusların ulağısınız, sizin olayınız tamamen farklı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080606
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080606,
					"content": "Her neyse, Adeptus diyarında yeterince uzun süre izinsiz bulunduk. Artık geri dönmeliyiz. Teşekkürler kudretli Adeptusların ulakları...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080607
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080607,
					"content": "Evet, teşekkür ederiz ulaklar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080608
					],
					"speakerTitle": "Li Dang"
				},
				{
					"id": 10080608,
					"content": "... Gerçekten Adeptusların ulağı olsak nasıl işimize yarardı ama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080609,
					"content": "Çünkü görünüşe göre bu Adeptusun ciddi bir öfke sorunu var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080610,
					"content": "Ancak biz yanlış bir şey yapmadık yani... Umarım sorun olmaz... Hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089601
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10089601,
					"content": "Kim benim dağıma izinsiz girdi? Hırsızı kim tutsaklıktan kurtardı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089602
					],
					"speakerTitle": "Dağkesen"
				},
				{
					"id": 10089602,
					"content": "Aptal ölümlü, karşıma çık ve hemen cezanı çek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dağkesen"
				}
			]
		},
		{
			"id": 100807,
			"completionStepIds": [
				100807
			],
