				"points": []
			},
			"dialogs": [
				{
					"id": 10089701,
					"content": "Kardeşim bana her şeyi anlattı... Onu kurtardığınız için ikinize de çok teşekkür ederim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089702
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10089702,
					"content": "*iç çeker* Ailemizin hayatını geçindirebileceği hiçbir şey yok... Hulao Dağı'nın kehribar kayalarına saklanmış hazineler olduğunu duyduk ve gidecek başka yerimiz olmadığı için onları aramaya geldik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089703
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10089703,
					"content": "Bunu etraflıca düşünmedik... Dağa çaktırmadan tırmanabileceğimizi, satıp ailemize destek olabileceğimiz kadar hazine alıp çıkabileceğimizi düşündük.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089704
					],
					"speakerTitle": "Li Dang"
				},
				{
					"id": 10089704,
					"content": "Gördüğünüz üzere Adeptus bizi açgözlülüğümüz nedeniyle cezalandırdı. Kehribar kayalar beni yuttu. Siz beni kurtarmaya gelmiş olmasaydınız kim bilir ne zaman çıkabilirdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089705
					],
					"speakerTitle": "Li Dang"
				},
				{
					"id": 10089706,
					"content": "... Ulaklar mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10089707
					]
				},
				{
					"id": 10089709,
					"content": "Günahlarını, düştüğün durumu ve tövbeni gördüm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10089710
					]
				},
				{
					"id": 10089705,
					"content": "Şansımıza Adeptus merhametli davrandı. Bizi kurtarmanız için ikinizi ulağı olarak gönderdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089706,
						10089709
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10089707,
					"content": "Evet! Siz ikiniz tam da ben dağın zirvesinde, burada Adeptustan af dilenirken kardeşimi kurtardınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089708
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10089708,
					"content": "Siz Adeptusların ulağısınız, ona şüphe yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089712
					],
					"speakerTitle": "Li Dang"
				},
				{
					"id": 10089710,
					"content": "Vay be çok iyi Adeptusların ulağı taklidi yapıyorsun. Sanki bu rolü oynamak için doğmuşsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10089711,
					"content": "Teşekkür ederim... Evet, gerçekten çok üzgünüz. Kardeşim ve ben dersimizi aldık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089712
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10089712,
					"content": "Adeptusun merhametine değer görüldüğümüz için gerçekten çok şanslıyız. Yöntemlerimizi değiştirip bundan böyle hayatımızı dürüstçe kazanacağımıza söz veriyoruz. Bunun için limanda ter dökmemiz gerekse bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089713
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10089713,
					"content": "Her neyse, Adeptus diyarında yeterince uzun süre izinsiz bulunduk. Artık geri dönmeliyiz. Teşekkürler kudretli Adeptusların ulakları...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089714
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10089714,
					"content": "Evet, teşekkür ederiz ulaklar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089715
					],
					"speakerTitle": "Li Dang"
				},
				{
					"id": 10089715,
					"content": "... Gerçekten Adeptusların ulağı olsak nasıl işimize yarardı ama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080609,
					"content": "Çünkü görünüşe göre bu Adeptusun ciddi bir öfke sorunu var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080610,
					"content": "Ancak biz yanlış bir şey yapmadık yani... Umarım sorun olmaz... Hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089601
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10089601,
					"content": "Kim benim dağıma izinsiz girdi? Hırsızı kim tutsaklıktan kurtardı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10089602
					],
					"speakerTitle": "Dağkesen"
				},
				{
					"id": 10089602,
					"content": "Aptal ölümlü, karşıma çık ve hemen cezanı çek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dağkesen"
				}
			]
