			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dağkesen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10080701,
					"content": "... Mukaddes Hulao Dağı'na izinsiz adım atıyorsun, dağımın kehribar kayalarını yok ediyorsun ve özgürlüğüne karar vermesi sana kalmamış bir hırsızı özgür bırakıyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080702
					],
					"speakerTitle": "Dağkesen"
				},
				{
					"id": 10080702,
					"content": "Hırsızların cehaleti Adeptuslara bir hakaretti ancak senin davranışların görülmemiş bir çirkinlik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080703
					],
					"speakerTitle": "Dağkesen"
				},
				{
					"id": 10080703,
					"content": "Bekle! Açıklayabiliriz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080704,
						10080706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080704,
					"content": "Şuna bak...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080705
					]
				},
				{
					"id": 10080705,
					"content": "... Yetki Mührü mü? Böyle şeylerin ölümlüler diyarında hâlâ var olduğunu bilmiyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080708
					],
					"speakerTitle": "Dağkesen"
				},
				{
					"id": 10080708,
					"content": "Bu bir... Yetki Mührü mü? Böyle şeylerin ölümlüler diyarında hâlâ var olmasına şaşırdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080709
					],
					"speakerTitle": "Dağkesen"
				},
				{
					"id": 10080709,
					"content": "Başta Rex Lapis bunları kendi elleriyle ölümlüler için yapmıştı. Çok az miktarda yapılmıştı ve bin yıllar sonra çok daha azı kaldı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080710
					],
					"speakerTitle": "Dağkesen"
				},
				{
					"id": 10080710,
					"content": "Konuş. Seni buraya getiren meselenin ne olduğunu dinleyip sonrasında doğru olup olmadığını teyit edeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080711
					],
					"speakerTitle": "Dağkesen"
				},
				{
					"id": 10080711,
					"content": "Doğruları konuşsan iyi edersin çünkü Liyue buraya beni kolayca kandırabileceğin kadar uzakta değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080712
					],
					"speakerTitle": "Dağkesen"
				},
				{
					"id": 10080712,
					"content": "Rex Lapis... Suikaste mi uğradı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080713
					],
					"speakerTitle": "Dağkesen"
				},
				{
					"id": 10080713,
					"content": "Zuhur Ayininde mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080714
					],
					"speakerTitle": "Dağkesen"
				},
				{
					"id": 10080714,
					"content": "Liyue'deki hangi ölümlü, hatta dünya üzerinde kim böylesine alçakça bir ihanette bulunmak üzere komplo kurar ki? Ya da şöyle sormalıyım; dünya üzerindeki hangi güç böyle bir şeyi arzulayabilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080715
					],
					"speakerTitle": "Dağkesen"
				},
				{
					"id": 10080715,
					"content": "Rex Lapis Adeptusları Liyue'yi korumak üzere görevlendirdi ve biz de her zaman bu görevi yerine getirdik. İnsanlar zenginleştikçe biz de yavaş yavaş dağlara çekildik. Aslında insanlığa iyi niyetimizi bu şekilde göstermiştik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080716
					],
					"speakerTitle": "Dağkesen"
				},
				{
					"id": 10080716,
					"content": "Ama şimdi... Ne yazık! Rex Lapis, öldü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080717
					],
					"speakerTitle": "Dağkesen"
				},
				{
					"id": 10080717,
					"content": "Gezgin, bana ulaştırdığın bilgiden artık haberdarım. Şimdi Ay Oymacısı'nın sizi neden gönderdiğini anlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080718
					],
					"speakerTitle": "Dağkesen"
				},
				{
					"id": 10080718,
					"content": "Burada ilgilenmem gereken konuları hallettikten sonra diğer Adeptuslarla bir araya gelmeliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080719
					],
					"speakerTitle": "Dağkesen"
				},
				{
					"id": 10080719,
					"content": "Birileri bana şu kehribar olayını anlatabilir mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080720
					]
				},
				{
					"id": 10080720,
					"content": "Paimon anlatabilir! Adeptuslar hikaye kitaplarında hep sihirli güçlere sahiptir, görünen o ki gerçek hayatta da öyleler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080721
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080721,
					"content": "Örneğin çimenler aslında Adeptusların saçıdır ve nehirler onların salyasıdır... Kehribar da benzeri bir durum olsa gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080722,
						10080723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080722,
					"content": "Yağmur... Adeptusların gözyaşları mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080724
					]
				},
				{
					"id": 10080724,
					"content": "... Saçmalamanız sınır tanımıyor. Bu kehribar kayalar, buraya ektiğim karst tomurcuklarından geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080725
					],
					"speakerTitle": "Dağkesen"
				},
				{
					"id": 10080725,
					"content": "Çiçeğin büyük kısmı yer altında gizli. Üzerine basıldığında istila eden kişiyi hapsetmek için kehribar üretiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080726
					],
					"speakerTitle": "Dağkesen"
				},
				{
					"id": 10080726,
					"content": "Buraya yerleştikten sonra dağın sükunetinin daimi olmasını sağlamak için bolca karst tomurcuğu ektim. Yıllar boyunca birçok rahatsız edici durumu engellediler ancak aynı zamanda birçok meraklı şeyi de hapsettiler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080727
					],
					"speakerTitle": "Dağkesen"
				},
				{
					"id": 10080727,
					"content": "Yani kehribar... Canlı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080728,
					"content": "Aynen öyle. Bu nedenle yokluğumda masum canların zarar görmesinden korktuğum için şu anda buradan ayrılamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080729
					],
					"speakerTitle": "Dağkesen"
				},
				{
					"id": 10080729,
					"content": "Bu meseleyle ilgilendikten sonra gideceğim. Muhtemelen siz daha hızlı gideceksiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dağkesen"
				},
				{
					"id": 10080723,
					"content": "Kehribar da Adeptusların kristalleşmiş... Iyy, iğrenç.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080724
					]
				},
				{
					"id": 10080706,
					"content": "Bizi Ay Oymacısı gönderdi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080707
					]
				},
				{
					"id": 10080707,
					"content": "Ay Oymacısı... Ulağı olarak bir ölümlüye mi güvendi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080708
					],
					"speakerTitle": "Dağkesen"
				}
			]
		},
