			"trigger": {
				"objectNames": [
					"Li Ding"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10080201,
					"content": "Merhamet et kudretli Adeptus! Yalvarırım sana... Bana ve kardeşime merhamet et... Hayatlarımızı bağışla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080202
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080202,
					"content": "Sorun nedir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080203
					]
				},
				{
					"id": 10080203,
					"content": "Sen kimsin? Ne oluyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080204
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080204,
					"content": "İlk biz sana sorduk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080205,
					"content": "Ah! Jueyun Gölü'ndeki güvenli geçidi kullanıyorsun... Bunun tek bir anlamı olabilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080206
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080206,
					"content": "Siz Adeptusların ulağısınız! Buraya beni ve kardeşimi kurtarmaya geldiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080207
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080207,
					"content": "Neden bahsediyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080208,
					"content": "... Aydınlanmış Adeptusların kudretli ulakları, merhamet edin! Yalvarırım kurtarın bizi... Kardeşim ve ben yalnızca ailemiz fakir olduğu ve Hulao Dağı'ndaki kehribar kayalarının içinde gizli hazineler olduğunu duyduğumuz için geldik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080209
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080209,
					"content": "Aptallık ettik... Sadece satıp ailemize yardım edecek kadar hazine bulmaya gelmiştik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080210
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080210,
					"content": "<color=#00E1FFFF>Dağa uzanan yolu</color> takip ettik ancak kehribar kayalar aniden kardeşim Li Dang'ı yuttu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080211
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080211,
					"content": "Beni de yutmadan önce buraya kadar kaçtım. Adeptusların evine izinsiz girdik ve cezamız da bu oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080212
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080212,
					"content": "Kardeşimi nasıl kurtaracağımı bilemedim, bu yüzden Adeptusların merhamet etmesi için dua etmeye başladım. Tam burada. Şimdi, geçen uzun zamanın üstüne iki ulak yardımıma geldi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080213
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080213,
					"content": "Ne? Biz Adeptusların ulağı değiliz... Biz de herkes gibi Adeptusları bulmak istiyoruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080214,
					"content": "Hayır, hayır, hayır, ulak, siz ulaksınız... Ulak olmalısınız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080215
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080215,
					"content": "Kardeşimin hangi kehribar kayanın içinde esir olduğuna dair hiçbir fikrim yok... Lütfen, onu kurtarmanız gerek! Yalvarırım size, bana Adeptusların merhametini gösterin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080216,
						10080218
					],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080216,
					"content": "İyi tamam. Gidip bir bakayım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080217
					]
				},
				{
					"id": 10080217,
					"content": "Teşekkürler, teşekkürler! Aydınlanmış Adeptusların kudretli ulakları, bir daha asla böyle aptalca şeyler yapmayacağımıza söz veriyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Li Ding"
				},
				{
					"id": 10080218,
					"content": "Günahlarını, düştüğün durumu ve tövbeni gördüm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10080219
					]
				},
				{
					"id": 10080219,
					"content": "Hey dikkat et! Böyle konuştuğunda gerçekten Adeptusların ulağı gibi oldun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10080220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10080220,
					"content": "Hulao Dağı'nın Adeptusuna ve ulaklarına teşekkürler! Bir daha asla bu kadar aptalca davranmayacağız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Li Ding"
				}
			]
		},
