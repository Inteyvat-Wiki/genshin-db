			},
			"dialogs": [
				{
					"id": 741421401,
					"content": "Aaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421402,
					"content": "Paimon, ben...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421403
					]
				},
				{
					"id": 741421403,
					"content": "Nasıl bu kadar hızlı gidip geldin? Paimon daha gözünü bile kırpmadı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421404,
					"content": "İyi bari...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421405
					]
				},
				{
					"id": 741421405,
					"content": "#Pekala! Aa, bizim minik baş belası da dönmüş! {NICKNAME} seni ne kadar merak etti Canotila, haberin var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421406,
					"content": "Şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421407
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421407,
					"content": "*ağlar* Özür dilerim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421408
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421408,
					"content": "Ya... Paimon seni suçlamıyordu ki! Ağlama Canotila. Yapma böyle, Paimon sana yiyecek güzel bir şey versin hemen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421409,
					"content": "(Ne oldu?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421410,
					"content": "(İçerisi biraz tehlikeliydi de.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421411
					]
				},
				{
					"id": 741421411,
					"content": "(Aa...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421412,
					"content": "Ağlama bu kadar Canotila, sen çok cesur bir Melusinasın bir kere! Bak, Paimon bu Tavuk Mantar Şişe bayılıyor. Al hadi, hepsi senin olsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421413,
					"content": "*ağlar* Çok teşekkür ederim Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421414
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421414,
					"content": "*çiğner*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421415
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421415,
					"content": "Aa, ne acayip bir lezzet! İnsanlar yemek diye bunu mu yiyor gerçekten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421416
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421416,
					"content": "Bak ya! Beğenmediysen Paimon'a geri verebilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421417,
					"content": "#Ama... Teşekkür ederim. Beni kurtardığın için sana da teşekkür ederim {M#Bay}{F#Bayan} {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421418
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421418,
					"content": "Şimdi ne yapacaksın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421419
					]
				},
				{
					"id": 741421419,
					"content": "Bilmem ki. Artık kitap okumaya hevesim kalmadı, orası kesin ama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421420
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421420,
					"content": "O da biraz abartı oldu sanki Canotila...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421421,
					"content": "Şey... Esinleme Kitabı ödümü kopardı gerçekten...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421422
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421422,
					"content": "(Peki ama tam olarak ne oldu?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421423,
					"content": "(Uzun hikaye...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421424,
						741421425
					]
				},
				{
					"id": 741421424,
					"content": "(Anlatılmaz, yaşanır.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421426
					]
				},
				{
					"id": 741421426,
					"content": "(O ne demek şimdi? Off, Paimon'u gıcık ettin...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421427,
					"content": "Neyse, artık burada kalmak istemiyorum. Diğerleriyle birlikte Merusea Köyü'nde yaşamak istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421428
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421428,
					"content": "Aynen, oraya git artık! Diğer Melusinalar sana çok iyi bakar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741421429,
					"content": "#{M#Bay}{F#Bayan} {NICKNAME}, Bayan Paimon... İkinize de çok teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421425,
					"content": "(İyi ki gelmedin diyeyim, sen anla.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421426
					]
				}
			]
		},
