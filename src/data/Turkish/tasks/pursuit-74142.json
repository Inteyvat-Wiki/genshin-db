			},
			"dialogs": [
				{
					"id": 741420701,
					"content": "#{M#Bay}{F#Bayan} {NICKNAME}! Hımm, Paimon neden yanında değil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420702
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420702,
					"content": "Şurada bir çatlak var... Sen neye bakıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420703
					]
				},
				{
					"id": 741420703,
					"content": "Ne çatlağı? Ayna değil mi o?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420704
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420704,
					"content": "Neyse, konusu açılmışken söyleyeyim. Ben burada bir şey arıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420705
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420705,
					"content": "Sırlar Aynasını bulmak için ipucu toplamaya çalışıyorum. Tabloya benzeyen bir şey, tıpkı Esinleme Kitabı gibi meditasyon yapabilmeni sağlıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741420706
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741420706,
					"content": "Gestalt Kulesindeki dört bölge ve tablodan mı bahsediyorsun yoksa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741420707
					]
				},
				{
					"id": 741420707,
					"content": "#... Ne diyorsun! Ayna gerçekten de öyle bir yerde mi duruyor yani? Anlaşıldı o zaman! Teşekkürler {M#Bay}{F#Bayan} {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canotila"
				}
			]
		},
