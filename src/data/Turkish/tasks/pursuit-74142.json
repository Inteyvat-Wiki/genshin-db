					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421505
					]
				},
				{
					"id": 741421505,
					"content": "Şey... Peki! Göz açıp kapayıncaya kadar geliyorsun zaten. Paimon'un içi rahat!",
