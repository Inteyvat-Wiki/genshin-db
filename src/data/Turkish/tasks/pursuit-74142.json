			"dialogs": [
				{
					"id": 741421301,
					"content": "#Teşekkür ederim {M#Bay}{F#Bayan} {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421302
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421302,
					"content": "Ne oldu böyle?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421303
					]
				},
				{
					"id": 741421303,
					"content": "Bilmiyorum. Sadece açan ayçiçeklerini ve o tatlı yavru köpeği görmek istemiştim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421304
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421304,
					"content": "Sonra bir canavar peşime düştü ve gökyüzü birden kararıverdi. Sesler duydum ama neden bahsettiklerini hiç anlayamadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421305
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421305,
					"content": "O kadar korktum ki altın ışıkları takip ederek koştum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421306
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421306,
					"content": "Canavar yaklaştıkça daha da zifiri bir karanlık çöktü dünyaya. Bahçe, saray, ulu ağaçlar, bütün çiçekler... Hepsi ortadan kayboluverdi. Her yeri bir kasvet kaplamıştı, harabelerden başka bir şey görünmüyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421307
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421307,
					"content": "Sonra da canavar beni yakaladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421308
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421308,
					"content": "Artık için rahat olsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421309
					]
				},
				{
					"id": 741421309,
					"content": "Lütfen onu geri gönder yavru köpek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421310
					]
				},
				{
					"id": 741421310,
					"content": "Bir daha buraya gelme ufaklık. Burası bomboş, hiçbir şey yok ama dışarıda seni uçsuz bucaksız bir dünya bekliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421311
					]
				},
				{
					"id": 741421311,
					"content": "Ne? Yavru köpek sen misin? İyi de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421312
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421312,
					"content": "... Seni tekrar görebilecek miyim? Bu dünya yeniden güzel bir bahçeye dönüşecek mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421313
					],
					"speakerTitle": "Canotila"
				},
				{
					"id": 741421313,
					"content": "Hayır. Güle güle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421314
					]
				},
				{
					"id": 741421314,
					"content": "Sana gelecek olursak... Bir daha soruyorum. Bana bakınca ne görüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421315
					]
				},
				{
					"id": 741421315,
					"content": "Bir köpek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421316
					]
				},
				{
					"id": 741421316,
					"content": "Güzel. Burada olmaması gereken zatı defettin. Sayende dünya büyük bir yıkımın eşiğinden döndü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421317
					]
				},
				{
					"id": 741421317,
					"content": "Yine de burada kalmanız doğru değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421318,
						741421320
					]
				},
				{
					"id": 741421318,
					"content": "O kadarını anladım, evet. Geri gönder beni hadi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421319
					]
				},
				{
					"id": 741421319,
					"content": "Doğru kararı verdin. Elveda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": []
				},
				{
					"id": 741421320,
					"content": "Neler oluyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421321
					]
				},
				{
					"id": 741421321,
					"content": "Burada olmaması gereken biri yüzünden bu dünyanın tüm temelleri sarsıldı, un ufak olmasına ramak kalmıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421322
					]
				},
				{
					"id": 741421322,
					"content": "O yüzden mi öyle şeyler gördüm yani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421323
					]
				},
				{
					"id": 741421323,
					"content": "Ne gördüğünü nereden bileyim ben? Ben sen değilim sonuçta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421324
					]
				},
				{
					"id": 741421324,
					"content": "E peki kimsin sen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741421325
					]
				},
				{
					"id": 741421325,
					"content": "Orasını boş ver şimdi. Önemli olan bu hayali dünyanın efendileri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421326
					]
				},
				{
					"id": 741421326,
					"content": "Dünyayı kurtarabileceğini sandı ama kim söylemiş dünyanın kurtarılmaya ihtiyacı olduğunu? Belki de hatırladıkları dünya, akşamüstü açan ayçiçeklerinin kaybolmaya yüz tutmuş bir hayalinden ibarettir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421327
					]
				},
				{
					"id": 741421327,
					"content": "Tabii bunlar yalnızca birer hikayeden ibaret, hiçbiri de bana ait değil. Ben sadece onun dost bildiği birinin hatırasıyım. Bir zamanlar beni kurtarabileceğini sandı ama sonunda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421328
					]
				},
				{
					"id": 741421328,
					"content": "Kelebek, kozasına geri döndü ve o kozadan bir larva çıktı. Sonra da o larva asla doğmayacağı bir hiçlikte kayboldu gitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421329
					]
				},
				{
					"id": 741421329,
					"content": "Ama bunların hiçbir önemi yok aslında. Her şeyimi kaybettim. Artık sadece onun hatıralarında yaşıyorum, beni kurtarmaya duyduğu saplantının bir gölgesiyim ben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421330
					]
				},
				{
					"id": 741421330,
					"content": "Ondan nefret ettiğim yok tabii. Beni kaybettikten sonra çok değişmiş olsa da benden vazgeçemediği ortada. Öyle olmasa hatıralar ve sanrılarla dolu bu dünyada var olmaya nasıl devam edeyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421331
					]
				},
				{
					"id": 741421331,
					"content": "O bir zamanlar benim dostumdu, sayesinde mutlu günler geçirdim. Şu anda neye dönüşmüş olursam olayım mazide kalan dostluğumuz için ona sonsuza dek minnettar kalacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421332
					]
				},
				{
					"id": 741421332,
					"content": "Neyse, daha fazla uzatmayalım. Bu yerin senin üzerinde bıraktığı etkiyi hissedebiliyorsun, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741421333
					]
				},
				{
					"id": 741421333,
					"content": "Yolun açık olsun. Bir daha asla karşılaşmamak üzere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": []
				}
			]
		},
