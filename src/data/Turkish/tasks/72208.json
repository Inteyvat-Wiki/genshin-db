			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ipe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722080101,
					"content": "Çok iyi balık tutuyorsun! Gerçi hâlâ geliştirebilirsin gibi duruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080102,
						722080103
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080102,
					"content": "Ay!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080104
					]
				},
				{
					"id": 722080104,
					"content": "Ahaha, özür dilerim. Selamlama olayını hep unutuyorum. İnsanları korkutabileceğimi unutuveriyorum işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080105
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080105,
					"content": "Ama hoşuna da gidiyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080106
					]
				},
				{
					"id": 722080106,
					"content": "Ah, hadi ama... Arada bir çocukları korkutmak çok eğlenceli değil mi sence de?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080107
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080107,
					"content": "*öksürür* Neyse, balıkçılığa geri dönelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080108,
						722080109
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080108,
					"content": "Ne, ciddi bir mesele mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080110
					]
				},
				{
					"id": 722080110,
					"content": "Şey... İmajıma biraz zarar verecek ama geçenlerde balık tutarken Makiri'nin bana verdiği tılsımımı düşürdüm. İçinde atalarının ruhlarının kutsamaları ve Büyük Yıldırım Kuşu vardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080111
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080111,
					"content": "Sandala bindikten sonra kaybettiğimi öğrenirse ben... Ben ona ne söylerim bilemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080112
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080112,
					"content": "Altın sandaldaki adam aramama yardım etmesi için birkaç kişi yollayacağını söyledi ama kimsenin geldiği yok! Seni de burada görünce bana yardım edebilirsin diye düşündüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080113,
						722080114
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080113,
					"content": "Ben de senin güvenilir biri olduğunu düşünmüştüm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080115
					]
				},
				{
					"id": 722080115,
					"content": "Genelde şurada balık tutarım ama hafızam gittikçe zayıflıyor. Anlayacağın arayıp bulma işini sana bırakacağım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080116,
						722080117
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080116,
					"content": "Çok eskiden hatırladığın bir yer olduğu için...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080118
					]
				},
				{
					"id": 722080118,
					"content": "Ne? Ne demek istiyorsun? Siz yabancılar kaybettiklerinizi böyle mi buluyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080119
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080119,
					"content": "*iç çeker* Nasıl olduğu önemli değil. Yeri bulunca tılsımı da hemen bulursun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080120
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080120,
					"content": "Peki tılsımı nasıl bulacağım?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080121
					]
				},
				{
					"id": 722080121,
					"content": "Nasıl mı? Tabii ki de denizden balık tutar gibi yakalaman lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080122
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080122,
					"content": "İşe yarar herhalde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080123
					]
				},
				{
					"id": 722080123,
					"content": "Teşekkür ederim uzaklardan gelen dostum! Büyük Yıldırım Kuşu ve atalarımız seni korusun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080117,
					"content": "Muhtemelen \"tüy\" sorunumuzu çözer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080118
					]
				},
				{
					"id": 722080114,
					"content": "Gerçekten umutsuz vakasın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080199
					]
				},
				{
					"id": 722080199,
					"content": "Autake Ovası'nın batısında üç tane şelaleye doğru bakan bir ada var. O adanın en batısında kalan denizde olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080115
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080109,
					"content": "Balık tutmayı çok seviyorsun, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080110
					]
				},
				{
					"id": 722080103,
					"content": "Bir anda ortaya çıkmadan önce selamlamaya ne oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080104
					]
				}
			]
		},
