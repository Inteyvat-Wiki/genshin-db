				{
					"id": 722080201,
					"content": "Çok teşekkür ederim! Sonunda huzurlu bir şekilde sandala binebilirim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722080202
					],
					"speakerTitle": "Ipe"
				},
				{
					"id": 722080202,
					"content": "Sandal nereye gidiyor ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722080203
					]
				},
				{
					"id": 722080203,
					"content": "Altın diyarı, rüyalar diyarına gidiyor. Sis olmayan bir alem. Rüyalarda tekrar görüşmek üzere dostum.",
					"roleType": "TALK_ROLE_NPC",
