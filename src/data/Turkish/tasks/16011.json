			"dialogs": [
				{
					"id": 160110201,
					"content": "Of...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110202
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110202,
					"content": "... Kılıç kırılmamış mı? Ama Kurt Ruhunu hissedemiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110203
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110203,
					"content": "(... Görünüşe göre artık gerçeklikte değilim. Burası Poyraz ve Roland'ın zihinlerinin iç içe geçtiği bir mekan olmalı.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110204
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110204,
					"content": "Geri dönüş yolu yok ve önümde sadece kurdun ağzı var... Hımm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110205
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110205,
					"content": "Hah, anlaşılan tek çare içinden geçmek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				}
			]
		},
		{
			"id": 1601107,
