			"dialogs": [
				{
					"id": 160110701,
					"content": "Bu... Kurdun kalbi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110702
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110702,
					"content": "... Roland!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				}
			]
		},
		{
			"id": 1601109,
			"completionStepIds": [
				1601109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
