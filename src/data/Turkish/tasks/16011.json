						160111102
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111102,
					"content": "... İleriye yürü ve arkana bakma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111103
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160111103,
					"content": "\"Varka... Artık kendi ismimin anlamını biliyorum.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111104
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 160111104,
					"content": "\"... Herkes senin için bu kadar uğraştıktan sonra, geri geldiğinde hepimize adamakıllı bir teşekkür etsen iyi olur.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111105
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 160111105,
					"content": "\"Aslında sana anlatmam gereken çok şey var... Ama sen dönene kadar bekleyebilirler.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111106
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 160111106,
					"content": "\"Favonius Şövalyelerine geri dönmeye hiç niyetim yok... Ama bensiz de başınızın çaresine bakabileceğinize inanıyorum.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111107
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 160111107,
					"content": "\"... Hepimiz seni bekliyoruz Büyük Kumandan.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111108
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 160111108,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111109
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111109,
					"content": "Hımm? ... Ha. Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111110
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111110,
					"content": "Büyük Kumandan olarak... Hiç fena bir iş çıkarmıyorum, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111111
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111111,
					"content": "Heh... Bu sessizliği onay verdiğinizin bir işareti olarak kabul ediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111112
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111112,
					"content": "Canlarınız pahasına korumaya yemin ettiğiniz her şey... Hepsi hâlâ burada, sapasağlam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111113
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111113,
					"content": "Favonius Şövalyeleri, Mondstadt... Ve tüm şövalyelerin ettiği yemin... Hepsini canım pahasına koruyacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111114
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111114,
					"content": "Bu yüzden... O mektubu sizin adınıza ben teslim edeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111115
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111115,
					"content": "... Onun gerçek Roland'ın yalnızca bir gölgesi olduğunu biliyorum ama... Vaktiniz olursa bunu ona okur musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111116
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111116,
					"content": "Rostam ve Arundolyn... Seni hiç unutmadılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111117
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111117,
					"content": "Of... Bu gerçekten uzun bir sefer oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111118
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111118,
					"content": "Bundan sonra bana sanırım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111119
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111119,
					"content": "... Rüzgar rehberlik edecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111122
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111122,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111130
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 160111130,
					"content": "... Selam millet. Görüşmeyeli uzun zaman oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111131
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111131,
					"content": "Ben... Hepinizi yeniden gördüğüme çok sevindim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111132
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111132,
					"content": "Hoş geldin Büyük Kumandan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111133
					]
				},
				{
					"id": 160111133,
					"content": "Evet, evimdeyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111123
					],
					"speakerTitle": "Varka"
				},
				{
