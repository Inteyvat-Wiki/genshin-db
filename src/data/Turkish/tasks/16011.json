						"rawParams": [
							"1601109",
							"2"
						],
						"stepId": 1601109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Roland"
				],
				"points": [
					{
						"sceneId": 20336,
						"position": [
							387.989,
							123.18,
							197.075
						],
						"pointId": 1
					},
					{
						"sceneId": 20336,
						"position": [
							387.824,
							111.946,
							237.497
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 160110901,
					"content": "... Dilediğin gibi olsun Poyraz Şövalyesi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110902
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110902,
					"content": "Ha... Hiç de hayal ettiğim gibi çıkmadın. Kurt Ruhundaki anılarda tasvir edildiğin kadar kaçık görünmüyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110903
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110903,
					"content": "Ben doğru yoldan bir kez olsun şaşmadım. Fakat sana baktığımda... Ejderhaları katledebilecek bir kahraman değil, yolunu epey zaman önce kaybetmiş bir ruh görüyorum. Bir zamanlar olduğun şövalyenin gölgesinden ibaretsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110904
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110904,
					"content": "Sanırım ortak noktamız bu. İkimiz de gücümüzün zirvesinde değiliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110905
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110905,
					"content": "Ay Avcısı'nın güçleri yenilgiye uğradı ve gördüğün Roland, Hiçlik tarafından yansıtılan kusurlu bir görüntüden ibaret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110906
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110906,
					"content": "Roland'ın en kudretli zamanlarındaki gücüne sahibim ama ruhum o kanlı anın esiri olmaktan kurtulamıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110907
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110907,
					"content": "İşte bu yüzden, şu anki halimle noksanım... Bir şövalye yerinde saymayı kendine yediremez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110908
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110908,
					"content": "Seni o haksızlığın pençesinden kurtarıp Hiçliğin kucağına teslim ettikten sonra, kendimi arındıracak ve şövalyelik yolunda yürümeye devam edeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110909
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110909,
					"content": "Hah! Dışarıdaki dünya daha fazla zulmünü kaldıramaz. Bu saplantın... Tahmin ettiğim gibi hiç değişmemiş. Seni ikna etmenin bir yolu yok, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110910
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110910,
					"content": "Ne kadar süslü cümleler kurulursa kurulsun, hiçbir laf cambazlığı bir şövalyenin inancını sarsamaz. Birbirimizi yolumuzdan döndüremeyiz... Ama sen zaten bu gerçeği uzun zamandır biliyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110911
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110911,
					"content": "Aksi takdirde neden tüm umudunu Poyraz'ın tek bir düşüncesine bağlayasın ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110912
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110912,
					"content": "Lakin bir zamanlar Kurt Ruhuna ev sahipliği yapan kılıç artık paramparça, elinde tuttuğun ise onun suretine bürünmüş bir hayaletten ibaret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110913
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110913,
					"content": "Artık durumu değiştirecek gücün kalmadı, imdadına yetişecek kimsen de yok... Burası senin mezarın olacak yalnız savaşçı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110914
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110914,
					"content": "Hımm, haklılık payın olabilir... Ama bence bu işten kurtulmak için hâlâ şansım var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110915
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110915,
					"content": "... Nasıl yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110916
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110916,
					"content": "Fikrini değiştirmem gereken sadece bir kişi var ve o sen değilsin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110917
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110917,
					"content": "Nerede olduğumuzu unuttun mu? Burası Kuzey Rüzgarı Tanrısı Andrius'un kalbi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110918
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110918,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110919
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110919,
					"content": "Andrius! Beni duyabiliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110920
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110920,
					"content": "Uyan! Sen yüce Kuzey Rüzgarı Tanrısı'sın! Daha ne kadar Hiçliğin egemenliği altında kendine acı çektireceksin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110921
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110921,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110922
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110922,
					"content": "... Eğer son hamlen buysa beni büyük hayal kırıklığına uğrattın Poyraz Şövalyesi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110923
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110923,
					"content": "İçten dilenen dilekleri şatafatlı bir şekilde sergilemek mucize yaratmaz. Bu dünya, sakinlerine böyle bir merhamet göstermez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110924
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110924,
					"content": "... Geri dön...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110925
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110925,
					"content": "... Ley Hatlarına... Geri dön...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110926
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110926,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110927
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110927,
					"content": "... Bu benim seçimim... Benim hatıram...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110928
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110928,
					"content": "... Yolculuğumun sonunda... Bulduğum cevap bu mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110929
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110929,
					"content": "And{RUBY#[D]Poyraz}rius... Sonunda nişanını kalbine geri ulaştırdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110930
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110930,
					"content": "Hah... Bir Poyraz Şövalyesi misin? O zaman izle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110931
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110931,
					"content": "... Bir kur{RUBY#[S]ben}dun insa{RUBY#[S]sen}nlık adına yapabileceği yegane şey bu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110932
					],
					"speakerTitle": "Andrius"
				},
				{
					"id": 160110932,
					"content": "... Tüm insanlık adına sana teşekkür ederim Kurtların Efendisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110933
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110933,
					"content": "Poyraz... Ley Hatlarına mı dönüyor? Ama neden? Kılıcın kırık, artık ruhunu taşıyacak bir aracın yok... Yoksa... Olamaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110934
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110934,
					"content": "Mucizeler için yalvarmak beyhude bir çabadır. Bunu gayet iyi biliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110935
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110935,
					"content": "... Ama kılıç, ruhun saklanabileceği yerlerden yalnızca biri. Bunun başka yolları da var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110936
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110936,
					"content": "Kurtların Hakimi bir zamanlar ruhunun gücünü sürüsüne bahşederek kalplerini güçlendirmiş, onların pençelerini ve dişlerini sivriltmişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110937
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 160110937,
					"content": "... Niyetim bu olmasa da Poyraz Kurdu'nun ruhu kaçınılmaz surette ölümlü bir kalbi harap edecek, yutacak ve özümseyecek... Sanki insan ve kurt zorla tek bir varlıkta birleştirilmiş gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110938
					],
					"speakerTitle": "Poyraz"
				},
				{
					"id": 160110938,
					"content": "... Eğer bir ölümlünün kalbi bir tanrının ruhunu taşıyacaksa... Bu yolun geri dönüşü yoktur. Yine de bir şövalyeyi kendi seçtiği yoldan caydıramam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110939
					],
					"speakerTitle": "\"Yüzbaşı\""
				},
				{
					"id": 160110939,
					"content": "Kalbin, ruhun... Çöküyor mu? Ah, şimdi anladım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110940
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110940,
					"content": "Bir kuzu bir kurdun kalbini nasıl ehlileştirebilir diye merak ediyordun... Yanılıyor muyum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110941
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110941,
					"content": "Cevabım şu: Kurdun kalbi yutmasını sağlayarak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110942
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110942,
					"content": "Kılıcın içindeki Kurt Ruhu sadece bir yemdi... Asıl düşünceler ve anılar kalbinde saklıydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110943
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110943,
					"content": "Şüphelenmeyeyim diye kasten Poyraz Kurdu'nun ruhunun seninkini özümsemesine, sonra da benim tarafımdan yutulmasına izin verdin... Ama... Bu kadar büyük bir yükü taşırken savaşacak kuvveti nasıl buldun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110944
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110944,
					"content": "Poyraz Kurdu'nun verdiği kararın yanında... Benim fedakarlığımın sözü bile edilmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110945
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110945,
					"content": "İnatçı bir iraden ve sıra dışı bir stratejin var... Ama gerçek bir şövalye böyle dövüşmez. Yaptığın seçim kusurlu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110946
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110946,
					"content": "Ruhun artık Andrius'unkiyle birleşti. O Ley Hatlarına tamamen girdiğinde sen de yok olacaksın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110947
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110947,
					"content": "Seni kurtarmalarını bırak, ne Barbatos ne de Gezgin Ley Hatlarının içinden ruhuna dayanak olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110948
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110948,
					"content": "Sen de kaybettin, ben de. Ne yazık ki sana artık kurtuluş sunamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110949
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110949,
					"content": "... Ruhun Poyraz'la birlikte huzura ersin yalnız savaşçı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110950
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 160110950,
					"content": "... Haha, yalnız mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110951
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110951,
					"content": "Seni hayal kırıklığına uğrattığım için üzgünüm ama... Her ne kadar ikimizin birlikte Ley Hatlarına dönmesi kulağa mükemmel bir son gibi gelse de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110952
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110952,
					"content": "Geçmişteki gerçek Roland'ın aksine, beni bekleyen güzel şaraplarım ve iyi dostlarım var. Zaferle dönüşümü dört gözle bekliyorlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110953
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110953,
					"content": "Bu yüzden kaderimi kabullenmeye henüz hazır değilim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160110954
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160110954,
					"content": "Ding dong! Bir mesajın var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
