			},
			"dialogs": [
				{
					"id": 160111201,
					"content": "Ahhh... Bu rüzgarı yüzümde hissetmeyeli uzun zaman olmuştu... Tıpkı hatırladığım gibi. Ee, konuşmak istediğin bir şey var mı? Ben ofise tıkılmadan önce son şansın bak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111202,
						160111215,
						160111219,
						160111231
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111202,
					"content": "Planın hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111203
					]
				},
				{
					"id": 160111203,
					"content": "Kılıç sadece bir yemdi, onun ruhunu kendi kalbimde taşıyordum... İşe yarayacağından en emin olduğum plan buydu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111204
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111204,
					"content": "Ama ikinci kısım, yani herkesin düşüncelerini kullanarak Ley Hatlarından geri çıkma konusu... Bunun işe yarayacağından pek emin değildim, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111205
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111205,
					"content": "#Şaka bir yana, eğer {NICKNAME} Kurt Ruhunu Roland'ın etkisinden kurtaramasaydı ne yapacaktın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 160111206,
					"content": "Hımm... Başlangıçta o adımı Barbatos'un atmasını planlıyordum. Ama ona danıştığımda çok daha uygun bir aday olduğunu söyledi... Rüzgarı Yakalayan Yabancı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111207
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111207,
					"content": "#Görünüşe göre güvenimiz boşa çıkmamış. Teşekkürler {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111208
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111208,
					"content": "Peki ya başaramasaydım?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111209
					]
				},
				{
					"id": 160111209,
					"content": "O zaman... Sanırım beni eve geri uçurması için Barbatos'tan bir rüzgar göndermesini istememiz gerekecekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111210
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111210,
					"content": "... Ama bunun ağır bir bedeli olurdu ve başarı garantisi de olmazdı. Ayrıca öyle bir güç harcamasını istemezdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111211,
						160111212
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111211,
					"content": "... Bir Hükümdarın gücünü çağırmak...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111213
					]
				},
				{
					"id": 160111213,
					"content": "Hımm, güzel soru. Belki şöyle en güzelinden bir kadeh Karahindiba Şarabı olabilir. Onu da ofisimdeki zulamda sakladığım parayla ödemek zorunda kalırdım kuşkusuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111214
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111214,
					"content": "O kadar ucuza yırtacağını sanıyorsan yanılıyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 160111212,
					"content": "... Ne kadar ağır bir bedelden bahsediyoruz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111213
					]
				},
				{
					"id": 160111215,
					"content": "Keşif seferi hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111216
					]
				},
				{
					"id": 160111216,
					"content": "Roland'ın gölgesi yenildiğine göre Vahşi Av yakın gelecekte güçlerini birleştiremeyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111217
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111217,
					"content": "Birkaç şövalye dönüşümlü olarak Nod-Krai'da kalacak ama diğer herkes gruplar halinde evlerine gönderilecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111218
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111218,
					"content": "Albedo ve Durin ilk grupla birlikte geri dönecekler, yani onları yakında tekrar görebileceksiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111219,
					"content": "Geleceğin hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111220
					]
				},
				{
					"id": 160111220,
					"content": "Geleceğim... Bunu Barbatos'tan veya Cadılar Meclisinden zaten duymuş olabilirsin ama Barbeloth'un küresinde geleceğin bir yansımasını görmüştüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111221
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111221,
					"content": "Kuzeyde bir Hiçlik felaketi görmüştün, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111222
					]
				},
				{
					"id": 160111222,
					"content": "Evet. Ama işlerin şu anki gidişatına bakılırsa... Sanırım geleceğin seyrini değiştirdik, bir nevi senin sayende oldu bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111223
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111223,
					"content": "Yine de Favonius Şövalyeleriyle yarım kalan işleri hallettikten sonra kuzeye bir yolculuk daha yapmam gerekecek... Nod-Krai tarafında yapılacak daha çok iş var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111224
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111224,
					"content": "Ayrıca orada kalmaya gönüllü olan ilk şövalye grubu hâlâ görevde. Onları geride bırakamam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111225
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111225,
					"content": "Yaa, ne kadar asil bir düşünce... Ama Paimon'a doğruyu söyle, Nod-Krai'a geri dönmenin asıl sebebi buradaki bütün işlerini yine Jean'e yıkmak, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 160111226,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111227
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111227,
					"content": "... Bir dakika, cidden öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160111228,
						160111229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 160111228,
					"content": "Kendini savunmak için bile bir şey söylemeyecek misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111230
					]
				},
				{
					"id": 160111230,
					"content": "Haha. Dalga geçiyorum. Bundan sonra Mondstadt'ta beni daha sık göreceksiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				},
				{
					"id": 160111229,
					"content": "Öyle pişmiş kelle gibi sırıtma!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111230
					]
				},
				{
					"id": 160111231,
					"content": "Başka sorum yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160111232
					]
				},
				{
					"id": 160111232,
					"content": "Peki o zaman. Ben biraz daha burada kalıp esintinin tadını çıkaracağım... Dünyanın bütün şaraplarını içsen ne fayda, uzun süren bir gurbetten sonra hiçbir şey memleket rüzgarı gibi sarhoş edemez insanı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				}
			]
		}
	]
}