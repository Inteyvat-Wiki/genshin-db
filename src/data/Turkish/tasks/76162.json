			"dialogs": [
				{
					"id": 761000701,
					"content": "Çekilin yolumdan, kımıldayın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000702
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761000702,
					"content": "Hehe... Ne bu acele...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000703
					],
					"speakerTitle": "Canavardan Gelen Ses"
				},
				{
					"id": 761000703,
					"content": "Er ya da geç... Hepiniz öleceksiniz. Ama bazılarınız... Biraz daha erken gidecek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000704
					],
					"speakerTitle": "Canavardan Gelen Ses"
				},
				{
					"id": 761000704,
					"content": "Üç yıl önce ölmediği için sızlanıp duruyordu... Şimdi... Onun dileğini yerine getireceğim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000705
					],
					"speakerTitle": "Canavardan Gelen Ses"
				},
				{
					"id": 761000705,
					"content": "... Bjorn? Ona ne yaptın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000706
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761000706,
					"content": "Çok zayıftı... Zayıflar... İşe yaramazlar... Sürünen böcekler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000707
					],
					"speakerTitle": "Canavardan Gelen Ses"
				},
				{
					"id": 761000707,
					"content": "... Tek yapabildikleri ölmek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000708
					],
					"speakerTitle": "Canavardan Gelen Ses"
				},
				{
					"id": 761000708,
					"content": "Sakın ona hakaret etmeye kalkma! Zayıf biri değil o!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000709
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761000709,
					"content": "Ah... Senin gözünde... Güçlüydü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000710
					],
					"speakerTitle": "Canavardan Gelen Ses"
				},
				{
					"id": 761000710,
					"content": "Ama... Herkes gibi güçlü insanlar da ölür...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000711
					],
					"speakerTitle": "Canavardan Gelen Ses"
				},
				{
					"id": 761000711,
					"content": "Senin bunu... Herkesten daha iyi anladığını sanıyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000712
					],
					"speakerTitle": "Canavardan Gelen Ses"
				},
				{
					"id": 761000712,
					"content": "Senden daha güçlü olanların... Hepsi üç yıl önce öldü, değil mi? On yıl önce de aynısı olmuştu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000713
					],
					"speakerTitle": "Canavardan Gelen Ses"
				},
				{
					"id": 761000713,
					"content": "... Kapa çeneni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000714
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761000714,
					"content": "Evet... Burada zayıf olan tek kişi... Sensin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000715
					],
					"speakerTitle": "Canavardan Gelen Ses"
				},
				{
					"id": 761000715,
					"content": "Yoksa... Neden her seferinde... Her seferinde... Hayatta kalan tek kişi sen oluyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000716
					],
					"speakerTitle": "Canavardan Gelen Ses"
				},
				{
					"id": 761000716,
					"content": "... Savaş alanından kaçtın, değil mi? Hayata tutunmaya çalışan bir korkaksın sadece...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000717
					],
					"speakerTitle": "Canavardan Gelen Ses"
				},
				{
					"id": 761000717,
					"content": "Dediklerine kulak asma Illuga!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761000718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761000718,
					"content": "Yeter! Ölme vaktin geldi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761000719
					]
				},
				{
					"id": 761000719,
					"content": "#... {NICKNAME}! Hızlıca bitirelim şu işi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		},
