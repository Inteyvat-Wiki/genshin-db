			"dialogs": [
				{
					"id": 745030101,
					"content": "Hoş geldiniz değerli konuklar, yine buluştuk. Uzun zaman olmadı ama yine de sizleri biraz özledim bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030102
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745030102,
					"content": "Hıh, yağcı seni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745030103,
					"content": "Ah, vay halime, yazıklar olsun bana! Nasıl üzüldüm. Belki de işe dönsem iyi olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030104
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745030104,
					"content": "Planlanan veri toplama projesinin ikiye ayrılacağını öncelikle belirteyim. Biri Alberre tarafından yürütülecek, diğeri ise bende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030105
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745030105,
					"content": "Biz bir Düello Şampiyonunun çevikliğini modellemek istiyoruz. Bu yüzden birkaç su altı hız mücadelesi tamamlamana ihtiyacımız olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030106
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745030106,
					"content": "Hım, Düello Şampiyonlarının su altında antrenman yapması mı gerekiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745030107,
					"content": "Kim bilir? Benim Düello Şampiyonu tanıdığım yok hiç. Patronun da tanıdığını düşünmüyorum. Muhtemelen bu şekilde daha havalı olacağını düşünüyordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030108
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745030108,
					"content": "Aslında su fışkırtabilen 10 farklı su çekme mekanizması kurmak istedi ama yüksek maliyetten dolayı bu fikirden vazgeçti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030109,
						745030110
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745030109,
					"content": "Güzel fikirmiş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745030111
					]
				},
				{
					"id": 745030111,
					"content": "Ne de olsa burası su diyarı Fontaine. Eğer bu, diğer ülkelerde satılacaksa, biraz Fontaine dokunuşu gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030112
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745030112,
					"content": "Her neyse, ilgili detayları içeren bir el kitabı hazırladık. Lütfen dilediğiniz zaman göz atın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030113
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745030113,
					"content": "Gitmek için sabırsızlanıyor musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030114
					],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745030114,
					"content": "Biraz hazırlık yapayım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745030115
					]
				},
				{
					"id": 745030115,
					"content": "Sorun değil. Veri toplama cihazları zaten oraya yerleştirildi, bu yüzden onlar için endişelenmene gerek yok. Sadece mücadeleyi tamamlamaya odaklanman gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arbon"
				},
				{
					"id": 745030110,
					"content": "Bunu sadece çocuklar havalı bulur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745030111
					]
				}
			]
		}
	]
}