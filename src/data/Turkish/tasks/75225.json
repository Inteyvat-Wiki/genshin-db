				},
				{
					"id": 752250102,
					"content": "Selam yabancı savaşçı. Ne güzel gözlerin var. İçindeki azmi görebiliyorum! Ne diyeceğim, şu yuvarlanan kaya parkurunu denemek ister misin? Kurallar basit! Yuvarlanan kayaları kır ve parkurun sonuna ulaş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752250103
					],
					"speakerTitle": "Sachya"
				},
				{
