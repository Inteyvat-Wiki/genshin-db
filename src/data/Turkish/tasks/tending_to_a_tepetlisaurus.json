			"dialogs": [
				{
					"id": 250201001,
					"content": "Hah, çok teşekkürler! Ben de hemen... Ahh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201002
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250201002,
					"content": "Pardon... Topun iskeletini bağlarken yanlışlıkla parmağımı kestim de.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201003
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250201003,
					"content": "Böyle meşakkatli işleri de hiç beceremem maalesef...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201004
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250201004,
					"content": "Bir dakika bekle. Çiçek köklerini iskelete bağlayıp üstünü kumaşla kapattım mı tamamız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201005
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250201005,
					"content": "Cazcal, elini üç defa daha kesse de zorlu uğraşların ardından nihayet Yüzertopu bitirmeyi başarır...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250201006
					]
				},
				{
					"id": 250201006,
					"content": "İşte bitti! Hadi Hora'yı bulalım. Kesin yine şu ağacın dibini kazıyordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201007
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250201007,
					"content": "Önce eline pansuman yap istersen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250201008
					]
				},
				{
					"id": 250201008,
					"content": "Yok canım, alt tarafı bir çizik işte. Şu işi hallettikten sonra bir yerlerden bez bulup sararım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201009
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250201009,
					"content": "Yine bir yerlere kaybolmadan Hora'yı bulalım da önce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
			]
