					"speakerTitle": "Cazcal"
				},
				{
					"id": 250201102,
					"content": "Ben gidersem ne yapacağımı anlayıp kaçar. Senin tek başına gitmen lazım. Yüzertopu havuzun ortasına koysan yeter. Sana güveniyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250201103
					],
					"speakerTitle": "Cazcal"
				},
				{
