			"dialogs": [
				{
					"id": 250200501,
					"content": "Hırr! Rraaa, raa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200502
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200502,
					"content": "Raaa, raaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200503
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200503,
					"content": "Hora, neşeyle atlayıp Yüzertopu kapar ve havuzun içinde yuvarlanmaya başlar. Etraf su içinde kalırken Hora'nın vücudundaki tüm çamurlar da temizlenir...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250200504
					]
				},
				{
					"id": 250200504,
					"content": "Hahaha, bak sen şu kerataya. Belli ki topu sevdi, havada kaptığına göre... Böyle havuzun içinde oynayacağını düşünmezdim hiç.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200505
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200505,
					"content": "Yeterince temizlenmiş sayılır bence. Hadi geri dönelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200506
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200506,
					"content": "Raarr? Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200507
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200507,
					"content": "Beğendin mi bakalım ufaklık? O top artık senin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200508
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200508,
					"content": "Aruuuu, aruuuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200509
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200509,
					"content": "Sana banyo yaptıracağım diye akla karayı seçtim var ya... Haha, neyse artık. En azından bu sorunu da çözmüş olduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200510
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200510,
					"content": "Hırr... Rarrr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200511
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200511,
					"content": "Niye elime dokunuyorsun, ne oldu? Ha, altı üstü birkaç çizik işte canım. Canını sıkma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200512
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200512,
					"content": "*sızlanır*... Gırr, raarr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200513
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200513,
					"content": "Ne o ufaklık, bir anda yüzün düştü... Daha demin zevkten dört köşeydin! Oynamaktan yoruldun mu yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200514
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200514,
					"content": "Sana da yardımın için çok teşekkür ederim dostum. Bunları ödülün olarak kabul et. İçinde çok değerli bir şey yok, dilediğin gibi kullanabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200515
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200515,
					"content": "Raarr! Raarrrr! Raarr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200516
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200516,
