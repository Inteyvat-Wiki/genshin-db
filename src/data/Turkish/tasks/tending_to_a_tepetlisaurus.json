			"dialogs": [
				{
					"id": 250200101,
					"content": "Hora! Uslu dur oğlum, sakın kımıldama! Üstünü hızlıca bir temizleyeceğim sadece...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200102
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200102,
					"content": "*sızlanır* Raarr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200103
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200103,
					"content": "Sızlanma ama ufaklık! Hadi gel, bıcı bıcı yapalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200104
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200104,
					"content": "Bak, şurada bir havuz var. Seni bir temizleyelim, sonra geri gelip oyun oynamaya devam ederiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200105
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200105,
					"content": "Raaa, raaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200106
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250200106,
					"content": "Dur, bekle! Hayır, sakın kaçma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200107,
						250200108
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200107,
					"content": "O koşan şey neydi öyle...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200109
					]
				},
				{
					"id": 250200109,
					"content": "Kabilemizi ziyarete mi geldin? Hora'nın kusuruna bakma lütfen. Şu sıralar ele avuca sığmaz oldu, bir oraya bir buraya koşturuyor... Çok korkutmamıştır umarım seni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200110
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200110,
					"content": "Banyo yapması için ikna etmeye mi çalışıyordun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200111
					]
				},
				{
					"id": 250200111,
					"content": "İkna mı? *iç çeker* \"Yalvarıyordum\" desem daha doğru olur. Birkaç gündür hava çok yağmurlu. Ne zaman oyun oynamaya çıksa üstü başı çamur içinde geri dönüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200112
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200112,
					"content": "Kendini temizletsin diye kendimi paralıyorum ama tek derdi tüm gün koşturup oyun oynamak işte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200113
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200113,
					"content": "E ben de sıradan bir insanım sonuçta, onun hızına nasıl yetişeyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200114
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200114,
					"content": "Yemekle kandırmayı denedin mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200115
					]
				},
				{
					"id": 250200115,
					"content": "Evet, denedim ama ne yapmaya çalıştığımı anlıyor gibi sanki. Yemeğin yanında beni görünce hiç oralı bile olmuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200116
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200116,
					"content": "Bir saniye başımı çevirdim mi gizli gizli yaklaşıyor, bütün yemeği tek lokmada yutup tüyüyor... Sonra da yakala yakalayabilirsen tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200117
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200117,
					"content": "Tepetlizor sonuçta, doğası bu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200118
					]
				},
				{
					"id": 250200118,
					"content": "Orası öyle! Büyüdüğünde başıma ne çoraplar örecek kim bilir... Of, geliyorlar bana soldan soldan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200119
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200119,
					"content": "Umarım gidip Cheven'ın dükkanını falan yıkmaz... Oradaki cevherleri parçalarsa ocağıma incir ağacı diker.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200120
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200120,
					"content": "*iç çeker* En iyisi Batz'ın daha önce verdiği fikri deneyeyim ben. Bu top bir Tepetlizorun ilgisini çekmeye yeter mi ki ama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200121
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200121,
					"content": "Batz kim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200122
					]
				},
				{
					"id": 250200122,
					"content": "Kabilemizdeki Tepetlizorların bakımından sorumlu kişi. Akıllı biridir, müzikten de çok iyi anlar. İnsan, Sürüngen fark etmeksizin herkes çok sever kendisini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200123
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200123,
					"content": "Kendisine bu sorundan bahsettiğimde bana hemen \"Yüzertop\" diye bir şeyin taslağını verdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200124
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200124,
					"content": "Zamanında Mataoho'dan almış bunu, küçük Sürüngenler bayılıyormuş. Hora için de bundan yapmamı önerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200125
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200125,
					"content": "Tam malzemeleri toplamıştım, başlamaya hazırdım ki Hora yine oynamaya başladı. Bir yerinde kurt var sanki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200126
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200126,
					"content": "Denemediğim bir tek bu Yüzertop taktiği kaldı artık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200127,
						250200128
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200127,
					"content": "Benim yardım edebileceğim bir şey var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200129
					]
				},
				{
					"id": 250200129,
					"content": "Yardım etmek mi istiyorsun? Harika birisin gerçekten! Ne iyi ettin de çıktın karşıma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250200130
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200130,
					"content": "Şuradaki kutudan biraz Kor Çiçeği Kökü getirir misin? Ben de o sırada Yüzertopun iskeletini hazırlamaya başlayayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250200128,
					"content": "Yardıma ihtiyacın varsa söyle lütfen, çekinme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200129
					]
				},
				{
					"id": 250200108,
					"content": "Aman! Yere yapışıyordum az kalsın...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250200109
					]
				}
			]
		},
