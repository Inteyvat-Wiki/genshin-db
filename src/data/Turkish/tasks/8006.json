					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060506,
					"content": "Khaenri'ah'nın milli çiçeği \"Inteyvat\" bu. Bir zamanlar ülkenin dört bir yanında bu çiçekler açardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060507
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060507,
					"content": "Yalnızca iki hafta açıp sonra solan bir çiçektir. Ancak koparıp Khaenri'ah'nın dışına çıkardığınızda yaprakları büyümeyi keser ve sertleşir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060508
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060508,
					"content": "Çiçeğin yaprakları yalnızca yetiştiği toprağa geri döndüğünde yeniden yumuşamaya başlar ve nihayet toza dönüşürdü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060509
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060509,
					"content": "Inteyvat bu nedenle evinden çok uzaklarda olan bir gezgini simgeler aslında. Memleketin şefkatinin bir sembolüdür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060510
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060510,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_Twins2Male|INFO_FEMALE_PRONOUN_Twins2Female]}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060511
					]
				},
				{
					"id": 80060511,
					"content": "*şaşırır* O zaman biri bu çiçeği... Oradan mı getirmiş yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060512,
					"content": "Majesteleri... Teklif nihayet onayınızı alabildi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060513
					],
					"speakerTitle": "Hiçliğin Habercisi"
				},
				{
					"id": 80060513,
					"content": "Tüm dikkatimizi Semavi İlkelerle yüzleşmeye verdiğimiz için asıl görevimizi, yani memleketi diriltmeyi ihmal ettik.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060514
					]
				},
				{
					"id": 80060514,
					"content": "Bu kadar kararsız davranmamam gerekirdi.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060515
					]
				},
				{
					"id": 80060515,
					"content": "Cihaz neredeyse hazır. Emrinizi bekliyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060516
					],
					"speakerTitle": "Hiçliğin Habercisi"
				},
				{
					"id": 80060516,
					"content": "Başarı ihtimali nedir?",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060517
					]
				},
				{
					"id": 80060517,
					"content": "Teorik olarak yaklaşık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060518
					],
					"speakerTitle": "Hiçliğin Habercisi"
				},
				{
					"id": 80060518,
					"content": "Neyse, boş ver. İhtimal yüzde bir bile olsa yeterli...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060519
					]
				},
				{
					"id": 80060519,
					"content": "Çok uzun süredir Hiçlikte yaşıyoruz.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060520
					]
				},
				{
					"id": 80060520,
					"content": "Onlar da böyle saygınlıktan yoksun bir halde yaşamak yerine yaşam ve ölümün doğal dengesine mümkün olduğunca çabuk kavuşmak istiyorlardır şüphesiz.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060521
					]
				},
				{
					"id": 80060521,
					"content": "Artık o sözde günahların bedelini ödemek zorunda kalmamalılar.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060522
					]
				},
				{
					"id": 80060522,
					"content": "Tarikat kararınız için size şükran duyuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060523
					],
					"speakerTitle": "Hiçliğin Habercisi"
				},
				{
					"id": 80060523,
					"content": "#{F#Aether}{M#Lumine}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060524
					]
				},
				{
					"id": 80060524,
					"content": "Bir şey gördün, değil mi? Ne gördüğünü anlatabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060525
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060525,
					"content": "Evet, uzun bir süre dalıp gittin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060526,
					"content": "Gördüklerini Dainsleif'e anlatıyorsun...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80060527
					]
				},
				{
					"id": 80060527,
					"content": "İlginç. İkizler arasında özel bir bağ olduğu söylenir tabii...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060528
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060528,
					"content": "Anlattıklarına bakılırsa bir cihaz aracılığıyla laneti kaldırmaya çalışıyorlar gibi duruyor. Daha demin gördüğümüz cihaz o olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060529
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060529,
					"content": "Bir de... Kardeşinin \"memleketi diriltmek\"ten bahsettiğini söyledin, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060530,
						80060531
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060530,
					"content": "Evet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060532
					]
				},
				{
					"id": 80060532,
					"content": "Şaşırmadım doğrusu. Her zamanki gibi inatçı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060533
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060533,
					"content": "Görünüşe göre Hiçlik Tarikatı bu yeri kullanarak dağ yabanilerinin üzerindeki laneti kaldırmayı planlıyor. Hepsi eski haline geri dönecek... Böylece Khaenri'ah ulusunun dirilişi de başlamış olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060534
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060534,
					"content": "Sonuçta bir ulus, halkı olmadan var olamaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060535,
						80060536
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060535,
					"content": "Ne düşünüyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060537
					]
				},
				{
					"id": 80060537,
					"content": "Eh, bence saçmalık ötesi bir plan. Başarılı olma ihtimalleri sıfır. Yüzde birlik bir ihtimal bile söz konusu değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060538
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060538,
					"content": "Daha önce de dediğim gibi bu laneti benden daha iyi kimse anlamayaz. 500 senedir bu lanetle yaşıyorum... Kurtuluş imkanı yok. Laneti kaldırmak mümkün değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060539
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060539,
					"content": "Zorla kaldırmaya çalışmak ise yalnızca daha fazla acıya neden olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060540
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060540,
					"content": "O yüzden iyice anlaman ve kendine hatırlatman gereken bir şey var: Onlar artık insan değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060541
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060541,
					"content": "Eğer boş yere ümitlenip duygularına hakim olamazsan yokuş aşağı gidersin... Sonunda sen de tıpkı onlar gibi olur, ikiyüzlülüğün içinde boğulursun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060542
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060542,
					"content": "Gücünü, kurtarmaya değecek şeylere sakla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060543
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060543,
					"content": "Sana inanmam için bir sebep söyle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060544
					]
				},
				{
					"id": 80060544,
					"content": "Ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060545
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060545,
					"content": "Haha... Doğru tabii. Ben bir görev için tuttuğun biriyim sadece. O ise kardeşin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060546
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060546,
					"content": "Onun tarafını tutman çok normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060547
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060547,
					"content": "Ancak senin verdiğin karar beni kendiminkinden vazgeçiremez. Benim seçtiğim yolun sonunda Hiçliği durdurmak var. Bir çıkmaza girdiysek belki de bu noktada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060548
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060548,
					"content": "Sana inanmayı seçiyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060549,
						80060550
					]
				},
				{
					"id": 80060549,
					"content": "Yine de bu sana tamamen güvendiğim anlamına gelmiyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060551
					]
				},
				{
					"id": 80060551,
					"content": "Anlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060552,
						80060553
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060552,
					"content": "Bir yanda %1 ihtimalle kurtuluş...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060554,
						80060555
					]
				},
				{
					"id": 80060554,
					"content": "Kimsenin başka bir canlı adına...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060556,
						80060557
					]
				},
				{
					"id": 80060556,
					"content": "Hem bu dağ yabanileri çoktan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060558
					]
				},
				{
					"id": 80060558,
					"content": "İlk karşılaştığımızda sana sorduğum üç soru işe yaramış anlaşılan. Artık bu dünyaya kendine has bir bakış açın var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060559
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060559,
					"content": "Güzel. Sen bu konu hakkındaki gerçek düşüncelerini paylaştığına göre ben de kendiminkileri senden gizlemeyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060560
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060560,
					"content": "Şu an Hiçliği durdurmaktan daha önemli bir hedefim var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060561
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060561,
					"content": "Hiçliğin buradaki faaliyetleri Halfdan'ın ve diğer Khaenri'ahlıların son dileklerine bir hakaret. Bunun gerçekleşmesine göz yumamam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060562,
						80060563
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060562,
					"content": "Anlıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060564
					]
				},
				{
					"id": 80060564,
					"content": "Hiçlik Tarikatı her an ortaya çıkabilir. İlerlerken gözünüzü dört açın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060563,
					"content": "O halde beraber hareket edelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060564
					]
				},
				{
					"id": 80060557,
					"content": "... Arzuladıkları sonu seçmişler bile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060558
					]
				},
				{
					"id": 80060555,
					"content": "... Böyle bir seçim yapma hakkı yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060556,
						80060557
					]
				},
				{
					"id": 80060553,
					"content": "... Diğer yanda %99 ihtimalle ızdırap ve ölüm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060554,
						80060555
					]
				},
				{
					"id": 80060550,
					"content": "Sadece kardeşimin yöntemlerini uygun bulmuyorum, hepsi bu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060551
					]
				},
				{
					"id": 80060536,
					"content": "Sence hiç umut var mı peki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060537
					]
				},
				{
					"id": 80060531,
					"content": "Dediğine göre bu onun göreviymiş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060532
					]
				},
				{
					"id": 80060504,
					"content": "Bu çiçeği daha önce gördüm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060505
					]
				}
			]
		}
	]
}