			"dialogs": [
				{
					"id": 80060401,
					"content": "Ufak bir dağ yabanisi kampı varmış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060402,
					"content": "Buradaki dağ yabanilerinin durumu hiç iyi görünmüyor. Galiba bazıları çoktan... Son nefesini vermiş bile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060403,
					"content": "Halfdan bize bunu mu göstermek istiyordu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060404,
					"content": "Fark etmez. Buradaki her şey dikkatlice araştırmaya değer. Bölgeyi inceleyelim. Her taşın altına bakın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				}
			]
		},
		{
			"id": 800605,
			"completionStepIds": [
				800605,
