				{
					"id": 80060601,
					"content": "Baş aşağı duran şehir buradan da görülüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060602,
					"content": "Durun... Dikkat edin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060603
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060603,
					"content": "Aaaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060604,
					"content": "N-Neler oluyor? O ışık ortadaki odadan mı geliyor? Of, çok parlak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80060605,
					"content": "Mutasyon devam ediyor... Hiçlik çoktan harekete geçti mi yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060606
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060606,
					"content": "Dainsleif... Görüyorum ki işimize burnunu sokmaktan bıkmamışsın. Üstelik yine Majestelerinin kardeşiyle berabersin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060607
					],
					"speakerTitle": "Hiçliğin Habercisi"
				},
				{
					"id": 80060607,
					"content": "Ne yazık ki ağdan çıkışını engellemeye zamanında yetişemedim... Seni getire getire buraya getirmiş. Ne feci bir hata.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060608
					],
					"speakerTitle": "Hiçliğin Habercisi"
				},
				{
					"id": 80060608,
					"content": "Hah! Karşıma çıkmaya cüret edebilmene bile şaşırdım doğrusu. Geçen sefer korkağın teki gibi kaçmıştın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060609
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060609,
					"content": "Majestelerinin isteği yerine getirilmeli. Bedeli ne olursa olsun... Yolumuza çıkan her şey yok edilmeli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060610
					],
					"speakerTitle": "Hiçliğin Habercisi"
				},
				{
					"id": 80060610,
					"content": "Bu defa... Halkımıza eziyet çektiren bu lanet artık sonsuza dek kalkmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060611
					],
					"speakerTitle": "Hiçliğin Habercisi"
				},
				{
					"id": 80060611,
					"content": "Onlara eziyet çektiren bir tek sizsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060612
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060612,
					"content": "O dağ yabanilerinin içinde lanet dışında bir şey kalmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060613
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060613,
					"content": "İstediğini söyleyebilirsin. Ben hiçbir yere gitmiyorum Dainsleif.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060614
					],
					"speakerTitle": "Hiçliğin Habercisi"
				},
				{
					"id": 80060614,
					"content": "Kaçınılmaz bir sonu ertelemek için canını vereceksin, öyle mi? Ne kadar gülünç. Yine de madem direnmeye kararlısın, öyle olsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				}
			]
		},
