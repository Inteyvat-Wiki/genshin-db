				},
				{
					"id": 80060802,
					"content": "Durup kutlayacak vaktimiz yok. Hiçlik Tarikatının cihazı etkinleşmeye başladı fakat yok etmek için hâlâ zamanımız var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060803
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80060803,
					"content": "Pekala! Hadi gidelim!",
