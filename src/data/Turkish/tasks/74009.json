			"dialogs": [
				{
					"id": 740090301,
					"content": "Açıklamama izin verin lütfen... Her şeyi yanlış anladınız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090302
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090302,
					"content": "Sonny Bey... Bu işe girmemizin tek sebebi biraz Mora kazanmaktı, üstlerimiz de anlaşmaya varamadığı için biz... Önce parayı kazanıp kazancımızı onlarla paylaşmayı düşünmüştük, evet aynen bu şekilde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090303
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090303,
					"content": "Of, Paimon'u hiç takmadı bile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090304,
					"content": "Örgüte karşı bir hiçbir şikayetim yok... Ah doğru ya, bir de o serserilerin oyununa geldim! Yoksa bu kadar aptalca bir şey yapmazdım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090305
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090305,
					"content": "#Etkileyici, gerçekten etkileyici. {NICKNAME}, hakkındaki hikayelerdeki kadar güçlüymüşsün. Sence de öyle değil mi Luca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090306
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090306,
					"content": "Çok güçlü. İnanılmaz derecede dayanıklı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090307
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090307,
					"content": "Lütfen, birlikte geçirdiğimiz onca zamanın hatırına... Sonny Bey... Luca Bey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090308
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090308,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090309
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090309,
					"content": "Of! Lütfen, yapmayın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090310
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090310,
					"content": "Luca, misafirlerimiz hâlâ burada. Onlar gitmeden onların moralini bozacak bir şey yapmayalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090311
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090311,
					"content": "Anlaşıldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090312
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090312,
					"content": "Hıh! Şimdi hatanı anladın mı Virgil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090313,
					"content": "Of, evet anladım, hepsi benim hatamdı... Lütfen merhamet gösterin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090314
					],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090314,
					"content": "Peki, en azından hatanı kabul ettin. Bunu bir daha sakın yapayım deme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090315,
					"content": "#Sevgili Virgil bir daha asla böyle bir şey yapmayacak. Paimon, {NICKNAME}, size Beyaz Eldiven Sonny olarak onurum, ayrıca babam ve oğlum üzerine yemin ederim ki bundan emin olabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090316,
						740090317
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090316,
					"content": "Hadi gidelim Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090320
					]
				},
				{
					"id": 740090320,
					"content": "Hah şöyle! Çok teşekkür ederiz Sonny, Luca. Meğerse Fontaine'de iyi insanlar, kötülerden fazlaymış!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090321,
					"content": "#Sevgili Paimon, {M#saygıdeğer beyefendi}{F#güzel hanımefendi}, elveda. Umarım gelecekte tekrar birlikte çalışırız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090322
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090322,
					"content": "Aaah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Virgil"
				},
				{
					"id": 740090317,
					"content": "Şimdi ne yapacaksınız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090318
					]
				},
				{
					"id": 740090318,
					"content": "#Hayat her şeyi anladığın zaman çok sıkıcı olabilir, doğru değil mi {M#bayım}{F#güzel hanımefendi}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090319
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090319,
					"content": "Yine de bilmek istiyorsanız onunla... Uzun ve çok ciddi iki çift laf edeceğiz. Ancak sizin daha fazla vaktinizi almak istemiyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090320
					],
					"speakerTitle": "Sonny"
				}
			]
		},
