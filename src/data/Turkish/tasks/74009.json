				]
			},
			"dialogs": [
				{
					"id": 740090101,
					"content": "Şu tesadüfe bir bak sevgili Luca, sence de çok şanslı değil miyiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090102
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090102,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090103
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090103,
					"content": "Siz kimsiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090104,
					"content": "Pardon. Kendimi tanıtmadan doğrudan muhabbete girmeye çalıştım. Ben Sonny, bazıları bana \"Beyaz Eldiven\" der. Arkadaşım da Balıkçı Luca. Bazı mecralarda çok ünlüdür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090105
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090105,
					"content": "Aa, merhaba! Paimon da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090106,
					"content": "#Kendinizi tanıtmanıza gerek yok. Sizin Paimon olduğunuzu ve sarışın gezginin de {NICKNAME} olduğunu biliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090107
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090107,
					"content": "Hı? Kim olduğumuzu biliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090108,
					"content": "Elbette biliyorum! Daha önce Başyargıcı nasıl biliyorsam sizi de öyle biliyordum. Yani sizi biliyordum ama siz beni bilmiyordunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090109
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090109,
					"content": "Şanınız ve başarılarınızdan dolayı Fontaine'e gelişinizin haberinin bize ulaşması an meseleydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090110
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090110,
					"content": "O kadar ünlü müyüz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090111
					]
				},
				{
					"id": 740090111,
					"content": "Ah ne kadar da alçak gönüllüsünüz. Nasıl desem ki? Hımm, bazı kişiler için sizin Fontaine'e gelişiniz, Epiclese Opera Salonunun sahnesine konulan bir bomba gibidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090112
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090112,
					"content": "Elbette bunu iyi bir anlamda söylüyorum. Sence de öyle değil mi canım Luca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090113
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090113,
					"content": "Şey, bir bombanın patlaması nasıl iyi bir şey olabilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090114,
					"content": "Hımm... Kelimelerle aram pek iyi değil. Kendimi nasıl anlatsam canım Luca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090115
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090115,
					"content": "Lyney ve Lynette'in sihir gösterisi gibi. İmkansızı başarmak için her şeyi havaya uçurmak gibi. Tüyler ürpertici bir deneyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090116
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090116,
					"content": "Aynen! Gördün mü? Ben bunu kırk yıl düşünsem böyle anlatamazdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090117
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090117,
					"content": "M-Madem öyle diyorsunuz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090118,
					"content": "Sana neden \"Beyaz Eldiven\" diyorlar peki? Paimon eldiven falan taktığını görmüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090119,
					"content": "Of, şimdi zor bir soru sordunuz işte. Bunu nasıl açıklasam ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090120
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090120,
					"content": "Bir tane beyaz eldiven taktığınızı hayal edin. Elinize kirli bir şey geçerse bu eldivende kara bir leke bırakır. Benim görevim... Bu kara lekeyi bulup ortadan kaldırmaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090121
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090121,
					"content": "Hımm... Yani bir tür temizlikçi falan mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090122,
					"content": "Aynen sevgili Paimon! Gördün mü? Ben senin yaptığın gibi işimi özetleyemezdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090123
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090123,
					"content": "Aaa, Fontaine Şehri sokaklarının hep temiz ve düzenli olmasının sebebi sizin gibi insanlar yani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090124,
					"content": "Hahaha, işte bunu duyduğuma sevindim! Evet, öyle de diyebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090125
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090125,
					"content": "Tamam, Paimon şimdi ne iş yaptığınızı anladı ama... Bir temizlikçinin bıçağa neden ihtiyacı olur ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090126,
					"content": "Bu bir tür iş aleti olarak düşünebilirsiniz. Bazı inatçı kirleri çıkarırken çok işimize yararlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090127
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090127,
					"content": "Anladım, teşekkürler! Peki... Arkadaşın Luca, balık tutmakta çok iyi olduğu için mi \"Balıkçı Luca\" olarak biliniyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090128,
					"content": "Hımm... Aslında bu hikayenin sadece çok küçük bir kısmı. Fontaine'de türlü türlü balık vardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090129
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090129,
					"content": "Ve Luca da insanlara çeşitli balıklarla nasıl zaman geçirebileceklerini öğretmekte oldukça tecrübelidir. Doğru mu sevgili Luca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090130
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090130,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090131
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090131,
					"content": "Hı? Paimon anlamadı... Eğer öyleyse neden...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090132,
					"content": "Zor ve iyi sorular sormakta oldukça iyi olduğunuzu söylemeliyim sevgili Paimon. Sohbet edecek daha fazla vaktimiz olsaydı seve seve tüm sorularınıza tatmin edici bir şekilde cevap verirdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090133,
						740090135
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090133,
					"content": "Soru sormayı bırakabilirsin Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090134
					]
				},
				{
					"id": 740090134,
					"content": "Ha? Peki... Sonny, Luca bizden istediğiniz bir şey var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090136,
					"content": "Dalmak bizi çok heyecanlandırır. Fontaine'in suları doğa ve atalarımız tarafından bırakılmış zenginliklerle dolu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090137
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090137,
					"content": "Yakın zamanda bir arkadaş edindiğinizi ve onunla dalmaya gittiğinizi duyduk. O kadar güçlüsünüz ki dalış ekipmanına bile ihtiyacınız olmamış, doğru mu söylüyorum sevgili Luca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090138
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090138,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090139
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090139,
					"content": "Virgil'i soruyorsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090140
					]
				},
				{
					"id": 740090140,
					"content": "Evet. Virgil'i sormak istemiştik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090141
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090141,
					"content": "Virgil... Yalancı ve hainin teki! Of, onun adını duymak bile Paimon'u kızdırmaya yetti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090142,
					"content": "Virgil ile yaşadıklarınızı Beyaz Eldiven Sonny ve Balıkçı Luca ile paylaşıyorsunuz.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740090143
					]
				},
				{
					"id": 740090143,
					"content": "... Anladım. Tüm bunları bize anlattığınız için teşekkür ederiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090144
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090144,
					"content": "Rica ederiz! Hıh, Paimon o adamı aklından hiç çıkarmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090145,
					"content": "Elbette tüm hikayeyi bizimle paylaştığınız için çok müteşekkiriz. Ancak bizi asıl mutlu eden şey, Virgil'i arkadaşınız olarak görmüyor oluşunuz. Eğer tersi olsaydı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090146
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090146,
					"content": "Şöyle desem daha iyi olabilir, onu arkadaşınız olarak görseydiniz bu sohbet çok tuhaf bir hal alırdı. Öyle değil mi sevgili Luca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090147
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090147,
					"content": "İşleri zorlaştırabilirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090148
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090148,
					"content": "Evet evet. Çok teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090149
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090149,
					"content": "Neden bahsediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090150
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090150,
					"content": "Onlar Virgil'in düşmanları.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090151
					]
				},
				{
					"id": 740090151,
					"content": "Ay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090152,
					"content": "#Sözleriniz beni derinden üzdü {M#sevgili beyefendi}{F#güzel hanımefendi}. Benim birçok arkadaşım vardır ama bir tane bile düşmanım yoktur. Virgil da arkadaşlarımdan biri, hazır sevgili Virgil'dan söz açılmışken...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090153
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090153,
					"content": "#Bence artık onunla ciddi bir şekilde \"konuşmanın\" zamanı geldi. Ne dediğimi anlamışsınızdır, değil mi sevgili {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090154
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090154,
					"content": "Bu şekilde size yaptıklarının bedelini ona ödetebiliriz. Saygıdeğer misafirlerimiz için en azından bunu yapabiliriz, sence de öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090155
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090155,
					"content": "Şey, Paimon'un kafası karıştı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090156,
						740090158
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090156,
					"content": "O Beyaz Eldiven. Tek bilmen gereken şey bu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090157
					]
				},
				{
					"id": 740090157,
					"content": "Şey... Peki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090160
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090160,
					"content": "Virgil ve arkadaşlarının merkezini bulduk. Orada buluşmaya ne dersiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090161,
						740090165
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090161,
					"content": "Neden bizim de oraya gitmemiz gerekiyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090162
					]
				},
				{
					"id": 740090162,
					"content": "#{M#Bayım}{F#Güzel hanımefendi}! Virgil size bu kadar ihanet etmişken ne yapacağımız konusunda bilginiz olmadan... Onunla konuşamayız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090163
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090163,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090164
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090164,
					"content": "Bakın, Luca da bana katılıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090166
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090166,
					"content": "Hıh! Paimon da Virgil ile bir konuşmak istiyor! Bizden düzgün bir şekilde özür dilemesi lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090167
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090167,
					"content": "Hahaha, çok tatlısınız. O halde belirlediğimiz yerde görüşürüz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090165,
					"content": "Tamam o zaman. Hadi gidelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090166
					]
				},
				{
					"id": 740090158,
					"content": "Her şeyi anlayamamak bir suç değildir Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090159
					]
				},
				{
					"id": 740090159,
					"content": "#Hayat her şeyi anladığın zaman çok sıkıcı olabilir, doğru değil mi {M#bayım}{F#güzel hanımefendi}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090160
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090135,
					"content": "Yardımcı olabileceğimiz bir şey var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740090136
					]
				}
			]
		},
