			"dialogs": [
				{
					"id": 740090201,
					"content": "#Sevgili Paimon, {M#saygıdeğer beyefendi}{F#güzel hanımefendi}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090202
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090202,
					"content": "Burası Virgil'in son zamanlarda kullandığı üs.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090203
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090203,
					"content": "Böyle işe... Virgil hâlâ neden dönmedi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090204
					],
					"speakerTitle": "Kötü Görünümlü Biri"
				},
				{
					"id": 740090204,
					"content": "Bizi böyle bekletmeye devam edecekse... Kendimi... Bu Sinthe'i kullanmaktan alıkoyamayacağım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090205
					],
					"speakerTitle": "Tehlikeli Görünümlü Biri"
				},
				{
					"id": 740090205,
					"content": "Kendine gel! Bu sevkiyatı hazırlamak için çok çaba sarf ettik. Virgil'in izni olmadan bu malları kullanırsan sana asla merhamet etmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090206
					],
					"speakerTitle": "Güvenilmez Görünümlü Biri"
				},
				{
					"id": 740090206,
					"content": "Ne yazık. Görünüşe göre sevgili arkadaşım Virgil henüz üssüne geri dönmemiş. Gerçi bu arkadaşlarla da bir konuşabiliriz, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090207
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090207,
					"content": "Of ama bu adamlar pek konuşmak isteyecekmiş gibi görünmüyorlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090208,
					"content": "Hımm, belki fikirlerini değiştirebiliriz. Sen ne düşünüyorsun sevgili Luca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090209
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090209,
					"content": "Bence de.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090210
					],
					"speakerTitle": "Luca"
				},
				{
					"id": 740090210,
					"content": "Hey! Bir sorun çıkarmayacaklarından emin misin? Paimon onların sizi direkt döveceğini düşünüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740090211,
					"content": "Olamaz! Ben hayatımda bu kadar düşünceli birini görmedim Paimon. Böyle bir şey elbette çok kötü olurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740090212
					],
					"speakerTitle": "Sonny"
				},
				{
					"id": 740090212,
					"content": "... Onlar için tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sonny"
				}
			]
		},
