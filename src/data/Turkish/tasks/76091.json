					"???"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760910203,
					"content": "Bulduğun not defterini ve sayfaları teslim ediyorsun...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760910204
					]
				},
				{
					"id": 760910204,
					"content": "Bir bakayım... Evet! Bunlar benim notlarım. Çok teşekkür ederim! Burada Fatui'nin suçlarına dair bir sürü kanıt var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910205
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910205,
					"content": "... Suçları mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760910206,
					"content": "Paha Adası'nda inşa ettikleri tüm o tesislere ve getirdikleri mekanik cihazlara bir bakın... O bölge eskiden birçok hayvanın yuvasıydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910207
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910207,
					"content": "Az önce Bordo Havzası'ndan döndüm, göletteki tüm denizanaları ölmek üzere. Muhtemelen Fatui'nin makinalarından kaynaklanıyor... Bunu herkese duyurmak zorundayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910208
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910208,
					"content": "Hı? Valyemiş Jölesi ve diğerlerinden mi bahsediyorsun? Ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760910209,
					"content": "Ona Bordo Havzası'nda olanları anlatıyorsunuz...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760910210
					]
				},
				{
					"id": 760910210,
					"content": "Demek artık çok geç... Yine de bunların kayda geçmesi gerekiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910211
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910211,
					"content": "Notları şimdilik size bırakıyorum. Bir an önce geri dönüp öğrendiklerimi sıraya koymam gerek, sonra da bunları makaleye dönüştüreceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910213
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910213,
					"content": "Ha, bir de başkalarına anlatırsanız bunu Semyon'dan duyduğunuzu söylemeyi unutmayın. Ne de olsa bunları yazıya döküp gazetede yayımlatmam biraz zaman alacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910214
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910214,
					"content": "Neyse, çok sağ olun! Görüşürüz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				}
			]
		},
