				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760910101,
					"content": "Uçan bir Fey! Notlarım... Fatui önemli notlarımı çaldı! Onları geri almama yardım eder misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910102
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910102,
					"content": "Şey, Paimon Fey sayılmaz aslında... Ama dediğini hemen halledebiliriz! Fatui bir çocuğun notlarını ne diye almış olabilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760910103,
					"content": "Belki de yazanları herkese göstereceğimden korkuyorlardır... Notlarımı geri almama yardım ederseniz sırlarını size açıklarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910105
					],
					"speakerTitle": "???"
				},
				{
					"id": 760910105,
					"content": "Bunları daha sonra konuşabiliriz. Önce lütfen <color=#00E1FFFF>notlarımı</color> geri almama yardım et. Bazı <color=#00E1FFFF>sayfalar</color> da etrafa saçılmış olabilir... Muhtemelen Fatui'nin oradadırlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				}
			]
		},
