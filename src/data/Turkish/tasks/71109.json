			"dialogs": [
				{
					"id": 711090201,
					"content": "Vay be, bu mahvolmuş Konakta ne de büyük bir sır saklıymış meğer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090202,
						711090203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090202,
					"content": "Ben de şaşırdım açıkçası.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090204
					]
				},
				{
					"id": 711090204,
					"content": "Paimon'a sorarsan bu yerden Üçüncü Huang'ın da haberi yoktur... Bir dakika! Burası efsanelerde bahsedilen şu \"Guhua Hazine Odası\" olabilir mi acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090205,
					"content": "#{NICKNAME}, şuraya baksana! Paimon platformun üstünde parıldayan bir şey olduğunu fark etti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090206,
						711090207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090206,
					"content": "Hazinedir kesin!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090208
					]
				},
				{
					"id": 711090208,
					"content": "Neyse, hadi hemen gidip bakalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090207,
					"content": "Bir mekanizma falan mı bu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090208
					]
				},
				{
					"id": 711090203,
					"content": "Eh, boşuna dememişler görünüşe aldanmamak lazım diye...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090204
					]
				}
			]
		},
		{
			"id": 7110905,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
