			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711090501,
					"content": "\"... Gökler sadakatsiz, onun lütfuna ulaşan az. Kader vefasız, refah içinde olan az... İyilerin bile yolları kapanır, iyi olmayanlar içinse daha kötüleri vardır...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090502
					],
					"speakerTitle": "Yazıt"
				},
				{
					"id": 711090502,
					"content": "\"... Bu anıt gelecek nesillere şu soruyu sormak için bırakıldı. Çıkmaza girdiğinde ne yapacaksın?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090503,
						711090504
					],
					"speakerTitle": "Yazıt"
				},
				{
					"id": 711090503,
					"content": "(Taş tablete dokun.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 711090504,
					"content": "(Ayrıl.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
