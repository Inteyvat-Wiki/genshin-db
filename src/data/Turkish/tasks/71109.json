				]
			},
			"dialogs": [
				{
					"id": 711090601,
					"content": "Hı? Bu kılıcın üzerinde bir şeyler yazıyor. Paimon bir baksın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090602,
					"content": "\"... Kılıcımla söylerken şarkımı, biçerim ejderleri içerim kanlarını. Kutsal ışık yıldırım gibi parlar, buzdan dalgalar gibi keskin kılıcım parçalar dağları...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090603
					],
					"speakerTitle": "Kadim Kılıç Ustası Yazıtı"
				},
				{
					"id": 711090603,
					"content": "\"... Tianheng Dağı'nın yamacında kaplanlar, giderim Bulut Denizi'ne pullu canavarları avlamaya... Bekleyin beni, başımda zafer tacı ile döneceğim huzur içinde yaşamaya...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090604
					],
					"speakerTitle": "Kadim Kılıç Ustası Yazıtı"
				},
				{
					"id": 711090604,
					"content": "Yanında da bir taş tablet var... Hım? Alttaki el yazısı farklı görünüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090605,
					"content": "\"... Aslında niyetim burada lezzetli yemekler bırakmaktı. Ama yemek zamanla bozuluyor ister istemez, ben de pişirirsiniz diye yemek tarifi bıraktım. Emin olun çok lezzetli yemekler.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090606
					],
					"speakerTitle": "Kadim İşleme"
				},
				{
					"id": 711090606,
					"content": "\"... Bunların haricinde bir şey kalmadı. Bir bu kılıç, bir de güzel manzara.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090607
					],
					"speakerTitle": "Kadim İşleme"
				},
				{
					"id": 711090607,
					"content": "\"... Çıkmaza girince ne yapmak gerekir? Cevabı sende var zaten.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090608
					],
					"speakerTitle": "Kadim İşleme"
				},
				{
					"id": 711090608,
					"content": "\"... Hazineyi... alma, yalnızca bir tane var... Bundan böyle...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090609
					],
					"speakerTitle": "Yamuk İşleme"
				},
				{
					"id": 711090609,
					"content": "Son nefesim bile... Onurlu olsun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090610
					],
					"speakerTitle": "Yamuk İşleme"
				},
				{
					"id": 711090610,
					"content": "Ay... Bu yazılar öyle okunaksız ki Paimon bir şey bile anlamadı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090611,
						711090612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090611,
					"content": "Yani yanına hiçbir şey almadığını söylemiş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090613
					]
				},
				{
					"id": 711090613,
					"content": "*ağlar* Bunca şeyden sonra bir tane bile değerli hazine bulamadık. Tüm umutlar boşaymış resmen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090614,
						711090615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090614,
					"content": "Bir de bana sor!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090617
					]
				},
				{
					"id": 711090617,
					"content": "Paimon böyle sıkıntılı bir durumdayken böylesine güzel bir manzara görmeyi de beklemiyordu hiç... Yani bu da bir şeydir, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090615,
					"content": "Tamam, sorun yok. Ben sana yiyecek bir şeyler hazırlarım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090616
					]
				},
				{
					"id": 711090616,
					"content": "#Hı? Cidden mi? Tamam o zaman, anlaştık {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711090617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711090612,
					"content": "Ben de anlamadım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711090613
					]
				}
			]
		},
