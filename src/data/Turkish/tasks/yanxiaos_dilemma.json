					"Güleç Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220030101,
					"content": "Hıh... Bunca zamandır benden geçiniyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030102
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 220030102,
					"content": "Ne yapıyorsunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030103
					]
				},
				{
					"id": 220030103,
					"content": "Hak etmeyen biri için yemek yapıyorum, ne olsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030104
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 220030104,
					"content": "İnanamıyorum ya! Beyefendi canı ne isterse onu yapıyor. Handa yardım edilecek bir şey var mı diye sormuyor bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030105
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 220030105,
					"content": "Günün çoğunu balık tutarak geçiriyor ama üç beş küçük balıktan başka bir şey tuttuğunu da görmedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030106
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 220030106,
					"content": "Ben olmasaydım şimdiye açlıktan ölmüştü!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030107
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 220030107,
					"content": "Öf, ne diye söyleniyorum ki. Beni duyamıyor. Duysa bile duymazlıktan gelirdi zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030108
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 220030108,
					"content": "Yapacak daha önemli bir işin yoksa bana birkaç malzeme getirebilirsin. Elimdekiler bitmek üzere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030109
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 220030109,
					"content": "Çok bir şey lazım değil. Bir tane <color=#00E1FFFF>Jueyun Biberi</color>, bir tane de <color=#00E1FFFF>Nilüfer Başı</color> yeterli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030110,
						220030112
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 220030110,
					"content": "Tamam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030111
					]
				},
				{
					"id": 220030111,
					"content": "Bulur bulmaz getiriver. Şu yemeği çabucak bitirip kurtulmak istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 220030112,
					"content": "Ama burada bir sürü malzeme var...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030113
					]
				},
				{
					"id": 220030113,
					"content": "Patronum bunlara sağlam para ödedi. Sence bu beleşçi, patronuma bir şey ödeyecek mi? Hiç sanmam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030114
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 220030114,
					"content": "Ona yaptığım her yemeğin parası benim cebimden çıkıyor... Peh, bana olan borcu kabarık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030115
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 220030115,
					"content": "Sebzeleri getirebilir misin? Zahmetli bir iş değil, çok zamanını da almaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Güleç Yanxiao"
				}
			]
		},
