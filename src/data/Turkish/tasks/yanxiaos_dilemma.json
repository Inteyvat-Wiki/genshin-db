					"Güleç Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220030401,
					"content": "Ha bir de fazla oyalanma! Mutlu bir beleşçi aç bir beleşçiden iyidir, emin ol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030402
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 220030402,
					"content": "Neden ona yemek yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030403
					]
				},
				{
					"id": 220030403,
					"content": "Çok merak ediyorsan söyleyeyim, benden başka kimsesi yok. Liyue'de tanıdığı tek kişi benim. Otlanmaya cesaret edebildiği tek yer de burası.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030404
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 220030404,
					"content": "Neden mi? Niye mi önemsiyorum? İyi tamam... Ona yemek yapmak istiyorum çünkü. Başın göğe erdi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030405
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 220030405,
					"content": "Ona yemek yapıyor olmasaydım muhtemelen yine gidip Dihua Bataklığı'nda saçma sapan bir şey yapardı. Böyle bir şeye göz yumamayız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030406
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 220030406,
					"content": "Ne diye bekliyorsun hâlâ? Oyalanmayı bırak da götür şu yemeği!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Güleç Yanxiao"
				}
			]
		},
