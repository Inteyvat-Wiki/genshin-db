			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Güleç Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220030301,
					"content": "Burada bekle. Yemek hazır olunca ona götürürsün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030302
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 220030302,
					"content": "Somurtma! Beleşe yaptırmıyorum bunu sana. Hak ettiğini alacaksın, merak etme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030303
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 220030303,
					"content": "Evet. Yemek hazır. Al bunu Ne Kadar Şanslı Olduğunu Bilmeyen Beyefendiye götür bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030304
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 220030304,
					"content": "Adı <color=#00E1FFFF>Jiangxue</color>. Su kenarında balık tutuyordur, gidince görürsün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030305
					],
					"speakerTitle": "Güleç Yanxiao"
				}
			]
		},
		{
			"id": 2200304,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
