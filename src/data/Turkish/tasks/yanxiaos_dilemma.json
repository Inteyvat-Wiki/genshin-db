					"Güleç Yanxiao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220030601,
					"content": "Yemeği götürdün mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030602
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 220030602,
					"content": "Evet, çok teş...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030603
					]
				},
				{
					"id": 220030603,
					"content": "Teşekkür ettiğini mi söyledi? Aman. Bıraksın masal anlatmayı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030604
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 220030604,
					"content": "Geçtiğimiz yıllarda bu sözleri o kadar çok duydum ki... Kafayı yiyorum artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030605
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 220030605,
					"content": "Balık tutmak dışında tek eğlencesi bana teşekkür etmek. Bak ne diyeceğim, eşyalarını topla gel, bu handa çalış, paranı kazan. Ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030606
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 220030606,
					"content": "Of, neyse, söylenmenin kimseye bir faydası yok. Al, ödülünü vereyim. Başkalarının aksine bunu hak ettin. Şimdi hayatına geri dönebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Güleç Yanxiao"
				}
			]
		},
		{
			"id": 2200307,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
