			},
			"dialogs": [
				{
					"id": 220030701,
					"content": "Hâlâ burada mısın? Dönsen iyi olur. Beklediği her saniye sinirden kudurma ihtimali artıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030702
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220030702,
					"content": "Neden sana yemek yapıyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030703
					]
				},
				{
					"id": 220030703,
					"content": "Biz... Arkadaşız. Çok uzun zamandır tanışıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030704
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220030704,
					"content": "Ben, şey... Bir keresinde Dihua Bataklığı'na gitmiştim... Kötü bir şey yapmak için. Ama yapmam gerekiyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030705
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220030705,
					"content": "Koskoca Liyue'de kalmama izin veren tek yer burası, şefi de karnımı doyuruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030706
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220030706,
					"content": "Daha fazla ayrıntı vermeyeceğim... Bu zaten uzun bir hikaye. Eminim yapacak daha iyi işlerin vardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030707
					],
					"speakerTitle": "Jiangxue"
				},
				{
					"id": 220030707,
					"content": "Daha fazla zamanını almayayım... Şef pek sabırlı biri değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiangxue"
				}
			]
		}
	]
