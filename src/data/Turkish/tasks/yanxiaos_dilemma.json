			"dialogs": [
				{
					"id": 220030201,
					"content": "Geldi mi sebzelerim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220030202,
						220030203
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 220030202,
					"content": "Getirdim, buyur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220030203,
					"content": "Henüz getirmedim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220030204
					]
				},
				{
					"id": 220030204,
					"content": "Niye? Git getir hadi! Yoksa o oksijen israfı artık aç bir oksijen israfı olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Güleç Yanxiao"
				}
			]
		},
		{
