					"Zhaoqin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715120101,
					"content": "Burası... Temizlendi mi? Ha? Çoktan temizlenmiş olmalı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120102
					],
					"speakerTitle": "Zhaoqin"
				},
				{
					"id": 715120102,
					"content": "Of, ne can sıkıcı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120103
					],
					"speakerTitle": "Zhaoqin"
				},
				{
					"id": 715120103,
					"content": "Aa... Sen... Gezginsin! Kusura bakma çok yoğundum. Geldiğini fark etmedim bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120104
					],
					"speakerTitle": "Zhaoqin"
				},
				{
					"id": 715120104,
					"content": "Ne ile uğraşıyorsun böyle?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715120105
					]
				},
				{
					"id": 715120105,
					"content": "Öhöm... Şöyle ki, bu seneki Fener Şenliği Festivali için bazı işlere yardımcı olmak adına Sivil İşler Bakanlığı tarafından Liyue Limanı Maceracılar Loncası olarak biz görevlendirildik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120106
					],
					"speakerTitle": "Zhaoqin"
				},
				{
					"id": 715120106,
					"content": "Taşordu, şehirde ve bazı önemli bölgelerde devriyedeyken biz de dışarıda, canavarları ve o işe yaramaz haydutları ortadan kaldırmakla sorumluyuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120107
					],
					"speakerTitle": "Zhaoqin"
				},
				{
					"id": 715120107,
					"content": "Hazır lafı açılmışken, sen de kayıtlı bir maceracıydın, değil mi? Maceralarınla ilgili çok şey duydum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120108
					],
					"speakerTitle": "Zhaoqin"
				},
				{
					"id": 715120108,
					"content": "Eğer istersen sen de bize yardım edebilirsin. Ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120109,
						715120110
					],
					"speakerTitle": "Zhaoqin"
				},
				{
					"id": 715120109,
					"content": "Ama tatil olması gerekmiyor muydu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715120111
					]
				},
				{
					"id": 715120111,
					"content": "Şey... Tatil sırasında Bakanlığa yardımcı olduğumuz için bunu telafi edip emeğimizin karşılığını vermek amacıyla ek ödeme yapacaklar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120112
					],
					"speakerTitle": "Zhaoqin"
				},
				{
					"id": 715120112,
					"content": "Yani bir maceracı bu görevleri yapmaya gönüllü olursa görevleri tamamladıktan sonra daha fazla ödül alabilecek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120113,
						715120115
					],
					"speakerTitle": "Zhaoqin"
				},
				{
					"id": 715120113,
					"content": "Ne kadarlık bir ek ödemeden bahsediyoruz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715120114
					]
				},
				{
					"id": 715120114,
					"content": "İnanın bana oldukça fazla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120123
					],
					"speakerTitle": "Zhaoqin"
				},
				{
					"id": 715120123,
					"content": "Değip değmeyeceği ne kadar iş olduğuna bağlı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715120116
					]
				},
				{
					"id": 715120116,
					"content": "Haha! Tamam! Boş duramayacağını biliyordum. Lonca tarafından onaylanan tüm yerleri işaretleyeceğim. Ayrıca lütfen bu minyatür Ateşleme Borusunu da al.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120117
					],
					"speakerTitle": "Zhaoqin"
				},
				{
					"id": 715120117,
					"content": "Bir görevi kabul edersen... Bir bölgeyi temizledikten sonra havai fişek atmayı unutma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120118
					],
					"speakerTitle": "Zhaoqin"
				},
				{
					"id": 715120118,
					"content": "Sen havai fişek attıktan sonra bölgenin \"temiz\" olduğunu işaretlemesi için birini göndereceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120119
					],
					"speakerTitle": "Zhaoqin"
				},
				{
					"id": 715120119,
					"content": "Sonra da temizlenen bölgelere göre genel planı düzenleyeceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120120
					],
					"speakerTitle": "Zhaoqin"
				},
				{
					"id": 715120120,
					"content": "Bu oldukça planlı görünüyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715120121
					]
				},
				{
					"id": 715120121,
					"content": "Evet... Sonuçta bu Fener Şenliği Festivali... Bir şeylerin ters gitmesine izin veremeyiz... Zaten herkes şu an çok gergin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120122
					],
					"speakerTitle": "Zhaoqin"
				},
				{
					"id": 715120122,
					"content": "Neyse şimdilik bunları boş ver. Gidip ne durumdayız bir bakayım, daha sonra Lahn'a rapor vermem gerekiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhaoqin"
				},
				{
					"id": 715120115,
					"content": "O zaman... Önce bana neler yapılması gerektiğini göster...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715120116
					]
				},
				{
					"id": 715120110,
					"content": "Peki ya Fener Şenliği?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715120111
					]
				}
			]
		}
	]
}