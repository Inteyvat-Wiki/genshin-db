			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ooshima Junpei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722140401,
					"content": "Ah... Şu güzelliğe bak... Çok sağ olun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140402
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140402,
					"content": "Hemen bunları pişireyim. Belki yemekten sonra şansım yaver giderse heykeli oymayı daha hızlı bitirebilirim, haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140403
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140403,
					"content": "Yemekle oymanın alakası ne ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140404
					]
				},
				{
					"id": 722140404,
					"content": "Güzel bir et yemeği yemek işe devam etmek için gereken gücü verir! Balıklar aynı etkiyi veremiyor. Ellerim bu iş için fazla zayıfmış gibi hissediyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140405
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140405,
					"content": "Doğrusu bütün heykeli bitirmemin beklenenden uzun süreceğinden korkmaya başlamıştım ama sayenizde artık öyle bir sorun kalmadı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140406
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140406,
					"content": "Yani evet, patronum... bir kedi ama ek süre istemek hiçbir şekilde hoş kaçmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140407
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140407,
					"content": "Ne olursa olsun bu işi elimden geldiğince hızlı bitireceğim. Hazır aklıma gelmişken, Leydi Rahibe bu heykel bittiğinde iyi bir şey olacağını söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140408
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140408,
					"content": "Tam olarak neyi kastediyor bilmiyorum ama... Heyecanla bekliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140409
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722140409,
					"content": "Sonra tekrar gelin de heykelin bitmiş halini görün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				}
			]
		}
	]
}