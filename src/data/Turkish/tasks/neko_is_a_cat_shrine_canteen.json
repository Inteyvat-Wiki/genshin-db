			},
			"dialogs": [
				{
					"id": 722140101,
					"content": "Bu.. olağanüstü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722140102,
					"content": "Taşı oymayı bitirdi mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140103
					]
				},
				{
					"id": 722140103,
					"content": "Bu işe başladığımızda taşın benimle uzaktan yakından alakası yoktu. Fakat şimdi baktıkça daha çok benzetiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722140104,
					"content": "Siz insanlar aklımı başımdan alıyorsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722140105,
					"content": "Çok gürültü oldu ama ben geçici başrahibeyim. Böyle ufak tefek şeylerden şikayetçi olacak değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722140106,
					"content": "Şu balıkları o insana götürün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140107
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722140107,
					"content": "Bunlar iyi şeyler, yani \"naaş\" olarak verebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140108,
						722140111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722140108,
					"content": "Sadece balık mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140109
					]
				},
				{
					"id": 722140109,
					"content": "Miyav, Konbumaru'ya ufaklıkları toplayıp birkaç serçe yakalamalarını tembihlemiştim ama olmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140110
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722140110,
					"content": "Balık yakalamak daha kolay geliyor onlara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722140111,
					"content": "\"Maaş\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140112
					]
				},
				{
					"id": 722140112,
					"content": "Miyav miyav miyav, çok sıkıyorsun beni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722140113,
					"content": "Şunları ver gitsin. İyi şeyler sonuçta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
		{
			"id": 7221402,
			"completionStepIds": [
				7221402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
