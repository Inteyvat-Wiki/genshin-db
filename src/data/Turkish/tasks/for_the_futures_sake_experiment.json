			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Frejus",
					"Chenee"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745120101,
					"content": "Verilere bakarsak bu icat başarılı. İkinize de yardımlarınız için teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120102
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120102,
					"content": "Evet, teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120103
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120103,
					"content": "Gördün mü, sana her şeyin yolunda gideceğini söylemiştim! Senin gibi bir deha varken bu uzaktan kumandalı topu yapmak çocuk oyuncağıydı Frejus!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120104
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120104,
					"content": "S-Sanırım öyle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120105
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120105,
					"content": "O zaman bir sonraki muhteşem cihaza geçelim hemen. Harika bir fikrim var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120106
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120106,
					"content": "Neymiş o?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120107
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120107,
					"content": "Gökyüzünü keşfedebilecek bir hava gemisine ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120108
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120108,
					"content": "Hım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120109
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120109,
					"content": "Ya da yerin derinliklerine kadar inebilen devasa bir matkap?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120110
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120110,
					"content": "Hah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120111
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120111,
					"content": "Sanki bilerek hayatını zorlaştırmaya çalışıyor gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745120112,
					"content": "Bunları yapması biraz zor olabilir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745120113
					]
				},
				{
					"id": 745120113,
					"content": "Yani sen Enstitünün teklifini üç defa reddetmiş insansın. Onların bile yapamadığı şeyleri yapabiliyorsundur kesin, haksız mıyım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120114
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120114,
					"content": "Tabii ki. Sadece zor olacağını söyleyebilirim ama çok da mühim bir mesele değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120115
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120115,
					"content": "*iç çeker* Artık o şeyleri istemiyorum gerçi. Göğe uçmak da yeri delmek de sıkıcı geldi. Yukarısı soğuk, aşağısı da bunaltıcı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120116
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120116,
					"content": "Ben de aynı fikirdeyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120117
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120117,
					"content": "O zaman, günlük hayatta kullanabileceğimiz bir şey yapar mısın? Ah, evet! Ben sabahları uyumayı çok severim, o yüzden... Bana yemekleri kendi kendine pişirebilen otomatik bir fırın yapabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120118
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120118,
					"content": "Pekala, bu yapılabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745120119,
					"content": "Önceki önerilerini bilerek öyle zor seçti bence.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745120120
					]
				},
				{
					"id": 745120120,
					"content": "Pekala, bunu nasıl tasarlayacağımı düşüneyim bir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120121
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 745120121,
					"content": "Güzel! Anlaştık o zaman. Ama eğer yapamazsan artık kahvaltılarımı sen hazırlarsın, tamam mı Frejus?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745120122
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 745120122,
					"content": "Ne? Nasıl bir istek bu? Sen yine de merak etme, yeteneklerimle böyle küçük bir işin altından kalkabilirim. Ne de olsa ben bir \"dahiyim\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Frejus"
				}
			]
		},
