					}
				]
			},
			"dialogs": [
				{
					"id": 790750301,
					"content": "Oh be... Rüzgar nihayet dindi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750302,
						790750303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750302,
					"content": "Lütfen beni dinle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750304
					]
				},
				{
					"id": 790750304,
					"content": "Tamam. Anlatacaklarınızı dinleyeceğim. Ancak öncesinde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750305
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750305,
					"content": "Ne kadar da şaşırdınız öyle! Eminim \"Bir çiçek nasıl konuşabilir ki?\" diye sormamak için kendinizi zor tutuyorsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750306
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750306,
					"content": "Ya da \"Sen nasıl bir çiçeğe dönüştün?\" diye de düşünebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750307
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750307,
					"content": "Bunu soran çok oluyor mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750308
					]
				},
				{
					"id": 790750308,
					"content": "Dışarıdayken evet, hem de çok. Eve döndüğümden beri... Hayır, kimse sormuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750309
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750309,
					"content": "\"Dışarıdayken\" derken, bu dünyanın dışını mı kastediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750310,
					"content": "Bir seyahat sonrasında bu hale geldiğini duymuştum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750311
					]
				},
				{
					"id": 790750311,
					"content": "Vay, her şeyden de haberin var! Kesin Panuelle anlatmıştır, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750312
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750312,
					"content": "Evet. Seyahat ederken bu hale geldim. Hehe, Rozel'in tabiriyle... Bu, benim tercihim olan bir \"değişimdi\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750313
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750313,
					"content": "Paimon bunu anlayabiliyor... Ama neden saksıdaki bir çiçeğe dönüşmek istedin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750314,
						790750315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750314,
					"content": "Bitkileri çok ama çok sevdiğin için olabilir mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750316
					]
				},
				{
					"id": 790750316,
					"content": "Hayır. Sadece... \"Yerimi\" bulmak istedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750317
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750317,
					"content": "Bu dünyanın dışında birçok insanla karşılaştım. Kimileri şefti, kimileri çiçekçi, kimileri de öğretmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750318
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750318,
					"content": "Neredeyse herkes kendisini rahat hissettiği bir \"yer\" bulmuştu. Hepsi bu şekilde hayatta bir yer edinmeyi başarmıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750319
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750319,
					"content": "Peki ya ben? Bildiğim tek şey seyahat etmekti. Kendime sabit bir \"yer\" bulmak daha önce aklımın köşesinden bile geçmemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750320
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750320,
					"content": "Bu \"saksı\" senin \"yerin\" demek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750321
					]
				},
				{
					"id": 790750321,
					"content": "Aynen öyle. Hemen de anladın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750322
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750322,
					"content": "Saksıda bir çiçek olarak, kendimi daima rahat hissettiğim bir \"yerim\" var artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750323
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750323,
					"content": "Ama... *iç çeker* Kendime bir saksı ve bir \"yer\" bulmama rağmen neden hâlâ seyahate çıkmak istiyorum ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750324
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750324,
					"content": "Sonuçta ben bir seyyahım. Seyahatin dışında yapabileceğim değerli bir şey var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750325
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750325,
					"content": "Anlamıyorum. Dış dünyayı gördükçe aklım daha da karışıyor... Bir \"yere\" sahip olmak ve \"seyahat etmek\", hangisi daha önemli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750326
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750326,
					"content": "Düşündükçe başıma ağrılar giriyor... Panuelle ile konuşurken ise sorduğu soruları geçiştiriyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750327
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750327,
					"content": "Onu yanlış yönlendirmekten korkuyorum. Seyahat etmeyi seven biri olsaydı benim bu halimi görünce seyahatten nefret eder miydi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750328
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750328,
					"content": "O benim arkadaşım ve hep öyle kalacak. Ona karşı dürüst olmam gerek, o yüzden sorduğu soruların hepsine yanıt verdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750329
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750329,
					"content": "Kendimi rahat hissetmemi sağlayacak bir \"yere\" sahip olmak için çiçeğe dönüştüğümü falan... Her şeyi anlattım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750330
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750330,
					"content": "Verdiğim yanıtlar onu üzmüş olabilir... Ya da şu anki halimi sevmiyor olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750331
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750331,
					"content": "Gittikçe birbirimizden uzaklaşıyoruz ama ben sadece bir bitkiyim ve kalkıp da onun yanına gidemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750332
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750332,
					"content": "Belki de en iyisi böyledir. Panuelle'in beni görmek istemediğine eminim. Bana kızgın olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750333
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750333,
					"content": "Ah... Demek öyle! O senin, sen de onun kızgın olduğunu düşünüyorsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750334,
					"content": "O yüzden de kimse kimseyle görüşmek istemiyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750335
					]
				},
				{
					"id": 790750335,
					"content": "Ne? Pa-Panuelle bana kızgın değil mi yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750336,
						790750337
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750336,
					"content": "İkiniz da aynı şeyi düşünüyorsunuz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750338
					]
				},
				{
					"id": 790750338,
					"content": "Panuelle'in düşüncelerini Chauvigne'e bir bir anlatıyorsunuz...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790750339
					]
				},
				{
					"id": 790750339,
					"content": "Aman tanrım, böyle bir şeyi nasıl düşünmüşüm ben? Onu asla üzgün görmek istemem, dudakları büzüldüğünde bile kalbim paramparça olur benim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750340
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750340,
					"content": "Sevgili misafirler! Lütfen beni ona götürün, yalvarıyorum size! Onu acilen görmem lazım! Bir dakika, hayır hayır, bir saniye bile bekleyemem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750341
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750341,
					"content": "Ben de senin bunu söylemeni bekliyordum saksılı dostum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750342
					]
				},
				{
					"id": 790750342,
					"content": "#Hehe, Paimon da bunu bekliyordu! Hadi gidelim {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750337,
					"content": "O aslında senin ona kızgın olduğunu sanıyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750338
					]
				},
				{
					"id": 790750315,
					"content": "Hayalin botanikçi olmak mıydı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750316
					]
				},
				{
					"id": 790750303,
					"content": "Panuelle'in sana anlatmak istediği bir şey var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750304
					]
				}
