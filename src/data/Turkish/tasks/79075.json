			"dialogs": [
				{
					"id": 790750401,
					"content": "Chauvigne! Ge-Gelmişsin. Lütfen beni dinle, sana hiçbir zaman kızmadım, senden ayrılmak da istemedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750402
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750402,
					"content": "Sadece artık benimle arkadaş olmak istemediğini düşündüm... Bazı seyyahların değişebildiğini biliyorum ve senin de değişmiş olduğundan endişelendim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750403
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750403,
					"content": "Tanrıçadan dilek diledim... Ama ona sunacak güzel bir hediye bulamadım, o da doğal olarak beni umursamadı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750404
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750404,
					"content": "Hayır! Panuelle, asla böyle bir şey olamaz. Ben senin her zaman arkadaşın olarak kalacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750405
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750405,
					"content": "Senden özür dilerim! Kendi düşüncelerime o kadar odaklanmıştım ki senin dediklerine hiç kulak veremedim bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750406
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750406,
					"content": "O yüzden... Beni bir daha görmek istemediğini sandım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750407
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750407,
					"content": "Böylece bu yanlış anlaşılmayı ortadan kaldırdık sanırım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750408
					]
				},
				{
					"id": 790750408,
					"content": "Evet! Paimon aranızda saçma bir anlaşmazlık olduğunu düşünmüştü ve birbirinizi anlamak için hiç çaba sarf etmemenize aşırı sinir olmuştu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750409,
						790750410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750409,
					"content": "Kesinlikle bir anlaşmazlık varmış...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750411
					]
				},
				{
					"id": 790750411,
					"content": "İkinize de teşekkür ederim değerli misafirler. Siz olmasaydınız öylece köşeme tıkılmış bir vaziyette hâlâ dışarı çıkmayı reddediyor olurdum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750412
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750412,
					"content": "Ama artık içimdekileri nihayet Panuelle'e anlatabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750413
					],
					"speakerTitle": "Chauvigne"
				},
				{
					"id": 790750413,
					"content": "Anlatacağın her şeyi dinlerim Chauvigne. İster seyahatlerinden bahset ister saksılardan... Benim için hiç sorun değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750414
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750414,
					"content": "Bu arada sevgili misafirler, lütfen bunları alın. Sizin için özel olarak topladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750415
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750415,
					"content": "Tanrıçadan dilerim ki hiçbir zaman arkadaşlarınızla tartışmazsınız ve içinizden geçenleri daima dinleyecek birileri olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750410,
					"content": "Ama neyse ki artık sorun çözüldü.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750411
					]
				}
			]
		}
