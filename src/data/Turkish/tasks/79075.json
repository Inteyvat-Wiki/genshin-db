			"dialogs": [
				{
					"id": 790750101,
					"content": "Chauvigne ne düşünüyor acaba öyle? *iç çeker* Benimle konuşmak bile istemiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750102
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750102,
					"content": "Chauvigne hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750103
					]
				},
				{
					"id": 790750103,
					"content": "Merhaba. Çok özür dilerim ama... Sorun Chauvigne. Bana hâlâ çok kızgın ve saksısından çıkıp benimle konuşmak dahi istemiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750104
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750104,
					"content": "*iç çeker* Ayrıca bu şekilde ne rüzgar ne de güneş ışığı ona ulaşır. Ya solarsa? O zaman ne yaparım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750105
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750105,
					"content": "Hımm... Saksıdaki bir çiçekten bahsettiğimize göre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750106,
					"content": "Onu olduğu yerden alıp götürebiliriz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750107
					]
				},
				{
					"id": 790750107,
					"content": "Onu da denedim! Ama Chauvigne sinirli olduğu zaman yanına bile yaklaşamıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750108
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750108,
					"content": "O kadar sinirli ki neredeyse beni bile uçuruyordu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750109
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750109,
					"content": "Bir saniye, sinirli olunca birini nasıl uçurabiliyor ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750110,
						790750111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750110,
					"content": "Epey sinirliymiş demek ki, anladım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750112
					]
				},
				{
					"id": 790750112,
					"content": "Belki de daha önce onunla seyahate çıkmayı reddettiğim için bana bu kadar öfkelidir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750113
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750113,
					"content": "Sevgili misafirler, acaba Chauvigne'e bir bakabilir misiniz? Siz belki onunla aklıselim bir şekilde konuşabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750114
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750114,
					"content": "Olur, bir deneyelim bakalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750115
					]
				},
				{
					"id": 790750115,
					"content": "Evet! O kadar çok yer gezip o kadar fazla insan gördük ki kesi... Yani muhtemelen onu ikna edebiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790750116,
					"content": "Harika! Onu bu adanın altındaki mağarada bulabilirsiniz. Şu taraftan lütfen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750117
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750117,
					"content": "Benim... Burayı temizlemem ve Chauvigne'in güneş alabilmesi için iyi bir yer bulmam lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750111,
					"content": "Yanına yaklaşmayı zorlaştırıyor, evet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750112
					]
				}
			]
		},
