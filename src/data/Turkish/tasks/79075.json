			"dialogs": [
				{
					"id": 790750201,
					"content": "Benim... Burayı temizlemem ve Chauvigne'in güneş alabilmesi için iyi bir yer bulmam lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750202
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750202,
					"content": "Chauvigne'i ikna etme işini size bırakıyorum o zaman sevgili misafirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750203
					],
					"speakerTitle": "Panuelle"
				},
				{
					"id": 790750203,
					"content": "Şimdi ben gitsem kesin onu darlayacağımı düşünür ve iyice tepesinin tası atar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Panuelle"
