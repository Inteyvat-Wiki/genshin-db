			"dialogs": [
				{
					"id": 750250101,
					"content": "Vay, bu gizemli yer de neresi? Bir sürü küçük Tepetlizor var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250102,
					"content": "Acaba... Tepetlizorların toplanma noktası olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250103,
					"content": "Rarr! ... Raarrr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250104
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750250104,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} çok heyecanlı görünüyor! Tek seferde bu kadar çok yeni arkadaşla tanışma fırsatın pek olmuyor, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250105,
					"content": "Raarr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250106
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750250106,
					"content": "#Ha, yani oraya gidip onlarla oynamak mı istiyorsun? Aslında düşününce {REALNAME[ID(2)|SHOWHOST(true)]} diğer küçük Tepetlizorlarla nadiren bir araya gelme fırsatı buluyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250107,
						750250108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250107,
					"content": "Dikkatli ol, tamam mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750250109
					]
				},
				{
					"id": 750250109,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750250110,
					"content": "#Ayy, Paimon yine de biraz endişeli... Neyse, {REALNAME[ID(2)|SHOWHOST(true)]} gelene kadar bir yer bulup dinlenelim ve bir şeyler yiyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250111,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} gelene kadar Paimon ile yakında hoş bir yer bulup dinleniyorsunuz.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750250112
					]
				},
				{
					"id": 750250112,
					"content": "Ancak bekleme tahmin ettiğinizden uzun sürüyor...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750250113
					]
				},
				{
					"id": 750250113,
					"content": "#Tuhaf... {REALNAME[ID(2)|SHOWHOST(true)]} nasıl oldu da hâlâ dönmedi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250114,
					"content": "Paimon kötü şeylerin yaşanmamasını umuyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250115,
					"content": "Kendini eğlenceye ve oyun oynamaya kaptırdı herhalde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750250116
					]
				},
				{
					"id": 750250116,
					"content": "Öyleyse onunla ciddi şekilde konuşmalıyız. Güneş batmak üzere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750250117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250117,
					"content": "Of... Hadi karanlık olmadan gidip onu bulalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750250108,
					"content": "Çok uzun süre kaybolma!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750250109
					]
				}
			]
		},
