			},
			"dialogs": [
				{
					"id": 730350101,
					"content": "Arama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350102,
					"content": "#Nara {NICKNAME} ve Paimon. Taze Zaytun Şeftalileri gibi zinde görünüyorsunuz ama Paimon üzgün görünüyor. Kabus mu gördün?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350103
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350103,
					"content": "Paimon bizi terk ettiğinden korktu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350104,
					"content": "Niye öyle düşündün? Hep buradaydım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350105,
						730350114
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350105,
					"content": "Ne oldu Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350106
					]
				},
				{
					"id": 730350106,
					"content": "Ç-Çünkü Vanarana rüyada. Utsava Festivalinde yaşadığımız eğlence de rüya gibiydi... Paimon, uyandığımızda her şeyin kaybolacağından korktu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350107,
					"content": "Yolculuğun başındaki gibi sadece ikimiz kalırdık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350108,
					"content": "Ama rüyalarda olan şeyler gerçektir. Daha önce Naraları gözlemledim ve aynı uyanıkken olan olaylar gibi kabusların onları ürküttüğünü, güzel rüyaların da neşelendirdiğini gördüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350109
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350109,
					"content": "Yani Paimon rüyasında bizimle ve Vanaranayla tanıştığını gördüğünde bunlar rüyanın dışında olduğu kadar gerçekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350110,
						730350112
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350110,
					"content": "Ayrıca Arama da burada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350111
					]
				},
				{
					"id": 730350111,
					"content": "Evet! Birlikte Ashvattha Mabedine gidip Bijayı almak ve Naranayı iyileştirmek için sizi bekliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350116
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350116,
					"content": "#Doğru. Herhalde yemeğe tuhaf mantarlar koymuşsun ki Paimon böyle şeyler düşünüyor {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350117,
					"content": "Hadi gidelim o zaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350112,
					"content": "Üstelik hâlâ Rana'ya yardım etmemiz lazım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350113
					]
				},
				{
					"id": 730350113,
					"content": "Evet. Ashvattha Mabedine gidip Bijayı almamız ve Narana'yı iyileştirmemiz lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350116
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350114,
					"content": "Buna kafanı o kadar yorma Paimon. Hadi gidelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350115
					]
				},
				{
					"id": 730350115,
					"content": "Aynen öyle. Narana'nın iyileşmesi için Ashvattha Mabedine gidip Bijayı almamız lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350116
					],
					"speakerTitle": "Arama"
				}
			]
		},
		{
			"id": 7303502,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7303509",
							"2"
						],
						"stepId": 7303509,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"302821",
