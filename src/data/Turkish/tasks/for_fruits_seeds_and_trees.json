						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arama",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730350201,
					"content": "#Harika. Burası Arayama ve diğerleri gibi Marana tarafından yıpratılmamış! Nara {NICKNAME}, Paimon, işte bu Ashvattha Ağacı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350202
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350202,
					"content": "Vay canına, ne kadar tuhaf görünümlü bir ağaç.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350203,
					"content": "Kabalık etme Paimon! Ashvattha Ağacını kızdıracaksın! Bu çok ama çok güçlü bir ağaçtır. En yaşlı Vasara ağacıdır. Tüm Aranaralardan ve hikayelerinden daha yaşlıdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350204
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350204,
					"content": "Binlerce ay, hatta belki daha uzun süre önce Kraliçe Aranyani burada şarkı söylemiş. O zaman Valuka'dan yeni ayrılmış. Orman şimdiki kadar gür değilmiş, yani yerlerde hâlâ epey kum varmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350205
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350205,
					"content": "Onun Ararakalarisi tüm Aranaralarınkinden daha güçlüymüş çünkü onun şarkısı İlk Şarkıya en yakın olanmış. Bu yüzden Ashvattha onun çağrısına cevap vermiş ve Sarva'dan filizlenmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350206
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350206,
					"content": "Kraliçe Aranyani, Ashvattha'ya ormanda birçok zeki, güzel ama yalnız Nara olduğunu, Naralarla arkadaş olabilmek için ormanın çocuklarının çoğalması gerektiğini söylemiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350207
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350207,
					"content": "Böylece Ashvattha güzel, bol tohumlu ve dolgun bir nar yaratmış. Bu çekirdeklerden ilk filizlenen Aramuhukunda'ymış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350208
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350208,
					"content": "Bu sayede Aramuhukunda ilk Aranara olmuş. Sonra tüm tohumlar büyümüş ve Aranaralar bir ağacın yaprakları gibi yayılmış. Yani hem biz, hem de Naralar orman halkıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350209
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350209,
					"content": "Ashvattha Ağacının çok güçlü ve çok önemli olmasının sebebi bu! Naraların Nara çocuklar doğurması gibi Aranaralar da Ashvattha ve Kraliçe Aranyani'nin çocukları.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350210
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350210,
					"content": "Demek öyle. Özür dilerim Arama. Ashvattha Ağacı çok etkileyici!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350211,
						730350213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350211,
					"content": "Çok ayıp Paimon. Birinin annesine tuhaf denir mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350212
					]
				},
				{
					"id": 730350212,
					"content": "Paimon öyle demek istememişti! Neyse, şimdi Bija konusunda ne yapmamız lazım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350214,
					"content": "Evet. Nasıl ağaçların büyümek için toprağa ve yağmura ihtiyacı varsa Vasara Ağacının da rüyalara ve hatıralara ihtiyacı var. Az önce söylediğim gibi, Ashvattha Ağacı en eski Vasara Ağaçlarının en eskisidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350215
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350215,
					"content": "Bu yüzden Araji, Arayama ve Aramaha'dan Vasoma Meyveleri getirdik. Büyük bir meyve vermesi için onları Ashvattha Ağacına adayacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350216
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350216,
					"content": "Araji, Arayama ve Aramaha'nın Vasoma Meyveleri mi? Vasara Ağaçlarının meyveleri mi yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350217,
					"content": "Evet, öyleler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350218
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350218,
					"content": "#Ashvattha Ağacına daha yakın dur Nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350219
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350219,
					"content": "Vay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350220,
						730350221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350220,
					"content": "Bu harika.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350222
					]
				},
				{
					"id": 730350222,
					"content": "Tüm Aranaralar bu ağacın soyundan gelir. Artık tüm Aranaralara bağlısın ve onların lütfuna sahipsin. Yani Ashvattha Ağacı seni de kutsayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350223
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350223,
					"content": "Çünkü sen bu tacı taktığın sürece Ashvattha Ağacı seni ormanın bir çocuğu gibi görecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350224
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350224,
					"content": "Hımm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350225
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350225,
					"content": "Ashvattha Ağacında bir tuhaflık var. Biraz zayıf olduğunu hissediyorum. Galiba son zamanlarda her yerde çıkan Marana yüzünden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350226
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350226,
					"content": "Neyse. Sırada Ashvattha Ağacının rüyasına girerek Vasoma Meyvelerini Rüya Ağacı'na sunmak var. Bu da onu canlandıracaktır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350227
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350227,
					"content": "#Yani Ashvattha'nın Salonlarında yaptığımız gibi yapıyoruz değil mi? {NICKNAME} uzanacak ve hop diye rüyaya gireceğiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350228,
					"content": "#Evet. Çok zekisin Paimon. Hazırsan elini uzat da Ashvattha Ağacının rüyasına girelim Nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350229,
						730350234
					],
					"speakerTitle": "Arama"
				},
				{
