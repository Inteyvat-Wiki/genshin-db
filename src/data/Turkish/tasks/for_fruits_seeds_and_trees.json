			"dialogs": [
				{
					"id": 730350401,
					"content": "Ashvattha Ağacının kalbi parlıyor. Şu Bija mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350402,
					"content": "Kolay olmadı ama sonunda Rana'yı iyileştirebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350403,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350404
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350404,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350405,
						730350406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350405,
					"content": "Arama?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350407
					]
				},
				{
					"id": 730350407,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350408
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350408,
					"content": "Ashvattha Ağacı, Marana tarafından yıpratılmış ve Bija üretemiyor. Size yardım etmek için yeni bir Ashvattha Ağacı dikmem gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350409
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350409,
					"content": "Ama tohumdan ağaca dönüşmesi uzun sürmez mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350410,
					"content": "Endişelenme. Vasara Ağacının büyüme hızı tohumuna bağlıdır. Ashvattha Ağacı bana tüm gücünü verdi, Vasoma Meyveleri de bizim hatıralarımıza sahip. Yani sorun yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350411
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350411,
					"content": "Teşekkürler ilk Ashvattha Ağacı. Teşekkür ederim Araji, Arayama ve Aramaha. Sizin hatıralarınızı kullanarak yeni Ashvattha Ağacıyla rüyalar arasındaki yolu yeniden inşa edeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350412
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350412,
					"content": "Arama'nın artık farklı olduğunu hissediyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350413,
					"content": "Bilmem ki... Birçok yeni şey ve bir sürü yeni kelime öğrendim. Bolca hatıra edindim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350414
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350414,
					"content": "Yine de hâlâ aynı kişiyim, arkadaşınım. O yüzden endişelenme. Tabii ki sana yardım edeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350415,
						730350416,
						730350417
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350415,
					"content": "Öyleyse Bija...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350419
					]
				},
				{
					"id": 730350419,
					"content": "Eski Vanarana, Ashvattha Mabedinin derinliklerine mühürlendi. Marananın cismi orada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350420
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350420,
					"content": "Tüm yeşillikler kararana, tüm çiçekler solana, tüm dereler kokuşana ve her canlı ölene dek toprağa ve Sarva'ya yılan zehri yayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350421
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350421,
					"content": "Onu yok etmeliyiz. Bija üretecek kadar güçlü bir ağaç ancak o zaman büyüyebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350416,
					"content": "Sana inanıyorum. Şimdi ne yapacağız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350419
					]
				},
				{
					"id": 730350417,
					"content": "Anlıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350418
					]
				},
				{
					"id": 730350418,
					"content": "#Anladığın sürece sorun değil Nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350419
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350406,
					"content": "Neler oluyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350407
					]
				}
			]
