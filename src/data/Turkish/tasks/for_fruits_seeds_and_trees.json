			"dialogs": [
				{
					"id": 730350901,
					"content": "Sonunda buradayız. Hımm. Paimon bu gizemli ağacı diğer Vasara Ağaçlarının rüyalarında da görebildiğimizi hatırlıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350902,
					"content": "#Özür dilerim Nara {NICKNAME} ve Paimon. Marananın Ashvattha Ağacının rüyasını da aşındırdığını fark etmedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350903
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350903,
					"content": "Sayısız kara haşere Sarva'da Rüya Ağacının köklerini aşındırıyor. Marananın elleriyle rüyayı kökünden salladığını hissedebiliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350904
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350904,
					"content": "Özür dilerim. Daha önce Ashvattha'nın Salonlarında Maranayı gördüğümüzde durumun böyle olduğunu anlamalıydım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350905
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350905,
					"content": "#Sorun değil! {NICKNAME} sayesinde bu sorunu kolayca çözdük, öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350906,
						730350907,
						730350909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350906,
					"content": "Öyleyse Bija...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350912
					]
				},
				{
					"id": 730350912,
					"content": "#Vasoma Meyveleri gücünün en azından bir kısmını geri kazandıracaktır. Sana güveniyorum Nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350913
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350913,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350914
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350914,
					"content": "Evet, anlıyorum. Bu kadar çabuk olacağını düşünmedim ama zamanı geldiğinde ne yapılacağını bileceğimden eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350915
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350915,
					"content": "Tıpkı bulutların yağmur yağdırmaları gerektiğini, yağmurun yere düşmesi gerektiğini, tohumların büyük ağaçlar olup bolca dolgun meyve vermeleri gerektiğini bildiği gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350916
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350916,
					"content": "Arama'da bir tuhaflık var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350917,
					"content": "Rüya Ağacı ile konuşuyordum. Hımm. Demek siz duyamadınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350918
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350918,
					"content": "Paimon daha önce Aranakin'in mantarlarla konuştuğunu gördü ama insanlar normalde bitkilerle konuşmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350919
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350919,
					"content": "Anladım. Yeni bir şey öğrendim. Sağ ol Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350920
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350920,
					"content": "#Bija konusunda endişelenmeyin Nara {NICKNAME} ve Paimon. Hadi şimdilik rüyadan ayrılalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arama"
				},
				{
					"id": 730350907,
					"content": "Çocuk oyuncağıydı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730350908
					]
				},
				{
					"id": 730350908,
					"content": "Ancak... Burada olanların Bijaya bir etkisi olacak mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730350912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730350909,
					"content": "Paimon'un söylediği kadar kolay olmadı gerçi...",
