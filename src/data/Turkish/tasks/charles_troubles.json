			"dialogs": [
				{
					"id": 4880001,
					"content": "Lisa? Vergi iadesi için mi buradasın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4880002,
					"content": "Selam şekerim. Evet. Zavallı Jean'e olanları duyunca birkaç ayak işine yardımcı olabilirim diye düşündüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880003
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 4880003,
					"content": "Harika, o halde bize ihtiyaç kalmadıysa yolumuza devam edelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4880004,
					"content": "Bir dakika... Aslında, Charles bir şeyi merak ediyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880005
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 4880005,
					"content": "İzin verin, anlatayım hanımefendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880006
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4880006,
					"content": "Az önce çok önemli bir sipariş aldım, ama maalesef elimizde hiç içki kalmadı, şaraphanenin teslimatı da gecikti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880007
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4880007,
					"content": "Eğer sizin için çok zor olmayacaksa <color=#00E1FFFF>bu lojistik sorunuyla ilgili bir şey yapabilir misiniz</color>?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880008
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4880008,
					"content": "Bu sipariş niye bu kadar acil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4880009,
					"content": "*iç çeker* Son dakikada geldi. Tamı tamına birkaç saniye önce aldık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880010
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 4880010,
					"content": "Evet, aciliyetinden dolayı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880011
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 4880011,
					"content": "Tamam, neler yapabileceğime bakayım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4880012
					]
				},
				{
					"id": 4880012,
					"content": "Tamam, ama bir sonraki içkim sizden olsa iyi olur!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4880013
					]
				},
				{
					"id": 4880013,
					"content": "Heh... Eminim patronum Usta Diluc buraya geldiğinde sizin hesabı kapatacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880014
