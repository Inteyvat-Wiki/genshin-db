					"nextDialogs": [
						4880103
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 4880103,
					"content": "Onca zamandır şaraphanede çalışıyorum, ilk kez dağ yabanileri tarafından soyuldum. *iç çeker*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880104
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 4880104,
					"content": "Biraz daha gecikseydiniz ne yapardım bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4880105
					],
					"speakerTitle": "Ernest"
				},
				{
					"id": 4880105,
					"content": "#Korkma. {NICKNAME} muhteşem bir dağ yabanisi yok edicisidir!",
