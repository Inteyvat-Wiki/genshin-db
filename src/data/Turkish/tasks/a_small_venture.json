			"dialogs": [
				{
					"id": 761390101,
					"content": "Bugünlerde yayıncılıkta pek para yok. Belki de yatırımlara odaklanmalıyım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390102
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390102,
					"content": "Yatırım kuponlarına bakayım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390103
					]
				},
				{
					"id": 761390103,
					"content": "Buyurun. Her kupon 2.000 Mora değerinde ve yatırım vadesi haftalık olarak doluyor. Şimdi bunları keseye koyalım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390104
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390104,
					"content": "... Of!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390105
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390105,
					"content": "Sorun ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390106
					]
				},
				{
					"id": 761390106,
					"content": "H-Hayır, hiçbir şey yok. Sadece sizi burada göreceğimi beklemiyordum, Leydi Nefer. Siz de mi... Yatırım kuponu almakla ilgileniyorsunuz acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390107
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390107,
					"content": "Yok, teşekkürler. Sadece arkadaşıma eşlik etmeye geldim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390108
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761390108,
					"content": "Yatırımlarınızın çok kazançlı olduğunu duydum Bay Dhabit. Söylentilerin doğru olduğunu görebiliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390109
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761390109,
					"content": "Ah, yok canım... Ay sonunu getirebilmek için ufak bir girişim işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390110
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390110,
					"content": "Bundan gerçekten para kazanılıyor mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390111
					]
				},
				{
					"id": 761390111,
					"content": "Tabii ki. Bay Dhabit çok iyi bir iş adamıdır. Onun tavsiyelerine kulak verirseniz kazançlı çıkarsınız. Değil mi Bay Dhabit?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390112
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761390112,
					"content": "Evet, evet... Haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390113
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390113,
					"content": "O zaman bakalım bugün şansım nasılmış...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390114
					]
				},
				{
					"id": 761390114,
					"content": "B-Bugün diyorsun... Ş-Şey, bunu söylemen çok ilginç! Bu güzel günde satın aldığın şey bizim yepyeni... Kısa vadeli yatırım kuponumuz! Ve işin güzel yanı; bu kuponda kar ve zarar anında hesaplanıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390115
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390115,
					"content": "Sanki hepsini şimdi uydurdun gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761390116,
					"content": "Ah... Endişelenme. N-Neyse, kısa vadeli yatırım kuponumuzu aldığın için teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390117
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390117,
					"content": "İşte yatırım getiriniz. İyi günler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390118,
						761390119
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390118,
					"content": "Eh... Para kazanmak hiçbir zaman kötü değildir sanırım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390120
					]
				},
				{
					"id": 761390120,
					"content": "Gerçekten mi? Paimon kuş şekilli bir heykel istiyor! Paimon'un favorisi o!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761390121,
					"content": "O zaman ben de gideyim. Bay Dhabit, dediğim gibi gerçekten söylentileri haklı çıkardınız. Cidden çok dürüst bir tüccarmışsınız. Kazancınız bol olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390122
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761390122,
					"content": "Nazik sözleriniz için teşekkür ederim Leydi Nefer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390123
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390123,
					"content": "Geçen sefer yardım istediğim konuya gelince...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390124
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390124,
					"content": "Aradığınız şeyi bulduk ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390125
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761390125,
					"content": "Sabırlı olun Bay Dhabit. Doğru düzgün iş yapacaksak adım adım ilerleyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390126
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761390126,
					"content": "E-evet, tabii ki... O işi sizin hünerli ellerinize bırakıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 761390119,
					"content": "Hadi Paimon, gidip birkaç şekerden heykel alalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761390120
					]
				}
			]
		},
