				},
				{
					"id": 761390210,
					"content": "Bu iş yatırımın doğasında var bir defa... Bazen kazanırsın, bazen kaybedersin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761390211
