			"dialogs": [
				{
					"id": 766740101,
					"content": "Vay vay vay, ortaya çıkan sonuç tüm beklentilerimi aştı... Eğer biri yanlışlıkla buraya gelirse bu büyücünün gücü karşısında nutkunun tutulacağına eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740102,
						766740103
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766740102,
					"content": "Eğer gerçekten olur da biri yanlışlıkla buraya gelirse...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766740104
					]
				},
				{
					"id": 766740104,
					"content": "Tamamen nasıl biri olduğuna bağlı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740105
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766740105,
					"content": "Dikkatli olmazsan yol gösterdiğin kişi rehavete ve her şeyi hak görme hissine kapılabilir. Kişi eğer, tıpkı senin gibi, kendi yeteneklerine güveniyorsa ona seve seve yardım ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740106
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766740106,
					"content": "Ama kendisi hiçbir iş yapmayıp tüm umutlarını büyücünün gücüne bağlayan türden biriyse... Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740107
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766740107,
					"content": "... O-Onları gerçekten bir heykele mi dönüştürürsün?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766740108,
					"content": "Hayır, öyle bir şey yapmam. Ama ona buradan çıkış yolunu gösterip yakındaki Sırlar Arşivi'ne gitmesini söylerim. Eminim Nefer onunla ne yapacağını benden çok daha iyi bilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766740109
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766740109,
					"content": "Ekmeden biçmeye kalkanlar bedelini ödemeli, sizce de öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766740103,
					"content": "Dileklerini gerçekleştirmesi için ona yol gösterecek misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766740104
					]
				}
			]
		}
