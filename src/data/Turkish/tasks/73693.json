				"points": []
			},
			"dialogs": [
				{
					"id": 736930101,
					"content": "Bu görev niye bana kaldı? Daha deneyimli öğrencilerden biri alamaz mıydı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930102
					],
					"speakerTitle": "Bahador"
				},
				{
					"id": 736930102,
					"content": "Hım? Siz de mi bir etkinlik yapıyorsunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736930103
					]
				},
				{
					"id": 736930103,
					"content": "Efendim? Aa, Gezgin! Şey, evet... Biz de etkinlik düzenliyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930104
					],
					"speakerTitle": "Bahador"
				},
				{
					"id": 736930104,
					"content": "Şey, etkinlik dedim ama bu aslında... Keşfedilmeyi bekleyen bir Zindan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930105
					],
					"speakerTitle": "Bahador"
				},
				{
					"id": 736930105,
					"content": "Bu Zindanın Şenlikle bir ilgisi var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736930106
					]
				},
				{
					"id": 736930106,
					"content": "*iç çeker* Ah, o konuya hiç girmeyelim. Ben sadece Şenlik var diye buradayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930107
					],
					"speakerTitle": "Bahador"
				},
				{
					"id": 736930107,
					"content": "Kusura bakma, kendimi tanıtmayı unuttum. Ben Spantamad'dan Bahador. Araştırma konularımız simya, elementler ve buna benzer alanlar üzerine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930108
					],
					"speakerTitle": "Bahador"
				},
				{
					"id": 736930108,
					"content": "Bana bu görev verildi ama ne kadar düşünürsem düşüneyim Darşanımızın tasarlayabileceği herhangi bir oyun bulamadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930109
					],
					"speakerTitle": "Bahador"
				},
				{
					"id": 736930109,
					"content": "Simya deneyleri yapmak için bir simya tezgahı koysak çok sıkıcı olabilirdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930110
					],
					"speakerTitle": "Bahador"
				},
				{
					"id": 736930110,
					"content": "Ayrıca Element Tepkimelerini doğrudan göstermemizin bir yolu da yoktu. Bir şeyler ters giderse tüm bu alan havaya uçabilirdi. O zaman ne yapardık?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930111
					],
					"speakerTitle": "Bahador"
				},
				{
					"id": 736930111,
					"content": "En sonunda ben de Maceracılar Loncasından yardım istemek zorunda kaldım, onların yardımı sayesinde bu Zindanı buldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930112
					],
					"speakerTitle": "Bahador"
				},
				{
					"id": 736930112,
					"content": "Birkaç öğrenci arkadaşımla birlikte araştırma yapmak için Zindana girdik. Açıkçası içerisi tam bir curcuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930113
					],
					"speakerTitle": "Bahador"
				},
				{
					"id": 736930113,
					"content": "Sonra da sadece bu Zindanda kullanılması için birkaç iksir geliştirdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930114
					],
					"speakerTitle": "Bahador"
				},
				{
					"id": 736930114,
					"content": "Darşanımızın uzmanlık alanını da böylece göstermiş olduk, değil mi? Hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930115
					],
					"speakerTitle": "Bahador"
				},
				{
					"id": 736930115,
					"content": "Gezgin, eğer ilgini çektiyse bu iksirleri al ve gidip Zindanı araştır. Ben Zindanın konumunu <color=#00E1FFFF>haritanda</color> işaretleyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930116,
						736930117
					],
					"speakerTitle": "Bahador"
				},
				{
					"id": 736930116,
					"content": "Bu oyunu... Oynamaya gelen oldu mu hiç?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736930118
					]
				},
				{
					"id": 736930117,
					"content": "Bu oyuna benden başka katılan oldu mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736930118
					]
				},
				{
					"id": 736930118,
					"content": "B-Birkaç maceracı gelip denedi! Oldukça da heyecanlılardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930119
					],
					"speakerTitle": "Bahador"
				},
				{
					"id": 736930119,
					"content": "Ama şunu da söyleyeyim, Darşanımızdaki öğrencilerden çok azı katıldı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930120
					],
					"speakerTitle": "Bahador"
				},
				{
					"id": 736930120,
					"content": "*iç çeker* Her neyse, ilgini çekiyorsa katılabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930121
					],
					"speakerTitle": "Bahador"
				},
				{
					"id": 736930121,
					"content": "Daha önce deneyen maceracıların değerlendirmesine göre \"çok zorlu\"ymuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930122,
						736930124
					],
					"speakerTitle": "Bahador"
				},
				{
					"id": 736930126,
					"content": "Hah, evet, gideceğin zaman sana vereceğim iksirler burada. Zindanı keşfederken dikkatli ol, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bahador"
				}
			]
		}
	]
}