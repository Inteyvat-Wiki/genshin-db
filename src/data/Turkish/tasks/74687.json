			"dialogs": [
				{
					"id": 746870301,
					"content": "Açılın, destek kuvvet geliyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870302
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 746870302,
					"content": "Aa, sizin burada ne işiniz var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870303,
						746870307
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 746870303,
					"content": "B-Bir sorun mu var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870304
					]
				},
				{
					"id": 746870304,
					"content": "Daha önce tanışmış mıydık?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746870305,
					"content": "Hiçbir sorun yok! Sizin gibi güçlü kahramanların yardıma geldiğini görmek harika gerçekten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870306
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 746870306,
					"content": "Ben birlikteyken, yani köye döndükten sonra herkes sizin her işin altından kalkabildiğinizi söylüyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870311
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 746870311,
					"content": "O ikisi de güvenilir sayılır ama aralarında sanki biraz... Tuhaf bir durum var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870312
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 746870312,
					"content": "İnsan duyguları karmaşıktır... Belki de biraz desteğe ihtiyaçları vardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870313
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 746870313,
					"content": "Tuhaf mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870314
					]
				},
				{
					"id": 746870314,
					"content": "Önemli değil. Odaklanmamız gereken daha mühim şeyler var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870315
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 746870315,
					"content": "Tamam o zaman, size güvenim tam. Topu kullanması kolay zaten. O canavarların kısa sürede icabına bakacağınıza eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marine"
				},
				{
					"id": 746870307,
					"content": "Sanırım daha önce tanışmıştık...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870308
					]
				},
				{
					"id": 746870308,
					"content": "Beni hatırlıyorsun demek! Chevalmarin Fantastik Film Diyarında bir pozisyon için başvurmuştum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870309
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 746870309,
					"content": "Paimon sanki onu hatırlıyor gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746870310,
					"content": "Başardıklarınızdan haberim var ve size her konuda gözüm kapalı güvenebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870311
					],
					"speakerTitle": "Marine"
				}
			]
		}
	]
}