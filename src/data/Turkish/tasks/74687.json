			},
			"dialogs": [
				{
					"id": 746870101,
					"content": "Günün yarısını bunlarla uğraşarak geçirdik ama canavarlar bir türlü azalmak bilmiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870102
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870102,
					"content": "Destek kuvvet mi çağırsam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870103
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870103,
					"content": "Paniğe gerek yok! Topumuza ve sivil kıyafetli meslektaşımıza güven sadece!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870104
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 746870104,
					"content": "Ayrıca bir kriz baş gösterirse de tehlikenin kokusunu her yerden alabilen o maceracı ile memur da muhakkak yardıma koşacaktır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870105,
						746870106
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 746870105,
					"content": "Ne kriziymiş o?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870107
					]
				},
				{
					"id": 746870107,
					"content": "İşte buradalar... Başlider ve küçük yardımcısı gerçekten de geldiler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870108
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870108,
					"content": "Selamlar. Size durumu açıklayayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870109
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 746870109,
					"content": "Sen biraz dinlen istersen. Ben anlatırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870110
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870110,
					"content": "Hey! Topu kullanmayı denemek ister misin? Böyle bir fırsat her zaman ele geçmez, en azından filo yok olduğundan beri... Asırlar öncesine yolculuk yapmış gibi olacaksın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870111
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870111,
					"content": "Bu özel yapım mermilerle canavarları havaya uçurmak inanılmaz derecede rahatlatıcı. Üstelik Jandarma bunun için ödül de veriyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870112
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870112,
					"content": "Devasa bir topla canavarları havaya uçurmak mı? Tam bizlik iş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870113,
						746870114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746870113,
					"content": "Gayet yapılabilir gibi duruyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870115
					]
				},
				{
					"id": 746870115,
					"content": "Heyecanını anlıyorum Başlider ama şu anda kritik bir aşamadayız. Sana neler olduğunu anlatayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870116
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870116,
					"content": "Geçenlerde bir grup işçi, yakınlardaki bir kazı sırasında bazı kadim harabeleri ortaya çıkardı ve orada uykuda olan canavarları rahatsız etti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870117
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870117,
					"content": "Canavarların kaçmasını önlemek için Jandarma olarak bir kontrol bölgesi oluşturduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870118
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870118,
					"content": "Gerçi \"kontrol bölgesi\" diyorum ama şu anda burada sadece ikimiz ve tesadüfen tatile gelmiş olan bir Melusina ajan var... Tabii bir de özel yapım topumuz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870119
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870119,
					"content": "Eyvah, gerçekten tehlikeliymiş! Paimon o Melusina ajanın başına bir şey gelmemesini umuyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746870120,
					"content": "Onun için endişelenmene gerek yok. Harabelerin girişindeki top uzaktan kontrol edilebiliyor. Yani canavarlara yaklaşmadan çoğunun icabına bakabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870121
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 746870121,
					"content": "Kendisi gayet güvenilir biri ama bu operasyon gitgide uzamaya başladı ve artık yorgun düşmüş olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870122
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870122,
					"content": "Bize yardım edecek misin Başlider? Durum yakında düzelmezse destek çağırmak zorunda kalacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870123
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870123,
					"content": "Seninki de laf mı Chenee? Başliderimizin ne kadar becerikli olduğunu bilmiyor musun? Hele bir topun başına geçsin, o canavarları tuzla buz eder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870124,
						746870125
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 746870124,
					"content": "Lafı uzatmaya gerek yok. Topu seve seve kullanırım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870126
					]
				},
				{
					"id": 746870126,
					"content": "Tehlike görünce kaçmak bize yakışmaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746870127,
					"content": "Harika! Yardımın için ne kadar teşekkür etsek az.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870128
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 746870128,
					"content": "Son deneyden sonra icadımda birkaç değişiklik yaptım. Umarım kullanması kolay olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870129
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 746870129,
					"content": "*iç çeker* Keşke otomatik nişan alma ve atış özelliği olsaydı... Ne dersin, böyle bir şey mümkün olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870130
					],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870130,
					"content": "Harika bir fikir! Bir dahaki sefere onu bir Meka Jandarmanın hedef saptama modülüyle entegre etmeyi deneyebilirim. Bu sayede kendi kendine çalışabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746870131
					],
					"speakerTitle": "Frejus"
				},
				{
					"id": 746870131,
					"content": "Çok zekice! Sen tam bir dahisin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chenee"
				},
				{
					"id": 746870125,
					"content": "Ne olursa olsun yardım ederim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870126
					]
				},
				{
					"id": 746870114,
					"content": "Bu canavarları havaya uçurmamızın özel bir sebebi var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870115
					]
				},
				{
					"id": 746870106,
					"content": "Tam zamanında geldik anlaşılan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746870107
					]
				}
			]
		},
