			"dialogs": [
				{
					"id": 756690101,
					"content": "#{NICKNAME}, buraya gel! Paimon sana güzel bir şey gösterecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756690102,
					"content": "Bak! Paimon bu fotoğrafları yolculuklarımız sırasında çekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756690103,
					"content": "Pek çok yer gezdik gördük. Sen keşifle meşgulken Paimon da Kamerasıyla meşguldü!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756690104,
					"content": "Al, Paimon'un çektiği bu muhteşem fotoğraflara bir bak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756690105,
					"content": "Bu arada Damoville Toptancısından iki fotoğraf albümü satın almıştık, hatırladın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690106,
						756690108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756690106,
					"content": "Hatırlıyorum, evet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756690107
					]
				},
				{
					"id": 756690107,
					"content": "Hatırlarsın tabii! Paimon o albümleri ayırtmak için tüm birikimini harcamıştı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756690111,
					"content": "Albümlerin birini sen almıştın, diğerini de Paimon almıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756690112,
					"content": "Paimon kendi albümünü fotoğraflarla doldurdu bile. Seninki doldu mu emin değil ama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756690113,
					"content": "Yine de ne olur ne olmaz diye Paimon yeni bir fotoğraf albümü aldı. Yedek olarak saklamayı düşünüyordu ama senin albümün doluysa sana verebilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690114,
						756690117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756690114,
					"content": "Fotoğraf çekmeyi seviyor musun Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756690115
					]
				},
				{
					"id": 756690115,
					"content": "Evet! Birlikte çok yer gördük, sıradan insanların hayal bile edemeyeceği bir sürü manzaraya tanıklık ettik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756690116,
					"content": "Paimon birkaç hatıra saklamasa yazık olurdu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756690121,
					"content": "Hem daha da önemlisi, bunlar ikimiz için de önemli anılar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756690122,
					"content": "Geçmiş hatıralarımızın ve gelecekteki deneyimlerimizin değerini bilmeliyiz. Pacal Paimon'a böyle demişti. Çok anlamlı, öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756690123,
					"content": "Paimon daha fazla fotoğraf çekmen için Kamerasını sana ödünç verecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756690124,
					"content": "Yakında Snezhnaya'ya gideceğiz, Paimon'un içinden bir ses işler artık hiç kolay olmayacak diyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756690125,
					"content": "Yani hazır fırsatımız varken yolculuğumuzda yaşadığımız deneyimleri düşünelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756690126,
					"content": "Böylece Snezhnaya'da ne zorlukla karşılaşırsak karşılaşalım birlikte yaşadığımız anıları düşünerek cesaretimizi koruyabilir ve yola devam edebiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756690117,
					"content": "Her zamanki gibi başkalarını düşünüyorsun Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756690118
					]
				},
				{
					"id": 756690118,
					"content": "Hehe, ne de olsa Paimon Teyvat'ın en iyi tur rehberi. Sadece kendini düşünecek hali yok ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756690119,
					"content": "Paimon fotoğraf çekmeyi çok sevdiği için fazladan bir fotoğraf albümü aldı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756690120,
					"content": "Yolculuklarımız sırasında o kadar çok güzel manzara gördük ki Paimon birkaç hatıra saklamasa yazık olurdu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756690108,
					"content": "Hatırlamıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756690109
					]
				},
				{
					"id": 756690109,
					"content": "Nasıl hatırlamazsın? Paimon o albümleri erkenden ayırtmak için tüm birikimini harcamıştı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756690110,
					"content": "Neyse! Sen hep çok meşgul olduğun için Paimon çok anlayışlı bir seyahat yoldaşı olmaya karar verdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756690111
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}