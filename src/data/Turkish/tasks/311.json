			"dialogs": [
				{
					"id": 3090201,
					"content": "Oh be. Sonunda bitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090202,
					"content": "Lisa'nın bahsettiği şu \"ley akıntıları\" ve \"element hatları\" sonunda normale dönmüştür herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090203,
					"content": "Dönüp <color=#00E1FFFF>Şövalyelerin</color> ne yaptığına bakalım mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090204,
					"content": "Tabii yapacağın daha ilginç bir şey varsa Paimon da gelebilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090205,
					"content": "Mesela... Bir sürü alışveriş yapmak... Ya da <color=#00E1FFFF>Yedilerin Heykeline</color> tekrar bakmak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090206,
					"content": "Dört Rüzgar tapınaklarında... Katılaşmış rüzgar gibi bir şey bulmuştuk, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090207,
					"content": "Mondstadt'ta insanlar onlara \"Rüzgar Özü\" diyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090208,
					"content": "Heykelin gözlerine yerleştirilebildikleri için bu isimle anılıyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090209,
					"content": "Bazı peri masallarına göre heykellerin gözlerinde aslında değerli taşlar varmış ama kırlangıçlar onları götürmüş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090210,
					"content": "Ancak Rüzgar Özleri hiçbir zaman fiziksel bir forma sahip olmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090212,
					"content": "Önsezilere sahip olan insanlar kutsanmak için onları toplayıp <color=#00E1FFFF>heykellere</color> adar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090213,
					"content": "Güçleri olan diğerlerinin aksine senin bir Önsezin yok. Ama bu dünyanın kuralları zaten senin için geçerli değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090214,
					"content": "Denemek istersen hemen gidip ne olacağına bakabiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090215,
					"content": "En yakın olanı Rüzgaralan'daki heykel sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3090216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3090216,
					"content": "Paimon, tanrılar sana ne yapacak görmek için sabırsızlanıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
