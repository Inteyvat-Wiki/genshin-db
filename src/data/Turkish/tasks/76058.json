			"dialogs": [
				{
					"id": 760580101,
					"content": "Paimon daha önce hiç bu kadar beyaz bir Hırsız Gelincik görmemişti. Hasta olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580102
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 760580102,
					"content": "Az önce çok hareketliydi, hatta Jurva'nın yiyeceğini çalmaya çalıştı. Bana hiç hasta gibi görünmüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580103
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 760580103,
					"content": "Belki nadir bir türdür. Linnea biliyor olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580104
					],
					"speakerTitle": "Jurva"
				},
				{
					"id": 760580104,
					"content": "Aa! Paimon'un gizli hazinesini talan eden Mora hırsızı bu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760580105,
					"content": "Hırsız Gelincik kaçmaya çalışır fakat üç çocuk daha hızlı davranır. Onu saf dışı bırakmayı başarırlar ve biraz çabaladıktan sonra pes eder. Sen de fırsattan istifade olup bitenleri anlatmaya başlarsın...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760580106
					]
				},
				{
					"id": 760580106,
					"content": "Demek bunu ilk yapışı değil... O zaman ona bir ders vermeliyiz! Yanlış bir şey yaptığında cezasını çekersin. Adil olan budur, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580107
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 760580107,
					"content": "Ama... Ama o sadece bir hayvan. Doğruyu yanlışı anlamaz ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580108,
						760580109
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 760580108,
					"content": "Paimon'un Morasını geri versin de, gerisi önemli değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760580110
					]
				},
				{
					"id": 760580110,
					"content": "Neyse, önce Paimon'un Morasını geri alalım. Nasılsa gelincik para harcayamaz, hepsi orada duruyordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580111
					],
					"speakerTitle": "Jurva"
				},
				{
					"id": 760580111,
					"content": "Yaşasın! Hehe, Paimon'un gizli hazinesi geri geldi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760580112,
					"content": "Keşke onu tutabilseydik. Böylece Helka geri döndüğünde, ona nadir Hırsız Gelinciği gösterebilirdik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580113
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 760580113,
					"content": "Ne? Ama iş falan yaptıramayız ki ona... Hırsızlık iş sayılmaz! Emek olmadan yemek olmaz bir kere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760580114
					],
					"speakerTitle": "Mikko"
				},
				{
					"id": 760580114,
					"content": "Tamam, tamam ama onu ne yapacağız? Neyse, bunu daha sonra Katya ile düşünürüz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jurva"
				},
				{
					"id": 760580109,
					"content": "Hayvanların bile hayatın acımasızlığıyla yüzleşmesi gerekiyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760580110
					]
				}
			]
		}
	]
