					"nextDialogs": [
						3550703,
						3550704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550703,
					"content": "Saçımı kökünden koparmadığın iyi oldu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3550705
					]
				},
				{
					"id": 3550705,
					"content": "Bu da neydi şimdi? Paimon yenip yutulacağımızı sandı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550706,
					"content": "Bunun ejder ile konuşan tuhaf tiple kesinlikle bir ilgisi var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550707,
						3550709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550707,
					"content": "Bu dünyada ejderlerin var olduğuna inanamıyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3550708
					]
				},
				{
					"id": 3550708,
					"content": "Evet, Paimon senin neden endişelendiğini anlıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550711,
					"content": "Ah? Bu da ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550712,
					"content": "Oradaki büyük kayanın üzerinde parlak kırmızı bir şey var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3550713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550713,
					"content": "Hadi gidip daha yakından bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3550709,
