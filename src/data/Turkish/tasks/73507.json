				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735070101,
					"content": "Altın Yıldız ve Gümüş Yardımcı... Tekrar karşılaştık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070102
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070102,
					"content": "Her zamanki gibi neşelisiniz bakıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070103,
						735070106
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070103,
					"content": "Sen de oldukça dinç görünüyorsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070104
					]
				},
				{
					"id": 735070104,
					"content": "H-Haniyyah! Balfour da buradaymış!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070105,
					"content": "Sizi burada görmek ne güzel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070114,
					"content": "O halde konumuza geri dönelim. Burada ne yapıyorsunuz? Paimon doğru hatırlıyorsa burası Çiçek Jölelerini aldığımız yerdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070115,
					"content": "Ah, bizim iki büyük kahramanımız! Sadece sesinizi duymak bile özgüvenimi artırmaya yetiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070116
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070116,
					"content": "Tamam, o zaman size çalışmamız hakkındaki raporumu vereyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070117
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070117,
					"content": "Daha önce Akademi, Bilgelik Küresinin tasarımını geliştirene kadar Nilotpala Kupası Canavar Terbiyecileri Turnuvasının durması gerektiğini söylemiştiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070118
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070118,
					"content": "Hâlâ bununla ilgili bir bildiri beklediğinizi sanıyorum, doğru mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070119
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070119,
					"content": "Evet, doğru! Layla, Cyno veya bu konuda sorumlu olan araştırmacılar bir ilerleme olursa bize bildirmeliler, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070120,
						735070121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070120,
					"content": "Teknik terimleri çok da anlayabileceğini sanmıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070122
					]
				},
				{
					"id": 735070122,
					"content": "Yani durum böyle. Çok da yardımcı olamayız. Hatta araştırmalarına köstek bile olabiliriz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070123,
					"content": "Ne kadar da dikkatli ve sabırlısınız. Şahsen ben önceki turnuvanın görkemli anlarını düşündükçe heyecanla dolup taşıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070124
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070124,
					"content": "Bundan ötürü, kısa bir zaman önce bu işle ilgili Akademi çalışanlarından ayrıntıları öğrenmeye çalıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070125
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070125,
					"content": "Mevcut durumda Bilgelik Küresine yapılacak iyileştirmeler hâlâ teorik çapta. Yani, bu iyileştirmelerin pratiğe geçmesi biraz zaman alabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070126
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070126,
					"content": "Bununla birlikte turnuvanın ilk tekrarı konusundaki hararetli tartışmalar gün geçtikçe azalıyor ve hatta turnuva yavaşça unutuluyor. Önceki etkinliğin verdiği etkinin boşa gitmesine izin veremeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070127
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070127,
					"content": "Ben de bir \"tematik etkinlik\" organize etmek için Haniyyah Hanım ile bir araya geldim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070128
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070128,
					"content": "\"Tematik etkinlik\" tam olarak ne anlama geliyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070129
					]
				},
				{
					"id": 735070129,
					"content": "Masada duran Mantar şeklindeki taşlar bununla mı ilgili yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070130,
					"content": "Evet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070131
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070131,
					"content": "Bay Balfour da sıradaki turnuvanın organize edilmesi için sponsor arıyor, hatta bunun için Liyue'de birkaç pazarlama becerisi bile edinmeye çalıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070132
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070132,
					"content": "Bunu yaparken de Mekanikus Savunması adında bir oyunla karşılaştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070133
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070133,
					"content": "Sonra bu oyunun marka haklarını Sumeru için satın aldı ve benim rehberliğimde yepyeni bir oyun çıkardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070134
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070134,
					"content": "Biz buna \"Mantar Mekanikus\" diyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070135
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070135,
					"content": "Mantar Mekanikus mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070136,
					"content": "Paimon bir düşünsün... Yani bazı mantarları kontrol edip bazı makinalarla mı çarpışacağız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070137,
					"content": "Haha! Oldukça zekisin Gümüş Yardımcı. Hemen anlayıverdin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070138
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070138,
					"content": "Bu oyunun anlaşılmasının ve reklamının yapılmasının kolay olacağına ve oyunun ciddi bir potansiyele sahip olduğuna inanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070139
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070139,
					"content": "Bunu, Canavar Terbiyecisi Turnuvasının uyarlaması olarak başarılı bir şekilde tanıtabilirsek insanların aklında uzun süre yer edinebiliriz diye düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070140
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070140,
					"content": "Bu şekilde, ileride yapacağımız turnuva için daha büyük bir kitleye ve yarışmacı sayısına ulaşabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070141
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070141,
					"content": "Tabii tüm bunlara ancak ikinizin izniyle başlayabiliriz. Ne de olsa turnuvanın nasıl organize edileceği ile ilgili son sözü siz söylüyorsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070142,
						735070143
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070142,
					"content": "Bence denemeye değer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070144
					]
				},
				{
					"id": 735070144,
					"content": "#Hımm, aslında ne {NICKNAME} ne de Paimon iş yapmayı çok iyi bilir ama Paimon bu konudaki fikrini beğendi Balfour!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070145,
					"content": "Sen ve Haniyyah bu konu üzerinde uzun zamandır çalışıyorsunuz ve Paimon ikinize de inanıyor, o yüzden istediğiniz gibi yapabilirsiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070146,
					"content": "Oyunu daha oynamadık ama Paimon birçok kişinin oyuna bayılacağını düşünüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070147,
					"content": "Harika! İkinizden de izin aldığıma göre Mantar Mekanikusu tanıtmaya başlayabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070148
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070148,
					"content": "Bu oyun hâlâ test aşamasında. Bu yüzden, oyunu geliştirmek üzere insanları oyunu test etmeye davet ederek onların geri bildirimlerini almamız gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070149
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070149,
					"content": "Ve Teyvat'taki her türlü popüler oyunu deneyimlemiş olan siz ikinizin, herkesten daha iyi öneriler vereceğine eminim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070150
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070150,
					"content": "#Hadi başlayalım {NICKNAME}! Ne de olsa bu tür konularda iyisin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070151,
						735070152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070151,
					"content": "Neden beni yönettiğin izlenimine kapılıyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070153
					]
				},
				{
					"id": 735070153,
					"content": "Hehe! Ama daha önce Paimon'un sana bir sorusu var Haniyyah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070154
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070154,
					"content": "Davul Kafa ve diğerlerini mi sormak istiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070155
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070155,
					"content": "Doğru! Paimon mantar arkadaşlarımızı özledi. Onlar nasıllar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070156
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070156,
					"content": "Merak etme, çok iyiler. Hatta çok kaygısız bir hayat yaşadıklarını söyleyebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070157
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070157,
					"content": "Döner Dönek ve Blitzara, şu anda <color=#00E1FFFF>Ormos Limanı'nın kuzeyindeki geçici meskenimdeler</color>. Önceki yarışmacılardan biri onlarla ilgileniyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070158
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070158,
					"content": "Davul Kafa ve Ateş Saçan yakınlardalar. Gümüş Yardımcı, eğer istersen gidip onlarla oynayabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070159
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070159,
					"content": "#Yakınlarda mı? O halde {NICKNAME} oyunu test ederken Paimon da Davul Kafa'yı arasın, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070160,
						735070161
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070160,
					"content": "Git hadi git!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070162
					]
				},
				{
					"id": 735070162,
					"content": "Tamam, o halde vakit kaybetmeyelim. Gel Altın Yıldız, Mantar Mekanikusun erken test sürümü senin için hazır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070161,
					"content": "Sana sonra katılacağım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070162
					]
				},
				{
					"id": 735070152,
					"content": "Hadi bakalım! Altın Yıldız, işe koyulma zamanı geldi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070153
					]
				},
				{
					"id": 735070143,
					"content": "Bunun üzerinde çok çalıştın, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070144
					]
				},
				{
					"id": 735070121,
					"content": "Onlara çok da öneri verebileceğimi sanmıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070122
					]
				},
				{
					"id": 735070106,
					"content": "Siz kimdiniz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070107
					]
				},
				{
					"id": 735070107,
					"content": "#Ah, hadi ama {NICKNAME}, aklın nerede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070108,
					"content": "Beraber Nilotpala Kupası Canavar Terbiyecileri Turnuvasına katılmamış mıydık? Mantar arkadaşlarımızla takılmak çok eğlenceliydi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070109,
					"content": "O zaman Haniyyah ile tanışmıştık, Balfour da önceki etkinliğin en sorumlu çalışanıydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070110,
					"content": "Bir dakika, yoksa Davul Kafa ile Döner Dönek'i de mi unuttun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070111,
						735070112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070111,
					"content": "Aa, şimdi hatırladım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070113
					]
				},
				{
					"id": 735070113,
					"content": "Ne? Hadi ama! Paimon az daha doktor bulmaya gidecekti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070112,
					"content": "Heh, sadece şaka yapıyordum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070113
					]
				}
			]
