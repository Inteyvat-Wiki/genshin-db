				"points": []
			},
			"dialogs": [
				{
					"id": 735070301,
					"content": "Nasıldı Altın Yıldız? İlk Mantar Mekanikus tecrüben nasıl geçti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070302
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070302,
					"content": "Yüz ifadene bakılırsa sanırım henüz bir sonuca ulaşamamışsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070303,
						735070304
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070303,
					"content": "Ne de olsa sadece bir tur oynadım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070305
					]
				},
				{
					"id": 735070305,
					"content": "Doğru. Test edecek içerik az olduğu için Mantar Mekanikusun güçlü ve zayıf yanlarını belirlemek biraz zor olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070306
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070306,
					"content": "Merak etme. Haniyyah Hanım ile bir süre burada olacağız ve toplamda 7 aşama olmak üzere her gün yeni bir Mekanikus aşaması çıkaracağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070307
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070307,
					"content": "Vaktin olduğunda uğrayabilirsen yeni aşamaları test edebilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070308
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070308,
					"content": "Bu konulardan sorumlu kişi her ne kadar sen olsan da bu oyunu Haniyyah Hanım ile beraber kendi isteğimizle çıkardık. Bu yüzden buna planlarının dışında bir zaman harcaman gerekecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070309
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070309,
					"content": "Yani verdiğin hizmet için ödeme alacaksın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070310,
						735070311
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070310,
					"content": "Haha, işte buna hayır demem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070312
					]
				},
				{
					"id": 735070312,
					"content": "Haha, çok açık sözlüsün! Bunu sevdim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070313
					],
					"speakerTitle": "Balfour"
				},
				{
					"id": 735070313,
					"content": "İki Mantar için de yeterli ikamet süresi başvurusunda bulundum. Yani Mantar Mekanikusun test aşaması boyunca Ormos Limanı'nda bulunacaklar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070314
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070314,
					"content": "Yani, Gümüş Yardımcı'n da Davul Kafa ile daha fazla zaman geçirebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070315,
						735070316
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070315,
					"content": "Ne mutlu Paimon'a!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070317
					]
				},
				{
					"id": 735070317,
					"content": "Hehe, evet sen de Davul Kafa'yı görsen iyi olur. Seni çok özledi, biliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070318
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070318,
					"content": "Bunu al. Bununla Davul Kafa ve Ateş Saçan'ı besleyebilirsin. Onların en sevdiği şeydir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 735070316,
					"content": "Ben de iple çekiyorum!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070317
					]
				},
				{
					"id": 735070311,
					"content": "O Morayı bir de sonraki turnuvada gör!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070312
					]
				},
				{
					"id": 735070304,
					"content": "Daha fazla test etmem gerekiyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070305
					]
				}
			]
		},
