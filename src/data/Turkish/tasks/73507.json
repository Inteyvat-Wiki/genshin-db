					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070512,
					"content": "Ama sanırım bir taşla iki kuş vurabiliriz. Hem Mantar Mekanikusu test edeceğiz hem de mantar arkadaşlarımızla oynayacağız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735070513,
					"content": "Paimon, Davul Kafa ve Ateş Saçan ile güzelce vakit geçirip Mantarlara Muhteşem Jöle yediriyorsun.\\nPaimon ve mantar arkadaşların çok eğleniyorlar.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735070514
					]
				},
				{
					"id": 735070514,
					"content": "Hehe, bu harikaydı! Paimon'un tüm dertleri bir anda puf olup gitti!",
