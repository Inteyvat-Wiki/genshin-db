			"dialogs": [
				{
					"id": 760220201,
					"content": "Hey! Koca oğlan! Ne yaptığını sanıyorsun? Kes şunu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760220202,
					"content": "Mora... Hayır, hayır! Murasaki'yi sen öldürdün... Öleceksin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760220203
					],
					"speakerTitle": "Öfkeli Samuray"
				},
				{
					"id": 760220203,
					"content": "#Eyvah! Dikkat et {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
