			},
			"dialogs": [
				{
					"id": 741560801,
					"content": "Merhaba baba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560802
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560802,
					"content": "... Bittim ben, bittim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560803
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741560803,
					"content": "Autumn senin kaçmayı planladığını söyleyince hayrete düştüm doğrusu. Bunca zamandır kilit altındasın ama hâlâ pes etmedin gerçekten, dimdik ayaktasın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560804
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560804,
					"content": "Hatta ayağına gelen fırsatı tepmeyip kaçmak için bu iki \"adalet savaşçısından\" yardım bile istemişsin. Yaşama arzun gözlerimi yaşartıyor açıkçası, hayata var gücünle tutunuyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560805
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560805,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741560806,
					"content": "Kaçabileceğin onca yer varken tutup eskiden Autumn ile birlikte ziyaret ettiğiniz yere gelmene ne demeli peki? Seçe seçe burayı mı seçtin gerçekten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560807
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560807,
					"content": "Ben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560808
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741560808,
					"content": "Sen çeneni yorma, durum ortada zaten. İki ayağı bir pabuca girince insan aşina olduğu yolu tercih ediyor tabii, içgüdüsel şeyler bunlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560809
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560809,
					"content": "Neyse ki Autumn da senden sonra evden çıktı. Henüz buraya varmadı, ben de bu meseleyi onun önünde tartışmayı hiç istemiyorum zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560810
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560810,
					"content": "Ne akla hizmet yapıyorsun bunları sen? Gerçekten anlayamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560811
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560811,
					"content": "Evlilik kisvesi altında sanki bir parça eşyaymış gibi sattın Autumn'ı... Hem de iki kez! İlkinde onu Fontaine Şehri'nde büyük bir ev karşılığında sattın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560812
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560812,
					"content": "İkincisinde de sırf onu başından atabilmek için rastgele birini buldun. Ailenin tüm mal varlığı sana kalsın istiyordun çünkü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560813
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560813,
					"content": "Autumn ağza alınmayacak zorbalıklara ve hakaretlere maruz kalırken oralı bile olmadın. Umurunda değildi ki zaten... Sonra ikinci evliliğinden olan çocuğunu büyüt diye sana verdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560814
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560814,
					"content": "Sen ne yaptın, o çocuğu da bir kenara attın. Çocuğun bakımı karşılığında verilen parayı alıp elini eteğini çekmişsindir kesin, başka ne olacak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560815
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560815,
					"content": "Şimdi de çocuklara şeker verip evine misafirliğe davet ediyorsun ya... İnsanda azıcık utanma duygusu olur, ar damarın çatlamış senin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560816
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560816,
					"content": "Vicdanın biraz olsun sızlamıyor mu gerçekten? Hiç mi pişmanlık duymuyorsun sen yahu? Gerçekten hayret ediyorum, aklım almıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560817
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560817,
					"content": "Ben Autumn ile tanıştığımda sokaklarda yaşıyordu. İyi kalpli bir anne o.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560818
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560818,
					"content": "Öyle merhametli bir kadın ki arkadaşımın kızı Penny'yle de ilgileniyor. Penny ona o kadar düşkün ki birbirlerini bir gün görmeseler kıyameti koparıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560819
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560819,
					"content": "Durumu hâlâ lehine çevirebileceğini düşünüyorsan çok yanılıyorsun. Autumn'ın artık çok seveni var, tek dostu ben değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560820
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560820,
					"content": "Şimdi de istediğin kadar kaçıp kurtulmaya çalış bakalım. Ne yapsan fayda etmez... Dünyanın öbür ucuna da gitsen iki elim yakanda artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560821
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560821,
					"content": "Onun kadar iyi kalpli biri her gün ızdırap içinde uyanmak zorunda ama senin gibi alçakların tuzu kuru, bir elin yağda ötekisi balda hayat sürüyorsun... Batsın böyle adalet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560822
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560822,
					"content": "Böyle duygusal konuşmalar yapmanın lüzumu yok. Uğraştığına değmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560823
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741560823,
					"content": "Ha... Her şeyi duydun galiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560824
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741560824,
					"content": "Aa, demek sen Autumn'sın! Paimon nihayet olan biteni anlamaya başlıyor galiba. Bu Leroy ailesinin geçmişi de amma karmaşık çıktı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741560825,
					"content": "#Benoit'yı buraya kadar takip ettik ama işler hiç de düşündüğümüz gibi değilmiş meğer {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560826
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741560826,
					"content": "Acaba bu mevzulara burnumuzu sokmasak mı, ne dersin? Kararı sen ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7415609,
