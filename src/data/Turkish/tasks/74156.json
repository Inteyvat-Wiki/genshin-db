					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561212
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561212,
					"content": "Hayır ama daha az acı çekerek öleceksin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561213
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561213,
					"content": "*iç çeker* ... Ah Autumn, ah. Yalan söylemeyi öğrenemedin gitti. Nasıl öğreneceğiz şimdi çocuğun nerede olduğunu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561214
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561214,
					"content": "S-Siz... Aklınıza eseni yapabileceğinizi mi sandınız! Burada sizi izleyen birileri var, biliyorsunuz değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561215
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561215,
					"content": "Çok da umurumuzdaydı. Yapamayacağımızı mı sanıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561216
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561216,
					"content": "... Boş ver Autumn. Bırak artık. Baksana, kızın ne güzel bir hayat sürüyor. Varlıklı da bir ailesi var. Onu bulsan ne yapacaksın ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561217
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561217,
					"content": "Senin yanında bir oraya bir buraya sürüklensin mi istiyorsun? Sen Meropide kaçağısın, kızın da senin gibi mi yaşasın yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561218
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561218,
					"content": "Evlatlık verildi demek... Bana neden söylemedin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561219
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561219,
					"content": "En azından... İyiymiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561220
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561220,
					"content": "Bırak gideyim Autumn. Yaşasam da ölsem de senin için değişen bir şey olmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561221
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561221,
					"content": "Onu sarıp sarmalayan bir annesi var, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561222
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561222,
					"content": "Olmaz mı, tabii ki var! Annesinin göz bebeği o. Ona senden de benden de daha fazla imkan sunuyordur şüphesiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561223
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561223,
					"content": "O halde onu bulmamın bir anlamı yok... Hiçbir anlamı yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561224
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561224,
					"content": "Evet işte, anlamsız diyorum sana! Ben Fontaine Şehri'nde sahip olduğum her şeyi sana bırakacağım. Artık hiçbir şeyde gözüm yok, yeter ki bırak gideyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561225
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561225,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561226
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561226,
					"content": "Neden dalıp gittin öyle Autumn? Onu serbest bırakmayı falan aklından geçirme sakın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561227
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561227,
					"content": "Bu işten paçayı sıyırırım sandın, değil mi Benoit? Yok öyle yağma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561228
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561228,
					"content": "Öylece durup Benoit'ya zarar vermenizi izleyemem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561229
					]
				},
				{
					"id": 741561229,
					"content": "İlla burnumu sokacağım diyorsun yani... Bu meselenin seninle uzaktan yakından alakası yok ama her aşın kaşığı olmak kanında var belli ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561230
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561230,
					"content": "Herkesin imdadına yetişmeyi takıntı yapmışsın, kibirli bir yalakanın tekisin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561231
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561231,
					"content": "Gerçekten gitmesine izin mi vereceksin Autumn?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561232
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561232,
					"content": "Ben... Bilmiyorum... Ben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561233
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561233,
					"content": "*iç çeker* Ne olacak senin bu yufka yüreğin böyle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561234
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561234,
					"content": "Yine on ikiden tutturdun belli ki Benoit. Bir anneyi canevinden vurmak için evladından bahsetmek lazım tabii. Autumn... Sana yardım edecek birileri var, o yüzden ben de daha fazla uzatmayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561235
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561235,
					"content": "Nereye kadar kaçabileceksin göreceğiz tabii. Artık ya seni enseleriz ya da bizim elimizin bile erişemeyeceği bir deliğe saklanırsın. Orasını zaman gösterecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561236
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561236,
					"content": "Kurtuldum diye sevinme hiç boşuna. Dilersen dünyanın öbür ucuna git, dilersen köşe bucak kaç... Peşindeki tek kişi ben olmayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561237
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561237,
					"content": "Meropide Kalesi'nde çok arkadaş edindim. Fontaine Şehri'ne gelmeden önce de hepsi seninle tanışmak için can atıyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561238
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561238,
					"content": "Tüm servetim sizin olsun... Alın hepsini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561239
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561239,
					"content": "Hadi yine iyisin, bugün de son günün değilmiş. Arkadaşlarım seni bulmadan önce umarım birkaç gün daha hayatta kalırsın. Şimdi yıkıl karşımdan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561240
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561240,
					"content": "Benoit, Fontaine Şehri'nin tersi yönünde kaçmaya başlar. Arkasına bile bakmadan dağların arasından giden yoldan ilerleyerek gözden kaybolur.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741561241
					]
				},
				{
					"id": 741561241,
					"content": "Size gelince... Yakında Fontaine Şehri'nden ayrılacağız ve muhtemelen sizi bir daha asla görmeyeceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561242
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561242,
					"content": "Hadi gidelim artık Autumn.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561243
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561243,
					"content": "... Athos, özür dilerim, gerçekten çok özür dilerim... Evladım için... Çok özür dilerim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561245
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561244,
					"content": "Önemli değil. Bu senin kişisel meselen. Karar vermek de sana düşer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561245
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561245,
					"content": "Gidelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561246
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561246,
					"content": "Hımm... Olan biteni öğrendik en azından. Ne karmaşık bir aile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561247
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561247,
					"content": "Paimon bu olanlara ne dese bilemedi doğrusu... Ama Autumn'a da çok üzüldü şimdi. Evladına bir türlü kavuşamadı zavallı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561248
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561248,
					"content": "Neyse artık, en azından kan dökülmesini engellemiş olduk! Bu da bir şeydir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}