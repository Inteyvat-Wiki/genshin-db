			"dialogs": [
				{
					"id": 741560401,
					"content": "Off, Paimon çok stres oldu şimdi! Gönderdiği notta onu burada beklememizi söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560402,
						741560403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741560402,
					"content": "O halde bekleriz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741560404
					]
				},
				{
					"id": 741560404,
					"content": "E peki o zaman, sen bilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741560405,
					"content": "Siz sessizce sabredip bir süre daha bekledikten sonra pencere gıcırtıyla açılır ve tanıdık bir yüz belirir. Gözünü dört açarak etrafa bakınan Benoit, sizi gördükten sonra dikkatlice camdan dışarı çıkar.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741560406
					]
				},
				{
					"id": 741560406,
					"content": "Benoit, neler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741560407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741560407,
					"content": "Çabuk, acele edelim! Yakalanırsak biterim ben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741560403,
					"content": "Ona bir çift sorum olacak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741560404
					]
				}
			]
		},
