			"dialogs": [
				{
					"id": 741561202,
					"content": "Bak sen. Başımıza iş aldık, iyi mi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561203
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561203,
					"content": "Teşekkür ederim, çok teşekkür ederim! *iç çeker* Seni büyüteyim diye ne zorluklar çektim ben hayırsız Autumn seni! Sen bana sırtını dönerken bu iki yabancı arka çıkıyor yine!",
