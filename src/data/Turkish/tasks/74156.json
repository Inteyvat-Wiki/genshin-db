			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Morticia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741561101,
					"content": "Bırakalım onlar halletsin. Benden bu kadar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561102
					]
				},
				{
					"id": 741561102,
					"content": "Ah, sevgili Autumn! Bana bunu yapmaya gönlün elverecek mi gerçekten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561103
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561103,
					"content": "Cendre Nehri'nde doğan çocuklar arasında senin kadar şanslısı var mı? Ne şekerini eksik ettim, ne saten elbiseni ne de romanını... Varımı yoğumu sana harcadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561104
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561104,
					"content": "Diğer çocuklar soğukla ve açlıkla cebelleşirken sen güzel güzel elbiseler giyip köpeğine kolyeler takıyordun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561105
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561105,
					"content": "Sana bu hayatı ben sağladım, karşılığını almam gerekmez mi sence de? Bedelsiz mükafat yoktur sonuçta bu hayatta, yok öyle ekmek elden su gölden yaşamak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561106
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561106,
					"content": "Ne acımasızlığımı gördün benim? Her daim cömert davrandım sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561107
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561107,
					"content": "Otur da bir düşün Autumn. Hayatının her aşamasında sana yardım etmedim mi, her şeyini planlamadım mı ben? Başına ne geldiyse kendi kendine aldığın kararlar yüzünden geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561108
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561108,
					"content": "Ah, Bay Benoit, başladın yine dilbazlık yapmaya, nasıl da yağ gibi üste çıkıyorsun... Yok iyi kalpliymişsin yok cömert davranmışsın falan, duyan da başkalarını umursuyorsun sanacak. Kendinden başkasını düşünmezsin sen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561109
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561109,
					"content": "Senin bahsettiğin o sözde iyilikler beni daha fazla sömürebilmek içindi sadece. Bu yalanlarına karnım tok artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561110
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561110,
					"content": "Sana olan merhametimin son damlasıyla uzatmadan canını alacağım... Tabii önce bana çocuğumun nerede olduğunu söyleyeceksin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561111
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561111,
					"content": "Eski evinde de şu an yaşadığın evde de ona dair en ufak bir iz yok. Onu nereye gönderdin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561112
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561112,
					"content": "Söylersem beni bırakacak mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561113
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561113,
					"content": "Hayır ama daha az acı çekerek öleceksin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561114
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561114,
					"content": "... Söylesem de söylemesem de öleceğim yani. Heh... Madem bu işten kaçarım yok, hayatta söylemem. Uğraşıp durun şimdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561115
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561115,
					"content": "*iç çeker* ... Ah Autumn, ah. Yalan söylemeyi öğrenemedin gitti. Nasıl öğreneceğiz şimdi çocuğun nerede olduğunu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561116
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561116,
					"content": "Nerede olduğunu biliyorum tabii, hehe! Ama asla söylemem size! Hayatta olmaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561117
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561117,
					"content": "Onu asla bulamayacaksınız. Asla, asla, ASLA...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561118
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741561118,
					"content": "Onu evine götüreceğim artık. Aranızda itirazı olan var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561119
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741561119,
					"content": "Buyur götür, kimsenin itirazı yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561120
					]
				},
				{
					"id": 741561120,
					"content": "S-Siz bu meseleyi kendi başınıza halledin. Biz burnumuzu sokmayalım şimdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561121,
					"content": "Benoit aynı cümleyi sayıklamaya devam eder: \"Onu asla bulamayacaksınız, asla!\" Autumn sessizce onu oradan götürür.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741561122
					]
				},
				{
					"id": 741561122,
					"content": "Bu meselenin kimsenin kulağına gitmesini istemiyordum. Sonuçta Autumn hakkında tutuklama kararı çıkartıldı. Tabii sırf o da değil, benim için de tutuklama kararı var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561123
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561123,
					"content": "Asayiş Dairesine gidip ihbarda bulunursanız yüklü miktarda para kazanırsınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561124
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561124,
					"content": "Tabii bunu yapmanızı tavsiye etmem. Yoksa dostlarımız bir daha asla peşinizi bırakmaz. Deneyin de görün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561125,
						741561126
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561125,
					"content": "İhbarda bulunmayacağım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561127
					]
				},
				{
					"id": 741561127,
					"content": "Haha, ben de öyle düşünmüştüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561128
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561128,
					"content": "O halde buyur, bu Gökkuşağı Gülü sizin olsun. Biz bu çiçeği çok severiz, anlamı çok büyüktür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561129
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561129,
					"content": "Şu anda bir uyarı olarak veriyorum bunu. Biraz önce söylediklerinizi asla unutmamanız ve fikrinizi değiştirmemeniz için bir uyarı yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561130
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561130,
					"content": "Elveda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561131
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741561131,
					"content": "Hımm... Olan biteni öğrendik en azından. Ne karmaşık bir aile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561132,
					"content": "Paimon ne dese bilemiyor doğrusu! İyi ki daha önce gidip Asayiş Dairesine ihbarda bulunmamışız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561133,
					"content": "Paimon yine de Autumn'a çok üzüldü şimdi. Evladına bir türlü kavuşamadı zavallı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561134,
					"content": "Paimon başta Benoit'yı iyi biri sanmıştı bir de! Şey... Sence Paimon biraz fazla mı saf?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741561135,
						741561136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561135,
					"content": "E günaydın Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561137
					]
				},
				{
					"id": 741561137,
					"content": "Ayıp oluyor ama! Yine başladın Paimon'a laf sokmaya, sırası mı şimdi... Hıh! Debord Otelde güzel bir yemek ısmarla da Paimon seni affetsin hadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741561136,
					"content": "Paimon'un beyin hücreleri birer birer iflas ediyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561137
					]
				},
				{
					"id": 741561126,
					"content": "Paraya ihtiyacım yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741561127
					]
				}
			]
		},
