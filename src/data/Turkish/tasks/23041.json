			},
			"dialogs": [
				{
					"id": 230410101,
					"content": "Oh... Bu kadarı toprağı yumuşatmaya yeter herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410102
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410102,
					"content": "Hâlâ bu çiçekle mi ilgileniyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410103
					]
				},
				{
					"id": 230410103,
					"content": "Evet. Kulsoom Nine bana çiçek bakmakla ilgili çok şey öğretti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410104
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410104,
					"content": "Mesela toprağı gevşetmek, yaprakları düzenli olarak budamak, böceklerden kurtulma yöntemleri gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410105
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410105,
					"content": "Tabii bir de çok sık sulamamak gerekiyor yoksa kökler çürüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410106
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410106,
					"content": "*iç çeker* Bense her gün sulanması gerektiğini sanıyordum. Toprağı nemli tutmak gerektiğini düşünmüştüm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410107
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410107,
					"content": "Böylesi iyi oldu gerçi, artık her gün su taşımam gerekmiyor. Kuyu çok uzakta zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410108
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410108,
					"content": "Yaprakları budamaya devam etmem lazım. Bu arada sen bana ufak bir kap su getirebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410109
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410109,
					"content": "Kazan ile konuştum. Bugün çiçekleri sulayabileceğimi söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410110,
						230410111
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410110,
					"content": "Hallederim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410114
					]
				},
				{
					"id": 230410114,
					"content": "Sulama kabı şurada. Suyu çekerken dikkatli ol, kaba çok çamur girmesin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410111,
					"content": "Tüm bunları sana Kulsoom Nine mi öğretti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410112
					]
				},
				{
					"id": 230410112,
					"content": "Hımm... Sayılır. Kulsoom Nine her şeyi bilir. Ne zaman bir sorum olsa ona giderim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410113
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410113,
					"content": "Bu işi sana bırakıyorum! Ufak bir kap su yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410114
					],
					"speakerTitle": "Nermin"
				}
			]
		},
		{
