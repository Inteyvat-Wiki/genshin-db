			},
			"dialogs": [
				{
					"id": 230410301,
					"content": "Tam zamanında geldin Gezgin! Gel de yaptığım Naneli Fasulye Çorbasının tadına bak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410303
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410303,
					"content": "Çorbandaki malzemeler...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410304
					]
				},
				{
					"id": 230410304,
					"content": "Malzemelerin çoğunu birine aldırdım, Nane hariç tabii... Onu kendim yetiştirdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410305
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410305,
					"content": "Raef bana bahçe aletleri ve biraz gübre verdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410306
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410306,
					"content": "Ben de onları tek bir saksı çiçeği için kullanırsam yazık olacağını düşündüm. O yüzden Azalai'den Nane tohumu almasını istedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410307
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410307,
					"content": "Nane tohumlarını ektikten sonra da tıpkı çiçeklere baktığım gibi baktım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410308
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410308,
					"content": "Onlar da zamanla büyüyüp olgunlaştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410309
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410309,
					"content": "Ben de birazını toplayıp bu Naneli Fasulye Çorbasını yaptım. Nasıl? Tadı güzel, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410310
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410310,
					"content": "Şey... Naneli Fasulye Çorbamı yediğine göre bana bir iyilik borçlusun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410311,
						230410312
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410311,
					"content": "Daha yemeğim bitmedi bile...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410313
					]
				},
				{
					"id": 230410313,
					"content": "Dalga geçiyorum ya. Yardımın karşılığında güzel bir ödül vereceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410314
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410314,
					"content": "Bana üç Zaytun Şeftalisi getir. Raef'in en sevdiği meyvedir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410315
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410315,
					"content": "Şeftalileri Naneli Fasulye Çorbama ekleyip ona götürmek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410316
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410316,
					"content": "Naneli Fasulye Çorbasını yapmayı öğrendim, geriye tek kalan Zaytun Şeftalisi bulmak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410317,
						230410319
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410317,
					"content": "Anladım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410318
					]
				},
				{
					"id": 230410318,
					"content": "Teşekkürler! Döndüğünde sana bir kase daha Naneli Fasulye Çorbası veririm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410321
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410321,
					"content": "Hadi Zaytun Şeftalisi bulup bana getir Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410319,
					"content": "Çalışırken çorba içmeye izni var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410320
					]
				},
				{
					"id": 230410320,
					"content": "Çok zamanını almaz ki. Zaten işleri de çok yoğun değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410321
					],
					"speakerTitle": "Nermin"
				},
