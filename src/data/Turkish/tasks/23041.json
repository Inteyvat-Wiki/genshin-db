					"Nermin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230410201,
					"content": "Hayır, olamaz... Yapraklarda yine ısırık izleri var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410202
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410202,
					"content": "Ne oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410203
					]
				},
				{
					"id": 230410203,
					"content": "Şuna bak Gezgin! Yavru kedi yine çiçeklerimi yiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410204
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410204,
					"content": "Şu yaprağa bak... Bu da aynı! Hepsini ısırmış!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410205,
						230410208
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410205,
					"content": "Kedinin karnı açtır belki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410206
					]
				},
				{
					"id": 230410206,
					"content": "Raef de öyle dedi. Hatta yavru kediyi beslemeye bile gitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410207
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410207,
					"content": "Ama ertesi gün kedi yine gelip çiçeklerimi kemirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410210
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410210,
					"content": "Şimdilik sadece yaprakları yiyor ama ya dalları ısırmaya başlarsa? Felaket olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410211
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410211,
					"content": "Yine de onu kovalamak istemiyorum tabii. Köyden giderse tek gidebileceği yer çöl...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410212
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410212,
					"content": "Yavru kediyi benim için yine besler misin Gezgin? Umarım yine gelip çiçeklerimi kemirmez. Lezzetli de değiller halbuki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410213,
						230410214
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410213,
					"content": "Hallederim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410216
					]
				},
				{
					"id": 230410216,
					"content": "Neyse, yardım etmeyi kabul ettiğin için teşekkürler. Yavru kedinin en sevdiği yeri haritanda işaretleyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410217
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410217,
					"content": "Ben de o sırada kediler gelip yaprakları koparmasın diye burada çiçeklerime göz kulak olacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410214,
					"content": "Bana kedi uzmanı derler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410215
					]
				},
				{
					"id": 230410215,
					"content": "Harika! Ne zaman kedi patisi görsem üstüme atlayıp pençeleriyle saldıracak diye korkuyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410216
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 230410208,
					"content": "Belki de kedi... Bitkileri kemirmeyi seviyordur?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230410209
					]
				},
				{
					"id": 230410209,
					"content": "Ne sevdiğini bilmiyorum açıkçası...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230410210
					],
					"speakerTitle": "Nermin"
				}
			]
		},
