					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722150301,
					"content": "Hepsini astın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150302
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150302,
					"content": "Astım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150303
					]
				},
				{
					"id": 722150303,
					"content": "Miyav miyav, harika. Tapınak bunlarla cıvıl cıvıl olacak kesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150304
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150304,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150305
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150305,
					"content": "Hımm. Neden kimse gelmiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150306,
						722150307
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150306,
					"content": "Bu kadar çabuk geleceklerini pek sanmıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150308
					]
				},
				{
					"id": 722150308,
					"content": "Ah, insanlara da akıl sır ermiyor. Sen hariç tabii. Sen daha açık fikirlisin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150309
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150309,
					"content": "Henüz kimse gelmedi ama en azından şu veletler artık kaybolmayacaklar miyav.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150310
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150310,
					"content": "Taş insan, taşın çok yakında hazır olacağını söylüyor. Bittiğinde gelirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150311
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150311,
					"content": "Hımm, evet, bir şey daha vardı. Garip bir şey.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150312
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150312,
					"content": "Yeşil giyen iki insana Hibiki ve Domeki hakkında soru sormaya gittim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150313
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150313,
					"content": "Ne Hibiki'yi tanıyorlarmış ne de Hibiki hakkında bir şey biliyorlarmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150314
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150314,
					"content": "Uzun olan \"Ako Domeki\" diye biri hakkında bir şeyler okumuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150315
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150315,
					"content": "Yok \"haydut\", yok \"başına konan ödül\", yok bilmem ne... Domeki'nin kötü biri olduğunu söylemeye çalışıyordu yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150316
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150316,
					"content": "Ama bunda bir yanlışlık olmalı. Hibiki hep Domeki'yle oynardı, Domeki iyi biri olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150317
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150317,
					"content": "O insanın idraki kıt olmalı. En güvenilir insan yine sen çıktın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150318
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150318,
					"content": "Ah, Hibiki ne zaman dönecek acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150307,
					"content": "Bu işler o kadar kolay değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150308
					]
				}
			]
		}
	]
}