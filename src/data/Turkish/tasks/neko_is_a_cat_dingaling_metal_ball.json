					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722150101,
					"content": "Miyav miyav, bu heykel hık demiş burnumdan düşmüş resmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150102,
					"content": "Heykel işi nasıl gidiyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150103
					]
				},
				{
					"id": 722150103,
					"content": "Taş insan çok yakında taşı dövmeyi bitireceğini söylüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150104,
					"content": "Hibiki döndüğünde çok mutlu olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150105,
					"content": "Hımm, evet. Taş iyi, hoş ama tapınağın etrafını da süslememiz gerek, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150106,
					"content": "Şu tıngırdayan metal topları asmama yardımcı olur musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150107
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150107,
					"content": "Bunları vakti zamanında Hibiki yapmıştı. Yanlış hatırlamıyorsam Hibiki benimle ve diğer ufaklıklarla oynamayı sevdiği için Domeki vermişti bunları. Tekrar bulmak için bayağı uğraştık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150108,
					"content": "Hah. Bunlar... Çan mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150109
					]
				},
				{
					"id": 722150109,
					"content": "\"Çan\" mı? Ne olduklarını bilmiyorum ama Hibiki benimle oynarken bu metal topları kullanıyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150110
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150110,
					"content": "Metal topları yere koyardı, sonra da uzağa fırlatırdı. Hareket ettikçe tıngır tıngır ses çıkarırlardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150111,
					"content": "Güçleri ne bilmiyorum ama çıkardıkları ses beni ve diğer kedileri peşlerine takardı hep.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150112
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150112,
					"content": "Sonradan anlamaya başladım. Tapınak bu metal toplardan yoksun, bu yüzden ibadet etmeye gelen insan sayısı çok az.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150113,
					"content": "Bu sebeple senden bu metal topları yüksek yerlere asmanı isteyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150114
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150114,
					"content": "Böylece insanlar metal topların tıngırdamasını duyup yollarını kaybetmeden tapınağa gelecekler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150115,
					"content": "Bağış Kutusu Morayla dolup taşacak ve tapınak da gelişip serpilecek. Hibiki de döndüğünde çok mutlu olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150116
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150116,
					"content": "Tapınağın çevresine metal toplar asmama yardım eder misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722150117
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722150117,
					"content": "Tamamdır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722150118
					]
				},
				{
					"id": 722150118,
					"content": "Sağ ol miyav.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
