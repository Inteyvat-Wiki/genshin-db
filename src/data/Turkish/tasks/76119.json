						761190202
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761190202,
					"content": "Senin için çok mu kolay oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190203
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761190203,
					"content": "Tekrar oynamaya gelirsen şapkaları daha hızlı karıştırmaya çalışacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190204
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761190204,
					"content": "Paimon merak ediyor... Kuuhenkilerle bu oyunu tam olarak nasıl oynuyordun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190205,
					"content": "Kuuvahki kullanmadan hiçbir şey göremiyorsun ama kullanırsan da her şeyi çok net görüyorsun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190206,
					"content": "Gözlerimi açabiliyorum ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190207
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761190207,
					"content": "Ha, doğru. Paimon onu düşünmemişti...",
