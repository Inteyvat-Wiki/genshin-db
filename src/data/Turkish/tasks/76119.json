				},
				{
					"id": 761190102,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190103
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761190103,
					"content": "... Hah.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190104
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761190104,
					"content": "Eğleniyorlar galiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190105,
					"content": "Merhaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190106
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761190106,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190107
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761190107,
					"content": "Sana da merhaba Luonnotar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190108
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761190108,
					"content": "Yeni bir oyun mu oynuyorsunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190109
					]
				},
				{
					"id": 761190109,
					"content": "Evet. Sancak Gemisi'nde insanların arkadaşlarıyla bardaklı bir oyun oynadığını gördüm, ben de bu fikri ödünç aldım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190110
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761190110,
					"content": "Bir fincanın altına bir taş yerleştiriyorlardı, sonra da masanın üzerindeki fincanları hızla karıştırıyorlardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190111
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761190111,
					"content": "Durduklarında da diğer oyuncudan taşın hangi bardağın altında olduğunu tahmin etmesini istiyorlardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190112
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761190112,
					"content": "Kuuhenkiler kumaşa sarılı halde fırıl fırıl dönmeye bayılırlar, o nedenle Bayan Büyücü'nün şapkasını referans alarak bazı geliştirmeler yaptım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190113
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761190113,
					"content": "Çok tatlı olmuş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190114
					]
				},
				{
					"id": 761190114,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190115
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 761190115,
					"content": "Bir dakika. Demek Sancak Gemisi'ne gittin... Seni tanıyan oldu mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190116,
					"content": "Soranlar oldu, ben de \"Bugün Ay Tanrıçası gibi giyindim. Tıpkı ona benzemişim, değil mi?\" dedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190117
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761190117,
					"content": "Vay canına, Ay Duası Gecesindeki numarayı yapmaya alıştın resmen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190118,
					"content": "Sana inandılar mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190119
					]
				},
				{
					"id": 761190119,
					"content": "Pek sayılmaz... Ama sonrasında benimle konuşmadılar da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190120
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761190120,
					"content": "Oyunculuğum doğal değil miydi acaba? Bir dahaki sefere başka bir yerde pratik yaparım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190121
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761190121,
					"content": "Nedense tamamen yanlış dersler çıkarmışsın gibi geliyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761190122,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190123
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 761190123,
					"content": "Luonnotar nerede saklandığını tahmin etmeni istiyor. Bir tur oynamak ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190124
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761190124,
					"content": "Olur!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761190125
					]
				},
				{
					"id": 761190125,
					"content": "Öyleyse başlangıç olarak 100.000 Mora koy lütfen. Ne de olsa bunlar Sancak Gemisi'nin kuralları.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761190126
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761190126,
					"content": "Bak işte o dersi kesinlikle atlamalıydın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
