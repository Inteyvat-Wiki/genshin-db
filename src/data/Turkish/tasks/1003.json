						10031013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031013,
					"content": "Handa Şahit Mührü olarak bilinen bir kaligrafi resmi var. Neredeyse bin yıldır el değiştiriyor, ona bir bakın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
