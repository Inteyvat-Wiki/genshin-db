			},
			"dialogs": [
				{
					"id": 10030401,
					"content": "Bana bu Adeptustan bahset.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030402
					]
				},
				{
					"id": 10030402,
					"content": "Xiao'yla tanıştınız mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030403
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030403,
					"content": "Fena değil. Çoğu zaman insanlarla konuşacak kadar keyifli olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030404
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030404,
					"content": "Bu onun keyifli hali mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030405,
					"content": "Evet, Adeptuslara rastlamak oldukça zordur. Çoğu insan hayatları boyunca onlara dua eder ama onları bir kere bile göremez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030406
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030406,
					"content": "Toprak Hükümdarı Liyue'yi oluşturduğunda Adeptusların gücünü ödünç aldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030407
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030407,
					"content": "Ancak Adeptuslar Liyue'yi yalnızca savaşarak korumayı biliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030408
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030408,
					"content": "Bu yüzden bin yıllardır Adeptuslar şehir dışında, uzaklarda saklanarak yaşarken Liyue'yi insanlar yönetti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030409
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030409,
					"content": "Oldukça bilgilisin, değil mi patron hanım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030410,
					"content": "\"Patron hanım\" değil, sadece patron...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030411
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030411,
					"content": "Her neyse, Adeptusların lütfunu aldığınıza göre artık işler çok daha kolay olacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030412
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030412,
					"content": "Görüşümü merak ediyorsanız... Xiao'nun keyfini bozmazsanız sorun çıkmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030413
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030413,
					"content": "Keyfini bozmamak mı? Bu \"Bekçi Yaksha\" için \"keyifli hal\" nasıl bir şey tahmin edemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030414,
					"content": "Haha! İlginç olacak değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030415
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030415,
					"content": "(Şimdi düşününce hiç güldüğünü de görmedim...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030416
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030416,
					"content": "Şöyle yapalım, sen şeften bir kase Badem Tofusu iste bir de iyi yapabildiğin yemekten bir tabak yap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030417
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030417,
					"content": "Badem Tofusu Xiao'nun sevdiği birkaç insan yemeğinden biri. Diğer yemek sana kalmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030418
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10030418,
					"content": "#Bize mi kalmış? {NICKNAME}, sence en iyi pişirdiğin yemek ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030419,
						10030421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030419,
					"content": "Sanırım Doyurucu Salata.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030420
					]
				},
				{
					"id": 10030420,
					"content": "Yani onu kötü yapmak oldukça zor, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030423,
					"content": "Ancak bir Adeptus için yemek yapacaksak Doyurucu Salata daha güvenilir bir seçenek gibi duruyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030421,
					"content": "Belki Maha Manjusaka Sıcak Ateş Bodurlopu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030422
					]
				},
				{
					"id": 10030422,
					"content": "Vay be! Bunu daha önce hiç duymamıştım, Paimon bunu denemek istiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030423
					],
					"speakerTitle": "Paimon"
				}
			]
		},
