					"nextDialogs": [
						10031009
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10031009,
					"content": "Bu yüzden zarar görmemeniz için ben Adeptusla uğraşırken siz de hayaletle eğitim yapmaya başlayabilirsiniz.",
