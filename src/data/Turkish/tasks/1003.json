			"dialogs": [
				{
					"id": 10030601,
					"content": "Molada olduğumu göremiyor musun evlat? Kaybol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030602
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 10030602,
					"content": "Pardon, biz bir Badem To...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030603
					]
				},
				{
					"id": 10030603,
					"content": "Kaybol!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030604
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 10030604,
					"content": "Bu şefin hizmeti en az Mondstadt'taki Wagner kadar iyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030605,
					"content": "Bizi patron Goldet gönderdi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030606
					]
				},
				{
					"id": 10030606,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030607
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 10030607,
					"content": "Anladım. Patron gönderdiyse başka seçeneğim yok, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030608
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 10030608,
					"content": "Ancak şu anda kendimi vererek yapabileceğimi sanmıyorum, Badem Tofusu gibi özen isteyen bir tatlı için yeterli motivasyonum yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030609
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 10030609,
					"content": "Nedenmiş o?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030610,
					"content": "Bir şefin elleri tıpkı bir eskrimcinin elleri gibi olmalı, titrememeli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030611
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 10030611,
					"content": "Ancak benim ellerim... Titriyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030612
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 10030612,
					"content": "Çünkü zamanında bir gezgin bana bu hanın... Lanetli olduğunu söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030613
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 10030613,
					"content": "Ve az önce... Az önce mutfakta... Bir şey gördüm... Olmaması gereken bir şey.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030614
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 10030614,
					"content": "(Şef çok göz korkutucu duruyor ancak hayaletlerden bahsettiği anda zayıf biri gibi görünüyor.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10030615,
					"content": "Wangshu Hanının... Güvenli olmadığını düşünüp duruyorum. Ben... Ellerim Badem Tofusu yapamayacak kadar titriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030616
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 10030616,
					"content": "#Tamam {NICKNAME}. Yüksek kaliteli Badem Tofusu için gidip mutfağı incelememiz gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
