				{
					"id": 10039405,
					"content": "Söylentileri duydum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10039406
					]
				},
				{
					"id": 10039406,
					"content": "Hahaha, Yedi Yıldız ile bağlantım olmadan bu konumda bir han işletmem çok zor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039407
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039407,
					"content": "Yani tabii ki onların onayına ihtiyacım var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039408
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039408,
					"content": "Kalan tüm saçmalıklar ise sadece söylentiden ibaret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039409
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039409,
					"content": "Saçmalık demişken; paylaşmak istediğiniz ilginç haberler var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 10039410,
					"content": "Bu kedicik kim?",
