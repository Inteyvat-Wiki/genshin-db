						221030202
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030202,
					"content": "Henüz değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030203
					]
				},
				{
					"id": 221030203,
					"content": "Bu işi vaktinde bitirmemiz çok önemli. Bu genç beyefendinin ne zaman gelip ne zaman gittiği hiç belli olmuyor. Beklenmedik bir anda çıkıp gelebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030204
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030204,
					"content": "Geldiğinde de işlerimiz bir süre aksayabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				}
			]
		},
