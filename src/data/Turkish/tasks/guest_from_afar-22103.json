						221030302
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030302,
					"content": "Evet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030303
					]
				},
				{
					"id": 221030303,
					"content": "Harika. Çok rahatladım. Artık işimize dönebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030304
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030304,
					"content": "Anlaştığımız üzere işte ücretin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030305
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030305,
					"content": "Hımm. Genç beyefendi mi? Onu buralarda görmüş olabileceğini tahmin etmem gerekirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030306
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030306,
					"content": "Onu hanın çatısında dinlenirken görmüş olabilir misin? Genelde orada takılır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030307
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030307,
					"content": "Ancak onu görecek olursan lütfen rahatsız etmemeye çalış. Rahatsız edilmekten pek hoşlanmıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				}
			]
		}
