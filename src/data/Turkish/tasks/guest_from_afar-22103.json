			},
			"dialogs": [
				{
					"id": 221030101,
					"content": "Ne büyük saçmalık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030102
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030102,
					"content": "Sorun ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030103
					]
				},
				{
					"id": 221030103,
					"content": "Ah, misafirlerimden biri misin? Lütfen kusura bakma, son zamanlarda buralarda sıra dışı şeyler yaşanıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030104
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030104,
					"content": "Misafirlerimiz sürekli olarak bu çevrede canavarların saldırısına uğruyorlar. Bu nedenle birçoğu artık burada kalmak istemiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030105
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030105,
					"content": "Bu iş böyle devam ederse durum iyice kontrolden çıkacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030106
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030106,
					"content": "Görünüşüne bakılırsa sen Gezgin olmalısın, değil mi? Acaba han adına gidip bu işi halledebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030107,
						221030108
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030107,
					"content": "Tamam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030109
					]
				},
				{
					"id": 221030109,
					"content": "Teşekkür ederim, çok naziksin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030113
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030113,
					"content": "O yüzden bu işle sen ilgilensen daha iyi olur. Karşılığında sana güzel bir ödeme yapabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030108,
					"content": "Canavarlar tehlikeli mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221030110
					]
				},
				{
					"id": 221030110,
					"content": "Pek değiller. Aslında, diğer sorunlarımın yanında önemsiz sayılırlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030111
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030111,
					"content": "Asıl sorun şu ki, genç bir beyefendi var, içlerinden birisi ona denk gelecek olursa işte o zaman...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030112
					],
					"speakerTitle": "Verr Goldet"
				},
				{
					"id": 221030112,
					"content": "Nasıl anlatsam? Onun sorun çözme şekli biraz farklı. Kendisi çevresindekileri pek düşünmeden hareket ediyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221030113
					],
					"speakerTitle": "Verr Goldet"
				}
			]
		},
