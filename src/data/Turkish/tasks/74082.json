			"dialogs": [
				{
					"id": 740820401,
					"content": "(Üstündeki yazıların çoğu kazınmış ama \"... Berrak çiyler... Üç...\" sözcüklerini okuyabiliyorsun.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820402
					],
					"speakerTitle": "Gizemli Sunak"
				},
				{
					"id": 740820402,
					"content": "Off! Buradaki kelimeler de kazınmış! Biri bir şeyler saklıyor kesin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820403,
						740820406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820403,
					"content": "\"Berrak çiy\" mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820404
					]
				},
				{
					"id": 740820404,
					"content": "Berrak çiy neyi temsil eder ki? Kristal gibi berrak çiy mi? Ama her yerde su var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820405,
					"content": "Bir de \"üç\" yazıyor, acaba üç damla su olabilir mi? Off, ne kadar sinir bozucu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820409,
					"content": "Hadi Paimon, senin hazine tespit edebilen süper hassas hislerine soralım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820410
					]
				},
				{
					"id": 740820410,
					"content": "Paimon zaten sordu! N-Neyse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820411,
					"content": "Her neyse, cevap üç ve su ile ilgili bir şey, hadi etrafa bakalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820406,
					"content": "Üç mü?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820407
					]
				},
				{
					"id": 740820407,
					"content": "Üç şeyi mi kastediyor acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820408,
					"content": "Berrak çiy acaba kristal gibi berrak çiy mi? Ama her yerde su var! Off, ne kadar sinir bozucu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820409
					],
					"speakerTitle": "Paimon"
				}
			]
		},
