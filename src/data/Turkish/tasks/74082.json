			"dialogs": [
				{
					"id": 740821001,
					"content": "Harika, bir anahtar daha aldık. Şimdi tek yapmamız gereken sonuncu anahtarı bulmak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821002,
					"content": "Anahtar, anahtar, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821003
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821003,
					"content": "Aa, Pahsiv! Sen nereden çıktın öyle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821004,
					"content": "Kayboldu, Pahsiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821005
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821005,
					"content": "Pekala o zaman... Paimon daha önce hiç böyle eşsiz bir Melusina ile karşılaşmamıştı... Ayrıca Paimon bütün Melusinaların ya Fontaine Şehri'nde ya Merusea Köyü'nde yaşadığını düşünüyordu. Sen neden buradasın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821006,
					"content": "Fontaine Şehri? Merusea Köyü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821007
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821007,
					"content": "Kafan karıştı sanki. O yerleri duymadın mı hiç?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821008,
					"content": "Fontaine Şehri, Melusina... Merusea Köyü, Melusina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821009
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821009,
					"content": "Ha... Erinnyes, Pahsiv, ev.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821010
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821010,
					"content": "Erinnyes, Pahsiv, koru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821011
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821011,
					"content": "Bir dakika, yani senin evin burası mı? Sen de onu koruyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821012,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821013
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821013,
					"content": "Ama Melusinalar Merusea Köyü'nde yaşamıyor muydu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740821014
					]
				},
				{
					"id": 740821014,
					"content": "Evet, biraz garip. Bazı Melusinalar farklı yerlerde mi doğuyor? Paimon burada başka hiç Melusina görmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821015
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821015,
					"content": "Pahsiv, burada yalnız mı yaşıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821016,
					"content": "Yalnız? Melusina. Nevale! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821017
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821017,
					"content": "... Nevale mi? Nevale mi var? Kim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821018,
					"content": "#... Nevale! Paimon, Paimon, {NICKNAME}, {NICKNAME}. Nevale, Nevale!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821019
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821019,
					"content": "Peki Nevale kim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740821020
					]
				},
				{
					"id": 740821020,
					"content": "Pahsiv... Nevale'nin isminin aslında \"Nevale\" olduğunu mu söylemeye çalışıyorsun? Paimon'un isminin Paimon olması gibi mi yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821021
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821021,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821022
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821022,
					"content": "Aha! Haklıymışım. Paimon zeki olduğunu söylemişti, öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821023,
						740821024
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821023,
					"content": "Çok garip bir isimmiş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740821025
					]
				},
				{
					"id": 740821024,
					"content": "Süper bir isimmiş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740821025
					]
				},
				{
					"id": 740821025,
					"content": "Nevale, Pahsiv, bilgi, bam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821026
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821026,
					"content": "Hımm... Nevale sana bir şeyler mi öğretiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821027
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821027,
					"content": "Pahsiv! Bir sürü. Dil, bilgi... Bir sürü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821028
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821028,
					"content": "Şey, Paimon \"bir sürü\" olduğunu pek sanmıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821029
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821029,
					"content": "Pahsiv, Nevale, koru, bam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821030
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821030,
					"content": "Yani senin burayı korumana yardım mı ediyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821031
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821031,
					"content": "Melusina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821032
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821032,
					"content": "Sen mi onun burayı korumasına yardım ediyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740821033
					]
				},
				{
					"id": 740821033,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821034
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821034,
					"content": "Demek öyle... Ama kim ki Nevale? Neden burayı korumak için senin yardımına ihtiyacı var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821035
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821035,
					"content": "Burada da kötü şeyler yaşanmış. Taş tableti gördük, birileri üzerindeki yazıları kazımış. Ayrıca bir sürü pislik gördük... Etrafta düşmanlar mı var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821036
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740821036,
					"content": "Meraklı Paimon, Pahsiv! Ama zaman değil bir sürü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821037
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821037,
					"content": "Anahtar, anahtar, anahtar, meydan, batı, bam, bam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821038
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740821038,
					"content": "Elimizden geldiğince hızlı olacağız!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740821039
					]
				},
				{
					"id": 740821039,
					"content": "#Paimon, Pahsiv! {NICKNAME}, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740821040
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740831040,
					"content": "Pahsiv mutlulukla iki defa sıçrar ve aceleyle oradan ayrılır.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740831041
					]
				},
				{
					"id": 740821041,
					"content": "Zamanımız çok kısıtlı galiba. İki anahtarı aldık ama zaten, hadi çabuk olalım ve üçüncü anahtarı da alalım!",
					"roleType": "TALK_ROLE_NPC",
