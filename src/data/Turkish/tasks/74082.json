			"dialogs": [
				{
					"id": 740820701,
					"content": "Sunakta ışıl ışıl parlayan bir su incisi belirir.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740820702
					]
				},
				{
					"id": 740820702,
					"content": "Şey, bu su damlası... Hazine olamaz, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820703,
					"content": "Hazineye benzemiyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820704
					]
				},
				{
					"id": 740820704,
					"content": "Paimon da öyle düşünüyor. Bu kadar kolay olamaz. Ama o zaman bu ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820705,
						740820710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820705,
					"content": "İblis Kral'ı tutan anahtar olabilir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820706
					]
				},
				{
					"id": 740820706,
					"content": "Ne? Öyleyse felaket olur! Çabuk yerine geri koy. Geç kaldıysak yandık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820707,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820708
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820708,
					"content": "Eyvah! İblis Kral geldi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820709,
					"content": "İblis Kral? Melusina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820715
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820715,
					"content": "Ayy, Paimon'un ödünü kopardın... Bir Melusina ha? Burada ne işin var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820716,
					"content": "Anahtar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820717
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820717,
					"content": "Anahtar mı? Ne anahtarı? Bu su damlası bir anahtar mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820718,
					"content": "Pahsiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820719
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820719,
					"content": "Şey... Su damlası Pahsiv mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820720,
					"content": "Melusina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820721
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820721,
					"content": "Ay! Ne demek istiyorsun? Su damlası bir Melusina mı? Paimon'un aklı çorbaya döndü. Ne oluyor ya? Buradaki Melusina sen değil misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820722
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820722,
					"content": "Pahsiv...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820723
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820723,
					"content": "Şey... Sen bir Pahsiv misin? Yoksa senin adın mı Pahsiv? Bir dakika... Hayır, cevap verme. Paimon'un aklı iyice karışır yoksa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820724,
					"content": "Her neyse, Paimon sana Pahsiv demeye karar verdi. Olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820725,
					"content": "Melusina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820726
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820726,
					"content": "#{NICKNAME}... Ne yapsak? Paimon söylediklerinden hiçbir şey anlamadı. Ne söylemeye çalışıyor ki acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820727,
					"content": "Bizim söylediklerimizi anlayabiliyorsun, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820728
					]
				},
				{
					"id": 740820728,
					"content": "Pahsiv...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820729
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820729,
					"content": "Bu su damlası bir anahtar mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820730
					]
				},
				{
					"id": 740820730,
					"content": "Pahsiv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820731
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820731,
					"content": "Sen bir insan değilsin, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820732
					]
				},
				{
					"id": 740820732,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820733
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820733,
					"content": "Şey... Birden yükselmene gerek yok, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820734,
					"content": "Ben bir insan değilim, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820735
					]
				},
				{
					"id": 740820735,
					"content": "M-Melusina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820736
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820736,
					"content": "Aa! Bir dakika! Paimon anlamaya başladı galiba. \"Pahsiv\" evet, \"Melusina\" ise hayır demek. Böyle olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820737
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820737,
					"content": "Pahsiv! Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820738
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820738,
					"content": "Senin adın Pahsiv değilmiş öyleyse. Kusura bakma, Paimon az önce ismini yanlış anladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820739,
					"content": "Pahsiv... Sevdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820740
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820740,
					"content": "Bu ismi sevdin mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820741
					]
				},
				{
					"id": 740820741,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820742
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820742,
					"content": "#Harika! O zaman Paimon sana Pahsiv diyecek, hehe. Bu {NICKNAME}. Seninle tanıştığımıza memnun olduk Pahsiv. Paimon daha önce hiç senin gibi bir Melusina ile karşılaşmamıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820743
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820743,
					"content": "#Paimon, Pahsiv! {NICKNAME}, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820744
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820744,
					"content": "Erinnyes... Melusina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820745
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820745,
					"content": "Erinnyes nereden çıktı şimdi? Hımm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820746
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820746,
					"content": "Erinnyes ile ilgili bir sorun mu var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820747
					]
				},
				{
					"id": 740820747,
					"content": "Erinnyes, Melusina, şimdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820748
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820748,
					"content": "Pahsiv, Erinnyes, koru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820749
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820749,
					"content": "Erinnyes'in başına kötü bir şeyler geliyor ve sen de onu korumak mı istiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820750
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820750,
					"content": "#Paimon, {NICKNAME}, Erinnyes, bam, bam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820751
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820751,
					"content": "#Hımm... Bu sefer beş kelime söyledi. O zaman... {NICKNAME} ve Paimon'un Erinnyes'i yumruklamasını mı istiyorsun? BAM diye?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820752
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820752,
					"content": "Melusina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820753
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820753,
					"content": "Yardım etmemizi mi istiyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820754
					]
				},
				{
					"id": 740820754,
					"content": "Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820755
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820755,
					"content": "Tamam, bizden yardım istiyor. Orasını anladık en azından. Paimon, Erinnyes'i nasıl yumruklayacağımızı pek anlamadı ama, sonuçta kocaman ada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820756
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820756,
					"content": "Bam, bam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820757,
						740820761
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820757,
					"content": "Ödül olacak mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820758
					]
				},
				{
					"id": 740820758,
					"content": "Ö... dül?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820759
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820759,
					"content": "#Yapma şimdi {NICKNAME}! Pahsiv zaten zar zor konuşuyor! Kendisine yardımcı olacak başkasını bulamaz, bizim yardım etmemiz lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820760
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820760,
					"content": "Ne yapmamız gerek?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820762
					]
				},
				{
					"id": 740820762,
					"content": "Anahtar, anahtar, anahtar, sayı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820763
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820763,
					"content": "Peki ya sonra? Kaç anahtar var bu arada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820764
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820764,
					"content": "Anahtar! Anahtar! Anahtar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820765
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820765,
					"content": "Üç anahtar mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820766
					]
				},
				{
					"id": 740820766,
					"content": "Pahsiv! Anahtar, sisli yol, güney...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820767
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820767,
					"content": "Anahtar, pınar, kuzey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820768
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820768,
					"content": "Anahtar, söğüt, doğu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820769
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820769,
					"content": "Ha, demek öyle... Hemen not edelim... Toplamda üç anahtar var; biri güneydeki sisli yolda, diğeri kuzeydeki pınarda ve sonuncusu da doğudaki söğütlerde... Paimon doğru anlamış mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820770
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820770,
					"content": "Anahtar, anahtar, anahtar, meydan, batı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820771
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820771,
					"content": "Batıdaki meydanda üç anahtar mı var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820772
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820772,
					"content": "Üç anahtarı da toplayıp meydana mı gidelim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820773
					]
				},
				{
					"id": 740820773,
					"content": "#Paimon, Melusina! {NICKNAME}, Pahsiv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820774
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820774,
					"content": "#Aşk olsun Pahsiv, neden hep {NICKNAME} Paimon'dan daha zekiymiş gibi davranıyorsun? İkimizin de zeka düzeyi aşağı yukarı aynı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820775
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820775,
					"content": "Her neyse, elimizde zaten bir tane anahtar var. Şimdi tek yapmamız gereken diğer ikisini bulmak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820776
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820776,
					"content": "Erinnyes, Melusina... Pahsiv, koru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820777
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820777,
					"content": "Sakin ol. Paimon ne olduğunu bilmiyor ama Erinnyes'i korumana yardımcı olacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820778
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820778,
					"content": "İzin verirsen Paimon ufak bir parantez açmak istiyor Pahsiv. Olur da şöyle parlak, yuvarlak, istenmeyen veya pahalı görünen bir sandık görürsen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820779
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820779,
					"content": "Şey, bize haber verirsen çok seviniriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820780
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820780,
					"content": "Pahsiv anlamaya çalışırken kafasını kaşır, ardından mutlulukla iki defa sıçrar ve aceleyle oradan ayrılır.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740820781
					]
				},
				{
					"id": 740820781,
					"content": "#Aa, koştu gitti hemen. Yapması gereken acil bir işi var herhalde. {NICKNAME}, gidip diğer iki anahtarı arayalım mı şimdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820761,
					"content": "Ne yapmamız gerek?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820762
					]
				},
				{
					"id": 740820710,
					"content": "Belki de bunu başka biri koydu buraya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820711
					]
				},
				{
					"id": 740820711,
					"content": "Ne? Of, o zaman biz hırsız sayılırız. Ayy, Paimon çok özür diliyor... Hadi hemen yerine geri koyalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820712,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820713
					],
					"speakerTitle": "Pahsiv"
				},
				{
					"id": 740820713,
					"content": "Olamaz! Sahibi geri döndü!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820714,
					"content": "Sahibi? Melusina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820715
					],
					"speakerTitle": "Pahsiv"
				}
			]
		},
