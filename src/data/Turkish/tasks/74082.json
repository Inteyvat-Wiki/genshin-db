				]
			},
			"dialogs": [
				{
					"id": 740820101,
					"content": "(Üstündeki yazıların çoğu kazınmış ama \"... Berrak çiyler... Sisli Orman Yolunda şarkı söyler...\" sözcüklerini okuyabiliyorsun.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820102
					],
					"speakerTitle": "Oymalı Taş Tablet"
				},
				{
					"id": 740820102,
					"content": "Vay canına! Kelimelerin çoğu okunmuyor! Eğlencelerin tanıtımına benziyor, öyle değil mi? Of, bazı turistler gerçekten çok düşüncesiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820103,
					"content": "Turistler genelde yazı yazmaz mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820104
					]
				},
				{
					"id": 740820104,
					"content": "#Hımm... Doğru dedin, \"{NICKNAME} ve Paimon buradaydı\" gibi şeyler yazarlar... Hayır! Bekle bir dakika! Biz iyi insanlarız, öyle bir şey yapamayız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820105,
					"content": "O zaman bu garip değil mi? Neden kelimeleri kazıyıp silmişler ki? Ve neden sadece belirli bir kısmını bırakmışlar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820106,
					"content": "Bu cümlenin de çoğu gitmiş azı kalmış! Tamamen kazımayı başaramamışlar ama. Hadi yine iyisin Sisli Orman Yolu, ucuz kurtulmuşsun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820107,
					"content": "Bu \"Sisli Orman Yolu\" ne acaba?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820108
					]
				},
				{
					"id": 740820108,
					"content": "Hımm... Acaba orman yollarının çok sisli olduğunu mu anlatıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820109,
					"content": "Paimon gidip bir bakmak istiyor! Aslında düşününce gizli hazineye giden bir yol gibi geliyor kulağa, ne dersin? Kitaplarda öyle oluyor hep. Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820110,
						740820111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820110,
					"content": "Senin kitap okuduğun mu var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820112
					]
				},
				{
					"id": 740820112,
					"content": "Aşk olsun! Paimon bütün günü yemek yiyerek geçirmiyor herhalde! Paimon'un içinden bir ses Sisli Orman Yolunda gizli bir hazine olduğunu söylüyor, bu yüzden kapatmaya çalışmışlar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820113,
					"content": "#{NICKNAME}, işte şimdi hazine bulma ustası biricik dostun Paimon'la birlikte hazine avına çıkma zamanı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740820111,
					"content": "Senin kütüphaneye gittiğin mi var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820112
					]
				}
			]
		},
