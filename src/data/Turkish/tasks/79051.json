			"dialogs": [
				{
					"id": 790510101,
					"content": "Burada bir günlük var, üstelik gayet sağlam duruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510102
					],
					"speakerTitle": "Oku"
				},
				{
					"id": 790510102,
					"content": "Oh be... İçim rahatladı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510103
					],
					"speakerTitle": "Oku"
				},
				{
					"id": 790510103,
					"content": "İçini kemiren meselelerin üstesinden gelmiş ve çizim becerilerini geliştirmiş! Paimon'a sorarsan ileride başarılı olacağına şüphe yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510104
					],
					"speakerTitle": "Oku"
				},
				{
					"id": 790510104,
					"content": "Yine de Su Damlacığı dostlarını geride bırakması Paimon'a biraz üzücü geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510105,
						790510106
					],
					"speakerTitle": "Oku"
				},
				{
					"id": 790510105,
					"content": "Her sanatçı taklidi kabullenmez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510107
					]
				},
				{
					"id": 790510107,
					"content": "Hımm, Paimon bunu anlayabiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510108
					],
					"speakerTitle": "Oku"
				},
				{
					"id": 790510108,
					"content": "Yine de hâlâ Paimon'un kafasını karıştıran bir şey var. Bu günlükte duvar resminin şeklini kaybedip kayabileceğini söylemiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510109
					],
					"speakerTitle": "Oku"
				},
				{
					"id": 790510109,
					"content": "Yine de böyle ciddi bir kazadan sonra bile bu duvar resmi gayet sağlam kalmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510110,
						790510111
					],
					"speakerTitle": "Oku"
				},
				{
					"id": 790510110,
					"content": "Su Damlacıkları sayesinde olmalı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510112
					]
				},
				{
					"id": 790510112,
					"content": "Doğru ya! Su Damlacıkları demek o yüzden Akış Yansıtıcıya ve duvar resmini eski haline getirme meselesine bu kadar hakimdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510113
					],
					"speakerTitle": "Oku"
				},
				{
					"id": 790510113,
					"content": "Paimon duygulanmaya başladı doğrusu... Su Damlacıkları pek akıllı görünmüyorlar ama aslında çok düşünceli ve sadık dostlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Oku"
				},
				{
					"id": 790510111,
					"content": "Dostlarının duvar resmini korumuşlar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510112
					]
				},
				{
					"id": 790510106,
					"content": "Kendi tarzını oluşturma konusunda ısrarcı olmak gayet doğal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510107
					]
				}
			]
		},
