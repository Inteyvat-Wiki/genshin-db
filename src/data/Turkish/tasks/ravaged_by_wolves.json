			},
			"dialogs": [
				{
					"id": 4530601,
					"content": "Araştırmanız nasıl gidiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530602
					],
					"speakerTitle": "Muhteşem Hopkins"
				},
				{
					"id": 4530602,
					"content": "Ayaktasın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530603,
					"content": "Şükürler olsun iyileştim. Cehennemin derinliklerinden çıkmayı başardım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530604
					],
					"speakerTitle": "Muhteşem Hopkins"
				},
				{
					"id": 4530604,
					"content": "Ee Favonius Şövalyeleri, neler buldunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530605
					],
					"speakerTitle": "Muhteşem Hopkins"
				},
				{
					"id": 4530605,
					"content": "Bölgedeki kurt kürkünü inceledikten sonra kurtların, Kurtlar Diyarı'ndan olduğu sonucuna vardık. Bundan öteye geçemedik henüz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530606
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530606,
					"content": "Lütfen soğukkanlılığınızı koruyun. Hemen Kurtlar Diyarı'na gidip bu işi çözeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530607
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530607,
					"content": "Favonius Şövalyeleri bu tehlikenin devam etmesine daha fazla izin vermeyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530608
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530608,
					"content": "Güzel. Geç olsun güç olmasın diyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530609
					],
					"speakerTitle": "Muhteşem Hopkins"
				},
				{
					"id": 4530609,
					"content": "Ne kadar kabasın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530610,
					"content": "Bu arada biz de bu konuyla kendi başımıza baş etmek durumundayız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530611
					],
					"speakerTitle": "Muhteşem Hopkins"
				},
				{
					"id": 4530611,
					"content": "Lütfen aptalca bir şey yapmayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530612
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530612,
					"content": "Hah! Biz buralarda işleri biraz farklı yürütürüz. Sizin gibiler yöntemlerimize pek aşina değildir. Yaptıklarının bedelini ödeyecekler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530613
					],
					"speakerTitle": "Muhteşem Hopkins"
				},
				{
					"id": 4530613,
					"content": "Görüşürüz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530614
					],
					"speakerTitle": "Muhteşem Hopkins"
				},
				{
					"id": 4530614,
					"content": "Çok kötü, cidden çok kötü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530615
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 4530615,
					"content": "Nedir kötü olan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530616,
					"content": "Geleceğe bakışları demek istedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530617
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 4530617,
					"content": "Bence de.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530618
					]
				},
				{
					"id": 4530618,
					"content": "Gençler bazen düşüncesizce hareket edebiliyor. Mahzuru yoksa onlara göz kulak olup başlarını belaya sokmalarına engel olsanız ne iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530619
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 4530619,
					"content": "Hiç mahzuru yok. Biz bunun için varız. Gerçi o çocuğun ağzından bal da damlamıyordu ama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530620
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530620,
					"content": "Bize bırakın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530621
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4530621,
					"content": "İstikamet Kurtlar Diyarı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
