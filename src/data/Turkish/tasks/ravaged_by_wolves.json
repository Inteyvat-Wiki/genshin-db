			"dialogs": [
				{
					"id": 4530701,
					"content": "Bu pençe izleri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530702,
					"content": "Pençe izlerine bakarak kaç kurt olduğunu ve boyutlarını anlayabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530703,
					"content": "Bu sefer en az iki kurt varmış, bir de şey olmalılar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530704,
					"content": "Ne olmalılar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530705
					]
				},
				{
					"id": 4530705,
					"content": "Evet, evet! En az... En az iki metre boyunda olmalılar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4530706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4530706,
					"content": "... Paimon, hayatında hiç kurt görmedin mi sen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4530707
					]
				},
				{
					"id": 4530707,
					"content": "Ne olmuş! Kurtlar gizemli yaratıklardır, her gün görmüyorsun sonuçta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
