					"nextDialogs": [
						205030504
					]
				},
				{
					"id": 205030504,
					"content": "Ah. Evet. Unutmuştum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030505
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030505,
					"content": "Bunlar iş görür sanırım. Bir şeyler çıkarabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030506
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030506,
					"content": "Sipariş vermek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030503,
					"content": "Beni Demir Parçası almam için yollamıştın, unuttun mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030504
