			"dialogs": [
				{
					"id": 205030201,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030202,
						205030204
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030202,
					"content": "Bir silah arıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030203
					]
				},
				{
					"id": 205030203,
					"content": "O taraftalar. İstediğini seç, farklı bir şeye ihtiyacın olursa da istediğini yapabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030207
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030207,
					"content": "Vay be, siparişe göre silah da yapıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205030208,
					"content": "Elbette. Silah satar, siparişe göre yapar ve saflaştırırım. Hepsi demircilik mesleğinin doğasında var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030209
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030209,
					"content": "Tek ihtiyacın cevher.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030210,
						205030212
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030210,
					"content": "Cevheri nereden bulabilirim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030211
					]
				},
				{
					"id": 205030211,
					"content": "Herhangi bir yerden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030214
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030214,
					"content": "Şaşırmış gibisin. En yakın maden yatağının yerini söyleyeyim o halde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030215
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030215,
					"content": "Biraz cevher getir, ihtiyacın olan silahı yapmana yardım edeyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030216
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030216,
					"content": "Harika. Teşekkürler!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030217
					]
				},
				{
					"id": 205030217,
					"content": "Önemli değil. Yapacak başka işlerim var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030212,
					"content": "Sen satıyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030213
					]
				},
				{
					"id": 205030213,
					"content": "Hayır. Başka birinden al, bendekiler bana anca yetiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030214
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030204,
					"content": "Paimon için silah bakıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030205
					]
				},
				{
					"id": 205030205,
					"content": "Paimon bunu ilk defa duyuyor! Yani şimdi Paimon'u ön saflarda mı istiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205030206,
					"content": "Tıfıl biri, değil mi? Özel yapılması gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030207
					],
					"speakerTitle": "Wagner"
				}
			]
		},
