					"nextDialogs": [
						205030603
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030603,
					"content": "Kötü bir gününde gibisin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205030604
					]
				},
				{
					"id": 205030604,
					"content": "Bir demircinin odaklanması ve konsantre olması gerekir, müşterilerle laflamamalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030605
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030605,
					"content": "Zanaatın iyiyse işlerin de iyidir. Ticaretin altın kuralı budur, aksini söyleyen olursa seni dolandırmaya çalışıyordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205030606
					],
					"speakerTitle": "Wagner"
				},
				{
					"id": 205030606,
					"content": "Başka bir şey yoksa işime dönüyorum.",
