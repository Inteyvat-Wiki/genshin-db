				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732060402,
					"content": "Affan hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060403
					]
				},
				{
					"id": 732060403,
					"content": "Hım... Bir şey mi oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060404
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732060404,
					"content": "Affan'ın karşılaştığı zorlukları Sabbah'a anlatıyorsun.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732060405
					]
				},
				{
					"id": 732060405,
					"content": "Anlıyorum. Demek o yüzden benden yardım istemeye geldin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060406
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732060406,
					"content": "Böyle bir sorun karşısında aklına gelmiş olmam beni çok mutlu etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060407
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732060407,
					"content": "Ne var ki bitki yetiştirmek benim uzmanlık alanım değil, bu konudaki deneyimim de sınırlı. Ne kadar yardımcı olabilirim bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060408
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732060408,
					"content": "Yine de elimden geleni yaparım tabii. Yeni bir gül cinsi yetiştiren bu beyefendi benim de ilgimi çekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060409
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732060409,
					"content": "Vaktim olduğunda Bay Affan'ın fideliğini ziyaret edeceğim. Beni daha sonra orada bulabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		},
		{
			"id": 7320606,
			"completionStepIds": [
				7320706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320603",
							"3"
						],
						"stepId": 7320603,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_NOT_RECEIVE",
						"rawParams": [
							"7320701",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732060601,
					"content": "Üzgünüm Shafaqat Amca. Son dileğini yerine getiremedim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060602,
						732060609
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060602,
					"content": "Shafaqat kim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060603
					]
				},
				{
					"id": 732060603,
					"content": "Ah, doğru ya... Yaşlı hortlak hakkında kafamı ütülemiştiniz siz. Gerçek adı yaşlı hortlak değil tabii. Yaşlı hortlak diye isim mi olur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060604
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060604,
					"content": "Büyüklerimden duydum adının Shafaqat olduğunu. Sumeru Şehri'ni genç yaşta terk edip köyümüze gelmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060605
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060605,
					"content": "Geldikten sonra da bu evi inşa etmiş ve yıllarca tek başına yaşamış. Evden nadiren çıkarmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060606
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060606,
					"content": "Gençlik halini hiç görmedim tabii ama dediklerine göre o zamanlar çocuklardan nefret etmezmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060607
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060607,
					"content": "Hem evinin önünde hem de arkasında birçok ağaç ve çiçek yetiştirdi. Çocuklar onun yanına gidip Ajilenakh Yemişi istemeyi ve onu dinlemeyi severlerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060608
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060608,
					"content": "Ben onu tanıdığımda çoktan yaşlanmıştı, herkes kendisini yaşlı hortlak olarak biliyordu. Çocuklardan da nefret etmeye başlamıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060621
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060621,
					"content": "Bunun başka bir yolu olmalı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060622
					]
				},
				{
					"id": 732060622,
					"content": "Başka nasıl bir yolu olabilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060623
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060623,
					"content": "Shafaqat Amca... O ihtiyar çoktan vefat etti bile. Hayatta olsaydı, bu gülleri yetiştirmek için hangi özel yöntemleri kullandığını sorabilirdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060624
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060624,
					"content": "Şimdi kime sorabilirim ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060625
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060625,
					"content": "Sabbah adında bir Amurta araştırmacısı tanıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060626
					]
				},
				{
					"id": 732060626,
					"content": "Ha, şu yabancı kızdan bahsediyorsun. Yardım edebilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060627
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060627,
					"content": "Bir kere buraya geldiğinde kovmuştum onu. Yardım etmek ister mi yine de?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060628
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060628,
					"content": "Bir sorarım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060629
					]
				},
				{
					"id": 732060629,
					"content": "Sen iyi bir çocuksun. Yardım edecek birini bulamazsan da sorun değil. Düşünmen bile yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060609,
					"content": "Çiçek yetiştirmeyi niye kafaya taktın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060610
					]
				},
				{
					"id": 732060610,
					"content": "Arada sırada bazı yabancılar köyümüze yerleşmek zorunda kalır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060611
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060611,
					"content": "Kendilerini ne kadar zorlasalar da bazıları burada yaşamaya alışamadı. O yüzden hayatlarının sonuna kadar yapayalnız kaldılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060612
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060612,
					"content": "O ihtiyar Shafaqat Amca da o kişilerden biriydi muhtemelen. Zaman içinde herkes bu duruma alışmıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060613
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060613,
					"content": "Ama üstünden ne kadar zaman geçerse geçsin, ben böyle bir şeye alışmayı reddettim. Onun başına gelenler gerçekten çok üzücü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060614
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060614,
					"content": "Bahçesini görseniz siz de bayılırdınız. Her renkten güzel çiçekler, her boydan ağaçlar vardı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060615
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060615,
					"content": "Böyle muhteşem bir bahçeye hayat vermiş kişi sessiz sedasız ölüp gitti. İnsanların ona dair hatırladığı tek şey, hayaletinin güya yaramaz çocukları kaçırması oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060616
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060616,
					"content": "Bunu kabullenemiyorum. Notlarına bu güllerin her yerde büyümesini istediğini yazmış. Ben de dileğini yerine getirmek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060617
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060617,
					"content": "Yaşlandım zaten, o yüzden kimsenin hakkımda ne düşündüğü umurumda değil. Bunu başarabilirsem hayatım anlam kazanacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060618
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060618,
					"content": "Evini temizledim ve arkasında bıraktığı sayfalarca yazıyı düzenledim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060619
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060619,
					"content": "İsterseniz size bir iki cilt gösterebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060620
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060620,
					"content": "Bu notları <color=#00E1FFFF>evin önüne</color> koyacağım ki onlar sayesinde biraz güneş görebilsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060621
					],
					"speakerTitle": "Affan"
				}
			]
		},
		{
			"id": 7320701,
			"completionStepIds": [
				7320701
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320701",
							"2"
						],
						"stepId": 7320701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732070101,
					"content": "Geldiniz demek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070102
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070102,
					"content": "Bana yardım edecek kişi bu olmalı, değil mi? Birkaç gün önce ona kötü şeyler söylemiştim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070103
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070103,
					"content": "Ben gerçekten... *iç çeker* Yaşlı ve işe yaramaz bir adamım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070104
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070104,
					"content": "Şu anda dostane bir konuşma yapmıyor muyuz efendim? Gönlünüz rahat olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070105
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070105,
					"content": "Tohumlar filizlendi mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070106
					]
				},
				{
					"id": 732070106,
					"content": "Bay Affan ile bakmaya gittik ama maalesef hâlâ filizlenmemişler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070107
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070107,
					"content": "Gözlemlerime göre bu tohumlar taşlaşma sürecinden geçmiş. Bunun iki sebebi olabilir:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070108
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070108,
					"content": "Birincisi, doğal hava şartları yüzünden çürüdüler ve bu da büyüme ihtimallerini ortadan kaldırdı ve onları taşlaştırdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070109
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070109,
					"content": "Eğer durum buysa tohumlar filizlenemez. Ancak bu hipotezin doğruluk payı düşük.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070110
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070110,
					"content": "Taşlaşmaları için çok uzun bir süre geçmesi gerekiyor ve bu tohumlar için henüz öyle bir durum söz konusu değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070111
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070111,
					"content": "İkinci olasılıksa bu türün Toprak ile güçlü bir bağının olması.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070112
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070112,
					"content": "Bu da demek oluyor ki tohum halindeyken bünyelerinde kabuklarını taşlaştıracak kadar Toprak elementi toplayabiliyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070113
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070113,
					"content": "Bu hipotez doğruysa tohumlar uzun süre boyunca muhafaza edilebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070114
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070114,
					"content": "Paimon... Paimon tam anlayamadı. Bu tohumlar taşa mı dönüştü yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732070115,
					"content": "Demek bunlar taş, öyle mi? Öyleyse bütün umutlarımız yok oldu. Altın Güller taştan yetişmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070116
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070116,
					"content": "Altın Gül mü? Halk şarkısında geçen Altın Gülden mi bahsediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070117
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070117,
					"content": "Ah, siz bunu bilmiyor olabilirsiniz. Köyün gül için yazılmış ve nesilden nesile aktarılmış bir halk şarkısı var. Bestesi de aslen Shafaqat Amca'ya ait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070118
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070118,
					"content": "Şarkıyı benden önceki nesle o öğretti, onlar da çocuklarına öğretti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070119
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070119,
					"content": "Benim akranlarım arasında bile bu şarkıyı bilmeyenler var. Bizim nesil de gittiğinde, Shafaqat Amca'yı hatırlayacak kimse kalmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070120
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070120,
					"content": "\"Ey güzeller güzeli gül, yerine getir dileklerimi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070121
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070121,
					"content": "\"Taştan biten Altın Gül bana bir şarkı söyledi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070122
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070122,
					"content": "Aynen öyle... Taşları bile çiçek açtırabiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070123
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070123,
					"content": "Aklına bir şey mi geldi Sabbah?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070124
					]
				},
				{
					"id": 732070124,
					"content": "Şarkıda da söylendiği gibi belki de taş kabuklarını kırarsak tohumlar filizlenebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070125
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070125,
					"content": "Normalde kabuklarını kendileri kırmaları için tohumları uyandıracak ideal bir yetiştirme ortamı gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070126
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070126,
					"content": "Ama bu cins güllerin tohum kabuğu tomurcuğun kıramayacağı bir sertlikte. O yüzden ona yardım etmeyi deneyebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070127
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070127,
					"content": "Sizin için de uygun mu Bay Affan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070128
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070128,
					"content": "Yani tohumları kırıp açalım mı demek istiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070129
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070129,
					"content": "Tohumları tamamen parçalamayacağız elbette. Bu iş için bize çevik biri lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070130
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070130,
					"content": "#{NICKNAME}, sen yapabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070131,
						732070132
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070131,
					"content": "Yine pis işler bana kaldı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070133
					]
				},
				{
					"id": 732070133,
					"content": "Dikkatli ol. Önce tohum kabuklarını kırmak için <color=#00E1FFFF>Şiddetli saldırıyı</color> kullan. Sonra da tohumları \"uyandırmak\" için <color=#00E1FFFF>Doğa</color> gücünü kullan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070132,
					"content": "Hallediyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070133
					]
				}
			]
		},
		{
			"id": 7320703,
			"completionStepIds": [
				7320703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320703",
							"2"
						],
						"stepId": 7320703,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Affan",
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732070321,
					"content": "Bir süre sessizce bekledikten sonra filizlerin yavaşça topraktan çıktıklarını görüyorsun...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732070301
					]
				},
				{
					"id": 732070301,
					"content": "Vay canına, Sabbah'ın yöntemi sahiden işe yaradı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732070302,
					"content": "Nihayet filizleniyorlar! Nihayet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070303
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070303,
					"content": "Anlaşılan Bay Shafaqat'ın dileği sonunda gerçekleşecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070304
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070304,
					"content": "Bay Affan, bu cins gülü onun yetiştirdiğini söylemiştiniz bana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070305
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070305,
					"content": "Yeni bir tür yetiştirebildiğine göre o da tıpkı benim gibi buraya sürgün edilmiş bir araştırmacıydı, öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070306
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070306,
					"content": "Evet... Bu köye sürgün edildi ve hayatı boyunca arkamızdaki evde yaşadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070307
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070307,
					"content": "Anladım. Biz sürgün edilmişlerin sonu muhtemelen hep aynı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070308
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070308,
					"content": "Hazır konusu açılmışken, yeni türler yetiştirmek sadece en iyi araştırmacıların yapabildiği bir şeydir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070309
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070309,
					"content": "Onun gibi birinin Akademiden uzakta ismi duyulmadan hiçliğe karışması ne hazin bir durum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070310
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070310,
					"content": "Kendi geleceğin mi aklına geldi yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070311,
						732070314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732070311,
					"content": "Moralini bozma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070312
					]
				},
				{
					"id": 732070312,
					"content": "Evet evlat. Yolun uzun ve daha yapacak çok şeyin var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070313
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070313,
					"content": "Melankoliye kapılma. İkinci bir yaşlı hortlak görmek istemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070317
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070317,
					"content": "Haklısın. Böyle mutlu bir zamanda hüzünlenmemeliyim. Konumuza geri dönelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070318
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070318,
					"content": "Bu Altın Güller henüz filizlendiler. Daha çiçek açacaklar. Çiçek açana kadar onlara bakmak istiyorum. Ne dersiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070319
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070319,
					"content": "Ben de.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732070320
					]
				},
				{
					"id": 732070320,
					"content": "Bırakalım da biraz topraktan beslensinler. Daha sonra buraya gelip çiçek açışlarını birlikte izleriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732070314,
					"content": "(Sabbah'ı nasıl teselli ederiz bilemedim...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070315
					]
				},
				{
					"id": 732070315,
					"content": "Üzülme. Bak, sonuçta bize Altın Gülü bıraktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070316
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070316,
					"content": "Bu çiçekler Shafaqat amcanın dünyada bir zamanlar var olduğunun birer kanıtı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070317
					],
					"speakerTitle": "Affan"
				}
			]
		},
