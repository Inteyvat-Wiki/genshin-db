			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732900201,
					"content": "Ah, nasıl özlemişim bu manzarayı... Buyur, hediyelerin hazır. Lütfen kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900202
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900202,
					"content": "Bunların hepsi burada yetişmeyen bitkilerin tohumları. Bir yerde bahçen varsa onları ekip büyümelerini izleyebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900203
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900203,
					"content": "Uzun bir süre bocaladım... Ama şimdi iyiyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900204
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900204,
					"content": "Sen gelmeden önce burada pek arkadaşım yoktu. Bazen kendimi öyle yalnız hissediyordum ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900207
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900207,
					"content": "Koca köyde bahçıvanlıkla ilgilenen çok az kişi var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900208
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900208,
					"content": "Şey... Bu şekilde söylemek pek doğru olmayabilir aslında. Köyün kuzeyinde yaşayan yaşlı bir adam çiçek yetiştirmek için tarlasını sürdü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900209
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900209,
					"content": "Onu daha önce ziyaret ettim. Biraz garip bir ihtiyar doğrusu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900210
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900210,
					"content": "Onu gördüğümde toprağa taş ekiyordu, sorunca da onların taş değil çiçek olduğu konusunda ısrar etti durdu. Sonra da beni kovdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900211
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900211,
					"content": "İnsan tek başına yaşayınca kendini yalnız hissediyordur eminim. Onu anlayabiliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900212
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900212,
					"content": "Sumeru Güllerimi yetiştirmeme yardım etmiştin... Belki onun bitkilerine de yardım edebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732900213
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732900213,
					"content": "Fırsat bulduğunuzda Paimon'la onu ziyaret edin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		}
	]
}