				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030605,
					"content": "Hangi Darşandaydın bu arada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030606
					]
				},
				{
					"id": 732030606,
					"content": "Hah, bu konu hakkında üç gün hiç susmadan konuşabilirim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030607
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030607,
					"content": "Eskiden Amurtacıydım, uzmanlık alanım ise bitkilerin evrimsel gelişimiydi. Haliyle çalışmalarımın da kanıta dayalı olduğu söylenebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030608
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030608,
					"content": "Bu alanda yeni kanıtlar olmadan yeni sonuçlar elde etmek imkansız anlayacağın. Basitçe söylemek gerekirse, tarihi bitkilerin incelenmesi için fosiller gereklidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030609
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030609,
					"content": "Ne yazık ki halihazırdaki fosil sayısı oldukça kısıtlı. Akademinin gücü de yenilerini bulmaya yetmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030610
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030610,
					"content": "Koşullar bu şekildeydi ama enstitü hâlâ sonuç almak istiyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030611
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030611,
					"content": "O yüzden bazıları da önceden yapılmış bir çalışmayı alıp ya onu tekrar düzenliyor ya da üzerine eklemeler yapıp öyle teslim ediyordu. Bunu sen de çok anlamsız buluyorsun, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030612
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030612,
					"content": "Aslında yeni malzemeler bulmak için yüzümüzü tarih ve coğrafya bilimlerine dönersek, yepyeni keşifler yapacağımıza şüphem yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030613
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030613,
					"content": "Amurta'nın genellikle pek önemsemediği bazı edebi belgeleri de kullanabiliriz. Gerçi onlar da Vahumana ve Haravatat'ın alanına girebilir gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030614
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030614,
					"content": "O alanlarda pek uzman sayılmam, zaten söz konusu dosyaları talep etmek bile epey uğraştırıyor. Oranın araştırmacılarıyla beraber çalışma konusuna hiç girmeyeceğim bile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030615
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030615,
					"content": "Yine de bir takım olarak birlikte çalışabilirsek, geçmişteki birçok sorunun cevaplanacağına eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030616
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030616,
					"content": "İş birliği girişimlerimizi devam ettirememiş olmamız çok yazık. Gerçi Vahumana ve Haravatat'takilerin çok tuhaf yaklaşımları olduğunu söylemeden de geçemem tabii...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030617
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030617,
					"content": "Araştırmalarımı sunarken yanlış anlaşılıp başka tarafa çekilebilecek ifadelere yer vermemek için üslubuma ve kullandığım kelimelere çok dikkat etmem gerekiyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030618
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030618,
					"content": "Akademiden kovulmadan önce Haravatatçı biriyle bir tartışmanın tam ortasındaydım. Şimdi onu bile yapamıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030625
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030625,
					"content": "Uzun bir süre bocaladım... Ama şimdi iyiyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030626
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030626,
					"content": "Sen gelmeden önce burada pek arkadaşım yoktu. Bazen kendimi öyle yalnız hissediyordum ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030629
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030629,
					"content": "Koca köyde bahçıvanlıkla ilgilenen çok az kişi var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030630
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030630,
					"content": "Şey... Bu şekilde söylemek pek doğru olmayabilir aslında. Köyün kuzeyinde yaşayan yaşlı bir adam çiçek yetiştirmek için tarlasını sürdü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030631
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030631,
					"content": "Onu daha önce ziyaret ettim. Biraz garip bir ihtiyar doğrusu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030632
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030632,
					"content": "Onu gördüğümde toprağa taş ekiyordu, sorunca da onların taş değil çiçek olduğu konusunda ısrar etti durdu. Sonra da beni kovdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030633
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030633,
					"content": "İnsan tek başına yaşayınca kendini yalnız hissediyordur eminim. Onu anlayabiliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030634
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030634,
					"content": "Sumeru Güllerimi yetiştirmeme yardım etmiştin... Belki onun bitkilerine de yardım edebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030635
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030635,
					"content": "Fırsat bulduğunuzda Paimon'la onu ziyaret edin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		},
