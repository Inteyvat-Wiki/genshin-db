			"dialogs": [
				{
					"id": 732030619,
					"content": "Aaru Köyü'nde hayat nasıl gidiyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030620
					]
				},
				{
					"id": 732030620,
					"content": "Pekala. Yiyeceğim de var, başımı sokabileceğim bir evim de. En azından tüm temel ihtiyaçlarım karşılanıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030621
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030621,
					"content": "Nihayetinde buraya sürgün edildim ben, o yüzden okuyacak bir kitabım veya araştırma ekipmanım olmasını beklemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030622
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030622,
					"content": "Burası uzun zamandır sürgündeki bilginlerin sürgün yeri olarak kullanılıyor. Burada hayat zor ve pratik, bu yüzden doğal olarak buradaki kimse akademik işlerle veya araştırmalarla ilgilenmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030623
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030623,
					"content": "İlk sürgün edilen ben değilim, muhtemelen sonuncusu da ben olmayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030624
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030624,
					"content": "Bununla yaşamayı öğrenmekten başka çarem yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030625
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030625,
