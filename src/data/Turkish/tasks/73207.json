					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732070501,
					"content": "\"Ey güzeller güzeli gül, yerine getir dileklerimi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070502
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070502,
					"content": "\"Taştan biten Altın Gül bana bir şarkı söyledi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070503
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070503,
					"content": "\"Şarkısında dedi ki:\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070504
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070504,
					"content": "\"Diyarlar değil şarkılar sırtlar benim ruhumu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070505
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070505,
					"content": "\"Şarkılar meydan okur yazgıma ve reddeder bu kötü kaderi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070506
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070506,
					"content": "\"Aşacaklar zamanı, aşacaklar beni. Onlar görecek bu solmaya mahkum yaşamın ötesini.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732070507
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732070507,
					"content": "İşte Shafaqat amcanın bize öğrettiği şarkı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		},
