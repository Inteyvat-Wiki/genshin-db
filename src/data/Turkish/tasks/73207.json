			"dialogs": [
				{
					"id": 732030602,
					"content": "Bir Sumeru Gülü getirdim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030603
					]
				},
				{
					"id": 732030603,
					"content": "Ah, nasıl özlemişim bu manzarayı... Buyur, hediyelerin hazır. Lütfen kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030604
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030604,
					"content": "Bunların hepsi burada yetişmeyen bitkilerin tohumları. Bir yerde bahçen varsa onları ekip büyümelerini izleyebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		},
		{
			"id": 7320307,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
