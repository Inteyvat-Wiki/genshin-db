			"dialogs": [
				{
					"id": 400000201,
					"content": "Merhaba! Bir tur Mekanikus Savunması oynamak ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000202
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000202,
					"content": "Mekanikus Savunması mı? O ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000203
					]
				},
				{
					"id": 400000203,
					"content": "Daha önce duymadın mı? Tanıtmama izin ver o halde. Mekanikus Savunması, bendeniz tarafından icat edilmiş bir masa oyunudur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000204
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000204,
					"content": "Masaya yayılmış bu şeyleri gördün mü? Bunlar Mekanikus Savunmasında kullanılan önemli eşyalardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000205
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000205,
					"content": "Karmaşık görünüyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000206
					]
				},
				{
					"id": 400000206,
					"content": "Başta karmaşık görünebilir ama birkaç kere oynadıktan sonra kavrarsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000207
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000207,
					"content": "Ne dersin? Denemek istiyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000208,
						400000209
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000208,
					"content": "Şey, bir oyun ne kadar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000210
					]
				},
				{
					"id": 400000210,
					"content": "Hayır, hiç de bile. Fener Şenliğindeyiz sonuçta. Ayrıca insanların oyun hakkındaki düşüncelerini öğrenebilmeyi umuyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000211
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000211,
					"content": "Yani oynamak için sadece bir Xiao Feneri vermen yeterli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000212
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000212,
					"content": "Denemek istersen bana bir Xiao Feneri getir, hemen oynayalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400000213
					],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000213,
					"content": "Haydi bir dene! Hatta ilk oyunun benden olsun, böylece Xiao Fenerin sende kalabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruijin"
				},
				{
					"id": 400000209,
					"content": "Çok pahalı olmalı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400000210
					]
				}
			]
		},
