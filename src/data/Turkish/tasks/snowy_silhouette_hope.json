			"dialogs": [
				{
					"id": 708020101,
					"content": "Bu sefer babamı gerçekten bulabilecek miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020102
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020102,
					"content": "Babanla ilgili gelişme var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020103
					]
				},
				{
					"id": 708020103,
					"content": "Ah, senmişsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020104
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020104,
					"content": "Pallad, Cyrus Amca'nın babam hakkında bir şeyler duyduğunu söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020105
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020105,
					"content": "Cyrus Amca tam emin değilmiş ama Pallad'a göre son buldukları ipucu sağlammış. Yani bu sefer gerçekten onu bulabilirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020106
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020106,
					"content": "Onlarla Ejdersırtı'na gitmeyi çok isterim ama Cyrus Amca kampta kalmamı söyledi. Yeni bir şey bulduklarında bana da haber vereceklermiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020107
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020107,
					"content": "Cyrus Amca'ya gidip bir haber var mıymış sorabilir misin, lütfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020108,
						708020109
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020108,
					"content": "Elbette.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020110
					]
				},
				{
					"id": 708020110,
					"content": "Şey... Kötü bir haber olmasından korkuyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020111
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020111,
					"content": "Ne olursa olsun... Sana güveniyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Joel"
				},
				{
					"id": 708020109,
					"content": "Neden gidip kendin sormuyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020110
					]
				}
			]
		},
