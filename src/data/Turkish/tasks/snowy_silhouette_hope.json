			"dialogs": [
				{
					"id": 708020201,
					"content": "Bu bölgede demek... Emin misin Pallad?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020202
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020202,
					"content": "Hiç olmadığım kadar, Bay Cyrus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020203
					],
					"speakerTitle": "Pervasız Pallad"
				},
				{
					"id": 708020203,
					"content": "Joel'in babasıyla ilgili mi konuşuyorsunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020204
					]
				},
				{
					"id": 708020204,
					"content": "Ah, Gezgin gelmiş! Bahse girerim ki seni Joel yolladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020205
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020205,
					"content": "O çocuk, neredeyse her gün birilerini göndererek herhangi bir haber olup olmadığını sordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020206
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020206,
					"content": "Ama bu sefer... Ona güzel haberlerimiz var, haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020207
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020207,
					"content": "Bir ara Ejdersırtı'nda özel bir eğitim düzenliyorduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020208
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020208,
					"content": "Kalanını ben anlatsam daha iyi olur, Bay Cyrus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020209
					],
					"speakerTitle": "Pervasız Pallad"
				},
				{
					"id": 708020209,
					"content": "Eğitimime devam ederken, büyük bir kar fırtınası yüzünden belirlenmiş olan yoldan saptım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020210
					],
					"speakerTitle": "Pervasız Pallad"
				},
				{
					"id": 708020210,
					"content": "El yordamıyla yolumu bulmaya çalışırken, uçurumun birinde bulanık bir gölge gördüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020211
					],
					"speakerTitle": "Pervasız Pallad"
				},
				{
					"id": 708020211,
					"content": "Benim gibi yolunu kaybetmiş bir maceracı olduğunu düşündüm ve dikkatini çekmek için bağırdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020212
					],
					"speakerTitle": "Pervasız Pallad"
				},
				{
					"id": 708020212,
					"content": "Maalesef bağırışlarım, gördüğüm kişinin dikkatinden ziyade canavarların dikkatini çekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020213
					],
					"speakerTitle": "Pervasız Pallad"
				},
				{
					"id": 708020213,
					"content": "Seni bilmem ama, benim o koşullar altında canavarları yenmem mümkün değildi. O yüzden telaşlı bir şekilde geri çekildim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020214
					],
					"speakerTitle": "Pervasız Pallad"
				},
				{
					"id": 708020214,
					"content": "Döndüğümde yaşananları Bay Cyrus'a anlattım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020215,
						708020217
					],
					"speakerTitle": "Pervasız Pallad"
				},
				{
					"id": 708020215,
					"content": "Yani gördüğün kişi Joel'in babası mıydı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020216
					]
				},
				{
					"id": 708020216,
					"content": "Emin değiliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020218
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020218,
					"content": "Neyse, yine de artık \"birinin\" Ejdersırtı'nda mahsur kaldığını biliyoruz. Bu nedenle bir kurtarma çalışması yürütmemiz gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020219
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020219,
					"content": "Bu kişinin Joel'in babası Joserf olup olmayacağı ise... Kader kısmet artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020220
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020220,
					"content": "Her halükarda, Ejdersırtı'nı keşfedebilecek yetenekteki herkese, dağılıp aramaya başlamalarını söyledim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020221
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020221,
					"content": "Ben de hazırlanayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020222,
						708020223
					],
					"speakerTitle": "Pervasız Pallad"
				},
				{
					"id": 708020222,
					"content": "Ben de geleceğim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020224
					]
				},
				{
					"id": 708020224,
					"content": "Gerçekten mi? Bu harika! Birlikte yola çıkalım o halde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pervasız Pallad"
				},
				{
					"id": 708020223,
					"content": "O canavarlara günlerini göstereceğim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020224
					]
				},
				{
					"id": 708020217,
					"content": "Çok önceden kaybolan herhangi bir maceracı da olabilir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020218
					]
				}
			]
		},
