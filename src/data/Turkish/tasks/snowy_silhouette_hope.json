					"nextDialogs": [
						708020403
					]
				},
				{
					"id": 708020403,
					"content": "Öyle mi? Hah! Onun sorumlu biri olduğuna dair hiç şüphem yoktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020406
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020406,
					"content": "Elimdeki işler bitince, Ejdersırtı'na gidip Joel'i bizzat kontrol edeceğim ve ona haber vereceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020407
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020407,
					"content": "Yani en kısa zamanda geleceğimi, ona söyle lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020408
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708020408,
					"content": "İşimi bitirmem biraz zaman alacak. Çocuğu bekletme hadi!",
