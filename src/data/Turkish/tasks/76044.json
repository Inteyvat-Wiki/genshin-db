			"dialogs": [
				{
					"id": 760440301,
					"content": "Hımm... Daha geçen gün Sancak Gemisi'nde bir sürü av hedefi vardı. Şimdi yalnızca bir tane kalmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440302
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440302,
					"content": "#{NICKNAME} hepsini çözmüş anlaşılan ama o bile sonuncuyla başa çıkamamış.{M#}{F#}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440303
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760440303,
					"content": "Hiçbir ipucu da yazmamışlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440304
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440304,
					"content": "Hoş... Hedef panosunda ipucu olmaması kimsenin bilgi sahibi olmadığı anlamına gelmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440305
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440305,
					"content": "Bak sen, ilham perileri mi ziyaret etti yoksa seni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440306
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760440306,
					"content": "Gidip Leszek'le konuşayım. Tecrübemi kullanıp birkaç faydalı bilgi koparabilirim ağzından.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440307
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440307,
					"content": "O halde bu işi sana bırakıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440308
					],
					"speakerTitle": "Nefer"
				},
