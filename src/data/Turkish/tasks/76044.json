			"dialogs": [
				{
					"id": 760440101,
					"content": "Sancak Gemisi'nde ilginç bir ödül avı ilanı var. Hiçbir ipucu da eklenmemiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440102
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440102,
					"content": "Hedef, Lempo Adası'nın kuzey kesiminde insanlara saldırıyormuş ama hiçbir iz bırakmadan ortadan kaybolmuş. Nereye gittiğini bilen yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440103
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440103,
					"content": "Her temas ardında bir iz bırakır. İzlerini ne kadar dikkatli silersen sil, ardında mutlaka yeni izler bırakırsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440104
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760440104,
					"content": "Ayrıca hedef ilanında herhangi bir bilgi yazmıyor olabilir ama bu durum, ilanı asan kişinin hiçbir şey bilmediği anlamına gelmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760440105,
					"content": "Hiç bu açıdan bakmamıştım... Ben gidip Leszek'le konuşayım. Tecrübemi kullanıp birkaç faydalı bilgi koparabilirim ağzından.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440106
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 760440106,
					"content": "O halde bu işi sana bırakıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440107
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 760440107,
					"content": "Tabii ki Patron Nef!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
