			"dialogs": [
				{
					"id": 750443901,
					"content": "(Pek de ilgi görüyormuş gibi durmayan bir fotoğraf albümü. İçinde bir sürü genç ve güzel kadının resmi var.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750443902
					],
					"speakerTitle": "\"Fontaine Parfüm Reklamları Koleksiyonu\""
				},
				{
					"id": 750443902,
					"content": "Off... Sadece kız resimleri mi bunlar? Sıkıcı!",
