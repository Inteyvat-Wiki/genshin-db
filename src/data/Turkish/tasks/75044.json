					"speakerTitle": "Paimon"
				},
				{
					"id": 750444403,
					"content": "Diğer Monetoo'lar aradığını buldu da bu mu bulamadı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750444404,
					"content": "#Yazık... Hadi {NICKNAME}, bu kavanozda olması gerekeni bulmasına yardım edelim... Hımm. Ne olabilir ki acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444405
					],
					"speakerTitle": "Paimon"
				},
				{
