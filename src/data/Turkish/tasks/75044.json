						750444602
					],
					"speakerTitle": "Monetoo"
				},
				{
					"id": 750444602,
					"content": "Ha, demek aradığımız buymuş! İçinde kırmızı olan bir şey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750444603,
					"content": "Bir dakika... Hı? İçine koyduğumuz şey kayboldu... Bir şey koyduk, değil mi? Tuhaflık var bu işte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750444604,
					"content": "Kavanozda başka bir şey mi var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750444605,
					"content": "(Kavanoza tıklat.)",
					"roleType": "TALK_ROLE_NPC",
