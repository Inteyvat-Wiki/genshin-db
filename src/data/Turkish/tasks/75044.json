				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750443601,
					"content": "(Dorothy Leeckson tarafından yazılmış bir aşk romanı. Kitabın solmuş kapağında, çiçeklerle donatılmış yatakta yatan bir kadın var.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750443602
					],
					"speakerTitle": "\"Lavanta Çiçeği\""
				},
				{
					"id": 750443602,
					"content": "(Kitabı şöyle bir gözden geçirdikten sonra rahatlıyor ve mutlu hissediyorsun fakat kayda değer herhangi bir bilgi edinemiyorsun.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750443603
					],
					"speakerTitle": "\"Lavanta Çiçeği\""
				},
				{
					"id": 750443603,
					"content": "Şey... Yani o kişi ailenin bahçıvanı mıydı, yoksa en yakın arkadaşının kuzeninin kayınbiraderi mi? Off... Paimon'un beyni yandı resmen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7504437,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750443701,
					"content": "(Emekli Fontaine Gölge Mareşosesi özel polis kuvvetleri dedektifi Frank Drebin'in biyografisi. Evet, dedektifin kendisi azman beyaz bir kedi gerçekten.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750443702
					],
					"speakerTitle": "\"Dedektif Karlıpati\""
				},
				{
					"id": 750443702,
					"content": "(Bu kitabın ilk sayfasına büyük bir kedi patisi basılmış. Dedektifin astlarına bıraktığı özel bir hatıradır belki de bu.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750443703
					],
					"speakerTitle": "\"Dedektif Karlıpati\""
				},
				{
					"id": 750443703,
					"content": "Yok, daha neler... E Paimon hakkında da bir kitap yazılsın madem. Adı da \"Beyaz Saçlı Dedektif\" falan olsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7504438,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750443801,
					"content": "(Fontaineli oyun yazarı Jean Brooklyn'in eseri. Bu kadar kalın bir kitap, kısa boylu kişilerin boyunu uzatmak için kullanılabilir gayet.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Teyvat Tarihi: Bölüm I\""
				}
			]
		},
