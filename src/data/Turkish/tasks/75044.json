			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750442401,
					"content": "\"Uzlaştırıcı... En hayırsever... Och-Kan'ın zaferi sonsuz olsun...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442402
					]
				},
				{
					"id": 750442402,
					"content": "... Zanaatkarlar Mahutzintl, Tlanalco ve... Su pompasının inşasından sorumlu olanlar... Kasıtlı olarak yavaşlatıldı ve bu durum gecikmelere sebep oluyor... Hayırsever hükümdarımız... Herhangi bir ceza vermedi... Yalnızca üç hafta boyunca erzak gönderimini askıya aldı...",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442403
					]
				},
				{
					"id": 750442403,
					"content": "\"... <color=#00E1FFFF>Su pompası mekanizmasını</color> etkinleştiren <color=#00E1FFFF>taş anahtarın</color>... Tutulduğu yer... Başka zanaatkar atanana dek... Kimse izinsiz kullanamaz...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
