			"dialogs": [
				{
					"id": 750444701,
					"content": "(Çocuksu el yazıları görünüyor:)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444702
					],
					"speakerTitle": "Bir Çocuğun Notları"
				},
				{
					"id": 750444702,
					"content": "Bu oyunun adı \"Bam Güm Çın Çın\", kuralları da şöyle:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444703
					],
					"speakerTitle": "Bir Çocuğun Notları"
				},
				{
					"id": 750444703,
					"content": "1. Bam Güm Monetoo çın çın yapmadığında Sürüngen heykelinin sırtına binip onu ilerlet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444704
					],
					"speakerTitle": "Bir Çocuğun Notları"
				},
				{
					"id": 750444704,
					"content": "2. Bam Güm Monetoo geriye sayıp \"çın!\" ettiğinde Sürüngen heykelinden in, yoksa kaybedersin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444705
					],
					"speakerTitle": "Bir Çocuğun Notları"
				},
				{
					"id": 750444705,
					"content": "3. Bam Güm Monetoo'ya ilk ulaşan kazanır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750444706
					],
					"speakerTitle": "Bir Çocuğun Notları"
				},
				{
					"id": 750444706,
					"content": "Bana \"Ee, bu Kırmızı Işık Yeşil Işık değil mi?\" deme hiç. Kurallar önemli, kurallara saygı duymadığın için kazanamıyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bir Çocuğun Notları"
				}
			]
		}
