			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750440701,
					"content": "Uçan Sürüngen tüm gün açıktır! Matahga'nın özel eğitimine katılmak istiyorsan gel de Uçan Sürüngen'den göklere havalan! Not:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440702
					],
					"speakerTitle": "Dikkat Çekici Slogan"
				},
				{
					"id": 750440702,
					"content": "Çok çalışıp idman yapmak güzeldir. Tembellik edip işten kaytarmak ise rezilliktir, yok olsundur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440703
					],
					"speakerTitle": "Dikkat Çekici Slogan"
				},
				{
					"id": 750440703,
					"content": "Bugün bir işe soyunmayan yarın kapının önüne koyulur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440704
					],
					"speakerTitle": "Dikkat Çekici Slogan"
				},
				{
					"id": 750440704,
					"content": "Başını dimdik tutup cesaretle ilerle ki Sürüngen süvarileri gibi yüceliğin tadına varabilesin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dikkat Çekici Slogan"
				}
			]
		},
		{
			"id": 7504408,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750440801,
					"content": "Kural şu: Önce sol, sonra sağ boruyu çal. Ardından tekrar solu, son olarak da sağı çal... Çal tabii ama riski de göze al!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440802
					],
					"speakerTitle": "Matahga! Hatırla!"
				},
				{
					"id": 750440802,
					"content": "Bir Sürüngeni Kuş Etiyle beslemek, onu uslu tutmanın ve gagalanmaktan kaçınmanın en iyi yoludur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440803
					],
					"speakerTitle": "Matahga! Hatırla!"
				},
				{
					"id": 750440803,
					"content": "(Matahga adında birinin kendine bıraktığı bir not. Nota baktığında ne kadar yoğun duygularla yazıldığını hissedebiliyorsun adeta.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750440804
					],
					"speakerTitle": "Matahga! Hatırla!"
				},
				{
					"id": 750440804,
					"content": "(Gerçi her hatırlatmanın sonuna ünlem işareti koyuyorsan ne anlamı var ki? Neyin önemli olup neyin olmadığı belli değil...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matahga! Hatırla!"
				}
			]
		},
		{
			"id": 7504417,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750441701,
					"content": "\"Kutsal Al{RUBY#[D]Yajaw K'ahk'}ev Muhafızı ve hayırsever, yüce Kutsal Hü{RUBY#[D]Ti'sakhuun}kümdarımız Majesteleri Och-Kan'ın emriyle tüm kabilelerden su koruma altyapısı inşası için işçi alımı yapılacaktır...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750441702
					]
				},
				{
					"id": 750441702,
					"content": "\"Sabit bir kota yoktur, her şey gönüllü katılıma göre belirlenecektir... İttifak kuruluyor... Tüm kabilelerin yanıt vermesini umuyoruz...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7504418,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750441801,
					"content": "\"Kutsal Al{RUBY#[D]Yajaw K'ahk'}ev Muhafızı ve hayırsever, yüce Kutsal Hü{RUBY#[D]Ti'sakhuun}kümdarımız Majestele{RUBY#[D]Kalomte}ri Och-Kan'ın emriyle yakındaki lanetli topraklar şu andan itibaren mühürlenmiştir. İttifak üyelerinin girmesi yasaktır.\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750441802
					]
				},
				{
					"id": 750441802,
					"content": "\"İzinsiz girenler resmi olarak ittifakın düşmanı olarak kabul edilecektir. Bu bildiri; (...) Nanatzcayan, Meztli, Huitztlan ve Teteocan'ın ortak beyanıdır.\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7504419,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750441901,
					"content": "\"Kutsal Al{RUBY#[D]Yajaw K'ahk'}ev Muhafızı, Büyük Uz{RUBY#[D]Q'atal Tzij}laştırıcı ve hayırsever Kutsal Hü{RUBY#[D]Ti'sakhuun}kümdarımız Och-Kan'ın şanı her daim ışıl ışıl parlasın.\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750441902
					]
				},
				{
					"id": 750441902,
					"content": "\"Bu bölgedeki drenaj çalışmalarının yavaş ilerlemesi nedeniyle ittifakın kaçınılmaz zaferini garantilemek adına vardiya sisteminde ufak ayarlamalar yapılmaktadır.\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750441903
					]
				},
				{
					"id": 750441903,
					"content": "\"İşçiler üç ekibe bölünecek, her ekip on altı saat çalışacak ve iki günde bir vardiya değişecektir. Üstün performans gösteren ekipler fazladan tahıl alacaktır.\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750441904
					]
				},
				{
					"id": 750441904,
					"content": "\"<color=#00E1FFFF>Biriken suyu</color> boşaltma çalışmalarının başarıyla sonuçlanmak üzere olduğunu bildirmek isteriz. Kanallar tamamlandığında <color=#00E1FFFF>su pompası</color> normal bir şekilde çalışacaktır. Herkese ha gayret demek istiyoruz!\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7504420,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750442001,
					"content": "\"... İttifakın kaçınılmaz zaferine kendilerini adamış olan yurttaşlara, ailelere ve kardeşlere sesleniyoruz...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442002
					]
				},
				{
					"id": 750442002,
					"content": "\"... En hayırsever olan... Ulaşım ve <color=#00E1FFFF>su altı kurtarma</color> çalışmalarını desteklemek için bir dizi yeni mekanizma tahsis etmiştir...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442003
					]
				},
				{
					"id": 750442003,
					"content": "\"... İleri! İleri! Her ne pahasına olursa olsun ileri... İttifakın şanlı geleceği için, özgürlüğümüz ve zaferimiz için, vatanımızı kötü kalpli ejderhanın baskısından kurtarmak için...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442004
					]
				},
				{
					"id": 750442004,
					"content": "\"... İzni olmayanların... <color=#00E1FFFF>Kontrol kolunu</color> kullanması yasaktır... Şimdiye kadar kazara düşerek yaralanan üç işçi mevcut...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7504421,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7504401",
							"2"
						],
						"stepId": 7504401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750442101,
					"content": "\"... Kuzeydeki taş duvarın arkasında şelalenin yukarısına giden küçük bir yol var. <color=#00E1FFFF>Depolama alanı</color> olarak kullanılabilir...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442102
					]
				},
				{
					"id": 750442102,
					"content": "\"Daha sonra yolu unuturum diye birkaç işaret bıraktım...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442103
					]
				},
				{
					"id": 750442103,
					"content": "\"... Sayani'nin yaraları iyileşmek yerine daha da kötüye gitmeye başladı. Rutubet yüzünden olsa gerek... Ona dinlenmesini söyledim ama gülüp geçti... Bunun ekibi yavaşlatacağını, herkesin bu yüzden fazladan erzakı kaçıracağını söyledi...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						750442104
					]
				},
				{
					"id": 750442104,
					"content": "\"... Gece olsun da elimde meşaleyle gizlice yanına gidip başkaları görmeden yarasını dağlayayım. Yoksa uzuvları da çürüyecek...\"",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				}
			]
		},
