			},
			"dialogs": [
				{
					"id": 20130801,
					"content": "Bir saniye... Bu mallar... Watatsumi Adası'na mı gönderiliyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130802
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130802,
					"content": "Leydim! Bu, beklenmedik bir şeref. Haklısınız, Kanjou Heyetinin Başkanı bu malları defalarca istemişti. Watatsumi Adası'na sapasağlam ulaştıklarından emin olmalıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130803
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20130803,
					"content": "Bir sorun mu var, Leydi Hiiragi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130804
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20130804,
					"content": "Hayır, devam et. Babamın, kargonun güvenliğiyle ilgili bazı endişeleri var ve malların güvenli bir şekilde taşınmasını sağlamak için benimle birlikte vasıflı bir refakatçinin gönderilmesini emretti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130805
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130805,
					"content": "Leydim, kargoya şahsınızın eşlik etmesini düşünmüyorsunuz, değil mi? Kesinlikle böyle bir meseleyle uğraşmanıza gerek yok. Ve şu \"vasıflı refakatçiye\" gelince...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130806,
						20130807
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20130806,
					"content": "Sizinle çalışmayı dört gözle bekliyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130808
					]
				},
				{
					"id": 20130808,
					"content": "Lütfen bize daha fazla vakit kaybettirmeyin. Yanlış hatırlamıyorsam, babam zaten bu kargonun vaktinde ulaşması gerektiğini açıklamıştı. Aksi takdirde, usulüne uygun bir cezanın verileceğinden eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130809
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130809,
					"content": "Evet, elbette leydim. S-sadece... Şey, şu refakatçinin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130810
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20130810,
					"content": "Yolda bana bir şey olursa, verilecek cezayı hatırlatmama gerek var mı? Eminim babamın mizacına oldukça aşinasındır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130811
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130811,
					"content": "Gerçekten tek başına güvenliğimi sağlayabileceğini mi düşünüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130812
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130812,
					"content": "Vay canına, Chisato konuşmasını çok iyi biliyor, hiç şansları yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130813,
					"content": "A-Ah, evet leydim. Peki öyleyse... Bize eşlik etmeniz bizim için bir onurdur. Güvenliğiniz birinci önceliğimizdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130814
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20130814,
					"content": "Shinnojou! Bunu gerçekten kabul ediyor olamazsın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130815
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20130815,
					"content": "Talep, Leydi Hiiragi'nin kendisinden geldi. Ona en iyi hizmeti sağlamak bizim görevimizdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130816
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20130816,
					"content": "Evet ama... Sorun o değil ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130817
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20130817,
					"content": "İyi o zaman, buradaki işimiz bittiyse derhal yola çıkalım derim. Oyalanmak, potansiyel hırsızlara hazırlanmak için daha fazla zaman tanımaktan başka bir şeye yaramaz, haksız mıyım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130818
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130818,
					"content": "E-evet, leydim. Onu duydun, kaybedecek vakit yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20130807,
					"content": "Yeteneklerimi sorgulamaya nasıl cüret edersin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130808
					]
				}
			]
		},
