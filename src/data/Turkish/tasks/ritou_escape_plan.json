			"dialogs": [
				{
					"id": 20131101,
					"content": "Durun! Burası Kanjou Heyetinin Başkanının Ofisi. İzinsiz kimse giremez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131102
					],
					"speakerTitle": "Yokoyama"
				},
				{
					"id": 20131102,
					"content": "Biz buraya şeyi... Bilirsin, ıı... Kanjou Heyetinin Başkanını görmeye geldik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20131103,
					"content": "Kanjou Heyetinin Başkanı nadiren yabancıları ağırlar. Şimdi gidin yoksa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131104
					],
					"speakerTitle": "Yokoyama"
				},
				{
					"id": 20131104,
					"content": "Ah... Bekle, bekle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131105
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20131105,
					"content": "Ah! Heyet Başkanı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131106
					],
					"speakerTitle": "Yokoyama"
				},
				{
					"id": 20131106,
					"content": "Bunlar uzaktan gelen onur konukları, onlara her zamanki prosedürü uygulamaya gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131107
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20131107,
					"content": "İçeri gelin, sizin için ne yapabileceğimize bir bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131108
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20131108,
					"content": "Hıh! Gördünüz mü bayım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20131109,
					"content": "Ç-çok özür dilerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yokoyama"
				}
