			"dialogs": [
				{
					"id": 20130101,
					"content": "Kımıldamayın! Seyahat İzinlerinizi gösterin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130102
					],
					"speakerTitle": "Kobayashi"
				},
				{
					"id": 20130102,
					"content": "Üzgünüm ama Narukami Adası'na gerçekten gitmemiz gerekiyor. Biraz acil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130103,
					"content": "Seyahat İzniniz yoksa, en çok bu kadar gidebilirsiniz. Kurallar böyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130104
					],
					"speakerTitle": "Kobayashi"
				},
				{
					"id": 20130104,
					"content": "Hah... Aklımıza gelen başımıza geldi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130105,
					"content": "Gezgin, bir şeyler düşünmelisin. Ritou'dan nasıl çıkacağız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130106,
						20130107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130106,
					"content": "Yashiro Heyeti bizi duyduysa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130108
					]
				},
				{
					"id": 20130108,
					"content": "Gidip Kanjou Heyetinin Başkanı ile görüşmemiz gerektiğini mi söylüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130109,
					"content": "Denemekten zarar gelmez herhalde. Paimon'un onun astları hakkında söyleyecek iki çift lafı var ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130110,
					"content": "Kim bilir, o belki de bizim en büyük hayranımızdır. Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130107,
					"content": "Kanjou Heyeti bizi duymuş mudur acaba?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130108
					]
				}
			]
		},
		{
			"id": 201302,
			"completionStepIds": [
				201302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
