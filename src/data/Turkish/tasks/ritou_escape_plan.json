				"points": []
			},
			"dialogs": [
				{
					"id": 20130701,
					"content": "Ah, sonunda geldiniz... Kendimi tanıtayım, ben Hiiragi Chisato.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130702
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130702,
					"content": "Bu teknik olarak bizim ikinci tanışmamız. Sizi yeniden görmek büyük bir zevk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130703
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130703,
					"content": "Vay, bu Hiiragi Klanının kızı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130704,
						20130705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130704,
					"content": "O zevk bana ait.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130706
					]
				},
				{
					"id": 20130706,
					"content": "Resmiyeti bir kenara bırakalım. Ben, senin başarılarına hayranlık duyuyorum ve sonunda tanışma şansımız oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130707
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130707,
					"content": "Burada bir sıkıntı mı var, yoksa Paimon'a mı öyle geliyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130708,
					"content": "Seninle gizlice buluşmak istememin nedeni ise... Açıkçası, bunu seninle konuşmak için asla başka bir fırsat bulamayacağımdan korktum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130709
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130709,
					"content": "N-neyi konuşmak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130710,
					"content": "Öhöm... Bir konuda yardımın lazım... Bir mektubun teslim edilmesinde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130711,
						20130712
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130711,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130713
					]
				},
				{
					"id": 20130713,
					"content": "Ah, aynı baban gibisin. Daha farklı olamaz mıydın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130714,
					"content": "H-hayır! Beni yanlış anlıyorsun. Lütfen açıklamama izin ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130715
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130715,
					"content": "Benim yerime Narukami Adası'na bir mektup götürebileceğini düşünmüştüm. Tenryou Heyetinden Kujou Kamaji'ye verilmesi gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130716
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130716,
					"content": "Babam onunla iletişim kurmamı kesinlikle yasakladı. Babama kalırsa, kendisine politik olarak daha fazla fayda sağlayacak biriyle evlenmem gerekiyormuş. Ama benim kalbim Kamaji'ye ait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130717
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130717,
					"content": "Babamın Ritou ile ilgili isteğine karşı gelmeye cüret edebilecek kimse yok. Fakat siz yabancısınız, hem de Narukami Adası'na gitmeye çalışan yabancılarsınız. Böyle bir fırsatın kaçması üzücü olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130718
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130718,
					"content": "Ah, Paimon şimdi büyük resmi görebiliyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130719,
					"content": "Tabii bunu yaparsanız, Ritou'dan ayrılmanıza yardımcı olmak için gücümün yettiği her şeyi yaparım. Söz veriyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130720,
						20130721
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130720,
					"content": "Hım, makul bir anlaşma gibi görünüyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130722
					]
				},
				{
					"id": 20130722,
					"content": "Dürüst olmak gerekirse, Inazuma'da kaldığın süre boyunca babamın, senin Ritou'dan ayrılmana izin verme gibi bir niyeti olmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130723
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130723,
					"content": "Evet, onu biz de fark ettik. Sadece bizi burada tutmaya çalıştığı belliydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130724,
					"content": "Daha birkaç gün önce, babam ve kibirli duran bir kadın arasında geçen bir konuşmaya kulak misafiri oldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130725
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130725,
					"content": "Seni Ritou'da nasıl tutacaklarını tartışıyor gibiydiler. Doğrusu babamın Şogun dışında biriyle bu kadar saygılı konuştuğunu ilk defa duydum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130726,
						20130727
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130726,
					"content": "Kibirli duran bir kadın...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130728
					]
				},
				{
					"id": 20130728,
					"content": "Çok fazla vaktimiz yok. Sizi adadan çıkarmak için yaptığım planları anlatacağım. Şansınıza bir mal sevkiyatı olacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130729
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130729,
					"content": "(Hiiragi Chisato, Gezgine planlarını anlatır.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130730
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130730,
					"content": "Pekala, sınırda seni bekleyeceğim. Mektubumu teslim etmen için sana güveniyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20130727,
					"content": "Anlaşılan Ritou'dan olabildiğince hızlı bir şekilde çıkmamız lazım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130728
					]
				},
				{
					"id": 20130721,
					"content": "Başka seçeneğimizin olmadığını da düşünürsek...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130722
					]
				},
				{
					"id": 20130712,
					"content": "Ben gidiyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130713
					]
				},
				{
					"id": 20130705,
					"content": "Sizi yeniden gördüğüme memnun oldum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130706
					]
				}
			]
		},
		{
			"id": 201308,
