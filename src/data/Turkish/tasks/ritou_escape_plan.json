					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131002
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20131002,
					"content": "Gayet iyiyim. Burada durabilirsin. Narukami Adası'na giden yol şurada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131003
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20131003,
					"content": "Mektubumda Kamaji'ye, Tenryou Heyetinden size özel bir Seyahat İzni vermesini söyledim. Bunu minnettarlığımın bir simgesi olarak düşünün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131004,
						20131005
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20131004,
					"content": "Teşekkürler Chisato.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20131006
					]
				},
				{
					"id": 20131006,
					"content": "Leydim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131007
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20131007,
					"content": "Ne? Demek öyle. Bir şeylerin ters gittiğini hissediyordum ama Shinnojou, sen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131008
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20131008,
					"content": "Hayır, Leydi Hiiragi bizden asla bir şey saklamaz, bundan eminim. Şu bahsettiğiniz \"Kamaji\" kim leydim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131009
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20131009,
					"content": "Onun... Sevdiğim kişi olduğunu söylemekten çekinmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131010
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20131010,
					"content": "Sevdiğiniz kişi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131011
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20131011,
					"content": "Shinnojou... Sen gerçekten öyle mi sandın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131012
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20131012,
					"content": "Ne? H-hayır, ben... Öhöm! Sadece durumu açıklığa kavuşturuyordum. En çılgın rüyalarımda bile... Öhöm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131013
					],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20131013,
					"content": "Endişelenmenize gerek yok. Böyle bir şey yaşanmadı sayın, unutun. Babam bunu duyarsa tek sorumlusu ben olacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131014
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20131014,
					"content": "Evet, elbette. Nasıl isterseniz leydim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131015
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20131015,
					"content": "Ama burada yaptıklarınız öğrenilirse ne olacak Chisato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20131016,
					"content": "Merak etmeyin, babam beni hep şımartmıştır. En fazla beni yarım gün yemeksiz bırakır ya da buna benzer bir şekilde cezalandırır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131017
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20131017,
					"content": "Hah, Paimon onun gibi bir adamın yumuşak bir yanının olmasını hiç beklemezdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20131018,
					"content": "Sağ salim gidin. Yakında tekrar görüşeceğimize eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131019
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 20131019,
					"content": "Hoşça kal Chisato!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20131020,
					"content": "Amma abarttın! Bakmayı bırak da harekete geçelim. Taşımamız gereken mallar var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20131021
					],
					"speakerTitle": "Kenzaburou"
				},
				{
					"id": 20131021,
					"content": "*sızlanır* P-peki... *iç çeker*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shinnojou"
				},
				{
					"id": 20131005,
					"content": "Lütfen dikkatli ol.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20131006
					]
				}
			]
		},
