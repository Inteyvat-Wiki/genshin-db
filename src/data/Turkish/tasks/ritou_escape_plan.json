			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hiiragi Shinsuke",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20130201,
					"content": "Ben, Kanjou Heyetinin Başkanı ve Hiiragi Klan lideri Hiiragi Shinsuke. İkinizle de tanışmak büyük bir şeref.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130202,
						20130203
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130202,
					"content": "Ben de tanıştığımıza şeref duydum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130204
					]
				},
				{
					"id": 20130204,
					"content": "Tanıştığımıza memnun oldum, efendim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130205,
					"content": "Gelip sizi görme nedenimiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130206,
					"content": "Durun hele, acele etmeyin, her şeyin bir zamanı var. Her yerde tanınan iki gezgin beni görmeye gelmiş. Onları tanımayı çok isterim. Bunu yalnızca işle sınırlamayalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130207
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130207,
					"content": "Hehe, yani bizim çok meşhur olduğumuzu mu söylüyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130208,
					"content": "Kesinlikle. Dünyada kaç kişi Fırtına Dehşeti'nin havasını söndürüp, Girdabın Lordu'nu denizin derinliklerine geri gömebilir? Kimde var bu güç?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130209
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130209,
					"content": "Aynen! Paimon, çok iyi bir noktaya parmak bastığınızı düşünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130210,
					"content": "Ve... Liyue Limanı'nda Fatui komplosunu engellediğinizi ve hatta habercilerden birini düelloda yendiğinizi de duydum. Bu doğru mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130211
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130211,
					"content": "Vay! Onu da duydunuz demek. Evet, bu doğru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130212,
					"content": "Hım... Düşündüğüm gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130213
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130213,
					"content": "Bir sorun mu var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130214,
					"content": "Heh, yok yok. Hayır. İkiniz de beni dehşete düşürdünüz, hepsi bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130215,
						20130216
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130215,
					"content": "Çok kibarsınız.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130217
					]
				},
				{
					"id": 20130217,
					"content": "... Ritou, bizi ziyaret ettiğiniz için çok gurur duyuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130218
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130218,
					"content": "Sizinle ilgili duyduğum diğer bir şey de, diğer insanlara yardım etme konusundaki gayretiniz. Acaba... Kanjou Heyetine de yardım etme nezaketinde bulunur musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130219
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130219,
					"content": "#Tabii, sorun değil. Neye ihtiyacınız varsa hallederiz. Değil mi, {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130220,
						20130221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130220,
					"content": "Yine bazı işler mi yapacağız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130222
					]
				},
				{
					"id": 20130222,
					"content": "Mükemmel. Peki, o zaman...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130223
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130223,
					"content": "Qingxin'i biliyorsun, değil mi? Liyue'deki dağların tepesinde yetişen bir çiçek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130224
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130224,
					"content": "Evet, önceden birkaç tane toplamıştık. Yani, şey... Liyue'ye geri dönmemizi mi istiyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130225,
					"content": "Evet. Bana 300 Qingxin getirir misiniz? Yeni toplanmış olanlarından.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130226
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130226,
					"content": "Ahh... Paimon doğru mu duydu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130227,
						20130228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130227,
					"content": "Siparişin miktarı biraz fazla değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130229
					]
				},
				{
					"id": 20130229,
					"content": "Çok zor, öyle mi? Hım... Anladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130230
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130230,
					"content": "O zaman şuna ne dersiniz? Dağıtılması gereken birkaç şey var, onlara yardımcı olur musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130231
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130231,
					"content": "Bu kulağa daha hoş geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130232,
					"content": "Tam olarak söylemek gerekirse 709 tane mektup.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130233
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130233,
					"content": "Hey! Nasıl yani? Sizin bu işleri yapacak adamlarınız yok mu zaten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130234,
					"content": "Ne yazık ki son zamanlarda biraz adam eksiğimiz var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130235
					],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130235,
					"content": "Bu nasıl bir açıklama böyle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130236,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130237
					]
				},
				{
					"id": 20130237,
					"content": "Gezgin, ne yapacağız? Bu adama yardım etmeli miyiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20130238,
						20130239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20130238,
					"content": "Bilmiyorum, düşüneceğim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130240
					]
				},
				{
					"id": 20130240,
					"content": "İşte bu! Beni çok bekletmeyin ama, hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hiiragi Shinsuke"
				},
				{
					"id": 20130239,
					"content": "Önce biraz daha araştırmam lazım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130240
					]
				},
				{
					"id": 20130228,
					"content": "Koparıldıktan sonra o çiçekler taze kalmaz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130229
					]
				},
				{
					"id": 20130221,
					"content": "Benim güçlü yanım bu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130222
					]
				},
				{
					"id": 20130216,
					"content": "Sonunda yine sizin dediklerinize geldiler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130217
					]
				},
				{
					"id": 20130203,
					"content": "Merhaba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20130204
					]
				}
			]
		},
