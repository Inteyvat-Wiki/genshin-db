			"dialogs": [
				{
					"id": 756750101,
					"content": "Hey... Ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750102
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 756750102,
					"content": "Kafam tamamen müzikle dolu, haydi dans, dans!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750103
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 756750103,
					"content": "Yandan, yandan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750104
					],
					"speakerTitle": "Sedile"
				},
				{
					"id": 756750104,
					"content": "Çok mutluyum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750105
					],
					"speakerTitle": "Manaia"
				},
				{
					"id": 756750105,
					"content": "Kırraaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750106
					],
					"speakerTitle": "Moo"
				},
				{
					"id": 756750106,
					"content": "Biraz fazladan para da kazandım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750107
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 756750107,
					"content": "Ha? Ne ara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750108
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 756750108,
					"content": "Nusta işe boğulmuştu, ben de stajyerlerine yardım edip birkaç canavar yuvasını temizledim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750109
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 756750109,
					"content": "Natlan'da dövüşmek de dans etmek de eşit derecede heyecan verici. Bunu sevdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750110
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 756750110,
					"content": "Eline sağlık Marine. Aslında amacım çaylaklara daha fazla pratik yaptırmaktı ama tek başlarına o görevin üstesinden gelemediler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750111
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 756750111,
					"content": "Geri döndüğümüzde onları daha çok çalıştırırım artık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750112
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 756750112,
					"content": "Hiç gerek yok, harika iş çıkardılar. Sadece yuvadan tahmin ettiğimizin tam yedi misli canavar fırlayacağını hiç hesaba katmamıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750113
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 756750113,
					"content": "Ayrıca Çiçek Tüyü Klanı çok iyi ödeme yapıyor. Aeval'a hediye almak için para bile koydum kenara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750114
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 756750114,
					"content": "Ama senin tatilin de bitmek üzere, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750115
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 756750115,
					"content": "Birkaç gün daha buralardayım, sonra dönüş gemisini ayarlama işine bakarım artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750116
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 756750116,
					"content": "Acelemiz yok, hâlâ dans edebiliriz. Roxane, Letellier, Chenee ve Frejus son zamanlarda iş kapmak için yarışıyorlar, bu yüzden onlardan rol çalmayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750117
					],
					"speakerTitle": "Marine"
				},
				{
					"id": 756750117,
					"content": "O zaman dans etmeye ve eğlenmeye devam edelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750118
					],
					"speakerTitle": "Sedile"
				},
				{
					"id": 756750118,
					"content": "Yorulunca yemek ye, doyunca da vur kafayı uyu. Sıfır sıkıntı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750119
					],
					"speakerTitle": "Manaia"
				},
				{
					"id": 756750119,
					"content": "Raarrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750120
					],
					"speakerTitle": "Moo"
				},
				{
					"id": 756750120,
					"content": "Melusinalar ile küçük Koholazorlar sıraya dizilip hoplaya zıplaya sahnenin yolunu tuttular.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						756750121
					]
				},
				{
					"id": 756750121,
					"content": "Şu misafirlerin tatlılığına bak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750122
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 756750122,
					"content": "Hehe, görünüşe göre sen de iyi vakit geçiriyorsun Nusta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750123,
						756750124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756750123,
					"content": "Artık çok daha rahat gülümsüyorsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756750125
					]
				},
				{
					"id": 756750125,
					"content": "Gerçekten mi? O zaman bundan sonra bulduğum tüm dans partilerine katılayım bari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750126
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 756750126,
					"content": "Bana \"hanımefendi\", hatta \"teyze\" diyen o ufaklıklara... Ruhen onlardan çok daha genç olduğumu ispat edeceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756750127
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 756750127,
					"content": "Bence bundan sonraki dans partileri de aynen böyle olmalı, hatta daha sık toplanmalıyız! Her ay yapıp bunu bir geleneğe dönüştürme fikrine varım ben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nusta"
				},
				{
					"id": 756750124,
					"content": "Biraz daha genç duruyorsun hatta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756750125
					]
				}
			]
		}
	]
}