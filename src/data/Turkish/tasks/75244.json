			"dialogs": [
				{
					"id": 752440101,
					"content": "Selam, sen de mi balık tutmaya geldin? Balık tutmayı biliyorsan o zaman sağlam bir şapkaya ihtiyacın olduğunu da biliyorsundur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440106
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440106,
					"content": "... Neden şapka takman gerek?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752440102
					]
				},
				{
					"id": 752440102,
					"content": "Neden mi? Sağlam bir şapka, başını güvende tutar da ondan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440107
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440107,
					"content": "Senin şapkan yok ama...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752440103
					]
				},
				{
					"id": 752440103,
					"content": "Seninle konuşmamın asıl sebebi de buydu aslında... Rüzgar şapkamı uçurdu da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440104
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440104,
					"content": "Müsaitsen onu bulmama yardımcı olur musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440108
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440108,
					"content": "Neden gidip kendin aramıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752440105
					]
				},
				{
					"id": 752440105,
					"content": "Sağlam şapkamı aramaya gidersem oltamı bırakmam gerek. Oltamı bırakmazsam da şapkamı aramaya gidemem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440109
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440109,
					"content": "Lütfen, yalvarırım bana yardım et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rantiy"
				}
			]
		},
