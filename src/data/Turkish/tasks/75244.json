			"dialogs": [
				{
					"id": 752440302,
					"content": "İşte bu! Çok teşekkür ederim! Sağlam şapkamı buldum ya, içim rahatladı sonunda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440303
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440303,
					"content": "Bu aslında birine özel yaptırdığım bir miğfer. Tüfek mermilerini bile durdurabiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440307
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440307,
					"content": "Kafana biraz fazla takıyorsun. Altı üstü balık tutuyorsun işte...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752440304
					]
				},
				{
					"id": 752440304,
					"content": "Kulağa çılgınca gelebilir ama bir süre önce buralarda balık tutan bir adam gözünden vuruldu. Muhtemelen bir tüfek mermisi ya da ok isabet etti. Balıkçılık da tehlikeli spor olmuş gerçekten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440305
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440305,
					"content": "Bütün bu olayın Nod-Krai'daki bir tür yeraltı güç çatışması yüzünden çıktığını işittim... Kim bilir? Böyle bir şeyin varlığı bile dikkatli olmamız gerektiğine bir işaret!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "Rantiy"
				}
			]
		},
