				{
					"id": 752440402,
					"content": "O serserileri mi kafana takıyorsun hâlâ? Dert etme, eğer onlarla karşılaşırsan ismimi ver, seni rahat bırakırlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752440403
					],
					"speakerTitle": "Rantiy"
				},
				{
					"id": 752440403,
					"content": "Ama sebebini sorma. Karşılaşmamız kaderimizde varmış. Şapkamı bulmama bile yardımcı oldun, iyiliğinin bir karşılığı olarak düşün.",
					"roleType": "TALK_ROLE_NPC",
