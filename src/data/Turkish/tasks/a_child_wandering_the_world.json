						"pointId": 3
					},
					{
						"sceneId": 20302,
						"position": [
							-0.119,
							59.263,
							-35.013
						],
						"pointId": 4
					}
				]
			},
			"dialogs": [
				{
					"id": 100060501,
					"content": "\"İlk kez karşılaşıyoruz, bu yüzden sana nasıl hitap edeceğimi bilmiyorum. Ama M'nin çocuğu olduğun için sanırım sana 'Mini Durin' diyeceğim.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060502
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060502,
					"content": "\"Senden önceki Durin'den daha küçük görünsen de damarlarında aynı kuvvet akıyor. Eksiksiz hem de.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060503
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060503,
					"content": "\"O 'Humus'un bir çocuğuydu, eksik bir oluşumdu. Bu nedenle kendi kuvvetini kontrol edecek 'irade'den yoksundu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060504
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060504,
					"content": "\"Ancak bu güç onun dayanabileceğinden çok daha fazlaydı, bu yüzden onu bozdu, onu tüketti ve böylece nihai kaderini belirledi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060505
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060505,
					"content": "\"Albedo, senin bu lekeli kanı aştığını ve kendisi gibi bir varlığa dönüştüğünü iddia ediyor. Bu onun görüşü. Ben ikna olmadım.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060506
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060506,
					"content": "\"Ben sadece gerçeklere, yalnızca kendi 'gördüklerime' güvenirim. O halde bu fırsatı kullan M'nin çocuğu. Kendini bana kanıtla.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Rhinedottir\""
				}
			]
		},
