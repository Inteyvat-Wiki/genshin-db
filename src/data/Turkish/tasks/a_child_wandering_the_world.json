			"dialogs": [
				{
					"id": 100060101,
					"content": "Selam Durin! Demek buradasın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060102,
					"content": "#Aa, {NICKNAME}, Paimon. Ne yapıyorsunuz burada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060103
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060103,
					"content": "Hehe, asıl sen neden burada tıkılmış kitap okuyorsun? Hava öyle güzel ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060104,
					"content": "Ha. Şey, Mondstadt halkıyla daha fazla iletişim kurma fırsatı bulduğumdan beri insanların ne zaman şaka yaptığını anlamakta zorlanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060105
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060105,
					"content": "Örneğin geçen sefer çiçekçideyken güzel bir çiçek gördüm. Dükkan sahibine söylediğimde bana dedi ki:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060106
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060106,
					"content": "\"Hehe, bu yabani otlar o kadar hoşuna gittiyse yanına birkaç Nane ve Tatlı Çiçek ekleyip bir buket yapmalısın.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060107
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060107,
					"content": "Onun dediği gibi yaptım. Ama ona buketin son halini gösterdiğimde bana oldukça ürkütücü bir bakış attı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060108,
						100060109
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060108,
					"content": "Benzersiz bir bakış açın var Durin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060110
					]
				},
				{
					"id": 100060110,
					"content": "Daha sonra Albedo, bunun \"kelimelerin arkasındaki anlamı\" kavramakta zorlandığım için yaşandığını söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060111
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060111,
					"content": "İşte o yüzden Mondstadt yazısını öğrendikten sonra buraya gelip kitap okuyabileceğimi söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060112
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060112,
					"content": "Bir hikaye kitabından doğduğum için bu kitapların bana bu dünyanın \"kuralları\" hakkında daha fazla şey öğretebileceğini düşündüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060113
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060113,
					"content": "Ve zamanın nasıl geçtiğini anlamamışım sanırım... Ee, şey, benden bir şey mi isteyecektiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060114,
						100060117
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060114,
					"content": "Arkadaşlar bazen sadece merhaba demek için uğrarlar Durin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060115
					]
				},
				{
					"id": 100060115,
					"content": "Ha, anladım. O zaman bir kural daha öğrenmiş oldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060116
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060116,
					"content": "Evet! Bu arada gerçekten de konuşmamız gereken konular vardı, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060118,
					"content": "Evet, Rhinedottir'den bir mesaj getirdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060119,
					"content": "Aa... Bu... Rhinedottir Teyze'den mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060120,
						100060121
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060120,
					"content": "İyi misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060122
					]
				},
				{
					"id": 100060122,
					"content": "Yok, ben... Sadece şaşırdım. Rhinedottir annemin arkadaşı... Ve bir zamanlar benim yerime var olan ejderhanın annesi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060123
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060123,
					"content": "Onun yerine geçtim, onun olması gereken kaderi devraldım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060124
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060124,
					"content": "Yani, eğer benden hoşlanmıyorsa... Ne yapacağımı bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060125,
						100060126
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060125,
					"content": "Sana karşı kin tuttuğunu sanmıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060127
					]
				},
				{
					"id": 100060127,
					"content": "Evet! Biz senin yanındayız! Ama cidden bak, Paimon ortada kötü bir şey olduğunu düşünmüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060128,
					"content": "Bunu duymak iyi geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060129
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060129,
					"content": "Peki, açayım o halde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060126,
					"content": "Her halükarda biz yanındayız.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060127
					]
				},
				{
					"id": 100060121,
					"content": "Gerilmene gerek yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060122
					]
				},
				{
					"id": 100060117,
					"content": "Cadılar Meclisinin isteği üzerine geldik...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060118
					]
				},
				{
					"id": 100060109,
					"content": "Bence sorun ondaymış.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060110
					]
				}
			]
		},
