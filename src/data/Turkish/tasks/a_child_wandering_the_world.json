			"dialogs": [
				{
					"id": 100060701,
					"content": "Öhöm... Usta Rhinedottir'in söyleyecekleri bu kadarmış. *öksürür*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060702
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100060702,
					"content": "Ağzına sağlık Sebas. İşin hiç kolay değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060703
					]
				},
				{
					"id": 100060703,
					"content": "Heh. Başkasının sesini taklit edebilen bir kediyi izlemenin tuhaflığı hiç değişmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060704,
					"content": "Bu kadar şaşırmayın. Ben sıradan bir kedi değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sebas"
