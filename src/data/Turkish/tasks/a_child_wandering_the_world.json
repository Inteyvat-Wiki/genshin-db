					}
				]
			},
			"dialogs": [
				{
					"id": 100060901,
					"content": "Aslında biyolojik açıdan ben bir kedi değilim, daha ziyade simyevi bir varlığım. Mesela sen sırf havada süzülüyorsun diye kendini bir Uçarlop olarak görmüyorsundur herhalde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060902
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100060902,
					"content": "Uçarlop mu? Ne demeye çalışıyorsun sen efendi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060903,
					"content": "Ha, anladım! Sebas senin bir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060904
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060904,
					"content": "Belki de o cümleni tamamlamasan daha iyi olur Durin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060905
					]
				},
				{
					"id": 100060905,
					"content": "Ne cümlesi? Hey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060906,
					"content": "Ha, bu arada Usta Rhinedottir'in mesajının nasıl bittiği düşünülürse sanırım bu tekniğin artık bir faydası kalmadı. Onu yok edeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060907
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100060907,
					"content": "Onun fikrini pek az kişi değiştirebilir. Oldukça etkileyici bir başarı delikanlı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060908
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100060908,
					"content": "Bu iş bittiğine göre ben artık gidiyorum. İletmem gereken bir mesajım daha var. Belki bir ara tekrar karşılaşırız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sebas"
				}
