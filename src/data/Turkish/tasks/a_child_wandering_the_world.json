					"speakerTitle": "Sebas"
				},
				{
					"id": 100060802,
					"content": "Şey, en azından kendini tanıtabilir misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060803
					]
				},
				{
					"id": 100060803,
					"content": "Evet! Artık konuşan kedilere alışkınız ama başkasının sesini taklit edebilen bir kedi... Bu bir ilk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060804,
					"content": "Bunun neden önemli olduğunu anlamadım ama illa bilmek istiyorsanız... Ben Sebas, yalnızca bir kahyayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060805
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100060805,
					"content": "Albedo'nun arkadaşlarısınız, değil mi? Doğrusunu söylemek gerekirse ben onun \"büyüğüyüm\". O yüzden sakın yanılmayın, ben öyle sıradan bir kedi değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sebas"
				}
			]
		},
