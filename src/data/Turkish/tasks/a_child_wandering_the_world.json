			},
			"dialogs": [
				{
					"id": 100060601,
					"content": "\"Hımm. Görünüşe göre Albedo yanılmamış.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060602
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060602,
					"content": "Bir dahaki sefere sırf bir şeyi kanıtlamak için bize canavarlarla pusu kurma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060603,
					"content": "Yine de onları yendikten sonra gücümü daha özgürce kontrol edebildiğimi hissediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060604
					],
					"speakerTitle": "Durin"
				},
				{
					"id": 100060604,
					"content": "\"Seni öğrendikten sonra kanındaki karanlık gücü mühürleyecek bir teknik hazırladım. Bu fırsatı kullanarak bu tekniği sana aktarmayı planlamıştım.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060605
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060605,
					"content": "\"Elbette bunu kullanmanın bir bedeli var. Teyvat'taki varlığını korurken bu dünyayla olan bağlantını da zayıflatacak.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060606
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060606,
					"content": "\"Ve her şey bir yana, sen M'nin çocuğusun. Kontrolsüz bir gücün seni senden önce gelen çocukla aynı kadere sürüklemesine göz yumamam.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060607
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060607,
					"content": "\"Ama şimdi seni görünce, endişelerimin yersiz olduğu anlaşılıyor. M harika bir anneydi, benden çok daha yetenekli bir anneydi hatta.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060608
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060608,
					"content": "\"Ayrıca itiraf edeyim, ne kadar ileri gidebileceğini oldukça merak ediyorum. Simyevi bir varlık olarak bu dünyayla gerçekten bütünleşmiş olan sen, insan toplumunda kendi yerini nasıl bulacaksın?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060609
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060609,
					"content": "\"Daha önce hiç böyle bir deney yapmamıştım. Bu sebeple beklenmedik bazı cevapların anahtarını sen taşıyor olabilirsin.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060610
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100060610,
					"content": "Hey! Bir konuda yanlışın var. Durin bir deney değil! O bizim arkadaşımız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100060611,
					"content": "Tam olarak anlamadım ama... Nezaketin için teşekkür ederim Rhinedottir Teyze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Durin"
				}
			]
		},
