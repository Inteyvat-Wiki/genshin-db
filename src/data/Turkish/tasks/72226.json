			"dialogs": [
				{
					"id": 722260301,
					"content": "Çok teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260302
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260302,
					"content": "Tünek iyi görünüyor. Eminim seremoni bu kez iyi geçecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260303,
						722260304
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260303,
					"content": "Çocuk oyuncağıydı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260305
					]
				},
				{
					"id": 722260304,
					"content": "Biraz zorlandık.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260305
					]
				},
				{
					"id": 722260305,
					"content": "Hehe. Nasıl olsa oldukça deneyimli gezginleriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722260306,
					"content": "#Sahiden {NICKNAME}, nerelisin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260307
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260307,
					"content": "Daha önce gelen insanlar Inazuma ve Narukami Adası'ndan bahsetti. Inazumalı mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260308,
						722260312
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260308,
					"content": "Şey, aşağı yukarı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260309
					]
				},
				{
					"id": 722260309,
					"content": "Aa evet, doğru. Biz de Narukami Adası'ndan geliyoruz değil mi? Bir dakika!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722260310,
					"content": "Paimon neredeyse buraya Maushiro için geldiğimizi unutuyordu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722260311,
					"content": "Memleketimiz çok çok uzak bir yerde...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260312
					]
				},
				{
					"id": 722260312,
					"content": "Bu doğru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722260313,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260314
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260314,
					"content": "Vay canına! Bir ejderhanın üzerine bile tırmandın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260315,
						722260316
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260315,
					"content": "Evet ama çok rahatsız ediciydi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260317
					]
				},
				{
					"id": 722260316,
					"content": "Evet, fena değildi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260317
					]
				},
				{
					"id": 722260317,
					"content": "Gerçekten harika...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260318
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260318,
					"content": "Dünya büyük evlat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722260319,
					"content": "Sis Denizi'nin ötesinde bu kadar çok yer olduğunu bilmiyordum. Bir gün buradan ayrılırsam hepsini görmeyi çok isterim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260320
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260320,
					"content": "Bize her zaman eğer sisi geçersek ruhlarımızın kaybolacağını ve sisin bizi dışarıdaki karanlıktan koruduğunu söylerlerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260321
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260321,
					"content": "Dışarıdan gelen birçok insanla tanıştım. Bu yüzden Sessizlik Denizi'nde yaşayan insanlar olduğunu biliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260322
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260322,
					"content": "Fırsat bulursan bizimle gelebilirsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722260323
					]
				},
				{
					"id": 722260323,
					"content": "Tamamdır, anlaştık o halde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260324
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260324,
					"content": "İkiniz önden gidin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260325
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722260325,
					"content": "Seremoni bittiğinde Tsurumi Adası'nın ötesindeki dünyayı birlikte keşfedelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722260326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722260326,
					"content": "Elbette!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruu"
				}
			]
		},
