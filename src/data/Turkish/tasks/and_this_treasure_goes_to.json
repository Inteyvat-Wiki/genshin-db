			},
			"dialogs": [
				{
					"id": 715551001,
					"content": "Çok sağ olun. İşim bitti düşünüyordum... Meğer şu Hazine Avcıları bunca zamandır beni takip ediyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551002
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551002,
					"content": "Nihayet araştırmamda biraz ilerleme kaydetmiştim, buradaki hazineyi bulabilsem ve dönerken yanımda götürsem ne harika olur diye düşünüyordum ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551003
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551003,
					"content": "Hazine Avcıları, kampıma dalıp beni kaçırdı ve buraya getirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551004
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551004,
					"content": "Sürekli bana hazinenin yerini sordular ve söylemezsem beni öldürmekle tehdit ettiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551005
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551005,
					"content": "Ama onlara öylece söylesem kesinlikle işimi bitirirlerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551006
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551006,
					"content": "*iç çeker* Soraya'yı dinlemeliydim. O hep bizim gibi arkeologların hazineler yerine akademik sonuçlara odaklanması gerektiğini söyler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551007
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551007,
					"content": "Ama elime geçen para bundan ibaret. Birkaç makale yazmak seyahat masraflarımı bile karşılamaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551008
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551008,
					"content": "Soraya bu kadar zamandır Liyue'de tek başına nasıl kalabildi hiç bilmiyorum. Onun reddedilen makale taslaklarını görmek bile beni çileden çıkarıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551009
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551009,
					"content": "Şimdi ne yapmayı düşünüyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715551010
					]
				},
				{
					"id": 715551010,
					"content": "Başka ne çarem var ki? Araştırma malzemelerimi topladım. Hazineye gelince... Sizin olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551011
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551011,
					"content": "Bu duruma düşmeme sebep olan saçma bakış açısına dönmeyeceğim. Tek bilmen gereken, hazinenin Lingju Geçidi'nin ortasındaki <color=#00E1FFFF>devasa, altın renkli ağacın altına</color> gömülü olduğu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551012
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551012,
					"content": "İsterseniz alabilirsiniz. Hatta unutmayın açıklamaları yazıp verebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551013
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551013,
					"content": "Şimdi biraz dinleneceğim, sonra kampıma dönüp eşyalarımı toplarım. Daha fazla Hazine Avcısı gelmeden buradan olabildiğince çabuk gitmem lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551014
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551014,
					"content": "Buradan Wangshu Hanına gitmem ne kadar sürecek bilmiyorum. Umarım Soraya ben oraya ulaşana kadar gitmemiş olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715551015
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 715551015,
					"content": "*iç çeker* Keşke Soraya benim hocam olsaydı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alrani"
				}
			]
		},
