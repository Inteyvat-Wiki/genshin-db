			"dialogs": [
				{
					"id": 760780101,
					"content": "Normalde Vahşi Avı takip eden canavarların hepsi yenildiğinde, pis kokularının da onlarla birlikte yok olması gerekir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780102
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780102,
					"content": "Ama bu çatlak kapanmıyor... Sıra dışı bir durum olsa da daha önce karşılaşmışlığımız var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780103
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780103,
					"content": "Etrafı arayalım. Belki kirli bir şey kalmıştır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
			]
		},
		{
			"id": 7607802,
