				]
			},
			"dialogs": [
				{
					"id": 760780201,
					"content": "Aa, bir fener. Tüm Işık Muhafızları bunlardan taşır, ayrıca Vahşi Avı dağıtmak için kullanılan önemli bir araç...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780202
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780202,
					"content": "Fener olduğu gibi duruyor, üzerine Vahşi Av sızıntısının kokusu sinmiş. Sahibi ise ortalıkta yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780203
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780203,
					"content": "Anladım. Şaşırtıcı olsa da burada neler yaşandığını anlamak zor değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780204
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780204,
					"content": "Işık Muhafızı kardeşlerimizin fedakarlıkları bazen bir fısıltı kadar sessiz olur. Meslektaşlarımın birinin bu şekilde vefat ettiğini öğrenmek hep üzücü olmuştur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780205
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780205,
					"content": "... Ey isimsiz kimse, geride bıraktığın feneri taşımama izin ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780206
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780206,
					"content": "Dışı temizlenecek ve ışığı yeniden yanacak. Nod-Krai'ı korumaya yemin eden bir başka Işık Muhafızının elinde yeniden hayat bulacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780207
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780207,
					"content": "Flins, feneri temizler ve dikkatlice kaldırır.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760780208
					]
				},
				{
					"id": 760780208,
					"content": "Vahşi Avın tamamen ortadan kaybolmamasının sebebi bu fener olmalı. Genel merkezden biri gelip alana kadar yanımda tutacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780209
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780209,
					"content": "... Bir dakika, fenerin altında bir şey var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780210
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760780210,
					"content": "Sanırım aynı meslektaşımın geriye bıraktığı bir yadigar bu. Feneriyle bir arada durmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
			]
		},
