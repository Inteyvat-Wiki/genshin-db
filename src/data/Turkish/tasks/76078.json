			"dialogs": [
				{
					"id": 760780401,
					"content": "Normalde yakınlardaki canavarlar temizlendiğinde buradaki yarıkların kendiliğinden kaybolması lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780402
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780402,
					"content": "Peki neden hâlâ Vahşi Avın varlığı hissediliyor? Bu çok tuhaf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780403
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780403,
					"content": "Gözden kaçırdığım bir şey olabilir mi? Vahşi Av tarafından kirletilmiş başka bir şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
