			},
			"dialogs": [
				{
					"id": 760780501,
					"content": "Burada bir Yemin Feneri de var. Bizden önce buraya gelen birine ait olmalı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780502
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780502,
					"content": "Fener hâlâ Vahşi Av aşındırmasının izlerini taşıyor. Ne olduğunu tahmin etmek zor değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780503
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780503,
					"content": "Yemin Fenerini aldığımız günden itibaren hayatlarımız içindeki aleve bağlanır, ta ki görevimiz tamamlanana kadar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780504
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780504,
					"content": "Nod-Krai'ın barışı ve güvenliği için son nefesine kadar savaşan size en derin saygılarımı sunuyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780505
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780505,
					"content": "Şimdilik fenerinizi alacağım. İçiniz rahat olsun, şerefiyle şehit olanların tacı mirasınızı güvende tutacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780506
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780506,
					"content": "Onu karargaha götüreceğim, alevini yeniden yakacağım ve vasiyetinizi devralmaya layık birine emanet edeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780507
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760780507,
					"content": "Illuga, feneri temizler ve dikkatlice kaldırır.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760780508
					]
				},
				{
					"id": 760780508,
					"content": "Böylece Vahşi Av buradan tamamen temizlendi ve bizden önce gelen kişinin ruhu nihayet huzura kavuştu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		}
