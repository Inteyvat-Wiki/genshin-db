				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120210804,
					"content": "Biliyor musun, Watatsumi Adası'ndaki en eski tapınak Sangonomiya'da değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210805
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210805,
					"content": "Yedilerin Heykeline yakın bir yerlerdeydi. O zamanlar bu adanın yerlileri Şogun'un varlığını kabul etmiş ancak Şogunluk kadar saygı göstermemişler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210806
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210806,
					"content": "Fakat koruyucu ilahımız hayatını kaybettikten sonra tapınak terk edilmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210807
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210807,
					"content": "O zamandan beri Watatsumi Adası ve Şogunluk arasındaki ilişki hiç düzelmemiş. Güvensizlik zaman içerisinde daha da kök salmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210808
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210808,
					"content": "Barış konuşmalarında bu konuları gündeme getirip etraflıca görüşmeyi umuyorum. Eninde sonunda bu sorunları aşmamız gerek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210809
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210809,
					"content": "Ekselansları, işiniz başınızdan aşkınken sizi buraya hangi rüzgar attı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210810
					],
					"speakerTitle": "Youkou"
				},
				{
					"id": 120210810,
					"content": "Şu halinize de bir bakın... Kendinize daha iyi bakmalısınız, anlaştık mı? Hepimizin kaderi sizin ellerinizde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210811
					],
					"speakerTitle": "Youkou"
				},
				{
					"id": 120210811,
					"content": "Endişelendiğiniz için teşekkür ederim fakat ben iyiyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210812
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210812,
					"content": "Ekselansları size yalvarıyorum. Lütfen bu tavsiyeme kulak verin. Şogun Ordusuyla çok uzun süredir savaşıyoruz. Bunca zamandan sonra barış ilan etmek bu kadar basit değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210813
					],
					"speakerTitle": "Yuna"
				},
				{
					"id": 120210813,
					"content": "Onlarla barış yaparsak bir zamanlar bizi koruyan tanrı bir hiç uğruna ölmüş olacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210814
					],
					"speakerTitle": "Yuna"
				},
				{
					"id": 120210814,
					"content": "Yapma lütfen. Geçmiş, geçmişte kaldı. Ayrıca savaş zar zor bitti zaten. Bir kez daha barış sağlandığı için minnettar olmalıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210815
					],
					"speakerTitle": "Youkou"
				},
				{
					"id": 120210815,
					"content": "Biliyorum, biliyorum. Sadece... *iç çeker* Bu anlaşmalarda gücümüzü belli etmeliyiz. Anlaşmaya varmak için can atıyor gibi görünmememiz lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210816
					],
					"speakerTitle": "Yuna"
				},
				{
					"id": 120210816,
					"content": "Endişelerinizi anlayışla karşılıyorum. Seçenekleri dikkatli bir şekilde değerlendirip en uygun olan yoldan ilerleyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210817
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210817,
					"content": "Harika... Size olan güvenimiz sonsuz Ekselansları.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210818
					],
					"speakerTitle": "Yuna"
				},
				{
					"id": 120210818,
					"content": "Ekselansları? Sizi buralarda görmek ne büyük şans.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210819
					],
					"speakerTitle": "Shiori"
				},
				{
					"id": 120210819,
					"content": "Biliyor musunuz? Kızım bu seneki tapınak görevlisi seçimlerine adını yazdırdı. Sangonomiya'ya gitmeyi başarırsa dünyanın en mutlu annesi ben olacağım! Siz nazik ve iyi niyetli bir lidersiniz. İyi ellerde olacağından şüphem yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210820
					],
					"speakerTitle": "Shiori"
				},
				{
					"id": 120210820,
					"content": "*iç çeker* Kızıma her zaman söylerim, olur da Ekselanslarının kendisinden bir şeyler öğrenme fırsatı yakalayabilirse sonuna kadar kullanmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210821
					],
					"speakerTitle": "Shiori"
				},
				{
					"id": 120210821,
					"content": "Demek istediğim, Ekselanslarına da bir bakın. Hâlâ çok genç ama bir o kadar da olgun ve zeki. Kızım için her zaman bir rol model olmuşsunuzdur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210822
					],
					"speakerTitle": "Shiori"
				},
				{
					"id": 120210822,
					"content": "Eğer kızınız Sangonomiya'ya gelebilirse onunla ilgileneceğim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210823
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210823,
					"content": "Ekselansları! Sizi görebildiğime sevindim. Bildiğiniz üzere, tarım faaliyetleri geçtiğimiz yıl oldukça büyük bir darbe aldı. İzin verin size son durumu kısaca anlatayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210824
					],
					"speakerTitle": "Iwata"
				},
				{
					"id": 120210824,
					"content": "Ekselansları, yoksa yanınızdaki Kılıç Balığı II'nin Yüzbaşısı mı? Kendisi artık Watatsumi Adası'nda mı görev yapacak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210825
					],
					"speakerTitle": "Ryouko"
				},
				{
					"id": 120210825,
					"content": "Ekselansları...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210826
					],
					"speakerTitle": "Yukiya"
				},
				{
					"id": 120210826,
					"content": "Şey... Lütfen herkes sakin olsun. Bütün sorularınızı cevaplayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210827
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210827,
					"content": "Aslında sorusu uzun olanlar bir rapor yazıp tapınağa bildirebilirse çok sevinirim. Böylelikle zamanım olduğunda hepsine cevap verebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210828
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210828,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210829
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210829,
					"content": "#{NICKNAME}, sen iyi misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210830,
						120210832
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210830,
					"content": "İyiyim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210831
					]
				},
				{
					"id": 120210831,
					"content": "Eh... Bu tarz şeylere alışıksındır herhalde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210834
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210834,
					"content": "Ekselansları, işte buradasınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210835
					],
					"speakerTitle": "Izumi Naki"
				},
				{
					"id": 120210835,
					"content": "Bir sorun var. Hâlâ seremonide kullanılacak eşyaların gelmesini bekliyoruz. Çalındıklarını düşünmeye başladım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210836
					],
					"speakerTitle": "Izumi Naki"
				},
				{
					"id": 120210836,
					"content": "Eşyaları çoktan geri aldık. Endişelenmeye gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210837
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210837,
					"content": "Gerçekten mi? Harika haber! Bizi şaşırtmaya devam ediyorsunuz Ekselansları!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210838
					],
					"speakerTitle": "Izumi Naki"
				},
				{
					"id": 120210838,
					"content": "Yakın zamanda gelen dilekçeleri düzenleyip masanızın üstüne bıraktım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210839
					],
					"speakerTitle": "Izumi Naki"
				},
				{
					"id": 120210839,
					"content": "Ayrıca takviminizde yer alan bugünkü tekstil endüstrisinin gelişimi hakkındaki toplantıya tam zamanında yetiştiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210840
					],
					"speakerTitle": "Izumi Naki"
				},
				{
					"id": 120210840,
					"content": "O bugün müydü? Şimdi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210841
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210841,
					"content": "Evet. Hanımefendiler sağ salim gelebilmiş. Biz de sizi bekliyorduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210842
					],
					"speakerTitle": "Izumi Naki"
				},
				{
					"id": 120210842,
					"content": "#Hımm, anladım... *iç çeker* {NICKNAME}, seninle birlikte adayı dolaşırız diye umuyordum fakat görünüşe göre bu plan başka bir zamana sarkacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210843
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210843,
					"content": "Yarın Sangonomiya Tapınağının girişinde buluşalım. Sonra da Zafer Ziyafetinin hazırlıklarıyla ilgileniriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210844
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210844,
					"content": "Yaşasın! Zafer Ziyafeti. Emin olmak için soruyorum, bir sürü lezzetli yiyecek olacak, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210845
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210845,
					"content": "Haha... İşin en önemli kısmı o zaten. Hoşunuza gideceğini düşündüğüm Watatsumi Adası'na özel yemekler olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210846
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210846,
					"content": "Ne güzel! Yarın görüşürüz o zaman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210847
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210847,
					"content": "Hım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210832,
					"content": "Benim için bir sabır testi oluyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210833
					]
				},
				{
					"id": 120210833,
					"content": "*iç çeker* Benim için de. Oldukça sinir bozucu olabiliyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210834
					],
					"speakerTitle": "Sangonomiya Kokomi"
				}
			]
		},
