				{
					"id": 120210302,
					"content": "Kokomi, tüccarın mallarını bulduk. Baksana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210303,
					"content": "Hımm... Evet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210304,
						120210305
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210304,
					"content": "Bir sorun mu var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210306
					]
				},
				{
					"id": 120210306,
					"content": "Şey, hiç. Bir anlığına dalmışım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210307
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210307,
					"content": "Bir bakalım... Evet, bunlar çalınan mallar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210308
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210308,
					"content": "Yiyecek, ilaç, tarım malzemeleri... Savaştan sonra toparlanmak için gerekli olan her şey. Muhtemelen iyi bir kar elde edebilmek için bütün bunları stokluyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210309
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210309,
					"content": "Öte yandan Tenryou Heyetinin bunlara ihtiyacı olduğunu pek sanmıyorum. O yüzden tüccarın heyete mal tedarik ediyor olması akla yatmıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210310
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210310,
					"content": "Her halükarda o sadece fırsatçı bir tüccar. Matsuda ve Uchimura'nın düşündüğü gibi çetrefilli bir olay yokmuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210311
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210311,
					"content": "Yani... Sütten çıkmış ak kaşık da değil ama, değil mi? İnsanlar bu eşyaları bulamazken tüccarın hepsini stokluyor olması...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210312,
					"content": "Eşyaları geri verip yoluna gitmesine izin vermeyeceğiz her halde? Bu doğru bir davranış değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210313,
					"content": "Merak etme. Bunun olacağını tahmin etmiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210314
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210314,
					"content": "Yakın zamanda Savaş Sonrası Geçici Emirler yayınlamış ve temel günlük malzemelerin ücretlerine sınırlama getirmiştim. Eninde sonunda bu eşyalar uygun bir fiyattan alıcısını bulacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210315
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210315,
					"content": "Zaten zahmet edip de emirleri okumuş olsaydı böyle bir şeye kalkışmazdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210316
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210316,
					"content": "Kokomi, her şeyi düşünmüşsün!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210317,
					"content": "Her şeye değil maalesef. Mesela Tenryou Heyeti ve Fatui arasındaki şu gizli anlaşma iddiası. Hâlâ çok şaşkınım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210318
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210318,
					"content": "Kötü enerjinin hiçbir şeye faydası olmaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210319
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210319,
					"content": "Ne... Nasıl? Ne demek istiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210320,
					"content": "Hiç. Hadi şu malları geri götürelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210321
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210321,
					"content": "Zafer Ziyafetine az kaldı. Başlamadan önce yetişebilmek için hızlı davranmamız gerekecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210322
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210322,
					"content": "Anlaşıldı! Önce barışı getir, sonra yemekleri götür!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210305,
					"content": "Ne düşünüyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210306
					]
				}
			]
		},
		{
			"id": 1202104,
			"completionStepIds": [
				1202109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202109",
							"2"
						],
						"stepId": 1202109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Naruse",
					"Matsuda",
					"Sangonomiya Kokomi",
					"Uchimura"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120210401,
					"content": "Mallarım! Geri almışsınız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210402
					],
					"speakerTitle": "Naruse"
				},
				{
					"id": 120210402,
					"content": "Teşekkür ederim Ekselansları! Size de teşekkür ederim Yüzbaşı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210403
					],
					"speakerTitle": "Naruse"
				},
				{
					"id": 120210403,
					"content": "Demiştim işte. Size masum olduğumu söylemiştim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210404
					],
					"speakerTitle": "Naruse"
				},
				{
					"id": 120210404,
					"content": "Yok ya? Ben o kadar da emin değilim. Tüm bunları önceden Fatui ile birlikte planlamış olabilirsin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210405
					],
					"speakerTitle": "Matsuda"
				},
				{
					"id": 120210405,
					"content": "Fatui kampından elde ettiğimiz bilgilere göre tüccarın onlarla bir ilişkisi yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210406
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210406,
					"content": "Tüm süreci Fatui yönetmiş olsaydı arkalarında mutlaka delil bırakırlardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210407
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210407,
					"content": "Ama... Ya eğer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210408
					],
					"speakerTitle": "Uchimura"
				},
				{
					"id": 120210408,
					"content": "Ama, eğer falan yok. Malları geri aldık. Önceden anlaştığımız gibi, bu onun masumiyetini kanıtlıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210409
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210409,
					"content": "Özür dilerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210410
					],
					"speakerTitle": "Matsuda"
				},
				{
					"id": 120210410,
					"content": "Galiba kendimizi fazla kaptırdık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210411
					],
					"speakerTitle": "Uchimura"
				},
				{
					"id": 120210411,
					"content": "Hıh! Ben size demiştim! Bu iki ahmağın olanlar hakkında hiçbir fikri yok. Beyinsiz kas yığınları sizi! Saçma sapan komplolardan falan bahsediyorsunuz... Bundan sonra bana dadanmazsınız artık, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210412
					],
					"speakerTitle": "Naruse"
				},
				{
					"id": 120210412,
					"content": "Beyefendi, çok ileri gidiyorsunuz. Size yöneltilen suçlamalar asılsız çıkmış olabilir fakat halkın ihtiyacı olan malları stoklamak Geçici Emirlere göre bir suçtur. Sonuçlarına katlanacaksınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210413
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210413,
					"content": "Bu malların size ait olduğunu çoktan söylediniz zaten. Biz de üzerimize düşeni yapmak zorundayız. Bu malları belirtilen ücretlerde satmanın yanı sıra bir de para cezası ödeyeceksiniz. Tutarı da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210414
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210414,
					"content": "Durun, durun, durun! Ekselansları... Kimin tarafındasınız siz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210415
					],
					"speakerTitle": "Naruse"
				},
				{
					"id": 120210415,
					"content": "Benim taraf tuttuğum falan yok. Watatsumi Adası'nın Kutsal Rahibesi olarak, açık ve tutarlı bir şekilde ödüllendirme ve cezalandırma ilkesine riayet ediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210416
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210416,
					"content": "Faziletli davranışlar nasıl takdir ediliyorsa yanlışların da cezalandırılması gerekir. Size yöneltilen ciddi suçlara karşı masumiyetinizi ispatlamış olabilirsiniz fakat bu, yaptığınız yanlışların cezasını çekmeyeceğiniz anlamına gelmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210417
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210417,
					"content": "Bekleyin bir dakika! Ben... Ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210418
					],
					"speakerTitle": "Naruse"
				},
				{
					"id": 120210418,
					"content": "Ee ne duruyorsunuz? Alın götürün! Bedelini ödemenin vakti geldi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210419
					],
					"speakerTitle": "Matsuda"
				},
				{
					"id": 120210419,
					"content": "Ekselansları, bütün malların kendisine ait olduğunu söylüyor ama mantıklı olmayan bir şeyler var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210420
					],
					"speakerTitle": "Uchimura"
				},
				{
					"id": 120210420,
					"content": "Tenryou Heyeti simgesi olanlar muhtemelen onun fakat geri kalanı değil. Özellikle de bunlar, belli ki tapınağa aitler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210421
					],
					"speakerTitle": "Uchimura"
				},
				{
					"id": 120210421,
					"content": "Hımm... Sanki Fatui üyeleri çaldıkları bütün malları bir yere yığmış. Tapınak eşyalarını bana bırakın. Geri kalanının da sahiplerini bulun ve onlara geri verin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210422
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210422,
					"content": "Biraz zor olacak biliyorum ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210423
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210423,
					"content": "Hiç sorun değil Ekselansları. Bu işle ilgileneceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210424
					],
					"speakerTitle": "Uchimura"
				},
				{
					"id": 120210424,
					"content": "Beni mazur görün Ekselansları ama bir iş birliği olduğuna dair hiçbir işaret bulamasak da halkımız gördüğünü anlatır. Tenryou Heyeti ve Fatui arasında bir şeyler dönüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210425
					],
					"speakerTitle": "Uchimura"
				},
				{
					"id": 120210425,
					"content": "Barış konuşmalarının yaklaştığını biliyorum o yüzden... Lütfen bunları göz önünde bulundurun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210426
					],
					"speakerTitle": "Uchimura"
				},
				{
					"id": 120210426,
					"content": "Endişelenmeni anlayışla karşılıyorum. Bu konular üzerine kafa yoracağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210427
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210427,
					"content": "#{NICKNAME}, bu eşyaları Sangonomiya Tapınağına geri götüreceğim. Bana eşlik etmek ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				}
			]
		},
		{
			"id": 1202108,
			"completionStepIds": [
				1202114
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202114",
							"2"
						],
						"stepId": 1202114,
						"stateName": "QUEST_STATE_UNFINISHED"
