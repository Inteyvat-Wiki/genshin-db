			},
			"dialogs": [
				{
					"id": 120210101,
					"content": "Burası tüccarın bahsettiği Fatui kampı olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210102
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210102,
					"content": "Görünüşe göre eskiden bir dağ yabanisi kampıymış. Fatui üyeleri burayı neden işgal etti kim bilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210103
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210103,
					"content": "Burası... Savunmaları oldukça güçlü gibi. Nasıl gireceğiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210104,
					"content": "Kaba kuvvet kullanarak değil orası kesin. Ancak bu sorun değil. Arazi avantajı bizde ve henüz konumumuzu bilmiyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210105
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210105,
					"content": "Düşmanımız apaçık ortadayken biz gölgelerdeyiz. Stratejik olarak üstünlük bizde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210106
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210106,
					"content": "Strateji ustamızın aklında ne var peki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210107
					]
				},
				{
					"id": 120210107,
					"content": "Hımm... Üç seçeneğimiz var gibi duruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210108
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210108,
					"content": "1. Seçenek: Şahı alırsak şah mat olur ve oyun biter. Şu anda Fatui Inazuma'da güçsüz durumda. Birbirinden bağımsız birkaç kalıntıdan ibaretler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210109
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210109,
					"content": "Yukarıdan saldırıp ilk olarak liderlerini etkisiz hale getirirsek geriye kalanlar düzgün bir şekilde savaşamayacak kadar zor durumda kalacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210110
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210110,
					"content": "#2. Seçenek: Zayıf yerlerinden vurmak. Bak {NICKNAME}, tam şurada. Barut fıçıları var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210111
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210111,
					"content": "Eğer onlar farkına varmadan fıçıları ateşe verebilirsek devasa bir patlama yaratabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210112
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210112,
					"content": "Tamamen savunmasız bir şekilde yakalanırlar ve böylece hem moralleri hem de savaşma kabiliyetleri dibe vurur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210113
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210113,
					"content": "3. Seçenek: Doğayı düşmanına karşı kullanmak. Denize yakın bir konumdayız ve dolayısıyla hava oldukça nemli. Ben su buharı toplarım, sen de bir yıldırım indirirsin ve birlikte onların hakkından geliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210114
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210114,
					"content": "Vay be. Strateji ustası diye buna derim. Yalnız etraflıca düşünmemiz lazım. Hangi seçeneği uygulayacağız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120210115,
					"content": "Karar verirken kendi yeteneklerimizi değerlendirmemiz lazım önce.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210116
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210116,
					"content": "En hızlı şekilde kazanmak istiyorsak havadan sürpriz bir saldırı yapmalıyız. Fakat bu üstün savaş becerileri gerektirir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210117
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210117,
					"content": "Bir patlamayla savaşı uzatmadan sayılarını bir anda azaltabiliriz. Fakat operasyon sırasında gizliliğimizi mutlaka korumamız gerekiyor. Bizi fark etmeleri riskini alamayız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210118
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210118,
					"content": "#Doğa avantajını kullanmak istiyorsak uzun bir kuşatmaya hazırlıklı olmalıyız. Seçeneklerimiz bunlar {NICKNAME}, hangisini tercih ediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210119,
						120210123,
						120210127
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210119,
					"content": "Sürpriz hava saldırısı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210120
					]
				},
				{
					"id": 120210120,
					"content": "Haha... İşte Kılıç Balığı'ndan tanıdığım yüzbaşı. Yeteneklerine olan güvenin tam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210121
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210121,
					"content": "Karar verilmiştir o halde. Hadi birlikte savaşalım. Ben bir savaşçı değilim fakat sana destek sağlayabilirim. Savaşta seni yalnız başına bırakacak halim yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210122
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210122,
					"content": "Olabildiğince çabuk savaşı kazanmalı ve tüccarın mallarını geri almalıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210123,
					"content": "Barut planı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210124
					]
				},
				{
					"id": 120210124,
					"content": "Haha, stratejik düşünebilen tek ben değilmişim demek ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210125
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210125,
					"content": "Ben de bu taktiği tercih ederdim. Bizim için diğerlerinden daha az tehlikeli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210126
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210126,
					"content": "Hadi bir olup şunlara hayatlarının sürprizini yaşatalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210127,
					"content": "İşleri biraz kızıştıralım o zaman.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120210128
					]
				},
				{
					"id": 120210128,
					"content": "O halde kampın alacağı hasarı en aza indirmek için şunları biraz oradan uzaklaştıralım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210129
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210129,
					"content": "Geçmişte seninle sırt sırta savaşma şansı pek bulamadık. Hızına yetişebilir miyim emin değilim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210130
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210130,
					"content": "Yine de endişelenmeye gerek yok. Her ne kadar bir savaşçı olmasam da savaş alanlarına yabancı değilim. Kabiliyetlerim sayesinde bir sorun yaşayacağımızı sanmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210131
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210131,
					"content": "O zaman kampı temizleyelim ve neyin peşinde olduklarını öğrenelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				}
			]
		},
		{
			"id": 1202102,
