					"Sangonomiya Kokomi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120210201,
					"content": "Ne yalan söyleyeyim Fatui üyelerinin bir dağ yabanisi kampında gizlenmelerini beklemiyordum. Demek ki bir süredir işlerini buradan gizlice sürdürüyorlardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210202
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210202,
					"content": "Asıl amaçları ne acaba? Askerler haklı olabilir mi? Tenryou Heyetiyle iş birliği içinde olabilirler mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210203
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210203,
					"content": "Kampı arayıp bir delil bulabilecek miyiz bakalım. Tüccarın söyledikleri doğruysa malları buralarda bir yerde olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120210204
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120210204,
					"content": "Tamamdır! Etrafı arayalım o halde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
