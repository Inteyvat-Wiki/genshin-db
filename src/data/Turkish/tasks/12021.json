			"dialogs": [
				{
					"id": 120211001,
					"content": "#Çok iyi iş çıkardın {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211002
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120211002,
					"content": "Hehehe, hepsi senin dahiyane taktiklerin sayesinde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120211003,
					"content": "Aslına bakarsan en iyi taktikler bile onların ne kadar iyi uygulandığına göre sonuç verir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211004
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120211004,
					"content": "Bir savaşı kazanmak, o savaşa dahil olan herkesin çabasıyla başarılır. Zafer asla tek bir kişiye ait olamaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211005
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120211005,
					"content": "Lafı açılmışken, Paimon'un katkısı da yok sayılamaz, ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120211006,
					"content": "Maalesef aynı görüşte değilim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120211007
					]
				},
				{
					"id": 120211007,
					"content": "Hey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120211008,
					"content": "Ne yalan söyleyeyim Fatui üyelerinin bir dağ yabanisi kampında gizlenmelerini beklemiyordum. Demek ki bir süredir işlerini buradan gizlice sürdürüyorlardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211009
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120211009,
					"content": "Asıl amaçları ne acaba? Askerler haklı olabilir mi? Tenryou Heyetiyle iş birliği içinde olabilirler mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211010
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120211010,
					"content": "Kampı arayıp bir delil bulabilecek miyiz bakalım. Tüccarın söyledikleri doğruysa malları buralarda bir yerde olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211011
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120211011,
					"content": "Tamamdır! Etrafı arayalım o halde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
