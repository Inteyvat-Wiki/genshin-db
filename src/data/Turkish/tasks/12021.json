			"dialogs": [
				{
					"id": 120211101,
					"content": "Hımm... Bu işi \"kitabına göre\" hallettik diyemeyiz sanırsam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211102
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120211102,
					"content": "Fakat olur böyle şeyler. Savaşlar karmaşık olaylardır ve durum bir anda tersine dönebilir. Plana bağlı kalmak her zaman işe yaramayabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211103
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120211103,
					"content": "Hehe... Sanki savaş başlar başlamaz planı rafa kaldırıp doğaçlama yaptık sanki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120211104,
					"content": "Yine de sonuç oldukça memnun edici. Yeteneklerinin ve uyum sağlamaya olan isteğinin bir kanıtı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120211105
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120211105,
					"content": "Ne yalan söyleyeyim Fatui üyelerinin bir dağ yabanisi kampında gizlenmelerini beklemiyordum. Demek ki bir süredir işlerini buradan gizlice sürdürüyorlardı.",
					"roleType": "TALK_ROLE_NPC",
