			"dialogs": [
				{
					"id": 150421501,
					"content": "Harika, bir sayım yapalım. Bir, iki, üç, dört...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421502
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421502,
					"content": "Bir kişi fazlamız var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421503
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421503,
					"content": "Selamlar! Dalgalı Koy'daki ana mücadeleye katılmaya geldiniz, değil mi? Maalesef ufak bir sorunla karşı karşıyayız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421504
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421504,
					"content": "Ama şey... Albümünüz için fotoğraf gerekiyorsa toplu fotoğrafınızı çekebilirim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421505
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421505,
					"content": "Hayır... Olmaz öyle şey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421506
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421506,
					"content": "Fotoğraflar hatıraları saklamanın bir yoludur yalnızca, baktığında mutlu anlarını hatırlarsın. Bizim için asıl önemli olan deneyimin kendisi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421507
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421507,
					"content": "Şey, bu fotoğrafları ödüllerle takas edebiliyoruz ama... Tamam ya, haklısın. Fotoğraf çekip öylece gidivermek doğru gelmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150421508,
					"content": "Anlıyorum, çok özür dilerim. Lütfen bize biraz daha müsaade edin. Sorunu en kısa sürede çözmek için elimizden geleni yapacağız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421509
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421509,
					"content": "Ne kadar sürer peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150421510,
					"content": "Net bir şey söyleyemiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421511
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421511,
					"content": "Nedenmiş o?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150421512,
					"content": "Yardım edebileceğimiz bir şey var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421513
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421513,
					"content": "Şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421514
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421514,
					"content": "Dalgalı Koy'daki diğer aktivitelerde pek fazla kişi çalışmıyor, Sürüngen çalışanlar da çok yorgun görünüyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421515
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421515,
					"content": "Ana aktivite programında sıkıntı yaşandığı için herkes onarım işlerine yardım etmek üzere görevlendirildi herhalde, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421516
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421516,
					"content": "Merak etme. Bize söyleyemeyeceğin detaylar olabilir, bunun farkındayım. İşini zorlaştırmaya çalışmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421517
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421517,
					"content": "Hatta tam tersi, işini kolaylaştırabilirim. Yoldaşlarımın hepsi çok yetenekli ve seve seve yardım ederler. Alacakaranlık Yolculuğunu ve Asha Yarışının testini yeni bitirdiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421518
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421518,
					"content": "Bize sorunun ne olduğunu söylersen hemen çözmene yardım edebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421519
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421519,
					"content": "Vay be, şu müzakere yeteneğine bak sen! Ara Bulucunun gizli yeteneği buymuş demek ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150421520,
					"content": "Bir dakika Chasca... Bunların hepsini nasıl fark ettin? Gizlice ağaç tepesine tüneyip bizi mi gözetledin yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421521
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421521,
					"content": "Bunun şu anda bir önemi var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421522
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421522,
					"content": "Asıl önemli olan... Yardım etme konusunda çok başarılı olmamız! Bir sorun varsa hepimiz üstümüze düşeni yapmaktan mutluluk duyarız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421523
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150421523,
					"content": "Sürüngenlerle ilgili ayrıntılara kadar tüm gözlemlerin doğru... Kusura bakmayın, bunu sizden saklamaya çalışmamalıydım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421524
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421524,
					"content": "Şimdi şöyle oldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421525
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421525,
					"content": "Göz Kamaştıran Mega Kaydırağı test ederken boyasının hâlâ yeterince iyi olmadığını fark ettik. Ruhani Yolun üzerinden boyanması gerekiyor, o yüzden kolay bir iş değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421526
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421526,
					"content": "Tatil köyünün resmi açılış tarihini ertelememek için mecburen kaydırağı geçici olarak kapattık. Şimdi de boyasını bir an önce tamamlamaya çalışıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421527
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421527,
					"content": "Haha... Zorluk dediğin bu muydu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421528
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421528,
					"content": "Boyaların yerini söyle, ben hemencecik hallederim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421529
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421529,
					"content": "Ne? Ama böyle bir şeyi nasıl...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421530
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421530,
					"content": "Onu tanımadığın için öyle düşünmen normal. Kendisi \"Umo{RUBY#[S]Birlik}ja\" Mualani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421531
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421531,
					"content": "Mualani... Bir saniye, bildiğimiz Mualani mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421532
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421532,
					"content": "Altı kahramandan biri olan meşhur Mualani mi yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tuksina"
				}
			]
		},
