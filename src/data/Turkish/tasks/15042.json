			"dialogs": [
				{
					"id": 150421701,
					"content": "Ellerine sağlık Mualani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150421702,
					"content": "Oh be... ÇOK İYİYDİ! Nasıldım millet? Hiç fena olmadı, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421703
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421703,
					"content": "Harika görünüyor! Cidden kahramanca bir iş çıkardın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421704
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150421704,
					"content": "Sen yokken Paimon bana senden epey bahsetti. Başardığın her şey o kadar muhteşem ki! Ciddiyim, düşününce bile çok heyecanlandım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421705
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150421705,
					"content": "Aa, çok sağ ol, haha! Ben de o kadar coşkuluyum ki bıraksan tam şuracıkta kaplıca partisi düzenleyeceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421706
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421706,
					"content": "Aa, bakın! Dalgalı Koy görevlileri de gelmiş! O kadar uğraştılar, biraz dinlenmek için can atıyorlardır şimdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421707
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421707,
					"content": "Bence akılları başka yerde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421708
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421708,
					"content": "Hı? Nasıl yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421709
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421709,
					"content": "Mualani, Mualani! İmzanı alabilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421710
					],
					"speakerTitle": "Tuksina"
				},
				{
					"id": 150421710,
					"content": "Ben de!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421711
					],
					"speakerTitle": "Gaun"
				},
				{
					"id": 150421711,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421712
					],
					"speakerTitle": "Yavru Iktomizor"
				},
				{
					"id": 150421712,
					"content": "Kimliğin ifşa oldu anlaşılan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421713
					]
				},
				{
					"id": 150421713,
					"content": "Eyvah, başkaları da gelmeden toplu fotoğraf çekilelim hemen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421714
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421714,
					"content": "Kocaman gülümseyin, başınızı dik tutun! Okyanusu ve uğurlu renginizi düşünün...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421715
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150421715,
					"content": "Üç, iki, bir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421716
					],
					"speakerTitle": "Mualani"
				},
