			},
			"dialogs": [
				{
					"id": 150421301,
					"content": "Gözlerin keskinmiş! Bu kadar yüksekteyken beni görebileceğini düşünmemiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421302
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421302,
					"content": "Görünüşe göre buradaki aktiviteler senin de ilgini çekmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421303,
						150421305
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421303,
					"content": "Aktiviteler eğlenceli mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421304
					]
				},
				{
					"id": 150421304,
					"content": "Bence güzeller ama \"eğlence\" kısmı kişiden kişiye göre değişir. Benim görüşlerimin çok bir önemi yok, kendin deneyip görmelisin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421307
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421307,
					"content": "Şuradaki pisti görüyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421308
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421308,
					"content": "Pistte sıralanan topları renklendirmek için boya toplarını kullan. Hepsini aynı renge boyadığında toplar \"bam\" diye yok olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421309
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421309,
					"content": "Aslında yakınlarda elinde silahıyla bekleyen biri olabilir. Zamanı gelince renkli topları vuruyordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421310,
						150421311
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421310,
					"content": "İnanılmaz...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421312
					]
				},
				{
					"id": 150421312,
					"content": "Dene ve gör. Şuradaki silahı kullanabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421313
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421313,
					"content": "Bu sefer sen oynarken ben izleyeceğim. İyi şanslar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150421311,
					"content": "Sözüne inanasım geldi bir an.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421312
					]
				},
				{
					"id": 150421305,
					"content": "Aktiviteler karmaşık mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150421306
					]
				},
				{
					"id": 150421306,
					"content": "Merak etme, gayet basitler. Buranın teması belli zaten. İstesen de \"karmaşık\" ya da \"zor\" bir mücadele bulabileceğini sanmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150421307
					],
					"speakerTitle": "Chasca"
				}
			]
		},
