			"dialogs": [
				{
					"id": 150420101,
					"content": "Vuhuuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420102
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420102,
					"content": "Güneş, dalgalar ve Koholazorlar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420103
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420103,
					"content": "Suyu görür görmez bizi unuttu. Paimon \"Umo{RUBY#[S]Birlik}ja\" Kadim Adının kimseyi geride bırakmamak anlamına geldiğini sanıyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150420104,
					"content": "Çabuk, bu taraftan! Hadi millet, aylaklık etmeyin... Gidelim artık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420105
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420105,
					"content": "Geliyoruz, geliyoruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420106
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150420106,
					"content": "Baksana, burada ne görüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420107
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420107,
					"content": "Tahta bir kalas.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150420108,
					"content": "Sıradan bir tahta kalas değil ama. Üstünde yazanı oku!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420109
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420109,
					"content": "Aaaa, gezi haritasıymış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150420110,
					"content": "Evet! Saklı hazinelerle dolu bir mahzenin anahtarı olabilir bu harita...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420111
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420111,
					"content": "Evet, bence de! Maceraya davetiye gibi adeta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420112
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150420112,
					"content": "Evet! Ya da yakıcı Filojiston korları gibi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420113
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420113,
					"content": "Filojiston mu? Hımm... Bir tür enerjiydi o, değil mi? Haritanın Filojistona benzemesinin sebebi... Tek bakışta insanı harekete geçirmesi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420114
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150420114,
					"content": "Evet! Tabii bir de harita çok önemli, tıpkı Filojiston gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420115
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420115,
					"content": "Elinde bir harita olduğu sürece maceranda kendi yolunu dilediğin gibi çizebilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420116
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420116,
					"content": "Hehe, özgürlük ve macera! Bu hoşuma gitti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420117
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150420117,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420118
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150420118,
					"content": "Hey, bekleyin iki dakika millet. Paimon'a neden Mualani bir şey saklıyormuş gibi geldi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150420119,
					"content": "Pekala millet, herkesin kendi başına keşfe çıkma zamanı geldi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420120
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420120,
					"content": "Bir saniye ya, böyle tur rehberi mi olur? Bizi gezdirmesi gerekmez mi, REHBER ya sonuçta?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420121,
						150420122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150420121,
					"content": "Belki Mualani kendi başına gezmek istiyordur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150420123
					]
				},
				{
					"id": 150420123,
					"content": "Hehe, gerçek bir dost gibi konuştun. Bu desteğini unutmayacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420124
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420124,
					"content": "Şunlara bir bakın. Bu iki büyük aktivite noktası \"Test Aşamasında\" olarak işaretlenmiş. Tahminimce bazı sorunlarla karşılaştılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420125
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420125,
					"content": "Şimdi şöyle, ayrılırsak hepimiz ilgimizi çeken aktivitelere göz atıp aynı anda testlere de yardımcı olabiliriz. Belki böylece Dalgalı Koy beklediğimizden daha erken açılır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420126
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420126,
					"content": "Aa, başından beri tüm grubu düşünüyormuşsun... Pardon, Paimon su aktiviteleri için heyecanlanıp bizi unuttun sandı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150420127,
					"content": "Hehe, hiç sorun değil. İşimiz bittiğinde şu devasa Koholazor binasının orada buluşalım mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420128
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420128,
					"content": "Yıllardır edindiğim rehberlik tecrübesine dayanarak, içimden bir ses ana mücadelenin girişinin şuralarda bir yerde olduğunu söylüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420129
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420129,
					"content": "Tamam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150420130
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150420130,
					"content": "Pekala, hadi ayrılalım o zaman. Haritayı kontrol etmeyi unutmayın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150420122,
					"content": "\"Tur rehberi\" olsa bile o da tatil yapmayı hak ediyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150420123
					]
				}
			]
		},
