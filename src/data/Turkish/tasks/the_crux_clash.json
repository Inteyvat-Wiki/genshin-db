							"200106",
							"2"
						],
						"stepId": 200106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rongshi",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20010601,
					"content": "İyi ter attım, güzel savaşıyorsun, beğendim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010602
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010602,
					"content": "Tebrikler, en iyi savaşçı beni yendi. Daha çok çalışmam gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010603,
						20010604
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010603,
					"content": "Sen de güzel savaşıyorsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010605
					]
				},
				{
					"id": 20010605,
					"content": "Değil mi ama! Paimon bir an için çok endişelendi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010606,
					"content": "Bir Önsezin olsaydı kesinlikle en güçlülerden biri olurdun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010607,
					"content": "Çocukken bir keresinde Önsezim olsun istemiştim. İnsanlar, yeterince güçlü olursam, bir Önsezi elde etme şansımın olacağını söylemişlerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010608
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010608,
					"content": "Ama bu şansı hiç yakalayamadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010609
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010609,
					"content": "Sonradan ben de ilgimi kaybettim. Bir Önseziye, kendi bedenine güvenebildiğin gibi güvenemezsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010610
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010610,
					"content": "Daha önce Önsezisi olan kişilerle savaştım ve kazandım. Sahip oldukları gücü onlara tanrılar vermişti ama ben bunu kıskanmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010611
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010611,
					"content": "Ne? Yani şu Efendisiz Önseziye sahip olmak için kayıt yaptırmadın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010612,
					"content": "Hayır. Sadece diğer savaşçılara karşı yarışmak ve kimin daha güçlü olduğunu görmek istedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010613
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010613,
					"content": "Yalnızca yenilerek kendi zayıflıklarını görebilir ve onlardan ders çıkarabilirsin. Yani bugünkü sonuçtan memnunum. Genelde mağlubiyet zevkini pek tadamıyorum ama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010614
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010614,
					"content": "Vay be... Gerçek güç bu işte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010615,
					"content": "İleride fırsatın olursa, lütfen tekrar savaşalım. Bir dahaki sefere daha güçlü olacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010616
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010616,
					"content": "Ben de öyle olacağım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010617
					]
				},
				{
					"id": 20010617,
					"content": "Bu arada... Kimin finale kaldığını biliyor musun? Senden daha zorlu bir rakip mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010618,
					"content": "Benim kadar zorlu olup olmayacağını bilmiyorum... Ama duyduğuma göre çok hızlı biriymiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010619
					],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010619,
					"content": "Bu yüzden asla kendini riske atma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rongshi"
				},
				{
					"id": 20010604,
					"content": "Bence şampiyon olma potansiyelin var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010605
					]
				}
			]
		},
		{
			"id": 200109,
			"completionStepIds": [
				200109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
