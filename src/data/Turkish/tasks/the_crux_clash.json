			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha",
					"Beidou",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20010901,
					"content": "Üstün bir performans sergiledin. Gerçekten övgüye layıktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010902
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010902,
					"content": "Bu tarza pek alışkın olmadığını anladım ve bu, karşılaşmayı kaybetmene neden olabilirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010903
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010903,
					"content": "Ama hemen uyum sağladın ve rakibine karşı kazanmayı başardın. İşte bu, çok zor elde edilen bir beceridir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010904,
						20010905
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010904,
					"content": "Keskin bir gözün var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010906
					]
				},
				{
					"id": 20010906,
					"content": "Aslında bunu gördüklerimden değil de duyduklarımdan, yani ayaklarının altındaki zeminden ve nefes alışverişinden anladım. Ama öyle abartılacak bir şey değildi, bunları Kaptan Beidou da anladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010907
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010907,
					"content": "Ahaha, gerçekten de öyleydi. Ama ben sadece önceki deneyimlerime güveniyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010908
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010908,
					"content": "Sanırım element güçlerini kullanmamak senin için çok yeni bir şey, ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010909,
						20010910
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010909,
					"content": "Kesinlikle öyle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010911
					]
				},
				{
					"id": 20010911,
					"content": "Son turda rakibimizin kim olacağını öğrenmek istiyoruz. Sence yarı finalde karşılaştığımızdan daha güçlü bir rakip mi olacak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010912,
					"content": "Pek sayılmaz. Finale ulaşan yarışmacılar kesin \"daha güçlü\" olacak diye bir şey yok. Ama genelde eşsiz bir tarzları olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010913
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010913,
					"content": "Senin karşılaşacağın kişiye gelince, onun becerisi hızlı olmasından ve üstün tekniğinden geliyor. Ayrıca savaş anlamında oldukça yetenekli olduğu da açıkça anlaşılıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010914
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010914,
					"content": "Ne oldu? Bu sefer yutabileceğinden daha büyük bir lokma ısırdığını mı düşünüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010915,
						20010916
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010915,
					"content": "Korkulu rüya görmektense uyanık yatmak iyidir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010917
					]
				},
				{
					"id": 20010917,
					"content": "Durum buysa sana bir teklifim var. Daha sessiz bir yere gidelim, ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010918
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010918,
					"content": "Kendimi doğru düzgün tanıtmadım. Ben, Inazuma topraklarında öylece dolaşan bir samuraydım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010919
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010919,
					"content": "Aa, evet, onu kılık kıyafetinden anlamıştık. Ama aynı zamanda... Kılıç sallamaya pek de alışkın biri gibi konuşmuyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010920
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010920,
					"content": "Hem edebi gelenekler hem de dövüş gelenekleri konusunda bilgili olduğum doğrudur. Öylece dolaşan bir samurayın, yollarda fazladan bir becerisinin olmasında sakınca yoktur herhalde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010921
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010921,
					"content": "Savaş hünerlerimle hava atmak istemem ama ben de dünyanın dört bir yanından gelen saygın savaşçılar gördüm. Rakibinin özel becerileri hakkında biraz bilgim var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010922
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010922,
					"content": "Yeteneklerini göz önünde bulundurunca, vereceğim birkaç ipucu, rakibini alt etmek için yeterli olacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010923
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010923,
					"content": "Bekle! Sence de kuralları biraz çiğnemiyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010924
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010924,
					"content": "İstihbarat toplamak, düellonun önemli bir parçasıdır. Düşmanını iyi tanımalısın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010925
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010925,
					"content": "Ayrıca buradaki favorimiz, Mondstadt'tan buraya gelirken yolda birçok savaşa katıldı. Böyle etkileyici başarılar için cesaretten fazlası gerekir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010926
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010926,
					"content": "Aynen öyle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010927
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010927,
					"content": "Hım, bir saniye. Mondstadt'a gittiğimizi sana hiç söylemedik ki biz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010928
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010928,
					"content": "Hehe, insan yabanda seyahat ederken arkasında hep iz bırakır. Karşılığında doğa da insanın üzerinde iz bırakır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010929
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010929,
					"content": "Ancak bu izlerden ancak bu kadarı anlaşılabiliyor. Seninle ilgili birçok şeyi hatırlayamıyorum... O yüzden bazı sorularıma yanıt arıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010930
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010930,
					"content": "Benimle gel. Karşılaşma sonrasında bir eğlence var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010916,
					"content": "Inazuma'ya gitmemiz çok önemli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010917
					]
				},
				{
					"id": 20010910,
					"content": "Evet, neyse ki bitti!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010911
					]
				},
				{
					"id": 20010905,
					"content": "Gözlem gücün hayli güçlüymüş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010906
					]
				}
			]
		},
		{
			"id": 200111,
			"completionStepIds": [
				200111
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
