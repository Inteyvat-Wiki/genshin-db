			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20011101,
					"content": "Şimdi yalnız olduğumuza göre, asıl mevzuya geliyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011102
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011102,
					"content": "Sen elementleri kontrol edebiliyorsun. Üstelik sadece birini değil, birkaçını. Bu, doğru mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011103,
						20011104
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011103,
					"content": "Aa, demek çoktan biliyordun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011105
					]
				},
				{
					"id": 20011105,
					"content": "Paimon, tanıştığımız andan beri bir şeyleri ima ettiğini biliyordu. Demek bunca zamandır farkındaydın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20011106,
					"content": "Evet. Diğer yarışmacılar element kabiliyetlerini fark ederse, istenmeyen yanlış anlaşılmalara neden olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011107
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011107,
					"content": "Yanlış anlamadıysam, karşılaşmanın çekişmeli yerlerinde bile element becerilerini kullanmaktan çekinmene bakılırsa, sen de aynı fikirdesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011108
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011108,
					"content": "Evet ama nereden anladın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011109
					]
				},
				{
					"id": 20011109,
					"content": "Hehe, sende gördüğüm ya da duyduğum şeyler hakkında konuşurken, şiirsel sembolizm yapmıyorum. Bunları mümkün olan en gerçek anlamında söylüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011110
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011110,
					"content": "Küçük bir yaştan itibaren doğanın işaretlerine karşı uyum sağladım. Rüzgarın nefesini ve yaprakların fısıltılarını duyabiliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011111
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011111,
					"content": "Senin içinde duyduklarım da bu doğadan gelen şeyler, başka bir şey değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011112
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011112,
					"content": "Bu kulağa ne kadar çılgınca gelirse gelsin, Paimon yine de sana inanıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20011113,
					"content": "Benim alçak gönüllü yeteneklerim, senin inanılmaz başarılarının yanında önemsiz kalır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011114
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011114,
					"content": "Bir insanın, Önsezi olmadan elementleri kullanabileceğini düşünmek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011115
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011115,
					"content": "İnanılmaz derecede karmaşık kokundan bahsetmiyorum bile, sanki bir tür gizemli varlığın kokusu gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011116
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011116,
					"content": "Hey, bizi kokumuza göre değerlendirmeyi bırak! Bu çok tuhaf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20011117,
					"content": "Birleşik element yeteneklerini nasıl elde etmeyi başardığın konusunda, beni biraz aydınlatabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011118,
						20011119
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011118,
					"content": "Ne yazık ki ben de bilmiyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011120
					]
				},
				{
					"id": 20011120,
					"content": "Hım, gayet olağanüstü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011121
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011121,
					"content": "O zaman, element enerjisini yönlendirmeyi, hatta savaşta kullanmayı nasıl öğrendiğini sorabilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011122,
						20011123
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011122,
					"content": "Hepsi Paimon'un bilgisi sayesinde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011124
					]
				},
				{
					"id": 20011124,
					"content": "Ah, ben bir şey yapmadım ki. Paimon, ona sadece aklına gelenleri anlattı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20011125,
					"content": "Uzun süren bir maceraydı ve yol boyunca bir sürü şey yaşandı. Nasıl olduysa o, doğal olarak elementleri kullanmayı öğrendi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20011126,
					"content": "Doğrusu, Paimon bile bunların nasıl işlediğini anlamıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20011127,
					"content": "Belki de böyle akılalmaz şeyler, tanrıların özü ve bahşettikleri Önsezilerdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011128
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011128,
					"content": "Ancak yine de elementleri nasıl kullandığını görme onuruna erişmek istiyorum, belki bana bir şeyler gösterebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011129
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011129,
					"content": "Elbette, öğrendiklerimin hepsini seninle paylaşacağım. Böylece adil bir alışveriş olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011130,
						20011131
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011130,
					"content": "Gayet makul.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011132
					]
				},
				{
					"id": 20011132,
					"content": "O halde becerilerini test edelim, olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011131,
					"content": "Sonunda gerçek bir savaş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011132
					]
				},
				{
					"id": 20011123,
					"content": "Hepsi Paimon'un dostluğu sayesinde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011124
					]
				},
				{
					"id": 20011119,
					"content": "Tek yaptığım, bir Yedilerin Heykeline dokunmaktı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011120
					]
				},
				{
					"id": 20011104,
					"content": "Arenada bundan bahsetmemene şaşırmamalı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011105
					]
				}
			]
		},
		{
			"id": 200113,
			"completionStepIds": [
				200113
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200113",
							"2"
						],
						"stepId": 200113,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaedehara Kazuha",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20011301,
					"content": "Hım, savaştaki becerilerin gerçekten de kusursuz. Rakibin, hızıyla bile seni yenemez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011302
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011302,
					"content": "Rakibin, nefesini kontrol etme ve dengesini koruma konusunda becerikli. Bu da birçok kişinin imkansız sandığı hamleleri yapmasını sağlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011303
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011303,
					"content": "Zaferlerinin neredeyse hepsi sürpriz saldırısından geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011304
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011304,
					"content": "Başka bir deyişle, onun zayıf noktaları bulma yeteneğine dikkat ettiğin sürece, saldırıları senin için bir tehdit oluşturmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011305
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011305,
					"content": "Teşekkür ederim, rakibimi asla küçük görmeyeceğim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011306
					]
				},
				{
					"id": 20011306,
					"content": "Ne demek, rica ederim. Tüm ilkelere karşı koyan elementleri kullandığını görebildim ya, o bana yeter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011307
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011307,
					"content": "Gerçekten de dünya gizemli bir yer. İnsan daima henüz bilinmeyen şeylerle karşılaşabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011308
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011308,
					"content": "Önsezilere kafayı takmış gibisin... İyi de senin zaten kendi Önsezin yok mu? Neden Önseziler ve elementler arasındaki bağlantıyı keşfetmeye bu kadar kararlısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20011309,
					"content": "Önsezilerin, tanrılar için ne ifade ettiğini bilmek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011310
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011310,
					"content": "Ve tanrıların, insanlara bu Önsezileri neye göre verdiklerini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011311
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011311,
					"content": "Ah pardon. Bu tarz konulardan bihaber olmalısın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011312
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011312,
					"content": "Kendine ait gizemli yönlerini öğrenebilme onurunu bana verdiğin için, Inazuma hakkındaki tüm sorularını yanıtlamaya hazırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011313
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011313,
					"content": "Gerçekten de bihaberim, bu yüzden lütfen beni aydınlat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011314
					]
				},
				{
					"id": 20011314,
					"content": "Yani bunu mu merak ediyordun? Haha, öyleyse izin ver de anlatmaya devam edeyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011315
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011315,
					"content": "Senin de bildiğin üzere, şu anda Inazuma'da bir Önsezi Avı Fermanı yürütülüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011316
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011316,
					"content": "Önseziler, tanrıların bahşettiği hediyelerdir. Şimdiyse, bu hediyeyi kabul eden insanların Önsezilerine hiçbir açıklama yapılmaksızın el konuluyor. Bu durum, bazen asıl Önsezi sahiplerinin ölmesine bile neden oluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011317
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011317,
					"content": "Başlangıçta, canlı varlıklara Önsezi bahşetmek için Yedi Hükümdarın her birinin kendi kriterleri vardı. Şimdi ise mevcut Elektrik Hükümdarı bu kriterlerden, hatta bu şekilde Önsezi bahşedilmesinden tereddüt mü ediyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011318
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011318,
					"content": "Ayrıca, bu kadar uzun bir süredir yeni bir Elektrik Önsezisi verilmediği için, Şogun Raiden'ın bu konudaki düşüncelerinden bir şeyler çıkartabiliriz gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011319
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011319,
					"content": "Bir hükümdardan ziyade bir... Despota benziyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20011320,
					"content": "Benim bildiğim kadarıyla o, \"sonsuzluğun\" peşinde olan bir hükümdar. Başkalarının ne düşündüğünü veya ne hissettiğini umursamadan, istediğini acımasızca yerine getirecektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011321
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011321,
					"content": "Liyue'nin \"sözleşmeleri\", Liyue'de yaşayan herkese fayda sağlamak içindir. Ama Inazuma'nın \"sonsuzluk\" arayışı, halkına ne sağlıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011322
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011322,
					"content": "... Inazuma'da kilitli kalan insanların bugünlerde pek de iyi geçinemediği de aşikar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011323
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011323,
					"content": "Bu, en başta karşılaştığın tanrının yapacağı bir şey gibi görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20011324,
					"content": "Aa? Elektrik Hükümdarı'yla daha önce karşılaştın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011325,
						20011326
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011325,
					"content": "Emin değilim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011327
					]
				},
				{
					"id": 20011327,
					"content": "Zamanla hepimiz değişeceğiz. Ama şogun aynı kalacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011328
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011328,
					"content": "Onu bulmak istersen, o sonsuza dek orada olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011329
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011329,
					"content": "Benim de, onun \"sonsuzluğa\" verdiği cevapları anlamak isteyeceğim bir gün gelecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011330
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011330,
					"content": "Aa! Karşılaşmana az kaldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011331
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011331,
					"content": "Ah, doğru! Inazuma hakkında konuşurken dikkatimiz o kadar dağıldı ki, Paimon turnuvayı tamamen unuttu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20011332,
					"content": "Yapacak başka bir işin yoksa birlikte dönebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20011333,
						20011335
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011333,
					"content": "Olur, birlikte gidelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011334
					]
				},
				{
					"id": 20011334,
					"content": "Pekala, hadi gidelim. Önseziyi kimin alacağını görmek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011335,
					"content": "Az sonra ben de gelirim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011336
					]
				},
				{
					"id": 20011336,
					"content": "Pekala. Karşılaşmaya geç kalmadığından emin ol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20011326,
					"content": "Çok uzun zaman önceydi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20011327
					]
				}
			]
		},
