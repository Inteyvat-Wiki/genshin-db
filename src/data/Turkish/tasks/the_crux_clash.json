						],
						"stepId": 200103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Beidou",
					"Kaedehara Kazuha",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20010301,
					"content": "Hahaha, seni favorim olarak tanıtmaktan pişman olmayacağımı biliyordum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010302
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010302,
					"content": "Sen ne düşünüyorsun Kazuha? Şu adamı yerle bir etti, üstelik bunu şık bir şekilde yaptı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010303
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010303,
					"content": "Etkileyici. Ama aynı zamanda bizim favorimizin, sanki rakibini ciddi bir zarardan korumak istercesine, kendini biraz kısıtladığını fark ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010304
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010304,
					"content": "Ben de zamanında hem büyük hem de küçük savaşlarda savaştım. Az önceki performansından sonra, ben onun yeteneklerine ikna oldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010305
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010305,
					"content": "Hadi ama, hepimiz geniş bir kelime dağarcığın olduğunu biliyoruz, müstakbel şampiyonumuzu tebrik etmek için bir iki laf edemez misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010306
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010306,
					"content": "Peki... Bu övgü sözlerini nasıl uygun bir şekilde ifade edeceğimi bir düşüneyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010307
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010307,
					"content": "İyi dövüştün ha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010308
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010308,
					"content": "Ih, tamam o zaman. İçindeki şairin eğlenceye katılıp birkaç güzel şey söyleyebileceğini düşünmüştüm... Neyse seni sıkboğaz etmeyeyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010309
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010309,
					"content": "Biliyor musun, birçok yarışmacı bana geldi ve Liyueli bir kahramanın turnuvaya girmesine çok şaşırdıklarını söyledi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010310
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010310,
					"content": "Sen kaydolduğundan beri, aralarında birkaç üst düzey dövüşçünün de bulunduğu birçok kişi daha kayıt yaptırdı. Eminim birçoğu seninle boy ölçüşmek için buraya geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010311,
						20010312
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010311,
					"content": "Bu kadar popüler olduğumu bilmiyordum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010313
					]
				},
				{
					"id": 20010313,
					"content": "Haha, herkes seni yenmek istediğine göre, sanırım ben de artık sana öyle davranmaya başlamalıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010314
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010314,
					"content": "Öncelikle, seviyenin oldukça altındaki insanlarla savaşarak ilk turlarda tüm enerjini boşa harcamanı istemiyoruz. Sen de kendi liginden biriyle dövüşmek için can atıyor olmalısın, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010315
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010315,
					"content": "Bu yüzden seni doğruca yarı finale yükseltiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010316
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010316,
					"content": "Ne? Ama elemelere yeni başladık... Doğrudan yarı finale geçebiliyorsak, bu oldukça çılgın bir sistemmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010317,
					"content": "Kaptan Beidou'nun tarzı böyledir. Onu aksine ikna edemezsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010318
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010318,
					"content": "Ayrıca senin seviyendeki biri her türlü yarı finale geçerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010319
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010319,
					"content": "Hah. Doğrusu, Paimon da böyle düşünüyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20010320,
					"content": "Tamam, ben biraz daha turnuvayı izleyeceğim. Dişine göre rakipler çıkarsa kim olduklarını ve ne yaptıklarını bilmek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010321
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010321,
					"content": "Sonunda ulaştık millet! Gerçek gösteri başlamak üzere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010322
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010322,
					"content": "Hehe... Sanırım kaptanın bu turnuva için yüksek beklentileri var. Onu uzun süredir hiç bu kadar heyecanlı görmemiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010323
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010323,
					"content": "Rakibin, yarı finale gelmek için birçok turda güzel savaştı. Bu, onu deneyimli bir savaşçı yapar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010324
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010324,
					"content": "Ondan daha güçlü olabilirsin ama bu gardını indirebileceğin anlamına gelmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010325,
						20010326
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010325,
					"content": "Düşürmeyeceğim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010327
					]
				},
				{
					"id": 20010327,
					"content": "Pekala. İlerideki fırtınayı atlatmaya hazır mısın göster bakalım bana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20010328
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 20010328,
					"content": "Pekala, şimdilik bu kadar çene çalma yeter. İzleyici bekliyor. Git, seni kayıt yapan mürettebatı bul. O, seni arenaya götürecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20010326,
					"content": "Buraya geliş amacımı unutmadım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010327
					]
				},
				{
					"id": 20010312,
					"content": "Neden böyle yaygara çıkardıklarını anlamıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20010313
					]
				}
			]
		},
		{
			"id": 200106,
			"completionStepIds": [
				200106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
