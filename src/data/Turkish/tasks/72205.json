			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kito",
					"Kina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722050101,
					"content": "Tuhaf. Cebime koyduğumdan emindim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050102,
						722050103
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050102,
					"content": "Selamlar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050104
					]
				},
				{
					"id": 722050104,
					"content": "Bu işe yaramaz. Bunları Una Nine'ye vermemiz gerekiyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050105
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050105,
					"content": "Yaşlandı ve belli ki artık birçok şeyi hatırlayamıyor. Yakın zamanda gençliğini anlatmaya başladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050106
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050106,
					"content": "Sürekli olarak çiçeklerden bahsediyor... Hatta hem farklı görünen hem de güzel olan çiçeklerin Sis Denizi'nin ötesinden geldiğini bile söyledi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050107
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050107,
					"content": "Sonra bir gün bir rüya gördüm. Adayı sarmalayan sisin bir anda yok olduğunu gördüm. Okyanusun diğer tarafında büyük, güzel bir ev duruyordu. Ahşaptan değildi... Altından da değildi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050108
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050108,
					"content": "Ben de, ben de!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050109
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050109,
					"content": "O rüyada yüksek dağları aşıp devasa ağaçlara tırmandım ve bir sürü güzel çiçek topladım. Bu çiçekleri hayatımda hiç görmedim ama Una Nine'nin aradığı çiçeklerin bunlar olduğunu biliyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050110
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050110,
					"content": "Ama çiçekler çok ağırdı ve bu yüzden ağaçtan düştüm. Düştüm de düştüm... Sonra da uyandım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050111
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050111,
					"content": "Hah! Açgözlü olmanın dersini aldın işte. Yeterince aldık demiştim ama yoook, hiç dinler misin! Sayende ben de seninle ağaçtan düştüm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050112
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050112,
					"content": "Artık ceplerimiz boş ve her şeyi kaybettik... Bu halde nasıl Una Nine'nin karşısına çıkacağız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050103,
					"content": "Yardım lazım mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050104
					]
				}
			]
		},
		{
			"id": 7220503,
			"completionStepIds": [
				7220512
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
