				},
				{
					"id": 722050706,
					"content": "Şuna bakar mısın? Yine tek başına surat asıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050707,
						722050708
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050707,
					"content": "Ne oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050709
					]
				},
				{
					"id": 722050709,
					"content": "Hadi ama Kito, bir yabancıya sinirlenmene gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050710
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050710,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050711
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050711,
					"content": "Özür dilerim. Sana sinirlenmemeliydim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050712,
						722050713
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050712,
					"content": "Sorun değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050714
					]
				},
				{
					"id": 722050714,
					"content": "Altın adam bizi yine sandala bindirme konusunda sıkıştırıyor... Bizi sisin olmadığı parlak altın yere götürmek istediğini söyleyip duruyor! Oraya gitmek istemiyorum! Ben Una Nine ile kalmak istiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050715
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050715,
					"content": "O bizimle oynamıyor, söylediklerimizi de hiç dinlemiyor... Sürekli bize ayrılmamızı söylüyor! Çok korkunç biri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050716
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050716,
					"content": "Sanki biz ayrılmayı bilmiyormuşuz gibi! Ancak Una Nine endişelenir diye korkuyoruz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050713,
					"content": "En azından ne olduğunu anlatır mısın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050714
					]
				},
				{
					"id": 722050708,
					"content": "Yardım edebileceğim bir şey var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050709
					]
				},
				{
					"id": 722050704,
					"content": "Hiç mutlu görünmüyorsun.",
