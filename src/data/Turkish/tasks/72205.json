				"points": []
			},
			"dialogs": [
				{
					"id": 722050501,
					"content": "Görünüşe göre yollarımız yeniden kesişti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050502
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050502,
					"content": "Tekrar merhaba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050503,
						722050504
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050503,
					"content": "Sana da merhaba!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050505
					]
				},
				{
					"id": 722050505,
					"content": "Aynen öyle! Bu arada şu koca taşın ne için kullanıldığını biliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050506
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050506,
					"content": "Hehe! Kito her şeyi bilir, bunu bilmiyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050507,
						722050508
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050507,
					"content": "Bilmiyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050509
					]
				},
				{
					"id": 722050509,
					"content": "Mata Dede hayatını kaybeden ruhlara rehberlik etmesi için yapılmış bir mezar taşı olduğunu söylemişti. Kayıp olan, gidemeyen ruhları çeker ve burada uyanmalarını sağlarmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050510
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050510,
					"content": "Uyandıktan sonra adada dolaşıp dileklerini yerine getirebilecek birini ararlarmış. O insanı bulduktan sonra dileklerinin hepsi yerine getirilene kadar o insana yapışır ve ancak bütün dilekleri yerine getirildiğinde sandalcı tarafından götürülürlermiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050511
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050511,
					"content": "Ruhlardan bazıları iyiymiş ve bazıları da o kadar iyi olmayabilirmiş. Bu yüzden gece vakti o büyük taşların yanından geçenlerin isimlerini ve klanlarını yüksek sesle belirtmeleri gerekirmiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050512
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050512,
					"content": "Ne de olsa atalarını tanıyanlar kendilerine yalnız ruhlara göre daha fazla güvenir. Nereden geldiğini duyduklarında ruhlar sessizce taşa geri dönermiş ve artık seni rahatsız etmezlermiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050513
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050513,
					"content": "Hımm... Sorun şu ki, sen bir yabancısın değil mi? Belirtebileceğin bir klanın olduğunu düşünmüyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050514
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050514,
					"content": "Eyvah, bu doğru. Kötü bir ruhla karşılaşırsan ne yapacaksın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050515
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050515,
					"content": "Hehe, merak etme. Neden biliyor musun? Çünkü ben seni korurum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050516
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050516,
					"content": "Doğru! Evet, bu doğru! Ben de kötü ruhları kovmaya yardım ederim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050508,
					"content": "Ne için kullanılıyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050509
					]
				},
				{
					"id": 722050504,
					"content": "Hâlâ burada mısın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050505
					]
				}
			]
		},
