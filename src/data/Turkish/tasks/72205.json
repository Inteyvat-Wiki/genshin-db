			"dialogs": [
				{
					"id": 722050701,
					"content": "Hey, yolumuz yeniden kesişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050702
					],
					"speakerTitle": "Kito"
				},
				{
					"id": 722050702,
					"content": "Kito'nun bugün çok konuşası yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050703,
						722050704
					],
					"speakerTitle": "Kina"
				},
				{
					"id": 722050703,
					"content": "Bir sorun mu var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722050705
					]
				},
				{
					"id": 722050705,
					"content": "Şey... Yok bir şey. Bugün tek başıma oynayacağım. Merak etmeyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722050706
					],
