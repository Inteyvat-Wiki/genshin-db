							"800209",
							"2"
						],
						"stepId": 800209,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020401,
					"content": "Devasa bir heykel, görkemli bir Katedral... Mondstadt halkı bunları inşa etmek için çok fazla kaynak ve enerji harcamış belli ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020402
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020402,
					"content": "Rüzgar Hükümdarı bu hediyeyi aldığında bunun farkında mıydı? Karşılığında geri ne verdi ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020403
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020403,
					"content": "Oysa sadakat karşılıksızdır, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020404,
					"content": "Hım, bu konuda tanrıların vicdanı rahat olduğu sürece benim söyleyebileceğim hiçbir şey yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020405
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020405,
					"content": "Şşş! Katedrale girmek üzereyiz. Rüzgar Hükümdarı hakkında kötü bir şey söyleme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020406,
					"content": "Ayrıca Rüzgar Hükümdarı bir... Ah, neyse boş ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020407,
					"content": "Hahah, Katedrale gireceğim konusunda kesin bir şey söylemedim. Siz ikinizi rahibelerle kaynaşmanız için baş başa bırakıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020408
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020408,
					"content": "Ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020409,
						80020410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020409,
					"content": "Ama diğer her şeyi birlikte yaptık.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020411
					]
				},
				{
					"id": 80020411,
					"content": "Sen Mondstadt'ın Fahri Şövalyesisin. Bu meselelere burnunu sokman için sana kesin izin vereceklerdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020412
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020412,
					"content": "Yanında olmam sadece onları şüphelendirir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020413,
						80020414
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020413,
					"content": "Seni tanımadıkları için mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020415
					]
				},
				{
					"id": 80020415,
					"content": "Doğru ve küçük arkadaşımızın da dediği gibi... Her an kilise hakkında kötü bir şey söyleyebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020416
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020416,
					"content": "İnançsız biri kutsal topraklara adımını attığında sonuç hiç de hoş olmuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020417
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020417,
					"content": "Geçmişte hiç tanrıların lütfuna mazhar olmadım. Ne şimdi ne gelecekte buna ihtiyaç duymam için bir neden göremiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020418
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020418,
					"content": "Pekala, bu kadarı yeter. Biz çene çalarken Hiçlik Tarikatı eylemlerine devam ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020419
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020419,
					"content": "#Peki öyleyse {NICKNAME}, biz gidip birilerine sorarız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020420,
					"content": "Gitmeden önce sizi bir konuda uyarmalıyım. Katedraldeyken şu Kirli Heykelden ortalıkta pek bahsetmeyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020421
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020421,
					"content": "Favonius Kilisesi heykel meselesini görmezden gelmezdi ama Hiçlik Tarikatına karşı apar topar harekete geçerlerse onları gafil avlamak için elimizdeki tek şansı da kaçırabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020422
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020422,
					"content": "Ayrıca... Tarikatın işlerine karışmanın sonu genelde kimse için iyi olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020414,
					"content": "Rahibelerin senden hoşlanmadığını mı düşünüyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020415
					]
				},
				{
					"id": 80020410,
					"content": "Merak etmiyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020411
					]
				}
			]
		},
		{
			"id": 800205,
			"completionStepIds": [
				800210
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
