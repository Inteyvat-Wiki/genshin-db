			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Barbara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020101,
					"content": "Fahri Şövalye! Merhaba, görmeyeli nasılsın? Bugün bir şeye ihtiyacın var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020102
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020102,
					"content": "Ah... Ama baştan söyleyeyim, Göklerin Kutsal Lirini yeniden ödünç alman gerekiyorsa bunu kabul edemeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020103
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020103,
					"content": "(Görünüşe göre bunun bir illüzyon olduğunu hâlâ anlamamış...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020104,
					"content": "Bir şeyler hakkında bazı sorular sormak için buradayız. Barbara, ilk Biçerdöveri duydun mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020105,
					"content": "Hım... O da ne? \"Biçerdöver\"... Ne işe yarıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020106
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020106,
					"content": "Ah, bunun hakkında bir şey bilmiyorsun demek... Pekala, sıradaki soru: Kilisenin hiç Yedilerin Heykelini kaybettiği oldu mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020107,
					"content": "Ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020108
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020108,
					"content": "O eski hikayeyi öğrenmek için mi buradasınız? Şey... Bunu beklemiyordum... O kadar uzun zaman önceydi ki, neredeyse kimse bundan bahsetmiyor artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020109
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020109,
					"content": "Uzun zaman önce, gerçekten de bir gece ardında hiç iz bırakmadan ortadan kaybolan bir Yedilerin Heykeli vardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020110
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020110,
					"content": "Kilisenin neredeyse tüm üyeleri onu aramaya çıktı ama asla bulunamadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020111
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020111,
					"content": "Bu olay, tahmin edeceğiniz üzere kilisenin kayıtlarına \"Yedilerin Kayıp Heykeli\" olarak geçti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020112
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020112,
					"content": "Hım... Tabii ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020113,
					"content": "Pardon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020114
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020114,
					"content": "Ah, bir şey yok! Peki ya başka ipucun... Şey, yani... Paimon demek istiyor ki... Başka ilginç hikayelerin var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020115,
					"content": "(Kusura bakma Barbara, ama daha yeni gördüğümüz heykel hakkında sana bir şey söyleyemeyiz... Dain'in de dışarıda dediği gibi, senin iyiliğin için...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020116,
					"content": "Başka ilginç hikayeler mi? Emin değilim, kilisenin kayıtlarında başka ne gibi olağan dışı olaylar olduğunu bir düşüneyim... Ah, \"Tiranın Yıkıcı Gazabı\" olabilir mi? Hayır, bu başka bir zamandan, ilgisi yok muhtemelen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020117
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020117,
					"content": "\"Tiranın Yıkıcı Gazabı\" mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020118,
					"content": "Günümüzde Fırtına Dehşeti'nin İni olarak bilinen Eski Mondstadt'ı büyük bir tehlikenin sardığı zamanı anlatıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020119
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020119,
					"content": "Bundan uzun seneler önce, Eski Mondstadt'a ne zaman biri yaklaşsa gökten ateş toplarının yağdığı günler vardı..",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020120
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020120,
					"content": "Gökten ateş topları mı yağıyordu? Ne kadar korkunç...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020121,
					"content": "O zamanlar insanlar bunun Fırtına Tanrısı'nın gönderdiği bir lanet olduğuna inanıyorlardı, bu yüzden de ona \"Tiranın Yıkıcı Gazabı\" dediler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020122
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020122,
					"content": "Bu tuhaf olaylar yaklaşık bir yıl boyunca devam etti. Hiç kimse nedenini çözemedi, zamanla kendiliğinden sona erdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020123,
						80020124
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020123,
					"content": "Çok tuhaf.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020125
					]
				},
				{
					"id": 80020125,
					"content": "Doğru! \"Tiranın Yıkıcı Gazabı\" teorisi daha sonra kilisenin gözünde geçerliliğini kaybetti. Mantıklı düşünürsek Fırtına Tanrısı göklerden ateş topları atmayacaktır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020126
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020126,
					"content": "Belki de felakete neden olan başka bir şeydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020127
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020127,
					"content": "Her neyse, bu olay Yedilerin Kayıp Heykeli ile ilgili olmayabilir belki ama aklıma başka garip olaylar gelmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020128
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020128,
					"content": "Önemli değil. Yine de teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020129,
					"content": "İşte yine o anlamsız kelime, \"teşekkür ederim\". Duymaya asla alışamayacağım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020130
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 80020130,
					"content": "Ah, Rosaria, buradasın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020131
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020131,
					"content": "Favonius Şövalyelerini arıyorsanız yine o canavarlarla meşguller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020132
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 80020132,
					"content": "\"O canavarlar\" mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020133
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020133,
					"content": "Geçen sefer Fırtına Dehşeti olayı sırasında Mondstadt'a saldırmaya çalışan canavarlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020134
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 80020134,
					"content": "Hiçlik Tarikatı değil miydi o? Yine mi iş başındalar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020135,
					"content": "Aynen öyle. <color=#00E1FFFF>Kurtlar Diyarı'nda</color> toplanıyorlar ve kurtlar arasında büyük huzursuzluk çıkarıyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020136
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 80020136,
					"content": "Hiçlik Tarikatı acaba Poyraz Kurdu'nun ruhunu hedef alıyor olabilir mi? Hangi amaçla olduğunu kesin olarak söyleyemem ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020137
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 80020137,
					"content": "Kumandan Jean şimdiden <color=#00E1FFFF>Kurtlar Diyarı'na</color> doğru yola çıktı. Benim de harekete geçmem gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020138
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 80020138,
					"content": "Öyleyse ben de gideceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020139
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020139,
					"content": "Kumandan Jean kilisede kalmanı ve rahiplerle işlerine devam etmeni söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020140
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 80020140,
					"content": "A-Ama... Sen de kilisenin bir üyesisin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020141
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020141,
					"content": "Merak etme, ben de yardıma gideceğim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020142
					]
				},
				{
					"id": 80020142,
					"content": "Tamam, biz de gidip Kumandan Jean'e yardım edeceğiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020143,
					"content": "Ah... Pekala, Fahri Şövalye de orada olacaksa madem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020144
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020144,
					"content": "Ama lütfen, hepiniz dikkatli olun. Rüzgar Hükümdarı hepinizi korusun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Barbara"
				},
				{
					"id": 80020124,
					"content": "Tiranla çok da ilgili değil gibi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020125
					]
				}
			]
		},
		{
			"id": 800202,
			"completionStepIds": [
				800205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800205",
							"2"
						],
						"stepId": 800205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jean"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020201,
					"content": "Oh... Cidden etrafta çok fazla düşman var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020202,
					"content": "Hedefe yaklaştıkça düşman sayısı da artıyor. Tam da Hiçlik Tarikatına yakışır cinsten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020203
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020203,
					"content": "Bir an önce Poyraz Kurdu'nu bulmalıyız.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020204
					]
				},
				{
					"id": 80020204,
					"content": "Evet! Hadi gidelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020205,
					"content": "Ben... Daha devam etmeyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020206
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020206,
					"content": "Ha? Neden? Tüylü hayvanlardan korktuğun için falan mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020207,
						80020208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020207,
					"content": "Sebebi bu değil muhtemelen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020209
					]
				},
				{
					"id": 80020209,
					"content": "Kurtlarla ilgisi yok. Poyraz eski bir tanrı olmasına rağmen kendi rızasıyla Yedilerin hizmetkarı oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020210
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020210,
					"content": "Yaptıkları benim görüşlerime uygun değil. Onunla herhangi bir etkileşime girmeyi istemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020211
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020211,
					"content": "Ayrıca, insanların sevdiği kişi sensin. Ben... O kadar sevilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020212,
						80020214
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020212,
					"content": "Yedilerden cidden nefret ediyorsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020213
					]
				},
				{
					"id": 80020213,
					"content": "Zaten tanrıları özel kılan bir şey de yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020216
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020216,
					"content": "Bu benim şahsi fikrim, ama sana bir tavsiye; Tanrıların etrafındayken her zaman gözünü dört aç.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020217
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020217,
					"content": "Onlara fazla güvenmemelisin. Tabii aynı zamanda tam tersini yapmaya da kalkma. Onları alaşağı etmeye ya da öldürmeye çalışma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020218
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020218,
					"content": "Söz konusu tanrı can düşmanın olsa bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020219
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020219,
					"content": "Onlara güvenme ve onlara zarar verme... Bu biraz garip bir tavsiye. Dain Yedilerden nefret mi ediyor yoksa onları koruyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020220,
					"content": "Neden düşüncelerin bu kadar çelişkili?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020221
					]
				},
				{
					"id": 80020221,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020222
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020222,
					"content": "Atalarımın hatalarını tekrar etmemek için.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020223
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020223,
					"content": "Son bir gerçeği söyleyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020224
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020224,
					"content": "Ha? Ne gerçeği?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020225,
					"content": "Khaenri'ah ulusunun tanrılar tarafından yok edilmesi... Hiçlik Tarikatının Yedilerin etkisi altındaki ulusları yok etmeye çalışmasının nedeni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020226
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020226,
					"content": "Ama bu kadar sohbet yeter. İşe geri dönmeliyiz. Ben civarda kalan Hiçlik Tarikatı üyelerini halledeceğim. Poyraz ziyaretinizi kısa tutmaya çalışın. Daha sonra Kurtlar Diyarı girişinde buluşalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020227
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020227,
					"content": "Ah... İşte gidiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020228,
					"content": "Ne garip bir adam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020229,
					"content": "Onun neden böyle dediğini anlayabiliyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020230
					]
				},
				{
					"id": 80020230,
					"content": "Evet, doğru. Sen de tanımadığın tanrılara karşı hep tetiktesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020231,
					"content": "Liyue'deki Zuhur Ayininde, senin kararın, Dain'in vereceği karara çok benziyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020232,
					"content": "Güven eksikliği olduğunda en iyisi o durumdan tamamen kaçınmaktır...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020233
					]
				},
				{
					"id": 80020233,
					"content": "*iç çeker* Basit bir durum değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020234,
					"content": "Fahri Şövalye! Paimon! Siz ikiniz burada ne yapıyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020235
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020235,
					"content": "Ah, Kumandan Jean! Seni bulduğumuza çok sevindik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020236,
					"content": "Rosaria buraya gelip Hiçlik Tarikatıyla savaşacağını söyledi. Biz de yardım etmek için geldik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020237,
					"content": "Öyleyse yardımınız için çok teşekkürler. Hiçlik Tarikatının aniden saldırıya geçmesi çok tuhaf, Kurtlar Diyarı'nı kuşattılar. Savunmaya destek için birkaç şövalye göndermeye hazırlanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020238
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020238,
					"content": "Kurtlar Diyarı'nın her tarafını altüst ettim... Ama seni görmedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020239
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020239,
					"content": "Rosaria bana Hiçlik Tarikatının Poyraz'ın peşinde olduğunu söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020240
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020240,
					"content": "Hiçlik Tarikatı ve Poyraz... Bu ikisi arasındaki bağlantı ne ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020241
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020241,
					"content": "Sorun çıkarmayı seviyorlar. Bir sebep gerekiyor mu onlara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020242,
					"content": "Hiçlik Tarikatı zaten Dvalin'in peşindeydi. Rüzgar Hükümdarı'nın diğer arkadaşlarından birinin de peşine düşmeleri çok da şaşırtıcı değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020243,
					"content": "Hım... Bu doğru...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020244
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020244,
					"content": "Yine de, mevcut tehdidin nedeni belli olsun ya da olmasın bu durumla ilgileneceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020245
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020245,
					"content": "Fahri Şövalye, lütfen gidip Poyraz Kurdu'nun tehlikede olup olmadığını kontrol et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020246
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020246,
					"content": "Bu tanrının ruhu... Genellikle insanları görmez. Ama duyduğuma göre onunla daha önce tanışmışsın. Belki de bu sefer onunla karşılaşacak kişi sen olursan daha iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020247
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020247,
					"content": "Tamam, hallederim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020248
					]
				},
				{
					"id": 80020248,
					"content": "Tamam, dikkatli ol. Yardımın için teşekkürler Favonius'un Fahri Şövalyesi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 80020214,
					"content": "Sosyal etkileşimlerden pek hoşlanmıyorsun sanırım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020215
					]
				},
				{
					"id": 80020215,
					"content": "İnsanlarla iletişim kurmakla sorunum yok. Ama tanrılarla etkileşim... Orası bambaşka bir hikaye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020216
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020208,
					"content": "Tüylü şeyler sevimli değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020209
					]
				}
			]
		},
		{
			"id": 800203,
