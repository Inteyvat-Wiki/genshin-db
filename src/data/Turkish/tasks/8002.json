			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Poyraz"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020701,
					"content": "Hım... Tören bölündü. Ne kadar da şanslısın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020702
					],
					"speakerTitle": "Hiçliğin Habercisi"
				},
				{
					"id": 80020702,
					"content": "Nasıl oluyor da yaşlı bir ruhun bu kadar güçlü bir iradesi olabiliyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020703
					],
					"speakerTitle": "Hiçliğin Habercisi"
				},
				{
					"id": 80020703,
					"content": "Fark etmez. Bu sadece küçük bir öngörülemez değişken. Büyük planımız bundan etkilenmeyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020704
					],
					"speakerTitle": "Hiçliğin Habercisi"
				},
				{
					"id": 80020704,
					"content": "Yine kayboldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020705,
						80020706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020705,
					"content": "En azından onu bu sefer durdurabildik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020707
					]
				},
				{
					"id": 80020707,
					"content": "Teşekkürler, tam vaktinde geldin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020708
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020708,
					"content": "İnsan Lupical... Beni bu halimle görmek zorunda kaldığınız için utanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020709
					],
					"speakerTitle": "Poyraz"
				},
				{
					"id": 80020709,
					"content": "Ama yine de, Hiçliğin Habercisi gücümü hafife aldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020710
					],
					"speakerTitle": "Poyraz"
				},
				{
					"id": 80020710,
					"content": "Poyraz Kurdu bir sınavı asla reddetmez. Ama korkutucu yabancı... Sınav kurallarına saygı duymuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020711
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020711,
					"content": "Ben de... Tuzağı görmedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020712
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020712,
					"content": "Bir dakika... Yani diyorsun ki Hiçlik Tarikatı, Poyraz Kurdu'nun zihnini yozlaştırmak için her şeyi hazırladı ve bir sınavla ona meydan okuma bahanesiyle tuzağa mı düşürdü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020713,
						80020714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020713,
					"content": "Bu senin hatan değil Razor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020715
					]
				},
				{
					"id": 80020715,
					"content": "#Sağ ol {NICKNAME}. Gelecekte pençelerim... Daha keskin olmak zorunda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020716
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020716,
					"content": "Siz... Tehlikenin kokusunu aldınız ve buraya mı geldiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020717
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020717,
					"content": "Hayır, tehlikenin haberini aldık. Paimon'un burnu tehlikenin nasıl koktuğunu bile bilmez ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020718,
					"content": "Yardıma gelmenin yanı sıra, aslında sana soracağımız bir şey de var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020719,
					"content": "Ah... Bizi mazur görün Bay Kurt Tanrısı, ilk Biçerdövere dair herhangi bir şey biliyor musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020720,
					"content": "İnsanların aletleri ile ilgilenmem. Şu Biçerdöver dediğiniz şeyin ne olduğunu bilmiyorum ama asla unutmayacağım insan yapımı bir makina vardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020721
					],
					"speakerTitle": "Poyraz"
				},
				{
					"id": 80020721,
					"content": "Yanlışlıkla huzuruma çıkmıştı ve onu meydan okuyan biri sanmıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020722
					],
					"speakerTitle": "Poyraz"
				},
				{
					"id": 80020722,
					"content": "Düşünemiyordu, tek yaptığı savaşmaktı. Tepeden tırnağa ölüm makinası olarak tasarlanmıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020723
					],
					"speakerTitle": "Poyraz"
				},
				{
					"id": 80020723,
					"content": "Nihayetinde saldırılarımdan biriyle ona feci şekilde hasar verdim. Ama yıkılmadan dövüş alanını terk etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020724
					],
					"speakerTitle": "Poyraz"
				},
				{
					"id": 80020724,
					"content": "Hım... Anlattıklarına bakılırsa o, ilk Biçerdöver olabilir, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020725,
						80020727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020725,
					"content": "Dönebiliyor muydu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020726
					]
				},
				{
					"id": 80020726,
					"content": "Evet. Dönebiliyor, yükseğe zıplayabiliyor ve hatta ateş topları atabiliyordu. Bir tanrıya denk olmasa da Önsezi kullanan çoğu kişiden daha güçlüydü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020730
					],
					"speakerTitle": "Poyraz"
				},
				{
					"id": 80020730,
					"content": "Ateş topları mı? Hey, bunu yakın zamanda başka bir yerde de duymamış mıydık?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020731
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020731,
					"content": "Her neyse, bu da açıkça ilk Biçerdöverin Mondstadt'a geldiğini kanıtlıyor, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020732
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020732,
					"content": "Anlatılana göre ilki, daha sonra gelen seri üretilmiş Harabe Muhafızlarından çok daha güçlüymüş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020733
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020733,
					"content": "Ama bu hikayede, Kuzey'in Kurdu ile çarpışırken savaş alanında hasar almış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020734,
					"content": "Bilmiyorum... Yardımcı olduk mu peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020735
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020735,
					"content": "Evet, çok yardımcı oldunuz! Teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020736
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020736,
					"content": "Çok önemli bir şeyi araştırmaya devam etmemiz gerek. Hiçliğin Habercisi gitmiş olabilir ama Hiçlik kuvvetleri hâlâ saldırıyor. Dikkatli olmalısınız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020737
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020737,
					"content": "Evet. Daha çok tehlike kokusu alıyorum. Daha büyük tehlike.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020738
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020738,
					"content": "Siz ikiniz dikkatli olun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020727,
					"content": "Füze atabiliyor muydu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020728
					]
				},
				{
					"id": 80020728,
					"content": "\"Füze\" mi? O tuhaf kelimeyi bilmiyorum... Dediğim gibi, insan icadı aletlerle ilgilenmem ben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020729
					],
					"speakerTitle": "Poyraz"
				},
				{
					"id": 80020729,
					"content": "Dönebiliyor, yükseğe zıplayabiliyor ve hatta ateş topları atabiliyordu. Bir tanrıya denk olmasa da Önsezi kullanan çoğu kişiden daha güçlüydü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020730
					],
					"speakerTitle": "Poyraz"
				},
				{
					"id": 80020714,
					"content": "Hadi, neşelen biraz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020715
					]
				},
				{
					"id": 80020706,
					"content": "Çabucak kaçtı gerçekten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020707
					]
				}
			]
		}
	]
}