			"dialogs": [
				{
					"id": 80020301,
					"content": "Sen... Burada istenmiyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020302
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020302,
					"content": "Ahahaha... Demek kurdun sefil ruhu artık vahşi enikler yetiştirmeyi seviyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020303
					],
					"speakerTitle": "Hiçliğin Habercisi"
				},
				{
					"id": 80020303,
					"content": "Muhafız olduğunu iddia ediyorsun ama bir zamanlar keskin olan pençelerin, görkemli günlerinden bu yana besbelli körelmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020304
					],
					"speakerTitle": "Hiçliğin Habercisi"
				},
				{
					"id": 80020304,
					"content": "Bize hizmet edersen, geçmişte sahip olduğun kutsal güçlerini sana geri verebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020305
					],
					"speakerTitle": "Hiçliğin Habercisi"
				},
				{
					"id": 80020305,
					"content": "Yalanlar... Yalanlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020306
					],
					"speakerTitle": "Poyraz"
				},
				{
					"id": 80020306,
					"content": "Bu tören de neyin nesi? Çok acı çekiyormuş gibi görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020307,
					"content": "Ah hayır... Bu, Dvalin'in zihnini yozlaştırmak için kullandıkları şeyin aynısı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020308,
					"content": "Kurtlar asla boyun eğmez. Ama... Bu böyle devam edemez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020309,
						80020310
					],
					"speakerTitle": "Razor"
				},
				{
					"id": 80020309,
					"content": "Bunu durduracağım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020311
					]
				},
				{
					"id": 80020311,
					"content": "Bize ne kadar direnirsen diren tüm çabaların boşa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hiçliğin Habercisi"
				},
				{
					"id": 80020310,
					"content": "Hiçliğin Habercisi ile tekrar karşılaşma vakti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80020311
					]
				}
			]
		},
		{
			"id": 800204,
			"completionStepIds": [
				800209
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
