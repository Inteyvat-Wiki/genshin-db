			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80020501,
					"content": "Anladım... Hiçlik Tarikatı yeni bir operasyon mu başlattı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020502
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020502,
					"content": "Bunun Kirli Heykel ile bir ilgisi olabilir. Biz de gitmeliyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020503
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020503,
					"content": "Hiçlik Tarikatı, Kurtlar Diyarı'ndan ne istiyor ki? Dvalin'e yaptıklarının aynısını mı yapmak istiyorlar? Aaah... Yine mi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80020504,
					"content": "Hayır, pek sanmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020505
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020505,
					"content": "Sadece etkisizleştirilen Osial'in aksine Andrius uzun zaman önce öldü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020506
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020506,
					"content": "Bugün Kurtlar Diyarı'nı koruyan yalnızca onun ruhu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80020507
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80020507,
					"content": "Hiçliğin Habercisi, Rüzgar Hükümdarı'nın eski yol arkadaşlarının birinden bilgi almak için Andrius'un ruhunu hedef alıyor olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				}
			]
		},
		{
			"id": 800206,
			"completionStepIds": [],
