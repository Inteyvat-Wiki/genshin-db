					"Ji Tong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414020101,
					"content": "Ah, merhaba. Tam da konuşmak istediğim insan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020102,
						414020103
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020102,
					"content": "Ne hakkında konuşacağız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020104
					]
				},
				{
					"id": 414020104,
					"content": "Yok hayır. O sorunun ne olduğunu buldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020105
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020105,
					"content": "Geçen gün Kamerayı bana satan tüccarı sonunda buldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020106
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020106,
					"content": "Bana sattığı Kamerada sorun olduğunu söyledim, öyle bir şey olmadığını söyleyip durdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020107
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020107,
					"content": "Neyse ki benim için çektiğin fotoğraflar yanımdaydı. Onlar olmasaydı hiçbir şekilde ikna edemezdim onu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020108
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020108,
					"content": "Çektiğin fotoğraflara baktıktan sonra, bana sattığı Kameraya göz atmayı kabul etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020109
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020109,
					"content": "Yanında bir iksir şişesiyle dün beni görmeye geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020110
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020110,
					"content": "Bu Kameranın diğer modellerden farklı çalıştığını söyledi. Fotoğrafların normal çıkmasını istiyorsan, bu iksirden biraz eklemen gerekiyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020111
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020111,
					"content": "Hiç eklemezsen, fotoğraflar senin çektiklerin gibi çıkarmış. Net fotoğraflar değil de renkli sayfalar gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020112,
						414020113
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020112,
					"content": "Neyse ki Kameran bozuk değilmiş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020114
					]
				},
				{
					"id": 414020114,
					"content": "Şey... Açıkçası artık Kamera çok da ilgimi çekmiyor, asıl ilgimi çeken şey bu iksir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020115
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020115,
					"content": "Bir düşünsene, çoğu insan sadece Kamerayı alıyor, değil mi? Bir kere alan sonsuza dek kullanabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020116
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020116,
					"content": "Ancak bu iksir bir sarf malzemesi. Yani kullanıp bitirdiğinde, kullanmaya devam etmek için daha çok satın alman gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020117
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020117,
					"content": "Ayrıca tüccarın dediğine göre, farklı iksirler fotoğraflarda farklı efektler oluşturuyormuş. Yeni iksir türleri üzerinde çalışıyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020118
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020118,
					"content": "Belki... Bu iksirlerde büyük bir iş fırsatı yatıyordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020119
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020119,
					"content": "Ah, özür dilerim. Kafanı şişiriyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020120
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020120,
					"content": "Yardımların için teşekkür ederim. Kamerayı bana ver de senin için biraz iksir ekleyeyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020113,
					"content": "Yani... Problem çözüldü mü?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020114
					]
				},
				{
					"id": 414020103,
					"content": "Fotoğraflardaki doygunlukla mı ilgili?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020104
					]
				}
			]
		},
		{
			"id": 4140202,
