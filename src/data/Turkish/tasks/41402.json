			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Ji Tong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414020201,
					"content": "Gezgin, dur bir saniye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020202
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020202,
					"content": "Ne oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020203
					]
				},
				{
					"id": 414020203,
					"content": "Böyle sormam biraz ani oldu ama Kameralara ilgin var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020204,
						414020205
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020204,
					"content": "Evet, biraz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020206
					]
				},
				{
					"id": 414020206,
					"content": "Bu Kamera bildiğin Kameralar gibi değil ama. Fontaine'deki son teknolojiyle donatılmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020207
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020207,
					"content": "Bu modelle çekilen fotoğrafların hepsi, standart Kameralarda olmayan eşsiz efektlerle çıkıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020208,
						414020209
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020208,
					"content": "Nasıl çalışıyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020210
					]
				},
				{
					"id": 414020210,
					"content": "Hey! Bende yalan yok. Bana inanmıyorsan, Maceracılar Loncasındakilere sorabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020211
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020211,
					"content": "Ben de başta şüpheyle yaklaştım. Çok uzun süre kurcaladım ama bir türlü çalıştıramadım. Sonunda Loncadan bir maceracı yardım etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020212
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020212,
					"content": "Şimdi. Bu Kamerayı bu kadar farklı yapan ne diye merak ediyorsundur. İç tasarımıyla alakalı bir şey.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020213
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020213,
					"content": "Özel bir iksir damlatıyorsun, baskı sırasında fotoğraflara eşsiz efektler ekliyor. Bu sayede herkesin bildiği Kameraların çıkarttıklarından daha kaliteli oluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020214
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020214,
					"content": "Ne düşünüyorsun? İlgileniyorsan, bunu sana bir süreliğine ödünç verebilirim. İksir seçeneklerin kısıtlı olacak ama nasıl çalıştığını anlamana yeter de artar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020215
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020215,
					"content": "Bir ara Fontaine'e gidip çeşit çeşit iksir almayı planlıyorum. İlgini çekerse siparişini alabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020216,
						414020217
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020216,
					"content": "Tamam o zaman. Teşekkürler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020219
					]
				},
				{
					"id": 414020219,
					"content": "Lütfen bu Kamerayı hürmetimin göstergesi olarak al. Hoşuna giderse gelecekte seninle iş yapmaktan memnun olurum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020217,
					"content": "Fiyatları ne kadar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020218
					]
				},
				{
					"id": 414020218,
					"content": "İşin o tarafını düşünmene gerek yok. Perakende satın aldığında bile çok ucuzlar, toptan satın almayı düşünürsen o zaman indirim ayarlarız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020219
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020209,
					"content": "Gerçekten mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020210
					]
				},
				{
					"id": 414020205,
					"content": "Pek ilgilenmiyorum, üzgünüm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020206
					]
				}
			]
		},
		{
			"id": 4140203,
			"completionStepIds": [
				4140203
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
