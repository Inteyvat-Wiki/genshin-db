				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ji Tong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414020301,
					"content": "Tamamdır, Kamera senin olsun. Ona iyi bak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020302,
						414020303
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020302,
					"content": "Öylece bana mı vereceksin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020304
					]
				},
				{
					"id": 414020304,
					"content": "İçinde uzun süre kullanmana yetecek kadar iksir var. Biterse de beni nerede bulacağını biliyorsun, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020305
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020305,
					"content": "Hazır konusu açılmışken, Kamera için yeni bir tür iksir ithal etmek adına bağlantımla irtibata geçmeyi düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020306
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020306,
					"content": "İlgini çeken bir şey olursa, beni nerede bulacağını biliyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414020307
					],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020307,
					"content": "Sadece Kamera aldığımı düşünüyordum, görünüşe göre bir girişime yatırım yapmışım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ji Tong"
				},
				{
					"id": 414020303,
					"content": "İksir biterse ne olacak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414020304
					]
				}
			]
		}
	]
}