			"dialogs": [
				{
					"id": 761380201,
					"content": "Leydi Nefer? Ve... Bay Zompaynco. Hangi rüzgar attı sizi buralara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380202
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380202,
					"content": "Natlanlı misafirimiz Donuk Ayın Çocuklarını ziyaret etmek istediğinden bahsetti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380203
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380203,
					"content": "Ama nezaketen kendisini onlarla birisinin tanıştırmasını istiyor. Yani sahne senin Bay Zompaynco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380204
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380204,
					"content": "M-merhaba Bayan Lyylikki! Sizinle tanışmak bir şeref. Şey... Natlan'dan bu fosili getirdim size...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380205
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380205,
					"content": "Teşekkürler Bay Zompaynco ama... Biz zaten tanışmıştık, öyle değil mi? Bu kadar resmi davranmaya hiç gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380206
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380206,
					"content": "Ne? O zaman... Beni nasıl fark ettin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380207
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380207,
					"content": "Ben yemek dağıtırken hep etraftaydın, değil mi? Sıranın çevresinde dolanıyor, etrafında dönüp duruyor ama hiç sıraya girmiyordun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380208
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380208,
					"content": "Ben de yemek almak istediğini ama fazla utangaç olduğunu düşünerek senin için bir porsiyon ayırmaya başladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380209
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380209,
					"content": "Ama hiç gelip ayırdığım yemeği almadın. Hatta bugün gelmesen birinden yardıma ihtiyacın olup olmadığını kontrol etmesini rica edecektim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380210
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380210,
					"content": "Ah... Özür dilerim. Nasıl selam vereceğimden emin olamadığımdan tereddüt ediyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380211
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380211,
					"content": "Bayan Lyylikki... Donuk Ayın Çocuklarını ziyaret edebilir miyim o zaman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380212
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380212,
					"content": "Tabii ki. Daha önce de dışarıdan misafirlerimiz oldu. Ancak nedenini sorabilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380213
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380213,
					"content": "Fotoğraf çekip not almak, kayıtları incelemek ve mümkünse birilerine yerel efsaneler hakkında sorular sormak istiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380214
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380214,
					"content": "Ben Natlan Sürüngen Kalıntıları Derneğinin bir üyesiyim. Araştırmam için malzeme bulabilirsem harika olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380215
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380215,
					"content": "Anladım. Arşiv'de biraz vakit geçirmek istiyorsun demek... Dur bir düşüneyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380216
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761380216,
					"content": "Siz ikiniz tanıştığınıza göre benim görevim tamamlanmış demektir. Ben yavaştan gideyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380217
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380217,
					"content": "Teşekkürler Leydi Nefer! Ama... Seni o kadar uğraştırdım, karşılığını vereyim. Bunca yolu boşu boşuna gelmen yakışık almaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380218
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380218,
					"content": "Nasıl istersen Bay Zompaynco.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380219
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380219,
					"content": "O zaman ben yola düşeyim. Size keyifli sohbetler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nefer"
				}
			]
		}
	]
}