			"dialogs": [
				{
					"id": 761380101,
					"content": "Leydi Nefer! Ne büyük tesadüf, tam zamanında geldin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380102
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380102,
					"content": "Kararını verdin demek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380103
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380103,
					"content": "Ne? Kararımı mı? N-ne demek istiyorsun? Yani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380104
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380104,
					"content": "Hep Donuk Ayın Çocuklarını ziyaret etmeyi istediğini biliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380105,
					"content": "Önce Lyylikki ile tanışıp o arkadaşlığı kullanarak ilerlemeyi umuyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380106
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380106,
					"content": "Bunu... Biliyor muydun? Ama bu arzumu içimde sakladım, kimselere söylemedim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380107
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380107,
					"content": "Bay Zompaynco, bir sır sakladığında sır sakladığın gerçeğini de saklamayı öğrenmen gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380108
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380108,
					"content": "Yoksa sırrını kalbinin en saklı köşelerine gizlesen bile rüzgar ona ulaşmanın bir yolunu bulur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380109
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380109,
					"content": "*iç çeker* Memleketimdeyken bile duygularımı gizleme konusunda iyi değildim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380110
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380110,
					"content": "Artık sırrımı bildiğine göre bana yardımcı olup beni Bayan Lyylikki ile tanıştırır mısın? Beni tanımıyor, onu rahatsız etmek istemem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380111
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380111,
					"content": "Merak etme. Donuk Ayın Çocukları çok misafirperverdir. Kapılarındaki bir yabancı da olsa, hatta tamamen insan olmasa da onu çok nazik ve sıcak bir şekilde karşılarlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380112
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380112,
					"content": "Ah, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380113
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380113,
					"content": "Yine de öylece içeri dalıvermek nezakete aykırı olur. Leydi Nefer, beni tanıştırabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380114
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761380114,
					"content": "Pekala. Bu saatte yemekleri dağıtmayı bitirmiş olmaları gerek, sohbet için ideal zaman. Hadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380115
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380115,
					"content": "Bu arada, bu sefer ödeme istemiyorum. Zaten oradan geçecektim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761380116
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761380116,
					"content": "Ah, çok teşekkürler! Hemen eşyalarımı alayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zompaynco"
				}
			]
		},
