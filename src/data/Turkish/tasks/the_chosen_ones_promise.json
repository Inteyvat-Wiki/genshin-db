			"dialogs": [
				{
					"id": 751380101,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}, iyi misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380102,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380103
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751380103,
					"content": "#Oh be, Paimon'un içine su serpildi! Şey... Açıklaması biraz zor ama {NICKNAME} rüyasında senin tuhaf biriyle birlikte takıldığını görmüş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380104,
					"content": "Tonatiuh'dayken tuhaf biriyle karşılaştın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380105,
					"content": "Rarr... Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380106
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751380106,
					"content": "Nasıl yani? Karşılaştın mı karşılaşmadın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380107,
					"content": "Haaarrr... Rarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751380108,
					"content": "Üff, Paimon ne demek istediğini anlamıyor ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380109,
					"content": "Aman, neyse. İyisin ya, önemli olan o.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751380110
					]
				},
				{
					"id": 751380110,
					"content": "Evet, orası doğru. Bona ne olacak peki? Nereye kayboldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380111,
					"content": "Raa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380112
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751380112,
					"content": "Siz ayrı mı düştünüz? Yoksa Bona gerçekten...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380113,
					"content": "Belki de Bona başından beri hikayeden çıkmış bir karakterdi sadece.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751380114
					]
				},
				{
					"id": 751380114,
					"content": "Hımm... Haklısın. Sıradan insanlar yüzlerce yıl yaşayamaz sonuçta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380115,
					"content": "Onun yarım kalan macerasını tamamlamış olduk en azından.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751380116
					]
				},
				{
					"id": 751380116,
					"content": "Evet. Bu macerayı başkalarına anlatacağımıza dair söz de verdik hem. Tonatiuh'yu bulduğumuz duyulunca Bona da meşhur bir maceracı olarak anılacak, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380117,
					"content": "O zaman vakit geldi demektir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751380118
					]
				},
				{
					"id": 751380118,
					"content": "Vakit yanardağa gidip \"o kişiyi\" bulma vakti. Sonra da...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751380119
					]
				},
				{
					"id": 751380119,
					"content": "Evet. Bu meselenin derinine inelim bir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380120,
					"content": "Ya bu arada... Acaba o adam Alev Çalan Bilge olabilir mi? Yolculuk sırasında bulduğumuz tüm mesajlar onun tarafından bırakılmıştı. Paimon gitgide daha çok meraklanmaya başladı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380121,
					"content": "Farklı kılıklara girdiğinden bahsetmişti aslında. Yani onunla karşılaşmış olsak bile kim olduğunu anlamamış olabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380122,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380123
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751380123,
					"content": "#Sen de meraklandın, değil mi {REALNAME[ID(2)|SHOWHOST(true)]}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380124,
					"content": "#Eh, bütün nişanları aldığımıza göre {REALNAME[ID(2)|SHOWHOST(true)]} ile yanardağa gidip bu meseleyi çözelim o zaman. Çözelim de üzerindeki laneti kaldıralım artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751380125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751380125,
					"content": "Kusura bakma Bona! Şimdilik Altın Ahdi yanımıza alıyoruz. Meseleyi çözünce sana da her şeyi anlatacağız, merak etme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
