					{
						"sceneId": 51203,
						"position": [
							2194.736,
							230.089,
							-781.087
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705480101,
					"content": "Eyvah, anlaşılan Hertha görevinin başına geri dönmüş, Glenfidia da bir yerlere gitmiş... İçecek standının kontrolü sana mı kaldı tatlım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480102,
						705480103
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480102,
					"content": "Aynen öyle, yetki bendenizde!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480104
					]
				},
				{
					"id": 705480104,
					"content": "Harika. Artık Lojistik Bölüğünün şu \"özel\" içeceklerinden biriyle karşılaşma korkusu yaşamadan sipariş verebileceğim. Hani şu insanı bütün gece uyanık tutan ve vakit geçirmek için çalışmaktan başka çare bırakmayan türden içecekleri diyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480105,
						705480106
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480105,
					"content": "Bütün gece çalışmak mı... Bunun artık mazide kalması gerekmiyor muydu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480107
					]
				},
				{
					"id": 705480107,
					"content": "Doğru! Artık rahat takılan bir kütüphaneciyim sadece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480108
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480108,
					"content": "Keşke kitaplarını iade etmeyi geciktiren bu kadar çok insan olmasaydı da kitapları geri almak için kapı kapı dolaşmak zorunda kalmasaydım... Seninle sohbet etmek ve tabii ki o enfes içeceklerini denemek için daha önce uğrardım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480109,
						705480110
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480109,
					"content": "Söyle bakalım, ne içiyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480111
					]
				},
				{
					"id": 705480111,
					"content": "Bir düşüneyim... Hımm, aslında favori bir içeceğim yok. Şöyle canlandırıcı, keyfimi yerine getirecek bir şeyler hazırlasan yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480112
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480112,
					"content": "Bir de daha sonra uykuya dalmama yardımcı olursa çok sevinirim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480113
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480113,
					"content": "(İçecek standında klasik tariflerden oluşan bir koleksiyon var... Önce onlardan birini seçerek başlayalım.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480114
					]
				},
				{
					"id": 705480114,
					"content": "(Lisa canlanmak istediğine göre \"Kar Buseli Şafak\" iyi bir seçim gibi görünüyor...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705480110,
					"content": "Özellikle aradığın bir tat var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480111
					]
				},
				{
					"id": 705480106,
					"content": "Bugünlerde işlerin çok yoğun değildir zannediyordum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480107
					]
				},
				{
					"id": 705480103,
					"content": "Fahri Barmen hizmetinde!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480104
					]
				}
			]
		},
		{
			"id": 7054802,
