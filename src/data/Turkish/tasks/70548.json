			},
			"dialogs": [
				{
					"id": 705480301,
					"content": "İşte hazır! Sadece sana özel, yeni bir tarif...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480302
					]
				},
				{
					"id": 705480302,
					"content": "Çabucak uykuya dalmana ve huzurlu rüyalar görmene yardımcı olacağını düşünüyorum. Adını da \"Uyuyan Gül\" koydum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480303
					]
				},
				{
					"id": 705480303,
					"content": "Renklerden bardak seçimine kadar her şey özenle hazırlanmış. Tarifi bambaşka bir içeceğe dönüştürmüşsün...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480304
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480304,
					"content": "Sadece görüntüsüne bakarsak tam benim tarzım! Şimdi bir de tadına bakalım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480305
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480305,
					"content": "Mmm... On numara beş yıldız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480306
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480306,
					"content": "Tıpkı... Enfes bir tatlı yedikten sonra Berrak Göl kıyısında yürüyüşe çıkmak gibi. Hafif bir esinti tenini okşuyor, rahatlamış ve huzurlu hissediyorsun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480307
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480307,
					"content": "Artık enerjim çekilmiş gibi hissetmiyorum ama aşırı uyarılmış da değilim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480308
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480308,
					"content": "*esner* Şimdiden uykum gelmeye başladı... Uyku öncesi içmek için daha iyi bir şey düşünemiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480309
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480309,
					"content": "Hatta o kadar iyi ki oturup bu \"Uyuyan Gül\"ün faydalarını öven bir makale yazasım var. Hem bu vesileyle seni \"İçecek Tariflerinin Yeni Üstadı\" ilan ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480310,
						705480311
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480310,
					"content": "O biraz abartı kaçabilir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480312
					]
				},
				{
					"id": 705480312,
					"content": "Hazır göl kenarı yürüyüşlerinden konu açılmışken, bir dahaki sefere havanın açık olduğu, güneşin ise yakmadan tatlı tatlı ısıttığı bir günde bana eşlik etmek ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480313
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480313,
					"content": "Seninle sohbet ederken her yürüyüş dinlendirici olur tatlım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480314
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480314,
					"content": "Geri döndüğümüzde bana bir bardak daha Uyuyan Gül hazırlarsın hem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480315,
						705480316
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480315,
					"content": "Harika olur!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480317
					]
				},
				{
					"id": 705480317,
					"content": "Haha, hatırlatırım o halde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480318
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480318,
					"content": "Günü geldiğinde hiçbir mazeret kabul etmem ama, ona göre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480316,
					"content": "Bunu mutlaka yapalım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480317
					]
				},
				{
					"id": 705480311,
					"content": "Senin memnun kalman benim için en büyük övgüdür!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480312
					]
				}
			]
		}
	]
