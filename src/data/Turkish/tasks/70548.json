							2194.736,
							230.089,
							-781.087
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705480201,
					"content": "Kar Buseli Şafak hazır, umarım beğenirsin!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480202
					]
				},
				{
					"id": 705480202,
					"content": "Mmm... Çok lezzetli olmuş tatlım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480203
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480203,
					"content": "Hoş bir ekşiliği var, tatlı ama baymıyor. Damakta pürüzsüzce dağılıp bitişte ferah bir tat bırakıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480204
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480204,
					"content": "Ancak nedense kendimi beklediğimden daha enerjik hissediyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480205
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480205,
					"content": "Acaba farkında olmadan Glenfidia'nın sırrını çözdün de onunkinden bile daha etkili bir enerji içeceği mi hazırladın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480206,
						705480207
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480206,
					"content": "Malzemelerle biraz oynasam mı acaba?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480208
					]
				},
				{
					"id": 705480208,
					"content": "Kafana takma, bir yere yetişmiyoruz! Hımm... Gözlerin merakla parlıyor, sanki soracak pek çok sorun varmış gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480209
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480209,
					"content": "Biraz sohbet edelim. Acele etme... Birazdan aradığın ilhamı bulursun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480210
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480210,
					"content": "Bugün hangi kitapları geri aldın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480211
					]
				},
				{
					"id": 705480211,
					"content": "*iç çeker* Madem sordun söyleyeyim, bugün biraz sıra dışı bir gündü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480212
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480212,
					"content": "Fontaine'deki eğitimini yeni bitirmiş bir şef, geçenlerde Goth Grand Otel'de çalışmaya başladı. En kıymetli kitabımız olan \"Bin Yıllık Mondstadt Tatlıları Külliyatı\"nı ödünç aldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480213
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480213,
					"content": "Görünüşe göre bazı tuzlu yemeklerin lezzetini geliştirmek için tatlı yapım tekniklerinden faydalanmayı planlıyor. Yağ oranlarını azaltmak gibi bir şeylerden bahsediyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480214,
						705480215
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480214,
					"content": "Tatlı et yemekleri...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480216
					]
				},
				{
					"id": 705480216,
					"content": "Gerçekten de öyle... Sonuçlara bakılırsa karamel sosunu biraz fazla kaçırmış. Güzel kokması gereken et dilimleri mide bulandıracak kadar tatlı olmuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480217
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480217,
					"content": "Karamel sos harika bir malzeme bu arada. İçeceklere eklendiğinde insanı mutlu etmeyi asla ihmal etmez. Bazen beş çayıma bile bir kaşık atarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480218
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480218,
					"content": "Sanırım yiyecekleri geliştirmek, her zaman mümkün olduğunca yaratıcı düşünmekten ibaret değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480219
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480219,
					"content": "Bu arada... Yanında getirdiğin şey not defteri mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480220
					]
				},
				{
					"id": 705480220,
					"content": "Ha, bu mu? Bugünkü diğer ayak işlerinden biri için getirmiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480221
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480221,
					"content": "Keşif takımından büyük bir birlik yakında Mondstadt'a dönüyor. O kadar uzun süredir yoklar ki damak zevklerinin değişmiş olması muhtemel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480222
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480222,
					"content": "Jean benden bazılarının ailelerini ziyaret etmemi istedi. Şövalyelerimizin değişen tercihlerini hangi yeni yemek malzemelerinin telafi edebileceğini anlamaya çalışacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480223,
						705480224
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480223,
					"content": "Ne ayrıntılı bir planlama...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480225
					]
				},
				{
					"id": 705480225,
					"content": "Hepsi kanlarını, terlerini ve zamanlarını Mondstadt'ı korumaya adadılar. Karşılığında biraz özeni ve saygıyı hak ediyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480226
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480226,
					"content": "Edindiğim bilgilere göre en çok talep edilen malzeme Natlan'dan Cacahuatl'mış. Görüyorum ki şövalyelerimiz kakaoyu epey sevmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480227
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480227,
					"content": "Birçoğu mektuplarında enerji toplamak için kakao tükettiklerini belirtmiş. Sıcak kakaoyu ben de denedim ve zinde kalma konusunda kahve kadar etkili olduğunu söyleyebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480228
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480228,
					"content": "Son zamanlarda şehir dışına çıktın mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480229
					]
				},
				{
					"id": 705480229,
					"content": "Bu fırsattan istifade kırsalın tadını çıkarmak için sıvışıp gittiğimi ima etmiyorsundur herhalde, değil mi? ... Hehe, yakaladın beni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480230
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480230,
					"content": "Mondstadt'ın az bilinen içkileri üzerine yaptığım araştırmalar beni Şafak Şaraphanesine götürdü, orada Baş Hizmetçi Adelinde ile kısa bir sohbet ettik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480231
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480231,
					"content": "Dönerken devriye gezen Ematol ile karşılaştım. Nasıl baş edeceğini bilmediği bazı canavarlara rastlamış, çaresizce benden yardım istedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480232
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480232,
					"content": "Gözü dönmüş tazılara hadlerini bildirmek için ona Kurtlar Diyarı'na giden kestirme bir yolda eşlik ettim... Böyle canlandırıcı bir idman yapmayalı epey olmuştu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480233
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480233,
					"content": "Peki son zamanlarda ne tür malzemeler ilgini çekiyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480234
					]
				},
				{
					"id": 705480234,
					"content": "\"Son zamanlarda\" mı? Kelimelerini ne kadar da dikkatli seçiyorsun tatlım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480235
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480235,
					"content": "Son görüşmemizden bu yana benim de değişmiş olabileceğimi düşündüğün için mi, yoksa sadece hatırlayamadığından mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480236,
						705480237
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480236,
					"content": "Sonuçta çok gezip çok okuyan birisin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480238
					]
				},
				{
					"id": 705480238,
					"content": "Hiç fena değil! Kusursuz bir cevap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480239
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480239,
					"content": "Öğrencilik yıllarımda okuduğum yeni ve heyecan verici her malzemeye ilgi duyar, sürekli ufkumu genişletir ve konfor alanımdan çıkardım. Ama artık rahat ve rutin bir hayata alıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480240
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480240,
					"content": "Liyueli bir hukuk uzmanından alıntı yapacak olursam, hayatım hızla \"emeklilik yıllarını huzur ve konfor içinde geçirme\" evresine yaklaşıyor. Artık macera ve heyecan beni eskisi kadar kolay harekete geçirmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480241
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480241,
					"content": "Hatırlıyorsundur, birkaç yıl önce birlikte bir maceraya atıldığımızda benim için o tatlı simya malzemesini bulmuştun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480242
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480242,
					"content": "O zamandan beri damak tadım hiç değişmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480243
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480243,
					"content": "Pekala, sanırım neyin iş göreceğini biliyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480244
					]
				},
				{
					"id": 705480244,
					"content": "Sana hemen yeni ve geliştirilmiş bir tarif hazırlayayım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480245
					]
				},
				{
					"id": 705480245,
					"content": "Tahmin ettiğim gibi tatlım, parlak zihnin daha da keskinleşmiş. O özel ilham kıvılcımını çakmak için tek ihtiyacın olan, sana yol gösterecek birkaç ufak ipucuymuş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705480237,
					"content": "Zevklerinin zaman zaman değişmesi gayet normal...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480238
					]
				},
				{
					"id": 705480224,
					"content": "Ne kadar da düşünceli bir hareket...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480225
					]
				},
				{
					"id": 705480215,
					"content": "Kesinlikle alışılmadık bir yaklaşım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480216
					]
				},
				{
					"id": 705480207,
					"content": "Tarifi değiştirip sana yenisini hazırlamamı ister misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480208
					]
				}
			]
		},
