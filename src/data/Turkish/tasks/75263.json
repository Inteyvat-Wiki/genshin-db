			},
			"dialogs": [
				{
					"id": 752630101,
					"content": "Herkesin dikkatine! Sefa Yeli Hız Şampiyonası başlamak üzere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630102
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630102,
					"content": "Üç gündür şampiyonluğunu sürdüren \"Nanaslı Hırçın Rüzgar\"ı yenecek kişi, günün büyük ödülünü almaya hak kazanacak! Şampiyonaya kayıt olmak için son fırsat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630103
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630103,
					"content": "Hıh! \"Nanaslı Hırçın Rüzgar\"a meydan okuyacak kimse yok mu? Buraya kadar mı yani? Kaybetmekten bu kadar mı korkuyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630104
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630104,
					"content": "*iç çeker* \"Nanaslı Hırçın Rüzgar\"a kimse kafa tutamaz. Üç gün arka arkaya zafer kazanmak herkesin harcı değildir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630105
					]
				},
				{
					"id": 752630105,
					"content": "Arrrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630106
					]
				},
				{
					"id": 752630106,
					"content": "Hı? Şansını mı denemek istiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630107
					]
				},
				{
					"id": 752630107,
					"content": "Hıh. Sürüngenlerin girmesine müsaade edecek kadar alçaldık mı artık? Pekala! İstediğiniz canavarı çıkarın karşıma, size gerçek hız neymiş göstereceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630108
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630108,
					"content": "Bu nasıl ilginç bir turnuva haline geldi böyle! Acaba Sürüngen yoldaşlarımız, üç kere şampiyon olan \"Nanaslı Hırçın Rüzgar\"ı tahtından indirebilecek mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kinowa"
				}
			]
		},
		{
			"id": 7526302,
			"completionStepIds": [
				7526301
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
