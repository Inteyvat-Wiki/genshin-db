				"points": []
			},
			"dialogs": [
				{
					"id": 752630201,
					"content": "Ben de kaydolmak istiyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752630202
					]
				},
				{
					"id": 752630202,
					"content": "Şok edici bir gelişme! Cesur bir savaşçı geliyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630203
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630203,
					"content": "Hı? Bana karşı bir şansın olabileceğini mi düşünüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630204
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630204,
					"content": "Birbiri ardına beklenmedik olaylar yaşanıyor... Sonunda şampiyon kim olacak? Birlikte izleyip görelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630205
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630205,
					"content": "Görevliler yarış parkurunu işaretlerken izleyiciler de toplaşıyor. Start çizgisinde yerini alıyorsun...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
