			"dialogs": [
				{
					"id": 752630301,
					"content": "İnanılmaz bir olay! Sonunda biri \"Nanaslı Hırçın Rüzgar\"ı yenmeyi başardı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630302
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630302,
					"content": "Şimşek gibi hareketleriyle turnuvayı kazanan yarışmacı karşınızda. Kendisine bir alkış alalım! Tebrikler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630303
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630303,
					"content": "Kaybettim. Olamaz... Bu doğru olamaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630304
					],
					"speakerTitle": "\"Nanaslı Hırçın Rüzgar\""
				},
				{
					"id": 752630304,
					"content": "O gerçekten harikaydı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630305
					]
				},
				{
					"id": 752630305,
					"content": "Fakat uzun zamandır bizi takip eden izleyicilerimiz, \"Nanaslı Hırçın Rüzgar\"ın aslında bu pistte koşmuş en hızlı yarışçımız olmadığının farkındadırlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630306
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630306,
					"content": "Ondan önce iki yerel efsane bu pisti domine etmişti. Ve bugün geri döndüler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630307
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630307,
					"content": "Hoş geldin \"Tezgeldi\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630308
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630308,
					"content": "♪ ♩~~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630309
					]
				},
				{
					"id": 752630309,
					"content": "Ve... \"Tezgitti\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630310
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630310,
					"content": "♫ ♩~~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630311
					]
				},
				{
					"id": 752630311,
					"content": "Sevgili yarışmacı, karşındakiler gerçekten dişli rakipler. Az önceki performansınla dahi... Onları yenmen neredeyse imkansız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630312
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630312,
					"content": "Hazır mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630313
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630313,
					"content": "Hazırım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752630314
					]
				},
				{
					"id": 752630314,
					"content": "Görevliler yarış parkurunu işaretlerken izleyiciler de toplaşıyor. Start çizgisinde yerini alıyorsun...",
