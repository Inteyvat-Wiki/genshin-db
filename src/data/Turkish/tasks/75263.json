			"dialogs": [
				{
					"id": 752630501,
					"content": "Yarış sona erdi! Artık her şey sona erdi! Neler oluyor böyle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630502
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630502,
					"content": "#Ve karşınızda yarışın tartışmasız galibi... {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630503
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630503,
					"content": "Vay canına! Muhteşemdi! \"Tezgeldi\" ile \"Tezgitti\"yi yenmeyi başardı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630504
					]
				},
				{
					"id": 752630504,
					"content": "Altın rengi bir şimşek gibiydi adeta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630505
					]
				},
				{
					"id": 752630505,
					"content": "Hadi ama, gümüş şimşek de yok muydu? Kimse gümüş şimşeği görmedi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752630506,
					"content": "Ezici bir yenilgiydi... Asla bu hıza ulaşabileceğimi sanmıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630507
					],
					"speakerTitle": "\"Nanaslı Hırçın Rüzgar\""
				},
				{
					"id": 752630507,
					"content": "Asla vazgeçme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752630508
					]
				},
				{
					"id": 752630508,
					"content": "Ben... Seni örnek alacağım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630509
					],
					"speakerTitle": "\"Nanaslı Hırçın Rüzgar\""
				},
				{
					"id": 752630509,
					"content": "♪ ♩~~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630510
					]
				},
				{
					"id": 752630510,
					"content": "♫ ♩~~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630511
					]
				},
				{
					"id": 752630511,
					"content": "Turnuvanın şampiyonu için hazırladığımız büyük ödülü lütfen kabul edin. Sonuna kadar hak ettiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752630512
					],
					"speakerTitle": "Kinowa"
				},
				{
					"id": 752630512,
					"content": "Sefa Yeli Hız Şampiyonası tarihine adınız altın harflerle kazınacak!",
