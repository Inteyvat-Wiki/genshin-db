			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kukla"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 762180101,
					"content": "Aa? Geldiniz demek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180102
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 762180102,
					"content": "Selam Sandrone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180103,
						762180104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180103,
					"content": "Davet ettiğin için teşekkürler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180105
					]
				},
				{
					"id": 762180105,
					"content": "Hı? Mektubunda çay saati yapacağız dememiş miydin? E ortalıkta hiçbir şey yok! Sakın Paimon'a bunun atıştırmalıksız, kuru kuru bir buluşma olacağını söyleme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180106,
					"content": "Hah, yok artık Paimon. Sence yiyecekleri unutur muyum hiç?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180107
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 762180107,
					"content": "Vay canına! O... O masa yoktan mı belirdi öyle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180108,
					"content": "Hehe, nasıl ama? Etkileyici değil mi? Yeni geliştirdiğim portatif çay masam bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180109
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 762180109,
					"content": "Taşıması da depolaması da çok kolay, hatta tıpkı Fagio gibi havada süzülme mekanizması da var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180110
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 762180110,
					"content": "Daha da etkileyici olan kısmı... Neyse boş verin, işi gösterişe döküp satış konuşmasına çevirmek istemiyorum. Kendiniz görürsünüz zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180111
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 762180111,
					"content": "Buyurun, çay ve ufak tefek atıştırmalıklar hazırladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180112
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 762180112,
					"content": "Öyleyse hiç çekinmeden alıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180113
					]
				},
				{
					"id": 762180113,
					"content": "Mmm! Bunlar enfes olmuş! Elinin tadına diyecek yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180114,
					"content": "Elbette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180115
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 762180115,
					"content": "Peki ama böyle bir şeyi yapmak nereden aklına geldi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180116,
					"content": "Dostlarım nerede olursa olsun, onlarla güzel bir çay saatinin keyfini çıkarabilmek istedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180117
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 762180117,
					"content": "Bunu daha önce de söylemiştim. Değer verdiklerimizi yaşatmak, sadece elimizdekilere sımsıkı sarılmakla olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180118
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 762180118,
					"content": "Son zamanlarda içimden hep yürüyüşe çıkmak, dostlarıma daha sık misafir olmak geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180119
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 762180119,
					"content": "Ama başkalarının evine kendimi davet ettirip çay ve ikram hazırlamalarını beklemek, üstüne bir de masayı onlara toplatmak... Bir hanımefendiye hiç yakışmaz doğrusu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180120
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 762180120,
					"content": "Hehe, Paimon arkadaşlarının bunu hiç dert edeceğini sanmıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180121,
					"content": "Ben ederim. Hem böyle basit bir icat benim için çocuk oyuncağı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180122
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 762180122,
					"content": "Bayağı hoşunuza gitti bakıyorum. Merak etmeyin, size de bir tane yapıveririm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180123
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 762180123,
					"content": "Hı? Emin misin, zahmet olmasın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762180124,
					"content": "Lafı bile olmaz. Dedim ya, böyle bir şeyi yapmak iki dakikamı alır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762180125
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 762180125,
					"content": "Madem öyle diyorsun... Çok sağ ol.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180126
					]
				},
				{
					"id": 762180126,
					"content": "Ne demek, lafı bile olmaz. Fontinalia Festivalinde bana çok yardımınız dokundu. Bu da benden size teşekkür mahiyetinde olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kukla"
				},
				{
					"id": 762180104,
					"content": "Umarım seni çok bekletmemişizdir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762180105
					]
				}
			]
		}
	]
}