			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arapas",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730210401,
					"content": "Hımm... Bu su, nehrin kaynağından geliyor. Ay ışığı kadar berrak ve temiz bir suyun aktığı Canlı Kaynak Suyundan yani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210402
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210402,
					"content": "Arachatora, Arasaka ve Araphala büyürken bu sudan içselerdi, bu kadar aptal olmazlardı. Bir tek kardeşim Arapacati...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210403
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210403,
					"content": "Şimdi ne yapacağız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210404,
					"content": "Hı? Şey, şimdi bana bir tencere dolusu çorba yapmanız gerek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210405
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210405,
					"content": "Arapas'ın rehberliğinde suya biraz meyve ve sebze ekleyip pişirmeye başlıyorsun.\\nTencereden çok hoş bir koku yayılmaya başlıyor.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730210406
					]
				},
				{
					"id": 730210406,
					"content": "Bittiğinde çorbayı beraber tadıyorsunuz.\\nBeklentilerinizi karşılıyor sayılır. Malzemelerin kokusu burnunuza geliyor...\\nYine de çorbanın içinde çeşni olmayınca fazla sade kalıyor.\\nHiçbir tat alınmıyor.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730210407
					]
				},
				{
					"id": 730210407,
					"content": "Mmm, üstün lezzet dediğin işte böyle kokmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210408
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210408,
					"content": "#Hımm... Ne düşünüyorsun {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210409,
						730210410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210409,
					"content": "En azından susuzluğu gideriyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210411
					]
				},
				{
					"id": 730210411,
					"content": "Paimon, bunun biraz tuz ve karabiberle daha iyi olacağını düşünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210412,
					"content": "Tuz ve karabiber her yemeği daha iyi yapar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210413
					]
				},
				{
					"id": 730210413,
					"content": "Yüce Aramuhukunda! Tuz mu eklemek istiyorsunuz? Ne berbat bir fikir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210414
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210414,
					"content": "Tuzlu toprakta yaşam olmaz, Aranaralar da büzüşüp tohuma dönüşür. Naralar buna rağmen tuz mu eklemek istiyor yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210415
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210415,
					"content": "Çorbaların tatsız olması gerekir! Siz Naralar bunu neden anlayamıyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210416
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210416,
					"content": "Daha önceden gelen Nara, çorbamdan bir kase içtikten sonra bize bir hikaye anlatmıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210417
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210417,
					"content": "\"Biz Naralar eve geldiğimizde ilk aldığımız koku çorba kokusudur. O yüzden çorbanın ihtiyacı olan tek şey güzel bir kokudur.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210418
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210418,
					"content": "Sonra da bana yaptığım çorbanın çok güzel koktuğunu söylemişti. Bunu asla unutmuyorum! O yüzden söyleyeceğiniz hiçbir şeye inanmam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210419
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210419,
					"content": "İyi de yalnızca kokusu yetmez ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210420,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210421
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210421,
					"content": "Hıh! Bu Utsava Festivalinin Narası sen olduğuna göre, Araja ve Arapacati'nin onayını almışsın demektir. Neyse... Tadı olan bir çorba yapmayı deneyeyim bari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210422
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210422,
					"content": "Bir dahaki sefere daha iyi bir su bulacağım ki çorbam daha da lezzetli olsun!",
