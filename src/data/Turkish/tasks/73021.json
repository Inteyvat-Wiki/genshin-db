				{
					"id": 730210213,
					"content": "Şey... Kokusu çok güzel ama Paimon nedense hiç tat alamıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210214,
					"content": "Yüce Aramuhukunda! Siz Naralar ne yapıyorsunuz öyle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210215
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210215,
					"content": "Aranara... Sen nereden çıktın birden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210216,
					"content": "Yer altından! Onu bırak şimdi, neden benim çorbamı içiyorsunuz siz? Arapas bu çorbaya çok emek verdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210217,
						730210220
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210217,
					"content": "Özür dileriz...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210218
					]
				},
				{
					"id": 730210218,
					"content": "Özür dileriz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210219,
					"content": "Hıh! Çorba hırsızları sizi! Özür dilemekle olmaz bu iş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210223
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210223,
					"content": "Burada çorba yapmanın ne kadar zor olduğunu biliyor musunuz siz? Bir yağmur yağıyor, bir güneş açıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210224
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210224,
					"content": "Hımm... Gerçi Varuna Mekanizması son zamanlarda çok daha dengeli. Hava da tekrar normale döndü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210225
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210225,
					"content": "O aslında bizim sayemizde oldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210226,
					"content": "Hıh! Eminim Varuna Mekanizmasını tamir eden Nara gibi iyi bir Nara sayesinde olmuştur! Sizin gibi çorba hırsızlarının sayesinde değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210227
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210227,
					"content": "Ne kadar kabasın! O kadar güzel kokuyordu ki karşı koyamadık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210228,
					"content": "Peki yapması o kadar zorsa, neden burada pişiriyorsun ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210229,
					"content": "Yemeğin ana malzemesinin her gün toplanması gerekiyor, yani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210230,
						730210231
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210230,
					"content": "Şeflik gururun mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210232
					]
				},
				{
					"id": 730210232,
					"content": "Su! Ana malzeme su! Su, çorbamın lezzetini çok etkiler. O yüzden en kaliteli suyu kullanarak hazırlamam gerekir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210233
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210233,
					"content": "Ben de bir süredir Apam Ormanı'nda dolaşıp çorba yapmak için su topluyordum. Bir ağaçta ne kadar çok yaprak varsa, ben de o kadar çok su örneği topladım. Sonunda da en güzel \"Canlı Kaynak Suyunu\" buldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210234
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210234,
					"content": "Utsava Festivali için yapacağım üstün lezzete uygun tek su kaynağı o. Anlatsam da anlamazsınız zaten siz... Bir tek daha önce gelen o Nara anlamıştı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210235
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210235,
					"content": "Festival demişken... Bizi Arapacati gönderdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210236,
					"content": "Arapas'a olanları anlatıyorsun...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730210237
					]
				},
				{
					"id": 730210237,
					"content": "Siz kardeşimin Nara dostlarısınız demek! Üstelik Utsava Festivali de yaklaşıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210238
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210238,
					"content": "Neyse, sorun yok. Canlı Kaynak Suyunu buldum ve Üstün Lezzetli yemeğini tamamladım. Yemek de bu tencerenin içinde... Ah evet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210239
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210239,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210240
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210240,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210241
					]
				},
				{
					"id": 730210241,
					"content": "Ehehehe... Üzülme ya! Çorban gerçekten çok güzel kokuyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210242,
					"content": "Ah, Canlı Kaynak Suyum! Kaynağında \"Apshvaanalar\" yaşıyor. Uzun süre gitmelerini bekleyip ancak bir tencere dolusu su alabilmiştim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210243
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210243,
					"content": "Olmaz! Bana Canlı Kaynak Suyundan bir tencere su daha getirmeniz lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210244
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210244,
					"content": "\"Apshvaana\" mı? O da ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210245,
					"content": "Hıh! Siz Naralar ormana dair hiçbir şey bilmiyorsunuz. Apshvaanalar suda yaşar, dört bacakları ve bir kuyrukları vardır. Ayrıca ısırırlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210246
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210246,
					"content": "... Köpekler mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210247,
						730210248
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210247,
					"content": "Köpekler suda yaşamaz ki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210249
					]
				},
				{
					"id": 730210249,
					"content": "Ah, evet. Peki \"Apshvaana\" nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210250
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210250,
					"content": "Boş ver şimdi onu! Ben suyumu istiyorum! Özellikle de o Canlı Kaynak Suyundan getirmenizi istiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210251
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210251,
					"content": "#Tamam, tamam... Başka bir seçeneğimiz yok {NICKNAME}. Hadi gidelim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210252,
						730210253
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210252,
					"content": "Doğru.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210254
					]
				},
				{
					"id": 730210254,
					"content": "O Canlı Kaynak Suyundan getirmeniz lazım. Başka suyu kabul etmem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210253,
					"content": "Hadi gidelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210254
					]
				},
				{
					"id": 730210248,
					"content": "Belki de Okeanid Köpekleridir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210249
					]
				},
				{
					"id": 730210231,
					"content": "Hayallerinin peşini asla bırakmamak mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210232
					]
				},
				{
					"id": 730210220,
					"content": "Şey... Çorbanı Paimon içti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210221
					]
				},
				{
					"id": 730210221,
					"content": "#{NICKNAME}! Paimon'u nasıl ispiyonlarsın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210222,
					"content": "Kimin içtiği umurumda değil! Çorbam gitti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210223
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730210208,
					"content": "Bence yapmayalım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210209
					]
				},
				{
					"id": 730210209,
					"content": "Evet ama Paimon çok merak etti. Paimon şimdi bir lokma alacak, sadece bir lokma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730210210,
					"content": "Sonrasında karnın ağrırsa ne yapacaksın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210211
					]
				},
				{
					"id": 730210211,
					"content": "Hıh, sen Paimon'u küçümsüyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210212
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
