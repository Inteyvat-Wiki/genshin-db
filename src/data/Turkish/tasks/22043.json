			},
			"dialogs": [
				{
					"id": 220430101,
					"content": "Kütüğüm ne ara bitti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430102
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430102,
					"content": "Ah, selam Gezgin! Seni gördüğüme ne kadar sevindim anlatamam. Acaba bana bir iyilik yapabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430103,
						220430104
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430103,
					"content": "Neymiş?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430105
					]
				},
				{
					"id": 220430105,
					"content": "Geçici başrahibemiz için tahtadan birkaç küçük oyma yapmaya çalışıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430106
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430106,
					"content": "Belki Narukami Adası'nda satabilirim diye onlardan birkaç paket götürmeyi düşünüyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430107
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430107,
					"content": "Satabilirsem kalıcı bir gelir akışı sağlayabileceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430108,
						220430111
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430108,
					"content": "Ah, bence satabilirsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430109
					]
				},
				{
					"id": 220430109,
					"content": "Hahaha, güzel dileklerin için teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430110
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430110,
					"content": "Bununla birlikte Leydi Neko'nun cazibesine güvendiğimi söyleyebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430118
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430118,
					"content": "Neyse, özetle böyle. Mesele şu ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430119
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430119,
					"content": "Ne yazık ki alıştırma yapmak için kullandığım kütükler bitmek üzere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430120
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430120,
					"content": "Acaba 10 adet Otogi Kütüğü toplamama yardım eder misin Gezgin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430121,
						220430123
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430121,
					"content": "Tabii ki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430122
					]
				},
				{
					"id": 220430122,
					"content": "O halde kolay gelsin. Yardımın için çok teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430126
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430126,
					"content": "İşin bittiğinde Otogi Kütüklerini bana getir lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430123,
					"content": "Gerçekten o kadar çok mu lazım?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430124
					]
				},
				{
					"id": 220430124,
					"content": "Alıştırma yapmaya daha yeni başladığım için işi güvenceye alıp malzeme istiflemek akıllıca olacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430125
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430125,
					"content": "Sana güveniyorum Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430126
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430111,
					"content": "Bu tahta oymalar da nereden çıktı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430112
					]
				},
				{
					"id": 220430112,
					"content": "Ah, şey... Bugüne dek başrahibeden ödeme olarak ne aldığımı biliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430113
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430113,
					"content": "Genellikle bu... şişeler, bardaklar, tabaklar ve farklı ıvır zıvırlarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430114
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430114,
					"content": "Biraz eski görünüyorlar ancak bunlara değer biçmeye götürdüğümde aslında biraz \"antika\"... ve değerli olduklarını öğrendim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430115
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430115,
					"content": "Ancak dürüst olmak gerekirse bunları satmak o kadar kolay değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430116
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430116,
					"content": "Hem düzgün bir gelir kapısı da sağlamıyorlar. Bir gün başrahibe bunlardan daha fazla veremeyecek duruma gelirse işsiz kalacağım, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430117
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430117,
					"content": "O yüzden ben de yeni bir iş kovalamaya karar verdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430118
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430104,
					"content": "Ne yapıyorsunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220430105
					]
				}
			]
		},
