			"dialogs": [
				{
					"id": 220430301,
					"content": "Hımm, bunlar iş görür sanırım. Tapınağa gelmek için bunca yolu teptikten sonra senden iş istediğim için kusura bakma, lütfen bunları al.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430302
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430302,
					"content": "Kütük oymacılığımı geliştirdikten sonra sana en iyi eserlerimden birini göndereceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220430303
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220430303,
					"content": "Hımm, bu sefer geçici başrahibe için nasıl bir oyma yapsam acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				}
			]
		}
