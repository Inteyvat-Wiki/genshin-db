					"content": "*horlar* *horlar*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220103
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220103,
					"content": "Selam! Merhaba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220104,
					"content": "Hımm... Lezzetli meyveler... *horlar*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220105
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220105,
					"content": "Ne kadar derin uyuyor... Doğru ya, Arapacati, <color=#00E1FFFF>Doğa gücünün</color> işe yarayacağını söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220106,
					"content": "#Paimon bu işi sana bırakıyor {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7302202,
