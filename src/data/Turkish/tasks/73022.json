						730220502
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220502,
					"content": "Araphala!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220503,
					"content": "Hı? Aa, Paimon gelmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220504
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220504,
					"content": "#{NICKNAME}, dışarıdaki o kocaman canavarın icabına baktı. Biz de sana onu söylemeye geldik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220505,
					"content": "#Vay be! Nara {NICKNAME} canavardan daha küçük duruyor, bu kadar güçlü olmasını beklemiyordum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220506,
						730220507
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220506,
					"content": "Çok kolay oldu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220508
					]
				},
				{
					"id": 730220508,
					"content": "Pekala, gidelim o halde. İyi Nara, birlikte meyve yiyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220507,
					"content": "Epey zorlandım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220508
					]
				}
			]
		},
		{
			"id": 7302206,
