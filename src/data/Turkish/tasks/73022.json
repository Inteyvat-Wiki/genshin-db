				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730220301,
					"content": "Aa, sen miydin? Görüşmeyeli uzun zaman oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220302
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220302,
					"content": "Neredeyim ben? Burası bir mağara mı? Off, başım dönüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220303
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220303,
					"content": "Sen kimsin? Neden burada uyuyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220304,
					"content": "Ben kim miyim... Off, başım çok kötü. Dur, bir düşüneyim... Adım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220305
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220305,
					"content": "Adım Araphala! Hehe, şimdi hatırladım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220306
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220306,
					"content": "Demek Araphala sensin! Biz de nereye gittiğini merak ediyorduk... Meğer tüm bu zaman boyunca bu mağarada uyuyormuşsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220307,
					"content": "Araphala... Adımı biliyorsunuz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220308
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220308,
					"content": "Ah! Naralar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220309
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220309,
					"content": "İşte şimdi tamamen uyandı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220310,
					"content": "Evet, kendine tamamen geldi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220311
					]
				},
				{
					"id": 730220311,
					"content": "*ağlar* Henüz hazır değilim. Lütfen beni ezip lapa yapmayın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220312
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220312,
					"content": "Ne? Seni neden lapa yapalım ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220313,
					"content": "Kardeşim, hep böyle yarı uykulu gezersem kötü bir Naranın beni alıp lapa yapacağını söylerdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220314,
						730220317
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220314,
					"content": "Çok lezzetli göründüğün doğru!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220315
					]
				},
				{
					"id": 730220315,
					"content": "Aaaaaaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220316
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220316,
					"content": "#{NICKNAME}! Şöyle şakalar yapmasana! Araphala, kimse seni pişirmeyecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220318,
					"content": "Sahiden mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220319
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220319,
					"content": "Sahiden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220320,
					"content": "Şaka yapıyorsun, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220321
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220321,
					"content": "#Şaka yapmıyorum! Neyse, Paimon'un adı Paimon, bu uzun Nara da {NICKNAME}. Bizi Arapacati gönderdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220322,
					"content": "Arapacati mi? O iyi mi? Ben ne kadar zamandır buradayım acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220323
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220323,
					"content": "Ne kadar zamandır mı? Paimon yanlış hatırlamıyorsa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220324,
					"content": "Hımm... Çok, çok uzun zaman önce tohumlar topraktan filizlenip ağaca dönüştü. Kaç kat Arapacati uzunluğundaydı o ağaçlar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220325,
						730220327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220325,
					"content": "Yedi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220326
					]
				},
				{
					"id": 730220326,
					"content": "#Vay be! Kendini aşıyorsun {NICKNAME}! Muazzam bir hafızan var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220329,
					"content": "Çok zaman geçmiş. Olamaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220330
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220330,
					"content": "Neyse, biz sana olup biteni anlatalım. Utsava Festivali başlamak üzere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220331,
					"content": "Araphala'ya olanları anlatıyorsun...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730220332
					]
				},
				{
					"id": 730220332,
					"content": "Demek Utsava Festivali geldi çattı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220333
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220333,
					"content": "Evet, o yüzden Arapacati artık Vanarana'ya dönmeni istiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220334,
					"content": "Öff... İyi de ben henüz aşçılık eğitimimi tamamlamadım ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220335
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220335,
					"content": "Sen zaten uyumuyor muydun? Paimon sanmıştı ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220336,
					"content": "\"Uyumak\" mı? Yok canım, sadece geçmişi düşünüyordum. Uyuyacak kadar ciddi bir şey yoktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220337
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220337,
					"content": "Ne? Uyku Aranaralar için ciddi bir şey mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220338,
					"content": "Hımm... Nasıl açıklasam... Biz yalnızca çok ciddi bir tehlike altındaysak uykuya dalarız. Uyuyunca da anılarımızı ve hayallerimizi bir tohuma saklarız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220339
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220339,
					"content": "Tehlike bittiğinde ve doğru zaman geldiğinde, o tohum ormana döner ve yeniden filizlenip bir Aranaraya dönüşür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220340,
						730220341,
						730220342
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220340,
					"content": "Bu gerçekten zor olmalı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220344
					]
				},
				{
					"id": 730220344,
					"content": "Tabii tüm Naraların uykuya ihtiyacı olduğunu da biliyorum. Vaktinde benim de bir Nara dostum vardı. Tıpkı senin gibi bir Altın Naraydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220345
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220345,
					"content": "Bir keresinde onunla buraya Benzersiz Taze Meyve toplamaya gelmiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220346
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220346,
					"content": "O zamandan beri hep buraya gelip meyve topluyorum. O Nara geri dönerse veya yeni Nara dostlar edinirsem birlikte yiyelim diye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220347
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220347,
					"content": "Bu sefer çok fazla meyve topladım... Aa, meyvelerim nereye gitti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220348
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220348,
					"content": "Demek yolda gördüğümüz Güneriklerini düşüren sendin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220349,
					"content": "Çoğunu düşürmüş müyüm yani? Ama sorun değil, hehe... En taze ve lezzetli olanları yanımda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220350
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220350,
					"content": "Ama yine de... O kadar çok meyveyi nasıl düşürdüm ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220351
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220351,
					"content": "Aşçılık eğitimi için kardeşlerimle yola çıktığımı hatırlıyorum. Tabii onlar taze meyvelerin en iyi yemek malzemesi olduğunu bilmiyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220352
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220352,
					"content": "Meyve toplarken... Evet, tam meyve topluyordum ki birdenbire kocaman bir canavar çıkageldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220353
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220353,
					"content": "O dev canavar beş kat Araphala uzunluğundaydı, upuzun da bir kuyruğu vardı. Her adımında yer sarsılıyordu. Üstelik içinde Marananın aurası da vardı sanırım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220354
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220354,
					"content": "Ve çok güçlüydü! Arama ve Arabalika orada olsaydı bile bu canavarı parçalarken zorlanırlardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220355
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220355,
					"content": "Nasıl yani? O kadar güçlüler mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220356
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220356,
					"content": "Evet ama ben değilim. Zaten o yüzden buraya saklanmam gerekti. Canavarın gitmesini beklerken geçmişi düşünmeye başladım, sonra da birdenbire karşımda sizi buldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220357
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220357,
					"content": "O kadar korkunç ve büyük bir canavar dışarıda dolaşırken, buradan çıkmak istemiyorum. Üzgünüm \"kardeşim\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220358
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220358,
					"content": "Ah, Paimon anladı. Ama Utsava Festivali yaklaşıyor. Artık eve dönmen gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220359
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220359,
					"content": "Utsava Festivalinde gamsız olmamız gerek ama ben buradan ayrılırsam canımın derdine düşeceğim. *horlar* Utsava Festivaline yakışmaz bu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220360
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220360,
					"content": "*horlar* *horlar* Nara Varuna...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220361
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220361,
					"content": "Off... Şuna bak ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220362
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220362,
					"content": "#Şimdi ne yapacağız {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220363,
						730220364
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220363,
					"content": "Hadi şu korkunç canavarın icabına bakalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220365
					]
				},
				{
					"id": 730220365,
					"content": "Paimon, herhangi bir şeyin Fırtına Dehşeti'nden daha korkunç olabileceğini düşünmüyor. Acaba Aranaralar Fırtına Dehşeti'ni görse ne derdi? Paimon merak ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220366
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220366,
					"content": "\"Bir milyon kat Araphala uzunluğunda!\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220367
					]
				},
				{
					"id": 730220367,
					"content": "\"Kuyruğundan kafasına yürüyene kadar ay doğup batıyor!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220368
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220368,
					"content": "Hadi gel de dışarıdaki canavarı halletmesinde ona yardım edelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220364,
					"content": "Ah, şu devasa canavar! Ne kadar da korkutucu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220365
					]
				},
				{
					"id": 730220341,
					"content": "Ne kadar güzel!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220344
					]
				},
				{
					"id": 730220342,
					"content": "Sen de tohuma dönüşebiliyor musun Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220343
					]
				},
				{
					"id": 730220343,
					"content": "Hey, senin Paimon'a bir garezin mi var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220344
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220327,
					"content": "Senin de hafızan çok iyi Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220328
					]
				},
				{
					"id": 730220328,
					"content": "Hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220317,
					"content": "Kimse seni lapa falan yapmayacak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220318
					]
				}
			]
		},
