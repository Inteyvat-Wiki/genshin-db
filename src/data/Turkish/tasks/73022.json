			},
			"dialogs": [
				{
					"id": 730220601,
					"content": "Pekala, Benzersiz Taze Meyvelerle yemek yapmaya başlayabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220602
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220602,
					"content": "Peki bu \"Benzersiz Taze Meyve\" ile sıradan meyvelerin arasındaki fark nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220603,
					"content": "Anlıyorum. Naraların gözünde tüm meyveler aynı olabilir ama aslında farklılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220604
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220604,
					"content": "Yalnızca güçlü ağaçlar Benzersiz Taze Meyve verebilir. Rüzgar estiğinde, ilk önce güçlü ağaçlar şarkı söylemeye başlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220605
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220605,
					"content": "Güçlü ağaçların verdiği Benzersiz Taze Meyveler, aslında onların bize bahşettikleri birer nimet. Nara dostumun dediğine göre, bu meyveler o kadar lezzetliymiş ki midende şarkı söylüyorlarmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220606
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220606,
					"content": "Acaba bu meyvelerden nasıl bir yemek yapılacak? Paimon sabırsızlanıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220607,
					"content": "Araphala yemeği hemen hazırlamaya başlıyor...\\nMeyveyi eşit bir şekilde bölüyor...\\nSonra da birkaç parçayı sana ve Paimon'a veriyor.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730220608
					]
				},
				{
					"id": 730220608,
					"content": "Taze meyveleri birlikte deniyorsunuz.\\nTahmin edileceği üzere tatları taze meyve gibi.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730220609
					]
				},
				{
					"id": 730220609,
					"content": "Çok lezzetli. Teşekkür ederiz güçlü ağaçlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220610
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220610,
					"content": "Bir dakika ya! Sen buna yemek pişirmek mi diyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220611,
					"content": "Benzersiz Taze Meyve kendi başına bile Üstün Lezzete sahip. Tadının mükemmel olması için pişirmeye gerek yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220612
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220612,
					"content": "Tadına baktığında anlayacaksın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220613
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220613,
					"content": "Lezzetli zaten ama... Tadı meyve gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220614,
					"content": "Sonuçta meyve zaten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220615
					]
				},
				{
					"id": 730220615,
					"content": "Evet, Paimon da öyle düşünüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220616,
					"content": "Siz Naralar da meyveleri kesip ahşap plaka üzerinde servis etmiyor musunuz zaten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220617
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220617,
					"content": "Öyle mi? Ha, bir saniye! Meyve tabağından mı bahsediyorsun yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220618,
					"content": "Meyve tabağı, yemekten sayılır mı ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220619,
						730220621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220619,
					"content": "Sayılır bence.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220620
					]
				},
				{
					"id": 730220620,
					"content": "Yine de Paimon'a biraz tuhaf geldi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220623
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220623,
					"content": "Böyle konularda inatçı olmaya gerek yok. Daha lezzetli yemek malzemeleri bulmak da bir çeşit yemek yapma yöntemi sayılır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220624
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220624,
					"content": "Yemek malzemesi ararken ormanın her yerini gezip ormanla daha da yakınlaşıyorum. Aşçılık eğitimimin anlamı da bu zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220625
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220625,
					"content": "Öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220626,
					"content": "Tabii ki öyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220627
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220627,
					"content": "Benzersiz Taze Meyveleri toplayıp Üstün Lezzetimi tamamladım. Böylece aşçılık eğitimim de tamamlanmış oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220628
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220628,
					"content": "Artık gururla Vanarana'ya dönebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220629
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220629,
					"content": "#İyi ki Nara {NICKNAME} ve Paimon, beni bu mağarada mahsur bırakan devasa canavarın icabına baktı. Yoksa Utsava Festivalini kaçıracaktım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220630
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220630,
					"content": "Peki o zaman, hadi hemen Vanarana'ya dön!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730220631,
					"content": "Evet, evet... Utsava Festivalini kaçırırsam kardeşimden bin tane laf işitirim... Düşüncesi bile ödümü koparıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730220621,
					"content": "Sanmıyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730220622
					]
				},
				{
					"id": 730220622,
					"content": "Evet, işlenmemiş bir şeye... Yemek demek tuhaf geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730220623
					],
					"speakerTitle": "Paimon"
				}
			]
		},
