			},
			"dialogs": [
				{
					"id": 765080301,
					"content": "#Bak sen! Meşhur {NICKNAME} değil mi bu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080302
					],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 765080302,
					"content": "Ben de Bayan Nilou yanımızda diye çok şanslı olduğumuzu düşünüyordum. Üstüne bir de işin üstadı geldi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080303
					],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 765080303,
					"content": "#Evet, {NICKNAME} için methiye düzmeye devam et. Çok hoşuma gidiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080304
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080304,
					"content": "Ne? Bunu Paimon'un söylemesi gerekmiyor muydu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765080305,
					"content": "Evet! O sözcükler Danışman Paimon'un ağzından usulca tıngırdayan bir ukulele sesi gibi çeviklik ve zarafetle dökülüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080306
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080306,
					"content": "Aynı sözcükler benim ağzımdan ise yarım fıçı içki içmiş bir davulcunun ritimleri gibi bol vurgulu ve yüksek sesle çıkıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080307
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080307,
					"content": "Tabii Usta Iansan'dan bas davula ikili vurmanın daha iyi olduğunu öğrendim. Hatta en iyisi otomatik bir silah gibi hiç durmadan vurmak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080308
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080308,
					"content": "Yani aynı sözcükleri söylememizin bir önemi yok çünkü bir kanon gibi birbirimizin sözlerini tamamlıyoruz. Hatta ritmi bulmana bile yardımcı olabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080309
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080309,
					"content": "N-ne? Paimon ne demek istediğini hiç anlamadı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765080310,
					"content": "Sanırım Nusta doğrudan işin özüne inerek ritme odaklandı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080311
					],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 765080311,
					"content": "Dansımızın özgür ve dışavurumcu olması istediğimizi yapabileceğimiz anlamına gelmiyor. En azından en önemli hareketlerimizin doğru ritimde olduğuna dikkat etmemiz gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080312
					],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 765080312,
					"content": "Yeni koreografimiz hazır ama yeni gelenlerle koreografiyi denemeye gelen yeni sürüngenler ritme uyum sağlamakta zorlanıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080313
					],
					"speakerTitle": "Taraneh"
				},
				{
					"id": 765080313,
