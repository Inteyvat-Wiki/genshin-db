			"dialogs": [
				{
					"id": 765080101,
					"content": "Kaplıca Halkı bir etkinlik falan mı düzenliyor? Buralarda çok ziyaretçi var gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765080102,
					"content": "Paimon şurada Sumeru'den birini görüyor... O... Dans gösterisi falan mı yapıyor o?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765080103,
					"content": "Ay ay ay! Göz kamaştırıcı kahramanımızla sevimli danışman Paimon da gelmiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080104
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080104,
					"content": "En çok saygı duyduğum savaşçı, hem dansın hem dövüş sanatlarının ustası, yaşamın üstadı... En içten selamlarımı iletiyorum sana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080105
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080105,
					"content": "Hımm... Bir yerden tanıdık geliyorsunuz Bayan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765080106,
					"content": "#{NICKNAME} gerçekten de dans etmeyi çok sever, nereden bildin bunu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765080107,
					"content": "#Çünkü Kutsal Alev Stadyumunda dans ederken çok eğlendiğine tanık oldum.{M#}{F#}",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080108
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080108,
					"content": "#Birlikte bir fotoğraf çektirdikten sonra bir köşeye çekilip Sürüngen Krakeri yedim ve {NICKNAME} dans ederken onu izledim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080109
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080109,
					"content": "Dansın bütün olayı rahatlayıp kendini özgür bırakmaktır! Az kalsın ben de sahneye atlayıp arkasında dans etmeye başlayacaktım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080110,
						765080112
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080110,
					"content": "Ah, şimdi hatırladım seni!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080111
					]
				},
				{
					"id": 765080111,
					"content": "Bundan onur duydum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080114
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080114,
					"content": "Şaka bir yana, gördüğünüz üzere Sumeru'dan dostlarımız var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080115
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080115,
					"content": "Mutota, Amina, Pacal ve Mualani bir araya geldi ve Çiçek Tüyü Klanının onları Yankıların Çocukları ve Kaplıca Halkı ile beraber ağırlayacağına karar verildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080116
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080116,
					"content": "Epey Münzevi paralı askeri de var gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765080117,
					"content": "Bir çatışmadan falan sonra onlarla arkadaş mı oldunuz yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765080118,
					"content": "Öyle sayılır! Ama birbirimizle çatışmadık, yanlış anlaşılmasın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080119
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080119,
					"content": "Hadramaveth Çölü'nün güney kıyısında barbekü partisi düzenliyorduk ki birden vahşi, kırmızı akbabalar belirip bize saldırıverdi. O kadar doymuştuk ki kıpırdayacak halimiz bile yoktu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080120
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080120,
					"content": "Çok da sinsice hareket ediyorlardı. Elimizden geldiğince onlara direnmeye çalıştık ama araziyi iyi bildikleri için bizi bitkin düşürmeyi başardılar. Sonunda o kadar yorulmuştuk ki pes edip geri çekilmek zorunda kaldık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080121
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080121,
					"content": "Ama geri çekilirken bir grup paralı askerle karşılaşıverdik. Akbabaların karşısına dikilip gizemli bir savaş dansı yapmaya başladılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080122
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080122,
					"content": "Bu da akbabalara bir mesaj falan göndermiş olmalı çünkü hemen ardından akbabalar kaçıp gitti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080123
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080123,
					"content": "Kızıl akbabaları bir savaş dansıyla kovduklarını mı söylüyorsun yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080124,
						765080125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765080124,
					"content": "Koreografileri ürkütücü derecede tuhaf olsa gerek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080126
					]
				},
				{
					"id": 765080126,
					"content": "İnanılmaz, değil mi? Biz de o dansın sırrını çok merak ettik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080127
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080127,
					"content": "Kampı topladıktan sonra gönlümüzce yiyip içtik ve ardından dans teknikleri üstüne konuşup birbirimize tüyolar verdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080128
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080128,
					"content": "O günden sonra canavarların veya vahşi hayvanların saldırısına uğradığımızda silahlarımızı kapıp onlara günlerini göstermeye başladık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080129
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080129,
					"content": "İki haftadan kısa süre içinde hem sıkı savaş dostları hem de ömürlük dans dostları oluverdik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080130
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080130,
					"content": "Ayrılmadan önce de ileride birbirimizin kamplarını ziyaret ederek bu \"dans partisini\" devam ettirmeye karar verdik. İşte bu da onun başlangıcı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080131
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080131,
					"content": "#Bekle bir dakika {NICKNAME}... Paimon hiç Sumeru ve Natlan arasındaki böyle bir dans partisine katıldığımızı düşünmüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080132,
						765080133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765080132,
					"content": "Hayır, katılmadık. Bu yeni bir şey.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080134
					]
				},
				{
					"id": 765080134,
					"content": "Böyle özel bir fırsatımız varken ve hep birlikteyken bize biraz ders vermek ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080135
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080135,
					"content": "Bu arada Mualani de burada. O kesinlikle aramızdaki en neşeli dans temsilcisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080136
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080136,
					"content": "Ayrıca Münzevi dostlarımız da Sumeru grubuna öncülük edip tavsiye vermesi için en meşhur yerli dansçılarından birini tutmuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080137
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080137,
					"content": "Kesin o dansçıyı da tanıyorsunuzdur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080138
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080138,
					"content": "Paimon kimden bahsettiğini biliyor galiba. Sonra onu iyice bir şaşırtsak çok güzel olur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080139,
						765080140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765080139,
					"content": "Ben varım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080141
					]
				},
				{
					"id": 765080141,
					"content": "Haha! Günümüz gittikçe güzelleşiyor! Mualani'nin dediği gibi işte şimdi havaya girdik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080142
					],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080142,
					"content": "Hadi, gidip küçük Taraneh'i bulalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nusta"
				},
				{
					"id": 765080140,
					"content": "Böyle bir şeyi hayatta kaçırmam!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080141
					]
				},
				{
					"id": 765080133,
					"content": "Bunu kendi gözlerimle görmek istiyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080134
					]
				},
				{
					"id": 765080125,
					"content": "Akbabaların paralı askerleri daha önceden tanımadığından falan emin misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080126
					]
				},
				{
					"id": 765080112,
					"content": "Artık seni asla unutmam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765080113
					]
				},
				{
					"id": 765080113,
					"content": "Haha! İhtiyacım olan tam da buydu işte. Kendimi biraz daha zorlayıp gerçekten muhteşem bir şey yapmalıyım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765080114
					],
					"speakerTitle": "Nusta"
				}
			]
		},
		{
