			"dialogs": [
				{
					"id": 721310101,
					"content": "Bu garip şekilli taş fenerden uğursuz bir enerji yayılıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310102
					],
					"speakerTitle": "İncele"
				},
				{
					"id": 721310102,
					"content": "Bu... Bir taş fener mi? Burada niye taş fener var ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721310103,
					"content": "Birisi üzerine bir şeyler yazmış. Gidip bakalım mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721310104,
					"content": "\"İş arkadaşlarım, bu tılsımla alakalı herhangi bir sorunuz varsa lütfen Musoujin Geçidi'ne gidip Bay Kaji ile konuşun.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310105
					],
					"speakerTitle": "İncele"
				},
				{
					"id": 721310105,
					"content": "Yeni yazılmış gibi duruyor. Altında da ufak şekilde bir şeyler karalanmış:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310106
					],
					"speakerTitle": "İncele"
				},
				{
					"id": 721310106,
					"content": "\"Üzgünüm ama biz de yardımcı olamayacağız. Dün Heyet Başkanından burayı boşaltma emri aldık.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310107
					],
					"speakerTitle": "İncele"
				},
				{
					"id": 721310107,
					"content": "\"Umarım bir gün yollarımız yine kesişir ve Tatarigami sorunumuzu nasıl çözeceğimizi tartışırız.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310108
					],
					"speakerTitle": "İncele"
				},
				{
					"id": 721310108,
					"content": "Bu Bay Kaji bu taş fenerlere kafayı takmış galiba. Musoujin Geçidi'ne gidip soralım mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
