			"dialogs": [
				{
					"id": 727380101,
					"content": "Bu olur. Hızlı ve basit bir temizlik işi yalnızca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380102
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380102,
					"content": "Hah, tam vaktinde geldin ufaklık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380103,
						727380104
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380103,
					"content": "Neyin vaktinde?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380105
					]
				},
				{
					"id": 727380105,
					"content": "Bak şu haline. Aklından ne geçtiğini biliyorum. \"Eyvah, beni yine baş belası bir göreve gönderecek kesin, değil mi?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380106
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380106,
					"content": "Merak etme, tapınağın renovasyonunu bitirdiğimizi söyleyecektim. Yeni bir hizmet sunmaya hazırlanıyoruz ayrıca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380107
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380107,
					"content": "Henüz duyurma fırsatı bulamadım ama bak buradasın. İyi zamanlama sayılmaz mı bu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380108
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380108,
					"content": "Yanımdaki bağış kutusunu görüyor musun? Burada yakında dilek tutmak için başka bir yer daha olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380109
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380109,
					"content": "Fal kağıtlarınız yok muydu zaten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380110
					]
				},
				{
					"id": 727380110,
					"content": "O başka. Fal kağıtları insanlara fallarını söylemek için, oysa bu... Dilek tutmak için.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380111
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380111,
					"content": "Haydi o zaman. Gözlerini kapat, bir dilek tut, dileğini dua levhasına yaz ve sonra bu rafa as. Dileğin belki gerçek olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380112
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380112,
					"content": "İstediğimi dileyebilir miyim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380113
					]
				},
				{
					"id": 727380113,
					"content": "Tabii ki. Ancak hangi dileklerinin gerçekleşeceği... Bizi izleyen tanrılara kalmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380114
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380114,
					"content": "Aciz bir Guuji olduğum için yalnızca fanilerin meselelerinde yardımcı olabilirim sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380115,
						727380116
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380115,
					"content": "Yeni arkadaşlar edinmek isterdim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380117
					]
				},
				{
					"id": 727380117,
					"content": "Dilemek istediğin buysa hadi dene. İşte, al bu boş kağıdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380118
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380118,
					"content": "Fal kağıtları yazmaktan artakalan kağıt bu. Sende dursun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380119
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380119,
					"content": "Dileğini buna yaz. Gerçekleşme ihtimalini artırır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380120
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380120,
					"content": "Gerçekten mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380121
					]
				},
				{
					"id": 727380121,
					"content": "Sana hiç yalan söyledim mi ben? Hadi acele et ufaklık, dilek tutma vaktin geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380122
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380122,
					"content": "Dileğini kağıda yaz, sonra kağıdı dua levhasına yapıştır ve rafa as...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380123
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380123,
					"content": "Sonra dileğin tutulmuş olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380124
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380124,
					"content": "Evet. Gayet iyi ve ciddi. Çok güzel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380125
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380125,
					"content": "Bunun işe yarayacağından emin misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380126
					]
				},
				{
					"id": 727380126,
					"content": "Pekala ufaklık, artık işine dönebilirsin. Kulaklarını keskin, gözlerini açık tut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727380127
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380127,
					"content": "Sonuçta karşılaşmak istediğin kişi bir erişte tezgahında oturmuş güzel bir kase yiyor olabilir... Gitmişken bana da getir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 727380116,
					"content": "Eski arkadaşlarımla bir araya gelmek isterdim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380117
					]
				},
				{
					"id": 727380104,
					"content": "Bir dakika... Nereye gidiyor bu konuşma?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727380105
					]
				}
			]
		}
	]
}