				"points": []
			},
			"dialogs": [
				{
					"id": 715220101,
					"content": "Hahaha! Patlama da ne kelime, bu oyun sayesinde ilham çağlıyor resmen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220102
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220102,
					"content": "Hangi oyun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715220103
					]
				},
				{
					"id": 715220103,
					"content": "Gezgin! Tam zamanında geldin. Yeni oyunumu test edecek birini arıyordum ben de.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220104
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220104,
					"content": "Gel, bak. Oyunun adı \"İlham Patlaması.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220105
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220105,
					"content": "Biz şairlerin şiir yazma sürecinin tamamını harika bir şekilde tasvir ediyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220106,
						715220110
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220106,
					"content": "Daha çok sünger gibi içmeyi tasvir ediyor olmasın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715220107
					]
				},
				{
					"id": 715220109,
					"content": "Anlat da öğrenelim o zaman.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715220110
					]
				},
				{
					"id": 715220107,
					"content": "Hahaha, hiç güleceğim yoktu! İlham için şarap kullanmanın iyi fikir olduğu da doğru ya gerçi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220108
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220108,
					"content": "Ne var ki müstesna bir şairin ilhamla dolması için şarap yeterli değildir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220110
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220110,
					"content": "Bizler şiir yazmadan önce mutlaka bir ilham kaynağı peşine düşeriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220111
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220111,
					"content": "Bazıları seyahat eder, bazıları yalnız kalmayı yeğler... Bazıları da yaratıcılıklarını artırmak için kendini şaraba verir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220112
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220112,
					"content": "İlham denilen kavramın sağı solu belli olmaz ne de olsa. Onun yolunu gözlemek de en baş ağrıtan kısımdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220113
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220113,
					"content": "İşte o yüzden genelde ilham bizi terk etmiş gibi hissederiz, bu bataktan çıkamayınca da dertlenip bunalıma gireriz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220114
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220114,
					"content": "Halbuki aslında ilham çoktan çat kapı gelmiştir bile. Ruhumuz bile duymadan aklımızda izini bırakmıştır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220115
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220115,
					"content": "Sonra bu ilham doğru zamanda ortaya çıkıp harika bir şiirde, bir tabloda veya başka bir eserde vücut bulur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220116
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220116,
					"content": "Sen de bunları bir oyuna dönüştürebildin yani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715220117
					]
				},
				{
					"id": 715220117,
					"content": "Hahaha! Sanırım evet! Şiir yazma sürecini anlaması da anlatması da oldukça basit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220118
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220118,
					"content": "Şansıma Mondstadt'ta fikirlerimi ilginç bulan birkaç oyun tasarımcısı da var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220119
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220119,
					"content": "Azıcık tartışma, biraz da beyin fırtınası sonucunda \"İlham Patlaması\" adlı bir oyun hazırladık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220120
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220120,
					"content": "İstersen hemen deneyebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715220121
					],
					"speakerTitle": "Buies"
				},
				{
					"id": 715220121,
					"content": "Birkaç tur oyna bakalım. Bir bakmışsın, sen de şairliğin kitabını yazıyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Buies"
				}
			]
		}
	]
}