					"speakerTitle": "Albizzi",
					"speakerSubtitle": "Mavi Uzman"
				},
				{
					"id": 790640302,
					"content": "Bize sabahleyin bu konuda bir şey diyen olmadı. Gidin şimdi. Bizi rahat bırakın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640303
					],
					"speakerTitle": "Dev Muhafız"
				},
				{
					"id": 790640303,
					"content": "Dev muhafızlar hepinizi alır ve dışarı fırlatır.\\nKimse karşı koyamaz.",
