			"dialogs": [
				{
					"id": 790640301,
					"content": "Millet, ben geldim. Uzun zamandır beklediğimiz Marki ve yoldaşlarıyla birlikte klanımızın kayıp kökenlerini araştırdık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
