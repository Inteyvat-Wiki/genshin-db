			},
			"dialogs": [
				{
					"id": 790640801,
					"content": "Burası muhafızların karargahı. Durumu açıklayabilirsek eminim dev muhafız bize daha sıcak davranır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640802
					],
					"speakerTitle": "Albizzi",
					"speakerSubtitle": "Mavi Uzman"
				},
				{
					"id": 790640802,
					"content": "Merhaba...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790640803
					]
				},
				{
					"id": 790640803,
					"content": "Ne yapıyorsun? Ben arkadaşımın fotoğrafına bakıp eski günleri yad ediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640804
					],
					"speakerTitle": "Kapıyı Çal"
				},
				{
					"id": 790640804,
					"content": "Bu sesi tanıyorum. Winston mı o?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640805
					],
					"speakerTitle": "Albizzi",
					"speakerSubtitle": "Mavi Uzman"
				},
				{
					"id": 790640805,
					"content": "Hahaha, demek sürüne sürüne kapımı çaldınız... Demiştim ben, senin bu dünyadaki tek dostun benim. Tanımadığın etmediğin iki yabancıyla göreve gitmek de neymiş?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640806
					],
					"speakerTitle": "Kapıyı Çal"
				},
				{
					"id": 790640806,
					"content": "Ne kadar saftın. \"Aa, onlarla arkadaş olurum ben kesin!\" diyordun. Ama gel gör ki seni bekleyen bir ben varım. Senin tek dostun benim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640807
					],
					"speakerTitle": "Kapıyı Çal"
				},
				{
					"id": 790640807,
					"content": "#Hayır, doğru değil bu... Sadece o ikisiyle değil, Marki {NICKNAME} ve yoldaşıyla da arkadaş oldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640808
					],
					"speakerTitle": "Albizzi",
					"speakerSubtitle": "Mavi Uzman"
				},
				{
					"id": 790640808,
					"content": "... Arkamdan kendine başka arkadaşlar mı edindin? Vay be, bak sen şu Albizzi'ye, büyümüş de koca adam olmuş... Sınırı aştın işte şimdi. Çek git buradan! Bir daha yüzünü görmek istemiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640809
					],
					"speakerTitle": "Kapıyı Çal"
				},
				{
					"id": 790640809,
					"content": "Hayır, gitmiyorum. Şu acil durum tedbirlerini iki dakikalığına kaldırıp beni içeri alır mısın bir? Yanımda çok önemli birini getirdim, kutsal alanımızın gizemini çözmeye çok yakınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640810
					],
					"speakerTitle": "Albizzi",
					"speakerSubtitle": "Mavi Uzman"
				},
				{
					"id": 790640810,
					"content": "Çek git dedim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640811
					],
					"speakerTitle": "Kapıyı Çal"
				},
