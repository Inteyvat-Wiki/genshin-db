			"dialogs": [
				{
					"id": 790640601,
					"content": "Şüpheli bireyler tespit edildi! Hangi yasayı çiğnediniz bilemem fakat şu an en üst düzey alarm seviyesindeyiz. Bizimle gelin, teslim olun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790640602
					],
					"speakerTitle": "Dev Muhafız"
				},
				{
					"id": 790640602,
					"content": "Herkes dağılır. Cappet \"Herkes kendi başının çaresine baksın!\" diye bağırır.\\nMuhafızlar gittikten sonra aynı yerde tekrar toplanıyorsunuz. Yakalanan olmamıştır...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						790640603
					]
				},
				{
					"id": 790640603,
					"content": "Tekrar deneyelim mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dedektif"
				}
			]
		},
