			"dialogs": [
				{
					"id": 756720101,
					"content": "Bu kıpır kıpır minik Ashanın burada ne işi var? Ayrıca... Hı? Bennett?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756720102,
					"content": "#Aa, {NICKNAME} ve Paimon! Merhaba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720103
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756720103,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720104
					],
					"speakerTitle": "Renk Ustası Asha"
				},
				{
					"id": 756720104,
					"content": "Tatile mi geldin Bennett?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756720105,
					"content": "#Evet. {NICKNAME} hatırlar belki, size yazdığım mektupta haber vermiştim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720106
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756720106,
					"content": "Birkaç ay önce, iyi kazandıran görevlerden nihayet yeterince para biriktirebildim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720107
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756720107,
					"content": "Ve sonunda babalarımı ve arkadaşlarımı şöyle güzel bir kaçamak yapmak için Sefa Yeli Tatil Köyüne davet edebildim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720108
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756720108,
					"content": "Natlan'dayken neredeyse hiç şanssızlık yaşamadığımı gören babalarım sevinçten dört köşe oldular!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720109
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756720109,
					"content": "Böyle güzel bir haberi mutlaka herkesle paylaşmalısın Bennett!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720110,
						756720111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756720110,
					"content": "Harika bir haber bu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756720112
					]
				},
				{
					"id": 756720112,
					"content": "Ah be, keşke sizinle geçen hafta karşılaşsaydık. Hep birlikte yemeğe çıkabilirdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720113
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756720113,
					"content": "Hımm, siz tekrar Mondstadt'a gelene kadar yemek işini ertelememiz gerekecek anlaşılan. Geldiğinizde sota bir yer bulup birlikte \"Güvenli Mağara Macerası Yemeği\" yaparız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720114
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756720114,
					"content": "Bir dakika Bennett. Yani babalarınla arkadaşların gitti ve sen tek başına tatil köyünde mi kaldın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756720115,
					"content": "Evet. Babalarım burada çok iyi vakit geçiriyordu fakat sonra Kedi Kuyruğu'ndaki Bayan Diona'nın bir süreliğine iş seyahatine çıkacağını duydular...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720116
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756720116,
					"content": "Bu yüzden tatili uzatmak yerine planladıkları günde Mondstadt'a geri dönmeye karar verdiler. Böylece Bayan Diona seyahate çıkmadan önce onun özel içeceklerinden biraz içebilecekler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720117
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756720117,
					"content": "Merak etmeyin, geciktiğimden ya da gemi biletimi kaybettiğimden mahsur kalmadım. Birkaç arkadaşıma yardım etmek için kaldım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720118
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756720118,
					"content": "Deniz kenarında balık tutarken \"renk ustası\" olarak bilinen birkaç Ashaya rastladık. Başları dertte gibi görünüyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720119
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756720119,
					"content": "Önceki deneyimlerimden yola çıkarak olağanüstü bir hazine aradıklarını düşündüm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720120
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756720120,
					"content": "Hımm. Bu Ashalar renk ustası olarak bilindiğine göre aradıkları hazine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720121,
						756720122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756720121,
					"content": "Süper muhteşem bir boya olabilir mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756720123
					]
				},
				{
					"id": 756720123,
					"content": "Doğru! Ashalar gittikleri her yeri boyamanın dışında, kendi koleksiyonları için boyalar bulmaya da bayılırlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720124
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756720124,
					"content": "Renk ustası Ashalar gizli bir diyarda çok özel bir boya keşfetmişler... Serbest halde dolaşan bir boyaymış bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720125
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756720125,
					"content": "Tıpkı Kristal Kelebekler gibi bu renkler de her yerdeler ve sürekli hareket halindeler. Renk ustalarının onları nasıl yakalayabileceğine dair bir fikirleri yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720126
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756720126,
					"content": "Aa, aslında biz de yardım edebiliriz. Hadi gidip neler olduğuna bir bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756720127,
					"content": "Kim bilir, belki de daha önce benzer bir şeyler yaşamışızdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720128,
						756720129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756720128,
					"content": "Yardıma ihtiyacı olan bir Ashaya yardım etmek bizim için bir zevk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756720130
					]
				},
				{
					"id": 756720130,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720131
					],
					"speakerTitle": "Renk Ustası Asha"
				},
				{
					"id": 756720131,
					"content": "Harika! O zaman renk ustalarına birlikte yardım edelim. Siz yönlendirin beni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756720132
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756720132,
					"content": "Umarım Ashalar harika renkler bulur ve en parlak, en göz kamaştırıcı tonları yaratarak kendilerine özgü neşelerini yaymaya devam edebilirler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756720129,
					"content": "Koleksiyon için özel bir şeyler mi lazım? O zaman doğru adrestesin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756720130
					]
				},
				{
					"id": 756720122,
					"content": "Çok değerli bir boya olabilir mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756720123
					]
				},
				{
					"id": 756720111,
					"content": "Her duyduğumda daha da mutlu oluyorum!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756720112
					]
				}
			]
		}
	]
}