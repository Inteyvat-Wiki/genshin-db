				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200630101,
					"content": "*iç çeker* Bizzat kendim görebilmek için neler vermezdim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630102
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630102,
					"content": "Neyi görmek için?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630103
					]
				},
				{
					"id": 200630103,
					"content": "Ah, ne zamandır oradasın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630104
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630104,
					"content": "Dün Stanley sarhoş olduğunda bana <color=#00E1FFFF>Dadaupa Geçidi'ndeki</color> macerasını anlattı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630105
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630105,
					"content": "\"Canavar, biçimsiz bedeniyle bana doğru kıvrılarak gelirken cayır cayır yanıyordu. Çığlıklar atarak saldırdım ama canavar hiçbir şey yapmıyor gibiydi. Yalnızca gözleriyle bana aşağılayıcı bir bakış attı. O korkunç gözleriyle...\" Aynen böyle dedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630106
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630106,
					"content": "Tabii bunu kendi gözlerimle görmedim ama... Stanley bile dengini bulduğunu söylüyorsa efsanevi bir canavar olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630107
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630107,
					"content": "*iç çeker* Stanley'nin bile yenmekte zorlandığı bu yaratığı görmeyi çok istiyorum. Göz ucuyla bile olsa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630108
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630108,
					"content": "Kendimi biliyorum. Muhtemelen ağzımı burnumu kırarlar, ben de kaçarak uzaklaşırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630109
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630109,
					"content": "Benim yerime canavarı bulmaya ne dersin? Tabii ilgini çektiyse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630110,
						200630112
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630110,
					"content": "Tamam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630111
					]
				},
				{
					"id": 200630111,
					"content": "Harika! Sana güvenebileceğimi biliyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630112,
					"content": "Hadi beraber gidelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630113
					]
				},
				{
					"id": 200630113,
					"content": "Gitmeyi çok isterdim ama maalesef yapmam gereken o kadar çok iş var ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630114
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630114,
					"content": "\"Yapmam gereken iş\" diyorum ama maalesef Mondstadt Maceracılar Loncası için maceraya çıkmak yeterince para kazandırmıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630115
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630115,
					"content": "Ben de kasabadakiler için garip işler yapmaya başladım. Kayıp kedileri bulmaktan tut çim biçmeye kadar ne olursa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630116
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630116,
					"content": "Yani bu efsanevi maceranın Stanley'yi korkutan kısmı tamamen sende. Geri döndüğünde canavarla ilgili her şeyi bana anlat. Hepsini duymak istiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
		{
			"id": 2006302,
			"completionStepIds": [
				2006301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
