				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200630201,
					"content": "*iç çeker* Acaba ne zaman efsanevi bir Maceracı olacağım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630202
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630202,
					"content": "Sorun ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630203
					]
				},
				{
					"id": 200630203,
					"content": "Ah, merhaba... Dün Cyrus bana <color=#00E1FFFF>Fırtınakesen Dağları'ndaki</color> eski bir macerasını anlattı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630204
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630204,
					"content": "\"Devasa kalkanı bir kabustan fırlamış gibiydi, kılıcımı ne kadar sert savurursam savurayım yerinden kımıldamadı bile. Bu sırada canavar kalkanın arkasından benimle alay edercesine gülümserken gözleriyle bana aşağılayıcı bir bakış attı. O korkunç gözleriyle...\" Aynen böyle dedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630205
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630205,
					"content": "Hiçbir saldırıdan etkilenmeyen Ahşap Kalkan... Bunu kendi gözlerimle görmek için neler vermezdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630206
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630206,
					"content": "Ancak yarıda bırakamayacağım tonlarca işim var. Ne tür korkunç bir canavar, Stanley'nin anlattığı gibi bir kalkana sahip olabilir, hayal bile edemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630207
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630207,
					"content": "Şey... İlgini çektiyse canavarı benim yerime bulmaya ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630208,
						200630210
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630208,
					"content": "Elbette.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630209
					]
				},
				{
					"id": 200630209,
					"content": "Şahane! Çok teşekkür ederim. Geri döndüğünde gördüklerini en ince ayrıntısına kadar duymak istiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630210,
					"content": "Hadi beraber gidelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630211
					]
				},
				{
					"id": 200630211,
					"content": "Benim de mi gelmemi istiyorsun? Üzgünüm ama gelemem. Maceracılar Loncasında beni bekleyen bir sürü garip iş var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630212
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630212,
					"content": "Bugünlerde maceralar çok kazandırmıyor. Bu işleri Maceracılar Loncası aracılığıyla alsam da gerçekte insanların getir götür işlerini yapıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630213
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630213,
					"content": "Draff için birkaç domuz gütmem, Margaret'ın kedisini bulmam, Flora için taze çiçek toplamam lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630214
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630214,
					"content": "Loncaya katıldığımda böyle maceralara atılmayı hayal etmemiştim ama... Ha ha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
		{
			"id": 2006303,
