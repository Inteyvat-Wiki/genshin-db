				"points": []
			},
			"dialogs": [
				{
					"id": 200630601,
					"content": "\"Canavar, biçimsiz bedeniyle bana doğru kıvrılarak gelirken cayır cayır yanıyordu. Çığlıklar atarak saldırdım ama canavar hiçbir şey yapmıyor gibiydi. Yalnızca gözleriyle bana aşağılayıcı bir bakış attı. O korkunç gözleriyle...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630602
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630602,
					"content": "Stanley canavarı böyle anlattı. Sözde canavarın bedenindeki ateşleri söndürerek onu anca yenebilmiş, bu sırada da kendi gücünü son damlasına kadar harcamış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630603
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630603,
					"content": "Ancak ne zaman, nasıl yaptığını sorsam beni geçiştiriyor. Acaba Stanley'nin gizli bir gücü filan mı var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
