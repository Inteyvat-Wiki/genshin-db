				"points": []
			},
			"dialogs": [
				{
					"id": 200630801,
					"content": "\"Devasa kalkanı bir kabustan fırlamış gibiydi, kılıcımı ne kadar sert savurursam savurayım yerinden kımıldamadı bile. Bu sırada canavar kalkanın arkasından benimle alay edercesine gülümserken gözleriyle bana aşağılayıcı bir bakış attı. O korkunç gözleriyle...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630802
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630802,
					"content": "Cyrus'un bana anlattığı bunlar. Çok iyi hatırlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630803
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630803,
					"content": "Ayrıca canavarı yenmenin anahtarı, önce kalkanına odaklanıp onu hızlıca yok etmenin akıllıca bir yolunu bulmakmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630804
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630804,
					"content": "Yoksa kalkanını kaldırdığı anda ne kadar iyi kılıç kullanırsan kullan canavara vurmak imkansızmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630805
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630805,
					"content": "Cyrus'un son dediğine göre de bu canavar saldırmak için en doğru anı beklermiş. Bir anlığına bile gardını indirirsen acımasız bir şekilde saldırırmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630806
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630806,
					"content": "İşte böyle bir canavarı alt edebildiği için Cyrus, Maceracılar arasında efsanedir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630807
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630807,
					"content": "*iç çeker* Umarım ben de bir gün bu seviyeye erişirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
