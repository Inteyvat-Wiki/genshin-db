					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 200631202,
					"content": "Ama... Ah, dönmüşsünüz! Nasıldı? Canavarı bulabildiniz mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631203
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631203,
					"content": "Evet ama...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200631204
					]
				},
				{
					"id": 200631204,
					"content": "Bir Ateş Bodurlopu... Cidden mi? İmkansız. Stanley bana böyle anlatmadı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631205
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631205,
					"content": "Neyse ki kendisi tam da burada! Hadi Stanley, maceranı onlara da anlat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631206
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631206,
					"content": "Anlatmıştın ya, şu cayır cayır yanan canavarlı olanı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631207
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631207,
					"content": "Ah, şey... O, evet, evet... O gün... Şey... Çok sarhoştum ve... Yani, tam hatırlayamıyorum ve...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631208
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 200631208,
					"content": "Hiç sorun değil dostum! Anlattığın her şeyi harfiyen hatırlıyorum. Hatta bak, kelimesi kelimesine buraya yazdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631209
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631209,
					"content": "Vay be... Ah Jack, aklına ne geldi? Sana başka bir hikaye anlatacaktım, unutmuşum! Çok eskiden ben daha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Stanley"
