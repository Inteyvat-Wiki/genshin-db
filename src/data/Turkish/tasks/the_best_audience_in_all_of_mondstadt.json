					"nextDialogs": [
						200631405
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631405,
					"content": "Yanlış yere gitmediğine eminsin, değil mi? Hey Stanley, bu konuda ne diyorsun?",
