			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200630301,
					"content": "Şöyle sürükleyici bir maceraya atılmak istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630302
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630302,
					"content": "Sorun ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630303
					]
				},
				{
					"id": 200630303,
					"content": "Dün Stanley bana başka bir hikaye anlattı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630304
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630304,
					"content": "Bu sefer normalden daha sarhoştu, yani anlamak biraz zordu. Anlayabildiğim kadarıyla <color=#00E1FFFF>Şafak Şaraphanesi'nin</color> yakınlarında geçmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630305
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630305,
					"content": "\"Canavarın bedeninde onu daha büyük, daha korkunç gösteren uğursuz buz kristalleri vardı. Telaş içinde kılıcımı bir sağa bir sola savururken korkudan buz kesilmiştim. Birkaç buz parçasını yerinden sökmeyi başarmıştım ama nedense gözlerimi bu parlak buz parçalarından alamamıştım.\" Sarhoş kafayla anlattığı hikayeden ilgimi bunlar çekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630306
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630306,
					"content": "Stanley'ye bile dengini bulduğunu düşündürtecek canavarın nasıl bir şey olduğunu düşünmeden edemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630307
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630307,
					"content": "Keşke gidip kendi gözlerimle görebilsem... Canavarı görür görmez can havliyle kaçardım muhtemelen, kendimi biliyorum çünkü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630308
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630308,
					"content": "Ama seni tanıyorum, bir sorun yaşamazsın. Benim için gidip bir göz atmaya ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630309,
						200630311
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630309,
					"content": "Tamam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630310
					]
				},
				{
					"id": 200630310,
					"content": "Harika! Bulduğunda geri dön ve bana her şeyi anlat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630311,
					"content": "Hadi beraber gidelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630312
					]
				},
				{
					"id": 200630312,
					"content": "Gelmeyi çok isterdim ama Maceracılar Loncasında olup bitenler yüzünden... Nasıldır bilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630313
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630313,
					"content": "Cyrus emekli olacak sanırım, Pınarköy'de bir yere yerleşmek istediğini söylüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630314
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630314,
					"content": "Herman, kızı doğduğundan beri bir kez olsun şehir dışına çıkmadı. Ne büyük kayıp. Herman şüphesiz en iyi Maceracımızdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630315
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630315,
					"content": "Stanley'nin de izni uzatıldı, uzun zamandır maceralara çıkmıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630316
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200630316,
					"content": "Lonca, giderlerini karşılayabilmek için insanlardan garip işler almaya başladı ancak bu işleri yapacak insan bulmakta zorlanıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630317
					],
					"speakerTitle": "Jack"
				},
				{
