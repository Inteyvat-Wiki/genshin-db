					"nextDialogs": [
						200631406
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631406,
					"content": "*öksürür* *öksürür* Bak aklıma ne geldi? Sana daha önce hiç anlatmadığım bir hikaye vardı. Jack, bunu duymak isteyeceğine eminim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631407
					],
					"speakerTitle": "Stanley"
				},
				{
