			"dialogs": [
				{
					"id": 200631001,
					"content": "\"Canavarın bedeninde onu daha büyük, daha korkunç gösteren uğursuz buz kristalleri vardı. Telaş içinde kılıcımı bir sağa bir sola savururken korkudan buz kesilmiştim. Birkaç buz parçasını yerinden sökmeyi başarmıştım ama nedense gözlerimi bu parlak buz parçalarından alamamıştım.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631002
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631002,
					"content": "Stanley'nin bana anlattıkları kabaca bu şekilde. Daha önce dediğim gibi, bana bunları anlattığı sırada kör kütük sarhoştu ve laf kalabalığı yapıyordu. Ayıldıktan sonra hikayeyi anlatmaya devam etti. Gel gör ki o kısmı pek iyi hatırlamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631003
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631003,
					"content": "Prensipte bir Ateş canavarını alt etmek istiyorsan Buz kullanırsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200631004
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200631004,
					"content": "Tabii söylemesi kolay. Bu büyüklükteki Ateş gücüne karşı ne kadar Buz kullanman gerektiğini söylemek zor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
