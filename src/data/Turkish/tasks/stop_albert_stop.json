			"dialogs": [
				{
					"id": 200421001,
					"content": "Ben mi etrafta sinsice dolaşıp şüpheli davranıyor ve kötücül planlar mı yapıyorum? Siz olayı tamamen yanlış anlamışsınız!",
					"roleType": "TALK_ROLE_NPC",
