					"nextDialogs": [
						200420705
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420705,
					"content": "Neyse boş ver. Yaprak olmaması, gelecekte Albert'ın Katedral etrafında dolaşmak için bahane bulamaması demek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420706
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420706,
					"content": "Bu hediyeler sana teşekkür etmek için. Rüzgar Hükümdarı seni korusun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420707
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200420707,
					"content": "Başka bir şey yoksa işe döneyim. Senin de işe dönmen gerekiyordur.",
