			"dialogs": [
				{
					"id": 718030401,
					"content": "Taş Sırtlı Dağ Reisini yendin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030402,
						718030404
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 718030402,
					"content": "Tabii ki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030403
					]
				},
				{
					"id": 718030403,
					"content": "Teşekkürler, bize büyük bir iyilik yaptın. Bu görevi bizim tamamladığımızı duyanlar Loncamızın becerisinden şüphe edemeyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lahn"
				},
				{
					"id": 718030404,
					"content": "Evet, hatta Ash'i de bulduk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030405
					]
				},
				{
					"id": 718030405,
					"content": "Teşekkürler, bize büyük bir iyilik... Bir dakika, ne dedin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lahn"
				}
			]
		},
