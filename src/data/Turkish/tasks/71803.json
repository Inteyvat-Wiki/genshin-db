			"dialogs": [
				{
					"id": 718030301,
					"content": "Miyav...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030302
					],
					"speakerTitle": "Ash"
				},
				{
					"id": 718030302,
					"content": "Ha? Burada kedinin ne işi var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030303,
					"content": "Miyav... Miyaaav...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030304,
						718030308
					],
					"speakerTitle": "Ash"
				},
				{
					"id": 718030304,
					"content": "Gri bir kedi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030305
					]
				},
				{
					"id": 718030305,
					"content": "Doğada kaybolmuş gri bir kedi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030306,
					"content": "Aa, Lahn kayıp gri kedi görevinden bahsetmişti. Belki de bu o kedidir! Paimon, adının Ash ya da onun gibi bir şey olduğunu hatırlıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030307,
					"content": "Onu burada bulacağımızı kim düşünebilirdi? Bunca zamandır buralarda mı saklanıyormuş?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030311,
					"content": "Taş Sırtlı Dağ Reisi yüzünden kimse bu civarda aramamış kediyi sanırım. Kedi de kaçmaya korktuğu için burada saklanmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030312,
					"content": "Neyse ki imdadına yetiştik, yoksa kim bilir daha ne kadar bekleyecekti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030313,
					"content": "Miyav... Miyav, miyav!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030314,
						718030317
					],
					"speakerTitle": "Ash"
				},
				{
					"id": 718030314,
					"content": "Miyav... Miyaaav...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030315
					]
				},
				{
					"id": 718030315,
					"content": "Hey, ne yapıyorsun? Paimon zaten ne dediğini anlamıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030316,
					"content": "Kediyi Lahn'a götürelim, o da görevi veren kişiye götürsün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030319,
					"content": "Miyav... Miyav! Miyav!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030320,
						718030322
					],
					"speakerTitle": "Ash"
				},
				{
					"id": 718030320,
					"content": "Miyav... Miyav! Miyav!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030321
					]
				},
				{
					"id": 718030321,
					"content": "Of, yapma! Aynı sesi ne kadar çıkarmaya çalışırsan çalış seni anlamayacak. Hadi onu alıp götürelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030322,
					"content": "O da bizimle aynı fikirde sanırım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030323
					]
				},
				{
					"id": 718030323,
					"content": "Ne dediğini nasıl... Neyse, boş ver. Hadi onu Lahn'a geri götürelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030317,
					"content": "Kediyi Lahn'a götürelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030318
					]
				},
				{
					"id": 718030318,
					"content": "Evet, sanırım şu anda yapabileceğimiz tek şey bu. O da görevi veren kişiye götürür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030308,
					"content": "Belki bu kedi Ash'tir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030309
					]
				},
				{
					"id": 718030309,
					"content": "Doğada kaybolmuş gri bir kedi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718030310,
					"content": "Haklısın! Lahn o görevden bahsetmişti, değil mi? Vay be. O kediyi burada bulacağımız kimin aklına gelirdi? Bunca zamandır buralarda mı saklanıyormuş?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030311
					],
					"speakerTitle": "Paimon"
				}
			]
		},
