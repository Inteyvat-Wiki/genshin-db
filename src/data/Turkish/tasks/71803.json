						718030502
					],
					"speakerTitle": "Ash"
				},
				{
					"id": 718030502,
					"content": "Bu kedi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030503
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 718030503,
					"content": "Ash olabilir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030504
					]
				},
				{
					"id": 718030504,
					"content": "Bana bir dakika verin, görev ilanında yazan özelliklerle bir karşılaştırayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030505
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 718030505,
					"content": "Bir bakalım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030506
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 718030506,
					"content": "Çoğuna uyuyor. Aradığımız kedi bu sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030508
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 718030508,
					"content": "Görevi veren kişi çok mutlu olacak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030509
					]
				},
				{
					"id": 718030509,
					"content": "Komik. Döndük dolaştık, yine kayıp kedi aramaya döndük.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030510
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 718030510,
					"content": "Ne desem bilemiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030511
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 718030511,
					"content": "Görevi verenlere ulaşıp verdikleri görevlerin tamamlandığını söyleyeceğim. Çok teşekkür ederim. Yardımlarının karşılığı olarak bunu kabul et lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030512
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 718030512,
					"content": "Hımm, kayıp kedi görevini veren kişi taşınmış. Kendisine ulaşmak biraz zaman alacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030513
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 718030513,
					"content": "O zamana kadar bu kerataya ben bakacağım sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030514
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 718030514,
					"content": "Miyav miyav miyav!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ash"
				}
			]
		}
