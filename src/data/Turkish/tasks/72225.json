			"dialogs": [
				{
					"id": 722250201,
					"content": "Lütfen Tüneğe hediye sunma konusunda bize yardım edin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250202
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250202,
					"content": "Ben Ku Abim ile burada kalacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruu"
				}
			]
		},
		{
			"id": 7222503,
			"completionStepIds": [
				7222505
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
