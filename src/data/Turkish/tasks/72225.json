					"Ruu",
					"Ku"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722250301,
					"content": "Vay, Tüneğe bak parlamaya başladı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250302
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250302,
					"content": "Sanırım hallettiniz. Özür dilerim, sizi zorlamış olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250303
					],
					"speakerTitle": "Ku"
				},
				{
					"id": 722250303,
					"content": "Hehe! Biz problem çözme uzmanlarıyız bilmiyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250304,
					"content": "Aslında Işık Seremonisinden çok farklı değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250305
					]
				},
				{
					"id": 722250305,
					"content": "Büyük bir sorunu çözmek için üç farklı noktada üç farklı küçük sorunu çözmeye gidiyoruz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250306,
					"content": "Bu başımıza sürekli geliyormuş gibi hissediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250307,
					"content": "Söylediklerini çok anlamadım ama büyüklerin bir sözü vardır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250308
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250308,
					"content": "Buna \"Üç Kuralı\" diyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250309
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250309,
					"content": "O ne demek?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250310,
					"content": "Sanırım sonuç alabilmek için bir şeyi üç kere yapman gerektiği anlamına geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250311
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250311,
					"content": "Örneğin \"talihinin iyiye dönmesi için üç iyiye işaret görmen gerekir\" derler... Aynısı iyiye olmayan işaretler için de geçerli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250312
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250312,
					"content": "Ayrıca \"dördüncüde başarılı olmak için geçmiş engelleri üç kez geçmen gerekir\" de derler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250313
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250313,
					"content": "O zaman adının \"Dört Kuralı\" olması gerekmiyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250314,
					"content": "Hımm, doğru! Sayılarla aran gerçekten iyi Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250315
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250315,
					"content": "Hehe, ne sandın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250316,
						722250318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250316,
					"content": "Konu nasıl buraya geldi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250317
					]
				},
				{
					"id": 722250317,
					"content": "Neyse, Ku'nun iyi olacağına emin misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722250319,
					"content": "Merak etmeyin, o her zaman böyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250320
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250320,
					"content": "Üf, rezil oldum... Umarım seremoniyi etkilemez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250321
					],
					"speakerTitle": "Ku"
				},
				{
					"id": 722250321,
					"content": "Etkilerse Ruu, senin yüzüne bakamam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250322
					],
					"speakerTitle": "Ku"
				},
				{
					"id": 722250322,
					"content": "Hey, böyle yapma! Sen bana hep nazik davrandın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250323
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250323,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250324
					],
					"speakerTitle": "Ku"
				},
				{
					"id": 722250324,
					"content": "#{NICKNAME}, Paimon, siz önden gidin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722250325
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250325,
					"content": "Ben Ku Abim ile burada kalacağım. Adak adamayı bitirdiğinizde ortalığı biz toparlarız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722250318,
					"content": "Bu arada Ku nasıl oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722250319
					]
				}
			]
		},
