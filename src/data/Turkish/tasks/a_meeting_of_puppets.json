			"dialogs": [
				{
					"id": 733560201,
					"content": "Herkesin yürüyeceği kendi yolu var. Fazla söze gerek yok. Bu arada çay da pek güzelmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560202,
						733560203
					],
					"speakerTitle": "Şapkalı Adam"
				},
				{
					"id": 733560202,
					"content": "(Biraz daha oturalım.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560204
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 733560204,
					"content": "Pekala, görüşürüz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Şapkalı Adam"
				},
				{
					"id": 733560203,
					"content": "Yavaş yavaş toparlansam iyi olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560204
					],
					"speakerTitle": "Kukla"
				}
			]
		}
	]
