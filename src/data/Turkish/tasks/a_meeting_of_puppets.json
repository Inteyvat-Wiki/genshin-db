			"dialogs": [
				{
					"id": 733560101,
					"content": "Gerçekten de inanması zor. Seninle burada oturup çay içeceğimiz aklımın ucundan bile geçmezdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560102
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560102,
					"content": "Çok mu garibine gitti? Sadece numerolojik dizilime sağladığın çekirdek işlem birimi için sana bir teşekkür edeyim demiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560103
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 733560103,
					"content": "Peki neden sürekli içimizi dışımızı biliyormuş gibi konuşup duruyorsun? Bize bayağı aşina gibisin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560104
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 733560104,
					"content": "Daha önce de dediğim gibi, iyi bir insan sarrafıyımdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560105
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560105,
					"content": "Yine de... Haha, doğru diyorsun. Sizi çözdüğümü sanmaktan vazgeçsem iyi olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560106
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560106,
					"content": "Ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560107
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 733560107,
					"content": "Son görüşmemizden bu yana bile epey değişmişsin gibi geliyor bana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560108
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560108,
					"content": "Hıh! İstediğin kadar eskiye gidip \"karşılaştır\", hiç fark etmez. Bende değişen tek şey, çekirdeğimdeki hataları kabullenip nihayet bazı gerçeklere gözlerimi açmış olmam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560109
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 733560109,
					"content": "Peki ya sen? Ne de olsa sen de benim gibi bir tür \"kukla\"sın, senin de kalbinde hiç hesaplama hataları oluyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560110
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 733560110,
					"content": "Hah... Sadece hatalardan çok daha fazlasını yaşıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560111
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560111,
					"content": "Anlat bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560112
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 733560112,
					"content": "Bunun için birbirimizi henüz yeterince iyi tanıdığımızı sanmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560113
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560113,
					"content": "Heh, sen bilirsin. Sadece nezaketen sormuştum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560114
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 733560114,
					"content": "Her halükarda bir kuklanın kalbini bulana dek uzun ve dolambaçlı yollardan geçmesi gerekir. En azından benim için öyleydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560115
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 733560115,
					"content": "Yaratıcınla aranız iyiymiş anlaşılan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560116
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560116,
					"content": "Evet, öyleydi. Bana hem hayattayken... Hem de sonrasında çok yardımcı oldu ve yol gösterdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560117
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 733560117,
					"content": "Bu konuda ikimiz çok farklıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560118
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560118,
					"content": "... Ah. Öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560119
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 733560119,
					"content": "Özür dilerim. İki kukla olarak bazı benzerliklerimiz olsa da sadece buna dayanarak senin hakkında bir şeyler bildiğimi varsaymamalıydım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560120
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 733560120,
					"content": "Sorun yok. Senin deyişinle, ben de geçmişteki hatalarımı kabullendim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560121
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560121,
					"content": "Sadece şimdiden çok fazla dolambaca takıldım. Bunları telafi etmek için çok daha uzun bir yol katetmem gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560122
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 733560122,
					"content": "O halde... Yolun açık olsun. Ben de senin deyişinle cevap verecek olursam, henüz tavsiye verebilecek kadar iyi tanımıyoruz birbirimizi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733560123
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 733560123,
					"content": "Haha... İyi dedin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				}
			]
		},
