			"dialogs": [
				{
					"id": 721160401,
					"content": "Çok teşekkür ederim! Cihazımızın temel yapısını bunlar oluşturacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160402
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160402,
					"content": "Şimdi yapmamız gereken tek şey işaretçilerin yeterli veri toplamasını beklemek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160403
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160403,
					"content": "Veriyi topladığımızda bu veriye göre cihazda birkaç değişiklik yapacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721160404
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721160404,
					"content": "Her şey hazır olduğunda artık buna bir son verelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
