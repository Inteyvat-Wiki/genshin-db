			"dialogs": [
				{
					"id": 731930901,
					"content": "Doğa gücünü kullanabiliyor musun yani? Önsezin var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930902
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930902,
					"content": "Uzun zamandır senin gibi biriyle karşılaşmamıştım. Geçmişe dönmüş gibi oldum adeta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930903
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930903,
					"content": "Şimdi olmuştur değil mi Sabbah Hanım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731930904,
					"content": "Evet, Doğa gücünü aldılarsa yakında filizlenirler. Biraz bekleyelim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930905
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930905,
					"content": "Yavaş yavaş topraktan filizler çıkmaya başlar.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						731930906
					]
				},
				{
					"id": 731930906,
					"content": "Birkaç yaprak çıktıktan sonra büyümeleri durur.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						731930907
					]
				},
				{
					"id": 731930907,
					"content": "#Filizleniyorlar! Paimon bunu yapabileceğini biliyordu {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731930908,
					"content": "Tahmin ettiğim gibi hemen sonuç aldık... Teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930909
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930909,
					"content": "Keşke çiçek de açsalardı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930910
					]
				},
				{
					"id": 731930910,
					"content": "Ah, açmamaları gayet normal. Bu işler aceleye gelmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930911
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930911,
					"content": "Bitkilerin büyümenin tüm evrelerinden geçmesi gerekir. Onları şimdiden filizlendirebilmen bile harika.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930912
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930912,
					"content": "Biraz bekleyelim de güller besinleri özümsesin. Onlar için de daha iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930913
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930913,
					"content": "Gerçekten çok teşekkür ederim. Size daha fazla zahmet vermek istemem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930914
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930914,
					"content": "Boş zamanınızda uğrayıp gülleri görün yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				}
			]
		}
	]
