			"dialogs": [
				{
					"id": 240100301,
					"content": "Somut formlarla sınırlı kalmamak lazım... Güzelliği ortaya çıkarmamız ve bazı sembolik yöntemler de kullanmamız gerekiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100302
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100302,
					"content": "Hayır, hayır... Olmuyor. Kompozisyon çok kasti yapılmış duruyor...",
					"roleType": "TALK_ROLE_NPC",
