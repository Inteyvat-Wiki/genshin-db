			"dialogs": [
				{
					"id": 240100501,
					"content": "Teşekkür ederim! Bu boyalar bana bir süre yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100502
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100502,
					"content": "Sakın hepsini suya dökme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100503
					]
				},
				{
					"id": 240100503,
					"content": "Suya mı? Hahaha. Sanırım resim tekniğim tam da sizin tarif ettiğiniz gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100504
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100504,
					"content": "Ancak yalnızca boyayı doğrudan tuvalin üzerine sıkıp oyma bıçağı ve palet spatulası yardımıyla dağıtınca istediğim o etkileyici dokunuşu yapabiliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100505
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100505,
					"content": "Yardımınız için teşekkürler. Bu boyalarla devam edebilirim şimdi. Zamanınız olunca gelip bir bakın, olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100506
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100506,
					"content": "Sonuçta eserime güzel bir şekilde başlayabilmem sizin sayenizde oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100507
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100507,
					"content": "Bu tablo bittiğinde onu ilk gören kişi siz olun isterim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				}
			]
