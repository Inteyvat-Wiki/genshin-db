				"points": []
			},
			"dialogs": [
				{
					"id": 240100101,
					"content": "Bu iyi bir fikir... Ama cidden bu şekilde yapılabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100102
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100102,
					"content": "Çizimin nasıl gidiyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100103
					]
				},
				{
					"id": 240100103,
					"content": "Ah, siz mi geldiniz? Fotoğraf konusundaki yardımınız için teşekkürler! Manzaralar gerçekten ilham vericiydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100104
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100104,
					"content": "Kafamda aşağı yukarı bir fikir oluştu, birkaç taslak da çizdim ama... Beklediğim gibi olmadılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100105
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100105,
					"content": "Yanlış anlamayın, hiçbir estetik değeri olmayan resimler yaptığımı söylemiyorum ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100106
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100106,
					"content": "Ama sanki özel bir şeyler eksik, sıradanlığı ortadan kaldırabilecek bir şeyler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100107
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100107,
					"content": "Ancak... Aklımdaki şeyler çok net. Onları bu şekilde resme dökmeyi denersem istediğim güzellikten ödün vermiş olacağım kesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100108
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100108,
					"content": "*iç çeker* Korkarım bu her sanatçının yüzleşmesi gereken bir sorun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100109,
						240100119
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100109,
					"content": "Belki başka bir şeyler çizmeyi deneyebilirsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100110
					]
				},
				{
					"id": 240100110,
					"content": "Tavsiyeniz için teşekkürler ancak korkarım bu sorun birkaç değişiklikle çözülmeyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100111
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100111,
					"content": "Dağlar ya da nehirler, kuşlar ya da böcekler, hatta insanlık da olsa... Bu sorun hiç değişmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100112
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100112,
					"content": "Bazı meslektaşlarım bu soruna çözüm ararken bu manzaraları kendi hissiyatlarına göre ayırıp değiştirdiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100113
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100113,
					"content": "Bu tarz resimlerde en çok sanatçının dışa vurmak istediği hisleri vardır ve tuvallerinde... Nasıl anlatsam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100114
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100114,
					"content": "Bu ister manzara resmi, ister bir portre olsun... Işık bile hiçbir geleneksel anlayışta bulunmayan bir tuhaflık taşır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100115
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100115,
					"content": "Bu tarz resimlere ilk bakıldığında resmi yapan kişinin resimden hiç anlamayan, hatta deli biri olduğu düşünülebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100116
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100116,
					"content": "Ancak bir sakinleşip resmi anlamaya çalıştığınızda adeta sanatçının adını haykırdığını görürsünüz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100117
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100117,
					"content": "Bu haykırış, duygularını yüksek sesle anlatan sanatçıların yüreklerinden ve ruhlarından gelir... Ve bu duygular hep çok yoğundur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100118
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100118,
					"content": "Ancak onların bu haykırışları kulaklarla duyulmaz, yürekten hissedilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100124
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100124,
					"content": "Bana gelince... Somut anlatımdan vazgeçmek istemiyorum ve bu yüzden başka bir yöntem buldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100125
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100125,
					"content": "Renklere odaklanmaya karar verdim. Yani, daha sert gölgeler bulup basit ama güçlü vuruşlar yapmam gerekiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100126
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100126,
					"content": "Aynı zamanda ışığı ve geleneksel manzara betimlemelerini azaltmam lazım... Bu şeyler benim anlatımımı etkileyeceği için bir süreliğine tuvalimden uzaklaşmalarını istemem gerekiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100127
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100127,
					"content": "Ancak bu güçlü ve yoğun renk dokunuşları için fazlaca boya kullanmam gerekiyor. İstediğim etkiye ulaşmak için boyayı doğrudan tuvale sıkmalıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100128
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100128,
					"content": "Yani şey... Ah, boyam bitti. Ancak şu anda şövalemi alıp götüremem. Bu çalışmamı etkiler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100129
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100129,
					"content": "Gezgin, sizden Boucicaut'u ziyaret etmenizi rica etsem? Ondan iyi boyalar sipariş etmiştim, şimdiye hazırlamış olması lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100130
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100130,
					"content": "Ya da belki... Biraz Yalancı Çiçek Nektarı toplama konusunda bana yardımcı olabilir misiniz? Bu sayede kendim biraz boya yapabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100131,
						240100134
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100131,
					"content": "Nektar kullanarak boya yapılabiliyor mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100132
					]
				},
				{
					"id": 240100132,
					"content": "Hahaha, tabii ki. Bazı sanatçı arkadaşlarım bunun için Kuş Yumurtası bile kullanır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100133
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100133,
					"content": "Bu tür boyaların narin ancak zengin renk katmanları olduğunu ve göz alıcı manzaraları betimlerken kullanmak için mükemmel olduklarını duymuştum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100136
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100136,
					"content": "Siz iyi bir insansınız, değil mi? Bir sanatçının çaresiz isteklerini geri çevirebilir misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100137,
						240100138
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100137,
					"content": "Pekala, tamam...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100139
					]
				},
				{
					"id": 240100139,
					"content": "Pekala, çok teşekkür ederim! Ben burada bekliyorum. Onları alır almaz buraya getirin lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100138,
					"content": "Gerçekten çaresizsin... Tamam, bu iş bende.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100139
					]
				},
				{
					"id": 240100134,
					"content": "Kendin boya yapabiliyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100135
					]
				},
				{
					"id": 240100135,
					"content": "Hahaha, tabii ki! Bir ressam olarak öğrenmen gereken ilk şey budur. Ortaya çıkardığın resimdeki kontrolü bu sayede elinde tutabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100136
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100119,
					"content": "Farklı bir resim tarzı denesen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100120
					]
				},
				{
					"id": 240100120,
					"content": "Doğru. Bazı meslektaşlarım da böyle düşünerek daha soyut işler ortaya koymak amacıyla \"betimsel\" anlatıma yöneldiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100121
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100121,
					"content": "Hatta bazı radikaller nesneleri somut olarak betimlemekten tamamen vazgeçip sadece boya vuruşları kullanarak kendilerini ifade etmek istiyorlar... Kendilerine \"neobetimleyiciler\" diyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100122
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100122,
					"content": "Ancak ben bile eserlerini tam olarak anlayabildiğimi söylemem. En fazla renklerdeki ve çizgilerdeki ritmik güzelliği hissedebiliyorum, o kadar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100123
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240100123,
					"content": "Resimde tam olarak ne anlatılmaya çalışıldığına gelince... Bunu ancak ressamdan açıklamasını isteyebiliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100124
					],
					"speakerTitle": "Depierris"
				}
			]
		},
		{
			"id": 2401002,
			"completionStepIds": [
				2401002
