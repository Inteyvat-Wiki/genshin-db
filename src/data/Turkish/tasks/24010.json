					"Boucicaut"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240100201,
					"content": "Merhaba. Ne almak istersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100202
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 240100202,
					"content": "Depierris'nin boyaları için gelmiştim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100203
					]
				},
				{
					"id": 240100203,
					"content": "Ah, onun boyalarını almaya mı geldin? İşte buradalar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100204
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 240100204,
					"content": "Bunları gerçekten çok çabuk tüketiyor. Sanki bunları alır almaz direkt suya döküyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100205
					],
					"speakerTitle": "Boucicaut"
				},
				{
					"id": 240100205,
					"content": "Neyse, buyur. Bunları ona götür lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Boucicaut"
				}
			]
		},
