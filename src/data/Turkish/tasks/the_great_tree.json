			},
			"dialogs": [
				{
					"id": 230270101,
					"content": "Sanırım gerçekten iyi bir bakıma ihtiyacı var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270102
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270102,
					"content": "Ne yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270103
					]
				},
				{
					"id": 230270103,
					"content": "Sen... Hımm. Görünüşüne bakılırsa bir gezginsin, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270104
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270104,
					"content": "Ben Yasmin. Amurta öğrencisiyim. Kutsal Ağacı araştırmak için buradayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270105
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270105,
					"content": "Bu Kutsal Ağaç, Ormos Limanı'nda pişmiş tüm pilavlardaki pirinç tanelerinin toplam sayısından daha fazla senedir yaşıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270106
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270106,
					"content": "Akademiyi ayakta tutan da bu Kutsal Ağaçtır. Yani Tavuk Tandır yaparken alta konulan sebzeler kadar önemli olduğunu söyleyebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270107,
						230270108
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270107,
					"content": "Bu nasıl bir benzetme böyle...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270110
					]
				},
				{
					"id": 230270110,
					"content": "Bu ağacın başına bir şey gelecek olursa tüm Sumeru Şehri korkunç felaketlerle karşı karşıya kalır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270111
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270111,
					"content": "Ağacı böcekler istila edebilir ya da kovuklarından ev büyüklüğünde çekirgeler fırlayabilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270112
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270112,
					"content": "Ya da dalları aniden çok fazla büyüyebilir, kökleri birden dışarı doğru sürgün verebilir ve bir sel gibi yoluna çıkan tüm evleri yıkıp geçebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270113
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270113,
					"content": "Belki de Kutsal Ağaç çok hızlı bir şekilde solar ve gövdesi düşüp Sumeru Şehri'nin yarısını yıkar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270114
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270114,
					"content": "T-Tüm bunların olma ihtimali yok, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270115
					]
				},
				{
					"id": 230270115,
					"content": "Tabii ki yok. Yani en azından şimdiye kadar her şey yolunda gitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270116
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270116,
					"content": "Ama sonuçta mantar canavarlar da sen ormanda mantar toplarken sana saldırmadan önce uyarmazlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270117
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270117,
					"content": "İşte ben de bu yüzden buradayım. Ağacı gözlemlemek ve başımıza gelebilecek herhangi bir tehlikeye karşı hazırlıklı olmak için.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270118
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270118,
					"content": "Ama gördüğün üzere düşüncelerim bir Alacakaranlık Kuşu kadar hızlı ancak bir Yıldız Mantarı kadar da güçsüzüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270119
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270119,
					"content": "Gezgin, Kutsal Ağacın köklerinin durumunu birkaç farklı konumda kameraya almama yardım eder misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270120
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270120,
					"content": "Genelde bana eşlik etmesi için bir maceracı tutarım ancak bu aralar hiçbiri müsait değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270121,
						230270122
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270121,
					"content": "Bana bırak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230270122,
					"content": "Siz araştırmacılar hep böyle mi konuşursunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270123
					]
				},
				{
					"id": 230270123,
					"content": "Nasıl yani? Benzetmelerimden mi bahsediyorsun? Üzgünüm, konuşma alışkanlığım böyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270124
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270124,
					"content": "Akademidekiler de bunu bana hep söylüyor ama konuşmamı da şıp diye değiştiremem ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270125
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270125,
					"content": "Bu sefer sana güveniyorum. Burada bekliyor olacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270108,
					"content": "Tam da senin yapacağın bir benzetme, değil mi Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270109
					]
				},
				{
					"id": 230270109,
					"content": "Evet, gerçekten de muhteşem bir ağaç...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270110
					],
					"speakerTitle": "Paimon"
				}
			]
		},
