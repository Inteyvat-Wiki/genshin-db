			"dialogs": [
				{
					"id": 230270201,
					"content": "Gezgin, şu tesadüfe bak. Yine karşılaştık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270202
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270202,
					"content": "Araştırmalarına devam ediyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230270203
					]
				},
				{
					"id": 230270203,
					"content": "Evet. Ladep ve Pharez daha fazla veri istedi, bu yüzden ben de buraya geldim, çalışmaya devam ediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270204
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270204,
					"content": "Ayrıca köklerin şu anki durumunu da merak ediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230270205
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230270205,
					"content": "Gezgin, mümkünse bana Kutsal Ağacın köklerinin durumunu kameraya almamda bir kez daha yardım eder misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				}
			]
		},
