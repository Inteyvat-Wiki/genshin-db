			"dialogs": [
				{
					"id": 230271101,
					"content": "Dönmüşsün. Kutsal Ağacın kökleri ne durumda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271102
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230271102,
					"content": "Köklerin durumunu Yasmin'e anlatıyorsun...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230271103
					]
				},
				{
					"id": 230271103,
					"content": "Canlıların orada toplanması bölgedeki yaşam enerjisinin hâlâ yüksek olduğunu gösterir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271104
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230271104,
					"content": "Bu durumda Kutsal Ağacın kökleri de şimdilik ciddi bir sorun yaşamadan büyümeye devam edecektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271105
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230271105,
					"content": "Tek endişem... Etrafındaki su kaynaklarında bulunan azot ve fosfat oranının artması sonucunda Mantarların fazlalaşması.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271106
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230271106,
					"content": "Her neyse, işte ödemen. Yardımın için teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230271107
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230271107,
					"content": "En iyisi Ladep ve Pharez'den bu civardaki element yoğunlaşmasını gözlemlemelerini isteyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				}
			]
		}
	]
