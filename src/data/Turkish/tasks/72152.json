			"dialogs": [
				{
					"id": 721520101,
					"content": "\"... Rinzou eskiden hazinesini burada saklardı. Delikanlılar son birkaç sandığı da götürdü...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520102
					],
					"speakerTitle": "Hazine Avcısı Notları"
				},
				{
					"id": 721520102,
					"content": "\"... Rinzou kurnaz biriydi ve adanın etrafına çeşitli özel semboller koydu...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520103
					],
					"speakerTitle": "Hazine Avcısı Notları"
				},
				{
					"id": 721520103,
					"content": "\"... Bu bir saptırma da olabilir ama ortada gerçek bir hazine de olabilir. Bunu ancak kendimiz gidip bakarsak öğrenebiliriz...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520104
					],
					"speakerTitle": "Hazine Avcısı Notları"
				},
				{
					"id": 721520104,
					"content": "\"... Bu sembollerin bazılarını bulduk. Dikilip beklemenin alemi yok, gidelim de Rinzou'nun definesinin hepsini kazıp çıkaralım!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520105
					],
					"speakerTitle": "Hazine Avcısı Notları"
				},
				{
					"id": 721520105,
					"content": "Vay canına... Bu cidden uzunmuş... Paimon şu anda hazine dışındaki kısımları okumakla uğraşamayacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721520106,
					"content": "Dur... Hazine mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721520107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721520107,
					"content": "Hadi ama gezgin, ortada ele geçirmemiz gereken bir hazine var! Hazine Avcılarının bizi geçmesine izin veremeyiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
