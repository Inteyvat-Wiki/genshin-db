			"dialogs": [
				{
					"id": 191451601,
					"content": "Dilerim ki Elektrik Hükümdarı o hanımefendiyi ve torununu kutsasın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451602
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 191451602,
					"content": "Merak ettiğim bir şey var... Ninenin gözleri görmüyor mu acaba?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191451603
					]
				},
				{
					"id": 191451603,
					"content": "Ah, demek fark ettin. Evet, gözleri pek iyi görmüyor. Dağa her tırmandığında bir yerine bir şey olacak diye endişeleniyoruz doğrusu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451604
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 191451604,
					"content": "Ne var ki yardım tekliflerimizi hep geri çeviriyor. Aynı yolu hayatı boyunca sayısız kez yürüdüğü için avucunun içi gibi bildiğini söylüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451605
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 191451605,
					"content": "Neyse ki yol üzerinde tapınak görevlileri var, en azından ona göz kulak oluyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191451606
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 191451606,
					"content": "Elektrik Hükümdarı gittikleri yolda ona ve torununa göz kulak olsun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inagi Hotomi"
				}
			]
		},
