					"nextDialogs": [
						401891103
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891103,
					"content": "Yemek malzemeleri tamam... Pişirme aletleri tamam... Sanırım hazırız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891104
					],
					"speakerTitle": "Escoffier"
				},
				{
