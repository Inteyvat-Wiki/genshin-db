					"content": "Bu çalışan kendini işine adamış görünüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890802,
						401890803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890802,
					"content": "Kendisine işinde başarılar diliyorum!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890804
					]
				},
				{
					"id": 401890804,
					"content": "Hahaha, harika iş çıkarıyorsunuz. Patronluk size benden daha çok yakıştı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890805
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890805,
					"content": "O halde Chevalmarin Fantastik Film Diyarı resmi olarak açılmıştır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890806
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890806,
					"content": "Tematik eğlence parkı işletmek uzun vadeli bir projedir. Aceleye getirirsen çok para kazanamazsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890807
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890807,
					"content": "Şu anki işlerimiz bitti sayılır, kısa bir ara verip bu döngünün gelir raporunu bekleyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890803,
					"content": "Görevinin başında olup olmadığını yakından kontrol edeceğim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890804
					]
				}
			]
		},
