			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Navia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401890429,
					"content": "Hadi başlayalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890401
					]
				},
				{
					"id": 401890401,
					"content": "Sevgili ortağım ve Paimon, şimdi tüm dikkatimizi Chevalmarin Fantastik Film Diyarına verelim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890402
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890402,
					"content": "Daha önce de belirttiğim üzere bu park film tutkunlarının girişimiyle başladı. Onlar da planlama, inşa ve operasyon süreçlerini üstlenmesi için Spina di Rosula'yı görevlendirdiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890403
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890403,
					"content": "Tabii bu film tutkunları her işi halledebilen uzmanlar değiller. Genelde etkinlik stantlarının tasarımıyla ilgileniyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890404
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890404,
					"content": "Bizim görevimiz uzun vadeli operasyonları yürütmek ve farklı etkinliklere yönelik standart strateji rehberleri geliştirmek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890405
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890405,
					"content": "Uzun vadeli operasyonlar, strateji falan... Bunlar çok karmaşık şeyler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890406,
					"content": "E ama bizim vaktimizin çoğu macera peşinde geçiyor, hem daha önce stant açmışlığımız da yok sayılır... Sence bu işin altından kalkabilir miyiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890407,
						401890408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890407,
					"content": "Büyük patronların hepsi ticaretin okulunu okumadı sonuçta, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890409
					]
				},
				{
					"id": 401890409,
					"content": "Budur işte! Zaten görüp geçirmediğin bir şey kalmadı, değil mi ortak? Hatta Teyvat'ın en büyük ticari projelerinde parmağın olduğunu söylesem abes kaçmaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890410
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890410,
					"content": "Her neyse! Önce festivalin nasıl organize edileceğine bakalım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890411
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890411,
					"content": "#Aa, Paimon anladı galiba. Sen ne düşünüyorsun {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890412,
						401890413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890412,
					"content": "Haha, bu iş tam benlik!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890414
					]
				},
				{
					"id": 401890414,
					"content": "Aynen öyle! Hadi, başarabiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890415,
					"content": "\"Standart strateji rehberleri\" dedin az önce ama... Standart olmayanları da mı var o zaman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890416,
					"content": "Var tabii! Film ve eğlence her insan için aynı şeyi ifade etmez, o yüzden herkesin deneyebileceği pek çok farklı ve heyecan verici etkinlik olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890417
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890417,
					"content": "Dikkatli olmazsak bazı ziyaretçiler yollarını kaybedip başlarına iş açabilirler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890418
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890418,
					"content": "Bazılarıysa yanlışlıkla tehlikeli dekorları alabilirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890419
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890419,
					"content": "Böyle karışıklıkları önlemek için her etkinliğe özel bir \"standart strateji rehberi\" hazırlamalıyız. Cevap anahtarı gibi düşünebilirsiniz mesela!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890420,
						401890421
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890420,
					"content": "Anlaşıldı, oyunları denememi istiyorsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890422
					]
				},
				{
					"id": 401890422,
					"content": "Vay be, eğer aktiviteleri ilk biz deneyeceksek kim bilir ne sürprizlerle karşılaşırız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890423,
					"content": "Ama bir zorlukla karşılaşırsak da yeteneklerimizi kullanıp üstesinden geliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890424,
					"content": "Ortağımı tehlikeye atacak değilim tabii ki. Siz gelmeden önce tüm etkinlikleri dikkatlice inceledim, son derece güvenli olduklarının garantisini verebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890425
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890425,
					"content": "Ayrıca etkinlikleri diğer insanlardan önce denemeniz iyi olur. Hem çok eğlenceli olur hem de fikirlerinizi ve önerilerinizi de paylaşırsınız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890426
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890426,
					"content": "Hehe, Navia yine şaşırtmıyor. Hem güvende olalım hem de eğlenelim istiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401890427,
					"content": "Harika öyleyse. Sizin katkınız çok önemli, bu yüzden ne düşündüğünüzü öğrenmek için sabırsızlanıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401890428
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890428,
					"content": "O halde Renkli Serüvenlerle başlayıp ilk rehberimizi hazırlayalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				},
				{
					"id": 401890421,
					"content": "Anladım, referans noktası olmamı istiyorsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890422
					]
				},
				{
					"id": 401890413,
					"content": "Vay be... Yaparken öğreneceğiz anlaşılan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890414
					]
				},
				{
					"id": 401890408,
					"content": "Biz de zamanında büyük işler yaptık!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401890409
					]
				}
			]
		},
