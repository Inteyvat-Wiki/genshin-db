					"content": "Rakamlar çok etkileyici görünmüyor olabilir ama başlangıç için hiç fena değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891002
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891002,
					"content": "Bu şevkle devam edip bir sonraki döngüde daha özel iş stratejileri uygulamalıyız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891003
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891003,
					"content": "Kalabalığı çekmek için Fontaine'deki ünlü şeflerden birini, yani yakın arkadaşım Escoffier'yi davet ettim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891004
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891004,
					"content": "\"Performansını\" eğlence parkının restoranında sergileyecek. Hadi onu görmeye gidelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891005
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891005,
					"content": "Restoran da iş stratejisinin bir parçası mı yani? Ne kadar da geniş kapsamlı bir operasyon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
