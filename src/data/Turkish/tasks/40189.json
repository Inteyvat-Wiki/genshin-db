					"nextDialogs": [
						401891105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891105,
					"content": "Aa, işverenlerim gelmiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891106
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891106,
					"content": "#Spina di Rosula'nın başkanı, yanında da meşhur {NICKNAME} ve Paimon... Açıkçası, sizin film temalı bir eğlence parkı işletmek için biraz fazla vasıflı olduğunuzu düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891107
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891107,
					"content": "Burada fazla vasıflı biri varsa o da Debord Otelin baş şefidir... Gittiğin her yere kaliteli yemeklerin kokusunu da götürüyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891108
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891108,
					"content": "Öhöm... Hadi işimize dönelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891109
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891109,
					"content": "#Her döngüdeki tematik yemeğe karar vermeme {NICKNAME} yardım etsin istiyorsun, doğru mu bildim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891110
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891110,
					"content": "\"Tematik yemek\" mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891111
					]
				},
				{
					"id": 401891111,
					"content": "Bahsettiğim iş stratejisi buydu işte. Escoffier'nin gurme yemeklerini kullanarak parka ziyaretçi çekmek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891112
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891112,
					"content": "Gerçi tek hedefimiz ziyaretçi çekmek değil. Onun aşçılık becerilerinin beklenmedik başka sonuçlar doğuracağına inanıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891113
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891113,
					"content": "Düşünsene Paimon, tüm aktiviteleri denemek ve birbirinden lezzetli yemekler tatmak için tek ihtiyacın bir bilet olsa... Almak istemez miydin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891114
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891114,
					"content": "Ö... Ö... Öyle olsa Paimon her gün gelirdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891115,
						401891116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891115,
					"content": "Senelik üyelik de var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891117
					]
				},
				{
					"id": 401891117,
					"content": "Ancak müşteri çekme potansiyelimizi düşürmemek için menüyü herkese gösteremeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891118
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891118,
					"content": "Bir yemek marka danışmanının yaptığı araştırma sonucunda birçok restoran \"Şefin Sürprizi\" adlı özel bir yemek sunmaya başladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891119
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891119,
					"content": "Bu yüzden her iş döngüsünde bana biraz ilham ver ki ben de bir sonraki tematik yemeğimize karar verebileyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891120
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891120,
					"content": "Şimdi elini ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891121,
						401891122
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891121,
					"content": "Elimi mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891123
					]
				},
				{
					"id": 401891123,
					"content": "Hım, sıcak ve enerjik bir his.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891124
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891124,
					"content": "Ellerin kılıç tutmaktan nasırlaşmış ama hâlâ narin sayılırlar. Kılıcının kabzasını sanki bir keman yayıymış gibi tutuyorsun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891125
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891125,
					"content": "Kılıç demek... O halde bu seferki tema \"güç\" olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891126
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891126,
					"content": "Pekala! Bakalım yemek formundaki \"güç\" nasıl bir şeymiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891122,
					"content": "İlhamın fiziksel olarak aktarılabileceği aklımın ucundan geçmezdi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891123
					]
				},
				{
					"id": 401891116,
					"content": "Hep burada yaşamanın bir yolu olsa keşke!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891117
					]
				}
			]
		},
