			"dialogs": [
				{
					"id": 401891601,
					"content": "Vay be... Her şey yolunda görünüyor. Parkı yönetme konusunda uzman olmuşsunuz resmen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891602
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891602,
					"content": "Sahiden öyle mi düşünüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891603,
					"content": "Aslında düşününce... Epey bir şey öğrenmiş olduk, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891604,
						401891605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891604,
					"content": "Navia bize her şeyi çok iyi öğretmiş demek ki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891606
					]
				},
				{
					"id": 401891606,
					"content": "Hiç de bile. Pek bir şey öğretmedim aslında. Size rehberlik eden kendi içgüdüleriniz oldu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891607
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891607,
					"content": "\"Uzun vadeli operasyon\" lafını ilk duyduğunuzda biraz korkutucu gelmiştir eminim, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891608
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891608,
					"content": "Ama gözünüzü korkutmasın bu! İşlerinizi küçük adımlara bölerek hepsini sırayla halledebilirsiniz. Süper zeki ya da doğuştan yetenekli olmanıza da gerek yok, bir yolunu bulursunuz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891609
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891609,
					"content": "Paimon kendindeki ilerlemeyi görünce iyice coştu! Hatta bu gaza getirici sözlerini bir kenara not edecek, hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891610,
					"content": "Bundan böyle Chevalmarin Fantastik Film Diyarını birlikte yöneteceğiz ve çok başarılı olacağız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891605,
					"content": "Navia'nın rehberliği olmadan başaramazdık!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401891606
					]
				}
