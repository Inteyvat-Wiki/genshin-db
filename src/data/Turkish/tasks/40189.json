			"dialogs": [
				{
					"id": 401891401,
					"content": "Bu Barbekü Soslu Kaburgaların sosunu geliştirdim. Klasik olandan daha yoğun aromalı fakat hiç yağlı değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891402
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891402,
					"content": "Marine ederken kullandığım Nane özü müthiş bir lezzet bırakıyor ağızda, tam keyifli bir günün ardından yumulmalık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891403
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891403,
					"content": "Ancak bana sorarsanız ustaların bunlara misafirlerden daha fazla ihtiyacı var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891404
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891404,
					"content": "Ustalar mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891405,
					"content": "Siz de fark etmişsindir muhakkak, bu park henüz tam bitmiş sayılmaz. Bu Barbekü Soslu Kaburgalardan bir porsiyon, ustaların enerjilerini çok daha hızlı toplamalarına yardımcı olacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891406
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891406,
					"content": "Patronları olarak onların yemeğini sağlamak durumundasınız. Yemek için buraya davet etmeye ne dersiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891407
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891407,
					"content": "Kim bilir, belki de morallerini yükselterek daha verimli çalışmalarına vesile olursunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891408
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891408,
					"content": "Öyle mi? Yanlış hatırlamıyorsam bir keresinde Cendre Nehri'ndeki hamallara özel bir Balık ve Patates Kızartması hazırlamıştın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891409
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891409,
					"content": "Sonraki birkaç gün boyunca işçilerin performansı inanılmazdı. Sekiz saatlik işi beş saatte tamamlıyorlar ve erken paydos edip dinlenme fırsatı buldukları için ertesi güne tamamen zinde bir şekilde başlıyorlardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891410
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401891410,
					"content": "O halde oyalanmayalım. Hazır kaburgaların dumanı üstündeyken gidip ustaları çağırın. Yemeğin yanında birkaç meze ve tatlı da hazırlayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891411
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401891411,
					"content": "Harika bir fikir! Şöhretinin hakkını veriyorsun gerçekten Escoffier!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891412,
					"content": "Anlaşılan bu tematik yemekler çok büyük bir fark yaratacak! Bundan sonra seni düzenli olarak ziyaret etmemiz gerek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401891413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401891413,
					"content": "Navia ile birlikte ustaları davet ediyor ve onlara Barbekü Soslu Kaburgalarla unutulmaz bir şölen yaşatıyorsunuz...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
