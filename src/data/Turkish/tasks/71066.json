			"dialogs": [
				{
					"id": 710660301,
					"content": "Evet, bu! Çok teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660302
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660302,
					"content": "Lütfen bunları ödül olarak kabul et. Çam sakızı çoban armağanı, kusura bakma ne olur. Yaptığın şeyleri ölümsüz kılmak için şiirler yazacağım!",
					"roleType": "TALK_ROLE_NPC",
