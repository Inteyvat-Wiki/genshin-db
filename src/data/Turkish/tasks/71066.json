			"dialogs": [
				{
					"id": 710660801,
					"content": "Son zamanlarda bir şey oldu mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660802
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660802,
					"content": "Hırsız Gelincikler Hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660803
					]
				},
				{
					"id": 710660803,
					"content": "Haa, Kanyon'dakileri diyorsun... Onlara bakma görevi bana verilmişti ama elime yüzüme bulaştırdım, söyleyebileceğim çok şey yok yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660804
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660804,
					"content": "Eh... Onları tekrar yakalamam imkansız. Hepsi saklambaç ustası sonuçta. İzlerini bulmak çok zor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660805
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660805,
					"content": "Ama bu gıcık yaratıklar insanlardan bir şeyler çaldıysa size biraz yardım edebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660806
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660806,
					"content": "Hırsız Gelincikler Hazine Avcıları tarafından eğitilir ve günün belirli saatlerinde beslenir. Üç tür Hırsız Gelincik vardır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660807
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660807,
					"content": "Altın Hırsız Gelincik en kurnaz olanıdır... Bir de daha sık görülen İstifçi Hırsız Gelincik vardır. En salağı ise Amatör Hırsız Gelinciktir. Ne zaman ortaya çıktıklarına gelecek olursak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660808
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660808,
					"content": "*iç çeker* Kimse tam saati hatırlamaya tenezzül etmediği için bir yerlerde besleme saatlerinin de bulunduğu bir eğitim kılavuzu olmalı. Muhtemelen Hırsız Gelinciklerin sık sık uğradığı kamptadır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660809
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710660809,
					"content": "Ah... Az kalsın bunu unutuyordum! Hırsız Gelincikleri çağırmak isterseniz bununla ıslık çalın.",
					"roleType": "TALK_ROLE_NPC",
