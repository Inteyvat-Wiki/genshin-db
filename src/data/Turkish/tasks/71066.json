			"trigger": {
				"objectNames": [
					"Taliesin",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710660701,
					"content": "Öhöm... Pardon. Bir şair olarak dramatik konuşma ve hikaye yazma eğilimindeyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660702
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660702,
					"content": "Hehe, doğrusunu söylemek gerekirse yüzüğü Hırsız Gelinciklerin yuvasında buldum... İyi bir durumdaydı ve göze hitap ediyordu, ben de aldım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660703
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660703,
					"content": "Hımm, sen de hırsızsın yani. Hırsızlardan çalmışsın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660704,
					"content": "Deme öyle... Denk geldim işte! Evet, şans eseri denk geldim! Şans eseri olsa da yüzük benim için çok değerli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660705
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660705,
					"content": "Yüzüğün nerede olabileceği hakkında bir fikrin var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660706
					]
				},
				{
					"id": 710660706,
					"content": "Evet... Hırsız Gelinciklerin buraya sık sık geldiğini duydum. Ben uyurken yüzüğümü çalmış olabilirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660707
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660707,
					"content": "Hımm, uyumadan önce yüzüğünü çıkaran insanlar da varmış demek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660708,
					"content": "Ben de hiç duymadım böylelerini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660709
					]
				},
				{
					"id": 710660709,
					"content": "Neyse, Paimon'un böyle bir alışkanlığı yok! Yüzüğü çıkardıktan sonra nereye koyacağını düşünmen lazım yoksa güzellik uykunu harcamış olursun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660710,
					"content": "Senin parmakların kadar küçük yüzük yapıyorlar mı ki Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660711
					]
				},
				{
					"id": 710660711,
					"content": "Peh, tabii yapıyorlar! Bilmediğin çok şey var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660712,
					"content": "Yeter. Lütfen kendi hayatlarınız hakkında konuşmadan önce başkalarının yaşam tarzını yargılamayın. Çok kabasınız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660713
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660713,
					"content": "... Her neyse, yardım etmek istiyorsanız... Lütfen Hırsız Gelinciklerin yuvalarını arayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660714
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660714,
					"content": "Haritanın burasında şüpheli bir Hazine Avcısı kampı olduğunu duydum. Yerini işaretledim sizin için.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660715
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660715,
					"content": "Hırsız Gelinciklerin sık sık burada görüldüğü söyleniyor. Sinsi Hazine Avcıları muhtemelen onlarla iş birliği içinde... Neyse, lütfen oraya bakın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660716
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660716,
					"content": "Hımm... Hırsız Gelinciklerden çalınan, daha sonra yine başka Hırsız Gelincikler tarafından çalınan bir yüzük. Paimon'a kalırsa gerçek sahibine dönmüş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660717,
					"content": "Hadi ama, yeter bu kadar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
