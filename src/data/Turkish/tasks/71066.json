			"dialogs": [
				{
					"id": 710660101,
					"content": "*iç çeker* Çok mantıksız. Garip.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660102
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660102,
					"content": "Buralarda bir yerde olması gerek. Neden bulamıyorum o zaman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660103
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660103,
					"content": "Ne oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660104
					]
				},
				{
					"id": 710660104,
					"content": "Yüzüğüm... Kaybettim. Benim için çok değerli. Bulmam gerek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660105
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660105,
					"content": "Nasıl bir yüzük?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710660106
					]
				},
				{
					"id": 710660106,
					"content": "Pirinçten yapılmış ve üzerine güzel bir kırmızı cevher işlenmiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660107
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660107,
					"content": "Efsanelerde anlatılan, gölge ejderha Durin'in düştüğü lav gölünün yakınlarında buldum. En azından bu, parıltısının neden karanlık alevlere benzediğini açıklar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660108
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660108,
					"content": "Vay be...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710660109,
					"content": "Hiçliğin Efendisinin kem gözünü yüzüğün taşıyıcısına dikeceği ve onu yakalamak için karanlık bir ordu göndereceği söylenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710660110
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710660110,
					"content": "Ah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
