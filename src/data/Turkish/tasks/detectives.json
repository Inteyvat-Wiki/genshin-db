			},
			"dialogs": [
				{
					"id": 191851101,
					"content": "Bu poşetler... Oldukça nadir bir malzemeden yapılmış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851102
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 191851102,
					"content": "[Bilgi] (Lyney'nin malzemeyi değerlendirmesine yardımcı ol...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851103
					]
				},
				{
					"id": 191851103,
					"content": "Senin Sihirli Ceplerinde kullanılan malzemeye benzemiyor mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851104
					]
				},
				{
					"id": 191851104,
					"content": "... Bire bir aynısı aslında. Romaritime Çiçeği lifinden yapılmış. Ama bu poşetlerin yapısında bir farklılık var. Yakından inceledim de anlaşılan hem su geçirmezler hem de aşınma ve sızıntıya karşı dayanıklılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851105
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 191851105,
					"content": "Poşetin ipleri bile ağzını sıkıca kapalı tutmak için özellikle tasarlanmış gibi duruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851106
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 191851106,
					"content": "Az önce aynı malzemeden yapılmış başka poşetlere rast geldim, ama onlar çok daha küçük ve inceydi. Ayrıca daha az dayanıklı görünüyorlardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851107
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 191851107,
					"content": "Yani... Şu küçük sızdırmaz poşetler gibiler miydi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851108
					]
				},
				{
					"id": 191851108,
					"content": "... Evet, onlara çok benziyorlardı. Normalde Muhafız Kanişler Sahte Sinthe'i çok kolay koklayıp bulur ama eğer böyle bir poşetin içine konulmuşsa öyle hemen tespit edemeyebilirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851109
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 191851109,
					"content": "O zaman bu büyük poşetler ne için? Eğer amaç Sahte Sinthe'i gizlemekse bu poşetler çok dikkat çekiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lyney"
				}
			]
		},
