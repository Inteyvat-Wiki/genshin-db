			"dialogs": [
				{
					"id": 191851001,
					"content": "... Gölge Mareşosesi, Pierre'in evini araştırırken bu fıçılar yoktu herhalde, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851002
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 191851002,
					"content": "Onları buraya taşımış olmalı. Ancak fıçıları buraya kadar getirmek çok dikkat çeker.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851003
					]
				},
				{
					"id": 191851003,
					"content": "Haklısın. Bu pek onun yapacağı bir şeye benzemiyor. O zaman bu fıçılar buraya nasıl geldi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851004
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 191851004,
					"content": "(Fıçıları incele...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851005
					]
				},
				{
					"id": 191851005,
					"content": "(Fıçılar sudan hasar görmüş. Kenarlarında kurumuş su lekeleri görülebiliyor...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851006
					],
					"speakerTitle": "Araştır"
				},
				{
					"id": 191851006,
					"content": "(Su lekelerinin yeri hep aynı sanki. Nedense bu lekeler sadece fıçının alt kısmında görülüyor.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851007
					],
					"speakerTitle": "Araştır"
				},
				{
					"id": 191851007,
					"content": "(Kapaklar çok sıkı kapatılmamış, kenarlarda boşluklar kalmış. Ancak fıçıların içinde su varmış gibi durmuyor.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851008
					],
					"speakerTitle": "Araştır"
				},
				{
					"id": 191851008,
					"content": "Sanırım fıçıların sadece alt kısmı suya batmış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lynette"
				}
			]
		},
