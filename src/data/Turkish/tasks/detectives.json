					"nextDialogs": [
						191854104
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 191854104,
					"content": "Soruşturmamızı o kadar hızlı yürüttük ki belki de gözümüzden kaçırdığımız bazı şeyler oldu. Sonuç çıkarımı modumu etkinleştireyim ve her şeyi en baştan tekrar bir düşüneyim. Bakalım yeni bir şey bulabilecek miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191854105
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 191854105,
					"content": "... Üzerinde düşünmemiz gereken, halen çözüme kavuşmamış veya tuhaf bir durum var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lynette"
				}
