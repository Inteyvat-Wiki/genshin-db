			"dialogs": [
				{
					"id": 191851201,
					"content": "Hah, tam da düşündüğümüz gibi... Sahte Sinthe burada yapılıyormuş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851202
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 191851202,
					"content": "[İlaç] (Chevreuse'ün ilaçları tanımlamasına yardımcı ol...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851203
					]
				},
				{
					"id": 191851203,
					"content": "Bu şişeler ve kavanozlar... Hepsinin içinde Sahte Sinthe mi var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851204
					]
				},
				{
					"id": 191851204,
					"content": "... Buraya sadece Sahte Sinthe gizlemekle kalmamış... Maddenin kendisini sentezlemek için gereken ham maddelerin yanı sıra, çok miktarda temizlik malzemeleri ve ne olduğunu anlayamadığım bazı ilaçlar da var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851205
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 191851205,
					"content": "Temizlik malzemeleri büyük ihtimalle maddenin etrafa yaydığı koku gibi izleri silmek için kullanılıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851206
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 191851206,
					"content": "Özel Devriye olarak bu Sahte Sinthe konusu üzerine araştırma yaptık. Kayıtlarımıza göre sıradan insanların bu maddenin geride bıraktığı izleri tespit edebilmesi çok zor. Pierre'e de aynısının olduğundan eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851207
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 191851207,
					"content": "İzlerin hepsini silmek için epey bir zaman ve çaba harcanmış olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851208
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 191851208,
					"content": "Ama bu diğer ilaçlar ne için?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chevreuse"
				}
			]
		},
