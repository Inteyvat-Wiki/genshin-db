			"dialogs": [
				{
					"id": 111240101,
					"content": "Bu tablet, Dağkesen tarafından dikilmiştir. Azhdaha'yı korkunç bir ejder olarak tanımlamaktadır. Bu yerden... Bu mühürden uzak durmaları için sonraki nesillere uyarı niteliğindedir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111240102
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111240102,
					"content": "Yazık... İyi ve kötü arasında ince bir çizgi var. İçindeki iyilik ve kötülük tek bir cümlede özetlenirse... Neyse, boş ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111240103
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111240103,
					"content": "(Ağacın altında duran Zhongli'yi sessizce izlersin...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111240104
					]
				},
				{
					"id": 111240104,
					"content": "(Sessizliğin ortasında sadece rüzgarın hafif sesi duyulur. Zaman, görünmez bir nehre dönüşüp akıp gidiyor sanki...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111240105
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111240105,
					"content": "(Kısa bir an, ölümlü dünyada bin yıl demek. Taşlar bunu hissediyor, dünya ve tanrılar da.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		},
