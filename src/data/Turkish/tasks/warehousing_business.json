				"points": []
			},
			"dialogs": [
				{
					"id": 230400201,
					"content": "Ah, şu Kızıl Akbabalar var ya! Dadandılar resmen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400202
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400202,
					"content": "Neler oluyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400203
					]
				},
				{
					"id": 230400203,
					"content": "Sen... Gezgin sen misin yoksa? Ebeid senden bahsetmişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400204
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400204,
					"content": "Haha, gezginler buralara pek uğramaz. Seni görmeyi beklemiyordum o yüzden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400205
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400205,
					"content": "Ah, Habachi ile tanıştın mı? Kendisi çok katıdır, o yüzden bazen soğuk ve mesafeli görünür. Sen yine de üstüne alınma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400206
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400206,
					"content": "Burada çok şey depolanıyor, sadece yiyecek değil. Kıyafetler, silahlar, hatta Mora ve çeşitli ürünler bile var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400207
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400207,
					"content": "Burada çok az genç var, pek çok iş de onların üzerine kalıyor. Kasabayı korumaktan tut, köylülerin günlük işlerine kadar bir sürü şey... O yüzden depo muhafızlığını da sadece Habachi yapıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400208
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400208,
					"content": "Ben de ancak malları sayıp hesap tutarak ona yardım edebiliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400209
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400209,
					"content": "Kızıl Akbabalar ne alaka peki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400210
					]
				},
				{
					"id": 230400210,
					"content": "*iç çeker* Hiç sorma. Bir süre önce depoya kurutulmuş et geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400211
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400211,
					"content": "Herhalde kokusu falan bu kuşları çekiyor. Neyse, ara ara deponun yakınındaki tepeye tünemeye başladılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400212
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400212,
					"content": "Depo kilitli olduğu için kurutulmuş ete ulaşamıyorlar tabii ama önlerinde yiyen herkes onların hedefi oluveriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400213
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400213,
					"content": "Muhafızlarımız onlardan kurtulamayacak kadar meşgul, Habachi de müsait değil zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400214
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400214,
					"content": "Vaktin varsa sen halledebilir misin Gezgin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400215,
						230400217
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400215,
					"content": "Hallederim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400216
					]
				},
				{
					"id": 230400216,
					"content": "Çok teşekkürler. O kadar vahşiler ki sorma, yanlarına çok yaklaşmamakta fayda var. Daha güvenli olsun diye ok ve yay kullanmanı öneririm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400217,
					"content": "Bir şeylere saldırdılar mı hiç?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400218
					]
				},
				{
					"id": 230400218,
					"content": "Evet, hem de bir sürü şeye. Nakliye bekleyen mallara, kuruttuğumuz etlere, Habachi'nin öğle yemeğine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400219
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400219,
					"content": "Habachi görevdeyken ne zaman öğle yemeği yese akbabalar geliyor ve çaktırmadan etini kapıp uçuyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400220
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400220,
					"content": "Zavallı çocuk onları kovalamak için görevden ayrılamıyor bile. O yüzden kalanlarla yetinmek zorunda kalıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400221
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400221,
					"content": "Lütfen şu akbabalardan kurtar bizi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				}
			]
		},
