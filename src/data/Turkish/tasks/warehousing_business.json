			},
			"dialogs": [
				{
					"id": 230400401,
					"content": "Nasıl geçti? Üstesinden gelebildin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400402,
						230400403
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400402,
					"content": "Evet, hepsi bitti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400404
					]
				},
				{
					"id": 230400404,
					"content": "Çok teşekkürler! Habachi nihayet huzur içinde öğle yemeğini yiyebilecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400405
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400405,
					"content": "Al, bu senin için.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400406
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400406,
					"content": "Ha... Bugün başka ne gelecek acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400403,
					"content": "Bir süre geri dönmezler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400404
					]
				}
			]
		},
		{
