			"dialogs": [
				{
					"id": 230400501,
					"content": "*iç çeker* Habachi'nin biraz dinlenmesi lazım artık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400502
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400502,
					"content": "Ne oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400503
					]
				},
				{
					"id": 230400503,
					"content": "Gezgin! Mükemmel zamanlama! Bana yardımcı olur musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400504
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400504,
					"content": "Köy dışından kurutulmuş yiyecekler geldi. Habachi de onları buraya teslim etmek üzereydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400505
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400505,
					"content": "Ne var ki bir grup Kızıl Akbaba kokuyu alıp saldırıya geçti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400506
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400506,
					"content": "Muhafızlar onları çabucak kovalayabildi ama yiyecekler dört bir yana saçıldı tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400507
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400507,
					"content": "Bazıları diğer teslimat ekiplerini uyarmaya gitti, Habachi de hâlâ yenilebilir olanları toplamaya çalışıyor. Bize yardım eder misin Gezgin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400508,
						230400510
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400508,
					"content": "Hallederim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400509
					]
				},
				{
					"id": 230400509,
					"content": "Çok teşekkür ederim. Kusura bakma, yeni malların gelmesini bekliyorum da o yüzden ben gidemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400510,
					"content": "Habachi iyi mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400511
					]
				},
				{
					"id": 230400511,
					"content": "*iç çeker* Mola vermesini söyledim ama dinlemedi. Dağılan yiyecekleri toplamayı bitirince depodaki malları inceleyecekmiş. Bu kadar çok çalışmasına gerek yok halbuki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400512
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400512,
					"content": "Mallar Beyaz Asansörün yakınlarında olmalı. Lütfen onları bana getir Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				}
			]
		},
