					"nextDialogs": [
						230400812
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400812,
					"content": "Ama bu sefer pusu kurmuş bir grup Hazine Avcısından bahsediyoruz. Teslimat ekibinde hızlı koşan biri olmasa haberimiz bile olmazdı.",
					"roleType": "TALK_ROLE_NPC",
