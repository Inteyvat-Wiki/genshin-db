			"dialogs": [
				{
					"id": 230400701,
					"content": "Malları getirdin mi Gezgin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400702
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400702,
					"content": "Evet, işte buradalar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230400703
					]
				},
				{
					"id": 230400703,
					"content": "Harika! Lütfen şuraya koy. Çok teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400704
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400704,
					"content": "Habachi şu an depodaki diğer eşyaların sayımını yapıyor. Buradaki yiyeceklerle ben ilgilenirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230400705
					],
					"speakerTitle": "Najat"
				},
				{
					"id": 230400705,
					"content": "*iç çeker* Umarım çok yiyecek kaybetmemişizdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Najat"
				}
			]
		},
