			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742230201,
					"content": "Yüz otuz altı... Pekala, on dört defa daha yapalım ve sonra bir mola verelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230202
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230202,
					"content": "Yardım lazım mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742230203
					]
				},
				{
					"id": 742230203,
					"content": "Yardım mı? Hayır, gerek yok. Hangi idmanda başkalarının yardımına ihtiyaç olur ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230204
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230204,
					"content": "Ancak vücudumu geliştirerek Athanatoi Lejyonunun asil askerleri arasına katılabilirim, tıpkı buradaki şu subay gibi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230205
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230205,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230206
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230206,
					"content": "Ah bu arada, tanıştırayım! Bu benim eğitmenim. Onun verdiği sınavları geçerek ancak yükselme hakkı elde edilebiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230207,
						742230210
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230207,
					"content": "Bu sadece bir heykel değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742230208
					]
				},
				{
					"id": 742230208,
					"content": "Laflarına dikkat et yurttaş! Bütün Remurialılar böyle değil mi zaten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230209
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230209,
					"content": "Her neyse, denemek istiyor musun? Başlangıç sınavında bu taş sütunları aynı anda parçalaman gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230213
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230213,
					"content": "Sakın ha o sütunları hafife alayım deme! O kadar idman yapmama rağmen ben bile tek yumrukta sadece bir tanesini zor parçalayabiliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230210,
					"content": "Sınav mı? Ne sınavı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742230211
					]
				},
				{
					"id": 742230211,
					"content": "Savaş sınavı tabii, başka ne olacak? Yükselmiş ve ölümsüz bir bedene sahip olabilirsin belki ama savaş becerilerini kendi başına geliştirmen gerekir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230212
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230212,
					"content": "Her neyse, denemek istiyor musun? Başlangıç sınavında bu taş sütunları aynı anda parçalaman gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230213
					],
					"speakerTitle": "Venier"
				}
			]
		},
