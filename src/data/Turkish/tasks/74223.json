						742230402
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230402,
					"content": "Tek kelimeyle inanılmaz. Daha önce Tanrı Kral'ın ordusunda hizmet etmiş olabilir misin acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230403
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230403,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742230404
					],
					"speakerTitle": "Venier"
				},
				{
					"id": 742230404,
					"content": "Performansını subayımız da çok beğendi! Sanırım benim daha çok çalışmam lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venier"
				}
			]
		},
