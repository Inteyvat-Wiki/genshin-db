				"points": []
			},
			"dialogs": [
				{
					"id": 746680101,
					"content": "Ne? Yedilerin Heykeli ışık saçmaya mı başladı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680102,
					"content": "Bu çok garip! Daha önce böyle bir şey olmuş muydu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680103,
						746680105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680103,
					"content": "Yedilerin Heykelinin parlaması normaldir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680107
					]
				},
				{
					"id": 746680107,
					"content": "#Sen kendini hiç rahatsız hissetmedin mi {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680108,
						746680110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680108,
					"content": "Hı? Su... Su benimle konuşuyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680109
					]
				},
				{
					"id": 746680109,
					"content": "Paimon da kesin inanır buna! Böyle şaka yapabiliyorsan bir şeyin yok demektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680112,
					"content": "Fakat heykel öyle parladıktan sonra hava daha nemli oldu sanki. Belki de açığa çıkan tüm o Su enerjisi yüzündendir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680113,
					"content": "Hehe, Paimon'un duyduğuna göre Fontaine'de Element Enerjisini doğru şekilde kullanabilirsen su altında bile yüzebilirmişsin! Hatta batık hazineleri bile çıkarabilirsin belki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680114,
					"content": "Paimon hazine için dalma işini sana bırakıyor. Paimon sahilde kalıp seni bekleyecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680115,
						746680116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680115,
					"content": "Suyun altında kendimi çok yalnız hissedeceğim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680117
					]
				},
				{
					"id": 746680117,
					"content": "Ayyy! Ama... Ama... Suda olmak çok korkunç!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680118,
					"content": "Ya Paimon bir akıntıya kapılıp alaşağı olursa ve başı dönerse? Ya oradan uçarak kaçamazsa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680119,
					"content": "Tıpkı Mondstadt'ta seninle karşılaştığımız zaman gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680120,
					"content": "O zaman yine seni balık gibi tutarım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680121
					]
				},
				{
					"id": 746680121,
					"content": "... Gerçekten mi? O-O zaman belki Paimon seninle beraber su altına gelmeyi deneyebilir. Hıh! Sözünü tutsan iyi olur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680116,
					"content": "Bir kere de sen bir şeyler yapsan Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680117
					]
				},
				{
					"id": 746680110,
					"content": "Vay canına, sanki solungaçlarımla nefes alıyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680111
					]
				},
				{
					"id": 746680111,
					"content": "Aman ne güzel! Önce solungaçların bir çıksın da görelim! Hıh! Senin hiçbir şeyin yok anlaşılan! Paimon bir anlığına senin için endişelendiğine inanamıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746680105,
					"content": "Su dalgası mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746680106
					]
				},
				{
					"id": 746680106,
					"content": "Burası Su Hükümdarı'nın ülkesi tabii! Yedilerin Heykelleri bile su çeşmesi şeklinde... TABİİ Kİ o ışık hiç de normal değildi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746680107
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}