					"nextDialogs": [
						220410107
					]
				},
				{
					"id": 220410107,
					"content": "Harika. Lütfen Konbumaru'yu bulup getirmen gerektiğini unutma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410108,
					"content": "Tek başına mı kaçtı?",
