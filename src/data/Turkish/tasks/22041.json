					"nextDialogs": [
						220410109
					]
				},
				{
					"id": 220410109,
					"content": "Evet... Belki onu azarladığım için içerlemiş olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410110
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220410110,
					"content": "Neden bu çocuk laftan anlamıyor ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220410111
					],
					"speakerTitle": "Neko"
				},
				{
