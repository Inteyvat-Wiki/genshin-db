			"dialogs": [
				{
					"id": 762100617,
					"content": "Resimdeki figür hızlıca sıçrayıp tam önünüze iniyor...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						762100601
					]
				},
				{
					"id": 762100601,
					"content": "Selamlar. Ben Zhangsun Jijing. Seninle bizzat tanışmak bir şereftir genç kahraman. Bana neden seslendiğini sorabilir miyim? Tartışmamız gereken acil bir konu mu var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100602
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100602,
					"content": "Şey, öyle bir durum yok. Sadece resmin içinde oradan oraya zıpladığını gördük de biraz merak ettik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100603,
					"content": "Anlıyorum. Sadece hafif adım tekniklerimin alıştırmasını yapıyordum. Yine de korkarım size pek iyi bir gösteri sunamadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100604
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100604,
					"content": "Hafif adım teknikleri mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100605,
					"content": "Evet. Bu diyara hiç yağmur yağmadığı için ustamın bana öğrettiği \"Yağmur Kesen\" sanatlarının idmanını yapamıyorum. Becerilerimin körelmesini istemediğim için de bunun yerine bu şekilde idman yapmaya başvurdum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100606
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100606,
					"content": "Büyük Usta Guhua'nın tam da bu taş yığınlarının üzerinde çevikliğini nasıl geliştirdiğini ve en sonunda sanatının zirvesine ulaştığı o eski günleri sık sık düşünürüm. Biz çömezlerin yeteneği kıt olsa da onun parlaklığının ufacık bir kısmını bile taklit etmeye çalışarak az da olsa bir ilerleme kaydetmeyi umuyoruz.",
					"roleType": "TALK_ROLE_NPC",
