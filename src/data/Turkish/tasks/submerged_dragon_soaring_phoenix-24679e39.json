			"dialogs": [
				{
					"id": 762100201,
					"content": "Gerçekten hayranlık uyandırıcı. Çok etkilendim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100202
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100202,
					"content": "Madem öyle... Naçizane bir ricam daha olacak. Acaba <color=#00E1FFFF>Bulut Adımı Tekniklerini</color> duymuş muydun genç kahraman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100203
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100203,
					"content": "Söylentiye göre Büyük Ustamız Guhua, bir zamanlar mor bir sisin ortasında göğe yükselmiş, sanki katı bir zeminmiş gibi havada yürümüş. Tüm bunlar bu efsanevi gizli teknik sayesinde mümkün olmuş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100204,
						762100206
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100204,
					"content": "Bana biraz abartı geldi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100205
					]
				},
				{
					"id": 762100205,
					"content": "Evet, sanki uydurma gibi... Ama şimdi düşününce, Kanat kullanarak benzer bir şey yapamaz mıyız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100207,
					"content": "Hım? O zaman bana bir iki hünerini göstermeni rica edebilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100206,
					"content": "Kanat kullanabilirsek...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100207
					]
				}
			]
		},
