			"dialogs": [
				{
					"id": 762100101,
					"content": "Tekniğin gerçekten olağanüstü genç kahraman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100102
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100102,
					"content": "#Hehe, aynen öyle! {NICKNAME} bu işte bir numaradır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100103,
					"content": "Öyleyse bu genç kahraman bana <color=#00E1FFFF>Atlama Tekniklerinin</color> gerçek özünü gösterebilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100104
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100104,
					"content": "Kayıtlara göre mezhebimin kadim ustaları olan Guhua Klanı, şehir duvarlarına sanki düz zeminde yürüyorlarmış gibi tırmanabiliyorlarmış. Çatılarda koşma ve duvarlara tırmanma sanatında gerçekten ustalaştıktan sonra bu becerileri damıtarak Atlama Tekniklerini oluşturmuşlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100105,
						762100106
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100105,
					"content": "İnanılmaz!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100108
					]
				},
				{
					"id": 762100108,
					"content": "#Hımm... Denemekten zarar gelmez sanki. Ne de olsa bugüne dek hazine ararken bol bol tırmanış yaptın, değil mi {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100106,
					"content": "Kulağa hırsızlık gibi geliyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100107
					]
				},
				{
					"id": 762100107,
					"content": "Hehe, bir düşünsene genç kahraman. Bir hırsız adaletten kaçmak için duvarın üzerinden atlayabiliyorsa fakat adaleti savunan bizler atlayamıyorsak bu durum, kötülerin elimizden kaçmasını çaresizce izlememize neden olmaz mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100108
					],
					"speakerTitle": "Zhangsun Jijing"
				}
			]
		},
