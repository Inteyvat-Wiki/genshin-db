			"dialogs": [
				{
					"id": 762100301,
					"content": "Bak, bunlar Guhua Klanının medarıiftiharı olan \"Erikseyri Direkleri\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100302
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100302,
					"content": "Belirli bir süre içinde belirttiğim sırayla taş yığınlarına basıp bana ne kadar becerikli olduğunu gösterebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100303,
						762100305
					],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100303,
					"content": "Tabii, benim için çocuk oyuncağı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100304
					]
				},
				{
					"id": 762100304,
					"content": "Gerçi epey de yığın varmış ama... Iı, boş ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762100307,
					"content": "Pekala genç kahraman, hünerlerini sergileme zamanı geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhangsun Jijing"
				},
				{
					"id": 762100305,
					"content": "Hatta bahse girerim Paimon Klanının ustası Paimon bile bunu başarabilir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762100306
					]
				},
				{
					"id": 762100306,
					"content": "Ne? İmkansız, hayatta olmaz... Dur bir dakika. Aslında Paimon yapabilir ya... Ama uçmak hile sayılır, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762100307
					],
					"speakerTitle": "Paimon"
				}
			]
		},
