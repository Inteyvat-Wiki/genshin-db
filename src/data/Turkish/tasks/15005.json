			"dialogs": [
				{
					"id": 150050101,
					"content": "Yenilen Koholazorlar dağılır ve kaçar.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150050102
					]
				},
				{
					"id": 150050102,
					"content": "Kıyafetlerinize bakılırsa siz Sumerulu alimler olmalısınız, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050103,
					"content": "Evet, ben Karya, bu da benim üst sınıfım Viramdra. Bizi kurtardığınız için çok sağ olun. Az kalsın canımızdan oluyorduk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050104
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050104,
					"content": "#Lafı bile olmaz! Bizim için bu tür sorunları çözmek refleks oldu artık. Bu arada Paimon'un adı Paimon, bu da {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050105,
					"content": "*iç çeker* Tüm Koholazorlar kaçtı ama galiba... En azından birini canlı yakalamamız lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050106
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150050106,
					"content": "Ne? Canlı yakalamak mı dedin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050107,
					"content": "Evet. Görünüşe göre siz onlarla başa çıkmakta epey tecrübelisiniz. Acaba beni canlı yem olarak kullanıp bir Koholazor yakalamamıza yardımcı olur musunuz? Çabanızın karşılığını öderiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050108
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150050108,
					"content": "Iı, şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050109,
					"content": "Kusurumuza bakmayın. Viramdra araştırmasına fazla kaptırdı kendini, lütfen üzerine çok gitmeyin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050110
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050110,
					"content": "Sorun yok! Ama niye vahşi bir Koholazor sürüsüne yaklaştınız? Ayrıca bu \"yakalama\" konusu nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050111,
					"content": "Oldu olacak bir de beraber fotoğraf çekilin isterseniz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050112
					]
				},
				{
					"id": 150050112,
					"content": "Paimon öyle bir şey istediklerini hiç sanmıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050113,
					"content": "Size çok komik geliyor olabiliriz... Biz aslında bir efsanede bahsi geçen gizemli bir adayı arıyoruz. Adaya dair çok önemli bir ipucunun Koholazorlar üzerinde bulunabileceği söyleniyor, o yüzden biz de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050114
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050114,
					"content": "Kaplıca Halkından bir rehberin yardımı olmadan onlara yaklaşmaya çalışmak pek akıllıca bir hareket değildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050115
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050115,
					"content": "Gizemli bir ada mı dedin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050116,
					"content": "Evet. Kaplıca Halkının bir efsanesinde gizemli bir adanın bahsi geçiyor. Viramdra da araştırmasının kilit noktasının o adada olduğuna inanıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050117
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050117,
					"content": "Öhöm... Yakalama teklifimi düşünmeyecek misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050118
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150050118,
					"content": "Ne teklif ama... Bir insanı canlı yem olarak kullanacak halimiz yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050119,
					"content": "O halde bu konuyu daha fazla konuşmamızın bir anlamı yok. Başka bir çözüm bulmam gerekecek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050120
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150050120,
					"content": "Öhöm... Viramdra!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050121
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050121,
					"content": "Ha, doğru... Karya'yla beni kurtardığınız için sanırım size minnetimi ifade etmem lazım. Çok sağ olun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050122
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150050122,
					"content": "Biraz tuhaf oldu ama Paimon kabul ediyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050123,
					"content": "Yolumuza devam edelim Karya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050124
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150050124,
					"content": "Evet, tekrar teşekkür ederiz. Kusurumuza bakmayın... Viramdra'nın sosyal becerileri biraz zayıftır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050125
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050125,
					"content": "Sorun değil, güle güle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050126,
					"content": "Ne ilginç bir ikiliydi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050127,
					"content": "Neyse, Paimon şu hanımefendinin bahsettiği gizemli adayı çok merak etti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050128,
					"content": "Sen de mi adayı bulmak istiyorsun Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050129
					]
				},
				{
					"id": 150050129,
					"content": "Evet! Kim bilir, belki hazine vardır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050130,
					"content": "Bugüne kadar maceralarımızda keşfettiğimiz onca müthiş yere kıyasla gizemli bir adayı bulmak bizim için çocuk oyuncağı olmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050131,
					"content": "Ama bu adaya dair hiçbir şey bilmiyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050132
					]
				},
				{
					"id": 150050132,
					"content": "Aa, doğru... Hanımefendi bu gizemli adanın bir Kaplıca Halkı efsanesiyle bağlantısı olduğunu söylemişti... Belki onlara sorarak başlayabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050133,
					"content": "Zamanı geldi. Hadi yeni bir maceraya çıkalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050134,
					"content": "Ancak asıl soru şu... Kime soracağız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050135,
					"content": "Şefle konuşsak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050136
					]
				},
				{
					"id": 150050136,
					"content": "Hımm... Olabilir. Ayrıntıları bilse bilse kabile şefi biliyordur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
