			"dialogs": [
				{
					"id": 150050201,
					"content": "Vay be, ne güzel manzara! Koholazorlar da var! Aa, bir iki tanesiyle fotoğraf çekilmeye çalışalım mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050202,
					"content": "Ya bizi ısırırlarsa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050203
					]
				},
				{
					"id": 150050203,
					"content": "Ama... Çok sevimliler ya, öyle bir şey yapmazlar, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050204,
					"content": "Hı? Ne oluyor orada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050205,
					"content": "Yardım edin! Ne olur yardım edin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050206
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150050206,
					"content": "Aa! Vahşi Koholazorlar gerçekten insanları ısırıyorlar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150050207,
						150050209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050207,
					"content": "Günü kurtarma zamanı!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050208
					]
				},
				{
					"id": 150050208,
					"content": "#Evet, şu ikilinin başı belada! Efsanevi {NICKNAME} ve sadık yardımcısı Paimon buna seyirci kalamaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150050209,
					"content": "Bizim fotoğraflar başka zamana kaldı anlaşılan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150050210
					]
				},
				{
					"id": 150050210,
					"content": "Evet, onları sonra çekeriz! Yardım isteyen birileri varken boş duramayız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
