			"dialogs": [
				{
					"id": 220130601,
					"content": "Anlatın bakalım, nasıl geçti? Okurların ne düşün...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130602
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130602,
					"content": "... Ne oldu ya? Bunun yüzünden düşen bin parça... Okurlardan nasıl geri bildirimler aldınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130603
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130603,
					"content": "*iç çeker* Peki Junkichi, geri bildirimleri kabul ediyor musun şimdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130604
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130604,
					"content": "İnanılır gibi değil... Nasıl böyle oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130605
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130605,
					"content": "Fikirlerim... ve yazdıklarım... yeterince ilginç değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130606
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130606,
					"content": "Demiştim sana, olay örgüsünü sırf karaktere yeni güçler vererek ilerletmek tehlikeli olabilir demiştim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130607
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130607,
					"content": "Eklediğin yetenekler kısa süreliğine ilgi çekti ancak okurlar alışınca sıkılmaya başladılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130608
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130608,
					"content": "Yılların tecrübesiyle konuşuyorum, biliyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130609
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130609,
					"content": "Biliyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130610
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130610,
					"content": "Değiştirmek için çok geç değil... Önceki bölümlere gelen eleştirileri tersine çeviremeyiz ama sonraki bölümleri yeniden sağlam temellere oturtabiliriz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130611
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130611,
					"content": "Teşekkürler Gezgin. Aslında şu an bu tokadı yemesi iyi oldu. Böyle yazmaya devam etseydi durumu daha kötüye gidecekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130612
					],
					"speakerTitle": "Shigeru"
				},
				{
