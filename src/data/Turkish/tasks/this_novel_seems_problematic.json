				"points": []
			},
			"dialogs": [
				{
					"id": 220130401,
					"content": "Merhaba, size nasıl yardımcı olabilirim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130402
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130402,
					"content": "Merhaba. \"Dövüş Sanatları\"nı okudunuz mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130403
					]
				},
				{
					"id": 220130403,
					"content": "Evet, okudum! Çok ilginç bir roman. Karakterleri ve olay örgüsü harika.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130404
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130404,
					"content": "Ama... Yazar son zamanlarda biraz özensiz yazıyor bence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130405
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130405,
					"content": "Hı... Şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130406
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130406,
					"content": "Önceki sayılarda hiç bahsedilmediği halde birden bir sürü yeni yetenek ortaya çıkıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130407
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130407,
					"content": "Buna \"yeteneği fark ediş\" dense de bana ucuz geldi açıkçası.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130408
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130408,
					"content": "Bence bu tarz ucuz olay örgüleri karakteri de ucuz gösteriyor. Umarım yazar bu gidişatı tekrar gözden geçirir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130409
					],
					"speakerTitle": "Hasegawa"
				},
				{
					"id": 220130409,
					"content": "Gezgin, şey... Gidip başka birine soralım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
