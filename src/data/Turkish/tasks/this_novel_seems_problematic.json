			"dialogs": [
				{
					"id": 220130501,
					"content": "Merhaba, sohbet etmek ister misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130502
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 220130502,
					"content": "Tabii. \"Dövüş Sanatları\"nı okudunuz mu acaba?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130503
					]
				},
				{
					"id": 220130503,
					"content": "Okudum. Ana karakteri de çok seviyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130504
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 220130504,
					"content": "Ama son zamanlarda okumakta zorlanıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130505
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 220130505,
					"content": "Zorlanıyorum derken?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130506
					]
				},
				{
					"id": 220130506,
					"content": "Son birkaç bölümde ana karaktere durduk yere bir sürü yeni yetenek verildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130507
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 220130507,
					"content": "Yazar hikayede karakterin bu yetenekleri nasıl fark ettiğini ve nasıl kullanabileceğini anlatmak için fazla vakit harcıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130508
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 220130508,
					"content": "Ayrıca yeteneklerin isimlerini takip etmek de gittikçe zorlaşıyor. Hiçbirini hatırlayamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130509
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 220130509,
					"content": "Okumaya devam etsem bile bu yetenekleri anlamadan hikayeyi takip edebileceğimi sanmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130510
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 220130510,
					"content": "*iç çeker* Açıkçası kitaba biraz ara verip takip etmesi daha kolay bir şeye geçmeyi düşünüyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130511
					],
					"speakerTitle": "Rie"
				},
				{
					"id": 220130511,
					"content": "Şey... Biz en iyisi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130512
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130512,
					"content": "Biz en iyisi dönelim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130513
					]
				},
				{
					"id": 220130513,
					"content": "Peki... Niye böyle oldu anlamıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
