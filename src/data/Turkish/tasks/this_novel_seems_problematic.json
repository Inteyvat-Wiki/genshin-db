			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shigeru",
					"Junkichi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220130101,
					"content": "Okurların geri bildirimlerini okudun mu? Aldığımız eleştiriler son zamanlarda kötüye gidiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130102
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130102,
					"content": "Merak etme. Hikayenin muhteşem zirvesinden önceki sessizlik bu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130103
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130103,
					"content": "Olay örgüsünün kilit noktasını okuduklarında bu eleştiriler tersine dönecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130104
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130104,
					"content": "Romanın sen o zirveye varamadan iptal edilirse ne olacak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130105
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130105,
					"content": "Neler oluyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130106
					]
				},
				{
					"id": 220130106,
					"content": "Gezgin, iyi ki geldin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130107
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130107,
					"content": "Junkichi, romanı \"Dövüş Sanatları\"nda ana karaktere çılgın yetenekler eklemeye devam ediyor. Şu \"ilham gezisinden\" beridir eklediği yeteneklerin ardı arkası kesilmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130108
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130108,
					"content": "Yae Yayınevi okurlardan çok sayıda olumsuz geri bildirim aldı. Okurlar bu yeteneklerin neden oraya çıktığını anlamadıklarını söylüyor. Yazarın hikayeyi ciddiye almadığını düşünüyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130109
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130109,
					"content": "Onların bir halt bildiği yok. Yazmaya devam edeceğim, bir noktada illaki anlayacaklar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130110
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130110,
					"content": "Diyorum sana, romanın o bir noktaya gelemeden iptal edilecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130111
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130111,
					"content": "Aman, neyse... Hatırladığım kadarıyla bu civarda birkaç \"Dövüş Sanatları\" okuru vardı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130112
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130112,
					"content": "Gidip onlara bu fikir mantıklı mı diye sorabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130113
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130113,
					"content": "İyi! Beni anlayacaklarına eminim. Gezgin, benimle gel. Buna şahitlik etmen lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130114
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130114,
					"content": "Evet, iyi fikir. Gezginle beraber gidin. Böylece döndüğünde insanların sana söyleyeceklerini inkar edemezsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130115
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130115,
					"content": "Hadi gidelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130116
					]
				},
				{
					"id": 220130116,
					"content": "Tamam, hadi o zaman. Okurlarımın beni anlayacağına eminim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130117
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130117,
					"content": "Yetenekleri ne kadar abarttın ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130118
					]
				},
				{
					"id": 220130118,
					"content": "Çok değil... Birazcık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130119
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220130119,
					"content": "\"Birazcık\" mı? Ana karakter yakında hikayedeki diğer tüm karakterlerin toplamından daha fazla yeteneğe sahip olacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130120
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220130120,
					"content": "Öhöm! Haydi gidelim artık. Okurlarımın anladığına eminim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
