			"dialogs": [
				{
					"id": 220130301,
					"content": "Merhaba, buyurun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130302
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130302,
					"content": "Merhabalar. \"Dövüş Sanatları\"nı okudunuz mu acaba?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130303
					]
				},
				{
					"id": 220130303,
					"content": "Hı? Okudum, beğendim de. Ama... Nasıl desem? Son zamanlarda olay örgüsü biraz garipleşti sanki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130304
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130304,
					"content": "Ana karakter sürekli yeni yetenekler kazanıyor ve bu yeteneklerle düşmanlarını hemen yeniyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130305
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130305,
					"content": "\"Dövüş Sanatları\"nı sevme sebebim ana karakterin düşmanlarını yenmek için zekice yöntemler kullanmasıydı... Ama şu an yazar kolaya kaçıyormuş gibi geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130306
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130306,
					"content": "Ayrıca, ana karakter kazandığı yeteneklerin çoğunu sadece bir kez kullanıyor. Bu da hikayeyi... Nasıl desem? Ciddiyetsiz gösteriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130307
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130307,
					"content": "Yazar ne düşünüyor bilmiyorum gerçekten...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130308
					],
					"speakerTitle": "Yuzu"
				},
				{
					"id": 220130308,
					"content": "Öhöm... Peki... Birkaç kişiye daha soralım, olur mu? Böyle düşünen nadir okurlardan birine denk geldik herhalde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
