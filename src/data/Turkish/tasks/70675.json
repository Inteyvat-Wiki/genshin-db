			"dialogs": [
				{
					"id": 706750101,
					"content": "Pekala, Prens'in Davet Panosunda yaptığı değişikliklerden sonra artık davetiyesi olan herkes bu özel odada seninle düello yapabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706750102
					],
					"speakerTitle": "Shuyun"
				},
				{
					"id": 706750102,
					"content": "Yani arkadaşlarının kalkıp buraya kadar seyahat etmelerine gerek kalmadı. Dahası, düello için gelenler bu odada kalabilir. Kim olursa olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706750103
					],
					"speakerTitle": "Shuyun"
				},
				{
					"id": 706750103,
					"content": "Ha? \"Bir kedinin böyle şeyler yapması imkansız\" da ne demek? Hıh, siz Prensi hâlâ tanımamışsınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706750104
					],
					"speakerTitle": "Shuyun"
				},
				{
					"id": 706750104,
					"content": "Yani, kedilerin neler yapabileceği ile ilgili bir fikriniz yok demek istiyorum! Her neyse, istediğiniz zaman yeni davet panosunu kullanarak arkadaşlarınızı özel odada düelloya davet edebilirsiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shuyun"
				}
			]
		}
	]
