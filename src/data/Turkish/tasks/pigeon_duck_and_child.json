				},
				{
					"id": 200480302,
					"content": "Lütfen bir daha buradan geçerken güvercinleri korkutmamaya çalış. Onları sonra zar zor geri getiriyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480303
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480303,
					"content": "İleride daha dikkatli olmaya çalışacağım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200480304
					]
				},
				{
					"id": 200480304,
					"content": "Tamamdır. Seni affediyorum. Al, sana Mondstadt mücveri vereyim. Bunlara bayılıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480305
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480305,
					"content": "Annem hep başkalarına kibar davranmam gerektiğini söyler.",
					"roleType": "TALK_ROLE_NPC",
