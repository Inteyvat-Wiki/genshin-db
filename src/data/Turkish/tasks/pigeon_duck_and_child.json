			},
			"dialogs": [
				{
					"id": 200480101,
					"content": "Ah! Yine SEN! Tüm güvercinlerimi korkutup kaçırdın. Yine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480102
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480102,
					"content": "Güvercinleri besliyordum. Bu konuda ne diyeceksin bakalım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480103
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480103,
					"content": "Ah be...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200480104
					]
				},
				{
					"id": 200480104,
					"content": "Neyse. Annem hep \"Birisi üzgünse bunu sözleriyle değil hareketleriyle gösterir.\" der.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480105
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480105,
					"content": "Köprüdeki güvercinler benim arkadaşlarım. Onları hep beslerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480106
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480106,
					"content": "Ama şu sıralar ördekler gelip yemeklerini çalıyor ve güvercinler yeteri kadar beslenemiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480107
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480107,
					"content": "Üç dal buğday bulup ördekleri onlarla beslemeni istiyorum. Sen onu yaparken ben de köprü güvercinlerinin yeterli beslenmesini sağlayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480108
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480108,
					"content": "İki taraf da karınlarını güzelce doyurduğunda belki herkes arkadaş olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480109,
						200480110
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480109,
					"content": "Elbette.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200480111
					]
				},
				{
					"id": 200480111,
					"content": "Teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480112
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480112,
					"content": "Hayvanlara iyi davranırsan sen de onlarla arkadaş olabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480110,
					"content": "Güvercinlerle dost olmak istemiyorum ki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200480113
					]
				},
				{
					"id": 200480113,
					"content": "Arkadaşları olmak istesen de istemesen de... Onlara bir özür borçlusun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200480114
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 200480114,
					"content": "Şimdi hemen git de buğday topla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				}
			]
		},
