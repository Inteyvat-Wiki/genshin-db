						721130505
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130505,
					"content": "Bakalım şansımız nasılmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130506,
					"content": "Ah, evet. Her gün yalnızca bir fal kağıdı çekebilirsin, lütfen unutma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130507
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130507,
					"content": "Diğer türlü çok yorucu oluyor... Dur, hayır. Yoksa Fal Kağıdı Askısını kullanamazsın... Hayır, yanlış oldu. Ne diyecektim ben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130508
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130508,
					"content": "\"Fal kağıtları hükümdarımızın iradesinin göstergesidir. Biz ölümlülere tevazuyla karşılamak ve elimizden geleni yapmak düşer.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130509
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130509,
					"content": "Nasıl ama? Gayet güzel bir açıklama bence. Unutma, her gün yalnızca bir fal kağıdı çekebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gendou Ringo"
				}
			]
		},
