			"dialogs": [
				{
					"id": 721131001,
					"content": "Sen tam olarak kimsin ve niyetin ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131002
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131002,
					"content": "Onu biz söyleyecektik! Bayan Gendou neden bize öyle saldırdın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131003,
					"content": "Ne kadar da kabasınız. Sorumu cevaplayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131004
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131004,
					"content": "#Ben {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131005
					]
				},
				{
					"id": 721131005,
					"content": "Adlarınızı zaten biliyorum. Şimdi gizli kodu nereden duyduğunu söyle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131006,
						721131008
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131006,
					"content": "Bana Paimon söyledi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131007
					]
				},
				{
					"id": 721131007,
					"content": "Dur, ne diyorsun sen? Çabuk Bayan Gendou'ya ne olduğunu anlat! Gözlerindeki acayip korkunç bakışı görmüyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131010,
					"content": "Anladım. Yani bu notlara rastladın. Öyleyse Momoka...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131011
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131011,
					"content": "Momoka kim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131012
					]
				},
				{
					"id": 721131012,
					"content": "O notları yazan kişi, ayrıca benim de meslektaşımdı. Ne yazık ki bundan böyle Inazuma'ya hizmet etmeye devam edemeyecek. Gerçekten çok yazık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131013
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131013,
					"content": "Eminim bir sürü sorun vardır. Yanıtlamaktan zarar gelmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131014
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131014,
					"content": "Momoka'yla ikimiz Shuumatsuban ninjasıydık. Görevimiz Inazuma'yı dış tehditlere karşı korumaktı ve bu \"kağıttan şeritler\" de görevlerimizle ilgili iletişim kurma yollarımızdan biriydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131015
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131015,
					"content": "Bundan ötürü çok fazla kin ve tehlikeyle karşı karşıya kaldık. Mesela ulusumuza sızan tehlikeli insanlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131016,
						721131018
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131016,
					"content": "Mondstadtlılar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131017
					]
				},
				{
					"id": 721131017,
					"content": "Mondstadtlılarla ne alakası var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131020,
					"content": "Silah arkadaşlarımızı birbirinden ayırt etmek için gizli kodlar kullanırız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131021
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131021,
					"content": "Herkesin gizli kodu kişiye özeldir. Momoka gizli kodunu bizi durumdan haberdar etmek için bırakmış olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131022
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131022,
					"content": "... Momoka da bu gizli kodu kullanmak isteyen düşmanları yemlemeye çalışıyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131023
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131023,
					"content": "Yani...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131024
					]
				},
				{
					"id": 721131024,
					"content": "Sen de hemen olayı anladın, değil mi Bayan Gendou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131025
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131025,
					"content": "Tabii ki, bu yüzden durumun aslını öğrenmem gerekiyordu ama gerçekten çok tuhaftı, tam anlamıyla çözemedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131026
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131026,
					"content": "Gerçekten Snezhnaya casuslarıysanız neden durumu Fatui'ye bildirmeden görevi emredildiği şekilde yerine getirdiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131027
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131027,
					"content": "Öyleyse terk edilmiş kampla ilgili hikayene inanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131028
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131028,
					"content": "Hareketlerinizden anladığım kadarıyla gizli kodu başta sadece meraktan eşleştirdiniz, siz ikiniz Inazuma'nın düşmanı değil, dostusunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131029
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131029,
					"content": "Adımızı aklamış olduk ama Paimon bizi tüm bu zaman boyunca ücretsiz iş gücü olarak kullanmana biraz içerledi Bayan Gendou!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131030
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131030,
					"content": "O kişi cidden sen miydin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131031
					]
				},
				{
					"id": 721131031,
					"content": "Hımm, görüyorum ki farkına varmışsın zaten. Sana sonrasında görev veren Gendou tam bir sahtekar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131032
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131032,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131033
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131033,
					"content": "Sizin izinizi sürerken Fatui casusları peşime düştü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131034
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131034,
					"content": "Ninja sanatları konusunda hiç fena sayılmam. Onları kandırmak için kendimi ölmüş gibi gösterdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131035
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131035,
					"content": "Sonrasında kendilerinden birini benim kılığıma sokup benim yerime koydular.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131036,
						721131037
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131036,
					"content": "Kişiliğinin farklı olmasından anlamalıydık.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131038
					]
				},
				{
					"id": 721131038,
					"content": "Ne? Yani o nazik Bayan Gendou taklitçi miydi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131039
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131039,
					"content": "\"Kibar\" mı? Herhalde kendisi epey popüler olmalı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131040
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131040,
					"content": "Nihayetinde seni resmi bir Shuumatsuban üyesi zannedip organizasyona sızmak için seni kullanmaya çalışmışlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131041
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131041,
					"content": "Durum benim de işime geldi. Taklitçinin yerimi alması, kendi yöntemlerimi kullanarak sizi buraya çekme fırsatı verdi bana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131042
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131042,
					"content": "İyi dinleyin. Şimdi size bir teklif yapacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131043
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131043,
					"content": "Dışarıdan bizim için çalışın. Hâlâ hayatta olduğumdan haberleri yok. Şartlar bizim lehimize.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131044,
						721131047,
						721131048
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131044,
					"content": "Ya reddedersek?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131045
					]
				},
				{
					"id": 721131045,
					"content": "Bunu deneyebilirsiniz elbette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131046
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131046,
					"content": "#Fatui bizim de düşmanımız {NICKNAME}! İş birliği yapmanın ne zararı olur ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131049
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721131049,
					"content": "Doğru bir karar verdin. Burada bulunan tüm kaynakları dilediğin gibi kullanabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131050
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131050,
					"content": "Herhangi bir gelişme olması halinde sizinle iletişime geçeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131051
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131051,
					"content": "İş birliğimizin verimli olmasını dilerim. Hoşça kalın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131052
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131047,
					"content": "Mantıklı bir teklif.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131049
					]
				},
				{
					"id": 721131048,
					"content": "Peki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131049
					]
				},
				{
					"id": 721131037,
					"content": "Fal Kağıdına bakarken doğru ismi kullanmasından belliydi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131038
					]
				},
				{
					"id": 721131018,
					"content": "Fatui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131019
					]
				},
				{
					"id": 721131019,
					"content": "Evet, doğru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131020
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721131008,
					"content": "Lütfen beni dinle. Şöyle oldu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131009
					]
				},
				{
					"id": 721131009,
					"content": "Tepede terk edilmiş bir kamp bulduk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131052
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}