					"speakerTitle": "Paimon"
				},
				{
					"id": 721130802,
					"content": "Biraz ürkütücüydü...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130803
					]
				},
				{
					"id": 721130803,
					"content": "Bence de. Ya geri dönmezse? Paimon bugün talihinin nasıl olacağını öğrenemeyecek mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130804,
					"content": "Ne? Burada bir kağıt var. Paimon bakmak istiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130805,
					"content": "Bakmamız doğru olmaz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130806
					]
				},
				{
					"id": 721130806,
					"content": "Ne olacak? Belki bir ipucudur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130807,
					"content": "Hı? Bu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130808,
					"content": "Sanırım bir sonraki adımı öğrenmek için... Buraya gitmemiz gerekiyordur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130809,
					"content": "Hadi gidip bakalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
