					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130402,
					"content": "Ne? Kötü talih bu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130403,
					"content": "Paimon ne yapman gerektiğini biliyor! Neydi şu şey... Hah, \"Kötü talih yazan kağıdı Fal Kağıdı Askısına asın.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130404,
					"content": "\"Sonra da Paimon'a güzel şeyler yedirin. Böylece kötü talihiniz iyi talihe dönecektir!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130405,
					"content": "Öyle mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130406
					]
				},
				{
					"id": 721130406,
					"content": "Tabii ki! Kadim bilgeliği sorgulamaya mı kalkıyorsun yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130407,
					"content": "Ne güzel şey şu kadim bilgelik! Neyse, hadi gidip şu Fal Kağıdı Askısını bulalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
