			"dialogs": [
				{
					"id": 721130701,
					"content": "Bayan Gendou'nun tutumu yine her zamanki gibi... Her neyse, kağıdın içeriğine bir bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130702,
					"content": "Hı? Bu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130703,
					"content": "Haa, Paimon şimdi anladı. Yenmemiz gereken kötü bir adam varmış!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130704,
					"content": "Evet, öyle olsa gerek. Bayan Gendou, şimdi sen iletişim için bu yolu kullanarak Inazuma'ya zarar vermeye çalışanları ortadan kaldıran bir gizli ajansın, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130705,
					"content": "Çok konuşuyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130706
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130706,
					"content": "Şey! Üzgünüm! Lütfen \"Shuumatsu\"yu üstümüze salma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130707,
					"content": "Gidin artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130708
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130708,
					"content": "Hemen gidiyoruz! Resimdeki yere gidip hedefimiz orada mı bir bakalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
