			"dialogs": [
				{
					"id": 721130601,
					"content": "Ha? Bu nedir? Birilerinin notlarına benziyor. Paimon şöyle bir baksın bakalım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130602,
					"content": "\"... Shuumatsu... Fatui... Komplo...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130603,
					"content": "Bu neydi şimdi? Karman çorman, her tarafı lekelerle kaplı. Paimon bir türlü okuyamadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130604,
					"content": "Bir hazineye ipucu olabilir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130605
					]
				},
				{
					"id": 721130605,
					"content": "Mantıklı! Paimon bir daha bakmak istiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130606,
					"content": "\"Fal kağıdının şifresini çözerken, gizli kodun...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130607,
						721130608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130607,
					"content": "Fal kağıdının şifresini çözerken mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130609
					]
				},
				{
					"id": 721130609,
					"content": "Paimon'a da göster! İlk bölümünde \"Puslu bir gece yarısında...\" yazıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130610,
					"content": "Burada yarıda kesiliyor ve Paimon diğer yarısının ne olduğunu çıkaramıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130611,
					"content": "Ama gizli bir kod kullandığına göre bulunması gereken bir sır da vardır değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130612,
					"content": "Her halükarda önemli görünüyor. Bir dahaki sefere fal kağıdımızın şifresini çözerken gizli kodları da eşleştirmeye çalışalım mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130608,
					"content": "Gizli kod mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130609
					]
				}
			]
		},
