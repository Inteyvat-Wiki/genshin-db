			},
			"dialogs": [
				{
					"id": 721130101,
					"content": "Fal kağıdı mı istiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130102
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130102,
					"content": "Of, amma soğuk biri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130103,
					"content": "Evet, fal kağıdı alacaktım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130104
					]
				},
				{
					"id": 721130104,
					"content": "Tamam. Başla bakalım. Önce şu şeyi... Onu güzelce salla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130105
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130105,
					"content": "Bu Fal Kağıdı Kutusu değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130106
					]
				},
				{
					"id": 721130106,
					"content": "Evet. İçinden Bambu Çubuğu düşecek. Çubuğu bana vereceksin, ben de sana eşleşen kağıt parçasını vereceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130107
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130107,
					"content": "Fal Kağıdı çekmeye gelmemiş miydik...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130108
					]
				},
				{
					"id": 721130108,
					"content": "Neyse ne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130109
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130109,
					"content": "Paimon'un bir sorusu var! Eğer... Kötü şans yazan bir kağıt çekersek ne olur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130110,
					"content": "Kaderin öyleyse yapacak bir şey yok. Beğenemedin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130111
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130111,
					"content": "Ne!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130112,
					"content": "Şu raf benzeri şeyi kullanarak şey yapamaz mıyız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130113
					]
				},
				{
					"id": 721130113,
					"content": "Olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130114
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130114,
					"content": "\"Olmaz\" mı dedi o?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130115,
					"content": "Bir bakayım. Evet, okuyorum. \"Kötü talih yazan kağıdı Fal Kağıdı Askısına asarsanız talihiniz iyiye döner...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130116
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130116,
					"content": "Ha, peki! Falınızda kötü şans çıkarsa şuradaki rafa bağlarsanız sorununuz çözülür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130117
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130117,
					"content": "Peh, şunlara bak sen... Pardon, kusura bakmayın. Büyük Narukami Tapınağı sakinleri olarak nezaketimizle nam salmış kimseleriz. Kötü şans getiren kağıt çekseniz de durumu tersine döndürmeniz mümkündür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130118
					],
					"speakerTitle": "Gendou Ringo"
				},
				{
					"id": 721130118,
					"content": "Bir şeyler doğru değil gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721130119,
					"content": "#Hadi {NICKNAME}, bir kağıt çekelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
