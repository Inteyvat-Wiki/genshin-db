					"Ruu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722270101,
					"content": "İkiniz savaşırken çok havalı görünüyorsunuz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270102
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270102,
					"content": "Ruu, sen de buradaymışsın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270103,
						722270104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270103,
					"content": "İyi misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270105
					]
				},
				{
					"id": 722270105,
					"content": "Merak etmeyin iyiyim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270106
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270106,
					"content": "Canavarlar hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270108
					]
				},
				{
					"id": 722270108,
					"content": "Nereden geldiklerini ben de bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270109
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270109,
					"content": "Buradan gelmedikleri kesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270110,
					"content": "Hı hı. Geçmişte adada bu tarz canavarlar yoktu. Tüylü insanlar veya büyük makinalar da yoktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270111
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270111,
					"content": "Geçmişte \"Wen Kamuy\" dediğimiz adaya özgü hayvanlar vardı. Çok uysaldılar... Aynı zamanda çok da lezzetliydiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270112
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270112,
					"content": "Bayağıdır ortalıkta görünmüyorlar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270113
					]
				},
				{
					"id": 722270113,
					"content": "Ben de bunu düşünüyordum. Tam ne zaman olduğunu bilmiyorum ama sanki bir anda hepsi yok oldu ve yerlerine bu canavarlar geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270114
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270114,
					"content": "Belki de Sis Denizi'nin ötesinden gelmişlerdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270115
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270115,
					"content": "Diğer yerlerde de dağ yabanileri var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270116
					]
				},
				{
					"id": 722270116,
					"content": "Bu çok tehlikeli değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270117,
						722270119
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270117,
					"content": "Zaman zaman, evet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270118
					]
				},
				{
					"id": 722270118,
					"content": "Tabii maceraya atılmak çok eğlenceli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270120,
					"content": "Ben de maceraya atılmayı çok isterdim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270121
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270121,
					"content": "Hehe. Paimon, büyüdüğünde harika bir maceracı olacağından emin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270122,
					"content": "Aynen öyle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270123
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270123,
					"content": "Bu tüneği de bize bırakın. Etrafta canavarlar var, sağa sola koşturursanız kendinizi tehlikeye atabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270124,
					"content": "Bunu bize bırakın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 722270119,
					"content": "Yine de maceraya atılmak çok eğlenceli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270120
					]
				},
				{
					"id": 722270104,
					"content": "Umarım yaralanmamışsındır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270105
					]
				}
			]
		},
		{
			"id": 7222702,
