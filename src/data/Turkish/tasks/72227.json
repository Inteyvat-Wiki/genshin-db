					"Ruu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722270301,
					"content": "Görünüşe göre buradaki işimiz bitti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270302,
					"content": "Vay be, demek gerçek bir maceracı böyle oluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270303
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270303,
					"content": "Buraya daha önce başkaları da gelmişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270304
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270304,
					"content": "Ancak hiçbiri sen ve Paimon gibi güçlü değildi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270305
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270305,
					"content": "Diğerleri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270306,
					"content": "Evet, Maushiro için gelmişlerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270307,
						722270308
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270307,
					"content": "O halde Sumida...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270309
					]
				},
				{
					"id": 722270309,
					"content": "Paimon, tam olarak anlamadı. Bu Maushiro dediğin ne? Buradaki insanların kullandığı yöresel müzik aleti olduğunu duymuştuk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270310,
					"content": "Doğru. Ses falan çıkartıyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270311
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270311,
					"content": "Bu siste görüş mesafemiz çok kısa, değil mi? Bu yüzden diğerlerine nerede olduğumuzu haber vermek için Maushiro kullanıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270312
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270312,
					"content": "Açıkçası bağırmaktan çok daha iyi. Bağırmak boğazı çok acıtıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270313
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270313,
					"content": "Burnumuzun ucunu bile göremiyoruz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270314,
					"content": "Değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270315
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270315,
					"content": "Bunlar gerçekten çok önemli. Ba... Mata Dede'nin dediğine göre Maushiro siste kaybolmuş ruhların evlerini bulmalarına da yardım ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270316
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270316,
					"content": "O kadar önemliler demek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270317,
					"content": "Seremonide ihtiyacınız olmasına şaşmamalı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270318
					]
				},
				{
					"id": 722270318,
					"content": "Doğru. Eminim ikinizin de çok hoşuna gidecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270319
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270319,
					"content": "Siz önden gidin. Ağacın altında biraz daha vakit geçirmek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270320
					],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270320,
					"content": "İyi olacağına emin misin? Canavarlar olabilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722270321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722270321,
					"content": "Sorun yok, dikkat ederim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruu"
				},
				{
					"id": 722270308,
					"content": "Katheryne'in bu göreve neden zor dediği şimdi belli oldu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722270309
					]
				}
			]
		},
