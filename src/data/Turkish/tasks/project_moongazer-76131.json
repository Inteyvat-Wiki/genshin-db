					}
				]
			},
			"dialogs": [
				{
					"id": 761310501,
					"content": "Hı? Yer çekimi normale döndü sanki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310502,
					"content": "Columbina! Geri döndün! Az önceki sorunu sen mi çözdün? İşte mükemmel zamanlama diye buna denir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310503,
					"content": "Çok endişelendik! Neredeydin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310504,
					"content": "İyi misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761310505
					]
				},
				{
					"id": 761310505,
					"content": "Özür dilerim. Bu üssün derinlerinin, ayın çekirdeğine çıkmasını beklemiyordum. Burada son derece yüksek yoğunluklu kadim ay enerjisi var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310506
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761310506,
					"content": "Bu üssü Kuuvahki ile doldurduğumda onunla kazara temas etmiş bulundum ve ayın çekirdeğine sürüklendim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310507
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761310507,
					"content": "Demek gerçekten oraya gittin. Paimon bu üssün perili olduğunu düşünmeye başlamıştı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310508,
					"content": "Neyse, Paimon iyi olduğuna sevindi! Ay Gözcüsü Projesi hakkında bazı yeni bilgiler keşfettik. Şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310509,
					"content": "Ben gerçeği ayın çekirdeğinde öğrendim bile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310510
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761310510,
					"content": "Senin de kim olduğunu öğrendim Ninnin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310511
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761310511,
					"content": "Görevim orada olmalı. Beni oraya götür lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310512
					],
					"speakerTitle": "Yumyum"
				},
				{
					"id": 761310512,
					"content": "Hımm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310513
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761310513,
					"content": "Sorun nedir, Columbina? Sanki onun oraya gitmesini istemiyor gibisin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310514,
					"content": "Ninnin... Ayın çekirdeğinde hayatta kalamaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310515
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761310515,
					"content": "Ama görevimi tamamlamalıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310516
					],
					"speakerTitle": "Yumyum"
				},
				{
					"id": 761310516,
					"content": "Anlıyorum ama görevin orada değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310517
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761310517,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310518
					],
					"speakerTitle": "Yumyum"
				},
				{
					"id": 761310518,
					"content": "Görevin ayın çekirdeğinde tamamlanmayacak. Aksine, her şeyin başladığı yerde bulacaksın onu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310519
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761310519,
					"content": "Ibni-Belum'un Gözünde mi yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310520,
					"content": "Evet, görevin Gözün içinde Ay Gözcüsü Projesini etkinleştirmek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310521
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761310521,
					"content": "Bunun için kadim ayın gücünden yapılmış bir veri anahtarı gerekiyor. Onu senin için almak üzere ayın çekirdeğine bir kez daha gidebilirim ama bu biraz zaman alacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310522
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761310522,
					"content": "Benden... Göze geri dönüp beklememi mi istiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310523
					],
					"speakerTitle": "Yumyum"
				},
				{
					"id": 761310523,
					"content": "Senin için uygun olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310524
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761310524,
					"content": "... Hayır. Eğer anahtarı kendim alamıyorsam... Seni burada bekleyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310525
					],
					"speakerTitle": "Yumyum"
				},
				{
					"id": 761310525,
					"content": "Sen geri dönmezsen... Ben de gitmeyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310526
					],
					"speakerTitle": "Yumyum"
				},
				{
					"id": 761310526,
					"content": "Burada kalıp... Arkadaşımın geri dönmesini beklemek istiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310527
					],
					"speakerTitle": "Yumyum"
				},
				{
					"id": 761310527,
					"content": "Anlıyorum. Teşekkürler Ninnin. Hemen döneceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310528
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761310528,
					"content": "Ben de seninle geliyorum Columbina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761310529
					]
				},
				{
					"id": 761310529,
					"content": "Madem ısrar ediyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310530
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761310530,
					"content": "B-Bir dakika, Yumyum ne olacak? Onu gerçekten burada tek başına mı bırakacağız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310531
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310531,
					"content": "Merak etme, Maagees'e mesaj gönderdim, yola çıktı bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310532
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761310532,
					"content": "Burada kaldığı sürece, bu üste ona zarar verebilecek başka hiçbir şey yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310533
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761310533,
					"content": "Paimon yine de biraz endişeli. Belki burada kalıp Yumyum'a eşlik etse daha iyi olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310534
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310534,
					"content": "Hı? Ayın çekirdeğinin neye benzediğini görmek istemiyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310535
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761310535,
					"content": "Evet ama Yumyum'u burada tek başına bırakırsak kendini yalnız hisseder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310536
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310536,
					"content": "Ayrıca Lusalim'in kızıymış ve bunu... Daha yeni öğrendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310537
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310537,
					"content": "Bu tür haberleri sindirmek genelde biraz zaman alır. Ve başa çıkmak kolay değildir. Ya kafaya takıp kaçarsa ve tehlikeli bir yerlere düşerse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310538
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310538,
					"content": "O yüzden Paimon burada onunla kalıp Maagees'i bekleyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310539
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310539,
					"content": "Ama geri dönüp gördüklerinizi Paimon'a anlatın, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310540
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310540,
					"content": "Teşekkürler Paimon. Gözümdeki değerin bir kez daha arttı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310541
					],
					"speakerTitle": "Yumyum"
				},
				{
					"id": 761310541,
					"content": "Öyleyse Paimon da senin atıştırmalık payını bir birim artırıyor! Artık üçü senin, yedisi Paimon'un.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310542
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310542,
					"content": "Paimon ablalık yapıyor resmen... Ne kadar da çabuk büyüyorlar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761310543
					]
				},
				{
					"id": 761310543,
					"content": "Hıh, bu kadar şaşıracak ne var? Paimon da Yumyum'un büyümesini izledi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310544
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310544,
					"content": "Hadi hadi, gidin! Ne kadar çabuk giderseniz, o kadar çabuk dönersiniz. Bizi çok bekletmeyin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310545
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310545,
					"content": "#Tamam. {NICKNAME}, benimle gel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				}
			]
		},
