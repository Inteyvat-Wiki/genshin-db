			"dialogs": [
				{
					"id": 761310601,
					"content": "Harika! İşte bir terminal daha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310602,
					"content": "Hünerlerini gösterme zamanı Yumyum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310603,
					"content": "Terminal etkinleştirildi. Üs verileri talep ediliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310604
					],
					"speakerTitle": "Yumyum"
				},
				{
					"id": 761310604,
					"content": "Üs verileri alındı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310605
					],
					"speakerTitle": "Yumyum"
				},
				{
					"id": 761310605,
					"content": "Ay Gözcüsü Projesi aranıyor... Veri yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310606
					],
					"speakerTitle": "Yumyum"
				},
				{
					"id": 761310606,
					"content": "Lusalim aranıyor... İşte burada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310607
					],
					"speakerTitle": "Yumyum"
				},
				{
					"id": 761310607,
					"content": "Lusalim'in araştırma laboratuvarını buldum. Bu üssün içinde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310608
					],
					"speakerTitle": "Yumyum"
				},
				{
					"id": 761310608,
					"content": "Haha, turnayı gözünden vurduk! Hadi hemen gidip bakalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310609,
					"content": "Üssün mühendislik şemalarını ve rotalarını okuyorum... Hımm... İlerlemeye devam edersek oraya varacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310610
					],
					"speakerTitle": "Yumyum"
				},
				{
					"id": 761310610,
					"content": "Başka bir bilgi var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761310611
					]
				},
				{
					"id": 761310611,
					"content": "Diğer veriler alınıyor... Hı? \"Yıldız Denizinden Dönen Karanlıklar Lordu\" mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310612
					],
					"speakerTitle": "Yumyum"
				},
				{
					"id": 761310612,
					"content": "O da kim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310613,
					"content": "Veriler bu üssün varlığının... Bu \"Karanlıklar Lordu\"nun iradesinden kaynaklandığını gösteriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310614
					],
					"speakerTitle": "Yumyum"
				},
				{
					"id": 761310614,
					"content": "İnşası da daha önce gördüğümüz tüm tesislerden çok daha geç bir tarihe dayanıyor. En alt seviyeleri ayın çekirdeğine gidiyor ve oraya bir çatlak oyulmuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310615
					],
					"speakerTitle": "Yumyum"
				},
				{
					"id": 761310615,
					"content": "O çatlaktan sonsuz bir kadim ay enerjisi yayılıyor ve bu da üsse güç sağlıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310616
					],
					"speakerTitle": "Yumyum"
				},
				{
					"id": 761310616,
					"content": "Amacı da ayı... Uzay tabanlı bir silaha dönüştürmek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310617
					],
					"speakerTitle": "Yumyum"
				},
				{
					"id": 761310617,
					"content": "U-Uzay tabanlı silah mı? Bir dakika, bu \"Karanlıklar Lordu\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310618,
					"content": "Muhtemelen geri dönen ejderha kral Nibelung.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761310619
					]
				},
				{
					"id": 761310619,
					"content": "Yani Ejderha Kral geri mi döndü? Vay canına, böyle bir yere rastlamak ne büyük ayrıcalık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310620,
					"content": "Önce Semavi İlkeler gelmiş, sonra ejderha kral, şimdi de biz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310621,
					"content": "Boşuna \"yıldızlar ve hiçlik yoldaşın olsun\" dememişler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761310622
					]
				},
				{
					"id": 761310622,
					"content": "Bu durumda ilerlerken çok dikkatli olmamız gerekecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310623
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310623,
					"content": "Bir şeyler ters giderse bizi korumalısın Columbina, tamam mı... Ha? Bir dakika, Columbina nerede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310624
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310624,
					"content": "Gitmiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310625,
					"content": "... Ne zamandan beri?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761310626
					]
				},
				{
					"id": 761310626,
					"content": "Paimon onun gittiğini fark etmedi bile... Yumyum, Columbina'nın nereye gittiğini gördün mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310627,
					"content": "Hayır, terminalden veri alıyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310628
					],
					"speakerTitle": "Yumyum"
				},
				{
					"id": 761310628,
					"content": "E-Eyvah... Güvende olmamızı sağlayan bir kişi vardı, o da bir anda ortadan kayboldu! Burası... Perili falan mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310629,
					"content": "(Columbina bir şey söylemeden gitmez. Bir sebebi olmalı.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761310630
					]
				},
				{
					"id": 761310630,
					"content": "(Acaba Yumyum'la ilgili bir şey mi? Yok hayır, terminaldeki verileri okuyordu.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761310631
					]
				},
				{
					"id": 761310631,
					"content": "(Yoksa...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761310632
					]
				},
				{
					"id": 761310632,
					"content": "Ayrıca buraya geldiğimizden beri, o tuhaf tanıdıklık hissi gittikçe daha da güçlü hale geliyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310633
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761310633,
					"content": "(Columbina'nın ortadan kaybolması, bahsettiği o tanıdıklık hissiyle ilgili olabilir. Bu üssün içinde tam olarak ne saklı?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761310634
					]
				},
				{
					"id": 761310634,
					"content": "Şimdi ne yapacağız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310635,
						761310637
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310635,
					"content": "Lusalim'in laboratuvarına gidiyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761310636
					]
				},
				{
					"id": 761310636,
					"content": "Evet. Bu üssün gizlediği sırları orada saklanıyor olmalı. Dolayısıyla Columbina'nın kayboluşuyla ilgili ipuçlarını da orada bulabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310641
					],
					"speakerTitle": "Yumyum"
				},
				{
					"id": 761310641,
					"content": "Ancak rotamız ilerideki güvenlik sistemlerinden geçmemizi gerektiriyor, bunu yaparken üs alarmını kesinlikle tetiklememeliyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310642
					],
					"speakerTitle": "Yumyum"
				},
				{
					"id": 761310642,
					"content": "Güvenliği bir şekilde devre dışı bırakmanın bir yolu var mı? Paimon bir baksın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310643,
						761310645,
						761310647,
						761310649,
						761310651
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310643,
					"content": "İncele",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761310644
					]
				},
				{
					"id": 761310644,
					"content": "Şuradaki yol Lusalim'in laboratuvarına çıkıyor ama önce güvenliği kapatmanın bir yolunu bulmalıyız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310653
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310653,
					"content": "Duruma bakılırsa ikinci kata soldaki odadan ulaşmamız gerekiyor. Güvenlik kontrol odası orada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310654
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310654,
					"content": "Gizlice girip kontrol etmenin bir yolunu bulsak nasıl olur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310645,
					"content": "İncele",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761310646
					]
				},
				{
					"id": 761310646,
					"content": "Görünüşe göre bu oda ikinci kata çıkıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310653
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310647,
					"content": "İncele",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761310648
					]
				},
				{
					"id": 761310648,
					"content": "Şemalara göre güvenlik kontrol odaları, sol ve sağ kanatların ikinci katında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310653
					],
					"speakerTitle": "Yumyum"
				},
				{
					"id": 761310649,
					"content": "İncele",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761310650
					]
				},
				{
					"id": 761310650,
					"content": "Görünüşe göre burada bir göçük olmuş. Geçiş yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310653
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310651,
					"content": "İncele",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761310652
					]
				},
				{
					"id": 761310652,
					"content": "Şemalara göre güvenlik kontrol odaları, sol ve sağ kanatların ikinci katında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310653
					],
					"speakerTitle": "Yumyum"
				},
				{
					"id": 761310637,
					"content": "Duruma bakılırsa geri çekilmemiz daha iyi olabilir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761310638
					]
				},
				{
					"id": 761310638,
					"content": "Paimon havayı yumuşatmak için şaka yaptığını anlayabiliyor... Cesur ol Paimon, cesur ol!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310639
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310639,
					"content": "Columbina'yı bulacağız! Onu arkada bırakmayacağız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310640
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310640,
					"content": "Lusalim'in laboratuvarına gitmeliyiz. Bu üssün sakladığı sırlar orada olmalı. Ayrıca Columbina'nın neden kaybolduğuyla ilgili ipuçlarını da orada bulabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310641
					],
					"speakerTitle": "Yumyum"
				}
			]
		},
