			"dialogs": [
				{
					"id": 761310701,
					"content": "Hımm? Bu şey hâlâ çalışıyor gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310702,
					"content": "Belki içinde bir bilgi vardır. Açıp bir bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310703,
					"content": "Uzaydan gelen yaratığın ejderhalara gönderdiği mesaj mı bu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310704,
					"content": "Anlıyorum. Demek böyle olmuş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310705
					],
					"speakerTitle": "Yumyum"
				},
				{
					"id": 761310705,
					"content": "Yani Ay Gözcüsü Projesinin amacı bu tür bir mesajı tekrar evrene göndermek miydi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310706,
					"content": "Eğer hepsi bundan ibaretse Ibni-Belum'un Gözünü kullanamazlar mıydı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310707,
					"content": "Paimon bir şey mi kaçırdı? Dur bakalım, tekrar kontrol etsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310708,
					"content": "Ha! Vay canına, sonunda gerçekten de bir dipnot varmış!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310709,
					"content": "\"'Kızım' Ninnin'e.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310710,
					"content": "Ninnin mi? Dur bir dakika... Yumyum, sen Lusalim'in kızı mısın yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310711,
					"content": "Dur biraz, o zaman bu hale nasıl geldin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310712,
					"content": "Ben... Bilmiyorum... Bu anılar yok bende... Neden yoklar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310713
					],
					"speakerTitle": "Yumyum"
				},
				{
					"id": 761310713,
					"content": "Ayın çekirdeğine gidip bakmamız gerekiyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761310714
					]
				},
				{
					"id": 761310714,
					"content": "P-Peki Columbina ne olacak? Ortadan kayboluşuyla ilgili hâlâ bir ipucu bulamadık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310715,
					"content": "Bu da ayın çekirdeğiyle bağlantılı olabilir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761310716
					]
				},
				{
					"id": 761310716,
					"content": "Aa, doğru! Daha önce bahsettiği o tanıdık his çekirdekle ilgili olmalı, değil mi? Hadi gidip bakalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
