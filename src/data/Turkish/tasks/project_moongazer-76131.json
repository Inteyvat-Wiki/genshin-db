					"id": 761310402,
					"content": "Bu üssün hâlâ faal olacağını kim tahmin ederdi? Bu çılgınlık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310403,
					"content": "İşte ejderha teknolojisi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761310404
					]
				},
				{
					"id": 761310404,
					"content": "Öyleyse onların çalışmalarına dokunmayalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310405
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761310405,
					"content": "Ne diyorsun sen? Paimon, hazır sen de varken buranın altını üstüne getirebiliriz sanmıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310406,
					"content": "Her şeyin aya geldiğimiz zamanki gibi olmasından korkmuyor musun? Uzay gemisine binemiyorduk az kalsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310407
					],
					"speakerTitle": "Yumyum"
				},
				{
					"id": 761310407,
					"content": "Ah... Paimon bunu tamamen unutmuş! Of. Cidden ya, bir üste neden kendi kendini yok etme sistemi olur ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310408,
					"content": "Görünüşe göre eski günlerdeki gibi dikkat çekmeden hareket etmemiz gerekecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761310409,
					"content": "Evet. Dürüst olmak gerekirse içeride ne olduğunu ben de merak ediyorum... Ve kendi \"evime\" gizlice sızmak oldukça... Yeni bir deneyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310410
					],
					"speakerTitle": "Columbina"
				},
				{
					"id": 761310410,
					"content": "Ayrıca buraya geldiğimizden beri, o tuhaf tanıdıklık hissi gittikçe daha da güçlü hale geliyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Columbina"
				}
			]
		},
