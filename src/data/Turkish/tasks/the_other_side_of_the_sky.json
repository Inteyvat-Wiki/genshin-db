			"dialogs": [
				{
					"id": 751360401,
					"content": "Öff. Onca badireyi atlatıp Tonatiuh'ya ulaştık ama ortalıkta didik didik taş arıyoruz... Daha heyecan verici bir macera olacağını düşünmüştüm ben bunun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360402
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360402,
					"content": "Ateş Taşlarını bulma işi size emanet o halde. Bir şeye ihtiyacınız olursa mutlaka seslenin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bona"
				}
