			},
			"dialogs": [
				{
					"id": 751360501,
					"content": "Yaşasın, başardık! Hımm, bu Işıltılı Yazıt nedense biraz tanıdık geliyor. Bizim meşhur Dönüş Yeşimi olmasın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360502,
					"content": "Bir dakika, bu Altın Ahit değil mi? Geçen sefer taş tabletin oradan aldığımızla aynı şey bu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360503,
					"content": "Hırr... Raaar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360504
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751360504,
					"content": "Doğru diyorsun, cidden tıpatıp aynısı!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360505
					]
				},
				{
					"id": 751360505,
					"content": "Hiçliğin pisliğini bastırabilen bir hazineyle lanetleri ve felaketleri önleyebilen bir nişan... Paimon'a sorarsanız birbirlerine epey benziyorlar sanki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360506,
					"content": "E günaydın Paimon, şimdi mi fark ettin bunu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360507
					]
				},
				{
					"id": 751360507,
					"content": "Ne? E biliyorsan neden Paimon'a söylemedin madem? Hem bir dakika ya, sen nereden biliyorsun ki bunu? Yine \"maceracılık tecrübesi\" falan mı diyeceksin yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360508,
					"content": "Hımm. Şimdi bir düşününce Hiçliğin pisliğini bastırabilen bir hazineyle lanetleri ve felaketleri önleyebilen bir nişan... Paimon'a sorarsanız birbirlerine epey benziyorlar sanki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360509,
					"content": "İyi ama bu şey gerçekten Ochkanatlan'daki Hiçliği bastırabilecek mi? Paimon, Sürüngen Kalıntıları Derneğindekilerin daha önce bundan bahsettiğini hiç duymadı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360510,
					"content": "Hımm. Eğer Dönüş Yeşimi, Altın Ahdin ta kendisiyse... Kötü kalpli ejderha bizi o yüzden hedef almış olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360511,
					"content": "Oh be, demek ki Paimon'un bu sabah yediği Yakıcı Et Yahnisine göz diktiği için takılmamış peşimize...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360512,
					"content": "Taşlar yerine oturmaya başladı gibi sanki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360513
					]
				},
				{
					"id": 751360513,
					"content": "Konu döndü dolaştı, yine Yakıcı Et Yahnisine geldi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360514
					]
				},
				{
					"id": 751360514,
					"content": "Hımm, iyi de Bona muhtemelen henüz Altın Ahit hakkında bir şey bilmiyordur... Bona? Bir baksana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360515,
					"content": "Bu işte bir terslik var... Daha önce buraya, Tonatiuh'ya geldiğimden eminim ben. Ayrıca Dönüş Yeşimi de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360516
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360516,
					"content": "Evet, onu yok etmeliyiz... Malum kişinin eline geçmesine izin veremeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360517
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360517,
					"content": "Bona? İyi misin Bona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360518,
					"content": "Bona mı? Hayır... Bona çoktan gitmiş olmalıydı. Ben neden hâlâ buradayım ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360519
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360519,
					"content": "#Hah, demek öyle. Demek bu... Dikkatli ol {NICKNAME}! Daha fazla yaklaşma. Bu bir tuzak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360520
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360520,
					"content": "Ne?",
