			"dialogs": [
				{
					"id": 751360201,
					"content": "Bu da ne böyle? Ateş Fosforitine benziyor ama parlıyor ve üzerinden alevler çıkıyor. Bona'dakinden çok daha güçlü durduğu kesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360202,
					"content": "Ateş Fosforiti aslında böyle bir şey olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360203,
					"content": "Off! Çok sıcak!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360204
					]
				},
				{
					"id": 751360204,
					"content": "#Bulduğun her şeye elini sürüp durma artık {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360205,
					"content": "Öyle mi yapıyorum? Fark etmemiştim bile...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360206
					]
				},
				{
					"id": 751360206,
					"content": "Heh, tencere dibin kara...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360207
					]
				},
				{
					"id": 751360207,
					"content": "Raarr! Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360208
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751360208,
					"content": "#Ne oldu {REALNAME[ID(2)|SHOWHOST(true)]}? Bunun hakkında bir şey mi biliyorsun yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360209,
					"content": "#Aa, {REALNAME[ID(2)|SHOWHOST(true)]}! Sonunda hünerlerini gösterme vakti geldi, hım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360210,
					"content": "Şu andan itibaren cayır cayır yanan hazinelerle ilgilenme işini sana bırakacağız o zaman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360211,
					"content": "Yihii! Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360212
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751360212,
					"content": "Hey! Buradayım! Bu tarafa bakın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360213
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360213,
					"content": "Aa, Bona orada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360214,
					"content": "İyi de oraya nasıl gitmiş ki o? Yoksa indiği yer... Şey, neyse. Hadi önce oraya gidelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
