				},
				{
					"id": 751360303,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360304
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751360304,
					"content": "Yaa, benim için endişelendin mi yoksa Paimon? İçin rahat olsun, ben Çiçek Tüyü Klanının baş maceracısıyım. Öyle kolay lokma değilimdir yani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360305
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360305,
					"content": "Yine de iyi olduğunu görmek güzel.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360306
					]
				},
				{
					"id": 751360306,
					"content": "Hehe, iyi olmamı sana borçlu olabilirim aslında. Seninle tanıştığımdan beri şansım hep yaver gidiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360307
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360307,
					"content": "Bulutların arasındayken sizden ayrılınca havada süzülen bir kayaya çarptım, sonra da bayılmışım galiba. Ne kadar zaman geçti bilmiyorum ama uyandığımda kendimi burada buldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360308
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360308,
					"content": "Buraya nasıl geldin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360309
					]
				},
				{
					"id": 751360309,
					"content": "Bulutların arasındayken sizden ayrılınca havada süzülen bir kayaya çarptım, sonra da bayılmışım galiba. Ne kadar zaman geçti bilmiyorum ama uyandığımda kendimi burada buldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360310
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360310,
					"content": "Uyandığımda her yeri arayıp taradım ama siz ortada yoktunuz. Ben de bir an sandım ki... Neyse artık, göründüğünüzden daha çetin cevizmişsiniz neyse ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360311
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360311,
					"content": "Paimon da tam buraya nasıl geldiğini soracaktı. Hepsi ıssız, uçan adalar bunlar. Uçarak mı geldin cidden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360312,
					"content": "Hehe, orasını sonra konuşalım. Neyse, aradığımız Tonatiuh bu işte. Maceramız başarıyla sonuçlandı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360313
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360313,
					"content": "Hımm, görünüşe bakılırsa burada efsanelerde anlatıldığı gibi hazineler yok. Biri gelip hepsini almış olmasın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360314,
					"content": "Bana sorarsanız Tonatiuh'daki o hazineler, kabile hikayecileri tarafından uydurulmuş bir hikayeden ibaret!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360315
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360315,
					"content": "Nasıl yani? Hayır ya, olamaz! Buraya boşu boşuna mı geldik diyorsun şimdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360316,
					"content": "Hazine işi uydurma olabilir ama aradığımız Dönüş Yeşiminin burada olmadığı anlamına gelmiyor tabii bu. Umudumuzu kaybetmeyelim hemen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360317
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360317,
					"content": "Hem şu yukarıdaki şeye baksanıza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360318
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360318,
					"content": "İçinde bir şey var, görüyor musunuz? Az önce de Chu'ulel'in Çekirdeğinin içinde bir Ateş Fosforiti buldunuz, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360319
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360319,
					"content": "Maceracılık tecrübelerime dayanarak konuşacak olursam... Aradığımız Dönüş Yeşimi orada olabilirmiş gibi geliyor bana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360320
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360320,
					"content": "O halde oraya çıkmanın bir yolunu bulalım ve kırıp açalım onu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360321,
					"content": "Oldu bil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360322
					]
				},
				{
					"id": 751360322,
					"content": "Durun biraz, öyle ha deyince olacak bir şey değil o! Dediğinizi ben zaten denedim. Kaba kuvvet kullanarak kırıp açmak mümkün değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360323
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360323,
					"content": "Bu iş öyle kolay olmayacak gibi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360324
					]
				},
				{
					"id": 751360324,
					"content": "Evet, kaba kuvvet kullanarak açabileceğimiz bir şeye benzemiyor bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360325
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360325,
					"content": "Maceracılık tecrübelerim bana buralarda bir yerde bir tür mekanizma olduğunu söylüyor. Tıpkı Ateş Fosforitini aldığımız zamanki gibi yani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360326
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360326,
					"content": "Mekanizma demişken, buradaki şey o olmalı! Tıpkı daha önce gördüğümüz Kadim Ateş Sunağına benziyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360327
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360327,
					"content": "Ne tesadüf ama... Bir dakika ya, tesadüf falan olamaz bu. Bir tür ipucu olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360328
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360328,
					"content": "Eğer cidden bir ipucuysa belki Ateş Fosforitini kullanarak... Ha, bir dakika. Ateş Fosforitimiz var mı bizim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360329,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} şu anda bir tane taşıyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360330
					]
				},
				{
					"id": 751360330,
					"content": "Ha, evet. Buraya gelirken bulmuştuk bunu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360331,
					"content": "Evet, işte bu! \"Maceracının Anahtarı\" prensibini bilir misiniz? Bir maceranın son aşamasında gereken en önemli eşyanın, her zaman en başta elde edildiğini söyler bu prensip.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360332
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360332,
					"content": "Yok daha neler! Hem bu aralık biraz dar değil mi sence, şu hale baksana... Yine de bu şey Ateş Fosforitine benziyor gerçekten...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360333,
					"content": "Paimon'a sorarsan sürekli cayır cayır yanan alevler hariç tıpatıp aynı duruyorlar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360334,
					"content": "Aa, doğru diyorsun aslında. Sen olmasan farkına bile varmazdım Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360335
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360335,
					"content": "Pardon da orası senin garipliğin... Neyse, yani buna benzer taşları toplamamız gerek diyorsun, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360336,
					"content": "Şu Ateş Taşlarını arıyorsak onlardan bu gemide dört tane var. Mesela önümüzde süzülen adada bir tane olması lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360337
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360337,
					"content": "Ooo... Dur biraz Bona, tüm bunları nereden biliyorsun sen? Sanki buraya daha önce gelmiş gibisin. Bu işin altında \"macera tecrübesinden\" daha fazlası yatıyor sanki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360338,
					"content": "Nasıl anlatsam... Maceracı sezgisi gibi bir şey diyeyim, siz anlayın. Neden bilmiyorum ama bu Sunağı görür görmez nasıl kullanacağımı anladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360339
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360339,
					"content": "Sizinle tanışmadan önce de burayı araştırıyordum zaten. Usta bir maceracı için detaylı inceleme yapmak şarttır, malum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360340
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360340,
					"content": "Demek öyle... İnsan her gün yeni bir şey öğreniyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360341
					]
				},
				{
					"id": 751360341,
					"content": "#Bir dakika, yani sen bu noktaya kadar kaba kuvvet kullanarak mı geldin {NICKNAME}? Vay be, hayat siz savaşçılara güzel gerçekten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360342
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360342,
					"content": "Neyse ki benim öyle şeylerle işim yoktur, kaba kuvvetten şaşmam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360343
					]
				},
				{
					"id": 751360343,
					"content": "Nevi şahsına münhasır birisin, belli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360344
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360344,
					"content": "Bu arada oraya nasıl gideceğiz ki biz? Bu senin için bile zor olabilirmiş gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360345,
					"content": "Hehe... Geçen sefer oraya nasıl çıktığımı merak ediyorsunuz, değil mi? Şimdi size yaptığım keşfi göstereceğim işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360346
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360346,
					"content": "Ee, nasıl buldunuz? İşte bu mekanizmayı kullanarak uçan adalar arasında özgürce gezinebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360347
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360347,
					"content": "Onları bulma işi size emanet o halde. Başka bir uçan adaya geçip geri dönemezseniz bana seslenin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360348
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751360348,
					"content": "#Pekala, Ateş Taşlarını taşıma işi sende o zaman {REALNAME[ID(2)|SHOWHOST(true)]}. Hadi gidelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360349,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				}
			]
		},
