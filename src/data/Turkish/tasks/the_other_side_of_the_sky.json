					}
				]
			},
			"dialogs": [
				{
					"id": 751360101,
					"content": "Sağ... Sağ salim kurtulduk! Off, Paimon sağlam zemine ayak basabilmeyi özlemiş resmen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360102,
					"content": "İyi de sen hep uçuyorsun, ne alaka?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360103
					]
				},
				{
					"id": 751360103,
					"content": "Pardon da zemine yakın bir şekilde süzülmekle gökyüzünde bir oraya bir buraya uçup durmak arasında fark var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360104,
					"content": "Buranın \"zemini\" pek de sağlam durmuyor bana sorarsan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360105
					]
				},
				{
					"id": 751360105,
					"content": "#Paimon'u korkutup durmasana ya! Düşersek {REALNAME[ID(2)|SHOWHOST(true)]} ile seni aynı anda yukarıya çekemez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360106,
					"content": "Cik... Ku...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360107
					],
					"speakerTitle": "Cocouik"
				},
				{
					"id": 751360107,
					"content": "Yoksa Tonatiuh şu mu? Aa, yaşasın! Başardık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360108,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360109
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751360109,
					"content": "Gerçi gemiden çok, koca bir iplik yumağına benziyor bu! Ya da dolanmış bir yılana falan işte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360110,
					"content": "Neyse, buradan daha güvenli durduğu kesin. Hadi oraya uçalım... Şey, bir dakika. Bona nereye gitti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360111,
					"content": "Uçma konusunda çok tecrübeli olduğunu söylemişti ama Paimon yine de endişelendi şimdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360112,
					"content": "Rüzgarın yönü doğru olduğu sürece...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360113
					]
				},
				{
					"id": 751360113,
					"content": "Haklısın, muhtemelen buralarda bir yere inmiştir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360114,
					"content": "Burada kalırsak nereye gittiğini asla öğrenemeyeceğiz ki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360115
					]
				},
				{
					"id": 751360115,
					"content": "Haklısın, artık harekete geçmemiz lazım. Belki bizi gemide bekliyordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751360116,
					"content": "Gidelim o zaman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
