			"dialogs": [
				{
					"id": 756730101,
					"content": "Görünüşe göre renk ustası Ashalarımız hallerinden çok memnun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730102
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730102,
					"content": "Muhteşem Ashalar için bir görev daha tamamlandı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730103
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730103,
					"content": "Süper! Başardık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730104,
					"content": "Bizim Ashaya şimdiden yeni bir eser için ilham mı geldi yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730105,
						756730106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730105,
					"content": "İlham göz açıp kapayıncaya kadar gelip gidebilir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730107
					]
				},
				{
					"id": 756730107,
					"content": "#Aa, bıraktığı hazinelere bak... {NICKNAME}, Paimon, bunları siz alın! Sıkı çalışmanızın karşılığı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730108
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730108,
					"content": "Belki bir dahaki geldiğimizde renk ustası Ashanın başyapıtını görebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730109
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730109,
					"content": "Nasıl bir eser olacağını bir düşünsenize! Sıradan Ashalar bile bu kadar güzel renkler ortaya çıkarabiliyorsa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730110,
					"content": "Paimon renk ustası Ashaların ne yaratacağını görmek için sabırsızlanıyor! Belki de kelimelerin tarif edemeyeceği bir şeyler çıkar ortaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730111,
					"content": "Belki Filojistonun, belki de Ayın ya da yıldızlı gökyüzünün o derin renkleri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730112,
					"content": "Evet, aynen öyle! Maceralarımız sırasında başı dertte olan bir yaratıkla karşılaşırsak ona yardım etmek için elimizden geleni yapmalıyız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730113
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730113,
					"content": "Hı hı! Kim bilir? Belki bir gün hiç beklemediğimiz ödüller alabiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730114,
						756730115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 756730114,
					"content": "Bennett'e katılıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730116
					]
				},
				{
					"id": 756730116,
					"content": "Ama... Bunu sırf bir ödül beklentisiyle yapmamalıyız. O zaman asıl amacımızdan sapmış oluruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730117
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730117,
					"content": "Bize bir faydası olmasa da ihtiyacı olan arkadaşlarımıza yardım etmek ve işler yoluna girdiğinde yüzlerinin güldüğünü görmek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730118
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730118,
					"content": "İşte bu hissi gerçekten çok seviyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bennett"
				},
				{
					"id": 756730115,
					"content": "Ayrıca çok tatmin edici bir his.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730116
					]
				},
				{
					"id": 756730106,
					"content": "O yüzden demiri tavındayken dövmek lazım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730107
					]
				}
			]
		}
	]
}