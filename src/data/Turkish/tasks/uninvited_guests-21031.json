				},
				{
					"id": 210310402,
					"content": "Hepsini sen mi yendin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310403
					]
				},
				{
					"id": 210310403,
					"content": "Hahaha, aynen öyle. Epey uğraştırdılar ama. Eskisi gibi genç bir savaşçı değilim artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310404
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310404,
					"content": "Senin oradaki canavarları da halletmişsindir herhalde, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310405
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310405,
					"content": "Canavar kampı konusunda...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210310406
					]
				},
				{
					"id": 210310406,
					"content": "Senden önce biri bütün canavarları alt etmiş... Ama kampta kimse yoktu, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310407
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310407,
					"content": "Çok enteresan. Oradan geçen bir maceracı mı alt etti onları yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210310408
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210310408,
					"content": "Her halükarda bölgeyi benim adıma kontrol ettiğin için sağ ol. Bunları kabul et lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
