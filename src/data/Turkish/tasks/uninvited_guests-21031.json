					"nextDialogs": [
						210310307
					]
				},
				{
					"id": 210310307,
					"content": "Tamamdır. İlgilenmem gereken başka meseleler var. Sonra görüşürüz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiao"
				},
				{
					"id": 210310303,
