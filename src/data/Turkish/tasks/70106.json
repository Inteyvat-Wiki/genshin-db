			"dialogs": [
				{
					"id": 701060201,
					"content": "İşte Dondurulmuş Etin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060202
					]
				},
				{
					"id": 701060202,
					"content": "Vay be, bu Dondurulmuş Et çok güzel görünüyor... Şimdi bulmam gereken son bir malzeme kaldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060203
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060203,
					"content": "Hiç Kral Kar Domuzunu duymuş muydun? İnsanlar bunun, dağın derinliklerinde yaşayan vahşi bir hayvan olduğunu söyler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060204
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060204,
					"content": "Tariflerde de bu canavarın seçkin etinin her bir pişirme yöntemine uygun olduğu söylenir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060205
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060205,
					"content": "Gezgin, benim için bu işi halledebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060206
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060206,
					"content": "Kazancımın ne olduğunu doğrudan sorabilir miyim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060207
					]
				},
				{
					"id": 701060207,
					"content": "Endişelenme, geri döndüğünde sana vermek için kenara ayırdığım bir şeyler var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harris"
				}
			]
		},
