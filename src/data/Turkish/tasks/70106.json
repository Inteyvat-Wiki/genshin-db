			},
			"dialogs": [
				{
					"id": 701060101,
					"content": "Yalnızca birkaç yemek malzemesi kaldı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060102
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060102,
					"content": "Ne var ne yok?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060103
					]
				},
				{
					"id": 701060103,
					"content": "Hımm? Aa, Gezgin. Kadim bir tarifin son dokunuşlarını yapıyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060104
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060104,
					"content": "Kısa süre önce bir kaşif ekibi dağda yolculuğa çıktı. İçlerinden biri de benim arkadaşım, kendisi de maceracı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060105
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060105,
					"content": "Hava kötü olduğu için çok ilerleyemediler ama arkadaşım fırtınadan kaçarken kadim bir harabe keşfettiklerini söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060106
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060106,
					"content": "Kitap ve kayıtlarla doluymuş. Hatta... Bir tarif bile varmış. Nasıl bu kadar uzun süre tek parça kaldı bilmiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060107
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060107,
					"content": "Maceracı arkadaşım tarifi bana verdi. Geçmişin tatlarını yeniden canlandırabileceğimi umuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060108
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060108,
					"content": "Aslında bu tarifte geçen yemek malzemelerinden bazılarının adını bile duymadım. Hatta bazı pişirme tekniklerine de yabancıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060109
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060109,
					"content": "Ben de yalnızca en temel yemek malzemelerini kullandığım değiştirilmiş bir halini pişiriyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060118
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060118,
					"content": "Tarifteki tuhaf yemek malzemelerini toplamama yardım etmek ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060110,
						701060112
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060110,
					"content": "Bana bırak!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060111
					]
				},
				{
					"id": 701060111,
					"content": "Bu konuda böyle heyecanlı olduğunu gördüğüme sevindim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060113
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060113,
					"content": "Birkaç yaban domuzunun dağlarda kaybolup buza hapsolduğunu duymuştum... Acaba böyle bir durum etin tadını nasıl etkiliyordur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060114
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060114,
					"content": "Belki bana on porsiyon Dondurulmuş Et getirebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060115
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060115,
					"content": "Netleştirmek adına, demek istediğin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060116
					]
				},
				{
					"id": 701060116,
					"content": "Evet, donmuş yaban domuzlarının eti yani. Buzun içinde kaldıklarından et tazedir diye düşünüyorum. Birileri bana buzda sıkışıp kalmış zavallı yaban domuzundan bahsedince aklıma gelen tek şey \"Dondurulmuş Et\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060117
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060117,
					"content": "Yardımın için teşekkür ederim. Malzemeleri aldığında gel ve beni bul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060112,
					"content": "Sana hangi yemek malzemeleri lazım?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060113
					]
				}
			]
		},
