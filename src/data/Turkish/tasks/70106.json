				},
				{
					"id": 701060303,
					"content": "Hiç Kral Kar Domuzunu duymuş muydun? İnsanlar bunun, dağın derinliklerinde yaşayan vahşi bir hayvan olduğunu söyler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060304
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060304,
					"content": "Tariflerde de bu canavarın seçkin etinin her bir pişirme yöntemine uygun olduğu söylenir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060305
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060305,
					"content": "Ha... Bundan mı bahsediyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701060306
					]
				},
				{
					"id": 701060306,
					"content": "Ne? Dur... Evet! Nasıl yani... Nereden? Bu tesadüfen mi oldu yoksa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060307
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060307,
					"content": "Yani, her neyse... Demek ki gereken tüm yemek malzemelerine sahibim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060308
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060308,
					"content": "Malzemeleri getirmeni beklerken ben de tarifimi kağıda döktüm. Bu tarif, başlangıç noktası olan kadim tariften çok daha farklı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060309
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060309,
					"content": "Nihayetinde yemeğin tadı iyi olduğu müddetçe tarifin neye evrildiği çok da önemli değil. Sanırım bu yemeğe \"Gulaş\" diyeceğim. Egzotik bir adı var ama yapımı kolay... Tadına baksana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060310
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060310,
					"content": "Endişelenme, böyle kötü bir ortamda yemek pişirmenin zorluğunu da hesaba kattım. Hazırlık süresini en aza indirip pişirme yönteminin kolay olmasına özen gösterdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701060311
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 701060311,
					"content": "Hadi dene bakalım. Bir kere yaptıktan sonra bir daha pişirmek istersen tarifin kolayca hatırlandığını göreceksin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harris"
				}
			]
		},
