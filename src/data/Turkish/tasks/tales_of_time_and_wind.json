			"dialogs": [
				{
					"id": 100070401,
					"content": "Bu ada...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070402
					]
				},
				{
					"id": 100070402,
					"content": "Özel bir ada mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070403
					]
				},
				{
					"id": 100070403,
					"content": "Her zaman değildi. Bir zamanlar bu da diğer adalar gibi sıradan, gösterişsiz bir kum ve çakıl yığınıydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070404
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070404,
					"content": "Ta ki hikayelerin tohumları rüzgarla buraya getirilip zamanla filizlendirilene kadar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070405
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070405,
					"content": "Günler geçtikçe rüzgar yeni masallar getirdi ve zaman da onların büyüyüp efsanelere dönüşmesini sağladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070406
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070406,
					"content": "#O halde... Seni Zaman'ın sevdiği bu adada \"gerçekten\" ağırlamama izin ver {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070407
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070407,
					"content": "Burası, uzak bir geçmişte Zaman ve Rüzgar'ın buluştuğu yer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070408,
					"content": "Hop, hop, hop... Birdenbire çok ciddi konuşmaya başladın Detone Ozan. Paimon artık bu sohbeti takip edemiyor sanki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100070409,
					"content": "Hehe, tasalanma sevgili Paimon! En iyi hikayeler her zaman biraz gizem ve merakla başlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
