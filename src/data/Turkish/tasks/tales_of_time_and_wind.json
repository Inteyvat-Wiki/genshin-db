			"dialogs": [
				{
					"id": 100070701,
					"content": "#Pekala, bu kadar yeterli. Bu enfes bir performans oldu {NICKNAME}. Teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070702
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070702,
					"content": "Az önce serbest bıraktığın o güç...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070703
					]
				},
				{
					"id": 100070703,
					"content": "Ha, merak etme. O güç tamamen bana aitti. Dışarıdan hiçbir yardım almadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070704
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070704,
					"content": "Bunu... Bir müzik aletini daha da hoş ezgiler çalabilmesi için akort etmek gibi düşün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070705
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070705,
					"content": "Vay, senin elin de armut toplamıyormuş Venti! Başka hangi numaraların var bakalım, hımm?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100070706,
					"content": "Ah Paimon. Kaç numaram olabilir ki? Sonuçta sadece iki elim var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070707
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100070707,
					"content": "Paimon'un bunu kastetmediğini biliyorsun Detone Ozan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100070708,
					"content": "Hahaha, içimden bir ses bugün rüzgarın epey kuvvetli eseceğini söylüyor. Mondstadt'a dönüp insanlara şapkalarını sıkı tutmalarını söylemeliyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
