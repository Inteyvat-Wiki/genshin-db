			"dialogs": [
				{
					"id": 100071001,
					"content": "Bir zamanlar Mondstadt halkı adına ilk özgürlük rüzgarlarını çağırmıştım. O rüzgarların yardımıyla, hak eden herkese özgürlüğü geri verilmişti.",
					"roleType": "TALK_ROLE_NPC",
