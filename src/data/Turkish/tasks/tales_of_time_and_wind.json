			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 100071101,
					"content": "Sana bundan daha önce bahsetmiştim, hatırladın mı? Bin Rüzgar Tapınağında \"Zaman\" ile nasıl karşılaştığımı ve ondan nasıl yardım aldığımı anlatmıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071102
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071102,
					"content": "İşte, o ilk özgürlük rüzgarları Zaman'ın yardımı sayesinde o kadar kuvvetli esebildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 1000712,
			"completionStepIds": [
				1000703
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 100071201,
					"content": "Ama öyle şiddetli rüzgarlar, bir şeylerin büyümesine yardımcı olmaktan ziyade ortalığı temizlemeye yarar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071202
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071202,
					"content": "Bu yüzden Mondstadt'taki birkaç kriz çözüldükten sonra rüzgarları yumuşattım. Rüzgarlar artık sadece ihtiyaç anında insanları destekleyecek kadar kuvvetliler, onları yere devirecek kadar değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071203,
						100071204
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071203,
					"content": "O halde biz buraya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100071205
					]
				},
				{
					"id": 100071205,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071206
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071206,
					"content": "Uzakta gölgeler toplanıyor. Eminim sen de hissetmişsindir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071207
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071207,
					"content": "Ateş Hükümdarı ile Ölümün Hakimi Ronova'nın karşılaşmasını ve Fatui Habercisi Yüzbaşı'nın başına gelenleri duydum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071208
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071208,
					"content": "Hiçlik faaliyetlerinin Mondstadt'a giderek daha fazla yaklaştığının da farkındayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071209
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071209,
					"content": "Korkarım ki yaklaşan kriz insanlığın tek başına çözebileceğinin ötesinde olabilir... Bu yüzden hazırlıklı olmalıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071210
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071210,
					"content": "İhtiyaç anlarında müdahale etmek Rüzgar Hükümdarı'nın görevidir. Bu nedenle ben, Barbatos, bizi bekleyen fırtınayı dağıtacak kadar kuvvetli bir rüzgar estireceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071211
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071211,
					"content": "Ama Mondstadt Şehri'nde bu kuvvette bir rüzgar çağırırsam orayı altüst ederim; kıyafetler, şapkalar, insanların balkonlarındaki çiçekler uçar gider...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071212
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071212,
					"content": "Dolayısıyla o rüzgarı çağırmak için burayı, yani bir zamanlar Zaman'a bir methiye okuduğum yeri seçtim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071213
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071213,
					"content": "Kim bilir, belki de Zaman bu adaya sırf benim o pek güzel müziğim sayesinde özel bir lütufta bulunuyordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071214
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071214,
					"content": "Bir dakika, yani... Burası gerçekten o kadar özel mi? Hiç de öyle görünmüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100071215,
					"content": "Gelgit alçalıp yükseliyor, kuşlar uğrayıp gidiyor... Her şey çok... Normal görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100071216,
					"content": "Zaman'ın varlıklar üzerindeki etkisi gözle görülenle sınırlı değildir. Mesela... Olgun bir Güneriği gibi düşünün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071217
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071217,
					"content": "Dış kabuğu sağlamsa kabuğun altındaki meyvenin olgunlaşıp olgunlaşmadığını sıradan bir insanın anlaması neredeyse imkansızdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071218
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071218,
					"content": "Ama o kabukta en ufak bir delik bile varsa meyve o noktadan başlayarak çürür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071219
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071219,
					"content": "Zaman'ın avuçlarına yerleşmiş bu adanın \"kabuğunda\" tek bir \"leke\" bile bulunmaz. Bu sebeple Zaman'ın bu adanın özü üzerindeki etkisi gizlidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071220
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071220,
					"content": "Elbette en temel açıdan baktığımızda Zaman'ın lütfundan yoksun olan her şey bir noktada silinmeye mahkumdur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071221
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071221,
					"content": "Ancak burada kalan güç sayesinde Zaman'ı ödünç alarak Rüzgar'ın etrafına bir sınır çizebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071222
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071222,
					"content": "Böylece burada ne kadar güçlü bir fırtına çıkarırsam çıkarayım dış dünya hiçbir şey fark etmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071223
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071223,
					"content": "#Tabii yardım isteyen kişi olarak bunun karşılığında bir şey sunmalıyım. İşte bu yüzden seni buraya davet ettim {NICKNAME}... Birlikte Zaman'a bir methiye okuyalım diye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100071224
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071224,
					"content": "#Hazır olduğunda bana haber ver {NICKNAME}. Ha, bir de eğer ihtiyacın varsa sana ödünç bir enstrüman verebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 100071204,
					"content": "Tam olarak ne yapmak için geldik?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100071205
					]
				}
			]
		},
