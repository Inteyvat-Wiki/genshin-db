			},
			"dialogs": [
				{
					"id": 721230602,
					"content": "Hay şansıma tüküreyim ki böyle insanlarla karşılaştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230603
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230603,
					"content": "Utanmaz herifler. Fatui ile komplo kuruyorsunuz demek... Büyük Narukami er ya da geç sizi mahvedecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230604
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230604,
					"content": "Sırf işimi böldün diye kazandın zannetme. Hâlâ bilmediğin bir hamlem var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hideaki"
				}
			]
		},
		{
			"id": 7212307,
