						],
						"stepId": 7212306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Miyuki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230301,
					"content": "Bir şeyler keşfedebildiniz mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230302
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230302,
					"content": "Hideaki hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230303
					]
				},
				{
					"id": 721230303,
					"content": "Demek öyle... Ama Hazine Avcıları alt tarafı birkaç hırsızdan ibaret. Onların çocukça oyunları gerçekten bu kadar büyük bir kargaşaya neden olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230304
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230304,
					"content": "Yıldırım Kirazının solmasının başka sebepleri olmalı bence... Şüphelendiğim birkaç konu var ama emin olamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230305
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230305,
					"content": "Nasıl yani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230306
					]
				},
				{
					"id": 721230306,
					"content": "Burası Kannazuka, burada ne Inazuma inancının ne de Sangonomiya'nın bir etkisi var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230307
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230307,
					"content": "Önsezi Avı Fermanı yayınlandığından beri Şogun Ordusu ve asiler arasında sık sık sorun çıkıyor. İki tarafın da savaş sırasında Yıldırım Kirazının hasar alıp almayacağını düşündüğünü sanmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230308
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230308,
					"content": "Leydi Miko'nun da dediği gibi, \"Onur ve övgü bu askeri tiplerin umursadığı tek şey.\" Mantıklı davranmalarını bekleyemeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230309
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230309,
					"content": "Bunun için hazırlanmıştık ama Yıldırım Kirazının şimdiki kadar kötü halde olacağını beklemiyorduk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230310
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230310,
					"content": "Neyse, şu anda en önemli şey Hazine Avcılarının çocukça oyunlarına son vermek. Gezgin, sana güvenebilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230311,
						721230313
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230311,
					"content": "Tabii!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230312
					]
				},
				{
					"id": 721230312,
					"content": "Lütfen dikkatli ol. Yıldırım Kirazının zayıf düşmüş olması durumu oldukça tehlikeli hale sokuyor. Zira bu ağaçlar, altında yatanı zapt etme görevini üstleniyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230315
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230315,
					"content": "Çok konuştum... Söylediklerimi unut lütfen. Kısacası çok dikkatli ol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230316
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230316,
					"content": "Benim de bulduklarımı incelemek için biraz zamana ihtiyacım var. En önemli soru şu: Hazine Avcılarını arka planda kim yönetiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230317
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230317,
					"content": "Bu olay giderek karmaşıklaşıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230313,
					"content": "Çok zor olmayacak gibi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230314
					]
				},
				{
					"id": 721230314,
					"content": "Korkarım sandığın kadar kolay olmayabilir. Yıldırım Kirazının zayıf düşmüş olması durumu oldukça tehlikeli hale sokuyor. Zira bu ağaçlar, altında yatanı zapt etme görevini üstleniyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230315
					],
					"speakerTitle": "Miyuki"
				}
			]
		},
		{
			"id": 7212304,
			"completionStepIds": [
				7212314
