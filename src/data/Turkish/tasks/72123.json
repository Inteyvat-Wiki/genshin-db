			},
			"dialogs": [
				{
					"id": 721230701,
					"content": "P-Peşimi bırak lütfen... Burayı üç defa koştuk, zar zor yürüyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230702
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230702,
					"content": "Serseriler! Sırf para için yabancılarla iş birliği yapmışlar! On defa daha koşsak bile size acımayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230703
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230703,
					"content": "Oh... Suratındaki rahat ifadeye göre küçük sorunu hallettin herhalde Gezgin. Çok sağ ol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230704
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230704,
					"content": "Yıldırım Kirazının gücü ne bu tip insanların eline geçmeli, ne de sinsi Fatui'nin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230705
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230705,
					"content": "Fatui'nin ne planladığını anlamak zor fakat yardakçısını yakaladığımıza göre cevapları ondan alabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230706
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230706,
					"content": "Temizliği bana bırak. Şogun Ordusunun yerlerini iyi bilirim. Bu adam kaçamayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Miyuki"
				}
			]
		},
