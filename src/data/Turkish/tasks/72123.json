					"Hideaki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230501,
					"content": "Para kazanmanı engelleyen şey, her işe karışan tapınak görevlisi demek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230502
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230502,
					"content": "Para kazanmak mı? Alçaklar sizi. Yıldırım Kirazını çıkarınız için kullanmaya nasıl cüret edersiniz? Leydi Miko sizi affetmeyecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230503
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230503,
					"content": "Peh! Çok büyük konuşuyorsun fakat kiminle uğraştığını unutuyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230504
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230504,
					"content": "Usta, şuradaki Gezgin bize engel olan kişi. Bize yardım etmezsen yaptığımız anlaşma suya düşecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230505
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230505,
					"content": "Hehe. Sen mi beni korkutacaksın cılız çocuk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fatui Avcı Eri"
				}
			]
		},
		{
