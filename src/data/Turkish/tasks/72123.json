				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hideaki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230204,
					"content": "L-Lütfen beni öldürme! Yıldırım Kirazı ile hiçbir alakam yok benim, yemin ederim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230205
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230205,
					"content": "O zaman buraya Yıldırım Kirazı için geldiğimizi nereden bildin? Vicdan mı yaptın yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230206,
					"content": "Paimon bu Elektrik Hipostaz benzeri şeyi kesinlikle kirli işlerinden elde ettiğini düşünüyor, doğru değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230207,
					"content": "S-Sen... Seninle ne alakası var onun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230208
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230208,
					"content": "Benim işim sonuçta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230209
					]
				},
				{
					"id": 721230209,
					"content": "Doğru! Yanlışları düzeltip adaletin yerini bulmasını sağlamamız istendi! Hadi o zaman söyle bakalım. Hazine Avcılarının Yıldırım Kirazı ile ilgili planları nedir ve bunu nereden aldın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230210,
					"content": "Eğer konuşmazsan... Bu Gezginin kılıcının müthiş gücünü tadacaksın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230211,
					"content": "Ko-Konuşacağım! Ama bu ağaçlar kimsenin umurunda değildi ki zaten! Ne var yani gücünü kullanarak kardeşlerimle para kazanmaya çalıştıysak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230212
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230212,
					"content": "Bu ağaçlarla ilgilenen önemli bir alıcı vardı, hatta ağaçların gücünü çıkarabilmemiz için bize araç ve imkan sağladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230213
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230213,
					"content": "Dediklerini yapıp ağaçlarda birer boşluk açacak ve Yıldırım Kirazının gücünü toplamak için o araçları kullanacaktık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230214
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230214,
					"content": "Daha sonra yapmamız gereken tek şey o gücü bu kristale yönlendirmekti. Sonrasında üç Tenryou Heyeti konağı değerinde varlığımız olacaktı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230215
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230215,
					"content": "Bir sürü para da verdi! Sizin gibiler hayatınız boyunca uğraşsanız harcayamazsınız üstelik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230216
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230216,
					"content": "Beni bırakırsanız size payınızı veririm. Yüzde on sizin, yüzde doksan bizim. Ne dersiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230217,
						721230218
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230217,
					"content": "Yeterli değil ahbap.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230219
					]
				},
				{
					"id": 721230219,
					"content": "Ne dedin? Yettin artık. Alıcımız buraya gelince buradaki Lord Hideaki'ye merhamet etmesi için yalvaran sen olacaksın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230220
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230220,
					"content": "Büyük konuşmayı da biliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230221,
					"content": "Bana bak küçük küstah şeytan! Kardeşlerim beni kurtarmak için her an gelebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230222
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230222,
					"content": "Kimi çağırırsan çağır, kaç kişi gelirse gelsin. Paimon'un kılına zarar veremeden Gezgin hepinizi kovalar buradan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230223,
					"content": "Duydun mu Yamada? Bu ufaklık ona zarar veremeyeceğini söylüyor! Hiçbir şey yapmayacak mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230224
					],
					"speakerTitle": "Hideaki"
				},
				{
					"id": 721230224,
					"content": "Yamada mı? O kim? Gezgin, çabuk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230225,
					"content": "Orada kimse yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721230218,
					"content": "Hayal kurmaya devam et evlat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230219
					]
				}
			]
		},
		{
			"id": 7212303,
			"completionStepIds": [
				7212306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
