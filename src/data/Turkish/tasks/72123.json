			"dialogs": [
				{
					"id": 721230901,
					"content": "Yıldırım Kirazının nerede olduğunu biliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230902
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230902,
					"content": "Yüz ifadene bakacak olursak Yıldırım Kirazının yerlerini bilmiyorsun galiba. Sonuçta buralı olmayan bir Gezginsin. Tahmin etmem gerekirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230903
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230903,
					"content": "Beş Yıldırım Kirazı ağacını bulmak zor değil. Kujou Kışlası adacığının <color=#00E1FFFF>en kuzey noktasından</color> <color=#00E1FFFF>Tatarasuna'nın en kuzey noktasına kadar</color> <color=#00E1FFFF>batı kıyısını</color> takip etmen gerek. O tarafta üç tanesini göreceksin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230904
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230904,
					"content": "Diğer ikisine gelecek olursak, biri <color=#00E1FFFF>Tatarasuna'nın kuzeybatısındaki dağda</color>, diğeri ise <color=#00E1FFFF>güneybatısındaki</color> dağda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230905
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230905,
					"content": "Artık bunları bildiğine göre daha kolay bulabilirsin. Yıldırım Kirazı meselesini sana bırakıyorum. Kendine dikkat et lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Miyuki"
				}
			]
		}
