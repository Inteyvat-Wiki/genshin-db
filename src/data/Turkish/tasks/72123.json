			},
			"dialogs": [
				{
					"id": 721230401,
					"content": "Yıldırım Kirazı meselesi ne durumda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230402
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230402,
					"content": "\"Çocukça oyunlar\" halledildi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230403
					]
				},
				{
					"id": 721230403,
					"content": "Harika, en azından Yıldırım Kirazının durumu düzelir artık. Leydi Miko'nun da rahatlayacağına eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230404
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230404,
					"content": "Bu sahtekarlar hangi yüzle Yıldırım Kirazının gücünü kendi kazançları için çalmaya çalışırlar anlamam. Yaptıkları şeyin affı yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230405
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230405,
					"content": "Hazine Avcılarının kamplarında bir tür kristal küp olduğundan ve Yıldırım Kirazının gücünü bununla toplamaya çalıştıklarından da bahsettin. Çok tehlikeli... Bir an önce çözülmeli bu sorun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230406
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230406,
					"content": "Bana zaten çok yardımcı oldun, o yüzden bunu da tek başına halletmeni isteyemem senden. Ben de seninle geleceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230407
					],
					"speakerTitle": "Miyuki"
				},
				{
					"id": 721230407,
					"content": "Kaybedecek vaktimiz yok. Hadi gidelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Miyuki"
				}
			]
		},
		{
			"id": 7212305,
