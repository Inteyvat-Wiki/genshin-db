			"dialogs": [
				{
					"id": 750320101,
					"content": "Manzara ne güzel, değil mi? Uçmak için de ideal doğrusu. Şöyle göklere yükselip rüzgarın peşine takılmak var ya... Yok böyle bir his!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320102,
						750320103
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320102,
					"content": "Aynen öyle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320104
					]
				},
				{
					"id": 750320104,
					"content": "Selamlar olsun sana savaşçı! Deneme uçuşu yapmak istiyorsan buyur lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320105
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320105,
					"content": "Burayı benim için babam inşa etmişti ama seninle seve seve paylaşırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320106,
						750320107
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320106,
					"content": "Teşekkürler, ben de tam denesem mi diye düşünüyordum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320108
					]
				},
				{
					"id": 750320108,
					"content": "Ne demek efendim! Uçmayı seven herkes Manyoya'nın dostudur! Manyoya ben oluyorum bu arada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320109
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320109,
					"content": "Sürüngen hava bölüğünde olmak için biraz gençsin sen sanki. Yedek süvari falan mısın, yoksa savaşçı olmak için mi eğitim alıyorsun bakayım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320110
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320110,
					"content": "Maceracıyız biz, geçerken uğradık.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320111
					]
				},
				{
					"id": 750320111,
					"content": "Öyle mi? Savaşmaya bu kadar meraklı olan maceracılarla nadiren karşılaşırım. Sen böyle diyene kadar hava bölüğü sınavına çalıştığını düşünüyordum cidden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320112
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320112,
					"content": "Ah, göklerde süzüle süzüle uçmak... Öyle unutulmaz bir his ki anlatamam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320113
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320113,
					"content": "Bu özgürlükten vazgeçmek isteyen bir kişi bile bulamazsın, öyle diyeyim sana. Ben de hayatta vazgeçmem özgürlüğümden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320114
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320114,
					"content": "Sen işini bilen birisin galiba. Hava bölüğünden misin yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750320115,
					"content": "Haha! Eskiden öyleydim. Şimdi emekli oldum tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320116
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320116,
					"content": "Yıllar boyu göklerde uçtum. Çoğu kritere göre yaşlı sayılmam aslında ama hava bölüğünde epey kıdemliydim diyebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320117
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320117,
					"content": "Eh, sonunda eski zindeliğimden eser kalmayınca bölüğe veda etme vakti geldi tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320118
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320118,
					"content": "Aman, öyle acıyan gözlerle bakmayın bana canım. Haha! İnsan eski günleri özlüyor tabii ama öyle çok da üzgün değilim doğrusu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320119
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320119,
					"content": "Bizim genç Sürüngen süvarileri daha yeni havalanmaya başladığında ben çoktan kayan yıldızlardan birine yetişmiştim bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320120
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320120,
					"content": "Ha, o günler artık mazi oldu tabii. Artık zamanımın çoğunu havada geçiremeyecek olsam da hâlâ göklere yükselme şansına sahibim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320121
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320121,
					"content": "Zaten o yüzden buradayım ya. Geride bıraktığım yaşantıyı yad ediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320122
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320122,
					"content": "Yanımda bölük arkadaşlarım olmadan, tek başıma uçarken çok sıkılıyorum da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320123
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320123,
					"content": "Aa, doğru ya. Siz benimle uçmak ister misiniz? Eskiden bölükte sık sık birbirimize karşı yarışırdık, maksat eğlence olsun tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320124
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320124,
					"content": "Sonunda en yüksek puanı alanı havaya fırlatırdık. En düşük puanı alan da yemekleri ısmarlardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320125
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320125,
					"content": "Sürüngen süvarilerinin arasından su sızmıyor belli ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750320126,
					"content": "Evet, hepsi dört dörtlük insanlardır. Hem bölük arkadaşı hem de rakibiz biz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320127
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320127,
					"content": "Aslında bir daha o ortamın keyfini süremeyeceğimden değil işte ama... Hünerlerimin o eski halinden eser kalmadığını da kabul etmem lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320128
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320128,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320129
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320129,
					"content": "Eh, fiziksel gücün azalsa ve karar verme yeteneğin körelse bile edindiğin tecrübeler birikmeye devam ediyor tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320130
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320130,
					"content": "Yani emekli olsam da bölükten emekli oldum sadece, göklerden değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320131
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320131,
					"content": "Ee, yarışmak ister misin? Bakalım kıdemli bir Sürüngen süvarisini havada yakalayabilecek misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320132,
						750320133
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320132,
					"content": "Bana uyar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320134
					]
				},
				{
					"id": 750320134,
					"content": "Hah. Çocuk gibi bir anda size içimi döktüğüm için bana deli deyip geçersiniz diye endişelenmiştim. Neyse ki öyle olmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320135
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320135,
					"content": "Ama olsun, denemek istediğinizde haber verin yeter. Yarışımızın hedefi de şu olsun:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320136
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320136,
					"content": "Zaman sınırı içinde belirlenen yolda Sürüngenini olabildiğince uzağa sür. Skor tutmana yardımcı olacağım. Sonuçlar 4 seviyeye bölünür, ikinci en yüksek kademeyi geçebilirsen kazanmış sayılırsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320137
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320137,
					"content": "Bana meydan okumaya hazır olduğunuzda haber verin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320133,
					"content": "Önce biraz düşüneyim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320134
					]
				},
				{
					"id": 750320107,
					"content": "Teşekkürler. Boş zamanım olduğunda gelirim belki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320108
					]
				},
				{
					"id": 750320103,
					"content": "Merhaba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320104
					]
				}
			]
		},
		{
			"id": 7503202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
