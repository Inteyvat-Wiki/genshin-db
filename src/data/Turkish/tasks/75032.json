					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Manyoya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750320201,
					"content": "Yarışıyor muyuz o halde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320202
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320202,
					"content": "Sürüngenine bin ve yol boyunca son sürat sür ve süre sınırı içinde mümkün olan en yüksek puanı al. <color=#00E1FFFF>İkinci puan kademesini geçersen bu tur senindir.</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320203,
						750320205
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320203,
					"content": "Hazırım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320204
					]
				},
				{
					"id": 750320204,
					"content": "Harika! O halde başlangıç noktasına gidelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320205,
					"content": "Biraz zamana ihtiyacım var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320206
					]
				},
				{
					"id": 750320206,
					"content": "Hiç sorun değil, hazır olunca söyle. Uçmak dediğin her şeyden önce rahatlamak ve eğlenmek için yapılır zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manyoya"
				}
			]
		},
		{
			"id": 7503204,
			"completionStepIds": [
				7503204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7503204",
							"2"
						],
						"stepId": 7503204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Manyoya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750320401,
					"content": "Hahaha! Harikaydın! \"Boynuz kulağı geçer\" derler ya hani, doğruluğu basbayağı kanıtlanmış oldu işte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320402
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320402,
					"content": "Eh, yıldızlar bile kayarken insanlar sonsuza dek gökte kalacak değil ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320403
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320403,
					"content": "Benim miadım dolmuş artık, belli. Mutlu mesut bir şekilde emekli olarak iyi etmişim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320404
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320404,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320405
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320405,
					"content": "Yine de bunu kabullenmek öyle zor ki. Hâlâ gencim, yüzümde bir kırışıklık bile yok. Neden emekli olmak zorundayım ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320406
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320406,
					"content": "Kariyerim nasıl böyle erken sona erdi? Daha zirveye bile ulaşamadan nasıl düşüşe geçtim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320407
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320407,
					"content": "Bu kadar pişman olacağımı bilseydim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320408
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320408,
					"content": "Neyse artık. Tekrar yapacak olsam yine aynı tercihleri yapardım zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320409
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320409,
					"content": "Yine hava bölüğüne katılmak için elimden geleni yapardım, zaten bu kadar hünerli biriyken zor olmazdı. Sonra da bu yaşımda emekli olurdum yine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320410
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320410,
					"content": "Elimden gelenin en iyisini yaptım, şimdi de tek yapabileceğim durumu kabullenmek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320411
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320411,
					"content": "Hayat böyle bir şey işte. Olacakla öleceğe çare yok, kahraman olma hayalleri kursan bile yalnızca kısa bir an için parlayacağını kabul etmen gerekiyor galiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320412
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320412,
					"content": "Manyoya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750320413,
					"content": "Merak etme, arkadaşının harika bir havacı olduğu ortada. Başından beri bana acır gözlerle bakıyordun, şimdi neden huzursuz oldun birden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320414
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320414,
					"content": "Haha! Bu hayat sürprizlerle dolu gerçekten, istesen de istemesen de karşına çıkıyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320415
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320415,
					"content": "Bunu emekli olmuş bir Sürüngen süvarisinden gelen kıymetli bir öğüt gibi düşün. Hem herkesin sorunu kendine, benim dertlerimle bozma moralini şimdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320416
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320416,
					"content": "Çok etkileyici. Keşke kardeşlerim de senin kadar sakin kalabilseydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320417
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320417,
					"content": "Kardeşlerin mi var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750320418,
					"content": "Evet, iki erkek kardeşim var ama onlara bir şey anlatmak ölüm. Bir kulaklarından girip diğerinden çıkar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320419
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320419,
					"content": "Onlar da uçuş becerilerini geliştiriyor... Hımm, gerçi Acomitl hep her şeyden kaçma derdinde. O yüzden idman yapmak yerine saklanıyordur herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320420
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320420,
					"content": "Neyse, o veletleri boş ver şimdi. Ne kadar yetenekli olduğunu iki gözümle gördüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320421
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320421,
					"content": "Zamanın olursa biraz daha idman yap. Gün gelir, hava bölüğü kapına dayanır... Belli mi olur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320422
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320422,
					"content": "Elimden geleni yaparım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750320423
					]
				},
				{
					"id": 750320423,
					"content": "Bunu duymak güzel. Umarım seni tekrar uçarken görebilirim. İyi şanslar genç savaşçı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manyoya"
				}
			]
		},
		{
			"id": 7503206,
			"completionStepIds": [
				7503206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
