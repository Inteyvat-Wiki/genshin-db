			},
			"dialogs": [
				{
					"id": 750320801,
					"content": "Hiç kolay olmasa gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320802
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320802,
					"content": "Kaptanımız yoldan geçen rastgele bir maceracının hava bölüğü üyelerine fark attığını duysa öfkeden küplere binerdi herhalde. Haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320803
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320803,
					"content": "Olsun tabii, canını sıkma sakın. Ben gururumu ayaklar altına almadığın için sana teşekkür etsem yeridir hatta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320804
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320804,
					"content": "Oldukça iyi uçtun ama beni geçebilmen için henüz vakit var gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750320805
					],
					"speakerTitle": "Manyoya"
				},
				{
					"id": 750320805,
					"content": "Daha iyisini yapabileceğini düşünüyorsan tekrar dene bence. Hazır gençken deneyebildiğin kadar denemek lazım. Hem kaybetmek de dünyanın sonu değil ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manyoya"
				}
			]
		},
