			"dialogs": [
				{
					"id": 706830701,
					"content": "Yardımlarınız için teşekkür ederim Fahri Şövalye ve Beyazlı Yardımcı. Sizler gerçekten de Mondstadt'ın ünlü kahramanlarısınız. Savaş Oyunu kayıtlarınız tekrar tekrar incelenip analiz edilmeye değer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830702,
						706830704
					],
					"speakerTitle": "Phonia"
				},
				{
					"id": 706830702,
					"content": "Hehe, harikayız!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706830703
					]
				},
				{
					"id": 706830703,
					"content": "#Hehe, sonuçta {NICKNAME} gerçek hayatta sayısız canavarla yüzleşti! Favonius Şövalyelerine büyük yardımımız dokunmuştur o zaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706830705,
					"content": "Evet, bu Savaş Oyunu gerçekten çok iyiydi. Hem 7. Bölük hem de Şövalyeler bu sonuçları analiz ederek birçok şey öğrenebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830706
					],
					"speakerTitle": "Phonia"
				},
				{
					"id": 706830706,
					"content": "Böylece Mondstadt'ı çevreleyen bölgelerdeki güvenliği artırma çabalarımız daha sorunsuz ilerleyecek. Örneğin yaşlılara yönelik ani Bodurlop saldırılarıyla veya dağ yabanilerinin kervanlara yaptıkları saldırılarla daha iyi bir şekilde başa çıkabileceğiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830707
					],
					"speakerTitle": "Phonia"
				},
				{
					"id": 706830707,
					"content": "Paimon bu saydığın olayların çok fazla yaşandığını düşünüyor... Bir saniye, bu bir daha asla olmayacakları anlamına mı geliyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706830708,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830709
					],
					"speakerTitle": "Phonia"
				},
				{
					"id": 706830709,
					"content": "Ö... Öyle, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706830710,
					"content": "Biraz zaman alacak tabii ama nihayetinde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830711
					],
					"speakerTitle": "Phonia"
				},
				{
					"id": 706830711,
					"content": "Phonia! Phonia! Bir baksana! Ah, Fahri Şövalye ve Beyazlı Yardımcısı da buradaymış! Merhaba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830712
					],
					"speakerTitle": "Ematol"
				},
				{
					"id": 706830712,
					"content": "Yine ne var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830713
					],
					"speakerTitle": "Phonia"
				},
				{
					"id": 706830713,
					"content": "Niye suratını astın? Savaş Oyunuyla alakalı rapor verecektim sadece...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830714
					],
					"speakerTitle": "Ematol"
				},
				{
					"id": 706830714,
					"content": "Öf. Neyse! İstediğin gibi \"savaş oyununu sessiz bir şekilde oynarken\" inanılmaz bir şey keşfettim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830715
					],
					"speakerTitle": "Ematol"
				},
				{
					"id": 706830715,
					"content": "Çok ama çok inanılmaz bir şey mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706830716,
					"content": "Kesinlikle! Her ne kadar bunlar simülasyon olsa da, patlayıcı gücünü on katına çıkarırsak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830717
					],
					"speakerTitle": "Ematol"
				},
				{
					"id": 706830717,
					"content": "Daha önce geliştirdiğimiz minyatür patlayıcı okun tek vuruşta Harabe Muhafızını yenmesi için yeterli olmaz mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830718
					],
					"speakerTitle": "Ematol"
				},
				{
					"id": 706830718,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706830719,
					"content": "?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706830720
					]
				},
				{
					"id": 706830720,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830721
					],
					"speakerTitle": "Phonia"
				},
				{
					"id": 706830721,
					"content": "Önce şunu söyle... Patlayıcı gücünü neden on katına çıkarma ihtiyacı hissettin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830722
					],
					"speakerTitle": "Phonia"
				},
				{
					"id": 706830722,
					"content": "Simülasyon sonuçları öyle daha güzel olmaz mı? Gerçek hayatta mümkün olmayabilir tabii ama bu veriler çok heyecan verici değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830723
					],
					"speakerTitle": "Ematol"
				},
				{
					"id": 706830723,
					"content": "Bu amaca ulaşmak için çok çalışırsak bir gün bu bahsettiğimiz sonuçları elde edebiliriz! Bir Zıpzıp Bodurun neredeyse onda biri gücünde harika bir patlama yaratmak... Of be...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830724
					],
					"speakerTitle": "Ematol"
				},
				{
					"id": 706830724,
					"content": "Patlayıcı gücünü yüz katına çıkarsaydın o zaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830725
					],
					"speakerTitle": "Phonia"
				},
				{
					"id": 706830725,
					"content": "Ne? Haha, çok komik! Klasik Phonia. Patlayıcı gücünü yüz katına çıkarsaydık... Her türlü canavarı ortadan kaldırabilirdik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830726
					],
					"speakerTitle": "Ematol"
				},
				{
					"id": 706830726,
					"content": "Özellikle de Dikenli Balık Kralı türündeki teknolojiyle donatılmış gelişmiş modeli kullanırsak... Tek bir atışta bir grup Harabe Devini yok edebilirdik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830727
					],
					"speakerTitle": "Ematol"
				},
				{
					"id": 706830727,
					"content": "Ciddi misin? O zaman neden daha da ileri gitmiyoruz? On milyon katına çıkaralım! Böylelikle belki Favonius Katedralini de havaya uçururuz, Fontaine Araştırma Enstitüsünün halini hatırını sorar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830728
					],
					"speakerTitle": "Phonia"
				},
				{
					"id": 706830728,
					"content": "Sonra kilise seni herkesin önünde astığında sonunda ben de senden kurtulmuş olurum ve evime normal bir kiracı bulurum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830729
					],
					"speakerTitle": "Phonia"
				},
				{
					"id": 706830729,
					"content": "Şey... Şaka yaptım. Alt tarafı bir şakaydı yani, yemin ederim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830730
					],
					"speakerTitle": "Ematol"
				},
				{
					"id": 706830730,
					"content": "Merak etme, ben de şaka yaptım. Zaten ben senin amirinim. Seni asacak olsalar ihmal nedeniyle ben de sorumlu olurdum. Evi kiralayabileceğim kimse de yok zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830731
					],
					"speakerTitle": "Phonia"
				},
				{
					"id": 706830731,
					"content": "Bir saniye, yani şaka potansiyel kiracının olmaması... Berbat bir şakaymış!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706830732
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706830732,
					"content": "Eveeet, yardımlarınız için ikinize de teşekkür ederim. Ematol, sen de dönünce simülasyon parametrelerini kendi kendine değiştirmemen gerektiğini anlamak için oturup düşüneceksin. İtiraz istemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Phonia"
				},
				{
					"id": 706830704,
					"content": "Yardımcı olabildiğime sevindim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706830705
					]
				}
			]
		}
	]
}