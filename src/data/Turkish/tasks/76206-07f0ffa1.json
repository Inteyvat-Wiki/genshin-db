			"trigger": {
				"objectNames": [
					"Castiglione"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 762060101,
					"content": "Kanou, koşturup durmayı bırak da şu paravanı bitir. Önce şelaleyi nasıl çizeceğini çözsen iyi edersin. Egeria aşkına, kim şelale çizerken dağınık perspektif kullanır ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060102
					],
					"speakerTitle": "Castiglione"
				},
				{
					"id": 762060102,
					"content": "... Hımm? Şey, kusura bakma. Yeni biriymişsin. Ayak seslerinden seni Kanou sandım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060103
					],
					"speakerTitle": "Castiglione"
				},
				{
					"id": 762060103,
					"content": "Burada ne yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762060104
					]
				},
				{
					"id": 762060104,
					"content": "Gördüğün üzere resim yapıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060105
					],
					"speakerTitle": "Castiglione"
				},
				{
					"id": 762060105,
					"content": "Ama yanlış bir fikre kapılmadan önce bir konuda anlaşalım: Hayvan resmi yapmakta yetenekli olabilirim ama çizdiğim hayvanlar yemek için değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060106
					],
					"speakerTitle": "Castiglione"
				},
				{
					"id": 762060106,
					"content": "Bir dakika, yani sanatını yiyebileceğimizi mi söylüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762060107,
					"content": "Madem resmimdeki insanlar artık kanlı canlı karşımda, o zaman resimlerimdeki canavarlar da pekala tabağa konulabilir... *iç çeker* Yine de umarım Liyue'den Bayan Jinggui gibi sürekli benden balık fileto çizmemi isteyip durmazsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060108
					],
					"speakerTitle": "Castiglione"
				},
				{
					"id": 762060108,
					"content": "Sanat, ah yüce Sanat! Hangi çağda olursa olsun, asıl amacı insan ruhunu kurtarmak ve kişinin karakterini geliştirmek olmalıdır. Bizi Hakikat, İyilik ve Güzellik ile daha yüce bir ruhani aleme yönlendirmelidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060109
					],
					"speakerTitle": "Castiglione"
				},
				{
					"id": 762060109,
					"content": "Örneğin en yüksek dağın zirvesinde durduğunda manzara doğal olarak net ve gerçektir. İşte benim ulaşmaya çalıştığım sanat da böyle bir şey.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762060110
					],
					"speakerTitle": "Castiglione"
				},
				{
					"id": 762060110,
					"content": "Hımm... Korkarım bunu tam olarak kavrayamayacaksın. Neticede kelimelerle bir yere kadar anlatılabilir. Şöyle yapalım, sana bir uçan platform çizeyim. Sonra da üzerine çıkıp bizzat deneyimle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Castiglione"
				}
			]
		}
	]
}