			"dialogs": [
				{
					"id": 230381101,
					"content": "Hımm, malzemede sorun olduğunu sanmıyorum. Pişirme usulümün doğru olduğuna da eminim. Ne oldu acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381102
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381102,
					"content": "G-Gezgin... Seni buraya hangi rüzgar attı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381103
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381103,
					"content": "Zakariya yolladı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230381104
					]
				},
				{
					"id": 230381104,
					"content": "O zaman başıma gelenleri duydun herhalde. Rezil oldum, rezil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381105
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381105,
					"content": "Neyse, sen önce ilacı iç.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230381106
					]
				},
				{
					"id": 230381106,
					"content": "P-Peki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381107
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381107,
					"content": "Maruf ilacı içer...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230381108
					]
				},
				{
					"id": 230381108,
					"content": "Oh... Çok daha iyi hissediyorum. Zakariya gerçekten de harika bir doktor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381109
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381109,
					"content": "Reçeteyi neden değiştirdin ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230381110
					]
				},
				{
					"id": 230381110,
					"content": "Geçen sefer birlikte hazırladığımız ilacı hatırlıyor musun? O ilaç pek bir etki göstermedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381111
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381111,
					"content": "Ben de yanlış kaynattığımı veya bazı malzemeleri unuttuğumu düşündüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381112
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381112,
					"content": "O yüzden... Şey... Kendi deneyimlerime dayanarak başka bir ilaç hazırladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381113
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381113,
					"content": "Her ihtimale karşı önce kendim deneyeyim dedim... Gerisini öğrenmiş oldun zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381114
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381114,
					"content": "Bana Dr. Zakariya'dan ilaç getirmesi için birini yollamıştım ama sen ondan önce geldin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381115
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381115,
					"content": "Teşekkür ederim Gezgin. Şimdi biraz dinleneceğim. Sonra da yine hastaları kabul etmeye başlarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381116
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381116,
					"content": "Çok uzun zamandır yoktum... Köylüler beni bekliyordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230381117
					],
					"speakerTitle": "Maruf"
				},
				{
					"id": 230381117,
					"content": "*iç çeker* Şifalı bitkilerim yine az kaldı gerçi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maruf"
				}
			]
		}
