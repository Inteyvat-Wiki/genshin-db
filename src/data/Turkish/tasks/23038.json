			"dialogs": [
				{
					"id": 230380101,
					"content": "Gezgin! Gelsene, senden bir iyilik isteyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380102
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380102,
					"content": "Ne oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230380103
					]
				},
				{
					"id": 230380103,
					"content": "Aaru Köyü'ndeki doktor Maruf'u hatırlıyor musun? Geçen sefer seni benden reçete almaya göndermişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380104
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380104,
					"content": "Zavallı adam bir ilaç hazırlayıp tadına bakmış ama günlerdir öğürüp kusuyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380105
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380105,
					"content": "Söylediğine göre yazdığım ilaç işe yaramamış. O yüzden tarifte bazı değişikliklere gitmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380106
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380106,
					"content": "Nasıl değişiklikler yaptı da bu hale geldi bu adam yahu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380107
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380107,
					"content": "*iç çeker* Mayalama usulü veya kullanılan malzemelerin miktarı dışında bir şeyleri değiştirdi herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380108
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380108,
					"content": "Aynı şey daha önce de olmuştu. Hiç akıllanmıyor bu Maruf...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380109
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380109,
					"content": "Neyse. Belki yapım aşamasında bir sorun çıkmıştır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380110
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380110,
					"content": "Benim için malzemeleri bulabilir misin Gezgin? Ben bir çorbayı pişireyim, sen de onu Maruf'a götür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380111,
						230380112
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380111,
					"content": "Hallederim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230380114
					]
				},
				{
					"id": 230380114,
					"content": "Maruf ona baş ağrısı için verdiğim reçeteyi değiştirmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380115
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380115,
					"content": "Bana üç Henna Yemişi lazım. Getirebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230380112,
					"content": "Yani daha önce böyle bir şey yapmıştı mı diyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230380113
					]
				},
				{
					"id": 230380113,
					"content": "Evet, hem de kim bilir kaç kere. Neyse ki genelde zehirli malzemeleri kullanması gerekmiyor. Onları da kullansa vay halimize...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230380114
					],
					"speakerTitle": "Zakariya"
				}
			]
		},
