			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Arakavi",
					"Arama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730810301,
					"content": "Bu, Arama ve Altın Nara. Çok uzunsunuz. Fakat yanınızdaki şu gümüş rengi şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810302
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810302,
					"content": "Hımm? Gümüş rengi şeye ne olmuş?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810303,
					"content": "Nasıl desem... Daracık ağaç kovuklarına bile rahatlıkla sığabiliyorsunuzdur. Ne kadar güzel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810304
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810304,
					"content": "#Nara geleneklerine göre önce tanışmamız gerek. Bunlar Nara {NICKNAME} ve Paimon. Bu da Arakavi. El sıkışın bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810305
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810305,
					"content": "Bir anlığına kafan karışsa da Arakavi ile tokalaşıyorsun...\\nFazla güç kullanmamaya çalışıyorsun.\\nArakavu'nun eli dokunulduğunda ilginç bir his veriyor.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730810306
					]
				},
				{
					"id": 730810306,
					"content": "Ne kadar etkileyici. Naralar hakkında daha önce bir sürü şey duymuştum ama ilk defa birine dokunuyorum. Bu çok özel bir his!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810307
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810307,
					"content": "Burada bir Nara ağırlayalı uzun zaman oluyor. O günden bu güne tohumlar ağaç oldu, birçok hikaye efsaneye dönüştü. O Nara, iyi bir Naraydı ya da bize öyle anlattılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810308
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810308,
					"content": "#Nara {NICKNAME} iyi bir Naradır. Güçlü ve cesurdur, taş duvarı delip filizlenen bir fidan gibidir. Onlar da Arana'ya yardım etmek için geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810309
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810309,
					"content": "Ah, Arana... Onunla görüşmeyeli uzun zaman oldu. Umarım her şey yolundadır ve Vimara Köyü'ndeki ufak Nara da iyidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810310
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810310,
					"content": "Vimara Köyü'ndeki çocukları tanıyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810311
					]
				},
				{
					"id": 730810311,
					"content": "Tabii ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810312
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810312,
					"content": "Hepimiz tanıyoruz! Arana geri geldiğinde bize küçük Naralar hakkında hikayeler anlattı. Nara Iotham, Nara Bahram ve Narana bizim arkadaşlarımız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810313
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810313,
					"content": "Paimon, bunun \"birini tanımak\" sayılabileceğinden emin değil pek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810314,
					"content": "Ne sayılır peki? Yoksa Nara gibi \"tanıştıktan\" sonra \"el sıkışmamız\" mı gerekiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810315
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810315,
					"content": "Paimon'un demek istediğini anladım ben. Naralar önce birlikte karınlarını doyurur ve hazine ararlar. Ondan sonra birbirlerini tanımış olurlar, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810316,
						730810317,
						730810318
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810316,
					"content": "O kadar da basit değil...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810321
					]
				},
				{
					"id": 730810321,
					"content": "Birbirimizin hikayesini bildiğimiz müddetçe birbirimizi tanıyor sayılırız. Ne de olsa Aranaraların dünyası, şarkıların ve hayallerin dünyasıdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810322
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810322,
					"content": "#Arakavi haklı. Nara {NICKNAME} hakkında bildiklerimiz ve zihnimizde canlananlar, kendisini tarif eden şarkılardan ve rüyalardan geliyor. Böylece onu tanıyor sayılırız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810323
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810323,
					"content": "Paimon'a sorarsanız tüm bunları şimdilik bir kenara bırakabiliriz... Biz arkadaşız zaten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810324,
					"content": "İyi arkadaşlar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810325,
						730810327
					],
					"speakerTitle": "Arama ve Arakavi"
				},
				{
					"id": 730810325,
					"content": "İyi arkadaşlar!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810328
					]
				},
				{
					"id": 730810328,
					"content": "Evet. Utsava Festivalini kutlayacağımız için Arakavi'nin bazı hazırlıklar yapması gerekiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810329,
					"content": "Bu doğru. Bize Bija lazım, değil mi? Arayasa, Aradasa ve Arasudraka'yı Ashvattha Meydanlarını bulmaya gönderdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810330
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810330,
					"content": "Harika! Şey, Paimon merak ediyor da... Neden bu salonların nerede olduğunu bilmiyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810331,
					"content": "Ashvattha'nın Salonları çok ama çok kutsal yerlerdir. Genelde oraya gitmeyiz. Tüm anılar Sarva'da birleşinceye kadar Vasara Ağaçlarının uyuyup rüya görmesini tercih ederiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810332
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810332,
					"content": "Orman hatırlar. Güzel şeyler asla kaybolup gitmez ve tüm acılar sonunda güzel şeylere dönüşür...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810333
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810333,
					"content": "Neyse, orada Ashvattha'nın Salonlarını arayan Arayasa, Aradasa ve Arasudraka'yı bulabilirsin. Sen de git ve onlara yardımcı ol Arama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810334
					],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810334,
					"content": "#Aynen. Eğer ormanda Nara {NICKNAME} ve Paimon ile karşılaşırsak birlikte maceraya çıkabiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810335
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730810335,
					"content": "#Anlaştık. Tanıştığımıza memnun oldum Nara {NICKNAME} ve Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakavi"
				},
				{
					"id": 730810327,
					"content": "O zaman şimdi biraz iş konuşalım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810328
					]
				},
				{
					"id": 730810317,
					"content": "Nasıl anlatsam...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810321
					]
				},
				{
					"id": 730810318,
					"content": "Paimon ve ben birlikte karnımızı doyurup hazine ararız.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730810319
					]
				},
				{
					"id": 730810319,
					"content": "Evet ama biz sadece \"birbirini tanıyan insanlar\" değiliz. Biz çok yakın iki yol arkadaşıyız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730810320,
					"content": "#Aferin size Nara {NICKNAME} ve Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730810321
					],
					"speakerTitle": "Arama"
				}
			]
		},
