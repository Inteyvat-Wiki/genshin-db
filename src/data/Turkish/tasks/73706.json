			"dialogs": [
				{
					"id": 737060101,
					"content": "Herkese müjde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060102
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737060102,
					"content": "Saha Güvenlik Merkezi, Akademinin önemli alimlerinden büyük övgüler alıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060103
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737060103,
					"content": "Yakın bir zamanda, bizim tavsiyelerimiz doğrultusunda bu merkezin yönetimini devralacak bir uzman ekip gönderecekler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060104
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737060104,
					"content": "Bu zamana kadar verdiğiniz destek için hepinize çok teşekkür ederim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060105
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737060105,
					"content": "Vay be Collei, sıkı çalışmanız meyvelerini vermeye başlamış!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060106
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 737060106,
					"content": "Ve devir teslim sürecini bizzat sen yönetiyorsun... Tebrikler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060107
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 737060107,
					"content": "Genç öğrencilerin bu günlerde Collei'den öğrenecekleri çok şey var. Özgüvenin, aktifliğin, liderliğin... Hepsi takdire şayan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060108
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 737060108,
					"content": "Yalnızca tezlerine ve araştırmalarına odaklanan, ancak pratik beceriden yoksun öğrencilerim gibi değilsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060109
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 737060109,
					"content": "D-Doğrusunu söylemek gerekirse kendime çok da güvenmiyorum. Tüm farklı Darşanlar için ara buluculuk yapmak, her şeyi koordine etmek falan... Hâlâ inanamıyorum bunları başarabildiğime.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060110
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737060110,
					"content": "#Ama bunda {NICKNAME} ve Paimon'un da rolü büyük oldu. İkinize de ne kadar teşekkür etsem azdır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060111,
						737060112
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737060111,
					"content": "Ne demek, lafı bile olmaz!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737060113
					]
				},
				{
					"id": 737060113,
					"content": "Evet, biz bu tür işlere alışkınız. Bu yüzden bizim için daha çok... Arkadaşlarla çok özel bir kamp gezisine çıkmak gibiydi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737060114,
					"content": "Biraz bulmaca çözdük, biraz egzersiz yaptık... İnanılmaz eğlenceliydi! Baklava börek gibi hallettik her şeyi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737060115,
					"content": "Off... Paimon'un karnı acıktı şimdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737060116,
					"content": "Madem tüm işlerimiz bitti, neden hep beraber bir kutlama ziyafeti çekmiyoruz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737060117,
					"content": "Haha, Candace ve ben bunu senden önce düşündük bile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060118
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 737060118,
					"content": "Bu taraftan millet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060119
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 737060119,
					"content": "Yaşasın! Ziyafet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737060120,
					"content": "Mm! Tam zamanında!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060121
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 737060121,
					"content": "Sumeru yemeklerinden oluşan böyle bir ziyafet çekmeyeli uzun zaman olmuştu... Paimon normalde yediğinin iki katını, hayır, üç katını yiyebilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060122,
						737060123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737060122,
					"content": "O zaman daha sık gelmeliyiz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737060124
					]
				},
				{
					"id": 737060124,
					"content": "Hah, bu bir meydan okuma mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737060125,
					"content": "Ne dilediğine dikkat et. Cüzdanını da düşünmemiz lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737060126,
					"content": "Mmm! Çöl bölgesine ait yemekler yemeyeli çok uzun zaman olmuştu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060127
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 737060127,
					"content": "Hiç hatırladığım gibi değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060128
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 737060128,
					"content": "Asıl lezzet buymuş meğer. Daha önce tattığım her şey bunun yanında sönük kaldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060129
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 737060129,
					"content": "Sizden bunları duymak çok sevindirici Madam Faruzan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060130
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 737060130,
					"content": "Köyümüze gelen tüm araştırmacılar sizin kadar kibar olsaydı böyle ziyafetleri daha sık verirdik belki de.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060131
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 737060131,
					"content": "Bu arada... Gezi yapmayı planlıyor musun Bayan Amber? Sonuçta buraya kadar geldin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060132
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 737060132,
					"content": "Ah, tabii ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060133
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 737060133,
					"content": "Ormos Limanı'nın kuzeybatısında devasa ağaçlarla dolu bir orman olduğunu duydum. Gövdeleri, Avcının Yeri restoranından bile daha büyükmüş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060134
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 737060134,
					"content": "Bunu kendi gözlerimle görmek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060135
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 737060135,
					"content": "Ağaçlara tırmanabilir ve tepeden kanatlarımla aşağı süzülebilirim! Kulağa çok eğlenceli geliyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060136
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 737060136,
					"content": "O zaman sana yolculuk için biraz atıştırmalık vereyim... Mesela yoğun bir kek ya da mantı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060137
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737060137,
					"content": "Yukarıda rüzgar çok kuvvetli, bu yüzden kolayca ufalanan bir şey istemezsin. Ayrıca daha kalın bir mataraya ihtiyacın olacak, böylece düşürürsen kırılmaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060138
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737060138,
					"content": "Oo, mantı harika fikir! Yumuşacık ve lezzetli oluyorlar. Çok iyi düşündün Collei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737060139,
					"content": "Çöle gelince, kum saati şeklindeki o devasa harabe gibi bazı harabeler görmek istiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060140
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 737060140,
					"content": "Sadece uzaktan gözlem yapacağım. Harabeleriniz koruma altında olabilir, bu yüzden... En iyisi içeri girmemek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060141
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 737060141,
					"content": "Ayrıca içeride uyuyan birileri de olabilir, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060142
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 737060142,
					"content": "Böyle düşünmenize sevindim Bayan Amber. Çok daha iyi olur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060143
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 737060143,
					"content": "Bu arada, vücudun çöl ortamına alışkın olmadığından yolculuk zorlu geçebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060144
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737060144,
					"content": "Nemlendirici krem ve cilt için esansiyel yağlar getirmelisin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060145,
						737060146
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 737060145,
					"content": "Cilt bakımını bile düşünüyoruz demek...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737060147
					]
				},
				{
					"id": 737060147,
					"content": "Doğrusunu söylemem gerekirse, Saha Güvenlik Merkezinin kurulmasına yardım etmek bu seyahatin en güzel yanıydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060148
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 737060148,
					"content": "Ve senin sayende yeni arkadaşlar da edindim Collei! Daha ne isterim ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060149
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 737060149,
					"content": "Mondstadt'a geldiğinizde mutlaka yanıma uğrayın! Size şehrimizin en güzel yerlerini gösteririm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060150
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 737060150,
					"content": "Seve seve!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060151
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 737060151,
					"content": "Fontaine'deyken biraz Karahindiba Şarabı içmiştim... İnanılmazdı! Çok tatlı ve hoş kokuluydu... Hiçbir acılığı yoktu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060152
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 737060152,
					"content": "Üstelik o ithal olanıydı! Tazesinin tadı kim bilir nasıldır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060153
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 737060153,
					"content": "Şimdiden birkaç fıçı devirmeyi planlıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060154
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 737060154,
					"content": "Öhöm... Belki şaraba biraz ara vermende fayda vardır. O çocuklar sana Henna Yemişi dikeni tozu vermişti, hatırlıyor musun? Onlarla çay yapabilirsin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060155
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 737060155,
					"content": "Haha... Hahaha... Hadi ama Candace, sadece tadına bakacağım. Fıçılar da o kadar büyük değil hem... En fazla üç beş kadeh içerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060156
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 737060156,
					"content": "Merak etmeyin, gelirken herkese hediyelik eşyalar getireceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060157
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 737060157,
					"content": "Favonius Şövalyeleri Kütüphanesinde çok sayıda kitap olduğunu duydum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060158
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 737060158,
					"content": "Mühendisliğe farklı bir açıdan yaklaşan kitaplara denk gelir miyim acaba? Bir göz atsam iyi olur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060159
					],
					"speakerTitle": "Faruzan"
				},
				{
					"id": 737060159,
					"content": "Sayısını tam olarak bilmiyorum ama kütüphane epey büyük.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060160
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 737060160,
					"content": "Ne tür kitaplarla ilgileniyorsunuz Madam Faruzan? İstediklerinizi bir kenara yazıp Lisa'dan hazırlamasını isteyebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060161
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 737060161,
					"content": "Sonuç olarak Mondstadt seyahat planlarını bana bırakın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060162
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 737060162,
					"content": "Lisa... Lisa Minci mi? Cyrus'un sürekli övüp durduğu öğrencisi... Demek o da buradaymış!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737060163
					],
					"speakerTitle": "Faruzan"
				},
				{
