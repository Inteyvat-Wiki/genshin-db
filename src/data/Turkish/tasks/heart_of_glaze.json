			"dialogs": [
				{
					"id": 10230301,
					"content": "Oo... <color=#00E1FFFF>Altın Ev</color> bu mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230302,
					"content": "Dışarıdan da oldukça etkileyici görünüyordu ama... İçinin daha da şık ve Mora dolu olabileceğini kim düşünebilirdi ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230303,
					"content": "Teyvat'taki tüm Mora burada basılıyor, değil mi? Bu durumda birkaç Mora eksilse kimse fark etmez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230304,
						10230305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230304,
					"content": "Bir Moraya bile dokunursan biteriz!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230306
					]
				},
				{
					"id": 10230306,
					"content": "Yani bu bir tuzak. Ne kadar da sinsice... İyi ki Paimon'un yanındasın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230307,
					"content": "Bir tane bile alamıyor olabiliriz ama yakından bakabiliriz, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230308,
					"content": "Daha iyisi, şu Mora dağının üzerinde bir kestirsek! Bir hayalin gerçek olması gibi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230309,
						10230310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230309,
					"content": "İlk önce Exuvia'ya bakmamız gerek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230311
					]
				},
				{
					"id": 10230311,
					"content": "Doğru! Tekrar işe koyulalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230312,
					"content": "Sessiz... Çok sessiz. Birileri Exuvia kadar önemli bir şeyi koruyordur öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230313,
					"content": "#Hah! {NICKNAME}, bak! Orada ne olmuş öyle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230314,
						10230315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230314,
					"content": "Taşordu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230315
					]
				},
				{
					"id": 10230315,
					"content": "Bayıltılmışlar!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230316
					]
				},
				{
					"id": 10230316,
					"content": "Oh, Paimon bela kokusu alıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230317,
					"content": "Çabuk! Exuvia iyi durumda mı kontrol etmeliyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230310,
					"content": "Burada bir şeyler eksik gibi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230311
					]
				},
				{
					"id": 10230305,
					"content": "O kadar kolay olsaydı burayı çok uzun zaman önce boşaltırlardı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230306
					]
				}
			]
		},
