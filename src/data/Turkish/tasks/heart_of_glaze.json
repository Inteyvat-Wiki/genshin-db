			"dialogs": [
				{
					"id": 10230201,
					"content": "Kılavuz olarak görevinizi yerine getirdiniz, neden hâlâ buradasınız? Bugünlük yeterince belaya karışmadınız mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230202
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230202,
					"content": "Ha? Kim var orada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230203,
					"content": "Fatui olsaydınız Çariçe'den çok cömert bir ödül almaya hak kazanmıştınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230204
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230204,
					"content": "Fakat şimdi bir artıktan başka bir şey değilsiniz ve yolumu kapatıyorsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230205,
						10230208
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230205,
					"content": "Burada olduğunu nasıl anladın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230206
					]
				},
				{
					"id": 10230206,
					"content": "Hım, nereden başlasam? Öncelikle biliyorsun lafı dolandırmayı hiç sevmem. Fakat Liyue'ye adım attığım anda Toprak Tanrısı'nın gizemli bir şekilde ortadan kaybolacağını ve ardından Exuvia'nın saklanacağını kim tahmin edebilirdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230207
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230207,
					"content": "O gerçekleştirdiğiniz sevimli minik Veda Ayini töreni olmasaydı istediğim bilgileri elde etmek çok daha uzun sürecekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230211
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230211,
					"content": "Mora basılmasını önlemek, Exuvia'yı gizlemek... Ha ha ha, Yedi Yıldız bu sefer elinden geleni ardına koymuyor ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230212
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230212,
					"content": "Bunca zamandır Exuvia'nın içindeki Gnosis'i almayı mı planlıyordun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230213,
					"content": "Fatui'nin On Bir Habercisinden biri olarak Çariçe'nin isteğini yerine getirmek benim görevim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230214
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230214,
					"content": "Arzu ettiğini elde edecektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230215,
						10230216
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230215,
					"content": "Ben bu konuda bir şey yapmazsam tabii.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230217
					]
				},
				{
					"id": 10230217,
					"content": "Hah! Senden izin istemiyorum. Ayrıca beni durdurmak için yapabileceğin bir şey yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230218
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230218,
					"content": "Müzakere ve diplomasinin zamanı çoktan geçti. Aslında bana kalsa o aşamaları çoktan atlamıştım da... Fakat Çariçe'nin uygun gördüğü şekilde hareket etmeliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230219
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230219,
					"content": "Her neyse, sonunda en sevdiğim kısma geldik. Basit bir zevk ancak şimdi seninle paylaşmaktan büyük memnuniyet duyacağım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230220
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230220,
					"content": "Savaş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230221
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230221,
					"content": "Savaş mı? Belasını arayıp bulmaya bayılan tiplerdensin ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230222,
					"content": "Ha ha, öyle denebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230223
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230223,
					"content": "Sinyora, Mondstadt'ın dışındaki Katedraldeki ilahları kızdırdığında görevini tamamladığı gibi hızla oradan çekip gitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230224
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230224,
					"content": "Doğrudan karşına çıkmak yerine kaçmak için kar ve buzdan yararlanmayı seçti. Şövalyelerin savaşın gürültüsünü duyup gelmesini istemezdi, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230225
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230225,
					"content": "Savaşmaya değecek bir rakiple karşılaştığında görevine öncelik verecek, sonuçları tartacak ve eylemlerinin sonuçlarını göz önünde bulunduracaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230226
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230226,
					"content": "Fakat benim için bir Haberci olmanın en keyifli yanlarından biri güçlü rakiplerle kılıç çarpıştırmaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230227
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230227,
					"content": "Mondstadt'ta olanların tekrar olmasına izin vermeyeceğiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230228,
					"content": "Ne? Benimle savaşmak mı istiyorsun? Güzel. Seni öldürmeyeceğim Gezgin. Sırf savaşın heyecanını hissetmek için seninle oynayacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230229
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230229,
					"content": "Ayrıca beni asla alt edemezsin. Rüyanda bile göremezsin. Fakat savaştan keyif almayı dene. Bana sorarsan hayatta bunun dışında ne var ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230230
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230230,
					"content": "Seni yenemez miyim? Sen tamamen kafayı yemişsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230231
					]
				},
				{
					"id": 10230231,
					"content": "Hahahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230232
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230232,
					"content": "Sözlerin düellosu, buna bayılırım! Şimdi laftan ibaret olup olmadığını anlayacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230216,
					"content": "Exuvia'nın yanına yaklaşmana izin vermeyeceğim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230217
					]
				},
				{
					"id": 10230208,
					"content": "Görünüşe göre tam zamanında gelmişim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230209
					]
				},
				{
					"id": 10230209,
					"content": "Hah! Bu gizli yeri zahmetsizce bulmama yardım ettiğiniz için size gerçekten müteşekkirim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230210
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230210,
					"content": "Şimdi beni durdurmaya çalışmanın nafile olacağını düşünmüyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230211
					],
					"speakerTitle": "Asilzade"
				}
			]
		},
