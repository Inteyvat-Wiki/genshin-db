			"dialogs": [
				{
					"id": 10230501,
					"content": "*nefes nefese kalır*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230502
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230502,
					"content": "Bak! Asilzade tekrar normale döndü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230546
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230546,
					"content": "Ah, pekala... Biraz nefeslenmenin zamanı geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230503
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230503,
					"content": "Anlaşılan vücudum Kötülüğün Mirasının yükünü kaldıracak kadar güçlü değil. Bunu etraflıca düşünme fırsatına sahip değildim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230504
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230504,
					"content": "Şimdi olayı daha dikkatle düşününce Gnosis'e benden önce ulaşman mümkün değildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230505
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230505,
					"content": "Nereye götürülmüş olursa olsun Gnosis ile bağlantın yoktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230506
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230506,
					"content": "Biz de sana bunu söylemeye çalışıyorduk! Biz almadık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230507,
					"content": "Bugün ortaya koyduğun hünerler Sinyora'nın Mondstadt'ta seninle ilgili gördüklerinin çok ötesinde. Söyle bana, bu nasıl mümkün olabilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230508,
						10230509
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230508,
					"content": "(Çünkü yedi elementin güçlerini topluyorum...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230510
					]
				},
				{
					"id": 10230510,
					"content": "Yanıtını zaten biliyorsun, değil mi? Gözlerinden okunuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230511
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230511,
					"content": "Fakat bu, kendine saklamak istediğin bir sır ise sanırım merakımı biraz kontrol altında tutmam gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230512
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230512,
					"content": "Halihazırda bu savaş beni memnun etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230513
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230513,
					"content": "Daha güçlü olmayı arzulayan herkes arkadaşım olmalıdır, arkadaşlığımızı sadece karşılıklı çarpışarak göstersek bile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230514
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230514,
					"content": "Bunun arkadaş edinmek için makul bir yol olduğundan pek emin değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230515,
					"content": "Ne yazık ki bu keyifli sohbeti sonlandırmamız gerek. Görev hâlâ beni çağırıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230516
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230516,
					"content": "Gnosis'i kimsenin almamış olduğu düşünülürse bir kez daha en başa dönmeliyiz. Belki de en başından beri Exuvia'nın içinde değildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230517
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230517,
					"content": "Aslında Exuvia bir tür dikkat dağıtma hamlesi idi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230518
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230518,
					"content": "Ne? Yani sence...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230519,
						10230520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230519,
					"content": "Rex Lapis hâlâ yaşıyor mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230521
					]
				},
				{
					"id": 10230521,
					"content": "Görünüşe göre öyle. Oldukça ilginç olduğunu belirtmeliyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230522
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230522,
					"content": "Görünüşe göre ticaretin başkentinin koruyucu tanrısı sözleşmelerin ötesinde işler yapabilecek kadar becerikliymiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230523
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230523,
					"content": "Bu nedenle şimdi yedek planımıza göz atalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230524
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230524,
					"content": "Yedek plan mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230525,
					"content": "Durumun bu hale gelmesini hiç istemiyordum, bu süreçte zayıf olanlar yok olup gidecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230526
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230526,
					"content": "İşin gerçeği, dünya gücün peşine düşenlere aittir. Nadiren zayıflarla isteyerek muhatap olurum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230527
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230527,
					"content": "Ne yazık ki Fatui Habercileri olarak yöntemlerimiz konusunda seçici olamıyoruz. Er ya da geç tüm çocukların sebzelerini yemeyi öğrenmesi gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230528
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230528,
					"content": "Pekala ne yapmayı planlıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230529,
					"content": "Guyun Taş Ormanı'nın altında yatan tanrıyı uyandıracağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230530
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230530,
					"content": "Tanrı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230531
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230531,
					"content": "Hükümdarlar Savaşı'nda Toprak Hükümdarı Morax tarafından alt edilen <color=#00E1FFFF>Girdabın Lordu Osial</color> bunca zamandır dalgaların altında Toprak Hükümdarı'nın taş mızrağıyla mıhlanmış bir halde duruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230532
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230532,
					"content": "Böyle kadim bir tanrı artık ilahının koruması altında olmayan, savunmasız Liyue Limanı'na saldıracak olursa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230533
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230533,
					"content": "Sence kurnaz Rex Lapis bu korkunç yıkımı öylece durup izleyecek midir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230534
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230534,
					"content": "Fakat... Hükümdarlar Savaşı iki bin yıl önce bitti! Kadim bir tanrı Yedilerin hükümdarlığındaki bir dünyaya nasıl adım atabilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230535
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230535,
					"content": "Çok basit! Onu uyandıracak koşulları hazırladım bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230536
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230536,
					"content": "Hey! Onlar Yetki Mühürleri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230537
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230537,
					"content": "Ah, Paimon şimdi hatırladı! Fatui bunları araştırıyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230538,
						10230539
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10230538,
					"content": "Araştırmalarını kendi gözlerimle gördüm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230540
					]
				},
				{
					"id": 10230540,
					"content": "Doğru. Senin eline geçen ise sadece araştırmamızın bir yan ürünü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230541
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230541,
					"content": "Bu kadar çok Yetki Mührünün tek bir noktaya odaklanmasıyla ve bir Haberci olarak Çariçe'mizin bana bahşettiği güç ile... Toprak Hükümdarı'nın mızraklarının zapt edici kudretini bir süreliğine de olsa ortadan kaldırmak hiç de zor olmayacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230544
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230544,
					"content": "Kadim tanrıların güçlerini bu şekilde kullanmak ilgimi çekmiyor ve büyük ölçüde prensiplerime aykırı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230545
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230545,
					"content": "Fakat böyle bir eylemin hem Toprak Hükümdarı'nın hem senin elini göstermeye zorlaması... Bu durum işleri daha ilginç bir hale getiriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10230539,
					"content": "Onları kopyalamaya çalışıyordun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230540
					]
				},
				{
					"id": 10230520,
					"content": "Cesedi sahte miydi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230521
					]
				},
				{
					"id": 10230509,
					"content": "(Çünkü yavaş yavaş eski gücüme kavuşuyorum...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230510
					]
				}
			]
		}
	]
}