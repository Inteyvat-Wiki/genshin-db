			"dialogs": [
				{
					"id": 732150101,
					"content": "Merhaba Nara dostum! Şey... Sana bir şey söylemem gerekiyordu ama ne olduğunu unuttum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150102
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 732150102,
					"content": "Sorun değil. Seni yine gördüğümüze çok sevindik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150103,
					"content": "Teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150104,
						732150106
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 732150104,
					"content": "\"Mawtiyima\" hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150105
					]
				},
				{
					"id": 732150105,
					"content": "O artık hiç konuşmuyor ama iyi durumda. Orman da iyileşiyor... Teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 732150106,
					"content": "Unutkanlık hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150107
					]
				},
				{
					"id": 732150107,
					"content": "Unutkanlık mı? Kusavanın gücü tükendiği için oluyor. Hafızam da o yüzden yakında uçup gidecek. Damla damla azalacak, tıpkı çiy taneleri gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranaga"
				}
			]
		},
