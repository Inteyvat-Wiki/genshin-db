			"dialogs": [
				{
					"id": 732150501,
					"content": "Merhaba Altın Nara ve Ufak Uçuşkan Beyazlı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150502
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 732150502,
					"content": "Hıh, Paimon ufak değil bir kere! Sen önce git de aynaya bak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150503,
					"content": "Ben de ufak değilim ki! Ah, doğru ya. Burada ne yapıyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150504
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 732150504,
					"content": "Sizi görmek için geldik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150505
					]
				},
				{
					"id": 732150505,
					"content": "Evet, ne de olsa geçmişte beraber bir sürü kötü adamı yendik. Beraber şarkı söyledik, hatta beraber \"Mootaya\"yı bile kurtardık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150506,
					"content": "Mawtiyima!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150507
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 732150507,
					"content": "Evet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150508,
					"content": "Üzgünüm... Eminim doğruyu söylüyorsunuzdur ama ben hatırlayamıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150509
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 732150509,
					"content": "Şey, hiç önemli değil! Üzülme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150510,
					"content": "(Gerçekten de hatırlamıyor...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
