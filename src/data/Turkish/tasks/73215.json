				{
					"id": 732150601,
					"content": "Altın Nara ve Uçuşkan Beyazlı! Geldiniz demek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150602
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150602,
					"content": "Evet, geldik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150603,
					"content": "Hehehe... Muhtemelen çoğu şeyi unuttum, o yüzden bana hatırlatmanız lazım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150604
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150604,
					"content": "Kusava yüzünden mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150605
					]
				},
				{
					"id": 732150605,
					"content": "Evet... Aranaga'nın size bahsetmiş olması lazım. Güç hafızada saklıdır. Hafızan yoksa gücün de yoktur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150606
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150606,
					"content": "Yani... Geçmişte bir şeyler yaşamış olmalıyız fakat artık hiçbir şeyi hatırlayamıyoruz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
