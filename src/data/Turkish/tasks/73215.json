			"dialogs": [
				{
					"id": 732150301,
					"content": "Merhaba ve teşekkürler Altın Nara ve Uçuşkan Beyazlı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150302
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150302,
					"content": "Burada ne yapıyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150303
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150303,
					"content": "Yine gelin de beraber oynayalım demiştin ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732150304,
					"content": "Öyle mi demiştim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150305,
						732150307
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150305,
					"content": "Öyle demiştin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150306
					]
				},
				{
					"id": 732150306,
					"content": "Anladım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150309
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150309,
					"content": "Neyse, teşekkür ederim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 732150307,
					"content": "Ne oldu, neden mutsuzsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150308
					]
				},
				{
					"id": 732150308,
					"content": "Hayır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150309
