			"dialogs": [
				{
					"id": 3532801,
					"content": "Aah! Az önce, bu dünyanın elementlerini mi hissettin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532802,
					"content": "Görünüşe göre, tüm yapman gereken yalnızca heykele dokunmaktı ve Rüzgarın gücüne sahip oldun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532803,
					"content": "Bu dünyadaki insanlar, ne kadar çok isteseler de güçlere asla senin kadar kolaylıkla sahip olamazlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532804,
						3532807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532804,
					"content": "Sanırım bunun nedenini biliyorum, çünkü...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3532805
					]
				},
				{
					"id": 3532805,
					"content": "Aha, bunun nedeni, en başta senin bu dünyaya ait olmaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532809,
					"content": "Buradan batıya doğru devam edersek, sonunda Özgürlük Şehri olan Mondstadt'a ulaşabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532817,
					"content": "Mondstadt rüzgarın şehridir çünkü Rüzgar Tanrısı'na taparlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532810,
					"content": "O yüzden belki de, Rüzgar Tanrısı'ndan güç aldığın için orada bazı ipuçları bulabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532811,
					"content": "Ayrıca, orada çok sayıda ozan vardır, belki de onlardan biri kardeşinle ilgili bir haber duymuştur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532812,
					"content": "O zaman, hadi harekete geçelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532813,
					"content": "Bu dünyadaki elementler senin dualarına yanıt verdi ve Paimon bunun harika bir işaret olduğunu düşünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3532807,
					"content": "Bu iyi değil...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3532808
					]
				},
				{
					"id": 3532808,
					"content": "Tanrıların az önce sana verdiği güçler hakkında söylemek için birazcık kaba bir söz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3532809
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
