			},
			"dialogs": [
				{
					"id": 130201401,
					"content": "Mondstadt'ta eski bir arkadaşım da var. Neden beraber gitmiyoruz? Bize etrafı gezdirmesini de isteyebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201402
					],
					"speakerTitle": "Rancho"
				},
				{
					"id": 130201402,
					"content": "Bu harika olur! Teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piah"
				}
