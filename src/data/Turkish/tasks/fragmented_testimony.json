				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130200101,
					"content": "Tezin nasıl gidiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200102
					],
					"speakerTitle": "Rancho"
				},
				{
					"id": 130200102,
					"content": "Önümüzdeki ay yayınlayabilirim sanıyorum. *iç çeker* Birkaç gün önce çalışmamı yarıda bırakmak zorunda kalacağımdan endişeleniyordum. Neyse ki öyle bir şey olmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200103
					],
					"speakerTitle": "Piah"
				},
				{
					"id": 130200103,
					"content": "Azar senin tez danışmanlarından biriydi. Açıkçası seni de kendisiyle birlikte sürükleyeceğinden korkmuştum. İşler nasıl halloldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200104
					],
					"speakerTitle": "Rancho"
				},
				{
					"id": 130200104,
					"content": "Yeni gelen Büyük Bilge Vekili projelerimizi inceledi ve araştırmalarımıza devam etmemiz için bize izin verdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200105
					],
					"speakerTitle": "Piah"
				},
				{
					"id": 130200105,
					"content": "Büyük Bilge Vekili mi? Yeni bir şey mi bu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200106
					],
					"speakerTitle": "Rancho"
				},
				{
					"id": 130200106,
					"content": "Evet, duyduğuma göre yeni bilgeleri seçmek biraz zaman alıyormuş o yüzden o da, geçici olarak yerine bakıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200107
					],
					"speakerTitle": "Piah"
				},
				{
					"id": 130200107,
					"content": "Ama onun sayesinde araştırma sonuçlarımız tehlikeye girmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200108
					],
					"speakerTitle": "Piah"
				},
				{
					"id": 130200108,
					"content": "Makalem bir yayınlansın kesinlikle kendime bir tatil verip güzelce dinleneceğim. Mondstadt bunun için güzel bir fikir gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200109
					],
					"speakerTitle": "Piah"
				},
				{
					"id": 130200109,
					"content": "Alhaitham'ı Büyük Bilge Vekili yaptıklarına göre gerçekten çıldırmış olmalılar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200110
					],
					"speakerTitle": "Rajkumar"
				},
				{
					"id": 130200110,
					"content": "Sakin olun Profesör. Benim de kafam karışmış durumda. Becerilerinizi düşünürsek siz bizim en önde gelen alimlerimizden birisiniz. Neden onun gibi genç birini seçtiklerini ben de anlamadım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200111
					],
					"speakerTitle": "Rehan"
				},
				{
					"id": 130200111,
					"content": "Aptal! Neden o pozisyona ben seçilmedim diye mi sinirlendiğimi sanıyorsun? Hayır, neden özellikle onu seçtiklerini anlamadığımdan sinirliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200112
					],
					"speakerTitle": "Rajkumar"
				},
				{
					"id": 130200112,
					"content": "Benim öğrencilerimden biriydi ancak derslere nadiren katılırdı. Ona bunu sorduğumda da kendi kendine çalışınca zamanını daha iyi kullandığını söylerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200113
					],
					"speakerTitle": "Rajkumar"
				},
				{
					"id": 130200113,
					"content": "Ne küstahlık! Rezillik... Akademinin onu Büyük Bilge Vekili yapması mı? *öksürür* *öksürür*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200114
					],
					"speakerTitle": "Rajkumar"
				},
				{
					"id": 130200114,
					"content": "Profesör, bu kadar sinirlenmeyin. Ben gidip size su getireyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200115
					],
					"speakerTitle": "Rehan"
				},
				{
					"id": 130200115,
					"content": "Şşş... Bir sır vereyim mi? Duyduğuma göre Büyük Bilge Vekili, Haravatat'tanmış!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200116
					],
					"speakerTitle": "Rezakhani"
				},
				{
					"id": 130200116,
					"content": "Gerçekten mi? Kimmiş?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200117
					],
					"speakerTitle": "Fariba"
				},
				{
					"id": 130200117,
					"content": "Alhaitham adında biri. Onunla hiç bizzat tanışmadım ama şu sıralar çok popüler, hakkında bir sürü şey anlatılıyor. Ne doğru ne yanlış söylemek zor tabii...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200118
					],
					"speakerTitle": "Rowshan"
				},
				{
					"id": 130200118,
					"content": "Son zamanlarda dikkatleri üzerine çeken bir Vahumana alimi de var. Seçilecek bilgelerden biri olabileceğini söylüyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200119
					],
					"speakerTitle": "Rowshan"
				},
				{
					"id": 130200119,
					"content": "Ha? Ders falan veriyor mu? Belki bir gideriz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200120
					],
					"speakerTitle": "Fariba"
				},
				{
					"id": 130200120,
					"content": "Vay canına, Alhaitham'ın Büyük Bilge Vekili olduğunun haberi hızla yayılıyor. Gerçi bazıları onu tanımıyorlar ama. Sanırım o Paimon'un düşündüğü kadar ünlü değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130200121,
					"content": "Bazıları iyi diyor bazıları kötü... Özellikle az önceki şu yaşlı adam. Gerçekten Alhaitham'ı hiç sevmiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130200122,
					"content": "Hey, sen iyi misin? Ah, pek iyi görünmüyorsun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130200123,
					"content": "Matra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200124
					],
					"speakerTitle": "Ilyas"
				},
				{
					"id": 130200124,
					"content": "Matra mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130200125,
					"content": "Ben Ilyas. Bir Matra ile önemli bir şey konuşmam lazım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200126
					],
					"speakerTitle": "Ilyas"
				},
				{
					"id": 130200126,
					"content": "Bu halde mi? Kendini zorlamaman lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130200127,
					"content": "Ne olduğunu bize anlat, biz senin mesajını Matraya iletiriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130200128,
					"content": "Olmaz, kendim söylemem lazım. Tek güvenebileceğim onlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200129
					],
					"speakerTitle": "Ilyas"
				},
				{
					"id": 130200129,
					"content": "Pardon, beni taşıyabilir misiniz acaba? Bu önemli bir konu. Hataya yer yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200130
					],
					"speakerTitle": "Ilyas"
				},
				{
					"id": 130200130,
					"content": "Madem öyle diyorsun, tamam, seni bir Matraya götüreceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1302003,
			"completionStepIds": [
				1302003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1302003",
							"2"
						],
						"stepId": 1302003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aarav"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130200301,
					"content": "Ah, merhaba! Rahatsız ediyoruz ama Cyno Akademide mi acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130200302,
					"content": "Siz ikiniz tanıdık geliyorsunuz. Mahamatra Cyno'nun arkadaşları mısınız? Şey, kendisi şu an bir görev için dışarıda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200303
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 130200303,
					"content": "Ama isterseniz mesajınızı kendisine iletebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200304
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 130200304,
					"content": "Biz bu adama kapının orada rastladık ve bir Matrayla konuşmak için can atıyordu. Sanırım acil bir konu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130200305,
					"content": "Hı? Sakıncası yoksa önce bana bir anlatabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200306
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 130200306,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200307
					],
					"speakerTitle": "Ilyas"
				},
				{
					"id": 130200307,
					"content": "Siraj...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200308
					],
					"speakerTitle": "Ilyas"
				},
				{
					"id": 130200308,
					"content": "Siraj mı? Bu isim tanıdık geliyor. Vahumana araştırmacısı değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200309
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 130200309,
					"content": "Vahumana araştırmacısı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130200310,
					"content": "Evet, hatta en tanınanlarından biri. Zeki olduğu kadar cesaretli olduğunu da duymuştum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200311
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 130200311,
					"content": "Vahumana'nın bir sonraki bilgesinin onun olacağıyla ilgili söylentiler var... Ah, ama lütfen devam et. Siraj'la ilgili ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200312
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 130200312,
					"content": "Tehlikeli bir deney yaptığı için onu ihbar etmek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200313
					],
					"speakerTitle": "Ilyas"
				},
				{
					"id": 130200313,
					"content": "Beni kaçırdı, bağladı ve o korkunç mağaraya götürdü... Her yerde deney malzemeleri vardı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200314
					],
					"speakerTitle": "Ilyas"
				},
				{
					"id": 130200314,
					"content": "Koşabildiğim kadar hızlı koştum... Biraz daha yavaş olsam beni yakalardı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200315
					],
					"speakerTitle": "Ilyas"
				},
				{
					"id": 130200315,
					"content": "Sakin ol, lütfen, acele etmene gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200316
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 130200316,
					"content": "Ne tür bir deney yapıyordu? Mağara nerede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200317
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 130200317,
					"content": "Hatırlamıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200318
					],
					"speakerTitle": "Ilyas"
				},
				{
					"id": 130200318,
					"content": "Ha? Hatırlamıyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130200319,
					"content": "Tek hatırladığım, Siraj bana doğru yürüyordu sonra bir anda başım... Tuhaf hissetmeye başladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200320
					],
					"speakerTitle": "Ilyas"
				},
				{
					"id": 130200320,
					"content": "Hatırlayamadığım bir kabus gibi... Tek bildiğim o yerin tehlikeli olduğu ve onların durdurulması gerektiği!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200321
					],
					"speakerTitle": "Ilyas"
				},
				{
					"id": 130200321,
					"content": "Ah, işi handa yaptıklarını duydum. Acele etmemiz lazım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200322
					],
					"speakerTitle": "Ilyas"
				},
				{
					"id": 130200322,
					"content": "Madem öyle diyorsun... *iç çeker* Tamam, ben bazı iş arkadaşlarımdan Siraj'ı araştırmalarını isteyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200323
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 130200323,
					"content": "Ama ondan önce sana, Matranın yalan makinası testini yapmak istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200324
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 130200324,
					"content": "Yalan söylediğimi mi düşünüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200325
					],
					"speakerTitle": "Ilyas"
				},
				{
					"id": 130200325,
					"content": "Lütfen yanlış anlama bu sadece standart bir protokol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200326
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 130200326,
					"content": "Pardon, siz ikiniz biraz burada bekleseniz olur mu? Biz hemen döneceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200327
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 130200327,
					"content": "Düşündüğünüzden biraz daha fazla bekliyorsunuz...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130200328
					]
				},
				{
					"id": 130200328,
					"content": "Hı? Alhaitham?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130200329,
					"content": "Size hemen anlatayım. İlk olarak, Ilyas yalan makinası testini geçti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200330
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 130200330,
					"content": "Bu da söylediklerinin son derece güvenilir olduğunu gösterir. Bu yüzden verdiği ipuçlarına dayanarak bir soruşturma başlatmaya karar verdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200331
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 130200331,
					"content": "Protokol gereği bu olay Büyük Bilge Vekili Alhaitham'a bildirildi. Olayı duyduktan sonra Mahamatra Cyno'ya bir mesaj bırakıp soruşturmaya katılmak istedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200332
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 130200332,
					"content": "Senin Matrayla çalışıyor olman biraz tuhaf. Özel bir nedeni falan mı var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130200333,
					"content": "Fazla düşünüyorsun. Sadece ilgimi çekti, hepsi bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200334
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130200334,
					"content": "Gerçekten mi? Paimon bu kadar boş vaktin olmasına şaşırdı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130200335,
					"content": "#O halde... Biz de katılalım {NICKNAME}, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130200336,
					"content": "Büyük Bilge Vekili Alhaitham'ın bu soruşturmaya katılması zaten protokole aykırı. Siz ikinize gelince de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200337
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 130200337,
					"content": "Ah, neyse. Sonuçta Ilyas'ı buraya getiren sizdiniz. O yüzden bize katılmanıza müsaade ediyorum, ama her şeyin gizli kalacağına dair söz vermeniz lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200338
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 130200338,
					"content": "Merak etme sen! Bizden sır çıkmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130200339,
					"content": "Pekala. O zaman, şimdiye kadar bildiklerimizin bir üstünden geçeyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200340
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 130200340,
					"content": "Ilyas, Siraj'ın bir Kshahrewar araştırmacısıyla handa bir iş yapacaklarını iddia etti. Bu, hatırladığı birkaç net şeyden biri. Görünüşe göre bu bilgiye kaçarken denk gelmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200341
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 130200341,
					"content": "Ne tesadüf, Siraj şu an Akademide değil. Bir ay önce, Akademi dışında uzun süreli bir araştırma yapmak için başvurmuştu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200342
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 130200342,
					"content": "Bu, Ilyas'ın söylediği zamana yakın. Bu yüzden biz de hana gidip şüpheli biri var mı diye araştırmaya karar verdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200343
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 130200343,
					"content": "Evet. Aarav, yola çıkmaya hazırlan. Siz ikiniz de ne istiyorsanız onu yapabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200344
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130200344,
					"content": "Ah, hadi ama! Geleceğimizi zaten söylemiştik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1302005,
			"completionStepIds": [
				1302005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1302005",
							"2"
						],
						"stepId": 1302005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Alhaitham"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130200501,
					"content": "Geldik, Büyük Bilge Vekili Alhaitham. Şimdi ne yapacağız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200502
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 130200502,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200503
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130200503,
					"content": "Büyük Bilge Vekili Alhaitham?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200504
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 130200504,
					"content": "Anlaşılan son zamanlarda notları okumuyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200505
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130200505,
					"content": "Akademinin yeni bildirisinde, devam eden bir araştırma sırasında Matranın eylemlerine bir bilgenin bile müdahale etme hakkının olmadığı açıkça belirtiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200506
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130200506,
					"content": "Üstünüz burada olsa bana ne yapacağını sormaz aksine işe karışmamamı söylerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200507
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130200507,
					"content": "Haklısınız. Anlaşıldı! O halde biz çevreyi kontrol altına alıp şüphelileri ararken lütfen bizi burada bekleyin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200508
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 130200508,
					"content": "Ilyas, lütfen burada kal. Büyük Bilge Vekili Alhaitham, sizden, ana tanığımızı korumanızı istemem gerekecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200509
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 130200509,
					"content": "Olur, tabii ben onun kendisini korumasını tercih ederim ama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200510
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130200510,
					"content": "O hep böyle... İnsanları kolayca görmezden gelebiliyor, tıpkı Aaru Köyü'ndeyken yaptığı gibi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130200511,
					"content": "Basit bir soruya yanıt vermek sadece soruyu soran kişiye fırsat vermek olur. Ayrıca konumumu net bir şekilde anlamasını sağlamalıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200512
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130200512,
					"content": "Ne demek istiyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130200513
					]
				},
				{
					"id": 130200513,
					"content": "Aarav'ın da tıpkı sizin gibi benim buraya gelmemle ilgili şüpheleri var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200514
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130200514,
					"content": "Ama sizin aksinize, \"Büyük Bilge Vekili, Matranın gücünü ele geçirmek istiyor.\" gibi düşüncelerle durumu olduğundan daha karmaşık bir hale getiriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200515
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130200515,
					"content": "Belli ki sorduğu tuzak bir soruydu. Matra bir zamanlar bilgelerin etkisi altındaydı ve genellikle kendilerini bu tarz bürokratik tuzakların içinde buluyorlardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200516
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130200516,
					"content": "Beni test etmesine gerek yoktu tabii. Umarım bu sefer işlerine karışmayacağımı anlamıştır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200517
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130200517,
					"content": "Off! Niye bu kadar karmaşık?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130200518,
					"content": "İşte bu yüzden en başta Büyük Bilge Vekili olmaya bu kadar karşıydım. Unvanlar ve rütbeler kaçınılmaz olarak işleri normalden daha sıkıntılı bir hale getiriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200519
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130200519,
					"content": "Affedersiniz, Büyük Bilge Vekili Alhaitham.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200520
					],
					"speakerTitle": "Ilyas"
				},
				{
					"id": 130200520,
					"content": "Aklımda bir soru var ve ne olursa olsun cevabı öğrenmem lazım... Daha önce tanışmış mıydık?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200521
					],
					"speakerTitle": "Ilyas"
				},
				{
					"id": 130200521,
					"content": "Hayır, seninle tanıştığımı hatırlamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200522
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130200522,
					"content": "Haha, ben de öyle düşünmüştüm... Muhtemelen sizin rütbenizde biriyle tanışma fırsatım olmamıştır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200523
					],
					"speakerTitle": "Ilyas"
				},
				{
					"id": 130200523,
					"content": "O zaman neden sordun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200524
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130200524,
					"content": "Nedense ilk tanıştığımızda bir yakınlık hissettim de ondan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200525
					],
					"speakerTitle": "Ilyas"
				},
				{
					"id": 130200525,
					"content": "Öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200526
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130200526,
					"content": "Belki de yanlış düşündün, ya da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200527
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130200527,
					"content": "Büyük Bilge Vekili Alhaitham, bir şüpheliyi yakaladık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200528
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 130200528,
					"content": "Siraj mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200529
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130200529,
					"content": "Hayır, onunla anlaşma yapan Kshahrewar araştırmacısı. Adı Narendra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200530
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 130200530,
					"content": "Büyük Bilge V-Vekili Alhaitham?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200531
					],
					"speakerTitle": "Narendra"
				},
				{
					"id": 130200531,
					"content": "Bir dakika, biri bana neler olduğunu açıklayabilir mi? Laboratuvardan bazı mekanik parçaları çalıp sattığımı kabul ediyorum ancak bu gerçekten bizzat Büyük Bilge Vekilinin müdahale etmesi gereken bir şey mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200532
					],
					"speakerTitle": "Narendra"
				},
				{
					"id": 130200532,
					"content": "Ne... Kendimi neyin içine soktum ben böyle? B-Ben açgözlülüğüme yenik düştüm evet, ama lütfen, yemin ederim bir daha böyle bir şey olmayacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200533
					],
					"speakerTitle": "Narendra"
				},
				{
					"id": 130200533,
					"content": "Ona birkaç soru sormak istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200534
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130200534,
					"content": "Tabii ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200535
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 130200535,
					"content": "Siraj'ı tanıyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200536
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130200536,
					"content": "Evet, alıcının adı buydu. Alışverişi handa yapmak istedi ama asla gelmedi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200537
					],
					"speakerTitle": "Narendra"
				},
				{
					"id": 130200537,
					"content": "Alışverişin içeriği neydi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200538
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130200538,
					"content": "Yaptığı deney için güç jeneratörleri ve elektrik aksamına ihtiyacı varmış. Bunlardan sadece bizim projemizde bulunuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200539
					],
					"speakerTitle": "Narendra"
				},
				{
					"id": 130200539,
					"content": "Bana özel olarak ulaştı ve malzemelerin kusurlu olduğunu bahane edip ona verecek olursam bana büyük miktarda Mora ödeyeceğini söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200540
					],
					"speakerTitle": "Narendra"
				},
				{
					"id": 130200540,
					"content": "Normalde bugün handa buluşup alışverişi yapacağımızı konuşmuştuk. Beni ekeceğini ya da sizinle karşılaşacağımı tahmin etmezdim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200541
					],
					"speakerTitle": "Narendra"
				},
				{
					"id": 130200541,
					"content": "Belki de Siraj, Ilyas'ın bilgi sızdıracağını biliyordu ve bu yüzden bilerek gelmedi. Her koşulda, bu ipucu burada sona eriyor gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200542
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 130200542,
					"content": "İyi haber, Siraj ne planlıyor olursa olsun güç jeneratörü ve elektrik aksamı olmadığı için ilerlemesi ciddi bir şekilde engellenecek. Araştırmamız için hâlâ biraz zamanımız var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200543
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 130200543,
					"content": "Şüpheliye sormak istediğiniz başka sorunuz var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200544
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 130200544,
					"content": "Hayır, o size emanet. Fakat Ilyas ile biraz konuşmak istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200545
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130200545,
					"content": "Sorun değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200546
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 130200546,
					"content": "Kapsamlı bir yalan makinası testi yaptık ve onun gerçekten bir hafıza kaybı yaşadığı sonucuna vardık. Buradan başka bir gelişme beklemiyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200547
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 130200547,
					"content": "Ama yine de merak ettim... Onu tam olarak neden görmek istiyorsunuz acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200548
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 130200548,
					"content": "Hafıza kaybı ile ilgili birkaç makale okumuştum. Hafızasını geri getirmeyi denemek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200549
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130200549,
					"content": "Anlıyorum... O zaman biz Akademiye dönüyoruz. Ilyas'ı size bırakıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200550
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 130200550,
					"content": "Beni takip et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alhaitham"
				}
			]
		},
