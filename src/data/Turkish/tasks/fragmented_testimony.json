		{
			"id": 1302012,
			"completionStepIds": [
				1302012
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1302012",
							"2"
						],
						"stepId": 1302012,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Alhaitham"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130201201,
					"content": "Siraj hana gelmemiş ve Narendra da bize bir ipucu vermedi... Burada takılı kaldık demek ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130201202,
					"content": "Alhaitham, gerçekten bu işin sonunu getirecek misin? Paimon bu konu ile bu kadar ilgilenmene şaşırıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130201203,
					"content": "Sebebini şimdiye anlarsın sanmıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201204
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130201204,
					"content": "#Ha? Paimon'un hiçbir fikri yok. {NICKNAME} sen anladın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130201205,
					"content": "Siraj'ı tanıyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130201206
					]
				},
				{
					"id": 130201206,
					"content": "Evet. Sınıf arkadaşıydık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201207
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130201207,
					"content": "Haa, demek o yüzden Aarav sana durumu bildirdiğinde beraber gitmek istedin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130201208,
					"content": "O zaman senin ilgini çeken şey olayın kendisi değil, şüpheli ile olan ilişkin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130201209,
					"content": "Söylediklerin gerçekten ancak bu kadar uzak olabilirdi ama senden fazla bir şey beklemiyordum zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201210
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130201210,
					"content": "Şimdilik bir zamanlar sınıf arkadaşı olduğumuzu bilmen yeter. Daha sonra ben katip oldum o da akademik alanda çalışmaya devam etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201211
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130201211,
					"content": "Geçen sene bir tez sunmuştu ve o zamanki Büyük Bilge benim fikrimi istemişti. Ben onayımı vermemiştim çünkü insan evrimini konu alarak altı temel günahtan birini işlemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201212
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130201212,
					"content": "İnsan evrimine ilişkin konuların ihlal edilmesinden, yasaklı konuların pervasızca zorlanmasına kadar uzanan altı temel günah, bu dünyadaki tüm kötülüğün kaynağıdır. Bilgeler, Akademinin kurallarını oluştururken veya onları düzenlerken bunu esas alırlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201213
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130201213,
					"content": "Benim fikrim, Siraj'ın araştırmasının hem çok toyca olduğu, hem de birçok temel prensibi ihlal ettiği yönündeydi. Büyük Bilge benim önerilerimi kurula taşıdı ve sonunda başvuruyu reddetti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201214
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130201214,
					"content": "Demek bu yüzden enerji kaynağı ve elektrik aksamları satın alıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130201215,
					"content": "Büyük ihtimalle kurallara takılmadan, gizlice deney yapmaya çalışıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201216
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130201216,
					"content": "Kulağa aşırı şüpheli geliyor... Onu durdurmalıyız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130201217,
					"content": "Ilyas, tekrar hatırlamaya çalışır mısın? Belki bir şeyler çıkar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130201218,
					"content": "Üzgünüm ama birçok kez denedim zaten. Ne kadar zorlarsam zorlayayım, zihnim kalın bir sisle kaplıymış gibi hissediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201219
					],
					"speakerTitle": "Ilyas"
				},
				{
					"id": 130201219,
					"content": "Aşırı stres durumlarında insan hafızası refleks olarak bazı hatıralarını unutarak kendini korumayı seçebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201220
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130201220,
					"content": "Fakat hatıralar tamamen kaybolmaz, sadece mühürlenir. Zihin doğru şekilde uyarıldığında geri getirilebilirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201221
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130201221,
					"content": "Şimdi, senin için önemli olan şeyleri hatırlamaya çalışalım. Konumuzla ilgisi olması gerekmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201222
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130201222,
					"content": "Aslında... Unuttuklarım sadece kaçırılıp üzerimde deney yapıldığı zamana ait hatıralar değil gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201223
					],
					"speakerTitle": "Ilyas"
				},
				{
					"id": 130201223,
					"content": "Nasıl bir insan olduğum ve yaptıklarım... Bazı şeyleri hatırlıyorum ama bazılarını ne kadar denersem deneyeyim hatırlayamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201224
					],
					"speakerTitle": "Ilyas"
				},
				{
					"id": 130201224,
					"content": "Fakat ne olursa olsun yapmam gereken iki şey olduğunu belli belirsiz anımsıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201225
					],
					"speakerTitle": "Ilyas"
				},
				{
					"id": 130201225,
					"content": "Anlat bize.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201226
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130201226,
					"content": "İlki, maaşımı Akademiden alıp Gandharva'daki kız kardeşime vermem gerektiği.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201227
					],
					"speakerTitle": "Ilyas"
				},
				{
					"id": 130201227,
					"content": "Detaylardan emin değilim... Ama sanırım ailemin masraflarını karşılamak için her ay kız kardeşime para gönderiyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201228
					],
					"speakerTitle": "Ilyas"
				},
				{
					"id": 130201228,
					"content": "İkincisi peki? O neydi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130201229,
					"content": "... Hatırlamıyorum. Üzgünüm, anımsayamadığım o kadar çok şey var ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201230
					],
					"speakerTitle": "Ilyas"
				},
				{
					"id": 130201230,
					"content": "Beklendiği gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201231
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130201231,
					"content": "Yine de şu an, Siraj'ı gören ve mağarasının tam yerini bilen tek kişi sensin. Bu yüzden, hafızanı geri kazanman için elimizden geleni yapıp sana yardım edeceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201232
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 130201232,
					"content": "Hafızanı kaybetmek çok can sıkıcı olmalı ama merak etme! Onu tamamen geri kazanmana yardım edeceğiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130201233,
					"content": "Çok teşekkürler. Bu his... Can sıkıcı olmaktan fazlası. Nasıl ifade edeceğimi bilemiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201234
					],
					"speakerTitle": "Ilyas"
				},
				{
					"id": 130201234,
					"content": "O kadar az hatıram var ki kim olduğuma dair net bir fikrim bile yok... Ve kafamın içinde devamlı çınlama var, her an bayılacak gibiyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201235
					],
					"speakerTitle": "Ilyas"
				},
				{
					"id": 130201235,
					"content": "Ama tüm bunlar olurken... Bir yandan da kendimi bir şekilde özgür kalmış gibi hissediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201236
					],
					"speakerTitle": "Ilyas"
				},
				{
					"id": 130201236,
					"content": "Yine de, şu an az da olsa sahip olduğum zihin açıklığı için size teşekkür borçluyum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201237
					],
					"speakerTitle": "Ilyas"
				},
				{
					"id": 130201237,
					"content": "Akademide, Araştırma Hazırlık Merkezi diye bir yerde yarı zamanlı çalıştığımı hatırlıyorum. Maaşımı da her ay buradan alıyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201238
					],
					"speakerTitle": "Ilyas"
				},
				{
					"id": 130201238,
					"content": "Anlıyorum. Öyleyse gidip oradaki sorumlu kişiyi bulalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alhaitham"
				}
			]
		},
