				},
				{
					"id": 761480102,
					"content": "Paimon sürekli size seslenip durdu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761480103,
					"content": "Hımm? Paimon neden Düşüncesizlik Boşluğu'na sürüklenmedi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480104
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480104,
					"content": "Şey... Belki de yemek yemek ve uyumak dışında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480105
					]
				},
				{
					"id": 761480105,
					"content": "Pek fazla bir şey düşünmediğinden olabilir mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480106
					]
				},
				{
					"id": 761480106,
					"content": "Hımm. Mantıklı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480107
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480107,
					"content": "Görünüşe göre Melanta şimdi gerçekten çok öfkeli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480108
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480108,
					"content": "#{NICKNAME} ile bir an önce yüzleşmeleri elzem oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480109
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480109,
					"content": "Başka bir yerde konuşalım. Burası artık pek güvenli sayılmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480110
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480110,
					"content": "Şey, kimsenin sormadığını biliyorum ama... Herkese merhaba. Benim adım Alara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
