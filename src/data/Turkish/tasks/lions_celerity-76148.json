			"dialogs": [
				{
					"id": 761480701,
					"content": "Bir kez daha buraya geri dönüyoruz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480702
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480702,
					"content": "Buraya son gelişim insan ömrüyle ölçüldüğünde... Çok ama çok uzun bir nesil öncesine denk geliyor olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480703
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480703,
					"content": "Görünüşe göre hepimiz tekrar Düşüncesizlik Boşluğu'na atıldık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480704
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480704,
					"content": "Peki buradan nasıl çıkacağız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480705
					]
				},
				{
					"id": 761480705,
					"content": "Normal yolu meditasyon yapmaktır. Zihnine ve düşüncelerine hakim olmayı öğrenmek ve ardından her türlü arzuyu bir kenara bırakmak gerekir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480706
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480706,
					"content": "Kısacası mutlak bir boşluk halini korumalıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480707
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480707,
					"content": "Söylemesi kolay. Kişinin doğasına ve arzularının gücüne bağlı olarak, bu süreç birkaç yıldan birkaç yüzyıla kadar sürebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480708
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480708,
					"content": "Senin gibi dünyanın kaderini omuzlarında taşıyan biri için arzuların muhtemelen bir kenara atılamaz... Atılmamalıdır da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480709
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480709,
					"content": "Öyleyse ne yapacağız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480710
					]
				},
				{
					"id": 761480710,
					"content": "Önce Zeitlind'i bulalım. Gerisini ondan sonra çözeriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480711
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480711,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480712
					],
					"speakerTitle": "Dex"
				},
				{
					"id": 761480712,
					"content": "Ne aldın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761480713
					]
				},
				{
					"id": 761480713,
					"content": "Bir dakika, Dex de mi içeri çekildi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480714
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480714,
					"content": "O halde durumu tersine çevirmek için hâlâ bir şansımız olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480715
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480715,
					"content": "Dex de bir Gözcü olduğu için, bu parçalarda bulunan gücü kullanarak bir yol açabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480716
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480716,
					"content": "Bu parçalara bir isim vermemiz gerekecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480717
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480717,
					"content": "Bu şatafatlı tabutları daha önce duymuştum. Tapınak sahibesinin kız kardeşlerinden biri tarafından hazırlanmışlardı... Sanırım onlara Maranasati Tabutları deniyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480718
					],
					"speakerTitle": "Istoria"
				},
				{
					"id": 761480718,
					"content": "Öyleyse, bunlara Ölümperisi Parçası diyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Istoria"
				}
			]
		}
	]
