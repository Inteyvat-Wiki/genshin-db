			"dialogs": [
				{
					"id": 761480101,
					"content": "Off! Az önce nereye kayboldunuz? Paimon'un yüreğine iniyordu az kalsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761480102
