			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jack"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411250101,
					"content": "*iç çeker* Keşke kendim gidip bakabilseydim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250102
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250102,
					"content": "Ne oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250103
					]
				},
				{
					"id": 411250103,
					"content": "Ah, senmişsin. Özel bir şey olduğu yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250104
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250104,
					"content": "Hımm. Yok, aslında bu çok özel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250105,
						411250108
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250105,
					"content": "Gök taşlarından mı bahsediyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250106
					]
				},
				{
					"id": 411250106,
					"content": "Evet! Onları sen de gördün, değil mi? Bir süredir gökyüzünden düşüyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250107
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250107,
					"content": "Daha şehre düşen olmadı, buna ister Rüzgar Tanrısı'nın koruması de, ister kör talih de; ne dersen de.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250113
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250113,
					"content": "Ancak birkaçı şehrin dışına düştü. Söylenenlere göre gök taşlarına kim dokunursa dokunsun, hiçbir şekilde uyanamayacakları derin bir uykuya dalıyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250114
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250114,
					"content": "Cyrus, şimdiden birçok maceracıyı bir araya getirip onları farklı görevlere gönderdi. Bazıları, yabanda kalanlara şehre sığınmalarını haber vermeye gitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250115
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250115,
					"content": "Diğerleri ise Favonius Şövalyelerine gök taşlarının yerlerini saptamada yardım ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250116
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250116,
					"content": "Gök taşlarının etrafında arama kurtarma çalışmaları yürütüyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250117
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250117,
					"content": "Bana gelince... Cyrus, en iyisi benim şehirde kalıp derin uykuya dalmışlara bakmam gerektiğini söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250118
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250118,
					"content": "Belki de becerilerim henüz yeterli düzeyde değildir ama hep böyle küçük işler yaparsam, güçlenme fırsatım olmaz ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250119
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250119,
					"content": "*iç çeker* Her şeye rağmen bana verilen görevi en iyi şekilde yerine getirmeliyim. Yine de senden bir şey isteyebilir miyim Gezgin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250120
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250120,
					"content": "Gidip şu gök taşlarıyla alakalı bilgi toplamanı istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250121,
						411250126
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250121,
					"content": "Bu bilgiyle ne yapacaksın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250122
					]
				},
				{
					"id": 411250122,
					"content": "Cyrus, bir maceraya atılmadan önce tamamen hazır olmamız gerektiğini söyler her zaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250123
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250123,
					"content": "Durumu tümüyle kavradığımı kanıtlayabilirsem ve gerekli hazırlıkları yaparsam belki de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250124
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250124,
					"content": "Araştırma takımlarına katılmama izin verir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250125
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250125,
					"content": "Ama şu an buradaki insanlara yardım etmekle meşgulüm, gidip kendim bilgi toplayamam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250133
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250133,
					"content": "Lütfen Gezgin! Gidip durumu araştırmama yardım et. Çok uzağa gitmene gerek yok, Fısıltı Ormanı'na gitsen yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250134
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250134,
					"content": "Bir şey bulursan, gelip bana anlatırsın. Araştırmalara katılabilme şansım tamamen senin ellerinde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250126,
					"content": "Yani çaktırmadan kaçıp...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250127
					]
				},
				{
					"id": 411250127,
					"content": "Ne? Çaktırmadan kaçmak mı? Hayır! Hiç de bile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250128
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250128,
					"content": "Gidip araştırmalara katılmak istiyorum, evet. Ancak şehirde de yardıma ihtiyaç var, bu da çok önemli! Görevimi öylece terk edemem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250129
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250129,
					"content": "Ama şey, yani... Cyrus, bir maceraya atılmadan önce bütün hazırlıkların yapılması gerektiğini söyler hep.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250130
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250130,
					"content": "Durumu tümüyle kavradığımı kanıtlayabilirsem ve gerekli hazırlıkları yaparsam belki de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250131
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250131,
					"content": "Araştırma takımlarına katılmama izin verir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250132
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250132,
					"content": "Ama şu an buradaki insanlara yardım etmekle meşgulüm, gidip kendim bilgi toplayamam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250133
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250108,
					"content": "Avcının Yeri'ndeki yıl dönümüne özel yarı fiyat kampanyasını mı diyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250109
					]
				},
				{
					"id": 411250109,
					"content": "Ne! Avcının Yeri'nde bugün indirim mi var? Nasıl bunu daha önce duymam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250110
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250110,
					"content": "Bir dakika ya! Konuşmak istediğim bu değildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250111
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250111,
					"content": "Son zamanlarda gökyüzünden gök taşları düşüyor. Eminim sen de görmüşsündür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250112
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 411250112,
					"content": "Daha şehre düşen olmadı, buna ister Rüzgar Tanrısı'nın koruması de, ister kör talih de; ne dersen de.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250113
					],
					"speakerTitle": "Jack"
				}
			]
		},
