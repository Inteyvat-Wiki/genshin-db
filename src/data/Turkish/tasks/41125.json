				{
					"id": 411250202,
					"content": "Gök taşlarını araştırmaya mı geldin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250203
					]
				},
				{
					"id": 411250203,
					"content": "Aynen öyle. Loncadan görev aldım, gök taşı meselesiyle alakalı araştırma yapıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250204
					],
					"speakerTitle": "Pervasız Pallad"
				},
				{
					"id": 411250204,
					"content": "Ancak gök taşlarının düştüğü yerlerin yakınlarındaki canavarlar, bir anda sorun çıkarmaya başlamış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250205
					],
					"speakerTitle": "Pervasız Pallad"
				},
				{
					"id": 411250205,
					"content": "Güçleri, hareketleri ve yaptıkları hiçbir şey normal değil. Ayrıca normalden çok daha kalabalıklar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250206
					],
					"speakerTitle": "Pervasız Pallad"
				},
				{
					"id": 411250206,
					"content": "Beni bulduklarında o bölgede kalamadım, daha az kullanılan yollardan gelerek izimi kaybettirdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250207
					],
					"speakerTitle": "Pervasız Pallad"
				},
				{
					"id": 411250207,
					"content": "Bu anormallikleri olabildiğince hızlı bir şekilde Cyrus'a iletmeliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250208
					],
					"speakerTitle": "Pervasız Pallad"
				},
				{
					"id": 411250208,
					"content": "Dikkate değer başka bir şey var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250209
					]
				},
				{
					"id": 411250209,
					"content": "Başka bir şey mi? Alimlerin birkaçı şehre dönmemek konusunda ısrarcı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250210
					],
					"speakerTitle": "Pervasız Pallad"
				},
				{
					"id": 411250210,
					"content": "İkna etmek için ne kadar uğraşırsam uğraşayım, araştırmalarına devam etmekte ısrar ettiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250211
					],
					"speakerTitle": "Pervasız Pallad"
				},
				{
					"id": 411250211,
					"content": "Maceracıların şehir dışındaki sayıları da az, yani ikide bir onları uyarmaya gidemeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250212
					],
					"speakerTitle": "Pervasız Pallad"
				},
				{
					"id": 411250212,
					"content": "Çok sinir bozucu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250213
					],
					"speakerTitle": "Pervasız Pallad"
				},
				{
					"id": 411250213,
					"content": "Başka bir şey yoksa, senin de şehre dönüp korunacak bir yer bulman lazım Gezgin. Burada aylaklık yapacak vaktimiz yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pervasız Pallad"
				}
			]
		},
