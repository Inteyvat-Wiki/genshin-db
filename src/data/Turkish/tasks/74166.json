					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660602
					],
					"speakerTitle": "Tuhaf Kişi"
				},
				{
					"id": 741660602,
					"content": "Burası hakkında da garip söylentiler var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660603,
					"content": "Hayır, yok. Ben hiç hazzetmiyorum ama buradan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660604
					],
					"speakerTitle": "Tuhaf Kişi"
				},
				{
					"id": 741660604,
					"content": "Öyle mi? Neden ki?",
					"roleType": "TALK_ROLE_NPC",
