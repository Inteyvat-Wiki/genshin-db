			"dialogs": [
				{
					"id": 741660401,
					"content": "Burası Kupon Kantini. Burada herkes günde bir defa ücretsiz Yemek Yardımı alabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660402
					],
					"speakerTitle": "Tuhaf Kişi"
				},
				{
					"id": 741660402,
					"content": "Tek sıkıntı şu ki yemeğin ne çıkacağı tamamen şansa bağlı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660403
					],
					"speakerTitle": "Tuhaf Kişi"
				},
				{
					"id": 741660403,
					"content": "Bu kadar mı yani? Bunu herkes ilk günde öğreniyor zaten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660404,
					"content": "Sakin ol canım. Gizli bilgilerim de var tabii. Duyduğuma göre Yemek Yardımı alırken Bran'e söyleyebileceğiniz gizli bir kelime varmış ve bu kelimeyi söylediğinizde o efsanevi gizemli yemeği alabiliyormuşsunuz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660405
					],
					"speakerTitle": "Tuhaf Kişi"
				},
				{
					"id": 741660405,
					"content": "Öyle mi? Neymiş o gizli kelime?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660406,
					"content": "Maalesef ben de bilmiyorum. Gizli kelimeyi sizin keşfedeceğiniz günü dört gözle bekliyor olacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660407
					],
					"speakerTitle": "Tuhaf Kişi"
				},
				{
					"id": 741660407,
					"content": "Lafı Paimon'un ağzından aldın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660408,
					"content": "Böyle fuzuli detaylara yormayın kafanızı! Sıradaki durağımız Üçlü Kupon Kumpanyası!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tuhaf Kişi"
				}
			]
		},
