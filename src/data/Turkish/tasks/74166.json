			"dialogs": [
				{
					"id": 741660301,
					"content": "Ne diyorsunuz? Karar verdiniz mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660302
					],
					"speakerTitle": "Tuhaf Kişi"
				},
				{
					"id": 741660302,
					"content": "Her şey bedava olacak dedin bak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660303,
					"content": "Tabii, tabii. Hepsi \"bedava.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660304
					],
					"speakerTitle": "Tuhaf Kişi"
				},
				{
					"id": 741660304,
					"content": "Hadi gelin o halde dostlar, size Meropide Kalesi'ni göstereyim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tuhaf Kişi"
				}
			]
		},
