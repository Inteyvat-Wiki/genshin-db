					"content": "Çünkü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660607,
					"content": "Çünkü çalışmak istemiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660608
					],
					"speakerTitle": "Tuhaf Kişi"
				},
				{
					"id": 741660608,
					"content": "Çalışmak istemediğim için buradayım ya zaten. Açlıktan ekmek çaldım, o yüzden beni buraya gönderdiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660609
					],
					"speakerTitle": "Tuhaf Kişi"
				},
				{
					"id": 741660609,
					"content": "Ama Meropide Kalesi'nde bile çalışmak zorundayım, bıktım artık, usandım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660610
					],
					"speakerTitle": "Tuhaf Kişi"
				},
				{
					"id": 741660610,
					"content": "\"Ufacık bir iş bile fazladır bu bedene!\" benim hayat felsefem artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660611
					],
					"speakerTitle": "Tuhaf Kişi"
				},
				{
					"id": 741660611,
					"content": "Iyy! Buraya gelince bile tüylerim diken diken oldu. Hadi çıkalım ve tura devam edelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
