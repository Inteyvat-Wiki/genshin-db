			"dialogs": [
				{
					"id": 741660701,
					"content": "Sonunda en sevdiğim yere geldik arkadaşlar! Burası Pankrasyon Ringi! Cennetten bir köşe desem yeridir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660702
					],
					"speakerTitle": "Tuhaf Kişi"
				},
				{
					"id": 741660702,
					"content": "O kadar güzel mi gerçekten? Paimon burayla ilgili farklı şeyler duymuştu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660703,
					"content": "Tabii ki güzel, dışarıdaki insanların laflarına kulak asma sen. Diğerlerini kandırmak için öyle bir imaj çizdiler, o kadar. Gelin hadi. Burada bir rıza formu var, imzalarsanız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660704
					],
					"speakerTitle": "Tuhaf Kişi"
				},
				{
					"id": 741660704,
					"content": "Hey! Yine mi sen? İnsanları rıza formuyla kandırarak yarışmaya yazdırıyor bak yine! Sonunda geçtin elime, kaç kaçabilirsen bakalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660705
					],
					"speakerTitle": "Muhafız"
				},
				{
					"id": 741660705,
					"content": "Neyse ki ikiniz o formları imzalamadan fark ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660706
					],
					"speakerTitle": "Muhafız"
				},
				{
					"id": 741660706,
					"content": "Siz aldırış etmeyin bu düzenbaza. O ve üyesi olduğu organizasyon, olanlardan bihaber insanları tehlikeli yarışmalara sokup üzerinden kazanç sağlıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660707
					],
					"speakerTitle": "Muhafız"
				},
				{
					"id": 741660707,
					"content": "Yok artık, çamur at izi kalsın! Kimseyi kandırdığım falan yok benim! Onlar benim arkadaşım ve hepsi de benim tavsiyem üzerine bilerek ve isteyerek yarışmaya giriyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660708
					],
					"speakerTitle": "Tuhaf Kişi"
				},
				{
					"id": 741660708,
					"content": "Tabii canım, öyledir kesin. Bu saçmalıklarını gittiğin yerde anlatırsın. Düş bakalım önüme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660709
					],
					"speakerTitle": "Muhafız"
				},
				{
					"id": 741660709,
					"content": "Muhafızlar o garip adamı götürür...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741660710
					]
				},
				{
					"id": 741660710,
					"content": "Of... Bedava yemek diye bir şey yokmuş gerçekten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
