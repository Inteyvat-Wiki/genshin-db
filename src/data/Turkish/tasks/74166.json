			"dialogs": [
				{
					"id": 741660501,
					"content": "Burası Üçlü Kupon Kumpanyasının bulunduğu yer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660502
					],
					"speakerTitle": "Tuhaf Kişi"
				},
				{
					"id": 741660502,
					"content": "Ee? Tüm tanıtımın bu kadar mı yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660503,
					"content": "Ben leb demeden leblebiyi anlamanız lazım sizin! Nerede kumpanya, orada dram! Nerede dram, orada romantizm! Nerede romantizm, orada aşk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660504
					],
					"speakerTitle": "Tuhaf Kişi"
				},
				{
					"id": 741660504,
					"content": "Söylentilere göre, her gün buraya gelip gösterilerini izleyenler gerçek aşkı bulabilirmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660505
					],
					"speakerTitle": "Tuhaf Kişi"
				},
				{
					"id": 741660505,
					"content": "Böyle bir söylenti mi var gerçekten? O zaman burası her gün çok kalabalık olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660506,
					"content": "Orası öyle ama bunun gerçekleşmesi için Meropide Kalesi'nde esir veya muhafız olmaman gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660507
					],
					"speakerTitle": "Tuhaf Kişi"
				},
				{
					"id": 741660507,
					"content": "E kim bulacak o zaman gerçek aşkı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660508,
					"content": "Sorun da o ya işte. Neyse, biz turumuza devam edelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tuhaf Kişi"
				}
			]
		},
