			"dialogs": [
				{
					"id": 741660201,
					"content": "#Pardon küçük {M#bey}{F#hanım}! Evet evet, sen! Oradaki! Buraya gelsene hemen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660202
					],
					"speakerTitle": "Tuhaf Kişi"
				},
				{
					"id": 741660202,
					"content": "Ne? Bize mi dedin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660203,
					"content": "Sizi gördüğüm gibi buranın yabancısı olduğunuzu anladım. Meropide Kalesi'ni pek bilmiyorsunuz galiba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660204
					],
					"speakerTitle": "Tuhaf Kişi"
				},
				{
					"id": 741660204,
					"content": "O halde benim gibi birine denk geldiğiniz için sizi kutlarım! Bu koca Kalede yaşayan tek iyi kalpli kişi benim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660205
					],
					"speakerTitle": "Tuhaf Kişi"
				},
				{
					"id": 741660205,
					"content": "Gelin de size Kaleyi tanıtayım. Para falan da istemem tabii, tabiri caizse hepsi \"bedava\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660206
					],
					"speakerTitle": "Tuhaf Kişi"
				},
				{
					"id": 741660206,
					"content": "Ben burayı yeterince biliyorum zaten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741660207
					]
				},
				{
					"id": 741660207,
					"content": "Öyle deme işte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660208
					],
					"speakerTitle": "Tuhaf Kişi"
				},
				{
					"id": 741660208,
					"content": "Belki kaybolmayacak kadar biliyorsundur ama benim rehberliğim bir başkadır. Sana öyle şeyler göstereceğim ki bunu daha önce nasıl fark etmemişim diyeceksin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660209
					],
					"speakerTitle": "Tuhaf Kişi"
				},
				{
					"id": 741660209,
					"content": "Bedava yemek gibi bir şey de var mı peki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741660210
					]
				},
				{
					"id": 741660210,
					"content": "Olmaz mı hiç? Diyorum ya, ben bu Kalenin en iyi kalpli sakiniyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660211
					],
					"speakerTitle": "Tuhaf Kişi"
				},
				{
					"id": 741660211,
					"content": "Ne garip bir adam. Daha yeni tanıştık ama hemen sıkı fıkı bir dost gibi davranmaya başladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741660212,
					"content": "Haha, altında bir şey arama sevgili dostum! Siz ikiniz aranızda konuşun. Ben burada kararınızı beklerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741660213
					],
					"speakerTitle": "Tuhaf Kişi"
				},
				{
					"id": 741660213,
					"content": "Kararınızı verince gelip beni bulursunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tuhaf Kişi"
				}
			]
		},
