			"dialogs": [
				{
					"id": 710580601,
					"content": "Şimdi biraz dinlenmem lazım. Eski yaralarım hâlâ acıyor. Özür dilerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580602
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710580602,
					"content": "Başka soruların olursa, lütfen daha sonra gel. Ayrıca bir isteğim olacaktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katarina"
				}
			]
		},
		{
			"id": 7105901,
			"completionStepIds": [
				7105901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105901",
							"2"
						],
						"stepId": 7105901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Katarina",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710590101,
					"content": "Ah, siz mi geldiniz? Oturun ve rahatınıza bakın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590102
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590102,
					"content": "Geçen sefer sizi aceleyle gönderdiğim için özür dilerim. Hangi konuda yardım istediğimi bile söyleyememiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590103,
						710590104
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590103,
					"content": "Önemli değil. Şimdi söyleyebilirsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590107
					]
				},
				{
					"id": 710590107,
					"content": "Hemen kaygılanmayın, kötü bir şey yapmanızı istemeyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590108,
						710590109
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590108,
					"content": "Pekala, söyle bakalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590113
					]
				},
				{
					"id": 710590113,
					"content": "Neyse, takımımın bir üyesi olan Kolya'dan yani Nikolay'dan ayrı kaldım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590114
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590114,
					"content": "Onu bulmama yardım eder misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590115
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590115,
					"content": "Hâlâ hayattaysa onu bana getirin. Yok ama eğer ölmüşse, lütfen bana haber verin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590116
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590116,
					"content": "Böyle bir işi sizin başınıza verdiğim için üzgünüm ama lütfen bunu bir düşünün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590117
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590117,
					"content": "Yani bizden istediğin bu mu? Paimon, bizden Taşordu'nun çalışmalarını sabote etmek gibi kötü bir şey yapmamızı isteyeceğini sanmıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710590118,
					"content": "Taşordu mu? Neden böyle bir şey isteyeyim ki? Onlarla düşman olmak bize hiçbir hayır getirmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590119
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590119,
					"content": "Nasıl yani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590120
					]
				},
				{
					"id": 710590120,
					"content": "Tam ben soracaktım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590121
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590121,
					"content": "Bekle, anladım. Yüzeydeki arkadaşlarımız Liyue halkıyla çatışmaya mı girdi? Eğer öyleyse, bu tam da tedarik hatlarının neden kesildiğini açıklar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590122
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590122,
					"content": "Kahretsin! Orada tam olarak ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590123,
						710590124
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590123,
					"content": "Uzun hikaye...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590125
					]
				},
				{
					"id": 710590125,
					"content": "Hıh... Bu konuyu başka bir güne bırakalım. Savaş, savaştır. Daimi düşman ya da ebedi müttefik yoktur. Fatui daima bu gerçekle yaşar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590126
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590126,
					"content": "En azından şimdilik Kolya dışında hiçbir şey umurumda değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590127
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590127,
					"content": "Biz geri çekildiğimizde, Kolya mangadan ayrı kaldı. Ben daha sonra onun için döndüğümde ise ben de kayboldum. *iç çeker* Çok yazık oldu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590128
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590128,
					"content": "Onun kaybolmadan önce nerede olduğunu, sana haritada gösterebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590129
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590129,
					"content": "O sırada bizi kovalayan düşmanları takımın geri kalanından uzaklaştırmaya çalışıyordu. Kolya mükemmel bir asker, onun orada ölmediğinden eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590130
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590130,
					"content": "Onun bize bir ipucu bıraktığını umuyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590124,
					"content": "Fatui başlattı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590125
					]
				},
				{
					"id": 710590109,
					"content": "Fatui'nin planlarına müdahale etmemize izin vermeyeceğin kesin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590110
					]
				},
				{
					"id": 710590110,
					"content": "Tabii ya! Eğer yapacağımız herhangi bir iyilik sizin kötü planınızı altüst ederse, bizi sakın durdurmaya çalışmayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710590111,
					"content": "Neden \"iyi\" veya \"kötü\" deyip duruyorsunuz? Ayrıca sizi neden durdurayım ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590112
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590112,
					"content": "*iç çeker* Sinirlerime dokunmaya başlıyorsunuz. Bitirmeme izin verecek misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590113
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590104,
					"content": "Merak etmeyin. Zaten henüz ortada bir şey yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590105
					]
				},
				{
					"id": 710590105,
					"content": "Evet, siz bir Fatui Üyesisiniz. Aklınızdan kötü bir şey geçiyorsa, size yardım etmek için kılımızı dahi kıpırdatmayız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710590106,
					"content": "Ah, bunda haklısın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590107
					],
					"speakerTitle": "Katarina"
				}
			]
		},
		{
