			},
			"dialogs": [
				{
					"id": 710590301,
					"content": "Demek döndünüz. Sizin için bir miktar Ateş Suyum var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590302
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590302,
					"content": "Haha, sizi içmeye davet etmiyorum. Yaralandığınızda, yaralarınızı temizlemek için de kullanabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590303
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590303,
					"content": "Nasıl geçti? Bir şey buldunuz mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590304
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590304,
					"content": "Bunu bulduk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
