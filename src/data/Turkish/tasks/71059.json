					"content": "Demek döndün. Bir şey bulabildin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590402
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590402,
					"content": "Hiçbir şey bulmadıysan sorun değil. Gidip biraz dinlen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590403
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590403,
					"content": "Beni merak etme, bir sıkıntım yok. Emekliliğimde burada kalmak istiyorum. Belki senden emeklilik başvurumla ilgilenmeni isteyebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590404
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710590404,
					"content": "Vay! Gerçekten de iyi dinleniyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710590405,
					"content": "Hıh, elinizde hiçbir şey olmadan böyle gelmeye devam ederseniz, belki de beni burada sonsuza dek dinlenirken bulursunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katarina"
				}
			]
		},
		{
			"id": 7105906,
			"completionStepIds": [
				7105907
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105907",
							"2"
						],
						"stepId": 7105907,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710590603,
					"content": "Acaba bu, o Fatui'nin bıraktığı bir nişan mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590601
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710590601,
					"content": "Burada kimseye dair bir iz yok. Katya'ya ne diyeceğiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710590602,
					"content": "Paimon, yapabileceğimiz pek bir şey olmadığını düşünüyor. Hadi dönelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7105913,
			"completionStepIds": [
				7105909
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105909",
							"2"
						],
						"stepId": 7105909,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katarina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710591305,
					"content": "Nişanlar, eylem günlükleri ve... Bir not mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591306
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591306,
					"content": "Lütfen bana Kolya'nın nerede olduğunu söyleyin. Hâlâ hayatta mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591307,
						710591308
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591307,
					"content": "Onu henüz bulamadık ama muhtemelen hâlâ hayatta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591309
					]
				},
				{
					"id": 710591309,
					"content": "Kolya asla kaçıp beni terk etmez. Bundan eminim. Bunu biliyorum. Mücadele karşısında asla kaçmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591310
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591310,
					"content": "Bunları nereden buldun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591311
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591311,
					"content": "Güneydoğu yönündeki bir mağarada. Senin için işaretleyeyim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591312
					]
				},
				{
					"id": 710591312,
					"content": "İçinde birçok canavarın olduğu tüyler ürpertici bir yer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710591313,
					"content": "T-Teşekkürler... Üzgünüm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591314
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591314,
					"content": "Umarım Kolya tüm varlığıyla mücadelesini ortaya koymuştur. Böyle olmasını tercih ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591315
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591315,
					"content": "Kolya, lütfen Çariçe'yi rezil etme. Beni de utandırma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591316
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591316,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591317
					]
				},
				{
					"id": 710591317,
					"content": "Öhöm, b-ben iyiyim. Biraz duygulandım sadece, o kadar. Size de doğru dürüst teşekkür edemedim, kusura bakmayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591318
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591318,
					"content": "Bu arada, biraz Ateş Suyu al. *iç çeker* Ama sen içmiyordun, öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591319
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591319,
					"content": "Biraz Moram var... Başka malzemeler de topladım. Benim pek işime yaramıyorlar, lütfen bunları kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591320,
						710591321
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591320,
					"content": "Sonraki planın nedir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591322
					]
				},
				{
					"id": 710591322,
					"content": "Sonraki planım mı? Sorduğun için teşekkürler ancak artık \"kötülük\" planlarımda bana yardım etmene gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591323
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591323,
					"content": "Belki Kolya'yı aramaya çıkarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591324
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591324,
					"content": "Görev yerim değişmeden önce bana bir mektup yazmıştı, onu yanımda taşıyorum. Bu mektup, benim için onun varlığını kanıtlayan tek delil ve bunu sonsuza dek yanımda taşıyacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591325
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591325,
					"content": "Eğer o hâlâ hayattaysa... Çariçe'ye sadık olan bir Fatui olarak, nereye gidip saklanmış olursa olsun, o hainin izini bulacağım ve onu öldüreceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591326
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591326,
					"content": "Eğer artık bu hayatta değilse de... Ablası olarak her Fatui'nin başına gelecek bu kaçınılmaz kaderi kabul edeceğim ve onunla gurur duyacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591327
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591327,
					"content": "\"Bunu ben de başaramazsam, başka kim başarabilir ki?\" derken bundan bahsediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591328,
						710591330
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591328,
					"content": "Ya kötü bir şey yapmaya çalışıyorsan ve seni durdurmam gerekirse ne olacak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591329
					]
				},
				{
					"id": 710591329,
					"content": "Hiçbir seçeneğimizin kalmadığı anlar elbet oluyor. Hepimizin yapmak zorunda olduğu şeyler var, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591333
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591333,
					"content": "Bunu çok ciddiye alıyorsun. Tabii ki seni anlıyorum. Reşit olmamış çocuklar, tuhaf endişelerin içinde boğulup dururlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591334
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591334,
					"content": "O zaman geldiğinde bakarız. Nihai ve kaçınılmaz seçimle karşı karşıya kaldığımda bakalım ne yapacağım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591335
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591335,
					"content": "Şimdilik biraz kestirmeye ihtiyacım var. Siz de biraz dinlenmek ister misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591336
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591336,
					"content": "Burada yalnızca bir hasır var. Pek rahat bir yatak olduğu söylenemez. Bizi başından savmaya çalışıyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591337
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710591337,
					"content": "Haha, ah canım benim. O da sizin sorununuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591338
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591338,
					"content": "Yine de yardımlarınız için teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591330,
					"content": "Hep Fatui'nin yolundan gitmek zorunda mısın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591331
					]
				},
				{
					"id": 710591331,
					"content": "Evet. Bu tuhaf bir şey mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591332
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591332,
					"content": "Neyse... Fikirler, bakış açıları... Bunlar çok sıkıcı düşünceler! Hıh... Maskemin arkasında yalnızca fikirler olduğunu düşünme. Kurşun geçirmez değilim neticede.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591333
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591321,
					"content": "Yardımıma ihtiyacın var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591322
					]
				},
				{
					"id": 710591308,
					"content": "Gizli bir tünelden kaçmış olabilir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591309
					]
				}
			]
		},
		{
			"id": 7105914,
			"completionStepIds": [
				7105908
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710591401,
					"content": "\"... Gizli odaya ulaştım. Mekanik canavar, yırtıcı bir hayvan gibi pusuya yatmış ve benim dışarı çıkmamı bekliyor...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591402
					],
					"speakerTitle": "Kapral Nikolay'ın Günlüğü"
				},
				{
					"id": 710591402,
					"content": "\"... Sol bacağım çok fena incindi ve acayip acıyor. Gelişigüzel bir şekilde bandajladım ama şişmeye başladı. Enfeksiyon belirtisi olabilir...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591403
					],
					"speakerTitle": "Kapral Nikolay'ın Günlüğü"
				},
				{
					"id": 710591403,
					"content": "\"Mağarada başka bir çıkış yolu var ama nereye açıldığını bilmiyorum. Çıkış yolunun temeli sağlam durmuyor. Eğer destekleyici bir şey olmadan fazla kuvvet uygulanırsa çökebilir...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591404
					],
					"speakerTitle": "Kapral Nikolay'ın Günlüğü"
				},
				{
					"id": 710591404,
					"content": "\"... Beni buldular. Biri geliyor. Siyah giyinmiş... bir kılıç ustası mı o?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591405
					],
					"speakerTitle": "Kapral Nikolay'ın Günlüğü"
				},
				{
					"id": 710591405,
					"content": "\"İnsan mı canavar mı bilemedim... Metal çitler bile onu durduramıyor. Ona baktığımda anladım ki...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591406
					],
					"speakerTitle": "Kapral Nikolay'ın Günlüğü"
				},
				{
					"id": 710591406,
					"content": "\"... Üzgünüm Katya.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kapral Nikolay'ın Günlüğü"
				}
			]
		}
	]
}