			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710590201,
					"content": "\"... Olamaz! Katya'nın balalaykası kırılmış. Herhalde arbede sırasında hasar verdim. Katya beni fırçalamadan önce, hemen onu tamir etmeliyim.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590202
					],
					"speakerTitle": "Kapral Nikolay'ın Günlüğünün Bir Parçası"
				},
				{
					"id": 710590202,
					"content": "\"... Atalarımız da beş yüzyıl önce böyle bir felaketle savaşmış mıdır? Kapitan-Poruçik, bir keresinde atalarımızın verdiği zorlu mücadelelerin yüzde birini bile bilmediğimizi söylemişti.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590203
					],
					"speakerTitle": "Kapral Nikolay'ın Günlüğünün Bir Parçası"
				},
				{
					"id": 710590203,
					"content": "(Ortadaki sayfaların çoğu kara bir maddeyle lekelenmiş. Onları temizlediğinde, mürekkeple yazılan kısım da tümüyle okunmaz hale geldi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590204
					],
					"speakerTitle": "Kapral Nikolay'ın Günlüğünün Bir Parçası"
				},
				{
					"id": 710590204,
					"content": "\"... Burada daha fazla kalamam. Beni siyah çamurdan kolayca takip edebilirler.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590205
					],
					"speakerTitle": "Kapral Nikolay'ın Günlüğünün Bir Parçası"
				},
				{
					"id": 710590205,
					"content": "\"... Sonra da aksi yöne gidip onları manganın geri kalanından uzaklaştıracağım.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590206
					],
					"speakerTitle": "Kapral Nikolay'ın Günlüğünün Bir Parçası"
				},
				{
					"id": 710590206,
					"content": "\"... Güneydoğu yönündeki harabe kalenin yakınında bir çukur var. Belki o tarafa doğru gidebilirim...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590207
					],
					"speakerTitle": "Kapral Nikolay'ın Günlüğünün Bir Parçası"
				},
				{
					"id": 710590207,
					"content": "\"... Bana şans dile. Bunu ben de başaramazsam, başka kim başarabilir ki?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kapral Nikolay'ın Günlüğünün Bir Parçası"
				}
			]
		},
