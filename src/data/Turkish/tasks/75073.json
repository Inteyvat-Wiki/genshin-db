			},
			"dialogs": [
				{
					"id": 750730101,
					"content": "İşte benim kurtarıcım! Bu Dağ Yabanilerini yenerek... Bana yardım ettiğin için teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730102
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730102,
					"content": "Tam uçurumun kenarında durmuş manzarayı seyrediyordum ki bir Dağ Yabanisi gelip beni bayılttı. Uyandığımda burada esir buldum kendimi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730103
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730103,
					"content": "Kilitli. Anahtar... Tabii ya, anahtar şuradaki sandığın içinde. Bana çok küçük bir iyilik yapabilir misin acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730104
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730104,
					"content": "Bunu yaparsan sana sonsuz minnet duyarım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Conulaf"
				}
			]
		},
