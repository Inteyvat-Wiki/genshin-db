			"dialogs": [
				{
					"id": 750730301,
					"content": "*ağlar* Kurtuldum! Sonunda bu hapisten kurtuldum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730302
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730302,
					"content": "Bu sıcak hava balonu sürekli bir o yana bir bu yana sallanıyor. Kim bilir, belki bir rüzgar eser de tüm kafesi yerle bir eder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730303
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730303,
					"content": "Öyle bir durumda bizi Itztli Nine bile kurtaramaz muhtemelen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730304
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730304,
					"content": "Sen de kimsin ve burada ne işin var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750730305
					]
				},
				{
					"id": 750730305,
					"content": "Ha, evet, kendimi tanıtmadım henüz. Adım Conulaf, Gece Rüzgarının Ustalarında bir rahibe adayıyım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730306
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730306,
					"content": "Unvanımdan anlayacağın üzere şu anda rahibelik eğitimi alıyorum. Hayatım boyunca kabilemizden dışarı çıkmamıştım, bu yüzden büyüklerim bana \"Neden gidip dünyayı görmüyorsun?\" dediler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730307
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730307,
					"content": "Ve beni eğitim bahanesiyle kabileden kovdular.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730308
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730308,
					"content": "Ancak Dağ Yabanileri tarafından kıstırılmak \"dünyayı görmenin\" iyi yanlarından biri olmasa gerek, sence de öyle değil mi kurtarıcım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730309,
						750730311
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730309,
					"content": "Tek başına maceraya çıkmak tehlikelidir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750730310
					]
				},
				{
					"id": 750730310,
					"content": "Kesinlikle öyle! Sen olmasaydın burada kim bilir daha ne kadar mahsur kalırdım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730313
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730313,
					"content": "Sonuç olarak, beni kurtardığın için teşekkürler sevgili kurtarıcım... O kadar fazla rüzgar aldım ki gidip eğitimim üzerine biraz daha düşünsem iyi olacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730314
					],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730314,
					"content": "Üzerimde pek bir şey yok ama biz iyiliğin karşılığını iyilikle öderiz, ailemden böyle öğrendim. Bu yüzden bunları kabul et!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Conulaf"
				},
				{
					"id": 750730311,
					"content": "Yeterince güçlü olduğun sürece...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750730312
					]
				},
				{
					"id": 750730312,
					"content": "Heh... Beni kandıramazsın. Bu dünyada senin kadar güçlü çok maceracı yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730313
					],
					"speakerTitle": "Conulaf"
				}
			]
		},
