			"dialogs": [
				{
					"id": 751080101,
					"content": "Yemek pişireceğiz dedik ama tam olarak ne pişireceğiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080102,
					"content": "Hımm... Eskiden Tombalak Pufuduk'u balıkla beslerdik, değil mi? O halde balık yemeği yapabiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080103,
					"content": "#Tombalak ve {REALNAME[ID(2)|SHOWHOST(true)]} iyi beslensinler istiyorsak... Natlan'ın özel Nane Soslu Izgara Balığı çok iyi bir tercih olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080104,
						751080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080104,
					"content": "Bu yemek benim spesiyallerimden biridir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080106
					]
				},
				{
					"id": 751080106,
					"content": "Pekala, başlayalım o halde. Sen yemeği yaparken Paimon da sana bazı ipuçları verecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080107,
						751080109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080107,
					"content": "Daha derinden kes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080108
					]
				},
				{
					"id": 751080108,
					"content": "Doğru! Ne kadar derinden kesersen lezzet o kadar içine işler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080111,
						751080113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080111,
					"content": "Ne kadar tuz o kadar mutluluk!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080112
					]
				},
				{
					"id": 751080112,
					"content": "#Mmm, tam bir lezzet bombardımanı. {REALNAME[ID(2)|SHOWHOST(true)]} ve Tombalak buna bayılacaklar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080115,
						751080117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080115,
					"content": "Nane sosunu ne kadar çok koyarsak o kadar iyi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080116
					]
				},
				{
					"id": 751080116,
					"content": "Hehe, bu ferahlatıcı lezzet harika olacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080119,
						751080121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080119,
					"content": "Acı biber olmazsa olmaz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080120
					]
				},
				{
					"id": 751080120,
					"content": "Doğru miktarda acı koymak iştahı açar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080123,
						751080125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080123,
					"content": "Kavurucu ateşte pişirildi. Dışı çıtır, içi yumuşak!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080124
					]
				},
				{
					"id": 751080124,
					"content": "Hehe, kulağa çok lezzetli geliyor, Paimon'un ağzının suyu aktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080127,
					"content": "#Müthiş bir aşçılık sürecinin ardından, {REALNAME[ID(2)|SHOWHOST(true)]} ve Tombalak için pişirdiğin özel ızgara balık hazır...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 751080125,
					"content": "Izgarada ağır ağır pişirildi. Yumuşak ve içi sulu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080126
					]
				},
				{
					"id": 751080126,
					"content": "#Vay canına, harika! {NICKNAME} şefin gizli ızgara balık tarifi... Belki bir gün bunu spesiyallerine ekler ve diğer arkadaşlarımız için de pişirirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080121,
					"content": "Fontaine hayvanlarının acı yiyeceklere karşı alerjileri olabilir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080122
					]
				},
				{
					"id": 751080122,
					"content": "Fakat hiç biber olmazsa bir şeyler eksikmiş gibi hissettirebilir. Çok az eklesek olmaz mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080123,
						751080125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080117,
					"content": "Tombalak gibi bir su hayvanı naneden korkar mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080118
					]
				},
				{
					"id": 751080118,
					"content": "Bu öyle bir şey değil. Karaya çıkmak Tombalağa kuru ve sıcak gelecek, bu yüzden biraz nane sosu katmak ferahlamasına yardımcı olacaktır, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080119,
						751080121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080113,
					"content": "Bu haliyle gayet iyi. Tuza gerek yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080114
					]
				},
				{
					"id": 751080114,
					"content": "Evet. Başka baharatlarımız da var, fazla tuza boğmayalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080115,
						751080117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080109,
					"content": "Daha yüzeyden kes.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080110
					]
				},
				{
					"id": 751080110,
					"content": "İyi fikir. Böylece balık hem kendi lezzetini korumuş hem de hafif bir lezzete sahip olmuş olur. Tombalak buna bayılacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080111,
						751080113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751080105,
					"content": "Mükemmel yaptığımı iddia etmiyorum ama sorun olmaz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080106
					]
				}
			]
		},
