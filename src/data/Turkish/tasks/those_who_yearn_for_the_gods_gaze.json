			},
			"dialogs": [
				{
					"id": 20140801,
					"content": "Teppei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140802,
					"content": "Ah... *öksürür* Selam, millet. Burada ne işiniz var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140803
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140803,
					"content": "Bir dakika, ayağa kalkayım... Ah, çok tuhaf, tüm gücüm nereye gitmiş benim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140804,
						20140805
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140804,
					"content": "Teppei, bana açıkça anlatmalısın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140806
					]
				},
				{
					"id": 20140806,
					"content": "Hım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140807
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140807,
					"content": "Ah, doğru. Evet, size her şeyi anlatma fırsatım olmadı. Son zamanlarda savaşa büyük katkılarım oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140808
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140808,
					"content": "Denizde Şogun'un Ordusuyla savaşmak, Şogunluk Samurayıyla kendi başıma savaşmak, yoldaşlarımı bir pusudan kurtarmak... Önceden rüyamda bile göremeyeceğim şeylerdi bunlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140809
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140809,
					"content": "*öksürür* Keşke hâlâ güçlü olsaydım. Ne kadar güçlü olursam, direniş için o kadar çok şey yapabilirim... Dur bir saniye, gizli silahım nereye gitti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140810,
						20140811
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140810,
					"content": "Bana şu silahtan bahset.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140812
					]
				},
				{
					"id": 20140812,
					"content": "*öksürür* Senin, Kılıç Balığı II'nin yüzbaşısı olmandan kısa süre sonraydı. Gizemli insanlarla tanıştım, destekçimiz olduklarını söylediler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140813
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140813,
					"content": "Silahı bana verdiler ve daha güçlü olmak istediğim sürece, bu gizemli silahın bana yardım edeceğini söylediler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140814
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140814,
					"content": "Haha... *öksürür* Tıpkı bir Önsezi gibi, değil mi? Gerçi ben hiç Önsezi kullanmadığım için farkını bilemiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140815
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140815,
					"content": "Bu... Bir Sanrı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140816
					]
				},
				{
					"id": 20140816,
					"content": "Sanrı mı? *öksürür* Tanrım, bu kulağa hiç de iyi gelmiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140817
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140817,
					"content": "Peki... Sanrı ve Önsezi arasındaki fark ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140818
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140818,
					"content": "Sanrı, onu kullananın yaşam enerjisini sömürür.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140819
					]
				},
				{
					"id": 20140819,
					"content": "*öksürür*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140820
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140820,
					"content": "Aman tanrım... Yani, nereden geldiği bilinmeyen gizemli bir silahın riskli olması çok da şaşırtıcı değildir sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140821
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140821,
					"content": "Son birkaç gündür gittikçe daha da yorgun hissediyorum ve tuhaf bir... Korku duyuyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140822
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140822,
					"content": "İlk başlarda, bir savaştan sonra normaldekinden daha yorgun olduğumu fark ettim. Aklıma bir şey gelmedi. Ama bugün geri döndüğümde birden gördüklerim bulanıklaşmaya başladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140823
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140823,
					"content": "Gerçekten utanç verici... Ben de sana yetiştiğimi sanıyordum, haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140824
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140824,
					"content": "Sanırım tanrıların lütfunu almamışım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140825
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140825,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140826
					]
				},
				{
					"id": 20140826,
					"content": "#Hey {NICKNAME}, benim için bir şey yapar mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140827
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140827,
					"content": "Üniformalarımız hazır olunca benimkini al... Buraya getir ve birlikte üzerimizi değişelim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140828
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140828,
					"content": "Neden öyle bakıyorsun? Merak etme ortak. Dinlenir dinlenmez turp gibi sağlam olacağım. Turp gibi sağlam diyorum bak... Dinlenir... Dinlenmez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140829
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140829,
					"content": "Teppei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140830
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140830,
					"content": "Fatui...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140831
					]
				},
				{
					"id": 20140831,
					"content": "#Hey {NICKNAME}, nereye gidiyorsun? Heyyyy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140811,
					"content": "Onu kullanmaya ne zaman başladın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140812
					]
				},
				{
