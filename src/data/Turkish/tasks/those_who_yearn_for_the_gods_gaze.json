			},
			"dialogs": [
				{
					"id": 20140201,
					"content": "Burası olmalı. Ama Sangonomiya haklıymış, şüpheli bir durum yok gibi görünüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140202,
					"content": "#Saklanıyor olabilirler mi? {NICKNAME}, bakalım neler bulabileceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140203,
					"content": "Bu <color=#00E1FFFF>Elektrik Abideleri</color> biraz şüpheli görünüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 201405,
			"completionStepIds": [
				201405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201405",
							"2"
						],
						"stepId": 201405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Teppei",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20140501,
					"content": "Oh be... İyi ki bitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140502,
					"content": "Bir canavara göre epey güçlüydü. Ama bu kadar büyük bir Yıldırım Başlı Dağ Reisinin burada ne işi var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140503,
					"content": "Hiç mantıklı değil... Ayrıca buradaki atmosfer Paimon'un tüylerini ürpertiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140504,
					"content": "Her neyse, en azından bitti. Gitsek iyi olur... Hey, Teppei? Sen burada ne arıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140505,
					"content": "*öksürür* Vay canına, çok şaşırdım. Burayı araştıranların siz olduğunuzu bilmiyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140506
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140506,
					"content": "Ön cepheye malzeme teslim ettim ve yeni döndüm. Dönüş yolunda da buraya uğrayıp bölgeyi kolaçan ederim diye düşündüm. *öksürür*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140507
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140507,
					"content": "İyi misin dostum? Biraz bitkin gibi görünüyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140508,
					"content": "İyiyim ben, bir şeyim yok. Birkaç gün önce denizdeyken soğuk almış olmalıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140509
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140509,
					"content": "Yolda geçerken, birilerinin soruşturma yapmak için adaya yeni geldiğini duydum. Ben de gelip bir bakayım diye düşündüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140510
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140510,
					"content": "Gerçek bir tehlike olsaydı, kahraman olma fırsatına erişebilirdim. Heh, ne yazık ki sadece sizmişsiniz. Sanırım boşuna geldim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140511
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140511,
					"content": "Teppei, sence de burası biraz tuhaf değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140512,
					"content": "Hım... Sen söyleyince sanki bir tuhaflık varmış gibi geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140513
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140513,
					"content": "Sanırım Tatarigami burada daha belirgin hissediliyor olabilir. Orobashi'nin kalıntılarından çok uzak değiliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140514
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140514,
					"content": "Orobashi mi? O da kim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140515,
					"content": "Bir tanrı. Bakın, şurada cesedi var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140516
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140516,
					"content": "Aah! Devasa bir yılan iskeleti. Çok korkunç görünüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140517,
					"content": "Atalarımızı Enkanomiya'dan çıkarıp yeryüzüne getiren, Orobashi'ydi. Bugün Watatsumi Adası olarak bildiğiniz yerin kökeni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140518
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140518,
					"content": "Atalarımız onu koruyucu bir tanrı olarak gördüler ama Orobashi, Hükümdarlar Savaşı sırasında Yashiori Adası'nı işgal etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140519
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140519,
					"content": "Şogun Raiden bizzat geldi ve Orobashi'yi Musou no Hitotachi ile öldürdü. Bu darbe, aynı zamanda daha sonra Musoujin Geçidi olarak bilinen bir yeri oluşturdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140520
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140520,
					"content": "Şogun Raiden bir darbede Musoujin Geçidi'ni mi oluşturdu? Vay be, bu inanılmaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140521,
					"content": "Evet. Ama Hükümdarlar Savaşı acımasızdı... *öksürür* ve Yashiori Adası, savaşta tamamen yok edildi. Söylenenlere göre, Şogun da bu sırada kendisi için çok önemli bir şeyi kaybetmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140522
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140522,
					"content": "Orobashi'nin ölümünden bu yana... *öksürür* Watatsumi Adası ve Şogunluk arasında hep bir kin olmuştur. Ama farklı fikirlerimizin, direnişin kurulmasıyla hiçbir ilgisi yok. Biz sadece Önsezi Avı Fermanına karşı durmak için ayaklandık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140523
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140523,
					"content": "Orobashi medeniyeti yok etmek için saldırdığında, Şogun buna karşı koydu ve onu durdurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140524
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140524,
					"content": "Ama şimdi Şogun, Önsezi Avı Fermanıyla insanları heveslerinden mahrum ettiği için, birinin karşı koyup onu durdurması gerekiyor... *öksürür*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140525
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140525,
					"content": "Ben geri döneyim. Şogun'un seçkin samuraylarından birkaçıyla uğraşıyordum. Gidip biraz mola vereceğim, ardından da sonraki görevime geçeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140526
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140526,
					"content": "En kısa sürede Sangonomiya'ya rapor vermelisiniz. Burada gereğinden fazla kalmayın, uzun süre Tatarigami'nin etrafında kalmak sağlığınıza zararlıdır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140527
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140527,
					"content": "*öksürür*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140528,
						20140529
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140528,
					"content": "Kendine dikkat et.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140530
					]
				},
				{
					"id": 20140530,
					"content": "Hey, benim için endişelenme. Formum gayet yerinde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140531
					],
					"speakerTitle": "Teppei"
				},
				{
					"id": 20140531,
					"content": "Teppei şimdiden Şogunluk Samurayıyla uğraşıyorsa, çok ilerleme kaydetmiş olmalı. Ama Paimon buna pek inanamıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20140532
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140532,
					"content": "#Hadi <color=#00E1FFFF>Kokomi</color> ile konuşalım, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20140529,
					"content": "Arkanı kolla.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20140530
					]
				}
			]
		},
		{
			"id": 201406,
			"completionStepIds": [
				201406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
