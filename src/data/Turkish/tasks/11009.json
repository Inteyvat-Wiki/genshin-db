				"points": []
			},
			"dialogs": [
				{
					"id": 110090301,
					"content": "Şifalı bitkiler almaya mı geldiniz? Umarım reçeteniz vardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090302
					],
					"speakerTitle": "Otacı Gui"
				},
				{
					"id": 110090302,
					"content": "Hepsinden yarım kilo olacak şekilde Qingxin, Parlak Zambak ve Mor Ot lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090303
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090303,
					"content": "Yemek siparişi gibi reçete mi olur? Haha... Neyse, alın bakalım. Bütün depomu kuruttunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090304
					],
					"speakerTitle": "Otacı Gui"
				},
				{
					"id": 110090304,
					"content": "Teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090305
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090305,
					"content": "Bunları harbiden de yiyormuş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090306,
					"content": "Shenhe bütün şifalı bitkileri silip süpürerek herkesi hayrete düşürür.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110090307
					]
				},
				{
					"id": 110090307,
					"content": "Karnım doydu, teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090308,
						110090309
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090308,
					"content": "Tatları nasıldı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090310
					]
				},
				{
					"id": 110090310,
					"content": "Berbattı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090311
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090311,
					"content": "Tamamen tatsız olmasalar da çok fazla yedikten sonra ağızda acı bir tat bırakıyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090312
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090312,
					"content": "Nasıl oluyor da restoran yemeklerine dokunmayıp bunları yiyebiliyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090313,
					"content": "Paimon'un yeteri kadar Morası olsaydı şehirdeki en lüks restorana gider, bir araba dolusu yemek söyler ve hepsini tek seferde yerdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090314,
					"content": "Çünkü gelecekte burada kalıp kalmayacağımdan emin değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090315
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090315,
					"content": "Ölümlüler diyarının yemekleri çok lezzetli. Ama dağlara dönersem buradaki yemekleri özlemek ruhani gelişimimi engeller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090316
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090316,
					"content": "Tadına bakmak için her yemekten ufak bir parça almak yeterli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090317
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090317,
					"content": "#\"Dağlara dönmek\", işte bu her şeyi açıklıyor {NICKNAME}! Paimon onun bir Adeptus olduğunu anlamıştı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090318,
					"content": "Benden yeterince söz ettik. Siz ne yapacaksınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090319
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090319,
					"content": "Doğru! Paimon az daha unutuyordu! Yeşim Konak'ı yeniden kurma yarışına katılmaya geldik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090320,
					"content": "Ama muhtemelen çok geride kaldık çünkü uzun bir süredir burada oyalanıyoruz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090321,
					"content": "Anlıyorum. Geçerken ben de yarışma hakkında bir şeyler duydum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090322
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090322,
					"content": "Hehe, kazanırsan da Ningguang'a istediğin her şeyi sorabilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090323,
					"content": "Yarışmaya sen de katılacak mısın Shenhe?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090324,
					"content": "Buraya Yeşim Konak'ın yeniden inşası için gelsem de bu ana kadar yarışmaya katılmaya hiçbir niyetim yoktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090325
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090325,
					"content": "Ancak bana gösterdiğiniz nezaket karşısında ben de size yardımcı olmak isterim. Karşılığında bir şey istemiyorum merak etmeyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090326
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090326,
					"content": "Vay canına! Yardım etmek zorunda değilsin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090327,
					"content": "... Ama bir Adeptusun yardımı işimizi kolaylaştırır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090328,
						110090329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090328,
					"content": "Elbette. Güçlerimizi birleştirelim o halde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090330
					]
				},
				{
					"id": 110090330,
					"content": "Vakit kaybetmeden işe koyulalım. Bir planım var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090331
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090331,
					"content": "Harika! Paimon bunun muhteşem bir plan olacağından emin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090332,
					"content": "Bu planın neye ya da kime göre \"muhteşem\" olarak sınıflandırılabileceğinden emin olmasam da etkili bir plan olacağını düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090333
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090333,
					"content": "Tek yapmamız gereken bizden önde olanları yok etmek. Böylelikle kazanan biz olacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090334
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090334,
					"content": "Reddediyorum! Bu asla ama asla kabul edilemez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090335,
					"content": "Neden ki? Rekabetin özünde çatışma ve üstünlük sağlama olduğunu duydum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090336
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090336,
					"content": "Biz bu yarışı adil bir şekilde kazanmak istiyoruz, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090337
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090337,
					"content": "Gün Batımı Zincifresi, Mucize Çekirdekleri ve Adeptus Mühürleri... Listenin başından başlayıp sırayla gidelim. Plaustrit için...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090338,
					"content": "Orada tartışanın kim olduğunu merak ediyordum, senmişsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090339
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090339,
					"content": "Baizhu! Burada ne arıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090340
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090340,
					"content": "Leydi Ningguang büyük miktarda pansuman malzemesi satın almak istiyor. Mağazadakilerin sayısı azaldı, bu yüzden malzemeleri bizzat almaya geldim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090341
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090341,
					"content": "Ha? Leydi Ningguang'ın neden bu kadar çok pansuman malzemesine ihtiyacı olsun ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090342
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090342,
					"content": "Emin değilim. Yeşim Konak'ı yeniden inşa edeceğini duydum, belki de şantiyede ilk yardım için kullanacaktır. Ne için kullanacağını sormadım gerçi, müşterimin kişisel meselelerine karışacak değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090343
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090343,
					"content": "Ayrıca Qiqi'yi de ödünç aldı... Yani Bubu Eczanesi şu anda zor durumda. Aranızda yarı zamanlı bir iş arayan var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090344
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090344,
					"content": "Yok, bizim yapacak başka işlerimiz var... Ama bilgi sahibi birine benziyorsun, o nedenle hazır buradayken sormak istiyorum: \"Gün Batımı Zincifresi\" diye bir şey duydun mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090345,
					"content": "Yeşim Konak'ın inşasında kullanılan bir Plaustrit, değil mi? Ondan \"Yedi Dağ Antlaşmalarında\" biraz bahsediliyor. Gün Batımı Zincifresi etkin hale getirildiğinde göklere kadar yükselir. Gerçekten ender bulunan bir malzemedir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090346
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090346,
					"content": "Kayıtlara bakılırsa var olan tüm Gün Batımı Zincifresi kazılmış ve sahiplenilmiş. Ancak Feiyun Ticaret Loncası bu konuyu çok daha iyi bilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090347
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090347,
					"content": "Tamamdır! Hadi gidip Feiyun Ticaret Loncasına soralım o zaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090348
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090348,
					"content": "Teşekkürler Baizhu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090349,
					"content": "Rica ederim, ne demek. Hepinize iyi şanslar, ihtiyacınız olursa beni Bubu Eczanesinde ziyaret edebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 110090329,
					"content": "Takımımıza hoş geldin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090330
					]
				},
				{
					"id": 110090309,
					"content": "Gerçekten güzel miydi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090310
					]
				}
			]
		},
