			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ningguang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110090101,
					"content": "Bugün hepinizi buraya önemli bir duyuru yapmak için çağırdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090102
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090102,
					"content": "Muhtemelen aranızdan haberleri duyanlar olmuştur. Açıkçası Yeşim Konak'ı tekrar inşa etmeyi planlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090103
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090103,
					"content": "Yeşim Konak'ı yeniden inşa etmek mi? Bu devasa bir proje...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090104
					],
					"speakerTitle": "Hongfei"
				},
				{
					"id": 110090104,
					"content": "Demek söylentiler doğruymuş. Son zamanlarda inşaat malzemelerinin neden pahalandığı belli oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090105
					],
					"speakerTitle": "Changgui"
				},
				{
					"id": 110090105,
					"content": "Yeşim Konak Leydi Ningguang için çok önemli. Böyle bir projeye dahil olmak büyük bir fırsat olurdu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090106
					],
					"speakerTitle": "Zhicheng"
				},
				{
					"id": 110090106,
					"content": "Leydi Ningguang, acaba biz de yardımcı olabilir miyiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090107
					],
					"speakerTitle": "Hongfei"
				},
				{
					"id": 110090107,
					"content": "Sabredin. Haberler henüz duyuruldu fakat şimdiden benimle iletişime geçip projeyle ilgilendiklerini belirten birçok kişi var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090108
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090108,
					"content": "Bununla birlikte, bugün burada size söylemek istediğim birkaç mesele var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090109
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090109,
					"content": "Şantiye alanı belirlendi ve gereken malzemelerin birçoğu ayarlandı ancak üç ana malzeme şu an için hâlâ eksik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090110
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090110,
					"content": "Gün Batımı Zincifresi, Mucize Çekirdekleri ve Adeptus Mühürlerine ihtiyacımız var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090111
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090111,
					"content": "Şey, cahilliğimi mazur görün Leydi Ningguang. Plaustritlere aşina olsam da diğer ikisini daha önce hiç duymadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090112
					],
					"speakerTitle": "Changgui"
				},
				{
					"id": 110090112,
					"content": "Yalnızca yeterli büyüklükteki Plaustrit parçaları, yani Zincifreler \"Gün Batımı\" olarak adlandırılabilirler. Yeşim Konak'ın havada süzülmesini bu taşlar sağlar. Mucize Çekirdekleri ise Yeşim Konak'ın mekanik yapısının ana bileşenleridir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090113
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090113,
					"content": "Adeptus Mühürleri ise mekanik cihazların Adeptus büyüsüyle birleşmesini sağlar. Adeptus Mühürleri en az mekanik çekirdeğin kendisi kadar vazgeçilmezdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090114
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090114,
					"content": "Bu üçü nadir bulunsa da sahip olduğunuz bağlantılarla ve yeteneklerle onları elde edeceğinize eminim. Asıl mesele zaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090115
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090115,
					"content": "\"Vakit nakittir\" deyimi benim hayat felsefemdir. Ne kadar verimli olursanız o kadar iyi. Bulduğunuz malzemelerin karşılığını fazlasıyla vereceğim, buna ek olarak tüm malzemeleri bulup getiren ilk üç kişi bana bir soru sorma hakkı kazanacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090116
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090116,
					"content": "Bana istediğiniz her şeyi sorabilirsiniz, dürüstçe cevaplayacağım. Bu mükafatlandırmanın herkesi memnun edeceğini düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090117
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090117,
					"content": "Bunları elde etmek kolay olmasa da işin ucunda Liyue Limanı'nın önümüzdeki sene için kalkınma planı hakkında içeriden bilgi alma şansı varsa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090118
					],
					"speakerTitle": "Changgui"
				},
				{
					"id": 110090118,
					"content": "Bu fırsat kaçmaz. Leydi Ningguang'dan bilgi almak paha biçilemez bir nimet. Malzemeleri ilk getiren pazarı kontrol edecektir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090119
					],
					"speakerTitle": "Zhicheng"
				},
				{
					"id": 110090119,
					"content": "Haha, tesadüfe bak! Her şeyi ifşa etmeye niyetim yok ancak geçen gün Plaustritler hakkında birkaç dedikodu duydum. O nedenle bana müsaade, yapacak işlerim var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090120
					],
					"speakerTitle": "Hongfei"
				},
				{
					"id": 110090120,
					"content": "Olamaz... Elimizi çabuk tutmazsak bu fırsatı kaçıracağız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090121
					],
					"speakerTitle": "Changgui"
				},
				{
					"id": 110090121,
					"content": "Ningguang Yeşim Konak'ı yeniden mi inşa ediyor? Büyük bir fırsat bu. Biz de dahil olmalıyız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090122,
					"content": "Yaptığım duyuruyu işittiniz demek? Ne dersiniz, ilginizi çeker mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090123
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090123,
					"content": "Gerçekten istediğim her şeyi sorabilir miyim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090124
					]
				},
				{
					"id": 110090124,
					"content": "Soracağın konu hakkında bilgi sahibi olduğum sürece evet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090125
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090125,
					"content": "(Bu sayede belki kardeşim hakkında bir şeyler öğrenebilirim...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090126
					]
				},
				{
					"id": 110090126,
					"content": "Gerçekten mi? O zaman Paimon sana işlerin nasıl yürütüldüğünü soracak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090127,
					"content": "Böylece bir daha hiç Morasız kalmayacağız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090128,
					"content": "Haha, tabii. Ancak sizinle bu bilgilerin ne kadarını paylaşacağım göstereceğiniz performansla doğru orantılı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090129
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090129,
					"content": "Yeşim Konak'ın inşası için büyük bir alan gerekli. Altın Ev'in dışındaki terk edilmiş maden şantiye alanı olacak. Topladığınız malzemeleri lütfen oraya götürün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090130
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090130,
					"content": "Şu anda ilgilenmem gereken başka işler olmasa sizi oraya memnuniyetle götürürdüm. Oraya vardığınızda lütfen sekreterimle görüşün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090131
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090131,
					"content": "Zamana karşı yarıştığınızı unutmayın. Karşınıza çıkan bu fırsatın başkaları tarafından elinizden alınmasına müsaade etmeyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090132
					],
					"speakerTitle": "Ningguang"
				},
				{
					"id": 110090132,
					"content": "Ningguang çok meşgul görünüyor... Hadi, yola koyulsak iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090133,
					"content": "#Önce Yujing Terası'ndan çıkalım... Ha? {NICKNAME} baksana, şurada şüpheli bir şeyler oluyor sanki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090134,
					"content": "Hanımefendi, seçkin birine benziyorsunuz. Bana kalırsa Leydi Ningguang'ın başlattığı bu yarışı kolayca kazanacaksınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090135
					],
					"speakerTitle": "Yaralı Liu"
				},
				{
					"id": 110090135,
					"content": "Şansınıza, malzemeler hakkında ilginizi çekebileceğini düşündüğüm bazı bilgilere sahibiz. Gelin, detayları konuşmak için daha sessiz bir yere geçelim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090136
					],
					"speakerTitle": "Yaralı Liu"
				},
				{
					"id": 110090136,
					"content": "Hayır. Gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090137
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090137,
					"content": "Hadi ama, yapma böyle. Hey, dur. Gitme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090138
					],
					"speakerTitle": "Yaralı Liu"
				},
				{
					"id": 110090138,
					"content": "Burada dikileceğine kadının peşinden gitsene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090139
					],
					"speakerTitle": "Yaralı Liu"
				},
				{
					"id": 110090139,
					"content": "Ha, tamam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cesur Qiang"
				}
			]
		},
		{
			"id": 1100902,
			"completionStepIds": [
				1100902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100902",
							"2"
						],
						"stepId": 1100902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shenhe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110090201,
					"content": "Hehe, şu işe bakın hanımefendi, kaçabileceğiniz hiçbir yer kalmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090202
					],
					"speakerTitle": "Yaralı Liu"
				},
				{
					"id": 110090202,
					"content": "Endişelenmeyin. Kötü insanlar değiliz. Sen bize Mora ver, biz de sana bilgi verelim. Alan mutlu veren mutlu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090203
					],
					"speakerTitle": "Yaralı Liu"
				},
				{
					"id": 110090203,
					"content": "Bu iş içime sinmedi patron. Şu beyaz saçlara, şu yaydığı enerjiye baksana... Bu kadında bir gariplik var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090204
					],
					"speakerTitle": "Cesur Qiang"
				},
				{
					"id": 110090204,
					"content": "Garipse garip, kesesi dolu! Parayı elimizden kaçırırsak kumar borcumuzu nasıl ödeyeceğiz, ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090205
					],
					"speakerTitle": "Yaralı Liu"
				},
				{
					"id": 110090205,
					"content": "Size söyledim. Vereceğiniz bilgiye ihtiyacım yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090206
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090206,
					"content": "Anlamamakta ısrar edecekseniz unutmayacağınız şekilde yeniden anlatabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090207
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090207,
					"content": "*iç çeker* Hadi ama. Zeki birine benziyorsun. Daha ne demem gerekiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090208
					],
					"speakerTitle": "Yaralı Liu"
				},
				{
					"id": 110090208,
					"content": "Mesele bilgiye ihtiyacının olup olmaması değil. Mesele kimsenin canı yanmadan önce senin o parayı cebinden çıkarıp bize vermen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090209
					],
					"speakerTitle": "Yaralı Liu"
				},
				{
					"id": 110090209,
					"content": "Verme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090210
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090210,
					"content": "Bahane uydurmayı kes! Paran var, biliyorum. Seni gördüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090211
					],
					"speakerTitle": "Yaralı Liu"
				},
				{
					"id": 110090211,
					"content": "Liuli Konağı'nda bir masa dolusu yemek söyleyip sadece birkaç lokma yedin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090212
					],
					"speakerTitle": "Yaralı Liu"
				},
				{
					"id": 110090212,
					"content": "Ardından Xinyue Köşkü'nde ve Wanmin Restoranında da gördüm. Her seferinde aynı terane. Bütün özel yemekleri sipariş ediyorsun, sonra da bitirmeden kalkıp gidiyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090213
					],
					"speakerTitle": "Yaralı Liu"
				},
				{
					"id": 110090213,
					"content": "Zengin bir aileden gelmesen nasıl bu kadar savurgan davranabilirdin? Bu kadar zengin olduğuna göre biraz bozukluk harcamanın sana zararı olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090214
					],
					"speakerTitle": "Yaralı Liu"
				},
				{
					"id": 110090214,
					"content": "Ustam Liyue Limanı'nda kimseye el kaldırmamam konusunda beni uyarmıştı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090215
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090215,
					"content": "Ancak işleri zorlaştırıyorsunuz. Belki de... \"Kaderimiz\" böyledir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090216
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090216,
					"content": "Patron, bu işte bir iş var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090217
					],
					"speakerTitle": "Cesur Qiang"
				},
				{
					"id": 110090217,
					"content": "Ne korkakmışsın sen de! Bilgi satmak yasa dışı değil. Bize elini sürerse daha iyi, dava açıp malını mülkünü alırız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090218,
						110090219
					],
					"speakerTitle": "Yaralı Liu"
				},
				{
					"id": 110090218,
					"content": "İşte oradalar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090220
					]
				},
				{
					"id": 110090220,
					"content": "Ha? Yine mi siz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090221
					],
					"speakerTitle": "Zheng"
				},
				{
					"id": 110090221,
					"content": "Taşordu mu? Taşordu ne arıyor burada? Bu sizin başınızın altından mı çıktı? Öf be. Bu işe burnunuzu sokmayın yoksa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090222
					],
					"speakerTitle": "Yaralı Liu"
				},
				{
					"id": 110090222,
					"content": "Sus! Ne hakla masum sivilleri tehdit edersin? Sizi tutuklamak zorundayım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090223
					],
					"speakerTitle": "Zheng"
				},
				{
					"id": 110090223,
					"content": "Hehe... Kızmayın efendim. Bırakın da açıklayayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090224
					],
					"speakerTitle": "Yaralı Liu"
				},
				{
					"id": 110090224,
					"content": "Taşordu beyaz saçlı kadının etrafını saran serserileri götürür.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110090225
					]
				},
				{
					"id": 110090225,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090226,
						110090227
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090226,
					"content": "İyi misiniz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090228
					]
				},
				{
					"id": 110090228,
					"content": "Shenhe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090229
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090229,
					"content": "Shenhe mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090230,
					"content": "Adım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090231
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090231,
					"content": "#Haa, adın Shenhe yani! Paimon'un adı da... Paimon! Bu da Paimon'un yol arkadaşı {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090232,
					"content": "Sizi duymuştum. Durumu yatıştırmaya yardım ettiğiniz için teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090233
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090233,
					"content": "Ancak kendim de halledebilirdim. Kafasını birkaç kez yere vursam pes etmesi için yeterli olurdu bence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090234
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090234,
					"content": "Yooo! Bunu yapamazsın! Şiddete karşı olmalıyız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090235,
					"content": "Burası Liyue Limanı. Burada o tür şeylere karşı yasalar var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090236,
					"content": "Yasalar mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090237
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090237,
					"content": "Yasanın ne olduğunu bilmiyor musun Shenhe?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090238
					]
				},
				{
					"id": 110090238,
					"content": "Hayır, bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090239
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090239,
					"content": "Cidden mi? O zaman nasıl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090241,
					"content": "Bu ses de neyin nesi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090242
					]
				},
				{
					"id": 110090242,
					"content": "Guruldayan midemin sesi. Pek bir şey yemedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090243
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090243,
					"content": "Çok açık sözlü biri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090244,
					"content": "Doğru ya... Senin tüm restoranları dolaşıp bir sürü yemek siparişi verdiğini ama her tabaktan birkaç lokma alıp kalktığını söylemişlerdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090245,
					"content": "Böyle yaparsan tabii aç olursun! Peki özel olarak yemek istediğin bir yemek var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090246
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090246,
					"content": "Qingxin, Parlak Zambak ve Mor Ot. Genelde bunları yerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090247
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090247,
					"content": "İyi de bunlar şifalı bitkiler...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090248
					]
				},
				{
					"id": 110090248,
					"content": "Şifalı bitkiler mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090249
					],
					"speakerTitle": "Shenhe"
				},
				{
					"id": 110090249,
					"content": "Açıklaması zor... Neyse, Bubu Eczanesi çok uzak değil. Hadi Shenhe'yi oraya götürüp ona bir şifa sofrası hazırlayalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110090250
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090250,
					"content": "Aç karnına iş yapamazsın sonuçta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110090227,
					"content": "Merak etmeyin, her şey yolunda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090228
					]
				},
				{
					"id": 110090219,
					"content": "Bilgi satmak için gözdağı vermeye çalışıyorlar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110090220
					]
				}
			]
		},
		{
			"id": 1100903,
