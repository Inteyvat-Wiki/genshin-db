			"dialogs": [
				{
					"id": 220350204,
					"content": "Vay be, bu sefer harbiden büyük kargaşa çıkardık. Amano ve Bay Andou şehirdeki hırsızın bu olaydan haberinin olmasını sağlayacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350205
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350205,
					"content": "Bu daha ne kadar sürecek?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220350206
					]
				},
				{
					"id": 220350206,
					"content": "Çok uzun sürmez, Sango hazır olduğunda bu davayı kapatırız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350207
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350207,
					"content": "İşte ücretin Gezgin, yardımın için çok teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350208
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350208,
					"content": "Ücretin ne kadar olacağına Sango karar verdiği için emeğini karşıladığını umuyorum. Lütfen ücreti kabul et, belki ileride tekrar çalışma şansı yakalayabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				}
			]
		},
