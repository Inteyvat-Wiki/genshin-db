			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220350101,
					"content": "Seni gördüğüme sevindim Gezgin. Sayende Sango, suçlunun kimliğini ortaya çıkardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350102
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350102,
					"content": "Bununla birlikte suçlunun işini tamamen bitirmek için hâlâ yapmamız gereken hazırlıklar var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350103
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350103,
					"content": "O kendi işleriyle uğraşırken biz de başladığımız işi bitirelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350104,
						220350107
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350104,
					"content": "Hazine Avcılarına mı sataşacağız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220350105
					]
				},
				{
					"id": 220350105,
					"content": "Evet. Suçlunun Hazine Avcılarıyla hiçbir alakası olmasa da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350106
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350106,
					"content": "Hazine Avcılarının kimseye hayrı yok zaten, o sebeple bize \"yardım\" etmelerini sağlayabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350112
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350112,
					"content": "Sango bulundukları yeri işaretledi. Şehirden çok da uzakta değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350113
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350113,
					"content": "Şehirdeki meseleye gelecek olursak... Sango bu harekatta bize yardım etmeleri için gizlice Amano ve Bay Andou'yu görevlendirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350114
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350114,
					"content": "Ayrıca davanın çözülmesi durumunda tüm övgüyü onların alacağına söz verdi; bu durumda bizimle seve seve çalışacaklarına eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350115
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350115,
					"content": "Planlamayı ve düşünmeyi ona bırak. Biz de Hazine Avcılarıyla \"görüşmelerimize\" devam edelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350116
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350116,
					"content": "Bölgeyi haritana işaretledim. Artık yola koyulalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350107,
					"content": "Suçluyu mu kandıracağız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220350108
					]
				},
				{
					"id": 220350108,
					"content": "Aynen öyle. Hazine Avcılarının peşinde olduğumuza inanmaya devam etmeleri gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350109
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350109,
					"content": "Böylece Sango'nun, planını tamamlayabilmesi için daha çok vakti olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350110
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350110,
					"content": "*kıkırdar* Hazine Avcılarının kimseye hayrı yok zaten...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350111
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220350111,
					"content": "En azından bize \"yardım\" edip bir işe yarasınlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220350112
					],
					"speakerTitle": "Ryuuji"
				}
			]
		},
		{
			"id": 2203502,
