			},
			"dialogs": [
				{
					"id": 730340201,
					"content": "Ha? Neye bakıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340202,
					"content": "Bu defterde çiçeklerin bakımıyla ilgili notlar var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730340203
					]
				},
				{
					"id": 730340203,
					"content": "Öyle mi? Paimon da bakmak istiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340204,
					"content": "\"... Açık bir alana konulmalı ve yeteri kadar güneş almalı...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340205,
					"content": "Anlaşılan Collei'in bunu dışarı çıkarmaya vakti olmamış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340206,
					"content": "Hehe. Hadi Collei'in yerine halledelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340207,
					"content": "Hımm. Önce çiçeği taşımalıyız. Evin yanına koyalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340208,
					"content": "Çok uzağa koyma. Collei döndüğünde bulamazsa endişelenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7303406,
			"completionStepIds": [
				7303406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7303406",
