				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730340601,
					"content": "Bu mektubu Collei yazmış. Hadi gidip bir bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340602,
					"content": "Peki niye hâlâ dönmedi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730340603
					]
				},
				{
					"id": 730340603,
					"content": "Yine Tighnari'yle çalışmaya çıkmış olabilir. Onlar hep çok meşgul oluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340604,
					"content": "Hadi mektubu oku. Sırf şu el yazısına bakınca bile, Paimon, Collei'in kalemini mektuba çok sert bastırdığına iddiaya girer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340605,
					"content": "#\"{NICKNAME} ve Paimon, çiçeğime baktığınız için teşekkürler.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340606,
					"content": "\"Ormanda halletmemiz gereken çok şey var. Meşgul olduğumda onunla ilgilenmeyi unutabiliyorum.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340607,
					"content": "\"Yardım ettiğiniz için tekrar teşekkür ederim. Boş zamanım olunca Bay Jahangir'in yerinde Kumpir yiyelim!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340608,
					"content": "Vay be! Collei bize yemek ısmarlayacak! Paimon bunu not alacak ve çok iyi hatırlayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340609,
					"content": "Hımm... Paimon hâlâ Collei'in ne üzerinde çalıştığını bilmiyor ama kendisi çok meşgul galiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730340610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730340610,
					"content": "Paimon onun yeteri kadar uyumasını umuyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
