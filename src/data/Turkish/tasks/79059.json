			"dialogs": [
				{
					"id": 790590101,
					"content": "Bu, \"Doğuya Yolculuk\" gösterisinden bir sahne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590102
					],
					"speakerTitle": "Sahne Notları"
				},
				{
					"id": 790590102,
					"content": "Oyunun asıl fikri, bir gezginin Daena Evi'nde mütevazı bilgeliği bulmak amacıyla Fontaine'den başlayarak doğuya, Sumeru Şehri'ne olan yolculuğunun anlatıldığı bir hikayeydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590103
					],
					"speakerTitle": "Sahne Notları"
				},
				{
					"id": 790590103,
					"content": "Bu sahne, gezginin \"Dönüşümlerin Ustasını\" nasıl devasa bir kaya tarafından ezilmekten kurtardığı ve yolda geçen maceralarıyla ilgili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590104
					],
					"speakerTitle": "Sahne Notları"
				},
				{
					"id": 790590104,
					"content": "Ne yazık ki, gezgin ve Dünyevi Dönüşümlerin Ustası rollerini canlandıran Su Tayfları ortadan kayboldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790590105
					],
					"speakerTitle": "Sahne Notları"
				},
				{
					"id": 790590105,
					"content": "Keşke biri <color=#00E1FFFF>ikisini de geri getirebilse</color> ve devasa kayanın yanındaki provayı çekebilseydi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						79059106
