			"dialogs": [
				{
					"id": 745260401,
					"content": "#Aa, {NICKNAME}, sen mi geldin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260402,
						745260403
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 745260402,
					"content": "Pratik mi yapıyorsun Nilou?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260404
					]
				},
				{
					"id": 745260404,
					"content": "Hayır hayır, hiç de değil. Sadece yeni bir dans üzerinde çalışıyorum. Yağmur sonrası güneşte parlayan Padisarahlardan ve yaprak uçlarında asılı kalan çiy tanelerinden ilham alan bir dans bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260405
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 745260405,
					"content": "Daha planlamanın en başındayız ve hareketlerin çoğu henüz tam oturmadı. Sanırım hâlâ eksik bir şeyler var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260406,
						745260407
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 745260406,
					"content": "Tasvir edişin bile kulağa güzel geliyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260408
					]
				},
				{
					"id": 745260408,
					"content": "Fotoğrafımı mı çekmek istiyorsun? Şey, dediğim gibi, bu dans adımları henüz gösteriye hazır değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260409,
						745260410
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 745260409,
					"content": "Dans son şeklini almadan önceki prova seansı da...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260411
					]
				},
				{
					"id": 745260411,
					"content": "Doğru, haklısın! O halde bu hareketleri en iyi şekilde yapacağım... Tam olarak çiçeklerin açtığı o anı yakalamaya çalış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nilou"
				},
				{
					"id": 745260410,
					"content": "Sanatın bir parçasıdır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260411
					]
				},
				{
					"id": 745260407,
					"content": "Bir fotoğrafını çekebilir miyim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260408
					]
				},
				{
					"id": 745260403,
					"content": "Seni rahatsız etmiyorumdur umarım?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260404
					]
				}
			]
		}
