			"dialogs": [
				{
					"id": 731100801,
					"content": "Alem Mezarını keşfettik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100802
					]
				},
				{
					"id": 731100802,
					"content": "Demek Alem Mezarına gittin... Dediğim gibi Kral Deshret'in Anıt Mezarının küçük bir hali, değil mi? Yeni bir şey keşfettin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100803
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100803,
					"content": "Soheil'e Alem Mezarının keşfini anlatıyorsun ve taş lehvayı ona veriyorsun.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731100804
					]
				},
				{
					"id": 731100804,
					"content": "Önemli bir şey bulmamışsınız anlaşılan. Belli ki iki yerin arasındaki tek fark boyutları değilmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100805
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100805,
					"content": "Bu levhaya gelince...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100806
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100806,
					"content": "Nedir o? Bir sürü kelime geçiyor, o yüzden değerli olmalı, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731100807,
					"content": "Anladığım kadarıyla sıradan bir masal sadece. Bazı hayvanların ismi geçiyor, o kadar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100808
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100808,
					"content": "Ne? Bu nasıl olabilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731100809,
					"content": "Önemli değil. Bundan kısa da olsa makale çıkarabilirim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100810
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100810,
					"content": "\"Koyunların Kaçışı: Çöldeki Çevresel Değişikliklere İlişkin Ön Çalışma.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soheil"
				}
			]
		},
