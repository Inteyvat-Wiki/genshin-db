				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731100501,
					"content": "Üç harabe de tamamen keşfedildiğine göre artık biraz kafamı dinleyebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100502
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100502,
					"content": "Peki o zaman. güçlenen dostluğumuzu kutlamak adına büyük ve küçük kahramanımız için minnetimi gösteren başka hediyeler hazırlayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100503,
						731100505
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100503,
					"content": "Rica ederim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100504
					]
				},
				{
					"id": 731100504,
					"content": "Önemli değil, gerçekten! Ayrıca bize verdiğin notlar sayesinde bir sürü hazine bulduk! Makale nasıl gidiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731100507,
					"content": "Makale... Evet, yeterli malzeme toplamış olsam da artık ciltlerce yazmak istemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100508
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100508,
					"content": "Benim peşinde olduğum şey bir devrim... Yine de Kral Deshret'in Anıt Mezarına gitmeliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100509
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100509,
					"content": "Ama bilge dedi ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100510
					],
					"speakerTitle": "Hulwani"
				},
				{
					"id": 731100510,
					"content": "Evet, anladım, bilgeden başka bildiğiniz yok zaten... Dertleniyorum, o kadar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100511
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100511,
					"content": "Çığır açan bir şeye neden ihtiyacın var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100512
					]
				},
				{
					"id": 731100512,
					"content": "Elbette bir sonraki bilge olabilmek için.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100513
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100513,
					"content": "Yabancılar, araştırmacı ile bilge arasındaki farkın küçük bir meyveyle büyük meyve arasındaki fark gibi olduğunu sanıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100514
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100514,
					"content": "Gerçekte aradaki fark bir Dağ Yabanisi ile Bodurlop arasındaki farktan da büyük.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100515,
						731100517
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100515,
					"content": "Bunlar tamamen farklı şeyler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100516
					]
				},
				{
					"id": 731100516,
					"content": "Tam da bunu kastediyorum. Birbirinden tamamen farklı şeyler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100519
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100519,
					"content": "Bilgeler, kontrol ettikleri güçle neredeyse biz araştırmacıları esir aldılar. Tek bir kelimeyle bizi batırabilir ya da çıkarabilirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100520
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100520,
					"content": "Benim gibi ihtiyarlar da dahil birçok kişi makaleler yazabilmek için onca emek ve uğraş verdi. Bilgelerin gözüne girebilmek için haysiyetimizden bile vazgeçeriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100521
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100521,
					"content": "Bu yüzden ben de bilge olmalıyım yoksa bunca acıyı boşuna çekmiş olacağım. Araştırmacı olsaydınız eminim siz de halimden anlardınız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100522
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100522,
					"content": "#Hayır, Paimon'a göre {NICKNAME} notlardaki kişiye daha çok benziyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731100523,
					"content": "Notlar mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100524
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100524,
					"content": "Evet! Notlarında ne yazdığını hatırlıyor musun? \"Alay edilmeye kıyasla bilgide ilerleme kaydetmemeye dayanmak çok daha zor.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731100525,
					"content": "Ne? Bunu ben mi yazmışım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100526
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100526,
					"content": "Hım... Yaşadığım onca şey hakikaten de doğru. Ama hatırlatmasaydın bir daha asla o açıdan bakmazdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100527,
						731100528
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100527,
					"content": "Yani tamamen unutmuştun...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100529
					]
				},
				{
					"id": 731100529,
					"content": "#{NICKNAME}, Paimon. Bu biraz uygunsuz gelecek ama bir iyilik daha isteyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100530
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100530,
					"content": "Ne? Daha fazla taş levha aramamızı mı istiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100531
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731100531,
					"content": "Hayır, hayır. Yeterince taş levham var. Sadece... Eski notlarımı tekrar okumak istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100532
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100532,
					"content": "Size verdiğim arkeoloji notlarını almama müsaade edin. Size hediye olarak başka bir şey hazırlayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100533
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100533,
					"content": "Tabii.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100534
					]
				},
				{
					"id": 731100534,
					"content": "Yardımınız için teşekkürler. Dilerim seyahatleriniz sorunsuz geçsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100535
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100535,
					"content": "Ayrıca gençlik zamanlarımı hatırlattığınız için teşekkürler. Oldukça güzel bir duygu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100528,
					"content": "Tekrar her şeyi hatırlamak güzel.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100529
					]
				},
				{
					"id": 731100517,
					"content": "Nasıl farklı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100518
					]
				},
				{
					"id": 731100518,
					"content": "Aradaki fark, tamamen farklı şeyler olmaları.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100519
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100505,
					"content": "Her şey karşılıklı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100506
					]
				},
				{
					"id": 731100506,
					"content": "Aynen öyle! Biz hazineleri aldık, sen de makalen için ilham.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100507
					],
					"speakerTitle": "Paimon"
				}
			]
		},
