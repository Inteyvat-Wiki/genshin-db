			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Soheil"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731100101,
					"content": "Oh, neyse, burası çok daha serin. Levhaya bakabilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100102
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100102,
					"content": "Soheil levhayı incelerken yüzündeki ifade hayret ve hoşnutsuzluk arasında gidip geliyor.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731100103
					]
				},
				{
					"id": 731100103,
					"content": "Hey, çok uzun zamandır buna bakıyorsun! Metni aklına kazıyıp ödeme yapmaktan kaçınmaya çalışmıyorsun, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731100104,
					"content": "Üzgünüm, buna hayran kaldım, o kadar. İlk defa böyle bir yazı görüyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100105
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100105,
					"content": "Bir şeyler keşfedebildiniz mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100106
					]
				},
				{
					"id": 731100106,
					"content": "Hımm... Birkaçı inşaat günlüğüne benziyor... \"Aaru\"dan bahsediyor ama şimdiki Aaru Köyü ile ilgili olup olmadığı meçhul. Kayıtların bu kadar kısa olması üzücü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100107
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100107,
					"content": "Yine de bu keşif hakkında kesinlikle birkaç sayfa yazı yazılabilir. Çok teşekkürler. Anlaşmamız gereğince bunları alın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100108,
						731100109
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100108,
					"content": "Rica ederim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100112
					]
				},
				{
					"id": 731100109,
					"content": "Aslında Tirzad'a teşekkür ediyor olman lazım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100110
					]
				},
				{
					"id": 731100110,
					"content": "Çok doğru! Tirzad'ın makalesini kanıtlamaya çalışmasaydık bu levhayı bulamazdık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731100111,
					"content": "Haklısın, aslında teşekkür etmem gereken kişi Tirzad!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100112
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100112,
					"content": "Sıradaki hedefim daha da büyük bir ana malzeme koleksiyonu bulmak ama çöle gitmeden bu zor olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100113
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100113,
					"content": "Bir fikrim var! Vaktin varsa lütfen beni dinle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100114
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100114,
					"content": "Bay Soheil, yoksa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100115
					],
					"speakerTitle": "Hulwani"
				},
				{
					"id": 731100115,
					"content": "Bilge, tüm araştırmacıların çöle gitmesini yasakladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100116
					],
					"speakerTitle": "Hulwani"
				},
				{
					"id": 731100116,
					"content": "Bilgenin otoritesine karşı gelmeye asla cüret edemem ama hediye vermeyi de yasaklamadığından eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100117
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100117,
					"content": "Hediye mi? Bize ne vereceksin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731100118,
					"content": "Çok değerli bir şey... Arkeoloji notlarımı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100119
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100119,
					"content": "Dürüst olmak gerekirse on yılı aşkın bir süre önce çöle gittim ama birkaç potansiyel harabenin yeri dışında özel bir şey bulmadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100120
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100120,
					"content": "Bence harabeler aracılığıyla sizinle tanışmama kader yol açtı. O yüzden bu notları almanızı istiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100121
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100121,
					"content": "Yani... Anladım. Bu kurallara karşı olmasa da korkarım yaptıkların...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100122
					],
					"speakerTitle": "Hulwani"
				},
				{
					"id": 731100122,
					"content": "#Yaptıklarım mı? Sadece büyük kahraman {NICKNAME} ve küçük kahraman Paimon ile arkadaşlığımı kutlamak için bir hediye veriyorum. Makul olan da bu değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100123
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100123,
					"content": "Sanırım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100124,
						731100125
					],
					"speakerTitle": "Hulwani"
				},
				{
					"id": 731100124,
					"content": "Makul sanırım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100130
					]
				},
				{
					"id": 731100125,
					"content": "Pek makul değil...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100126
					]
				},
				{
					"id": 731100126,
					"content": "Ah... Yetmez mi? Bunu bir tanışma hediyesi olarak düşünün. Sonra size daha güzellerini vereceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100127
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100127,
					"content": "Paimon oldukça makul olduğunu düşünüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731100128,
					"content": "Küçük kahraman öyle düşünüyor. Peki büyük kahraman ne düşünüyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100129
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100129,
					"content": "Tamam...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100130
					]
				},
				{
					"id": 731100130,
					"content": "Araştırmacıların dünyası gerçekten karmaşıkmış! Hemen çıkıp yardımımıza ihtiyacı olduğunu söyleyebilirdi! Onun yerine tüm bu saçmalıklarla uğraşmak zorunda kaldık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731100131,
					"content": "Paimon'a sorarsan şuradaki koca adamın onu bilgeye ihbar edeceğinden korkuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100132,
						731100134,
						731100136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731100132,
					"content": "Senin dünyan basit de ondan Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100133
					]
				},
				{
					"id": 731100134,
					"content": "Vay be! Gerçekten anladın Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100135
					]
				},
				{
					"id": 731100136,
					"content": "Geçerli sebepleri olmalı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100137
					]
				},
				{
					"id": 731100133,
					"content": "Öyle mi? Paimon dünyasının oldukça karmaşık olduğunu düşünüyor. Paimon her yemeğin tadının nasıl olduğunu ve farklı hazinelere nasıl ulaşılacağını hatırlamak zorunda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731100234,
					"content": "Bir de bütün o Aranaraların adları var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731100135,
					"content": "Tabii ki! Bir tek yüzüne \"Bana yardım edin!\" yazmadığı kalmıştı! Hımm, şimdi ona yardım edersek eminim köşeyi döneriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731100137,
					"content": "Bu her ne kadar doğru olsa da Paimon bu araştırmacıların hep \"bilgi arama\" bahanesinin arkasına sığındığını hissediyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731100138,
					"content": "Bu yaptıkları ve söyledikleri her şeyi haklı göstermez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731100139,
					"content": "Bunu örnek al ve onlar gibi olma Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100140
					]
				},
				{
					"id": 731100140,
					"content": "Merak etme, Paimon'un bilgiye açlığı falan yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731100141,
					"content": "Soheil'in hediyesinde ne yazıyormuş bakalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731100142,
					"content": "Görünüşe bakılırsa zor bir zamandan geçiyor. Kral Deshret'in Anıt Mezarı çevresini bir ay hiçbir şey bulamadan araştırdı ama pes etmedi ve sonunda Şeffaf Harabeleri buldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731100143,
					"content": "Sonrasında Kral Deshret'in Anıt Mezarından çok daha küçük olan Alem Mezarı adında bir yeri keşfetti. Sonunda da Koyun Yutan Kaya denilen bir yerde paralı askerlerin saldırısına uğradı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731100144,
					"content": "Vay canına... Başına gelen bunca şeyden sonra yine de \"alay edilmeye kıyasla bilgide ilerleme kaydetmemeye dayanmak çok daha zor\" yazmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731100145,
					"content": "Sanki bambaşka biri gibi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100146
					]
				},
				{
					"id": 731100146,
					"content": "Evet! Anlaşılan o zamanlar hakikaten de bilginin peşindeymiş. Paimon bundan etkilendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731100147,
					"content": "O açıdan bakınca bunu değerli bir hediye olarak görmesi son derece normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100148
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731100148,
					"content": "Hadi notlarında bahsettiği her konumu ziyaret edelim. Kayda değer bir şey bulursak geri götürüp ona hediye edelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
