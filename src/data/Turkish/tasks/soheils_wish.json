			"dialogs": [
				{
					"id": 731100601,
					"content": "Şeffaf Harabeleri keşfettik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100602
					]
				},
				{
					"id": 731100602,
					"content": "Şeffaf Harabelere mi gittiniz? Bir şey buldunuz mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100603
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100603,
					"content": "Elbette. Şaşırmaya hazır olun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731100604,
					"content": "Soheil'e Şeffaf Harabeleri keşfini anlatıp ona üç taş levhayı verirsin.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731100605
					]
				},
				{
					"id": 731100605,
					"content": "Aha! Yani Kral Deshret o bilinmez gücün ardında gerçekten de bir sır saklıyormuş. Ne olduğunu öğrenmeliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100606
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100606,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100607
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100607,
					"content": "Bu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100608
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100608,
					"content": "Bu nasıl olabilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100609
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100609,
					"content": "Hey, betin benzin atmış. Korkunç bir şey mi buldun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731100610,
					"content": "Şey... Hayır, kusura bakma, \"korkunç\" diyemem de... Taş levhaların üzerindeki yazılar karmaşık görünüyor ama aslında onlar izin talebi kayıtları.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100611
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100611,
					"content": "Ayrıca kayıtlı mazeretler şimdiki genç alimlerden çok da farklı değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100612
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100612,
					"content": "Oh, iyi ki daha önce Şeffaf Harabelere girişi bulmamışım yoksa o zamanlar öfkeden kudururdum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100613
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100613,
					"content": "Neyse, taş levhaları getirdiğiniz için teşekkürler. Belki de gidip Mondstadt'taki insanların mazeretleri neymiş öğrenmeliyim. Bir makale yazmam için yeterli olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100614
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100614,
					"content": "\"Yoğun Programa Ara: Farklı Toplumlarda İzin Günlerinin Evrimi Üzerine.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soheil"
				}
			]
		},
