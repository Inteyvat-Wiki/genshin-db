			"dialogs": [
				{
					"id": 731100701,
					"content": "Koyun Yutan Kayayı keşfettik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731100702
					]
				},
				{
					"id": 731100702,
					"content": "Tehlikeli durumlarla karşılaşmadınız, değil mi? Gerçi Thutmose ile karşılaşsanız bile kendi başınızın çaresine bakabileceğinizden şüphem yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100703
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100703,
					"content": "Soheil'e Koyun Yutan Kaya keşfini anlatıyorsun ve taş levhayı ona veriyorsun.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731100704
					]
				},
				{
					"id": 731100704,
					"content": "Demek ki gerçekten de gizli bir üs varmış... Thutmose'nın bütün tedbirlerime rağmen beni soymasına hiç şaşmamalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100705
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100705,
					"content": "Cahil ahmaklar! Sözde Kral Deshret'e tapıyorlar ama böyle önemli yadigarları rastgele oraya buraya atabiliyorlar! Kabul edilemez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100706
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100706,
					"content": "Bu kadar değerli bir şeyi aldığınız için Akademi adına teşekkürlerimi sunuyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100707
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100707,
					"content": "Niye birden kaşınızı çattınız? Çözemediğin şifre falan mı var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731100708,
					"content": "Aslında tam tersi. Bu bir aşk şiiri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100709
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100709,
					"content": "Belki bu levha Haravatat'takiler için daha değerli olacaktır. Ne tür başlıklar düşüneceklerini tahmin edebiliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731100710
					],
					"speakerTitle": "Soheil"
				},
				{
					"id": 731100710,
					"content": "\"Hitabetin Gelişimi ile Medeniyetin İlerlemesi Arasındaki İlişki Üzerine.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soheil"
				}
			]
		},
