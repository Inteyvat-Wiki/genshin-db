			"dialogs": [
				{
					"id": 230310601,
					"content": "Çok iyi, elimizde tüm malzemeler var. Şimdi eşsiz bir yem nasıl hazırlanır iyi izle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310602
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310602,
					"content": "Kayvan ustalıkla yemi hazırlıyor.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230310603
					]
				},
				{
					"id": 230310603,
					"content": "Pekala, hazır. Başlayalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310604
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310604,
					"content": "Olta derinliği iyi... Akıntı hızı makul...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310605
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310605,
					"content": "Sessiz olmalısın. Balıklar çok hassastır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310606
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310606,
					"content": "Kıyıdaki ayak sesleri bile onları ürkütebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310607,
						230310608
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310607,
					"content": "Hareketsiz duruyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310609
					]
				},
				{
					"id": 230310609,
					"content": "O zaman sabırlı olun ve bekleyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310610
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310610,
					"content": "Kayvan sırılsıklam bir paket yakalar.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230310611
					]
				},
				{
					"id": 230310611,
					"content": "Bu da ne? Bu balık değil ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230310612,
					"content": "Daha önce hiç böyle bir \"balık\" görmedim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230310613
					]
				},
				{
					"id": 230310613,
					"content": "Demek yine böyle oldu. Tam da beklediğim gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310614
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310614,
					"content": "Merak etme yabancı, sakin ol. Detaylara fazla takılma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310615
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310615,
					"content": "Oltaya takılan her şey \"balık\" sayılır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310616
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310616,
					"content": "Sana şu kadarını söyleyeyim, \"en iyi oltacı\" unvanını almamın bir sebebi var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310617
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310617,
					"content": "Sonuçta sürekli yem yutamayacak cansız şeyler yakalamak da özel bir yetenek, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310618
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310618,
					"content": "Diğer balıkçılar benim eşsiz hünerlerimden her zaman övgüyle bahseder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230310619,
						230310620
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230310619,
