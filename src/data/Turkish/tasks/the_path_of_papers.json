			"dialogs": [
				{
					"id": 731053001,
					"content": "Umarım iyisindir Alrani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053002,
						731053005
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731053002,
					"content": "Alrani Akademide nasıldı peki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731053003
					]
				},
				{
					"id": 731053003,
					"content": "Oldukça gayretli bir çocuktu ama ne yazık ki hep tuhaf açmazların peşinde koşardı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053004
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731053004,
					"content": "Kesinlikle nitelikli bir öğrenci ve bence kesinlikle çok iyi bir araştırmacı olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731053005,
					"content": "Öğrenci makalelerinin Akademide kabul alması zor mudur?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731053006
					]
				},
				{
					"id": 731053006,
					"content": "Doğrusunu söylemek gerekirse evet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053007
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731053007,
					"content": "Makale incelemesi karmaşıktır. Araştırmanın ana konusunu, atıflarının ne kadar kapsamlı olduğunu dikkate almalısın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053008
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731053008,
					"content": "Ayrıca başka makalelerle ve kendi çalışmanla olabilecek çakışma ya da çatışmaları da hesaba katmalısın. Tez önerin sunulduktan sonra yine çeşitli zorluklar seni bekler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053009
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731053009,
					"content": "*iç çeker* Ama itiraf etmeliyim ki o son derece şanssız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Niloofar"
				}
			]
		},
