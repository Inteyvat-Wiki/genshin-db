			"dialogs": [
				{
					"id": 731053101,
					"content": "Başka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053102,
						731053108
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731053102,
					"content": "Neden bu kadar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731053103
					]
				},
				{
					"id": 731053103,
					"content": "Alrani'ye karşı \"iyi\" mi davranıyorum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053104
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731053104,
					"content": "Beni yanlış anlamayın. Bunu üç basit nedenden ötürü yapıyorum. Birincisi Alrani burada kalmak için bana ödeme yaptı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053105
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731053105,
					"content": "İkincisi ben para alırım, can değil. Onu ormanda öylece bıraksaydım itibarım zedelenirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053106
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731053106,
					"content": "Üçüncüsü, kendisi parlak bir geleceğe sahip eğitimli bir hanım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053107
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731053107,
					"content": "Ona yardımcı olabilmek, biz Hazine Avcılarına biraz iyi şöhret kazandırır bence, ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731053108,
					"content": "Ne kadar ödeme yaptı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731053109
					]
				},
				{
					"id": 731053109,
					"content": "Az bir miktar değil. Bir tür \"gübre\" geliştirerek kazanmış o parayı da. Neden bahsettiği hakkında hiçbir fikrim yok. Umurumda da değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053110
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731053110,
					"content": "Her neyse, bize ödeme yaptı ve şu an için ona yardımcı olacağız. Durum bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Narzam"
				}
			]
