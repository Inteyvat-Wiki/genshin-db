			},
			"dialogs": [
				{
					"id": 731050101,
					"content": "Alrani, nereye gittin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050102
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050102,
					"content": "Alrani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050103
					]
				},
				{
					"id": 731050103,
					"content": "Hımm, Paimon bu ismi hatırlıyor... Sürekli tezini yazan genç hanım mıydı? Watatsumi Adası'nda tanışmıştık hani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050104,
					"content": "Evet, Akademiden bazı malzemeler için ayrıldığını söylemişti. Şimdiye geri dönmüş olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050105,
					"content": "Fakat oradaki kadın gerçekten gergin görünüyor... Hadi gidip soralım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050106,
					"content": "Alrani Akademiye geri döndüyse uğrayıp selam verebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050107,
					"content": "Selamlar. Alrani hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050108
					]
				},
				{
					"id": 731050108,
					"content": "Sizler Maceracılar Loncasının gönderdiği Maceracılar mısınız? Alrani'yi buldunuz mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050109
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050109,
					"content": "Sıkboğaz ettiğimin farkındayım, özür dilerim. Fakat Alrani için çok endişeleniyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050110
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050110,
					"content": "Tamam, sakin ol biraz. Maceracılar Loncasından değiliz. Sadece geçiyorduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050111,
					"content": "Peki ya siz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050112
					]
				},
				{
					"id": 731050112,
					"content": "Maceracı değil misiniz? Çok özür dilerim. Onlardan hiç haber alamadım. O kadar endişeliyim ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050149
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050149,
					"content": "Alrani ile başınızdan geçenleri anlat...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731050113
					]
				},
				{
					"id": 731050113,
					"content": "Alrani'nin sürekli bahsettiği Gezgin sensin demek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050114
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050114,
					"content": "Ben Niloofar, Akademide araştırmacıyım... Belli oluyordur herhalde, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050115
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050115,
					"content": "Araştırmacı olsam da artık enerjimin büyük bir bölümünü öğrencilerime araştırma yapmayı öğretmeye harcıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050116
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050116,
					"content": "Alrani benim öğrencim. Tezini yazmakta zorlanıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050117
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050117,
					"content": "Sen... Onun akıl hocası mısın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050118
					]
				},
				{
					"id": 731050118,
					"content": "Bayan Alrani'nin dediğine göre akıl hocası onaylamadığı için makalelerinin çoğunu yeniden yazmak zorunda kalmış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050119,
					"content": "Ah, bunun yeri ve zamanı değil şimdi. Bayan Alrani'ye ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050120,
					"content": "Alrani... Kayboldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050121
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050121,
					"content": "Alrani, bir süre önce Inazuma'dan elinde makalesiyle büyük bir heyecanla dönmüştü. Makalesi de Watatsumi Adası'ndaki yerel kültürle alakalıydı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050122,
						731050123
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050122,
					"content": "İşini oldukça ciddiye alıyordu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050124
					]
				},
				{
					"id": 731050124,
					"content": "Belli oluyordu zaten. Makale çok güzel yazılmıştı ve her açıdan üst kalitedeydi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050125
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050125,
					"content": "Ne yazık ki makalesini çok geç teslim etti! Öncesinde taslak metnini bana göndermesini istemiştim ama geri dönüş alamadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050126
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050126,
					"content": "Makalesinin tamamlayarak geldiğinde ise başkası halihazırda ön incelemeden geçmiş, tamamen aynı konudaki bir makaleyi çoktan teslim etmişti bile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050127
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050127,
					"content": "İncelemeyi geçebilmesi için elimden gelen her yolu denedim ama yine de olmadı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050128
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050128,
					"content": "Neden ki? Bayan Alrani makalesi için yazacaklarını çok uzun süre önceden hazırlamıştı. Neden bu kadar uzun sürsün ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050129,
					"content": "Bir saniye... Inazuma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050130,
					"content": "Sakoku Fermanı!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050131
					]
				},
				{
					"id": 731050131,
					"content": "Hayır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050132,
					"content": "Bunu ona nasıl anlatacağımı bilemedim... Alrani'yi daha az üzecek bir yol bulmaya çalışıyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050133
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050133,
					"content": "Sonra boşboğazın biri ona her şeyi anlatıvermiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050134
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050134,
					"content": "Ardından Alrani de ortadan kayboldu. Akademide her yere baktım ama yoktu. Sonra da Maceracılar Loncasına giderek bir özel görev başlatmalarını istedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050135
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050135,
					"content": "Alrani'nin defterinden başka bir şey bulamadılar, ona dair hiçbir iz yoktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050136
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050136,
					"content": "Maceracılar hâlâ her yerde onu arıyor olmalı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050137
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050137,
					"content": "Ben... Ne yapacağımı bilmiyorum hiç... *ağlar*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050138,
						731050140
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050138,
					"content": "Alrani'yi bulmaya yardımcı olurum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050139
					]
				},
				{
					"id": 731050139,
					"content": "Doğru! Defteri buldukları yerden aramaya başlarız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050142,
					"content": "Gerçekten mi? Ne kadar teşekkür etsem az!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050143
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050143,
					"content": "Defterin bulunduğu yeri haritada işaretleyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050144
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050144,
					"content": "Şey, ödeme için size...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050145,
						731050146
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050145,
					"content": "Onu daha sonra konuşuruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050147
					]
				},
				{
					"id": 731050147,
					"content": "Çok teşekkürler. Burada Maceracılar Loncasından gelecek haberleri bekliyor olacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050148
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050148,
					"content": "Umarım iyisindir Alrani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050146,
					"content": "Onu Alrani'den isterim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050147
					]
				},
				{
					"id": 731050140,
					"content": "Nerede buldular defteri?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050141
					]
				},
				{
					"id": 731050141,
					"content": "Bayan Alrani'nin bulunmasına yardımcı oluruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050123,
					"content": "Üzerinde çok sıkı çalışıyordu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050124
					]
				}
			]
		},
		{
			"id": 7310505,
