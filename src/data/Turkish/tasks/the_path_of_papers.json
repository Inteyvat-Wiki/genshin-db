			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gobley",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731050501,
					"content": "Lütfen merhamet edin! Hepsi bir yanlış anlaşılmadan ibaret!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050502,
						731050505
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050502,
					"content": "Hiç sanmıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050503
					]
				},
				{
					"id": 731050503,
					"content": "Bayan Alrani'ye ne yaptınız? Çıkar ağzındaki baklayı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050504,
					"content": "Yoksa... Yoksa seni bir güzel pataklarız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050507,
					"content": "Yo, hayır, lütfen... Lütfen dinleyin. Hepsini yanlış anladınız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050508
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050508,
					"content": "O kadınla uğraşır mıyız hiç! Gücümüz ona yeter mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050509,
						731050510
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050509,
					"content": "Nasıl yani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050511
					]
				},
				{
					"id": 731050511,
					"content": "Uzun hikaye...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050512
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050512,
					"content": "Bir süre önce neredeyse hiç paramız kalmamıştı, sonra ablamı da yanımıza alıp cüzdanımızı dolduracak bir şeyler yapalım dedik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050513
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050513,
					"content": "Öff, hırsızlık yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050514,
					"content": "Şey... Biz Hazine Avcılarıyız... Bu da bizim işimiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050515
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050515,
					"content": "Kampta planlar yaparken, kampa doğru gelen ve kocaman bir çantası olan genç bir hanım gördük.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050516
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050516,
					"content": "Kendinde değil gibi görünüyordu. Hepimizi korkuttu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050517
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050517,
					"content": "Daha biz herhangi bir hamle yapamadan kendisi gelip kamp ateşinin yanına oturuverdi, bir yandan ağlıyor bir yandan da kitaplarını ateşe atıyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050518
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050518,
					"content": "Gerçekten tüyler ürpertici bir sahneydi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050519,
						731050520
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050519,
					"content": "Genç bir hanımdan korkmak...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050521
					]
				},
				{
					"id": 731050521,
					"content": "Öyleyiz tabii ama insan falan öldürmeyiz. Sadece çalıp çırparız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050522
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050522,
					"content": "Neler olup bittiğini anlamadan bizi şaşkına çevirdi. Bir kese dolusu Mora fırlatıp bizden kendisini kilitlememizi istedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050523
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050523,
					"content": "Nasıl yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050524,
						731050525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050524,
					"content": "Bu anlattığın şey çok saçma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050526
					]
				},
				{
					"id": 731050526,
					"content": "İlk başta kimse ona dokunmaya cesaret edemedi... Fakat yemeden içmeden sürekli bizden kendisini kilitlememizi isteyip durdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050527
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050527,
					"content": "En sonunda, ablam dallardan bir kafes yapmamızı ve onu içine koymamızı istedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050528,
						731050529
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050528,
					"content": "Ablanız düşünceliymiş...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050530
					]
				},
				{
					"id": 731050530,
					"content": "Ablam eğitimli insanlara hep saygı duymuştur. Günün birinde okula gitmek istediğini söylüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050531
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050531,
					"content": "Öhöm... Kendisi şu tarafta, inanmıyorsan gidip bak. Muhtemelen ablam da şu an onu sakinleştirmeye çalışıyordur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050532
					],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050532,
					"content": "Teyzeyi alıp buradan gidersen sana karşılığını seve seve veririz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gobley"
				},
				{
					"id": 731050529,
					"content": "Aslında ona iyilik yapmaya çalışıyormuşsunuz...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050530
					]
				},
				{
					"id": 731050525,
					"content": "Siz de istediğini yaptınız mı yani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050526
					]
				},
				{
					"id": 731050520,
					"content": "Sizler Hazine Avcıları değil misiniz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050521
					]
				},
				{
					"id": 731050510,
					"content": "O zaman Alrani sizinleydi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050511
					]
				},
				{
					"id": 731050505,
					"content": "Alrani'ye ne yaptın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050506
					]
				},
				{
					"id": 731050506,
					"content": "Bize bildiklerini anlat! Yoksa... Yoksa seni bir güzel pataklarız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050507
					],
					"speakerTitle": "Paimon"
				}
			]
		},
