					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050805,
					"content": "Şahsen değil ama ondan tuhaf bir Hazine Avcısı olarak bahsedildiğini duydum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050806
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050806,
					"content": "Denilene göre soyduğu kurbanlarına sorular sorarmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050807
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050807,
					"content": "Edebiyat, Elementler, her türlü konudan. Hatta zeka soruları bile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050808
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050808,
					"content": "Sorusunu doğru cevaplayabilirsen çaldığı her şeyi geri verip şehre kadar sana eşlik edermiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050809
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050809,
					"content": "Desene çatlağın tekiymiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050810,
						731050811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050810,
					"content": "Ne şimdi bu? Bilmececi bir hırsız mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050812
					]
				},
				{
					"id": 731050812,
					"content": "Kimse bilmiyor. Bunları da ormanda onunla karşılaşan danışmanım sayesinde öğrendim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050813
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050813,
					"content": "Ona da \"Boş bir odayı en hızlı ne doldurur?\" diye sormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050814
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050814,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050815,
					"content": "Rüzgar! Paimon doğru bildi mi? Cevap rüzgar olmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050816,
					"content": "Peki... Mum ışığı mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050817
					]
				},
				{
					"id": 731050817,
					"content": "Danışmanım \"Elementler her yerdedir.\" diye cevap vermiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050818
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050818,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050819
					]
				},
				{
					"id": 731050819,
					"content": "Hile ama bu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050820
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050820,
					"content": "Haha. Her neyse, Narzam şehre kadar danışmanıma eşlik etmiş ve görgü kuralları çerçevesinde vedalaşmışlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050821
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050821,
					"content": "Alrani onunlaysa o kadar endişelenmezdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050822
					],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050822,
					"content": "Ama sonsuza dek orada kalamaz. Makalesi için ona yardımcı olmanın bir yolunu bulmalıyız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Niloofar"
				},
				{
					"id": 731050811,
					"content": "Tam olarak neyin peşinde acaba?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050812
					]
				}
			]
		},
