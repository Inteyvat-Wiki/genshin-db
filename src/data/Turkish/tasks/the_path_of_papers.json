			},
			"dialogs": [
				{
					"id": 731050701,
					"content": "Alrani! Kafesten çıkacak mısın, çıkmayacak mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050702
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050702,
					"content": "Hayır! Araştırmalara da akademiye de veda ettim artık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050703
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050703,
					"content": "Bunun için size para verdim. Beni rahat bırakın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050704
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050704,
					"content": "İnatçısın, sinir bozucu derece inatçısın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050705,
						731050706
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050705,
					"content": "Öhöm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050707
					]
				},
				{
					"id": 731050707,
					"content": "Me-merhaba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050708,
					"content": "Ne? Ah, sen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050709
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050709,
					"content": "Ge-Gezgin! *ağlar*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050710
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050710,
					"content": "Bayan Alrani, gerçekten de buradaymışsın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050711,
						731050712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050711,
					"content": "İyi olduğunu görünce rahatladık.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050713
					]
				},
				{
					"id": 731050713,
					"content": "*ağlar*... O konuyu ilk ben kaleme aldım! Bu hiç adil değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050714
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050714,
					"content": "Inazuma'da çok uzun kalmasaydım makalem kabul alacaktı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050715
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050715,
					"content": "Sakin ol biraz... Hâlâ makaleni bitirmeyi istiyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050716,
					"content": "*nefes nefese kalır*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050717
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050717,
					"content": "Ben... O işi bıraktım! Makaleler, Akademi... Hepsinden bıktım! Makale yazmak budalalık! Akademinin canı cehenneme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050718
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050718,
					"content": "Narzam'a beni koruması için para verdim. Kimse beni o makaleyi yazmam için zorlayamaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050719
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050719,
					"content": "Hıh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050720
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050720,
					"content": "Sen kimsin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050721
					]
				},
				{
					"id": 731050721,
					"content": "Adım Narzam. İşim... Şey, biliyor olmalısın. Lafı uzatmayayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050722
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050722,
					"content": "Seni tanıyorum Gezgin. Son zamanlarda buralarda epey adını duyduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050723
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050723,
					"content": "Kızı geri götürmek için özel görevdeysen deneyebilirsin. Seni durduracak değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050724
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050724,
					"content": "Hey! Sana para ödedim ben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050725
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050725,
					"content": "Ne için? Birkaç günden sonra yemek paramızı bile ödemeye yetmeyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050726
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050726,
					"content": "Neyse, geri dönmeyeceğim. Beni orada bekleyen tek şey yeni konular ve saha araştırmaları. Gecem gündüzüm sıkıntılarla geçecek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050727
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050727,
					"content": "Hatta garip tipler tarafından kaçırılabilir veya tuhaf canavarlarla karşılaşabilirim. Sonra makalemi tamamlamaya vaktim kalmaz ve yine... Makale savunmamı kaçırırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050728
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050728,
					"content": "*ağlar*... Hayır... Burada kilitli kalırım daha iyi. *ağlar*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050729
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050729,
					"content": "Gezgin, lütfen mesajımı Bayan Niloofar'a iletir misin? Sana bir not vereceğim. Geri dönmek istemiyorum, yalvarırım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050738
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050738,
					"content": "Alrani hıçkırarak notunu yazar...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731050730
					]
				},
				{
					"id": 731050730,
					"content": "İşte... *ağlar*... Makale denen şeyi de kim icat etmiş ki? *ağlar*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050731
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 731050731,
					"content": "Tamam... Sakin ol. Şimdilik kimse seni bir yere götürmüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050732
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050732,
					"content": "Bayan Alrani'nin... Şu anda ruh hali biraz dengesiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050733
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050733,
					"content": "Biz bu notu Niloofar'a iletirken biraz daha kalmasına izin verin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050734,
						731050735
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731050734,
					"content": "Ama...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050736
					]
				},
				{
					"id": 731050736,
					"content": "Ona zarar vermemizden endişelenmenize gerek yok. Aynen söylediği gibi, ödemesini yaptı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050737
					],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050737,
					"content": "Ayrıca... Nihayet epey bilgili birine denk geldim. Burada işimize yarayacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Narzam"
				},
				{
					"id": 731050735,
					"content": "Hazine Avcıları...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050736
					]
				},
				{
					"id": 731050712,
					"content": "Niloofar bize makalenden bahsetti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050713
					]
				},
				{
					"id": 731050706,
					"content": "Pardon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050707
					]
				}
			]
		},
