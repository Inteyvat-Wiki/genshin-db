			"dialogs": [
				{
					"id": 401450201,
					"content": "#{NICKNAME}! Paimon! Merhaba! Yardımcı olabileceğim bir konu var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450202
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401450202,
					"content": "Son zamanlarda işler fazla yoğunlaştı, Lisa da bu yüzden verimliliğimizi artırmak için bazı yollar bulmamızı tavsiye etti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450203,
					"content": "Aa, evet! Kendisiyle ben de konuştum bu konuyu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450204
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401450204,
					"content": "Şu anda kendinizi geliştirebileceğiniz üç nokta var. İksir yapımı, bitki yetiştirme ve satış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450205
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401450205,
					"content": "Bu alanlarda veriminizi artırdığınızda dükkanı yürütmeniz çok daha kolaylaşacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450206
					],
					"speakerTitle": "Freda"
				},
				{
					"id": 401450206,
					"content": "#Vay, gerçekten tam da ihtiyacımız olan şey bu! Hadi bir deneyelim {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450207,
						401450209,
						401450211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450207,
					"content": "İşletme verimliliğini artırmak...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450208
					]
				},
				{
					"id": 401450208,
					"content": "Görünüşe göre bu geliştirme için gereken tüm hazırlıklar tamam. Lütfen deneyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freda"
				},
				{
					"id": 401450209,
					"content": "Malzeme alımı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450210
					]
				},
				{
					"id": 401450210,
					"content": "Şanslısınız! Daha yeni bir parti gelmişti! Lütfen işinize yarar bir şey var mı bir bakın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freda"
				},
				{
					"id": 401450211,
					"content": "Hoşça kal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450212
					]
				},
				{
					"id": 401450212,
					"content": "İşinizde bol şans diliyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freda"
				}
			]
		}
	]
