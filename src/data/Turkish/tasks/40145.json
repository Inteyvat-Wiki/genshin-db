			"dialogs": [
				{
					"id": 401450101,
					"content": "Kısa bir deneme sürecinin ardından iksir dükkanı büyük bir başarıyla açılır...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401450102
					]
				},
				{
					"id": 401450102,
					"content": "*iç çeker* Gittikçe daha fazla müşteri geliyor. O kadar uzun zamandır ara vermeden çalışıyoruz ki Paimon'un başı dönmeye başladı artık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450103,
						401450104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450103,
					"content": "İşler cidden yolunda...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450105
					]
				},
				{
					"id": 401450105,
					"content": "Bir sürü sipariş var. Paimon bunların hepsini kendi başımıza halledebilir miyiz bilmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450106,
					"content": "Belki de dükkana yardımcı almalıyız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450107,
					"content": "Dinleniyor musunuz canlarım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450108
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450108,
					"content": "Az önce satış verilerine baktım da ticaret konusunda gerçekten yeteneklisiniz. İksirler resmen kapış kapış gidiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450109
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450109,
					"content": "Aa, Lisa! Tam zamanında geldin! Biz de dükkanda bize yardım eden biri olsa ne iyi olur diyorduk tam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450110,
					"content": "Hı? Şimdiden siparişler yığılmaya mı başladı yoksa? Yetişemiyor musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450111
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450111,
					"content": "Evet, boğazımıza kadar siparişe battık resmen! Paimon hiç bu kadar müşterimiz olacağını düşünmemişti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450112,
					"content": "Bu başarıya şaşırdığımı söyleyemem. Aslında tam olarak böyle bir sonuç bekliyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450113
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450113,
					"content": "Siz dükkanla ilgilenirken ben de Freda ile işi nasıl daha verimli hale getirebiliriz diye konuştum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450114
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450114,
					"content": "Çalışmanızı gözlemledikten sonra iksir hazırlama, bitki yetiştirme ve satış süreçlerinde geliştirilmesi gereken bazı noktalar olduğunu fark ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450115
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450115,
					"content": "Bir dakika, yani sen bunca zamandır perde arkasında bunlarla mı uğraşıyordun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450116,
					"content": "Paimon da senin işten kaytardığını düşünmüştü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450117,
					"content": "Aşk olsun, iş ciddiye bindiğinde gayet güvenilir biriyimdir ben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450118
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450118,
					"content": "Peki bu bahsettiğin geliştirmeleri nasıl hayata geçireceğiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401450119,
					"content": "Bu konuyu Freda ile düşündük ve birlikte bir plan hazırladık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401450120
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450120,
					"content": "O size detayları anlatacak. Gidip kendisiyle bir konuşun bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401450104,
					"content": "İsmimizi iyi duyurduk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401450105
					]
				}
			]
		},
