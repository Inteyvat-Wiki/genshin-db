			"dialogs": [
				{
					"id": 752580101,
					"content": "Hı? Neden burada bayılmış biri var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752580102,
					"content": "Heeey! Paimon'u duyabiliyor musun? İyi misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752580103,
					"content": "Adamın kalkmasına yardım ediyorsunuz. Yavaşça bilinci yerine geliyor...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752580104
					]
				},
				{
					"id": 752580104,
					"content": "Ay ay ay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580105,
						752580106
					],
					"speakerTitle": "Baygın Personel"
				},
				{
					"id": 752580105,
					"content": "Selam. Çok mu içtin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752580107
					]
				},
				{
					"id": 752580107,
					"content": "Kafam acıyor... Ben nasıl... Bir düşüneyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580108
					],
					"speakerTitle": "Baygın Personel"
				},
				{
					"id": 752580108,
					"content": "Hah! Hatırladım! Sanırım beni biri bayılttı... Ama kim olduğunu göremedim. Bir dakika... Siz bayıltmadınız, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580109
					],
					"speakerTitle": "Baygın Personel"
				},
				{
					"id": 752580109,
					"content": "Yok artık! Sana biz yardımcı olduk! Bize teşekkür etmen gerek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752580110,
					"content": "Ah, affedersiniz... Mey ve Ben barında çalışıyorum. Kuzeydeki limana teslimat için gidiyordum... Nod-Krailı bir tüccar birliği bizden Bal Şarabı almıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580111
					],
					"speakerTitle": "Baygın Personel"
				},
				{
					"id": 752580111,
					"content": "Olamaz! Bal Şarabı gitmiş! Çaldılar mı? Dur biraz, sen çalmadın değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580112
					],
					"speakerTitle": "Baygın Personel"
				},
				{
					"id": 752580112,
					"content": "Nedir bu bizi suçlama sevdası?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752580113,
					"content": "Ah, haklısın. Affedersin... Başım döndüğünden olsa gerek. Size teşekkür ederim. Bara geri dönüp olanları anlatmam lazım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580114
					],
					"speakerTitle": "Baygın Personel"
				},
				{
					"id": 752580114,
					"content": "Eğer gerçekten burada haydutlar geziyorsa siz de kuzey limanından uzak durmalısınız. Tehlikeli olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Baygın Personel"
				},
				{
					"id": 752580106,
					"content": "Seni eve götürmemi ister misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752580107
					]
				}
			]
		}
	]
}