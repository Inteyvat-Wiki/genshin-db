			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205050201,
					"content": "İstediğin zaman birini keşfe çıkarabilirsin, keşfe çıkanlar onlara ihtiyaç duyduğunda maceralarına hâlâ katılabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050202
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050202,
					"content": "Ayrıca keşfin süresini seçebilirsin. Arkadaşların geri döndüğünde buraya gelip keşiften toplananları onaylaman yeterli olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050203
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050203,
					"content": "Macera Rütben yükseldikçe daha tehlikeli keşiflere katılabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050204
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050204,
					"content": "Sonuçta efsanevi güç efsanevi sorumluluk gerektirir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205050205,
					"content": "Tabii ki hiç kimsenin güvenliğini ihmal etmeyiz. Herkes kendi tecrübesine göre uygun olan yere keşfe çıkabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205050206
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 205050206,
					"content": "Yardımın için tekrar teşekkürler. Umarım arkadaşlarınla keşiflerimizde bize elinizden geldiğinizce yardımcı olursunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				}
			]
		}
	]
}