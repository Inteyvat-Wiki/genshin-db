			"dialogs": [
				{
					"id": 715360101,
					"content": "#Fener Şenliğin kutlu olsun {NICKNAME}. Dehya'ya hediye zarfı yapmasında yardım ettiğini duydum. Çok güzel olmuş, teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360102
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360102,
					"content": "Köyde her şeyi rayına oturttun herhalde, ha?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715360103
					]
				},
				{
					"id": 715360103,
					"content": "Evet. Dehya ve diğer arkadaşlar sağ olsun. Ben yokken köyün güvende olduğunu bilmek içimi rahatlatıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360104
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360104,
					"content": "Bu boş vaktini değerlendirip güzelce dinlen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715360105
					]
				},
				{
					"id": 715360105,
					"content": "Öyle yapacağım. Dehya birkaç gün sonra Qiaoying Köyü'nü ziyaret etmek istiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360106
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360106,
					"content": "Manzarası güzelmiş, çayı da meşhurmuş üstelik. Dönmeden önce köydekilere hediyelik çay alırım hem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360107
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360107,
					"content": "Buranın geleneğine uygun olarak birkaç hediye zarfı yapmayı düşünüyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360108
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360108,
					"content": "Ama Dehya her günümüzü planlamış. O koşuşturma arasında vakit bulabilir miyim bilmiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360109
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360109,
					"content": "Dehya senin iyi zarf yaptığını söyledi. Bana da öğretebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715360110
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 715360110,
					"content": "Tabii ki, göstereyim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
