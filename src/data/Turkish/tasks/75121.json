			"dialogs": [
				{
					"id": 751210101,
					"content": "Biri beni birkaç kitap bulmam için yolladı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751210102
					]
				},
				{
					"id": 751210102,
					"content": "Citlali'nin istediği kitabı Kuroda'ya anlatıyorsun.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						751210103
					]
				},
				{
					"id": 751210103,
					"content": "\"Yüce Şogun: Sınırsız Bir Güçle Yeniden Doğan Raiden\"ın ilk baskısı ve \"Lütfen Kitsune Guuji!\"nin sınırlı sayıdaki özel baskısı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210104
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210104,
					"content": "Arkadaşın bu işlerden anlıyormuş doğrusu. Koleksiyon değeri açısından baktığımızda şu anda Yae Yayınevinin çıkardığı hiçbir kitap senin aradığın kitapların yakınından geçemez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210105
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210105,
					"content": "Böyle zevk sahibi bir okuru tanımıyor olmam da üzücü gerçekten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210106
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210106,
					"content": "Bu kitaplar mevcut mu hâlâ?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751210107
					]
				},
				{
					"id": 751210107,
					"content": "Bunları şu an piyasada ya da depolarda bulman mümkün değil. Hepsi çoktan satıldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210108
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210108,
					"content": "Ama ikisinden de var bende...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210109
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210109,
					"content": "Sana bunun için ödeme yapabilirim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751210110
					]
				},
				{
					"id": 751210110,
					"content": "Yok, yok. Bu kitaplar, gerçek değerini anlayacak birinin elinde olsa çok daha iyi olur zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751210111
					],
					"speakerTitle": "Kuroda"
				},
				{
					"id": 751210111,
					"content": "Bu yüzden bu kitapları sana vermekten mutluluk duyarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuroda"
				}
			]
		}
	]
