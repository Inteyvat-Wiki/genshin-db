			"dialogs": [
				{
					"id": 740120501,
					"content": "Vay canına! Çok katı biri! Paimon kesinlikle o adam için çalışmak istemiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740120502,
					"content": "\"Toplu bir onur duygusundan\" bahsedecek cüreti nereden buluyorlar? Milletin yemek yemesine bile izin vermemek onurlu bir şey mi sanki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120503,
						740120505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740120503,
					"content": "Tamamen haksız değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740120504
					]
				},
				{
					"id": 740120505,
					"content": "Ne kadar acayip bir kural...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740120506
					]
				},
				{
					"id": 740120504,
					"content": "Disiplin önemli tabii ama bu kadarı da biraz fazla değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740120506,
					"content": "Değil mi? İnsan bir işi halletmeyi ne kadar beceremiyorsa kurallar ve disiplin konularında da o kadar tuhaf oluyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740120507,
					"content": "Şöyle bir düşününce, biz de kargaşa çıkarırsak birlik lideri Shumilov'un aşağı gelmesini sağlayabiliriz değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740120508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740120508,
					"content": "#O zaman biz de yukarı çıkabiliriz... Hadi deneyelim {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
