					"nextDialogs": [
						200090704
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090704,
					"content": "Bir dağ yabanisinden bir hediye... Bugünleri göreceğini sanmıyordun, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200090705
					],
					"speakerTitle": "Ella Musk"
				},
				{
					"id": 200090705,
					"content": "Neyse ben gideyim artık. Not etmem gereken çok fazla şey öğrendim. Belki bir ara tekrar görüşme şansı buluruz.",
					"roleType": "TALK_ROLE_NPC",
