			"dialogs": [
				{
					"id": 706819905,
					"content": "Gesine hancıya menüyü sorar, ardından meşhur olduğu kadar pahalı birkaç yemek sipariş eder...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 706810801,
					"content": "Liyue mutfağının görüntü, koku ve lezzete bütüncül bir yaklaşım sergilediğini duydum! Gerçekten çok farklı görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810802
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810802,
					"content": "Bakarken bile Paimon'un ağzı sulanıyor doğrusu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810803,
					"content": "Hep birlikte Wangshu Hanındaki enfes yemeklerin tadını çıkarıyorsunuz...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706810804
					]
				},
				{
					"id": 706810804,
					"content": "Yaa, inanılmaz lezzetliymiş bu! Şu da öyle! Hatta şu da... Off, Paimon bir lokma daha yerse patlayacak artık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810805,
						706810806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810805,
					"content": "Ziyafet dediğin böyle olur işte!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810807
					]
				},
				{
					"id": 706810806,
					"content": "Tüm yorgunluğum uçtu gitti resmen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810807
					]
				},
				{
					"id": 706810807,
					"content": "Tüm yardımlarınız için çok teşekkür ederim! Siz olmasaydınız bu noktaya gelene kadar göbeğim çatlardı herhalde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810808
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810808,
					"content": "Çalışanlardan birinin söylediğine göre bu yol <color=#00E1FFFF>Liyue Limanı'na</color> çıkıyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810809
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810809,
					"content": "Birkaç gün daha buralarda kalıp büyük ustaların nerede olduğunu öğrenmeyi planlıyorum. Sonra da nereye gideceğime karar veririm artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810810
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810810,
					"content": "Birlikte yolculuk etmekten büyük keyif aldım ama size de daha fazla yük olmak istemiyorum hiç.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810811
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810811,
					"content": "Yoluma devam edip gücüme güç katmam lazım. Güçlenmeliyim ki ben de saygın bir Maceracı olabileyim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810812
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810812,
					"content": "Hehe, çok fazla vakit geçiremedik aslında ama biz de çok eğlendik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810813,
					"content": "İleride tekrar karşılaşmak dileğiyle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810814,
						706810815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810814,
					"content": "Tekrar görüşmek üzere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810816
					]
				},
				{
					"id": 706810815,
					"content": "Umarım aradığını bulursun!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810816
					]
				},
				{
					"id": 706810816,
					"content": "Evet! Umarım siz de bulursunuz, yolunuz açık olsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810817
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810817,
					"content": "Gesine arkanızdan el sallar.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706810818
					]
				},
				{
					"id": 706810818,
					"content": "Eh, hazır buraya kadar gelmişken etrafta biraz dolaşsak mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810819,
					"content": "Yolda daha neler neler göreceğiz kim bilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810820
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810820,
					"content": "Gesine, <color=#00E1FFFF>Liyue Limanı'nın</color> hemen ileride olduğunu söylemişti. Vaktimiz olduğunda biz de gidip bir göz atalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
