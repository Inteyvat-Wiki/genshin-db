				"points": []
			},
			"dialogs": [
				{
					"id": 706810701,
					"content": "Birlikte çekildiğimiz bu fotoğrafı sonsuza kadar saklayacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810702
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810702,
					"content": "Off! Şimdi azıcık rahatlayınca fark ettim de açlıktan midem kazınıyor benim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810703
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810703,
					"content": "Sen öyle deyince Paimon'un da karnı guruldamaya başladı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810704,
						706810705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810704,
					"content": "Hadi dinlenecek bir yer bulalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810708
					]
				},
				{
					"id": 706810708,
					"content": "En iyisi biraz dolaşıp yemek yiyecek bir yer bulalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810709,
					"content": "Buralarda bize uygun bir restoran yok galiba... Sizin gibi kıymetli kişilere derme çatma bir yerde yemek yedirmeye de gönlüm elvermez şimdi, bana o kadar yardımınız dokundu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810710
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810710,
					"content": "Yemek demişken... Şu ilerideki devasa kayanın üzerinde duran bina acaba meşhur <color=#00E1FFFF>Wangshu Hanı</color> olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810711
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810711,
					"content": "Mondstadt'ta çalışan Liyueli bir tüccar bana oranın yemeklerini öve öve bitirememişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810712
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810712,
					"content": "İzin verin de size bir ziyafet ısmarlayarak teşekkür edeyim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810713
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810713,
					"content": "Oley! Hadi gidip yemek yiyelim o zaman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810705,
					"content": "Durma öyle Paimon, ateş yak da pişir yemekleri!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810706
					]
				},
				{
					"id": 706810706,
					"content": "Ayıp ama! Olmaz öyle Paimon aşağı, Paimon yukarı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810707,
					"content": "Hem Paimon'un yaptığı yemeklerin tadını bilmiyorsun sanki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810708
					],
					"speakerTitle": "Paimon"
				}
			]
		},
