				]
			},
			"dialogs": [
				{
					"id": 706810401,
					"content": "Çok pardon, bir dakika burada bekler misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810402
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810402,
					"content": "Ne oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810403
					]
				},
				{
					"id": 706810403,
					"content": "Bir şey mi unuttun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810404,
					"content": "Hayır, unutmadım. Ama şimdi haritaya bakıyorum da... Daha fazla ilerlersek Mondstadt'tan çıkacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810405
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810405,
					"content": "Ne zaman döneceğim de belli değil... Hocam bıraktığım notu görünce küplere binecek, küplere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810406,
						706810407
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810406,
					"content": "Şu hocandan daha önce de bahsetmiştin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810408
					]
				},
				{
					"id": 706810408,
					"content": "Evet... Henüz çiçeği burnunda bir Maceracıyken vahşi doğada birkaç Dağ Azmanıyla karşılaşmış. Sonra da tam onlarla dövüşürken bir anlık dikkatsizlikle balta darbesini yiyip yere yığılıvermiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810409
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810409,
					"content": "Neyse ki yoldan geçen bir Şövalye onu görmüş de kurtarıp şehre geri götürmüş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810410
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810410,
					"content": "Hocam bu olay yüzünden öyle utanmış, öyle mahcup olmuş ki tekrar maceraya atılmadan önce canını dişine takıp dövüş becerilerini geliştirmeye karar vermiş. Yaklaşık on yıldır bu şekilde idman yapıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810411
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810411,
					"content": "Kendisi sürekli temel becerilerin öneminden bahsediyor ama her gün o tahta hedeflerle boğuşmaktan canıma tak etti artık benim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810412
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810412,
					"content": "O yüzden ona haber vermeden tek başıma çekip gittim işte, ne yapayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810413,
						706810414
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810413,
					"content": "Güçlendikten sonra geri dönersin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810415
					]
				},
				{
					"id": 706810415,
					"content": "Evet! Ben de öyle yapayım diyordum zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810416
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810416,
					"content": "Hah, aklıma bir fikir geldi şimdi bak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810417
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810417,
					"content": "Gesine, cebinden birkaç Karahindiba Tohumu çıkarır ve avucunda tutar. Tohumlara bir şeyler mırıldandıktan sonra onları rüzgara doğru savurur...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706810418
					]
				},
				{
					"id": 706810418,
					"content": "Bizim buralarda Karahindibaların dilekleri taşıyıp götürdüğü söylenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810419
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810419,
					"content": "Ben de yolculuğum sırasında her şeyin yolunda gitmesini, hedeflerime ulaşabilmeyi ve hocamın beni anlamasını diledim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810420
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810420,
					"content": "Rüzgar Hükümdarı dileklerine kulak vermiştir eminim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810421
					]
				},
				{
					"id": 706810421,
					"content": "Bence de! Hadi bakalım, ilerlemeye devam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810414,
					"content": "Onu gururlandıracak bir şeyler yap madem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810415
					]
				},
				{
					"id": 706810407,
					"content": "Hocan da Maceracı mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810408
					]
				}
			]
		},
