			"dialogs": [
				{
					"id": 706810301,
					"content": "Oh be... Sonunda kurtuldum. Çok teşekkür ederim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810302
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810302,
					"content": "Adım Gesine. Gördüğünüz üzere bir Maceracıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810303
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810303,
					"content": "Senin kadar becerikli bir kişinin sıradan biri olmasına imkan yok bence! İyi kalpli bir şövalye misin bakayım? Yoksa bu toprakları karış karış gezen maceraperest bir kahraman mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810304,
						706810305
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810304,
					"content": "Ben bir gezginim, öylesine geçiyordum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810309
					]
				},
				{
					"id": 706810309,
					"content": "#Paimon'un adı Paimon. Bu da {NICKNAME}, kendisi Maceracılar Loncasının bir üyesidir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810310,
					"content": "Demek bir maceracısın gerçekten! Oldukça tecrübelisin de üstelik, o güçlü canavarları hiç ter dökmeden dize getirdiğine göre... Ne güçlü kişiler var gerçekten şu dünyada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810311
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810311,
					"content": "Bir de benim halime bak... İdman sırasında ne yapmam gerektiğini hatırlıyorum ama iş uygulamaya gelince bedenim beni dinlemiyor işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810312
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810312,
					"content": "Ya hocam haklıysa? Ya cidden üç beş yıl daha idmana devam etmem gerekiyorsa? Oraya böyle elim boş dönersem rezil olurum ben, rezil... *ağlar*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810313
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810313,
					"content": "Yaa, öyle deme ama! Biz daha tecrübeliyiz, seninle aramızdaki farkın nedeni o. Böyle güçlü olalım diye ne çok savaştık, bir bilsen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810314,
						706810318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810314,
					"content": "Öncelikle sakin kalmayı öğrenmelisin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810315
					]
				},
				{
					"id": 706810315,
					"content": "Evet! Acemiler genelde gerçek bir dövüş sırasında paniğe kapılıyor. O yüzden de normalden çok daha kötü bir performans sergiliyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810316,
					"content": "Düşman ne kadar güçlü görünürse görünsün soğukkanlı kalmalı ve onu gözlemleyerek zayıf noktasını bulmalısın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810317,
					"content": "Ardından da bildiğimiz bam güm döveceksin işte! Bitti gitti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810320,
					"content": "Anladım... İşte tecrübe dediğin böyle bir şey demek ki! Bu yolculuk boyunca benim de canla başla hünerlerimi geliştirmem lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810321
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810321,
					"content": "Sen de mi yolculuk yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810322
					]
				},
				{
					"id": 706810322,
					"content": "Evet... <color=#00E1FFFF>Liyue'ye</color> gitmeyi planlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810323
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810323,
					"content": "Liyue'nin dövüş sanatlarını hiç duymuş muydunuz? Orada bir çatıdan diğerine hoplayıp duvarlara tırmanıyorlarmış. Derileri artık öyle sertmiş ki hiçbir silah işlemiyormuş... Demiri bile çubuk gibi ortadan ikiye bölebiliyorlarmış hatta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810324
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810324,
					"content": "Bana birkaç numara öğretebilecek bir usta bulursam atıldığım bu macera benim için çok daha kolay olacak, eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810325
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810325,
					"content": "Yine de dürüst olacağım, Maceracılar Loncasına uzun zamandır üye olsam da ilk kez böyle uzun bir yolculuğa çıkıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810326
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810326,
					"content": "*iç çeker* Şehirden dışarı adımımı attığım anda bir baktım ki canavarlar yolumu kesmiş bile. Liyue'ye tek parça halinde ulaşabilecek miyim, bilmiyorum artık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810327,
						706810328
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810327,
					"content": "Biz de Liyue'ye gidiyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810329
					]
				},
				{
					"id": 706810329,
					"content": "Gerçekten mi? En deneyimli kişilerin bile dövüş ustalarına ihtiyacı oluyormuş demek ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810330
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810330,
					"content": "Yok, o yüzden değil! Şey... Bazı sebeplerden dolayı Teyvat'ın tüm uluslarını dolaşıyoruz diyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810331,
					"content": "Liyue'yi o kadar da iyi bilmiyoruz ama zaten bir noktada ziyarete gitmeyi planlıyorduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810332,
					"content": "Madem aynı yöne gidiyoruz, birbirimizi kollayalım işte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810333,
					"content": "Vay be! Bu denli başarılı bir maceracıyla birlikte çalışacağım günler de gelecekmiş meğer... Bu yolculuk umutsuz bir vaka değildir belki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810334
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810334,
					"content": "O halde önden ben gideyim. Yola çıkmadan önce haritayı dikkatlice incelemiştim, kaybolmam imkansız yani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810328,
					"content": "Bize katılmak ister misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810329
					]
				},
				{
					"id": 706810318,
					"content": "Durumu iyi değerlendirebilmek de çok önemli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810319
					]
				},
				{
					"id": 706810319,
					"content": "Evet! Bu düşman benim boyumu aşar diyorsan fırsatın varken tabanları yağlamalısın. Kahraman ayaklarına yatmaya falan hiç gerek yok yani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706810305,
					"content": "Kim olduğum bana kalsın...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810306
					]
				},
				{
					"id": 706810306,
					"content": "Demek öyle! Demek gizli bir görevdesin ve ser verip sır vermemen gerekiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810307
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810307,
					"content": "Evet, aşağı yukarı öyle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810308
					]
				},
				{
					"id": 706810308,
					"content": "Gizemli davranmayı abartma istersen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810309
					],
					"speakerTitle": "Paimon"
				}
			]
		},
