					}
				]
			},
			"dialogs": [
				{
					"id": 706810501,
					"content": "Şurası <color=#00E1FFFF>Dihua Bataklığı</color>, değil mi? Bu ne güzellik böyle! Mondstadt'ta da hiç böyle yerler yok ki oturup seyredelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810502
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810502,
					"content": "Ne iyi ettim de bu yolculuğa çıktım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810503
					],
					"speakerTitle": "Gesine"
				},
				{
					"id": 706810503,
					"content": "Aa, doğru ya! Böyle güzelliklerle her gün karşılaşmıyoruz, hadi gelin birlikte bir hatıra fotoğrafı çekelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gesine"
				}
			]
		},
