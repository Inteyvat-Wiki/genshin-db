			"dialogs": [
				{
					"id": 733100201,
					"content": "Bu hale mi gelmişler? Ne yazık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100202
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733100202,
					"content": "Sorush, neden bahsediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733100203,
					"content": "Boş ver. Soydaşlarımın bu acınası hallerini gördüm de... Ama önemli değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100204
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733100204,
					"content": "İşte böyle şeyler Paimon'u daha da meraklandırıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733100205,
					"content": "Paimon da bir baksın... Vay be, gerçekten de garip bir ağaç! Yuvarlak şekli sanki bir kapıyı andırıyor, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100206,
						733100207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733100206,
					"content": "İçinden geçersek...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733100208
					]
				},
				{
					"id": 733100208,
					"content": "Hehe, önce Paimon gitmek istiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733100209,
					"content": "... Fravashi Ağaçları kapı değildir. İçlerinden öylece geçerseniz ağaçların içindeki Pari ruhlarını rahatsız edersiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100210
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733100210,
					"content": "Demek bu ağaca Fravashi Ağacı deniyor... Peki ya Pari ruhları nerede? Paimon onları hiç göremiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733100211,
					"content": "Beyaz Pofuduk tabii ki onları göremez. Geçmişin takıntılarında mahsurlar hâlâ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100212
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733100212,
					"content": "Bunu istememiş olabilirler ama dünyaya tutunmaya çalışan bu hallerini görmek... Bu görüntüye katlanamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100213
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733100213,
					"content": "Paimon'a güzel geldi. Sence de hoş değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733100214,
					"content": "Hıh, sen ne anlarsın ki Beyaz Pofuduk? Bu Fravashi Ağaçları, toprağı yozlaştıran kirlilikle sonuna dek savaşan Parilerdir. Kalan son güçlerini kullanarak bugün gördüğünüz ağaçlara dönüşmüşler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100215
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733100215,
					"content": "O kadar güçsüz düşmüşler ki vücut bütünlüklerini koruyamamışlar. Kirlendikleri için Vourukasha Vahası'na kabul edilmemişler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100216
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733100216,
					"content": "Efsaneye göre kadim zamanlarda Kuşkucular Cemiyeti, onlar için bir arınma ayini düzenleyerek Vourukasha Vahası'na geri dönmelerini sağlarmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100217
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733100217,
					"content": "Fakat günümüzde Kuşkucular Cemiyetinde bu ayini yapabilecek biri kalmadı. Tek yapabildikleri bu Fravashi Ağaçlarını hayatta tutmak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100218
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733100218,
					"content": "Ancak bu sadece ızdıraplarının uzamasına sebep oluyor. Şu anki görünüşlerine bakılırsa, acı dolu hatıralarına yalnız başlarına katlanmak dışında hiçbir şey yapamıyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100219,
						733100220
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733100219,
					"content": "Onlara yardım etmemiz gerek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733100221
					]
				},
				{
					"id": 733100221,
					"content": "Paimon onların tek başlarına acı çekmelerine izin veremez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733100222,
					"content": "Öte yandan biz Parilerin kaderi bu. Belki topraklarımızı bu şekilde korumaya devam etmek istemişlerdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100223
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733100223,
					"content": "Bu senin görüşün. Onlar belki farklı düşünüyordur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733100224,
					"content": "Paimon böyle mahsur kalsaydı kesin eve dönüp diğerleriyle bir arada olmak isterdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733100225,
					"content": "Beyaz Pofuduk, irademizi ne cüretle böyle küçümsersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733100226
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733100226,
					"content": "Hıh, öyle olsun. Gücümle onu uyandıracağım ve tükenen sesini dinleteceğim size.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733100220,
					"content": "Öyleyse onları kurtarmanın bir yolu var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733100221
					]
				},
				{
					"id": 733100207,
					"content": "Bizi bir yere götürebilir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733100208
					]
				}
			]
		},
