			"dialogs": [
				{
					"id": 230110601,
					"content": "Nasıl geçti? Kütüklerim geldi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110602
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110602,
					"content": "Viktor'a olanları anlatıyorsun...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230110603
					]
				},
				{
					"id": 230110603,
					"content": "Yine mi canavarlar? Of, bana mı öyle geliyor yoksa dünyadaki tüm arabalar canavarlar tarafından saldırıya mı uğruyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110604
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110604,
					"content": "Neyse, boş ver. Kütüklerimi aldığım sürece benim için sorun yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110605
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110605,
					"content": "Neredeyse unutuyordum. İşte, sözleştiğimiz gibi ödemen hazır. İstersen bir say.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110606
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110606,
					"content": "Şey, bu arada... Lily iyi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110607
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110607,
					"content": "Gitmeden önce ona veda edemedim. Umarım bana kızmamıştır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110608,
						230110610
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110608,
					"content": "O gayet iyi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110609
					]
				},
				{
					"id": 230110609,
					"content": "Pekala. *öksürür* Bana öyle bakmana gerek yok. Sadece onun için biraz endişeleniyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110614
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110614,
					"content": "Her neyse, ödemenin eksiksiz olduğuna emin ol. Tam olarak anlaştığımız kadarını hazırladım Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110610,
					"content": "Dönüp onu kendin gör.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110611
					]
				},
				{
					"id": 230110611,
					"content": "Bunu yaparsam Bay Vsevolod kesin çok sinirlenir. Boş ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110612
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110612,
					"content": "Ona mektup göndermeye de cesaret edemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110613
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110613,
					"content": "Zaten bir Fatui üyesinden mektup almak pek iyi bir şey değil. Hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110614
					],
					"speakerTitle": "Viktor"
				}
			]
		}
