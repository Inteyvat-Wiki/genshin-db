					"content": "Viktor'un kütükleri hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110503
					]
				},
				{
					"id": 230110503,
					"content": "Kütükler... Yani tüm canavarları kaçırdığını mı söylüyorsun? Göründüğünden daha güçlüymüşsün...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110504
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110504,
					"content": "Teşekkürler. Daha sonra birkaç kişiyle oraya gidip kütükleri getireceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110505
					],
					"speakerTitle": "Hamawi"
