				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230110101,
					"content": "Hımm... Bunu nasıl oysam acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110102,
						230110103
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110102,
					"content": "Selam!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110104
					]
				},
				{
					"id": 230110104,
					"content": "Of, kim var orada? Rahat bırak beni, ben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110105
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110105,
					"content": "Aa, Gezgin! Seni Sumeru'ya hangi rüzgar attı böyle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110106
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110106,
					"content": "Rudolf seni beni dövmeye göndermedi herhalde değil mi? Ben alt tarafı çok önceden Lily'ye küçük bir hediye göndermiştim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110107,
						230110109
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110107,
					"content": "Geçerken uğradım sadece...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110108
					]
				},
				{
					"id": 230110108,
					"content": "Hâlâ seyahat ediyorsun yani. Duramıyorsun değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110112
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110112,
					"content": "Ama... Seni Sumeru'da göreceğimi tahmin etmezdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110113
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110113,
					"content": "İlk olarak Mondstadt'tan Snezhnaya'ya gitmem emredildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110114
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110114,
					"content": "Ama ikinci bir emir geldi ve Bay Vsevolod'a yardım etmek için Sumeru Şehri'ne gönderildim. Hatta Lord Pulcinella'nın emri üzerine transfer edildiğim söylendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110115,
						230110116
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110115,
					"content": "Pulcinella mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110117
					]
				},
				{
					"id": 230110117,
					"content": "Evet... Şey, hayır. Konuşmayı bırakayım yoksa Bay Vsevolod gizli meselelere olan duyarsızlığımı eleştirecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110118
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110118,
					"content": "*iç çeker* Haberci Efendilerimizin isimleri sır değil. Niye bu konuda bu kadar geriliyor hiç anlamam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110119
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110119,
					"content": "Sumeru'da ne yapıyorsun peki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110120
					]
				},
				{
					"id": 230110120,
					"content": "Bay Vsevolod ve ben esasen lojistik destek ve koordinasyondan sorumluyuz. Kısacası sürekli alışverişe çıkıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110121
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110121,
					"content": "Çok önemli bir iş gibi durmuyor ama Mondstadt Katedralinde dikilmekten iyi olduğu kesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110122
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110122,
					"content": "Hehe. Bir de şimdiki işimde çok boş vaktim oluyor, üstelik gözü üzerimde olan kimse yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110123
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110123,
					"content": "O yüzden çocukluk hobim olan ahşap oymacılığına yeniden başladım. Sumeru'da da çok tahta var. Pratik yapmak için tam da yeri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110124
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110124,
					"content": "Ve yaptığım ahşap oymaları çocuklar çok beğeniyor biliyor musun? Beni rahat bırakmadılar, ben de hepsine bir tane yapacağıma söz verdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110125,
						230110128
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110125,
					"content": "Sen Fatui'yle değil misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110126
					]
				},
				{
					"id": 230110126,
					"content": "Evet, ne olmuş? Yani... Bir Fatui Üyesi çocuklar için oyuncak yapamaz mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110127
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110127,
					"content": "Ayrıca ben sadece tedarikçiyim. Tüm o harika fırsatları Lordlara bırakıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110130
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110130,
					"content": "Neyse, durum böyle işte. Snezhnaya'ya dönemedim ama Sumeru'yu da seviyorum. Burada yemek, eğlence ve gayet güzel bir ortam var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110131
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110131,
					"content": "İşten sonra yanıma biraz yemek alıp güzel, güneşli bir yerde ahşap oyacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110132
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110132,
					"content": "Gerçi... Haha, herkes bana şüpheli gözle bakıyor, tıpkı ilk konuştuğumuzda senin baktığın gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110133
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110133,
					"content": "Neyse, yapacak bir şey yok. Sonuçta ben bir Fatui üyesiyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110134,
						230110135
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110134,
					"content": "Şu anda bile sana pek güvenmiyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110136
					]
				},
				{
					"id": 230110136,
					"content": "Pekala... Aslında artık hayatımdan gayet memnunum, biraz birikim yapmayı bile başardım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110137
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110137,
					"content": "Günlerim böyle geçecekse buraya, Sumeru'ya yerleşebilirim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110138
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110138,
					"content": "Öhöm, tamam, bu kadar yeter. Gezgin, şimdi sen de burada olduğuna göre istersen \"eşit takasımıza\" devam edelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110139
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110139,
					"content": "Gerçi anlatacak hikayem de kalmadı, bu yüzden bu sefer ödemeni gerçek para birimiyle yapacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110140,
						230110141
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110140,
					"content": "Bu benim için daha iyi olur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110143
					]
				},
				{
					"id": 230110143,
					"content": "Pekala, sana özel görevi açıklayayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110144
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110144,
					"content": "Hamawi'den biraz kütük istemiştim ama henüz elime ulaşmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110145
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110145,
					"content": "Çalışma saatleri içinde gidip onunla konuşayım desem bu sefer de Bay Vsevolod beni azarlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110146
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110146,
					"content": "Gezgin, lütfen bana bir iyilik yapıp Hamawi'den kütüklerin teslimatıyla ilgili bilgi alabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110147,
						230110149
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110147,
					"content": "Sen ödemeyi hazırla yeter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110148
					]
				},
				{
					"id": 230110148,
					"content": "Merak etme. Seni hayal kırıklığına uğratmam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110151
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110151,
					"content": "Her neyse, bu işi sana bırakıyorum Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110149,
					"content": "Bir işler çevirmiyorsun, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110150
					]
				},
				{
					"id": 230110150,
					"content": "Hayır yahu, önceki işlerimizde böyle kirli numaralar yaptım mı? Merak etme, ben böyle şeyler yapmam. Basit ve huzurlu bir hayat yaşamamın nesi yanlış?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110151
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110141,
					"content": "Şimdi de Fatui'den özel görev mi alacağım?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110142
					]
				},
				{
					"id": 230110142,
					"content": "Tabii ki hayır, sen sadece Viktor'dan özel görev alacaksın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110143
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110135,
					"content": "Benim sana güvendiğim ne malum? Bana yaranmaya çalışma!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110136
					]
				},
				{
					"id": 230110128,
					"content": "Çocukların ağzından bilgi almaya çalışmıyorsun... Değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110129
					]
				},
				{
					"id": 230110129,
					"content": "Orada dur bakalım! Asla yapmam öyle bir şey! Sen niye biz Fatui üyelerini hep böyle kötü zannediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110130
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110116,
					"content": "Bir Haberci daha mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110117
					]
				},
				{
					"id": 230110109,
					"content": "Aynen öyle, hadi benimle Mondstadt'a gel!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110110
					]
				},
				{
					"id": 230110110,
					"content": "Hahaha, pekala. Beni alıp götürürken kelepçelemek de ister misin acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110111
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110111,
					"content": "Bu kadar şamata yeter. Halletmem gereken işler var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110112
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 230110103,
					"content": "V-Viktor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110104
					]
				}
			]
		},
