					"content": "Viktor'a teslim edilecek kütükler hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110303
					]
				},
				{
					"id": 230110303,
					"content": "Fatui üyesinin sipariş ettiği kütüklerden mi bahsediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110304
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110304,
					"content": "*iç çeker* Bir Fatui üyesiyle iş yapmanın sorun çıkaracağını biliyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110305
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110305,
					"content": "Kütükleri taşırken canavarların saldırısına uğradık. Hepimiz sağ salim döndük ama arabamızı getiremedik. Kütükleri de yol kenarında bırakmak zorunda kaldık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110306
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110306,
					"content": "Ne oraya gitmeyi göze alabilirim, ne de o canavarlardan bu kadar çabuk kurtulacak birini bulabilirim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110308
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110308,
					"content": "Biz Fatui değiliz...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230110309
					]
				},
				{
					"id": 230110309,
					"content": "Sen Fatui üyesi değil misin? O halde neden ona yardım ediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110310
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110310,
					"content": "Her neyse, şimdilik sadece arabamı oraya bırakabilir ve durumla ilgilenebilecek biri var mı diye etrafa bakınabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110311
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110311,
					"content": "Kütüğü almak için acelen varsa, arabanın yaklaşık olarak yerini haritada işaretliyorum. Kendin gidip göz atabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230110312
					],
					"speakerTitle": "Hamawi"
				},
				{
					"id": 230110312,
					"content": "*iç çeker* Fatui'nin karıştığı işten hayır gelmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hamawi"
				}
			]
		},
