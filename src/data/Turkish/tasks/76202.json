			},
			"dialogs": [
				{
					"id": 762020301,
					"content": "Aniden yüzünde bir rüzgar esiyor.\\nNe tuhaf... Çifte Meyve Çörekleri, Yazdönümü Pastası, Fırında Çıtır Et ve Yemişli Bitki Şekerlemesi kokuyor.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762020302
					]
				},
				{
					"id": 762020302,
					"content": "Of! Aşırı şekerli bir rüzgar Paimon'un boğazına kaçtı! *öksürür*... Hey! Neredeyiz biz? Şu demlik ve fincanlar çok ama çok büyük görünüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020303,
					"content": "Bir dakika... Yoksa küçüldük mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020304,
					"content": "İşin içinde Nicole'un büyüsü var galiba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020305
					]
				},
				{
					"id": 762020305,
					"content": "Özür dilerim, hayvan aktörler davet etmeyi umuyordum ama ne yazık ki olmadı... Ben daha çok... \"İfadesiz\" suratlı oyuncularla çalışmaya alışkınım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020306
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020306,
					"content": "Hı? Nicole, sen de mi küçüldün? Paimon senin kocaman olacağını sanmıştı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020307,
					"content": "Muhteşem Devasa Büyücü Nicole, gökleri ayakta tutarken konuşmak için çömelecek miydi? Kalsın! Şu anki boyumdan oldukça memnunum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020308
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020308,
					"content": "Neeeyse... Büyük Büyücünün Çay Saatine hoş geldiniz! Hadi, kendinize çay doldurun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
		{
			"id": 7620204,
			"completionStepIds": [],
