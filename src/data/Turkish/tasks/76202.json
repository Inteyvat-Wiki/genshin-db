			"dialogs": [
				{
					"id": 762020601,
					"content": "Aaa! Neden birden aşağı kaydı ki? Ayrıca şu... Devasa bir Mandragora heykeli mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
