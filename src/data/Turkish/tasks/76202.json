			"dialogs": [
				{
					"id": 762020201,
					"content": "Hoş geldiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020202,
						762020203
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020202,
					"content": "Merhaba Nicole.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020204
					]
				},
				{
					"id": 762020204,
					"content": "Vay canına, evin ne kadar da güzel! Paimon bu haline bayıldı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020205,
					"content": "Hehe, beğeneceğini biliyordum Paimon. Bunu duydum ya, boş zamanlarımda uğraşmama değmiş demek ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020206
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020206,
					"content": "Her şey bu gizli kulübeyi bitirdiğim gün başladı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020207
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020207,
					"content": "Devam edip birkaç kulübe daha yapmayı planlıyordum ama etrafta bana ilham verecek kimse yoktu. Hal böyle olunca bir süre sonra hevesim de yavaş yavaş... Sönüp gitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020208
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020208,
					"content": "\"Aynı anda hem eğlenmenin hem keyif almanın hem de bir şeyler başarmış gibi hissetmenin bir yolu yok mu?\" derken cevap birdenbire aklıma geldi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020209
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020209,
					"content": "Bir dakika, doğrudan cevaba mı geçiyoruz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020210,
					"content": "Hadi Paimon. Zaman kimseyi beklemez. Bak, tam gözünüzün önünde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020211
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020211,
					"content": "Bu kapıdan mı geçeceğiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020212,
					"content": "Aslında sadece bu kapıdan değil ama yanılıyor da değilsin. Her şeyin bir yerden başlaması gerekir. Buradan daha iyi neresi olabilir ki? Hazır mısınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020213
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020213,
					"content": "B-Bir dakika, çok hızlı gidiyorsun! Paimon sana yetişemiyor... Neye hazır mıyız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020214,
					"content": "Kafanıza takmayın. Hiçbir şeye hazırlanmanıza gerek yok, lafın gelişi öyle söyledim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020215
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020215,
					"content": "Gözlemlerime ve çıkarımlarıma göre... Karmaşık girişlerden ve açıklamalardan pek hoşlanmıyorsunuz. Eğlenceyi maceranın en heyecanlı yerinde bulmayı tercih ediyorsunuz, haksız mıyım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020216,
						762020217
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020216,
					"content": "Doğru diyorsun...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020218
					]
				},
				{
					"id": 762020218,
					"content": "Haha, bak bunu duyduğuma sevindim! O halde sıkı durun, kendimi hiç tutmayacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020219
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020219,
					"content": "Biz melekleri biliyorsun. Maceracıları hazinelere yönlendirme keyfine karşı koyamıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020220
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020220,
					"content": "Madem amaç nazik olmak ve başkalarının mutluluğu bulmasına yardım etmek, neden kendi arkadaşlarıma birkaç ipucu vererek başlamayayım ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020221
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020221,
					"content": "Bunu düşünürken aklıma aniden süper bir fikir geldi! Küçük kulübemi rahatlayıp eğlenebileceğiniz bir yere dönüştürdüm. Hatta her bir odaya hazine bile sakladım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020222
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020222,
					"content": "Doğrusunu söylemek gerekirse diğer meleklerle kıyasla bile bir şeyler saklama konusunda oldukça iyiyimdir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020223
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020223,
					"content": "Yabana bir sandık gömüp yolunu size göstermesem aylarca arasanız da bulmanız imkansız olurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020224
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020224,
					"content": "Öhöm... Neyse... Konudan saptım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020225
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020225,
					"content": "İşleri kasten zorlaştırmak istemiyorum, sırf beni eğlendirin diye sizi kırlarda koşturacak da değilim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020226
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020226,
					"content": "Tek yapmanız gereken bu odada üç tüy bulmak! Bulduğunuzda bana haber verin ki ödülünüzü, yani o güzel ve büyük hazine sandığını açmanızı izleyebileyim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020227
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020227,
					"content": "Aaa, demek hazine avına çıkıyoruz! Paimon sabırsızlandı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020228,
					"content": "Aynen öyle! Hazine avı. Çok eğlenceli olacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020217,
					"content": "Yine de biraz açıklama fena olmazdı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020218
					]
				},
				{
					"id": 762020203,
					"content": "Burada olmaktan şeref duydum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020204
					]
				}
			]
		},
