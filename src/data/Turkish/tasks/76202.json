			"dialogs": [
				{
					"id": 762020401,
					"content": "Biraz fazla mı geldi? Merak etmeyin, aslında oldukça basit. Sadece iyi düşünün, her yeri didik didik edin ve sonunda ödülünüzü alın. Tam da sizin ustası olduğunuz türden bir macera!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
