			"dialogs": [
				{
					"id": 762020901,
					"content": "Paimon bu ödüller için neden bu kadar heyecanlı olduğunu merak etti Nicole...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020902,
					"content": "#Hani {NICKNAME} Paimon'dan bir hediye alınca tepkisini izlemek Paimon'un çok hoşuna gidiyor tamam ama bu biraz farklı sanki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020903,
					"content": "Sana \"üzümünü ye de bağını sorma\" dememiş miydim Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020904
					]
				},
				{
					"id": 762020904,
					"content": "Kafanıza takmayın, benim için sorun değil! En kötü ihtimalle, vereceğim cevap melek ırkı hakkındaki bazı yanılsamalarınızı yerle bir edebilir. Hepimizin özverili, iyiliksever varlıklar olduğumuzu düşünüyorsanız gerçekler fikrinizi değiştirebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020905
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020905,
					"content": "Soruna gelecek olursak sevgili Paimon, heyecanımın yol gösterdiğim kişilerin sevincini paylaşmakla bir ilgisi yok. Aksine, üzerimdeki görevleri yerine getirmemden kaynaklanıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020906
					],
					"speakerTitle": "Nicole",
					"speakerSubtitle": "Nicole"
				},
				{
					"id": 762020906,
					"content": "Hı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020907,
					"content": "Her şey meleklerin doğuşuyla başladı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020908
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020908,
					"content": "Bizlere bu topraklardaki tüm canlıları sevme görevi emanet edilmişti, fakat bizden sonra gelen tanrıların aksine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020909
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020909,
					"content": "... Duyguları algılama yeteneğimiz ilkeldi, gelişmemişti. Çoğu zaman, sırf komutları takip eden makinalar gibi, sadece yukarıdan gelen emirleri yerine getirirdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020910
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020910,
					"content": "\"Aydınlatma\"nın yanı sıra \"rehberlik etmek\" birincil görevimizdi. Bu, eski akranlarımın bilgeliklerinden arındırıldıktan sonra korudukları birkaç içgüdüden biriydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020911
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020911,
					"content": "Görevlerimizi yerine getirdiğimizde neşe dolu bir rahatlama hissi yaşardık. Bu his, bir meleğin normalde yaşayabileceği en yoğun duygusal deneyimdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020912
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020912,
					"content": "Bu... Biraz üzücü değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020913,
					"content": "Öyle belki ama bunu acınacak bir şey olarak görmemeyi tercih ederim. Ne de olsa gök kubbenin ulu hükümdarı bile şu anda kalbimdeki duyguların gerçekliğini inkar edemez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020914
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020914,
					"content": "Üstelik başkalarına rehberlik etmek başlı başına iyi bir şey, öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
