					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020602,
					"content": "Tıkırt...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020603
					],
					"speakerTitle": "Kapıyı İncele"
				},
				{
					"id": 762020603,
					"content": "Durun. Pardon, küçük bir teknik arıza yaşandı. Bir bakayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020604
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762020604,
					"content": "Tık... Tak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020605
					],
					"speakerTitle": "Kapıyı İncele"
				},
				{
					"id": 762020605,
					"content": "Hareket ediyor! Hey! Bu şey bize mi saldırıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762020606,
					"content": "Hah, çok daha iyi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762021401,
					"content": "Ne demek çok daha iyi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762021402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762021402,
					"content": "#Hım? Yapmayın, saldırmıyor bile neredeyse. Birazcık gıdıklanmaya dayanabilirsiniz, değil mi? Hem bu {NICKNAME} için yeteneklerini gösterebileceği harika bir fırsat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762021403
					],
					"speakerTitle": "Nicole"
				}
			]
