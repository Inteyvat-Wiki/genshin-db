			"dialogs": [
				{
					"id": 730410601,
					"content": "Ne? Nasıl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410602
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410602,
					"content": "Aranishat da çabucak bulundu. O da Aralila kadar zayıf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410603
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410603,
					"content": "Uff... Hepsi çok zayıf. Sadece Altın Nara güçlü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410604
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410604,
					"content": "Bu kötü oldu! Ararakalariler üzerine çalışmam gerek, hem de çok güçlü Ararakalariler. Nara arkadaşım beni asla bulamayacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410605,
						730410607
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410605,
					"content": "O öyle olmuyor sanırım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730410606
					]
				},
				{
					"id": 730410606,
					"content": "Kaybetmekten mi korkuyorsun? Oyun oynarken kazanmaya veya kaybetmeye odaklanmaya gerek yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410609
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410609,
					"content": "Kaybetsem de eğlendim. Sonuçta altın Nara iyi bir Nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410610
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410610,
					"content": "Nara arkadaşımız kazandı. Harika! Lütfen çiçeklerimizi kabul et!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410611
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410611,
					"content": "Teşekkürler iyi Nara! İyi bir arkadaşsın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410607,
					"content": "Bir dahaki sefere daha şanslı olursun umarım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730410608
					]
				},
				{
					"id": 730410608,
					"content": "Evet! Bir dahakine kaybetmeyeceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410609
					],
					"speakerTitle": "Aranishat"
