			"dialogs": [
				{
					"id": 730410101,
					"content": "Ah, senmişsin Altın Nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410102
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410102,
					"content": "Nara arkadaşım, gel de Aralila'yla oyna! Aranishat çok zayıf. Onunla oynama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410103
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410103,
					"content": "Aman, Aralila geçen sefer Aranishat'a karşı kaybetti. O yüzden Aralila daha zayıf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410104
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410104,
					"content": "Peki o zaman, böyle şeylere kafa yormayalım. Nara arkadaşımız gelmiş, onunla oynayalım. Birbirimize karşı yarışıp kim daha güçlü görelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410105
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410105,
					"content": "Peki yarışalım. Aranishat korkmuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410106
					],
					"speakerTitle": "Aranishat"
				},
				{
					"id": 730410106,
					"content": "Önce Aralila saklanacak ve Nara arkadaş gelip arayacak. Sonra Aranishat saklanacak ve Nara arkadaş arayacak. İlk bulunan kaybeder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730410107
					],
					"speakerTitle": "Aralila"
				},
				{
					"id": 730410107,
					"content": "Oynamak ister misin Nara arkadaşım? Hazırsan hemen başlayalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aralila"
				}
			]
		},
