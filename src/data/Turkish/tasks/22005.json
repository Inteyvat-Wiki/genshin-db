			},
			"dialogs": [
				{
					"id": 220050101,
					"content": "Of ya, nerede bu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050102
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050102,
					"content": "Ne yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050103
					]
				},
				{
					"id": 220050103,
					"content": "Ay! Nereden çıktın sen öyle bir anda? Sessiz sessiz nasıl yaklaştın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050104
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050104,
					"content": "Ben mi? Ben... Bir araştırmacıyım. Guili Ovası'nın tarihi mimarisini ve yadigarlarını araştırıyorum. A-Adım Bao'er.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050105
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050105,
					"content": "Araştırmama o kadar dalmışım ki yanımda taşıdığım bir paketi kaybettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050106
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050106,
					"content": "İçinde aşırı nadir bir hazi... Şey, aşırı nadir bir tarihi yadigar var. Bulmama yardım edebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050107,
						220050108,
						220050109
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050107,
					"content": "Tamam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050110
					]
				},
				{
					"id": 220050110,
					"content": "Süper! Sanırım buraya yakın bir yerde düşürdüm... Ya da belki biraz daha uzakta. Neyse, iyice ara lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050108,
					"content": "Nasıl bir paket?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050111
					]
				},
				{
					"id": 220050111,
					"content": "Yani işte... Sıradan bir kutu. Dört yüzü, üstü, altı var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050112
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050112,
					"content": "Yadigarı neden mi kutuya koydum? Çünkü... Kutuda taşınması daha mantıklı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050113
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050113,
					"content": "Yadigar hasar görmesin diye kutuyu giysilerle doldurdum. Bir an önce bulmam gerekiyor, lütfen yardım et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050109,
					"content": "Ne tür bir yadigar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050114
					]
				},
				{
					"id": 220050114,
					"content": "Şey... Çok değerli bir yadigar işte. Anlatmaya çalışsam da anlamazsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050115
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050115,
					"content": "Gerçek değerini ancak benim gibi bir uzman anlayabilir. Bir an önce bulmama yardım et lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				}
			]
		},
