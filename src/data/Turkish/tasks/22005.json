					"content": "Bu mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050303
					]
				},
				{
					"id": 220050303,
					"content": "Bir bakayım... Hayır, değil galiba... Çok hafif geldi, içinde benim yadigarım olamaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050304
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220050304,
					"content": "Ama yine de sağ ol. Ben kendim aramaya devam ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050305
					],
					"speakerTitle": "Bao'er"
				},
				{
