			"dialogs": [
				{
					"id": 745040101,
					"content": "Ah, işe başlamak için çok mu isteklisiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040102
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745040102,
					"content": "Umarım bunu söylememin bir sakıncası olmaz ama bu planın pek umut verici olduğunu düşünmüyorum. Vaktiniz varsa Lepaute Saatçiliğe uğrayıp biraz keyfinize bakın isterseniz, ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040103
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745040103,
					"content": "Ooo, dürüstlüğün mü tuttu şimdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745040104,
					"content": "Şşş! Sus artık, sus! Biri bizi duyarsa, beni düşman bir casus sanabilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040105
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745040105,
					"content": "Haha, bu konuyu burada bırakalım, olur mu? Yani, ben sadece burada çalışıyorum, o yüzden hadi iş konuşalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040106
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745040106,
					"content": "Öncelikle bu veri toplama projesinin ikiye ayrılacağını belirteyim. Biri Arbon tarafından yürütülecek, diğeri ise bende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040107
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745040107,
					"content": "Biz bir Düello Şampiyonunun gücünü modellemek istiyoruz. Bu yüzden birkaç savaş testi tamamlamana ihtiyacımız olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040108
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745040108,
					"content": "Canavarların sıklıkla toplandığı bazı yerler tespit ettik ve bu yerlerin yakınlarına veri toplama cihazları yerleştirdik, yani sadece gidip o yaratıkları temizlemeniz yeterli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040109
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745040109,
					"content": "Ben tam konumları haritada işaretledim. Diğer önemli hususlar bu el kitabında yazılı, vaktiniz olduğunda göz atabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040110
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745040110,
					"content": "Herhangi bir sorunuz var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745040111
					],
					"speakerTitle": "Alberre"
				},
				{
					"id": 745040111,
					"content": "Yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745040112
					]
				},
				{
					"id": 745040112,
					"content": "Peki o zaman, umarım veri toplama işi sorunsuz ilerler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alberre"
				}
			]
		}
	]
