					"nextDialogs": [
						223070603
					]
				},
				{
					"id": 223070603,
					"content": "Güzel! Gerçek bir maceracıya benzediğini söylemiştim, değil mi? Bunu kanıtlamış oldun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070604
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070604,
					"content": "Pekala, şimdi kutuda ne varmış bakalım... Peh, bir yığın çöp...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070605
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070605,
					"content": "Neyse, en azından denedin! Senin payın bu. Zhang Shun almaya gelene kadar onun payını tutacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070606
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070606,
					"content": "*iç çeker* Henüz bulamadın mı... Bu eleman kesin beni kandırdı...",
