			},
			"dialogs": [
				{
					"id": 223070201,
					"content": "Selam dostum! Sana nasıl yardımcı olabilirim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070202
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070202,
					"content": "Hazine Haritaları lazım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223070203
					]
				},
				{
					"id": 223070203,
					"content": "Hazine Haritaları mı? Ha bildim, Zhang Shun'un haritalarından bahsediyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070204
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070204,
					"content": "Demek gerçekten bu hazineleri arayacaksın. Açıkçası ben bunları yalnızca ufak bir eğlence olarak görüyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070205
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070205,
					"content": "Ama görünüşünden belli, sen gerçek bir maceracısın. Birileri \"hazine\" der demez gözleri ışıldayan türdensin hem de.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070206
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070206,
					"content": "Zaten benim Hazine Haritalarına pek ihtiyacım yok, yani onları alabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070207
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070207,
					"content": "Tabii hazine bulacak olursan yarı yarıya bölüşelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070208
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070208,
					"content": "Sonuçta bu haritalar bir süredir bendeydi. Onları sakladığım için bir miktar pay almam gerekir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
			]
		},
