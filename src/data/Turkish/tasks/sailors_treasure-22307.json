					"content": "Evet, lütfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223070302
					]
				},
				{
					"id": 223070302,
					"content": "Tamamdır... Al bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070303
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223070303,
					"content": "Kolay gelsin. Hazineyi bulduğunda buraya getirmeyi unutma... Anlaştığımız gibi üçe böleceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
