			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tailleferre"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742240201,
					"content": "Yine karşılaştık Tailleferre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240202,
					"content": "Aa, siz miydiniz? Maceracı ve onun küçük asistanı. Kusura bakmayın, adınızı unuttum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240203
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240203,
					"content": "#Paimon'un adı Paimon ve bu da {NICKNAME}. Geçen seferki yardımların için teşekkürler bu arada. Sayende bir Kabuk Arp kullanarak kadim besteyi çalabildik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240204,
					"content": "Bu sefer hangi rüzgar attı seni Petrichor'a?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240205,
					"content": "Ben de size aynısını soracaktım. Bir söylentinin peşindeyim ama sizin gibi maceracıların zaten bundan çoktan haberi vardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240206
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240206,
					"content": "Söylenti mi? Ne söylentisi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240207,
					"content": "Hımm? Tüm Petrichor'u kasıp kavuran büyük haberi duymadınız mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240208,
						742240209
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240208,
					"content": "Kazara tüm dünyayı kurtarmıştık, onu mu diyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240210
					]
				},
				{
					"id": 742240210,
					"content": "Ne? Ne diyorsun? Hayır, hayır, efsanevi Solgun Kale'nin yeniden keşfinden bahsediyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240211
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240211,
					"content": "Oraya ait en son kayıtlar birkaç yüzyıl öncesine dayanıyor. Sizin de bunun için buraya geldiğinizi sanmıştım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240212
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240212,
					"content": "Ha, o mu? Onun bizimle bir ilgisi olabilir tabii...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240213,
					"content": "O halde, kalenin bir zamanlar Fontaine tarihindeki en önemli müzisyene, yani Boethius'a ait olduğunu da biliyorsunuzdur, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240214
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240214,
					"content": "Yazdığı operalar olsun derlediği kadim Remuria besteleri olsun, eserlerinin hepsinin müzik tarihinde özel bir yeri var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240215
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240215,
					"content": "Bir zamanlar yaşadığı o kalede mutlaka çok zengin kaynaklar olmalı. Bunların her biri Müzisyenler Birliğimiz için ayrı bir öneme sahip yadigar hükmündedir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240216
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240216,
					"content": "Bu yüzden, haberleri alır almaz buraya koştum ve diğer maceracılardan önce davranıp önemli olanları güvence altına almaya çalıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240217
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240217,
					"content": "Ama sanırım siz yine de benden bir adım öndeymişsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240218
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240218,
					"content": "(Iıı, Boethius'un aslında çok kötü biri olduğunu ve o müziklerin hepsini kötülük yapmak için kullandığını ona söylesek mi ki?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240219,
					"content": "(Doğruları öğrense üzülür mü dersin?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240220,
						742240221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240220,
					"content": "\"Senfoni\" artık kötülük için kullanılamaz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240222
					]
				},
				{
					"id": 742240222,
					"content": "Hımm? İkiniz ne fısır fısır ne konuşuyorsunuz öyle? Kadim besteleri çoktan bulmuş olamazsınız herhalde, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240223
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240223,
					"content": "Şey, eğer... Ama bak \"eğer\" diyoruz, Boethius gerçekten ama gerçekten kötü biri olsaydı onun bıraktığı müzik bestelerini yine de ister miydin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240224,
					"content": "Hımm... Dürüst olmak gerekirse, \"gerçekten ama gerçekten kötü biri\" derken neyi kastettiğinizi tam anlamıyorum ama yaptığı müzikler dışında tarihte onunla ilgili söylenenler pek hoş değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240225
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240225,
					"content": "\"Uçan Yabancı\" romantik operasından da anladığımız üzere, yaşadığı süre boyunca Remuria'yı yeniden canlandırma umudunu asla yitirmedi ve yeni kurulan Fontaine'i sürekli bir düşman olarak gördü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240226
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240226,
					"content": "Tarihçilere göre, Fontaine kurulmadan önce meydana gelen savaşlarda da onun parmağı varmış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240227
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240227,
					"content": "Ancak müzik alanındaki başarıları bunlardan çok daha farklı bir olay. Yaptığı müziklerde yanlış bir tarih olabilir ama sanat açısından halen değerini koruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240228
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240228,
					"content": "Benim gözümde bunların hepsi tarihin birer parçası. En saf sanatlar dahi yerine göre kötülük için kullanılabilir ve müzisyenlerin bunu unutmaması gerekir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240229,
						742240231
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240229,
					"content": "Senin bunları kötü niyetle kullanmayacağına eminim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240230
					]
				},
				{
					"id": 742240230,
					"content": "Haha, ben sadece bir araştırmacıyım. Bu kadim melodileri dinleyebildiğim için ne kadar onur duyuyorum bilemezsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240233
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240233,
					"content": "Bu arada, madem burada rast geldik sizden bir konuda yardım isteyebilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240234
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240234,
					"content": "Geçen sefer yaptığım iyiliğin bir karşılığı olarak düşünebilirsiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240235,
						742240237,
						742240239
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240235,
					"content": "Geçen sefer herhangi bir ödemeye gerek yok dememiş miydin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240236
					]
				},
				{
					"id": 742240236,
					"content": "Hehe, o halde bunu bir \"yardım\" olarak görün sadece, olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240240
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240240,
					"content": "Her neyse, az önce de söylediğim üzere meşhur kayıp opera \"Uçan Yabancı\" için buradayım ben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240241
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240241,
					"content": "Ruggiero adlı birinin yüzlerce yıl önce geride bıraktığı kayıtlara göre, bu kayıp opera Solgun Kale'nin içinde bir yerlerde olmalı. Onu bulmama yardım eder misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240242
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240242,
					"content": "Sonuçta bu tür konularda benden çok daha tecrübelisinizdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240243
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240243,
					"content": "#O bestelerin çoğunda artık \"o güç\" yok... Madem istedi, ona yardım edelim o zaman, değil mi {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240244,
					"content": "Harika, buradan kabul ettiğinizi anlıyorum. Hehe, muhteşem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240245
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240245,
					"content": "Size güveniyorum o halde. Sizi kasabada bekliyor olacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240237,
					"content": "Ama ben Morasız iş yapmam...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240238
					]
				},
				{
					"id": 742240238,
					"content": "Merak etmeyin, karşılığını alacaksınız. Müzisyenler Birliğinin sadece birkaç çulsuzun bir araya geldiği bir yer olmadığını göreceksiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240240
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240239,
					"content": "Böyle olacağını tahmin etmiştim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240240
					]
				},
				{
					"id": 742240231,
					"content": "Çok etkileyici bir yaklaşım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240232
					]
				},
				{
					"id": 742240232,
					"content": "Hehe, benim kişisel görüşlerim bu yönde yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240233
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240221,
					"content": "Onca şeyi açıklaması biraz zaman alacak ama...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240222
					]
				},
				{
					"id": 742240209,
					"content": "Petrichor'daki Büyük Hipnoz hakkında mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240210
					]
				}
			]
		},
