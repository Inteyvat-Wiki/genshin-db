			},
			"dialogs": [
				{
					"id": 742240901,
					"content": "Hımm, bu... Bu gerçekten de \"Uçan Yabancı.\" Onu bulmuşsunuz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240902
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240902,
					"content": "Eminim kolay olmamıştır, size güvenmekle ne kadar da haklıymışım, harika maceracılarım benim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240903
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240903,
					"content": "Hehe teşekkürler! Bu besteyle ne yapacaksın peki? Epiclese Opera Salonunda çalıp bir sürü Mora falan mı kazanacaksın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 742240904,
					"content": "Hımm... Para kazanmak önemli tabii ama bunu kişisel çıkarlarım için kullanma niyetinde değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240905
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240905,
					"content": "Bu kadim sanat eseri tüm insanlığın ortak varlığıdır. Bu yüzden, araştırmamı tamamladıktan sonra \"Uçan Yabancı\"yı halkın kullanımına sunacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240906
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240906,
					"content": "Sonuçta bu kayıp operayı bulmak ve tarih sayfalarında şimdiye dek eksik kalmış bir yeri doldurmak yapılacak en büyük iyiliklerden değil midir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240907,
						742240908
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240907,
					"content": "Arkandayım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240910
					]
				},
				{
					"id": 742240910,
					"content": "Pekala, sanırım artık gitmem gerek. Araştırmalar ve çalışmalar beni bekler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240911
					],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240911,
					"content": "Ha bu arada, işte ödemeniz! Fırsat olursa yeniden buluşmak dileğiyle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tailleferre"
				},
				{
					"id": 742240908,
					"content": "Benim katkılarımı da unutma tabii.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742240909
					]
				},
				{
					"id": 742240909,
					"content": "Tabii ki. İsminizi başlık sayfasına yazacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742240910
					],
					"speakerTitle": "Tailleferre"
				}
			]
