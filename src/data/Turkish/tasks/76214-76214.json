			},
			"dialogs": [
				{
					"id": 762140301,
					"content": "#Hav? Ne oldu {M#Bay}{F#Bayan} Altın Gezgin? Sana nasıl yardımcı olabilirim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140302
					],
					"speakerTitle": "Leydi Kaniş Hanımefendi"
				},
				{
					"id": 762140302,
					"content": "Bay Gri Kedi adına Leydi Kaniş Hanımefendi'yi çay partisine davet ediyorsun...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762140303
					]
				},
				{
					"id": 762140303,
					"content": "Hım? Vakti gelmiş mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140304
					],
					"speakerTitle": "Leydi Kaniş Hanımefendi"
				},
				{
					"id": 762140304,
					"content": "Teşekkür ederim, hav! Bu kadar meşgul olmasaydım Bayan Sarman Kedi'yi davet etmeye kendim giderdim... Eğer öyle yapsaydım belki de Bay Gri Kedi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140305
					],
					"speakerTitle": "Leydi Kaniş Hanımefendi"
				},
				{
					"id": 762140305,
					"content": "Kedi ya da köpek, hepimiz barış içinde yaşayabiliriz... Evet, bunu yapabiliriz. Neyse, çay partisine gideyim ben. Hatırlattığın için sağ ol!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Leydi Kaniş Hanımefendi"
				}
			]
		},
