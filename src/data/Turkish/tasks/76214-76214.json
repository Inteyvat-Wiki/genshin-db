			},
			"dialogs": [
				{
					"id": 762140201,
					"content": "... Miyav. Kılıç ustalığın... Oldukça etkileyici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140209
					],
					"speakerTitle": "Bayan Sarman Kedi"
				},
				{
					"id": 762140209,
					"content": "Sana minnetlerimi sunuyorum uzak diyarlardan gelen saygıdeğer şövalye. O kibirli kaba herifler halkımın evlerini bir daha asla rahatsız edemeyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140210
					],
					"speakerTitle": "Bayan Sarman Kedi"
				},
				{
					"id": 762140210,
					"content": "Pekala... Seni sarayıma getiren nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140202,
						762140204
					],
					"speakerTitle": "Bayan Sarman Kedi"
				},
				{
					"id": 762140202,
					"content": "\"Saray\" mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140203
					]
				},
				{
					"id": 762140203,
					"content": "Şey... Bu bir peri masalı olduğuna göre bu da peri masalı dünyasının bir parçası olsa gerek, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762140206,
					"content": "Bay Gri Kedi adına Bayan Sarman Kedi'yi çay partisine davet ediyorsun...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762140207
					]
				},
				{
					"id": 762140207,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140208
					],
					"speakerTitle": "Bayan Sarman Kedi"
				},
				{
					"id": 762140208,
					"content": "... Anlıyorum ve sana teşekkürlerimi sunuyorum, uzak diyarlardan gelen saygıdeğer şövalye. Bilgece öğüdünü dikkate alıp derhal yola koyulacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bayan Sarman Kedi"
				},
				{
					"id": 762140204,
					"content": "Majesteleri, müsaadenizle size bir meseleyi bildirmek isterim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140205
					]
				},
				{
					"id": 762140205,
					"content": "Öhöm, birileri ne çabuk yola geldi! Yabancı bir diyarda olunca oranın adetlerini benimseyiverdin hemen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140206
					],
					"speakerTitle": "Paimon"
				}
			]
		},
