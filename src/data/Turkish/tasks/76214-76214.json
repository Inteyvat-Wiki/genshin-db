			"dialogs": [
				{
					"id": 762140101,
					"content": "Miyav... Çay partisinin zamanı geldi de geçti bile, miyav. Acaba yolu mu bulamadılar, miyav...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140102
					],
					"speakerTitle": "Bay Gri Kedi"
				},
				{
					"id": 762140102,
					"content": "#Aa, demek sensin {M#Bay}{F#Bayan} Altın Gezgin. Seçilmiş kahraman sen olmalısın, miyav! Arkadaşlarımı bulmama yardım eder misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140103,
						762140104
					],
					"speakerTitle": "Bay Gri Kedi"
				},
				{
					"id": 762140103,
					"content": "Kimdir bu arkadaşların?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140106
					]
				},
				{
					"id": 762140106,
					"content": "Ha, bu arada henüz gelemeyen iki hanımefendiden biri, tıpkı benim gibi konuşabilen bir kedicik. Ama benim aksime o bir sarman, miyav.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140107
					],
					"speakerTitle": "Bay Gri Kedi"
				},
				{
					"id": 762140107,
					"content": "Diğer arkadaşımsa çok kibar bir leydi kaniş. Evet, bir köpek ama yine de çok zarif biri, miyav.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140108
					],
					"speakerTitle": "Bay Gri Kedi"
				},
				{
					"id": 762140108,
					"content": "Biri kedi, diğeri köpek olsa da ne zaman birlikte çay içmeye otursak her zaman harika vakit geçiririz, miyav!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140109
					],
					"speakerTitle": "Bay Gri Kedi"
				},
				{
					"id": 762140109,
					"content": "Lütfen, Miyavranopolis'in huzuru için bana bir pati uzat, miyav!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bay Gri Kedi"
				},
				{
					"id": 762140104,
					"content": "Vay be, bu devirde \"kahraman\" olmak ne kolay.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140105
					]
				},
				{
					"id": 762140105,
					"content": "Ayrıntılara çok takılmayalım, miyav. Eğer efsanevi kutsal kılıca zaten sahipsen bahsettikleri Saf Kaseyi bulsan da bulmasan da kahraman kahramandır, miyav.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140106
					],
					"speakerTitle": "Bay Gri Kedi"
				}
			]
		},
