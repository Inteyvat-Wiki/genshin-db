			"trigger": {
				"objectNames": [
					"Taisuke",
					"Eiko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722110101,
					"content": "Eiko Hanım, nereye gideceğiz şimdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110102
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722110102,
					"content": "Ah... Biraz dinlenelim bence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110103
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722110103,
					"content": "Hımm. Sizmişsiniz. Sizin için ne yapabiliriz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110104
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722110104,
					"content": "İşinin ehli bir şef arıyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110105
					]
				},
				{
					"id": 722110105,
					"content": "Şef mi arıyorsunuz? Seirai Adası'nda mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110106
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722110106,
					"content": "Ama durum şu, Neko bizden...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110107,
					"content": "Ha. Leydi Neko sizden yemek yapmanızı istiyor, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110108
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722110108,
					"content": "Ah be! Keşke yemek yapmayı becerebilseydim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110109
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722110109,
					"content": "Diğer bir deyişle \"Bu malzemelerden bir kediye nasıl yemek yapacağız?\" sorununa yardımcı olacak bir şef arıyorsunuz, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110110
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722110110,
					"content": "Bir düşüneyim... Şef... Şef...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110111
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722110111,
					"content": "Inazuma Şehri'ne gidip Kiminami Restoranındaki Kiminami Anna'ya sormayı deneyebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110112
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722110112,
					"content": "Hem çok iyi birisi hem de iyi yemek yapar. Size yardım edebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110113
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722110113,
					"content": "Teşekkürler, gidip bir bakalım ona.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110114
					]
				},
				{
					"id": 722110114,
					"content": "Teşekküre gerek yok. Hadi gidin artık, Taisuke ile sonraki keşiflerimizi planlamamız gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110115
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722110115,
					"content": "Hehe, bu tapınak işi iyiye gider umarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110116
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722110116,
					"content": "Yoksa sizin ve Neko'nun sarf ettiği bunca emek boşa gidecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eiko"
				}
			]
		},
		{
