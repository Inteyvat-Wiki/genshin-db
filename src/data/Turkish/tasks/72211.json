			"dialogs": [
				{
					"id": 722110801,
					"content": "Ah, sizsiniz. Tam da yardıma ihtiyacım vardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110802
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110802,
					"content": "Sorun nedir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110803
					]
				},
				{
					"id": 722110803,
					"content": "Sayenizde tapınak yepyeni oldu. İnsanlar çok yakında buraya tekrar uğramaya başlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110804
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110804,
					"content": "Ufaklıklara gelecek ziyaretçilerin önünde rezil olmamaları, ağırbaşlı hareket etmeleri için ders veriyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110805
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110805,
					"content": "Başıboş koşuşturmaya o kadar alışkınlar ki maalesef öğütlerimi dinlemiyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110806
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110806,
					"content": "Ama kurnazca bir planım var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110807
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110807,
					"content": "Kurnazca plan derken?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110808
					]
				},
				{
					"id": 722110808,
					"content": "Daha çok ama çok gençken ben de her yerde oynamayı severdim. Hibiki, beni ve diğer kedileri hizaya sokmak için lezzetli bir yemek yapardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110809
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110809,
					"content": "Lezzetli mi dedin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110810,
					"content": "Ne zaman o yemeği yapsa kediler ağaçlardan, çatılardan koşup gelirdi hemen. Ne kadar sıcak olursa olsun, hatta dilimiz de yansa o yemeğe karşı koyamazdık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110811
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110811,
					"content": "Hibiki her seferinde koca bir kazan dolusu yapardı, hem insanlar hem de kediler yemeği paylaşırdı. Tapınağı ziyarete gelenler bile kendi paylarını alırlardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110812
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110812,
					"content": "Ah ama şu obur Domeki... Öyle böyle değil, çok fazla yerdi. Hayatımda o kadar çirkin bir görüntü görmedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110813,
						722110814
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110813,
					"content": "Yani...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110815
					]
				},
				{
					"id": 722110815,
					"content": "Güzel, senden de bir şey kaçmıyor. Evet, senden yemek yapmanı istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110816
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110816,
					"content": "Hikmetine laf etmek istemem ama...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110817
					]
				},
				{
					"id": 722110817,
					"content": "Bu yemeğin nasıl yapılacağını biliyor musun peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110818,
					"content": "Miyav, miyav?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110819
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110819,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110820
					]
				},
				{
					"id": 722110820,
					"content": "Bu tür detayları size bırakabiliyor olmam gerekmiyor mu? Her şeyi benim mi yapmam gerek?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110821
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110821,
					"content": "Ah... O yemek gerçekten muhteşemdi! Yemeğin neye benzediğini unuttum, en son yememin üzerinden uzun yıllar geçti ama hâlâ tadı damağımda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110822
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110822,
					"content": "#Görünüşe göre yine iş başa düştü {NICKNAME}. Tapınak için buna değer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110823,
						722110824
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110823,
					"content": "Yemeğe ne konuyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110826
					]
				},
				{
					"id": 722110826,
					"content": "Tabii ki hatırlıyorum. Balık eti, hayvan eti, suda büyüyen çim ve beyaz pilav.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110827
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110827,
					"content": "Ah. Balık, Çiğ Et, Yosun ve Pirinç demek istedin. Yemek nasıl yapılıyordu peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110828
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110828,
					"content": "Hiçbir fikrim yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110829,
						722110831
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110829,
					"content": "Galiba bir şefe sormamız gerekecek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110830
					]
				},
				{
					"id": 722110830,
					"content": "Tabii ama... Kedi maması yapmayı bilen şefi nereden bulacağız? Hımm... Taisuke ve Eiko'ya soralım bakalım. Belki onlar ne yapılacağını biliyordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110831,
					"content": "Şu iki maceracıya soralım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110832
					]
				},
				{
					"id": 722110832,
					"content": "Ah doğru! Taisuke ve Eiko maceracı olduklarına göre bir şeyler biliyorlardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110824,
					"content": "Asıl niyetini biliyorum Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110825
					]
				},
				{
					"id": 722110825,
					"content": "Olur mu öyle şey, Paimon kedilerin dostudur! Neko, yemeğe hangi malzemelerin konduğunu hatırlıyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110826
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110814,
					"content": "Yemek yapmamı mı istiyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110815
					]
				}
			]
		},
