				{
					"id": 722110501,
					"content": "Yemeği ufaklıklara götürdün mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110502
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110502,
					"content": "Patilerini yediler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110503
					]
				},
				{
					"id": 722110503,
					"content": "Öyle mi? Harika. Miyav, miyav...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110504
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110504,
					"content": "Böyle fevkalade bir şey yemeyeli uzun zaman olmuştu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110505
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110505,
					"content": "Miyav miyav miyav... Artık aç ya da susuz değilim ama pilavlı bir yemeğin cazibesine de karşı koymak mümkün değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110506
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110506,
					"content": "Dünyada en sevdiğim şey pilavlı yemekler olduğu için şu ufaklığın adını Meshi koydum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110507
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110507,
					"content": "Hibiki'nin yaptığı yemeğin adı neydi peki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110508
					]
				},
				{
					"id": 722110508,
					"content": "Adı mı? Yemeklere ad mı verilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110509
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110509,
					"content": "Bunun adı \"Neşeli Kedi Tabağı\" sonuçta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110510
					]
				},
				{
					"id": 722110510,
					"content": "Çok karmaşık bir admış. Hoşuma gitmedi diyemem ama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110511
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110511,
					"content": "Ayrıca haklısın. Yemekler iyi şeyler ve her iyi şeyin bir adı olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110512
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110512,
					"content": "Miyav, miyav, Hibiki döndüğünde sorarım. Ona yemeğinizi yapabilirsiniz hatta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110513
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110513,
					"content": "O da size kendi yemeğini yapar. Böylece iki lezzetli yemeğin tadına varabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110514
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110514,
					"content": "Tapınağı yenilemek için bundan daha iyi sebep mi olur? Hibiki döndüğünde hep beraber yemek yeriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110515
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110515,
					"content": "Teşekkürler. Elinize sağlık. Miyav miyav.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
