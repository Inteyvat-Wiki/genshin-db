			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kiminami Anna",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722110201,
					"content": "Merhaba, Kiminami Restoranına hoş geldiniz. Ne alırsınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110203
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110203,
					"content": "Neko'ya yemek yapmam gerekiyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110204
					]
				},
				{
					"id": 722110204,
					"content": "\"Neko\" mu? Acaba bu bir kedinin ismi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110205
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110205,
					"content": "Neko'yu tanıyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110206,
					"content": "Hayır ama tam bir kedi ismi olduğunu düşündüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110207
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110207,
					"content": "İçine doğmuş desene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110208
					]
				},
				{
					"id": 722110208,
					"content": "Neyse, boş ver şimdi onu. Olaylar olaylar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110209,
					"content": "Seirai Adası'nda Asase Tapınağı var, bu tapınakta da... konuşan bir kedi mi var? Bu kedi de senden yemek yapmanı mı istedi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110210
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110210,
					"content": "Bu... Bu gerçek, değil mi? Böyle bir şeyi ilk kez duyuyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110211,
						722110212
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110211,
					"content": "Elbette, şüphen olmasın...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110213
					]
				},
				{
					"id": 722110213,
					"content": "Seirai Adası mıydı? Fırsatını bulduğum an gidip bakacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110214
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110214,
					"content": "Neko'nun yemeğine dönsek...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110215
					]
				},
				{
					"id": 722110215,
					"content": "Ah, doğru... Unuttum neredeyse. Bir düşüneyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110216
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110216,
					"content": "Hımm, kedilerin seveceği bir yemek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110217
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110217,
					"content": "Zor mu olacak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110218,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110219
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110219,
					"content": "Zor olacak, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110220
					]
				},
				{
					"id": 722110220,
					"content": "Bu, Kiminami soyadı için büyük bir imtihan! Ne olursa olsun bu imtihanı başarıyla geçeceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110221
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110221,
					"content": "Şimdi. Balık, Çiğ Et, Yosun ve Pirinçten öyle bir yemek yapacağız ki kediler bile patilerini yiyecek. Bu iş bende Gezgin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110222
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110222,
					"content": "Paimon da biraz istiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110223,
						722110224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110223,
					"content": "Bana da ayırın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110225
					]
				},
				{
					"id": 722110225,
					"content": "Tabii ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110226
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110226,
					"content": "Ben tarifi nasıl oluşturacağımı düşünürken siz de bana üç porsiyon Yosun hazırlayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110227,
						722110229
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110227,
					"content": "Tamamdır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110228
					]
				},
				{
					"id": 722110228,
					"content": "Size bırakıyorum o zaman. Üç porsiyon yeterli olur. Bulduğunuzda gelip bana verin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110229,
					"content": "Ne yemek yapacağını buldun mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110230
					]
				},
				{
					"id": 722110230,
					"content": "Bazı fikirlerim var ama henüz kafamda oturtamadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110231
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110231,
					"content": "Şimdilik üç porsiyon Yosun bulmama yardım etseniz yeterli. Şimdiden sağ olun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110224,
					"content": "Bu iş sende o zaman.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110225
					]
				},
				{
					"id": 722110212,
					"content": "Gidip kendin bakabilirsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110213
					]
				}
			]
		},
