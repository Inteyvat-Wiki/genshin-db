			"dialogs": [
				{
					"id": 722110702,
					"content": "Harika! Bir dakika. Galiba... Galiba ne yapacağımı artık biliyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110703
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110703,
					"content": "Oldu bu iş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110704
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110704,
					"content": "Üff, ne güzel koktu! Paimon tadına bakmaya can atıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110705,
					"content": "Yemeğe ne ad verelim? Hımm... Konuşan bir kedi için yaptığımıza göre yemeğe de Neşeli Kedi Tabağı diyelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110706
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110706,
					"content": "İşte! Yemeğiniz hazır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110707
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110707,
					"content": "Ah, unutmadan size yemeğin tarifini de yazayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110708
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110708,
					"content": "#Yaşasın! Çok yakında menüde {NICKNAME} Usta'nın Kedicik Yemeklerini görürüz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110709,
						722110712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110709,
					"content": "Sen kedi misin ki Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110710
					]
				},
				{
					"id": 722110710,
					"content": "Hey! Çok ayıp! Güzel yemek evrensel bir dildir, bilmiyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110711,
					"content": "Neyse, çok sağ olun Bayan Kiminami.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110713,
					"content": "Hiç önemi yok! Yemeği ve tarifi Neko'ya hediye olarak götürün yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110714
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110714,
					"content": "Vaktim olunca ben de Asase Tapınağına gidip onu ziyaret edeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110715
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110715,
					"content": "Tamamdır, artık gidebilirsiniz. Neko'yu bekletmeyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 722110712,
					"content": "Teşekkürler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110713
					]
				}
			]
		},
