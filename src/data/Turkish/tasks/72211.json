					"content": "Bu koku... Yaptınız demek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110402
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110402,
					"content": "Aynen öyle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110403
					]
				},
				{
					"id": 722110403,
					"content": "Miyav, miyav! Muhteşem! Bir tadına bakayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110404
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110404,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110405
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110405,
					"content": "Hımm, Hibiki'nin yaptığından biraz farklı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110406
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110406,
					"content": "Güzel olmuştur ya. Hadi biz de tadına bakalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110407,
					"content": "Üff, harika olmuş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110408,
					"content": "Miyav.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110409
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110409,
					"content": "(Hibiki denen kişinin yaptığından farklı olduğu için Neko mutsuz mu oldu acaba?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722110410,
					"content": "Pek güzel olmuş. Sahiden bu işi biliyorsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110411
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110411,
					"content": "Afiyet olsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110412
					]
				},
				{
					"id": 722110412,
					"content": "Hibiki'nin yaptığı yemekten epey farklı, evet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110413
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110413,
					"content": "Fakat yemeği yerken hissettiklerim Hibiki'yle yemek yerken hissettiklerimle aynıydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110414
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110414,
					"content": "Bu niye böyle oldu insan? Siz insanlar tuhaf büyüler yapabiliyor musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110415,
						722110416
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110415,
					"content": "Biri sana yemek yapalı uzun zaman olduğu içindir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110417
					]
				},
				{
					"id": 722110417,
					"content": "Yine de teşekkür ederim. Böyle lezzetli bir yemek yemeyeli uzun yıllar olmuştu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110418
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110418,
					"content": "Ufaklıklar da bunu pek sever. Bu yemekten onlara da götürür müsün?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722110419
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110419,
					"content": "Ben sevdiysem onlar da sever. Belki bu kadar leziz bir yemeği yedikten sonra uslanırlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722110416,
					"content": "Yemeği yapan kişi içine sevgisini de kattığı içindir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722110417
					]
				}
			]
		},
