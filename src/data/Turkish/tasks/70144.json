			"trigger": {
				"objectNames": [
					"Iris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701440101,
					"content": "Hava akımı hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701440102
					]
				},
				{
					"id": 701440102,
					"content": "Ne olmuş? Araştırmalarında bir şey mi buldun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440103
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701440103,
					"content": "Bulduklarım bunlar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701440104
					]
				},
				{
					"id": 701440104,
					"content": "Tanrım... Burada ne zaman ortaya çıkacak acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440105
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701440105,
					"content": "Araştırdığın için teşekkürler, durumu Loncaya ben iletirim. İşte ödülün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				}
			]
		},
		{
			"id": 7014402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"99902",
							"3"
						],
						"stepId": 99902,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701440201,
					"content": "Benim için bir görevin var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701440202
					]
				},
				{
					"id": 701440202,
					"content": "Bir görev mi? Zamanlaman daha iyi olamazdı! Tam da garip hava akımını araştırması için deneyimli bir maceracı bulmalıyım diye düşünüyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440203
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701440203,
					"content": "Garip hava akımı mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701440204
					]
				},
				{
					"id": 701440204,
					"content": "Konu hakkında biraz bilgi vereyim. Yakın zamanda küçük bir kaşif takımı keşif için dağa çıktı. Hayli deneyimli birkaç maceracı da onlara katıldı ve bilinen tüm tehlikelerden uzak bir rota izlediler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440205
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701440205,
					"content": "Ancak nasıl olduysa, yolda ani ve güçlü bir soğuk hava akımıyla karşılaştılar, bu yüzden kamplarına dönmek zorunda kaldılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440206
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701440206,
					"content": "Maceracılar döndüğünde onlarla konuştum. Kullandıkları rotada o kadar güçlü bir hava akımının çıkması mümkün değilmiş. Görünüşe göre bir anda ortaya çıkmış. Doğal olarak oluşan bir olaya benzemiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440207
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701440207,
					"content": "O zamandan beri, birçok maceracı ve araştırmacı aynı durumla karşılaştığından bahsetti. Kendimiz birkaç araştırma yaptıktan sonra, hava akımının kaynağının yerini kesin olarak belirlediğimize inanıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440208
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701440208,
					"content": "Maalesef ki araştırmalara katılan maceracılar hâlâ soğuk yanığı, kas yorgunluğu ve diğer sorunlardan muzdarip. Yani anlayacağın, araştırmalarımızı geçici olarak durdurduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440209
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701440209,
					"content": "Gezgin, ilgini çektiyse bizim yerimize hava akımının kaynağını araştırmaya devam eder misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440210,
						701440212
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701440210,
					"content": "Tabii.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701440211
					]
				},
				{
					"id": 701440211,
					"content": "Çok teşekkürler. Yola çıkmadan önce iyi hazırlandığından emin ol, buna sebep olan ne ise normal değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440215
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701440215,
					"content": "Soracağın başka soru yoksa seni tutmayayım. Araştırmaya başlayabilirsin. Yardımın için çok teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				},
				{
					"id": 701440212,
					"content": "Benim kazancım ne olacak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701440213
					]
				},
				{
					"id": 701440213,
					"content": "Hım... Hemen konuya giriyorsun demek. Merak etme. Lonca, maceracılarına az para verip onları kandırma peşinde değil. Kampa döndüğünde seni bekleyen bir ödül olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440214
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701440214,
					"content": "Bahsettiğim ödülün miktarına gelirsek... Bulacağın şeylerin değerine göre değişir. Neyin ne olduğunu biliyorsun, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440215
					],
					"speakerTitle": "Iris"
				}
			]
		},
