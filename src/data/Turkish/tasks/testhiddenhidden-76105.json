			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Malta"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761050101,
					"content": "#{M#Beyefendi}{F#Hanımefendi}, şuradaki Kaya Yengeçlerini gördünüz mü? Sanırım bir tür ayin yapıyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050102
					],
					"speakerTitle": "Malta"
				},
				{
					"id": 761050102,
					"content": "Sanırım normal halleri bu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761050103
					]
				},
				{
					"id": 761050103,
					"content": "Gerçekten mi? Aa... Sanırım şimdi anladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050104
					],
					"speakerTitle": "Malta"
				},
				{
					"id": 761050104,
					"content": "Nasha Kasabası'nda Kaya Yengeçleri gibi bir sürü insan var. Bazıları kol kola yürür, bazıları da yollarını ayırmadan önce yumruk ve tekmelerle birbirlerini selamlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050105
					],
					"speakerTitle": "Malta"
				},
				{
					"id": 761050105,
					"content": "Sanırım Nasha Kasabası'ndaki insanların da normal halleri böyle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050106,
						761050107
					],
					"speakerTitle": "Malta"
				},
				{
					"id": 761050106,
					"content": "Aynen öyle. Hemen kaptın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761050108
					]
				},
				{
					"id": 761050108,
					"content": "#{M#Beyefendi}{F#Hanımefendi}, bu Kaya Yengeçlerinin hepsinin gölete girmesini sağlayabilir misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761050109
					],
					"speakerTitle": "Malta"
				},
				{
					"id": 761050109,
					"content": "Tüm hazine avcılarını Sancak Gemisi'ne çağırmak gibi! Bunu izlemek çok ilginç olurdu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761051501
					],
					"speakerTitle": "Malta"
				},
				{
					"id": 761051501,
					"content": "#Tüm Kaya Yengeçleri bir araya geldiğinde ne olacağını görmeyi gerçekten çok istiyorum... Şey, {M#Beyefendi}{F#Hanımefendi}, şu an müsait misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Malta"
				},
				{
					"id": 761050107,
					"content": "Aynı şey sayılır mı bilemedim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761050108
					]
				}
			]
		},
