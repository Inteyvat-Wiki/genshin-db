			"dialogs": [
				{
					"id": 737080301,
					"content": "Oh... Sonunda geldik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080302,
					"content": "Yolculuk çok uzundu ama Paimon'a göre Gök Kubbenin Evlatları bölgesindeki Teticpac Tepesi'nin kendine has bir karakteri var. Mantar dostlarımız için burası yepyeni bir deneyim olmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080303,
					"content": "Paimon birkaç manzara resmi getirdi. Mantarların bu resimlerle önlerinde gördükleri manzarayı karşılaştırmasını sağlayabiliriz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080304,
					"content": "Yakından bakıp manzaraları eşleştirebilir ve normalde gözden kaçıracakları küçük ayrıntıları fark edebilirler... Eğer bu ilgilerini uyandırırsa burası daha derin ve kapsamlı bir keşif için doğru yer demektir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080305,
					"content": "♪♫!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080306
					],
					"speakerTitle": "Davul Kafa"
				},
				{
					"id": 737080306,
					"content": "♫... ♩?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080307,
						737080308
					],
					"speakerTitle": "Ateş Saçan"
				},
				{
					"id": 737080307,
					"content": "Bu da bir yöntem tabii.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080309
					]
				},
				{
					"id": 737080309,
					"content": "Hehe, Paimon boş vakit buldukça rehberlik kitaplarını okuyor ve farklı gezi noktalarını inceliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080310,
					"content": "İyi bir rehberin olmazsa olmaz becerilerinden biri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080311,
					"content": "Pekala, Mantar dostlarımız bir denesin bakalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080308,
					"content": "İşini biliyorsun Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080309
					]
				}
			]
		}
