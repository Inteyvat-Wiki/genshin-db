			"dialogs": [
				{
					"id": 737080201,
					"content": "Görünüşe göre mesaj sorunsuz bir şekilde iletilmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080202
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080202,
					"content": "Yeniden karşılaştık Altın Yıldız ve Gümüş Yardımcı. Uzun zaman olmuştu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080203
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080203,
					"content": "İkiniz de ışıl ışıl ve hayat dolusunuz. Sanki aradan hiç zaman geçmemiş gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080204,
						737080208
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080204,
					"content": "Görüşmeyeli uzun zaman oldu Haniyyah!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080205
					]
				},
				{
					"id": 737080205,
					"content": "Gerçekten sizmişsiniz, Haniyyah ile Davul Kafa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080206,
					"content": "O mesajın neden bu kadar tanıdık geldiği belli oldu... Demek ki Paimon ve Davul Kafa arasındaki bağ hâlâ eskisi gibi kuvvetli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080207,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080212
					],
					"speakerTitle": "Davul Kafa"
				},
				{
					"id": 737080212,
					"content": "Sizinle yeniden karşılaşacağımız anı pek çok farklı şekilde hayal etmiştim. Görkemli bir ziyafet ya da yaratıcı bir hoş geldin partisi gibi, sizi sahiden şaşırtacak bir şeyler tasarlamıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080213
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080213,
					"content": "Ancak nihayetinde hepsi biraz fazla resmi geldi. Yoğun olduğunuzdan çok vaktinizi alıp size zahmet vermek istemedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080214
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080214,
					"content": "Üstelik Mantar dostlarımız şu sıralar sessiz ve sakin ortamlardan hoşlanıyor. O yüzden biz de rahat ve doğal bir şekilde bir araya gelelim istedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080215
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080215,
					"content": "Doğru! Haniyyah'nın okuduğu metinler sonunda meyvesini verdi. İnsanın kafası rahat olunca hayat kalitesi de artıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080216
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080216,
					"content": "En keyiflisi de kaygısızca sohbet edebilmek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080217
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080217,
					"content": "♫~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080218
					],
					"speakerTitle": "Ateş Saçan"
				},
				{
					"id": 737080218,
					"content": "Souka da burada! Üstelik Ateş Saçan da... Peki bu kim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080219,
					"content": "Bu benim Mantar dostum, Kasırga Dansçısı. Sen ve Davul Kafa 32'nci turda bizi elemiştiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080220
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080220,
					"content": "Ehehe, bayağı net hatırlıyorsun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080221,
						737080222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080221,
					"content": "Yavaş yavaş hatırlamaya başladım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080223
					]
				},
				{
					"id": 737080223,
					"content": "Her neyse, gördüğünüz gibi değerli dostlar, bir sonraki buluşmamız için zaman veya mekan ayarlamamıza gerek yok artık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080224
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080224,
					"content": "Haniyyah ve ben bu ticaret bölgesini satın aldık ve burayı Küçük Mantar Oyun Alanına dönüştürdük!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080225
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080225,
					"content": "Dur biraz, yani buradaki ekipmanlar yeni masa oyunu için kiralanmadı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080226,
					"content": "Aynen öyle. Artık Bayda Limanı'nda yaşayacak, Mantarlarla ilgili masa oyununu tanıtacak ve hayvanlarla iletişim kurma teorimizi paylaşacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080227
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080227,
					"content": "Ne zaman vaktiniz olursa uğrayıp Mantar dostlarla oynayabilirsiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080228
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080228,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080229,
						737080230
					],
					"speakerTitle": "Davul Kafa"
				},
				{
					"id": 737080229,
					"content": "Yaşasın! Mantar dostlar!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080231
					]
				},
				{
					"id": 737080231,
					"content": "Ayy! Bu gerçekten Paimon'un bugün duyduğu en güzel şeylerden biri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080232,
					"content": "İlk Mantar Turnuvası bittikten sonra Paimon, Davul Kafa ile beraber oynamak için bir sürü fikir bulmuştu. Artık sonunda hepsini gerçekleştirebiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080233,
					"content": "Lafı açılmışken, burayı işletmek epey pahalıya patlıyor olmalı, öyle mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080234
					]
				},
				{
					"id": 737080234,
					"content": "Merak etme, şu anda Mora derdimiz yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080235
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080235,
					"content": "Son zamanlarda Bay Belfort'un yardımıyla Mantar Mekanikus ve Küçük Mantarların Eğlenceli Şöleni gibi masa oyunları sayesinde sermaye biriktirdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080236
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080236,
					"content": "Ayrıca geçmiş deneyimlerimizi toparlayarak canavar eğitimi ve Mantarlar hakkındaki bilgilerimizi daha sistematik bir teori haline getirdik. Hatta birkaç kitap basmayı bile denedik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080237
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080237,
					"content": "Bazı araştırmacılar bana maddi destek sunacak kadar ilgi gösterdi hatta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080238
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080238,
					"content": "Edindiğim bilgileri kullanıp onları başkalarına daha erişilebilir hale getirerek Mora kazanıyorum. Kazandığım Mora da Mantar dostlarımızın daha iyi bir yaşam sürmesine yardımcı oluyor. Her şey olumlu bir döngüye girdi yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080239
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080239,
					"content": "Vay canına, bu harika!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080240
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080240,
					"content": "Gerçekten de Haniyyah her şeyin üstesinden gelebilecek sakin, güvenilir bir... \"Canavar Terbiyesi Teorisi Uzmanı\" olmuş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080241,
					"content": "Hepsi Souka'nın rehberliği sayesinde. Öğrencileri örnek alarak beni kendimi zorlamaya ve öğrenmem gereken becerilerde ustalaşmaya teşvik etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080242
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080242,
					"content": "Hey! Sana bu kadar mütevazı olmanı öğretmedim ama. Ben de mükemmel bir öğretmen değilim. Biri sana iltifat ettiğinde sadece kabul et gitsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080243,
						737080244
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080243,
					"content": "Kolayca başarmışsın gibi konuşuyorsun ama mutlaka zor zamanlar da olmuştur, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080245
					]
				},
				{
					"id": 737080245,
					"content": "Evet, epey zorluk yaşadım. Fakat zamanın geçmişe ve zorluklara sünger çekmesine izin vermeliyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080246
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080246,
					"content": "En büyük pişmanlığım, geçtiğimiz yıl Mantar dostlarımızı eğlenmeleri için pek dışarı çıkarmamış olmam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080247
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080247,
					"content": "Kendi canavar terbiyesi teorilerimi derlemeye başladığımdan beri günlerimizin çoğu mağaralarda ve ağaç evlerde geçti. Durmadan yazı yazarken gecem gündüzüme karışmıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080248
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080248,
					"content": "İşin ticari yönü gerçekten yorucu ve teslim tarihleriyle yarıştığımız o günler gerçekten de zordu. Artık Souka'nın bazı düşüncelerini çok daha iyi anlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080249
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080249,
					"content": "Aslında her şey berbat da değildi! Yazmayı bitirdiğin an müthiş tatmin olmuş hissediyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080250
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080250,
					"content": "Evet, katılıyorum. Bitirilen her taslak, kutlama olarak bir kaçamak öğünü hak ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080251
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080251,
					"content": "Ne yazık ki Mantar dostlarımız yemeklerimizin tadına tam anlamıyla varamıyor... Onların gözünde hayat epey sıkıcı bir hal alıyor olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080252
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080252,
					"content": "Bu durum uzun sürerse moralleri bozulur, bu da hiç iyi olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080253
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080253,
					"content": "Madem işleriniz duruldu ve kalacak bir yer buldunuz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080254
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080254,
					"content": "Mantarları eğlenmeleri için dışarı çıkarsak nasıl olur? İstedikleri kadar oyun oynatıp sonra da geri getiririz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080255
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080255,
					"content": "Böylece sen işine odaklanabilirsin, Mantarlar da güzelce vakit geçirmiş olur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080256,
						737080257
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080256,
					"content": "Harika bir fikir Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080258
					]
				},
				{
					"id": 737080258,
					"content": "Ben de!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080259
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080259,
					"content": "Gezilip görülecek yerler konusunda ben tamamen teorik takılıyorum. Tek yapabildiğim kitaplardan araştırmak. Fontaine'e ilk gidişimde nasıl olduysa kaybolmuştum hatta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080260
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080260,
					"content": "Haniyyah benden de beter. Sumeru'da eğlenmek için nerelere gidileceğini bile bilmez. Tüm hayatı işinden ibaret!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080261
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080261,
					"content": "Geçen sefer Fontaine'de epey uzun süre kaldık ama gezi planlaması berbattı. Gözüme kestirdiğim tatlıcıya bile gidemedim ve hep merak ettiğim makaronları kaçırdım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080262
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080262,
					"content": "Öhöm... Ama eğer bu işi Altın Yıldız ve Gümüş Yardımcı üstlenseydi öyle olmazdı. Mantar dostlarımızı etkileyecek ve şahane vakit geçirebilecekleri harika yerler bulurdunuz eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080263,
						737080264
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080263,
					"content": "O zaman doğru noktaları seçmek için düşünsem iyi olur!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080265
					]
				},
				{
					"id": 737080265,
					"content": "Bir saniye, lütfen bu küçük Kamerayı da yanına al...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080266
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080266,
					"content": "Haniyyah sıradan bir Kamera çıkarır ve nazikçe Davul Kafa'nın başına yerleştirir. Davul Kafa herkesi şaşırtacak şekilde, sanki bu tür şeyleri taşırken uçmaya alışkınmış gibi onu kolayca dengeler...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						737080267
					]
				},
				{
					"id": 737080267,
					"content": "Sıradan görünebilir ama aslında çok özel bir hatıra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080268
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080268,
					"content": "Davul Kafa bir keresinde Apam Ormanı'nın güney kesimlerinde kaybolan bir tüccarın çocuğunu kurtarmıştı. Tüccar, minnettarlığını göstermek için Davul Kafa'ya bu Kamera da dahil olmak üzere pek çok hediye verdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080269
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080269,
					"content": "Davul Kafa bu kameranın çektiği resimleri gerçekten çok seviyor. Bu yolculuktaki anılarını saklamak için sen de kullanabilirsin onu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080270
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080270,
					"content": "Bayan Helene adında bir uzman buldum ve Kameranın kasasına Davul Kafa'nın sevdiği nemli ortamlarda bile çalışabilecek şekilde yalıtım yaptırdım... Artık su altında bile çekebiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080271
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080271,
					"content": "Yani bu demek oluyor ki... Bu Kamera da Davul Kafa'nın onur nişanlarından biri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080272,
						737080273
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080272,
					"content": "Helal sana Davul Kafa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080274
					]
				},
				{
					"id": 737080274,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080275
					],
					"speakerTitle": "Davul Kafa"
				},
				{
					"id": 737080275,
					"content": "#Fotoğraf çekme işini de hiç merak etme! {NICKNAME} ve Paimon bu işin kitabını yazdı artık! Ekipmanımızın nasıl göründüğünün bir önemi yok, önemli olan harika kareler yakalamak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080276
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080276,
					"content": "#{NICKNAME}, hadi hazırlanıp yola çıkalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080277
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080277,
					"content": "Mantar dostlarımızın özel yiyeceğini unutma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080278
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080278,
					"content": "Aaa, evet! İyi hatırladın Paimon. Yanına bolca Muhteşem Jöle aldığından emin ol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080279
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080279,
					"content": "Son hali hem daha lezzetli hem de saklaması daha kolay. Ortam ne kadar sıcak olursa olsun bozulmaz, için rahat olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080280
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737080280,
					"content": "Sadece arkadaşlarımıza tek seferde çok fazla vermemeye dikkat et. Fazla yemek onlar için iyi değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080281
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737080281,
					"content": "Hehe, tamamdır! Jöle sırt çantasına giriyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080282
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080282,
					"content": "Geriye kalan tek şey yola çıkmak... Ve seyahatimizden bolca hatırayla geri dönmek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080273,
					"content": "Aferin Davul Kafa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080274
					]
				},
				{
					"id": 737080264,
					"content": "Hem eğlenceli hem de güzel yerler seçeceğim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080265
					]
				},
				{
					"id": 737080257,
					"content": "Ben de Mantar dostları gezdirip oynatmak istiyorum!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080258
					]
				},
				{
					"id": 737080244,
					"content": "Üstesinden geldiğin zorlukları atladın sanki...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080245
					]
				},
				{
					"id": 737080230,
					"content": "Artık birbirimizi her zaman görebiliriz!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080231
					]
				},
				{
					"id": 737080222,
					"content": "Sıcak ve samimi hava rahatlamama yardımcı oluyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080223
					]
				},
				{
					"id": 737080208,
					"content": "Pek hatırlayamadım ama... İkinize de merhaba!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737080209
					]
				},
				{
					"id": 737080209,
					"content": "Gerçekten de Haniyyah ve Davul Kafa! Nilotpala Kupası Canavar Terbiyecileri Turnuvasında tanışmıştık. Onlar bizim eski dostlarımız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080210,
					"content": "Paimon onları Ormos Limanı yakınlarında ve daha sonra Fontaine Şehri'nde gördüğümüzü de hatırlıyor. Ne kadar çok zaman geçmiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737080211,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737080212
					],
					"speakerTitle": "Davul Kafa"
				}
			]
		},
