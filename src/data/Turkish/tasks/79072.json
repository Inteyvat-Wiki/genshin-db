			"dialogs": [
				{
					"id": 790720101,
					"content": "#Aman tanrım, ne büyük şeref! Siz {NICKNAME} olmalısınız, bu durumda yanınızdaki de yoldaşınız Bayan Paimon olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720102
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720102,
					"content": "Hehe, aynen öyle! Doğru bildin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790720103,
					"content": "O kadar ünlü müyüz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790720104
					]
				},
				{
					"id": 790720104,
					"content": "Takımyıldız Metropolü'nde haberler hızlı yayılır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720105
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720105,
					"content": "Tam zamanında geldiniz. Ben de tam \"Uçan Şapkalar\" adlı oyunum için son rötuşları yapıyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720106
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720106,
					"content": "Gerçi ben \"Uçan Şapkacı\" adlı eserin kahramanı olan ve herkese güzel bir şapka yapan şapkacı gibi olamam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720107
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720107,
					"content": "Ama \"Uçan Şapkalar\" oyununun herkese neşe getireceğine inanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720108
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720108,
					"content": "Ayrıca bu oyun için birbirinden tamamen farklı üç mod tasarladım... Merak etmeyin, kurallar çok karmaşık değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720109
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720109,
					"content": "Size garanti veriyorum, oyunu çözmek için bir defa oynamanız yeterli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790720110,
						790720112
					],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720110,
					"content": "Bir deneyeyim bakalım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790720111
					]
				},
				{
					"id": 790720111,
					"content": "Pekala. Bu taraftan lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Devitt"
				},
				{
					"id": 790720112,
					"content": "Şu an meşgulüm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790720113
					]
				},
				{
					"id": 790720113,
					"content": "Hiç sorun değil. Vaktiniz olduğunda gelip beni bulun. Ben bir süre daha burada olacağım.",
