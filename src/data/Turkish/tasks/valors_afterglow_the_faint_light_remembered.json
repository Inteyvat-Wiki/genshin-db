			"trigger": {
				"objectNames": [
					"Muning",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710390201,
					"content": "Hı? Zhiqiong sizinle değil mi? Bakanlıktan haber geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390202
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390202,
					"content": "Haritalarının Huishan Salonuna sağladığı paha biçilemez katkılardan ötürü Sivil İşler Bakanlığı onun için bir istisna yapmaya karar verdi ve... Bir bakayım, onu resmi bir danışman ve rehber olmaya davet etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390203
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390203,
					"content": "Kendisine tebrikler. Görünüşe göre bir başına oraya buraya gitmesi boşuna değilmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390204
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390204,
					"content": "O gitti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390205
					]
				},
				{
					"id": 710390205,
					"content": "Gitti mi? Gitti derken? Sizden önce mi çıktı? Ancak Taşordu bana kimsenin Kanyon'dan ayrıldığını bildirmedi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390206
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390206,
					"content": "Zhiqiong takımdan ayrıldı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390207
					]
				},
				{
					"id": 710390207,
					"content": "Ne? Hımm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390208
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390208,
					"content": "Durun, durun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390209
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390209,
					"content": "Bir dakika, onun keşif takımından ayrıldığını mı söylüyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390210
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390210,
					"content": "Yani, Zhiqiong takımdan mı ayrıldı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390211
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390211,
					"content": "Evet! Bunun neresini anlamadın ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710390212,
					"content": "Anladım. Derhal bir arama ve kurtarma ekibi toplayacağım. Hâlâ Kanyon'daysa onu bulabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390213
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390213,
					"content": "Yine saçma sapan bir şeylerin peşinde olabilir. Belki de başka bir sebepten ayrılmıştır... Ancak fark etmez, onu bulmak zorundayız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390214
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390214,
					"content": "Mevcut halindeyken takımdan ayrı çalışmak çok düşüncesiz bir davranış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390215,
						710390217
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390215,
					"content": "Yardımım lazım mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390216
					]
				},
				{
					"id": 710390216,
					"content": "Hayır, sanmıyorum... Sanırım artık benim de olaya dahil olmam gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390233
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390233,
					"content": "Bana ihtiyacınız olursa orada olacağım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390234
					]
				},
				{
					"id": 710390234,
					"content": "Paimon da orada olacak! Genç maceracımızı geride bırakamayız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710390235,
					"content": "Seyahat ederken de onu arayacağız. Belki bir şekilde ona rastlarız, kim bilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710390217,
					"content": "Zhiqiong hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390218
					]
				},
				{
					"id": 710390218,
					"content": "Yerinde duramayan biri ancak ne olursa olsun hâlâ arkadaşız. Etraftaki en dost canlısı kişi olmayabilirim fakat arkadaşlarımı kolay kolay unutmam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390219
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390219,
					"content": "Daima büyük maceracı hayali gibi bir şeyden bahsedip duruyor. Üstelik geçmişte birkaç kez ağır bir şekilde yaralanmasına, hatta bir keresinde ölümden dönmesine rağmen bunu yapıyor. Biraz olsun durulur sanmıştım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390220
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390220,
					"content": "Gerçek dışı hayallerinden şimdiye dek vazgeçmesini umuyordum. Sonuçta Roald ve Stanley gibi maceracıların hayatları güllük gülistanlık değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390221
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390221,
					"content": "*iç çeker* Ancak bunu hiç beklemiyordum... Dürüst olmam gerekirse senden Kanyon'a gelmeni istememizin doğru bir karar olup olmadığını sorgulamaya başladım... İstememiş olsaydık belki de yeniden bu kadar hevesli olmazdı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390222,
						710390226
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390222,
					"content": "Nihayetinde çabaları sonuç verdi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390223
					]
				},
				{
					"id": 710390223,
					"content": "Sonuç mu verdi? Bence bu biraz fazla faydacı bir yaklaşım. Kanyon'un büyük kısmını haritaladığı için minnettarız ancak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390224
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390224,
					"content": "Ancak \"hayaller\" gibi soyut ve gerçek olmayan şeylerin peşinde koşmak gerçekten kişinin hayatından önemli midir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390225
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390225,
					"content": "Bunu bir türlü anlayamıyorum. Birinin böyle sebeplerle kendini tehlikeye atmasını da aklım almıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390232
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390232,
					"content": "Bu yüzden onu arama işini bana bırak... Yani, daha doğru bir ifadeyle Taşordu arama ekibine bırak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390233
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390226,
					"content": "Sonuçta bu onun tercihi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390227
					]
				},
				{
					"id": 710390227,
					"content": "Sen tercih diyorsun... Bense bahane! Orada ölüp gidecek, bunun farkında mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390228
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390228,
					"content": "*öksürür* Özür dilerim. Biraz sert konuştum. Yine de... Bizim gibi ölümlülerin değiştiremeyeceği şeylerle karşı karşıyayken biraz daha sabırlı olsa olmaz mıydı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390229
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390229,
					"content": "Yirmi veya otuz yıl içinde... hatta belki on yıl içinde daha emniyetli yer altı ekipmanlarımız olabilir! Böylece yer altı haritaları çizmek için keşiflere çıkma konusunda endişelenmesine gerek kalmazdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390230
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390230,
					"content": "Ancak bu gibi şeyleri beklemeye hiç niyeti yok! Hayır efendim, bir ömür sürecek işleri hâlâ bu kadar gençken bitirmek zorunda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390231
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710390231,
					"content": "Bence bu delilik. Üstelik arkadaşı olarak onu öylece kendi haline bırakamam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390232
					],
					"speakerTitle": "Muning"
				}
			]
		}
	]
}