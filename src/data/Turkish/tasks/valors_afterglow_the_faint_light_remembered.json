						710390102,
						710390103
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710390102,
					"content": "Selam Jinwu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390104
					]
				},
				{
					"id": 710390104,
					"content": "!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390105
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710390105,
					"content": "Aman! Be-Beni korkuttun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710390106,
					"content": "Ö-Özür dilerim. Neyse, şey, Zhiqiong'u arıyorsan... o gitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390107,
						710390109
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710390107,
					"content": "Nereye gitti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390108
					]
				},
				{
					"id": 710390108,
					"content": "Bilmiyorum... Birkaç dakikalığına başka bir şeyle ilgileniyordum ve bir baktım... Gitmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390112
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710390112,
					"content": "Onunla konuştum... ancak gitmekte ısrar etti. Onu tatlı sözle, tehditle ve hatta dayakla kalmaya ikna edebileceğimi sanmıyordum zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390113
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710390113,
					"content": "*iç çeker* Umarım ne yaptığını biliyordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390114
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710390114,
					"content": "Umarım biliyordur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390115
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710390115,
					"content": "Şey, o zaman bu durumu Muning'e bildirmeli ve onun Zhiqiong için bir arama takımı toplamasını sağlamalıyım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390116,
						710390117
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710390116,
					"content": "Muning'e gidelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390118
					]
				},
				{
					"id": 710390118,
					"content": "Of, Zhiqiong yine gitmiş! Hadi hemen yüzeye dönelim ve Muning'i bulalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710390117,
					"content": "Biraz sakin ol.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390118
					]
				},
				{
					"id": 710390109,
					"content": "Gittiğinde durumu nasıldı peki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390110
					]
				},
				{
					"id": 710390110,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390111
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710390111,
					"content": "Khedive durumunu kontrol etmişti ve durumunun pek parlak olmadığını söylemişti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710390112
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710390103,
					"content": "İyi misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710390104
					]
				}
			]
		},
		{
			"id": 7103902,
			"completionStepIds": [
				7103903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
