			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101120401,
					"content": "Şuna bakın, <color=#00E1FFFF>Muhteşem Cesaret Kılıcı</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120402
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120402,
					"content": "Emin misin? Paimon'a çok sıradan göründü, biraz da yıpranmış görünüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120403,
					"content": "Dağ yabanileri neden böyle bir hurdanın önünde eğilsin ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120404,
					"content": "(Ahh... Görünüşe göre birileri eski bir kılıcı, şu dağ yabanilerinin etrafında kutlama yaptığı ganimet yığınının içine atmış...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120405
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120405,
					"content": "Bu korkunç durumda! Ve çok basit, ben... Ben söyleyecek söz bulamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120406
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101120406,
					"content": "Hımm... Söylesene Jack, hiç Rüzgar Kristal Kelebeği gördün mü? Mondstadt Şehrinin çevresindeki kırda bulunurlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120407
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120407,
					"content": "Gün ışığında görürsen aldırış etmezsin. Ama ya zifiri karanlıkta görürsen? Muhteşem parıltısı büyüleyicidir. Gerçekten gece gökyüzünde dans eden muhteşem bir kristale benziyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120408,
					"content": "Cesaret de aynı değil midir? Her şey yolundayken cesaret işe yaramaz ama bir zorlukla karşılaştığında ondan kurtulmanı sağlayan şey cesarettir. Karanlıklar içindeyken sana rehberlik eden bir ışık gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120409,
						101120410,
						101120411
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120409,
					"content": "Güzel saçmaladın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120412
					]
				},
				{
					"id": 101120412,
					"content": "Haklısın... Haklısın! O zaman bu, o olmalı... Bu, Muhteşem Cesaret Kılıcı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120413
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101120413,
					"content": "Ahaha, hı hı! O zaman kılıcımızı bulduğumuza göre artık sadece o kalkana ihtiyacımız var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120414
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120414,
					"content": "Hadi çevreyi arayalım! Kesin <color=#00E1FFFF>Dadaupa Geçidi'ndedir</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120415
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120415,
					"content": "Orada birisi var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120416,
					"content": "Stanley mi? Burada ne arıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120417
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120417,
					"content": "Çok tuhaf davranıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120418,
					"content": "Ne oldu? Neden hepiniz bir anda durdunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120419
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101120419,
					"content": "Ha? Ah, hiçbir şey olmadı. Sadece şu Mora saçan hırsız gelinciklerden biri geçti, o kadar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120420
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120420,
					"content": "Ne? Nerede? Görmek istiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120421
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101120421,
					"content": "Belki başka sefere, haha. Bulmamız gereken bir kalkan var, unuttun mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120410,
					"content": "Çok iyi kurtardın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120412
					]
				},
				{
					"id": 101120411,
					"content": "Neredeyse inanıyordum!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120412
					]
				}
			]
		},
		{
			"id": 1011206,
			"completionStepIds": [
				1011206
