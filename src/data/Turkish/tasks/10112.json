					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101121001,
					"content": "Çok teşekkür ederim millet! Onları gerçekten bulduğuma inanamıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121002
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101121002,
					"content": "Anne! Baba! Bulduğum efsanevi silahlara bakın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121003
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101121003,
					"content": "Hey, beklesene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121004
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121004,
					"content": "Şarap sözü vermiştin! Ahh, bu sefer gerçekten çok yardım etmiştim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121005
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121005,
					"content": "Burada ne yapıyorsun Stanley? Dolaşmaya mı çıkmıştın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121006
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121006,
					"content": "Ah... Haha! Hey! Burada ne yapıyorsun ozan? Hayret doğrusu. Sen de... Dolaşmaya mı çıktın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121007
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101121007,
					"content": "Evet, aslında yemek sonrası yürüyüşü. Ayrıca bir arkadaşın bir şeyi aramasına yardım ediyorduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121008
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121008,
					"content": "(Paimon, Stanley'nin sahtekar olabileceğini düşünmeye başladı...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121009,
						101121010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101121009,
					"content": "(Ben de cidden öyle düşünmeye başlıyorum.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101121011
					]
				},
				{
					"id": 101121011,
					"content": "(Stanley Jack'in duygularını incitmemek için kılıcı ve kalkanı önceden buraya mı koydu acaba?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101121012,
					"content": "Maceracılar Dadaupa Geçidi'ne oldukça aşina olmalılar, değil mi? Sonuçta daha önce buradaki savaşlarda bulundunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121013
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121013,
					"content": "Buna inansan iyi olur! Tüm bu alanı gözlerim kapalı geçebilirim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121014
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101121014,
					"content": "Vay canına. O zaman azmine ve hafızana hayran kaldım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121015
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121015,
					"content": "Benim gibi harika bir maceracıdan en az bu kadarı beklenir! Ama siz dikkat etseniz iyi olur. Burası dağ yabanileriyle dolu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121016
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101121016,
					"content": "Ben, ah... Şimdi şeye geri döneceğim, ımm... Ah... Dolaşmaya. Hoşça kalın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121017
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101121017,
					"content": "Suçluluk psikolojisi, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101121018,
					"content": "Pekala, Jack'e kendini övmeye bu kadar kaptırmamalıydı, öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121019
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121019,
					"content": "Yine de... Biraz daha düşününce, merak ettiğimi söylemeliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121020
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121020,
					"content": "Geçmişinden kurtulamayan ve bunun yerine şimdiki zamandan vazgeçen biri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121021
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121021,
					"content": "Merak ediyorum... Acaba böyle biri geleceğe ilk adımını atmaya zorlansaydı hangi yoldan giderdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121022
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121022,
					"content": "Neden bahsediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121023
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101121023,
					"content": "Haha, kendi kendime düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101121024
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121024,
					"content": "#Her neyse {NICKNAME}, bu gece <color=#00E1FFFF>Meleklerin Payı'na</color> doğru yolculuğa çıkalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 101121010,
					"content": "(O kesinlikle bir sahtekar. Şüphesiz.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101121011
					]
				}
			]
