			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dağ Yabanisi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101120601,
					"content": "Şuna bakın, <color=#00E1FFFF>Görkemli Onur Kalkanı</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120602
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120602,
					"content": "Yalancı, yalancı, sana kimse inanmaz! Bu koca bir tahta parçası!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120603,
					"content": "Bir tutma yeri olan koca bir hurda tahta parçası... Aklı başında kim bunu bir kalkan olarak kullanır?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120604,
					"content": "Ayrıca üzerinde şarap lekeleri var... Evet, bunun bir şarap fıçısından alındığına eminim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120605
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101120605,
					"content": "Ama yine de ozan sezgilerim bana bunun Görkemli Onur Kalkanından başka bir şey olmadığını söylüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120606
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120606,
					"content": "Savaşçılar, savaşın izlerini gururla taşır ve kalkanlar da farklı değildir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120607
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120607,
					"content": "Elbette sağlam bir kalkan, savaş alanından uzak durmuş bir kalkandır. Kırılmış ve parçalanmış bir kalkan, sayısız savaşta savaşmış ve hikayesini anlatmak için yaşamış bir kalkan değil midir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120608
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120608,
					"content": "Askerin bedeni yorulmuş ve parçalanmış olmasına rağmen yine de en sonuna, kanının son damlasına kadar savaşır. Böylesine muhteşem bir irade gücü... Onurun gerçek anlamı bu değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120609,
						101120610,
						101120611
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120609,
					"content": "Venti'ye katılıyorum!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120612
					]
				},
				{
					"id": 101120612,
					"content": "Haklısın... Parlak yeni kalkanlar uzun süre yeni ve parlak kalmaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120613,
					"content": "Tamam o zaman... Belki kibarca sorarsak Görkemli Onur Kalkanını ücretsiz olarak almamıza izin verir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120614,
					"content": "*boğazını temizler* Pardon, Bay Dağ Yabanisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120615,
					"content": "Dala?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120616
					],
					"speakerTitle": "Dağ Yabanisi"
				},
				{
					"id": 101120616,
					"content": "#Ay! Tamam, buradan sonrası sende {NICKNAME}! Umarım şu ana kadar biraz Dağ Yabanisi dili öğrenmişsindir. Öğrenmediysen vücut dilini deneyebilirsin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120617,
						101120618,
						101120619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120617,
					"content": "O kalkan için güzel miktarda Mora ödeyeceğim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120622
					]
				},
				{
					"id": 101120622,
					"content": "Biadam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120623
					],
					"speakerTitle": "Dağ Yabanisi"
				},
				{
					"id": 101120623,
					"content": "Eyvah... Bundan <color=#00E1FFFF>hoşlanmış görünmüyor</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120624,
						101120625,
						101120626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120624,
					"content": "Lütfen kopardığım bu tatlı çiçeği al.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120627
					]
				},
				{
					"id": 101120627,
					"content": "Mosi mita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120628
					],
					"speakerTitle": "Dağ Yabanisi"
				},
				{
					"id": 101120628,
					"content": "Yeterince <color=#00E1FFFF>neşeli</color> görünüyor. Belki sonunda pazarlık işe yarar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120631,
						101120633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120631,
					"content": "Venti var şarkı söylemek, sen var kalkanı vermek, tamam mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120632
					]
				},
				{
					"id": 101120632,
					"content": "Hı? Pekala, ısrar ediyorsan bir şeyler mırıldanayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120634
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101120634,
					"content": "Mosi mita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120635
					],
					"speakerTitle": "Dağ Yabanisi"
				},
				{
					"id": 101120635,
					"content": "Yeterince <color=#00E1FFFF>neşeli</color> görünüyor. Belki sonunda pazarlık işe yarar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120633,
					"content": "Mani nini Biaodomu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120636
					]
				},
				{
					"id": 101120636,
					"content": "Biadam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120637
					],
					"speakerTitle": "Dağ Yabanisi"
				},
				{
					"id": 101120637,
					"content": "Eyvah... Bundan <color=#00E1FFFF>hoşlanmış görünmüyor</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120625,
					"content": "Lütfen çaldığım bu dağ yabanisi maskesini al.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120629
					]
				},
				{
					"id": 101120629,
					"content": "Biadam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120630
					],
					"speakerTitle": "Dağ Yabanisi"
				},
				{
					"id": 101120630,
					"content": "Eyvah... Bundan <color=#00E1FFFF>hoşlanmış görünmüyor</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120631,
						101120633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120626,
					"content": "Kucha pupu gusha ye!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120629
					]
				},
				{
					"id": 101120618,
					"content": "Lütfen o kalkanı alabilir miyim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120622
					]
				},
				{
					"id": 101120619,
					"content": "Vin plata dada!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120620
					]
				},
				{
					"id": 101120620,
					"content": "Mosi mita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120621
					],
					"speakerTitle": "Dağ Yabanisi"
				},
				{
					"id": 101120621,
					"content": "Yeterince <color=#00E1FFFF>neşeli</color> görünüyor. Belki sonunda pazarlık işe yarar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101120624,
						101120625,
						101120626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101120610,
					"content": "Katılıyorum. Aradığımız kalkan bu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120612
					]
				},
				{
					"id": 101120611,
					"content": "Venti bugün tam formunda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101120612
					]
				}
			]
		},
