				"points": []
			},
			"dialogs": [
				{
					"id": 700460101,
					"content": "Harika, sanırım artık hazırım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460102
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460102,
					"content": "Göreyim seni Jala! Birkaç güne kalmaz hepsini yakalarsın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460103,
						700460104
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460103,
					"content": "Ya-Yakalarsın derken?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460105
					]
				},
				{
					"id": 700460105,
					"content": "Eyvah! Fontaine'de bir kaçakçı var demek... Hayvan kaçakçıları bugünlerde çok mu para kazanıyor nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460106,
					"content": "Ama Paimon onlara göz açtırmayacak! Bizimle Asayiş Dairesine geliyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460107,
					"content": "... Hah. Demek sizsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460108
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460108,
					"content": "Tabii ki. Aslına bakarsanız ben de Asayişten geliyorum. Yolu gösterebilirim isterseniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460109
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460109,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460110,
						700460112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460110,
					"content": "Güzel. Açık sözlü insanları severim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460111
					]
				},
				{
					"id": 700460111,
					"content": "Bir dakika, bu işte bir yanlışlık var... Yakalanmaktan korkmuyorsun. İflah olmaz bir suçlusun galiba... Belki de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460114,
					"content": "Kanunlara uyan biri de olabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460115
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460115,
					"content": "Daha doğrusu Asayiş beni özel bir çevre koruma danışmanı yani \"Zincirsiz Avcısı\" olarak tuttu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460116
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460116,
					"content": "Özellikle Fontaine sularına gelmiş istilacı balık türlerini avlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460117
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460117,
					"content": "İstilacı... Türler mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460118,
						700460120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460118,
					"content": "Kulağa tanıdık geliyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460119
					]
				},
				{
					"id": 700460119,
					"content": "Evet! Paimon da Mondstadt'ta böyle bir şey duyduğumuzu hatırlıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460122,
					"content": "Neyse, geçmişe takılıp kalmayalım. Önemli olan şu an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460123
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460123,
					"content": "Bu istilacı türler tuhaf inanışları olan bazı tüccarlar tarafından suya bırakıldılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460124
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460124,
					"content": "Bazı balıklar oldukça saldırgan, bazıları çok hızlı çoğalıyor, bazılarıysa özel bir yemle yetiştiriliyor. Sonuç olarak bölgesel su ekosistemi için büyük bir sorun teşkil ediyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460125
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460125,
					"content": "Bu balıklar yerli türlerin yaşam alanlarına girip ekosistemi bozarlarsa Fontaine'in su kalitesi olumsuz etkilenebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460126
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460126,
					"content": "Bunun Fontaine halkının sağlığı üzerindeki etkileri ancak gelecekte anlaşılabilir. Fakat Fonta gibi bir içeceğin tadı aniden değişebilir ve bu da ekonomiyi felakete sürükler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460127,
						700460128
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460127,
					"content": "Fonta'yı yedirmeyiz! Şimdi değil!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460129
					]
				},
				{
					"id": 700460129,
					"content": "Böyle konuşunca sorun daha da ciddi görünüyor! Öylece oturup izleyemeyiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460130,
					"content": "Biz balık yakalamada tecrübeliyiz, sana yardım edebiliriz istersen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460131,
					"content": "Olur tabii! Bunu söylemenizi bekliyordum ben de!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460132
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460132,
					"content": "Tüm istilacı balıklara tuzak kurup onları oltayla yakalayabileceğimiz bir alan oluşturdum bile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460133
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460133,
					"content": "Hadi göreyim sizi Fahri Şövalye ve Beyazlı Yardımcı! Ben de size arkadan destek olacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460134
					],
					"speakerTitle": "Jala"
				},
				{
					"id": 700460134,
					"content": "Paimon'a mı öyle geliyor yoksa bu kız... Bizi çok mu iyi anlıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460128,
					"content": "Pek Fonta içmem gerçi ama önemini anlıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460129
					]
				},
				{
					"id": 700460120,
					"content": "Neymiş o?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460121
					]
				},
				{
					"id": 700460121,
					"content": "Paimon'un hafızası net değil ama uzun zaman önce Mondstadt'ta böyle bir şey duyduğumuza emin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460112,
					"content": "Yoksa bir... Yanlış anlaşılma mı var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460113
					]
				},
				{
					"id": 700460113,
					"content": "Evet. Yakalanmaktan hiç de korkmuş görünmüyor. İflah olmaz bir suçlu herhalde... Belki de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700460104,
					"content": "Ka-Kaçakçı mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460105
					]
				}
			]
		}
	]
}