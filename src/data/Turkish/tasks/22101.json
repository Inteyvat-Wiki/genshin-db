					"content": "Henüz değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010203
					]
				},
				{
					"id": 221010203,
					"content": "Anladım, acele etmene gerek yok. Bu canavarlar gelip giden insanlara sorun yaratabilir ama en azından hana yaklaşmaya cesaret edemezler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010204
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010204,
					"content": "Fuzuli konuşuyorum ancak içeri girmeye cesaret ederlerse... Onları dışarı çıkmaya ikna edebileceğime inanıyorum. Misafirlerimin güvenliği benim için çok önemli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010205
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221010205,
					"content": "Kendini savunmayı bilmeyen kimse şehirden bu kadar uzak bir yerde han işletemez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
