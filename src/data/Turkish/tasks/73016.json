			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arabalika",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730160301,
					"content": "Bir Nara... Üstelik yanında da uçan bir şey var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160302
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160302,
					"content": "#Evet, Paimon'un adı Paimon ve uçabiliyor. Ah, bu da {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160303,
					"content": "Sen Arabalika olmalısın. Bu arada, hiç de bizden korkmuş gibi bir halin yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160304,
					"content": "Altın Nara tıpkı Arapandu gibi kokuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160305
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160305,
					"content": "Evet, zaten bizi de Arapandu gönderdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160306,
					"content": "Sizden zarar gelmez. Arabalika'ya zarar vermek isteseydiniz, Büyük Demir Parçası hareket ederken saldırırdınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160307
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160307,
					"content": "Ah evet. \"Aranaralara yerdeyken saldıracaksın\" dedikleri bu galiba... Dur dur, öyle bir şey yapmayacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160308,
					"content": "Neden olmasın? Arabalika düşman olsaydı, ona iki taraftan saldırmak mantıklı olurdu. Hayvanlar bile avlanırken öyle yapar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160309
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160309,
					"content": "Hımm... Haklısın aslında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160310,
					"content": "Kafan mı karıştı Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160311
					]
				},
				{
					"id": 730160311,
					"content": "Neyse! Asla \"Aranaralara yerdeyken saldırmak\" gibi bir şey yapmayız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160312,
					"content": "Sonuçta Aranaralar bizim dostumuz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160313
					]
				},
				{
					"id": 730160313,
					"content": "Evet, aynen öyle! Aranaralar bizim dostumuz! Dostlarımıza zarar vermeyiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160314,
					"content": "Hıh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160315
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160315,
					"content": "Şey... O niye somurtuyor ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160316,
						730160318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160316,
					"content": "Belki de başta iyi bir izlenim bırakmadın Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160317
					]
				},
				{
					"id": 730160317,
					"content": "Ama Paimon kendisinin yanlış bir şey yaptığını düşünmüyor... Ah... Aranaraların da sağı solu hiç belli olmuyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160320,
					"content": "Doğru! Arapandu'nun dediğine göre, Arabalika'nın Ararakalarisi çok güçlüymüş. O Harabe Muhafızını yenmek için Ararakalarisini kullanmış olmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160321,
					"content": "Paimon, Ararakalarinin ne olduğunu biliyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160322
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160322,
					"content": "E-Evet, Paimon tabii ki de biliyor! Hani şu... Şey yok mu... O çok, çok güçlü... yetenek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160323,
					"content": "Hıh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160324
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160324,
					"content": "Ne! Paimon yine kendisine tepeden bakıldığını hissediyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160325,
					"content": "Biz görevimize odaklanalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160326
					]
				},
				{
					"id": 730160326,
					"content": "Evet... Buraya Varuna Mekanizmasının iyileşmesine yardım etmeye geldik! Buralarda bir yerde dalların ve yaprakların olması gerekmiyor mu? Paimon niye onları göremiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160327,
					"content": "Ne dalı? Ne yaprağı? Daha çok kök gibi bir şey bunlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160328
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160328,
					"content": "Cidden öyle mi? Ama Arapandu demişti ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160329,
					"content": "Varuna Mekanizması tüm gücünü Vana'nın altındaki kök sisteminden alıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160330
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160330,
					"content": "Eh... Mantıklı aslında...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160331,
					"content": "Kökler de yerin altında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160332
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160332,
					"content": "Buradaki Taş ve Demir Parçaları Aranaraların değil. Aşağıya inmek için Demir Parçalarını alt etmek lazım. Demir Parçaları çok güçlü ama altın Nara da hiç güçsüz değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160333
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160333,
					"content": "#Ne sandın! {NICKNAME} zaten bir sürü Büyük Demir Parçasının icabına baktı bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160334,
					"content": "O zaman Arabalika bu Naranın ne kadar güçlü olduğunu görmek istiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160335
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160335,
					"content": "Niye yerin altına girdi ki? Yoksa çoktan Harabe Muhafızının oraya mı gitti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160336,
					"content": "#Peşinden gidelim {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160318,
					"content": "Belki de herkese karşı böyledir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160319
					]
				},
				{
					"id": 730160319,
					"content": "Hiç anlamıyorum... Dışarıdan bu kadar tatlı görünüp de böylesine huysuz nasıl olunur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160320
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7301607,
			"completionStepIds": [
				7301607
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301607",
							"2"
						],
						"stepId": 7301607,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arabalika",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730160701,
					"content": "Büyük Demir Parçasını alt ettik. Suyu takip ederek yerin altına girebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160702
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160702,
					"content": "Arabalika buraya çok uzun zamandır gelmemişti. Her şey değişmiş. Yer altında da Büyük Demir Parçalarından olabilir. Arabalika demir kokusu alıyor. Kötü koku... Dikkatli olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160703
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160703,
					"content": "#Nara {NICKNAME} güçlü, korkmaya gerek yok. Paimon tıpkı Aranakula gibi. Güçsüz. Dikkat et. Mantarlar seni yemesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160704
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160704,
					"content": "Senin yanında herkes güçsüz kalıyor zaten! Bu zamana kadar bir sürü Aranara gördük ama Paimon hiçbirinin Harabe Muhafızını bir çırpıda yenebileceğini düşünmüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160705,
					"content": "Paimon daha Aranaraları tanımamış. Aradasha olsaydı Büyük Demir Parçasını saniyesinde yok ederdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160706
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160706,
					"content": "Aradasha'nın Ararakalarisi çok güçlüydü, eskiden...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160707
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160707,
					"content": "Eskiden mi? Peki ya şu an?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160708,
					"content": "Şu an mı? Aradasha için şu an diye bir şey yok. Bu yüzden Arabalika daha fazla çalışmalı. Ararakalari çalışmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160709
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160709,
					"content": "Keşke Paimon da Ararakalari kullanmasını öğrenebilseydi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160710,
						730160714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160710,
					"content": "Öyle bir şey yapabilseydin bütün kapışmaları sana bırakırdım Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160711
					]
				},
				{
					"id": 730160711,
					"content": "#Hehe, sonra {NICKNAME} Paimon'u değil, Paimon onu korurdu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160712,
					"content": "O zaman sana güveniyorum Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160713
					]
				},
				{
					"id": 730160713,
					"content": "Bu işi Paimon'a bırak! Hatta her işi Paimon'a bırakabilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160718,
					"content": "Paimon hayal kurmayı çok seviyor. Bu iyi bir şey mi yoksa kötü bir şey mi emin değilim. Fakat şu an suyun akması için taştan bir cihaz bulmamız lazım. Yoksa yer altına inemeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160719
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160719,
					"content": "Aranara toprağı kazabilir ama suya bir şey yapamaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160720
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730160720,
					"content": "#Tamamdır, etrafa bir bakalım {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160714,
					"content": "Paimon hayatta böyle bir şey öğrenemez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160715
					]
				},
				{
					"id": 730160715,
					"content": "Paimon denerse başarabilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730160716,
					"content": "Bunu diyenlerin çoğu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730160717
					]
				},
				{
					"id": 730160717,
					"content": "Güvenli bir bölge bulalım, bir şeyler yiyelim ve ardından da dinlenelim. Sonrasında da Paimon, Arabalika'dan ona Ararakalari öğretmesini istesin, olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730160718
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7301610,
			"completionStepIds": [
				7301610
