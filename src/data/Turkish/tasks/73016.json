			"dialogs": [
				{
					"id": 730161501,
					"content": "Ne korkunçtu ama! İyi ki Arabalika yardım etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161502,
					"content": "Arabalika size söylemişti. Dikkatsiz Paimon. Başı belaya girer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161503
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161503,
					"content": "Tamam, tamam, Paimon halleder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161504,
					"content": "Harabe Muhafızları da kendi işlerini yapmak için buradalar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161505
					]
				},
				{
					"id": 730161505,
					"content": "Evet, muhafızlar da kesin buradaki bir şeyi koruyor olmalı. Sonuçta biz de onlar için yabancıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161506,
					"content": "#Nara {NICKNAME} ve Paimon, Vana'ya yabancı ama Arabalika değil. Devasa Demir Parçası mantıklı değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161507
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161507,
					"content": "Arabalika ona öğretecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161508
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161508,
					"content": "Vay... İleride Paimon da iyi olacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161509,
					"content": "Bu sözünü sana hatırlatacağım Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161510
					]
				},
				{
					"id": 730161510,
					"content": "Hatırlat tabii! Yarından... Hayır, bugünden itibaren başlıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161511,
					"content": "#Buradaki taşı yalnızca Aranaralar uyandırabilir. Gerisini Arabalika'ya bırakın Nara {NICKNAME} ve Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161512
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161512,
					"content": "Oooo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161513,
					"content": "Varuna Mekanizmasını iyileştirmemize bir adım daha yakınız! İyileştiği zaman Apam Ormanı'ndaki sporların çoğu yok olacak... Düşüncesi bile Paimon'un burnunu kaşındırıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161514
					],
					"speakerTitle": "Paimon"
				},
				{
