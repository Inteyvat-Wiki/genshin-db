			},
			"dialogs": [
				{
					"id": 730161001,
					"content": "Onlar sanki... Bozulmuş gibi görünüyorlar! Hiç hareket etmiyorlar! Of. B-Bu Paimon'u korkuttu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161002,
					"content": "Hehehe! Yani sadece bir yığın paslanmış Demir Parçası, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161003,
					"content": "Dikkatsiz Paimon. Vana artık tehlikeli. Başın belaya girer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161004
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161004,
					"content": "Arabalika da çok katıymış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161005,
					"content": "Hayır, sen fazla dikkatsizsin Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161006
					]
				},
				{
					"id": 730161006,
					"content": "Öyle demek? Peki... Paimon, Arabalika kadar katı olursa onun kadar güçlü olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161007,
					"content": "Kendine karşı katı olmalısın Paimon, başkalarına değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161008
					]
				},
				{
					"id": 730161008,
					"content": "Tamam o zaman, Paimon da artık katı kurallar koyacak... Yarından itibaren!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161009,
					"content": "Neyse, taşın dalları burada olduğuna göre artık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161010,
					"content": "Üç taşı da bu yöne doğru çevirmemiz lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161011
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161011,
					"content": "Paimon da tam onu diyecekti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161012,
					"content": "Yalnız... Arabalika diğer Aranaralar gibi konuşmuyor. Lafı hiç dolandırmıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161013,
						730161015
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161013,
					"content": "Gerçi böylesi daha kolay anlaşılıyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161014
					]
				},
				{
					"id": 730161014,
					"content": "Ne söyleyecekse doğrudan söylüyor ve kolayca anlaşılıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161017
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161017,
					"content": "Arapandu çok düşünür ama Arabalika çok düşünmez. Arabalika'nın işi korumaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161018
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161018,
					"content": "Arapandu bir zamanlar Nara Varuna ile birlikte Vana'yı korumuştu. Nereden geldiği bilinmeyen kara çamuru defedip Varuna Mekanizmasını iyileştirmişlerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161019
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161019,
					"content": "Nara Varuna Vana'dan ayrılalı çok uzun zaman geçti. Belki bundan sonra Utsava Festivaline de gelmez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161020
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161020,
					"content": "Arapandu mutlaka durumun farkındadır. Üzerinden çok uzun yıllar geçti. Küçük tohumlar büyüyüp kocaman birer ağaç oldu. Vana'dan ayrılan o Nara bir daha asla geri gelmeyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161021
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161021,
					"content": "Arapandu'nun arzusu Varuna Mekanizmasını yeniden iyileştirmek. Vana için, Utsava Festivali için ve Nara Varuna için...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161022
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161022,
					"content": "Paimon şimdi anladı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161023
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161023,
					"content": "Arabalika hiç Nara Varuna ile tanışmadı ama onun hikayesi Vana'da iyi bilinir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161024
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161024,
					"content": "Arabalika, Arapandu kadar çok düşünmez. Arabalika'nın tek bildiği Aranaraları ve Vana'yı korumak için daha güçlü olması gerektiği.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161025
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161025,
					"content": "Nara Varuna artık burada değil ama Aranaralar hâlâ Varuna Mekanizmasını iyileştirebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161026
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161026,
					"content": "Evet! Biz de yardım edeceğiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161027
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161027,
					"content": "#Buradaki demir kokusu bir garip. Nara {NICKNAME}, Arabalika bu işi sana bırakacak. Burada bekleyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161028
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730161028,
					"content": "Paimon, Arabalika'yı rahatsız eden şeyi bilmiyor... Gerçi bu orman hakkında bizden çok daha fazla şey biliyorsundur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161029
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161029,
					"content": "#Neyse, etrafa saçılan üç yaprağı aramaya başlayalım {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730161015,
					"content": "Pek Aranaraların yapacağı bir hareket değil aslında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730161016
					]
				},
				{
					"id": 730161016,
					"content": "Gerçi hangi hareket Aranaraların yapacağı bir hareket ki... Aman, Paimon anlamıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730161017
					],
					"speakerTitle": "Paimon"
				}
			]
		},
