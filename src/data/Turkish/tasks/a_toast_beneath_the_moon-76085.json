				},
				{
					"id": 760520504,
					"content": "T-Tadı mı yok?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520505,
					"content": "Evet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520506,
						760520507
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760520506,
					"content": "Belki de çok hızlı içmişsindir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520508
					]
				},
				{
					"id": 760520508,
					"content": "Ha... Teşekkürler, almayayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520509
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760520509,
					"content": "Bir zamanlar insanların hasat zamanında neden o kadar neşeli olduklarını anlayamamıştım. Sonra bir gün, daldan sarkan olgun bir meyveye uzandım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520510
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760520510,
					"content": "Dokusundaki canlılığı hissettim. Güneş ışığının, suyun, toprağın ve havanın vücut bulmuş organik bir hali gibiydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520511
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760520511,
					"content": "Her ısırıkta, dalgaların serin, beyaz köpükleri gibi akın eden ferahlatıcı bir tatlılık hissettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520512
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760520512,
					"content": "Ve aromanın karşı konulmaz gücünü böyle anladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520513
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760520513,
					"content": "Aa, çok ilginçmiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520514,
					"content": "Sonra da bu yaşam enerjisini kendimize alarak doğanın döngüsünü tamamlıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520515
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760520515,
					"content": "Aa, birdenbire karanlıklaştı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760520516,
					"content": "Bu yüzden taze meyveyi tercih ederim. Bu dünyadan ne aldığımı, onu almadan önce nasılsa öyle görmeme olanak tanır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520517
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760520517,
					"content": "Ve bu dünyaya karşılığında ne borçlu olduğumu hatırlatıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760520507,
					"content": "Bir tane daha yapayım mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520508
					]
				}
			]
		},
