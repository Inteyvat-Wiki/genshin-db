					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760850602,
					"content": "Bu çok lezzetli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850603
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760850603,
					"content": "Şimdiye kadarki favorim bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850604
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760850604,
					"content": "Vay canına! Sonunda Columbina'nın sevdiği bir içecek oldu! Paimon çok mutlu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760850605,
					"content": "Şey... Affedersiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850606
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760850606,
					"content": "Paimon bir özet geçsin. Keskin bir acılık olmamalı, doğrudan meyve suyu eklenmemeli, süt eklenebilir ama eklenmese daha iyi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760850607,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850608
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760850608,
					"content": "Demek bu \"hafif içimli\" bir içecek...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760850609
					]
				},
				{
					"id": 760850609,
					"content": "Tarifi çözmemiz çok iyi oldu! İleride içecekleri tam da senin istediğin gibi hazırlayabileceğiz artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760850610,
					"content": "... İleride mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850611
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760850611,
					"content": "Elbette, biz arkadaşız sonuçta! Ne zaman bir şeyler içmek istersen bize haber ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760850612,
					"content": "Bir dakika, içeceğini bitirmeyişinin sebebi bu mu yoksa? Bunu son bardağın olduğu için içmediğini söylemeyeceksin, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760850613,
					"content": "Şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850614
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760850614,
					"content": "Sorun değil. Merak etme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760850615
					]
				},
				{
					"id": 760850615,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760850616
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760850616,
					"content": "Elinize sağlık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Küçük Hanım"
				}
			]
