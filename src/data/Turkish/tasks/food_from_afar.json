			"dialogs": [
				{
					"id": 120060801,
					"content": "Selam Gezgin, her şey yolunda mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060802
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060802,
