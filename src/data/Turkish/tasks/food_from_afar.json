			"dialogs": [
				{
					"id": 120060401,
					"content": "Giysiniz hazır Bayan Kamisato. Sizin için katlayıp paketledim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060402
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 120060402,
					"content": "Bir de, üzerine konuştuğumuz diğer parça da hazır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060403
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 120060403,
					"content": "Çok teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060404
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060404,
					"content": "Hayır, ben teşekkür ederim! Güzel bir giysi, üzerinde çalışmak çok keyifliydi. Gelecek sefer görüşürüz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060405
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 120060405,
					"content": "Gezgin, sana bir hediyem var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060406
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060406,
					"content": "Gerçekten mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060407
					]
				},
				{
					"id": 120060407,
					"content": "Vay canına... Çok şık! Saça mı takılıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060408,
					"content": "Beyaz balıkçıl şeklinde bir saç tokası. Süs eşyası olarak da kullanabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060409
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060409,
					"content": "Yardımınızı isteyip karşılığında bir şey vermemek olmazdı, o yüzden işte hediyem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060410,
						120060411
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060410,
					"content": "Çok güzel bir hediye, çok teşekkürler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060412
					]
				},
				{
					"id": 120060412,
					"content": "Beğenmene sevindim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060413
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060413,
					"content": "Beyaz balıkçıllardan söz etmişken, unvanının anlamı da bu, değil mi? Shirasagi Himegimi. Yani bu hediye aslında senden bir parça, senin gibi şık ve güzel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060414,
					"content": "Hehe, gururum okşandı Paimon. Bu hediyenin sana beni hatırlatmasını çok isterim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060415
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060415,
					"content": "Hehe, emin ol hatırlatacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060416,
					"content": "Pekala, almaya geldiğimiz şeyi aldığımıza göre yola koyulabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060417,
					"content": "Tsubaki'yle tanışma zamanı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060411,
					"content": "Ona gözüm gibi bakacağım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060412
					]
				}
			]
		},
