	"talks": [
		{
			"id": 1200601,
			"completionStepIds": [
				1200601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
