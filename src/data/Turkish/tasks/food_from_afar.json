			"dialogs": [
				{
					"id": 120060201,
					"content": "İşte hazır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060202,
					"content": "İşte burada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060203
					]
				},
				{
					"id": 120060203,
					"content": "*koklar* Leziz kokuyor... Sen mükemmel bir aşçısın Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060204
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060204,
					"content": "*iç çeker* Dünyanın dört bir tarafındaki mutfakların yemeklerinde ustalaşabilmeyi çok isterdim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060205
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060205,
					"content": "Tek öğrenmen gereken şey tarifler. İstersen ileride seninle daha fazla tarif paylaşabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060206,
					"content": "Harika! Mutfaktaki uzmanlığınızdan faydalanmayı dört gözle bekliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060207
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060207,
					"content": "Nasıl gidiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060208
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060208,
					"content": "Vay canına, yoksa siz... Bayan Kamisato, bahsettiğiniz yemek bu olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060209
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060209,
					"content": "Evet, Gezginin pişirdiği yurt dışındaki kültüre has yemek bu işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060210
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060210,
					"content": "Rica etsem paket yapabilir misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060211
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060211,
					"content": "Elbette, hiç sorun değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060212
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060212,
					"content": "Ah, harika kokuyor! Tadının muhteşem olduğuna eminim. Menüye buna benzer bir şey eklemek istiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060213
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060213,
					"content": "Hehe, nasıl yapıldığını sana öğretelim mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060214,
					"content": "Öğretir misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060215
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060215,
					"content": "Elbette.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060216
					]
				},
				{
					"id": 120060216,
					"content": "En güzel yemek başkalarıyla paylaştığın yemektir. Paimon o nedenle Mondstadt'taki dostlarımızın, bu yemeği Inazuma'dakilerle paylaşmamızı sorun etmeyeceğini düşünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060217,
					"content": "Gerçekten mi? Ah, bu harika, her zaman uluslararası yemeklerin nasıl yapıldığını öğrenmek istemişimdir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060218
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060218,
					"content": "Bana tarifi yazabilirseniz yemeği menümüze eklerim ve herkesin görebilmesi için reklamını da yaparım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060219
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060219,
					"content": "Biz dışarıya kapalı bir millet olduğumuz için insanların yeni bir şey deneme şansları pek olmuyor. Gezgin, sen harikasın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060220
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060220,
					"content": "Ben Bayan Kamisato için bu yemeği paketleyeyim. Lütfen hazır olduğunuzda restorana gelin, yemekleriniz sizi bekliyor olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060221
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060221,
					"content": "Bu tarifi yüksek bir fiyata satabilirdin ama fedakarlık yaparak karşılıksız bir şekilde verdin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060222
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060222,
					"content": "Sen harika bir insansın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060223
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060223,
					"content": "Aa abartma lütfen Ayaka...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060224
					]
				},
				{
					"id": 120060224,
					"content": "Ben ciddiyim... Sana gerçekten hayranım ve senin gibi kişiliği güzel biriyle arkadaş olmaktan gurur duyuyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060225
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060225,
					"content": "Muhtemelen artık tarifi yazman gerekiyor, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060226
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060226,
					"content": "#Evet {NICKNAME}, haydi tarifi tüm ayrıntıları ile yazarak Bayan Kiminami'ye verelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060227,
					"content": "Pekala, pizza diyorduk! Temel malzemelerle başlayalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060228,
						120060230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060228,
					"content": "Mantar + Un",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060229
					]
				},
				{
					"id": 120060229,
					"content": "Dosdoğru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060232,
					"content": "Tamam, şimdi de diğer malzemeleri ekleyelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060233,
						120060235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060233,
					"content": "Lahana + Peynir",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060234
					]
				},
				{
					"id": 120060234,
					"content": "Enfes! İşte bu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060239,
					"content": "Şimdi gelelim pişirme talimatlarına... \"Pizzayı yüksek ısıda fırına yerleştirin ve hamur kızıl altın bir renk alana kadar pişirin.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060240
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060240,
					"content": "Pekala, bu tamam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060241
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060241,
					"content": "Inazuma'nın her yerinde tariflerimiz ve şanımız yürüsün!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060242,
					"content": "Bundan hiç şüphem yok. Bu yemek muhteşem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060243
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060243,
					"content": "Harika, o zaman hadi bu tarifi hemen Bayan Kiminami'ye götürelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060235,
					"content": "Gözyaşı Otu + Fosforlu Mantar",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060236
					]
				},
				{
					"id": 120060236,
					"content": "Xiangling'in sende derin bir etki bıraktığı kesin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060237,
					"content": "Xiangling de kim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060238
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060238,
					"content": "Gerçekten çok yetenekli bir aşçı olan dostumuz. Gerçi bazı tuhaf zevkleri de yok değil... Yine de o, Paimon'un en sevdiklerinden biri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060230,
					"content": "Deniz Mantarı + Eflatun Kavun",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060231
					]
				},
				{
					"id": 120060231,
					"content": "Ciddi misin? Pekala, ne de olsa aşçı sensin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060232
					],
					"speakerTitle": "Paimon"
				}
			]
