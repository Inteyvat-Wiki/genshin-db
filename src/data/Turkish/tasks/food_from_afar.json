			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kiminami Anna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120060101,
					"content": "Geldik mi? Ah, burası şu sokak kenarı yerlerden! Tatlı ve rahat görünüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060102,
					"content": "Hoş geldiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060103
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060103,
					"content": "Bayan Kiminami, nasılsınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060104
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060104,
					"content": "Bayan Kamisato! Mükemmel zamanlama. Rezervasyonunuz tam da... Şimdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060105
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060105,
					"content": "Sanırım öyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060106
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060106,
					"content": "Önceden verdiğim siparişi rica edeceğiz. Konuştuğumuz diğer konuda ise... Yardımınız için teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060107
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060107,
					"content": "Harika, hiç sorun değil. İstediğiniz her şey hazır, sizi bekliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060108
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060108,
					"content": "Gezgin, ufak misafir, lütfen ben yemeklerinizi hazırlarken biraz burada bekleyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060109
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060109,
					"content": "Siz oturun lütfen. Halletmem gereken bir şey var, hemen döneceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060110,
						120060111
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060110,
					"content": "Bir şey mi oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060112
					]
				},
				{
					"id": 120060112,
					"content": "Şey... Öyle bir şey değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060113
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060113,
					"content": "Yalnızca halletmem gereken birkaç ufak şey var. Uzun sürmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060114
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060114,
					"content": "Aceleyle gittiği kesin... Konu neyse önemli olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060115,
					"content": "Siz Bayan Kamisato'nun arkadaşları mısınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060116
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060116,
					"content": "Haha, tüm klasik yemekleri pişiriyoruz. Elbette daha şık yerler var ama buranın yemekleri kendini anlatıyor zaten! Umarım beğenirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060117
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060117,
					"content": "Yıllardır bu işteyiz, Kamisato Klanını oldukça iyi tanırız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060118
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060118,
					"content": "Bayan Kamisato ve erkek kardeşi yemeklerimize çok düşkündür. Çalışanlarını buraya gönderip yemek aldırırlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060119
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060119,
					"content": "Grup rezervasyonu yaptırmasından çok masa ayırtmasına şaşırdım! Bayan Kamisato'nun ilk defa arkadaşlarıyla yemeğe çıktığını görüyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060120
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060120,
					"content": "İlk defa mı? Vay canına... Bu bizi önemli insanlar yapıyor, desene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060121,
					"content": "Elbette öylesiniz. Belki haddimi aşıyorum ama... Diğer insanlardan duyduklarımı söylemiş olayım. Görünüşe göre Bayan Kamisato'nun pek arkadaşı yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060122
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060122,
					"content": "Buna gerçekten şaşırdım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060123
					]
				},
				{
					"id": 120060123,
					"content": "Bu nasıl olur? O herkese karşı çok nazik ve düşünceli, Paimon onun çok popüler olduğunu sanıyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060124,
					"content": "Eskiden ben de öyle düşünürdüm. Anlaşılan toplumsal etkileşime dair kurallar biraz karmaşık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060125
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060125,
					"content": "Çevredeki kimse onun hakkında kötü bir şey söylemez. Hep güzel, şık, zarif olduğunu söylerler. Bu topraklardaki en şanlı klanlardan birine ait olduğunu da unutmayalım. Özetle herkes onu örnek bir genç kadın olarak görür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060126
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060126,
					"content": "Ama sadece o kadar, insanlar ona bakıp bir kusursuzluk örneği görürler ve bağ kurabilecekleri bir şey olabileceğini düşünmezler. Yani sıradan ailelerin çocuklarının çoğu onunla konuşmaya cesaret bile edemez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060127
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060127,
					"content": "Anladınız mı şimdi? O teoride herkesin tanımak istediği bir kız ama pratikte arkadaşlık kurmakta zorlanıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060128
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060128,
					"content": "Paimon bunu asla tahmin edemezdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060129,
					"content": "Onunla pek konuşmayız ama uzun süredir tanışırız. Bu kadar genç yaşta bu kadar çok sorumluluk aldığı için ona hep hayran olmuşumdur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060130
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060130,
					"content": "Bu nedenle bugün buraya arkadaşlarıyla beraber gelmesi beni çok mutlu etti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060131
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060131,
					"content": "Her neyse, rahatınıza bakın, afiyet olsun. Lütfen onunla olabildiğince fazla sohbet edin. Bu çok hoşuna gidecektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060132
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060132,
					"content": "Mahalle için bir iyilik yaptığınızı düşünün... Bizim için ona iyi bakın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060133
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060133,
					"content": "Ah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060134
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060134,
					"content": "Bu da ne? Ayaka'nın sesine benziyordu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060135,
					"content": "*iç çeker* Çok üzgünüm Gezgin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060136,
						120060137
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060136,
					"content": "Patlama mı oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060138
					]
				},
				{
					"id": 120060138,
					"content": "Bir dakika buraya gelebilir misin? Şey... Bir konuda yardımına ihtiyacım var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060139
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060139,
					"content": "Üzgünüm! Seni birdenbire buraya sürüklemek istemezdim ama şey... Bir mutfak faciası yaşadım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060140
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060140,
					"content": "Yani duyduğumuz o gürültü tencereden geldi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060141,
					"content": "Gördüğünüz gibi bu ev restoranın tam yanında. Restoranın sahipleri burada yaşıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060142
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060142,
					"content": "Aslında bu yerleşkenin tamamı ailenin özel mülkü. Bayan Kiminami'den benim için birkaç malzeme ve kap kacak hazırlamasını istemiştim, özel bir yemek pişirecektim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060143
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060143,
					"content": "Neden sen pişirecektin ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060144
					]
				},
				{
					"id": 120060144,
					"content": "Aynen! Yemek istediğin bir şey varsa menüden söyle gitsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060145,
					"content": "Aslında... Tsubaki'ye hediye olarak özel bir şey pişirmek istemiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060146
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060146,
					"content": "Annem defterinde Tsubaki'nin dünya mutfağını sevdiğini yazmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060147
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060147,
					"content": "Ben de, Tsubaki'yle tanışırken yurt dışı kültürlerinden olan bir yemek pişirip hediye etmenin uygun olacağını düşündüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060148
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060148,
					"content": "Yurt dışındaki kültürlerden bir yemek mi? O zaman Inazuma dışındaki bütün yemekler sayılır, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060149
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060149,
					"content": "Öyleyse... Çok fazla seçeneğimiz var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060150,
						120060152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060150,
					"content": "Aslında... Ben mutfakta profesyonel sayılırım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060151
					]
				},
				{
					"id": 120060151,
					"content": "Ben de böyle düşünmüştüm! Seyahatlerinde farklı kültürlerden epey bilgi edinmişsindir. Umarım bölgesel mutfaklar da buna dahildir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060154
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060154,
					"content": "O zaman senden görevi devralmanı isteyebilir miyim? Şahsi bir iyilik olarak... Olur mu? Sana borçlu olurum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060155,
						120060156
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060155,
					"content": "Tabii ki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060157
					]
				},
				{
					"id": 120060157,
					"content": "Harika! Ama... Ne tür bir yemek uygun hediye olur? Mutfaktan çıkıp teslim edilene kadar yemeğe bir şey olmaması gerekiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060158
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060158,
					"content": "Ah, Paimon biliyor! Tam da bu amaca uygun bir yemek var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060159
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060159,
					"content": "Pizza!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060160
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060160,
					"content": "\"Pizza\" da ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060161
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060161,
					"content": "Ekmek tabanına sos sürülüp üstüne çeşitli malzemeler ekleniyor ve fırında pişiriliyor. Müthiş bir şey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060162
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060162,
					"content": "Kulağa çok güzel geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060163
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060163,
					"content": "Buna biraz Inazuma'nın yerel çeşnilerinden eklememiz mümkün mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060164
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060164,
					"content": "Neden olmasın! Pizzaya her şey eklenebilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060156,
					"content": "Hünerlerimi gösterme zamanım geldi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060157
					]
				},
				{
					"id": 120060152,
					"content": "Yemeklerimin olağanüstü olduğu söylenir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060153
					]
				},
				{
					"id": 120060153,
					"content": "Hey! Durumu tuhaflaştırma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060154
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060137,
					"content": "Neler oluyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060138
					]
				},
				{
					"id": 120060111,
					"content": "Dövüş mü var? Destek lazım mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060112
					]
				}
			]
		},
