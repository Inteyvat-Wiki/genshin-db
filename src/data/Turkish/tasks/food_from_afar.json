			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kiminami Anna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120060301,
					"content": "Hey! Tarifi yazdınız mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060601,
					"content": "İşte burada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060602
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060602,
					"content": "Teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060603
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060603,
					"content": "Ayy, bu çok heyecan verici! Hemen yapmak istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060604
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 120060604,
					"content": "Gezgin, Paimon, yemeğinizi geciktirdiğim için lütfen özrümü kabul edin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060605
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060605,
					"content": "Hehe, sorun değil! Karnın ne kadar acıkırsa yemek o kadar lezzetli gelir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060606,
					"content": "Pekala, haydi soğumadan yiyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060607
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060607,
					"content": "Ne düşünüyorsunuz? Inazuma mutfağı damak zevkinize uygun mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060608
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060609,
					"content": "Hepsi çok lezzetliydi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060611
					]
				},
				{
					"id": 120060610,
					"content": "Yeni şeyler denemek güzeldi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060611
					]
				},
				{
					"id": 120060608,
					"content": "Harika! Paimon buna bayıldı... Ah! Ve özellikle de şuradakine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060609,
						120060610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060611,
					"content": "Haha, iyi madem. Rahatladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060612
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060612,
					"content": "Şey... Ben biraz önce yemek yapmaya çalışırken siz... Buranın sahibiyle konuştunuz mu hiç?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060613
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060613,
					"content": "Benim hakkımda, şey... Bir şey dedi mi acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060614
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060614,
					"content": "Dedi ama hiç merak etme. Senin adına çok mutlu olduğunu söyledi, o kadar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060615,
					"content": "Benim adıma... Mutlu mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060616
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060616,
					"content": "Yani... O zaman... Size söylemiş olmalı. Şey dedi mi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060617
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060617,
					"content": "*iç çeker* Ne fark eder ki... Pek arkadaşım olmadığını ben de biliyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060618
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060618,
					"content": "Hey, sorun sen değilsin, çoğu insanın daha önce seninle bire bir konuşma şansı olmamış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060619,
					"content": "Teselli edici sözlerin için teşekkür ederim Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060620
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060620,
					"content": "Ama hepsi doğru. Yani benim... Pek arkadaşım yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060621
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060622,
					"content": "Saçmalama!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060624
					]
				},
				{
					"id": 120060623,
					"content": "Ben senin arkadaşınım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060624
					]
				},
				{
					"id": 120060621,
					"content": "Genellikle bana ya ailem ya da çalışanlar eşlik eder. O yüzden sizi yemeğe çıkardığımı görenler şaşırmış olmalı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060622,
						120060623
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060624,
					"content": "Aynen öyle! Burada iki arkadaşın var işte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060625,
					"content": "Ay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060626
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060626,
					"content": "Teşekkürler... Beni çok mutlu ettiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060627
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060627,
					"content": "Pardon... Bir an kendimi kaybettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060628
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060628,
					"content": "Duygular ifade edilmeli. Onları içinde tutmanın sana bir faydası olmaz, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060629,
					"content": "Katılıyorum! Yani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060630
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060630,
					"content": "Ben sadece beni gerçek bir dost olarak gördüğünüz için ne kadar mutlu olduğumu söylemek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060631
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060631,
					"content": "Tabii ki öyle görüyoruz. Bizim tarzımız bu. Birisi bize iyi davranırsa biz de ona iyi davranırız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060632
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060632,
					"content": "Arkadaşlıklar uzun yıllar sürer! Mesela anneni örnek alalım, defterinde Tsubaki'den bahsetti ve onu bulmak istemene sebep oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060633,
					"content": "Evet! Bence de arkadaşlık çok değerli bir şey. Ben de bizimkinin değerini daima bileceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060634
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060634,
					"content": "Konu tekrar açılmışken bu Tsubaki sahiden kim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060635
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060636,
					"content": "Can kulağıyla dinliyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060637
					]
				},
				{
					"id": 120060635,
					"content": "Sanırım bir fikrim var ama şu anda sadece tahmin sayılır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060636
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060638,
					"content": "...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060639
					]
				},
				{
					"id": 120060637,
					"content": "Bence Tsubaki... Tilki elçisi olabilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060638
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060639,
					"content": "Tilki elçisi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060640
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060640,
					"content": "Evet. Ben öyle düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060641
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060641,
					"content": "Annemin biricik kızı ben bile bu arkadaşını daha önce hiç duymadım. Çok gizemli bir durum. Bu nedenle onun, üstün yeteneklere sahip ama bunu pek belli etmeyen biri olduğunu düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060642
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060642,
					"content": "Üstelik tilki elçileri yeni ortaya çıkmadı. Inazuma'da onlar hakkında kadim zamanlardan bu yana hikayeler anlatılır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060643
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060643,
					"content": "Daha önce Guuji Yae ile tanışmış olmalısınız. Mesela, o bir tilki elçisi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060644
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060644,
					"content": "Bu durum beni düşünmeye sevk etti. Belki de Inazuma'da insanların bilmediği tilki elçileri vardır... Ve belki de Tsubaki onlardan biridir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060645
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060645,
					"content": "Vay canına, yani Inazuma'da da mı doğaüstü varlıklar var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060646
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060646,
					"content": "Yani, \"Inazuma'da da mı\" derken...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060647
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060647,
					"content": "Şey, Inazuma'dan önce Liyue'de biraz zaman geçirmiştik. Orada da Adeptuslar gibi çok sayıda doğaüstü varlık var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060648
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060648,
					"content": "Hem de her türden... Gökyüzünde, yerin altında, suda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060649
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060649,
					"content": "Ciddi misin? Kitaplarda bu tür şeylerin iddia edildiğini görmüştüm ama bunu tecrübe etmiş birinden duymak gerçekten şaşırtıcı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060650
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060650,
					"content": "Yani Liyue ününün hakkını veriyor... Kültürü uzun bir tarihe sahip ve en güzel efsaneler oradan çıkıyor. Oldukça büyüleyici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060651
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060651,
					"content": "Bir ara bizimle beraber Liyue'ye gelmelisin. En güzel tarafı da bir sürü lezzetli yemeğinin olması!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060652
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060652,
					"content": "Gerçekten mi? Çok isterim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060653
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060653,
					"content": "Yemeklerden bahsetmişken, Gezgin, Paimon, doydunuz mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060654
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120060654,
					"content": "Ah, Paimon doydu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060655
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120060655,
					"content": "Muhteşem, o zaman gidip kimonoyu alalım. Sonra da annemin gizemli ve yüce dostunu ziyaret ederiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamisato Ayaka"
				}
			]
		},
