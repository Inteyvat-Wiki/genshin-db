					"Ganyu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110320201,
					"content": "Bayan Ganyu, davetimi kabul ettiğiniz için teşekkür ederim. Siz ikiniz de burada olduğunuz için minnettarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320202
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320202,
					"content": "Evet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110320203,
					"content": "Çok teşekkür ederiz Huixin. Bu yemeği planlamak için çok zahmet ettin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320204
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320204,
					"content": "Aslına bakarsanız... Yardımlarınız için teşekkür etmenin yanı sıra, size söylemek istediğim bir şey var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320205
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320205,
					"content": "Ah? Yardım edebileceğim bir şey varsa hemen söyle. Çekinmene gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320206
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320206,
					"content": "Ah... Hayır, hayır. Yardıma ihtiyacım yok... Söyleyeceklerimi dinleyebilir misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320207
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320207,
					"content": "Zevkle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320208
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320208,
					"content": "Küçük bir kızken babam sizinle ilgili hikayeler anlatırdı Bayan Ganyu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320209
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320209,
					"content": "Babama çok saygı duysam da... Asıl sizin nezaketinize ve güvenilirliğinize her zaman hayranlık duymuşumdur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320210
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320210,
					"content": "Yuehai Konağı personeline katılmaya karar vermemin nedeni size duyduğum hayranlıktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320211
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320211,
					"content": "Beni bu kadar takdir ettiğini bilmiyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320212
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320212,
					"content": "Bununla birlikte Yuehai Konağı'nda çalışmak son derece zormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320213
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320213,
					"content": "Sizin gibi muhteşem bir sekreterle kendimi karşılaştıramam bile. Sonuç olarak genellikle kendimden şüphe ediyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320214
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320214,
					"content": "Katılmıyorum. Bence sekreter olarak çok iyi iş çıkartıyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320215
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320215,
					"content": "Ah, teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320216
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320216,
					"content": "Yıllar içinde ben de anne oldum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320217
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320217,
					"content": "Hah! Yani Tian Amca aslında dedeymiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110320218,
					"content": "Benim gençlik ideallerimin etkisinde kalarak adımlarımı izledi ve Yuehai Konağı'nda sekreter oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320219
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320219,
					"content": "Başta onun için endişelendim, ne de olsa kolay bir iş değildi. Doğruyu söylemek gerekirse bu işe uygun olduğundan hâlâ emin değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320220
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320220,
					"content": "Fakat tüm bu olanlardan sonra... Aldığı kararı desteklemeye karar verdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320221
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320221,
					"content": "Peki fikrini değiştiren ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320222
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320222,
					"content": "Kıdemli meslektaşı olarak sizinle çalışacağı için Bayan Ganyu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320223
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320223,
					"content": "Her zamanki şefkatinizle ona yardım edecek ve ona \"Annen de böyle yapardı\" diyeceksiniz. Heh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320224
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320224,
					"content": "Muhteşem bir an olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320225
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320225,
					"content": "Umarım sizden çok fazla şey istemiyorum; yirmi küsur yıl sonra bile sizin yol göstermenize ihtiyaç duyabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320226
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320226,
					"content": "Huixin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320227
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320227,
					"content": "Ben... Senin için böyle bir anlam taşıdığımı bilmiyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320228
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320228,
					"content": "Heh, tıpkı bana babamın numarasını gösterdiğiniz gibi. Sizin \"tanık\" olmanız insanları rahatlatıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320229
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320229,
					"content": "\"Tanık\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320230
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320230,
					"content": "Liyue Limanı'nın binlerce yıllık geçmişine, nasıl değiştiğine, insanlarının hikayelerine tanık oldum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320231
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320231,
					"content": "Fakat bunun sadece yalnızlığımın kaynağı olduğunu düşünürdüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320232
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320232,
					"content": "Huixin, sözlerinin benim için ne kadar önemli olduğunu bilemezsin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320233
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320233,
					"content": "Liyue Limanı'nın insanlarıyla sadece Rex Lapis'in sözleşmesinin ötesinde bir bağım olduğunu fark etmemi sağladın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320234
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320234,
					"content": "Bana güveniyorlar, beni kabul ediyorlar ve hikayelerine tanık olmamı istiyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320235
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320235,
					"content": "Elbette! Bizim gözümüzde yerinizi kimse dolduramaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320236
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320236,
					"content": "Heheh... Doğru. Bu nedenle seni hayal kırıklığına uğratamam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320237
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320237,
					"content": "Yihuu! Ganyu sonunda mutlu oldu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110320238,
					"content": "Yerimden edilmiş olmama karşın, bunun için savaşmaya hazırım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320239
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320239,
					"content": "Seni hayal kırıklığına uğratmayacağım. Sözleşmemi yerine getireceğim ve Yedi Yıldızın sekreteri olarak çalışmaya devam edeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320240,
						110320241
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320240,
					"content": "Ah... Sana söyledim, sen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110320242
					]
				},
				{
					"id": 110320242,
					"content": "Yine de geri dönüp durumla kendim ilgileneceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320243
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320243,
					"content": "Fakat yokluğumda her şey birbirine girmiş olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320244
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320244,
					"content": "Kaybedecek vaktimiz yok, iş başına!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320245
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320245,
					"content": "Bol şans Bayan Ganyu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320246
					],
					"speakerTitle": "Huixin"
				},
				{
					"id": 110320246,
					"content": "Nee? Hemen gidiyor muyuz? Paimon hâlâ aç!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110320241,
					"content": "Kovulmadın. Sadece bir yanlış anlaşılma oldu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110320242
					]
				}
			]
		},
		{
			"id": 1103203,
