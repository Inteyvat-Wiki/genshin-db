					"Baiwen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110320301,
					"content": "Aaahh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320302
					],
					"speakerTitle": "Baishi"
				},
				{
					"id": 110320302,
					"content": "Baishi, iyi misin? Ayakta mı uyudun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320303
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 110320303,
					"content": "Bak... Bak kim geri dönmüş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320304
					],
					"speakerTitle": "Baixiao"
				},
				{
					"id": 110320304,
					"content": "Dinlenmeye bile zamanınız var demek? Görünüşe göre siz üçünüz yerimi doldurmaya uygunmuşsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320305
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320305,
					"content": "Hayır, öyle değil! Sadece... Çok uzun zamandır çalışıyoruz. Ara vermeseydik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320306
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 110320306,
					"content": "Sizi tekrar görecek kadar uzun süre ayakta kalamazdık Bayan Ganyu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320307
					],
					"speakerTitle": "Baixiao"
				},
				{
					"id": 110320307,
					"content": "Bayan Ganyu, sizi özledik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320308
					],
					"speakerTitle": "Baishi"
				},
				{
					"id": 110320308,
					"content": "Heheheh. Sadece bir kez karşılaşmış olmamıza karşın güzel sözlerinize teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320309
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320309,
					"content": "Geri dönmeniz ve görevinizi yeniden üstlenmeniz için gece gündüz dua ettik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320310
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 110320310,
					"content": "Siz bizim için tüm yaşamı kurtarmak üzere insanların dünyasına gönderilen bir Adeptus gibisiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320311
					],
					"speakerTitle": "Baishi"
				},
				{
					"id": 110320311,
					"content": "Daha önce kıskançlıktan yapılan şikayetleri unutun, lütfen bizi bu zorlu işlerden kurtarın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320312
					],
					"speakerTitle": "Baixiao"
				},
				{
					"id": 110320312,
					"content": "Tamam, tamam anlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320313
					],
					"speakerTitle": "Ganyu"
				},
				{
					"id": 110320313,
					"content": "Lütfen elinizdeki dosyaları idari işler, ticari işler ve sivil işler olarak ayırın. Henüz başlamadığınız ve devam eden işleri işaretleyin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320314
					],
					"speakerTitle": "Ganyu"
