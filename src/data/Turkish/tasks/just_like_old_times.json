			"dialogs": [
				{
					"id": 761840101,
					"content": "Bak sen şu işe, bunu tarihe not düşmek lazım. Beni çay partilerinden birine davet edeceğin günü de mi görecektik Sandrone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840102
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 761840102,
					"content": "Belki hal ve hareketlerine biraz çekidüzen verseydin seni çok daha önce davet ederdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840103
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761840103,
					"content": "Katılıyorum. İkide bir insanları düelloya çağırmayı bıraksan onun da faydası dokunur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840104
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 761840104,
					"content": "Heh. Tıpkı abilerim ve ablalarım gibi konuşuyorsunuz. Ne yapayım, elimde değil. Ustam beni dağda bayırda eğitirken görgü kurallarına pek sıra gelmiyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840105
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 761840105,
					"content": "Boş ver. Zaten kırk yılda bir toplanıyoruz. Rahatlayıp anın tadını çıkaralım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840106
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761840106,
					"content": "Hımm. Yeni icadın mı bu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840107
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 761840107,
					"content": "Adı Fagio. \"Faaliyet Asistanı Genel İnteraktif Otomaton\"un kısaltması.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840108
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761840108,
					"content": "Yani Pulonia'nın tamir edilmesi için hiç mi umut kalmadı? Buna çok üzüldüm Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840109
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 761840109,
					"content": "Sorun değil, ben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840110
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761840110,
					"content": "... Onunla savaşma fırsatı bulamayacağıma çok üzülüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840111
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 761840111,
					"content": "Ne bekliyordum ki zaten...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840112
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761840112,
					"content": "Pulonia güçlü görünüyordu, \"Fagio\"ya gelince...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840113
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 761840113,
					"content": "... Onun zayıf göründüğünü mü söylemeye çalışıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840114
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761840114,
					"content": "Şey... Haha, yok canım, hayır. Sadece Pulonia kadar kuvvetli durmuyor sanki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840115
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 761840115,
					"content": "Hıh. Pulonia ölçümler ve hesaplamalar için üretildi. Ona savaş yetenekleri eklerken işlem gücünden ödün vermemeye özen göstermiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840116
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761840116,
					"content": "Ama Fagio'nun karmaşık formüller işlemesi gerekmiyor. Sahip olduğu bütün işlem gücü doğrudan savaş modülüne yönlendirilebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840117
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761840117,
					"content": "Yani... O zaman Pulonia'dan bile daha güçlü, öyle mi? Böyle bir şey nasıl mümkün olabilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840118
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 761840118,
					"content": "Kendi gözünle görmeden için rahat etmeyecek, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840119
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761840119,
					"content": "Baştan söyleyeyim, onu kırarsam tek kuruş tamir masrafı ödemem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840120
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 761840120,
					"content": "Hastane masraflarını da ben ödemem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840121
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761840121,
					"content": "(*iç çeker* Böyle olacağını biliyordum.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840122
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 761840122,
					"content": "(*ham hum ham*...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Küçük Hanım"
				}
			]
		},
