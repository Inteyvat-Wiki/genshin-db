			"dialogs": [
				{
					"id": 761840301,
					"content": "Şu çay partileri hiç de fena değilmiş. Bu kadar eğlenceli olduklarını bilseydim çok daha önceden katılırdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761840302,
						761840303
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 761840302,
					"content": "(Biraz daha oturalım.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761840304
					]
				},
				{
					"id": 761840304,
					"content": "Tamam, sonra görüşürüz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 761840303,
					"content": "Yavaş yavaş toparlansam iyi olacak.",
					"roleType": "TALK_ROLE_PLAYER",
