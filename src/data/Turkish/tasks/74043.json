			"dialogs": [
				{
					"id": 740430301,
					"content": "Hımm, hadi bakalım. Toplamda 7 çekirdek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430302
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430302,
					"content": "Onlar senin neyine yarayacak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430303
					]
				},
				{
					"id": 740430303,
					"content": "Nereden bileyim? Patronum bana o gizemli makinalardaki çekirdeklerden 7 tane lazım olduğunu söyledi. Hepsini alıp götürebilirsem karşılığında yüklü bir Mora alacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430304
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430304,
					"content": "Pekala, bu işe yarar! Onunla burada buluşup durumu rapor edeceğim, istersen ona kendin sorabilirsin. Her durumda, o tüm hesabını ödedikten sonra ancak senin payını verebilirim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430305
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430305,
					"content": "Of pekala, madem öyle diyorsun... Bekleyeceğiz o zaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430306,
					"content": "Bir süre beklersiniz...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740430307
					]
				},
				{
					"id": 740430307,
					"content": "Sevgili Henri, işler yolunda mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430308
					],
					"speakerTitle": "\"Patron\""
				},
				{
					"id": 740430308,
					"content": "Gayet yolunda Patron! İstediğiniz 7 çekirdeği topladım. Bu arada, sizi ortağımla tanıştırayım... Ah, adın neydi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430309
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430309,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430310
					]
				},
				{
					"id": 740430310,
					"content": "Şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430311
					],
					"speakerTitle": "\"Patron\""
				},
				{
					"id": 740430311,
					"content": "Iıı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430312,
					"content": "Bir dakika, siz birbirinizi tanıyor musunuz? Harika! Olaylar şöyle gelişti Patron...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430315
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430313,
					"content": "#\"Ah, {NICKNAME}! Burada ne işin var?\"\\n\"Patron\" dönüp kaçmak ister ama Avcı ile Turner birden ortaya çıkarak onu yakalar.\\n\\n",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740430314
					]
				},
				{
					"id": 740430315,
					"content": "Ah! Affedin, merhamet edin lütfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430316
					],
					"speakerTitle": "\"Patron\""
				},
				{
					"id": 740430316,
					"content": "Hah, bu ikisi de ne kadar yetenekliymiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430317,
					"content": "Endişelenme Patron! Burada ölümcül bir tehlike yok, eminim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430318
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430318,
					"content": "Kesinlikle öyle. Hiç kimse tehlikede değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430319
					],
					"speakerTitle": "Avcı"
				},
				{
					"id": 740430319,
					"content": "En azından şimdilik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430320
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430320,
					"content": "E-En azından şimdilik mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430321
					],
					"speakerTitle": "\"Patron\""
				},
				{
					"id": 740430321,
					"content": "Sıradaki şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430322
					],
					"speakerTitle": "Avcı"
				},
				{
					"id": 740430322,
					"content": "Hesabı kızarmış tavukla mı yoksa başka bir şeyle mi ödeyeceğiniz... Tamamen size kalmış Patron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430323
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430323,
					"content": "Ayy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430324
					],
					"speakerTitle": "\"Patron\""
				},
				{
					"id": 740430324,
					"content": "İkiniz buraya nasıl geldiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430325,
					"content": "Daha önce... Sizinle tanışma şerefine erişince Henri'nin peşinden gitmeye karar verdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430326
					],
					"speakerTitle": "Avcı"
				},
				{
					"id": 740430326,
					"content": "Ne? Bir dakika, neden ben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430327
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430327,
					"content": "İyi de neden ilk başta hedef bendim? Sadece işimi yapıyordum ben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430328
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430328,
					"content": "Parçaladığın makinalar, su kalitesini izlemek ve iyileştirmek için Fontaine Araştırma Enstitüsü tarafından kullanılan cihazlardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430329
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430329,
					"content": "Ne? Onlar kirlilik oluşturmak için tasarlanmamış mıydı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430330
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430330,
					"content": "Söktüğün çekirdeklerinin içinde ise Fontaine'deki en gelişmiş merkezi bileşenler ve su verileri vardı. Bu sebepten ötürü... Ticari ortağınızla tanışmak istedik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430331
					],
					"speakerTitle": "Avcı"
				},
				{
					"id": 740430331,
					"content": "Ne? Neden ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430332,
						740430334
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430332,
					"content": "Bana yalan söyledin Henri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430333
					]
				},
				{
					"id": 740430334,
					"content": "Hadi canım, yok artık! Resmen kandırıldık!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430335
					]
				},
				{
					"id": 740430333,
					"content": "Hayır hayır, sen benim en büyük velinimetimsin! Sana neden yalan söyleyeyim ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430335
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430335,
					"content": "Bana yalan söyledin Patron! Bu kadar önemli şeyleri bana bilerek mahvettirdin, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430336
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430336,
					"content": "Ö-Öyle bir amacım yoktu! Ben bu düzenin en alt kademesinde yer alıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430337
					],
					"speakerTitle": "\"Patron\""
				},
				{
					"id": 740430337,
					"content": "Hımm? \"Öyle bir amacım yoktu\" falan gibi bir şeyler dediğinizi duydum, neydi o? Sanırım sizi tam olarak duyamadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430338
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430338,
					"content": "Aaaay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430339
					],
					"speakerTitle": "\"Patron\""
				},
				{
					"id": 740430339,
					"content": "Ah, Patron çok yorulmuş olmalı. Gözleri açık uyuyakalmış baksana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430340
					],
					"speakerTitle": "Avcı"
				},
				{
					"id": 740430340,
					"content": "Ahh, bi-bizim de öyle bir amacımız yoktu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430341
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430341,
					"content": "Iıı, bu hususta ise artık konunun peşini bırakmaya karar verdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430342
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430342,
					"content": "Gerçekten mi? Bu şekilde her şey yolunda olacak mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430343,
					"content": "İhtiyacımız olan içlerindeki çekirdekler ve bir bütün olarak veriler. Makinanın kendisi sadece bir aksesuar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430344
					],
					"speakerTitle": "Avcı"
				},
				{
					"id": 740430344,
					"content": "Üst kademedekiler sorun olmadığını ve sizinle hiçbir şekilde uğraşmamamız gerektiğini söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430345
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430345,
					"content": "Hımm? Bizimle uğraşmamak da ne demek?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430346
					]
				},
				{
					"id": 740430346,
					"content": "Ah, hiçbir şey, hiçbir şey.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430347
					],
					"speakerTitle": "Avcı"
				},
				{
					"id": 740430347,
					"content": "Yani baksana bir bize, sadece dışarıda dolaşıyoruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430348
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430348,
					"content": "Burada karşılaşmak ne güzel oldu, değil mi? Ne kadar güzel bir hava var, ne kadar da güzel bir rastlantı oldu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430349
					],
					"speakerTitle": "Avcı"
				},
				{
					"id": 740430349,
					"content": "Ne yazık ki tüm karşılaşmaların bir sonu vardır ve bizimki de öyle olacak. Artık veda vakti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430350
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430350,
					"content": "Sadece böyle bir karşılaşmanın güzelliği kalbinizde kalsın ya da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430351
					],
					"speakerTitle": "Avcı"
				},
				{
					"id": 740430351,
					"content": "Unut gitsin. Kim bilir belki de böyle daha iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430352
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430352,
					"content": "Yani? Böyle iyi miyiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430353
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430353,
					"content": "Tam tersinin olmasını mı isterdin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430354
					],
					"speakerTitle": "Avcı"
				},
				{
					"id": 740430354,
					"content": "Ah, Hükümdarlar aşkına, hayır! Gayet iyiyiz, bir şeyimiz yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430355
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430355,
					"content": "*iç çeker* İyi biriyle tanıştığımı ve onunla birlikte işim sayesinde hayatımı değiştirebileceğimi düşünmüştüm. Ancak ne yazık ki kötü niyetli insanlar hâlâ çoğunlukta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430356
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430356,
					"content": "... Hey Henri, yardım eder misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430357
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430357,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430358
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430358,
					"content": "Çok yazık ama bu iyi kalpli Patronun aklını yitirmiş gibi duruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430359
					],
					"speakerTitle": "Avcı"
				},
				{
					"id": 740430359,
					"content": "Biri lazım bize...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430360
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430360,
					"content": "Çalışkan olan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430361
					],
					"speakerTitle": "Avcı"
				},
				{
					"id": 740430361,
					"content": "Güvenilir olan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430362
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430362,
					"content": "Yani, düzgün bir şekilde çalışarak hayatını değiştirmek isteyen iyi biri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430363
					],
					"speakerTitle": "Avcı"
				},
				{
					"id": 740430363,
					"content": "Doğru, bu iyi adamı güvenli evimize götürebilecek iyi bir arkadaşa ihtiyacımız var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430364
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430364,
					"content": "Orada... Onunla enine boyuna konuşabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430365
					],
					"speakerTitle": "Avcı"
				},
				{
					"id": 740430365,
					"content": "Tabii ki şükranlarımızı da sunacağız... Hem de Mora ile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430366
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 740430366,
					"content": "Ah... Tabii! Ben de varım o zaman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430367
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430367,
					"content": "Teşekkürler, sağ olun. İkinize de teşekkür ederim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430368
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430368,
					"content": "#Ben {NICKNAME}, o da Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430369
					]
				},
				{
					"id": 740430369,
					"content": "#İkinize de teşekkürler {NICKNAME}, Paimon. Sizinle karşılaştıktan sonra hayatım gerçek manada değişti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430370
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430370,
					"content": "Teşekküre gerek yok! Çok çalış ve tekrar dolandırılma yeter Henri, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430371
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430371,
					"content": "Evet, tabii! Çok sıkı çalışacağım ve zengin biri olacağım. Daha sonra benim için çalışan adamlarım olacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430372
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430372,
					"content": "Avcı, Turner ve Henri baygın haldeki Fatui Üyesini kazıp çıkarırlar ve onu götürürler.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740430373
					]
				},
				{
					"id": 740430373,
					"content": "Paimon, Henri'nin hayatının çok güzel olacağını umuyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430374
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740430374,
					"content": "Bir saniye bekle. Henri'nin bize vereceği ücrete ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}