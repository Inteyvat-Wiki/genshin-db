			},
			"dialogs": [
				{
					"id": 740430201,
					"content": "Ne istiyorum? İşçi hakları! Ne zaman istiyorum! Hemen şimdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430202,
						740430204,
						740430206
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430202,
					"content": "Hey, istediğin çekirdekleri getirdim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430203
					]
				},
				{
					"id": 740430203,
					"content": "Hımm? Bir bakayım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430204,
					"content": "Neden burada protesto yapıyorsunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430205
					]
				},
				{
					"id": 740430205,
					"content": "Düştüğümüz yerden geri kalkabilmemiz lazım elbette!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430206,
					"content": "Her neyse, benim ne yapmamı istiyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740430207
					]
				},
				{
					"id": 740430207,
					"content": "Of, cidden seninle ne yapacağım ben? Birileri yere ve su altına bazı tuhaf makinalar yerleştirmiş. Neyse ki onları ayırt etmesi epey kolay, bulundukları bölgede tuhaf bir ışık yanıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740430208
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 740430208,
					"content": "Onlardan kurtul ve bu özel çekirdekleri bana getir. Toplamda <color=#00E1FFFF>7</color> tane lazım bana. Teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henri"
				}
			]
		},
