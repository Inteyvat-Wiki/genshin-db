			"dialogs": [
				{
					"id": 761290101,
					"content": "Loncaya tüm yardımlarınız için tekrar teşekkür ederim Patron Nefer ve Bayan Jahoda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 761290102,
					"content": "Teşekküre gerek yok. Aramızda bir iş birliği var ne de olsa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290103
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290103,
					"content": "Bu doğru ama Loncanın bazı... Karmaşık araştırma işlerine yardımcı olduğunuz için size minnettarım Patron Nefer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290104
					],
					"speakerTitle": "Sarin"
				},
				{
					"id": 761290104,
					"content": "Maceracılar Loncası da bizim çalışmalarımıza yardımcı olması için birçok üyesini görevlendirdi. Hepimiz aynı amaç için çalışıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290105,
					"content": "Gelecekteki iş birliklerimizin de aynı şekilde keyifli olmasını umuyorum Bay Sarin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290106
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290106,
					"content": "Patron Nefer, emin olabilirsiniz ki Maceracılar Loncası...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290107
					],
					"speakerTitle": "Sarin"
				},
				{
					"id": 761290107,
					"content": "Şey, şunu daha net ifade edeyim. Nod-Krai'daki Maceracılar Loncası şubemizin güvenilir bir iş ortağı olduğundan kesinlikle emin olabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290108
					],
					"speakerTitle": "Sarin"
				},
				{
					"id": 761290108,
					"content": "Heh, bundan şüphem yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290109
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290109,
					"content": "(Güzel, güzel, böyle konuşmaya devam et Patron Nef. Canım Patron Nef, lütfen bana bakma, lütfen bana bakma, lütfen bana bakma...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290110
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290110,
					"content": "Jahoda, sen neden bu kadar sessizsin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290111
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290111,
					"content": "(EYVAH, baktı! Tamam, sakın görev tahtasına bakma, lütfen görev tahtasına bakma, lütfen görev tahtasına bakma...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290112
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290112,
					"content": "Hı? B-Ben mi? B-Benim söyleyecek bir şeyim yok! Şey... Görev için... Teşekkürler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290113
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290113,
					"content": "Ah, ayrıca size de yardımlarınız için teşekkür etmeliyiz Bayan Jahoda. Siz olmasaydınız Loncanın evrakları muhtemelen dağ gibi yığılırdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290114
					],
					"speakerTitle": "Sarin"
				},
				{
					"id": 761290114,
					"content": "Bana teşekkür etmenize gerek yok... Sonuçta karşılığını alıyorum, tabii ki işimi düzgün yapmam gerekir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290115
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290115,
					"content": "(*iç çeker* Ona söylemesi için öğrettiğim her şeyi unutmuş anlaşılan...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290116
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290116,
					"content": "Bu arada madem hepimiz buradayız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290117
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290117,
					"content": "(Hayır ya! Çok iyi bir hava yakalamıştık! Lütfen bana biraz müsaade et Patron!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290118
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290118,
					"content": "Bay Sarin, son görev listesini getirebilir misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290119
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290119,
					"content": "Jahoda, en önemli olduğunu düşündüğün görevi seç.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290120
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290120,
					"content": "Bunu dikkatlice düşünmeni istiyorum, acele etme tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290121
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761290121,
					"content": "Tamam... Tabii Patron...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290122
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761290122,
					"content": "(Eyvah! BİTTİM BEN!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		}
	]
}