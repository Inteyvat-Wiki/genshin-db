			"dialogs": [
				{
					"id": 721580101,
					"content": "Fırtına... Dindi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580102
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 721580102,
					"content": "Görünüşe bakılırsa Koruyucu Taşların dördü de mühürlendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580103
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580103,
					"content": "Evet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580104
					]
				},
				{
					"id": 721580104,
					"content": "Sen miydin? İçeri nasıl girdin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580105
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 721580105,
					"content": "Taisuke senin bir çeşit kapıdan geçip ortadan kaybolduğunu söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580106
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 721580106,
					"content": "Bu kapı nasıl bir şeymiş? Çok garip...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580107
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 721580107,
					"content": "Orada tam olarak ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580108
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580108,
					"content": "Eiko'yla yukarıdan gök gürültüsüne benzeyen bir ses geldiğini duyduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580109
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580109,
					"content": "Fırtınanın çoktan dinmesi gerekiyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580110
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580110,
					"content": "Olanları anlatıyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580111
					]
				},
				{
					"id": 721580111,
					"content": "Havada süzülen taşlar bir platform oluşturdu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580112
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580112,
					"content": "Demek öyle... Açıkçası daha önce Seirai Adası'nda böyle bir doğa olayının meydana geldiğini hiç duymadım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580113
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580113,
					"content": "Sence bunun neresi bir doğa olayına benziyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580114
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 721580114,
					"content": "Neresinden bakarsan bak doğaüstü bir olay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580115,
						721580116
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 721580115,
					"content": "Haklısın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580117
					]
				},
				{
					"id": 721580117,
					"content": "Doğa olayı ya da değil, Seirai Adası'ndaki fırtına dindi ve özel görev tamamlandı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580118
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 721580118,
					"content": "Bir de bu garip tüyü bulduk...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580119
					]
				},
				{
					"id": 721580119,
					"content": "Bu... Taisuke, şuna baksana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580120
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 721580120,
					"content": "Peki, müsaadenle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580121
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580121,
					"content": "Üzgünüm ama bu tüyün nereden geldiğine dair bir fikrim yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580122
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580122,
					"content": "Daha önce böyle bir desene ve dokuya sahip tüyleri olan bir kuş görmedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580123
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580123,
					"content": "Tüyün boyut ve oranlarına bakarak kuşun gökyüzündeki taş platformun kendisi kadar büyük olduğunu söyleyebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580124
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580124,
					"content": "Tüy bu kadar önemli mi? Tüyün nereden geldiğini bu kadar merak ediyorsan neden Loncaya bir özel görev teklifinde bulunmuyorsun? Belki de sana yardım edecek birileriyle karşılaşabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580125,
						721580126
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 721580125,
					"content": "Peki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580127
					]
				},
				{
					"id": 721580127,
					"content": "Pekala, yardımın için teşekkürler Maceracı. Taisuke ve ben Loncaya dönüp raporlarımızı hazırlayacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580128
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 721580128,
					"content": "Ah, doğru ya. Bu senin için. Çok bir şey değil... Yardımın karşılında sana hâlâ borçluyuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580129
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 721580129,
					"content": "Taisuke, hadi toplanmaya başla. Loncaya geri dönüyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580130
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 721580130,
					"content": "Eiko... O zaman hızlıca tapınağa gidip Leydi Neko'yu görelim, olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580131
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580131,
					"content": "Taisuke...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580132
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 721580132,
					"content": "Hadi ama! Konuşan bir kediden bahsediyoruz! Konuşan bir kedi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580133
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 721580133,
					"content": "*iç çeker* Gerçekten...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eiko"
				},
				{
					"id": 721580126,
					"content": "Bunu bir düşüneyim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580127
					]
				},
				{
					"id": 721580116,
					"content": "Bu konuda haklısın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580117
					]
				}
			]
		}
	]
}