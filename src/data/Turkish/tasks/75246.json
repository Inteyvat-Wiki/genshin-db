			"dialogs": [
				{
					"id": 752460101,
					"content": "#{NICKNAME}, bak, şurada birileri var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460102,
					"content": "Bir yerden tanıdık geliyorlar. Sanırım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460103
					]
				},
				{
					"id": 752460103,
					"content": "Ororon ve Ifa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460104,
					"content": "#{M#Dede}{F#Diğer Nine} ve Paimon! Ben de bu sesleri nereden tanıyorum diyordum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460105
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460105,
					"content": "Dostlar! Dostlar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460106
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460106,
					"content": "Aa! Siz de tatil köyüne gelmişsiniz! Ne zamandır görüşemiyoruz yahu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460107
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460107,
					"content": "Evet ya! Chasca bize burada çalıştığınızı söyledi. Yollarımızın kesişeceği varmış!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460108,
					"content": "Kesinlikle öyle. Burasının çok hoş bir atmosferi var, sizce de öyle değil mi? Duyduğuma göre herkes harika vakit geçiriyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460109
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460109,
					"content": "Hehe, aynen öyle! Umarız daha da iyiye gider ve daha fazla ziyaretçi çekeriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460110,
					"content": "Sizde ne var ne yok? İşler yolunda mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460111,
					"content": "Fena değil. Sürüngen personeller ve bitler gayet sağlıklı, enerjileri de yerinde. Bu yüzden biraz boş vaktimiz oldu, biz de etrafa bakınalım dedik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460112
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460112,
					"content": "... Bit PERSONELLER.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460113
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460113,
					"content": "Hı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460114
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460114,
					"content": "Bitler de personel. O kısmı söylemedin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460115
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460115,
					"content": "Kesinlikle haklısın dostum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460116
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460116,
					"content": "Doğru... Benim hatam. Tüm personelimize minnettarım gerçekten. Tabii ki onları aktif bir şekilde koruyup kollayan Bay Ororon'a da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460117
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460117,
					"content": "Buraya önemli bir sebep uğruna savaşmak için erkenden geldik. Bu bile başlı başına bir ödül sayılır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460118
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460118,
					"content": "Şöyle ki, dostumun aldığı ilk resmi davet bu. Tahmin edeceğiniz üzere... Kendisini bu işe adadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460119
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460119,
					"content": "Hevesli olmak iyidir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460120
					]
				},
				{
					"id": 752460120,
					"content": "#Gördün mü? {M#Dede}{F#Diğer Nine} ne dediğini biliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460121
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460121,
					"content": "Her gün önemli bir amaç uğruna savaşma şansı elde ediyoruz. Bunu Cacucu'dan öğrendim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460122
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460122,
					"content": "Haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460123
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460123,
					"content": "Ama siz... Balık tutmuyor musunuz? Balık tutmak ne zamandan beri \"önemli bir amaç uğruna savaşmak\" oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460124,
					"content": "Ağzından çıkanı kulağın duyuyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460125
					],
					"speakerTitle": "Cacucu"
				},
				{
					"id": 752460125,
					"content": "Bir arkadaşımız tarafından önerildiğinden beri tabii ki. Kendisi son derece şanslı ve ünlü Mondstadtlı bir maceracı. Onun dediğinin aksini iddia etmek pek akıl karı olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460126
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460126,
					"content": "(Bir dakika... Bennett mi?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460127
					]
				},
				{
					"id": 752460127,
					"content": "O arkadaşımız bir çubuğu çevirdi ve çubuk bu göleti işaret etti. Ororon da kendi şansımızı yaratmak yerine şansın bizi götürdüğü yere gitmenin daha iyi olduğunu söyledi. Bu yüzden balık tutmak için buraya geldik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460128
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460128,
					"content": "Pekala, dediğin mantıklı olsa bile... Bu gölet kapibaralarla dolu! Burada balık tutabilecek misiniz ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460129,
					"content": "Elbette! Kapibaralar uysal canlılardır, sorun yok yani. Ayrıca hayat sana su verirse balık tutmalısın. Ninemden böyle öğrendim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460130
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460130,
					"content": "Nine ne kadar da bilge sözler söylemiş. Bir de şöyle derdi: \"Hayat sana yemek verirse yemek ye.\" ve \"Hayat sana limon verirse limonata yap.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460131
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460131,
					"content": "#Haha, aynen öyle. Ancak bu kez size limon uzatan biziz {M#Dede}{F#diğer Nine} ve Paimon. Hazır buradayken bizimle balık tutmaya ne dersiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460132
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 752460132,
					"content": "Hatta biraz ortalığı kızıştıralım... En büyük balığı yakalayan Ororon'un Bal Şarabını alır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460133
					],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460133,
					"content": "İşte bu Paimon'un hayır diyemeyeceği bir teklif!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460134,
					"content": "#Hehehe, sen kiminle dans ettiğini unuttun herhalde? Biz hiçbir meydan okumayı geri çevirmeyiz, hem {NICKNAME} çok sağlam bir rakiptir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460135,
						752460137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752460135,
					"content": "Hadi yapalım şu işi dostum!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460136
					]
				},
				{
					"id": 752460136,
					"content": "Rekabetçi ruhun ortaya çıktı demek! Pekala, görelim o halde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ifa"
				},
				{
					"id": 752460137,
					"content": "Kozlarımızı paylaşalım evlat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460138
					]
				},
				{
					"id": 752460138,
					"content": "Pekala, kazanan her şeyi alır. Yani sadece balıkları değil, bit personellerin yaptığı bal şarabını da alır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ororon"
				}
			]
		},
