			"dialogs": [
				{
					"id": 200380101,
					"content": "*iç çeker* Acaba Yedilerin Heykelleri ne haldedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380102
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380102,
					"content": "Yedilerin Heykelleri mi? Ne olmuş onlara?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380103
					]
				},
				{
					"id": 200380103,
					"content": "Açıklayayım... Eskiden her hafta Yedilerin Heykellerinden birine dua eder, hazır gitmişken de toz alırdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380104
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380104,
					"content": "Hayatımdaki tüm güzellikler için hükümdarlara şükrediyorum... Heykellerini temizlemek de bu şükranı gösterme yolumdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380105
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380105,
					"content": "Ama Lily doğduğundan beri çok nadiren dışarı çıkabiliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380106
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380106,
					"content": "Kimse uzun süre temizlemediği için heykeller artık pislenmiştir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380107
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380107,
					"content": "Sorumluluktan kaçıyormuşum gibi görünüyor olabilir ama... Benim için Yedilerin Heykellerinin tozunu alır mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380109,
						200380110
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380109,
					"content": "Tabii ki!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380111
					]
				},
				{
					"id": 200380111,
					"content": "Çok teşekkür ederim! Rüzgar Hükümdarı seni korusun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380115
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380115,
					"content": "Bir şey daha var. Yedilerin Heykelleri, hükümdarların gücünü taşıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380116
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380116,
					"content": "Üstlerinde biriken toz normal bir şekilde temizlenemez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380117
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380117,
					"content": "Ama senin element güçlerin var. İşin kolay olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380118
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380118,
					"content": "Yani benim aksime... Benim için tek bir heykeli temizlemek bir gün sürüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380110,
					"content": "Rüzgar tozları uçurmamış mıdır?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200380112
					]
				},
				{
					"id": 200380112,
					"content": "Barbatos ve hakimiyetindeki rüzgarların gün içinde yapacak başka işleri olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380113
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380113,
					"content": "Orada burada tembellik edip her şeyi hükümdarlardan beklememeliyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380114
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 200380114,
					"content": "Lord Barbatos'un yükünü hafifletmek için birlikte çalışalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200380115
					],
					"speakerTitle": "Jilliana"
				}
			]
		},
