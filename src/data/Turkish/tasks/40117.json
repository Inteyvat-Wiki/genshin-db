				"points": []
			},
			"dialogs": [
				{
					"id": 401171401,
					"content": "Klee üzerinde \"süper eğlenceli Çuf Çuf Vagon\" sürebileceğin bazı gizemli raylar bulduklarını söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171402
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401171402,
					"content": "Ah, ben de öyle bir şey duydum. Sanırım \"korkunç\" bir ray hattında \"inanılmaz\" derecede hızla giden bir vagonmuş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171403
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401171403,
					"content": "Evet, o olmalı. Söylediğine göre vagon çok dik bir yerden inerken vücudun sanki bir tüy gibi havada süzülüyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171404
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401171404,
					"content": "Gerçekten mi? Hım, ben de duydum ki vagondayken Klee'nin çantası az daha uçacakmış. Kaeya çantayı yakalamasaymış bir sürü Zıpzıp Bodur havada uçuşacakmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171405
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401171405,
					"content": "Olamaz, bu çok tehlikeli olurdu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171406
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401171406,
					"content": "*iç çeker* Ama gerçekten o vagona binmek istiyorsan müsait olduğumda sana eşlik edebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171407
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401171407,
					"content": "Ne? Eula, bunu nasıl bildin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171408
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401171408,
					"content": "Denemek istediğin yüzünden anlaşılıyor... Ama şimdiden söyleyeyim, vagondayken cebinden bir şey düşerse toplamana yardım etmem. O yüzden binmeden önce ceplerini boşaltmayı unutma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171409
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401171409,
					"content": "Ah, tamamdır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Collei"
				}
			]
		},
