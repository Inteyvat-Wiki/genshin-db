			"trigger": {
				"objectNames": [
					"Klee",
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401171301,
					"content": "Hey Kaeya, kaçmazsam bana Şişedeki Cinin hikayesini anlatacağına söz vermiştin. Hatırladın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171302
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401171302,
					"content": "Ah, evet. Peki, nerede kalmıştım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171303
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171303,
					"content": "Aa, ben hatırlıyorum! Cin şişeden çıkmıştı ve şişeyi açan çoban çocuğu yiyecekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171304
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401171304,
					"content": "Evet, Cin korkutucu ağzını açtığı anda çoban çocuğun aklına bir fikir geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171305
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171305,
					"content": "Cinin ağzına Zıpzıp Bodur mu fırlattı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171306
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401171306,
					"content": "Haha, Zıpzıp Boduru olsaydı eminim senin dediğin gibi yapardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171307
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171307,
					"content": "Ama çoban çocukta öyle bir şey yoktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171314
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171314,
					"content": "Cine dedi ki, \"Bekle, o devasa vücudun nasıl o küçücük şişeye sığabiliyor? Gözlerimle görmezsem asla inanmam!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171308
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171308,
					"content": "Cin, onun bu sözüne kızdı ve şöyle dedi \"Muhahaha. Aptal çocuk, gücümü sınamaya nasıl cüret edersin?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171309
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171309,
					"content": "Cin, şişenin içine döndü ve çocuk da hemen şişenin ağzını kapattı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171310
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171310,
					"content": "Yaşasın! Cin bir daha dışarı çıkamayacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171311
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401171311,
					"content": "Gerçi o küçük şişenin içinde Cin uyuyabilir mi ki? İçerisi muhtemelen çok rahatsızdır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171312
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401171312,
					"content": "Hayır ama Cin, kötü şeyler yaptığı için yakalanıp şişenin içine hapsedildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171313
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401171313,
					"content": "O yüzden bu hikayeden çıkarman gereken ders, kötü bir şey yapıp hapsolmak istemiyorsan yakalanmaman gerektiğidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401171314
					],
					"speakerTitle": "Kaeya"
				}
			]
		},
		{
			"id": 4011714,
