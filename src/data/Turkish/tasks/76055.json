			},
			"dialogs": [
				{
					"id": 760550101,
					"content": "(<color=#FFCC33FF>Lauma</color> bir şey duydu galiba...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760550102
					]
				},
				{
					"id": 760550102,
					"content": "... İlginç. Bir ses duydum sanki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550103
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550103,
					"content": "(Ah, misafirler! Gelin, gelin! Çarkı çevirin, sonra çarkı durdurun ve iyi yemekler gelsin!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550104
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550104,
					"content": "(Hı? Çarkı neden çevirmiyorsunuz? Hadi, çevirin! İyi yemekler bekliyor!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550105
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550105,
					"content": "Kulağa... Yavru bir köpek gibi geliyor. İyi yemek için çarkı çevir... Ne demek bu şimdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550106
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550106,
					"content": "(Selam misafirler! Benimle konuşabilirsiniz! Lütfen çarkı çevirin, yoksa leziz bir şey yiyemeyeceğim!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550107
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550107,
					"content": "Aç mısın? Yanımda bisküvi var. Al, ye bir tane.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550108
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550108,
					"content": "(Hımm? Çarkı çevirmiyorsun ama bana yemek mi vermek istiyorsun? Hımm, peki. Alayım. Neden olmasın?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550109
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550109,
					"content": "(Teşekkürler misafir. Adım Pavlov, bisküvi için sağ ol. Çok lezzetliydi! Fakat yine de çarkı çevirmedin.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550110
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550110,
					"content": "Rica ederim... Sakıncası yoksa sorabilir miyim, \"çarkı çevirmek\" dediğin nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550111
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550111,
					"content": "(Çark çevrilir ve sonra durdurulursa iyi yemek düşüyor. Hep böyle.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550112
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550112,
					"content": "(Çarkı çevirmez misin sevgili misafir? Çevirdikten sonra herkes mutlu hissediyor.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550113
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550113,
					"content": "Çevirmeyeceğim. Galiba... Burada iyi durumda yaşıyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550114
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550114,
					"content": "(Tabii ki, tabii ki! İnsanlar benimle oynuyor, çark benimle oynuyor, iyi yemek de var.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550115
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550115,
					"content": "Sevindim o halde. Sahibine benden selam söyle. Ben gidiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550116
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 760550116,
					"content": "(Aaa... Görüşürüz misafir! Yine gel!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pavlov"
				}
			]
		},
