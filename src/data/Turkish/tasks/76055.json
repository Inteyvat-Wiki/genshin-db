						760550302
					]
				},
				{
					"id": 760550302,
					"content": "Tuhaf... Sanırım bir ses duydum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550303
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760550303,
					"content": "(Aa, misafirler! Gelin, gelin! Çarkı çevirin, sonra çarkı durdurun ve güzel yemekler gelsin!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550304
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550304,
					"content": "(Hı? Çarkı neden çevirmiyorsunuz? Hadi, çevirin! Güzel yemekler var!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550305
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550305,
					"content": "Küçük bir köpek... Senin için çarkı çevirmemi mi istiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550306
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760550306,
					"content": "(Selam misafirler! Benimle konuşabiliyorsunuz! Lütfen çarkı çevirin, yoksa leziz bir şey yiyemeyeceğim!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550307
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550307,
					"content": "Aç mısın? Daha yeni atıştırmalık almıştım. Al, biraz ye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550308
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760550308,
					"content": "(Hı? Çarkı çevirmiyorsun ama bana yemek mi vermek istiyorsun? Hımm, peki. Alayım. Neden olmasın?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550309
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550309,
					"content": "(Teşekkürler misafir. Adım Pavlov, yemek için sağ ol. Çok lezzetliydi! Fakat yine de çarkı çevirmedin.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550310
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550310,
					"content": "Bu atıştırmalıklar güzelmiş. Ama... Bahsettiğin bu çark... Tam olarak ne yapıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550311
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760550311,
					"content": "(Çark çevrilir ve sonra durdurulunca güzel yemek düşüyor. Hep böyle.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550312
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550312,
					"content": "(Çarkı çevirir misin sevgili misafir? Çevirdikten sonra herkes mutlu oluyor.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550313
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550313,
					"content": "Çarkı çevirirsem... Sen mutlu olacak mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550314
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760550314,
					"content": "(Tabii ki, tabii ki! İnsanlar benimle oynuyor, çark benimle oynuyor, güzel yemek de var... En iyi kısmı yemek!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550315
					],
					"speakerTitle": "Pavlov"
				},
				{
					"id": 760550315,
					"content": "Anlıyorum... Evet, güzel yemek önemlidir. Al, geri kalanları da sen ye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550316
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760550316,
					"content": "Benim gidip biraz daha almam gerekiyor. Hoşça kal Pavlov.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760550317
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760550317,
					"content": "(Mmm... Lezzetli, lezzetli! Güle güle misafir! Yine gel!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pavlov"
