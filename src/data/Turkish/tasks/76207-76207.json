			"dialogs": [
				{
					"id": 762070201,
					"content": "Ah... Bir zamanlar dilin ta kendisiydim. Şimdi ise bir yanılsamanın paramparça olmuş bir öznesine indirgendim ve bir kez daha bu kusurlu \"sembole\" geri dönüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070202
					],
					"speakerTitle": "Tosalis"
				},
				{
					"id": 762070202,
					"content": "Ayyy! Garip bir kitabın içinden garip şeyler söyleyen garip biri fırladı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762070203,
					"content": "\"Garip\" isabetsiz bir terim. Betimlenemeyen, yazıya dökülemeyen veya nitelenemeyen eşsiz bir varlığı ima eder. Benim bu tanıma uymadığım çok açık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070204
					],
					"speakerTitle": "Tosalis"
				},
				{
					"id": 762070204,
					"content": "Ben sadece bu sayfalarda \"gerçekliğe\" bir giriş noktası bulmaya çalışıyordum. Ancak istemeden sonsuz bir metafor ertelemesinin içine düştüm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070205
					],
					"speakerTitle": "Tosalis"
				},
				{
					"id": 762070205,
					"content": "Sembolleştirmeye meydan okuyan bir kalıntıya dönüştüm. Senin müdahalen sayesinde dilin despotluğundan kurtuldum. Nihayet kendimi bir kez daha yanlış tanımaya başlayabilirim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762070206
					],
					"speakerTitle": "Tosalis"
				},
				{
					"id": 762070206,
					"content": "Lütfen herkesin anlayacağı dilden konuş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762070207
					]
				},
				{
					"id": 762070207,
					"content": "... Kazara sayfaların içine düştüm ve orada mahsur kaldım. Beni dışarı çıkardığın için teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tosalis"
				}
			]
		}
	]
