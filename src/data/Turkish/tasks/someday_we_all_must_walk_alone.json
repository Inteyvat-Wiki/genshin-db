					"content": "Raaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770105
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770105,
					"content": "Raaaa... Rarr! Rarr! Roooaa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770106,
						751770108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770106,
					"content": "Bu hareket tanıdık geldi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770107
					]
				},
				{
					"id": 751770107,
					"content": "Aa! Şu \"Büyük Etli Alev Topu\" değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770110,
					"content": "Hehe, Yankıların Çocuklarında yönetmen olmak isteyen ama Kamerasını düzgün kullanamayan bir adam vardı... Aa! Kameranı ondan mı aldın yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770111,
					"content": "Raarr! Err... Raar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770112
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770112,
					"content": "Bizimle fotoğraf çekilmek istiyorsun, değil mi? Hehe, Paimon senin dilinden anlıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770113,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770114
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770114,
					"content": "Evet... Uzun zamandır maceralara atılıyoruz ama birlikte hiç fotoğrafımız yok! Şimdi ufaklığın laneti kalktığına göre nihayet büyüyüp güçlenebilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770115,
					"content": "#Tepetlizorlar ne kadar sürede büyüyorlar acaba... {REALNAME[ID(2)|SHOWHOST(true)]} yarın yetişkin olursa bir daha bebeklik halini göremeyeceğiz demektir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770116,
						751770118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770116,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770117
					]
				},
				{
					"id": 751770117,
					"content": "Hehe, hadi bir fotoğraf çekilelim artık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770119,
					"content": "Usta Fotoğrafçı Paimon her şeyi hazırladı, bir sorun olmaması lazım. Ayrıca Kamera bize doğru dönük!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770120,
					"content": "Geri sayma bitince herkes \"Büyük Etli Alev Topu\" desin. Üç, iki, bir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770121,
					"content": "\"Büyük Etli Alev Topu\"!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770122
					]
				},
				{
					"id": 751770122,
					"content": "Raaar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770123
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770123,
					"content": "#İşte budur. Vay be, {REALNAME[ID(2)|SHOWHOST(true)]} gerçekten harika poz verdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770124,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770125
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770125,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} fotoğraflardan birini alır, arkasını döner ve sırtındaki sert kabuğun altına dikkatlice gizler.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751770126
					]
				},
				{
					"id": 751770126,
					"content": "#Neden {REALNAME[ID(2)|SHOWHOST(true)]} birdenbire fotoğraf çekilmek istedi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770127,
					"content": "Ruuuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770128
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770128,
					"content": "Vuruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770129
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770129,
					"content": "Vuruuu... Ruuuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770130
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770130,
					"content": "#İyi misin {REALNAME[ID(2)|SHOWHOST(true)]}? Bir şeyin yok umarım? Hımm... Pek mutlu görünmüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770131,
					"content": "Raaar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770132
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770132,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770133
					]
				},
				{
					"id": 751770133,
					"content": "Kendi maceran için yola çıkmaya hazırlanıyorsun...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770134
					]
				},
				{
					"id": 751770134,
					"content": "Ha? Kendi... Maceran mı? Bizimle devam etmek istemiyor musun? Aa, Paimon seni sinirlendirecek bir şey mi yaptı yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770135,
					"content": "P-Paimon sana bir daha açgözlü demeyecek! Lütfen bizi terk etme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770136,
					"content": "Vuruuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770137
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770137,
					"content": "Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770138
					]
				},
				{
					"id": 751770138,
					"content": "*burnunu çeker* P-Paimon herkesin bir gün büyüyeceğini biliyor... *ağlar* Herkesin gitmek istediği bir yer var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770139,
					"content": "Ama... Paimon veda etmek istemiyor... Böyle aniden olmaz ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770140,
					"content": "Ağlama. Bir gün tekrar görüşeceğiz...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770141
					]
				},
				{
					"id": 751770141,
					"content": "#Gerçekten mi? İleride yardıma ihtiyacımız olduğunda bizi bulsan iyi edersin {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770142,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770143
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770143,
					"content": "#Ayrıca... Maceraların sırasında başını belaya sokarsan da gelip bizi bulabilirsin {REALNAME[ID(2)|SHOWHOST(true)]}! Delikanlılık taslama sakın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770144,
					"content": "Raarr! Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770145
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770145,
					"content": "... Çok fazla yemek yeme ve kazanamayacağın dövüşlere girme. Bu arada Paimon fazla yemek yeme dediyse de bol bol et yemeyi ihmal etme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770146,
					"content": "B-B-Bir de...! H-Her şeyden önemlisi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770147,
					"content": "Mutlu ve sağlıklı bir şekilde büyü...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770148
					]
				},
				{
					"id": 751770148,
					"content": "Evet! Mutlu, sağlıklı ve iri! En az üç dağın boyutuna ulaşman lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770149
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770149,
					"content": "Rarr! Rarr! Rarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770150
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770150,
					"content": "E-Evet! İ-İşte böyle! *ağlar* B-bizi unutayım deme sakın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770151
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751770151,
					"content": "Ormanın huzurlu sessizliğinde, veda yemeği olarak Yakıcı Et Yahnisini paylaşıyorsunuz. Ardından, seyyar kampını toplayıp ayrılmaya hazırlanıyorsun.\\nBağımsızlığına kavuşacak olan küçük dostun için birkaç hatıra hazırlarken, birlikte geçirdiğiniz o macera dolu günleri hatırlamadan edemiyorsun. Mağaranın girişini kapatan Yumkazor, sahildeki Tombalak ve yol boyunca karşılaştığınız tüm o ilginç karakterler...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751770152
					]
				},
				{
					"id": 751770152,
					"content": "Son olarak... Kısa bir süreliğine aklın, garip altın yazılarla iletişim kuran kişiye takılıyor...\\nPaimon'un dediği gibi, \"Bizi kullanıyordu! Yüzünü bile göstermedi!\"\\nBu durum, Kutsal Dağ'ın eteğindeki genç Sürüngen dostunun gözlerindeki karmaşık duyguları hatırlatıyor.\\n... Henüz küçük olsa da kesinlikle büyüyüp güçlü bir Sürüngen olacak.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751770153
					]
				},
				{
					"id": 751770153,
					"content": "En sonunda boynuzunu Paimon'un alnına değdirir ve şefkatle uzattığın avucuna sokulur.\\nArdından uzunca bir süre duraksar, sanki cesaretini toplamaya çalışıyor gibidir...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751770154
					]
				},
				{
					"id": 751770154,
					"content": "Genç Sürüngen hiç tereddüt etmeden arkasını döner ve ağır aksak uzaklara doğru yol alır.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 751770118,
					"content": "Hadi öyleyse!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770119
					]
				},
				{
					"id": 751770108,
					"content": "\"Büyük Etli Alev Topu\"!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770109
					]
				},
				{
					"id": 751770109,
					"content": "Şimdi sen öyle deyince Paimon hatırladı sanki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770110
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}