						732570403
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732570403,
					"content": "Çok yorgunum... Bir an önce... Uykuma dönmek istiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570404
					],
					"speakerTitle": "Rashnu"
				},
				{
					"id": 732570404,
					"content": "Çok ayıp. Burada tüm işi yapan benim, sen hiçbir şey yapmadın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570405
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570405,
					"content": "Katılmıyorum. Beklemek de önemli bir iş. Hatta eylemler geçiciyken beklemek ebedi bir iştir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570406
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732570406,
					"content": "Bu nasıl bir mantık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570407,
					"content": "Bu, biz Parilerin felsefesi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570408
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732570408,
					"content": "Şimdi felsefe konuşmanın sırası değil ama. Önemli olan Khvarena'nın Ulu Şarkıları. Hepsini getirdiniz, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570409
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732570409,
					"content": "Tabii ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570410,
					"content": "Öyleyse artık mührü kaldırabiliriz. Ardından Ulu Şarkıları kullanarak Khvarena'nın gücünü toplayabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570411
					],
					"speakerTitle": "Mihir"
				},
				{
					"id": 732570411,
					"content": "Yine de dikkatli olun. Yüzlerce yıllık kir birikmiş. Mührü kaldırdığımda içeriden ne çıkacağını bilemeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mihir"
				}
			]
