			"dialogs": [
				{
					"id": 732570101,
					"content": "Fabrika harabelerinden çıktığımızdan beri Sorush çok sessiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570102,
					"content": "Sürekli konuşup duruyordu, Paimon onu bu kadar sessiz görmeye alışık değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570103,
						732570104,
						732570105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570103,
					"content": "Epey korkmuş olmalı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570106
					]
				},
				{
					"id": 732570106,
					"content": "Canlan biraz Sorush! Yapacak daha çok şeyimiz var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570107,
					"content": "Mesela şu... Paimon'un ismini hatırlayamadığı ayini yapmamız ve devasa deliği kapatmamız gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570108,
					"content": "İşimiz bittikten sonra çabalarımızı lezzetli bir yemekle ödüllendirebiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570109,
					"content": "Şey yiyebiliriz... Iı, Paimon Parilerin ne yemeyi sevdiğini bilmiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570110,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570111
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570111,
					"content": "... Parilerin yemek yemeye ihtiyacı yoktur Sersem Pofuduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570112
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570112,
					"content": "*iç çeker* Demek Beyaz Pofuduğun tesellisine muhtaç kalacak kadar düşmek de varmış şu dünyada. Ne yazık bana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570113
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570113,
					"content": "Tanıdığım herkes bu dünyadan göçene dek bir Boz Kristalin içinde mühürlenmeyi... Veya gidip ebediyen uyuyabileceğim bir mağara bulmayı yeğlerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570114
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570114,
					"content": "Paimon Beyaz Pofuduk değil! Hem öyle bir mağara var mı ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570115,
						732570117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570115,
					"content": "Sorunlarını kaçarak çözemezsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570116
					]
				},
				{
					"id": 732570116,
					"content": "Ben artık umursamayı bıraktım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570119
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570119,
					"content": "Nasejuna'ya kanmanın utancıyla nasıl yaşayacağım ben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570120
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570120,
					"content": "Neyse, Khvarena'nın Ulu Şarkılarını topladığınıza göre gökyüzündeki tuhaflığı çözmek için gidip Mihir veya Rashnu'dan yardım isteyebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570121
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570121,
					"content": "Ne yaparsanız yapın ama lütfen beni rahat bırakın ve söylediklerimi duymamış sayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570122
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570122,
					"content": "Iı, bir sürü garip şey söyledin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570123,
						732570124,
						732570125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570123,
					"content": "\"Yasnapatim\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570126
					]
				},
				{
					"id": 732570126,
					"content": "Off, yeter! Lütfen durun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570127
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570127,
					"content": "#{NICKNAME}, gitme üstüne! Sorush bunca zamandır bizimle. Paimon, onu görevini yarıda bırakmış halde görmek istemiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570128,
					"content": "Üstelik Sorush'un... İyi yönleri de var... Mesela, şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570129,
					"content": "Tereddüt ettiğini gördüm! Oooof! Beni küçük görmeyin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570130,
						732570131
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570130,
					"content": "Hızlı karar verebiliyorsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570132
					]
				},
				{
					"id": 732570132,
					"content": "Çok doğru! Hem Apaosha'nın Alametini söndürmek için bu kadar uğraşmadık mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570133,
					"content": "Buraya kadar gelebildiysek hep senin sayende!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570134,
					"content": "Nasıldı o söz... Paimon bir düşünsün... Hah, \"Böyle devam edersen yakında gerçekten usta bir maceracı olman işten değil.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570135,
					"content": "Ciddi misiniz? Beni gerçekten övmek mi istiyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570136
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570136,
					"content": "Evet, dostların olarak gayet ciddiyiz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570137
					]
				},
				{
					"id": 732570137,
					"content": "Hehe, harika biri olduğumu biliyordum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570138
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570138,
					"content": "Hehe, moralim yerine geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570139
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570139,
					"content": "Madem Sorush'un morali düzeldi, hadi şimdi gidip Zurvan'ı bulalım ve devasa deliği kapatıp ödülümüzü alalım! Paimon büyük yemeği dört gözle bekliyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570131,
					"content": "Sorumluluk duygun kuvvetli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570132
					]
				},
				{
					"id": 732570124,
					"content": "\"Yaman suretim\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570126
					]
				},
				{
					"id": 732570125,
					"content": "\"Kaderimdeki fedakarlık\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570126
					]
				},
				{
					"id": 732570117,
					"content": "Hâlâ yapman gereken şeyler yok mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570118
					]
				},
				{
					"id": 732570118,
					"content": "Biliyorum, biliyorum ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570119
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570104,
					"content": "Yaşananları düşününce...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570106
					]
				},
				{
					"id": 732570105,
					"content": "Belki de sadece yorgundur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570106
					]
				}
			]
		},
		{
			"id": 7325702,
			"completionStepIds": [
				7325702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
