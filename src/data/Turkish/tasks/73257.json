					}
				]
			},
			"dialogs": [
				{
					"id": 732570201,
					"content": "Zurvan, biz geldik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570202,
					"content": "#{NICKNAME}, Sorush ve Paimon dönmüşsünüz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570203
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570203,
					"content": "Gördüğüm kadarıyla Khvarena'nın tüm Ulu Şarkılarını almışsınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570204,
						732570205
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570204,
					"content": "Evet, bazı aksaklıklara rağmen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570206
					]
				},
				{
					"id": 732570206,
					"content": "Olsun, elde edilen sonuç muhteşem. Bu görevde size güvenmekte haklıymışım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570207
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570207,
					"content": "Siz olmasaydınız kötü niyetli kişiler Khvarena'nın Ulu Şarkılarını çalabilirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570208
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570208,
					"content": "Hım, Paimon sanki Zurvan'ın olacakları tahmin ettiğini düşünüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570209,
					"content": "Heheh, demek haklıymışım! Karanlık çukurun müritleriyle mi karşılaştınız yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570210,
						732570212
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570210,
					"content": "Nereden bildin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570211
					]
				},
				{
					"id": 732570211,
					"content": "Eee... Nereden bildiğimi boş verin de neler oldu anlatın bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570214
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570214,
					"content": "Yer altındaki harabelerde yaşadıklarınızı ve Nasejuna'nın ihanetini Zurvan'a anlatıyorsunuz.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732570215
					]
				},
				{
					"id": 732570215,
					"content": "Hehe, demek Cemiyetin Vijnanapatisi bile karanlık çukurun saflarına geçmiş. Bunu beklemiyordum doğrusu. Kuşkuculara güvendiğimden değil de, bu kadarı biraz fazla olmuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570216
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570216,
					"content": "Ayrıca anladığım kadarıyla savaştığınız karanlık çukurun hizmetkarı, Nasejuna'yı Ulu Şarkıların peşine düşmeye ikna etmiş. Tanıyorum ben o hizmetkarı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570217
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570217,
					"content": "Ne? Hiçlik Tarikatından o adamı nasıl tanıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570218,
					"content": "Hıh, eskiden Kuşkucular Cemiyetindeydi. Birkaç yüz yıl önce ormandan bir soruşturma ekibi, Dahrililerin gizemlerini keşfetmeye geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570219
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570219,
					"content": "Cemiyetin uyarılarına rağmen Dahri harabelerine girmekte ısrar ettiler. Dönemin Vijnanapatisi de ne olur ne olmaz diye ekiple beraber bir adamını yolladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570220
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570220,
					"content": "Harabelerde ne gördüklerini kimse bilmiyor ama o adam yeniden kendini gösterdiğinde çoktan kirliliğin lütfunu kabul etmişti. Soruşturma ekibinden de iz yoktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570221
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570221,
					"content": "Sonra karanlık çukurun müritleri ortaya çıktı. Khvarena'nın Ulu Şarkılarının peşindeydiler. Bu yüzden sayısız Dhev çağırıp Vourukasha Vahası'na saldırdılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570222
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570222,
					"content": "Pek çok Parinin ve insan savaşçıların yardımıyla evimizi korumayı başarsak da karanlık çukurun müritlerini yok edemedik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570223
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570223,
					"content": "Bir gün yeniden faydalanabilecekleri bir açık bırakmamak için Ulu Şarkıların gücüyle Vourukasha Vahası'nı ve harabeleri mühürledim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570224
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570224,
					"content": "Kuşkucular Cemiyeti bu olaydan sonra eskisi gibi olamadı. Eski arşivlerini yangında kaybettiler, sonra da giderek bugünkü hallerini aldılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570225
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570225,
					"content": "Onlardan en son söz ettiğinden beri karanlık çukurun müritlerinin bir şeyler peşinde olduklarını sezmiştim ama Kuşkucuların liderini bile taraflarına çekebileceklerini tahmin etmemiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570226
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570226,
					"content": "Demek öyle. Bu arada Paimon, Nasejuna'nın söylediklerini merak ediyor. Kuşkucuların ataları hakkında bir şey biliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570227,
					"content": "Sonuçta onlarla beraber savaşmışsın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570228
					]
				},
				{
					"id": 732570228,
					"content": "Hehe. Tarih efsanelere, efsaneler de öykülere dönüşür. Gelenekler böyle aktarılır. Unutmak da hikayenin bir parçası.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570229
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570229,
					"content": "Gelenek fikrine ne kadar sıkı sarılırsan diğer hikayeler yerine yalnızca gönlünden geçen hikayeyi o kadar fazla hatırlarsın. Sonra da bir bakmışsın öyküler labirentinde kaybolmuşsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570230
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570230,
					"content": "Her gün her saat bir şeylerin unutulduğu bir dünyada yeryüzüne kazıdıklarımız, rüzgara söylediğimiz şarkılardan çok daha güvenilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570231
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570231,
					"content": "Size de bu nedenle güvendim. Açık sözlüsünüz ve başka insanların size karşı düşüncelerini kafanıza takmıyorsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570232
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570232,
					"content": "Paimon bizi övdüğünü biliyor ama söyleyiş biçimin biraz garip geldi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570233,
					"content": "Hafif bir kinaye sezdim sanki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570234
					]
				},
				{
					"id": 732570234,
					"content": "Sanırım Büyük Zurvan beni kastediyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570235
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570235,
					"content": "Beş yüz yıl önce yaşananlara gelecek olursak... Bana kalırsa hikayeyi benden dinlemek yerine kendiniz görmeyi yeğlersiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570236
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570236,
					"content": "Şimdi elinizde bunun için harika bir fırsat var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570237
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570237,
					"content": "Bu arada Sorush, görüyorum ki daha güvenilir biri olmuşsun. Yaşadıklarından sonra nihayet insanların anlattığı o deli saçması masallardan uyandın herhalde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570238
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570238,
					"content": "Büyüğüm! Geçmişte olan geçmişte kalsın lütfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570239
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570239,
					"content": "#Bu meseleyi {NICKNAME} ve Paimon'a emanet etmekle doğru karar vermişim. O halde sanırım Ab-Zohr Ayinini de içim rahat bir şekilde size bırakabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570240
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570240,
					"content": "Ab-Zohr Ayini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570241
					]
				},
				{
					"id": 732570241,
					"content": "Paimon, Zurvan'ın bu ayinden bahsettiğini hatırlıyor! Bir şeyi temizlemek içindi... Kirlilik miydi neydi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570242,
					"content": "Ab-Zohr Ayini, Harvisptokhm Ağacını kirlilikten arındırmak için düzenlenen bir ayin. Normalde bu ayini yalnızca karanlığı bastıran ağaçların altında gerçekleştirmek gerekir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570243
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570243,
					"content": "Ancak mühür zayıfladı ve gökyüzünde tuhaflık yeniden belirdi. Bu nedenle sorunu çözmek için normalden fazlasını yapmamız icap ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570244
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570244,
					"content": "Harvisptokhm Ağacının üzerinde beliren tuhaflık, ağacın çok yüksek miktarda kirliliği bünyesinde toplamasından kaynaklanıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570245
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570245,
					"content": "Aşırı miktarda biriken bu kirlilik ve tuhaflığın sebep olduğu yozlaşma nedeniyle Harvisptokhm Ağacı artık Khvarena gücünü sürdüremiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570246
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570246,
					"content": "Şu an yapabileceğimiz tek şey Harvisptokhm Ağacına girmek ve ağacı arındırarak tanrımızı uyandırmak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570247
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570247,
					"content": "Bir dakika, Harvisptokhm Ağacına girebiliyor muyuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570248
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732570248,
					"content": "Tabii ki. Chinvat Ayininin o karanlık çukurun içinde gerçekleştirildiğini mi sanıyordunuz? Oradaki kirliliğe Pariler bile dayanamaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570249
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570249,
					"content": "Harvisptokhm Ağacının içinde Gaokerena adında dev bir nilüfer bulunur. Tanrımızın bilinci bu nilüferin içinde uyumakta. Kirliliği temizlediğimizde Mukaddes Çiçek yeniden açacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570250
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570250,
					"content": "Amrita, toprağı tüm kirden arındıracak. Bu işlemler ilk bakışta karmaşık geliyor olabilir ama ben size zorluk çıkaracaklarını düşünmüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570251
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570251,
					"content": "Tamam o zaman. Rashnu ve Mihir'i Tunigi Çukuru'na yolladım. Yanlarına gidin ve beraberinizde Ulu Şarkıları da götürün. Böylece Khvarena'nın gücünü toplayabileceksiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570252
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570252,
					"content": "Khvarena, karanlığı bastıran dev ağaçları uyandıracak ve derinliklerdeki kirli çamuru temizleyecek. Sonrasında Chinvat Ayinini gerçekleştirebilir ve Harvisptokhm Ağacına giden yolu açabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570253
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570253,
					"content": "Ağaca girdiğinizde Bahar Tacı, Sorush'a kadim kahramanların büyük başarılarını gösterecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570254
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570254,
					"content": "Khvarena'yla ilgili tüm anılar nihayetinde Harvisptokhm Ağacına dönecek. Efsaneler kaç defa değiştirilirse değiştirilsin ve yeniden anlatılırsa anlatılsın bu anılar asla yok olmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570255
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570255,
					"content": "Ben bunları hiç bilmiyordum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570256
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 732570256,
					"content": "Hehe, Bahar Tacı aslında Harvisptokhm Ağacının bir parçasıydı. Gittiğinde anlayacaksın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570257
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570257,
					"content": "Şimdi lütfen gidin ve Apaosha'nın Alametini söndürün. Gökten Amrita yağdığında yeniden görüşeceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570212,
					"content": "Evet...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570213
					]
				},
				{
					"id": 732570213,
					"content": "Aa, anlatın bakalım ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570214
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 732570205,
					"content": "Çok yoruldum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570206
					]
