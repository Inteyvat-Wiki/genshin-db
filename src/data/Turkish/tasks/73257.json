					"nextDialogs": [
						732572907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732572907,
					"content": "Neyse, bu alakasız konu üzerinde daha fazla vakit harcamayalım. Gerisini size bırakıyorum!",
