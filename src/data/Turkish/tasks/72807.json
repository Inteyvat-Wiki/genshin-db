					"nextDialogs": [
						728070203
					]
				},
				{
					"id": 728070203,
					"content": "Kamaji Usta'dan mı bahsediyorsun? Onunla ne işin var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070204
					],
					"speakerTitle": "Sanada"
				},
				{
