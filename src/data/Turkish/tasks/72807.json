						728070205
					]
				},
				{
					"id": 728070205,
					"content": "Bu mektubu Bayan Hiiragi Chisato mu gönderdi dedin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070206
					],
					"speakerTitle": "Sanada"
				},
				{
					"id": 728070206,
					"content": "Mektubu gönderen gerçekten Hiiragi Chisato ise...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070207
					],
					"speakerTitle": "Sanada"
				},
				{
					"id": 728070207,
					"content": "Bence doğrudan Kamaji Usta'yla konuşmalısın. Bu aralar köprünün orada yürüyüşe çıkmaya başladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sanada"
