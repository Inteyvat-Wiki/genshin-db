			"dialogs": [
				{
					"id": 728070301,
					"content": "Sen... Sen şu yabancı Gezginsin. Nasıl yardımcı olabilirim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070302
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070302,
					"content": "Hiiragi Chisato'nun mektubu hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070303
					]
				},
				{
					"id": 728070303,
					"content": "Bu mektubu bana vermeni gerçekten Bayan Hiiragi mi istedi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070304
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070304,
					"content": "Bu el yazısı... Gerçekten o yazmış... Şükürler olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070305
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070305,
					"content": "Geldiğin için teşekkür ederim Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070306
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070306,
					"content": "Seyahat İznine gelince... Bayan Hiiragi'nin özel ricası olduğu için tabii ki halledeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070307
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070307,
					"content": "Yine de hazırlamam için biraz zaman lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070308
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070308,
					"content": "Şöyle yapalım. Beni Kiminami Restoranında bekler misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070309
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070309,
					"content": "Niye oraya gitmek istiyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070310
					]
				},
				{
					"id": 728070310,
					"content": "Çünkü senden küçük bir iyilik isteyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070311
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070311,
					"content": "Bir süredir Bayan Hiiragi'ye böyle bir şey göndermek istiyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070312
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070312,
					"content": "Ayrıca bir mektup yazıp Bayan Kiminami'den benim için ikram hazırlamasını istedim. Hediye olarak Bayan Hiiragi'ye göndermeyi düşünüyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070313
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070313,
					"content": "Ama babam planlarımı duyarsa kızabilir. Tam ne yapacağımı düşünürken sen geldin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070314,
						728070320
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070314,
					"content": "Sadece bir hediye.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070315
					]
				},
				{
					"id": 728070315,
					"content": "Babam Bayan Hiiragi'yle konuşmamı istemiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070316
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070316,
					"content": "Endişelenmesini anlıyorum. Sonuçta Kujou Klanının bir üyesi ve Tenryou Heyetinin savaşçılarından biriyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070317
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070317,
					"content": "Bayan Hiiragi ise Kanjou Heyetindeki Hiiragi Klanının liderinin kızı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070318
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070318,
					"content": "Onunla çok yakınlaşırsam birisi kesinlikle ilişkimizden çıkar sağlamaya çalışacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070319
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070319,
					"content": "Bazıları bunu sadece bir hediye olarak görmeyebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070326
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070326,
					"content": "Hehe. Bu önemsiz konuları boş verelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070327
					],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070327,
					"content": "Lütfen beni Kiminami Restoranında bekle Gezgin. Seyahat İznini onayladıktan sonra sana getireceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujou Kamaji"
				},
				{
					"id": 728070320,
					"content": "Baban çok mu katıdır?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070321
					]
				},
				{
					"id": 728070321,
					"content": "Babam... Doğal olarak katı olmak zorunda. Bayan Hiiragi'yle konuşmamı neden istemediğini anlayabiliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
