			"dialogs": [
				{
					"id": 728070501,
					"content": "Gezgin. Dönmüşsün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070502
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 728070502,
					"content": "Mektubumu Kamaji'ye verdin değil mi? Seyahat İznini de alabildin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070503,
						728070505
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 728070503,
					"content": "Evet. Teşekkür ederim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070504
					]
				},
				{
					"id": 728070504,
					"content": "Bana teşekkür etmene gerek yok. Asıl Kamaji'ye teşekkür etmelisin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070506
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 728070506,
					"content": "Bu ne? İkram ve... Kamaji'nin elinden bir mektup mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070507
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 728070507,
					"content": "Kendisi mi gönderdi? Üç Renkli Dango... Benim için mi hazırlamış?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070508
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 728070508,
					"content": "Teşekkür ederim Gezgin. Afiyetle yiyeceğim. Bu mektubu da dikkatlice okuyacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070509
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 728070509,
					"content": "Teşekkürler, sana da zahmet oldu. Lütfen bunları teşekkür olarak kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728070510
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 728070510,
					"content": "Kim bilir, belki ileride tekrar yardımına ihtiyacım olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 728070505,
					"content": "Bunu Kamaji gönderdi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728070506
					]
				}
			]
		},
