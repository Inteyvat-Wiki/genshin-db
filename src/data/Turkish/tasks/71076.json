			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anton"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710621201,
					"content": "Yakında gideceğiz. Maceranda aksaklığa yol açtıysak özür dilerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621202,
						710621210,
						710621213,
						710621221
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621202,
					"content": "Taşordu'yla iş birliği hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621203
					]
				},
				{
					"id": 710621203,
					"content": "Bu, uzun zaman önceydi. Burası mühürlendikten kısa süre sonra Liyue'nin Yedi Yıldızı ile iletişime geçtik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621204
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621204,
					"content": "Başta işler yolunda gidiyordu... Hatta Sinyora, her iki taraf için de yararlı olacak ticari anlaşmalar imzaladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621205
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621205,
					"content": "Ek koşullardan biri uyarınca Liyue, Fatui'nin Kanyon'a öncü ekip göndermesine izin verdi. Yaşanan anomalilerin kaynağını araştırıp bunu ortadan kaldırmaya geldik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621206
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621206,
					"content": "Anlaşmaya göre Snezhnaya ve Liyue burada bulunan her şeyi birbiriyle paylaşacaktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621207
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621207,
					"content": "Başka amaçlarınız yok mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621208
					]
				},
				{
					"id": 710621208,
					"content": "Bildiğim kadarıyla hayır. Kanyon'a girdiğimizde yerel halk bile bize içten dileklerini iletti. Hepimiz başkaları uğruna kendimizi feda ederek kahraman olacağımızı düşünüyorduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621209
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621209,
					"content": "*iç çeker* İşlerin böyle sonuçlanacağını kim tahmin ederdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621210,
					"content": "\"Kara Felaket\" hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621211
					]
				},
				{
					"id": 710621211,
					"content": "\"Kara Felaket\", \"Karanlığın Felaketi\" ya da adına ne dersen... Beş yüzyıl önce meydana gelen büyük faciayı ifade ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621212
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621212,
					"content": "Bu felaket, Snezhnaya'nın ebedi düşmanı... Beş yüzyıldır felaket karanlıkta gizleniyor ve biz de sonsuza dek buna karşı tetikte olacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621213,
					"content": "Hakkınızda ne söyleyebilirsin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621214
					]
				},
				{
					"id": 710621214,
					"content": "Hakkımızda mı? Söyleyecek pek bir şey yok. Sıkı mücadele vermemize rağmen başarısız olduk. Hepsi bu kadar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621215
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621215,
					"content": "Buraya ilk geldiğimizde Dokuzuncu Bölüğümüz 64 askerden oluşuyordu. Şimdi komutan da dahil adamlarımızın yarısı ya ortadan kayboldu ya da öldü. Belki daha yarımız olmadı gerçi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621216
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621216,
					"content": "Neyse, işte o civarda. Etrafa dağıldık ve birbirimizle iletişimi kaybettik. Bu mücadeleyi kaybettik ve uzun zaman önce geri çekilmeliydik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621217
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621217,
					"content": "Fakat yüzeydeki adamlarınız Liyue Limanı'na saldırdı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621218
					]
				},
				{
					"id": 710621218,
					"content": "Şaşırtıcı gelse de sanırım nedenini anlayabiliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621219
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621219,
					"content": "Anlamlı uğraşlara yardımcı olmak amacıyla Lord Pulcinella, önemsiz varlıkları feda etmekten çekinmez. Onun mantığı budur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621220
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621220,
					"content": "Astı olarak onun yaptığına hiçbir itirazım yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621221,
					"content": "Katarina hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621222
					]
				},
				{
					"id": 710621222,
					"content": "Onunla karşılaştın mı? Hâlâ hayatta mı? Umarım beni affedebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621223
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621223,
					"content": "Katarina ile kardeşi Kapral Nikolay, Taş Yuva'da büyüdü. İkisi de Majesteleri Çariçe'nin çocukları.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621224
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621224,
					"content": "Bana kardeşini bulacağını söylediğinde bu ortamda kalmaktan aklını kaçırdığını düşündüm. Kardeşinin hâlâ hayatta olması imkansız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621225,
						710621230
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621225,
					"content": "Yani onu terk ettin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621226
					]
				},
				{
					"id": 710621226,
					"content": "Terk etmek mi? Hayır, o... O kalmaya gönüllü oldu. Sonuçta gereksiz takıntılar bütün ekibi yavaşlatır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621227
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621227,
					"content": "Herkes için hayatımızı veya sevdiklerimizin hayatını feda etmeye hazırız. Fatui böylesine kararlıdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621228
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621228,
					"content": "Katya ve Kolya da buna dahil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621229
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621229,
					"content": "Bana aynısını yapsalar onları suçlamam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621230,
					"content": "İçinde bulunduğu durum düşündüğün kadar kötü değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621231
					]
				},
				{
					"id": 710621231,
					"content": "Sen bir yabancısın. Fatui sıradan vatandaşların önünde duygularını gösteremez ve göstermemeli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621232
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621232,
					"content": "Onun gözünde biz aileyiz. O da bizim ailemiz, yani ailemizdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621233
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621233,
					"content": "Fakat Kolya'yı aramakta ısrar etti... Umarım beni affedebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				}
			]
		},
