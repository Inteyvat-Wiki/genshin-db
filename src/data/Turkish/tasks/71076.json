			"dialogs": [
				{
					"id": 710622801,
					"content": "Yiyecekler için teşekkür ederim. Herhangi bir sorun olursa Komutanımız Anton'a sorabilirsin. Sana söyleyecek hiçbir şeyim yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710622802
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710622802,
					"content": "Lütfen yanlış anlama. Gizli bilgiler söz konusu olduğunda, biliyorsun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710622803
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710622803,
					"content": "Öhöm, neyse. Umarım tekrar arkadaş olarak karşılaşırız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Radomir"
				}
			]
		},
		{
