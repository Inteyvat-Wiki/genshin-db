			"dialogs": [
				{
					"id": 708150601,
					"content": "Ah Jiayi ah... Kızını nasıl böyle yüzüstü bırakır?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150602
					],
					"speakerTitle": "Ruoxin Nine"
				},
				{
					"id": 708150602,
					"content": "Babasını yılda birkaç kez görebiliyor zaten. Böyle baba mı olunur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150603,
						708150605
					],
					"speakerTitle": "Ruoxin Nine"
				},
				{
					"id": 708150603,
					"content": "Liyue Limanı için yapıyor bunu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150604
					]
				},
				{
					"id": 708150604,
					"content": "Her yıl öyle diyor. Kim bilir kaç kez demiştir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruoxin Nine"
				},
				{
					"id": 708150605,
					"content": "Görevini yapıyor sadece...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150606
					]
				},
				{
					"id": 708150606,
					"content": "Kızıyla ilgilenmek de onun görevi. Minik Liu her gün daha da büyüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150607
					],
					"speakerTitle": "Ruoxin Nine"
				},
				{
					"id": 708150607,
					"content": "Böyle giderse, o döndüğünde bu sefer Liu çalışıyor olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150608
					],
					"speakerTitle": "Ruoxin Nine"
				},
				{
					"id": 708150608,
					"content": "Baba kız bir türlü bir araya gelemiyorlar galiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruoxin Nine"
				}
			]
		},
