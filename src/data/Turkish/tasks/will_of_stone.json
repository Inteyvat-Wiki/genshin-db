					"nextDialogs": [
						708151105
					]
				},
				{
					"id": 708151105,
					"content": "Ben de dönmek istiyorum. Ama Liyue Limanı bu haldeyken, şimdilik dönemeyeceğim sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708151106
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708151106,
					"content": "Yine de çok teşekkür ederim. Umarım o hediyeler kızımın moralini biraz düzeltir. Sonuçta en sevdiği oyuncaklar onlar.",
					"roleType": "TALK_ROLE_NPC",
