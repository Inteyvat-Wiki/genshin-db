			"dialogs": [
				{
					"id": 708150401,
					"content": "*iç çeker* Eve dönmeme kalan günleri sayıyordum. İki üç gün kalmıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150402
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708150402,
					"content": "Bu zamana kadar izin günlerimi hiç harcamamıştım, Minik Liu'yla bir haftadan fazla zaman geçirebilirdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150403
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708150403,
					"content": "Ama bir emirle tüm izinlerimiz iptal oldu. İzindekiler bile geri çağrıldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150404
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 708150404,
					"content": "Tecrübeme dayanarak diyebilirim ki... Qingce Köyü'ne en az bir ay daha dönemeyeceğim. Ne büyük bir şanssızlık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				}
			]
		},
		{
			"id": 7081505,
			"completionStepIds": [
				7081502
