			},
			"dialogs": [
				{
					"id": 708150801,
					"content": "Niye beni takip ediyorsun? Liyue Limanı'na gideceğim dedim ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150802
					],
					"speakerTitle": "Minik Liu"
				},
				{
					"id": 708150802,
					"content": "Canavarların arasından kendi başıma geçebilirim. Beni bulamazlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150803
					],
					"speakerTitle": "Minik Liu"
				},
				{
					"id": 708150803,
					"content": "Çocukmuşum gibi davranma! Büyüdüm ben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150804
					],
					"speakerTitle": "Minik Liu"
				},
				{
					"id": 708150804,
					"content": "Bunu baban gönderdi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150805
					]
				},
				{
					"id": 708150805,
					"content": "Babam mı? Seni bunu vermen için mi gönderdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150806
					],
					"speakerTitle": "Minik Liu"
				},
				{
					"id": 708150806,
					"content": "Eminim yine oyuncak göndermiştir. Hep ya bebek ya uçurtma gönderiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150807
					],
					"speakerTitle": "Minik Liu"
				},
				{
					"id": 708150807,
					"content": "Beğenmedin mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150808
					]
				},
				{
					"id": 708150808,
					"content": "Beğendim. Babam vermiş sonuçta. Nasıl beğenmem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150809
					],
					"speakerTitle": "Minik Liu"
				},
				{
					"id": 708150809,
					"content": "Ama böyle şeyleri sürekli beğenirsem, hep çocuk kalmaz mıyım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150810
					],
					"speakerTitle": "Minik Liu"
				},
				{
					"id": 708150810,
					"content": "Sürekli bunlarla oynarsam, ben ne zaman maceracı olacağım? Ne zaman kendi Önsezim olacak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150811
					],
					"speakerTitle": "Minik Liu"
				},
				{
					"id": 708150811,
					"content": "Niye Önsezin olsun istiyorsun ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150812
					]
				},
				{
					"id": 708150812,
					"content": "Önsezim olsaydı çok şey yapabilirdim. Para kazanabilirdim mesela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150813
					],
					"speakerTitle": "Minik Liu"
				},
				{
					"id": 708150813,
					"content": "O zaman babam sürekli Liyue Limanı'nda çalışmak zorunda kalmazdı. Dönüp benimle zaman geçirirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150814
					],
					"speakerTitle": "Minik Liu"
				},
				{
					"id": 708150814,
					"content": "Şimdi Önsezim olmadan, tek başıma Liyue Limanı'na bile gidemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150815
					],
					"speakerTitle": "Minik Liu"
				},
				{
					"id": 708150815,
					"content": "Ama babam seni buraya hediye için gönderdiyse, onu arayarak başına daha çok dert açıyorumdur belki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150816
					],
					"speakerTitle": "Minik Liu"
				},
				{
					"id": 708150816,
					"content": "<color=#00E1FFFF>Ben de ona hediyeler hazırlamıştım</color>. Sürpriz yapmak istiyordum ama... Artık hediyeleri ona götüremem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150817
					],
					"speakerTitle": "Minik Liu"
				},
				{
					"id": 708150817,
					"content": "<color=#00E1FFFF>Keşke götürmeme yardım edecek biri olsaydı</color>. Önemli değil. Dönüyorum. Peşimden gelmene gerek yok. Evin yolunu biliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Minik Liu"
				}
			]
		},
