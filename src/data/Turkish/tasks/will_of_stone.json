					"Ruoxin Nine"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150501,
					"content": "Nereye gitti bu çocuk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150502
					],
					"speakerTitle": "Ruoxin Nine"
				},
				{
					"id": 708150502,
					"content": "Minik Liu ile ilgili bir şey sorabilir miyim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150503
					]
				},
				{
					"id": 708150503,
					"content": "Onu mu arıyorsun? *iç çeker* Gelebileceğin en kötü vakitte geldin. Nereye gitti bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150504
					],
					"speakerTitle": "Ruoxin Nine"
				},
				{
					"id": 708150504,
					"content": "Babası Liyue Limanı'ndan biriyle mektup göndertmiş. Geleceğini söylemiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150505
					],
					"speakerTitle": "Ruoxin Nine"
				},
				{
					"id": 708150505,
					"content": "Minik Liu çok mutluydu. Babası için hediye hazırlamak istediğini söyledi. Sonra birkaç çocuğu peşine takıp meyve ve çiçek topladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150506
					],
					"speakerTitle": "Ruoxin Nine"
				},
				{
					"id": 708150506,
					"content": "Ama birkaç gün sonra babası haber gönderdi. Son anda bir görev verildiğini, gelemeyeceğini söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150507
					],
					"speakerTitle": "Ruoxin Nine"
				},
				{
					"id": 708150507,
					"content": "Minik Liu çok kızdı. Ne söylersek söyleyelim, babası gelmediği için ısrarla kendi başına Liyue Limanı'na gitmek istedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150508
					],
					"speakerTitle": "Ruoxin Nine"
				},
				{
					"id": 708150508,
					"content": "Bir süre şaka yaptığını sandık. Ama bu sabah baktığımızda çoktan gitmişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150509
					],
					"speakerTitle": "Ruoxin Nine"
				},
				{
					"id": 708150509,
					"content": "*iç çeker* Aramaya birkaç kişi gönderdik ama istersen sen de katılabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150510,
						708150512
					],
					"speakerTitle": "Ruoxin Nine"
				},
				{
					"id": 708150510,
					"content": "Deneyeceğim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150511
					]
				},
				{
					"id": 708150511,
					"content": "Sana da zahmet oldu, kusura bakma. *iç çeker* Ah şu çocuk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruoxin Nine"
				},
				{
					"id": 708150512,
					"content": "Nereye gitmiştir sence?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150513
					]
				},
				{
					"id": 708150513,
					"content": "Çok uzağa gittiğini düşünmüyorum. Muhtemelen hâlâ buralardadır ama köyün dışı çok tehlikeli. Lütfen geç olmadan bul onu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruoxin Nine"
				}
			]
		},
