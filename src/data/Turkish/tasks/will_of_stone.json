			"dialogs": [
				{
					"id": 708150901,
					"content": "Bebekler... Uçurtmalar... Rüzgar gülleri. Babam yine bunlardan göndermiş, tam da düşündüğüm gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150902
					],
					"speakerTitle": "Minik Liu"
				},
				{
					"id": 708150902,
					"content": "*iç çeker* Keşke ben de ona kendi hediyelerimi gönderebilseydim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150903
					],
					"speakerTitle": "Minik Liu"
				},
				{
					"id": 708150903,
					"content": "Onları babana ben götürürüm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150904
					]
				},
				{
					"id": 708150904,
					"content": "Yardım edecek misin? Aslında... Senin de Önsezin yok ama canavarları kolayca yendin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150905
					],
					"speakerTitle": "Minik Liu"
				},
				{
					"id": 708150905,
					"content": "Dediğin gibi yapmamız lazım sanırım. Teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150906
					],
					"speakerTitle": "Minik Liu"
				},
				{
					"id": 708150906,
					"content": "*iç çeker* Keşke senin kadar güçlü olabilsem...",
					"roleType": "TALK_ROLE_NPC",
