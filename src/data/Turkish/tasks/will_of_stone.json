			"dialogs": [
				{
					"id": 708150701,
					"content": "Beni yakalayıp Qingce Köyü'ne geri götürmeye mi geldin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150702,
						708150704
					],
					"speakerTitle": "Minik Liu"
				},
				{
					"id": 708150702,
					"content": "Ruoxin Nine seni çok merak etmiş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150703
					]
				},
				{
					"id": 708150703,
					"content": "Hıh. Demek beni yakalamaya geldin. Dönmeyeceğim işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150706
					],
					"speakerTitle": "Minik Liu"
				},
				{
					"id": 708150706,
					"content": "Git ve köydekilere babamı bulmak için Liyue Limanı'na gideceğimi söyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150707
					],
					"speakerTitle": "Minik Liu"
				},
				{
					"id": 708150707,
					"content": "Merak etmesinler. Babamı bulunca onunla biraz konuşur, sonra geri gelirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Minik Liu"
				},
				{
					"id": 708150704,
					"content": "Sana bir şey getirdim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150705
					]
				},
				{
					"id": 708150705,
					"content": "Hiçbir şey istemiyorum. Bana rüşvet vermeye çalışıyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150706
					],
					"speakerTitle": "Minik Liu"
				}
			]
		},
		{
