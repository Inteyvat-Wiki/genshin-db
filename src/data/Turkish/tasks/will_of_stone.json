					"nextDialogs": [
						708151004
					],
					"speakerTitle": "Ruoxin Nine"
				},
				{
					"id": 708151004,
					"content": "Ufaklık, köyün etrafındaki bambular gibi hızla büyüdü. Göz açıp kapayıncaya kadar kocaman oldu.",
					"roleType": "TALK_ROLE_NPC",
