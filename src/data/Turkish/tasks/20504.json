			},
			"dialogs": [
				{
					"id": 205040301,
					"content": "<color=#00E1FFFF>Rüzgar Mühürleri</color> Mondstadt'ın her yerinde var. Yetmezse keşfe çık ve daha fazla topla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040302
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040302,
					"content": "Sadece dekorasyon için mi kullanılıyorlar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040303
					]
				},
				{
					"id": 205040303,
					"content": "Aynen öyle! Rüzgar Hükümdarı'nın hediyesinden daha güzel başka ne olabilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205040304,
					"content": "Haha, tamam, beni yakaladınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040305
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040305,
					"content": "Aslında bundan daha karışık ama sadece dekorasyon için olduğunu söylediğimde insanlar daha kolay anlıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040306
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040306,
					"content": "Tabii ki <color=#00E1FFFF>Rüzgar Mühürlerini</color> diğer malzemelerde olmayan özellikleri için istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040307,
						205040309
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040307,
					"content": "Bitirdiğinde bana da göster.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040308
					]
				},
				{
					"id": 205040308,
					"content": "Haha, elbette! Sonucun seni çok şaşırtacağına eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040312
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040312,
					"content": "Yakında tekrar uğra ve bana tonlarca <color=#00E1FFFF>Rüzgar Mührü</color> getir, olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040313
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040313,
					"content": "Ayrıca maceralarında garip ama harika hazineler bulursan da uğra lütfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040309,
					"content": "Bunu olduğundan daha gizemli göstermeye çalışıyorsun sanki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040310
					]
				},
				{
					"id": 205040310,
					"content": "İşe yarıyor... Paimon şu an meraktan kuduruyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205040311,
					"content": "Haha! Her şeyi şimdi anlatsam sürprizi kaçar, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040312
					],
					"speakerTitle": "Marjorie"
				}
			]
		}
	]
