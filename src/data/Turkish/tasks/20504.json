				"points": []
			},
			"dialogs": [
				{
					"id": 205040101,
					"content": "Hoş geldiniz. Buradaki her hazine eşsizdir, emin olabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040102
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040102,
					"content": "Hehe... Burada Paimon'un tanıdığı bir şey yok, orası kesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205040103,
					"content": "Haha, ne demiştim! Bunların hepsi maceracıların dünyanın dört bir yanından getirdiği nadide parçalar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040104
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040104,
					"content": "Dikkatini çeken oldu mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040105,
						205040106
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040105,
					"content": "Her biri o kadar muhteşem ki...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040107
					]
				},
				{
					"id": 205040107,
					"content": "Gerek yok! Söylemeyi unuttum, burada alışverişi takasla yapıyorsunuz. Mora burada geçmez, ürünü ürünle alırsınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040108
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040108,
					"content": "Son zamanlarda özel bir şey yapmaya çalışıyorum ve süsleme için çok fazla <color=#00E1FFFF>Rüzgar Mührüne</color> ihtiyacım var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040109
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040109,
					"content": "Elinde hiç <color=#00E1FFFF>Rüzgar Mührü</color> var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040110,
						205040112
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040110,
					"content": "Birkaç tane olacak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040111
					]
				},
				{
					"id": 205040111,
					"content": "Haha, görünüşe göre Rüzgar Hükümdarı maceralarını seviyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040114
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040114,
					"content": "Yani bulduğun <color=#00E1FFFF>Rüzgar Mühürleri</color> ile burada alışveriş yapabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040115
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040115,
					"content": "Ürünlere göz at.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 205040112,
					"content": "O nedir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040113
					]
				},
				{
					"id": 205040113,
					"content": "Rüzgar Hükümdarı'nın maceracılara memnuniyetinin bir göstergesi olarak verdiği mühür veya armadır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205040114
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 205040106,
					"content": "Fiyatlarını sormaya çekiniyorum!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205040107
					]
				}
			]
		},
		{
			"id": 2050403,
