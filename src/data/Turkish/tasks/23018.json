			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zakariya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230180101,
					"content": "*iç çeker* Ne sıkıcı iş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180102,
						230180103
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180102,
					"content": "Yardım lazım mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180119
					]
				},
				{
					"id": 230180119,
					"content": "Son zamanlarda personel eksiğimiz var ve ben de günlerdir hiç uyumadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180120
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180120,
					"content": "Gezgin, eğer yapabilirsen yakınlardaki hastalara ilaç götürebilir misin? Lütfen durumlarını da bir kontrol et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180121,
						230180124
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180121,
					"content": "Bana bırak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180122
					]
				},
				{
					"id": 230180122,
					"content": "Sana güveniyorum. Doğa Hükümdarı aşkına, söylediği tek şey \"Doğa Hükümdarı seni kutsasın\" olmayan biri lazım bana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180123
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180123,
					"content": "Hah, \"Doğa Hükümdarı aşkına\"... Son zamanlarda bunu çok sık söylüyorum, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180124,
					"content": "Bence biraz mola vermelisin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180125
					]
				},
				{
					"id": 230180125,
					"content": "Maalesef bunu yapamam. Durumu daha ciddi olan hastaları başka bir yere yerleştirdim ve onlar için ilaç hazırlamam gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180126
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180126,
					"content": "*iç çeker* Bana Doğa Hükümdarı'nın lütuflarına nasıl erişebileceklerini soracaklarına eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180127
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180127,
					"content": "Sana güveniyorum. Doğa Hükümdarı'nın lütufları hakkında konuşmak dışında bir şey yapabilen bir yardımcıya gerçekten ihtiyacım var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180103,
					"content": "Ne oldu burada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180104
					]
				},
				{
					"id": 230180104,
					"content": "Sen Gezginsin sanırım. Burası Bimarstan, tüm halka yardım eden bir hastane. Şey... Doğa Hükümdarı'nın lütuflarını dağıtıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180105
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180105,
					"content": "Zengin ya da yoksul fark etmez, ihtiyacı olan herkes burada tıbbi yardım alabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180106
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180106,
					"content": "Tabii bunun sonucu olarak çok fazla hastamız var ve hepsine yetişecek personelimiz yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180107
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180107,
					"content": "*iç çeker* Doğa Hükümdarı'nın cömertliği sonsuz olabilir ama bizim bütçemiz ve personelimiz sınırlı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180108
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180108,
					"content": "Ayrıca tüm tıbbi tavsiyeleri yok sayan ama sürekli Doğa Hükümdarı'nın lütuflarına nasıl erişeceğini soran hastalar var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180109
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180109,
					"content": "Haha, Doğa Hükümdarı'nın lütufları demek... Vay canına!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180110
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180110,
					"content": "Doğa Hükümdarı lütuflarını etrafa öylesine dağıtıyor olsaydı insanlar zaten hiç hasta olmazdı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180111
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180111,
					"content": "Of, özür dilerim, bunu söylememeliydim. Lütfen bundan Golshan'a bahsetme yoksa yine bana bir nutuk çeker.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180112,
						230180115
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180112,
					"content": "Sen Doğa Hükümdarı'na gönülden bağlı bir mürit değil misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180113
					]
				},
				{
					"id": 230180113,
					"content": "Elbette öyleyim. Sumeru Şehri'nde öyle olmayan birini bulabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180114
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180114,
					"content": "Yine de \"gönülden bağlı\" kısmını atabilirsin. Ben kendimi daha çok Doğa Hükümdarı'nın akılcı bir müridi olarak görüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180118
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180118,
					"content": "Of... Üzgünüm, yorulmuş olmalıyım. İçimi döküyordum. Lütfen söylediklerimi çok ciddiye alma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180119
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180115,
					"content": "Bazıları tedavinin Doğa Hükümdarı'nın lütfu olduğunu söylüyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180116
					]
				},
				{
					"id": 230180116,
					"content": "*iç çeker* Şu hikayeleri bir düşün, tamam mı? Bazı hastalarımız gibi fazla ciddiye alma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180117
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180117,
					"content": "Eğer Doğa Hükümdarı hikayelerde anlatılan kadar güçlü olsaydı insanlara sadece birkaç tane mantar verirdim ve birden iyileşiverirlerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180118
					],
					"speakerTitle": "Zakariya"
				}
			]
		},
		{
			"id": 2301802,
			"completionStepIds": [
				2301802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
