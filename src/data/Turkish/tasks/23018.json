			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zakariya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230180201,
					"content": "Bu kez şifalı bitki çiftliğinde çalışan Gurgen'e ilaç götüreceksin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180202
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180202,
					"content": "Geçtiğimiz birkaç günde çok çalıştığı için kolunu incitmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180203
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180203,
					"content": "Lütfen ona bu ilacı ver. Ayrıca evde kalmasını ve Doğa Hükümdarı'na sessizce dua etmesini söyle. Çiftlik işleri biraz bekleyebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180204,
						230180205
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180204,
					"content": "Tamamdır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180207
					]
				},
				{
					"id": 230180207,
					"content": "Lütfen ilacı teslim ettikten sonra geri gel. Ben de ödemeni o zamana kadar hazırlamış olurum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230180205,
					"content": "Doğa Hükümdarı'na sessizce dua mı etsin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180206
					]
				},
				{
					"id": 230180206,
					"content": "Bunu söylemezsem dediğim hiçbir şeyi dinlemeyecek. Sen sadece verdiğim talimatları uygula olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180207
					],
					"speakerTitle": "Zakariya"
				}
			]
		},
		{
			"id": 2301803,
