					],
					"speakerTitle": "Aftab"
				},
				{
					"id": 230181804,
					"content": "İ-İşte bu! Ben de et yiyince Doğa Hükümdarı'nı kızdıracağımdan korkuyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
