						230181602
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230181602,
					"content": "Birkaç gündür et yemiyormuş...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230181603
					]
				},
				{
					"id": 230181603,
					"content": "Nasıl yani? Ben ona daha hafif şeyler yemesini söyledim, et yemeyi tamamen bırakmasını değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181604
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230181604,
					"content": "Bu şekilde Doğa Hükümdarı'nın lütuflarına daha kolay erişebileceğini mi sanıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181605
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230181605,
					"content": "Pekala... Sanırım başka bir yol bulmam gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181606
					],
					"speakerTitle": "Zakariya"
				},
				{
					"id": 230181606,
					"content": "Çabaların için teşekkürler. İşte, bu senin için.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zakariya"
