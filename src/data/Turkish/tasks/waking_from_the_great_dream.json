					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nergis Haçı",
					"Ann"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2569.368,
							-76.1,
							3382.662
						],
						"pointId": 6767
					}
				]
			},
			"dialogs": [
				{
					"id": 741650301,
					"content": "İmkansız... Çoktan \"geri dönülemeyecek\" noktaya ulaşmışım. Bu hale nasıl düştüm ben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650302
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650302,
					"content": "Ezeli Deniz üzerindeki tüm kontrolümü de kaybettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650303
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650303,
					"content": "Neden, neden böyle oldu? Neden, neden böyle bir şey yaptınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650304
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650304,
					"content": "Yeni dünya doğamayacak. Herkes bir kabuğun içinde, hayallerinin kabuğunda ölecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650305
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650305,
					"content": "Paimon, rüyadan uyanması gereken kişinin asıl sen olduğunu düşünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650306,
					"content": "Dünyanın sonu, herkesin bir araya gelip çözmesi gereken bir sorun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650307,
					"content": "Anladım. Kutsal Kılıç benim tarafımda değil. Her savruluşuyla beni çevreleyen evrensel iradeyi parçalıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650308
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650308,
					"content": "Ta ki sıradan ve zayıf benliğim, fiziksel vücuduma geri dönene dek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650309
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650309,
					"content": "Ezeli Deniz'in taşması o kadar hızlı olmayacak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741650310
					]
				},
				{
					"id": 741650310,
					"content": "Evet, en başta dünya formülüne girilen asıl değerlerin değiştiğini hissedebiliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650311
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650311,
					"content": "Birileri yaşam enerjisinin kontrolünü eline aldı, birileri de canavarlar diyarının kapısını açtı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650312
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650312,
					"content": "Tabii bir değer daha var. O da sensin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650313
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650313,
					"content": "Kaderinde, her şeyi yutan balinanın yenilgisini görmek ve her şeye tanıklık etmek olan kişi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650314
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650314,
					"content": "Anladım, anladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650315
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650315,
					"content": "Bir keresinde senin gibi biri olduğumu hayal etmiştim ama o hayal artık paramparça oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650316
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650316,
					"content": "Yaptığım hiçbir şeyin değeri yok. Her şey boş bir hayalden ibaret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650317
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650317,
					"content": "Hayır, aslında bir hayal kadar bile değil. Hayaller en azından zararsız. Ama ben... Hayır siz, onlar... Tüm yaptıklarım için çok büyük bedeller ödediniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650318
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650318,
					"content": "Nergis Haçı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650319
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650319,
					"content": "Aa, sen de buradaymışsın. Seni görmemiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650320
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650320,
					"content": "Benim aslında kim olduğumu biliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650321
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650321,
					"content": "İsimler sadece etiketlerden ibarettir ama ben, ruhunda bir araya gelen iki rengi gayet iyi tanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650322
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650322,
					"content": "Müdür Lyris'in olanlardan haberi yok. O, hâlâ hayata tutunmaya çalışan Mary-Ann'e bel bağlıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650323
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650323,
					"content": "Çok karışık olan bugün ile geleceği anlayamıyor, sadece geçmişi elinde tutmak istiyor. Bu yüzden de yapabildiği tek şeyi yapıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650324
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650324,
					"content": "Benim adım Ann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650325
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650325,
					"content": "O halde merhaba Ann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650326
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650326,
					"content": "Seni affedebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650327
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650327,
					"content": "Bunu söylemen garip oldu. Amacım en başından beri yüce ve kutsaldı. Bencillik işin içine hiçbir zaman girmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650328
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650328,
					"content": "Kimse beni yargılayamaz veya eleştiremez, kimsenin de beni bağışlamasına ihtiyacım yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650329
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650329,
					"content": "Amaçların yüce olabilir ama çılgınlığın birçok kişiye zarar verdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650330
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650330,
					"content": "Hatta formülü bile doğru girmedin... Ayrıca bir hatanın bağışlanmasının nesi kötü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650331
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650331,
					"content": "... Haklısın. Özür dilerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650332
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650332,
					"content": "O yüzden lütfen bizimle geri dön Nergis Haçı. Görmen gereken başka insanlar var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650333
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650333,
					"content": "Bu adam iş birliğine daha yatkın görünüyor ama böyle bir istek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650334,
					"content": "Elbette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650335
					],
					"speakerTitle": "Nergis Haçı"
				},
