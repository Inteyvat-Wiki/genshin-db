							2569.368,
							-76.1,
							3382.662
						],
						"pointId": 6767
					}
				]
			},
			"dialogs": [
				{
					"id": 741650201,
					"content": "İmkansız... Çoktan \"geri dönülemeyecek\" noktaya ulaşmışım. Bu hale nasıl düştüm ben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650202
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650202,
					"content": "Ezeli Deniz üzerindeki tüm kontrolümü de kaybettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650203
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650203,
					"content": "Neden, neden böyle oldu? Neden, neden böyle bir şey yaptınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650204
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650204,
					"content": "Yeni dünya doğamayacak. Herkes bir kabuğun içinde, hayallerinin kabuğunda ölecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650205
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650205,
					"content": "Paimon, rüyadan uyanması gereken kişinin asıl sen olduğunu düşünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650206,
					"content": "Dünyanın sonu, herkesin bir araya gelip çözmesi gereken bir sorun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650207,
					"content": "Anladım. Kutsal Kılıç benim tarafımda değil. Her savruluşuyla beni çevreleyen evrensel iradeyi parçalıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650208
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650208,
					"content": "Ta ki sıradan ve zayıf benliğim, fiziksel vücuduma geri dönene dek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650209,
						741650215
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650209,
					"content": "Ezeli Deniz'in taşması o kadar hızlı olmayacak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741650210
					]
				},
				{
					"id": 741650210,
					"content": "Evet, en başta dünya formülüne girilen asıl değerlerin değiştiğini hissedebiliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650211
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650211,
					"content": "Birileri yaşam enerjisinin kontrolünü eline aldı, birileri de canavarlar diyarının kapısını açtı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650212
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650212,
					"content": "Tabii bir değer daha var. O da sensin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650213
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650213,
					"content": "Kaderinde, her şeyi yutan balinanın yenilgisini görmek ve her şeye tanıklık etmek olan kişi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650214
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650214,
					"content": "Anladım, anladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650221
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650221,
					"content": "Bir keresinde senin gibi biri olduğumu hayal etmiştim ama o hayal artık paramparça oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650222
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650222,
					"content": "Yaptığım hiçbir şeyin değeri yok. Her şey boş bir hayalden ibaret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650223
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650223,
					"content": "Hayır, aslında bir hayal kadar bile değil. Hayaller en azından zararsız. Ama ben... Hayır siz, onlar... Tüm yaptıklarım için çok büyük bedeller ödediniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650224
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650224,
					"content": "Nergis Haçı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650225
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650225,
					"content": "Aa, sen de buradaymışsın. Seni görmemiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650226
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650226,
					"content": "Benim aslında kim olduğumu biliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650227
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650227,
					"content": "İsimler sadece etiketlerden ibarettir ama ben, ruhunda bir araya gelen iki rengi gayet iyi tanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650228
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650228,
					"content": "Müdür Lyris'in olanlardan haberi yok. O, hâlâ hayata tutunmaya çalışan Mary-Ann'e bel bağlıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650229
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650229,
					"content": "Çok karışık olan bugün ile geleceği anlayamıyor, sadece geçmişi elinde tutmak istiyor. Bu yüzden de yapabildiği tek şeyi yapıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650230
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650230,
					"content": "Benim adım Ann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650231
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650231,
					"content": "O halde merhaba Ann.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650232
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650232,
					"content": "Seni affedebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650233
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650233,
					"content": "Bunu söylemen garip oldu. Amacım en başından beri yüce ve kutsaldı. Bencillik işin içine hiçbir zaman girmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650234
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650234,
					"content": "Kimse beni yargılayamaz veya eleştiremez, kimsenin de beni bağışlamasına ihtiyacım yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650235
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650235,
					"content": "Amaçların yüce olabilir ama çılgınlığın birçok kişiye zarar verdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650236
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650236,
					"content": "Hatta formülü bile doğru girmedin... Ayrıca bir hatanın bağışlanmasının nesi kötü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650237
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650237,
					"content": "... Haklısın. Özür dilerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650238
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650238,
					"content": "O yüzden lütfen bizimle geri dön Nergis Haçı. Görmen gereken başka insanlar var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650239
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650239,
					"content": "Bu adam iş birliğine daha yatkın görünüyor ama böyle bir istek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650240
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650240,
					"content": "Elbette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650241
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650241,
					"content": "Hı? Bu tür bir şey için genellikle biraz içsel mücadele ile saatler süren bir ikna çabası gerekmez mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650242,
					"content": "Daha önce de dediğim gibi yanlış bir şey yaptığımı düşünmüyorum. Görevimi tamamlayamamış olabilirim ama dünya her halükarda kurtuldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650243
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650243,
					"content": "Diğerleri bana istediği gibi lanetler yağdırabilir. Artık içimde tek bir arzudan başka hiçbir şey kalmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650244
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650244,
					"content": "Ne arzusu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650245,
					"content": "Ben de en başa, Nergis Haçı kahramanlarının yolculuklarına çıkmadan önceki zamana dönmek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650246
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650246,
					"content": "Ama bu imkansız. Bizler kendi kaderimizin efendisi değiliz. Artık kendi rüyalarımı kontrol etme gücüne bile sahip değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650247
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650247,
					"content": "#Şövalye {NICKNAME}, hazır olduğunda ezeli suları tekrar mühürlemeye başlayıp buradan gideceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650215,
					"content": "O yaratık çoktan yenildi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741650216
					]
				},
				{
					"id": 741650216,
					"content": "En başta dünya formülüne girilen değerlerin değiştiğini fark etmem gerekirdi. Bu dünyaya bir \"değişken\" indi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650217
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650217,
					"content": "Evrenin dışındaki her şey \"varlık\" veya \"değişken\" olarak nitelendirilemez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650218
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650218,
					"content": "Tüm bunlara rağmen yine de bir şeyi gözden kaçırmışım. Yani seni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650219
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650219,
					"content": "Her şeyin tanığı, her şeyi kaydeden ve her şeyin tasarımcısı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650220
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650220,
					"content": "Yalnızca bir dünya değerindeki kişi bu unvanı taşıyabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650221
					],
					"speakerTitle": "Nergis Haçı"
				}
			]
		},
		{
			"id": 7416503,
			"completionStepIds": [
				7416505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
