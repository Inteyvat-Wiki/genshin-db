					}
				]
			},
			"dialogs": [
				{
					"id": 741650101,
					"content": "\"Mantık...\" Hissediyorum. Ziyaretçiler, Nergis Haçı'nın varisi misiniz yoksa bir tehdit misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650102
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650102,
					"content": "Kılıçlarınızı çektiniz. Cevabımı aldım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650103
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650103,
					"content": "Nergis Haçı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650104
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 741650104,
					"content": "Ha? Bu şey Nergis Haçı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650105,
					"content": "Adımı duyduğunuza göre dünyayı kurtarma görevimi ve hâlâ bir kurtulma şansınız olduğunu biliyor olmanız lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650106
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650106,
					"content": "Sırf yalanlarla kandırıldığınız için kılıcınızı bana doğrulttunuz, ancak yine de gücümü sizinle savaşarak heba etmeyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650107
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650107,
					"content": "Merak edin ve sevinin. Her şey sona erdiğinde cevabımı açıklayacağım ve göstereceğim ama şimdi Kutsal Kılıcı bana verin ve kendinize güvenli bir yer bulun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650108
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650108,
					"content": "Kutsal Kılıcı sana vermeyeceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741650109,
					"content": "Ahmakça, gerçekten ahmakça bir seçim. Ancak yine de sizi affedip kurtaracağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650110
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650110,
					"content": "Dört bölgenin tersine çevrildiğini hissedebiliyorum ama akan ağaç henüz tamamlanmamış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650111
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650111,
					"content": "Artık herkesi kurtaramam. Kendi yaşam enerjimden taviz vermem gerekse bile elimden geldiği kadar yardım etmeye çalışacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650112
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650112,
					"content": "On kişiden yalnızca beşi kurtarılabiliyorsa ben altı kişiyi kurtarmaya çalışacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741650113
					],
					"speakerTitle": "Nergis Haçı"
				},
				{
					"id": 741650113,
					"content": "Şimdi Kutsal Kılıcı alacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nergis Haçı"
				}
			]
		},
		{
