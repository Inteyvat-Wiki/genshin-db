				},
				{
					"id": 190551803,
					"content": "O döndükten sonra ticari faaliyetimizi geliştirmeye yönelik çalışmalar yapmaya başladık. Kısa süre sonra Narukami Adası'nda yeni bir mal yasası çıkarılma çalışmaları başladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551804
					],
					"speakerTitle": "Gorou"
				},
				{
