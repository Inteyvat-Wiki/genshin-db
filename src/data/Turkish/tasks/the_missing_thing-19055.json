				"points": []
			},
			"dialogs": [
				{
					"id": 190551601,
					"content": "#Sana karşı tamamen dürüst olmadığım için tekrar özür dilerim {NICKNAME}. Gerçekten üzgünüm ama bunu yapmam gerekiyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551602
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551602,
					"content": "Anlıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190551603
					]
				},
				{
					"id": 190551603,
					"content": "Bu arada Kokomi'nin bunlardan haberi var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190551604
					]
				},
				{
					"id": 190551604,
					"content": "Evet... Ekselansları... Şey... Savaş birçok kötülük getirdi ve bu sırada bizi çok şey öğrenmeye zorladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551605
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551605,
					"content": "Evet ama soruma cevap vermedin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 190551606,
					"content": "Şey, öhöm... Yeni mal yasasını kimin çıkarmaya çalıştığını merak etmiyor musun? Kesinlikle Kanjou Heyeti değil çünkü onlara doğrudan fayda sağlamıyor. Orada bir bağlantımız da yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551607
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551607,
					"content": "Evet. Sanki tanrılar bir anda ortaya çıkıp size yardım etmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 190551608,
					"content": "Haha, evet, tanrılar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551609
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551609,
					"content": "Bir süre önce Ekselanslarıyla Narukami Adası'ndaki Irodori Festivaline davet edildim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551610
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 190551610,
					"content": "Festivalde ben pazar yerinde beklerken Ekselansları da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gorou"
				}
			]
		},
