					"content": "Güzel. Hadi gidelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190550903
					],
					"speakerTitle": "Todoroki"
				},
				{
					"id": 190550903,
					"content": "Bak, bu Todo... Aman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190550904
					],
					"speakerTitle": "Paimon"
				},
				{
