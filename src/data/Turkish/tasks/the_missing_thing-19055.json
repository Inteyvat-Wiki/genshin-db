				"points": []
			},
			"dialogs": [
				{
					"id": 190551001,
					"content": "İstihbaratın doğruymuş. Geldiğimizde tüm Nobushiler hâlâ uyuyordu, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551002
					],
					"speakerTitle": "Tokuda"
				},
				{
					"id": 190551002,
					"content": "Hepsini yakaladık. Malları da alıp buraya getirdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551003
					],
					"speakerTitle": "Tokuda"
				},
				{
					"id": 190551003,
					"content": "Bir bakayım. Hımm... Hiçbir sorun yok sanırım. Aferin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551004
					],
					"speakerTitle": "Todoroki"
				},
				{
					"id": 190551004,
					"content": "Önemli değil. Kervanının uğraşları sağ olsun köyde tahıl fiyatları düştü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551005
					],
					"speakerTitle": "Tokuda"
				},
				{
					"id": 190551005,
					"content": "Aynen öyle. Ayrıca savaşta aldığımız yaraların vücutlarımızda bu kadar uzun süre etki edeceğini kim bilebilirdi? Neyse ki hayat kurtaracak ilaçlar da getirmişsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551006
					],
					"speakerTitle": "Masashi"
				},
				{
					"id": 190551006,
					"content": "Yukarıdakilerin yardımıyla durum düzeliyor. Bu arada köyün stoku ne durumda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551007
					],
					"speakerTitle": "Todoroki"
				},
				{
					"id": 190551007,
					"content": "Bu gece onaylanmasını sağla. Yarın sabah Sangonomiya Tapınağına gittikten sonra yola çıkıp General Gorou'dan talimat almam lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190551008
					],
					"speakerTitle": "Todoroki"
				},
				{
					"id": 190551008,
					"content": "Endişelenme. Listeyi çoktan hazırladık. Bizi izle yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masashi"
				}
			]
		},
