			},
			"dialogs": [
				{
					"id": 721830201,
					"content": "Hımm, merhaba çocuklar, beni görmeye mi geldiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830202
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 721830202,
					"content": "Gözyaşı Otu tohumları hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830203
					]
				},
				{
					"id": 721830203,
					"content": "Tohumlar... Demek Dinginçay Çaydanlığında tohum yetiştirmek istiyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830204
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 721830204,
					"content": "Herhalde sorun olmaz. Sonuçta Dinginçay Çaydanlığı senin ufak diyarın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830205
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 721830205,
					"content": "Ama bugün sadece bir kese dolusu tohum getirdin. Sadece bu bir kese tohumu mu ekeceksin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830206
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 721830206,
					"content": "Doğru ya! Nasıl tohum toplayacağımızı bile bilmiyoruz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830207,
					"content": "Bu tohum kesesini ektikten sonra daha fazlasını nasıl bulacağız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830208,
					"content": "Üzülme, benim yıllar önce kullandığım ufak bir kutum var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830209
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 721830209,
					"content": "Çiçek ektiğim zamanlarda hepsini bu kutuda tutardım. Kutuda yetiştirilen çiçekler uzun süre burada saklanabiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830210
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 721830210,
					"content": "Dahası, çiçekleri kutuya koyduktan sonra çiçek tohumu da üretmeye başlıyor... Böylece çiçek ekimi oldukça pratikleşiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830211
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 721830211,
					"content": "Tabii artık bu kutu eskisi kadar kullanışlı değil... Ama yine de \"tohum üretme\" gücü duruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830212
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 721830212,
					"content": "Zaten artık eksisi kadar kullanmıyorum, niye sana vermeyeyim ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830213
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 721830213,
					"content": "Çiçek ve bitki ya da ekin büyütmek istersen bu kutu işini görür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830214
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 721830214,
					"content": "Teşekkür ederim Nine!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830215
					]
				},
				{
					"id": 721830215,
					"content": "Teşekkür ederim Nine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830216,
					"content": "Çocuklar bu kadar kibar olmanıza gerek yok. Hadi şimdi kutuyu deneyin bakalım. Söylemiş olayım, çiçeklerle ve bitkilerle ilgilenmek öyle kolay bir iş değildir. Yani hazır olun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830217
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 721830217,
					"content": "Nine gerçekten çok güçlü... Ama kutuyu denemeden önce çaydanlığımıza dönüp tohumları ekmeyi deneyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830218,
					"content": "Hımm, Paimon bunların yakında büyümesini umuyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}