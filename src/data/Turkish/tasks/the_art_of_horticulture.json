			},
			"dialogs": [
				{
					"id": 721830101,
					"content": "Bunlar... Tohum mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830102,
					"content": "Bunlar Gözyaşı Otu Tohumu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830103
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830103,
					"content": "Bu çiçeği bilir misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830104
					]
				},
				{
					"id": 721830104,
					"content": "Bununla ilgili biraz bilgim var. Çiçeğin kendisini daha önce gördüm, başkalarının da faydaları hakkında konuştuğunu duymuştum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830105
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830105,
					"content": "Bu çiçeğin... Rüzgar olmasa bile gök gürültüsü sesi olduğunda hafifçe titrediğini hatırlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830106
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830106,
					"content": "Büyüdüğünde güzel görünüyor mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830107
					]
				},
				{
					"id": 721830107,
					"content": "Sadece görüntüden bahsediyorsak... Gerçekten hoş göründüğünü söyleyebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830108
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830108,
					"content": "Gözyaşı Otu yetiştirmeyi denemek ister misin? Tabii buralarda bu çiçeğe uygun toprak olduğunu sanmıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830109
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830109,
					"content": "Benim yetiştirmek için toprağım var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830110
					]
				},
				{
					"id": 721830110,
					"content": "Öyle mi? Tam da senden beklenecek bir şey... Demek şimdiden toprak bile hediye ettiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830111
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830111,
					"content": "Ayıp olmayacaksa, acaba toprağın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830112,
						721830115
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830112,
					"content": "Inazuma'da değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830113
					]
				},
				{
					"id": 721830113,
					"content": "Ayrıca Mondstadt ve Liyue'de yaptığınız işleri duydum efendim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830114
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830114,
					"content": "Böylesine işlerin ardından toprak hediye edilmemiş olsa daha şaşırtıcı olurdu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830120
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830120,
					"content": "#{NICKNAME}, bu bahsettiğin toprak Ninenin bize verdiği Dinginçay Çaydanlığı değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830121,
					"content": "Onun içinde bir şeyler yetiştirilebiliyor mu? Nine bize bu konuda bir şey söylemedi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830122,
						721830124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830122,
					"content": "Hadi dönüp soralım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830123
					]
				},
				{
					"id": 721830123,
					"content": "Tamamdır, gidip Nineye bir soralım bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830124,
					"content": "Sonuçta Adeptuslar oldukça güçlü.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830125
					]
				},
				{
					"id": 721830125,
					"content": "Öyle mi? Ama Nine de oldukça kuvvetli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830126,
					"content": "Tamamdır, gidip Nineye bir soralım bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721830115,
					"content": "Aslında toprağım çaydanlıkta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721830116
					]
				},
				{
					"id": 721830116,
					"content": "Çaydanlıkta mı? Efendim lütfen böyle şakalar yapmayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830117
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830117,
					"content": "Mondstadt ve Liyue'de yaptığınız işleri de duydum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830118
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830118,
					"content": "Yani sanırım toprağınız ya Liyue'de ya da Mondstadt'ta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830119
					],
					"speakerTitle": "Madarame Hyakubei"
				},
				{
					"id": 721830119,
					"content": "Tam size yaraşır bir toprak efendim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721830120
					],
					"speakerTitle": "Madarame Hyakubei"
				}
			]
		},
