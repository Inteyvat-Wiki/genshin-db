				"points": []
			},
			"dialogs": [
				{
					"id": 240030701,
					"content": "Verut ne zaman büyüyecek? *iç çeker*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030702
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030702,
					"content": "Saklanmayacak mısın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030703
					]
				},
				{
					"id": 240030703,
					"content": "Saklanmak gibi bir niyetim yok. Verut beni bu kadar sık rahatsız etmese daha fazla kitap okumayı yeğlerdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030704
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030704,
					"content": "Ebeveynlerimiz çok sıkı çalışıyorlar, bu yüzden benim bir an önce büyüyüp onların yükünü hafifletmem lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030705
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030705,
					"content": "Ama Verut sürekli annesini özlediğini söylediğinden ona eşlik etmem gerekiyor. Başka türlü susmuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030706
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030706,
					"content": "Pardon, çok fazla konuştum. Ben buluşma noktasında bekleyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030707
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030707,
					"content": "Umarım Verut bu defa kıyafetlerini kirletmez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurele"
				}
			]
		},
