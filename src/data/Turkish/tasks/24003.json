			},
			"dialogs": [
				{
					"id": 240030901,
					"content": "Hey! Saklanacağım yeri ona söyledin mi yoksa? Beni nasıl o kadar hızlı bulabildi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030902
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030902,
					"content": "Sana daha önce de söyledim. Saklanma yerlerini bulmak çok kolay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030903,
						240030904
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030903,
					"content": "Bu oyunda biraz tecrübeliyim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030905
					]
				},
				{
					"id": 240030905,
					"content": "Gerçekten mi? O halde buraya tekrar gelecek misin? Bizimle tekrar oynamak ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030906
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030906,
					"content": "Gündüzleri ebeveynlerimiz çalışıyorlar, abim de hep kitap okuyor... Kimsenin oyun oynayacak vakti yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030907
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030907,
					"content": "Sen de benim gibi raflardaki kitapları okuyabilirsin. Hem saklambaç oynamaktan çok daha faydalı bir şey.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030908
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030908,
					"content": "Yani... Annemin yanına gidip ondan dikiş yapmayı öğrenirim daha iyi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				},
				{
