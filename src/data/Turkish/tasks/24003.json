			"trigger": {
				"objectNames": [
					"Verut",
					"Aurele"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240030101,
					"content": "Bu sefer seçtiğim saklanma yerini asla bulamayacaksın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030102
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030102,
					"content": "Öyle yerlere saklanırsan seni arayan ben değil, ailen olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030103
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030103,
					"content": "Ne yapıyorsunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030104
					]
				},
				{
					"id": 240030104,
					"content": "Abimle saklambaç oynuyoruz... Ama tüm saklanma yerlerimi biliyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030105
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030105,
					"content": "Verut, burada o kadar uzun zamandır oynuyoruz ki saklanmadığın yer kalmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030106
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030106,
					"content": "Saklanamayacağın yerlere gelirsek... Sana neden oralara saklanmaman gerektiğini bin kere söyledim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030107
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030107,
					"content": "Ama oralar o kadar tehlikeli değil ki! Anne ve babamız abartıyor sadece!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030108
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030108,
					"content": "Ama oralara saklandığın zaman üstün başın kirlenip yırtılıyor. Anne ve babamız zaten yeterince sıkı çalışıyorlar, onları daha da yormasan iyi edersin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030109
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030109,
					"content": "Aa... Doğru söylüyorsun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030110,
						240030111
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030110,
					"content": "Ben de katılabilir miyim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030112
					]
				},
				{
					"id": 240030112,
					"content": "Gerçekten mi? Benimle oynamak mı istiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030113
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030113,
					"content": "Verut, başkalarını rahatsız etme! Pardon, kardeşim oyun oynamaktan başka bir şey düşünmüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030114,
						240030115
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030114,
					"content": "Merak etme, vaktim var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030116
					]
				},
				{
					"id": 240030116,
					"content": "Harika! Gördün mü abi? Benimle oynamak isteyen o! Kesin senden daha iyi saklanacağım, izle de gör!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030117
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030117,
					"content": "*iç çeker* Peki o halde. Sana güveniyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030118
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030118,
					"content": "Verut, sana gitmemeni söylediğim yerlerde saklanma, tamam mı? Anne ve babamız geri gelir de, ki bugün geç gelecekler, kıyafetlerini yırtıklar içinde görürse kimse senin kıyafetlerini düzeltmekle uğraşmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030119
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030119,
					"content": "Tamam, anladım... Of, çok gıcıksın! Şimdi saklanmaya gidiyorum. Sen de hemen saklan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030120
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030120,
					"content": "Önce sen saklan. Ben nerede saklanacağıma çoktan karar verdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030121
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240030121,
					"content": "Gerçekten mi? Hava atıyorsun! Kesin bulunacaksın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240030122
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240030122,
					"content": "Aurele ve Verut, kendi saklanma yerlerine geçerler...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 240030115,
					"content": "Sorun değil. Beni rahatsız etmiyorsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030116
					]
				},
				{
					"id": 240030111,
					"content": "Belki seni bulamayabilirim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240030112
					]
				}
			]
		},
