			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Konda Densuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721110701,
					"content": "Bu... Bu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110702
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110702,
					"content": "Arabayı parçalarken bu kadar dikkatsiz davrandığıma inanamıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110703
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110703,
					"content": "Hey, sonunda itiraf ettin işte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110704,
					"content": "Yaptığınız bunca araştırmanın üzerine söyleyebileceğim bir şey kalmadı. Bunu daha fazla saklayamam artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110705
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110705,
					"content": "O zaman yaşananları az çok çözmüşsünüzdür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110706
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110706,
					"content": "Gayet de çözdük! Densuke Dede, sen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110707,
					"content": "Bir Şogunluk arabasını soymaya kalktın, değil mi? Arbedenin ortasında arabayı tek yumrukta parçaladın, arabadakiler de doğruca dereye uçtu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110708,
					"content": "Kaçmak isteyen Şogunluk askerleri de dikkatini dağıtmak için para keselerini kuyuya attılar! Sen de başkaları Morayı çalmasın diye kuyuyu kilitledin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110709,
					"content": "Değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110710,
					"content": "Ne? Yok daha neler, öyle bir şey olmadı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110711
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110711,
					"content": "Hadi ya? Paimon kuyunun dibindeki Moraları almak için senden kuyunun anahtarını isteyecekti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110712,
					"content": "Onları Şogunluğa teslim edeceğim! Aynen, hepsi doğrudan Şogunluğa gidecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110713,
					"content": "*iç çeker* İyi tamam, olanları anlatayım madem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110714
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110714,
					"content": "Köyde içip içip sapıtan birkaç genç var. Yine içtikleri bir gün gidip bir Şogunluk arabasını soydular. Kese ve mallar Şogunluğa ait yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110715
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110715,
					"content": "İnsanlar köyümüzde böyle uygunsuz bir hadise yaşandığını duysun istemedim. Ben de bu nedenle olayın üstünü örtmeye çalıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110716
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110716,
					"content": "Para kesesini kendine istediğini itiraf ettin ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110717,
					"content": "Onu gerçeği saklamak için söyledi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110718
					]
				},
				{
					"id": 721110718,
					"content": "Evet. İtiraf edersem araştırmayı bırakırsınız diye düşünmüştüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110719
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110719,
					"content": "Bu olaya bulaşan bir tek benim... Başka kimseye zarar gelmediyse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110720
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110720,
					"content": "Bunu lütfen Şogunluğa bildirmeyin. Kendimi kurtarmaya çalışmıyorum. Bu olay yüzünden köyümüzün aşağılanmasını istemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110721,
						721110724
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110721,
					"content": "Seni şikayet etme gibi bir niyetim yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110722
					]
				},
				{
					"id": 721110722,
					"content": "Evet, buraya o nedenle gelmedik ki zaten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110723,
					"content": "Oh, çok şükür! Çok şükür...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110727
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110727,
					"content": "Bu örtbas işini vicdanıma yediremedim, o yüzden her şeyi günlüğüme yazdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110728
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110728,
					"content": "Günlüğü de çatıya fırlattım. Okumak isterseniz buyurun. Çatımı daha yeni onardım, lütfen zarar vermeyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110729
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110729,
					"content": "Kuyudaki kilide gelecek olursak...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110730
					]
				},
				{
					"id": 721110730,
					"content": "Evet, kuyuyu ben kilitledim. Anahtarı nereye sakladığımı da günlüğüme yazmıştım, gidip okuyabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110731
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110731,
					"content": "Densuke Dede, Konda Köyü bariyeri hakkında bir şey biliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110732
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110732,
					"content": "Bariyer mi? Demek o eski efsaneyi hâlâ hatırlayanlar var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110733
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110733,
					"content": "Söylentilere göre kadim zamanlarda Yıldırım Kirazının kökleri bu köyün altında yatıyormuş. Tabii bu Narukami Adası'ndaki barışı koruyan beş kökten birisi oluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110734
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110734,
					"content": "Kökleri ve bariyerini koruma görevinin bizzat Kitsune Saiguu tarafından bize, yani Konda Klanına verildiği söyleniyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110735
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110735,
					"content": "Tabii bu evvel zaman içindeydi, detaylarını pek hatırlayamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110724,
					"content": "Ben sadece gerçeği öğrenmek istiyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110725
					]
				},
				{
					"id": 721110725,
					"content": "Evet, biz buraya seni şikayet etmeye gelmedik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110726,
					"content": "Gerçeği mi? Heh... Siz zamane gençleri pek bir meraklısınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110727
					],
					"speakerTitle": "Konda Densuke"
				}
			]
		},
