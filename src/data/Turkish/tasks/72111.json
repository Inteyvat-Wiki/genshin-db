			"dialogs": [
				{
					"id": 721110101,
					"content": "Pekala. Senin için ne yapabilirim evladım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110102
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110102,
					"content": "Kanıtları bulduk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110103
					]
				},
				{
					"id": 721110103,
					"content": "Kanıt mı, ne kanıtı? Ne demek istediğini anlayamadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110104
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110104,
					"content": "Köyde yaşanan garip olayların kanıtlarından bahsediyoruz. Bilmiyormuş gibi yapma lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110105,
					"content": "Saçmalama! Köyümüzde garip ne olay yaşansın? Göster bakalım neymiş bu kanıtlar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110106
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110106,
					"content": "#({NICKNAME}, ilk önce kuyunun orada bulduğumuzu göster. Paimon sana güveniyor!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110107,
					"content": "Bunu arka bahçendeki kurumuş kuyuda bulduk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
