				},
				{
					"id": 721110302,
					"content": "Derenin aşağısında bulduk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110303
					]
				},
				{
					"id": 721110303,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110306
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110306,
					"content": "Bu iki eşyanın birbiriyle bağlantısı olduğunu nasıl kanıtlayacaksınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110307
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110307,
					"content": "Birbirleriyle gayet de bağlantılılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110308,
					"content": "Saçmalık! Nasıl bağlantılı olabilirler ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110309
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110309,
					"content": "Yoksa Moranın üzerinde gizli bir kod falan mı var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110310
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110310,
					"content": "Moranın üzerinde bir şey yok, başka bir şey bulduk biz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721110311,
					"content": "Bunu bir arabanın kalıntılarının yanında bulduk...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721110304,
					"content": "Köyün girişindeki ağaç dallarında bulduk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721110305
					]
				},
				{
					"id": 721110305,
					"content": "Öyle şey mi olur... Beni böyle deneyerek amacınıza ulaşamazsınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110306
					],
					"speakerTitle": "Konda Densuke"
				}
			]
