					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110502
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110502,
					"content": "Beni saçma sapan şeylerle kandırmaya çalışma evlat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721110503
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 721110503,
					"content": "Biri bunu yağmurlu bir gecede kasıtlı olarak bırakmış...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
