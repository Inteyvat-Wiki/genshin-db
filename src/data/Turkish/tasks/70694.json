			"dialogs": [
				{
					"id": 706940101,
					"content": "Bayan İri Kaya, beliniz hâlâ ağrıyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940102
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706940102,
					"content": "Şimdi iyiyim... Sıcak kompres çok iyi geldi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940103
					],
					"speakerTitle": "Yuvarlanan İri Kaya"
				},
				{
					"id": 706940103,
					"content": "Hehe, böyle sıcak kompres yapabilmek için ıslak bandajı yavaş yanan barutla tam ayarında ısıtmak gerekir, yoksa yakma riski var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940104
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706940104,
					"content": "Bandajları bu şekilde ısıtmak da ancak Yoimiya'nın aklına gelirdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706940105,
					"content": "#Bir dakika... Aa bak kim gelmiş! Meşhur kahramanımız {NICKNAME} ve onun küçük beyaz yoldaşı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940106
					],
					"speakerTitle": "Yuvarlanan İri Kaya"
				},
				{
					"id": 706940106,
					"content": "Yoksa klasik bir dokuma parşömen çizgi roman sahnesine mi şahit olmak üzereyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940107,
						706940108
					],
					"speakerTitle": "Yuvarlanan İri Kaya"
				},
				{
					"id": 706940107,
					"content": "Selam! Onu tedavi mi ediyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706940109
					]
				},
				{
					"id": 706940109,
					"content": "Endişelenecek bir şey yok! Doğada dolaşıp antrenman yapmak için yeni zorlu rakipler arıyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940110
					],
					"speakerTitle": "Yuvarlanan İri Kaya"
				},
				{
					"id": 706940110,
					"content": "Kazara belimi incitip tepeden kartopu gibi yuvarlandığımda Yoimiya Hanım bana çok yardımcı oldu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940111
					],
					"speakerTitle": "Yuvarlanan İri Kaya"
				},
				{
					"id": 706940111,
					"content": "Of... Çok canın yanmış olmalı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706940112,
					"content": "Hehe, Ruhyakan Destanı'ndan alıntı yaparsak, \"Ben sadece yoldan geçen bir savaşçıyım...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940113
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706940113,
					"content": "Bunu \"özgür paralı asker\" olarak değiştirebiliriz artık! Şövalyeler, canavarlarla istediğim gibi ilgilenebilmem için bana izin verdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940114,
						706940115
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706940114,
					"content": "Demek hâlâ etrafta dolaşan canavarlar var, öyle mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706940116
					]
				},
				{
					"id": 706940116,
					"content": "İşler pek iyi görünmüyor... Şövalyelerle iletişime geçip destek kuvvet mi istesek?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706940117,
					"content": "Doğru, temkini elden bırakmamalıyız. Fakat durum henüz o kadar da acil değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940118
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706940118,
					"content": "Şövalyeler, yarış alanının etrafındakileri zaten temizlemişti. Şu anda çevrede sadece birkaç başıboş canavar dolaşıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940119
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706940119,
					"content": "Dürüst olmak gerekirse yarışmaya katılan maceracıların çoğu kendini kollayabilecek durumda zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940120
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706940120,
					"content": "Kuvvetli, becerikli ve cesurlar. Onlara sıradan insanlar gibi davranırsak kendilerini aşağılanmış hissedebilirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940121
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706940121,
					"content": "Bu yüzden, Maceracılar Loncası olarak bunu her zamanki gibi bir imtihan olarak ele aldık ve canavarlarla başa çıkmak için bir takım oluşturduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940122
					],
					"speakerTitle": "Yuvarlanan İri Kaya"
				},
				{
					"id": 706940122,
					"content": "Cesaret Sınavı da tam olarak bununla ilgili: Canavarları temizlemek, çeşitli kahramanların savaş tarzlarını taklit etmek ve kendi sınırlarını aşmak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940123
					],
					"speakerTitle": "Yuvarlanan İri Kaya"
				},
				{
					"id": 706940123,
					"content": "Bereket Kolektifinden de böyle düşünmesi beklenirdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940124,
						706940125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706940124,
					"content": "O zaman bunun mutlaka bir parçası olmak istiyorum!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706940126
					]
				},
				{
					"id": 706940126,
					"content": "#Süper! Seni iş başında görmeyeli uzun zaman olmuştu {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706940127
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706940127,
					"content": "Şu anki becerilerini görmeyi gerçekten çok isterim... Göz alıcı hareketlerin acaba hangi havai fişeklere benziyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 706940125,
					"content": "Dışında kalmam mümkün değil!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706940126
					]
				},
				{
					"id": 706940115,
					"content": "Bölgede siviller de olduğu için dikkatli olmamız gerek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706940116
					]
				},
				{
					"id": 706940108,
					"content": "Savaştan mı çıktınız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706940109
					]
				}
			]
		}
	]
}