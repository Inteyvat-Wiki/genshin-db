					"nextDialogs": [
						220250207
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250207,
					"content": "İştah kaybını, ağızda kalan garip tatları ancak böylesine eşsiz bir ziyafet giderir, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250202
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250202,
					"content": "Açıkçası şu an oldukça alengirli bir durumdayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250203
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250203,
					"content": "Bana soracak olursan ille de pahalı bir yemek olmak zorunda değil. Doyurucu ve eşsiz bir tadının olması yeterli olur diye düşünüyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250204
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250204,
					"content": "Bu konuda Jueyun Pilavını öneririm! Hem çıtır olur hem de yoğun baharat içerir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250205
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250205,
					"content": "Jueyun Pilavını hayatımda ilk defa Qingce Köyü'nde yemiştim, üzerinden neredeyse on sene geçti ama tadı hâlâ damağımda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250206
					],
					"speakerTitle": "Li Xiao"
				},
				{
					"id": 220250206,
					"content": "Jueyun Pilavı her türlü sorunu çözer bence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Li Xiao"
				}
			]
