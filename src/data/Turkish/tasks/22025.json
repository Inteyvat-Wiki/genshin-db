			"dialogs": [
				{
					"id": 220250101,
					"content": "Ah... Açlıktan başım dönüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250102
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250102,
					"content": "Ne oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250103
					]
				},
				{
					"id": 220250103,
					"content": "Bilmiyorum... Biraz halsiz hissediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250104
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250104,
					"content": "Muhtemelen dün gece, yaptığın leziz yemeği eve götürdüğümde oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250105
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250105,
					"content": "Yemek oldukça değişik olsa da... En azından karnımı doyurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250106
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250106,
					"content": "Sonrasında iyi bir uyku çekip bugün sıkı çalışmayı planlıyordum fakat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250107
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250107,
					"content": "Tam uykuya dalacakken midemin derinliklerinden gelen yemeğin kokusunu alıp durdum! O yüzden gözüme uyku girmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250108
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250108,
					"content": "Gün doğana dek yarı uyanık bir şekilde böyle döndüm durdum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250109
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250109,
					"content": "Önemli olan nokta uykusuz kalmış olmam değil, sonuçta işim gereği uykusuz kaldığım çok oldu fakat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250110
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250110,
					"content": "Bugün çok ilginç şeyler oldu! Uyanıp ağzıma bir şeyler attığımda kendime gelirim sanıyordum fakat sonrasında yediğim şeyde bile ağzıma dünkü yemeğin tadı geldi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250111
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250111,
					"content": "Çok ağır bir yemekti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220250112
					]
				},
				{
					"id": 220250112,
					"content": "*iç çeker* Ağzımdaki garip tadı sanırım ancak eşsiz lezzetteki bir yemek değiştirebilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250113
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250113,
					"content": "Eşsiz lezzetteki bir yemek mi? Gidip birilerine öyle bir yemek hakkında fikirleri var mı diye soralım mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250114,
					"content": "Bir şeyler öğrenirsek onu Tang Wen Hanım için pişirebiliriz... Böylece sorununu çözebiliriz belki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220250115,
					"content": "Gerçekten mi? Çok teşekkür ederim! Senin için de uygunsa lütfen Ritou'ya gidip sorabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220250116
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220250116,
					"content": "Doğru hatırlıyorsam Ritou'nun tüccarlarından biri olan Li Xiao yemekler hakkında çok şey biliyordu. Chuyu Ticaret Şirketinden Qiuyue de amatör bir gurme olarak bilinir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				}
			]
		},
