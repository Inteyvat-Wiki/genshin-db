				]
			},
			"dialogs": [
				{
					"id": 766751001,
					"content": "Kurtarıcımızı kurtarıp kampa geri getiren kahraman neden bir köşede tek başına oturuyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751002,
						766751003
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751002,
					"content": "Lafı ağzımdan aldın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751004
					]
				},
				{
					"id": 766751004,
					"content": "Heh... Doğrusunu söylemem gerekirse şu an kadehimde çok özel bir içki var. Sadece yalnızken içilebilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751005
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751005,
					"content": "... Ama madem beni yakaladın, yapacak bir şey yok. Al, bir kadeh de sen iç.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751006,
						766751007
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751006,
					"content": "... Tahmin etmiştim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751008
					]
				},
				{
					"id": 766751008,
					"content": "Yakalandım! Şakaydı. Şu an yanımda bir damla bile içki yok. Canın gerçek bir içki çekiyorsa Erminie'yi bul, onda bolca var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751009
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751009,
					"content": "Bir kampta her zaman sarhoş yoldaşlarını gecenin tekinsizliğinden koruyacak ayık birine ihtiyaç vardır. Seferimiz başladığından beri bu emrim geçerlidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751010
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751010,
					"content": "Büyük şanssızlık, değil mi? Ne tesadüf ki bu gece o ayık kişi olma sırası bende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751011
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751011,
					"content": "... Yani bu gece diğer herkes sarhoşken ben olamam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751012,
						766751013
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751012,
					"content": "Gerçekten şanssızlık mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751014
					]
				},
				{
					"id": 766751014,
					"content": "Kim bilir? Belki de kader bizimle uğraşmaktan zevk alıyordur. Yarın gelseydi belki de şu an aşağıda gönlümce şarap içiyor olurdum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751015
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751015,
					"content": "Ama sadece bir gün geç gelseydi belki de kampın yanından geçip giderdin. Ziyafeti kaçırırdın, konuşmak için bu fırsatı bile bulamazdın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751016
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751016,
					"content": "Vakti gelmeden kimse hangi seçimin ne sonuç doğuracağını bilemez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751017
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751017,
					"content": "Tıpkı Mondstadt'tan başlayan bu sefere liderlik etmeye karar vermem gibi... Buralara kadar geleceğimi hiç hayal etmemiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751018
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751018,
					"content": "Seferi başlatma sebebin... Vahşi Avın işini bitirmek miydi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751019
					]
				},
				{
					"id": 766751019,
					"content": "... İş oraya geldi, evet. Ama biz yola çıktığımızda \"bildiğim\" tek bir şey vardı: Kuzeyde tüm Teyvat'ı kasıp kavurabilecek bir Hiçlik fırtınası doğuyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751020
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751020,
					"content": "Harekete geçmemiz biraz zaman aldı ama düşmanın nerede ortaya çıkacağı, nasıl bir şekle bürüneceği...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751021
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751021,
					"content": "... Yola çıktığımızda bunların hepsi bizim için muammaydı. Elimizden gelen tek şey, bir yandan ilerleyip bir yandan da istihbarat toplamak ve her olasılığa karşı hazırlanmaktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751022,
						766751023
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751022,
					"content": "Bildikleriniz bu kadar olmasına rağmen yine de sefere çıktınız, öyle mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751024
					]
				},
				{
					"id": 766751024,
					"content": "Haha! Çabuk öğreniyorsun bakıyorum. Ne yazık ki düşman, biz hazırlık yapana dek öyle oturup beklemeyecekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751025
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751025,
					"content": "Tereddüt ettiğimiz her saat Hiçlik sayısız insanın hayatını yutuyordu. Ne kadar erken harekete geçersek kaderlerini o kadar erken değiştirebilirdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751026
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751026,
					"content": "Bu \"seferi\" başlatmak için ihtiyacımız olan tüm istihbarat buydu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751027,
						766751028
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751027,
					"content": "Boşuna Poyraz Şövalyesi dememişler sana...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751029
					]
				},
				{
					"id": 766751029,
					"content": "Bu kadar resmiyete gerek yok \"Fahri Şövalye\"! Sen de farklı değilsin. Senin yolculuğun da birçok insanın kaderini değiştirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751030
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751030,
					"content": "Mesela Mondstadt, Dvalin... Ya da Nod-Krai, keşif birliği... Hatta benim kaderimi bile değiştirdin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751031
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751031,
					"content": "#Ateşin etrafında şarkı söyleyip bir şeyler içerek geleceği düşünebiliyor olmamız... Sen gelmeseydin bunların hiçbiri olmazdı {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751032
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751032,
					"content": "... Gerçekten o kadar müthiş biri miyim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751033
					]
				},
				{
					"id": 766751033,
					"content": "... Heh, kim bilir? Ne de olsa kader değişkendir ve anlaşılması zordur. Ama sen hayatta olduğun sürece umut var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751034
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751034,
					"content": "Bu gece içmediğimiz şarabı yarın içeriz, çocuklar benim payımı ayırır. Nefes aldığımız sürece yarınlar bize daha çok şarap ve kahkaha getirecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751035
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751035,
					"content": "O zaman şerefe! Yarına! Umuda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				},
				{
					"id": 766751028,
					"content": "Favonius Şövalyelerinden de bu beklenirdi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751029
					]
				},
				{
					"id": 766751023,
					"content": "İstihbarat her harekatın temelidir dememiş miydin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751024
					]
				},
				{
					"id": 766751013,
					"content": "Karahindiba Şarabının geleceği günü mü buldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751014
					]
				},
				{
					"id": 766751007,
					"content": "Elma Şırası bu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751008
					]
				},
				{
					"id": 766751003,
					"content": "Neden tek başına içiyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751004
					]
				}
			]
		},
