			"dialogs": [
				{
					"id": 766750901,
					"content": "Aa! Büyük Kumandan! Fahri Şövalye! Geri döndüler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750902
					],
					"speakerTitle": "Winfried"
				},
				{
					"id": 766750902,
					"content": "Döndüler! Döndüler! Herkes sıraya girsin ve onları doğru düzgün karşılasın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750903
					],
					"speakerTitle": "Ekbert"
				},
				{
					"id": 766750903,
					"content": "Vay canına, bu kadar popüler miyiz? Paimon'un yüzü kızarmak üzere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750904,
					"content": "Rüzgar uzaklardaki o mis kokuyu nasıl da taşıyor! Yüce Barbatos, gerçekmiş! Karahindiba Şarabı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750905
					],
					"speakerTitle": "Leifhelm"
				},
				{
					"id": 766750905,
					"content": "Hem de Şafak Şaraphanesinin özel üretimi! Tüm o değerli anılarım... Geri döndüler... Hepsi gözümde canlanıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750906
					],
					"speakerTitle": "Winfried"
				},
				{
					"id": 766750906,
					"content": "Şey... Bu karşılama bizim için değilmiş galiba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750907,
					"content": "Evet, işte bu, lezzet dediğin bu... Tıpkı hatırladığım gibi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750908
					],
					"speakerTitle": "Ekbert"
				},
				{
					"id": 766750908,
					"content": "İnanılmaz, bunca yılın ardından...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750909
					],
					"speakerTitle": "Leifhelm"
				},
				{
					"id": 766750909,
					"content": "İyi bir Şafak Şaraphanesi şarabının tadını çoktan unuttuğumu düşünmeye başlamıştım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750910
					],
					"speakerTitle": "Winfried"
				},
				{
					"id": 766750910,
					"content": "Eğer tadı değişmediyse... Pınarköy'deki evim de muhtemelen değişmemiştir... Değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750911,
						766750912
					],
					"speakerTitle": "Ekbert"
				},
				{
					"id": 766750911,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750913
					]
				},
				{
					"id": 766750913,
					"content": "... Sağ ol Fahri Şövalye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750914
					],
					"speakerTitle": "Ekbert"
				},
				{
					"id": 766750914,
					"content": "... Bu kadar yeter, artık susalım millet. Herkes dönene dek fıçılar kapalı kalacak. O zamana kadar parti hazırlıklarını bitirelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750915
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750915,
					"content": "Emredersiniz kumandanım! Hemen başlıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750916
					],
					"speakerTitle": "Winfried"
				},
				{
					"id": 766750916,
					"content": "... Ne demiştim ben? İçki içmek, ciddi işlerin en ciddisidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750917
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750917,
					"content": "Oooo... Karamelize Soslu Rosto... Çiçekli Tavuklar... Paimon buralarda böyle hakiki Mondstadt yemekleri yiyebileceğini hiç düşünmemişti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750918,
					"content": "Şey, bir dakika, Varka nerede? Onu gören oldu mu? Bir yerlerde sarhoş olup sızmamıştır herhalde, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750919,
						766750920
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750919,
					"content": "Onda o karaciğer varken mümkün mü?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750921
					]
				},
				{
					"id": 766750921,
					"content": "Tamam... Paimon bitirince yetişir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750920,
					"content": "Ben bir gidip bakayım, sen yemeye devam et.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750921
					]
				},
				{
					"id": 766750912,
					"content": "Aynı, ben uğradım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750913
					]
				}
			]
		},
		{
			"id": 7667510,
