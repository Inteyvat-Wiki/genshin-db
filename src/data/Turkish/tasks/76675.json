			},
			"dialogs": [
				{
					"id": 766750401,
					"content": "Hey, iyi misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750402,
					"content": "İ-İyiyim... Of, neyse ki hızlı geldiniz, yoksa gün batımına kadar yetişemezdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750403
					],
					"speakerTitle": "Donatas"
				},
				{
					"id": 766750403,
					"content": "... Çok şükür! \"Temel malzemelerimiz\" sağ salim geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750404
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750404,
					"content": "Şey, hangi malzeme bu kadar önemli olabilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750405,
						766750406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750405,
					"content": "İçki olmalı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750407
					]
				},
				{
					"id": 766750407,
					"content": "Gözlerin keskinmiş! Şafak Şaraphanesinden özel olarak sipariş ettiğimiz Karahindiba Şarabı geldi! Mondstadt'ın özü tek bir şişede!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750408
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750408,
					"content": "Ta oradan buraya getirene kadar neler çektiğimizi tahmin bile edemezsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750409
					],
					"speakerTitle": "Donatas"
				},
				{
					"id": 766750409,
					"content": "Eline ayağına sağlık! Bu geceki ziyafette bizimle içiyorsun. Bütün kamp senin şerefine kadeh kaldırmayı dört gözle bekliyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750410
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750410,
					"content": "... Yani acele etmenin tek nedeni içkilerin zamanında yetişmesini sağlamak mıydı? Paimon da senin bir kez olsun ciddileştiğini sanmıştı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750411,
					"content": "Ne? İçki içmenin dünyanın en ciddi meselesi olmadığını mı söylüyorsun yani? Çünkü tam şu an bir şeyler içmeyi çok isterdim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750412
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750412,
					"content": "B-Bir dakika! Lütfen dur biraz! Şu an hiç sırası değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750413
					],
					"speakerTitle": "Donatas"
				},
				{
					"id": 766750413,
					"content": "Evet, doğru diyor! Önce şu ciddi meseleyi halletmelisin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750414,
					"content": "Bu özel bir üretim. Çökmesini önlemek ve tadını korumak için sürekli hareket halinde tutulması gerekiyor! Bu kadar uzun süre beklediği için kalitesinin... En az yüzde on düştüğünü söyleyebilirim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750415
					],
					"speakerTitle": "Donatas"
				},
				{
					"id": 766750415,
					"content": "Yüzde on mu? Kabul edilemez bir oran bu! Hazır olana kadar kimse bir damlasına bile dokunmasın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750416
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750416,
					"content": "... Peeeeki. Sen bilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750417,
					"content": "Nasıl eski haline getirebiliriz bunu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750418
					]
				},
				{
					"id": 766750418,
					"content": "Fıçıların yuvarlanmasını sağlayan özel bir mekanizma yaptırdık... Ama görünüşe göre düşerken kırılmış. Bu yüzden sanırım şimdi eski usul kas gücü kullanmamız gerekecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750419
					],
					"speakerTitle": "Donatas"
				},
				{
					"id": 766750419,
					"content": "Hımm, yani şimdi <color=#00E1FFFF>ahşap fıçılara vurup onları hedeflerine yuvarlayacağız</color> öyle mi? Klasik bir Favonius Şövalyeleri kuvvet idmanı gibi duruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750420
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750420,
					"content": "Bir dakika, Şövalyeler bu şekilde mi idman yapıyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750421
					]
				},
				{
					"id": 766750421,
					"content": "Evet, bu idman kişiye güç kontrolü ve hassasiyet kazandırır. Bu idmanda ikisi de gerekir, yoksa fıçı yoldan sapar. Birçok şövalye için temel bir idmandır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750422,
						766750423
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750422,
					"content": "Merak ettim doğrusu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750424
					]
				},
				{
					"id": 766750424,
					"content": "Demek temel talimlere meraklısın ha? Laurent ve diğerlerinin dönmesine daha var aslında...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750425
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750425,
					"content": "Pekala, bu iş sende o zaman. Fıçıları yanlışlıkla uzağa yuvarlarsan da sorun değil. Bana seslen yeter, ben onları yerlerine geri koyarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750423,
					"content": "Fahri Şövalye olarak ben de bir denemek isterim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750424
					]
				},
				{
					"id": 766750406,
					"content": "Burnuma alkol kokusu geliyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750407
					]
				}
			]
		},
