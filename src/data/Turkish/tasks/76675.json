				{
					"id": 766750501,
					"content": "Fıçılarla ilgili yardıma mı ihtiyacın var, yoksa biraz sohbet etmek mi istedin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750502,
						766750504
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750502,
					"content": "Lütfen tekrar yerleştir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750503
					]
				},
				{
					"id": 766750503,
					"content": "Pekala! Pes etmek yok, moralini bozma ve tekrar dene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750504,
					"content": "Biraz konuşalım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750505
					]
				},
				{
					"id": 766750505,
					"content": "Noelle'e idman yaptırdığım zamanlarda ne zaman gerilse fıçıları paramparça ederdi. Sonrasında da tüm dağınıklığı tek başına toplardı, yardım kabul etmezdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750506
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750506,
					"content": "Zamanla... Şövalyelerin tartışmasız en iyi temizlikçisi oldu. Ha, kendisi bunun farkında olmayabilir ama bu da bir ilerlemedir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				}
			]
		},
