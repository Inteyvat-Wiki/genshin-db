			"dialogs": [
				{
					"id": 766750101,
					"content": "... Nannina kuzeyi tutuyor, o zaman doğuyu da Laurent alsın... Tamam, şimdilik bu kadar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750102
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750102,
					"content": "Selam Varka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750103,
					"content": "Hım? Fahri Şövalye? Paimon? Sizi kampıma hangi rüzgar attı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750104,
						766750105
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750104,
					"content": "Öylesine dolaşıyorduk, sana rastladık.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750106
					]
				},
				{
					"id": 766750106,
					"content": "Yok canım! Favonius Şövalyelerinin her kampı sizin de kampınız sayılır, buyurun lütfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750107
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750107,
					"content": "Ama bir dahakine önceden haber verin ki ben de levazım subayımıza sizin için güzel yiyecek ve içecekler hazırlatayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750108
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750108,
					"content": "Burası gerçekten keşif güçlerinin kampı mı? Paimon biraz daha... Kalabalık olmasını bekliyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750109,
					"content": "Keşif gücündeki çoğu kişi burada görevli değil, olanların da çoğu devriyede. Açıkçası... Hahaha, biraz hayalet kasaba havası var gerçekten de.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750110
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750110,
					"content": "Buradakiler ne yapıyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750111
					]
				},
				{
					"id": 766750111,
					"content": "Hiçlikle ilgili toplayabildiğimiz tüm istihbaratı toplamaya çalışıyoruz. Tabii şu an Vahşi Avla uğraşıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750112
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750112,
					"content": "Onun için de Nod-Krai'ın dört bir yanından istihbarat topluyoruz. Rerir mühürlenmiş olsa bile ortalık tamamen durulmuş değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750113
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750113,
					"content": "Ayrıca Hiçlikle ilgili toplayabildiğimiz tüm istihbaratı topluyoruz. Nod-Krai'daki durum şimdilik stabil ama tetikte olmalıyız. Hiçliğin ne zaman geri döneceği hiç belli olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750114
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750114,
					"content": "İstihbarat her harekatın temelidir. Mesele sadece düşman hareketleri de değil. Arazi veya hava durumundaki değişiklikler, zafer ile yenilgi arasındaki farkı belirleyebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750115
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750115,
					"content": "Ayrıca ileride Kuzey İstihbarat Ağı ile uzun vadeli bir iş birliği yapmayı ve bu geçici kampı bir istihbarat istasyonuna dönüştürmeyi planlıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750116
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750116,
					"content": "İstihbarat istasyonu mu? Vay be, Fontaine'deki casusluk konulu gerilim filmlerindeki gibi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750117,
					"content": "Hahaha, hiç de bile! İçinde savunması bu denli zayıf bir kamp olan tek bir kitap ismi söyle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750118
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750118,
					"content": "Seferde geçirdiğimiz yıllar boyunca Teyvat'ın her yerinde farklı Hiçlik felaketlerinin meydana geldiğini gördük. Hiçlik anormal derecede kurnaz, sürekli değişiyor ve hiçbir saldırısı birbirine benzemiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750119
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750119,
					"content": "Kuzey İstihbarat Ağını kullanarak bulgularımızı paylaşmayı ve bu iş birliği sayesinde Hiçlik hakkında bilgi toplamaya devam etmeyi umuyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750120
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750120,
					"content": "Bu tek bir ulusun sorumluluğu değil. Nod-Krai'da rüzgar her gün farklı bir yönden esiyor... Bu yüzden burası bir ileri karakol kurmak için ideal bir yer bence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750121
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750121,
					"content": "Haaa, demek o yüzden... İşte \"şövalyelik\" dediğin budur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750122,
					"content": "Haha! \"Şövalyelik\" iyidir hoştur ama... Aslında biz bu istasyonu daha yeni kurduk ve henüz çevredeki arazinin düzgün bir haritası bile yok elimizde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750123
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750123,
					"content": "Yakınlarda herhangi bir inşaat malzemesi veya istihbarata rastlarsan buraya getirmeyi unutma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750124
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750124,
					"content": "İçin rahat olsun, sen bizim Fahri Şövalyemizsin. Sana göz kulak oluruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750125
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750125,
					"content": "Hallederim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750126
					]
				},
				{
					"id": 766750126,
					"content": "Hah, bir sefer biter, diğeri başlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750127
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750127,
					"content": "Büyük Kumandan! Bir sorunumuz var efendim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750128
					],
					"speakerTitle": "Winfried"
				},
				{
					"id": 766750128,
					"content": "Öyle mi? Nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750129
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750129,
					"content": "Bugün beklediğimiz o önemli misafir... Dağın eteklerinde mahsur kalmış!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750130
					],
					"speakerTitle": "Winfried"
				},
				{
					"id": 766750130,
					"content": "NE? O... Düşündüğüm kişi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750131
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750131,
					"content": "Evet efendim! Ta kendisi! Mevcut birliklerimizin çoğu devriyede. Kimi yeniden görevlendirelim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750132
					],
					"speakerTitle": "Winfried"
				},
				{
					"id": 766750132,
					"content": "Gerek yok! Sen yolu tarif et yeter, ben kendim hallederim! Fahri Şövalye, Paimon, haydi görüşürüz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750133
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750133,
					"content": "Varka rüzgar gibi yola koyulur...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						766750134
					]
				},
				{
					"id": 766750134,
					"content": "... Vay be, Paimon Varka'yı hiç bu kadar gergin görmemişti! Şu misafirin kim olduğunu merak etti şimdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750135,
					"content": "Acaba... Çok önemli bir muhbir mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750136
					]
				},
				{
					"id": 766750136,
					"content": "Evet, büyük ihtimalle! Hadi onu takip edelim ve yardıma ihtiyacı var mı bir bakalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766750105,
					"content": "Bölüyor muyuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750106
					]
				}
			]
		},
