					"nextDialogs": [
						766750605
					]
				},
				{
					"id": 766750605,
					"content": "Bu idmanı Razor'la ilk yaptığımda bitirmemiz tam bir gün sürmüştü. Neden biliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750606
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 766750606,
					"content": "Günün dörtte birini fıçıları yuvarlayarak, kalan dörtte üçünü de benim ne dediğimi anlamaya çalışarak geçirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				}
			]
		},
