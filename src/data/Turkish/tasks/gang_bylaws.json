			"dialogs": [
				{
					"id": 191431001,
					"content": "Ne yapacağız? Bugün Dehanın Yakarışı oynayamayacak mıyız cidden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431002
					],
					"speakerTitle": "Souta"
				},
				{
					"id": 191431002,
					"content": "Başka bir yerde oynayabiliriz belki ama yetişkinlerden kaçmak için köprünün altı dışında nereye saklanabiliriz ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431003
					],
					"speakerTitle": "Eita"
				},
				{
					"id": 191431003,
					"content": "Buldum! Yoimiya'ya söyleyelim de havai fişek patlatsın. Yerimizi kapan o adam da korkup kaçar belki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431004
					],
					"speakerTitle": "Souta"
				},
				{
					"id": 191431004,
					"content": "O da biraz kabalık olmaz mı? Gerçi önce o bizi kovdu ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431005
					],
					"speakerTitle": "Eita"
				},
				{
					"id": 191431005,
					"content": "Evet, hepsi onun suçu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431006
					],
					"speakerTitle": "Souta"
				},
				{
					"id": 191431006,
					"content": "Bence... Eve gidip ödevlerimizi yapsak daha iyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191431007
					],
					"speakerTitle": "Yuma"
				},
				{
					"id": 191431007,
					"content": "Sürekli oyun oynayıp hiç ders çalışmayan insanlar da büyüyünce <color=#00E1FFFF>köprünün altında takılan o yetişkinler gibi</color> olur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuma"
				}
			]
		},
