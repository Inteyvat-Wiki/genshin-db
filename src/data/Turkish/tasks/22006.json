			"dialogs": [
				{
					"id": 220060701,
					"content": "Neyse ki yeşim levha hasar görmemiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060702,
						220060706
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060702,
					"content": "Niye onlara vermedin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060703
					]
				},
				{
					"id": 220060703,
					"content": "Yadigarlar alimlerin incelemesi, sanatçıların ilham alması, insanların bir sergide görüp hayranlık duyması içindir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060704
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060704,
					"content": "Üç beş kuruşa satsınlar diye hırsızlara verilemez. Hem yadigara hem de tarihe saygısızlık olur bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060705
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060705,
					"content": "Tarihe ve tarihten bize kalanlara zerre değer vermeyen insanların karşısında asla geri adım atmam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060706,
					"content": "Yeşim levha hakkında biraz daha bilgi verir misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060707
					]
				},
				{
					"id": 220060707,
					"content": "İlgini çekti, değil mi? Pekala, öncelikle şunu sorayım: Yadigarın kültürel değeriyle mi yoksa parasal değeriyle mi ilgileniyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060708
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060708,
					"content": "Şaka şaka. Bu yeşim levhada Hükümdarlar Savaşı'ndan bir olayın kaydı var... Yanılmıyorsam bir klan çatışması anlatılıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060709
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060709,
					"content": "Deşifre edebilirsem belki Sumeru Akademisinin kayıtlarındaki bazı boşlukları doldurabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060710
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060710,
					"content": "Gerçi belki de o boşluklar çoktan doldurulmuştur ve benim öğrenmeye iznim yoktur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
