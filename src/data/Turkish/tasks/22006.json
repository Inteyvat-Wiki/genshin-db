			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220060301,
					"content": "Sağ ol Gezgin! Korkunçtu... Hazine Avcıları şu sıralar çok agresif davranıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060302
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060302,
					"content": "Sen kimsin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060303
					]
				},
				{
					"id": 220060303,
					"content": "Ben Soraya, misafir bir alimim. Hatta şu an bir araştırmanın ortasındayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060304
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060304,
					"content": "Birkaç gün önce bazı ipuçlarını takip ederek bir harabeye ulaştım. Harabenin içinde Hükümdarlar Savaşı'na dair kayıtlı bilgilerin yer aldığı yeşim bir levha buldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060305
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060305,
					"content": "Tam çıkarken Hazine Avcıları tarafından pusuya düşürüldüm. Kaçmaya çalıştım ama beni yakaladılar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060306
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060306,
					"content": "Sen olmasaydın benim de yeşim levhanın da işi yaştı kısacası. O yüzden bir kez daha teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060307
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060307,
					"content": "Sen de mi alimsin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060308
					]
				},
				{
					"id": 220060308,
					"content": "Buralarda başka alimler de mi var? Kim mesela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060309
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060309,
					"content": "Bao'er mi? Bir dakika... Az önce Hazine Avcıları beni pusuya düşürdüğünde içlerinden biri Bao'er tüm hazineyi gasp etti diye şikayet ediyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060310
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060310,
					"content": "İlginç tesadüf... Şu Bao'er'i biraz daha anlatabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060311
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060311,
					"content": "Hatırladığım kadarıyla...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060312
					]
				},
				{
					"id": 220060312,
					"content": "Hımm. Bao'er'in sana gösterdiği yerler benim hedeflediğim yerlerle aynı. Bu tesadüf pek de tesadüf değildir belki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060313
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060313,
					"content": "Gerçekten Hazine Avcıları ile iş birliği yapıyorsa... Hazine bulma umuduyla bir süredir beni takip ediyorlardı kesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060314
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060314,
					"content": "Bao'er hazinenin hepsini kendisine istedi muhtemelen, bu yüzden de gruptan ayrılıp tek başına ilerlemeye çalıştı. Ama bu bölge tek kişinin arayamayacağı kadar büyük, o yüzden...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060315
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060315,
					"content": "Sanırım seni kullanmış Gezgin. Eminim bu harabeyi uzun zamandır gözlüyordu... Yoldaşlarıyla ben oraya sizden önce gitmiş olduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060316
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060316,
					"content": "Telaş yapmanı istemem, sonuçta ben sadece tahminimi söylüyorum. Ama Bao'er... Şüpheli duran bir isim. Sahte ad veya kod adı olabilir belki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060317
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060317,
					"content": "Gezgin, onu sürdüğü izden saptırabilir misin? Bu yeşim levha asla yanlış ellere geçmemeli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060318,
						220060319
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060318,
					"content": "Tabii ki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060320
					]
				},
				{
					"id": 220060320,
					"content": "Sağ ol. Gerçi elin boş dönersen bir şeyler döndüğünü hisseder muhtemelen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060321
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060321,
					"content": "Bir fikrim var. Küçük bir şey vereyim sana, bunu gidip ona ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060322
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060322,
					"content": "Bundan az biraz kar edebilir. Umarım şimdilik şüphe çekmemeye yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060325
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060325,
					"content": "Tamam, artık geri dönsen iyi olur. Yoldaşlarını pataklamış olabilirsin ama tek başına seyahat ediyorsa henüz haberi olmamıştır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060326
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060326,
					"content": "Ha, bir de onun daha sonraki hazine avlarından birine katılıp bir şey bulursan bana getirebilirsin. Genelde Wangshu Hanında oluyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060327
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060327,
					"content": "*iç çeker* Bugüne kadar hayatta pek bir şey başarmış sayılmam ama tarihi bir yadigarı güvende tutabilirsem en azından bir işe yaramış olurum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060319,
					"content": "Elim boş dönersem şüphelenir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060323
					]
				},
				{
					"id": 220060323,
					"content": "İyi bir noktaya parmak bastın... O zaman bunu al. Pek değerli sayılmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060324
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 220060324,
					"content": "Bundan az biraz kar edebilir. Umarım şimdilik şüphe çekmemeye yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060325
					],
					"speakerTitle": "Soraya"
				}
			]
		},
