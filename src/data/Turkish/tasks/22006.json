			"dialogs": [
				{
					"id": 220060601,
					"content": "Nerede kaldın? Bir şey bulabildin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060602,
						220060603
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060602,
					"content": "Bunu buldum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060604
					]
				},
				{
					"id": 220060604,
					"content": "Eh... Bu da fena değil ama... Asıl aradığım şeyle uzaktan yakından alakası yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060605
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060605,
					"content": "Neyse, yadigar yadigardır. Alayım. Merak etme, iyi emeller uğruna kullanılmasını sağlayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060609
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060609,
					"content": "Yardımın için teşekkürler. Karşılığında bunları vermek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060610
					],
