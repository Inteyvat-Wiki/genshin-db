			},
			"dialogs": [
				{
					"id": 220060101,
					"content": "Hiçbir yerde bulamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060102
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060102,
					"content": "Bu sefer ne kaybettin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060103
					]
				},
				{
					"id": 220060103,
					"content": "Şey, bu sefer bir şey kaybetmedim... Hâlâ arıyorum! Ama bir türlü bulamıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060104
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060104,
					"content": "Nerede olabilir ki? Olabileceği yeri doğrulamak için o kadar uğraştıktan sonra olacak iş mi bu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060105
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060105,
					"content": "Aramama yardım edebilir misin? Böyle bir yadigarın kaybolmasına göz yumamayız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060106,
						220060107
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060106,
					"content": "Tamam...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060108
					]
				},
				{
					"id": 220060108,
					"content": "Tamam, sen bu tarafı ara, ben de şu tarafı arayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060109
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060109,
					"content": "Bulmamız lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060107,
					"content": "Bu sefer ne tür bir yadigar arıyoruz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060110
					]
				},
				{
					"id": 220060110,
					"content": "Bu... Şey, bu bir... Neyse, çok eski bir şey işte! Tarihi bin yıl öncesine... Yok yok, ta Hükümdarlar Savaşı'na kadar uzanıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060111
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060111,
					"content": "Kısacası oldukça değerli bir yadigar ve bulunması lazım! O yüzden aramama yardım et lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				}
			]
		},
