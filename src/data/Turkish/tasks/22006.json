				},
				{
					"id": 220060610,
					"content": "*iç çeker* Kayıp olan diğer yadigarda kaldı aklım. Umarım başına bir şey gelmemiştir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060603,
					"content": "Aradığın şey bu mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220060606
					]
				},
				{
					"id": 220060606,
					"content": "Güzel bir şey getirmişsin ama aradığım asıl şey bu değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060607
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060607,
					"content": "Yadigarlar nasıl muhafaza edilir biliyor musun? Bilmiyorsan yadigara zarar verebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060608
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220060608,
					"content": "En iyisi ben alayım onu. Merak etme, iyi emeller uğruna kullanılmasını sağlayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220060609
					],
					"speakerTitle": "Bao'er"
				}
