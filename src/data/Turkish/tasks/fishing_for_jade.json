					"nextDialogs": [
						718140403
					]
				},
				{
					"id": 718140403,
					"content": "Öyle mi? Bir bakabilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718140404
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718140404,
					"content": "Evet, bu gerçekten de Yeşim Konak'tan düşmüş.",
