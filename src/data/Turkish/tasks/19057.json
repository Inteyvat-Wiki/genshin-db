			"dialogs": [
				{
					"id": 190570901,
					"content": "Heizou'yla ters düşmek gerçekten büyük bir hata oldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570902
					],
					"speakerTitle": "Iba"
				},
				{
					"id": 190570902,
					"content": "Hı? Siz ikiniz neler olduğunu mu öğrenmek istiyorsunuz? Anlatacak pek bir şey yok aslında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570903
					],
					"speakerTitle": "Iba"
				},
				{
					"id": 190570903,
					"content": "Bu davayı Heizou'nun aldığını öğrendiğim an her şeyin bittiğini anladım. Ben de hiç zahmete girmeden her şeyi itiraf ettim. Sonuçta yoluna bir \"Tufan\" çıktığında başka ne yapabilirsin ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570904
					],
					"speakerTitle": "Iba"
				},
				{
					"id": 190570904,
					"content": "\"Tufan\" mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190570905
					]
				},
				{
					"id": 190570905,
					"content": "Heizou'nun lakabı. Tüm mahkumlar ondan bu isimle bahseder, daha önce duymamış mıydın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570906
					],
					"speakerTitle": "Iba"
				},
				{
					"id": 190570906,
					"content": "Ondan asla kaçamazsın, asla saklanamazsın... Heizou, karşısında suçluların çaresiz kaldığı bir doğal afettir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570907
					],
					"speakerTitle": "Iba"
				},
				{
					"id": 190570907,
					"content": "Tüh, keşke bilseydim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iba"
				}
			]
		}
