			"dialogs": [
				{
					"id": 190570701,
					"content": "Biraz önce olanlar için özür dilerim, bana ne oldu bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570702
					],
					"speakerTitle": "Etsu"
				},
				{
					"id": 190570702,
					"content": "Dedektif Heizou mu? Eminim benim gibi insanlara tahammül edemiyordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570703
					],
					"speakerTitle": "Etsu"
				},
				{
					"id": 190570703,
					"content": "Kibar ve arkadaş canlısı biri olsa da dolandırıcılık suçundan hüküm giymiş kişilere karşı daha farklı davrandığına eminim... Bize gerçekten garezi var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570704
					],
					"speakerTitle": "Etsu"
				},
				{
					"id": 190570704,
					"content": "Sence o daha önce dolandırılmış olabilir mi? Bence bu imkansız, kim Dedektif Heizou'yu kandıracak kadar kurnaz olabilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Etsu"
				}
			]
		},
		{
			"id": 1905708,
