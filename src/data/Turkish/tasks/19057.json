			"dialogs": [
				{
					"id": 190570801,
					"content": "Merhaba Gezgin. Kuzenim adına özür dilerim. Sana çok sorun yarattı mı? Her zaman bir baş belasıydı... Ama kimseye bir kötülük yapmak istemediğine emin olabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190570802
					],
					"speakerTitle": "Kano Nana"
				},
				{
					"id": 190570802,
					"content": "Çok ileri giderse lütfen ona haddini bildir ve eğer karşı çıkmaya kalkarsa ona söyleneni yapması gerektiğini, aksi takdirde bana hesap vermesi gerekeceğini belirt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kano Nana"
				}
			]
		},
