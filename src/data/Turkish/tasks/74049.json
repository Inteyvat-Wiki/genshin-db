						],
						"pointId": 340300089
					}
				]
			},
			"dialogs": [
				{
					"id": 740490301,
					"content": "#Süpersin {NICKNAME}! O çirkin makinayı güzel bileşenlere dönüştürdün. \"Güm\" diye hem de!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490302
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490302,
					"content": "Bir daha bu bahçeyi asla rahatsız edemeyecek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490303
					]
				},
				{
					"id": 740490303,
					"content": "Bazı çiçekler zarar görmüş ama diğerleri halen iyi görünüyor. Patojenler tekrar gelip bahçene zarar veremeyecek. Çiçeklerin artık daha güçlü ve sağlıklı bir şekilde büyüyebilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490304,
					"content": "Bu harika... Yine de ben dersimi aldım. Bu tür değerli çiçekler özenli bakım ve titiz bir koruma gerektiriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490305
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490305,
					"content": "#{NICKNAME} ve Paimon... Bana nadide çiçekler getirdiniz ve hatta bahçemi savunmama bile yardım ettiniz. Hakkınızı nasıl öderim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490306
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490306,
					"content": "Ay, bu kadar nazik olmaya gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490307,
					"content": "Ah, buldum! Bu çiçekleri ben topladım. Benim için çok kıymetliler, onları size verebilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490308
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490308,
					"content": "#Aa! Şey, bu çiçekler gerçekten de o kadar değerliyse belki kendine onları dikecek bir bahçe yapmalısın {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490309,
					"content": "Sözü geçmişken, bunlar Tidalga değil mi? Bunlar çiçekten sayılıyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490310,
					"content": "Tidalga bir bitki ve çok güzeldir. Bu yüzden tabii ki o da bir çiçek. İnsanlar buna \"biyoloji\" diyor... İleride büyük bir çiçekçi olmak için ben de biraz çalışmıştım. Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490311
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490311,
					"content": "Paimon bu işte bir gariplik seziyor ama ne de olsa bitki sınıflandırmasından Paimon da pek anlamaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490312,
					"content": "Amacıma ulaşmak için çalışmaya devam edeceğim. İnsanlardan, başarılı çiçekçilerin yeni çiçek türleri geliştirip \"bahçecilik fuarlarında\" sergilediğini duymuştum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490313
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490313,
					"content": "Ben de bunu yapmak istiyorum... Ben de orada \"ödül\" kazanmak istiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490314
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490314,
					"content": "Bu gerçekten de takdire şayan ama Paimon'a göre hâlâ açıklaması güç bazı yanlış anlaşılmalar var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490315,
					"content": "Bahçecilik fuarına katılmasının amacı yeni bitki çeşitleri getirip insanların beğenisine sunmak, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490316,
					"content": "Ama onun his ve estetik anlayışı insanlarınkinden biraz fazla farklı olabilir... Sence insanlar onun yaptığı çiçekleri garip bulur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490317,
					"content": "Onun bahçecilik kariyerinin arkasındasın anlaşılan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490318
					]
				},
				{
					"id": 740490318,
					"content": "Tabii ki! Paimon onun hocası sonuçta. Eğer kazanırsa Paimon'a da yarar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490319,
						740490323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490319,
					"content": "Kafayı ödüle takmanın alemi yok. En önemlisi yaptığın işten keyif almak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490320
					]
				},
				{
					"id": 740490320,
					"content": "Bu doğru. Yetiştirdiğin çiçekleri güzel bulması gereken tek kişi sensin! Diğer insanların ne düşündüğü çok da önemli değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490321,
					"content": "Bahçene bakıp, güzel çiçeklerin yetişmesini izlemek ve her gün bundan mutlu olmak yeterli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490322,
					"content": "Evet! Onların sağlıklı ve güçlü yetişmelerini sağlayacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490323,
					"content": "Başarıya giden yolda ilk adımı attın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490324
					]
				},
				{
					"id": 740490324,
					"content": "Doğru, senin getireceğin bitki türleri epey değişik olabilir ama kimileri de böyle şeyler sever!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490325,
					"content": "Yeni bir tür yetiştirdiğinde önce bize söyle, olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490326,
					"content": "Elbette! Sonuçta bana o kadar yardım ettiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cosanzeana"
				}
			]
		},
