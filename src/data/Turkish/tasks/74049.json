				]
			},
			"dialogs": [
				{
					"id": 740490201,
					"content": "*ağlar* Kıymetli çiçeklerim... Mahvolmuşlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490202
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490202,
					"content": "Eyvah, çok yazık olmuş... Acaba Patojenlerin verdiği zarar yüzünden mi büyüyemediler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490203,
					"content": "Ben... Bundan sonra çiçeklerimin hep yanında olacağım. Asla ayrılmadan onlara bakacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490204
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490204,
					"content": "Az dur, bir sakinleş Cosanzeana. Birlikte başka biz çözüm var mı düşünelim. Her şeyden önce, Patojenler çiçeklerine neden zarar versin ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490205,
						740490206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490205,
					"content": "Daha önce başka çiçekler getirdiğinde...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490207
					]
				},
				{
					"id": 740490207,
					"content": "Hayır, asla! Hıh, o kötü adamlar anca benim arkamdan böyle işler yapabilirler. Off, çok sinirlendim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490208
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490208,
					"content": "Vay be, Paimon, Cosanzeana'nın bu kadar sinirlenebileceğini beklemezdi. Demek ki bu çiçekleri gerçekten de önemsiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490209,
					"content": "Ama bir an düşündüm de Cosanzeana yaklaşınca Patojenler hiç de kaçmadı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490210,
					"content": "Belki de onları çeken şey çiçekler değildi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490211
					]
				},
				{
					"id": 740490211,
					"content": "Bu mümkün. Bahçenin etrafına bakıp neler bulabiliriz bir görelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490206,
					"content": "Peşinden hiç Patojen geldi mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490207
					]
				}
			]
		},
		{
			"id": 7404903,
