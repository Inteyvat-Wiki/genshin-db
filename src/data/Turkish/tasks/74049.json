					"Cosanzeana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740490101,
					"content": "#Aa, nadide çiçeklerin sahibi {NICKNAME} ve Paimon gelmiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490102
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490102,
					"content": "Merhaba Cosanzeana. Getirdiğimiz çiçekler güzel büyüyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490103,
					"content": "Şey, benim... Gün boyunca onlara hiç bakma fırsatım olmadı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490104
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490104,
					"content": "Hı? Çiçekleri beğenmedin mi yoksa? Neden onlara bakmadın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490105,
					"content": "Şey... Elde etmesi bu kadar zor çiçeklere bakmayı elbette çok isterim. Ama gözlerimin önünde solabileceklerini düşününce... Bakmaktan korktum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490106
					],
					"speakerTitle": "Cosanzeana"
				},
				{
					"id": 740490106,
					"content": "Vay be, gerçekten de ne kadar endişelisin... Gidip beraber bakalım mı? Eğer kötü bir şey olursa sana yardımcı oluruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740490107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740490107,
					"content": "Bu kadar endişelenmenin anlamı yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740490108
					]
				},
				{
					"id": 740490108,
					"content": "Haklısın... Hadi beraber gidelim! Yardımınızla beraber bunu başarabiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cosanzeana"
				}
			]
		},
		{
			"id": 7404902,
			"completionStepIds": [
				7404905
