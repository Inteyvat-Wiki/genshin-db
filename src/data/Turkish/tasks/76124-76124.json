			"dialogs": [
				{
					"id": 761240301,
					"content": "Mükemmel! Burada bitirelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240302
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240302,
					"content": "İkinize de teşekkürler, hakikaten çok keyifliydi. Sarışın genç, becerilerin gerçekten de pek etkileyici. Hatta şu Guhua denen çocuktan bile çok daha kuvvetli olduğunu söyleyebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240303,
						761240304
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240303,
					"content": "Aferin bana!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761240306
					]
				},
				{
					"id": 761240306,
					"content": "Sizin sayenizde ben de nadir bir aydınlanma anı yaşadım. Lezzetini ortaya çıkarmak için balık ezmesinin içine gerçekten de biraz taze kıyma karıştırmak gerekiyor. Çok uzun süre bekletirsen balık kokusunu bastıramıyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240307
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240307,
					"content": "Haklısın... Hımm? Bir dakika... Bunun konumuzla hiç alakası yok ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761240308,
					"content": "Haha, boş verin şimdi bu önemsiz meseleleri! Bir dahaki sefere Castiglione'a birkaç balık daha çizdirdiğimde ikinize de güzel bir balık ezmesi ısmarlarım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240304,
					"content": "Abartılacak bir şey yapmadım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761240305
					]
				},
				{
					"id": 761240305,
					"content": "Mütevazı olmaya gerek yok. Kılıç ustalığın sağlammış, çok belli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240306
					],
					"speakerTitle": "Jinggui"
				}
			]
		},
