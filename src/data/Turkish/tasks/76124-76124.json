			"dialogs": [
				{
					"id": 761240401,
					"content": "Hım? Burada bir resim daha var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761240402,
					"content": "Oo, gözlerin keskinmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240403
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240403,
					"content": "Kendilerine Guhua Klanının varisleri diyen bir grup genç bir zamanlar Castiglione'dan bunu resmetmesini talep etmişlerdi. Söylediklerine göre burası onların pek değerli \"talim alanı\"ymış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240404
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240404,
					"content": "Ama fena gururlular. Kendilerini şimdiden bu tür temel talimlerin çok ötesinde, eşsiz ustalar olarak görüyorlar. Bu yüzden de resmi bana verdiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240405
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240405,
					"content": "Bir dakika... Sen Guhua Klanından değil misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761240406,
					"content": "Öyle olduğumu iddia etmeyi çok isterdim ama ne yazık ki o Guhua denen delikanlı beni yanına almaya cesaret edemezdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240407
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240407,
					"content": "Vaktiyle biz Guili Ovası'ndaki haydutların icabına bakarken o çocuk yeterli idmanı olmadığı için neredeyse ölüyordu. Başka çarem kalmamıştı, o yüzden ben de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240408
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240408,
					"content": "Neyse, boş verin. Eski ve can sıkıcı bir mesele. Ama bu resim başka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240409
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240409,
					"content": "Merak ediyorsanız açıp bakabilirsiniz. Yırtsanız da önemli değil, zaten Castiglione çoğu zaman boşta geziyor. Ona bir tane daha çizdiririm olur biter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinggui"
				}
			]
		}
	]
}