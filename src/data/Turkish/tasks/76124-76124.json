			"dialogs": [
				{
					"id": 761240101,
					"content": "Heh... Ne kadar görsem de bana hâlâ mantıksız geliyor. Bambu keserek kılıç ustalığını geliştiren birini ömrühayatımda duymadım. Şu Guhua denen delikanlının aklında gerçekten de tuhaf fikirler vardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240102
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240102,
					"content": "Bambudan sepetler örülebilir, oymalı süsler yapılabilir, flüt veya hesap çubuğu olarak şekillendirilebilir, hatta yazı fırçası bile yapılabilir. Ama kazık veya idman silahı olarak kullanmak... İşte bunu ilk defa duyuyorum. Epey yenilikçi bir fikir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240103
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240103,
					"content": "Pekala! Tomar açıldığına göre Guhua Klanının o küçük müritleri adına konuşacağım ve kuralları açıklayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240104
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240104,
					"content": "Bu bambu hedeflerin bazıları <color=#00E1FFFF>mavi</color>, diğerleri ise <color=#FF5E41FF>kırmızı</color> giysilidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240105
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240105,
					"content": "Bu imtihanın ilk aşaması basit: <color=#00E1FFFF>Mavili</color> olanlara vur, <color=#FF5E41FF>kırmızılı</color> olanlara ise dokunma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761240106
					],
					"speakerTitle": "Jinggui"
				},
				{
					"id": 761240106,
					"content": "Hazırsan istediğin zaman başlayabilirsin. Gel de kılıcının ne kadar keskin olduğunu göreyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinggui"
				}
			]
		},
