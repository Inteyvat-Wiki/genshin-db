			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rikoru",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450101,
					"content": "Ne var? Rahatsız etmeyin beni. Düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450102
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450102,
					"content": "Çok önemli bir şey düşünüyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450103
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450103,
					"content": "Nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450104,
					"content": "Dainichi Mikoshi denen yapıyı gördünüz mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450105
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450105,
					"content": "Tüm ülkedeki en uzun şey.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450106
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450106,
					"content": "Ondan daha uzun bir binayı nasıl inşa edebileceğimi düşünüyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450107
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450107,
					"content": "Byakuyakoku'yu aydınlatabilsin diye o kadar uzun, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450108,
					"content": "Neden o kadar uzun bir bina yapmak istiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450109,
					"content": "Şanımı göstermek için elbette! Büyük Rikoru'nun şanı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450110
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450110,
					"content": "O yaşlı Aberaku'ya patronun kim olduğunu göstereceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450111,
						722450112
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450111,
					"content": "Aberaku'yu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450113
					]
				},
				{
					"id": 722450113,
					"content": "Elbette. Dainichi Mikoshi'yi yapıp Byakuyakoku'yu kurtardı. Eskiden ona hayrandım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450114
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450114,
					"content": "Gel gör ki tahtta gözü varmış. O yetişkinler olmasaydı şimdiye ölmüştüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450115
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450115,
					"content": "Bu yüzden Dainichi Mikoshi'den daha uzun bir yapı inşa edeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450116
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450116,
					"content": "N-Ne kadar sürecek?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450117,
					"content": "Umurumda bile değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450118
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450118,
					"content": "Byakuyakoku halkı onlardan benim için bir tarihi eser inşa etmelerini istediğim için kendisini şanslı hissetmeli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450119
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450119,
					"content": "Tamam artık, beni rahatsız etmeyi bırak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450120
					],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450120,
					"content": "Bir düşüneyim. Eğer kirişler bu uzunluktaysa... Öyle yaparsak, yük mukavemeti ve ahşap doğramalar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rikoru"
				},
				{
					"id": 722450112,
					"content": "... Tanıyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450113
					]
				}
			]
		},
		{
			"id": 7224502,
			"completionStepIds": [
				7224502
