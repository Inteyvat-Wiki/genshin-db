			},
			"dialogs": [
				{
					"id": 722450301,
					"content": "Uzak diyarlardan gelen Gezginler... *öksürür* Yorulmuş gibisiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450302
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450302,
					"content": "Böyle olmaz, biliyorsunuz değil mi? Birçok hastalık yorgunlukla başlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450303
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450303,
					"content": "Her gün yeteri kadar dinlendiğinizden emin olmalısınız ki... *öksürür*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450304
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450304,
					"content": "*öksürür* *öksürür* ... Sağlıklı büyüyün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450305
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450305,
					"content": "Peki ya sen? Sen de sağlıklı görünmüyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450306,
					"content": "Ahaha, bendeki eski bir hastalık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450307
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450307,
					"content": "Gezgin, sağlıklı bir ruhun olması için vücudunu sağlıklı tutman gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450308
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450308,
					"content": "*iç çeker* Keşke daha fazla zamanım olsaydı. Dünyanın en iyi doktoru olurdum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450309
					],
					"speakerTitle": "Surepio"
				},
				{
					"id": 722450309,
					"content": "Böylece bu vücutla bile odamdan sağlıklı bir şekilde yürüyerek çıkabilir ve canım istediği kadar koşup oynayabilirdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Surepio"
				}
			]
		},
