			},
			"dialogs": [
				{
					"id": 722450501,
					"content": "Hey Gezgin, çok ilgi çekici görünüyorsun. Falına bakmama ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450502
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450502,
					"content": "Adım Ion, şimdiye kadar bütün fallarım çıktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450503
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450503,
					"content": "Gerçekten mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450504,
					"content": "Dolandırıcı gibi konuşuyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450505,
					"content": "(Ayrıca Paimon, mezar taşında yazılanları hatırlıyor...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450506,
					"content": "Ah, hadi ama yüzünüzdeki o şüpheli bakış da ne? Ben her zaman insanların falına bakarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450507
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450507,
					"content": "Byakuyakoku'dan çok az kişinin falında mutlu bir gelecek görmüştüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450508
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450508,
					"content": "Bu nedenle şanslarının döneceğini söyleyerek onları kandırdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450509
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450509,
					"content": "Elimden bir şey gelmese de bu şekilde onları bir nebze mutlu etmek istedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450510
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450510,
					"content": "Tabii bu yüzden bana falları hiç çıkmıyor dediler. Ne kadar üzücü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450511
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450511,
					"content": "Demek öyle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450512,
					"content": "Evet. Sen, küçük olan. Gel de hemen şimdi kanıtlayayım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450513
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450513,
					"content": "N-Ne? Olur! Paimon'un üzerinde dene bakalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450514,
					"content": "Hımm, tamam... Dikkatimi toplamama izin verin... Hah. Neden bu kadar çok parazit var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450515
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450515,
					"content": "Nasıl yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450516
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450516,
					"content": "S-Sorun ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450517,
					"content": "Ben... Falına bakamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450518
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450518,
					"content": "Nasıl olabilir? Çoğu zaman doğru bilemesem de en azından bir şeyler görebilirdim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450519
					],
					"speakerTitle": "Ion"
				},
				{
					"id": 722450519,
					"content": "Sanırım o kadar da iyi değilsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450520,
					"content": "Öyle görünüyor. Çalışmalarıma ciddi bir şekilde devam etmem gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ion"
				}
			]
		},
