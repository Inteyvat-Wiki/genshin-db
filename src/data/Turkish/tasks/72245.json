			"dialogs": [
				{
					"id": 722450701,
					"content": "*iç çeker* Demek uzaklardan gelen gezgin sensin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450702
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450702,
					"content": "Amacın ne? Buraya gelişini görmek çok üzücüydü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450703
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450703,
					"content": "Üzücü mü? Üzülecek ne var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450704,
					"content": "Bir şarkıcı için dünyadaki her şey uğruna üzülmeye değerdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450705
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450705,
					"content": "Her buluşmanın bir ayrılığı vardır ve her canlı bir gün toprağa dönecektir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450706
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450706,
					"content": "Yeniden bir araya gelişler uzun süreli ayrılıkların acısını dindirmeye yetmez... Sana gelince Gezgin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450707
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450707,
					"content": "Yalnızca amacı olanlar senin gibi farklı diyarlara yolculuk edebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450708
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450708,
					"content": "Uzun süredir burada yaşayan yerliler böyle bir yolculuğu şairane bulabilir ama bir tek yolculuğu yapanın kendisi bilir yolda neler çektiğini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450709
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450709,
					"content": "Daha önce gelmiş olsaydın senin için şarkı söyleyebilirdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450710
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450710,
					"content": "Ancak birine, onun sesini duyana kadar bir daha şarkı söyleyemeyeceğime dair yemin ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450711
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450711,
					"content": "Benden çok daha yaşlı gibi görünsen de sana sadece iyilik dileyebilirim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450712
					],
					"speakerTitle": "Orupeusu"
				},
				{
					"id": 722450712,
					"content": "Umarım dileklerin gerçekleşir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orupeusu"
				}
			]
