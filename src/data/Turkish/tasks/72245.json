			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Isumenasu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722450201,
					"content": "Hımm. Daha önce hiç sizin gibi giyinen birilerini görmemiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450202
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450202,
					"content": "Acaba sen, şey... Ah, gökten düşmüş olabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450203
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450203,
					"content": "Pekala, anlaşılan dünyada yalnızca bizim şanlı ulusumuz yokmuş! Haritalarınızı verin de güzelce inceleyeyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450204
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450204,
					"content": "(Haritanı verirsin...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450205
					]
				},
				{
					"id": 722450205,
					"content": "Ah, ne kadar ayrıntılı... Yüzey şekilleri doğru olarak çizilmekle kalmamış, dağ yolları ve nehirler de net bir şekilde görülebiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450206
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450206,
					"content": "Peki bu \"Teyvat\" dediğin ulus Byakuyakoku ile karşılaştırıldığında ne kadar büyük?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450207
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450207,
					"content": "Teyvat bir kıta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450208,
					"content": "Ayrıca Enkanomiya... Yani Byakuyakoku, haritanın en güneyinde kalan küçük bir kara parçası.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450209,
					"content": "Mümkün değil! Topraklarımız çok büyüktür! Nasıl olur da bu kadar küçük çizilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450210
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450210,
					"content": "Bu harita çok güzel çizilmiş olsa da sahte olduğu açıkça ortada. Alın haritanızı da gidin buradan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450211
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450211,
					"content": "Bu ucuz dolandırıcılık numarasından bir anlığına bile olsa etkilendiğimi düşünmek bana hakarettir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450212
					],
					"speakerTitle": "Isumenasu"
				},
				{
					"id": 722450212,
					"content": "Eh, ister inan ister inanma evlat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
