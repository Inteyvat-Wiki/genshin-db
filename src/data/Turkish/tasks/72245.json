			},
			"dialogs": [
				{
					"id": 722450601,
					"content": "Aha! Görünüşüne bakılırsa başka bir ulustan gelen bir gezgin olmalısın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450602
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450602,
					"content": "Nereden geliyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450603
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450603,
					"content": "Mondstadt'tan geliyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450604,
					"content": "Mondstadt mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450605
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450605,
					"content": "Piramumon'a Mondstadt'ın nasıl bir yer olduğunu basitçe anlatıyorsun...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722450606
					]
				},
				{
					"id": 722450606,
					"content": "Hiç öyle bir şehir duymamıştım. Böyle bir yerin varlığı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450607
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450607,
					"content": "Hahaha! Tam tahmin ettiğim gibi! Dünya sadece Byakuyakoku'dan ibaret olamaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450608
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450608,
					"content": "Sonuçta dünyada sadece Byakuyakoku olsaydı dünya çok yalnız olurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450609
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450609,
					"content": "Ayrıca kadim yazılar ulusumuzun kuruluşundan önceki zamanlardan bahsediyor. Bunu okuduğumda dünyanın sadece Byakuyakoku'dan ibaret olmadığını düşünmeye başladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450610
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450610,
					"content": "Yine de içimde bir korku vardı anlıyor musun? Gerçekten dünyanın bu kadarcık olmasından korkuyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450611
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450611,
					"content": "Gelişinin içimi nasıl rahatlattığını anlayamazsın Gezgin. Haha, demek dünyada görülmeye değer bir sürü yer var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450612
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450612,
					"content": "Güneşe Dönüş Ayini denen festivale katılmak zorunda olmam çok üzücü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450613
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450613,
					"content": "Bak ne diyeceğim Gezgin, hadi bana buraya nasıl geldiğini söyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450614
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450614,
					"content": "Festival bittiğinde Dainichi Mikoshi'den gizlice çıkmak için bir yol bulurum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450615
					],
					"speakerTitle": "Piramumon"
				},
				{
					"id": 722450615,
					"content": "Bunun yerine birlikte meyve suyu içelim! Haha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piramumon"
				}
			]
