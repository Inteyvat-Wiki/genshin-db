				"points": []
			},
			"dialogs": [
				{
					"id": 722450401,
					"content": "Hareket etme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450402
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450402,
					"content": "Dur! Sana hareket etmemeni söylüyorum! Beni duymuyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450403
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450403,
					"content": "Ah, Paimon hareket etmeden duramaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450404,
						722450405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450404,
					"content": "Paimon'a hareket etmemesini söylemek...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450406
					]
				},
				{
					"id": 722450406,
					"content": "Asla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450407,
					"content": "Üf tamam be, etrafında dön o zaman. Bu kıyafetleri hayatımda hiç görmemiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450408
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450408,
					"content": "Estetik olarak pek çekici değiller ama insanın ilgisini çekiyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450409
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450409,
					"content": "Beğenmediysen neden bakıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450410,
					"content": "Ciddi misin? Kadın bakıcıları bana modellik yapmaları için ikna etmek bile bu kadar zor değildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450411
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450411,
					"content": "Halkımın giyim tarzından bıktım artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450412
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450412,
					"content": "Senin giydiklerin ise farklı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450413
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450413,
					"content": "Hımm, biliyorum. Kıyafetleri bu şekilde birlikte kullanıyorlar demek... Siz yabancılar gerçekten utanmazsınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450414
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450414,
					"content": "Anlıyorum... Kıyafetler böyle yapıldıysa vücudunun şekli böyle olmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450415
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450415,
					"content": "Ne yapıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722450416,
					"content": "Heykel. Kil ve suyu birleştirip iki elimle yoğuruyorum. Rahatlamamı sağlıyor. Beni bu şekilde rahatlatan birkaç uğraşıdan biri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450417
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450417,
					"content": "Rahatımı bozan nedir biliyor musun? Düzenli olarak toplantılarda oturmak, o yetişkinlerin yazdıklarını sesli olarak okumak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450418
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450418,
					"content": "Aman, neyse. Nasılsa kaba şeklinizi çıkarttım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722450419
					],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450419,
					"content": "Şimdi beni rahatsız etmeyi bırakın. Hadi, gidin işinize.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risutaiosu"
				},
				{
					"id": 722450405,
					"content": "Aşağı düşer misin Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722450406
					]
				}
			]
		},
		{
			"id": 7224505,
			"completionStepIds": [
				7224505
