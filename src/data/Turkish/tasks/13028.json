					"speakerTitle": "Nahida"
				},
				{
					"id": 130280101,
					"content": "Onlar için bir şey yapmak istiyorum ki tekrar bir araya gelme şansları olsun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280102
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280102,
					"content": "Bu iki mantar dışında Paimon da Uçan Rüzgar Mantarı kampı hakkında biraz endişeli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130280103,
					"content": "Hı hı. Ben de aynı şekilde hissediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280104
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280104,
					"content": "Bir fikrim var. Neden onları getirip diğer Mantarlarla aynı yerde yaşatmıyoruz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280105
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280105,
					"content": "İki taraf da daha önce element yaşam formunun olduğu yerde yaşadılar, yani benzer alışkanlıklara sahip olmalılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280106
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130280106,
					"content": "Evet, birbirlerine göz kulak olabilirler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130280107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130280107,
					"content": "Bizimle gelmek ister misiniz?",
