			"dialogs": [
				{
					"id": 200290101,
					"content": "Sanırım sonunda eve gidiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290102
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290102,
					"content": "Bizi bırakıyor musun Viktor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290103
					]
				},
				{
					"id": 200290103,
					"content": "Ah, sen miydin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290104
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290104,
					"content": "Evet. Üstlerimden, Snezhanya'ya dönebileceğime dair emir aldım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290105
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290105,
					"content": "Benim başka bir Haberciye transfer edilmem ve artık Mondstadt'ta yeni emirler beklemem gerekmemesiyle ilgili bir şeyler söylendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290106
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290106,
					"content": "Şimdi hangi Haberci altında çalışacağımı hiç bilmiyorum ama umarım Lord Scaramuccia değildir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290107
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290107,
					"content": "Ne zaman gidiyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290108
					]
				},
				{
					"id": 200290108,
					"content": "Üsttekiler bundan bahsetmedi. Eşyalarımı toplayıp zamanı geldiğinde gitmek üzere hazır olmamı söylediler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290109
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290109,
					"content": "Harika değil mi? Sonunda o rahibelerin yargılayıcı bakışlarından kurtuluyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290110
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290110,
					"content": "Tabii, Gezgin. Seninle pek çok kez anlaşma yaptık... Son bir iyilik yapabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290111
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290111,
					"content": "Önceden olduğu gibi, sen işi halledeceksin ben de ödemeyi yapacağım. Benimle çalıştığında hiçbir zaman bedavaya iş yapmış olmazsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290112,
						200290113
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290112,
					"content": "Bu defa bana ne hikayeler anlatacaksın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290114
					]
				},
				{
					"id": 200290114,
					"content": "Haha. Dürüst olmak gerekirse sana anlatacak Fatui hikayelerim bitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290115
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290115,
					"content": "Bu defa ödemeyi Mora ile yapacağım. Uyar mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290116
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290116,
					"content": "Tabii sana da Lily'ye anlattığım peri masallarını anlatmamı istersen başka...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290117,
						200290118
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290117,
					"content": "Hangi konuda yardım lazım?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290120
					]
				},
				{
					"id": 200290120,
					"content": "Dürüst olmak gerekirse bu seferki isteğim onunla da ilgili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290121
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290121,
					"content": "Lily... Tüm Mondstadt'ta \"kötücül Fatui üyesi amcanın\" söylediklerini dinleyen tek kişi. Tabii senin dışında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290122
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290122,
					"content": "Mondstadt'a geri döneceğimi pek sanmıyorum... Bu nedenle Lily'ye son bir hatıra bırakmak istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290123
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290123,
					"content": "Ama bildiğin üzere dışarı çıkıp bir şeyler satın almaya çalışmak atış poligonunda yürümek olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290124
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290124,
					"content": "O nedenle de bu görevi sadece sana verebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290125
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290125,
					"content": "Marjorie'nin dükkanına gidip çocuklar için hediye var mı diye bak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290118,
					"content": "Lily'yle hâlâ arkadaş mısınız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290119
					]
				},
				{
					"id": 200290119,
					"content": "Şey... Yani... Bazen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290120
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290113,
					"content": "Etrafta sen varken Fatui hikayemiz eksik olmuyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290114
					]
				}
			]
		},
