				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200290701,
					"content": "Nasıl gitti? Hediyeyi alabildin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290702
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290702,
					"content": "Aldım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290703
					]
				},
				{
					"id": 200290703,
					"content": "İşinde gerçekten iyisin. Bakalım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290704
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290704,
					"content": "Bu ne...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290705
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290705,
					"content": "Bu bebek fazla ince ve uzun, çarpık çurpuk ve özensiz boyanmış... Gerçi güzel kokuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290706
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290706,
					"content": "Bunun çocuklara uygun olduğuna emin misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290707,
						200290708
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290707,
					"content": "Marjorie bunu önerdi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290710
					]
				},
				{
					"id": 200290710,
					"content": "Bu hediyeyle yetineceğiz. Mektubu nereye koysam ki... Neyse, altına koyayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290711,
						200290712
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290711,
					"content": "Lily'ye mektup mu yazdın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290713
					]
				},
				{
					"id": 200290713,
					"content": "Öyle saçma bir şeyler. Boş ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290714
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290714,
					"content": "Tamamdır. Bunu Lily'ye götürmeme yardım et. <color=#00E1FFFF>Meydanın yakınlarında</color> bir yerdedir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290715
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290715,
					"content": "Bunu gidip kendim vermeye kalksam Rudolf bana nasıl bakardı, tahmin edebiliyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290712,
					"content": "Ne yazdın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290713
					]
				},
				{
					"id": 200290708,
					"content": "İstediğin zaman Snezhanya'dan başka bir tane alıp buraya gönderebilirsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290709
					]
				},
				{
					"id": 200290709,
					"content": "Çok isterdim ama bir düşünsene. Bir Fatui üyesi Mondstadt'a bir şey gönderiyor. Favonius Şövalyeleri o kargoyu daha şehre girmeden durdurmaz mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290710
					],
					"speakerTitle": "Viktor"
				}
			]
		},
