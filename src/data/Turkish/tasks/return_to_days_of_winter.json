				{
					"id": 200290502,
					"content": "Buraya kadar koştum ama bu canavarlar peşimden gelmeye devam etti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290503
					],
					"speakerTitle": "Korkmuş Schuster"
				},
				{
					"id": 200290503,
					"content": "Kurt Çengeli toplamaya geldin değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290504
					]
				},
				{
					"id": 200290504,
					"content": "Evet, Marjorie rica etti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290505,
						200290507
					],
					"speakerTitle": "Korkmuş Schuster"
				},
				{
					"id": 200290505,
					"content": "Neden yanında birini getirmedin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290506
					]
				},
				{
					"id": 200290506,
					"content": "Hadi ama, kim benimle gelip \"bitki toplamak\" kadar basit bir görevde çalışmak isterdi ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290508
					],
					"speakerTitle": "Korkmuş Schuster"
				},
				{
					"id": 200290508,
					"content": "Biliyorum ama Kurt Çengelleri sadece burada bulunabiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290509
					],
					"speakerTitle": "Korkmuş Schuster"
				},
				{
					"id": 200290509,
					"content": "Ayrıca güvenli bölgelerde yetişen Kurt Çengellerinin hepsi toplanmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290510
					],
					"speakerTitle": "Korkmuş Schuster"
				},
				{
					"id": 200290510,
					"content": "O yüzden de Kurt Çengeli toplamak için daha uzağa gitmem gerekti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290511
					],
					"speakerTitle": "Korkmuş Schuster"
				},
				{
					"id": 200290511,
					"content": "Ama şimdi bundan bahsetmeyelim. Bu Kurt Çengellerini Marjorie'ye götürmeme yardım eder misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290512
					],
					"speakerTitle": "Korkmuş Schuster"
				},
				{
					"id": 200290512,
					"content": "Benim biraz dinlenmem gerek. Bacaklarım beni yarı yolda bırakacak diye korktum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Korkmuş Schuster"
				},
				{
					"id": 200290507,
					"content": "Lütfen tek başına çok uzaklaşma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290508
					]
				}
			]
		},
		{
