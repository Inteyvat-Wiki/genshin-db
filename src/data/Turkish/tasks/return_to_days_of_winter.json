					"nextDialogs": [
						200290802
					],
					"speakerTitle": "Rudolf"
				},
				{
					"id": 200290802,
					"content": "Ama neden? Bay Fatooey bana bir sürü hikaye anlatıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290803
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290803,
					"content": "Selam Lily, Viktor sana bir hediye aldı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290804
					]
				},
				{
					"id": 200290804,
					"content": "Vay canına! Bay Fatooey bana hediye mi aldı? Teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290805
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290805,
					"content": "Bekle, o Fatui üyesi neden Lily'ye hediye gönderiyor? Sakın bana şey olduğunu söyleme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290806
					],
					"speakerTitle": "Rudolf"
				},
				{
					"id": 200290806,
					"content": "Çünkü ben Bay Fatooey'e bir sürü yiyecek veriyorum! Ondan bana hediye gönderdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290807
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290807,
					"content": "Lily, o iyi biri değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290808
					],
					"speakerTitle": "Rudolf"
				},
				{
					"id": 200290808,
					"content": "Ama bana hikaye anlatıyor! O iyi biri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290809,
						200290810
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290809,
					"content": "Bunu Viktor'un veda hediyesi olarak düşün.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290811
					]
				},
				{
					"id": 200290811,
					"content": "Neden gitmesi gerekiyor ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290812
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290812,
					"content": "*iç çeker* Ayrılıyor mu? İyi bari. Her gün Lily'yle ne konuştuğu hakkında endişelenip duruyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290813
					],
					"speakerTitle": "Rudolf"
				},
				{
					"id": 200290813,
					"content": "Baba, Fatooey beye güle güle demek istiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290814
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290814,
					"content": "*iç çeker* Lily, o adama çok yaklaşmamalısın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290815
					],
					"speakerTitle": "Rudolf"
				},
				{
					"id": 200290815,
					"content": "Ama neden? Fatooey... Bana çok nazik davrandı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290816
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290816,
					"content": "Bana bir sürü hikaye anlatıyor! O iyi biri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290817
					],
					"speakerTitle": "Lily"
				},
				{
					"id": 200290817,
					"content": "Lily, babanı dinle. İşler o kadar basit değil... *iç çeker* Bak şöyle yapalım. Babacık sana büyüdüğünde daha fazla şey anlatacak olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rudolf"
				},
				{
					"id": 200290810,
					"content": "Viktor yakında Mondstadt'tan ayrılıyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290811
					]
				}
			]
