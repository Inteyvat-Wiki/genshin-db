					"id": 200290902,
					"content": "Çok mutlu oldu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290903
					]
				},
				{
					"id": 200290903,
					"content": "Güzel. Sanırım Rudolf da konu hakkında iki çift laf etmiştir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290904
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290904,
					"content": "Söylemene bile gerek yok. Mondstadt'ta kimse Fatui üyelerine güvenmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290905
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290905,
					"content": "Ne zaman gideceksin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290906
					]
				},
				{
					"id": 200290906,
					"content": "Resmi emir henüz gelmedi. Eşyalarımı önden hazırladım, şimdilik Goth Grand Otelde kalacağım. Haber geldiğinde gitmeye hazır şekilde bekleyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290907
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290907,
					"content": "Hadi ama, niye bu kadar ciddisin? Bana da resmi bir şekilde mi veda edeceksin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290908
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290908,
					"content": "Hayır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290909
					]
				},
				{
					"id": 200290909,
					"content": "Doğru. Öyle olması gerek. Arkadaş değiliz ki. Sadece geçici ortaklarız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290910
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290910,
					"content": "Snezhanya'ya yolun düşerse beni bul. Birlikte iş yapmaya devam edebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290911
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290911,
					"content": "Neyse, bu kadar sohbet yeter. İşte ödemen. Sanırım bu Mondstadt'taki son \"eşit takasımız\" olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290912
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290912,
					"content": "*iç çeker* Umarım sonraki atamam da böyle sıkıntılı olmaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
