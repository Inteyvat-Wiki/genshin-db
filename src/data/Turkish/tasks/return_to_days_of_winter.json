			"dialogs": [
				{
					"id": 200290401,
					"content": "Hediyeyi aldın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290402,
						200290406,
						200290409,
						200290412
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290402,
					"content": "Eve döndüğünde ne yapacaksın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290403
					]
				},
				{
					"id": 200290403,
					"content": "Ben mi ne yapacağım? Sanırım transfer emirlerimi beklemem gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290404
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290404,
					"content": "*iç çeker* İşler kötüye giderse hükümdarların unuttuğu bir yere transfer edilip orada yine beklemeye alınabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290405
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290405,
					"content": "Ama bana her şey uyar. Beni Inazuma'ya yollamasınlar da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290406,
					"content": "İşler neden birdenbire hareketlendi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290407
					]
				},
				{
					"id": 200290407,
					"content": "Neden mi? Leydi Sinyora'nın... Fedakarlığı nedeniyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290408
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290408,
					"content": "Aslında ben emir kuluyum. Ne emir gelirse onu uyguluyorum. Üzerine çok da düşünmeme gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290409,
					"content": "Lily nerede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290410
					]
				},
				{
					"id": 200290410,
					"content": "Rudolf'un onu meydana ya da öyle bir yere götüreceğinden bahsettiğini duymuştum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290411
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290411,
					"content": "Sanırım kıymetli kızını kötücül Fatui'den uzak tutması gerekiyor, ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 200290412,
					"content": "Görüşürüz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290413
					]
				},
				{
					"id": 200290413,
					"content": "Tamamdır, o zaman hediye işini sana bırakıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
