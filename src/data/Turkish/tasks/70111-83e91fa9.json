			},
			"dialogs": [
				{
					"id": 701110101,
					"content": "Saygıdeğer gezgin. Müsaitsen bir konuşalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110102
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110102,
					"content": "Gereksiz ayrıntıya girmeyeceğim. Yardımına ihtiyaç duyduğum bir mesele var. Birkaç gün önce Liyue'den saygıdeğer Yu Huangyi bana olağanüstü nadirlikte bir hazine gönderdi. Lakin bu hazine hâlâ tarafıma ulaşmadı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110103
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110103,
					"content": "Bu bölgenin muhafızının ona el koyduğunu düşünüyorum. Bu \"hazine\"yi bulursan onu benim adıma geri almanı rica ediyorum. İçin rahat olsun, karşılığını layığıyla alacaksın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				}
			]
		},
		{
			"id": 7011102,
			"completionStepIds": [
				7011102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7011102",
							"2"
						],
						"stepId": 7011102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soga Sumidanoryu Sakon Shigehira"
				],
				"points": [
					{
						"sceneId": 103,
						"position": [
							322.275,
							205.963,
							571.86
						],
						"pointId": 229
					}
				]
			},
			"dialogs": [
				{
					"id": 701110201,
					"content": "Biz geldik! Şuna bir bak bakalım. Kastettiğin \"hazine\" bu mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 701110202,
					"content": "Hah! Size en içten minnetlerimi sunuyorum! Ne kadar teşekkür etsem azdır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110203
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110203,
					"content": "Pekala. Daha fazla beklemeye lüzum yok. Hemen açayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110204
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110204,
					"content": "B-Bu da ne böyle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110205
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110205,
					"content": "Aaaa! O şey patlamak üzere mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 701110206,
					"content": "Hayır, saygıdeğer Yu Huangyi bana asla zarar vermek istemezdi... Yoksa muhafız asıl hazineye el koyup bombaya mı dönüştürdü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110207
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110207,
					"content": "Maalesef bu tür cihazların nasıl söküldüğünü hiç bilmiyorum... Başka çaremiz yok! Uzağa fırlat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110208
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110208,
					"content": "Korkmaya gerek yok! Şimdi hatırladım. Hyperborea'dan bir asilzade bir keresinde kutsal bir bombayı fırlatmanın doğru yönteminden bahsetmişti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110209
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110209,
					"content": "\"Üçe kadar sayılacak. Ne fazla. Ne eksik. Sayılacak sayı üç olacak. Dört yasaktır. İkide durulmayacak. Beş ise söz konusu bile olamaz. Ve üç sayısına ulaşıldığında...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110210
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110210,
					"content": "Açıklamayı bırak da fırlat artık şunu! Patlamak üzere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7011103,
