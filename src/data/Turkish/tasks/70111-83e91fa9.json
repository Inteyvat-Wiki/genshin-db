			"dialogs": [
				{
					"id": 701110301,
					"content": "Hı? Bir saniye. Hepsi bu muymuş? Havai fişekler yüzünden mi panik yaptık?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 701110302,
					"content": "N-Ne büyük bir parıltı... Ekselansları Yüce Narukami Ogosho'nun hizmetinde geçirdiğim onca yılda bile böylesine parlak bir alev çiçeğine tanık olmamıştım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110303
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110303,
					"content": "Anlıyorum, demek Yu Beyefendinin görmemi istediği manzara buymuş... Hayallerimi ziyadesiyle aşıyor. Büyük şeref duydum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110304
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110304,
					"content": "\"Kuzgun yeşimi kadar karanlık gecede, bulutların arasında açar çiçekler. Su üstündeki köpük gibi olan beden, derhal dönmelidir sessizliğe. Yıldızlar çekilirken ve yağmur boşlukta dağılırken...\" Ne kadar zarif...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701110305
					],
					"speakerTitle": "Soga Sumidanoryu Sakon Shigehira"
				},
				{
					"id": 701110305,
					"content": "Şey, Paimon \"zarif\" kısmını pek anlamadı ama en azından tehlikeli değilmiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}