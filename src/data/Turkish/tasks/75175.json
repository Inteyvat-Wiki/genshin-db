			"dialogs": [
				{
					"id": 751750101,
					"content": "Sıvı Filojistona girdiğinde zihninde samimi anılara benzer görseller canlanıyor peş peşe.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750102
					]
				},
				{
					"id": 751750102,
					"content": "Yanan havuzun yanında gümüş beyaz ve kül kaplı gölgeler konuşuyor...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750103
					]
				},
				{
					"id": 751750103,
					"content": "\"... İkinci Aşama deneysel onay tamamlandı. Her şeyi arındıracak, her şeye evrim geçirtecek bu sistemin adını 'Huitzilopochtli' koyuyorum, yani 'Arındıran Gök Alevi'\"...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750104
					]
				},
				{
					"id": 751750104,
					"content": "\"Gerçi bir önemi yok ya. Yakında burada adların hiçbir anlamı kalmayacak.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750105
					]
				},
				{
					"id": 751750105,
					"content": "\"Aşınmaya karşı önlem olarak Yıldız Kümeleri etkinleştirilmeli ve aktif olarak yerleştirilmeli. Hiçlik onları tamamen yozlaştırmadan önce kendilerini yok edip Hiçliğin etkisini ortadan kaldıracaklar...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750106
					],
					"speakerTitle": "Gölete gir"
				},
				{
					"id": 751750106,
					"content": "Hedeflerin aşınıp aşınmadığını nasıl hatasız bir şekilde tespit edeceksin? Kontrol edilebilir bir örnek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750107
					],
					"speakerTitle": "Gölete gir"
				},
				{
					"id": 751750107,
					"content": "Kendi üzerinde mi deneyeceksin? Aklını mı kaybettin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750108
					],
					"speakerTitle": "Gölete gir"
				},
				{
					"id": 751750108,
					"content": "\"Hah. Bir şey olmaz. En azından bu çökmüş bedenim bir işe yaramış olur.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750109
					]
				},
				{
					"id": 751750109,
					"content": "Bu sistem etkinleştirildiğinde hayatta kalma ihtimali en düşük kişi sen olacaksın, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750110
					],
					"speakerTitle": "Gölete gir"
				},
				{
					"id": 751750110,
					"content": "Hiçlik sonunda çürüttü mü zihnini? Yoksa... Tüm soydaşlarının senin cenaze alevinde kendini feda etmesini mi istiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750111
					],
					"speakerTitle": "Gölete gir"
				},
				{
					"id": 751750111,
					"content": "\"Halkına ne kadar az güveniyorsun! Sen hariç tüm lordlar buna rızalarını gösterdi.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750112
					]
				},
				{
					"id": 751750112,
					"content": "Körü körüne takip ediyorlar planını çünkü, planın arkasındaki gerçeği hiç düşünmüyorlar... Bu eylemde benim rızam yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750113
					],
					"speakerTitle": "Gölete gir"
				},
				{
					"id": 751750113,
					"content": "\"... Bir önemi yok. Yok oluş... Aynı zamanda yeniden doğuş olacak. Ben kararımı verdim.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750114
					]
				},
				{
					"id": 751750114,
					"content": "\"Hım... Korkarım ki her gün en fazla bu kadar süre uyanık kalabiliyorum. Her halükarda hazırlıklar tamamlandığında etkinleştireceğim onu.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750115
					]
				},
				{
					"id": 751750115,
					"content": "Başka bir çözüme yer yok mu hiç? Farklı bir yol arıyorum ben hâlâ... Dünyayı sırf kişisel bir garez uğruna alevlere boğmadığından emin misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750116
					],
					"speakerTitle": "Gölete gir"
				},
				{
					"id": 751750116,
					"content": "\"Kim bilir? Gölgelerdeki düşmanımızı bu dünyadan uzakta tutmak için ne gerekiyorsa yaparım.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750117
					]
				},
				{
					"id": 751750117,
					"content": "\"Ayrıca 'farklı bir yol' diyorsun da... Aradığını o 'insanlar'dan bulabilecek misin? Çok kaptırmışsın kendini. Görüyorum...\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750118
					]
				},
				{
					"id": 751750118,
					"content": "\"Sana anlatmaya çalıştım. Ama tıpkı alev havuzlarında bilgelik arayan ırkımızda da olduğu gibi, bilmek ve kabul etmek birbirinden farklı iki kavramdır.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750119
					]
				},
				{
					"id": 751750119,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751750120
					],
					"speakerTitle": "Gölete gir"
				},
				{
					"id": 751750120,
					"content": "\"Eğer istediğim tek şeyin 'yıkım' olduğuna inanıyorsan... İnşa etmek istediğin bir dünya varsa... Durdur o zaman beni. Öldür beni. Kanıtla kendini bana!\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750121
					]
				},
				{
					"id": 751750121,
					"content": "\"Ama şunu da bil Kukulkan... Bu diyeceğim kehanet değil, bir zamanlar aynı yolu yürüyen benden sana bir tavsiye yalnızca. Bir gün gelecek...\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751750122
					]
				},
				{
					"id": 751750122,
					"content": "\"... Sen de benim yürüdüğüm yolu yürüyeceksin.\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		}
	]
}