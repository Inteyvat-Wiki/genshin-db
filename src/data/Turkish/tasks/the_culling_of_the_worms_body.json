			"dialogs": [
				{
					"id": 735150101,
					"content": "Gelmişsin maceracı. Biz de gerekli kurulumları yapmak üzereydik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150102
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150102,
					"content": "Eğer her şey yolunda giderse o canavara bugün hiç unutmayacağı bir ders verebiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150103
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150103,
					"content": "Yükleme işlemi sürerken bunu bozmaya çalışacak canavarlar olabilir. Öyle olursa lütfen bir gözünüz yükleme sürecinde ve cihazın durumunda olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150104,
						735150105
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735150104,
					"content": "Oldu bil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150106
					]
				},
				{
					"id": 735150106,
					"content": "Çok teşekkürler maceracı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150107
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735150107,
					"content": "Ah, benim bir fikrim var! Solucanezen Topu için yardım etmeye uğraşıp durdun. Topu ilk defa test etme onuru da sana ait!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150108,
						735150110
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150108,
					"content": "Bunu kendin yapmak istemez misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150109
					]
				},
				{
					"id": 735150109,
					"content": "Topların yere çarptığı anı izlemek beni daha çok mutlu eder! Ayrıca ateşlemeyi başkası yaparsa ben de tüm o ihtişamı dışarıdan izleyebilirim... Ah! Her şey ortada zaten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150112
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150112,
					"content": "Tek yapman gereken yükleme cihazını canavarlardan korumak ve gücün yüklenmesi için beklemek. Solucanın zayıf noktasını yakalamak için bekle ve sonra tam güçle ateş et!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150113
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150113,
					"content": "Gerisini ateşleme ve otomatik düzeltme mekanizmaları halleder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150114
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150114,
					"content": "#Etkileyici. Paimon da izlemek istiyor {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735150115,
					"content": "Tamam, hallederim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150116
					]
				},
				{
					"id": 735150116,
					"content": "Pekala, anlaştık o zaman! Sana nasıl çalıştığını anlatayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150110,
					"content": "Bu şeyin nasıl çalıştığı hakkında bir fikrim yok...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150111
					]
				},
				{
					"id": 735150111,
					"content": "Sakin ol! Tüm tasarımı kullanıcı dostu olmasına yönelik yaptım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150112
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735150105,
					"content": "Tamamdır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150106
					]
				}
			]
		}
	]
