			"dialogs": [
				{
					"id": 752430101,
					"content": "Ah, sevgili müşterim, hayatımı kurtardınız. O Fatui haydutlarını kovduğunuz teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430102
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752430102,
					"content": "O aptalların nereden geldiklerini bilmiyorum ama beni tehdit etmekle dahi uğraşmadılar. Doğrudan gelip ellerini çantama daldırdılar! Bildiğiniz soyguncu hepsi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430103
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752430103,
					"content": "Neyse ki siz araya girdiniz! Siz olmasaydınız her şeyimi kaybedecektim... Lütfen teşekkürlerimi kabul edin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430104
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752430104,
					"content": "Doğru ya, size burayı tanıtmayı unuttum. Bu keyifli yerin adı Gün Işığı Alpaka Parkı. Burada hem sevimli Alpakaları görebiliyor hem de alakalı pek çok oyuncak satın alabiliyorsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430105
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752430105,
					"content": "Ama şu haydutlar hem çalışanlarımı hem de misafirleri korkutup kaçırdı... Ayıkla şimdi pirincin taşını.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752430106
					],
					"speakerTitle": "Aloha"
				},
				{
					"id": 752430106,
					"content": "Eğer Alpaka Parkını gezmek istiyorsanız lütfen yarın gelin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aloha"
				}
			]
		},
