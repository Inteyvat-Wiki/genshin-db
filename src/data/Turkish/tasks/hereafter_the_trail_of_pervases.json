			"dialogs": [
				{
					"id": 710350101,
					"content": "Siz ikiniz ne istersiniz bakalım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350102
					],
					"speakerTitle": "Şef Mao"
				},
				{
					"id": 710350102,
					"content": "Üç porsiyon Izgara Kaplan Balığı lütfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350103
					]
				},
				{
					"id": 710350103,
					"content": "Derhal! Hafiften bekleteceğim sizi ama, birazdan pişerler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350104
					],
					"speakerTitle": "Şef Mao"
				},
				{
					"id": 710350104,
					"content": "Üç porsiyon mu? Biri sana, biri Paimon'a... Sonuncusu kime?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350105,
						710350106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350105,
					"content": "Gidip Pervases'i ziyaret ederiz diyordum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350107
					]
				},
				{
					"id": 710350107,
					"content": "Bize Yedi Yıldızlı Lambayı ve Buhurdanlığı veren Pervases'i mi diyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350108,
					"content": "Ha, doğru. Izgara Kaplan Balığının tadını özlediğini söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350109,
					"content": "Ama o ölmemiş miydi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350110,
					"content": "Yine de gidip saygımızı sunabiliriz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350111
					]
				},
				{
					"id": 710350111,
					"content": "Mantıklı. Hadi gidelim o zaman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350112,
					"content": "Pervases'le son buluştuğumuzda tapınak berbat bir haldeydi, ayrıca sağda solda Hazine Avcıları vardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350113,
					"content": "Umarım heykele bir zarar gelmemiştir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350114,
					"content": "Üç porsiyon Izgara Kaplan Balığınız. Buyurun efendim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350115
					],
					"speakerTitle": "Şef Mao"
				},
				{
					"id": 710350115,
					"content": "#Ooh, harika kokuyorlar! Haydi {NICKNAME}. Sonraki durağa gidelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350106,
					"content": "Pervases, Izgara Kaplan Balığına bayılır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350107
					]
				}
			]
		},
