			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wang Ping'an",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710350401,
					"content": "Bu tapınak mahvolmuş durumda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350402
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350402,
					"content": "Söyle bakalım beyefendi, tapınağı onarma fikri de nereden esti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350403,
					"content": "Şey... Orası uzun hikaye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350404
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350404,
					"content": "Adeptus taklidi yaptığım zamanlarda bu yalana devam etmeme yardımcı olacak bir sürü kaynak topladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350405
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350405,
					"content": "O Adeptus bana dersimi verdikten sonra iyi biri olacağıma yemin etmiştim, hatırladın mı? İşte geri döndükten sonra topladığım tüm malzemeleri yok etmeyi düşünüyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350406
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350406,
					"content": "Ama sonra aklıma bir şey geldi... Tüm bu bilgileri yok etmek yerine dolandırıcılıkla ilgili bildiğim her şeyi yazıya döksem ve başkalarıyla paylaşsam daha iyi olmaz mıydı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350407
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350407,
					"content": "Böylelikle dolandırıcılara karşı insanların gözünü açacaktım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350408
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350408,
					"content": "Yazdığım rehber birçok insanın işine yaramış. Bu bana da sürpriz oldu. Sivil İşler Bakanlığı bile rehberi kullandıklarını söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350409
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350409,
					"content": "Hatta dolandırıcılara karşı alınabilecek birkaç ek önlem bile paylaştılar ve rehberime eklememi istediler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350410
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350410,
					"content": "Bunun için güzel de bir para verdiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350411
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350411,
					"content": "Rehber dışında Bekçi Yaksha hakkında da bir kitap yazmayı planlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350412
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350412,
					"content": "Tabii ki kitabın amacı Bekçi Yaksha'nın hikayelerini olabildiğince fazla insanla paylaşmak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350413
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350413,
					"content": "Bu sayede halk öykülerimiz hakkında bildiklerimi iyi bir amaç uğruna kullanabileceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350414
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350414,
					"content": "Pervases'in tapınağını da ikinci kitabım için bilgi toplarken keşfettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350415
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350415,
					"content": "Bazı kaynaklardan bu tapınağın atalarımız tarafından Yaksha Pervases'in anısına inşa edildiğini öğrendim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350416
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350416,
					"content": "Ama tapınağın bu kadar kötü bir durumda olacağını tahmin etmemiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350417
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350417,
					"content": "Geri döndüğümde bu konu üzerine düşündüm ve tapınağın tadilatını kendi cebimden karşılamaya karar verdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350418
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350418,
					"content": "Sonuçta beni de doğru yola bir Adeptus yönlendirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350419
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350419,
					"content": "Bu tapınağı onararak eskiden yaptığım yanlışları telafi edebileceğimi düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350420
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350420,
					"content": "Hımm... Doğruyu söylediğini düşünüyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350421,
					"content": "#Sen ne düşünüyorsun {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350422,
						710350424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350422,
					"content": "Bana da doğruymuş gibi geldi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350423
					]
				},
				{
					"id": 710350423,
					"content": "\"Gibi\" derken? Doğruyu söylüyorum! En ufak yalanım yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350426
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350426,
					"content": "*iç çeker* İyi tamam, ne istiyorsanız onu düşünün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350427
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350427,
					"content": "Bana güvenmiyorsanız tadilat başladığında gelin kendi gözlerinizle görün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350424,
					"content": "Zamanında bizi kandırmayı denemiştin ama...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350425
					]
				},
				{
					"id": 710350425,
					"content": "Bıraktım ben o işleri! Ben namuslu bir vatandaşım artık! Düzeleceğime yemin etmemiş miydim o Adeptusun önünde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350426
					],
					"speakerTitle": "Wang Ping'an"
				}
			]
		},
