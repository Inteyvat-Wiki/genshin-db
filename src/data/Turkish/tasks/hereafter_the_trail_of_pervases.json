			"dialogs": [
				{
					"id": 710350201,
					"content": "Ne yapıyorsunuz burada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350202
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 710350202,
					"content": "Sen de mi Pervases'i görmeye geldin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350203
					]
				},
				{
					"id": 710350203,
					"content": "Yok, geçiyordum sadece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350204
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 710350204,
					"content": "Siz ikiniz niye buradasınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350205
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 710350205,
					"content": "Pervases'i görmeye geldik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350206,
					"content": "Of, burası yine geçen seferki gibi berbat durumda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350207,
					"content": "Tapınak var burada, heykel de var. Neden buranın bakımını yapmaya gelmiyorlar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350208,
					"content": "Belki de burayı unutmuşlardır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350209
					]
				},
				{
					"id": 710350209,
					"content": "İnsanlar böyle bir yeri nasıl unutabilir? Yakshalar dediğin, Liyue Limanı'nı savunan kahramanlar sonuçta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350210,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350211
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 710350211,
					"content": "Xiao, sen... Kızgın mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350212,
					"content": "Hayır. Yakshalar görevlerini sadece itibar için yerine getirmediler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350213
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 710350213,
					"content": "Şimdi bunları konuşmayalım. Önce Izgara Kaplan Balığı gelsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350214,
					"content": "Xiao, sen de istersen kendi payımızın yarısını sana verebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350215,
					"content": "Yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350216
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 710350216,
					"content": "İmdat! Yardım edin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350217
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350217,
					"content": "Hah? Duydunuz mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350218,
					"content": "Bakın. Biri yardım istiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350219
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 710350219,
					"content": "Hadi gidelim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350220
					]
				},
				{
					"id": 710350220,
					"content": "Ne? Izgara Kaplan Balığı ne olacak ama? Paimon daha yemedi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
