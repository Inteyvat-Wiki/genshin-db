			"dialogs": [
				{
					"id": 710350301,
					"content": "Teşekkür ederim yüce Adeptus, teşekkür ederim yiğit kahraman! Aa, tesadüfe bak! Yine karşılaştık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350302
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350302,
					"content": "Bizi tanıyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350303,
					"content": "Nasıl unutabilirim ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350304
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350304,
					"content": "Sen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350305
					]
				},
				{
					"id": 710350305,
					"content": "Ben Wang Ping'an! Hatırlamadın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350306,
						710350308
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350306,
					"content": "Ha, \"Yıldızkapan\" mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350307
					]
				},
				{
					"id": 710350307,
					"content": "Hı? Ne? \"Yıldızkapan\" da ne? Şey, Adeptusun önünde konuşmayalım bunları lütfen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350310
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350310,
					"content": "Tam da Yaksha Pervases'in tapınağında adak adamaya hazırlanıyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350311
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350311,
					"content": "Ama dağlara girdikten kısa bir süre sonra bu Hazine Avcıları bana saldırdı... Beni kurtardığınız için teşekkür ederim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350312
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350312,
					"content": "Bir dakika. Pervases'in tapınağında ne yapacaktın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350313,
					"content": "Heykele zarar mı verecektin yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350314,
					"content": "Hayır, hayır! Böyle bir şey aklımın ucundan bile geçmez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350315
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350315,
					"content": "Ne yapacaktın o zaman?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350316
					]
				},
				{
					"id": 710350316,
					"content": "Şey... Tapınağı onarmak istiyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350317
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350317,
					"content": "Bugünkü planım tapınağın şu anki durumunu yakından inceleyip gerekli malzemeleri almaktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350318
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350318,
					"content": "Yolumu Hazine Avcılarının kesmesini ve onlardan kaçmak zorunda kalmayı beklemiyordum tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350319
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350319,
					"content": "Kaçayım derken de kayboldum. Devamını biliyorsunuz zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350320
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350320,
					"content": "Devamını tapınakta konuşalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350321
					]
				},
				{
					"id": 710350321,
					"content": "Haklısın, burası sohbet etmek için uygun bir yer değil. Önce tapınağa gidelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350322
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350322,
					"content": "Orada konuşuruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350323
					],
					"speakerTitle": "Wang Ping'an"
				},
				{
					"id": 710350323,
					"content": "Siz gidin. Benim yapacak işlerim var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350324
					],
					"speakerTitle": "Xiao"
				},
				{
					"id": 710350324,
					"content": "Hı? Gidiyor musun hemen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710350325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350325,
					"content": "Gitti bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710350308,
					"content": "Tamam, hatırladım seni.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710350309
