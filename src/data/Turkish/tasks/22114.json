			},
			"dialogs": [
				{
					"id": 221140701,
					"content": "Ben fıçıcıyım. Ne el becerim iyidir, ne de belirli bir yeteneğim vardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140702,
						221140708
					],
					"speakerTitle": "Asabi Ann"
				},
				{
					"id": 221140702,
					"content": "Fıçıcı mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140703
					]
				},
				{
					"id": 221140703,
					"content": "Yani fıçı tamir eden ve tahta bir fıçıyı son haline getirmek için tek bir tahta kalasa ihtiyacı olan biriyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140704
					],
					"speakerTitle": "Asabi Ann"
				},
				{
					"id": 221140704,
					"content": "Ama elimdeki kalasın kalitesi kötü. Biraz kısa ve fıçımı yapmak için bunu kullanırsam, fıçının kapasitesi önemli ölçüde azalacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140705
					],
					"speakerTitle": "Asabi Ann"
				},
				{
					"id": 221140705,
					"content": "Üstelik yeni bir tahta kalas almaya kalksam, fıçı kim bilir ne zaman biter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140706
					],
					"speakerTitle": "Asabi Ann"
				},
				{
					"id": 221140706,
					"content": "Fıçıyı bitirmek için zamanım azaldığından, kötünün iyisini seçmem gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140707
					],
					"speakerTitle": "Asabi Ann"
				},
				{
					"id": 221140707,
					"content": "Kim bilir dünyada benim gibi kaç fıçıcı benzer bir ikilem yaşıyordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asabi Ann"
				},
				{
					"id": 221140708,
					"content": "Linling'in işi hakkında konuşabilir miyiz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140709
					]
				},
				{
					"id": 221140709,
					"content": "İşi mi? Tabii. Geçmişte tekne sayımında yardımını istemişti değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140710
					],
					"speakerTitle": "Asabi Ann"
				},
				{
					"id": 221140710,
					"content": "Neden şaşırdın? Elimizde sonuç olduğu müddetçe, işini nasıl yaptığı beni çok ilgilendirmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140711
					],
					"speakerTitle": "Asabi Ann"
				},
				{
					"id": 221140711,
					"content": "Ayrıca sana verdiği ödüller de onun kendi cebinden çıkıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140712
					],
					"speakerTitle": "Asabi Ann"
				},
				{
					"id": 221140712,
					"content": "Ama verileri kendisi incelemeden önce bana bildirmesi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140713
					],
					"speakerTitle": "Asabi Ann"
				},
				{
					"id": 221140713,
					"content": "Beni asıl sinirlendiren bu sorumsuzca davranışıydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asabi Ann"
				}
			]
		},
