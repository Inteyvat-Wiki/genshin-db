					"Linling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140101,
					"content": "Bittim ben, bu defa her şey bitti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140102
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140102,
					"content": "Sorun ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140103
					]
				},
				{
					"id": 221140103,
					"content": "*hıçkırarak ağlar* Asabi Ann, bu tarz bir işe uygun olmayabileceğimi söyledi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140104
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140104,
					"content": "Bu beni kovacağı anlamına gelmiyor mu? Ne yapacağım ben? Hep çok sıkı çalışıyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140105,
						221140111
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140105,
					"content": "Aniden ne oldu böyle?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140106
					]
				},
				{
					"id": 221140106,
					"content": "Tekneleri saymak için daha önce senden yardım almamış mıydım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140107
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140107,
					"content": "Yeteneğine güvenip bana verdiğin veriyi kontrol etmedim ve doğrudan teslim ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140108
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140108,
					"content": "Hesaplamaların çoğu yanlışmış... Asabi Ann küplere bindi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140109
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140109,
					"content": "Onunla konuşmama yardım eder misin? Bundan böyle işimi ciddiyetle yapacağım! Bir daha da senden yardım istemeyeceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140110
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140110,
					"content": "Ama gidip kendim sormaya cüret edemiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140111,
					"content": "Verdiğim hesaplamalar yanlış mıymış?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140112
					]
				},
				{
					"id": 221140112,
					"content": "Evet! Daha önce bu konuda senden yardım almamış mıydım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140113
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140113,
					"content": "Yeteneğine güvenip bana verdiğin veriyi kontrol etmedim ve direkt teslim ettim... Hesaplamaların çoğu yanlış çıktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140114
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140114,
					"content": "Ama sadece arada bir yardımını istedim. Çoğu veriyi kendim de hesapladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140115
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140115,
					"content": "Hepsini yan yana getirince nerede hata yaptığımı bulamadım. Asabi Ann da küplere bindi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140116
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140116,
					"content": "Lütfen onunla konuşmama yardım et! Bundan böyle işimi ciddiyetle yapacağım! Bir daha da senden yardım istemeyeceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140117
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140117,
					"content": "Ama gidip kendim sormaya cüret edemiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				}
			]
		},
