						"stepId": 2211405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140501,
					"content": "Sayıları belirlediniz mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140502,
						221140504
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140502,
					"content": "Evet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140503
					]
				},
				{
					"id": 221140503,
					"content": "Harika. Hazırlıklarım neredeyse tamam. Birazdan malların tümünü inceleyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140506
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140506,
					"content": "Doğru! Lütfen bunu teşekkür olarak kabul et. Az sonra gidip kargoları inceleyeceğim. Bu defa hataya mahal vermeyeceğim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140504,
					"content": "Şiir yazmıyordun değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140505
					]
				},
				{
					"id": 221140505,
					"content": "Tabii ki hayır! Önceliklerimi belirlemeyi biliyorum. Şimdi şiir yazmanın sırası değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140506
					],
					"speakerTitle": "Linling"
				}
			]
		},
		{
			"id": 2211406,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211402",
							"2"
						],
						"stepId": 2211402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140601,
					"content": "Artık çalışırken şiir yazamam. Odaklanmam gerek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140602,
						221140607,
						221140612
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140602,
					"content": "Sonuçta iş her şeyden önce gelir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140603
					]
				},
				{
					"id": 221140603,
					"content": "Biliyorum. Ama yıllarca her gün aynı şeyi yapmak... İnsanı bir müddet sonra sıkıyor, anlıyorsun değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140604
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140604,
					"content": "Tabii ki, nedeni de bunun bir yan iş olması. Yani hem iş o kadar önemli değil, hem de kimsenin umurunda olmuyorsun; bu yüzden bir süre sonra için geçmeye başlıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140605
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140605,
					"content": "Asabi Ann sürekli \"Her iş önemlidir.\" ve \"Her iş belirleyicidir.\" gibi şeyler söyler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140606
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140606,
					"content": "Peki hal böyleyken, herkes neden yapmak istediği iş konusunda bu kadar seçici?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140607,
					"content": "Yaptığın işin sorumluluğunu alman gerekir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140608
					]
				},
				{
					"id": 221140608,
					"content": "Sadece arada bir yardımını istiyorum. Çoğu zaman kendi işimi zaten kendim hallediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140609
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140609,
					"content": "İşimin sorumluluğunu almam gerektiğini biliyorum ama iş yoğunlaştıkça, ben daha fazla kaytarmak istiyorum. Bu yüzden arada senin yardımını istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140610
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140610,
					"content": "Kendimi boşta bulduğum anda, yapacak bir şeyler aramaya başlıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140611
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140611,
					"content": "Hayatında bir gün bile çalışmadın değil mi? Sana bunları anlatmanın hiç faydası yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140612,
					"content": "Neden şiir yazmayı bu kadar istiyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140613
					]
				},
				{
					"id": 221140613,
					"content": "Niye durup dururken böyle bir şey sordun? Bir düşüneyim... Sence bir insan neden çalışır?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140614
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140614,
					"content": "Bana göre \"çalışmaya devam etmiş olmak için çalışmak\" biraz sıkıcı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140615
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140615,
					"content": "Nasıl anlatsam, herkesin kendi hayalleri var değil mi? Gündelik iş hengamesinden tamamen ayrı, başka hayaller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140616
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140616,
					"content": "Böylece insan, devam edemeyecekmiş gibi hissettiği anlarda bile hayallerine sığınabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140617
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140617,
					"content": "Ama tabii bu benim düşüncem. Maceracılar bu konuda ne düşünür, onu bilemem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140618
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140618,
					"content": "İnsanların hayalleri için yaşamaktan başka bir şey yapmadıklarını gördükçe, benim de kendimi gündelik işlere adayasım geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140619
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140619,
					"content": "Yine de... Hahaha, bu arada söylemiş olayım, hayaller hayal olarak kalır. Çalışırken ayakların yere basmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				}
			]
		},
