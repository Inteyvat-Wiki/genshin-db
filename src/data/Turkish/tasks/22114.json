			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140301,
					"content": "İş konusunda ne yapmalıyım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140302
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140302,
					"content": "Asabi Ann, sana bir şans daha vereceğini söyledi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140303
					]
				},
				{
					"id": 221140303,
					"content": "Gerçekten mi? Şahane! Harika o zaman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140304
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140304,
					"content": "Kargo kontrolü mü? Eyvah... Ama daha önce o işi hiç yapmadım ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140305
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140305,
					"content": "Bir daha hata yaparsam sonum olur. Önce hazırlık yapmam gerekiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140306
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140306,
					"content": "Önceki inceleme standartlarını ve inceleme biçimlerini bulmam gerek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140307
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140307,
					"content": "İlk olarak kargo sayısını doğrulamama yardım eder misin? Sadece belgedeki kargo sayılarını kontrol ederek doğru olup olmadıklarına bakman gerek. Sonra ben daha ayrıntılı bir inceleme yürüteceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140308,
						221140311
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140308,
					"content": "Anladım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140309
					]
				},
				{
					"id": 221140309,
					"content": "Çok teşekkür ederim. Bu sırada ben de hazırlık yapayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140310
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140310,
					"content": "Bu defa işleri batıramam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140311,
					"content": "Her şeyi bize bırak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140312
					]
				},
				{
					"id": 221140312,
					"content": "Hayır, bu defa olmaz. Kargo incelemesi tekne saymaktan çok daha karmaşık. Bunu kendim halletmeliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140313
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140313,
					"content": "Sen lütfen sadece kargo sayısını doğrula. Sonrasında ben daha detaylı bir inceleme yapacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linling"
				}
			]
		},
