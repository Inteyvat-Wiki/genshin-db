					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140802
					],
					"speakerTitle": "Linling"
				},
				{
					"id": 221140802,
					"content": "Bu defa çok dikkatli olmam gerek. Tek bir hata bile yapamam...",
					"roleType": "TALK_ROLE_NPC",
