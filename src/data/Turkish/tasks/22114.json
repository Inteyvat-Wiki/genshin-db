			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Asabi Ann"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221140201,
					"content": "*iç çeker* Bu gerçekten...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140202
					],
					"speakerTitle": "Asabi Ann"
				},
				{
					"id": 221140202,
					"content": "Linling hakkında konuşabilir miyiz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140203
					]
				},
				{
					"id": 221140203,
					"content": "Linling'i mi soruyorsun? Nasıl desem... Yaptığı işe pek uygun biri değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140204
					],
					"speakerTitle": "Asabi Ann"
				},
				{
					"id": 221140204,
					"content": "Daha da açık olmak gerekirse, veri girişlerinde yaptığı hatalar gerçekten korkunç.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140205
					],
					"speakerTitle": "Asabi Ann"
				},
				{
					"id": 221140205,
					"content": "Sırf bu haftanın verilerine bakacak olursak, yedi günden sadece birinde veya ikisinde doğru veri var. Şöyle bir göz gezdirerek yapılsa bile, onun yaptığından daha tutarlı bir sonuç olurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140206
					],
					"speakerTitle": "Asabi Ann"
				},
				{
					"id": 221140206,
					"content": "Bu durumda işi nasıl ona bırakabilirim ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140207
					],
					"speakerTitle": "Asabi Ann"
				},
				{
					"id": 221140207,
					"content": "Sadece sayılardan bahsediyorsak...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140208
					]
				},
				{
					"id": 221140208,
					"content": "Bizim işimizde \"sadece\" diye bir tabir yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140209
					],
					"speakerTitle": "Asabi Ann"
				},
				{
					"id": 221140209,
					"content": "Tahta fıçılardaki tek bir kalas dahi azıcık kısa kalsa, tüm fıçının hacmi azalır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140210
					],
					"speakerTitle": "Asabi Ann"
				},
				{
					"id": 221140210,
					"content": "İşteki de buna benzer bir durum. Tek bir konuda bile dikkatsizce davranmak, işi daha çok çıkmaza sürükler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140211
					],
					"speakerTitle": "Asabi Ann"
				},
				{
					"id": 221140211,
					"content": "Tekne sayma işinden örnek vereyim. Sayımlar doğru olmazsa, limanda gerçekleştireceğimiz faaliyetler isabetli olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140212
					],
					"speakerTitle": "Asabi Ann"
				},
				{
					"id": 221140212,
					"content": "Buradaki hataların maliyeti çok çıkarabilir ve biri bu sorunu çözmeye çalışsa bile, telafi için harcanan zaman geri gelmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140213
					],
					"speakerTitle": "Asabi Ann"
				},
				{
					"id": 221140213,
					"content": "Şimdi anladın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140214,
						221140219
					],
					"speakerTitle": "Asabi Ann"
				},
				{
					"id": 221140214,
					"content": "Hım... Anlıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140215
					]
				},
				{
					"id": 221140215,
					"content": "Yine de limanda iş gücü eksiğimiz var, yani kendisini muhtemelen kovmayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140216
					],
					"speakerTitle": "Asabi Ann"
				},
				{
					"id": 221140216,
					"content": "Nasıl desem... \"Kısa kalas\", \"eksik kalastan\" iyidir, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140217
					],
					"speakerTitle": "Asabi Ann"
				},
				{
					"id": 221140217,
					"content": "Kargoyu incelemeyle görevli kişi acil bir durum nedeniyle burada değil. Linling'e söyle, orada onun yardımına ihtiyaç var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140218
					],
					"speakerTitle": "Asabi Ann"
				},
				{
					"id": 221140218,
					"content": "Orada yapacağı işte ciddi bir sorun çıkmazsa, incelemeden sorumlu kişi geri döndüğünde Linling de tekne sayma işine dönebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140224
					],
					"speakerTitle": "Asabi Ann"
				},
				{
					"id": 221140224,
					"content": "Hımm... Sanırım bu bir deneme olarak değerlendirilebilir, ayrıca ikinci bir şans tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140225
					],
					"speakerTitle": "Asabi Ann"
				},
				{
					"id": 221140225,
					"content": "Bu beyanı Linling'e ilet. Kontrolleri buna göre yürütmesini ve kontrol ettiklerinin arkasına işaret koymasını söyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140226
					],
					"speakerTitle": "Asabi Ann"
				},
				{
					"id": 221140226,
					"content": "Bir de lütfen aklını başına devşirmesini de söyle. Bu kez de işleri batırırsa, kendisine başka şans verilmeyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asabi Ann"
				},
				{
					"id": 221140219,
					"content": "Gidip söyleyeyim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221140220
					]
				},
				{
					"id": 221140220,
					"content": "Ne söyleyeceksin, kovulduğunu mu? Henüz kovulmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140221
					],
					"speakerTitle": "Asabi Ann"
				},
				{
					"id": 221140221,
					"content": "Limanda iş gücü eksiğimiz var. Nasıl desem... \"Kısa kalas\", \"eksik kalastan\", iyidir değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140222
					],
					"speakerTitle": "Asabi Ann"
				},
				{
					"id": 221140222,
					"content": "Kargoyu incelemeyle görevli kişi acil bir durum nedeniyle burada değil. Linling'e söyle, orada onun yardımına ihtiyaç var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140223
					],
					"speakerTitle": "Asabi Ann"
				},
				{
					"id": 221140223,
					"content": "Orada yapacağı işte ciddi bir sorun çıkmazsa, incelemeden sorumlu kişi geri döndüğünde Linling de tekne sayma işine dönebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221140224
					],
					"speakerTitle": "Asabi Ann"
				}
			]
		},
		{
