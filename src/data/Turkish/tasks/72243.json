					"nextDialogs": [
						722430121
					]
				},
				{
					"id": 722430121,
					"content": "Elbette, hiç sorun değil. Tabii teklifimin bu eşyanın ederi kadar olduğuna eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430122
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430122,
