				{
					"id": 722430102,
					"content": "Satmak istediğim bir hazinem var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430103
					]
				},
				{
					"id": 722430103,
					"content": "Hazine mi satmak istiyorsun? Bu ilk kez oluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430104
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430104,
					"content": "Senin kadar yetenekli bir maceracının satacak çok nadir ürünleri vardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430105
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430105,
					"content": "Bir bakayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430106
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430106,
					"content": "Marjorie'ye Ejderkemiği Küresini anlatıyorsun.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722430107
					]
				},
				{
					"id": 722430107,
					"content": "Bu, ozanların \"Dertyok Meyvesi\" dediği şey değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430108
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430108,
					"content": "Bunun gerçekten var olduğunu bilmiyordum. Demek gerçek adı Ejderkemiği Küresi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430109
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430109,
					"content": "Etkileri dediğin gibiyse sana karşılığında 80.000 Mora ve bazı yöresel yemeklerden veririm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430110
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430110,
					"content": "Hımm... Karşılığında 80.000 Mora ve 5 Ay Çöreği kabul eder misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430111,
						722430114,
						722430120
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430111,
					"content": "Ne için kullanacaksın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430112
					]
				},
				{
					"id": 722430112,
					"content": "Hehe. Bu eşi benzeri olmayan bir hazine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430113
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430113,
					"content": "Etkileri bir peri masalından fırlamış gibi! Simyagerler bu ürünü görünce Moralarını önüme dökecektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430110
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430114,
					"content": "Makul bir fiyat. Anlaştık.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722430115
					]
				},
				{
					"id": 722430115,
					"content": "Anlaştık o halde. Buraya kadar getirdiğin için teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430116
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430116,
					"content": "Doğru, yoğuşma ile oluşan bu tür damlalar rüzgarda yavaşça buharlaşır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430117
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430117,
					"content": "Kalitesini korumak için bir zarla üzerini örtmek veya sızdırmayan kapalı bir kutuya koymak çok iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430118
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430118,
					"content": "Sana bir tüyo vereyim, karşılığında para istemem. Umarım maceralarında sana yardımcı olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722430119
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430119,
					"content": "Gelecekte bu tür hazinelerle karşılaşırsan burada her zaman bulduğun hazineleri alacak biri var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 722430120,
					"content": "Biraz daha düşüneyim.",
