				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706610401,
					"content": "Burası iş görür! Sudaki şu küçük balıkları gördün mü? Ne kadar güzeller...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610402
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610402,
					"content": "İşte, bu aletlerden birkaçını al. Olta, yem ve yem yapmak için tarifler var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610403
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610403,
					"content": "Önce yemi kancana tak, balıkların toplandığı yere hedef aldıktan sonra oltanı at! Daha sonra sabırla balığın yemi yutmasını bekle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610404
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610404,
					"content": "Yeni başlayanlarda \"acemi şansı\" diye bir şey olduğunu duydum. Ben ilk başladığım zamanlarda, yarım metrelik kocaman bir levrek yakalamıştım! Ne duruyorsun? Hadi rast gele!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610405
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610405,
					"content": "Umarım bir Paimon daha yakalarım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610406
					]
				},
				{
					"id": 706610406,
					"content": "Hey! Bu Paimon'un üstüne başka Paimon alamazsın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706610407,
					"content": "Paimon mu? Ne kadar garip bir isim, bir tür balık mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610408
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610408,
					"content": "Geçen sefer yakalamayı başardığım \"harika bir deniz mahsulü\".",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610409
					]
				},
				{
					"id": 706610409,
					"content": "Hey! Paimon ne ara \"acil durum yiyeceği\" iken \"harika bir deniz mahsulü\" oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706610410,
					"content": "Ah, anladım! Zaten deneyimli bir oltacı olduğunu düşünmemiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610411
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610411,
					"content": "Ne tutacağını şimdi çok daha merak ediyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nantuck"
				}
			]
		},
