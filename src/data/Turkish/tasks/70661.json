			"dialogs": [
				{
					"id": 706610101,
					"content": "Yıldızlar ve hiçlik yoldaşın olsun! Maceracılar Loncasına hoş geldin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706610102,
					"content": "Balıkçılık Derneğinden bir görev aldık. Civardaki sularda balık faaliyetinin anormal olduğunu bildirdiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610103
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706610103,
					"content": "Maalesef raporlarında ayrıntı vermemişler. Durumun ne olduğunu anlamamıza yardım eder misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706610104,
					"content": "Sorun ne olursa olsun, kolaylıkla halledebileceğinden şüphem yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706610105,
					"content": "Balıkçılık Derneği mi? Bildiğimiz balıkçılık mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610106
					]
				},
				{
					"id": 706610106,
					"content": "Ne? Ne demek \"bildiğimiz balıkçılık mı\"? Anlamadım. Başka tür balıkçılık da mı var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 706610107,
					"content": "Ah, Balıkçılık Derneği... Balıkçılık Derneği... Elbette, mutlaka lezzetli balık yakalamak ile meşgul olmalılar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706610108,
					"content": "Kaybedecek vaktimiz yok. Hadi gidip bir göz atalım! Hehehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7066102,
			"completionStepIds": [
				7066102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
