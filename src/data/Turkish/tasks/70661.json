			},
			"dialogs": [
				{
					"id": 706610601,
					"content": "Nasıl geçti? Yüz ifadene bakılırsa güzel bir balık yakalamışsın! Bakabilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610602
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610602,
					"content": "Ah? Yeni keşfedilmiş bir balık türü! Harika!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610603
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610603,
					"content": "Bana parlak günlerimi hatırlattın, o zamanki seviyeme yaklaşmışsın, hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610604
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610604,
					"content": "Çıplak elle de balık yakalayabilir misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610605
					]
				},
				{
					"id": 706610605,
					"content": "Öhöm... Sanırım bu küçük, sıradan balıklar sana çok kolay geldi. Sana ter döktürecek bir şey vermeliyim belki de.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610606
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610606,
					"content": "Bunu bilmeyebilirsin ama aynı tür balıklar bile, yaşadıkları ortam ve yedikleri yemekteki farklılıklardan dolayı çok farklı gelişebiliyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610607
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610607,
					"content": "Hepsi aynı görünse de bazıları çok aktif ve enerjiktir. Zaman zaman sudan dışarı atlarlar ve çok göz alıcıdırlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610608
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610608,
					"content": "Bu balıklar, hem ticari hem de estetik değer olarak diğerlerinden üstündür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610609
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610609,
					"content": "Çoğu balık düşkünü, bu balıkları süs niyetine yüksek fiyatlara alıp evde akvaryumlarda besliyor. Bu tür balıklara \"süs balığı\" denmesinin sebebi de budur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610610
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610610,
					"content": "Yani \"Acil Durumlar için Paimon\"un yanı sıra...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610611
					]
				},
				{
					"id": 706610611,
					"content": "\"Süs için Paimon\" da var!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610612
					]
				},
				{
					"id": 706610612,
					"content": "Hayır, yok! O kadar çeşit Paimon nasıl olabilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706610613,
					"content": "Evet, aynen böyle. Bakıyorum da hemen kavramışsın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610614
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610614,
					"content": "Son zamanlarda Fırtınakesen Dağları'na yakın sularda çok fazla \"süs balığı\" faaliyeti görüldü, o konumları haritanda işaretledim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610615
					],
					"speakerTitle": "Nantuck"
				},
				{
					"id": 706610615,
					"content": "Hadi gidip bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nantuck"
				}
			]
		},
