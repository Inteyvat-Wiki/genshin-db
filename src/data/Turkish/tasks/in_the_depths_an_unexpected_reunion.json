					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80040101,
					"content": "Tam zamanında geldin Gezgin, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80040102,
					"content": "Selam Katheryne! Bugün bize verebileceğin özel bir görev var mı? Bir dakika ya, sen bizi gördüğüne neden bu kadar mutlu oldun ki? Ne oldu söyle çabuk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040103,
					"content": "Kısa bir süre önce tapınağa gidip bir fal kağıdı çektim. Tapınak görevlisi yakında beklenmedik biriyle karşılaşacağımı söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80040104,
					"content": "Katheryne'in tapınakta fal kağıdı çekmesi... Paimon hayatında bundan daha garip bir şey duymadı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040105,
					"content": "Dur bir saniye, en garip kısmı bu değil ki! Biz şu an Liyue'deyiz! Sen bir gün içinde Inazuma'ya gidip geri mi geldin yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040106,
					"content": "Hehe, benim de bir özel hayatım var sonuçta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80040107,
					"content": "Peki \"beklenmedik biriyle karşılaşmak\" derken bizi mi kastettin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040108,
					"content": "Kim bilir? Yine de yakında beklenmedik biriyle karşılaşacağımı bildiğim için kime rast gelirsem geleyim mutlu oluyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80040109,
					"content": "Peki madem. Birbirimizi neredeyse her gün görüyoruz gerçi ama... Seni mutlu ediyorsa öyle olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040110,
						80040111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040110,
					"content": "Beklenmedik bir karşılaşma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040112
					]
				},
				{
					"id": 80040112,
					"content": "#Şeyi mi diyorsun? Ha, Paimon şimdi anladı {NICKNAME}. O halde umalım da tapınak görevlisi doğruyu söylemiş olsun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040113,
					"content": "Umarım onu buluruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040114,
					"content": "Kusura bakmayın... Yanlış bir şey mi söyledim acaba? Moraliniz bozuldu sanki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040115
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80040115,
					"content": "Ah, önemli bir şey değil. Neyse, işimize geri dönelim. Bize verebileceğin yeni bir görev var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040116,
					"content": "Aslında var, evet. Bu seferki görev bir madenci tarafından verildi. Kanyon'u araştırmakla alakalı bir görev.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040117
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80040117,
					"content": "Gerçekten mi? Kanyon artık mühürlü değil mi yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040118,
					"content": "Görevin ayrıntılarını verme kısmını görevi veren kişiye bırakıyorum. İsmi Yuehui, kendisi şu an Kanyon'da olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040119
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80040119,
					"content": "Tamam o zaman, sağ ol Katheryne! Hemen yola koyulacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040120,
					"content": "Pekala. Yıldızlar ve... Hiçlik yoldaşınız olsun. Bu kez yolunuz gerçekten de hiçliğe gidiyor. İkinize de bol şans dilerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80040111,
					"content": "Yoksa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040112
					]
				}
			]
		},
		{
			"id": 800402,
			"completionStepIds": [
				800402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800402",
							"2"
						],
						"stepId": 800402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yuehui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80040201,
					"content": "Selam! \"Yuehui\" sensin, değil mi? Bizi Maceracılar Loncası gönderdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040202,
					"content": "Hah, süper. Tanıştığımıza memnun oldum. Evet, o görev ilanını ben verdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040203
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040203,
					"content": "Bir saniye... Sen bir yerlerden tanıdık geliyorsun. Ünlü bir maceracı falan mısın yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040204,
						80040205
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040204,
					"content": "Orası biraz karışık.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040206
					]
				},
				{
					"id": 80040206,
					"content": "Şey, peki o zaman. Önce kendimi tanıtarak başlayayım. Ben Yuehui. Madenciyim, kısa süre önce Kanyon'da çalışmak için madencilik izni aldım. Ekibimde başka kişiler de var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040207
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040207,
					"content": "Gerçekten mi? Kanyon'da çalışma izni veriyorlar mı yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040208,
					"content": "Evet, sonunda Yujing Terası'ndakilerin akılları başlarına geldi. Artık yüzeye yakın yerlerde sınırlı miktarda cevher madenciliğine izin veriyorlar. Biz de onay alabilen ilk kişiler arasındayız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040209
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040209,
					"content": "Ancak son zamanlarda madencileri rahatsız eden birtakım olaylar yaşandı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040210
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040210,
					"content": "Öyle mi? Ne gibi? Biz hiçbir şey duymadık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040211,
					"content": "Şey... Doğrusu olayın ciddiyetini söylemek zor. Önemli bir şey de olabilir, önemsiz de. Asıl sorun durumun gerçekten çok... Garip olması.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040212
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040212,
					"content": "Madencilerden biri moladayken birkaç dağ yabanisinin kendisine doğru yürüdüğünü fark etmiş. Adeta rüyada gibi hareket ediyorlarmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040213
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040213,
					"content": "Gelgelelim madencinin yüzüne bile bakmadan yanından geçip gitmişler. Doğrudan Kanyon'un derinliklerine doğru ilerlemişler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040214
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040214,
					"content": "Ondan sonra madenci etrafa daha çok dikkat etmeye başlamış. Sonra aynı olayın devamlı yaşandığını fark etmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040215
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040215,
					"content": "Hımm... Sadece merak etmiş olabilir mi? Nasıl bir yer diye bakmak istemişlerdir belki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040216,
					"content": "Hiç sanmıyorum. Bu durumun en garip kısmı şu... Dağ yabanilerini izleyen madenci diyor ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040217
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040217,
					"content": "Girenlerin geri çıktığını hiç görmemiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040218
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040218,
					"content": "Öyle duruyor yani. İçeri giren dağ yabanileri bir daha asla dışarı çıkmıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040219
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040219,
					"content": "Ayrıca son zamanlarda bu durum gittikçe daha sık yaşanmaya başladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040220
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040220,
					"content": "\"Bu dağ yabanileri ne ayak?\" \"İçeri girenlerin başına ne geliyor?\" \"Bir felaket mi yaklaşıyor acaba?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040221
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040221,
					"content": "Herkesin aklında bu düşünceler dönüp duruyor. Endişeden kafayı yemek üzere millet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040222
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040222,
					"content": "Ahh... Paimon hiç şaşırmadı... Bunu dinledikten sonra Paimon'un bile tüyleri ürperdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040223,
						80040224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040223,
					"content": "Kanyon'un içinde neler döndüğünü düşünmek bile istemiyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040225
					]
				},
				{
					"id": 80040225,
					"content": "Aynen öyle. Bilinmezliğe duyulan korkudan daha derin bir korku yoktur sonuçta. Bu durumu açıklığa kavuşturmamız lazım ki herkesin içi rahat etsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040226
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040226,
					"content": "Peki biz... Bu görevi kabul etmek istiyor muyuz gerçekten? Şey, sağ olun Madenci Bey fakat biz önce biraz düşünelim en iyisi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040227,
					"content": "Kabul ediyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040228
					]
				},
				{
					"id": 80040228,
					"content": "Hey! Paimon'a da fikrini sorsan keşke!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040229,
						80040230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040229,
					"content": "Bu kadar garip bir olayda...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040231
					]
				},
				{
					"id": 80040231,
					"content": "Ha, demek o yüzden... Hımm, peki madem. Belki ikizin hakkında bir şeyler öğreniriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040232,
					"content": "Gitmezsek çok pişman olacaksın, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040233,
					"content": "Nedir son kararınız? Görevi kabul ediyor musunuz? Sizi zorlamak istemem tabii ama... Madencilik İznimin boşa gitme ihtimali moralimi bozuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040234
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040234,
					"content": "Evet, kabul ediyoruz. Bu durum bizi de meraklandırdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80040235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80040235,
					"content": "Harika. Bana gerçekten çok büyük bir iyilik ediyorsunuz. Size hemen dağ yabanilerinin gittiği yeri genel hatlarıyla tarif edeyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80040230,
					"content": "Hiçlik Tarikatının parmağı vardır diye düşünüyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040231
					]
				},
				{
					"id": 80040224,
					"content": "\"Garip\" kelimesinin cuk oturduğu kesin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040225
					]
				},
				{
					"id": 80040205,
					"content": "Orasını boş ver. Biz işimize odaklanalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80040206
					]
				}
			]
		},
		{
			"id": 800403,
			"completionStepIds": [
				800403,
				800404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_A_AND_ETCOR",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
