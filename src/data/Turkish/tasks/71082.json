			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"\"Tang Wuchou\" olduğunu iddia ediyor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710820101,
					"content": "Yine İhtiyar Chou'nun tuzağına mı düştün?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820102
					],
					"speakerTitle": "\"Tang Wuchou\" olduğunu iddia ediyor"
				},
				{
					"id": 710820102,
					"content": "Hadi ama! Sana söyledim ya, onun hazine avı şöyle işliyor: <color=#00E1FFFF>Hazine ne kadar iyiyse etrafında o kadar çok patlayıcı varil olur. Tam tersi de geçerli.</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820103
					],
					"speakerTitle": "\"Tang Wuchou\" olduğunu iddia ediyor"
				},
				{
					"id": 710820103,
					"content": "Şimdi anladın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Tang Wuchou\" olduğunu iddia ediyor"
				}
			]
		},
		{
			"id": 7108202,
			"completionStepIds": [
				7108202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7108202",
							"2"
						],
						"stepId": 7108202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"\"Tang Wuchou\" olduğunu iddia ediyor",
					"He Amca",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710820201,
					"content": "Seni aşağılık Hazine Avcısı... *nefes nefese kalır* Son zamanlarda... Yiyecek mantarım kalmadığı için... Bu kadar yorgun olmasam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820202
					],
					"speakerTitle": "He Amca"
				},
				{
					"id": 710820202,
					"content": "Çoktan ağzını burnunu kırmıştım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820203
					],
					"speakerTitle": "He Amca"
				},
				{
					"id": 710820203,
					"content": "Seni ihtiyar hırsız! Sen nasıl benim Parlak Zamba... Şey, Qingxin diyecektim! Nasıl onlara mantar diyebilirsin? Nasıl koparıp yersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820204
					],
					"speakerTitle": "\"Tang Wuchou\" olduğunu iddia ediyor"
				},
				{
					"id": 710820204,
					"content": "*öksürür* Bunu yapmaya ne hakkın var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820205
					],
					"speakerTitle": "\"Tang Wuchou\" olduğunu iddia ediyor"
				},
				{
					"id": 710820205,
					"content": "Niye kavga ediyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820206,
					"content": "Yiyecek mantar arıyordum! Haha, evet mantar eti! Ama beni madene almadılar! Ben de burada mantar aramaya geldim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820207
					],
					"speakerTitle": "He Amca"
				},
				{
					"id": 710820207,
					"content": "Uzun bir arayışın sonunda burada mantar olduğunu gördüm! Tam ben mantarlara uzanırken bu herif bir anda bana saldırdı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820208
					],
					"speakerTitle": "He Amca"
				},
				{
					"id": 710820208,
					"content": "#Hah! Herif mi? Guhua talim kampımıza dalan o! Ayrıca bu çiçekler kahraman {NICKNAME} ve bana ait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820209
					],
					"speakerTitle": "\"Tang Wuchou\" olduğunu iddia ediyor"
				},
				{
					"id": 710820209,
					"content": "Bir de kahraman Paimon'a!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820210,
					"content": "Evet. Kahraman Paimon'a! Üçümüz hariç kimse bu kutsal bölgeye dokunamaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820211
					],
					"speakerTitle": "\"Tang Wuchou\" olduğunu iddia ediyor"
				},
				{
					"id": 710820211,
					"content": "Aşağılık Hazine Avcısı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820212
					],
					"speakerTitle": "He Amca"
				},
				{
					"id": 710820212,
					"content": "Rezil bunak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820213
					],
					"speakerTitle": "\"Tang Wuchou\" olduğunu iddia ediyor"
				},
				{
					"id": 710820213,
					"content": "He Amca, Tang Wuchou Hazine Avcılığını bıraktı zaten. Ayrıca ektiği şeyler çiçek. Mantar değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820214,
					"content": "Ne? Öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820215
					],
					"speakerTitle": "He Amca"
				},
				{
					"id": 710820215,
					"content": "Yakından bak. Bunlar Qingxin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820216,
					"content": "Hımm. Bunlar gerçekten de Qingxin! Anlaşılan hâlâ tam kendime gelemedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820217
					],
					"speakerTitle": "He Amca"
				},
				{
					"id": 710820217,
					"content": "Peki sen hâlâ \"harika bir Parlak Zambak bahçesi\" yapmayı mı hayal ediyorsun Tang Wuchou?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820218,
					"content": "Çok güzel bir manzara olurdu, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820219
					],
					"speakerTitle": "\"Tang Wuchou\" olduğunu iddia ediyor"
				},
				{
					"id": 710820219,
					"content": "Ne derdiniz olursa olsun kavga etmeyi bırakın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710820220,
					"content": "*iç çeker* Mantar yokmuş. Görüşürüz o zaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710820221
					],
					"speakerTitle": "He Amca"
				},
				{
					"id": 710820221,
					"content": "Şu baş belası ihtiyar gittiğine göre sonunda biraz çiçek ekebilirim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Tang Wuchou\" olduğunu iddia ediyor"
				}
			]
		}
	]
}