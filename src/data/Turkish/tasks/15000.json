			"dialogs": [
				{
					"id": 150000101,
					"content": "Selam! Ben Huni. Yavru Sürüngenleri bulmama yardım etmeye mi geldiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000102
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000102,
					"content": "Ben de Toba. Siz beklediğimiz yardımcılar olmalısınız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000103
					],
					"speakerTitle": "Toba"
				},
				{
					"id": 150000103,
					"content": "Iıı... Sizinle tanıştığımıza memnun olduk! Ama biz buradan öylesine geçiyorduk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150000104,
					"content": "Sanka Amca bize yardım etsin diye arkadaşlarını göndereceğini söylemişti ama... Sizi demiş olmasın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000105
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000105,
					"content": "Maalesef Sanka diye birini tanımıyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150000106
					]
				},
				{
					"id": 150000106,
					"content": "Evet, kusura bakmayın... Ortada bir yanlış anlaşılma olmuş sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150000107,
					"content": "Yanlış anlaşılma mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000108
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000108,
					"content": "Of ya! Kandırıldık Huni! O gözlüklü adamın dolandırıcı olduğunu nasıl anlamadım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000109
					],
					"speakerTitle": "Toba"
				},
				{
					"id": 150000109,
					"content": "Yavru Sürüngenleri ne yapacağız şimdi? Vaktimiz azalıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000110
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000110,
					"content": "Sorun değil Huni, merak etme! Bize bir anlatın bakalım, ne olmuş yavru Sürüngenlere?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150000111,
					"content": "Kabilede son zamanlarda pek çok huzursuzluk yaşandı, babamın Sürüngeni de yaralandı... Adı Nanna, üç küçük yavrusu var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000112
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000112,
					"content": "Nanna'ya olanlardan sonra yavruları o kadar korktular ki kaçıp saklandılar. Aklım kaldı onlarda, ben de aramaya çıktım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000113
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000113,
					"content": "Nanna babanın Sürüngeniyse... Neden yavruları baban aramıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150000114,
					"content": "Babam kabilenin ileri gelenlerinden biri olduğu için Bedel Ateşi Gecesine hazırlanmakla meşgul. Bizim için çok önemli bir tören, yani bundan daha önemli en azından. Benim de burada olmamam gerekiyor aslında, ona söylemeden gizlice kaçtım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000115
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000115,
					"content": "Yavruları bulmam uzun sürmez diye düşündüm. Ama sonra karşılaştığımız bir adam bize bir sürü hikaye anlattırdı ve vaktimizi harcadı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000116
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000116,
					"content": "Evet, ne kadar bencil biri! Kalpsiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000117
					],
					"speakerTitle": "Toba"
				},
				{
					"id": 150000117,
					"content": "#Sorun yok, bozmayın moralinizi! Biz size yardımcı oluruz. Çok düşünceliyizdir, değil mi {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150000118,
					"content": "Öyleyiz gerçekten de. Yavru Sürüngenler yakında mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150000119
					]
				},
				{
					"id": 150000119,
					"content": "Yakında olmaları lazım! İzlerini bulmayı başardım, sanıyorum uçurumda saklanıyorlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000120
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000120,
					"content": "Paimon'la hallederiz. Çok sürmez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150000121
					]
				},
				{
					"id": 150000121,
					"content": "#Gerçekten mi? Vay be... Çok sağ olun {M#Bay}{F#Bayan} {NICKNAME} ve Bayan Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000122
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000122,
					"content": "Süpersiniz! Uçurumda dikkatli olun ama. Çok sarptır. Yetişkinler bile tırmanırken zorlanır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Toba"
				}
			]
		},
