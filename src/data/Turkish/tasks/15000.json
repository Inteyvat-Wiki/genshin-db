				]
			},
			"dialogs": [
				{
					"id": 150000401,
					"content": "Auu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000402
					],
					"speakerTitle": "Pocchi",
					"speakerSubtitle": "Yavru Yumkazor"
				},
				{
					"id": 150000402,
					"content": "Bulduk! Bir dakika, şu diğeri kim... Ajaw?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150000403,
					"content": "Bak sen şu baş belası ikiliye, hizmetkarımızın arkadaş çevresine nasıl da sızmışlar... Geçen karşılaşmamızdan beri hayranlığınız geçmedi mi? O yüzden mi bizi görür görmez aceleyle saygınızı sunmaya geldiniz? Sizi suçlayamayız tabii. Majestelerimiz hizmetkarlarımızı böyle büyülüyor ne de olsa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000404
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 150000404,
					"content": "Pekala! Siz kafirler bize başka seçenek bırakmadınız... Yüce Ejder Lordu K'uhul Ajaw sizinle görüşecek. Gelin. Diz çökün. Şimdi ayaklarımızı öpebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000405
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 150000405,
					"content": "Bir dakika ya, sen... Kinich'in yancısı değil misin? Ne saçmalayıp duruyorsun iki saattir? Son karşılaşmamızdan beri daha da sinir bozucu olmuşsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150000406,
					"content": "Sus! Kime \"yancı\" diyorsun sen? Üstün ejderiz biz! Ateş Ulusunun egemen hükümdarıyız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000407
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 150000407,
					"content": "Hatırlatmış olalım, geçen sefer Kinich sizin adınıza yalvarmasaydı tek kelime merhamet göremezdiniz bizden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000408
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 150000408,
					"content": "Bırak ya! Büyük konuşuyorsun ama Kinich seni hapsetmiş işte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000409,
						150000411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150000409,
					"content": "Ey yüce hükümdar, sizi bu dağ zirvesine getiren nedir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150000410
					]
				},
				{
					"id": 150000410,
					"content": "Hıh. Bak böyle ol işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000413
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 150000413,
					"content": "Yine de söylemiş olayım, alçak gönüllü hizmetkarımız Huitztlan yakınlarında yaşanan bir Hiçlik olayını araştırmamız için yalvardı. Biz de talebini kabul ettik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000414
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 150000414,
					"content": "Hiçlik olayı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150000415,
					"content": "Bakın, bu küçük kertenkeleyi görüyor musunuz? Orta boyutlu bir kertenkele olan annesi, Hiçlik gücünün etkisine girdi. Zihni bulandığı için önce hizmetkarımın kabilesine, sonra kendi soyuna saldırdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000416
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 150000416,
					"content": "Eyvah... Şimdi durumu nasıl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150000417,
					"content": "Hiçliğin gücüne karşı savaşmaya çalışan küçük bir böcekti. Dolayısıyla Gece Krallığı yolcusu oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000418
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 150000418,
					"content": "Zayıf bir canlıydı... Mücadelesine uçurumdan atlayarak son vermiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000419
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 150000419,
					"content": "Uçurumdan atlayarak mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150000420,
					"content": "Sevgili Solgun Kanatlı Karıncam, kafanda sorular dönüyor görüyorum fakat lütfen onları kendine sakla. Yüzündeki tuhaf ifadeyi de sil. Biz Yüce Ejder Lordu K'uhul Ajaw'ız, dilek çeşmesi değiliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000421
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 150000421,
					"content": "Solgun Kanatlı Karınca mı? Sen var ya... Bekle sen, bu çirkin lakap oyunu iki kişi de oynanabilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150000422,
					"content": "Hım, hafif bir Hiçlik enerjisi seziyoruz... Yakında dolanan kötü bir büyücü olmalı fakat iyi saklanmış. Şüpheli yabancılarla karşılaşırsanız onları etraflıca sorguya çekin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000423
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 150000423,
					"content": "Şüpheli yabancılar mı? Bir dakika, bizimle dalga mı geçiyorsun sen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150000424,
					"content": "Peh! Hükümdarına karşı ne cüretle bu ithamlarda bulunuyorsun, hadsiz! Yat kalk hizmetkarımızın berbat arkadaş seçimine dua et! Aksi halde yüzünü mosmor ederdik! Morluğu geçince bir daha morartırdık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000425
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 150000425,
					"content": "Ayaklarımı öpmeye gelmediyseniz yıkılın karşımdan! Yüce Ejder Lordu K'uhul Ajaw'ın işine mani olmayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 150000411,
					"content": "Ee ufaklık, ne işin var burada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150000412
					]
				},
				{
					"id": 150000412,
					"content": "\"Yüce hükümdar\" diyeceksin! Yüce Ejder Lordu K'uhul Ajaw'ın öfkesini üzerinize mi çekmek istiyorsunuz? Bu hakaretinizden dolayı Bedel Ateşinde bin yıl yanacaksınız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000413
					],
					"speakerTitle": "Ajaw"
				}
			]
		},
		{
			"id": 1500005,
			"completionStepIds": [
				1500007
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
