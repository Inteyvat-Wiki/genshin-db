					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huni",
					"Toba"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2373.144,
							259.097,
							8480.769
						],
						"pointId": 9113
					},
					{
						"sceneId": 3,
						"position": [
							-2375.592,
							259.064,
							8479.979
						],
						"pointId": 9114
					},
					{
						"sceneId": 3,
						"position": [
							-2374.284,
							259.103,
							8478.566
						],
						"pointId": 9115
					},
					{
						"sceneId": 3,
						"position": [
							-2374.395,
							259.072,
							8482.007
						],
						"pointId": 9116
					}
				]
			},
			"dialogs": [
				{
					"id": 150000501,
					"content": "Aa, döndünüz mü? Ne çabuk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000502
					],
					"speakerTitle": "Toba"
				},
				{
					"id": 150000502,
					"content": "Yavruların sağ salim dönmesine çok sevindim. İkinize de çok teşekkür ederiz! Nihayet içimiz rahat şekilde eve dönebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000503
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000503,
					"content": "Rica ederiz! Lafı bile olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150000504,
					"content": "Natlan'dan değilsiniz sanırım, değil mi? Kıyafetleriniz bizimkilerden farklı çünkü. Bu arada o kadar tırmanıştan sonra yorulmuşsunuzdur herhalde. İsterseniz gelin evimde biraz dinlenin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000505
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000505,
					"content": "Evet, lütfen gelin! Söz veriyorum Gök Kubbenin Evlatları sizi çok güzel karşılar! Misafir ağırlamayı severiz biz, siz de çok iyi kalplisiniz zaten. Hiç o gözlüklü adam gibi değilsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000506
					],
					"speakerTitle": "Toba"
				},
				{
					"id": 150000506,
					"content": "Galiba \"gözlüklü adam\" da Natlanlı değildi, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150000507,
					"content": "Evet. Yani kıyafetleri kesin değildi de... Aslında şimdi düşününce gerçekten şüpheli bir havası vardı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000508
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000508,
					"content": "Gerçekten mi? Belki Ajaw'ın bahsettiği şüpheli yabancı odur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150000509,
					"content": "Bize ondan biraz daha bahsedebilir misiniz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150000510
					]
				},
				{
					"id": 150000510,
					"content": "Tabii, madem merak ediyorsunuz. Düşüneyim, ne konuşmuştuk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000511
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000511,
					"content": "Lütfen beyefendi, size kaç hikaye anlattım... Yavru Sürüngenleri bulmama ne zaman yardım edeceksiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000512
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000512,
					"content": "Son bir hikaye daha. Bu son bak, yemin ederim. Şu ateş topunu bir kez daha anlatır mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000513
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 150000513,
					"content": "Sürekli yanan kocaman, şeffaf bir ateş topu varmış diye duydum... Beş yüz yıl önceymiş galiba? Bin yıl mı yoksa? Belki daha da eskidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000514
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 150000514,
					"content": "Ha, Bedel Ateşini diyorsunuz! \"Mal{RUBY#[D]Bedel Ateşi}ipo\" kadim adı oradan geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000515
					],
					"speakerTitle": "Toba"
				},
				{
					"id": 150000515,
					"content": "Vay be, bir kadim adın kökeni oradan geliyor demek! Çok etkileyici!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000516
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 150000516,
					"content": "Evet! Her kadim adın arkasında bir hikaye yatar. Efsaneye göre Bedel Ateşi ilk kez Büyük Birlik döneminde ortaya çıkmış. Och-Kan tarafından Natlan'ı yönetmek ve ona karşı çıkan herkesi bastırmak için kullanılmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000517
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000517,
					"content": "Bedel Ateşi normal ateşten farklıdır. Onunla yanarsan arkanda korkunç bir yanma acısı hissedersin fakat hemen ölmezsin. Ne yaparsan yap asla arkanı dönüp ona bakmamalısın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000518
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000518,
					"content": "Neden ki? Dönersen ne oluyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000519
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 150000519,
					"content": "Döndüğün an puf! Yanıp kül oluyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000520
					],
					"speakerTitle": "Toba"
				},
				{
					"id": 150000520,
					"content": "Eyvah eyvah... Birinin kıyafetini ucundan tutuşturmayı anlarım ama insanları diri diri yakmak... Hiç bana göre değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000521
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 150000521,
					"content": "Değil mi? Birini arkadan yakıp dönmesine izin vermemek ne kadar zalimce bir şey. Och-Kan gerçekten kötü kalpli bir despotmuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000522
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000522,
					"content": "Evet, şok oldum... Tahmin edeyim, günün birinde yiğit bir kahraman çıkıp günü kurtarmış mı? Bu tarz hikayelerde öyle olur genelde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000523
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 150000523,
					"content": "Doğru tahmin ettin Gözlüklü Amca! Bu işlerden anlıyorsun gerçekten. Kahramanın adı Yupanqui. Kendisi kabilemizin atasıdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000524
					],
					"speakerTitle": "Toba"
				},
				{
					"id": 150000524,
					"content": "Evet. Yupanqui hem despot Och-Kan hem de ilk Ateş Hükümdarı Xbalanque ile arkadaşmış. O zamanlar Büyük Birlik'te teçhizat subayıymış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000525
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000525,
					"content": "Och-Kan'ın zulmünden hiç hoşlanmazmış. O yüzden Bedel Ateşini çalıp Och-Kan'ın ordusuna fırlatmış. Askerler kendini Bedel Ateşine karşı savunamadığı için hepsi yanıp kül olmuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000526
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000526,
					"content": "Böylece atamız halkımıza özgürlüğünü kazandırmış. Fakat tam şehirden ayrılacakken Och-Kan'ın arkadan ona seslendiğini sanmış. Bir anlık dikkatsizlikle arkasını dönüp bakmış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000527
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000527,
					"content": "Ama arkasında Och-Kan yokmuş. Yalnızca kül olmuş bir şehir, harap olmuş bir ordu ve göklere yükselen alevler varmış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000528
					],
					"speakerTitle": "Toba"
				},
				{
					"id": 150000528,
					"content": "Hemen sonra da gördüğü o alevler gözlerinin içinden fışkırmış ve onu yutmuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000529
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000529,
					"content": "Tek bir bakışta olmuş hepsi! Arkasını döndüğü an yanıp kül olmuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000530
					],
					"speakerTitle": "Toba"
				},
				{
					"id": 150000530,
					"content": "Peki acaba bu, Bedel Ateşini çalmasının bedeli miymiş? Yoksa arkasını dönmesinin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000531
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 150000531,
					"content": "Cevabı kimse bilmiyor. Ama Yupanqui'yi yutan alev hiç görülmediği kadar şiddetli yanmış. Yüz gün boyunca sönmemiş, en son ley hatlarında delik açmış!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000532
					],
					"speakerTitle": "Toba"
				},
				{
					"id": 150000532,
					"content": "Sonra fısss! Ateş, Gece Krallığı'nın ölümcül karanlığına düşmüş. Bugüne dahi orada yanmaya devam ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000533
					],
					"speakerTitle": "Toba"
				},
				{
					"id": 150000533,
					"content": "Büyüklerimiz bugün o ateşin sonraki yaşama giden yolu aydınlattığını söylüyor. Fakat ölenlerin yeniden doğabilmesi için alevleri kabul etmesi ve önce ateş tarafından arındırılması gerekiyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000534
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000534,
					"content": "Hayatına son bir bakış gibi, yaptığın her şeyin hesabını vermen gerekiyormuş... Neyse işte, Yupanqui'nin Bedel Ateşi hikayesi böyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000535
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000535,
					"content": "Ah... Çok iyi bir hikayeymiş gerçekten! Peki doğru mu bu? Gece Krallığı'nda bu ateşi bulmak mümkün mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000536
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 150000536,
					"content": "Bilmem ki... Bence sadece hikayeden ibaret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000537
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000537,
					"content": "Bu bahsettiğin ad kabilende nesiller boyunca aktarıldı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000538
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 150000538,
					"content": "Tabii! Bedel Ateşi Gecesinde kutladığımız kahraman Burkina'ya geçti. Ama o beş yüz yıl önceydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000539
					],
					"speakerTitle": "Toba"
				},
				{
					"id": 150000539,
					"content": "Evet, şimdi de Kinich'e ait... O yüzden ona genelde \"Mal{RUBY#[D]Bedel Ateşi}ipo\" Kinich deriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000540
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000540,
					"content": "Kinich demek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000541
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 150000541,
					"content": "Hadi Gözlüklü Amca, bu kadar hikaye yeter! Artık gidip yavru Sürüngenleri bulur musun? Söz vermiştin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000542
					],
					"speakerTitle": "Toba"
				},
				{
					"id": 150000542,
					"content": "Iıı... Bulurum ama Bedel Ateşi efsanesi bize arkamıza bakmamamız gerektiğini anlatmıyor mu? Geçmişi eşelemeyelim boşuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000543
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 150000543,
					"content": "Şu Kinich'i anlatsanıza bana. Son hikaye olsun bu, yemin ederim. Şu andan itibaren... Son bir hikaye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000544
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 150000544,
					"content": "Hayır mı? Dikkat et Toba, bana her an küfredecekmişsin gibi bakıyorsun. Cık cık, sakın ha. Yalnızca büyükler küfredebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000545
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 150000545,
					"content": "Amca... Umarım bizi kandırmaya çalışmıyorsundur... Yoksa öldüğünde Bedel Ateşi seni yutar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000546
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000546,
					"content": "Natlanlı değilsem nasıl yutacak ki beni? Gözlüklü Amca'nız sizin gibi buralı değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000547
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 150000547,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000548
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000548,
					"content": "Bir dakika... Şu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000549
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 150000549,
					"content": "... Pekala çocuklar, ben sözümün eriyim. İki arkadaşımı çağırdım, yoldalar şimdi, ıı... Evet. Benim adıma yardım edecekler size.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000550
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 150000550,
					"content": "Köpek gibi çalıştırın onları, tamam mı? İşleri o sonuçta. Çekinmeyin hiç.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000551
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 150000551,
					"content": "Gerçekten mi? Peki bize ismini söyler misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000552
					],
					"speakerTitle": "Toba"
				},
				{
					"id": 150000552,
					"content": "Bu uçurumun eteklerinde karşılaştık sizinle... Tepelerin altında... O yüzden \"Sanka\" diyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000553
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 150000553,
					"content": "Ciddi misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000554
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000554,
					"content": "Bana inanmıyorsanız dönün kendiniz bakın. Tam arkanızdalar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000555
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 150000555,
					"content": "Hı? Neredeler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000556
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000556,
					"content": "Bir dakika... Nereye gittin Sanka Amca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000557
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000557,
					"content": "Evet, hakikaten de şüpheli biriymiş... Kadim adlar hakkında bilgi edinmeye çalışıyormuş sanki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000558
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150000558,
					"content": "Aynen! Yetmezmiş gibi bize ihanet etti! Bedelini ödeyecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000559
					],
					"speakerTitle": "Toba"
				},
				{
					"id": 150000559,
					"content": "Gerçi alt tarafı birkaç hikaye dinledi bizden. En kötü ne olabilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000560
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000560,
					"content": "#Hımm... {NICKNAME}, gidip Kinich'e anlatsak mı bunları? Ajaw durumu araştırdığını söyledi ama sağı solu belli olmuyor onun. Sözüne güvenmeyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000561
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150000561,
					"content": "Hı? Kinich'i tanıyor musunuz siz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000562
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000562,
					"content": "Yakından tanımıyoruz. Ama kendisiyle daha önce karşılaşmışlığımız var, bir keresinde de beraber yemek yemiştik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000563
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150000563,
					"content": "Of ya, çok kıskandım! Ben onunla hiç konuşamadım bile. Çok havalı biri! Hem Sürüngen avcısı hem de süper bir kadim adı var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000564
					],
					"speakerTitle": "Toba"
				},
				{
					"id": 150000564,
					"content": "Ben de konuşamadım hiç! Ama babam onu pek sevmiyor galiba... Ondan uzak durmamı söylüyor hep. Sürekli yanında gezdirdiği o garip ufaklık yüzünden kesin. Ne sinir biri. Burnu havada sürekli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000565
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000565,
					"content": "Ha, kendine K'uhul Ajaw diyen şu tipten bahsediyorsun! Evet, biz de onunla tanıştık... İnsanların sinirleriyle oynamayı çok seviyor gerçekten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000566
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150000566,
					"content": "Aynen! Kinich niye onunla ortak oldu anlamıyorum. Niye beni seçmedi mesela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000567
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000567,
					"content": "Eyvah! Huni, saat geç olmuş! Çok uzun zamandır dışarıdayız... Hemen eve dönmezsek fırça yiyeceğiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000568
					],
					"speakerTitle": "Toba"
				},
				{
					"id": 150000568,
					"content": "Of, haklısın. Tamam o zaman... Bu yol bizim köye gidiyor. Ziyaret etmek isterseniz evime bekliyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000569
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000569,
					"content": "Bir şeye ihtiyacınız olursa babam size yardım edebilir. Umarım yakında tekrar görüşürüz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000570
					],
					"speakerTitle": "Huni"
				},
				{
					"id": 150000570,
					"content": "Biz kaçtık! Hoşça kalın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Toba"
				}
			]
		},
