			"dialogs": [
				{
					"id": 741430501,
					"content": "Lanoire! Lanoire, iyi misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430502
					],
					"speakerTitle": "Earnshaw"
				},
				{
					"id": 741430502,
					"content": "Dede! Ben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430503
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430503,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741430504,
					"content": "#Ahh, içim çok rahatladı. Teşekkür ederim {NICKNAME}, Paimon. Siz olmasanız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430505,
						741430506
					],
					"speakerTitle": "Earnshaw"
				},
				{
					"id": 741430505,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741430507
					]
				},
				{
					"id": 741430507,
					"content": "İyi ama... Şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741430508,
					"content": "Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741430509
					]
				},
				{
					"id": 741430509,
					"content": "Şey... Doğru, evet! Paimon iyi olmana çok sevindi Lanoire! İçimiz rahatladı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741430510,
					"content": "#Teşekkürler dede. Size de teşekkürler {M#Bay}{F#Bayan} {NICKNAME}, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430511
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430511,
					"content": "Bir daha öyle kaçıp gitme sakın! Yüreğime iniyordu az daha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430512
					],
					"speakerTitle": "Earnshaw"
				},
				{
					"id": 741430512,
					"content": "Size de o kadar zahmet verdik, kusura bakmayın gerçekten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430513
					],
					"speakerTitle": "Earnshaw"
				},
				{
					"id": 741430513,
					"content": "Sorun değil, o iyi olsun da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430514
					],
					"speakerTitle": "Charlene"
				},
				{
					"id": 741430514,
					"content": "(Gerçekten iyi misin Lanoire?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741430515,
					"content": "#(Tırtıl'ın ne demek istediğini şimdi anladım {M#Bay}{F#Bayan} {NICKNAME}. Dedeme neden bir şey söylemediğinizi de tabii.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430516
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430516,
					"content": "(Ben de dedeme bir şey söylemeyeceğim. Onu üzmeyip uslu bir kız olacağım.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430517
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430517,
					"content": "(Sen çok akıllı bir kızsın Lanoire.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741430518,
					"content": "(...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430519
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430519,
					"content": "(Hayır, değilim. Tırtıl'ın en son ne demek istediğini, bana neden teşekkür ettiğini anlamadım. Onca zamandır bana yardım eden oydu sonuçta.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430520
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430520,
					"content": "(Biraz daha büyüyünce onu bulup nedenini soracağım. Sonra da ona bir sürü şey anlatıp lezzetli bir doğum günü pastası yapacağım.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430521
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430521,
					"content": "#({M#Bay}{F#Bayan} {NICKNAME}, Bayan Paimon. Ben büyüyünce gidip Tırtıl'ı bulabilir miyiz acaba?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430522,
						741430523
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430522,
					"content": "Onu büyüyünce konuşuruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741430524
					]
				},
				{
					"id": 741430524,
					"content": "Tamam, anlaştık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430525
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430525,
					"content": "Oradan ayrılırlar.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 741430523,
					"content": "Olur...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741430524
					]
				},
				{
