			"dialogs": [
				{
					"id": 741430201,
					"content": "Çocuklar! Siz... Ben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430202
					],
					"speakerTitle": "Earnshaw"
				},
				{
					"id": 741430202,
					"content": "Earnshaw, ne oldu böyle? Nefes nefese kalmışsın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741430203,
					"content": "Lanoire... O dağ yabanisi gelip Lanoire'ı kaçırdı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430204
					],
					"speakerTitle": "Earnshaw"
				},
				{
					"id": 741430204,
					"content": "Ne? Eyvah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741430205,
					"content": "Oraya doğru gitti! Gidip yardım getireceğim. Siz de peşlerinden gidin lütfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430206
					],
					"speakerTitle": "Earnshaw"
				},
				{
					"id": 741430206,
					"content": "Tamam! Acele edelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
