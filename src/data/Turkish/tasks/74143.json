				]
			},
			"dialogs": [
				{
					"id": 741430401,
					"content": "Hah, siz mi geldiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430402
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741430402,
					"content": "Demek senmişsin Tırtıl! Paimon'un yüreği ağzına geldi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741430403,
					"content": "#Aaa! {M#Bay}{F#Bayan} {NICKNAME} ve Bayan Paimon! Sevdiğim herkes burada! Keyfime diyecek yok artık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430404
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430404,
					"content": "Dedem de bana koskocaman bir doğum günü pastası hazırlamış!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430405
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430405,
					"content": "Bugün doğum günün müydü? İyi ki doğdun! Şey... Pastadan kaldı mı bari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741430406,
					"content": "Sorma... Hepsi çoktan bitti bile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430407
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430407,
					"content": "Ne? Ciddi misin? Tüh ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741430408,
					"content": "Tırtıl...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741430409
					]
				},
				{
					"id": 741430409,
					"content": "Sen iyi misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741430410
					]
				},
				{
					"id": 741430410,
					"content": "Merak edecek bir şey yok. Böyle güzel bir günde can sıkıcı konulara girmeyelim şimdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430411
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741430411,
					"content": "#Neyse, tekrar teşekkür ederim {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430412
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741430412,
					"content": "Ne için teşekkür ediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741430413,
					"content": "Haha, öylesine işte. Bizim Çocuk Takımı toplanmayalı çok, çok uzun zaman geçmiş gibi hissediyorum da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430414
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741430414,
					"content": "Peki ama beni neden buraya getirdin Tırtıl? Bir tuhaf davranıyorsun doğrusu. Seni görünce dedemin aklı çıkmış... Hatta Kahraman, Prens ve Prenses'in bile ödü kopmuş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430415
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430415,
					"content": "Dedeme ne zaman senden bahsetsem ziyaretimize gelsin de misafir edelim diyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430416
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430416,
					"content": "Eh, üstüne başına bakınca tabii... Neden geçen sefer yaptığın gibi insan kılığına girmedin ki Tırtıl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741430417,
					"content": "İstemediğimden değil ki. Şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430418
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741430418,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741430419,
					"content": "Ne varmış ki üstünde başında? O bu haliyle de güzel. Az önce omzunda otururken kolayca Bulle Meyvelerine uzanabildim. Hem rüzgar gibi hızlı da koşuyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430420
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430420,
					"content": "Şimdi diyeceklerimi aklından çıkarma Lanoire. Bana benzeyen birini görürsen sakın yaklaşma. Bir an önce oradan uzaklaşmaya bak. Öyle kişilere güven olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430421
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741430421,
					"content": "Öyle mi? İyi de sen kötü biri değilsin ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430422
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430422,
					"content": "Bana söz ver Lanoire.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430423
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741430423,
					"content": "Başta Tırtıl'ın yaptığı \"numaralarla\" Lanoire'ı kandırmaya çalışacağını düşünüyorsun.\\nNe var ki Tırtıl böyle bir şey yapmaz, pür dikkat Lanoire'ın ağzından çıkacak cevabı bekler.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741430424
					]
				},
				{
					"id": 741430424,
					"content": "Ama... Tamam. Söz veriyorum Tırtıl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430425
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430425,
					"content": "Peki dediğini yaparsam seni gördüğümde nasıl tanıyacağım ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430426
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430426,
					"content": "Hah bu arada, biliyor musun Tırtıl? Meropide Kalesi'nden çıkana kadar dünyanın ne kadar büyük bir yer olduğunu fark etmemişim ben. Her gün başka bir yöne yürüyorum ama hâlâ karşıma duvar falan çıkmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430427
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430427,
					"content": "Güneş açtığında sıcak oluyor, gece olup güneş battı mı hava soğuyuveriyor. Gece bastırınca göle doğru hafif bir meltem esiyor, biraz üşütüyor beni. Pervanelere hiç ama hiç benzemiyor. Neden öyle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430428
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430428,
					"content": "Kahraman da yanımızda uzanırken hep dedemle bana bakıyor. Uyurken bazen arka ayaklarıyla bir şeyleri tekmeliyor. O kadar komik ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430429
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430429,
					"content": "Sonra... Sonra çıplak ayakla çimlerde yürüdüğüm zaman otların sivri uçları parmaklarımın arasını gıdıklıyor, hatta biraz batıyor gibi. Çimlerin kitaplarda anlatıldığı gibi yumuşak olduğunu sanırdım halbuki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430430
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430430,
					"content": "Bir de Estienne'in bana verdiği çiçekler vardı ya? Dışarıda onlardan bir sürü gördüm. Tabii o çiçeklerin toprağın içine uzanan sağlam kökleri var. Bu neden oluyor peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430431
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430431,
					"content": "Bu dünya çok büyük ve acayip bir yermiş. Işığın bile binbir çeşit rengi var. Sana anlatmak istediğim ve senden dinlemek istediğim öyle çok şey var ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430432
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430432,
					"content": "Peki seni nasıl bulacağım ben? Off, kendimi o küçük balığı bulmayı çok isteyen büyücü çırağı gibi hissediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430433
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430433,
					"content": "O hikayeyi hâlâ hatırlıyorsun demek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430434
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741430434,
					"content": "Hiç unutur muyum? Geri dönmeni ve hikayenin sonunu anlatmanı bekliyordum! Sonunda çırak küçük balığı bulabildi mi bari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430435
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430435,
					"content": "Anlatayım. Yıllar, yıllar sonra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430436
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741430436,
					"content": "Budala çırak sonunda harika büyücüye veda edebilme cesaretini göstermiş ve atölyeden ayrılmış. Sonra da küçük balığı bulmak için yola koyulmuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430437
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741430437,
					"content": "Tabii daha önce hiç büyük bir okyanus görmemiş ki, balığın nasıl bir yerde yaşadığını nereden bilsin... Bu yüzden giderken birilerine yolu sorması gerekmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430438
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741430438,
					"content": "Bu yüzden nehir kenarındaki sazlığa gidip sormuş. Hikayesini dinleyen sazlık gülmekten çatlamış, iki büklüm olmuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430439
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741430439,
					"content": "\"Okyanusu arıyorsun demek,\" demiş sazlık. \"Nehirlerden çok daha geniş ve büyük bir yerdir orası. Tüm nehirler de oraya akar zaten.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430440
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741430440,
					"content": "Böylece akan nehri takip eden çırak, sonunda büyük okyanusa ulaşmış. Gel gör ki okyanus öyle büyükmüş ki çırak nereden başlasa bilememiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430441
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741430441,
					"content": "Bu yüzden gidip iskelede dinlenen Mor Altın Balıkçı Martıya sormuş. Hikayesini duyunca hayret eden martı da gagasında tuttuğu kızarmış patatesleri yere düşürüvermiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430442
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741430442,
					"content": "\"Boşa kürek çekiyorsun dostum,\" demiş martı. \"Koca okyanusta sıradan, küçük bir balığı bulmaya çalışmak akıl karı değil, hayatımda HİÇ senin gibisini görmemiştim. Hem kim bilir, belki de çoktan...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430443
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741430443,
					"content": "Martıyla onun şamatacı arkadaşlarından gına gelen çırak, ağzına ekmek tıkayıp martıyı susturmuş. Sonra da kıyıda dolaşarak sorular sormaya ve balığı aramaya devam etmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430444
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741430444,
					"content": "Çırak budalanın teki olduğu için doğru dürüst aramayı da bilmiyormuş ki... Nasıl dalacağını deneye deneye anlamaya çalışırken her seferinde okyanusta daha da açılmış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430445
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741430445,
					"content": "Sonunda onu bulmuştur kesin! Gerçekten çok istersen ve asla pes etmezsen dileklerin sonunda gerçek olurmuş! Dedem hep öyle derdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430446
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430446,
					"content": "Mutlu sonla biten hikayeleri seviyorsun sen... Eh, Earnshaw Dede doğru demiş. Yaptığı onca budalalığa rağmen çırak, o küçük balığı bulabilmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430447
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741430447,
					"content": "Onu bulduğunda küçük balık, özgürce dolaşan bir balık sürüsünün ortasında ailesiyle birlikte yüzüyormuş. Çırak, birbirine benzeyen onca balığın arasında onu gördüğü gibi tanımış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430448
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741430448,
					"content": "\"Sonunda seni buldum...\" Çırağın dileği nihayet gerçek olmuş ama hayal ettiği kadar sevinememiş nedense. Aksine biraz şaşkın hissediyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430449
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741430449,
					"content": "Balık sürüsü etrafına toplanıp bütün hikayeyi anlatmasını bekliyormuş. Pek beceremese de çırak onlara her şeyi bir bir anlatmış. Lafını bitirince de büyük bir yükten kurtulmuş gibi vermiş nefesini, ağzından bir sürü baloncuk yükselmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430450
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741430450,
					"content": "\"Sana iki özür borcum var,\" demiş çırak. \"İlki bir zamanlar yardım istediğinde sana yardım edecek cesareti gösteremediğim için. Diğeri de pat diye ziyaretine geldiğim için...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430451
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741430451,
					"content": "\"Sonunda seni görünce farkına vardım bencilliğimin... Bizzat gelip senden özür dilersem geçmişte olduğum kişiyi affedebilirim sandım.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430452
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741430452,
					"content": "\"Ne önemi var ki?\" Küçük balığın yanıtı karşısında çırak hayrete düşmüş. \"Eskiden bana yardım edemedin ama ben eninde sonunda evime, ailemin kollarına geri döndüm.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430453
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741430453,
					"content": "\"Başıma kötü bir şey de gelmedi. O yüzden af dileyecek bir şey de yok.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430454
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741430454,
					"content": "\"Bu kadar fuzuli bir mesele için epey zaman ve emek harcamışsın. Buna dürüstlük mü denir, yoksa budalalık mı bilemedim. Eh, budalanın teki de olsan bizim için hava hoş gerçi. Biz budalaları da dost biliriz...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430455
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741430455,
					"content": "Aa! Sonunda dost mu oldular yani? Sonra ne oldu peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430456
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430456,
					"content": "Ne mi oldu? Çok yakın arkadaş oldular tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430457
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741430457,
					"content": "Ne? Bu kadar mı yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430458
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741430458,
					"content": "Hikaye böyle mi bitiyor Tırtıl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430459
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430459,
					"content": "Aynen öyle, hikayenin sonu bu. Güzel hikayeleri tadında bırakmak lazım, yoksa eğlencesi kaçar. Sonra bir bakmışsın, kahramanlar kötü ejderhalara dönüşüvermiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430460
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741430460,
					"content": "Bitmek bilmeyen ne çok hikaye duydum, bir bilseniz. Hepsi de korkunç sonlandı, hikayelerde geçen herkes hayal kırıklığına uğradı. Kötü hikayelerdi bunlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430461
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741430461,
					"content": "Tabii senin maceralarını anlatan hikaye hâlâ devam ediyor sevgili Lanoire. İyi ki doğdun. Bir gün sen de bana kendi hikayeni anlatacaksın, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430462
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741430462,
					"content": "Hı hı... Söz veriyorum, anlatacağım Tırtıl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430463
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430463,
					"content": "Seni bulunca bir sürü hikaye anlatacağım! Sonra da senin için büyük mü büyük, lezzetli mi lezzetli bir doğum günü pastası hazırlayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430464
					],
					"speakerTitle": "Lanoire"
				},
				{
					"id": 741430464,
					"content": "Haha, pasta olmasa da olur. Doğum günümü bilmiyorum zaten, gözümü açtığım günü biliyorum sadece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741430465
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741430465,
					"content": "Teşekkür ederim Lanoire. Çünkü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tırtıl"
				}
			]
		},
