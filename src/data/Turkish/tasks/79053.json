			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Idyia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790531401,
					"content": "Ah, siz ikiniz. Ne oldu? Bir şey soracak gibi duruyorsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531402
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531402,
					"content": "Veluriyam Serabı hakkında cevaplar arıyorsanız eğer, doğru kişiye geldiniz. Veluriyam Serabı'nı avucumun içi gibi bilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531403,
						790531405
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531403,
					"content": "Avucunun... İçine ne oldu ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531404
					]
				},
				{
					"id": 790531404,
					"content": "Mecazi anlamda dedim! Elimde avucumda herhangi bir sorun yok, hiç olmadı da!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531407
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531407,
					"content": "Her neyse, Paimon seni durumdan haberdar etsin! Lunaparkta bu mektubu bulduk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790531408,
					"content": "Idyia, bunun nereden geldiğini sen kesin biliyorsundur, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790531409,
					"content": "Tabii ki, bu mektup şeyden gelmiş... Bu da ne? Böyle bir mektubu ilk defa görüyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531410
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531410,
					"content": "Avucundaki izler artık pek net görünmüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790531411,
					"content": "B-Ben farkında olmadan birileri gömmüş olmalı. İlk defa görüyor olmam gayet normal yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531412
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531412,
					"content": "Ayrıca içeriğine bakılırsa, bir mektuptan daha çok bir vasiyetnameye ve günlüğe benziyor. Ama yazan kim? Bu yazım tarzı oldukça tanıdık geliyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531413
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531413,
					"content": "Shinrou Kutusu ile ilgili olabilir mi acaba?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531414
					]
				},
				{
					"id": 790531414,
					"content": "Ah! Şimdi sen söyleyince hatırladım, haklısın. Shinrou Kutusunu getiren yaşlı adamdan kalma bu... Ben şişenin içine girmeden kısa süre önce olan bir şeydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531415
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531415,
					"content": "Yaşlı adam Inazumalıydı. Buraya geldikten sonra sorduğu ilk soru, bu Zindanın dileklerini yerine getirip getiremeyeceğiydi. Geçmişteki bir savaş alanına dönmek istiyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531416
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531416,
					"content": "Ona açıklamaya çalıştım ama... Geldiğinde bedeni berbat haldeydi ve yorucu bir yolculuktan sonra beyni de sınırlarını zorluyordu belli ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531417
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531417,
					"content": "\"Yalvarırım beni o güne geri gönder\" veya \"beni o savaşa geri gönder\" deyip duruyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531418
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531418,
					"content": "Ben de şişenin serabını kullanarak onun zihnindeki savaş alanını yeniden yarattım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531419
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531419,
					"content": "Ah! O zaman mektubundaki \"nihayet dönüyorum\" dediği kısım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790531420,
					"content": "Sersemlemiş bir halde uyandığında muhtemelen etrafındaki serap, çoktan hafızasındaki savaş alanının görüntüsüne bürünmüştü. Savaş alanı çok korkunç olmasına rağmen yüzünde kocaman bir gülümseme vardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531421
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531421,
					"content": "Neden birisi son anlarında böyle korkunç bir şey görmek ister ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531422,
						790531423
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531422,
					"content": "Belki de onun için özel bir anlamı vardır...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531424
					]
				},
				{
					"id": 790531424,
					"content": "Bilmiyorum ama sonuçta oldukça mutlu görünüyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531425
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531425,
					"content": "Öyle bir yerde gerçekleştirmek istediği bir dileği varsa bu yükü taşıyarak geçirdiği yıllar çok zorlu zamanlar olsa gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531426
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531426,
					"content": "Ana Merkezi yeniden başlatmada Shinrou Kutusunun çok yardımı dokundu. Bay Hideie'ye bir teşekkür borçluyum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531423,
					"content": "Belki de öyle daha heyecanlı oluyordur...",
