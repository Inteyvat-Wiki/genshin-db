	"talks": [
		{
			"id": 7905301,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7905301",
							"2"
						],
						"stepId": 7905301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Idyia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790530101,
					"content": "\"Veluriyam Serabı'na hoş geldiniz. Umarım yorucu yolculuğunuzdan sonra burada biraz rahatlayıp dinlenebilirsiniz.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530102
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790530102,
					"content": "Her şey tepetaklak olmasaydı sizi böyle karşılardım... *iç çeker* Bu kadar çok olay yaşadığımıza hâlâ inanamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530103
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790530103,
					"content": "Artık her şey düzeldiğine göre... Geç olsun güç olmasın diyebiliriz, değil mi? Tam bir profesyonel gibi konuşmadım mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530104,
						790530109,
						790530114,
						790530117
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790530104,
					"content": "Ön Baskılar hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790530105
					]
				},
				{
					"id": 790530105,
					"content": "Ah... Temel teoriyi açıklamamı ister misin? Aslında ben de pek anlamıyorum ama kısaca, Ön Baskı bir fikir gibidir denilebilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530106
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790530106,
					"content": "Bunu, bir bitkinin nasıl büyüyeceğinin daha tohum halindeyken yazılmış olması veya bir kuşun daha yumurtadayken kanatlarını nasıl açacağının kodlanması gibi düşünebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530107
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790530107,
					"content": "Her şey, kendisine işlenmiş bu içgüdüleri ve kuralları takip ederek etrafımızda gördüklerimize dönüşür. Belki de her bir şeyin taslağı daha en başta oluşturulmuştur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530108
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790530108,
					"content": "Ön Baskılar da tıpkı o taslaklar gibidir ve şişeden yansıyan ışık onları Veluriyam Serabı'na dönüştürür. Ah, ancak bu tür bir sihir sadece şişenin kendi sınırları içerisinde işe yarar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790530109,
					"content": "Okeanidler hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790530110
					]
				},
				{
					"id": 790530110,
					"content": "Ah, Fontaine'den neden kaçtığımızı mı merak ediyorsun? Sanki üzerinden bir ömür geçmiş gibi geliyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530111
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790530111,
					"content": "Kaçmamızın sebebi ise... \"Su\" yüzündendi. Fontaine'in suları değişti ve Okeanidler için oradaki sular şimdi... Acılarla ve nefretle dolu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530112
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790530112,
					"content": "Bizim açımızdan bakıldığında, eğer yaşamak istiyorsak kaçmak en iyi çözümdü. Ah, işte o zaman yolumuzu kaybettik ve çöle düştük...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530113
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790530113,
					"content": "Şunu da söyleyeyim, bu çölün cidden ucu bucağı yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790530114,
					"content": "Rhodeia hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790530115
					]
				},
				{
					"id": 790530115,
					"content": "Ne, Rhodeia mı? Onunla tanıştın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530116
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790530116,
					"content": "Sanırım sonunda kendisine kalacak bir yer bulmuş... Qingce Köyü mü? Liyue'deki mi? Gerçekten çok uzağa gitmişsin, Rhodeia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790530117,
					"content": "Aferin. Böyle devam!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790530118
					]
				},
				{
					"id": 790530118,
					"content": "Evet... Elimden geleni yapacağım! Buradaki nemli havanın tadını çıkarmaya çalış lütfen. Çölde böyle bir yere denk gelmek zor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Idyia"
				}
			]
		},
		{
			"id": 7905313,
			"completionStepIds": [
				7905302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
