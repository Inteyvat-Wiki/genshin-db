			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Idyia"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790531301,
					"content": "Idyia! Acil durum, büyük bir haber var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790531302,
					"content": "Bir cep saati bulduk! Baksana! Şu efsanevi Mora Cep Saati değil mi bu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531303,
						790531304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790531303,
					"content": "Dışı sarı ve altın gibi parıldıyor!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531305
					]
				},
				{
					"id": 790531305,
					"content": "Hımm, ver bir bakayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531306
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531306,
					"content": "Ge-Gerçekten buldunuz mu onu? Yoksa bu, kaderin bir oyunu mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531307
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531307,
					"content": "Gizemli maceracının ardında bıraktığı büyük ödül, efsanevi Gezgin tarafından bulundu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531308
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531308,
					"content": "Bir çeşit... Manevi miras gibi hissediyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531309
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531309,
					"content": "Paimon, bu şekilde övüldüğü için çok mutlu oldu ama şimdi ne olacağını daha çok merak ediyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531310,
						790531311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790531310,
					"content": "Başka ödüller de alacak mıyız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531312
					]
				},
				{
					"id": 790531312,
					"content": "Ö-Öyle bir şey değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531313
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531313,
					"content": "Aslında, bu cep saatini birilerinin bulacağı hiç aklıma gelmemişti... Zaten nereye gömülü olduğunu ben bile unutmuştum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531314
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531314,
					"content": "Yalnızca kendisi bile çok değerli, öyle değil mi? Yani benden başka bir ödül almanıza gerek yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531315
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531315,
					"content": "Her neyse bu olayı not alacağım, bazı yazı teknikleriyle tabii ki. Gelecekteki misafirlerim için heyecanlı ve sürükleyici bir hikayeye dönüştüreceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531316
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531316,
					"content": "Şimdiyse gömdüğünüz hazine, bu Mora Cep Saatinin yerini alacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531317
					],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531317,
					"content": "Ah evet, doğru! Bunun hakkında konuşmuştuk, hazinenin içinde saklı olan hikayelerden bahsetmiştik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790531318,
					"content": "#Her neyse, hadi şu saati biraz daha inceleyelim, {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790531319,
					"content": "Idyia, bizim hakkımızda lütfen çok heyecanlı bir hikaye yaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790531320,
					"content": "Hiç meraklanmayın, o iş bende!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Idyia"
				},
				{
					"id": 790531311,
					"content": "Gizli bir etkinliği mi tetikleyecek?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531312
					]
				},
				{
					"id": 790531304,
					"content": "Üzerinde Mora yazıyor!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531305
					]
				}
			]
		},
		{
			"id": 7905314,
