			"dialogs": [
				{
					"id": 200490101,
					"content": "Çok fena içesim var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490102
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490102,
					"content": "Eury beni içerken yakalarsa çok fena yandım demektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490103
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490103,
					"content": "Her şey yolunda mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490104
					]
				},
				{
					"id": 200490104,
					"content": "Ha? Sorun yok. Sadece canım biraz içki çekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490105
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490105,
					"content": "Eşim Eury, içmeme katlanamıyor. O yüzden evde hiç içmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490106
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490106,
					"content": "Alışverişe çıkmasını bekleyip birkaç duble devirmeye çıkıyorum artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490107
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490107,
					"content": "Önce sorunun olduğunu kabul etmen gerekiyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490108
					]
				},
				{
					"id": 200490108,
					"content": "Hey! Öyle deme. Tüm Mondstadt'ta içmeyi seven tek ben değilim ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490109
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490109,
					"content": "Acaba gidip Eury'yi biraz oyalar mısın? Birkaç kadehlik oyalasan bana yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490110
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490110,
					"content": "Eury her alışverişe çıktığında bir sürü şeyin arasından seçim yapması gerekiyor ve tüm gün karar vermeye çalışıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490111
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490111,
					"content": "Karşısına başka seçenekler çıkardığın sürece üzerine düşünmeye devam eder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490112,
						200490114
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490112,
					"content": "Tamam...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490113
					]
				},
				{
					"id": 200490113,
					"content": "Haha, şahane! İyi talihin şarabı kadehlerinizden eksik olmasın dostlar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490114,
					"content": "Tam olarak ne kadar süre içmeyi planlıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490115
					]
				},
				{
					"id": 200490115,
					"content": "Yani o, senin Eury'yi ne kadar oyalayacağına göre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490116
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490116,
					"content": "Yok ya. Sadece bir kadeh içkiyi fondip yapmadan içeceğim kadar zamanım olsa yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490117
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200490117,
					"content": "Yemin ederim bir kadeh sadece! Mondstadt'ta han müdavimlerine güvenebilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nimrod"
				}
			]
		},
