					"nextDialogs": [
						200490204
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200490204,
					"content": "Anladım. O zaman sanırım elma alacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490205
					],
					"speakerTitle": "Eury"
				},
				{
					"id": 200490205,
					"content": "Üzgünüm Eury ama... Sanırım elmalar da kötüleşmeye başlamış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490206
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200490206,
					"content": "Öyle mi? Hımm... Yapacak bir şey yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490207
					],
					"speakerTitle": "Eury"
				},
				{
					"id": 200490207,
					"content": "Bize bırak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200490208,
					"content": "Ha? Neyi size bırakayım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490209
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200490209,
					"content": "Yardım etmeyi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490210
					]
				},
				{
					"id": 200490210,
					"content": "Dert etme, biz sana taze <color=#00E1FFFF>güneriği</color> buluruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200490211,
					"content": "Bulur musunuz? Teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490212
					],
					"speakerTitle": "Quinn"
				},
				{
					"id": 200490212,
					"content": "Bu çok iyi oldu, Nimrod güneriğini elmaya tercih eder. Burada bekliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eury"
				}
