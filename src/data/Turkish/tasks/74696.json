				]
			},
			"dialogs": [
				{
					"id": 746960101,
					"content": "Hatırlayabiliyor musun Qiqi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960102
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960102,
					"content": "Ha... Şey... Özür dilerim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960103
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960103,
					"content": "Özür dilemene hiç gerek yok. Mermonia Sarayı'na daha epey yolumuz var. Biz şimdilik yürümeye devam edelim, eminim yakında evinin yerini hatırlarsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960104
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960104,
					"content": "Baksana, Qiqi! Yanında da bir Melusina var. Paimon böyle bir ikili görmeyi hiç beklemiyordu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960105,
					"content": "#Aaa! {NICKNAME} ve... Pai... Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960106
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960106,
					"content": "Selam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960107
					]
				},
				{
					"id": 746960107,
					"content": "Qiqi'yi tanıyor musunuz? Süper haber! Lumidouce Limanı civarında araştırma yaparken denk geldim ona... Boyuna bakıp insan çocuğu sandım... Kendisi bir çocuk, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960108
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960108,
					"content": "Ben... Şeyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960109
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960109,
					"content": "Bizim yakın bir arkadaşımız!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960110
					]
				},
				{
					"id": 746960110,
					"content": "Aynen, aynen! Bayağı eski dostuz biz. Çok yakın arkadaşız hatta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960111,
					"content": "Hehe! İyi kurtardın! Qiqi zombi olduğunu söyleseydi kızın korkudan yüreğine inebilirdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960112,
					"content": "Evet... Çok yakın... Arkadaşız... Aynen öyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960113
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960113,
					"content": "Bu kesinlikle çok hoş bir tesadüf oldu. Ne yalan söyleyeyim, ilk defa ne yapacağımı tamamen şaşırdım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960114
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960114,
					"content": "Hafızasıyla ilgili sıkıntı yaşadığını biliyorsunuzdur herhalde? Kendi adı dışında pek bir şey hatırlamıyor gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960115
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960115,
					"content": "Qiqi'ye bazen oluyor öyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960116,
					"content": "Zavallı çocuk. Onu Gölge Mareşosesine götürüp bir süre orada misafir edecektim ama belki yolda hafızası biraz yerine gelir diye umuyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960117
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960117,
					"content": "Madem bu kadar yakın arkadaşsınız, nerede yaşadığını da biliyorsunuzdur diye tahmin ediyorum. Onu direkt evine bırakabilirsem epey zahmetten kurtulurum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960118
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960118,
					"content": "Biliyoruz da... Şey, orası buradan bayağı uzak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960119,
					"content": "Bayağı... Uzak... Hımm... Bir Perinin peşinden Lumidouce Limanı'na kadar gittim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960120
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960120,
					"content": "Hı? Bir şey mi hatırladın? Ondan önce ne olmuştu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960121
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960121,
					"content": "Ondan... Önce... Doktor Baizhu beni Yi... Iıı, Yi bilmem nereye hasta bakmaya götürmüştü... Ben de bitki toplamaya çıktım, sonra da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960122
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960122,
					"content": "Haa! Baizhu seni Yilong Rıhtımı'na götürdü, değil mi? Dedektif Paimon neler olduğunu anladı galiba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960123,
					"content": "Baizhu hastalarına bakmak için Qiqi'yi Yilong Rıhtımı'na götürdü. Qiqi bitki toplarken kayboldu, bir Peri gördü ve onun peşinden ta Lumidouce Limanı'na kadar geldi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960124,
					"content": "#Hehe, Paimon ve {NICKNAME} iyi ki \"Robben Chesterton'a Karşı\"yı okumuş! Böyle basit çıkarımlar yapmak artık Paimon için çocuk oyuncağı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960125,
					"content": "O kitabın kurgu olduğunu biliyorsun, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960126
					]
				},
				{
					"id": 746960126,
					"content": "Aa! İşte şimdi olay çözüldü! Ben Qiqi'yi hemen Yilong Rıhtımı'na geri götüreyim. Qiqi'nin vasisi Doktor Baizhu'ydu, değil mi? Çok endişelenmiştir kesin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960127,
						746960128
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960127,
					"content": "Bir saniye... Barbeloth'un kehanetinde geçen şu kişiler...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960129
					]
				},
				{
					"id": 746960129,
					"content": "Aa, haklısın! Paimon az kalsın unutuyordu bunu. Barbeloth, orada mısın? Bizi duyuyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746960130,
					"content": "Bağırmana gerek yok. Başından beri buradaydım zaten, sadece muhabbetinizi bölmek istemedim. Sonuçta iyi bir falcı her zaman dinler haldedir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960131
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960131,
					"content": "Yol gösteren şu Periyi kaderin bir işareti olarak düşünebiliriz. Hehe... Qiqi, hazır buraya kadar gelmişken senin de bir falına bakayım, ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960132
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960132,
					"content": "Fal... Mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960133
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960133,
					"content": "Ah canım. Barbie, dur ben lafa gireyim. Çocuklarla konuşmak pek sana göre değil, korkutuyorsun zavallı kızı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960134
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960134,
					"content": "Bunu ben halledeyim. Şimdi iyi dinle, ufak bir sürpriz hediye nasıl verilirmiş gör.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960135
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960135,
					"content": "Öhöm... Küçük Cadılar Meclisi üyesi Küçük Qiqi, ben müttefikin Klee'nin annesi, yani dünyanın en büyük cadısı Alice Teyzen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960136
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960136,
					"content": "Memnun oldum Alice Teyze...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960137
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960137,
					"content": "Ah, ne kadar tatlı ve kibar bir çocukmuş bu böyle. Gel bakalım, teyzenin arkadaşı olan bir başka büyük cadı sana şöyle harika bir sürpriz fal partisi verecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960138
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960138,
					"content": "Fal... Partisi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960139
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960139,
					"content": "Aynen öyle! Önündeki şu kartlara baksana. Çok güzel değiller mi? Beğendin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960140
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960140,
					"content": "Ben... Beğendim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960141
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960141,
					"content": "Harika! Şimdi benim için bir kart seçer misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960142
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960142,
					"content": "Şey... Bu olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960143
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960143,
					"content": "Tabii ki. Bu kadar uslu durduğun için o kart senin olsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960144
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960144,
					"content": "Iı... Teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960145
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960145,
					"content": "Hadi bakalım Barbie, mola bitti. Gel de küçük Qiqi'nin kartını yorumlamasına yardım et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960146
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960146,
					"content": "Beni uyandırmana gerek yok... Baştan beri dinliyordum zaten. Hım, düz Asılan Adam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960147
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960147,
					"content": "Bu kart çok az kişiye çıkar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960148
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960148,
					"content": "Demek ki sen çok özelsin Qiqi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960149
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960149,
					"content": "Aşkınlığı, bekleyişi ve sıradan dünyadan kopuşu simgeliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960150
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960150,
					"content": "Seni bağlayan prangalar var ama senin onlardan kurtulmaya hiç niyetin yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960151
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960151,
					"content": "Prangalar... Yani... Emirlerimi mi diyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960152
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960152,
					"content": "Yüzeysel açıdan bakarsak böyle yorumlaman pek de yanlış sayılmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960153
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960153,
					"content": "Geleceğine gelirsek, tek yapman gereken beklemek. Gerçi zaman açısından sıkıntın da yok... Ama... Hım, ne kadar tuhaf, cidden çok tuhaf...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960154
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960154,
					"content": "Dur bir saniye! Bir anda çok fazla şey söyledin. Bırak da zavallı çocuk biraz nefes alsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960155
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960155,
					"content": "Qiqi önce minik hediyesinin tadını çıkarsın. Çocuklara karşı cidden biraz daha sabırlı olman lazım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960156
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960156,
					"content": "Ne diyorsun Qiqi? Sürprizini beğendin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960157
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960157,
					"content": "Bu kart çok güzelmiş... Teşekkür ederim Alice Teyze.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960158
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960158,
					"content": "Ayy, aferin benim akıllı kızıma. Teyzenin adını ne güzel aklında tutmuşsun. Teyzen seninle birazcık daha laflamayı çok isterdi ama artık eve gitme zamanın geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960159
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960159,
					"content": "Barbie Teyze'nin söyleyeceği başka bir şey varsa, bir dahaki Cadılar Meclisi toplantısına katılan her küçük cadıya bir kehanette bulunabilir! Çok tatlı olmaz mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960160
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960160,
					"content": "... Üstüme iş yıkmadan önce bana bir sorsan keşke.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960161
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960161,
					"content": "Anlaştık o zaman! Qiqi ve siz şahitler, bir dahaki sefere görüşürüz, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960162
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 746960162,
					"content": "Görüşürüz... Alice Teyze... Ve Alice Teyze'nin... En yakın arkadaşı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960163
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960163,
					"content": "Of... Bitti mi? O iki ses bu oyuncak bebekten mi geldi? Nasıl bir oyuncak bu ya? Çok tatlıymış, acaba nereden...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960164
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960164,
					"content": "Of! Yok ya, şimdi bunun hiç sırası değil. Qiqi, hadi gidip senin şu Doktor Baizhu'nu bulalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960165
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 746960165,
					"content": "#... Hımm, zamanı geldi... Qiqi'nin eve gitmesi lazım. Sonra görüşürüz... {NICKNAME}... Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746960166,
						746960167
					],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960166,
					"content": "Kendine iyi bak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960168
					]
				},
				{
					"id": 746960168,
					"content": "Kart... Hediye... Hımm... Güzelmiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qiqi"
				},
				{
					"id": 746960167,
					"content": "Kendine dikkat et.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960168
					]
				},
				{
					"id": 746960128,
					"content": "Qiqi de onlardan biri değil miydi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746960129
					]
				}
			]
