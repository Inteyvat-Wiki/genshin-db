			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sorush",
					"Markozov",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733300701,
					"content": "Hey, sizi düzenbaz insanlar! Burayı hemen terk etseniz iyi olur! Biz Parilerin mirası ve sırrında gözünüz kalmasın sakın, ayrıca ulaşamazsınız da zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300702
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733300702,
					"content": "Pari mi? Sen bir Pari misin? Harika bir şey bu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300703
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300703,
					"content": "#Ah! Yanında {M#genç bir adam}{F#genç bir hanım} da varmış... Ve onun... Evcil hayvanı galiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300704
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300704,
					"content": "Hey, ağzından çıkanı kulağın duysun! Paimon onun en iyi arkadaşı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733300705,
					"content": "Arkadaş... Ah, tabii! \"En iyi arkadaş\"... Ne hoş geliyor kulağa! Ben de küçüklüğümden beri hep bir \"en iyi arkadaşım\" olsun istemişimdir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300706
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300706,
					"content": "#{M#Genç adam}{F#Genç hanım}, iki tane en iyi arkadaş istemezsiniz herhalde, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300707,
						733300708
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300707,
					"content": "Nasıl yani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733300710
					]
				},
				{
					"id": 733300710,
					"content": "Yani... İki en iyi arkadaşın olması biraz haksızlık olmaz mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300711
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300711,
					"content": "Böyle bir haksızlığı affetmek imkansız... O yüzden lütfen Pariyi bana verin. Nasıl davranacağım konusunda da endişeniz olmasın. Tüm potansiyelini kullandığından emin olacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300712
					],
					"speakerTitle": "Markozov"
				},
				{
					"id": 733300712,
					"content": "Küstah seni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300713
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733300713,
					"content": "Aaa, çok mantıksız davranıyor... Onunla anlaşabilmek mümkün değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733300714,
					"content": "Kelimeler olmadan da anlaşırız... Benim akıllı Yasnapatim ne demek istediğimi anlamıştır, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300715
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733300715,
					"content": "Ah, Paimon anladı! Sorush ona bir ders vermemizi istiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733300716,
					"content": "Hıh! Sessiz ol Beyaz Pofuduk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733300708,
					"content": "Bence sakıncası yok aslında.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733300709
					]
				},
				{
					"id": 733300709,
					"content": "Olamaz! Sadece Paimon senin en iyi arkadaşın olabilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733300710
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
