					"Bao'er"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210240601,
					"content": "Bu bir işe yaramıyor galiba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240602
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240602,
					"content": "Pardon. Bir kutu gördün mü?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240603
					]
				},
				{
					"id": 210240603,
					"content": "Kutu mu? Evet, bir kutu buldum ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240604
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240604,
					"content": "İçine baktığımda faturalardan başka bir şey olmadığını gördüm. Birileri çok büyük bir işe girişmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240605
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240605,
					"content": "Hımm. Acaba bu kutunun sahibi kutuyu geri almak için ne kadar para öder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240606
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240606,
					"content": "Nasıl yani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240607
					]
				},
				{
					"id": 210240607,
					"content": "O kadar endişelenme. Sadece şaka yapıyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240608
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240608,
					"content": "Gel gör ki faturalardaki malların değeri gerçekten yüksek ve insan bu işi Liyue'deki hangi ensesi kalının bağladığını merak ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240609
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240609,
					"content": "Neyin ne zaman yapılacağını iyi bilirim. Sırf yapabiliyorum diye arı kovanına çomak sokacak değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240610
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240610,
					"content": "Yine de ben bu kutuyu korumak için onca zaman ve emek harcamışken senin onu öylece alıp gitmen pek makul olmaz, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240611
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240611,
					"content": "Pazarlık etmeye ne dersin? Böyle sorunları çözmenin en geleneksel yolu budur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240612
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240612,
					"content": "Sen bana 3 tane Gece Parlayan Yeşim getirirsen ben de sana faturaları veririm. Olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240613
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240613,
					"content": "Sonuçta o faturalardaki mallara kıyasla 3 tane Gece Parlayan Yeşimin lafı bile olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240614,
						210240616
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240614,
					"content": "Anlaştık.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240615
					]
				},
				{
					"id": 210240615,
					"content": "Hadi, işe koyul öyleyse. Döndüğünde ikisini takas ederiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240616,
					"content": "Faturalarda ne yazıyor ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240618
					]
				},
				{
					"id": 210240618,
					"content": "Bilmiyorsun demek? O zaman buraya başkasının işini halletmeye geldin. Bana göre hava hoş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240619
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240619,
					"content": "Sana bir tavsiye vereyim; bu büyüklükteki ticari anlaşmalar hakkında çok soru sormasan iyi edersin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240620
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240620,
					"content": "O zaman gidip bana şu Gece Parlayan Yeşimleri getir, ben de sana faturaları vereyim. Sonra kimin için çalışıyorsan ona verebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240621
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240621,
					"content": "Her şey sorunsuzca hallolur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				}
			]
		},
