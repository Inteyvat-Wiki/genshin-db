			"dialogs": [
				{
					"id": 210240901,
					"content": "Faturaları buldun mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240902
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240902,
					"content": "Hepsini buldum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210240903
					]
				},
				{
					"id": 210240903,
					"content": "Çok sağ ol! Çok sevindim. Neyse ki her şey yolunda gitmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240904
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240904,
					"content": "Bu faturalar kaybolsaydı patronum ne kadar sinirlenirdi tahmin bile edemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240905
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240905,
					"content": "Bu faturaların nasıl bir iş için düzenlendiğini merak ediyorsun, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240906
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240906,
					"content": "Kusura bakma. Gerçekten söyleyemem. Bu bir sır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240907
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240907,
					"content": "İşte ödemen. Lütfen kabul et. Bir dakika... Bu kutu niye açılmış?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240908
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240908,
					"content": "Dışarıda karşılaştığın birisi bunu alıp içine mi bakmış?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240909
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240909,
					"content": "Eyvah, bittim ben. Öldüm. Öldüm! Çok kötü oldu bu. Hemen patrona söylemem lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240910
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240910,
					"content": "Endişelenme. Senden şüphelenmiyorum. Sonuçta senin hakkında araştırma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240911
					],
					"speakerTitle": "Landa"
				},
				{
					"id": 210240911,
					"content": "Öhöm. Neyse, bir şekilde patronuma haber vermem lazım. Lütfen sen kendi işine devam et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Landa"
				}
			]
		},
