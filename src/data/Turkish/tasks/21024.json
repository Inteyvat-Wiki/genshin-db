			"dialogs": [
				{
					"id": 210240802,
					"content": "İdare eder. Alayım. İşte faturalar. Dikkat et bir şey olmasın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210240803
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 210240803,
					"content": "Hadi öyleyse, gitsen iyi olur. Bu işi kimin için yapıyorsan eminim şu an çok gerilmiştir.",
