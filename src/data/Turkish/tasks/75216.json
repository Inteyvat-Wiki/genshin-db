			"dialogs": [
				{
					"id": 752190101,
					"content": "#Aa, şuradaki {NICKNAME} değil mi? Hey, bekle lütfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190102
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190102,
					"content": "İşte buradasın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190103
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190103,
					"content": "Selam, ne oldu? Yardım mı lazımdı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190104,
					"content": "Haha, yok. Elimde sizin adınıza bir paket var. Ben de tam sizi nerede bulacağımı düşünüyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190105
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190105,
					"content": "İyi insan lafın üstüne gelirmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190106
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190106,
					"content": "Paket mi? Kimden peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190107,
					"content": "Orası uzun hikaye. Önce Maceracılar Loncasına ulaşmış, ardından birkaç sefer el değiştirmiş ve sonunda Gök Kubbenin Evlatlarının bir kuryesi tarafından alınmış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190108
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190108,
					"content": "Natlan'ın son zamanlardaki durumu malum, kervanlar bir süredir düzgün çalışmıyor. Ayrıca paketin üzerinde gönderici adı yok ama imzaya bakarsak... Fontaine'den geliyor olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190109
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190109,
					"content": "Fontaine'de bile arkadaşlarınız var demek, ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190110,
						752190111
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190110,
					"content": "Paketi alıyorum, teşekkürler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752190112
					]
				},
				{
					"id": 752190111,
					"content": "Harika! Alayım o zaman.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752190112
					]
				},
				{
					"id": 752190112,
					"content": "Vay be, bugün işe harika başladım. Paketin elime geçmesiyle alıcıya rastlamam bir oldu adeta. Ateş Hükümdarı'na şükürler olsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190113
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190113,
					"content": "Neyse, ben diğer teslimatları halledeyim. Size iyi günler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190114
					],
					"speakerTitle": "Huqiru"
				},
				{
					"id": 752190114,
					"content": "Sana da iyi çalışmalar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190115,
					"content": "Fontaine'den demek... Paket dedi ama ufacık bir şey bu! Paimon'a göre mektuba benziyor daha çok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190116,
					"content": "Hadi açıp bakalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190117,
					"content": "Charlotte'tan gelmiş! Biz Fontaine'den ayrılırken çekildiğimiz fotoğrafı göndermiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190118,
					"content": "Fotoğraf çekileli çok uzun zaman olmadı aslında ama Paimon'a bir ömür gibi geldi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752190119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752190119,
					"content": "Hehe, bu fotoğrafı güvenli bir yere koyalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}