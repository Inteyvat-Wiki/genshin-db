				]
			},
			"dialogs": [
				{
					"id": 100040201,
					"content": "Ah, yaz günlerini hatırlattı bu. Aslında ferahlatıcı sayılır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040202,
					"content": "Demek kadim Khaenri'ah krallığının kapısı bu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040203
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040203,
					"content": "Arkasında birçok sır ve trajedinin yattığına eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040204
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040204,
					"content": "Pekala, hadi ikinci mektubu açalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040205,
					"content": "Bir bakayım... Evet. İşte burada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040206
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040206,
					"content": "\"Eski bir Sumeru atasözü şöyle der: Ezberlenmiş bilgi, bilgelik yağmurlarıyla sulanmadıkça meyve vermez. Şimdi, bu topraklarda 'Apaosha'nın Alameti' olarak bilinen bir olgu vardır.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040207
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040207,
					"content": "\"Bu, hakikati aşırı arzulamaya karşılık olarak yanan göksel bir işarettir. Bu bağlamda, belki de buna 'Gerçeğin Alameti' demek daha uygun olur...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040208
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040208,
					"content": "\"Bu kadim krallığın kayıtlarına göre, Khaenri'ah'da ayna gibi berrak ve durgun, yüzeyleri gerçek yıldızları yansıtan birkaç büyük yer altı gölü bulunmaktadır.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040209
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040209,
					"content": "\"Bu, suda oluşan 'Gerçeğin Alameti'nin sahte gökyüzünü aşıp dış evrene bağlanabilmesinden kaynaklanıyor.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040210
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040210,
					"content": "Hiç bilmiyordum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040211
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040211,
					"content": "\"Gök cisimlerinin kütleçekim kuvvetlerini ve etkilerini gözlemlemek için sahte gökyüzünün ötesini görebilmek gerekir. Bu dünyanın kaderini ancak bu kozmik parametreleri elde ederek öngörebiliriz.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040212
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040212,
					"content": "\"Şimdi, sana vereceğim görev şu: Khaenri'ah'nın kapısının önünde bir 'Gerçeğin Alameti' aç.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040213
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040213,
					"content": "Mektubun geri kalanında yaşlı cadının bunu çağırmak için bulduğu tören hakkında bir sürü şey var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040214
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040214,
					"content": "Evet, bu gezegen yörüngeleri ve... Runlar falan... Paimon bunları anlamaya bile çalışmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040215,
					"content": "Ee, ne dersin Mona? Deneyecek misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040216,
					"content": "Yani, bunu itiraf etmekten hazzetmiyorum ama bulduğu parametreler işe yarayabilir gibi görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040217
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040217,
					"content": "Açıkçası bu olasılık oldukça heyecan verici. Hem şimdi geri dönmek bana bir gecelik konaklama masrafına daha mal olacak. O halde... Şu an denemenin tam zamanı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040218
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040218,
					"content": "Sonsuz yıldızların elçileri, ekliptik ve ekvatoral düzlemlerinin gezginleri, parlak göksel kardeşler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040219
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040219,
					"content": "Uçsuz bucaksız boşluğun dolambaçlı yollarından geçin. Ben, Astrolog Mona Megistus, dengeyi sağlamak için Suyun gücünü çağırıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040220
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040220,
					"content": "Bilgelik ve hakikat adına, susuzluk dinsin. Ben, Astrolog Mona Megistus, sizleri çağırıyorum ey yıldızlar, karşımda durun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040221
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040221,
					"content": "İ-İşe yaradı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040222,
					"content": "Aaaa, canavarlar! Nasıl oldu bu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040223,
					"content": "Maalesef. Gerçeğin Alameti sadece canavarların geçmesine yetecek kadar açıldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040224
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040224,
					"content": "Kahretsin! Gerçek yıldızları hiç göremedim. Neyse... Bunun acısını sizden çıkaracağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
