			"dialogs": [
				{
					"id": 100040101,
					"content": "Mona! Sana bir şey getirdik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040102,
					"content": "#Aa, {NICKNAME}, Paimon! Bugün çok enerjiksiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040103
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040103,
					"content": "Benim için bir şey mi getirdiniz? Yoksa... Mora kazanmanın kolay bir yolunu mu buldunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040104
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040104,
					"content": "Aslında ustandan bir tür \"görev\" getirdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040105,
					"content": "Ben pas geçeyim! Of, sanırım tercih hakkım yok ama değil mi? Yine de girişimcilik ruhunu korumak lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040106
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040106,
					"content": "Bunun bir işkence olacağını biliyorum. O yaşlı cadıyı çok iyi tanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040107
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040107,
					"content": "Önce bir göz atmaya ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040108,
					"content": "Hım, bu kitap... Pek özel gelmedi gözüme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040109
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040109,
					"content": "Aaa! İçinden mektuplar düştü!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040110
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040110,
					"content": "Aa! Belki de... Seninle barışmaya çalışıyordur, olamaz mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040111,
					"content": "Bilemiyorum. Her halükarda bu üç mektubu sırasıyla açmam gerekiyor herhalde. Pekala, birincisiyle başlayalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040112
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040112,
					"content": "Eğer bu onun \"görevi\" ise hepimizin okumasında sakınca olmaz. Hadi, ne yazıyormuş bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040113
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040113,
					"content": "\"Ah, görüşmeyeli ne kadar uzun zaman oldu öğrencim. Maalesef son günlerde ayağa kalkmak giderek zorlaşıyor...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040114
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040114,
					"content": "Peh, merhamet kartını oynuyor. En azından biraz daha inandırıcı görünmeye çalışabilirdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040115
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040115,
					"content": "\"Seni kovaladığım zamanları hatırlıyor musun? Deli gibi kaçardın benden, Su hayaletini kullanarak beni şaşırtmaya çalışırdın. Ah, sanki daha dün gibi...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040116
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040116,
					"content": "\"Artık sen kendi yoluna gittin ve ben de günlerimi sallanan sandalyemde pinekleyerek geçiriyorum. Yine egzersize başlasam iyi olacak...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040117
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040117,
					"content": "Egzersizini başka şekilde yap ihtiyar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040118
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040118,
					"content": "Şey, aslında tekrar düşününce bu mektup biraz özel duruyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100040119
					]
				},
				{
					"id": 100040119,
					"content": "\"Şimdi, eminim bu mektubun amacını merak ediyorsundur. O halde söylüyorum... Eğer bir krallığın, hatta bütün dünyanın kaderini nasıl öngöreceğini öğrenmek istiyorsan...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040120
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040120,
					"content": "\"Sumeru'ya git ve yer altı krallığının kapısını ara. Oraya vardığında ikinci mektubu aç.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040121
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040121,
					"content": "Hım, insanları ağına düşürmeyi çok iyi biliyor, ona şüphe yok. Gizli tekniğini aktarma konusunda ciddi mi acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040122
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040122,
					"content": "Sanırım gerçekten yaşlanıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040123
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040123,
					"content": "İkinizin arasında çok garip bir dinamik var. Duygusal konulardan konuşurken... Kavga ediyorsunuz. Ama sıkıcı akademik konulara gelince hepten duygusallaşıyorsunuz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040124,
					"content": "Neyse, bu \"yer altı krallığına açılan kapı\" kulağa tanıdık geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040125,
					"content": "Bir dakika, siz duymuş muydunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040126
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040126,
					"content": "Evet. Aynı yerden bahsediyoruzdur herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040127,
					"content": "Süper! Araştırma yapmama bile gerek yok o zaman! Yani rehber tutmak yok, konaklama yok, sağa sola Mora saçmak yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040128
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040128,
					"content": "Hadi, kaybedecek vaktimiz yok. Gidelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040129
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040129,
					"content": "Az önce ulaşım ücretinden de bahsetmediğine göre, Paimon'un tahminince...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040130,
					"content": "Evet! Her zamanki yöntem! Hadi gidelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				}
			]
		},
