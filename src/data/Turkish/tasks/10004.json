					}
				]
			},
			"dialogs": [
				{
					"id": 100040601,
					"content": "Oh, bitti sonunda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040602,
					"content": "Pekala, yaşlı cadı her şey bittiğinde üçüncü mektubu açmamı söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040603
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040603,
					"content": "Ama başaramadım. O zaman... Yine de açmalı mıyım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040604
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040604,
					"content": "Hımm. Biliyor musun, Paimon artık aranızdaki dinamiği çok daha iyi anlıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040605,
					"content": "Bak, töreni \"başarıyla\" tamamlaman gerektiğini söylememiş, yani açabilirsin. Sorun olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100040606,
					"content": "Hım, sanırım doğru. Yine de güzel şeyler yazdığını sanmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040607
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040607,
					"content": "\"Eğer bunu okuyorsan Gerçeğin Alameti'ni açmaya çalıştın demektir.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040608
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040608,
					"content": "\"... Hahahaha. Ciddi misin? Gerçekten denediğine inanamıyorum!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040609
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040609,
					"content": "\"Neye gülüyorsun seni ihtiyar cadı?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040610
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 100040610,
					"content": "\"Khaenri'ah'da birkaç yıldız gölü bulunuyordu ve bu da o bölgedeki uzay dokusunu nispeten istikrarsız kılıyordu. Bunun sonucunda, fiziksel olmayan yollarla gök kubbeyi delme girişimlerinin başarıya ulaşma olasılığı daha yüksekti.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040611
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040611,
					"content": "\"Her halükarda, bu yerin iyi gizlendiğini ve çok fazla kişi tarafından ziyaret edilmeyeceğini biliyordum. Bu nedenle Gerçeğin Alameti'ni açma girişiminin başarısız olmasının olumsuz etkileri küçük çapta kalacaktı.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040612
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040612,
					"content": "\"Ve tabii ki, öğrencim olarak, sahte gökyüzünün ötesinde dolaşan Hiçlik yaratıklarıyla başa çıkabilecek yeteneğe sahip olduğundan emindim.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040613
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040613,
					"content": "\"Onları yenemesen bile onlardan kaçabileceğinden eminim. Her zaman hızlıydın.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040614
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040614,
					"content": "\"Ah, su falını 'susuzluğu' gideren bilgelikle bağdaştırmak... Gerçekten deham sınır tanımıyor.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040615
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040615,
					"content": "\"Kürenin pratik uygulaması, sahte gökyüzünün neden olduğu rahatsızlıkları da azalttı. Hah, Alice'in bunu nasıl geçeceğini görmek isterim!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100040616
					],
					"speakerTitle": "Barbeloth"
				},
				{
					"id": 100040616,
					"content": "Mona okumayı burada kesiyor... Görünüşe göre yaşlı cadı birkaç bin kelime daha kendini övmeye devam etmiş.\\n\\nGözlem sonuçlarını düzenledikten sonra hep birlikte Mondstadt'a geri dönüyorsunuz.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		}
	]
