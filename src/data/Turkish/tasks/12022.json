			"dialogs": [
				{
					"id": 120220301,
					"content": "#Baksana, {NICKNAME}. Bahsettiği kitap bu olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220302
