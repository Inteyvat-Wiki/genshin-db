			"dialogs": [
				{
					"id": 120220601,
					"content": "#Aradığımız kitap bu sanırım, değil mi {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220602,
					"content": "Henüz bitirememiş baksana kitap ayracı duruyor. Diğer kitapları çoktan okumuş bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220603,
					"content": "Kitabın dili çok ağır, Paimon hiçbir şey anlamıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220604
					],
