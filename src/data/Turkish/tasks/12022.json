			"dialogs": [
				{
					"id": 120220701,
					"content": "Ekselanslarını mı arıyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220702
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220702,
					"content": "Maalesef kendisi şu an burada değil. Nerede olduğunu da bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220703
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220703,
					"content": "Çok tuhaf... Başka bir zaman gelelim o halde biz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220704,
					"content": "Gerek yok. Yanlış hatırlamıyorsam Ekselansları bu tarz bir durumda ne yapılması gerektiğini Genel Operasyon Talimatlarında belirtmişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220705
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220705,
					"content": "Kaçıncıydı... Evet, hatırladım! 98. madde. <color=#00E1FFFF> \"Uzak diyarlardan bir ziyaretçi beni görmeye geldiyse ve benim nerede olduğum bilinmiyorsa kendisine mor yapraklı ağacı görene kadar güneye gitmesini söyleyin.\"</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220706
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220706,
					"content": "Dipnotta bu talimatın yalnızca Ekselansları nereye gittiği hakkında hiçbir bilgi vermediyse ve bahsi geçen ziyaretçi VIP ise geçerli olacağı belirtilmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220707
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220707,
					"content": "Bildiğim kadarıyla siz ikiniz koşulları karşılıyorsunuz. Bu talimatları hiç yanımdan ayırmam. Eminim şu anda uygulanması gereken de bu madde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220708
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220708,
					"content": "Kokomi gerçekten de her şeyi düşünüyor! Söylediği yeri bulup bir bakalım o halde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
