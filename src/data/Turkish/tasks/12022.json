			},
			"dialogs": [
				{
					"id": 120220101,
					"content": "Kokomi henüz gelmemiş galiba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220102,
					"content": "Tuhaf gerçekten. Buluşmalara geç kalan birine benzemiyor halbuki... Biraz daha bekleyelim o halde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220103,
					"content": "Şu ana kadar gelmesi gerekirdi. Başı dertte midir acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220104,
					"content": "Şuradaki askere soralım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220701,
					"content": "Ekselanslarını mı arıyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220702
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220702,
					"content": "Maalesef kendisi şu an burada değil. Nerede olduğunu da bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220703
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220703,
					"content": "Çok tuhaf... Başka bir zaman gelelim o halde biz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220704,
					"content": "Gerek yok. Yanlış hatırlamıyorsam Ekselansları bu tarz bir durumda ne yapılması gerektiğini Genel Operasyon Talimatlarında belirtmişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220705
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220705,
					"content": "Kaçıncıydı... Evet, hatırladım! 98. madde. <color=#00E1FFFF> \"Uzak diyarlardan bir ziyaretçi beni görmeye geldiyse ve benim nerede olduğum bilinmiyorsa kendisine mor yapraklı ağacı görene kadar güneye gitmesini söyleyin.\"</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220706
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220706,
					"content": "Dipnotta bu talimatın yalnızca Ekselansları nereye gittiği hakkında hiçbir bilgi vermediyse ve bahsi geçen ziyaretçi VIP ise geçerli olacağı belirtilmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220707
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220707,
					"content": "Bildiğim kadarıyla siz ikiniz koşulları karşılıyorsunuz. Bu talimatları hiç yanımdan ayırmam. Eminim şu anda uygulanması gereken de bu madde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220708
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 120220708,
					"content": "Kokomi gerçekten de her şeyi düşünüyor! Söylediği yeri bulup bir bakalım o halde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1202202,
			"completionStepIds": [
				1202208
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1202208",
							"2"
						],
						"stepId": 1202208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sangonomiya Kokomi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120220204,
					"content": "Kokomi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220205,
					"content": "Buradasın demek! Hani buluşup Zafer Ziyafeti hazırlıklarını tamamlayacaktık? Bir şey mi oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220206,
					"content": "Neyse... Sizmişsiniz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220207
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220207,
					"content": "Ben... Özür dilerim... Bugün kendimi hiç iyi hissetmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220208
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220208,
					"content": "*yutkunur* Hasta mı oldun yoksa? Hemen bir doktor bulalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220209,
					"content": "Hayır, hayır. Hasta değilim... Sadece hiç enerjim kalmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220210
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220210,
					"content": "En-Enerjin mi kalmadı? *yutkunur* Yani... Harabe Muhafızı gibi mi yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220211,
					"content": "Hayır, sadece lafın gelişi öyle dedim. *iç çeker* İtiraf etmesi çok zor ama öyle görünmek istesem de her zaman her şeye gücüm yetmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220212,
						120220213
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220212,
					"content": "Dün herkes sorularıyla sana çok yüklendi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220214
					]
				},
				{
					"id": 120220214,
					"content": "Fark ettin demek? Hislerimi gizlemekte pek de başarılı değilim galiba. Bu konuda kendimi geliştireceğim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220215
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220215,
					"content": "Aslına bakarsanız liderlik etmek için biçilmiş kaftan değilim. Benim başlarda hayal ettiğim şey askeri strateji hakkında yeterince bilgi sahibi olmak ve belki de danışman olmaktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220216
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220216,
					"content": "İnsanlarla sürekli iletişim içinde olmak, morallerini yüksek tutmaya çalışmak, olan biteni anlamaya çabalamak, herkese hak ettiğini vermek... Bunlar çok yorucu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220217
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220217,
					"content": "Bir şekilde sırf yanlarında olduğum için bile mutlu olmalarını ve aynı zamanda saygıda kusur etmemelerini sağlamam gerek... Ama bu benim için doğuştan gelen bir yetenek değil. İşin aslı, kendimi bu konumda görmeyi hiç istememiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220218
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220218,
					"content": "Ancak geldiğim soy nedeniyle er ya da geç Kutsal Rahibe olmak benim kaderimde var. İstesem de istemesem de durum bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220219
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220219,
					"content": "O yüzden tüm bunlardan bunaldığımda buraya gelip kendimi bir kitaba kaptırırım ve bir süreliğine de olsa rahatlarım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220220
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220220,
					"content": "Endişelenmenize gerek yok, işlerim bundan etkilenmiyor. Zafer Ziyafeti hazırlıkları için birini görevlendirdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220221
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220221,
					"content": "Bu gece bir konuşma yapmalıyım ve askerlerin içine kurt düşürecek bir şeyler söylememem lazım. Bu barış kolay kazanılmadı ve onların huzurlu olmalarını istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220222
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220222,
					"content": "Yardım edebileceğimiz bir konu var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220223,
					"content": "Biraz daha kafamı dinlersem enerjimi toplarım diye düşünüyorum. *iç çeker* Biri bana askeri stratejiyle ilgili bir kitap okusa kendimi toparlamama çok yardımcı olurdu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220224
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220224,
					"content": "En son buraya geldiğimde bir kitap okuyordum ama yarısına kadar gelebilmiştim. Nereye koydum acaba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220225
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220225,
					"content": "Biz hemen buluruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220226,
					"content": "Sonra da okuruz bile. Böylece kendini toparlamana yardım ederiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220227,
					"content": "Yapar mısınız gerçekten? Teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220228
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220228,
					"content": "Hehe... Watatsumi Adası'na geri geldiğiniz için çok şanslıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 120220213,
					"content": "Sana bir şeyler olacağını hissetmiştim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120220214
					]
				}
			]
		},
