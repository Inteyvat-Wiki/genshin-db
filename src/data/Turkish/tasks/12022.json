				{
					"id": 120220501,
					"content": "Vay canına... Ne kadar fazla dilekçe var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220502,
					"content": "Dinlenirken bile bunlarla mı uğraşması gerekiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220503,
					"content": "\"Sangonomiya Etkinlikleri Nakit Girdi Beyanı\", \"Birleştirilmiş Yıllık Balık Üretimi Raporu\", \"Watatsumi Adası Aylık Bakım Giderlerinin Dağılımı\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220504,
					"content": "Tek bir kişi için çok fazla iş var. Yazması gereken talimatlar ve görüşmesi gereken insanlar varken üstüne bir de bunlar... Arada bir böyle gücünün tükenmesi gayet doğal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120220505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120220505,
					"content": "Hadi şu kitabı bulup enerjisini toplamasına yardım edelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
