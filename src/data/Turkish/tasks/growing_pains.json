			"dialogs": [
				{
					"id": 225000101,
					"content": "Ne zaman hazır olacak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000102
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 225000102,
					"content": "Bugün oyun saati yok mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000103
					]
				},
				{
					"id": 225000103,
					"content": "Selam! Yok, şu sıralar oyun saati hiç gelmeyecek gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000104
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 225000104,
					"content": "Minik Meng, canı sıkkın diye kendi başına surat asıp oturuyor ve Minik Fei de ikide bir ortadan kayboluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000105
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 225000105,
					"content": "Minik Meng'e sorunun ne olduğunu sordum ama söylemedi. Son günlerde ikisi de çok tuhaf davranıyor, dertleri ne anlamadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000106,
						225000110
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 225000106,
					"content": "Yetişkinlerin dünyasına hoş geldin evlat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000107
					]
				},
				{
					"id": 225000107,
					"content": "Nasıl yani, büyüdüğünde mutluluk bitiyor mu? O zaman neden Minik Meng ve Minik Fei bu kadar çok büyümek istiyor ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000108
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 225000108,
					"content": "O zaman ben hiç büyümesem daha iyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000109
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 225000109,
					"content": "Her neyse, konudan sapıyoruz. Bir konuda yardımına ihtiyacım var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000112
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 225000112,
					"content": "Bana Ying'er'in dükkanından bir şey getirir misin? Zaten önceden konuşmuştuk, muhtemelen çoktan hazırlamıştır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000113,
						225000115
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 225000113,
					"content": "Memnuniyetle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000114
					]
				},
				{
					"id": 225000114,
					"content": "Yaşasın! Teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 225000115,
					"content": "Ying'er'in dükkanı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000116
					]
				},
				{
					"id": 225000116,
					"content": "Aklından ne geçiyor bilmiyorum, ama muhtemelen o değil. Ying'er'den bana bir şey yapmasını istedim, o da yapacağını söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000117
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 225000117,
					"content": "Şimdi de senden onu alıp bana getirmeni rica ediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 225000110,
					"content": "Sen de mi mutsuzsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000111
					]
				},
				{
					"id": 225000111,
					"content": "Ben mi? Yok ben iyiyim de... Bir konuda yardımın gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000112
					],
					"speakerTitle": "Minik Lulu"
				}
			]
		},
