						225000603
					]
				},
				{
					"id": 225000603,
					"content": "Teşekkür ederim! En iyi parfümü Ying'er yapar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000604
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 225000604,
					"content": "Acaba kokusunu aldıklarında, Minik Meng ve Minik Fei ne düşünecek?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000605
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 225000605,
					"content": "Nasıl tepki verirlerse versinler, izlemesi çok eğlenceli olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000606,
						225000608
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 225000606,
					"content": "Çok sevecekler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000607
					]
				},
				{
					"id": 225000607,
					"content": "Umarım. Bu çok iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000610
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 225000610,
					"content": "Bana yardım ettiğin için teşekkür ederim. Birazdan eve dönüp yeni parfümümü deneyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000611
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 225000611,
					"content": "Güzelse tekrar tekrar kullanabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 225000608,
					"content": "Kimle oynamayı tercih edersin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000609
					]
				},
				{
					"id": 225000609,
					"content": "Hım? Herhangi birini tercih etmem... İkisini de tercih ederim! Minik Meng ve Minik Fei, ikisi de benim en yakın arkadaşım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000610
					],
					"speakerTitle": "Minik Lulu"
				}
			]
