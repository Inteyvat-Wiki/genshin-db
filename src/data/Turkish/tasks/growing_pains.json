					"content": "3.000 Moraya ne dersin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000302
					]
				},
				{
					"id": 225000302,
					"content": "Görüyorum ki birileri epey çaresiz... Tamam o zaman, Lulu'nun parfümünü arkadaşlığımızın hatırına önceye alacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000303
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000303,
					"content": "Ama gün içinde dükkanla da ilgilenmem gerekiyor. Kişisel işlerimi genelde gece hallediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000304
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000304,
					"content": "Akşama uğrarsan her şeyi hazırlamış olurum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ying'er"
				}
			]
