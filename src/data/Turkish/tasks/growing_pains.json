			"dialogs": [
				{
					"id": 225000401,
					"content": "Yardımcı olabilirim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000402
					]
				},
				{
					"id": 225000402,
					"content": "Fena fikir değil. Sonuçta bu konularda biraz tecrüben var. En son buraya geldiğinde beni etkilediğini unutmadım. *kıkırdar*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000403
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000403,
					"content": "Tesadüfe bak ki gereken malzemelerin bir kısmı elimde. Gidip Şef Mao'nun mutfağında hazırlayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000404
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000404,
					"content": "Üç Nane yaprağı topla. Sonra da Simya Tezgahında özütlerini çıkart. Tekniği unutmadın, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000405
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000405,
					"content": "Sen bana Nane Özütünü getir, gerisini ben hallederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ying'er"
				}
			]
		},
