			"dialogs": [
				{
					"id": 225001001,
					"content": "Elinde Nane Özütü var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225001002,
						225001006
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225001002,
					"content": "Nasıl yapacağım?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225001003
					]
				},
				{
					"id": 225001003,
					"content": "Daha önce yapmıştık hatırlamıyor musun? Her işe burnunu soktuğun gibi, her şeyi de hızlıca unutuyorsun yani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225001004
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225001004,
					"content": "O halde hızlıca tekrar anlatayım. Üç adet Nane yaprağı topla, daha sonra Simya Tezgahında onların özütünü çıkart.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225001005
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225001005,
					"content": "Çıkarttığın özütü bana getir, gerisini ben hallederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225001006,
					"content": "Nane Özütü ne işe yarar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225001007
					]
				},
				{
					"id": 225001007,
					"content": "Nasıl anlatsam... Karışımdaki uyarıcı etkileri baskılıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225001008
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225001008,
					"content": "Ancak en önemlisi bu koku Lulu gibi bir çocuğa daha uygun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225001009
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225001009,
					"content": "Koku dediğin sadece burunla hissedilmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225001010
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225001010,
					"content": "Parfüm, kişinin canlılığını, heyecanlılığını, mutluluğunu ve hayat doluluğunu da yansıtır. *kıkırdar*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ying'er"
				}
