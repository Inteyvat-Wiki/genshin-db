			},
			"dialogs": [
				{
					"id": 225000201,
					"content": "Tekrar merhaba, demek beni hemen özledin. Bu defa ne için geldin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000202
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000202,
					"content": "Minik Lulu için bir şey almaya geldim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000203
					]
				},
				{
					"id": 225000203,
					"content": "Minik Lulu mu? Evet doğru. Kendisine parfüm yapmamı istemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000204
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000204,
					"content": "Ama korkarım ki şu an uygun bir zaman değil... Nedense sen buraya en son geldiğinden beri, güzel kokulu ürünlerime talep epey arttı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000205
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000205,
					"content": "Bir sürü sipariş aldım. Bunların tümünü tek başıma halletmem zor, hele ki bir de dükkana bakmam gerekiyorken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000206
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000206,
					"content": "Bunun yanı sıra Lulu sadece bir çocuk. Yetişkin kadınların sıktığı türde bir parfümü ona hediye etmek çok uygunsuz olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000207
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000207,
					"content": "Ben de kendi parfümümü nasıl çocuklara uygun hale getiririm diye kafa patlatıyorum. Uygulanabilir bir formül belirledim, ancak henüz yapmaya başlamadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000208
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000208,
					"content": "Ertelenemeyecek kadar acilse, işi hızlandırabilirdik aslında ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000209
					],
					"speakerTitle": "Ying'er"
				}
			]
		},
