			"dialogs": [
				{
					"id": 225000501,
					"content": "Parfüm hazır. Nane Özütünden kişiye özel parfüm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000502
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000502,
					"content": "İşte, Minik Lulu için hazır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000503,
						225000504
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000503,
					"content": "Tamam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 225000504,
					"content": "Neden Nane?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000505
					]
				},
				{
					"id": 225000505,
					"content": "Doğal kokusuyla birlikte, şey... Hım, uyarıcı etkileri baskılıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000506
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000506,
					"content": "Açık konuşmak gerekirse Lulu'dan sipariş aldığıma çok şaşırdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000507
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000507,
					"content": "O yaşlardaki zamanlarımı, aşkın tadına ilk vardığım anları hatırlattı... Ah, insanın kalbi pır pır ediyor... Keşke o zamanlar biraz daha olgun olsaydım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000508
					],
					"speakerTitle": "Ying'er"
				},
				{
					"id": 225000508,
					"content": "Öhö... Neyse artık Lulu'nun yanına dönmelisin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ying'er"
				}
			]
		},
