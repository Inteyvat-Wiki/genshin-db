			"dialogs": [
				{
					"id": 761200101,
					"content": "... Al. Bu senin. Ben kendi payımı ödemiş oldum, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200102
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761200102,
					"content": "Aa, bir tuval. Bir saniye, o halde bu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200103,
					"content": "Hah. Tam zamanında geldiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200104
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761200104,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200105
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200105,
					"content": "Vay, Büyük Ressamımız Maalaus gelmiş! Görüşmeyeli uzun zaman oldu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200106,
					"content": "Ne için \"tam zamanında\" geldik?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200107
					]
				},
				{
					"id": 761200107,
					"content": "Maalaus'u aya götürdüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200108
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761200108,
					"content": "Paimon sana çooook imrendi... Sanki yan komşunun bahçesine gitmişsin gibi söyledin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200109,
					"content": "Peki neden gittiniz? İlham mı arıyordunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200110,
					"content": "Sayılır. Ayrıca bir \"sergi\" için yer seçtik. Hatırlıyor musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200111
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761200111,
					"content": "Paimon hatırlıyor! Maalaus'un Ay Tanrıçası sergisi! Açılışa bizi de davet etmeyi unutmayın, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200112,
					"content": "Tabii ki. Ayrıca Maalaus, etrafındaki ufak değişiklikleri hissedebiliyor anlaşılan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200113
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761200113,
					"content": "Aydan döndüğümden beri çok değiştiğimi söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200114
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761200114,
					"content": "Bu yüzden ayın özel bir yanı olup olmadığını görmek için onu götürmemi istedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200115
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761200115,
					"content": "Heh! İşte gerçek bir sanatçı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200116,
					"content": "Peki bu özel yan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200117
					]
				},
				{
					"id": 761200117,
					"content": "Ben de emin değilim. Maalaus'u birçok yere götürdüm ama hiçbiri onu memnun etmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200118
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761200118,
					"content": "Ta ki onu sizin geminizin yakınına getirene kadar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200119,
						761200120
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761200119,
					"content": "Uzay gemimiz mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200121
					]
				},
				{
					"id": 761200121,
					"content": "Ama onu yaklaştırdığımda geminin kendisiyle ilgilenmediğini fark ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200122
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761200122,
					"content": "Hı? Nasıl yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200123,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200124
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200124,
					"content": "Aaa, etrafında uçuyor Columbina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200125,
					"content": "Haha. O gün de böyle yaptı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200126
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761200126,
					"content": "Aslında uzay gemisini gördükten sonra benim nasıl göründüğümle ilgileniyordu sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200127
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761200127,
					"content": "Nasıl... Göründüğün mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200128,
					"content": "#Evet. {NICKNAME} ile oraya birlikte gidişimiz aklıma geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200129
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761200129,
					"content": "#Geminin tepesinde oturup Teyvat'ı seyretmiştik. {NICKNAME} geçmişle ilgili hakikati bulmuştu, bense \"evimi\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200130
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761200130,
					"content": "Sadece bunu düşünmek bile bana bir huzur hissi verdi... Mutluluktu belki de.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200131
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761200131,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200132
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200132,
					"content": "Evet, haklısın. Bunlar daha önce hissettiğim şeyler değildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200133
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761200133,
					"content": "Ben de aya ulaştıktan sonra olanlar dahil bütün hikayemizi anlattım Maalaus'a.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200134
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761200134,
					"content": "Dinledikten sonra çok memnun görünüyordu, sanki o çok arzuladığı ilhamı bulmuş gibiydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200135
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761200135,
					"content": "Ha. O zaman artık büyük sanatçının sihrini konuşturma zamanı geldi, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200136,
					"content": "Heh, o gün Paimon'u yukarı götürmemiştiniz. O yüzden Maalaus'un ne çizeceğini Paimon da çok merak ediyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200137,
					"content": "Peki bu sefer boya olarak ne kullanacağız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200138
					]
				},
				{
					"id": 761200138,
					"content": "Bu seferki özel bir şey.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200139
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761200139,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200140
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200140,
					"content": "Maalaus, sadece bize ait olan boyalar istediğini söylüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200141
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761200141,
					"content": "Peki... O ne demek?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200142,
					"content": "Sanırım sana bu yolculuğu hatırlatacak şeylerden, yolculuğun sana kazandırdıklarından ve sana getirdiği neşeden bahsediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200143
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761200143,
					"content": "Merak etme. Maalaus sadece bu nesneleri görmek ve onlara dokunmak istiyor. O kadar değerli bir şeyi boya olarak kullanmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200144
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761200144,
					"content": "Sen ona ne verdin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200145
					]
				},
				{
					"id": 761200145,
					"content": "Aydan biraz toprak ve Ay Duası Gecesi için bana verdiğiniz kartı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200146
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761200146,
					"content": "#Ha, o zaman bu macerayı temsil eden bir şey olmalı, öyle mi? Pekala. Sen seç {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200120,
					"content": "Gerçekten özelmiş...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200121
					]
				}
			]
		},
