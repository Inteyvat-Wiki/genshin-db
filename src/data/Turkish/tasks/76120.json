				},
				{
					"id": 761200302,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200303
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200303,
					"content": "Epey memnun görünüyor... Vay canına, hemen tuvalin başına geçti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200304,
					"content": "Biliyor musun Columbina, Paimon şimdi düşününce fark etti de Maalaus'un resimleri senin doğduğun andan bugüne kadarki hikayenin neredeyse tamamını anlatıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200305,
					"content": "Ama o hikaye henüz bitmedi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761200306
					]
				},
				{
					"id": 761200306,
					"content": "Aynen! Zaten Paimon yetenekli ressamımızdan daha fazla eser görmek istiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200307,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200308
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 761200308,
					"content": "Aa, bitirdin mi hemen? Her zamanki gibi pek hızlısın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200309,
					"content": "Paimon bir baksın... Ooo! Bu çok güzel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200310,
					"content": "Paimon, Teyvat'ın aydan bakınca bu kadar güzel göründüğünü bilmiyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761200311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761200311,
