			"dialogs": [
				{
					"id": 220270301,
					"content": "Nanatsuki ne yapmam gerektiğini söyledi, değil mi? Ama tam olarak ne adamalıyım bilmiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270302
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270302,
					"content": "Sevdiğim şeylerden biri olacaksa o zaman Üç Renkli Dango olmalı. Onları o kadar çok seviyorum ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270303
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270303,
					"content": "Üç Renkli Dango adamak saygısızlık olur mu ki? Daha öncesinde Konpeito Şekeri adamıştım ama cevap alamamıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270304
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270304,
					"content": "Ayrıca bazılarının poşetlere çiçek doldurup adadıklarını duydum. Dangoya göre çok daha uygun bir adak olabilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270305
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270305,
					"content": "#Ne yapmalıyız? Sence ne adamalıyız {F#ablacığım}{M#abiciğim}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
			]
		},
		{
