			},
			"dialogs": [
				{
					"id": 220270101,
					"content": "Şu ahşap ürünleri nasıl yapılıyor acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270102
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270102,
					"content": "Ahşap ürünlerini ne yapacaksın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270103
					]
				},
				{
					"id": 220270103,
					"content": "#Merhaba {F#abla}{M#abi}. Şey, daha önce tapınağın ilahi müdahalesi diye bir şey duymuş muydun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270104
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270104,
					"content": "Duyduğuma göre tapınağa bir şeyler adarsan dileklerin gerçek olabilirmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270105
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270105,
					"content": "Ben de ahşap ürünlerinin değerli olduğunu düşünüyorum; onları bir adak olarak kullanırsam kesin bir geri dönüş alırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270106
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270106,
					"content": "Ancak ne yazık ki ahşap ürünü alacak kadar param yok. Bu yüzden kendi başıma bir ahşap ürünü yapmak istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270107
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270107,
					"content": "Yayoi Ahşap Ürünlerinde çalışan Nanatsuki'nin ahşap konusunda çok yetenekli olduğunu duydum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270108
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270108,
					"content": "#Ona gidip ahşap ürünlerinin nasıl yapıldığını sorabilir misin {F#ablacığım}{M#abiciğim}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270109,
						220270111
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270109,
					"content": "Sorun değil, hadi gidelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270110
					]
				},
				{
					"id": 220270110,
					"content": "#Teşekkür ederim {F#ablacığım}{M#abiciğim}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270111,
					"content": "Sen neden gitmiyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270112
					]
				},
				{
					"id": 220270112,
					"content": "Nanatsuki genelde çok ciddi birisidir, kendi başıma gidip sormaya korkuyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270113
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270113,
					"content": "#Ancak benimle gelirsen daha iyi olur {F#ablacığım}{M#abiciğim}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
			]
		},
		{
			"id": 2202702,
			"completionStepIds": [
				2202702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
