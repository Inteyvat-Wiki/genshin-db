				"objectNames": [
					"Yayoi Nanatsuki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220270201,
					"content": "Merhaba, size nasıl yardımcı olabilirim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270202
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270202,
					"content": "Ah... Şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270203
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270203,
					"content": "Ahşap ürünleri hakkında bilgi almak istiyor da...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270204
					]
				},
				{
					"id": 220270204,
					"content": "Ah, tapınağa adak olarak sunmak için kendine bir tane ahşap ürünü mü yapmak istiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270205
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270205,
					"content": "Lütfen Nanatsuki, gerçekleşmesini çok istediğim bir dileğim var! Bu nedenle... Merak etme, gizli formülünü kimseye söylemem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270206
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270206,
					"content": "Boyama formülünün bir önemi yok ki. Güzel bir ahşap ürünü yapmak istiyorsan, boyadan ziyade bu konuda uzun zaman boyunca tecrübe edinmiş olman daha önemli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270207
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270207,
					"content": "Mesele sadece zaman değil; aynı zamanda paran da olmalı. Bana bakma, ben dört nesildir ahşap ürünleri yapan bir aileden geliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270208
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270208,
					"content": "Ahşap üzerine çalışmak için Sumeru'ya bile gittim. Yani bir gecede öğrenebileceğin bir şey değil bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270209
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270209,
					"content": "Öyle mi? Ama... Ben tapınağa başka ne sunabilirim bilmiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270210
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270210,
					"content": "Bana soracak olursan tapınağa sunduğun adağın değeri önemli değil. Senin hislerini yansıtıyor olması gerekir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270211
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270211,
					"content": "En içten hislerinle ve niyetinle en sevdiğin eşyaları adarsan hükümdarlardan cevap alabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270212
					],
					"speakerTitle": "Yayoi Nanatsuki"
				},
				{
					"id": 220270212,
					"content": "En içten hislerim ve niyetim... Sevdiğim şeyler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270213
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270213,
					"content": "Şey, anladığımdan emin değilim ama yine de teşekkür ederim, Nanatsuki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270214
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270214,
					"content": "#O zaman önce tapınağa gidelim {F#ablacığım}{M#abiciğim}. Adağıma karar vermem için hâlâ yardımına ihtiyacım var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
			]
		},
		{
