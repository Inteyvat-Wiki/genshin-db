			"dialogs": [
				{
					"id": 220270401,
					"content": "Üç Renkli Dango adayalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270402
					]
				},
				{
					"id": 220270402,
					"content": "Gerçekten mi? Tamam o zaman! Şanslıyız ki yanımda bir tane getirmiştim. Annem benim için yapmıştı ama yemedim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270403
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270403,
					"content": "Haydi adayalım o zaman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270601
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270601,
					"content": "Ey Hükümdar, beni kutsa ve dileklerimin gerçekleşmesine yardım et...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270602
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270602,
					"content": "#Bu ana dek yanımda durduğun için teşekkür ederim {F#ablacığım}{M#abiciğim}. Lütfen bunları al, hepsi senin için!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270603
					],
					"speakerTitle": "Shouta"
				},
				{
					"id": 220270603,
					"content": "Yarın buraya tekrar geleceğim. Umarım o zamana kadar bir cevap alırım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouta"
				}
			]
		},
