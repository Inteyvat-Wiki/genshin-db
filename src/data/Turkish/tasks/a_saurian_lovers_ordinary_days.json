			"dialogs": [
				{
					"id": 750240822,
					"content": "\"Kadife\" adlı Tepetlizor yenildikten sonra yer altına girip kimsenin onu bulamayacağı bir yere saklanıyor. Bunu fırsat bilip yaralı kişiyi kontrol etmeye gidiyorsun...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750240801
					]
				},
				{
					"id": 750240801,
					"content": "Görünürde bir yara yok... Hey, sen iyi misin? Paimon'u duyabiliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240802,
					"content": "... Hımm? Kadife? Narin ruhlu şey seni. Beni merak mı ettin yoksa? Hiç merak etme. Seni ürkütmeden oyun oynayabilmek için bir süredir kendimi eğitiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240803
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240803,
					"content": "#Hey, Paimon Paimon'dur, duydun mu? Kadife falan değil! {NICKNAME}, sence düşerken başını yaralamış olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240804,
						750240805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240804,
					"content": "Umarım başı yakında düzelir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240806
					]
				},
				{
					"id": 750240806,
					"content": "Bir saniye. Sen Kadife değilsin. Neler oluyor? Bana ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240807
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240807,
					"content": "Ona üç Sürüngen tarafından nasıl kuşatıldığını ve Kadife'nin onu nasıl bayılttığını anlatıyorsun...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750240808
					]
				},
				{
					"id": 750240808,
					"content": "Demek öyle oldu. Sizi uğraştırdığım için özür dilerim. İsmim Icayo. Gördüğünüz üzere, Sürüngenleri kovalamayı seven bir maceracıyım... Ancak bazen onların da beni yakaladığı oluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240809
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240809,
					"content": "Bir süre yataktan çıkamadığım bir sağlık problemi yaşadım. O süreçte dayanıklılığım ciddi oranda düşmekle kalmadı, aynı zamanda Sürüngenlerle de düzenli olarak bir araya gelemedik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240810
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240810,
					"content": "Bu kez kampa bile varamadan etrafımı kuşattılar... Ne kadar şanslıyım ki birileri iyi olup olmadığımı merak etmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240811,
						750240812
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240811,
					"content": "Gerçekten çok pozitif düşünüyorsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240813
					]
				},
				{
					"id": 750240813,
					"content": "Neyse, seni kurtarmaya çalışırken... Kadife ile bir çatışma yaşadık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240814,
					"content": "Endişelenecek bir şey yok. Eminim onun için diğer oyunlardan bir farkı yoktu. Muhtemelen yenildiği için bir yerlerde somurtup duruyordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240815
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240815,
					"content": "Görünüşüne rağmen narin bir ruhu vardır. Birazdan gidip gönlünü alırım, dediğim gibi merak edilecek bir durum yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240816
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240816,
					"content": "Pekala. İyi görünüyorsun. Boşuna endişelenmişiz ama Paimon iyi olmana sevindi yine de.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240817,
					"content": "Bunun için minnettarım. Bu arada, çok değerli bir şey değil ama... Lütfen şu Ekşi Soslu Ceviche tarifini alın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240818
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240818,
					"content": "Dalgacık bu yemeğe bayılıyor... Belki sizin yoldaşınız da çok sever!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240819
					],
					"speakerTitle": "Icayo"
				},
				{
					"id": 750240819,
					"content": "Roooaa... Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240820
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240820,
					"content": "#Hımm? Denemek mi istiyorsun? Merak etme, {NICKNAME} sana hazırlayacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240821
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240821,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750240812,
					"content": "Öyle mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240813
					]
				},
				{
					"id": 750240805,
					"content": "Öyleyse sıkıntı büyük...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240806
					]
				}
			]
		},
