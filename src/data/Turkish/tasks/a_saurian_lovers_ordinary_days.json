			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750240701,
					"content": "(Burada bir günlük var...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240702,
						750240706,
						750240710,
						750240714
					]
				},
				{
					"id": 750240702,
					"content": "(İlk kısmı oku.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240703
					]
				},
				{
					"id": 750240703,
					"content": "\"... Bugün yağmurlu bir gün. \"Dalgacık\"a onun çok sevdiği <color=#00E1FFFF>Ekşi Soslu Ceviche</color> hazırladım. Onun memnuniyetini görünce her şeye değdiğini anladım...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240704
					],
					"speakerTitle": "İsimsiz Günlük"
				},
				{
					"id": 750240704,
					"content": "\"... Yavaş yavaş yüzmesine rağmen ona biraz <color=#00E1FFFF>Ekşi Soslu Ceviche</color> uzatınca... Birdenbire sudan çıktı ve görüntüsü oldukça sevimliydi...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240705
					],
					"speakerTitle": "İsimsiz Günlük"
				},
				{
					"id": 750240705,
					"content": "\"... Bana olan sevgisinden asla şüphem yok. Yalnızca, <color=#00E1FFFF>ceviche'i</color> benden biraz daha fazla seviyor olabilir...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İsimsiz Günlük"
				},
				{
					"id": 750240706,
					"content": "(İkinci kısmı oku.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240707
					]
				},
				{
					"id": 750240707,
					"content": "\"... Büyük ve yuvarlak ışıldayan gözler, kıvrımlı bir kuyruk ve neşeli haykırışlar... Ah Yeşim, senden daha sevimli bir Sürüngen var mı bu dünyada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240708
					],
					"speakerTitle": "İsimsiz Günlük"
				},
				{
					"id": 750240708,
					"content": "\"... Ne aldatıldın ne de kendinden şüphe ettirdin, sanki tüm yaşam senin arkadaşınmış ve seninle oyunlar oynarken müthiş zaman geçiriyormuş gibi...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240709
					],
					"speakerTitle": "İsimsiz Günlük"
				},
				{
					"id": 750240709,
					"content": "\"... Yoğun olmasaydım seninle tüm gün oyunlar oynamak, güneş ışınlarının parça parça sızdığı ormanda hızla ilerlerken seni seyretmek isterdim. Tıpkı rüzgarın bir çocuğu gibi, özgür bir ruhla...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İsimsiz Günlük"
				},
				{
					"id": 750240710,
					"content": "(Üçüncü kısmı oku.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240711
					]
				},
				{
					"id": 750240711,
					"content": "\"... Senin nerede olduğunu bulmak için dağları ve vadileri aştım. Beni gerçekten görmek istemeseydin ayrılabilirdin...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240712
					],
					"speakerTitle": "İsimsiz Günlük"
				},
				{
					"id": 750240712,
					"content": "\"... Ancak benim yürüme hızımı hesaba katarak sık sık mola verdin, hatta benim için bir sürü Tahıl Meyvesi topladın. Şu parlak taşlardan bahsetmiyorum bile...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240713
					],
					"speakerTitle": "İsimsiz Günlük"
				},
				{
					"id": 750240713,
					"content": "\"... Ah Kadife, benim sevgili Kadife'm, senin bu sert kabuğunun altında yatan narin kalbini bir tek ben tanırım. Sert bir savaşçı olmayı hiçbir zaman istememiştin zaten...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İsimsiz Günlük"
				},
				{
					"id": 750240714,
					"content": "(Pekala, okumayı bırak...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
