						750240905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240905,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}, Yeşim'i oradan uzaklaştırdığında yerdeki kişinin iyi olup olmadığını kontrol edelim, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
