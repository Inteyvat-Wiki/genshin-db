			"dialogs": [
				{
					"id": 750240601,
					"content": "Şraar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240602
					],
					"speakerTitle": "\"Kadife\""
				},
				{
					"id": 750240602,
					"content": "Telaşlanma, yalnızca şuradaki adamın yaralanıp yaralanmadığını kontrol ediyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240603,
						750240605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240603,
					"content": "Sanırım düello zamanı geldi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240604
					]
				},
				{
					"id": 750240604,
					"content": "Hadi, bu kadar erken pes etme! Bak, sana zarar vermek istemiyoruz ve... Doğan gereği senin savaşçı bir tip olmadığını biliyoruz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240606,
					"content": "Şrarr! Grarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750240607
					],
					"speakerTitle": "\"Kadife\""
				},
				{
					"id": 750240607,
					"content": "Eyvah... Daha da sinirlendi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750240605,
					"content": "\"Ah Kadife, sevgili Kadife'm...\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750240606
					]
				}
			]
		},
		{
