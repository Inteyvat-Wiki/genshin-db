			"dialogs": [
				{
					"id": 150450601,
					"content": "Vay be, çok hoş görünüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450602
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450602,
					"content": "Buraya gelin millet, birlikte fotoğraf çekileceğiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450603
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450603,
					"content": "Fena değil, hiç fena değil! Bu sabah hepiniz çok enerjik görünüyorsunuz. Ne saçı dağılan var ne de yorgun yorgun bakan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450604
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450604,
					"content": "Böyle şeylere dikkat ediyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450605,
					"content": "Tabii ki, detaylara dikkat etmesem iyi bir rehber olabilir miydim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450606
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450606,
					"content": "Ben de güzel bir içkinin kıymetini bilmesem iyi bir ozan olabilir miydim hiç?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450607
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450607,
					"content": "... Bunun konumuzla ne ilgisi var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450608,
					"content": "Hahaha! Nasıl oldu bilmiyorum ama ben ne demek istediğini çok iyi anladım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450609
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450609,
					"content": "Beraber saçmalamak arkadaşlığın şanındandır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450610
					]
				},
				{
					"id": 150450610,
					"content": "Gerçekten öyle mi düşünüyorsun? Yoksa sırf Detone Ozan üzülmesin diye rol mü yapıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450611,
					"content": "Bence de birazcık saçmalamaktan zarar gelmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450612
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150450612,
					"content": "Bu Asha saç bandını tak bakalım. Sana hepimizden bir hediye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450613
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450613,
					"content": "Aa, sağ olun!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450614
					]
				},
				{
					"id": 150450614,
					"content": "Çok yakıştı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450615
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450615,
					"content": "Tamam o zaman...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450616
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450616,
					"content": "Üç, iki, bir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450617
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450617,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450618,
					"content": "Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450619
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450619,
					"content": "... Pardon, tüm bu saçmalamalar Paimon'un kafasını karıştırdı. Zihni tamamen bomboş şu an...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450620,
					"content": "Hiç bitsin istemiyorsun, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450621
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150450621,
					"content": "O sözcükleri söylediğinde tatil resmen sona erecek diye mi çekiniyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450622
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150450622,
					"content": "Nasıl ya... Ara Bulucuların zihin okuyamadığını sanıyordu Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450623
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450623,
					"content": "Haha, Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450624
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450624,
					"content": "Merak etme Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450625
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450625,
					"content": "Ateş Hükümdarı'na dileğinde söylediğin gibi, elbet yine yaz gelecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450626
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450626,
					"content": "Herkes kendi yoluna gitse bile, arkadaşlığımıza değer verdiğimiz sürece bir yerlerde birbirimize denk geleceğimizden eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450627
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450627,
					"content": "Bennett'in ağzı iyi laf yapmaya başladı, değil mi Profesör Venti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450628
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450628,
					"content": "Şey, böyle bir konuda övgü kabul edemem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450629
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450629,
					"content": "Ses tonun öyle demiyor ama... Hadi hadi, tam da Paimon'a ilham gelmişti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450630
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450630,
					"content": "Tekrar denemeye ne dersiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450631
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450631,
					"content": "Evet, bu sefer hep birlikte söyleyelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450632
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450632,
					"content": "Ne diye bağıralım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450633
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150450633,
					"content": "Şans yıldızı olur mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450634
					]
				},
				{
					"id": 150450634,
					"content": "Olur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450635
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450635,
					"content": "Üç, iki, bir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450636
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450636,
					"content": "Şans yıldızı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450641
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450641,
					"content": "Arkadaşlarınla harika bir zaman geçiriyorsun...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150450642
					]
				},
				{
					"id": 150450642,
					"content": "... Ee, gelecek planların neler Bennett?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450643
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150450643,
					"content": "Karar vermekte zorlanırsan dilediğinde Kaplıca Halkına gelip canının istediği kadar kalabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450644
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450644,
					"content": "Bu düşünceli teklifin için sağ ol Mualani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450645
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450645,
					"content": "Aslında benim için yaptığı her şey adına teşekkür etmeye Ateş Hükümdarı'nın yanına gittim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450646
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450646,
					"content": "Bana girdiğimiz Zindanın aslında Mare Jivari'nin Hiçlik tarafından oluşturulan bir simülasyonu olduğunu söyledi. Zindan çok dengesizmiş, artık tamamen kaybolmuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450647
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450647,
					"content": "Daha sonra geleceğim hakkında konuşmaya başladık ve Natlan'da kalmak istersem beni seve seve kabul edeceğini, kararım ne olursa olsun saygı duyacağını söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450648
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450648,
					"content": "Üzerine uzun uzun düşündükten sonra... Mondstadt'a dönmeye karar verdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450649
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450649,
					"content": "Babalarını özledin, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450650
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150450650,
					"content": "Evet, sebeplerden biri bu. Bu macerada olan biten her şeyi anlatacağıma dair söz vermiştim onlara, sözümden geri dönemem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450651
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450651,
					"content": "Ama aynı zamanda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450652
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450652,
					"content": "Annem ve babamla vedalaşırken bir gün Teyvat'taki en efsanevi maceracı olacağıma dair söz verdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450653
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450653,
					"content": "Hiçbir maceracı tek bir yerde uzun süre kalmamalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450654
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450654,
					"content": "Bennett...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450655
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450655,
					"content": "Peki ya Natlan'dan ayrıldıktan sonra şansın yine kötüye giderse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450656
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450656,
					"content": "Haha, hiç sorun değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450657
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450657,
					"content": "Bu macerada gördüğüm samimiyet ve iyilik, ileride karşılaşacağım tüm zorluklarla yüzleşmeme yetecek cesareti verdi bana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450658
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450658,
					"content": "Kendi kaderimi şekillendirmeye çalışırken bir yandan da onların nezaketini başkalarına da göstermek istiyorum. Hep inanmışımdır buna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450659
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450659,
					"content": "Herkes kadehlerini kaldırsın! Liderimize!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450660
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150450660,
					"content": "Liderimiz Bennett'e!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450661
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450661,
					"content": "Şerefe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450662
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450662,
					"content": "Iıı... Yine sabahlayacağız, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450663
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450663,
					"content": "Hehe, eğlence dur durak bilmiyor! Sırada kim var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450664
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450664,
					"content": "Bennett birkaç defa az kalsın uykuya dalıyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450665
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150450665,
					"content": "Hayır, hayır... Hâlâ... Devam edebilirim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450666
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150450666,
					"content": "Siz gidip biraz dinlenin. Görünüşe göre enerjin henüz bitmemiş, o yüzden temizliği sana bırakıyorum Mualani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450667
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150450667,
					"content": "Ha? Neden ben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450668
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450668,
					"content": "#{NICKNAME}, birlikte yürüyüşe çıkalım mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450669
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450669,
					"content": "Çok güzel bir yer biliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 1504507,
