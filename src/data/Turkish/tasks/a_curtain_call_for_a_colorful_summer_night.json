					}
				]
			},
			"dialogs": [
				{
					"id": 150450701,
					"content": "Detone olabilirsin ama manzaranın iyisinden anlıyorsun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450702,
					"content": "Haha, beğendiğine sevindim. Bazı hikayeleri kuşların bile duymaması gerekir. Sadece yükseklerdeki yıldızlara anlatılırlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450703
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450703,
					"content": "Uyku öncesi bir hikaye zamanı mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450704
					]
				},
				{
					"id": 150450704,
					"content": "Haha... Daha çok \"Zaman\"ın kendisiyle başlayan bir hikaye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450705
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450705,
					"content": "Uzun, çok uzun zaman önce, \"Za{RUBY#[D]Istaroth}man\" bu dünyanın hikayesini yazmaya başladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450706
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450706,
					"content": "Onun gözünde tüm canlılar, hem değerleri hem de önemsizlikleri bakımından eşitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450707
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450707,
					"content": "Kadim bir parşömen gibi; herkesi, her olayı, her karşılaşmayı ve her ayrılığı hafızasına kazıdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450708
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450708,
					"content": "O zamanlar, ben henüz bir Rüzgar ruhuyken, Bin Rüzgar Tapınağında şans eseri \"Zaman\" ile karşılaşmıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450709
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450709,
					"content": "Dileklerimi duyduğunda gücünün ve iktidarının bir kısmını bana verdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450710,
						150450711
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450710,
					"content": "Rüzgarla gelen hikayenin tohumları...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450712
					]
				},
				{
					"id": 150450712,
					"content": "\"Zaman ve Rüzgar\" hikayesini duymuşsun anlaşılan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450713
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450713,
					"content": "Büyüleyici, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450714
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450714,
					"content": "Ayinlere, şiirlere, harabelere ve kadim metinlere kazınmış anılar sayesinde önemsiz gördüğü varlıklar onunla buluştular... Hem de defalarca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450715
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450715,
					"content": "Paylaşmak istediğin hikaye bu muydu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450716,
					"content": "Hımm... Hikayenin başlangıcı demek daha doğru olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450717
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450717,
					"content": "Mare Jivari'nin aşınması da bizzat zamanla bağlantılı. Başka bir deyişle, zamanın var olacak her anında mevcut olan bir felaket.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450718
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450718,
					"content": "\"Zaman\"ın aksine ben kalbimde pek çok dileğe yer verdim hep.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450719
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450719,
					"content": "Beş yüz yıl önce, Mare Jivari'deki aşınmanın Tenochtzitoc'un ötesine geçmesini engellemek için...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450720
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450720,
					"content": "... Onu zaman çizgisinin dışına atarak \"Rüzgarsız Diyar\"a çevirdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450721
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450721,
					"content": "Mare Jivari'nin ortadan kaybolmasının ardındaki gerçek bu mu yani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450722
					]
				},
				{
					"id": 150450722,
					"content": "Pardon, sanırım kafanı karıştırdım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450723
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450723,
					"content": "Mare Jivari'nin yirmi otuz yıl önce Tenochtzitoc'tan nasıl kaybolduğunu merak ediyorsan, bu soruyu en iyi cevaplayabilecek kişi ben olmayabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450724
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450724,
					"content": "Mare Jivari, kendisine ait olmayan pek çok hikaye taşır... Ben sadece hikayelerden birinde rol oynadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450725
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450725,
					"content": "Beş yüz yıl önce yaptığım seçimin bir bedeli vardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450726
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450726,
					"content": "Ruhu Mondstadt'a geri dönemeyenler oldu... Bazıları da burada kalıp Monetoo'larla birleşerek günümüzdeki Ashalara dönüştü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450727
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450727,
					"content": "Yani Tenochtzitoc'a gelmenin sebebi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450728,
					"content": "Doğru. Ateş Hükümdarı Mavuika ile iş birliği yapmaya geldim buraya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450729
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450729,
					"content": "Mumu bunun için mi yaktık?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450730
					]
				},
				{
					"id": 150450730,
					"content": "Bu da doğru. Ateşi aramızda işaret olarak kullanıyorduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450731
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450731,
					"content": "İçeri girmemin tek yolu Mavuika'nın o alan ve gerçek Mare Jivari arasında bir gedik açmasıydı. Dönmek isteyen ruhların tamamını ancak bu şekilde geri getirebilirdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450732
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450732,
					"content": "Anıları geri getirme numarama gelirsek... Heh, bunu ilk kez yapmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450733
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450733,
					"content": "Mavuika bir de bizi tanıştırmak istediğinizden bahsetti... Görünüşe göre sizden önce davrandım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450734
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450734,
					"content": "Onun da benim gibi kaliteli şaraba ve özgürlüğe düşkün olduğunu görmek çok hoşuma gitti. Gayet iyi anlaştık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450735,
						150450736
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 150450735,
					"content": "Bu kez gerçekten kendini aşmışsın...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450737
					]
				},
				{
					"id": 150450737,
					"content": "Aslında birkaç gün kendime gelemedim... Hatta şu anda bile çok yorgun hissediyorum.",
					"roleType": "TALK_ROLE_NPC",
