			"dialogs": [
				{
					"id": 150450401,
					"content": "#Günaydın {NICKNAME}, günaydın Paimon! Böyle hazırlanmışken gelip bir selam vereyim dedim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450402
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450402,
					"content": "Günaydın Mualani! Nasıl bu kadar enerjik olabiliyorsun? Dün gece en fazla partileyen sen değil miydin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450403,
					"content": "O dünde kaldı! Sağlam bir uyku çekince kendime geldim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450404
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450404,
					"content": "Bakın ne getirdim. Albüm tamamlama ödülünüzü sizin yerinize aldım, gitmenize gerek kalmadı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450405
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450405,
					"content": "Aaa! Sağ ol Mualani, çok düşüncelisin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450406,
					"content": "İyi bir rehber, konu yardım etmek olduğunda hep bir adım önde olmalıdır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450407
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450407,
					"content": "İşten bahsetmişken, tatilimizin de sonuna yaklaştık artık... Neyse, iyi oldu. Yakında dönmezsem biricik köpeğim beni unutacak diye korkuyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450408
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450408,
					"content": "Diğerleriyle de konuştum, herkes dönmeye hazır gibi görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450409
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450409,
					"content": "Bazıları ailelerini özlemiş, bazıları da Karahindiba Şarabı yoksunluğu sendromu yaşıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450410
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450410,
					"content": "Chasca bile evini özlemiş. Açıkça söylemez tabii ama geceleri hep Çiçek Tüyü Klanının olduğu tarafa bakıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450411
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450411,
					"content": "Çok iyi anlıyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150450412
					]
				},
				{
					"id": 150450412,
					"content": "Ama yaz daha bitmedi! O yüzden... Kalan zamana unutulmaz birkaç anı daha sığdıralım bence!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450413
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450413,
					"content": "Bir grup fotoğrafı daha çekilebiliriz mesela!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450414
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150450414,
					"content": "Hemen şu an çekilmeye ne dersiniz? O kadar zaman geçirdikten sonra Paimon buraya biraz bağlandı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150450415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150450415,
					"content": "Harika fikir! Siz bu duvarı süsleyin, ben de gidip diğerlerini toplayayım. Meydanın orada buluşuruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				}
			]
		},
