			"dialogs": [
				{
					"id": 762010201,
					"content": "Kötü davranıyorsun Metta! Ben sadece maceranda eğlenmeni istemiştim... Neden böyle şeyler söylemek zorundasın ki, hıh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010202
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010202,
					"content": "Her aklına eseni yapmaktan vazgeçmezsen yakında herkesi kendine düşman edeceksin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010203
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010203,
					"content": "Aklıma her eseni yapmıyorum! B-Benim de kendi planlarım var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010204
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010204,
					"content": "Vay canına, planlar ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010205
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010205,
					"content": "Öf... Yine beni başından savıyorsun. Artık seninle konuşmuyorum! Sonra pişman olsan da nafile, iş işten geçmiş olacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010206
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010206,
					"content": "... Aa, Linnea! Metta aslında...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010207
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010207,
					"content": "Vesa olan biteni zar zor toparlayıp anlatırken bunun çocuklar arasında geçen sıradan, küçük bir atışma olduğu anlaşılır...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						762010208
					]
				},
				{
					"id": 762010208,
					"content": "Nasıl bakarsan bak bu işte benim bir suçum yoktu, haksız mıyım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010209
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010209,
					"content": "Ona bakarsan... Benim de bir suçum yoktu! Linnea Abla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010210
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010210,
					"content": "Hımm... Bazen böyle şeyler olur işte. Aslında kimse suçlu değildir ama yine de işler istediğimiz gibi gitmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010211
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010211,
					"content": "Aa, bu aynı Gece Çiçeğinin temsil ettiği, Donuk Ayın Çocuklarından olan iki kız kardeşin hikayesi gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010212
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010212,
					"content": "Hı? İki kız kardeşin hikayesi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010213
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010213,
					"content": "Evet. Bir zamanlar Donuk Ayın Çocukları arasında iki kız kardeş olduğunu duymuştum. Tıpkı biri kırmızı biri mavi açan Gece Çiçeği gibi, kişilik olarak birbirlerinden çok farklılarmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010214
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010214,
					"content": "İki kız kardeş de doğru olduğuna inandığı şeyi yapmış ama bu yüzden yolları ayrılmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010215
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010215,
					"content": "Derler ki küçük kız kardeş, ablası sayısız hayat kurtarmış olmasına rağmen onu geride bıraktığı için ablasını asla affetmemiş... Sonunda ölene dek birbirlerini bir daha hiç görmemişler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010216
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010216,
					"content": "Aa... Donuk Ayın Çocuklarının böyle hikayeleri olduğunu bilmiyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010217
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010217,
					"content": "Ben de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010218
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010218,
					"content": "Hımm... Bunu gezgin bir ozandan duymuştum. Belki biraz abartmıştır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010219
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010219,
					"content": "Ha, demek ki bu uydurma bir hikaye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010220
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010220,
					"content": "Hikaye tamamen doğru olmasa bile verdiği ders yine de geçerli, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010221
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010221,
					"content": "İkisi de haksız olduğunu düşünmüyordu. İkisi de kendi seçiminin doğru olduğundan emindi ama bu seçimler birbirlerini sonsuza dek kaybetmelerine neden oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010222
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010222,
					"content": "Haklı olduğunu ispatlamak bir dostunu kaybetmek anlamına geliyorsa... Siz neyi seçerdiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010223
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010223,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010224
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010224,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010225
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010225,
					"content": "Şey... Aslında bir macerada rotadan ufak tefek sapmalar yaşamak o kadar da kötü bir şey değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010226
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010226,
					"content": "... Evet! Şimdi düşününce, Metta'nın benimle macerada geçirdiği zaman çok değerli. Eğer sürekli fikrimi değiştirirsem hiçbir şeyin tadını çıkaramayabiliriz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010227
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010227,
					"content": "Ben... Bir dahaki sefere daha iyi plan yapacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010228
					],
					"speakerTitle": "Vesa"
				},
				{
					"id": 762010228,
					"content": "Hehe, ikinizin tekrar anlaştığını gördüğüme sevindim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010229
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762010229,
					"content": "Bir dahaki sefere Vesa ile maceraya çıktığımızda bulduğumuz tüm sıra dışı taşları Speranza'ya getireceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762010230
					],
					"speakerTitle": "Metta"
				},
				{
					"id": 762010230,
					"content": "Anlaştık! Öyleyse size şimdiden teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnea"
				}
			]
		},
