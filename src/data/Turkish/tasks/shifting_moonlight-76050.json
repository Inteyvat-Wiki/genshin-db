				{
					"id": 760500102,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500103
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760500103,
					"content": "Vay canına, bugün ne kadar da hareketli burası! Bütün Kuuhenkiler Columbina'nın etrafında dans ediyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500104,
					"content": "Bir dakika... Dans etmiyorlar sanki. Onu sevimlilikleriyle canlı canlı gömmeye çalışıyorlar gibi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500105,
					"content": "Y-Yardım edin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500106
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760500106,
					"content": "Elini ver.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500107
					]
				},
				{
					"id": 760500107,
					"content": "Oh... Teşekkürler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500108
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760500108,
					"content": "Kuuhenkiler neden az önce öyle davrandılar? Normalde o kadar enerjik değiller, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500109,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500110
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760500110,
					"content": "Şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500111
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760500111,
					"content": "Küçüklerle bir oyun oynamaya karar vermiştim, biraz fazla kaptırdılar galiba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500112
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760500112,
					"content": "Oyun bittikten sonra etrafını sarmaları... Sanki yavru köpeklere benziyorlar, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500113,
					"content": "Belki de bu onların minnettarlıklarını gösterme biçimidir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500114
					]
				},
				{
					"id": 760500114,
					"content": "Evet... Ama bu seferki minnettarlıkları, beklenmedik bir kar fırtınasına yakalanmak gibiydi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500115
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760500115,
					"content": "Öyle diyorsun ama yine de onları şımartma fırsatını kaçırmazsın kesin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500116,
					"content": "Her neyse, siz de denemek ister misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500117,
						760500119
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760500117,
					"content": "Yani... Etrafımızı sarmalarını mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760500118
					]
				},
				{
					"id": 760500118,
					"content": "Evet... Ayarlayabiliriz. Sadece doğru cevabı vermen gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500121
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760500121,
					"content": "Olur tabii ki. Kuuhenkilerin kafaya taktığı oyunu görmek harika olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760500122,
					"content": "Hadi o zaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500123
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760500123,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760500124
					],
					"speakerTitle": "Kuuhenki"
				},
				{
					"id": 760500124,
					"content": "!!!",
