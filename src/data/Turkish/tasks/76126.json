			},
			"dialogs": [
				{
					"id": 761260201,
					"content": "Aa... Jahoda. Ne için gelmiştin? Hımm... Patron Nefer müsait mi şimdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260202
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260202,
					"content": "(Tahmin ettiğim gibi, Patron Nef'i görmek istiyor... Hımm, bu kadar ufak bir meseleyi ben halledebilirim.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260203
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260203,
					"content": "Bu kadar zahmet etmene gerek yok. Patron sana yardım etmem için beni gönderdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260204
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260204,
					"content": "Hı? N-Ne demek istiyorsun? Yani Patron Nefer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260205
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260205,
					"content": "Hep Donuk Ayın Çocuklarını ziyaret etmek istemiştin, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260206
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260206,
					"content": "Önce Lyylikki ile samimiyet kurup sonra da seni Donuk Ayın Çocuklarına götürmesini mi isteyecektin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260207
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260207,
					"content": "Ne? Leydi Nefer bunu biliyor muydu? Ama bu arzumu içimde sakladım, kimselere söylemedim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260208
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260208,
					"content": "(İşte şimdi patronun o süper havalı sözü söyleme zamanı! Neydi o laf ya? Iı... Hah!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260209
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260209,
					"content": "Bay Zompaynco, bir sır sakladığında sır sakladığın gerçeğini de saklamayı öğrenmen gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260210
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260210,
					"content": "Yoksa sırrını kalbinin en saklı köşelerine gizlesen bile rüzgar ona ulaşmanın bir yolunu bulur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260211
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260211,
					"content": "*iç çeker* Memleketimdeyken bile duygularımı gizleme konusunda iyi değildim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260212
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260212,
					"content": "(OH BE! Söyledim işte! Yaptığım pratikler işe yaradı, hehehe!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260213
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260213,
					"content": "Artık sırrımı bildiğinize göre bana yardımcı olup beni Bayan Lyylikki ile tanıştırır mısın? Ben bir yabancıyım, onu rahatsız etmek istemem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260214
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260214,
					"content": "Endişelenme, Lyylikki çok candan biridir. Yabancı olman ya da insan bile olmaman fark etmez, sana her türlü sıcakkanlı davranır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260215
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260215,
					"content": "Aa, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260216
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260216,
					"content": "Yine de önceden haber vermeden damlamak kabalık olur... Ama eğer onu tanıyorsan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260217
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260217,
					"content": "Tabii ki! Yemek dağıtmayı henüz bitirmiş olmalılar. Hadi gidelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260218
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260218,
					"content": "Ah! Bu arada, Patron bu sefer sizden ücret almayacağımızı söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260219
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260219,
					"content": "Ah, çok teşekkürler! Hemen eşyalarımı alayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zompaynco"
				}
			]
		}
	]
}