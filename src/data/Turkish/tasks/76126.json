			"dialogs": [
				{
					"id": 761260101,
					"content": "Jahoda? Ve... Bay Zompaynco. Sizin için ne yapabilirim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260102
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260102,
					"content": "Ben... Şey... Aslında...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260103
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260103,
					"content": "Donuk Ayın Çocuklarını ziyaret etmek istiyor ama söylemeye çekindiği için senden yardım istiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260104
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260104,
					"content": "Evet! Evet, tam olarak öyle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260105
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260105,
					"content": "M-Merhaba Bayan Lyylikki! Sizinle tanışmak bir şeref. Şey... Natlan'dan bu fosili getirdim size...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260106
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260106,
					"content": "Teşekkürler Bay Zompaynco ama... Biz zaten tanışmıştık, öyle değil mi? Bu kadar resmi davranmaya hiç gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260107
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260107,
					"content": "Ne? O zaman... Beni nasıl fark ettin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260108
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260108,
					"content": "Ben yemek dağıtırken hep etraftaydın, değil mi? Sıranın çevresinde dolanıyor, etrafında dönüp duruyor ama hiç sıraya girmiyordun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260109
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260109,
					"content": "Ben de yemek almak istediğini ama fazla utangaç olduğunu düşünerek senin için bir porsiyon ayırmaya başladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260110
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260110,
					"content": "Ama hiç gelip ayırdığım yemeği almadın. Hatta bugün gelmesen birinden yardıma ihtiyacın olup olmadığını kontrol etmesini rica edecektim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260111
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260111,
					"content": "Ah... Özür dilerim. Nasıl selam vereceğimden emin olamadığımdan tereddüt ediyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260112
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260112,
					"content": "Bayan Lyylikki... Donuk Ayın Çocuklarını ziyaret edebilir miyim o zaman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260113
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260113,
					"content": "Tabii ki. Daha önce de dışarıdan misafirlerimiz oldu. Ancak nedenini sorabilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260114
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260114,
					"content": "Fotoğraf çekip not almak, kayıtları incelemek ve mümkünse birilerine yerel efsaneler hakkında sorular sormak istiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260115
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260115,
					"content": "Ben Natlan Sürüngen Kalıntıları Derneğinin bir üyesiyim. Araştırmam için malzeme bulabilirsem harika olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260116
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260116,
					"content": "Anladım. Arşiv'de biraz vakit geçirmek istiyorsun demek... Dur bir düşüneyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260117
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 761260117,
					"content": "Pekala, sohbeti koyulaştırdığınıza göre bu görevi tamamlanmış sayıyorum. Patronuma gidip rapor vereyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260118
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761260118,
					"content": "Teşekkürler Bayan Jahoda! Ama... Seni o kadar uğraştırdım, karşılığını vereyim. Bunca yolu boşu boşuna gelmen yakışık almaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260119
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260119,
					"content": "Ve geri döndüğünde lütfen Patron Nefer'a minnetimi iletmeyi unutma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260120
					],
					"speakerTitle": "Zompaynco"
				},
				{
					"id": 761260120,
					"content": "Tabii ki. Ben artık gidiyorum o zaman. Siz ikiniz muhabbetin tadını çıkarın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
