			"dialogs": [
				{
					"id": 705280401,
					"content": "*iç çeker* Lonca gerçekten de bu kadar işin altından kalkabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280402
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280402,
					"content": "Ah, Gezgin! Seni daha önce fark etmediğim için özür dilerim. Bazı Lonca işlerini düşünüyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280403
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280403,
					"content": "Mondstadt'a Rüzgarçiçeği Festivali için gelmiş olmalısın, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280404
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280404,
					"content": "Tam zamanında geldin. Lonca da az önce ödül garantili çekişmeli bir oyun hazırlamıştı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280405
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280405,
					"content": "Ne dersin? Denemek ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280406
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280406,
					"content": "O halde önce sana bu küçük oyundan bahsedeyim. Tasarımcısı bu oyuna \"Çiçek Satrancı\" diyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280407
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280407,
					"content": "İlhamını, dalgalanan taç yaprakları ile onları kovalayan rüzgardan aldığını ve...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280408
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280408,
					"content": "... Oyunun amacının da... Bu yaprakları kovalarkenki duygusallığı yaşamak olduğunu söylemişti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280409,
						705280410
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280409,
					"content": "Vay be, oldukça ilginçmiş...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705280411
					]
				},
				{
					"id": 705280411,
					"content": "Yani tasarımcısı bir ozan olduğu için... Bilirsin ya, hayal gücü biraz yüksek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280412
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280412,
					"content": "Temel olarak, satrancın bu türünü oynarken satranç tahtasındaki Çiçek Balonlarından olabildiğince çok toplamalısın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280413
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280413,
					"content": "Balonları toplarken de çeşitli engellerden kaçınmalısın... Bu sırada sana destek olacak birkaç aletin de olacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280414
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280414,
					"content": "Hatta bu tasarımcı, bu oyunun tamamı için bir rehber hazırladı. Bunu daha sonra sana göstereceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705280415
					],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280415,
					"content": "İlgini çektiyse oynamakta özgürsün. Unutma, sadece katılarak bile ödül kazanabilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Plauen"
				},
				{
					"id": 705280410,
					"content": "Şey, biraz karışıkmış.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705280411
					]
				}
			]
		}
	]
}