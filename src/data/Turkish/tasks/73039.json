			"dialogs": [
				{
					"id": 730391101,
					"content": "Oley! Dumanı üstünde Turplu Sebze Çorbamız hazır! Aranaralar da kendi yemeklerini hazırlamayı bitirmiş olmalı.",
					"roleType": "TALK_ROLE_NPC",
