			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Arapacati",
					"Arachatora",
					"Arasaka",
					"Arapas",
					"Araphala"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730391224,
					"content": "#Yardım almak için hâlâ {NICKNAME} ile konuşmalısın yoksa geçen seferki yemeklerin aynısını yapacaksın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391201
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730391201,
					"content": "Aranara, Paimon'un söylediği pişirme yöntemini kullanarak senin rehberliğinde yemeği hazırlar.\\nSonrasında Aranaralarla afiyetle yersiniz.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730391202
					]
				},
				{
					"id": 730391202,
					"content": "Özbeöz Nara yemeğinin tadı nasıl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730391203,
					"content": "#Şey... Her ne kadar kardeşlerime yemek pişirmeyi öğretenin Nara {NICKNAME} olmasını öneren Arapacati olsa da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391204
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391204,
					"content": "Nara yemekleri... Naraların \"mutluluğun tadı\" dediği bu mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391205
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730391205,
					"content": "Mutluluk şu an benden uzaklaşıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391206
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730391206,
					"content": "Vanarana suyunun En İyi Su olduğu kesin ama o sudan yapılan yemek nasıl bu hale gelmiş?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391207
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730391207,
					"content": "Benzersiz Taze Meyve hâlâ leziz tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391208
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730391208,
					"content": "Aranaralar kötü olduğunu mu düşünüyor? Paimon'a epey leziz gelmişti ama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730391209,
					"content": "\"Kötü\" yemek nasıl olur bilmiyorum ama bunun tadı... \"etkili\". Yani son hız koşarken ağaca çarpmak gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391210
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391210,
					"content": "Vay be. Kültür çatışması denen şey bu olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730391211,
					"content": "#Yine de öyle demek ayıp kardeşlerim. Nara {NICKNAME} bunun yerine teşekkürü hak ediyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391212
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391212,
					"content": "*sızlanır* Özür dilerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391213
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730391213,
					"content": "\"Özür dilerim!\" değil \"Teşekkür ederim!\" de.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391214
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391214,
					"content": "#Teşekkür ederim Nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391215
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730391215,
					"content": "#Nara {NICKNAME} ve Paimon yemeği beğendiği sürece sorun yok! Onlara bakmayın. Nara arkadaşlarımız mutluysa biz de mutluyuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391216
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391216,
					"content": "#Tabii Nara {NICKNAME}, Nara Varuna'dan tamamen farklı. Nara Varuna bize kardeşlik hakkında çok şey anlattı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391217
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391217,
					"content": "#Ama Nara {NICKNAME} pek konuşmuyor. İyi hissetmiyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391218
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391218,
					"content": "#Bir şey söylesene {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391219,
						730391220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730391219,
					"content": "Çok düşüncelisin. Teşekkür ederim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730391222
					]
				},
				{
					"id": 730391222,
					"content": "#Öyle mi? Sevindim. Tekrar teşekkürler. Bu yapraklar Arapacati ve kardeşlerinden size hediye, Nara {NICKNAME} ve Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391223
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391223,
					"content": "Umarız ikiniz Vanarana'da \"mutluğun tadı\"nı çıkarmaya devam edersiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730391220,
					"content": "(Sessiz kal.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730391221
					]
				},
				{
					"id": 730391221,
					"content": "#Neyse. Endişelenmeye gerek yok Arapacati! {NICKNAME} iyi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730391222
					],
					"speakerTitle": "Paimon"
				}
			]
		},
