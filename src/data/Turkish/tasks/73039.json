			"dialogs": [
				{
					"id": 730390101,
					"content": "Tüm kardeşlerim artık hatalarından ders aldı. Utsava Festivali neşe dolu bir gün, o yüzden Arapacati sinirlenmemeli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390102
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730390102,
					"content": "Doğru Arapacati. Sinirlenme. Neşeli günler \"mutluluğun tadıyla\" kutlanmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390103
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730390103,
					"content": "Aşçılık eğitimimizin sonuçlarını açıklama zamanı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390104
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730390104,
					"content": "Epeydir hazırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390105
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730390105,
					"content": "Yaşasın, Utsava Festivali Ziyafeti! Paimon bunu dört gözle bekliyordu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390106,
						730390107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730390106,
					"content": "Evet! Utsava Festivali Ziyafeti!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730390108
					]
				},
				{
					"id": 730390108,
					"content": "Vanarana suyu en güzel sudur ve en güzel çorbalar bununla yapılır. Naranın seveceğine eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390109
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730390109,
					"content": "#Nara {NICKNAME} ve Paimon'a \"mutluluğun tadını\" sunacağım ve kardeşlerime yemek pişirmeyi \"öğretmelerini\" sağlayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390110
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730390110,
					"content": "Naraların seveceği yemekler yapmanın tek yolu bu. Misafirlere böyle davranılmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730390111
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730390111,
					"content": "#Onlara yemek pişirmeyi öğretir misin Nara {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730390107,
					"content": "Fazla umutlanmasak iyi olur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730390108
					]
				}
