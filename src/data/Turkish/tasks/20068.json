					"Grace"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200680401,
					"content": "Teşekkürler, bu kadarı yeter. Lütfen biraz bekle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680402
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680402,
					"content": "İşte hazır. Lütfen bu Mondstadt Mücverini Timmie'ye ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680403
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680403,
					"content": "Lütfen, bir dahakine böyle işlere kalkışma. Uğraştığına değmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680404
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680404,
					"content": "Lütfen bu tavsiyemi iyi dinle. Timmie'yi, beni hayal kırıklığına uğratma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680405
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680405,
					"content": "Tavsiyelerimi dinleyen olsaydı Rahibe Victoria bu kadar meşgul olmazdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				}
			]
		},
		{
			"id": 2006805,
