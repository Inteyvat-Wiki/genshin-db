			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Grace"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200680101,
					"content": "Ne yapsam ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680102
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680102,
					"content": "Ne oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680103
					]
				},
				{
					"id": 200680103,
					"content": "Ah, senmişsin. Tam zamanında geldin. Timmie bana, senin ördeklere ne yaptığını anlattı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680104
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680104,
					"content": "Sen... Sen... Nasıl desem? Yaptığın kahramanlıkları bilmiyor değilim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680105
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680105,
					"content": "Ama gerçekten cesaretini ve gücünü bu şekilde kullanmak zorunda mıydın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680106,
						200680107,
						200680108
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680106,
					"content": "Çok açtım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680109
					]
				},
				{
					"id": 200680109,
					"content": "Gerçekten aç olsaydın dürüst bir iş yapar, öyle karnını doyururdun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680110
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680110,
					"content": "Yeteneklerinle Maceracılar Loncasında kendine yer bulabileceğine eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680113
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680113,
					"content": "Olan olmuş artık ama Timmie'nin yaşananlardan dolayı morali çok bozuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680114
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680114,
					"content": "Ben... Bir ara Timmie'nin babası bana bir yemek tarifi öğretmişti. Timmie'nin en sevdiği yemek, Filanemo Mantarlı Mondstadt Mücveri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680115
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680115,
					"content": "Timmie'ye pişirmemiz için üç Filanemo Mantarı bulmama yardım eder misin? Bu şekilde hem onu biraz neşelendiririz hem de ondan özür dilemiş olursun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680116,
						200680117
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680116,
					"content": "Bu iş bende.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680118
					]
				},
				{
					"id": 200680118,
					"content": "Tamam o halde, hadi git bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680120
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680120,
					"content": "Filanemo Mantarlarına gelirsek... Şehrin güney kısmında, evlerin çatısındaki saçakların altında bulabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680121
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680121,
					"content": "Lütfen çabuk ol!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680117,
					"content": "Hemen hallediyorum!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680119
					]
				},
				{
					"id": 200680119,
					"content": "Üç tane yeterli! Bu kadar mantarla ne yapacaksın? Timmie'yi her kızdırdığında yemekle mi gönlünü alacaksın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680120
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680107,
					"content": "Bir kazaydı, gerçekten!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680111
					]
				},
				{
					"id": 200680111,
					"content": "O ördek ve güvercinlere kazara mı vurdun? Maceralarında karşılaştığın zorlu düşmanları da mı kazara yendin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680113
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200680108,
					"content": "Güç, bu tarz günlük eylemlerden doğar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200680112
					]
				},
				{
					"id": 200680112,
					"content": "Sen... Ben... Unut gitsin. Gerçekten çok yönlü bir \"gücün\" var galiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200680113
					],
					"speakerTitle": "Grace"
				}
			]
		},
