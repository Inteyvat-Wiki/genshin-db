			"dialogs": [
				{
					"id": 200680201,
					"content": "Hiç Filanemo Mantarı bulabildin mi? Şehirde, evlerin çatısındaki saçakların altında birkaç tane bulabilirsin.",
					"roleType": "TALK_ROLE_NPC",
