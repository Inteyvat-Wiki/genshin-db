				"points": []
			},
			"dialogs": [
				{
					"id": 230080301,
					"content": "Harika! İşte bu. Bir saniye, hemen yapıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080302
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080302,
					"content": "Bir süre sonra...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230080303
					]
				},
				{
					"id": 230080303,
					"content": "Tahmin ettiğim gibi oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080304
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080304,
					"content": "Tutuşu güçlü olsa da nemli toprak sertleştikten sonra kolaylıkla kırılıyor. Ama Yalancı Çiçek toprağıyla karıştırırsak katılaşan toprak daha esnek hale geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080305
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080305,
					"content": "Tek sorun karışıma katılaşmadan önce şekil verilememesi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080306
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080306,
					"content": "Fakat Bodurlopların ortamındaki toprağı ekleyince karışıma katılaşmadan önce çok daha iyi şekil verilebiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080307
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080307,
					"content": "Ne oldu bilmiyorum ama süreci anlatmam gerekirse toprak, Bodurlop gibi oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080308,
						230080309
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080308,
					"content": "Bunun adını \"Bodurloptoprağı\" koyabiliriz herhalde, ne dersin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080311
					]
				},
				{
					"id": 230080311,
					"content": "Bodurlopların bir özelliği karışımı bir şekilde etkilemiş gibi duruyor. O yüzden Bodurlop Özü eklesem daha etkili olur mu acaba diye düşündüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080312
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080312,
					"content": "Gerçekten de eklenen Bodurlop Özü miktarıyla karışımın şekil verilebilirliği ve sağlamlığı değişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080313
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080313,
					"content": "Bu da demek oluyor ki sadece yapı malzemesi olarak değil çömlek ve birçok diğer şeyin yapımında da kullanılabilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080314,
						230080315
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080314,
					"content": "Tebrikler!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080316
					]
				},
				{
					"id": 230080316,
					"content": "Sağ ol. O bilge insanların \"Damlaya damlaya göl olur.\" derken kastettiği şey buymuş demek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080317
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080317,
					"content": "Bu toprağın pek bir numarası yok gibi görünse de küçümsememeliyiz. Bir gün bununla gökyüzüne kadar uzanan bir kule inşa edebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080318
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080318,
					"content": "Bu karışımın adını \"Killi Toprak\" koydum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080319
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080319,
					"content": "Sonraki adımımız Killi Toprağın neler yapabileceğini görmek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080320
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080320,
					"content": "Son zamanlarda insanların evlerinde çıkan sorunlara çözüm bulmak üzereyiz sanki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080321
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080321,
					"content": "Tekrar sağ ol Gezgin. Lütfen karşılığında bunları kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				},
				{
					"id": 230080315,
					"content": "Sonunda emeğinin karşılığını aldın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080316
					]
				},
				{
					"id": 230080309,
					"content": "Paimon'un seveceği bir şeye benziyor..",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230080310
					]
				},
				{
					"id": 230080310,
					"content": "Hey! Paimon toprak yemez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230080311
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
