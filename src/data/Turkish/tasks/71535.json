			"dialogs": [
				{
					"id": 715350401,
					"content": "Vay! Elin bayağı yatkınmış. Çok güzel bir zarf oldu, teşekkür ederim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350402
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350402,
					"content": "Bu senin bana bir hediyen oldu sanırım. Karşılığında verebileceğim bir şey yok üzerimde ama Sumeru'ya döndüğümde mutlaka bir şey gönderirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350403
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350403,
					"content": "Şimdi de ben Candace için bir zarf yapayım da kolye ile birlikte hediye ederim. Kesin çok beğenecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350404
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350404,
					"content": "Bu arada, artık gelmiş midir acaba? Epey zaman oldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dehya"
				}
			]
		}
