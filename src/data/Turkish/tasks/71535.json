			"dialogs": [
				{
					"id": 715350201,
					"content": "#Seni gördüğüme sevindim {NICKNAME}. Fener Şenliğine mi geldin sen de?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350202
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350202,
					"content": "Hediye zarfı mı yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715350203
					]
				},
				{
					"id": 715350203,
					"content": "Evet. Candace için almak istemiştim ama beceremedim bir türlü. En baştan yapacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350204
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350204,
					"content": "Candace seninle gelmedi mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715350205
					]
				},
				{
					"id": 715350205,
					"content": "Henüz gelmedi ama gelecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350206
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350206,
					"content": "Başta benimle Liyue'ye gelmek istememişti. Köyü koruması gerekiyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350207
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350207,
					"content": "Ona herkesin yıl sonunda biraz rahatlamayı hak ettiğini söyledim. Ayrıca Liyue'ye giden bir kervana eşlik etmem gerektiğini, onun da benimle gelebileceğini söyledim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350208
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350208,
					"content": "Biz yokken köyü koruması için birkaç adam bile ayarlayacaktım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350209
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350209,
					"content": "Fakat ikna olmadı. En sonunda, köy halkı onun artık biraz dinlenmesi gerektiği konusunda üstüne gidince fikrini ancak değiştirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350210
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350210,
					"content": "Ama o zaman bile önce işlerini ayarlaması gerektiğinde ısrar etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350211
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350211,
					"content": "Ama kervan kimseyi beklemez... Ben de kendim geldim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350212
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350212,
					"content": "Hediye seçerken çok zorlandım. Öyle güzel şeyler var ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350213
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350213,
					"content": "Nihayetinde ona bir kolye aldım ama sonra, Fener Şenliğindeki hediye zarfı geleneğini öğrenince bir zarf da ben yapayım diye düşündüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350214
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350214,
					"content": "Sonuç olarak... Pek iyi gitmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350215
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350215,
					"content": "#Sen bu işten daha iyi anlarsın {NICKNAME}. Bana biraz ipucu verebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350216
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 715350216,
					"content": "Sorun değil, bir bakayım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
