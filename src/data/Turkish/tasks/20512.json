			"dialogs": [
				{
					"id": 205120101,
					"content": "Bu reçete gittikçe tuhaflaşıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120102,
					"content": "Anna nasıl?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120103
					]
				},
				{
					"id": 205120103,
					"content": "Sen miydin? İnanmayacaksın ama Anna çok daha iyi hissettiğini söylüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120104,
					"content": "Belki doktorun yazdığı ilaç gerçekten işe yaramıştır. Ben bile inanamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120105
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120105,
					"content": "Neyse, ister işe yarasın ister yaramasın, en iyisi devam etmek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120106
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120106,
					"content": "Bu seferki reçetede... Hımm. Bir \"Yoğun Su Bodurlopu Özü\" bulmama yardım edebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120107,
						205120112,
						205120117
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120107,
					"content": "Bu normal bir şey gibi sanki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120108
					]
				},
				{
					"id": 205120108,
					"content": "Öyle mi? Bana kalırsa tam tersi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120109
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120109,
					"content": "Ama en azından bulması kolay. Birilerine sordum. Büyük Bodurlopları yenerek Yoğun Öz elde edebilirmişiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120110
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120110,
					"content": "Jack, durmaksızın küçük bodurlopları yenerek büyük bodurlopları çekebileceğimizi söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120111
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120111,
					"content": "Ben dövüş konusunda o kadar yetenekli değilim. O yüzden sana güveniyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120112,
					"content": "Merak etme. Bu seferkini yiyebiliriz belki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120113
					]
				},
				{
					"id": 205120113,
					"content": "Onu nereden biliyorsun? Daha önce denedin mi? Şey... Niye susuyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120114
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120114,
					"content": "Her neyse. Su Bodurloplarını bulmak çok kolay olacaktır. Birilerine sordum. Büyük Bodurlopları yenerek Yoğun Öz elde edebilirmişiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120115
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120115,
					"content": "Jack, durmaksızın küçük bodurlopları yenerek büyük bodurlopları çekebileceğimizi söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120116
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120116,
					"content": "Ben dövüş konusunda o kadar yetenekli değilim. O yüzden sana güveniyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120117,
					"content": "Nerede olduklarını biliyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205120118
					]
				},
				{
					"id": 205120118,
					"content": "Güzel. Bodurloplarla baş etmek konusunda uzmansın anlaşılan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120119
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120119,
					"content": "Yardım etmeyi kabul ettiğin için teşekkürler. Büyük Bodurlopları yenerek Yoğun Öz elde edebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120120
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120120,
					"content": "Jack, durmaksızın küçük bodurlopları yenerek büyük bodurlopları çekebileceğimizi söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205120121
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205120121,
					"content": "O zaman sana iyi şanslar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		},
