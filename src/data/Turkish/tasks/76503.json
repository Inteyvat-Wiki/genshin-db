			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Flins"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765030101,
					"content": "#Sevgili {NICKNAME} ve Paimon, siz mi geldiniz? Böyle uzak bir yerde karşılaşmak ne hoş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030102
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030102,
					"content": "Takip ettiğiniz bir iz mi var? Yoksa yolunuzu mu kaybettiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030103,
						765030104
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030103,
					"content": "Öylesine etrafa bakınıyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765030105
					]
				},
				{
					"id": 765030105,
					"content": "Anlıyorum. Doğrusu, bu gemi enkazının güvertesinden bakıldığında Kuuvahki Deneysel Tasarım Bürosunun devasa silüeti... Kendine has bir ihtişama sahip. Adeta uyuyan bir devi andırıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030106
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030106,
					"content": "Evet. Bu kadar uzaktan dahi korkutucu görünüyor. Kim bilir içeride hangi sırlar gizli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765030107,
					"content": "Özel bir görüntü aradığına göre senin için harika bir ilham kaynağı olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030108
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030108,
					"content": "Ne de olsa en büyüleyici hikayeler, genellikle ışık ile karanlığın kesiştiği yerlerde doğar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030109
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030109,
					"content": "Hehehe, sen ve şu mavi fenerin, zaten bir hikayeden fırlamış gibi duruyorsunuz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765030110,
					"content": "Sözü açılmışken, senin şu yerde nöbet tutuyor olman gerekmiyor mu? İzin mi aldın yoksa devriye mi geziyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765030111,
					"content": "İkisi de diyebilirim. Biz Ratnikler, gölgelerden doğabilecek herhangi bir felakete karşı ebedi bir nöbet tutarız. Bu yüzden nerede olursak olalım her zaman tetikte olmamız gerekir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030112
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030112,
					"content": "Burada her şey yolunda görünüyor, o yüzden çok endişelenmeye gerek yok. Huzur içinde yaratıcı uğraşlarınızla ilgilenebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030113,
						765030114
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030113,
					"content": "Eh, hazır fırsatını yakalamışken...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765030115
					]
				},
				{
					"id": 765030115,
					"content": "Benim mi? Bu biraz beklenmedik bir istek. Açıkçası Kamera önünde bulunmayı pek bilmediğimi itiraf etmeliyim. Aynı şekilde, izlenmekten ziyade izlemeye alışkınım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030116
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030116,
					"content": "Vaktimi sessiz mezarlar ve ölülerin fısıltıları eşliğinde geçirdiğim için olabilir. Anlıyorsun, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030117
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030117,
					"content": "Yine de bir arkadaşın ricasını geri çevirmek kaba ve misafirperverliğe aykırı olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765030118
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030118,
					"content": "Kaydetmeye değer bulduğunuz şeyleri çekebilirsiniz. Bir nebze dahi olsa size ilham verebilmek benim için bir onurdur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				},
				{
					"id": 765030114,
					"content": "Senin fotoğrafını çekebilir miyiz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765030115
					]
				},
				{
					"id": 765030104,
					"content": "Bir yandan da fotoğraf çekmek için malzeme arıyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765030105
					]
				}
			]
		},
