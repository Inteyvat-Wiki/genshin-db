			"dialogs": [
				{
					"id": 736900101,
					"content": "Merhaba! Ben Kshahrewar'dan Daya. Sen de mi Bilgelik Şenliğine katılmaya geldin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900102
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900102,
					"content": "Darşanımız yeni bir oyun çıkardı. Adı \"Yol Projesi\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900103
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900103,
					"content": "Oynamak ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900104
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900104,
					"content": "Eğer yanlış hatırlamıyorsam Kshahrewar'ın çalışma alanı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900105
					]
				},
				{
					"id": 736900105,
					"content": "Evet, mekanik ve mimari üzerine çalışıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900107
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900107,
					"content": "Iı, konudan saptım galiba. Neyse, bu Şenliğe katılmak için bir sürü öğrenci kafa kafaya verdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900108
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900108,
					"content": "Ve ortaya \"Yol Projesi\" çıktı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900109
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900109,
					"content": "Kısaca anlatmam gerekirse, oyuncuların hazırladığımız çeşitli nesneleri kullanarak bir yol oluşturması gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900110
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900110,
					"content": "Köprüler kurmak, merdivenler inşa etmek... Oyunun amacı, insanların gidecekleri yere ulaşmalarını sağlayacak bir yol yapmak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900111
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900111,
					"content": "Gerçekte inşası biten binaları nasıl test ediyorsak oyundaki yolun yapımı bittiğinde de bir doğrulama yapıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900112
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900112,
					"content": "Özetle, başarılı olmak için güvenli bir yol yapmak gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900113,
						736900114
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900113,
					"content": "Bu biraz karmaşık geldi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900115
					]
				},
				{
					"id": 736900115,
					"content": "Merak etme! Gerçekten bir şey inşa etmeni istemiyoruz zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900116
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900116,
					"content": "Bir şeyler ters gider ve yol çökerse hemen yeniden inşa ediyoruz. İstediğin kadar deneme de yapabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900117
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900117,
					"content": "Hayal gücünü kullanman yeter. Yapabileceğin en güzel yolu yap!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900118,
						736900120
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900118,
					"content": "Bir deneyeceğim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900119
					]
				},
				{
					"id": 736900119,
					"content": "Süper. O halde seni şöyle alalım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900120,
					"content": "Kusura bakma, şu anda biraz meşgulüm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900121
					]
				},
				{
					"id": 736900121,
					"content": "Ha, öyle mi? Tamam o zaman... Standımız Şenlik boyunca açık olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736900122
					],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900122,
					"content": "Ne zaman denemek istersen gelebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Daya"
				},
				{
					"id": 736900114,
					"content": "Mimarlıkta pek iyi değilimdir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736900115
					]
				}
			]
		}
	]
}