						],
						"pointId": 13688
					}
				]
			},
			"dialogs": [
				{
					"id": 760200701,
					"content": "İşte bu çok tuhaf...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200702
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200702,
					"content": "Gördünüz mü? Ağaç birden aydınlandı ve bu ufaklıklar belirdi... Keşke balık olsalardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200703
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200703,
					"content": "Ortadaki yeşil şey kökü yani, öyle mi? Paimon nasıl çalıştığını anlamadı ama ışıl ışıl olunca eskisinden çok daha güzel göründü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760200704,
					"content": "Neler olduğunu anlatıyorsunuz...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760200705
					]
				},
				{
					"id": 760200705,
					"content": "İnanması zor... Ama bana yalan söylemen için bir neden de yok. Birlikte balık tuttuğum yarı Donuk Ayın Çocuğu doğruyu söylüyormuş demek ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200706
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200706,
					"content": "Aman, doğruysa doğru. Alt tarafı geçmişin kalıntıları işte. İstedikleri kadar konuşup şarkı söylemeye devam etsinler, balık tutmamızı engelleyemezler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200707
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200707,
					"content": "Neyse, siz hazine avcılarısınız, değil mi? Az önce bulduğunuz o şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200708
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200708,
					"content": "<color=#00E1FFFF>Bilginliğin İspatı</color> bu muymuş? Sıradan bir tüy gibi görünüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760200709,
					"content": "Tanıdığım bir tüccar, beş adet <color=#00E1FFFF>Bilginliğin İspatı</color> toplayan kişinin, ayın doğusunda ve güneşin batısında \"Büyük Hazine\"yi bulacağını söylemişti. Doğru mudur bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200710
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200710,
					"content": "Yine de birçok hazine avcısı bu hikayelere inanıyor. Hepsi çılgınca hazinenin peşinden koşuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200711
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200711,
					"content": "Şey, ortada bir hazine söz konusu sonuçta! Paimon da biraz merak ediyor açıkçası.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760200712,
					"content": "20 yaş daha genç olsaydım... Yok yok, o zaman bile burada balık tutuyor olurdum. Gerçi bugün de elim boş dönüyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				}
			]
		}
	]
}