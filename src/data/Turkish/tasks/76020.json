				"points": []
			},
			"dialogs": [
				{
					"id": 760200101,
					"content": "Bugün de elim boş dönüyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200102,
						760200105,
						760200112,
						760200117
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200102,
					"content": "Burada ne yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760200103
					]
				},
				{
					"id": 760200103,
					"content": "Balık tutuyorum. Gerçi balık dışında her şeyi yakaladım herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200104
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200104,
					"content": "Gemi enkazlarından çıkan ıvır zıvır olsa yine işime yarardı, gezgin tüccarlara falan satardım. Bir keresinde bir çizme tutmuştum mesela, yarısına kadar... Of, boş verin. Susayım da balıklar korkup kaçmasın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200105,
					"content": "Yakınlarda dikkate değer bir şeyler var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760200106
					]
				},
				{
					"id": 760200106,
					"content": "Hazine avı mı? \"Büyük Hazine\"nin ayın doğusunda ve güneşin batısında olduğu söylenir... Doğru yerde olmadığınız belli oluyordur herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200107
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200107,
					"content": "Gerçi bu sularda birçok gemi enkazı var. Dalgaların altında hazine olabilir ama ona ulaşmanın kolay olacağını sanmam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200108
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200108,
					"content": "Bir keresinde handa da o tarz bir şey duymuştum, batan gemilerinden kurtulan denizciler anlatıyordu. O gece ay görünmemesine rağmen dalgaların arasında parlayan bir şey varmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200109
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200109,
					"content": "Bunun ayı bile yutabilecek kadar heybetli bir canavar olan tek gözlü Kratti olduğuna yemin ediyorlardı. Dev bir deniz yılanının bölgesini ele geçirmek için onunla savaşıyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200110
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200110,
					"content": "O günden sonra okyanusun bu kısmı uzun bir süre boyunca tamamen karanlığa gömüldü. Hiçbir gemi buradan geçmeye cesaret edemiyordu. Herkes dalgaların altındaki kayıp ruhların onları derinlere sürükleyeceğinden korkuyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200111
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200111,
					"content": "İnsanlar kayıp ruhların hâlâ buralarda dolaştığını söylüyor ama bence bunlar çocukları korkutmak için uydurulmuş hikayelerden ibaret. Ben böyle saçmalıklara inanmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200112,
					"content": "Bu ağaç hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760200113
					]
				},
				{
					"id": 760200113,
					"content": "Bu ağaç lanetli. Eskiden burada bir girdap vardı, denizciler ona Kratti'nin Gözü derlerdi. Sonra bir gün bu ağaç tam da girdabın ortasından büyümeye başladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200114
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200114,
					"content": "Ama o zamanlar yaşanan tek garip olay bu değildi. Şimdi düşünüyorum da, her şey o kayalar gökyüzünden düştükten sonra başladı... Kim bilir? Belki bu ağaç da onlarla aynı yerden gelmiştir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200115
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200115,
					"content": "Bir de arada bir görünen şu parlak küçük şeyler var. Çok nadir rastlanır onlara. Ben de belki farklı balık türleri gelmiştir diye düşünüp şansımı denemeye geldim buraya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200116
					],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200116,
					"content": "Eskiden birlikte balık tuttuğum bir arkadaşım vardı. Sürekli tuhaf şarkılar duyduğunu söylüyordu. O kadar korktu ki bir daha hiç gelmedi. Hah, aslında sadece yarı Donuk Ayın Çocuğu ama nasıl olduysa tuhaf huyları tamamen onlara çekmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				},
				{
					"id": 760200117,
					"content": "Kusura bakma, rahatsız ettim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760200118
					]
				},
				{
					"id": 760200118,
					"content": "Sorun değil. Zaten balık malık geldiği yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ilmari"
				}
			]
		},
