			"dialogs": [
				{
					"id": 760200301,
					"content": "Vay canına... Demin gördüğümüz o parlak küçük şeylerden bir sürü var burada! Gerçi şu an neredeyiz ki biz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760200302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760200302,
					"content": "Dönüp dolaşıp o tuhaf görünümlü ağacın altına gelmiş olabilir miyiz? Ve şu yeşil şeyler... Onlar da ne öyle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
