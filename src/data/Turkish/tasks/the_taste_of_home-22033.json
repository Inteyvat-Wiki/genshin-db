			},
			"dialogs": [
				{
					"id": 220330401,
					"content": "Hım, açıkçası tadı ne Liyue ne de Inazuma yemeklerine benziyor. Hiç alışkın olmadığım bir tadı var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330402
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330402,
					"content": "Tam olarak istediğim yemek olmasa da yeni bir şeyler denemiş olduğum için mutluyum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330403
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330403,
					"content": "Teşekkür ederim Gezgin. Lütfen bunları kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				}
			]
		},
		{
