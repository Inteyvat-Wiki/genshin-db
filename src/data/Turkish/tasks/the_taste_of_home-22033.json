			},
			"dialogs": [
				{
					"id": 220330501,
					"content": "Ne? Bu bir Inazuma yemeği ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330502
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330502,
					"content": "Korkarım ki istediğim yemek bu değildi... Neyse, en azından karnımı doyurur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330503
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330503,
					"content": "Yine de teşekkür ederim Gezgin. Lütfen bunları kabul et.",
					"roleType": "TALK_ROLE_NPC",
