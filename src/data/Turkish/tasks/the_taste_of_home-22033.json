			"dialogs": [
				{
					"id": 220330201,
					"content": "Ne çabuk döndün? Yoksa sen gizli bir şef misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330202
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330202,
					"content": "Hım... Artık dayanamayacağım. Lütfen, bir an önce tadına bakmak istiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330203,
						220330204
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220330203,
					"content": "Afiyet olsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220330204,
					"content": "Bir bakalım... Hangi yemeklerden bahsediyorduk?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220330205
					]
				},
				{
					"id": 220330205,
					"content": "Şey... Pirinç Topları, Nilüfer Kızartması ve Üç Renkli Dango!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220330206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220330206,
					"content": "Birini seçip Tang Wen Hanım'a verelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
