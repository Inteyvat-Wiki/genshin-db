						700890102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700890102,
					"content": "Bu da değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890103
					],
					"speakerTitle": "\"Maukie\""
				},
				{
					"id": 700890103,
					"content": "Hey, ne yapıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700890104,
					"content": "Geri dönüş yolunu bulmaya çalışıyorum. Tek hatırladığım, bir Rüzgar Hükümdarı Heykeli bulmam gerektiği.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890105
					],
					"speakerTitle": "\"Maukie\""
				},
				{
					"id": 700890105,
					"content": "Başka bir şey hatırlamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890106
					],
					"speakerTitle": "\"Maukie\""
				},
				{
					"id": 700890106,
					"content": "Dönüş yolu mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700890107,
					"content": "Belli belirsiz bir ev hasreti çekiyorum ama hiçbir şey hatırlamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890108
					],
					"speakerTitle": "\"Maukie\""
				},
				{
					"id": 700890108,
					"content": "Uyandığımda elimdeki tek şey üzerinde \"Sen 'Maukie'sin.\" yazan bir nottu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890109
					],
					"speakerTitle": "\"Maukie\""
				},
				{
					"id": 700890109,
					"content": "Dolayısıyla sanırım benim adım Maukie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890110
					],
					"speakerTitle": "\"Maukie\""
				},
				{
					"id": 700890110,
					"content": "Artık gitmeliyim. Hoşça kalın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890111
					],
					"speakerTitle": "\"Maukie\""
				},
				{
					"id": 700890111,
					"content": "Ne tuhaf bir adam. Ama kötü birine benzemiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700890112,
					"content": "İyi misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700890113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 700890113,
					"content": "Garip bir görü yaşadım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700890114
					]
				},
				{
					"id": 700890114,
					"content": "Garip bir görü mü? Acaba şu adam heykele dokundu diye mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
