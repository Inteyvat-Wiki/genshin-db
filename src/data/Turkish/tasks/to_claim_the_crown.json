			"dialogs": [
				{
					"id": 401030501,
					"content": "Kareena!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401030502,
					"content": "Oh... Sonunda geldiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030503
					],
					"speakerTitle": "Kareena"
				},
				{
					"id": 401030503,
					"content": "Nerelerdeydiniz? Sizi her yerde arıyordum... Üçüncü tur çoktan başladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030504
					],
					"speakerTitle": "Kareena"
				},
				{
					"id": 401030504,
					"content": "Sachin'i kaçırmaya çalışan bazı serserileri yakalıyorduk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401030505,
					"content": "Ama artık bunun bir önemi yok! Bilgelik Tacıyla ilgili bir sorun olabileceğini düşünüyoruz ve onu araştırmak istiyoruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401030506,
					"content": "Taç mı? Taçta bir sorun olduğunu sanmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030507
					],
					"speakerTitle": "Kareena"
				},
				{
					"id": 401030507,
					"content": "Bilgelik Tacı, son yirmi yıldır her Cümbüşte sorunsuz bir şekilde kullanıldı... Neden şimdi sorun olsun ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030508
					],
					"speakerTitle": "Kareena"
				},
				{
					"id": 401030508,
					"content": "Birkaç yeni bilgi edindik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401030509
					]
				},
				{
					"id": 401030509,
					"content": "Hımm. Bu oldukça ciddi görünüyor. Bir düşüneyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030510
					],
					"speakerTitle": "Kareena"
				},
				{
					"id": 401030510,
					"content": "Tamam, durum şu ki Bilgelik Tacı şu anda Mawtiyima Ormanı'nda. Üçüncü tur başlamadan önce onu oraya taşıdık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030511
					],
					"speakerTitle": "Kareena"
				},
				{
					"id": 401030511,
					"content": "Yarışmacıların üçüncü turda Mawtiyima Ormanı'na gidip orada tacı bulması ve onu geri getirip yerine koyması gerekiyor. Bunu ilk yapan kişi 4 puan kazanır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030512
					],
					"speakerTitle": "Kareena"
				},
				{
					"id": 401030512,
					"content": "Yarışmacılar arasındaki puan farkının çok az olduğunu düşünürsek bu turu kazanan kişi, yarışmanın da kazananı olacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030513
					],
					"speakerTitle": "Kareena"
				},
				{
					"id": 401030513,
					"content": "Bundan ötürü rekabetin çok çekişmeli olacağını düşünüyorum. Zamanında yetişemeyebilirsiniz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030514
					],
					"speakerTitle": "Kareena"
				},
				{
					"id": 401030514,
					"content": "Denemeden öğrenemeyiz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401030515
					]
				},
				{
					"id": 401030515,
					"content": "Sizin için tacın yerini haritada işaretliyorum. Lütfen hemen oraya gidin. Umalım da kötü bir şey olmasın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030516
					],
					"speakerTitle": "Kareena"
				},
				{
					"id": 401030516,
					"content": "Pekala. Hadi gidelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
