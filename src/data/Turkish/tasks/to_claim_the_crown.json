			"dialogs": [
				{
					"id": 401030601,
					"content": "Sanırım artık bitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030602
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401030602,
					"content": "Kaveh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401030603,
					"content": "İyi misin? Bir yerin ağrıyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030604
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 401030604,
					"content": "Ben... İyiyim... Of...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030605
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401030605,
					"content": "Teşekkürler Tighnari. Endişelenmene gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030606
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401030606,
					"content": "Kendini çok zorlama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030607
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 401030607,
					"content": "Kaveh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030608
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 401030608,
					"content": "Kaveh tacı kırmış olabilir ama ondan önce görevi başarılı bir şekilde tamamladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030609
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 401030609,
					"content": "Bu, onu kurallara göre üçüncü turun kazananı yapıyor. Puanına bakacak olursak Darşanlar Şampiyonasının galibi de o oluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030610
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 401030610,
					"content": "Şampiyon ve Sachin'in şahsen seçtiği varisi olarak Kaveh, Sachin'in tüm mirasını devralma hakkını kazandı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030611
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 401030611,
					"content": "Şüpheye yer bırakmamak için Sachin'in tüm mal varlığını bağışlamak istediğini doğrulayabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030612
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 401030612,
					"content": "Dediğim gibi... O, dünyanın kötü bir yer olduğunu düşünüyordu. O yüzden geride bıraktıklarını dünyayı daha iyi bir hale getirmek için kullanmak istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030613
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401030613,
					"content": "Dünyayı reddetmenin hiçbir faydası yok. O ve ben... İkimiz aynı değiliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030614
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401030614,
					"content": "Pekala. Katip olarak bu olayın kaydını geçeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030615
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 401030615,
					"content": "Bilgeler, Sachin'in mallarının kullanımı için seninle iletişime geçecekler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030616
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 401030616,
					"content": "... Tamam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030617
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401030617,
					"content": "Araştırmasındaki bulguların doğru olup olmadığını bilmiyorum. Araştırmasını onun için nasıl tamamlayacağımı da bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030618
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401030618,
					"content": "Ama bunu burada sonlandırarak artık bir başka yarışmacının daha acı çekmeyeceğini biliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030619
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401030619,
					"content": "Bizler sonuncu değiliz. Bizden sonra daha nice şampiyonalar yapılacak ve... Birçok alim bizim yolumuzdan gidecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030620
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401030620,
					"content": "Sachin'in sözleri yalnızca acıya neden olabilir ama artık... Bu devir sona eriyor. Artık kimse onu duymak zorunda değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030621
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401030621,
					"content": "Hepimiz burada alimleriz. Onun görüşlerini bu şekilde reddetmenin despotça ve küstahça olduğunu biliyorum... Benim için fark etmez. Bu sorumluluk bana ait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030622
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401030622,
					"content": "En azından bunu yapabilirim. Ya da... Yapabileceğim tek şey bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030623
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401030623,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030624
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 401030624,
					"content": "Doğru dedin. Konuşmanda birçok kişinin özendiği ama sahip olamadığı adalet ve idealizm duygusu vardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030625
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 401030625,
					"content": "Bunu, bana çok saçma gelmesine rağmen söylüyorum. Eksikliklerinin uzun zamandır farkındasın ama kibrin bunu kabul etmenin önüne geçiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030626
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 401030626,
					"content": "Bununla birlikte bakış açın, bir zafer konuşmasına oldukça uyuyor. Yarışmacı Kaveh, organizasyon komitesi adına seni kazanan olarak tebrik etmekten onur duyuyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030627
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 401030627,
					"content": "Ne? Lütfen, samimiyetsiz tebriklerine ihtiyacım yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030628
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401030628,
					"content": "Neyse, şimdi tartışmanın zamanı değil. Yorumlarını benim görüşlerime değil, yarışmaya odakla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030629
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401030629,
					"content": "Tebrikler Kaveh! Bir de ödül töreni için hazırlanman gerekiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nilou"
				}
			]
		},
		{
			"id": 4010310,
			"completionStepIds": [
				4010310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
