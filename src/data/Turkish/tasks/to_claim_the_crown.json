			"dialogs": [
				{
					"id": 401030201,
					"content": "Ah, geldiniz. Kusura bakma, ben de tam sizi bilgilendirmesi için birini gönderecektim. Şüphelilerin sorgusunu daha yeni bitirdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030202
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401030202,
					"content": "Ne öğrendin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401030203,
					"content": "Aslında... Beklenmedik birçok şey öğrendim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030204
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401030204,
					"content": "Paralı askerleri yakalamak şaşırtıcı derecede kolaydı. Birini Sachin gibi giydirdik ve hemen bunu yuttular.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030205
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401030205,
					"content": "Daha sonra işler biraz karıştı tabii... Sorgu sırasında Sachin'in kendi oğlu tarafından tutulduklarını öğrendik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030206
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401030206,
					"content": "Ne? Neden birisi kendi babasını kaçırır ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401030207,
					"content": "Kim bilir? Her halükarda yakaladığımız bu adamlar buz dağının yalnızca görünen kısmı. Hâlâ birçoğu şehrin dışında kol geziyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030208
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401030208,
					"content": "Adamlarımızla gidip onları bir araya toplayıp köşeye sıkıştıracağız. Bizimle gelmek ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030209
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401030209,
					"content": "Tabii ki. Bu sıkıntıyı kökünden çözmenin zamanı geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
