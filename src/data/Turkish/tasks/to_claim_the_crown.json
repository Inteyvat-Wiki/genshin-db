			"dialogs": [
				{
					"id": 401035101,
					"content": "Alhaitham, Nilou diğer yarışmacıları gördünüz mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401035102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401035102,
					"content": "Hayır. Henüz kimse görevi tamamlamadı... Neden, bir şey mi oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401035103
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 401035103,
					"content": "Taçla ilgili bir sorun olabilir... Ah, Alhaitham, eminim bu konuda bir şeyler biliyorsundur, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401035104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401035104,
					"content": "Neden bahsediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401035105
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 401035105,
					"content": "Sen var ya... Boş ver! Önce onu bulmaya gideceğiz. Daha sonra sana tekrar sorarız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
