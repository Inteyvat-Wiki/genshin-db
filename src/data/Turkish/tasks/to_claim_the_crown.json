					"Kaveh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401031001,
					"content": "Sonunda... Biri mallarımı ve... Beraberinde araştırmamı miras alıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031002
					],
					"speakerTitle": "Sachin"
				},
				{
					"id": 401031002,
					"content": "Gel Kaveh. Bana gel evlat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031003
					],
					"speakerTitle": "Sachin"
				},
				{
					"id": 401031003,
					"content": "... Adımı nereden biliyorsun? Sen kimsin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031004
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401031004,
					"content": "Ben Sachin'im. Aslında Sachin'in aklının bir parçasıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031005
					],
					"speakerTitle": "Sachin"
				},
				{
					"id": 401031005,
					"content": "Kader ne ilginç bir şey... Bana daha önce tanıştığım birini hatırlattın. Ancak sen ona kıyasla daha çetinsin, ayrıca bu dünyanın imtihanlarını ve zorluklarını daha iyi biliyorsun. Mirasıma layık olan kişi sensin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031006
					],
					"speakerTitle": "Sachin"
				},
				{
					"id": 401031006,
					"content": "İlk defa tanışıyoruz evlat ama şimdi çok önemli şeyler diyeceğim. O yüzden lütfen beni dikkatlice dinle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031007
					],
					"speakerTitle": "Sachin"
				},
				{
					"id": 401031007,
					"content": "Darşanlar Şampiyonasında mükemmel bir performans sergiledin. Akademide üstün yeteneklere sahip birçok kişi var ama sen en iyisinin de en iyisisin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031008
					],
					"speakerTitle": "Sachin"
				},
				{
					"id": 401031008,
					"content": "Yerime geçecek birini seçecek olsaydım seni seçerdim Kaveh. Sadece kazanan sen olduğun için değil, aynı zamanda karakter olarak da bana benzediğin için.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031009
					],
					"speakerTitle": "Sachin"
				},
				{
					"id": 401031009,
					"content": "... Ben mi? Sana mı benziyorum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031010
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401031010,
					"content": "Evet. İkimiz de idealist olmaktan muzdaribiz, sefaletimizin sebebi bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031011
					],
					"speakerTitle": "Sachin"
				},
				{
					"id": 401031011,
					"content": "Yirmi sekiz yıl önce çöle geldim ve orada tam sekiz yıl boyunca yaşadım. Orada ne gördüm sence? Sonu gelmeyen çekişmeler ve katliamlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031012
					],
					"speakerTitle": "Sachin"
				},
				{
					"id": 401031012,
					"content": "Su kaynakları üzerinde anlaşmazlıklar, soyulan kervanlar, insanların suistimal edilmesi... Her gün süren amansız bir mücadele. Samiel Duvarı'nın ardında benim tamamen yabancı olduğum bir dünya vardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031013
					],
					"speakerTitle": "Sachin"
				},
				{
					"id": 401031013,
					"content": "Orada gördüklerim beni çok rahatsız etti. Umutsuzca oradaki insanları kurtarmanın bir yolunu bulmayı istedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031014
					],
					"speakerTitle": "Sachin"
				},
				{
					"id": 401031014,
					"content": "... Ee, bir yolunu bulabildin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031015
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401031015,
					"content": "Bir Vahumana alimi olarak Vahumana bilgilerini kullanarak cevabı bulmaya çalıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031016
					],
					"speakerTitle": "Sachin"
				},
				{
					"id": 401031016,
					"content": "Tarih ve antropoloji araştırdım, insan doğası üzerine birçok deney yaptım, hatta çölün derinliklerinde yaşayan ve kendilerine \"Kayıp Darşan\" diyen alimleri bile bulmaya çalıştım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031017
					],
					"speakerTitle": "Sachin"
				},
				{
					"id": 401031017,
					"content": "Ancak nihayetinde aradığım cevabın var olmadığını öğrendim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031018
					],
					"speakerTitle": "Sachin"
				},
				{
					"id": 401031018,
					"content": "Bu çatışmaların suçunu yalnızca bir gruba yüklemek imkansızdı. Günah işlemek insan doğasındandır. Doğamız gereği çatışmalar yaşanır ve bunlar da beraberinde yıkım getirir. İnsan doğasının gerçeği budur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031019
					],
					"speakerTitle": "Sachin"
				},
				{
					"id": 401031019,
					"content": "Araştırmamın amacı tarihten ders çıkarmaktı ama sonra tarihin bir rehber olamayacağını öğrendim... Kötü günlerin ardında yalnızca daha kötü günler vardır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031020
					],
					"speakerTitle": "Sachin"
				},
				{
					"id": 401031020,
					"content": "Bunu anladıktan sonra daha önce öğrendiğim hiçbir şeyde anlam göremedim. Ezici bir boşluk hissi yüreğime oturdu, hayatla yüzleşmeye artık dayanamıyordum... Bu yüzden hayatıma bir son vermeye karar verdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031021
					],
					"speakerTitle": "Sachin"
				},
				{
					"id": 401031021,
					"content": "Ancak canımı almadan önce tesadüfen bir kişinin bilincini muhafaza edebilen bu taç elime geçti. Akademiden mallarımı yönetmesini istemeden önce birçok tecrübemi bunun içinde aktardım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031022
					],
					"speakerTitle": "Sachin"
				},
				{
					"id": 401031022,
					"content": "Düşündüğüm gibi, Akademi ile imzaladığın sözleşme aslında senin vasiyetindi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031023
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 401031023,
					"content": "Dünyadan ümidini kestiysen neden böyle bir şey yapmaya ihtiyaç duydun ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031024
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 401031024,
					"content": "İnsan doğasıyla ilgili birçok deney yaptığımdan bahsetmiştim... Bunu da bu konudaki son deneyim olarak görebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031025
					],
					"speakerTitle": "Sachin"
				},
				{
					"id": 401031025,
					"content": "Akademide birçok dahi var ve her neslin en parlak öğrencileri de orada yetişir. Büyük bir ödül koyarak, bir gün insan doğasının gizemini tamamen çözmeye ve dünyayı daha iyi bir hale getirmeye muktedir olacak kişiyi bulmayı ümit ediyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031026
					],
					"speakerTitle": "Sachin"
				},
				{
					"id": 401031026,
					"content": "Anladım. Hem dahi olan hem de sıradan insanların acılarını anlayan bir varis istiyordun. Böyle bir kişi insanlık, toplum ve dünya hakkında daha net bir görüşe sahip olacaktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031027
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 401031027,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031028
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401031028,
					"content": "Ama hiç zenginliğin insanların kalplerini dünyadaki acılara karşı duygusuzlaştırdığını düşündün mü? Bir idealist bile senin mal varlığını devraldıktan sonra vasiyetini yerine getiremeyecek hale gelebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031029
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 401031029,
					"content": "Çok zekisin ama... Benim nasıl düşündüğümü anlayamıyorsun. Benim için bu da insan doğası üzerine yaptığım deneyin ve araştırmamın bir parçası.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031030
					],
					"speakerTitle": "Sachin"
				},
				{
					"id": 401031030,
					"content": "Varisim, araştırmam yüzünden acı çekebilir veya zevk ve sefa sürebilir. İki türlü de benim araştırmam ilerleme kaydetmiş olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031031
					],
					"speakerTitle": "Sachin"
				},
				{
					"id": 401031031,
					"content": "Bu dünyanın kökünde yatan hastalığa üzülüyorum, katlanılmaz tarihinden utanç duyuyorum ve araştırmamı tamamlayamadığım için yakınıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031032
					],
					"speakerTitle": "Sachin"
				},
				{
					"id": 401031032,
					"content": "İşte bu yüzden Kaveh, evladım... Bana çok yardımın dokunacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031033
					],
					"speakerTitle": "Sachin"
				},
				{
					"id": 401031033,
					"content": "Sen... Gerçekten sahip olduğun her şeyi istediğim gibi kullanmam için bana vermek istediğine emin misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401031034
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401031034,
					"content": "Sana karşı olan izlenimime güveniyorum. Şimdi, tacı tak Kaveh ve benim bitiremediğim yolculuğu tamamla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sachin"
				}
			]
		},
