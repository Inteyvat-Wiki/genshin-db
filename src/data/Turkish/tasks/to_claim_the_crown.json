			"dialogs": [
				{
					"id": 401030401,
					"content": "Patron, daha fazlası geldi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030402
					],
					"speakerTitle": "Levi"
				},
				{
					"id": 401030402,
					"content": "Bakın, biz sadece işimizi yapıyoruz. Yanlış kişileri cezalandırıyorsunuz. Bu işin ardındaki kişiyi mi istiyorsunuz? İşte o. Bizi Sachin'i kaçırması için tutan kişi o.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030403
					],
					"speakerTitle": "Mazaar"
				},
				{
					"id": 401030403,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030404
					],
					"speakerTitle": "Jiwani"
				},
				{
					"id": 401030404,
					"content": "Ne oldu? Bunu size kim yaptı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401030405,
					"content": "... Bir dakika, yani sen onlarla değil misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030406
					],
					"speakerTitle": "Mazaar"
				},
				{
					"id": 401030406,
					"content": "Kiminle? Kim yaptı bunu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401030407,
					"content": "Önce uçan bir çocuk geldi. Hiçbir soru sormadan saldırmaya başladı. Sonra yeşil kıyafetler giyen bir adam geldi ve bizi biraz sorguladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030408
					],
					"speakerTitle": "Mazaar"
				},
				{
					"id": 401030408,
					"content": "İhtiyacım olan şeyi öğrendim. Bu komployu planlayan kişi, Sachin'in oğlu Jiwani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030409
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401030409,
					"content": "Ona sormak istediğin bir şey varsa şimdi tam sırası. İşin bittiğinde onları tutuklayıp daha fazla sorgulamak için Akademiye götüreceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030410
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401030410,
					"content": "Neden Sachin'i kaçırması için birilerini tuttun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401030411,
					"content": "Hıh. Neden olabilir sence? Yirmi yıl önce benim iyiliğimi hiç düşünmeden, rahat bir hayat sürmek için çekip gitmişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030412
					],
					"speakerTitle": "Jiwani"
				},
				{
					"id": 401030412,
					"content": "Bu yeterince kötü değilmiş gibi bir de gidip tüm mal varlığını Akademiye emanet etti ve bir gün hepsini beğendiği bir dahiye vereceğine dair sözleşme imzaladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030413
					],
					"speakerTitle": "Jiwani"
				},
				{
					"id": 401030413,
					"content": "Onun serveti benim miras hakkım! Öylece oturup hepsinin başkasına gitmesini izleyeceğimi mi sanmıştın? Benim hakkımı vermezse ben de hakkım olanı kendim alırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030414
					],
					"speakerTitle": "Jiwani"
				},
				{
					"id": 401030414,
					"content": "Gerçekten onu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401030415
					]
				},
				{
					"id": 401030415,
					"content": "Elbette! Buralarda bir yerde olup Şampiyonayı gölgelerden izleyeceğini söylememiş miydi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030416
					],
					"speakerTitle": "Jiwani"
				},
				{
					"id": 401030416,
					"content": "Ben de onu kaçırttıktan sonra ona sözleşmeyi değiştirtecektim. Daha sonra Akademi malları vermeyi kabul etmezse de onun seçtiği dahi olduğumu ilan etmesini sağlayacaktım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030417
					],
					"speakerTitle": "Jiwani"
				},
				{
					"id": 401030417,
					"content": "Onu buldunuz mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401030418
					]
				},
				{
					"id": 401030418,
					"content": "Hayır. Yaşlı bunak nasıl saklanacağını iyi biliyor, bu konuda hakkını vermeliyim. Muhtemelen tüm bu olan bitenleri izleyip kendi kendine gülüyordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030419
					],
					"speakerTitle": "Jiwani"
				},
				{
					"id": 401030419,
					"content": "20 yıl önce delirdiğini düşünüyordum. Bir delinin neler yapabileceğini kim bilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030420
					],
					"speakerTitle": "Jiwani"
				},
				{
					"id": 401030420,
					"content": "Bilgelik Tacı hakkında ne biliyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401030421
					]
				},
				{
					"id": 401030421,
					"content": "Bilgelik Tacı mı? Şu Akademiye bağışladığı şeyi mi diyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030422
					],
					"speakerTitle": "Jiwani"
				},
				{
					"id": 401030422,
					"content": "Oldukça pahalı olduğunu söyleyebilirim. Geçmişte onu satın almak için birçok malını satması gerekmişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030423
					],
					"speakerTitle": "Jiwani"
				},
				{
					"id": 401030423,
					"content": "Onu eve getirdikten sonra evde garip şeyler olmaya başlamıştı. Mesela bazen depodan tiz sesler geldiğini duyardık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030424
					],
					"speakerTitle": "Jiwani"
				},
				{
					"id": 401030424,
					"content": "Ayrıca onu Akademiye bağışlamadan önce kendisini depoya kapatıp onu durmaksızın günlerce araştırmıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030425
					],
					"speakerTitle": "Jiwani"
				},
				{
					"id": 401030425,
					"content": "Daha o noktada ciddi bir sorunu olduğu belliydi. Yaptığı hiçbir şey beni şaşırtmıyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030426
					],
					"speakerTitle": "Jiwani"
				},
				{
					"id": 401030426,
					"content": "Ciddi bir sorunu vardı derken ne demek istedin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401030427,
					"content": "O sıralar çocuk olduğum için çok net hatırlamıyorum ama araştırma yapmak için çöle gidip yıllarca geri dönmediğini hatırlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030428
					],
					"speakerTitle": "Jiwani"
				},
				{
					"id": 401030428,
					"content": "Nihayet geri döndüğünde de tamamen farklı biriydi. Anlaşılmaz şeyler sayıklar ve makale yazıp dururdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030429
					],
					"speakerTitle": "Jiwani"
				},
				{
					"id": 401030429,
					"content": "Ne yazdığını görmek istediğimi söylerdim ama beni hep odadan kovardı. Daha sonra bir yere gitti ve yazdığı makaleleri de beraberinde götürdü. Geri geldiğinde de Akademi ile o sözleşmeyi imzaladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030430
					],
					"speakerTitle": "Jiwani"
				},
				{
					"id": 401030430,
					"content": "... İçimden bir ses acaba o noktada çoktan babam olmayı bıraktı mı diye merak ediyor. Belki \"Sachin\" dediğimiz o adam aslında çölden gelen, onun kılığındaki bir şeytandır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030431
					],
					"speakerTitle": "Jiwani"
				},
				{
					"id": 401030431,
					"content": "Dur artık! Paimon'u korkutuyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401030432,
					"content": "Bana inanın ya da inanmayın, benim için fark etmez. Size tüm bildiklerimi anlattım. Fakat eğer Sachin'i görecek olursanız, benim için ona şunu söyleyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030433
					],
					"speakerTitle": "Jiwani"
				},
				{
					"id": 401030433,
					"content": "Orada neyi araştırırsa araştırsın, benim gözümde çöpten farkı olmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030434
					],
					"speakerTitle": "Jiwani"
				},
				{
					"id": 401030434,
					"content": "Bitti mi? O halde hadi, bizimle geliyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030435
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401030435,
					"content": "Sonunda tüm bunların ardındaki kişiyi yakaladık. Bize sağladığın önemli bilgiler için teşekkür ederiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030436
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401030436,
					"content": "Hâlâ aklına yatmayan bir şey var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030437
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401030437,
					"content": "\"Bilgelik Tacı\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401030438
					]
				},
				{
					"id": 401030438,
					"content": "Evet, Alhaitham'ın notlarında da yer alıyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030439
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401030439,
					"content": "... Katip Alhaitham da mı bu konuya baktı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030440
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401030440,
					"content": "Hımm... Anladım. Taçla ilgili bir sorun olduğunu düşünüyorsanız organizatörlerle iletişime geçip yarışmayı soruşturma süresince durdurmalarını isteyebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401030441
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401030441,
					"content": "İyi bir fikir! Tamam o halde, hadi etkinlik alanına gidip Kareena'ya neler olup bittiğini söyleyelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
