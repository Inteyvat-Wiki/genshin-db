				"points": []
			},
			"dialogs": [
				{
					"id": 120040101,
					"content": "Hımm, şimdi ne yapacağız? Bir planın var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120040102,
					"content": "Gezgin, Paimon. Bekleyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040103
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040103,
					"content": "Ha? Ayaka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120040104,
					"content": "Bir sorun mu var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120040105
					]
				},
				{
					"id": 120040105,
					"content": "Bir şey çıktı, senin yardımına ihtiyacım var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040106
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040106,
					"content": "Endişelenmene gerek yok. Yashiro Heyeti ya da Kamisato Klanından gelen bir şey değil. Benim şahsi isteğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040107
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040107,
					"content": "Şahsi isteğin mi? Yani, özel hayatınla ilgili bir şey mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120040108,
					"content": "Evet. Annemle ilgili bir şey.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040109
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040109,
					"content": "Bu sana biraz ani gelebilir... Fakat bana göre bu konuda güvenebileceğim tek kişi sensin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040110
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040110,
					"content": "Biraz daha detaylı olarak açıklayabilir misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120040111
					]
				},
				{
					"id": 120040111,
					"content": "Birkaç gün önce, bazı eski aile eşyalarını karıştırırken anneme ait olan bir defter buldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040112
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040112,
					"content": "Her türlü şey hakkında yazmıştı, birçoğu önemsiz şeylerdi. Ama asıl dikkatimi çeken bir isimdi, daha önce hiç duymadığım bir isim. Sık sık ondan bahsetmesi, görmezden gelmemi zorlaştırıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040113
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040113,
					"content": "Muhtemelen annenin yakın arkadaşıdır değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120040114,
					"content": "Gerçekten o ismi daha önce hiç duymadın mı? Bir kere bile mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120040115
					]
				},
				{
					"id": 120040115,
					"content": "Hiç duymadım. Annem ve babam yıllar önce vefat etmiş olsalar da hem erkek kardeşim hem de ben onların tanıdıklarının büyük çoğunluğuna aşinayız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040116
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040116,
					"content": "Yani... Bu gizemli kişiyi çok merak ediyorum. Onunla tanışmak istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040117
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040117,
					"content": "Defterde yazdığına göre ismi \"Tsubaki.\" Bu kişi annem için çok önemli birine benziyor. Birçok farklı kişiliği olan, eğlenmeyi seven biri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040118
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040118,
					"content": "Hım... Paimon onun bir kız ismi olduğunu düşünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120040119,
					"content": "Ben de öyle düşünüyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040120
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040120,
					"content": "Peki bizim ne yapmamızı istiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120040121,
					"content": "Senin yerine onu bulmamızı mı istiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120040122,
					"content": "Hayır buna gerek yok, defterde adresi yazıyor. Doğruca yanına gidebiliriz. Bana hediye hazırlama konusunda yardımcı olmanızı istiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040123
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040123,
					"content": "Lütfen size söylediğim her şey aramızda kalsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040124
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040124,
					"content": "Aslında kardeşimi de alıp birlikte gitmek daha doğru olurdu ama o şu anda çok meşgul. Belki biraz bencilce olacak ama Inazuma'dan kimsenin bu işe karışmasını istemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040125
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040125,
					"content": "Bu yüzden bana geldin demek, yabancı olduğum için.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120040126
					]
				},
				{
					"id": 120040126,
					"content": "Kesinlikle. Bunun yanı sıra sen başkaları için gerçekten endişe duyan nazik ve iyi kalpli birisin... Güvenilir olduğunu da unutmamak lazım. Bu durumda senden başka hiç kimsenin yanında kendimi rahat hissetmem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040127
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040127,
					"content": "Bize güvenebilirsin! Daha önce hediye hazırlamışlığımız var, yardım edebiliriz. Ödemeye gelince... Bize lezzetli bir yemek ısmarlarsan çok mutlu oluruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120040128,
					"content": "Bu harika, aslında bu bahaneyle size etrafı göstermek istiyordum. Tabii ki bir sakıncası yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040129
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040129,
					"content": "#Ah, hiç de bile! Değil mi {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120040130,
					"content": "Zerre kadar yok hem de.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120040131
					]
				},
				{
					"id": 120040131,
					"content": "Teşekkür ederim! Gidelim mi o zaman? İlk durağımız Ogura Tekstil ve Kimono.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120040132
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120040132,
					"content": "Pekala! Şahane!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}