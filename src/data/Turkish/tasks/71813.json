			]
		},
		{
			"id": 7181305,
			"completionStepIds": [
				7181305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181305",
							"2"
						],
						"stepId": 7181305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130501,
					"content": "\"Bu büyük plan sayesinde, uzun yıllar yıkılmayacak bir Liyue'ye ve halkın refahına doğru yavaş fakat emin adımlarla ilerleyeceğiz.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130502
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130502,
					"content": "Ah, dönmüşsünüz. Bir saniye, son satırları bitirmek üzereyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130503
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130503,
					"content": "Hımm... İşte bitti. Buyurun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130504
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130504,
					"content": "Bu da istediğin Üç Mevsim Çorbası.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130505
					]
				},
				{
					"id": 718130505,
					"content": "Ah, o şimdi kalsın. Önce kitabı beğendiniz mi onu söyleyin. El yazımın beklentilerinizi karşılayacağına inanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130506
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130506,
					"content": "Harika bir iş çıkarmışsın...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130507
					]
				},
				{
					"id": 718130507,
					"content": "Hahaha, beni ziyadesiyle övüyorsunuz efendim. Kitap sizindir. Kaybetmeyin sakın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
		{
			"id": 7181306,
			"completionStepIds": [
				7181306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181306",
