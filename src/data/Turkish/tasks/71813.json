			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jifang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130201,
					"content": "Merhaba. Almak istediğiniz bir şey var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130202
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718130202,
					"content": "\"Teyvat'ın İncisi\" adında bir kitap arıyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130203
					]
				},
				{
					"id": 718130203,
					"content": "\"Teyvat'ın İncisi\" mı? Şu anda stoklarımızda yok. Acelesi var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130204
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718130204,
					"content": "Yeşim Konak'ı yeniden inşa ediyorlar, o yüzden...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130205
					]
				},
				{
					"id": 718130205,
					"content": "Öyle mi? O halde hazırlıklar düzgünce yapılmalı, evet. Bir düşüneyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130206
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718130206,
					"content": "Belki gidip Qingzhou'ya sorabilirsiniz. Çok kitap okuyan biridir kendisi. \"Teyvat'ın İncisi\" kitabını nerede bulabileceğinizi biliyordur belki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130207
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 718130207,
					"content": "Anladım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130208
					]
				},
				{
					"id": 718130208,
					"content": "Hatırladığım kadarıyla Qingzhou genelde Wangshu Hanında kalıyor. Oraya gidip bakabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jifang"
				}
			]
		},
		{
			"id": 7181303,
			"completionStepIds": [
				7181303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181303",
							"2"
						],
						"stepId": 7181303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130301,
					"content": "Bu nasıl bir muammadır böyle, ne can sıkıcı bir durum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130302
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130302,
					"content": "Şey, \"Teyvat'ın İncisi\" diye bir kitap biliyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130303
					]
				},
				{
					"id": 718130303,
					"content": "\"Teyvat'ın İncisi\" mi dediniz? Evet, o kitabı hatırlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130304
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130304,
					"content": "Evvel zaman içinde tüccarlar hakkında bir şiir yazarken fikir edinmek için dört bir yanı dolaşmıştım. Bahsettiğin kitaba da o sırada rastladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130305
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130305,
					"content": "Kitabın içeriğini tamamen anlamamıştım fakat bazı kısımları pek ilham vericiydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130306
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130306,
					"content": "Şiirin ismini hatırlamaya çalışayım. Bir saniyenizi rica edeceğim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130307
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130307,
					"content": "Kitabı nerede bulabileceğimi biliyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130308
					]
				},
				{
					"id": 718130308,
					"content": "Ah, kitabın yerini mi bulmaya çalışıyorsunuz? Korkarım nerede olduğu hatırıma gelmiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130309
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130309,
					"content": "Ancak acil gerekiyorsa kitabın bir kopyasını sizin için yazabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130310,
						718130311
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130310,
					"content": "Yazabilir misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130312
					]
				},
				{
					"id": 718130312,
					"content": "Uzun bir metin değildi zaten. Ezberlemesi pek kolay olmuştu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130313
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130313,
					"content": "Bir de zannediyorum kitap koleksiyoncusu kitabı bana ödünç vermeyi reddetmişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130314
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130314,
					"content": "Şiir sanatı aceleye gelmez. O yüzden ben de istediğim zaman kullanabilmek adına bir kopyasını çıkarmaya karar vermiştim. Kitabın içeriği de pek uzun olmadığı için şu an neredeyse tamamı ezberimde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130315
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130315,
					"content": "Gerçekten çok etkilendim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130316
					]
				},
				{
					"id": 718130316,
					"content": "Ah, lafı bile olmaz efendim. Yine de dilerseniz metni elimle yazmam karşılığında bana bir iyilik yapabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130317
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130317,
					"content": "Pek utanç verici bir şey isteyeceğim sizden... İlham bulmaya o kadar odaklanmışım ki bugün hiç yemek yemediğimi yeni fark ediyorum. Karnım zil çalıyor adeta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130318
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130318,
					"content": "Bana bir tabak Üç Mevsim Çorbası getirebilir misiniz acaba? Karşılığında size \"Teyvat'ın İncisi\" kitabının bir nüshasını yazacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130319
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130319,
					"content": "Siz dönene kadar bitirmiş olurum diye düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718130311,
					"content": "Ezberinden mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130312
					]
				}
			]
		},
		{
			"id": 7181304,
			"completionStepIds": [],
