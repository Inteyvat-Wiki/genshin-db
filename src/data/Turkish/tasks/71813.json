					],
					"speakerTitle": "Usta Lu"
				},
				{
					"id": 718130702,
					"content": "Evet, hepsi kaçtı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130703
					]
				},
				{
					"id": 718130703,
					"content": "Tamam o zaman. Birazdan gidip bambu toplayacağım. Süs eşyaları hazır olunca doğrudan Yuehai Konağı'na gönderirim.",
					"roleType": "TALK_ROLE_NPC",
