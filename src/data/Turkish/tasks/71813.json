				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Usta Lu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718130601,
					"content": "Buyur, ne istemiştin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130602
					],
					"speakerTitle": "Usta Lu"
				},
				{
					"id": 718130602,
					"content": "Bambudan yapılmış ufak süs eşyaları sipariş etmek istiyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130603
					]
				},
				{
					"id": 718130603,
					"content": "Bambudan süs eşyaları demek... Yapabilirim elbette, fakat bu siparişin kimden geldiğini öğrenebilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130604
					],
					"speakerTitle": "Usta Lu"
				},
				{
					"id": 718130604,
					"content": "Baiwen'in verdiği bir listede yazıyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130605
					]
				},
				{
					"id": 718130605,
					"content": "Ah... Yuehai Konağı'ndan bir sipariş demek. O halde mümkün olduğunca çabuk hazırlayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130606
					],
					"speakerTitle": "Usta Lu"
				},
				{
					"id": 718130606,
					"content": "Ancak bir sorun var. Neden bilmiyorum ama benim sık sık malzeme toplamaya gittiğim bambu ormanı birdenbire bir sürü yaban domuzuyla doluverdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130607
					],
					"speakerTitle": "Usta Lu"
				},
				{
					"id": 718130607,
					"content": "Çok büyük bir sıkıntı değil fakat bambu toplamak için etraflarından dolaşmam gerekiyor genelde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130608
					],
					"speakerTitle": "Usta Lu"
				},
				{
					"id": 718130608,
					"content": "Yaban domuzlarını uzaklaştırabilirsen hemen gidip bambu toplayabilirim. Böylece çabucak işe koyulabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130609
