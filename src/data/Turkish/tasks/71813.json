			"dialogs": [
				{
					"id": 718130401,
					"content": "\"Teyvat'ın İncisi\"... Nasıl başlıyordu... Ah, doğru ya. \"Ticaret ve takas dağlarla başlayıp denizlerle son bulur, tıpkı pınarlar ve dereler gibi...\"",
					"roleType": "TALK_ROLE_NPC",
