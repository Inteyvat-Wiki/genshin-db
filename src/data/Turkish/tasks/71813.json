				{
					"id": 718130801,
					"content": "Merhaba, nasıl yardımcı olabilirim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130802
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718130802,
					"content": "Yaptığınız hazırlıklarla ilgili...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130803
					]
				},
				{
					"id": 718130803,
					"content": "Yoksa bu... \"Teyvat'ın İncisi\" mi? Bunu nereden buldun? Ben Liyue'nin altını üstüne getirmeme rağmen bulamamıştım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130804
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718130804,
					"content": "Qingzhou bana kendi eliyle kopyasını yazıp verdi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130805
					]
				},
				{
					"id": 718130805,
					"content": "Şair Qingzhou mu? Şöhretinin hakkını veriyormuş gerçekten de.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130806
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718130806,
					"content": "Bu eşyaları hazırlamamıza yardım ettiğin için sağ ol. Usta Lu süs eşyalarını gönderince ona da emeğinin karşılığı verilecek elbette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130807
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718130807,
					"content": "Yeşim Konak'ı yeniden inşa ediyorsunuz demek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718130808
					]
				},
				{
					"id": 718130808,
					"content": "Evet, planlarımız bu yönde. Ancak daha hazırlanması gereken bir sürü şey var. O kadar çok işimiz var ki inşaatın çabuk biteceğini hiç sanmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130809
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718130809,
					"content": "Hele malzemelerden biri başımızı o kadar ağrıttı ki sorma. Ona hâlâ bir çözüm bulamadık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718130810
					],
					"speakerTitle": "Baiwen"
				},
				{
					"id": 718130810,
					"content": "Neyse, bundan bahsetmeyeceğim şimdi. Yardımın için tekrar teşekkürler. Lütfen karşılığında bunları kabul et. İzninle artık işime geri dönmem lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Baiwen"
				}
			]
