			},
			"dialogs": [
				{
					"id": 746820101,
					"content": "Sonunda geldik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820102
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820102,
					"content": "Peki çocukluk hayalin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746820103
					]
				},
				{
					"id": 746820103,
					"content": "Küçükken konuştuğum Orman Gözcülerinin suratlarının neden buruştuğunu yetişkin olunca anladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820104
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820104,
					"content": "*öksürür* Neyse, ben elimden geleni yaptım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820105
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820105,
					"content": "Hem Yalancı Ateş Ağacının işlenmemiş meyvesini Yeşimkuyruk Mantar Kuşunun yakınına götürmemem gerektiğini de öğrendim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820106
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820106,
					"content": "Yanık kokusu aldığımda çok geçti artık. Neredeyse yaydığı sporların içinde boğulacaktım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820107
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820107,
					"content": "Bazen Mantarların, Küflü Domuzlardan tamamen farklı bir tür olduğu çıkıyor aklımdan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820108
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820108,
					"content": "Hazır konusu açılmışken, onlar gerçekten bir tür mantar, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746820109,
					"content": "Evet, özellikle de çorbada kullanıldıklarında müthiş lezzet katarlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820110
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820110,
					"content": "Neyse, biz bugünkü mücadelemize dönelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746820111,
					"content": "Ben bugün ne pişirsem bulamadım ki... Aa! Doğru, tamam, \"müzakerelerden\" bahsediyorsun. Pardon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820112
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820112,
					"content": "İki Fontemer Sapkını lordunun hikayesini duymuşsunuzdur belki. Bin Yıllık İnci Denizatının ne kadar \"gururlu\" ve \"asil\" olduğu anlatılır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820113
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820113,
					"content": "Buna karşın Ateş ve Demir İmparatorundan da güçlü, acımasız ve zalim bir varlık olarak bahsedilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820114
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820114,
					"content": "Sen de tabii daha zorlu olan düşmanı seçmişsindir. Sonuçta karşındaki ne kadar güçlü olursa o kadar havalı bir hikaye çıkar ortaya, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746820115,
					"content": "Doğru ama Ateş ve Demir İmparatoru, ağır zırhlı bir yengeç... Öte yandan diğer seçeneğimizse uçabilen bir denizatı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820116,
						746820118
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820116,
					"content": "Uçan bir denizatı yerine Pegasus mu demeliyiz acaba?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746820117
					]
				},
				{
					"id": 746820117,
					"content": "Bir dakika, şu anda sormamız gereken soru bu mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746820119,
					"content": "Yine de bir kerecik olsun binebilseydim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820120
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820120,
					"content": "Pekala o zaman. Anlaşılan bu defa sonuna kadar gideceksin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746820121,
					"content": "Sonuçta buraya kadar geldik, değil mi? Elimiz boş dönmek olmaz. Neyse, hazır olduğunuzda gidelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820122,
						746820123
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820122,
					"content": "Hazırım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 746820123,
					"content": "Halletmem gereken başka işler var. Birazdan görüşürüz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746820124
					]
				},
				{
					"id": 746820124,
					"content": "Sorun değil. Ben seni burada bekliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 746820118,
					"content": "Benim için bir farkı yok...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746820119
					]
				}
			]
		}
	]
}