			"dialogs": [
				{
					"id": 110040301,
					"content": "♪ Kendime bir Yalancı Buz Ağacı aldım, onu yemeğe pişiririm... ♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040302
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110040302,
					"content": "♪ Bir parça domuzla birleşirse daha da iyi... ♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040303,
						110040305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110040303,
					"content": "Onu cesaretlendirmeyi bırak!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110040304
					]
				},
				{
					"id": 110040304,
					"content": "Biraz neşelen! Bu dünyada nadir malzemeler bulmaktan daha keyifli ne olabilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040307
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110040307,
					"content": "Bekle, burada başka bir şey var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040308
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110040308,
					"content": "Bu, avcının kovaladığı yaban domuzu olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110040309,
					"content": "Ama Paimon, daha önce bu desene sahip bir şeyi hiç görmemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110040310,
					"content": "Bunu daha önce nerede gördüm? Hımm... Aha! Bu, \"Liyue Doğa Tarihi\" içerisinde yer alıyordu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040311
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110040311,
					"content": "Bu desen özgün bir şey. 300 yıl önce nesli tükenen bir yaban domuzu türüne ait!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040312
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110040312,
					"content": "Vay canına! Bu kadar uzun zaman sonra nasıl hâlâ yaşıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040313,
						110040315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110040313,
					"content": "Tesadüfen olan bir dondurarak saklama işlemi mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110040314
					]
				},
				{
					"id": 110040314,
					"content": "Olabilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110040317,
					"content": "Bu yaban domuzunun etinin çok değerli olduğu için avlanarak neslinin tükendiğini okumuştum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040318
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110040318,
					"content": "Yalancı Buz Ağacı ve nesli tükenmiş yaban domuzu. Bir değil, iki tane paha biçilemez hazine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040319
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110040319,
					"content": "Bu bizim galibiyet biletimiz olacak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110040320
					]
				},
				{
					"id": 110040320,
					"content": "Haklısın. Hadi Pınarköy'e geri dönelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110040315,
					"content": "Kalıtsal bir şans mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110040316
					]
				},
				{
					"id": 110040316,
					"content": "Paimon, bunun gerçekten mümkün olamayacağından oldukça emin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110040305,
					"content": "♪ Onları bir bardak şarapla yıkayıp temizle... ♪",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110040306
					]
				},
				{
					"id": 110040306,
					"content": "Hahaha... Senin yorumun bunu berbat etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040307
					],
					"speakerTitle": "Xiangling"
				}
			]
		}
	]
