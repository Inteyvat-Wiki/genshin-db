			"dialogs": [
				{
					"id": 40190101,
					"content": "Sigewinne!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190102,
					"content": "#{NICKNAME}, Paimon, dönmüşsünüz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190103
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190103,
					"content": "İyi misiniz? Yaralandınız mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190104
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190104,
					"content": "Merak etme, ikimiz de iyiyiz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190105
					]
				},
				{
					"id": 40190105,
					"content": "Bir şeyimiz yok! Siz nasılsınız? Ortalık darmaduman oldu! Çok sıkıntı yaşadınız mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190106,
					"content": "Sadece birkaç kişi hafif yaralandı o kadar, başka bir zarar görmedik. Mösyö Neuvillette ziyaret etti. Krizi şimdilik onun sayesinde bastırdık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190107
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190107,
					"content": "Tabii ki yardımlarınız için siz de teşekkürü hak ediyorsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190108
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190108,
					"content": "Burada ona ihtiyaç olduğunu Neuvillette nereden biliyordu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190109,
					"content": "Mösyö Neuvillette'in Su elementiyle güçlü bir bağı var. Su seviyesi yükseldiğinde oluşan dalgaları hissedebiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190110
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190110,
					"content": "Yaralıların yaralarını sararken Bomba Kardeşler ile karşılaştım. Tek kelime etmeden nasıl aşağıya koştuğunuzdan bahsediyorlardı... İkinizin de iyi olduğunu görmek içime su serpti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190111
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190111,
					"content": "Acil bir işiniz yoksa lütfen birkaç gün daha bizimle kalın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190112
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190112,
					"content": "Canınız herhangi bir şey çekiyorsa bana haber verin, istediğiniz yemeği Bay Wolsey'ye hazırlatabilirim. Ha, ayrıca istediğiniz zaman dinlenmek için revire uğramaktan da çekinmeyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190113
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 40190113,
					"content": "Bu fırsatı değerlendirerek yüz kaslarınızı biraz daha incelemek istiyorum. Mutluluk dolu gülümsemeniz bulaşıcı. Hatta o kadar değerli ki siz gider gitmez özledim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sigewinne"
				}
			]
		},
