			"dialogs": [
				{
					"id": 40190401,
					"content": "Ha? Siz... Siz geri mi döndünüz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190402
					],
					"speakerTitle": "Cuistot"
				},
				{
					"id": 40190402,
					"content": "Cuistot! Laverune!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190403,
					"content": "Siz... Yakalanıp tekrar mı buraya atıldınız yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190404
					],
					"speakerTitle": "Laverune"
				},
				{
					"id": 40190404,
					"content": "Ne? Hayır, hiç de bile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190405,
					"content": "Off! Ben de kargaşa sırasında hapisten kaçtığınızı düşünmüştüm. Sizi efsanevi kaçaklar olarak görüyordum ama şimdi bana... Hiç kaçmadığınızı mı söylüyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190406
					],
					"speakerTitle": "Cuistot"
				},
				{
					"id": 40190406,
					"content": "Ahahaha... Şey, üzgünüz ama... Halletmemiz gereken bazı işler vardı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190407,
					"content": "Pekala, pekala, detaylara takılmaya gerek yok. Sizi gördüğümüze sevindik. Sizin için çok endişelenmişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190408
					],
					"speakerTitle": "Laverune"
				},
				{
					"id": 40190408,
					"content": "Hey, endişelenen sadece ben değildim! Sen de çok endişelenmedin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190409
					],
					"speakerTitle": "Cuistot"
				},
				{
					"id": 40190409,
					"content": "Evet, öyle sayılır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190410
					],
					"speakerTitle": "Laverune"
				},
				{
					"id": 40190410,
					"content": "Ben de birkaç gün önce mutfakta çalışmaya transfer edildim. Hâlâ Cuistot'nun havuçlarla uğraşırken mırıldandığını duyabiliyorum: \"O ikisi iyi midir? Sence canlı bir şekilde çıkabildiler mi?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190411
					],
					"speakerTitle": "Laverune"
				},
				{
					"id": 40190411,
					"content": "Her öyle dediğinde ben de ona \"İyi olduklarına eminim! Şu an neredelerse arkalarına yaslanmış, içeceklerini yudumlayıp manzaranın tadını çıkarıyorlardır.\" dedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190412
					],
					"speakerTitle": "Laverune"
				},
				{
					"id": 40190412,
					"content": "Hey! Hapishane arkadaşların için endişelenmekte yanlış bir şey yok, değil mi? Yani benim anlattığım bütün dedikoduları severek dinlediklerini düşünürsek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190413
					],
					"speakerTitle": "Cuistot"
				},
				{
					"id": 40190413,
					"content": "Bu ikisi... Paimon'la ilk tanıştıkları zamana kıyasla çok daha içten ve arkadaş canlısı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190414,
						40190415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190414,
					"content": "Yemek Yardımlarının kalitesi son zamanlarda zirveye çıkmış olmalı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190416
					]
				},
				{
					"id": 40190416,
					"content": "... Şey, sen öyle diyorsan öyledir. Her lokmayı yediğinizden emin olmak için gözüm üzerinizde olacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cuistot"
				},
				{
					"id": 40190415,
					"content": "Sizin yemekleriniz bütün mahkumları kantine getirecek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190416
					]
				}
			]
		},
