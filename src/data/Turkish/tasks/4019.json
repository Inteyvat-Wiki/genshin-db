			"dialogs": [
				{
					"id": 40190501,
					"content": "Jurieu! Bayan Sigewinne bana senin henüz bir şey yemediğini söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190502
					],
					"speakerTitle": "Lourvine"
				},
				{
					"id": 40190502,
					"content": "Şey, bir şeyle uğraşıyordum, unutmuşum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190503
					],
					"speakerTitle": "Jurieu"
				},
				{
					"id": 40190503,
					"content": "Bu ne biçim bahane... Ne? Siz mi geldiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190504
					],
					"speakerTitle": "Lourvine"
				},
				{
					"id": 40190504,
					"content": "Jurieu, Lourvine, geri döndük!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190505,
					"content": "Selamlar. Son zamanlarda buralar fena karıştı. Nasılsınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190506
					],
					"speakerTitle": "Jurieu"
				},
				{
					"id": 40190506,
					"content": "İyiyiz, teşekkürler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190507
					]
				},
				{
					"id": 40190507,
					"content": "Sizi sormalı? Hâlâ revirdeki gizli geçişten giderek gemi üzerinde çalışıyor musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190508,
					"content": "Evet. Hâlâ çok gizli ama. O yüzden kimseye tek kelime etmeyin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190509
					],
					"speakerTitle": "Lourvine"
				},
				{
					"id": 40190509,
					"content": "Revir kalabalık olduğunda biraz zahmetli oluyor ama ben yine de Dükün ofisinden geçmektense revirden gitmeyi tercih ediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190510
					],
					"speakerTitle": "Jurieu"
				},
				{
					"id": 40190510,
					"content": "Revire kaçıp işten kaytarmak kolayına geliyor tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190511
					],
					"speakerTitle": "Lourvine"
				},
				{
					"id": 40190511,
					"content": "Öyle mi? O zaman sen neden hep buradasın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190512
					],
					"speakerTitle": "Jurieu"
				},
				{
					"id": 40190512,
					"content": "Siz ikiniz ilişkinizi gizlemek için işinizi bahane olarak kullanıyorsunuz, öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190513,
					"content": "Ne alaka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jurieu"
				}
			]
		},
