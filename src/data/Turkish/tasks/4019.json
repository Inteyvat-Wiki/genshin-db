				},
				{
					"id": 40190302,
					"content": "Kalede durumların nasıl olduğunu görmek istedik! Her şey yolunda mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190303,
					"content": "İyi gibiyiz. Neuvillette gelip büyük sorunu halletti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190304
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190304,
					"content": "Madem öyle, ona burada kalmasını teklif etmeye ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190305,
					"content": "Aa, süper fikirmiş. Hadi gidip Iudex'i Fontaine Şehri yerine hiçliğin ortasındaki bir su birikintisinde yaşamaya ikna edelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190306
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190306,
					"content": "İşe yarayacağını pek sanmıyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190307
					]
				},
				{
					"id": 40190307,
					"content": "Buraya aceleyle geldi, sonra bir bardak çay bile içmeden gitti. Bayan Sigewinne'in verdiği hediyeyi yanına almayı unutmadı ama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190308
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190308,
					"content": "Çok meşgulmüş herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190309,
					"content": "Bayan Clorinde de gitti. O da giderken Bayan Sigewinne'in verdiği hediyeyi aldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190310
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190310,
					"content": "Hediyeler milkshake miydi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190311,
					"content": "Neuvillette milkshake aldı. Clorinde ise ruj.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190312
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190312,
					"content": "Ne? İki hediyenin uzaktan yakından alakası yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190313,
					"content": "Şey, bu aslında Neuvillette'in kendi suçu, o kadar çok çalışarak Sigewinne'i sağlığı için endişelendirdi. Bunu görmezden gelsek bile başhemşiremiz kadınlara güzellik ürünleri hediye etmeye bayılıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190314
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190314,
					"content": "Aa, sizin için de hediyelerim var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190315
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190315,
					"content": "Bunları da Sigewinne mi gönderdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190316,
					"content": "Hayır, bunlar bizzat benim size hediyem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190317
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190317,
					"content": "Kaledeki işiniz bittiğine göre istediğiniz zaman yüzeye dönebilirsiniz. Ancak cezanızın tamamını henüz çekmediniz, bu yüzden süreniz dolana kadar hücrenizi kullanmaya devam edebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190318
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190318,
					"content": "Gerçekten mi? O zaman burada çok uzun bir süre boyunca kalabiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190319,
					"content": "Yemeklerimiz karşılanacak mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190320
					]
				},
				{
					"id": 40190320,
					"content": "Kantini ücretsiz olarak kullanabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190321
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 40190321,
					"content": "Yaşasın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190322,
					"content": "Serbest kalma zamanınız geldiğinde belgelerinizi bana getirip doldurtmayı unutmayın ama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wriothesley"
				}
			]
		},
