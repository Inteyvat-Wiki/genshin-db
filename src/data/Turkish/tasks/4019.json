			"dialogs": [
				{
					"id": 40190601,
					"content": "Hücremize döndük! Ama artık mahkum değiliz, o yüzden aynı hissettirmiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190602,
					"content": "Omuzlarımızdan büyük bir yük kalktı sanki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190603
					]
				},
				{
					"id": 40190603,
					"content": "Evet, öyle geliyor... Ama aslında en başında kötü bir şey yapmamıştık, o yüzden kendimizi neden bu kadar strese soktuk Paimon anlamıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190604,
					"content": "Özgürlüğümüzü kazanmışız gibi hissediyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190605
					]
				},
				{
					"id": 40190605,
					"content": "Hıhı! Özgür olmak gerçekten özel hissettiriyor şimdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190606,
					"content": "Söylemek istediğin bir şey mi var Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190607
					]
				},
				{
					"id": 40190607,
					"content": "Ne? Nasıl bildin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190608,
					"content": "Çünkü genellikle hemen uyuyakalırdın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190609
					]
				},
				{
					"id": 40190609,
					"content": "Hey, bu doğru değil! Pekala... Tamam, Paimon sadece ne kadar harika bir ikili olduğumuzu söylemek istiyordu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190610,
					"content": "Hani... Birlikte bir sürü yere gittik ve birçok arkadaş edindik. Gezmeyi ya da arkadaş edinmeyi hiç bırakmadık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190611,
					"content": "Dünyada bir sürü kötü olay yaşanıyor, biz de sadece iki kişiyiz ama nereye gidersek gidelim karşılaştığımız sorunları çözüyoruz hep. Bu çok havalı değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190612,
					"content": "Teyvat'ın en iyi maceracıları biziz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190613
					]
				},
				{
					"id": 40190613,
					"content": "Paimon'u da mı saydın bugün? Aramızdaki tek maceracı sen değil misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190614,
					"content": "Rehber olmak da sayılır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190615
					]
				},
				{
					"id": 40190615,
					"content": "O zaman Katheryne'e söyleyelim Paimon'a da bir Maceracının El Kitabı versin! Bugünden sonra Paimon da artık bir maceracı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190616,
					"content": "Ayy, düşüncesi bile Paimon'un içini kıpır kıpır etti... Paimon uyuyacak şimdi, sen de çok geçe kalmadan uyu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190617,
					"content": "En son burada uyuyakaldığımızda hücremizin dışında fena bir kargaşa yaşanmıştı ve Ezeli Deniz Suyu az kalsın taşacaktı. Çok korkunçtu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190618,
					"content": "Artık güvendeyiz ama, öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190619,
					"content": "Güvendeyiz, merak etme Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190620
					]
				},
				{
					"id": 40190620,
					"content": "#Pekala, o zaman iyi geceler {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190621,
					"content": "Sana da iyi geceler Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
