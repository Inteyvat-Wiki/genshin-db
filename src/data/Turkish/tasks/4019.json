			"dialogs": [
				{
					"id": 40190201,
					"content": "Şimdi tahmin et bakalım! Bir sonraki kart hangisi olacak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190202
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 40190202,
					"content": "Şey... Dişli kedi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190203
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 40190203,
					"content": "Bak sen, kimler gelmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190204
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 40190204,
					"content": "#{NICKNAME}, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190205
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 40190205,
					"content": "Selam millet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190206
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 40190206,
					"content": "Görünüşe bakılırsa güzelce iyileşiyorsun Freminet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190207,
					"content": "Hıhı, desteğiniz için teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190208
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 40190208,
					"content": "Ha, doğru! Ben... Cesaretimi toplayıp Bayan Clorinde'e bizzat teşekkür ettim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190209
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 40190209,
					"content": "Vay be, nasıl bir tepki verdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190210,
					"content": "\"Önemli değil\" dedi... Sanki bir can kurtarmak onun için öyle büyük bir başarı değilmiş gibi. Ayrıca kafaya takmamamı da söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190211
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 40190211,
					"content": "Seni strese sokmak istememiş, hepsi bu. Haklı bu arada, üzerine çok düşünmene gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190212
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 40190212,
					"content": "Evet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190213
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 40190213,
					"content": "Peki, bakın ne anlatacağız şimdi! Opera salonuna geri döndük ve Yaver ile karşılaştık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190214,
					"content": "\"Babamız\" ile mi karşılaştınız? Size bir şey dedi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190215
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 40190215,
					"content": "Bir şeyler söyledi ama... Anlamakta zorlandık. Ayrıca ileride bizimle çalışmayı dört gözle beklediğini de söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190216,
					"content": "Biraz şaşırtıcıydı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						40190217
					]
				},
				{
					"id": 40190217,
					"content": "Size karşı olan tavrı hayal ettiğimizden çok daha iyiymiş... Harika.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190218
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 40190218,
					"content": "Ona inanmalısınız. İşleri kendi yöntemleriyle halletmeyi sever ve yakın gördüğü kişilere yardım etmek için elinden ne geliyorsa yapar. Artık sizi de yakın görüyor olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190219
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 40190219,
					"content": "Hıhı. \"Babamız\" çok becerikli ve güvenilir biri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190220
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 40190220,
					"content": "Aa, Paimon şimdi hatırladı, Lyney'nin biraz fazla gururlu olduğunu söylemişti! Ayrıca dedi ki bazen başkalarına da güvenmeyi öğrenmeliymişsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190221,
					"content": "Şey... Anladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190222
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 40190222,
					"content": "Bu tam da \"Babamızın\" söyleyeceği bir şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190223
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 40190223,
					"content": "Hey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190224
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 40190224,
					"content": "Önümüzdeki birkaç gün boyunca burada mı kalacaksınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190225
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 40190225,
					"content": "Görünüşe göre evet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190226,
					"content": "Harika. Çay saati düzenleyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190227
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 40190227,
					"content": "Gerçekten mi? O zaman Paimon bir dilim daha kek istiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 40190228,
					"content": "\"Daha\" dediğine göre yukarıdayken sana çoktan lezzetli bir dilim kek verilmiş. Hımm, ne kadar hoş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						40190229
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 40190229,
					"content": "Bir dahaki sefere bizimle çay içip bir şeyler yersin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lynette"
				}
			]
		},
