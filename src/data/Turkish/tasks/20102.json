				{
					"id": 201020701,
					"content": "Geri gelmişsin. Mektubu götürdün mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020702
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020702,
					"content": "Timmie bu mektubu babasına yollamanı istiyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020703
					]
				},
				{
					"id": 201020703,
					"content": "Timmie hâlâ babasına mektup yazıyor. Tüm hikayeyi Grace'ten duydun sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020704
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020704,
					"content": "Ben... Ben bunu yollayamam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020705,
						201020708,
						201020712
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020705,
					"content": "Tamam. Yollama sen de.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020706
					]
				},
				{
					"id": 201020706,
					"content": "Yani, evet... Ne kadar istesem de yapamam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020707
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020707,
					"content": "Yapabileceğim hiçbir şey yok, şimdilik onu saklayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020717
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020717,
					"content": "Neyse, yeter bu konu. Mektubu saklayacağım. Lütfen göndermişim gibi yap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020718
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020718,
					"content": "O anlayacaktır... Canım eski dostum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020719
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020719,
					"content": "Yardımın için teşekkürler ve lütfen Timmie'ye bundan bahsetme. Bu konuda sana güvenebilirim, değil mi? Bununla birlikte işte ödemen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020708,
					"content": "Yak gitsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020709
					]
				},
				{
					"id": 201020709,
					"content": "Hahaha... İçindeki maceracı konuştu! Her durumda kararlı ve işgüzar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020710
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020710,
					"content": "Ben bir maceracı değilim. Sadece yaşlı bir avcıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020711
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020711,
					"content": "Yakmayacağım, hatta açmayacağım bile. Şimdilik sadece saklayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020717
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020712,
					"content": "İzin ver bende kalsın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020713
					]
				},
				{
					"id": 201020713,
					"content": "Neden? Eski arkadaşımın hâlâ hayatta olduğunu düşünmüyorsundur umarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020714
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020714,
					"content": "Bir yerlerde bulunmayı beklediğini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020715
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020715,
					"content": "Evet, eskiden ben de bunu düşünürdüm. Hatta çıkıp aradım bile ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020716
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020716,
					"content": "En sonunda gerçekleri kabul etmek zorunda kaldım. Dostum aramızdan ayrıldı ve asla dönmeyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020717
					],
					"speakerTitle": "Draff"
				}
			]
		},
