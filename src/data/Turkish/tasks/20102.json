			"dialogs": [
				{
					"id": 201020601,
					"content": "Karahindibalarımı getirdin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020602
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020602,
					"content": "Getirdim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020603
					]
				},
				{
					"id": 201020603,
					"content": "Yaşasın! Bir sürü var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020604
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020604,
					"content": "Karahindiba Tohumlarını da koyduktan sonra zarfımızı mühürleyebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020605
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020605,
					"content": "Her şey hazır! Yaşasın! Babam mektubumu aldığında çok mutlu olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020606
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020606,
					"content": "Ama... Mektup yollamak istediğinde eğitimli bir güvercin kullanman gerekiyormuş. Babamın adresini de bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020607
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020607,
					"content": "Ah, dur. Şimdi hatırladım. Annem, Pınarköy'den Bay Draff'ın posta güvercinleri olduğunu söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020608
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020608,
					"content": "Bay Draff'ın babamı tanıdığını da söylemişti. Mektubu o gönderebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020609
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020609,
					"content": "Şey... Bana tekrar yardım edebilir misin? Bu mektubu Bay Draff'a götür, benim için babama yollamasını söyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020610
					],
					"speakerTitle": "Timmie"
				},
				{
					"id": 201020610,
					"content": "Bir şey daha... Okumak yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timmie"
				}
			]
		},
