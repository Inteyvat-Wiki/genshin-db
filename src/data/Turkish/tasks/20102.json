			"dialogs": [
				{
					"id": 201020101,
					"content": "*iç çeker* Acaba çocuk neler yapıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020102
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020102,
					"content": "Sorun ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020103
					]
				},
				{
					"id": 201020103,
					"content": "Hımm... Ah, selam. Mükemmel zamanlama, geçen seferki mektubu hatırlıyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020104
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020104,
					"content": "Vaktin olursa lütfen bu mektubu benim için Grace'e ilet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020105,
						201020107
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020105,
					"content": "Tamam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020106
					]
				},
				{
					"id": 201020106,
					"content": "Teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020107,
					"content": "Neden ben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020108
					]
				},
				{
					"id": 201020108,
					"content": "Geçen sefer olanlardan sonra bu güvercinlere biraz zor güvenirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020109
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020109,
					"content": "Ayrıca mektubu Mondstadt'a kendim götürürsem çocukla yüzleşmem gerekir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020110
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020110,
					"content": "*iç çeker* Sorma... Sadece... Lütfen. Bunu benim için yap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				}
			]
		},
		{
			"id": 2010202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
