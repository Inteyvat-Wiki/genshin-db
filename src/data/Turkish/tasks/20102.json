			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Draff"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201020201,
					"content": "Mektubumu götürmen gerekmiyor muydu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020202,
						201020205
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020202,
					"content": "Mektupla ilgili...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020203
					]
				},
				{
					"id": 201020203,
					"content": "Çok eskiden yaşanmış bir olay hakkında. Önceki mektubu okumadın sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020204
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020204,
					"content": "Boş ver, okuma. Sıkıcı ve çok uzun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020205,
					"content": "Çocuk kim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020206
					]
				},
				{
					"id": 201020206,
					"content": "Bilmen gerekiyorsa köprüde sürekli güvercinleri besleyen çocuktan bahsediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020207
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020207,
					"content": "Evet, Timmie. Bazı nedenlerden dolayı şimdilik onunla karşılaşmasam iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020208
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 201020208,
					"content": "Mutlu musun? Şimdi, Grace kafayı yemeye başlamadan git bu mektubu ona götür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				}
			]
		},
		{
			"id": 2010203,
			"completionStepIds": [
				2010202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2010202",
							"2"
						],
						"stepId": 2010202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Grace"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201020301,
					"content": "Garip, şimdiye burada olmalıydı... Ya bir şey olduysa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020302
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020302,
					"content": "Sana bir mektup var, Draff'tan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020303
					]
				},
				{
					"id": 201020303,
					"content": "Hımm? Ne yapıyorsun burada? Sen bir posta güvercini değilsin ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020304
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020304,
					"content": "Güvercinlere bir şey mi oldu? Amanın, Pınarköy'de bir gün bile sakin geçmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020305
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020305,
					"content": "Şey, mektubu getirdiğin için teşekkürler. Bir saniye, karşılığında sana vermek istediğim bir şey var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020306
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020306,
					"content": "Mektupla ilgili...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020307
					]
				},
				{
					"id": 201020307,
					"content": "Ah, okudun mu? Bir şey fark edeceğinden değil, içindekiler gizli değildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020308
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020308,
					"content": "Draff'ın kelimeleriyle \"çok eskiden yaşanmış bir olay\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020309
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020309,
					"content": "Çok eskiden yaşanmış olsa da asla unutamayacağımız bir olay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020310
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020310,
					"content": "Lütfen devam et...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020311
					]
				},
				{
					"id": 201020311,
					"content": "Gerçekten bilmek istiyor musun? Sana güvenebilirim sanırım ama sır olarak kalacağına söz ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020312,
						201020313
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020312,
					"content": "Söz veriyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020316
					]
				},
				{
					"id": 201020316,
					"content": "Draff ile Timmie'nin babası çok yakın arkadaş. Birlikte avlanırlar, içerler, binbir türlü belaya bulaşırlar... Her şeyi birlikte yaparlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020317
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020317,
					"content": "Şövalyeler onları kaç kez uyardı, Rahibe Victoria onlara kaç kez nutuk çekti bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020318
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020318,
					"content": "Timmie doğduğu zaman babası hayatını yoluna koydu. İçkiyi bıraktı. Ailesi için çok çalışmaya başladı ve onun deyimiyle oğluna \"örnek\" oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020319
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020319,
					"content": "Timmie'ye örnek olmayı kafasına o kadar takmıştı ki Draff'a bile alkolü bıraktırdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020320
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020320,
					"content": "Dayanamayıp şişe devirmek istediklerinde buluşup çok fazla elma şarabı içtikleri zamanlar hariç tabii. Bir iki kere ben de onlara katılmıştım hatta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020321
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020321,
					"content": "Maalesef Timmie'nin babası bir gün av sırasında çok ağır yaralandı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020322
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020322,
					"content": "Draff elinden geldiğince çabuk bir şekilde onu buraya getirdi. Onu kurtarmak için elimizden gelen her şeyi yaptık ama... Maalesef kurtulamadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020323
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020323,
					"content": "O zamandan beri Draff, Pınarköy'e dönüp avlanırken benden de Timmie'ye bakmamı istedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020324
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020324,
					"content": "Her ay mektup yazıp biraz da para gönderir ama Timmie'nin yüzüne bakamıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020325
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020325,
					"content": "Son zamanlarda Timmie'ye o uğursuz günde yaşananları söylemek istediğinden bahsediyor. *iç çeker* Neler hissettiğini düşünmeye bile korkuyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020326,
						201020332,
						201020336
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020326,
					"content": "Timmie'nin gerçeği bilmesini istemiyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020327
					]
				},
				{
					"id": 201020327,
					"content": "Evet. O daha bir çocuk... Her şeyi anlatmanın mantıklı olmadığını düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020328
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020328,
					"content": "Her ne kadar koca adam olduğunu söyleyip Nora ve Glory'ye bakarken bana yardım etse de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020329
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020329,
					"content": "Tüm o korkunç ayrıntılara dayanabileceğinden emin değilim. Ona ağır gelir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020330
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020330,
					"content": "Büyüdüğünde belki ama şimdilik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020331
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020331,
					"content": "Mutlu bir çocukluk geçirmesini yeğlerim. Bu ona yalan söylememiz anlamına gelse bile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020341
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020341,
					"content": "Tabii, Timmie'nin büyüdüğünü inkar edemem. Her geçen gün daha da meraklanıyor ve daha fazla soru soruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020342
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020342,
					"content": "Gün geçtikçe onunla yüzleşmem daha da zorlaşıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020343
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020343,
					"content": "Nora, eskiden Timmie'nin onu sürekli ormana sürüklediğini, babasına bir hediye veya bir mektup göndermek istediğini söylüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020344
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020344,
					"content": "Bugünlerde çok durgun ve sürekli somurtuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020345
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020345,
					"content": "Zamanın olursa benim için Timmie'yi kontrol eder misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020346,
						201020348
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020346,
					"content": "Tamam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020347
					]
				},
				{
					"id": 201020347,
					"content": "Harika, teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020348,
					"content": "Neden sen bakmıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020349
					]
				},
				{
					"id": 201020349,
					"content": "Biraz garip olacak ama her ne kadar ona gerçeği söylemeyeceğim desem de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020350
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020350,
					"content": "Ne zaman babasına bir mektup yazmak istediğini söylese içim yanıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020351
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020351,
					"content": "Bir gün ona hikayenin tamamını anlatmaktan kendimi alamayacağımdan korkuyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020352
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020352,
					"content": "Buna izin veremem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020353
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020353,
					"content": "Lütfen, benim yerime Timmie'yi kontrol et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020332,
					"content": "Bunu sonsuza kadar saklayamazsın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020333
					]
				},
				{
					"id": 201020333,
					"content": "Saklayamayacağımı biliyorum ama o daha çok küçük...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020334
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020334,
					"content": "Sadece... Hayır, gerçekten mutlu bir çocukluk geçirmesini istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020335
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020335,
					"content": "Hayatında ne kadar kötü deneyimler edinse de en azından geçmişe dönüp bakabileceği mutlu anıları olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020341
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020336,
					"content": "Gerçeği bilmesinin nesi bu kadar kötü?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020337
					]
				},
				{
					"id": 201020337,
					"content": "Hımm... Senin gibi birinin böyle düşünmesi normal. Bir sürü şey görüp geçirdin, bu da cesaretini ve direncini artırdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020338
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020338,
					"content": "Şüphesiz hayatın, bugün seni olduğun kişi yapan bir sürü acı verici deneyimle doludur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020339
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020339,
					"content": "Ancak Timmie daha çok küçük. Belki de bencillik yapıyorum ama dayanabileceğinden fazlasını üstlenmesini istemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020340
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020340,
					"content": "En azından mutlu bir çocukluk geçirmesini istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020341
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020313,
					"content": "Hiçbir şey için söz veremem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020314
					]
				},
				{
					"id": 201020314,
					"content": "Dayanılmaz birisin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020315
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 201020315,
					"content": "Öyle olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020316
					],
					"speakerTitle": "Grace"
				}
			]
