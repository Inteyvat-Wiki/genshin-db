			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Uesugi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190603001,
					"content": "Hey, Gezgin. Bir davayı araştırmak o kadar kolay değilmiş, değil mi? Merak etme, sana bilmen gereken her şeyi anlatacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603002
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603002,
					"content": "Amir Sango hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190603003
					]
				},
				{
					"id": 190603003,
					"content": "Sango mu? Takatsukasa Klanı gerçekten de başarılı bir dedektif tutmuş, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603004
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603004,
					"content": "Başvuruları iletmek için arada sırada karakola geliyor ve sürekli Ryuuji Davasının tekrar araştırılması için talepte bulunuyor. Ama Heizou ona hep engel oluyordu. Onun şikayet mektubu yazacak kadar ileri gitmesini beklemiyordum. Gerçekten de acımasız biri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603005
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603005,
					"content": "Usta Heizou'nun Sango'yu neden davadan uzak tutmaya çalıştığına gelecek olursak... Bence o, Sango'nun kendini tehlikeye atmasından endişeleniyor. Sonuçta önemli bir adamın cinayeti söz konusu. Dikkatli olmazsan başın belaya girebilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603006
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603006,
					"content": "Sango'nun bir dedektiflik bürosu olabilir ama sonuçta o da sıradan biri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603007
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603007,
					"content": "Yani onlar arkadaş mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190603008
					]
				},
				{
					"id": 190603008,
					"content": "Şey... Tam olarak öyle söylenemez. Her görüştüklerinde tartıştıklarını görüyorum. Ama Heizou yine de onu eski bir dostu olarak bellemiş. Daha önceden Sango'yla birlikte çalıştığını duymuştum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603009
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 190603009,
