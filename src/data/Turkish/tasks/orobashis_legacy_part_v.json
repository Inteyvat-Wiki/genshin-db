					"nextDialogs": [
						721320102
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320102,
					"content": "Yağmurun durması ada için savaşanları daha agresif hale getirebilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320103
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320103,
					"content": "Ama adadaki sorunun çözülmesine katkıda bulunmayacaklardı zaten. Bizim yaptığımız sorunu öylece büyümeye bırakmaktan daha iyidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320104
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320104,
					"content": "Sana söz verdiğim hediyeye gelirsek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320105
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320105,
					"content": "Bu bir zamanlar Yashiori Reisleri tarafından kullanılan ünlü mızrak. Bu taslağın senin için ne değeri olur bilemem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320107
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320107,
					"content": "Ama yetenekli bir demirciye verirsen Lord Kitain'in elindeki mızrağın ihtişamını yeniden yaratabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320108
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320108,
					"content": "*iç çeker* Ne yazık ki kahramanların çağı geldi geçti ve birçok kötünün sonunu getiren Kitain bir daha geri dönmeyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320109
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320109,
					"content": "Yine de yardımların sayesinde Lord Kitain'in yaptıklarına bir adım daha yaklaştık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721320110
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721320110,
					"content": "Şimdi ben yardımcı olabileceğim bir şey var mı diye sormak için Şogun Ordusundaki arkadaşlarımın yanına gideceğim. Umarım tekrar yollarımız kesişir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaji"
				}
			]
		},
