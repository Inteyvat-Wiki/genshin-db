				{
					"id": 401290904,
					"content": "Kusura bakmayın... Şöyle birkaç dekor yerleştirmeyi düşünüyordum ama zamanım kalmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290905
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290905,
					"content": "Sorun değil, şimdi hayal vakti!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290906
					]
				},
				{
					"id": 401290906,
					"content": "Vay be! Hayal moduna ne çabuk geçtin öyle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290907,
					"content": "#{NICKNAME} işin özünü kavramış galiba. Sen de elinden geleni yap Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290908
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290908,
					"content": "Aa, Paimon'u küçümseme! Paimon da birden o moda geçebilir. Hatta giriyor... Paimon Hayal Modu aktif!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290909,
					"content": "Öhöm... Ey genç maceracılar! Bu diyarın Koruyucu Tanrıçası Paimon'un karşısındasınız. Bu ulusu ziyaretinizdeki amaç ve niyetinizi belirtin derhal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290910,
					"content": "Şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290911
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290911,
					"content": "Biz Prens Thelxie'nin yoldaşlarıyız Yüce Tanrıça. Kaybettiği ihtişamını geri almasına yardım etmek için geldik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290912
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290912,
					"content": "Oo! İhtişamını geri almak istiyor demek! Tanrıçanızda her türlü ihtişam var. Altın ihtişam, gümüş ihtişam, bronz ihtişam... Prensiniz hangisini kaybetmiş?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290913,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290914
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290914,
					"content": "Iıı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290915
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290915,
					"content": "Karakterini mi unuttun Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290916
					]
				},
				{
					"id": 401290916,
					"content": "Ne münasebet? Tanrıçanın imtihanı bu! Verdiğiniz cevaplar doğrultusunda tanrıça hepinizin cesur maceracılar olduğunu ve açgözlülüğün kalbinizi kirletmediğini anladı! Saygıdeğer kişilersiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290917,
					"content": "Dolayısıyla lütfen tanrıçanın ödüllerini kabul edin. Tanrıça şimdi size üç tür ihtişamı da bahşedecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290918,
					"content": "Prense gelince... Tanrıça sana gökkuşağının ihtişamını bahşedecek, geleceğin her daim ışıkla dolu olsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290919
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290919,
					"content": "-.. -... .-- -...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290920
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401290920,
					"content": "Bu cömert lütufları için Yüce Tanrıçaya minnetimi sunuyorum. Bedenimin her yerinden güç akmaya başladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290921
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290921,
					"content": "Benim... Benim de... Efsanelerde adı geçen kutsal ilham bu mu yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290922
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290922,
					"content": "Tanrıça Paimon'un kudreti sağ olsun!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290923
					]
				},
				{
					"id": 401290923,
					"content": "Hehe! Öhöm... Pekala maceracılar, cesaretinizi yitirmeden yolunuza devam edin ve krallığı ele geçiren canavarları yenin! Aradığınızı elbet bulacaksınız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
