			"dialogs": [
				{
					"id": 401290101,
					"content": "Oğlunun durumu iyiye gidiyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290102
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290102,
					"content": "İlgin için teşekkürler Freminet. Durumu stabil sayılır. Aile doktorumuz onu bugün bir ihtimal yürüyüşe çıkarabileceğimizi söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290103
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290103,
					"content": "Zuria! Freminet! Biz geldik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290104,
					"content": "Hehe, herkes burada sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290105
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290105,
					"content": "Tam değil, biri eksik sanki. Ama nerede olabileceğine dair Paimon'un bir tahmini var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290106,
					"content": "Hey! Thelxieeee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290107,
					"content": "-.. -... . -- -...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290108
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401290108,
					"content": "Aaa! Thelxie kendine kılıç kalkan yapmış! Çok havalı duruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290109,
					"content": "Evet, elinde silah tutunca Thelxie daha da heybetli durmuş. Kendini aştın Freminet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290110
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290110,
					"content": "Biz de yardım ettik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290111,
					"content": "Evet, malzemenin iyisinden anlıyorsunuz. Bulduğunuz tüm malzemeler kaliteliydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290112
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290112,
					"content": "Bu arada Zuria bana macerayı bir taç giyme töreniyle sonlandırmak istediğini söyledi. O yüzden zahmet olmazsa sizden taç için de birkaç malzeme bulmanızı isteyebilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290113
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290113,
					"content": "Harabelere giderken yol üzerinde arayabilirsiniz. Malzemeleri ben toplamayı düşünüyordum ama siz benden daha güzellerini bulabilirsiniz diye düşündüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290114
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290114,
					"content": "Oldu bil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290115
					]
				},
				{
					"id": 401290115,
					"content": "Galiba gitmeye hazırız. Yola koyulalım mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290116,
					"content": "Bir dakika lütfen. Düşünüyordum da... Thelxie bize bu yeni görünüşünü gösterdiğine göre resimli kitaba yeni bir sayfa çizebiliriz belki. Ne dersiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290117
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290117,
					"content": "Aaa! Paimon heyecanlandı bak şimdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290118,
					"content": "Ne çizelim sayfaya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290119
					]
				},
				{
					"id": 401290119,
					"content": "Hımm, bildiğimiz hikayeyi temel alalım mı? Atmosferini daha az kasvetli yapalım ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290120
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290120,
					"content": "Yani üzücü kısımları çıkarıp yerine neşeli kısımlar mı ekleyelim? Paimon'a gayet güzel geldi bu fikir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290121,
					"content": "Peki, deneyeyim bakalım. Çizim yeteneğim pek yoktur ama işim gereği çok çizim görmüşlüğüm var. Ne çizeceğime gelirsek... Nasıl bir şey görmek istersiniz söyleyin bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290122
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290122,
					"content": "Düşüneyim... Silahı çizebiliriz. Prens, cesaret kılıcını ve metanet kalkanını kuşanır. Demek ki artık aklındaki şüphelerden kurtulmuştur ve karanlığa karşı savaşmaya hazırdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290123
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290123,
					"content": "Tamam, silahı ekleyeyim... Başka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290124
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290124,
					"content": "Paimon prensin arkadaşları da olsun istiyor! Thelxie'nin yanında arkadaşları var, artık tek başına savaşmıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290125,
					"content": "Tamam, yanına dostlarını da çizeyim... Başka?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290126
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290126,
					"content": "Biraz da renk olsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401290127
					]
				},
				{
					"id": 401290127,
					"content": "Renk. Ha, renk... Evet! Çok önemli. Önündeki yol artık renksiz gri tonlarında değil, renklerle ve umutla dolu olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290128
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290128,
					"content": "Bir sayfanın bu kadar ilham verici olacağını kim bilebilirdi... Ne güzel. Fikirleriniz harikaydı millet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290129
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290129,
					"content": "Süper! Herkes çok motive görünüyor, özellikle de Thelxie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290130,
					"content": "Görüyor musun oğlum? Sana da ilham verdi mi bunlar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290131
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290131,
					"content": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290132
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401290132,
					"content": "Eminim vermiştir Zuria. Bu daha ilk sayfa üstelik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290133
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290133,
					"content": "Doğru, Paimon bu resimli kitabın bitmiş halini görmek için sabırsızlanıyor! Bir an önce bitirelim, içimizdeki inancı ve umudu yitirmeyelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290134,
					"content": "Evet! Ben de dört gözle bekliyorum bunu. Hadi daha fazla zaman harcamadan bir an önce Su İfriti Krallığı'na doğru yola koyulalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290135
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290135,
