			"dialogs": [
				{
					"id": 401290601,
					"content": "Oh be, sonunda bitti! Tüm kötü canavarları yenip Su İfriti Krallığı'nı kurtarmayı başardık mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290602,
					"content": "Evet, şimdi Thelxie'nin taç giyme törenine katılmamız gerek... Yalnız ben işlerin bu kadar sorunsuz gitmesini beklemiyordum hiç. Harabelerin merkezine ulaşmamız daha uzun sürer sanıyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290603
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290603,
					"content": "Benim hatam. Bir taç gerekeceğini Freminet'ye daha önceden söylemem gerekirdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290604
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290604,
					"content": "#{NICKNAME} ve Tanrıça Paimon'un gücü sayesinde! Tüm canavarları tek seferde yok ettik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290605,
					"content": "Sorun değil Zuria. Ben tacı yaptıktan sonra tekrar gelebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290606
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290606,
					"content": "O halde vaktinizi ayırdığınız için hepinize ayrı ayrı teşekkür ederim. Thelxie, sana da teşekkürler çocuğum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290607
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290607,
					"content": "-.-  ..-.   ..-  -...  .---  -.  ..-. -.  -...  -.  -...  ---",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290608
					],
					"speakerTitle": "Thelxie"
				},
				{
					"id": 401290608,
					"content": "Thelxie tam bir savaş uzmanı çıktı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401290609,
					"content": "Onu durdurabilecek hiçbir şey olduğunu sanmıyorum... Gerçek bir prens oldu resmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290610
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290610,
					"content": "Evet, katılıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290611
					],
					"speakerTitle": "Zuria Destree"
				},
				{
					"id": 401290611,
					"content": "#Şimdilik kampa dönelim. Tacı bir an önce yapmak istediğim için {NICKNAME} ve Paimon'dan dönüş yolunda malzeme aramalarını istedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401290612
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 401290612,
					"content": "Thelxie'nin Fantastik Maceralarına da yeni bir bölüm daha ekleyebiliriz! Su İfriti Krallığı'nı kurtardığımıza göre resimli kitaba yeni sahneler çizme vakti geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
