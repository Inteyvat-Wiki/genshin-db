			"dialogs": [
				{
					"id": 722470201,
					"content": "Sanırım bu kutsal eşyaları korumak için yeterli güce sahipsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470202
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470202,
					"content": "Bu şekilde sonunda huzura ulaşabilirim. Bu eşyaların götürülmesi gerekiyor, böylece...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470203
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470203,
					"content": "Neden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470204,
					"content": "Çünkü... Çünkü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470205
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722470205,
					"content": "Olamaz ya, bozuk saat gibi takıldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722470206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722470206,
					"content": "Adaklar bu olmalı. Gerçi biraz eski püskü duruyorlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7224703,
