			},
			"dialogs": [
				{
					"id": 210380201,
					"content": "Teşekkür ederim Gezgin. Bu fotoğraf gerçekten harika.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380202
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380202,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380203
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380203,
					"content": "*iç çeker* Gitme zamanı geldi. \"Büyük bir adam, her yerde ilham bulabilir\" ve \"On bin kilometre gezmek, on bin kitap okumaktan iyidir\" gibi sözleri düşününce çok motive oluyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380204
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380204,
					"content": "Ama gitme zamanı geldiği için tüm bu motivasyonumu kaybettim. Tek istediğim burada biraz daha kalmak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380205
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380205,
					"content": "Gezgin, sence aradığım şeyi bu yolculukta bulabilecek miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380206,
						210380208
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380206,
					"content": "Bilmiyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380207
					]
				},
				{
					"id": 210380207,
					"content": "Hahaha... Yani, sence ne arıyorum? Ne aradığımı ben biliyor muyum peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380210
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380210,
					"content": "Evet, gitme zamanı geldi. Tüccarla buluşmam lazım. Lütfen bu ödülü kabul et Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380211
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380211,
					"content": "Que'er... Sonuç olarak gelmedi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380208,
					"content": "Sana kalmış.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380209
					]
				},
				{
					"id": 210380209,
					"content": "Yani... Kaderine bağlı diyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380210
					],
					"speakerTitle": "Sun Yu"
				}
			]
		},
