				"points": []
			},
			"dialogs": [
				{
					"id": 210380101,
					"content": "Gezgin, iyi ki buradasın. Neredeyse bugün gelmeyeceğini düşünmüştüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380102
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380102,
					"content": "Bugün Liyue Limanı'ndan ayrılacağım gün. Sana önceden çok zahmet çıkardım... Sana düzgün bir şekilde teşekkür etmeliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380103
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380103,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380104
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380104,
					"content": "Öhöm... Tam da seni gördükten sonra ne demeliyim diye düşünüyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380105
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380105,
					"content": "Artık konuşma vaktim geldi ama düşündüğüm hiçbir şeyi hatırlamıyorum... Şu işe bak, şimdi bile kendimi küçük düşürüyorum, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380106,
						210380107
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380106,
					"content": "Kafana takma. Eminim yakında yine karşılaşırız.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380108
					]
				},
				{
					"id": 210380108,
					"content": "Gerçekten mi? Haha, bu harika bir haber! Geldiğin zaman sana etrafı gösteririm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380109
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380109,
					"content": "Şey, aslında senden bir iyilik daha isteyecektim. Kameran var, değil mi? Benim için fotoğraf çekebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380110
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380110,
					"content": "Bir zamanlar bir denizci bana yurt dışına giderken memleketinin fotoğrafını yanımda götürmem gerektiğini söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380111
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380111,
					"content": "Ama benim bir Kameram yok, belki bana bu konuda yardımcı olabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210380112,
						210380113
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380112,
					"content": "Tabii ki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 210380113,
					"content": "Bir poz ver!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380114
					]
				},
				{
					"id": 210380114,
					"content": "P-Poz mu? Ben arkamdaki manzarayı kastetmiştim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210380107,
					"content": "Fontaine'e gidince sana bir uğrarım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210380108
					]
				}
			]
		},
		{
			"id": 2103802,
