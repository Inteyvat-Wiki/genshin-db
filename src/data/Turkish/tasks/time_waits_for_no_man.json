			"dialogs": [
				{
					"id": 206030501,
					"content": "Ne kadar çabuk döndün. Sanırım ortada ciddi bir mesele yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030502
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206030502,
					"content": "Hayır, canavarlar hâlâ bölgede aktif.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206030503
					]
				},
				{
					"id": 206030503,
					"content": "Ne? Hâlâ kol gezen canavarların olması yetmezmiş gibi bir de sayıları öncekinden fazla mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030504
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206030504,
					"content": "Garip. Mondstadt'a saldıran o kalabalık kuvvet daha önce yenilmemiş miydi? Neden bölgede gizlenmeye devam ediyorlar ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030505
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206030505,
					"content": "Başka planları olmasın sakın? Maceracıları toplayıp görevleri yeniden düzenlemem gerek. Bu canavarları hafife almamalıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030506
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206030506,
					"content": "Ormandaki canavar faaliyetlerini etraflıca incelemek Maceracılar Loncasının yetki alanına girer. Herkese neler yapabileceğimizi gösterme zamanı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030507
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 206030507,
					"content": "Ah, evet. Lütfen bunları çabaların için bir teşekkür olarak kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyrus"
				}
			]
		}
