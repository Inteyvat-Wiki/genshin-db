					"content": "Gök taşlarını gözlemlemenin çok daha iyi bir yolu var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010302
					]
				},
				{
					"id": 225010302,
					"content": "Daha iyi bir yol mu dersin? Haklısın. Meteorun yalnızca ateşine baksam ve etrafındaki her şeyi unutsam, benim acizliğim olmaz mı bu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
