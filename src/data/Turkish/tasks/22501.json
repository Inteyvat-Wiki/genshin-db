				{
					"id": 225011301,
					"content": "Söylediklerinizi düşündüm efendim ama gök taşları kaçırılamayacak kadar ender bir manzara. Her şeye rağmen gideceğim.",
					"roleType": "TALK_ROLE_NPC",
