					"nextDialogs": [
						225011303
					]
				},
				{
					"id": 225011303,
					"content": "Ancak direkt gök taşlarını görmeye gidersem, korkarım ki yalnızca onlardan etkilenirim ve etrafında olan biteni kaçırabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011304
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011304,
					"content": "Bir şairin en korkunç kabusu, gözlerinin sadece bir şeyi görmesidir. Gök taşlarını yalnızca gözlemlersem, fırçamdan güzel bir şiir çıkacağını hiç sanmam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011305
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011305,
					"content": "Yani onlara uzaktan bakmalı, daha yakına gitmeden etrafındaki her şeyi içselleştirmeliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011306
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011306,
					"content": "Daha sonra... Hım, dur. Yollarda bu kadar canavar varken ve bana eşlik edecek biri olmadan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011307
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011307,
					"content": "Gezgin, nezaket gösterip yolumuzu engelleyen canavarları yok edebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011308,
						225011310
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011308,
					"content": "Tamam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225011309
					]
				},
				{
					"id": 225011309,
					"content": "Muhteşem! Harika! Bu durumda sana güveniyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011310,
					"content": "Ama gök taşlarına dokunmayacağına dair bana söz ver...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225011311
					]
				},
				{
					"id": 225011311,
					"content": "B-Ben... Tamam, söz veriyorum. Ama onlara dokunmak, beni bitmeyen bir uyku haline sokacaksa neden kendime zarar verecek bir şey yapayım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011312
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011312,
					"content": "Yine de insan, gök taşlarının uyuşturucu etkisine girmiş kişilerin rüyalarında gördüklerini merak ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011313
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011313,
					"content": "*öksürür* Sadece şaka yapıyordum! Lütfen canavarlar konusunda bana yardım et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
