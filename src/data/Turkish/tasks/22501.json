			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225010101,
					"content": "Hım... Hayır, bu mısra güzel olmadı. Hem de hiç güzel olmadı. *iç çeker* Gidip kendim görmeliyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010102
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225010102,
					"content": "Bir şey mi oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010103
					]
				},
				{
					"id": 225010103,
					"content": "Gününüz nasıl geçiyor efendim? İsmim Qingzhou. Saygı sınırlarını aşmadan şiirden anladığımı eklemek isterim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010104
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225010104,
					"content": "Şans yüzüme gülmüş ve küçük bir parça şiirsel ilham yakalamıştım ki, bu ilhamın ihtişamlığına yaraşır bir şekilde devamını getiremedim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010105
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225010105,
					"content": "Son zamanlarda gökyüzü çok garipti. Alevli gök taşları düştü. Bu ölümlü dünyada gördüğüm ender manzaralardandı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010106
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225010106,
					"content": "Ampul yandı kafamda bir anda, dedim kendi kendime bu gök taşlarından birini görseydim yakından, yakalardım o kaçak cümleyi, devam ettirirdim şiirimi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010107
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225010107,
					"content": "Şey, bu çok uygun olmayabilir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010108
					]
				},
				{
					"id": 225010108,
					"content": "Uygun değil mi? Ne demek istersiniz bu sözlerinizle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
