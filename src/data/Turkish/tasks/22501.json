			"dialogs": [
				{
					"id": 225010401,
					"content": "Buradan şiir yazabilirsin değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010402
					]
				},
				{
					"id": 225010402,
					"content": "Bu işe yaramaz, efendim. Tüm hayatım boyunca dünyadan uzakta ve kapalı kapılar ardında kalırsam, yazacağım şiirler sağlıklı birinin inlemesinden veya bir aptalın vaazından farkı olmaz.",
