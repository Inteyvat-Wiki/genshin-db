						225011202
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011202,
					"content": "Sevindim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225011203
					]
				},
				{
					"id": 225011203,
					"content": "Dahası, şiiri güzel yapan sadece eşsiz bir üslup değildir. Bir şeyin kalitesini ölçmek için daha ince ayrıntılara bakılması gerekir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011204
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011204,
					"content": "Bir çiçekten veya başka küçük bir eşyadan da güzel bir mısra yazabiliriz. Çiçeklere övgü için yazılan şiir çoktur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225011205
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225011205,
					"content": "Hım... Bununla beraber dışarıdan bakanlar daha iyi görür, değil mi? Söyle o zaman Gezgin, şiirimi yazarken nasıl bir çiçeği referans almalıyım?",
					"roleType": "TALK_ROLE_NPC",
