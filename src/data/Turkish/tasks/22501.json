				"points": []
			},
			"dialogs": [
				{
					"id": 225010201,
					"content": "Ne demek \"uygun değil\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010202
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225010202,
					"content": "O gök taşlarına dokunursan bayılırsın...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010203
					]
				},
				{
					"id": 225010203,
					"content": "Ah! Duymuştum bu dediklerinizi ama dokunmazsam ve bakarsam yalnızca yakından, girer mi yine de başım belaya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225010204
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 225010204,
					"content": "Dokunmayacağına söz verebilir misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225010205
					]
				},
				{
					"id": 225010205,
					"content": "Yani, arzularıma ket vurabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
