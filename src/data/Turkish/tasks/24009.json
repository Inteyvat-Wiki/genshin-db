			"dialogs": [
				{
					"id": 240090401,
					"content": "Bir bakayım... Arkadaşlarımın verdiği bazı tavsiyeleri defterime not almıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090402
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090402,
					"content": "\"Su altındaki devasa harabeler!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090403
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090403,
					"content": "Cidden mi? Bu kelimeleri öyle bir bastırarak yazmışım ki neredeyse kağıt yırtılıyormuş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090404
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090404,
					"content": "Böyle bir yerin eşsiz bir güzelliğe sahip olacağını düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090405
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090405,
					"content": "Pekala, o halde böyle harabelerin fotoğrafını çekmemde bana yardımcı olur musunuz? Ne kadar büyük olursa, ne kadar yıpranmış halde olursa benim için o kadar iyi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				}
			]
		},
