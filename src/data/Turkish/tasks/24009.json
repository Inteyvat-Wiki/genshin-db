					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090801,
					"content": "Fotoğrafı getirdiniz mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090802
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090802,
					"content": "İşte burada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090803
					]
				},
				{
					"id": 240090803,
					"content": "Bakayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090804
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090804,
					"content": "Ah! Mükemmel! Mükemmel! Fotoğraf çekme konusunda böylesine iyi olmanızı beklemiyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090805
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090805,
					"content": "Bu fotoğraflardan kesinlikle en iyi malzemeleri çıkaracağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090806
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090806,
					"content": "Çok teşekkür ederim. Hım... Morayı nereye koydum ben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090807
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090807,
					"content": "Pekala, bu sizin, lütfen alın! Eğer ileride yine fırsatınız olursa lütfen bana fotoğraf çekme konusunda yardımcı olun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090808
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090808,
					"content": "O halde... Kompozisyona bir bakayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				}
			]
		},
		{
			"id": 2400909,
			"completionStepIds": [
				2400901
			],
