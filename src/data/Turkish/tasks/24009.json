			},
			"dialogs": [
				{
					"id": 240091101,
					"content": "Karşıt unsurlar eksik gibi... Neler oluyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091102
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091102,
					"content": "Sanki o belirleyici şey eksikmiş gibi geliyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091103,
						240091105
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091103,
					"content": "Fotoğraf mı çekiyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091104
					]
				},
				{
					"id": 240091104,
					"content": "Evet, bu Kamera resimlerimin ilham kaynağı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091107
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091107,
					"content": "Adım Depierris, bir ressamım ve sizinle tanıştığıma gerçekten çok memnun oldum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091108
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091108,
					"content": "Ah... Hah. Ben de öyle!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091109
					]
				},
				{
					"id": 240091109,
					"content": "Normalde yeni tanıştığım bir arkadaşıma kahve ısmarlardım ama ne yazık ki yakınlarda bir kafe yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091110
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091110,
					"content": "Hımm. Bu Fonta'yı alın lütfen, kadeh kaldırıp tanışmamızı resmiyete dökelim! Daha önce Fontaine'e gelmiş miydiniz bu arada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091111
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091111,
					"content": "İlk gelişim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091112
					]
				},
				{
					"id": 240091112,
					"content": "Ah, öyleyse güzel vakit geçireceksiniz! Şehre gidin ve yukarıdan geçip duran su yollarını izleyin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091113
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091113,
					"content": "Sonra da sokaklara dalıp karmaşık makinaları görün. Gerçi pek bir estetik değerleri yok ama, yani en azından mütevazı bir ressam olarak benim gözümde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091114
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091114,
					"content": "Son olarak da bir kafede oturup bir kahvenin tadını çıkarabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091115
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091115,
					"content": "Belki de siz kahvenizi yudumlarken biri gelip sizinle sohbet eder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091116
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091116,
					"content": "Bu arada gelen kişi bir çeşit \"Kamera Kulübü\"nden falan olduğunu söylerse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091117
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091117,
					"content": "Söylediği saçmalıklara aldırış etmeyin... Bazıları böyle saçma şeyler yaparlar çünkü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091118,
						240091120
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091118,
					"content": "Tam olarak ne yapıyorlar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091119
					]
				},
				{
					"id": 240091119,
					"content": "Ne mi yapıyorlar? Fontaine'deki kültürel hayatı mahvediyorlar işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091122
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091122,
					"content": "Felaket tellallığı yaptığımdan falan değil. Bu kulüpte ne hakkında konuşuyorlar, bir tahmininiz var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091123
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091123,
					"content": "\"Sadece resimlerden bahsedecek olursak Kameraların çektikleri, ressamların çizdiklerinden çok daha iyi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091124
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091124,
					"content": "Yani şu \"sadece resimlerden bahsedecek olursak\" saçmalığını dinleyin bir. İstedikleri kadar bunun gerçek olduğunu haykırsınlar, bu sadece saçmalık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091125
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091125,
					"content": "Görüntüleri olduğu gibi yansıtırsak estetik anlayışa ne olacak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091126
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091126,
					"content": "Pekala, bazılarımız daha natüralist eserler ortaya koymaya çalışıyor, bu doğru ama bu da onların estetik kaygısından ortaya çıkan bir şey.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091127
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091127,
					"content": "Estetik! Estetik en önemli şey, anlıyor musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091128,
						240091129
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091128,
					"content": "P-Pek değil...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091130
					]
				},
				{
					"id": 240091130,
					"content": "Bir ressamın gözünden dünyayı gözlemlemek sadece ilk adımdır. Yürekten bir şaheser ortaya koymak için yapmamız gereken fırçamızı kullanarak hissiyatı ve güzelliği keşfetmektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091131
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091131,
					"content": "Kamera kullanmayı sevenlerin hepsi sanat anlayışından uzak ahmaklar değiller tabii ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091132
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091132,
					"content": "Kamera kullanmayı seven birçok arkadaşım var, ben de onlarla sohbet etmeyi severim. Bazen ben onların çektiği fotoğraflardan ilham alırım, bazen de benim çizdiğim resimler onlara ilham olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091133
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091133,
					"content": "Ancak şu sanata dair hiçbir şey bilmeyip sadece boş boş konuşanlar... Ah, düşündükçe kan beynime sıçrıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091134
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091134,
					"content": "Hem fotoğraf çekmeyi sevenleri hem de resim çizenleri küçük düşürüyorlar! Onlar var ya... *öksürür* *öksürür*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091135
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091135,
					"content": "Sakin ol, biraz su iç...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091136
					]
				},
				{
					"id": 240091136,
					"content": "Ah, teşekkür ederim... Bu konudan bahsedince sinirlerime hakim olamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091137
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091137,
					"content": "Biz de bazı arkadaşlarımla bu Kamerayı, resimlerimizi yaparken bize malzeme sağlar diye düşünerek kullanmaya karar verdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091138
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091138,
					"content": "Daha sonra da bir sergide bu resimleri, onları yaparken yararlandığımız fotoğraflarla yan yana koyacağız. Bu sayede herkes resimle fotoğraf farkını anlayabilecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091139
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091139,
					"content": "Yine de, *iç çeker*. Çektiğim fotoğraflar bana çok da anlamlı gelmiyor. Arkadaşlarımın söylediğine göre en güzel manzarayı en korkunç yerlerde bulabilirmişim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091140
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091140,
					"content": "Mesela suların altında, uçurum kenarında ya da belki yalnızca az sayıda kişinin girebildiği ormanlarda... Ancak böyle yerlere gitmeye ben cesaret edemem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091141
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091141,
					"content": "Maceracı tutmaya kalksam bu da uzun zaman alır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091142
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091142,
					"content": "#Hımm... Saygıdeğer {M#beyefendi}{F#hanımefendi}, bir sanatçı için çalışmayı düşünür müydünüz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091143,
						240091144
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091143,
					"content": "Bana resim yaptırmayacağın sürece...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091145
					]
				},
				{
					"id": 240091145,
					"content": "Merak etmeyin! İkimiz de iyi olduğumuz işleri yapacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091146
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091146,
					"content": "Ödeme konusunda endişe etmenize de gerek yok. İlham bulmak için çıktığım gezilerde beni korusunlar diye sık sık maceracı tutarım zaten, kuralları biliyorum yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091147
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091147,
					"content": "Yalnızca, bu durum çok acildi o yüzden kimseyi tutmaya vaktim olmadı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091148
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091148,
					"content": "Pekala, anlaştık o zaman. Sizin yardımınız da olacağı için iyi işler ortaya koyma konusunda kendime daha çok güveniyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091144,
					"content": "Ben sadece macera işlerinde iyiyimdir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091145
					]
				},
				{
					"id": 240091129,
					"content": "B-Biraz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091130
					]
				},
				{
					"id": 240091120,
					"content": "Peki... Bana bir şey yaparlar mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091121
					]
				},
				{
					"id": 240091121,
					"content": "Fontaine'e yaptıkları gibi kültürel hayatınızı mahvederler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091122
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091105,
					"content": "Kamera kullanmak hobilerin arasında mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240091106
					]
				},
				{
					"id": 240091106,
					"content": "Kamera mı, hobim mi? Hayır, hayır, bu sadece referans toplamak için bir araç. Benim ilgim fırçalarıma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091107
					],
					"speakerTitle": "Depierris"
				}
			]
		},
