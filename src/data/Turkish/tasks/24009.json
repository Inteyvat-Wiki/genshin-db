				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090201,
					"content": "Bir bakayım... Arkadaşlarımın verdiği bazı tavsiyeleri defterime not almıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090202
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090202,
					"content": "Su bitkileri... Sallanıyor... Işık ve gölge... Değişim... Ne yazıyormuşum ki burada? Çok mu içmiştim acaba? ... Evet, öyle olsa gerek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090203
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090203,
					"content": "Öhöm. Lütfen su altına inip bazı su bitkilerinin fotoğrafını çekmemde bana yardımcı olun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090204
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090204,
					"content": "Anlaşılan bu notları alırken su bitkilerindeki ışıklar ve gölgeler ilgimi çekmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				}
			]
		},
