			"dialogs": [
				{
					"id": 240091001,
					"content": "Yardımlarınız için teşekkürler! Bu karnımı doyurmama yeter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091002
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091002,
					"content": "Buyurun, bu sizin. Benim şimdi acilen yemek yemem lazım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240091003
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240091003,
					"content": "Bir dahaki sefere çantama bisküvi koyup getireceğim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				}
			]
		},
