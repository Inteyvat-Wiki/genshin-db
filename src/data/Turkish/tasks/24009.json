					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090901,
					"content": "Bu... Güzel olmadı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090902,
						240090903
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090902,
					"content": "Bu defa ne fotoğrafı çekmem gerekiyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090904
					]
				},
				{
					"id": 240090904,
					"content": "Bu defa... Şey, fotoğraf işi değil de, aslında sizden başka bir isteğim olacaktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090905
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090905,
					"content": "Öhöm, bu biraz utanç verici ama şey... Yiyecek bir şeyler bulmama yardım eder misiniz? Mesela Sarımsaklı Baget Ekmek?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090906,
						240090907
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090906,
					"content": "Sen... Yiyecek hiçbir şey getirmedin mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090908
					]
				},
				{
					"id": 240090908,
					"content": "Hayır! Bir sürü ekmek, biraz reçel ve kurutulmuş et getirmiştim. Bugün için yetecek kadar vardı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090909
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090909,
					"content": "Ama resme odaklanayım diye yemekleri bir kenara koymuştum... Acıkmaya başlayınca bir fark ettim ki yemeğim yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090910
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090910,
					"content": "Belki de bir hayvan ya da yoldan geçen ve karnı acıkmış biri gizlice almıştır. Öyleyse umarım karınları doyar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090911
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090911,
					"content": "Maalesef benim de karnımı bir şekilde doyurmam gerekiyor... Şimdi şehre de dönemem, yeterince malzeme toplamadan olmaz yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090912,
						240090913
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090912,
					"content": "Bekle bir dakika.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090914
					]
				},
				{
					"id": 240090914,
					"content": "O halde size güveniyorum. Şehirden alabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090915
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090915,
					"content": "Haha.. Ah, biraz güçsüz hissediyorum. Açlıktan mı acaba ya da belki de çok fazla düşündüm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090913,
					"content": "Gidip getireyim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090914
					]
				},
				{
					"id": 240090907,
					"content": "Yemek alacak Moran mı kalmadı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090908
					]
				},
				{
					"id": 240090903,
					"content": "Bu defa nereye gidiyoruz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090904
					]
				}
			]
		},
		{
			"id": 2400910,
