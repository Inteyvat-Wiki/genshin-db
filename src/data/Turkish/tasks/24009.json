			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Depierris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240090101,
					"content": "Gezgin! Tam zamanında geldiniz! Çok iyi bir fotoğraf çekme noktası buldum. Tek ihtiyacım olan sizin yardımınız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090102
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090102,
					"content": "Hâlâ ilham arıyorsun, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090103
					]
				},
				{
					"id": 240090103,
					"content": "Evet. Bu malzemeler yeterli değil. Tek bir fotoğrafla tüm tabloyu oluşturamam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090104
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090104,
					"content": "Genelde referans malzemesi kullanmak için onlarca, hatta yüzlerce fotoğraf lazım oluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090105,
						240090106
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090105,
					"content": "O kadar çok demek...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090107
					]
				},
				{
					"id": 240090107,
					"content": "Daha önce de söylediğim gibi, resim \"oluşturmaktan\" gelir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090108
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090108,
					"content": "Gördüğün şeyleri olduğu gibi tuvale yansıtırsan bu \"resim\" değil \"fotoğraf\" olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090109
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090109,
					"content": "Bir ressamın asıl yapması gereken şey hassasiyetini ve estetik algısını kullanarak etrafındakileri gözlemlemek ve sonrasında onu bir şekle sokup dönüştürüp düzenlemektir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090110
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090110,
					"content": "Bir nesnenin en güzel yanını alıp o tuvale işlediğin an resmin tamamlanmış olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090111,
						240090112
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090111,
					"content": "Yani, pek anlamadım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090113
					]
				},
				{
					"id": 240090113,
					"content": "Siz... Pekala. Basitçe söylemek gerekirse bu resimlerin yalnızca en güzel kısımlarını referans olarak alacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090114
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090114,
					"content": "Mesela, bu resimdeki ışık ve gölge dengesi çok iyi ama manzaradaki kontrastta eksiklik var. Bu yüzden ben de yalnızca ışık ve gölge dengesini ele alacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090115
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090115,
					"content": "Diğer bir resimde etkileyici pozuyla bir gezgin var, bir sonrakinde de büyüleyici bir bina...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090116
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090116,
					"content": "Ortaya çıkacak ürünün güzel olup olmaması senin estetik zevkine ve algına bağlı olduğundan bu, neredeyse aklından yapboz yapmak gibidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090117
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090117,
					"content": "Ancak tek yolu bu değil tabii, çünkü referans malzemede yer alan görüntüyü de değiştirip soyutlaştırabiliriz... Ancak şimdilik bu kadarını bilseniz yeterli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090118,
						240090119
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090118,
					"content": "Demek hâlâ benim yardımıma ihtiyacın var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090120
					]
				},
				{
					"id": 240090120,
					"content": "Ah... Evet, evet! Fotoğraf çekme becerileriniz çok iyi. Cidden, arkadaşlarım sizin çektiğiniz fotoğrafları gördükten sonra gelip sizinle tanışmak istediler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090121
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090121,
					"content": "Sizin yardımınız sayesinde ortaya olağanüstü bir şey çıkarabileceğime eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240090122
					],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090122,
					"content": "O yüzden lütfen insanlığa kazandırılacak bu estetik adına, hazırladığım Mora adına bana yardım edin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Depierris"
				},
				{
					"id": 240090119,
					"content": "Öyleyse senin için malzeme toplamaya devam edeceğim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090120
					]
				},
				{
					"id": 240090112,
					"content": "Daha basit anlat!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090113
					]
				},
				{
					"id": 240090106,
					"content": "Fotoğrafların farklı kullanımları mı var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240090107
					]
				}
			]
		},
		{
			"id": 2400902,
