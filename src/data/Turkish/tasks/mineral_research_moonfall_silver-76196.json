			"dialogs": [
				{
					"id": 761960301,
					"content": "Oh... Atladığımız yoktur, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960302
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960302,
					"content": "Hımm... Yok, her şey tastamam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960303
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960303,
					"content": "Demin Aydüşen Gümüşüyle yere ilginç desenler çizdiğini gördüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960304
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960304,
					"content": "Aynen! Epey uğraştırdı ama bence herkesin Aydüşen Gümüşüne olan sevgisini filizlendirmeye yardımcı oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960305
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960305,
					"content": "Bu arada Natlan'da bir halk hikayesi duymuştum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960306
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960306,
					"content": "Anlatılanlara göre bir zamanlar yıldızların arasında yaşayan bir kız varmış. Yeryüzüne düşünce, gökyüzüne geri dönebilmek için yere devasa çizimler yapmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960307
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960307,
					"content": "Nihayetinde göklerdeki babası Güneş, kızının bu yakarışını duymuş ve onu tekrar yanına almış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960308
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960308,
					"content": "Kim bilir, belki de senin yaptığın desenleri görür ve o da Aydüşen Gümüşüne bayılır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960309
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960309,
					"content": "Haha, işte o zaman Aydüşen Gümüşünün bir numaralı elçisi olurum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960310
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960310,
					"content": "Ama ondan ziyade yukarıdaki kuşlar tarafından fark edilmek daha endişe verici. Bilirsin, kargalar falan da parlak şeyleri çok sever.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960311
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960311,
					"content": "Doğru. Hem kargaların yanı sıra yerdeki İz Sürücü Köstebeklere ve Hırsız Gelinciklere de dikkat etmeliyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960312
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960312,
					"content": "Lumi de var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960313
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960313,
					"content": "Haha, doğru! Lumi de var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960314
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960314,
					"content": "Ya-ho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
