			"dialogs": [
				{
					"id": 761960201,
					"content": "Dorota? Sen de mi buradaydın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960202
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960202,
					"content": "Tam zamanında yetiştin Linnea! Ben de herkese Aydüşen Gümüşünün eşsiz güzelliğinden bahsediyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960203
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960203,
					"content": "Ah Aydüşen Gümüşü... Şu mehtaplı kürede senden daha mükemmel bir mücevher var mı acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960204
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960204,
					"content": "Şuna bak! Şu kusursuz şekle, pürüzsüz ve yuvarlak dokuya bir bak! Hele o yanardöner beyazın eşsiz element yatkınlığıyla bir araya gelişi yok mu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960205
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960205,
					"content": "Gözümde bir tek gökteki ay seninle yarışabilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960206
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960206,
					"content": "Şey... Evet. Aydüşen Gümüşü çok güzel bir cevherdir. Hatta ben de birkaç numune topladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960207
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960207,
					"content": "Hah, beni anlayacağını biliyordum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960208
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960208,
					"content": "Ama yine de Aydüşen Gümüşünü benden daha iyi kimse anlayamaz! Maceracılar Loncasının danışmanı olabilirsin ama birinciliği sana o kadar kolay kaptırmam. Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960209
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960209,
					"content": "Doğru ya! Madem maceracılara genelde sen bir şeyler öğretiyorsun, bu sefer de ben seni bir sınayayım, ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960210
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960210,
					"content": "Elimde üç parça Aydüşen Gümüşü var. Ne yazık ki ikisinde ufak tefek kusurlar mevcut. Fakat sonuncusu yok mu... İşte o benim göz bebeğim. Aydüşen Gümüşlerinin şahı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960211
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960211,
					"content": "Bakalım hangisinin en mükemmeli olduğunu anlayabilecek misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960212
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960212,
					"content": "Hımm, bakayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960213,
						761960220,
						761960225
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960213,
					"content": "Soldaki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960214
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960214,
					"content": "(Hımm? Lumi ne yapıyor acaba?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960215,
						761960231
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960215,
					"content": "Bunu seçiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960216
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960216,
					"content": "Haha, demek ki sen bile yanılabiliyormuşsun Linnea. Aslında bunun hiç umulmadık bir yerinde saklı küçücük bir kusuru var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960217
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960217,
					"content": "Tamam, bu sefer sen kazandın. Ama bir dahakine bu kadar kolay yenilmeyeceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960218
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960218,
					"content": "Bana fark etmez. Ben dünden hazırım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960232
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960232,
					"content": "Linnea sonunda Dorota'nın Aydüşen Gümüşü Hayran Etkinliğine katıldı ve gerçekten çok güzel zaman geçirdi...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761960219
					]
				},
				{
					"id": 761960219,
					"content": "Vay be, herkesin bu kadar hevesli olacağını düşünmemiştim. Ama her güzel şeyin bir sonu var işte... Neyse, toparlanıp dönme vakti geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960233
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960233,
					"content": "Sana yardım edeyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960234
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960234,
					"content": "Çok iyi olur cidden! Sağ ol!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960231,
					"content": "Bir daha düşüneyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960212
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960220,
					"content": "Ortadaki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960221
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960221,
					"content": "(Görünüşe göre Lumi bunu beğendi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960222,
						761960231
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960222,
					"content": "Bunu seçiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960223
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960223,
					"content": "Ah, sen de hissediyorsun, değil mi? Sadece mükemmel olan bir şeyin yaydığı o karşı konulmaz cazibeyi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960232
					],
					"speakerTitle": "Dorota"
				},
				{
					"id": 761960225,
					"content": "Sağdaki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960226
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761960226,
					"content": "(Hımm? Lumi ne yapıyor acaba?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960227,
						761960231
					],
					"speakerTitle": "Linnea"
				},
				{
