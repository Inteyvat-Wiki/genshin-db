			"trigger": {
				"objectNames": [
					"Büyük Usta Hanakado"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727360101,
					"content": "Harika, harika!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360102
					],
					"speakerTitle": "Büyük Usta Hanakado"
				},
				{
					"id": 727360102,
					"content": "Arataki Çetesinin bu kadar çok rakibi yeneceğini hiç düşünmemiştim. Görünüşe göre bu sanatta hepiniz oldukça iyisiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360103
					],
					"speakerTitle": "Büyük Usta Hanakado"
				},
				{
					"id": 727360103,
					"content": "Daha önce söylediğim sözleri geri alıyorum. Siz saygıdeğer ve önemli rakiplersiniz ve sizinle tüm gücümle dövüşeceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360104
					],
					"speakerTitle": "Büyük Usta Hanakado"
				},
				{
					"id": 727360104,
					"content": "Peki! Boşboğaz, sen bizim liderimizsin. Kendini gösterme zamanın geldi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727360105,
					"content": "Ve şey, daha önce dediklerimi ciddiye alma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360106,
						727360107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727360106,
					"content": "Hadi Hakiki Böcek Dövüşü Kralı, sıra sende!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727360108
					]
				},
				{
					"id": 727360108,
					"content": "Hahahahahaha! Hadi bakalım! Kozlarımızı bir kez daha ortaya koyalım, nihai zafer benim olacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360109
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727360109,
					"content": "Takımını nasıl yönetiyordun bilmiyorum ama sonuçlar ortada: Arataki Çetesi bir numara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360110
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727360110,
					"content": "Büyük Usta Hanakado, dövüşe hazır ol!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727360107,
					"content": "Krala karşı Büyük Usta! Bu efsanevi bir şey olacak!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727360108
					]
				}
			]
		},
		{
			"id": 7273602,
			"completionStepIds": [
				7273603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7273603",
							"2"
						],
						"stepId": 7273603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Büyük Usta Hanakado"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727360201,
					"content": "Anladım. Anladım... Bir kere daha dövüşelim. Bu sefer yöntemlerin bir işe yaramayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360202
					],
					"speakerTitle": "Büyük Usta Hanakado"
				},
				{
					"id": 727360202,
					"content": "Kazanmak veya kaybetmek çok da önemli değil... Eğlencesine dövüşelim, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360203
					],
					"speakerTitle": "Büyük Usta Hanakado"
				},
				{
					"id": 727360203,
					"content": "Böylesine nadir bir rakibi bulmak oldukça zor. Dövüşü bu kadar erken bırakmak bu şansı ziyan etmek olur, öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360204
					],
					"speakerTitle": "Büyük Usta Hanakado"
				},
				{
					"id": 727360204,
					"content": "Elbette! Hodri meydan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360205
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727360205,
					"content": "Gizli böcek dövüşü tekniklerimi biraz zor görürsün ama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360206
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727360206,
					"content": "Benim daha güçlü bir böcek dövüşçüsü olduğumu kabul edersen seninle istediğin kadar böcek dövüştürürüm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727360207
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727360207,
					"content": "Görünüşe göre Boşboğaz ve Büyük Usta Hanakado kapışmaya devam ediyorlar... En iyisi onları kendi hallerine bırakalım! Böcekler bıkana kadar kapışmaya devam etsinler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}