					"content": "Bunlar iş görür, teşekkür ederim. Şimdi bunları marangozlara gönderme vakti... Tabii, doğru ya. Bir de kiraları toplamam lazım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040702
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040702,
					"content": "*iç çeker* Adı Astromona mıydı neydi... Acaba bu sefer evde midir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040703
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040703,
					"content": "Astrolog Mona demek istediniz sanırım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200040704
					]
				},
				{
					"id": 200040704,
					"content": "Aynen! Şimdi hatırladım. Adı sence de biraz uzun değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040705
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040705,
					"content": "Mona kirasını ödemedi diyorsunuz yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200040706,
					"content": "Aynen öyle. Onun dışındaki tüm kiracılarım kiralarını ödedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040707
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040707,
					"content": "Birkaç kez kirayı almaya gittim ama evde değildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200040708
					],
					"speakerTitle": "Goth"
				},
				{
					"id": 200040708,
					"content": "Lütfen oraya gidip kirayı almamı sağlayabilir misin Gezgin?",
