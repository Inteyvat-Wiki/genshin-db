						200040503
					]
				},
				{
					"id": 200040503,
					"content": "Güzel. Neyse ki evin kirası çok da pahalı değil. İşler durgun olduğu için gereken Morayı zar zor toplayabildim.",
					"roleType": "TALK_ROLE_NPC",
