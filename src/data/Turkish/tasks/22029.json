			"dialogs": [
				{
					"id": 220290301,
					"content": "*nefes nefese kalır* Gerçekten de zorlu bir rakipmişsin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290302
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290302,
					"content": "Çok şey öğrettin bana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290303,
						220290304
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290303,
					"content": "İyi misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290305
					]
				},
				{
					"id": 220290305,
					"content": "Sorun değil... Biraz nefeslenmem gerek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290306
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290306,
					"content": "O kadar güçlüsün ki dev bir ejderhayı yendiğini söylesen bile inanırım şu an...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290307
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290307,
					"content": "Aslında zaten yendim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290308
					]
				},
				{
					"id": 220290308,
					"content": "Hahaha... Sana inanıyorum merak etme. Benimle beraber antrenman yaptığın için teşekkür ederim. Bu karşılaşmayı asla unutmayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290309
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290309,
					"content": "Zahmet olmazsa lütfen arada sırada buraya antrenman yapmaya gel. Senin gibi güçlü birisiyle antrenman yaptığım sürece hedefimle aramda hiç kimse duramaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290310
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290310,
					"content": "\"Hedefin\" mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290311
					]
				},
				{
					"id": 220290311,
					"content": "Şey... Gerçekleştirmek istediğim bir dilek sadece. Yardımın için teşekkür ederim, ödeme olarak lütfen bunu kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290312
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290312,
					"content": "Benim gidip biraz dinlenmem lazım. Kuvvetli hamlelerin beni biraz yordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290304,
					"content": "Kusura bakma, kendimi tutamadım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290305
					]
				}
			]
		},
