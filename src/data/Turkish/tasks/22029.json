				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220290101,
					"content": "Yapabilirim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290102
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290102,
					"content": "Ha? Siz de kimsiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290103
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290103,
					"content": "İlandaki görev için geldim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290104
					]
				},
				{
					"id": 220290104,
					"content": "Ah, antrenman arkadaşı bulmak için yayınladığım ilandan bahsediyorsun. Doğru ya. Dövüş sanatları için bir antrenman arkadaşı arıyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290105
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290105,
					"content": "Kabul ettin yani öyle mi? Seni daha önce şehirde gördüğümü sanmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290106
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290106,
					"content": "Yanlış anlama, gücünü sorgulamak gibi bir niyetim yok, sadece hangi dövüş sanatlarında usta olduğunu kestiremedim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290107,
						220290109
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290107,
					"content": "Daha önce dev ejderhaları yenmişliğim var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290108
					]
				},
				{
					"id": 220290108,
					"content": "Hahaha, öyle mi? Onları nasıl yendiğini değil de nereden bulduğunu daha çok merak ettim. Ben daha önce hiç görmedim de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290112
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290112,
					"content": "Merak etme, oldukça yetenekliyimdir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290113
					]
				},
				{
					"id": 220290113,
					"content": "Haha, neyse, lafla peynir gemisi yürümez. Konuşmayı bırakalım da icraat görelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290114,
						220290115
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290114,
					"content": "Memnuniyetle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220290115,
					"content": "Neden görev ilanını isimsiz yayınladın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290116
					]
				},
				{
					"id": 220290116,
					"content": "Aslında... Çok da gurur duymadığım bir nedenden dolayı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290117
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290117,
					"content": "Neyse, görevi halihazırda kabul ettiğine göre sana gerçeği söyleyebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290118
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290118,
					"content": "Bir zamanlar birkaç Doushin ile bir göreve çıkmıştım. Dönüşte bir ticaret kervanını soymaya hazırlanan bir grup Kairagi ile karşılaştık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290119
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290119,
					"content": "Kervanı kurtarmak için oraya koştuk. İlk başta avantaj bizde olduğu için hemen geri çekildiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290120
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290120,
					"content": "Sonrasında biz tam mola verecekken aniden başka bir grup Kairagi çıkageldi. Onlara komut veren bir liderleri var gibi görünüyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290121
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290121,
					"content": "Biz daha ne olduğunu anlayamadan kendimizi kapana kısılmış bir halde bulduk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290122
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290122,
					"content": "Avantajımızı kaybettiğimiz için elimizden gelen tek şey kervanı korurken Kairagileri püskürtmeye çalışmaktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290123
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290123,
					"content": "Ben Kairagi lideri ile dövüşürken... Lider silahımı elimden aldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290124
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290124,
					"content": "Silahımı aldıktan sonra onu havaya kaldırdı ve bana bakarak gülmeye başladı. O kadar utanç vericiydi ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290125
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290125,
					"content": "O tüccarlara ne oldu peki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290126
					]
				},
				{
					"id": 220290126,
					"content": "Biz geri çekilirken devriye gezen bir grup Doushine rastladık, Kairagiler de onları görünce kaçtılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290127
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290127,
					"content": "O tüccarlara şehre kadar eşlik ettik. Ancak malları tamamen... *iç çeker* Hepsi benim beceriksizliğim yüzünden oldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290128
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290128,
					"content": "Döndüğümüzde bana yeni bir silah verildi fakat yine de yaşadıklarımı hâlâ atlatamadım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290129
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290129,
					"content": "O yüzden becerilerimi geliştirme umuduyla o görev ilanını verdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290130
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290130,
					"content": "Yeteri kadar güçlendiğimde o Kairagiyi yenip silahımı geri alacak ve adıma sürülmüş bu kara lekeyi temizleyeceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290109,
					"content": "Bir tanrının düşüşüne tanıklık ettim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220290110
					]
				},
				{
					"id": 220290110,
					"content": "Ha, sen neden bahsediyorsun be? Liyue'deki Zuhur Ayininde rol aldığını mı söylüyorsun yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290111
					],
					"speakerTitle": "Asakura"
				},
				{
					"id": 220290111,
					"content": "Hahaha, senin mantığına göre Liyue'deki birçok insan \"bir tanrının düşüşüne\" tanıklık etmiştir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220290112
					],
					"speakerTitle": "Asakura"
				}
			]
		},
