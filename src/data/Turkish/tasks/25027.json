			"dialogs": [
				{
					"id": 250270401,
					"content": "Ah, ne de güzel cıvıldıyor şu kuşlar! Bir sonraki eserim için harika bir materyal olacak bu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270402
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270402,
					"content": "Yine de sadece birkaç kuşun ötüşünü kaydedersek çok tekdüze olur sanki. Daha kalabalık bir sürü bulup cıvıltılarının topluca kaydını alsak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270403
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270403,
					"content": "Bir dakika... Şurada bir Koholazor var. Pençesiyle taşları kazırken çıkardığı sesi duyuyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270404
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270404,
					"content": "Koholazorlar hassas canlılardır, çok yaklaşmayalım. Kabilemizdeki profesyonellerden rica edersem ihtiyacım olan kaydı yapmama yardımcı olurlar. Bu işi onlardan başkası yapamaz zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270405
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270405,
					"content": "Bak sen... Birbirine kafa tutan savaşçılar demek. Güzel, güzel. Dövüş sesleri gerçekten de ilham verici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270406
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270406,
					"content": "Hop! Ne dikiliyorsun sen orada? Dövüşmeye mi geldin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270407
					],
					"speakerTitle": "Öfkeli Kabile Savaşçısı"
				},
				{
					"id": 250270407,
					"content": "Hayır, biz... Materyal topluyorduk da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270408
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270408,
					"content": "\"Topluyorsun\" demek ha? Ağzını burnunu dağıtayım da onu topla asıl sen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270409
					],
					"speakerTitle": "Öfkeli Kabile Savaşçısı"
				},
				{
					"id": 250270409,
					"content": "#İ-İmdat! {NICKNAME}, ne olur durdur şunu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Milu Nui"
				}
			]
		},
