			"dialogs": [
				{
					"id": 250270901,
					"content": "Ses kaydı almayı deneyebilirsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270902
					]
				},
				{
					"id": 250270902,
					"content": "Ses mi? Vahşi doğadaki sesleri kaydedip şarkılarımda doğrudan bunları kullanmak gibi mi yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270903
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270903,
					"content": "Hımm... Güzel bir fikir sanki. Evet ya, çok güzel bir fikir! Zehir gibisin gerçekten, süpersin! Hadi hemen işe koyulalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270904
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270904,
					"content": "Bir dakika, yanına bir şey almayacak mısın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270905
					]
				},
				{
					"id": 250270905,
					"content": "Yok canım. Ne yani, doğa yürüyüşüne çıkarken yanımda gramofon taşımamı mı bekliyordun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270906
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270906,
					"content": "Şarkılarda kullanabileceğimiz sesler için keşif gezisine çıkacağız, o kadar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270907
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270907,
					"content": "Örneğin bir ördeğin kanat çırpışı, bir Koholazorun su sıçratışı, bir Tepetlizorun ayak sesleri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270908
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270908,
					"content": "Hedeflerimizi belirledikten sonra ses kaydı yapmak için hazırlıklara başlayacağım tabii ama o aşamaya daha var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270909
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270909,
					"content": "Biz şimdilik zaman kaybetmeden yola çıkalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Milu Nui"
				}
			]
		},
