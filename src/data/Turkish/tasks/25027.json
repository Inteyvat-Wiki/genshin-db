				"points": []
			},
			"dialogs": [
				{
					"id": 250270201,
					"content": "Bay Milu yeni bir albüm çıkarmış! Alsam mı acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270202
					],
					"speakerTitle": "Mahina Nui"
				},
				{
					"id": 250270202,
					"content": "Bana Milu Nui'nin müziğinden bahseder misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270203
					]
				},
				{
					"id": 250270203,
					"content": "Kendisi harika bir müzisyendir! Haloa ve bebek Sürüngen bayılıyor şarkılarına.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270204
					],
					"speakerTitle": "Mahina Nui"
				},
				{
					"id": 250270204,
					"content": "Huysuzlandıklarında, mızmızlık ettiklerinde, uyumak istemediklerinde hemen Bay Milu'dan \"Bahar Günü Şarkısı\"nı açarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270205
					],
					"speakerTitle": "Mahina Nui"
				},
				{
					"id": 250270205,
					"content": "Melodiyi birazcık dinlediler mi mışıl mışıl uyurlar. Ertesi gün de pamuk gibi uyanırlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270206
					],
					"speakerTitle": "Mahina Nui"
				},
				{
					"id": 250270206,
					"content": "Gerçi... Haloa son zamanlarda daha hareketli şarkılar dinlemek istiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270207
					],
					"speakerTitle": "Mahina Nui"
				},
				{
					"id": 250270207,
					"content": "Bay Milu daha enerjik şarkılar yazsa bizimki de çok daha fazla eğlenirmiş gibi geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mahina Nui"
				}
			]
		},
		{
			"id": 2502703,
			"completionStepIds": [
				2502703
