			"trigger": {
				"objectNames": [
					"Milu Nui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250270101,
					"content": "Şu Pakaa'ya laf anlatacağım diye bin dereden su getirdim... Bir kulağından girip diğerinden çıkıyor, anlamıyor ki müziğe dair fikirlerimi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270102,
						250270103
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270102,
					"content": "Ne oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270104
					]
				},
				{
					"id": 250270104,
					"content": "Hımm? Sen... Gezgin misin? Merhabalar. Adım Milu Nui, müzisyenim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270105
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270105,
					"content": "Xochicuicatl Müzik Dükkanına yolun düştüyse pop müzik bölümünde mutlaka plaklarımı görmüşsündür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270106
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270106,
					"content": "\"Pop müzik\" anlayışımı ziyadesiyle yansıtıyor hepsi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270107
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270107,
					"content": "Gel gör ki Pakaa beni zerre anlamıyor. Şarkılarım pop müziğe değil, çocuk şarkılarına benziyormuş güya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270108
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270108,
					"content": "O kadar dil döktüm, yine de anlatamadım derdimi. İnadı tuttu bir kere, albümlerimi çocuk bölümüne koymak istiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270109
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270109,
					"content": "Yani evet, çocuklar şarkılarımı seviyor, aileler de onlara hediye etmek için albümlerimi alıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270110
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270110,
					"content": "Ama zaten çocuklar, yetişkinlerden çok daha dikkatli dinleyiciler! Kabilemizdeki çocuk nüfusu da epey fazla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270111
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270111,
					"content": "Şarkılarım çocuklar arasında bu kadar popüler olduysa pop bölümünde yer almak en doğal hakkım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270112,
						250270113
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270112,
					"content": "Şey... Mantıklı tabii...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270114
					]
				},
				{
					"id": 250270114,
					"content": "Değil mi ya? Hıh! Biliyorum, Pakaa hep böyle boş boş konuşur zaten ama artık burama kadar geldi! Yeni şarkım bir hazır olsun bak, o bile yeteneklerimi kabul etmek zorunda kalacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270115
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270115,
					"content": "Hoş, onun müzik zevkine pek de güvenmiyorum ama... Neyse artık. Ee, senin müzikle aran nasıldır gezgin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270116
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270116,
					"content": "Şey...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270117
					]
				},
				{
					"id": 250270117,
					"content": "Müzik aleti çalar mısın? Şarkı söylüyorsan veya mırıldanıyorsan da sayılır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270118,
						250270120
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270118,
					"content": "Müzisyenlik benden sorulur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270119
					]
				},
				{
					"id": 250270119,
					"content": "Harika! Öyleyse sen kesin benim müzik felsefemi anlarsın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270122
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270122,
					"content": "Yeni şarkım için tam da senin gibi birine ihtiyacım vardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270123
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270123,
					"content": "Merak etme, ödülün şimdiden hazır. Zaman ayırdığına değecek yani, için rahat olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270124
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270124,
					"content": "Peki o zaman. Şimdi içgüdülerine kulak ver ve sorumu cevapla. Muhteşem bir şarkı yazmak için nereden başlamam lazım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270120,
					"content": "Uzaktan yakından alakam yok...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270121
					]
				},
				{
					"id": 250270121,
					"content": "Hiç sorun değil! Müziğin keyfini en iyi senin gibiler çıkarır zaten. Şüphesiz ki en tarafsız yorumları da sen yaparsın o yüzden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270122
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270113,
					"content": "\"Çocuklara yönelik pop müzik\" işte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270114
					]
				},
				{
					"id": 250270103,
					"content": "Neymiş bu müziğe dair fikirlerin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270104
					]
				}
			]
		},
		{
			"id": 2502702,
