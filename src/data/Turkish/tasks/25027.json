					"Haloa Nui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250270301,
					"content": "Aa, yeni bir plak çıkmış! Bebek Sürüngen sevinçten havalara uçacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270302
					],
					"speakerTitle": "Haloa Nui"
				},
				{
					"id": 250270302,
					"content": "Bana Milu Nui'nin müziğinden bahseder misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270303
					]
				},
				{
					"id": 250270303,
					"content": "Milu Amca'nın şarkılarına ben de bayılırım ama bildiğim en büyük Milu hayranı evdeki Sürüngenimiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270304
					],
					"speakerTitle": "Haloa Nui"
				},
				{
					"id": 250270304,
					"content": "Ne zaman yaramazlık yapacağı tutsa annem şarkılarından birini çalıyor. Dinleyince bir bakmışsın, sus pus oluvermiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270305
					],
					"speakerTitle": "Haloa Nui"
				},
				{
					"id": 250270305,
					"content": "Şarkılar biraz fazla uzun ama sanki. Eşlik etmeyi bırak, sözlerini aklımda tutamıyorum bile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270306
					],
					"speakerTitle": "Haloa Nui"
				},
				{
					"id": 250270306,
					"content": "Sözleri daha kısa şarkılar yazsaydı ufaklık tüm gün gönlünce dinlesin diye söylerdim o şarkıları!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Haloa Nui"
				}
			]
		},
