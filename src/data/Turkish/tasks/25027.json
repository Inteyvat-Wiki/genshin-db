						250271302
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250271302,
					"content": "Görüyorum ki huysuz kişileri yola getirmekte üstüne yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250271303,
						250271305
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250271303,
					"content": "Bu daha ne ki, gücümün çeyreğini bile kullanmadım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250271304
					]
				},
				{
					"id": 250271304,
					"content": "Ona ne şüphe! Güçlü olduğun her halinden belli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250271307
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250271307,
					"content": "Eh, macera dolu bir yolculuk oldu. Neyse ki daha sonra şarkılarımda kullanabileceğim bir sürü ses buldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250271308
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250271308,
					"content": "Biraz hazırlıktan sonra sesleri resmi olarak kaydetmeye başlayabileceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250271309
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250271309,
					"content": "Hımm... \"Savaş sesleri\" güzel bir başlangıç olabilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250271310
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250271310,
					"content": "Dur ya, olmaz. O çok sert kaçar. Daha normal bir sesle yapalım açılışı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250271305,
					"content": "Bir şeyler yaptık işte.",
