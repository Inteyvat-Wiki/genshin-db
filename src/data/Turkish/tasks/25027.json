					"id": 250270501,
					"content": "Nasıl geçti? Geri bildirim verdiler mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270502
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270502,
					"content": "Birkaç fikir sundular diyebilirim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250270503
					]
				},
				{
					"id": 250270503,
					"content": "Müşterilerin geri bildirimlerini Milu Nui'ye anlatıyorsun...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250270504
					]
				},
				{
					"id": 250270504,
					"content": "Ya, demek öyle... Çok teşekkür ederim, bu geri bildirimler benim için çok kıymetli. Neleri değiştirebilirim diye bir bakayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270505
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270505,
					"content": "Bir şey dikkatimi çekti de... Tüm dinleyicilerim müziğime çocuk şarkısı muamelesi mi yapıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250270506
					],
					"speakerTitle": "Milu Nui"
				},
				{
					"id": 250270506,
					"content": "... Yok, hayır, bu yüzden değişiklik yapıyorum ya zaten... Peki nereden başlasam?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Milu Nui"
				}
			]
