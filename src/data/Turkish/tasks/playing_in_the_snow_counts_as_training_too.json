			"dialogs": [
				{
					"id": 706910101,
					"content": "Sayın Fahri Şövalye! Buraya, buraya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910102
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910102,
					"content": "Klee yeni arkadaşlar edindi! Bizimle oynamak ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910103
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910103,
					"content": "Bize Kar Labirenti adında yeni bir oyun gösterdiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910104
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910104,
					"content": "Kuralları zor değil. Sadece çok özel bir saklambaç oyunu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910105
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910105,
					"content": "Ay ne güzel ya! Klee, Yaoyao ve Sayu... Demek hepiniz arkadaş oldunuz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706910106,
					"content": "Sadece adına bakarak bile bu oyunun Rüzgar Labirentinin gelişmiş bir versiyonu olduğu anlaşılıyor, değil mi? Hehe, Paimon sizinle oynamak için sabırsızlanıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910107,
						706910108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706910107,
					"content": "Saklambaç mı? Süper!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910109
					]
				},
				{
					"id": 706910109,
					"content": "Hapşuuu... Kamp artık o kadar soğuk değil ama hâlâ biraz uykum var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910110
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910110,
					"content": "#Hıı? Gözlerim bana oyun mu oynuyor, yoksa {NICKNAME} ile Paimon mu gelmiş?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910111
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910111,
					"content": "#Gözlerin gayet iyi. Bu kesinlikle {NICKNAME} ile Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910112,
						706910113
					],
					"speakerTitle": "Yaoyao"
				},
				{
					"id": 706910112,
					"content": "Selam Yaoyao! Selam Sayu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910114
					]
				},
				{
					"id": 706910114,
					"content": "İyi fikir! Hareket edip biraz eğlenmeye başlarsak uykumuz da açılır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910115
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910115,
					"content": "Hem o aşırı ciddi Bayan Sumire de karlı dağlarda zaman geçirmenin becerilerini geliştireceğini söylememiş miydi Sayu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910116
					],
					"speakerTitle": "Yaoyao"
				},
				{
					"id": 706910116,
					"content": "Off, bunu hatırladığınıza inanamıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910117
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910117,
					"content": "Pekala... Yaşıtlarıma, hatta o süper Ninken'e karşı kaybedecek olursam ileride tembellik yapmak çok daha zor olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910118
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910118,
					"content": "Görünüşe göre bu yolculukta kendime biraz çekidüzen vermem gerekecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910119
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910119,
					"content": "Merak etme! Jueyun Biberi ve toz karabiber kullanarak yeni bir Gulaş tarifi geliştirdim ve biraz hazırladım bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910120
					],
					"speakerTitle": "Yaoyao"
				},
				{
					"id": 706910120,
					"content": "Başlamadan önce biraz ye. Söz veriyorum, oyun boyunca hiç üşümeyeceksin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910121
					],
					"speakerTitle": "Yaoyao"
				},
				{
					"id": 706910121,
					"content": "Harika! Durun önce şu kaseyi bitireyim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910122
					],
					"speakerTitle": "Sayu"
				},
				{
					"id": 706910122,
					"content": "Paimon da biraz istiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706910123,
					"content": "Peki o halde... Karlı dağda saklambaç oyunumuz başlasın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706910124
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 706910124,
					"content": "Hehe! Bütün dağ karla kaplı. Paimon için mükemmel bir saklanma yeri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706910113,
					"content": "Saklambaç oynamak ister misiniz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910114
					]
				},
				{
					"id": 706910108,
					"content": "Klee'nin yeni arkadaşlarıyla da tanışmayı çok isterim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706910109
					]
				}
			]
		}
	]
}