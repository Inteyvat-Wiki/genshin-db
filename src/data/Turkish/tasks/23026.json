			"dialogs": [
				{
					"id": 230260301,
					"content": "Kendilerine Gezgin Derviş Alimler diyen bir grup gezgin araştırmacıyla karşılaşmış olabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260302
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260302,
					"content": "Akademideki Darşanların birinde çok sayıda Derviş bulunur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260303
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260303,
					"content": "Öğretisinin temelinde elementler olan bu Darşan, element güçlerine bağlı olan her şeyi araştırır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260304
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260304,
					"content": "Sorum şu, bu Darşanın ismi nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260305,
						230260307,
						230260309
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260305,
					"content": "Spantamad.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260306
					]
				},
				{
					"id": 230260306,
					"content": "Doğru. Yedi Büyük Elementi tüm maddenin ve yaşamın özü olarak gören Elementbilim araştırmacıları Spantamad'dadır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260307,
					"content": "Haravatat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260308
					]
				},
				{
					"id": 230260308,
					"content": "Haha, yanlış cevap. Haravatat araştırmacıları dil, göstergebilim ve mantık konularında çalışır. İnan bana, bunlar son derece karmaşık konulardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260309,
					"content": "Rtawahist.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260310
					]
				},
				{
					"id": 230260310,
					"content": "Ne yazık ki yanlış cevap. Rtawahist, içinde bulunduğumuz evren üzerine araştırmalar yapan araştırmacıların yeridir. Hehe, ilgi çekici, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				}
			]
		},
