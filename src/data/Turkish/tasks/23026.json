			},
			"dialogs": [
				{
					"id": 230260101,
					"content": "Bu sorular çok mu zor acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260102
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260102,
					"content": "Hey! Gezgin! Dur bir saniye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260103
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260103,
					"content": "Kim, ben mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260104
					]
				},
				{
					"id": 230260104,
					"content": "Evet! Hehe, senden ufak bir iyilik isteyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260105,
						230260106,
						230260107
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260105,
					"content": "Bir şey mi kaybettin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260108
					]
				},
				{
					"id": 230260108,
					"content": "Nasıl yani? Sen bu konuya neden bu kadar hakimsin? Ahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260109
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260109,
					"content": "Ama hayır, hiçbir şey kaybetmedim, araştırma için malzemeye de ihtiyacım yok. İlham konusunda ise... Kendi başıma yeterince ilham buldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260110
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260110,
					"content": "Öhöm, aslında birinci sınıfların Sumeru'da kullanılan çeşitli terimleri daha hızlı öğrenmeleri için bir \"Soru Cevap\" broşürü hazırlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260111
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260111,
					"content": "Kısaca şöyle, bu broşür karmaşık isimleri soru ve cevap formunda açıklayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260112
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260112,
					"content": "Böylelikle öğrenmek öğrenciler için daha etkili ve daha ilgi çekici olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260113
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260113,
					"content": "Fakat bu soruların ne kadar zor olduğunu tam olarak kestiremiyorum... Ben de senden yardım isteyebileceğimi düşündüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260114,
						230260116
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260114,
					"content": "Akademi hakkında çok şey bilmiyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260115
					]
				},
				{
					"id": 230260115,
					"content": "Haha, sorun değil. Sorularımı cevapladıktan sonra en azından birkaç şey öğrenmiş olursun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260119
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260119,
					"content": "Endişelenme. Bunlar korkulacak sorular değil, yalnızca... Ufak birkaç soru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260120
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260120,
					"content": "Başlayalım o halde. İşte sorumuz geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260116,
					"content": "Daha önce böyle bir şey yapmıştım sanırım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260117
					]
				},
				{
					"id": 230260117,
					"content": "Mondstadt'ta Swan'ın sana sorduğu sorulardan mı bahsediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230260118,
					"content": "Ama o bize önceden cevapları vermişti! Paimon bu kişinin böyle bir şey yapmayacağını düşünüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230260106,
					"content": "Malzemen mi bitti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260108
					]
				},
				{
					"id": 230260107,
					"content": "İlham mı arıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260108
					]
				}
			]
		},
