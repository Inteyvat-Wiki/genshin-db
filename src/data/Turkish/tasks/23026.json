			"dialogs": [
				{
					"id": 230260201,
					"content": "Öhöm... Duymuş olabileceğin üzere Akademideki her Darşanın uzmanlaştığı bir araştırma alanı var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260202
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260202,
					"content": "Pekala, en fazla araştırmacıya sahip Darşanın adı nedir? Ufak bir ipucu da vereyim, bu Darşanın ana çalışma alanı Biyoloji.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260203,
						230260205,
						230260207
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260203,
					"content": "Amurta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260204
					]
				},
				{
					"id": 230260204,
					"content": "Doğru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260205,
					"content": "Armuta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260206
					]
				},
				{
					"id": 230260206,
					"content": "Eh, bir şeyler ters gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260207,
					"content": "Atamur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260208
					]
				},
				{
					"id": 230260208,
					"content": "Haha, ne yazık ki doğru cevap bu değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				}
			]
		},
