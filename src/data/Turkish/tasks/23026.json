			"dialogs": [
				{
					"id": 230260401,
					"content": "Yukarı bakınca Akademiyi bir arada tutan ağacı görebiliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260402
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260402,
					"content": "Sıradaki sorum basit ama çoğu kişi bu bilgiyi kolaylıkla göz ardı edebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260403
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260403,
					"content": "Pekala, Akademiyi tutan ağacın adı nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230260404,
						230260406,
						230260408
					],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260404,
					"content": "Ulu Ağaç.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260405
					]
				},
				{
					"id": 230260405,
					"content": "Haha, yakın sayılır. Ama ne yazık ki yanlış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260406,
					"content": "Kutsal Ağaç.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260407
					]
				},
				{
					"id": 230260407,
					"content": "Haha, güzel! Bu doğru cevap!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				},
				{
					"id": 230260408,
					"content": "Devasa Ağaç!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230260409
					]
				},
				{
					"id": 230260409,
					"content": "Güçlü bir isim olsa da yanlış cevap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziryab"
				}
			]
		},
