					"content": "Bu yazılanları okuyan her kim olursa olsun, benimle aynı doğaya sahip olacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710131403
					],
					"speakerTitle": "Harabe Hazinesi"
				},
				{
					"id": 710131403,
					"content": "<color=#00E1FFFF>İlgini çekerse diye, sahip olduğum birkaç hazineyi havuzun yanına gömdüm. İzin veriyorum, alabilirsin.</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710131404
					],
					"speakerTitle": "Harabe Hazinesi"
				},
				{
					"id": 710131404,
					"content": "Ama lütfen bu üç soruyu aklından çıkarma. Umarım bir gün bunları cevaplayacak bilgiye sahip olursun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harabe Hazinesi"
				}
			]
		},
		{
