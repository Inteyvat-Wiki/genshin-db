			},
			"dialogs": [
				{
					"id": 710130101,
					"content": "Yoldaşım ve ben, çocukluğumuzdan beri savunma sanatlarına çalıştık. Görevimiz, kötülüğe karşı savaşmak ve bu dünyanın tüm kutsal değerlerini korumaktı. Ama <color=#00E1FFFF>Önsezimiz</color> olmadan bu görev hiç kolay olmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710130102
					],
					"speakerTitle": "Harabe Hazinesi"
				},
				{
					"id": 710130102,
					"content": "Kendimizi daha da geliştirmek ve aradığımız <color=#00E1FFFF>Önsezileri</color> bulmak için buraya sığındık. Uğraşlarımızın göstergesi olarak bu abideyi diktik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710130103
					],
					"speakerTitle": "Harabe Hazinesi"
				}
			]
		},
		{
			"id": 7101302,
			"completionStepIds": [
				7101302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
