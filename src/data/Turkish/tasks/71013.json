			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710131501,
					"content": "<color=#00E1FFFF>Önseziler</color> gerçekten başka bir diyardan geliyor. İnsanlar, bunların tanrının bir hediyesi olduğunu söylüyorlar ama kimin niye bir Önsezi alacağını bilen yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710131502
					],
					"speakerTitle": "Harabe Hazinesi"
				},
				{
					"id": 710131502,
					"content": "Kadim yazılara göre tanrı, ölümlüler diyarına şefkatle bakar ve kötülüğe karşı savaşıp dünyayı korumaları için hak edenlere <color=#00E1FFFF>Önsezi</color> bahşeder. Ama ben... Artık canavarları yok etme arzusuyla yanıp tutuşmuyorum. Artık onlarla sadece konuşmak istiyorum. Onları anlamak istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710131503
					],
					"speakerTitle": "Harabe Hazinesi"
				},
				{
					"id": 710131503,
					"content": "Bu <color=#00E1FFFF>Önsezi</color>... Artık işime yaramıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harabe Hazinesi"
				}
			]
		},
