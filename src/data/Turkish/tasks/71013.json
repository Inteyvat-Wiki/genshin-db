			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710130201,
					"content": "Neyse ki <color=#00E1FFFF>Önsezimi</color> bulabildim ama içimde bir şüphe vardı. Sıradan insanlar, uzun zamandır dünyayı kirleten canavarları yeryüzünden silecek kudrete sahip miydi? Peki dış görünüşleri dışında, bu canavarlar insanlardan çok mu farklıydı? Onlar da bizim gibi konuşmuyor, gelişmiyor; sevgi ile nefreti, sevinç ile hüznü hissetmiyorlar mıydı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710130202
					],
					"speakerTitle": "Harabe Hazinesi"
				},
				{
					"id": 710130202,
					"content": "Ben de aklımdaki en büyük karmaşayı bu abideye kazıdım. Ey gelecekte bunu okuyan kişi, sen bu bilmeceyi çözebilecek misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harabe Hazinesi"
				}
			]
		},
