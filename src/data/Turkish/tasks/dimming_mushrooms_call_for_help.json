			"dialogs": [
				{
					"id": 710610201,
					"content": "Katalizörün enerjisini Xamaran'a aktarırsın.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710610202
					]
				},
				{
					"id": 710610202,
					"content": "Vay canına! Cücük Mantarı parlamaya başladı. Paimon artık ona \"Parlak Mantar\" dese daha iyi olur belki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610203,
					"content": "#Çok yaşa {NICKNAME}! Çok yaşa Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610204
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610204,
					"content": "#{NICKNAME} ve Paimon sayesinde, Xamaran'ın yaşam ışığı yeniden canlandı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610205
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610205,
					"content": "Yine de gardını düşürme. Xamaran, kötü enerjinin henüz yok olmadığını biliyor. Her an bir misilleme gelebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610206
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610206,
					"content": "Ne? O zaman ne yapacağız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610207,
					"content": "Of! Tüm bu siyah çamur da nereden geldi? Cücük Mantarı'nın bahsettiği \"kötü enerji\" bu mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7106103,
			"completionStepIds": [
				7106110
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
