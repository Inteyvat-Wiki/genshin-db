			"dialogs": [
				{
					"id": 710610401,
					"content": "#Çok yaşa {NICKNAME}! Çok yaşa Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610402
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610402,
					"content": "Xamaran haddini aşmak istemiyor ama iki ayaklıların bir lafı var: \"Başladığın işi bitirmelisin.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610403,
						710610405
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610403,
					"content": "Ayak işi demek istiyorsun herhalde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610404
					]
				},
				{
					"id": 710610405,
					"content": "İnsanların özdeyişleri mantarlar için geçerli mi ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610406
					]
				},
				{
					"id": 710610404,
					"content": "İki ayaklılar arasında siz ikiniz gerçekten \"Bilge\" unvanını hak ediyorsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610407
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610406,
					"content": "İkimiz de yeryüzünün nimetlerinden yararlanan canlı varlıklarız. Birbirimize yardım etmemiz gayet doğal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610407
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610407,
					"content": "Lütfen bu Bilgeliğin Lütfunu al.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610408
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610408,
					"content": "Bilgeliğin Lütfunu elde ettin.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710610409
					]
				},
				{
					"id": 710610409,
					"content": "Vay canına! Bu da ne böyle? Aslında içimde biraz şüphe uyandırıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610410,
					"content": "Xamaran kötü enerjinin havada yayılan kokusunu alabiliyor ancak kaynağının nerede yattığından habersiz. Suyu takip edersen onu bulacaksın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610411
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610411,
					"content": "#Yapman gereken yalnızca Bilgeliğin Lütfunu kötü enerjinin kaynağı üzerinde kullanmak {NICKNAME}. Xamaran'ın soydaşları geri kalanının çaresine bakacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610412,
						710610413
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610412,
					"content": "Kötü enerjinin kaynağı... Bununla ilgilenmemek olmaz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610414
					]
				},
				{
					"id": 710610413,
					"content": "Peki, neden bununla sen ilgilenmiyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610414
					]
				},
				{
					"id": 710610414,
					"content": "#{NICKNAME}, sen Paimon'dan da komiksin. Xamaran'ın senin gibi ayakları yok. Ayaksızlardan biri olarak Xamaran iki ayaklıların meselelerine çok fazla karışmamalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610415
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610415,
					"content": "Üstelik Xamaran'ın yapması gereken daha önemli bir iş var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610416
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610416,
					"content": "Daha önemli bir iş mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610417
					]
				},
				{
					"id": 710610417,
					"content": "Xamaran gücünün büyük bir kısmını harcadı. Xamaran ikinizle hoş bir sohbet etmiş olsa da şimdi dinlenmeli. Kötülüğü defetmek için gereken gücü toplamalı ve soydaşlarının iyiliği için barınak sağlamalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610418
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610418,
					"content": "#{NICKNAME} ve Paimon, umarım yolculuğunuz hayırlı geçer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610419
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610419,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610420
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610420,
					"content": "Hey Cücük Mantarı! Uyan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610421,
					"content": "#{NICKNAME}, Cücük Mantarı uykuya dalmış gibi. Hadi o zaman, yola çıkalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610207,
					"content": "Of! Tüm bu siyah çamur da nereden geldi? Cücük Mantarı'nın bahsettiği \"kötü enerji\" bu mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
