						"stepId": 7106110,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710610301,
					"content": "#Çok yaşa {NICKNAME}! Çok yaşa Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610302
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610302,
					"content": "Xamaran'ın yardım çağrısına Kimse cevap vermedi. Çok ayaklılar ve dört ayaklılar hiç umursamadı ve iki ayaklılar da kulak asmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610303
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610303,
					"content": "#Yalnızca hikmet sahipleri cevap verdi. Paimon ve {NICKNAME} böylece bilgeliklerini sergiledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610304
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610304,
					"content": "Siz, iki ayaklıların en bilgelerisiniz. Xamaran ikinize de minnettar kalacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610323
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610323,
					"content": "Hıh, Bilge Paimon hafife alınmamalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610305,
					"content": "Rica ederiz, önemli değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610306
					]
				},
				{
					"id": 710610306,
					"content": "#Zamanla {NICKNAME} ve Paimon, Xamaran ve soydaşlarının seviyesine yükselecek. Xamaran bundan emin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610307
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610307,
					"content": "Bir saniye, bu ne demek oluyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610308,
					"content": "Çok ayaklılar dört ayaklılardan aşağı, dört ayaklılar iki ayaklılardan aşağı. Doğal olarak iki ayaklılar da ayaksızlardan aşağı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610309
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610309,
					"content": "#Fakat {NICKNAME} ve Paimon, doğuştan gelen eksikliklerini sıkı çalışarak telafi edebilir. Hatta bir gün kaderin gidişatını bile değiştirebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610310
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610310,
					"content": "Vay! Bu parlak mantar çok büyük laflar ediyor. Paimon, parlak mantarlardan iyi yemek malzemesi olup olmayacağını merak etti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610311,
						710610312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610311,
					"content": "Tavuk Mantar Şiş için olabilir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610313
					]
				},
				{
					"id": 710610312,
					"content": "Güzel mantarlar yalan söyler. Bu mantar zehirli olabilir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610313
					]
				},
				{
					"id": 710610313,
					"content": "Bu Paimon obur. Bugün mantardan bir ısırık, yarın başka bir ısırık alırsa yüz gün sonra Paimon'dan Paimon kalmaz, bir tek mantar kalır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610314
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610314,
					"content": "#Ah, Cücük Mantarı yine tuhaf konuşmaya başladı {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610315,
					"content": "Demek espriyi anlamadın. Ne yazık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610316
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610316,
					"content": "Bu hiç komik değildi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610317,
					"content": "Xamaran kötü enerjiden arındı ancak soydaşları hâlâ acı çekiyor. Xamaran eskisi gibi zayıfları korumak için yeterli güce sahip değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610318
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610318,
					"content": "#Lütfen {NICKNAME}, Xamaran sana yalvarıyor. Yardımseverliğini göster ve savunmasızları koru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610319
					],
					"speakerTitle": "Xamaran"
				},
				{
					"id": 710610319,
					"content": "#Yani başka hasta mantarlar mı var diyorsun? {NICKNAME}, hadi onlara yardım edelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610320,
						710610321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610320,
					"content": "Madem buradayız...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610322
					]
				},
				{
					"id": 710610321,
					"content": "Yolumuzdan çok sapmadığımız müddetçe olur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610322
					]
				},
				{
					"id": 710610322,
					"content": "Hadi gidelim o zaman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710610207,
					"content": "Of! Tüm bu siyah çamur da nereden geldi? Cücük Mantarı'nın bahsettiği \"kötü enerji\" bu mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
