			"dialogs": [
				{
					"id": 740840605,
					"content": "Bak! Sunağın yanında bir ejder var! Uyuyor galiba ama yine de dikkatli olmamız lazım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840601
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840601,
					"content": "Ne? Nasıl yani? Anahtar nasıl olmaz? Sunak çoktan etkinleştirildi mi? Birileri anahtarı çoktan aldı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840602,
					"content": "Raaarrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840603
					],
					"speakerTitle": "Uyuyan Ejder"
				},
				{
					"id": 740840603,
					"content": "Eyvah! Ejder uyandı! Hemen kaçmamız lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740840604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740840604,
					"content": "Sunağın yanındaki ejder silkinerek uyanır, gözleri nefret ve öfke doludur...\\nOlabildiğince hızlı bir şekilde kıyıya yüzersiniz ama onun da peşinizden ayrılmaya niyeti yoktur...",
