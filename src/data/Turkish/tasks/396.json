			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Barbara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3960201,
					"content": "Bu Barbara, kilisenin Rahibesi. Göklerin Kutsal Lirini almak için burada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960202
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3960202,
					"content": "Rüzgar Hükümdarı seni korusun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960203
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960203,
					"content": "Büyük Kumandan Vekilimizle kıyaslandığında gerçekten konuşabilecek bir konumda değilim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960204
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960204,
					"content": "Ama yine de tüm Mondstadt adına hepinize yardımınız için teşekkür etmek istiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960205
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960205,
					"content": "Neyse ki her şey barışçıl bir şekilde çözüldü. Ordu ve ejder arasında büyük bir savaş nasıl sona ererdi hayal bile edemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960206
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960206,
					"content": "Şimdi Fatui için çenelerini kapatmaktan başka seçenek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960207
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3960207,
					"content": "Her şeyin planlandığı gibi sonuçlanmamasına kızmış olabilirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960208
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3960208,
					"content": "Bu sefer, Favonius Şövalyelerine baskı yapmak için en iyi bahanelerini bile kaybettiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960209
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3960209,
					"content": "Diplomatik olarak konuşmak gerekirse, bir şey kazanmadılar, tam tersine, ne kadar sabırsız olabileceklerini kanıtladılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960210
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3960210,
					"content": "Esaslı bir hikayeye benziyor. Kutsal Liri de yanında getirdin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960211
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960211,
					"content": "Senden Liri sonsuza dek savunmanı isteyemeyiz. Vekilharç bir süredir bana baskı yapıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960212
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960212,
					"content": "Biz eee... Onu beraberimizde getirdik... Şey... Sadece... Biraz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960213,
					"content": "Ah, merak etme! Buraya kira almaya gelmedim! Kilise her zaman özel olarak fon alır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Barbara"
				}
			]
		},
		{
			"id": 39605,
			"completionStepIds": [
				39605
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
