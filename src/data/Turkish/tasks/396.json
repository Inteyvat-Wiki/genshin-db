			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Barbara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3960501,
					"content": "Ah! Fahri Şövalye, uyanmışsın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960502,
						3960505
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960502,
					"content": "Venti... O iyi mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960503
					]
				},
				{
					"id": 3960503,
					"content": "Imm... Tam olarak \"iyi\" olduğunu söyleyemem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960504
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960504,
					"content": "Seni Katedralin dışında baygın halde yatarken buldum ve seni iyileştirmek için element güçlerimi kullandım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960510
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960510,
					"content": "İlk önce ozan uyandı ama tuhaf bir şekilde iyileştirme güçlerim onun üzerinde neredeyse hiç etki etmedi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960511
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960511,
					"content": "İlk defa böyle bir hastayla karşılaştım. Ama sadece \"tamamen normal\" dedi ve sonra kalkıp Katedralden ayrıldı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960512
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960512,
					"content": "Ayrıldı mı? Çok zaman geçti mi? Nereye gitti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960513,
					"content": "<color=#00E1FFFF>\"Mondstadt Kahramanının Sembolü\"</color> dedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960514
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960514,
					"content": "Onu durdurmak istedim ama Jean... Yani Kumandan Jean, onun gitmesine izin vermemi söyledi. Ne tuhaf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960515,
						3960516
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960515,
					"content": "(Sanırım anladım...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960517
					]
				},
				{
					"id": 3960517,
					"content": "Paimon, Venti'nin daha önce <color=#00E1FFFF>o ağacın</color> altında iyileştiğini hatırlıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960518,
					"content": "(Muhtemelen Rüzgaralan ve Rüzgar Hükümdarı arasındaki bağlantı nedeniyle. Kumandan Jean de bunu anladı ama Barbara'ya söyleyemeyiz...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960516,
					"content": "(Sanırım Jean anladı...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960517
					]
				},
				{
					"id": 3960505,
					"content": "Hangi gezegende... Yaşıyoruz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960506
					]
				},
				{
					"id": 3960506,
					"content": "Gezegen mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960507
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960507,
					"content": "Ah! Onun saçmalıklarına kulak asma Bayan Barbara!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960508,
					"content": "Ahh... Iıı, tamam, evet, temel olarak, seni Katedralin dışında buldum, baygın yatıyordun ve seni iyileştirmek için element gücümü kullandım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960509
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960509,
					"content": "Paimon'a göre yüzüne hâlâ son kez buz gibi soğuk su fışkırtabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960510
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 39606,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
