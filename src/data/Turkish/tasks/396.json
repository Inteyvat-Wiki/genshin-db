			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3960601,
					"content": "Çimenlerin arasından esen rüzgar harika, bıraktığı kokuyu çok seviyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960602
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960602,
					"content": "Haha, geçen sefer tam olarak aynı şeyi söylemiştim. *iç çeker* Böyle şeyleri neden sadece şanssız olduğum günlerde söylüyorum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960603
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960603,
					"content": "Peki... Gnosis nedir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960604
					]
				},
				{
					"id": 3960604,
					"content": "Ah, demek fark ettiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960605
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960605,
					"content": "*iç çeker* Bu, sıradan insanlarla paylaşmayı sevdiğim bir şey değil. Ama sanıyorum ki sizinle sırrımı paylaşabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960606
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960606,
					"content": "Bildiğin gibi, Önseziler yalnızca küçük bir azınlığın sahip olduğu sihirli güçlerdir. Bu Önsezilerden yararlanarak element gücünü kullanırlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960607
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960607,
					"content": "Doğrusu her Önsezi sahibi, tanrı olma yolunda ilerleyen ve Kutsal Diyar'a yükselebilen biridir. Biz bu kişilere Köken Tanrıları diyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960608
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960608,
					"content": "Köken Tanrıları mı? Paimon, onları daha önce hiç duymamıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960609,
					"content": "Haha, çünkü bu sadece hükümdarların bildiği bir sır. Önseziler gibi ilkel araçlara ihtiyaç duymuyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960610
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960610,
					"content": "Bunun yerine, her hükümdarın doğrudan Kutsal Diyar'ın kendisi ile iletişime geçen içsel bir büyü odağı bulunur... Gnosis olarak bilinir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960611
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960611,
					"content": "Peki ya beline astığın şey nedir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960612
					]
				},
				{
					"id": 3960612,
					"content": "He he. O sadece şüpheden kaçınmak için yanımda taşıdığım parlak bir cam küre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960613,
						3960614
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960613,
					"content": "Ha...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960615
					]
				},
				{
					"id": 3960615,
					"content": "Peki Paimon'u havaya savuran ve senin Gnosis'ini çalan o kötü kadın kimdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960616,
					"content": "Adı Sinyora, 8 numaralı haberci.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960617
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960617,
					"content": "Snezhnaya Çariçesi, ona ve diğer habercilere tanrılara eş değer bir yönetim yetkisi ve bununla birlikte diğer bütün ölümlülerinkini aşan güç vermiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960618
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960618,
					"content": "Snezhnaya Çariçesi mi? O...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960619,
					"content": "Aynen öyle. Yedilerden birisi o, Zapolyarny Sarayı'nda saltanat süren Çariçe, ayrıca Fatui Habercilerinin hesap verdiği tek kişi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960620
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960620,
					"content": "Yediler her zaman iyi geçinemiyor ama yine de... Başka bir hükümdarın Gnosis'ini çalmayı planlayacağını hiç düşünmemiştim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960621
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960621,
					"content": "Çariçe ne tür bir tanrı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960622
					]
				},
				{
					"id": 3960622,
					"content": "Ah... Bunu nasıl açıklamalıyım acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960623
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960623,
					"content": "Beş yüz yıl önce onu iyi biri olarak bilirdim. Ama artık aynısını söyleyemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960624
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960624,
					"content": "Anlayacağınız üzere bir felaket, beş yüz yıl önce gerçekleşti ve sonrasında o, benimle tüm bağlarını kopardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960625
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960625,
					"content": "Ama Buz Hükümdarı ve Fatui hakkında olan sohbetimizi başka bir güne saklayabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960626
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960626,
					"content": "#{NICKNAME}, Yedilerin geri kalanını arıyorsan önünde hâlâ çok sayıda zorluk var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960627
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960627,
					"content": "Mondstadt'ın komşu ülkesi Liyue'ye gitmelisin. Benim aksime orada hüküm süren Toprak Hükümdarı, tüm bölgesini kendi başına yönetiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960628
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960628,
					"content": "Liyue'ye yol gösteren kutsal kehanetlerini söylemek için her yıl sadece bir kez iner ve şehir için yılın geri kalanında izlenecek yol haritasını belirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960629
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960629,
					"content": "Yine de kulağa ismi lazım değil birinden çok daha fazla çalışıyormuş gibi geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960630
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960630,
					"content": "He he.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960631
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960631,
					"content": "... Her durumda bu yılın Zuhur Ayini başlamak üzere. Bunu kaçırırsanız diğer yılı beklemek zorunda kalırsınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960632
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960632,
					"content": "#NE? Neden bize daha önce söylemedin? Tamam o zaman hoşça kal. {NICKNAME}, gidiyoruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960633,
					"content": "Bir saniye bekle, Rüzgarın Yol Arkadaşı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960634,
						3960636
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960634,
					"content": "Beni mi kastettin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960635
					]
				},
				{
					"id": 3960635,
					"content": "Evet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960638
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960638,
					"content": "Gezgin, tekrar yola çıktığında yolculuğun kendisinin bir anlamı olduğunu hatırlamalısın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960639
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960639,
					"content": "Teyvat'ın kuşları, şarkılar ve şehirler, Çariçe, Fatui'si ve canavarlar... Hepsi yolculuğunun bir parçası.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960640
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960640,
					"content": "Varacağın nokta her şey demek değil. Sonuna ulaşana kadar gözlerini açık tut. Etrafındaki dünyayı görme şansını kullan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960641,
						3960642
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960641,
					"content": "Venti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960643
					]
				},
				{
					"id": 3960643,
					"content": "Harika. Rüzgar Hükümdarı'nın öğütleri bu kadardı! Venti Zamanına geri dönme vakti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960642,
					"content": "Anlıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960643
					]
				},
				{
					"id": 3960636,
					"content": "İzinsiz bir şekilde heykelin Rüzgar gücünü ödünç aldığım için üzgünüm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960637
					]
				},
				{
					"id": 3960637,
					"content": "Haha, en iyi şekilde kullan yeter... Veya daha da iyisi bana bir bardak karahindiba şarabı ısmarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960638
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960614,
					"content": "Kandırılmış hissediyorum... Ama sanırım artık buna alıştım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960615
					]
				}
			]
		},
		{
			"id": 39608,
			"completionStepIds": [
				39604
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3960701,
					"content": "Sohbet etmek isterseniz şimdi tam zamanı. Bir ozan her zaman tek bir diyarda kalmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960702,
						3960707,
						3960715,
						3960727,
						3960741
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960702,
					"content": "Dvalin hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960703
					]
				},
				{
					"id": 3960703,
					"content": "Dvalin, sonuna dek görevini Dört Rüzgardan biri olarak hatırladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960704
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960704,
					"content": "Bu yüzden bu görevi ondan zorla alıp kendi özgürlük ideallerimi ona dayatma niyetinde değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960705
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960705,
					"content": "Umarım Dvalin, kendi için en iyi seçimi yapar ve özgürlüğün ne olduğunu anlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960706
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960706,
					"content": "Bir hükümdar olmadan önce ben de özgürlüğün anlamını bir arkadaşım sayesinde öğrendim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960701
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960707,
					"content": "Hiçlik Tarikatı hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960708
					]
				},
				{
					"id": 3960708,
					"content": "Kaeya'nın yeni bir istihbarat paylaştığını mı söylüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960709
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960709,
					"content": "#... Anlıyorum. Bu yüzden Hiçlik Tarikatında Dvalin'i yozlaştırma planını oluşturan bir {F#Prens}{M#Prenses} var, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960710
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960710,
					"content": "#Muhtemelen Dvalin'i Hiçlik için bir savaş silahı yapmaya çalışıyorlardı. Ama gerçi, hiç böyle bir Hiçlik Tarikatı {F#Prensi}{M#Prensesi} duymadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960711,
						3960712
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960711,
					"content": "O zaman bir Hiçlik Tarikatı geleneği değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960713
					]
				},
				{
					"id": 3960713,
					"content": "Ben de öyle düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960714
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960714,
					"content": "#Ama bir {F#Prens}{M#Prenses} nasıl birdenbire ortaya çıkıp tüm Hiçlik Tarikatının yönetimini ele alır?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960701
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960712,
					"content": "O zaman bu, yeni bir gelişme...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960713
					]
				},
				{
					"id": 3960715,
					"content": "Sinyora hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960716
					]
				},
				{
					"id": 3960716,
					"content": "O Fatui leydisi buralarda kalmadı değil mi? Sadece Gnosis'ini alıp gitti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960717,
					"content": "Favonius Şövalyelerinin görgü tanığı olmasından kaçınmak istedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960718
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960718,
					"content": "Burada yapılan en ufak hata, Fatui'nin Şövalyelerle olan diplomatik ilişkilerini mahvederdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960719
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960719,
					"content": "Yani öylece Mondstadt'ın müttefikleri gibi davranmaya devam mı edecekler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960720
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960720,
					"content": "*iç çeker* ... Keşke yedi ulus en başından beri Hiçlik Tarikatına karşı birlik olsaydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960721
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960721,
					"content": "Fatui, yedi ulus içinde en güçlü orduya sahip olanı. Yine de onu Kutsal Liri çalmak, tanrıların gücüne göz dikmek ve Dvalin'i Şövalyelere karşı pazarlık kozu yapmak için kullandılar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960722
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960722,
					"content": "Lirden bahsetmişken... Diluc, daha önce böyle bir şey söylememiş miydi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960723,
					"content": "Fatui'nin çıldırarak yedi ulusa saldırabileceğini ve habercileri yüzünden Şövalyeleri tehdit edebileceğini söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960724,
					"content": "Evet. Daha önce söylediğim gibi Buz Hükümdarı onlara diğer ölümlülerin ötesinde bir yetki ve güç verdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960725
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960725,
					"content": "Çariçe... Onu beş yüz yıldır görmedim. Ne düşünüyor? Planı ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960726
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960726,
					"content": "Yanıt ne olursa olsun içimde bunun sadece Yedileri aramanı daha da zorlaştıracağına dair bir his var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960701
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960727,
					"content": "Tanrılar hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960728
					]
				},
				{
					"id": 3960728,
					"content": "Daha önce söylediğim gibi Önsezi sahipleri, Köken Tanrıları olarak bilinir ve Kutsal Diyar'a yükselebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960729
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960729,
					"content": "Bir Gnosis, element kullanımının daha üst düzey bir bağlantı noktasıdır ve Yedilerden biri olarak bir hükümdarın statü sembolüdür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960730
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960730,
					"content": "#Ama Yedilerden hangisinin {F#erkek kardeşini}{M#kız kardeşini} aldığı konusuna gelince... Ne yazık ki bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960731
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960731,
					"content": "... Bekle, Yedilerden biri olarak ben de henüz şüphelerden arınmış değilim, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960732,
						3960734
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960732,
					"content": "O tanrıya hiç benzemiyorsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960733
					]
				},
				{
					"id": 3960733,
					"content": "Biraz bekleyin! Detone Ozan'ın Barbatos'un vücut bulmuş hallerinden biri olmadığı ne malum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960734,
					"content": "Sana güvenecek kadar uzun süredir seni tanıyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960735
					]
				},
				{
					"id": 3960735,
					"content": "#Haha, gerçekten harika bir takımız! Diyelim ki {F#erkek kardeşin}{M#kız kardeşin} bulundu, yeni Dört Rüzgardan biri olmak ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960736
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960736,
					"content": "Olabilir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960737
					]
				},
				{
					"id": 3960737,
					"content": "#Hımm, buna çok istekli değil gibisin {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960738
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960738,
					"content": "Hey, Detone Ozan... Dört Rüzgardan biri olmak, bedava yiyecek anlamına geliyorsa Paimon'u düşünebilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960739
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3960739,
					"content": "Ha ha ha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960701
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3960741,
					"content": "Başka bir şey yok...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960742
					]
				},
				{
					"id": 3960742,
					"content": "O zaman en iyisi <color=#00E1FFFF>Liyue'ye</color> doğru gitmek. Zuhur Ayinini kaçırırsan bir yıl daha beklersin o zaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		}
	]
