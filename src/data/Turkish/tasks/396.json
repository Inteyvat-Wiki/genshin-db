			"dialogs": [
				{
					"id": 3960001,
					"content": "Sana saldıranlar Fatui miydi? Bu çok fazla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960002
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960002,
					"content": "Kumandan Jean çoktan Şövalyelerin Karargahına geri döndü. Kanıt arayacağını söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960003
					],
					"speakerTitle": "Barbara"
				},
				{
					"id": 3960003,
					"content": "Ama arkada hiç iz kalmadıysa Şövalyelerin suçlulara karşı şikayette bulunmasının zor olabileceğini de söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Barbara"
				}
			]
		},
		{
			"id": 39602,
			"completionStepIds": [
				39602
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
