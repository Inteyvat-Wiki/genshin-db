					"nextDialogs": [
						230135205
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135205,
					"content": "İşte ücretin Gezgin. Yardımın için çok teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135206
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135206,
					"content": "İstediğin zaman tekrar uğrayabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135207
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135207,
					"content": "Bay Garcia'nın akıl sağlığı çok bozulursa, belki yardımına ihtiyacım olabilir.",
