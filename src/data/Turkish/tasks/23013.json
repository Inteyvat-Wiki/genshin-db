			"dialogs": [
				{
					"id": 230130201,
					"content": "Lutong, Moramız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130202
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130202,
					"content": "Bir yolunu buluruz Bay Garcia.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130203
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130203,
					"content": "Liyue'de eski bir söz vardır: \"Yoluna bir dağ çıktıysa onu aşmanı sağlayacak bir yol da çıkar.\" Sanırım bu söz tam olarak şu an yaşadığımız durumu anlatıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130204
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130204,
					"content": "Yani eğer önümüzde bir dağ varsa, o dağı aşmanın bir yolunu mutlaka buluruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130205
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130205,
					"content": "İşte bu! Zekice bir benzetme. O halde sanırım içinde bulunduğumuz durum o kadar da kötü değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130206
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130206,
					"content": "Bay Garcia, sizce bu cümleyi yazan ilk kişi gerçekten dağı aşmasını sağlayacak bir yol bulabilmiş midir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130207
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130207,
					"content": "Lutong, hadi ama, şom ağzını açma şimdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
		},
