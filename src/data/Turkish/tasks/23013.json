						230135104
					]
				},
				{
					"id": 230135104,
					"content": "Haklısın, durum Kaia Hanım ile ilgili. Bay Garcia bu konuda konuşmasa da iş yerinde dikkati giderek daha fazla dağılmaya başladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135105
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135105,
					"content": "O kafeye de bir daha hiç gitmedi. Canı bir şey çektiğinde artık benden almamı istiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135106
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135106,
					"content": "Bay Ahangar, gerekirse Bay Garcia ile konuşabileceğini söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135107
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135107,
					"content": "Bay Garcia nasıl düzelecek bilmiyorum. Bu tür bir durumla daha önce hiç karşılaşmadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
