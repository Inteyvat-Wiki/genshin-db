			"dialogs": [
				{
					"id": 230135001,
					"content": "Efendim, aradığımız yer burası olabilir. Şimdi birilerini bulup onları beraberimizde götürmeliyiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135002
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135002,
					"content": "Efendim? Bay Garcia, beni duyuyor musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135003
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230135003,
					"content": "Ne? Ha... Elbette duydum. Dönüp birini bulalım, çok uzun sürmez zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135004
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135004,
					"content": "Her... Her şey yolunda mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230135005
					]
				},
				{
					"id": 230135005,
					"content": "Gezgin, haha... Bir sorun yok. Ben iyiyim. Sorunum varmış gibi mi görünüyorum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135006
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135006,
					"content": "Numaralandırma Makinası üzerindeki araştırmaya artık tamamen odaklanabilirim. Başarının yalnızca bir adım uzakta olduğunu hissedebiliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135007
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135007,
					"content": "Yardım etmek istersen, lütfen benim için Bodurlop Özü bulabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135008
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135008,
					"content": "Sen burada olduğuna göre, birilerini bulmak için şehre dönmeme gerek yok. Biraz da para kazandığımdan, sana daha iyi bir ücret ödeyebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230135009,
						230135010
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135009,
					"content": "Tabii.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230135011
					]
				},
				{
					"id": 230135011,
					"content": "Bu kısmı sana bırakıyorum Gezgin. Bana gelince, mekanizmanın yapısını nasıl değiştireceğimi düşünmem lazım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230135010,
					"content": "Bana uyar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230135011
					]
				}
			]
		},
