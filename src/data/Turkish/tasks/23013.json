			},
			"dialogs": [
				{
					"id": 230131101,
					"content": "Bay Garcia, tüm samimiyetimle bir kez daha söylüyorum, Mora için birkaç kitap satmalıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131102
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230131102,
					"content": "Hayır! Hayatta olmaz! Lutong, canım, sen resmen ruhumu satmamı istiyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131103
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131103,
					"content": "Ama efendim, kimse ruhlar için ödeme yapmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131104,
						230131105
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230131104,
					"content": "Neden hâlâ buradasınız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230131106
					]
				},
				{
					"id": 230131106,
					"content": "Gezgin? Seni buraya hangi rüzgar attı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131107
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131107,
					"content": "Şey... Son deneyim başarısızlıkla sonuçlandı. Bodurlop Özünü seyreltirken yanlış bir şey yapıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131108
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131108,
					"content": "Yağın Numaralandırma Makinasındaki parçaları kaygan hale getirmesi gerekiyordu ama bunun yerine parçaların sıkışma ihtimalini artırdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131109
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131109,
					"content": "Bu yüzden deneylere devam edebilmek için daha fazla Bodurlop Özüne ihtiyacım var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131110,
						230131111
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131110,
					"content": "Bana bırak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230131120
					]
				},
				{
					"id": 230131120,
					"content": "Gezgin, lütfen Bodurlop Özü toplamamıza yardım et. Ben ödemeni hazırlayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230131111,
					"content": "Mora kazanmanızın bir yolu yok mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230131112
					]
				},
				{
					"id": 230131112,
					"content": "Moramız yok değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131113
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131113,
					"content": "Bu kabiliyet meselesi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131114
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230131114,
					"content": "Çok teşekkürler sevgili Lutong. Yerinde bir açıklama yaptın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131115
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131115,
					"content": "Bu gerçekten utanç verici... Numaralandırma Makinasını tamamladım ama makinanın işleyişi gerçekten hiç iç açıcı değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131116
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131116,
					"content": "Hesaplamayı kendisi tam olarak yapamıyor bile. Bu işlemi yapabilmesi için birinin desteğine ihtiyaç duyuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131117
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131117,
					"content": "Ama ben bu makinayı geliştireceğim! Numaralandırma Makinamın büyük bir buluş olacağından eminim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131118
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131118,
					"content": "Bu icat yeni bir çağın habercisi olacak! Sonra da Mora kazanmanın bir yolunu bulacağımdan eminim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131119
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131119,
					"content": "G-Gerçi ilk önce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230131120
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230131105,
					"content": "Daha fazla Bodurlop Özüne mi ihtiyacın var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230131106
					]
				}
			]
		},
