			},
			"dialogs": [
				{
					"id": 230130301,
					"content": "Gezgin, Bodurlop Özü bulabildin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130302
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130302,
					"content": "Buldum, burada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230130303
					]
				},
				{
					"id": 230130303,
					"content": "Harika! Bu yeterli olur. Döndüğümde deneylerime devam edeceğim. Bunu yağ olarak kullandığım takdirde Numaralandırma Makinam kesinlikle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130304
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130304,
					"content": "Şimdi araştırmama dönmem gerek. Lutong, lütfen kalan işlerle ilgilen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130305
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230130305,
					"content": "Emredersiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130306
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130306,
					"content": "İşte ücretin Gezgin. Yardım ettiğin için çok teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130307
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130307,
					"content": "Şey, bir de... Bence ileride yardımına ihtiyaç duyabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130308
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130308,
					"content": "Yine de için rahat olsun. Muhasebeden ben sorumlu olduğum sürece hak ettiğin ödemeyi alacaksın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130309
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130309,
					"content": "*iç çeker* Açıkçası benim Bay Garcia'yla gelmemin nedeni tüm hayatımı ebeveynlerimin yaptığı gibi Sivil İşler Bakanlığının bir departmanında çalışarak ve hesap kitap yaparak geçirmek istememem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130310
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130310,
					"content": "Oysa şimdi Bay Garcia'ya hesaplamalarında yardımcı olmanın yanı sıra bir de ona hesap kitap işlerinde yardımcı olmam gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230130311
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230130311,
					"content": "Kader dedikleri şey bu olsa gerek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				}
			]
		},
