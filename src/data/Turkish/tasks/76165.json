				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Patolichev"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761650201,
					"content": "Ah, selamlar. Ben Patolichev, Işık Muhafızlarının levazım subayıyım. Size nasıl yardımcı olabilirim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650202
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650202,
					"content": "Sen Donuk Fırtına Küheylanlarından Patolichev misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650203
					]
				},
				{
					"id": 761650203,
					"content": "Donuk Fırtına Küheylanları... Haa, daha önce gördüğümüz o tuhaf gölgeleri kastediyorsun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761650204,
					"content": "Evet, eskiden o birlikte görev yapıyordum. Donuk Fırtına Küheylanları... Bu ismi duymayalı çok uzun zaman oldu. Başka birinin ağzından duyacağımı hiç düşünmemiştim... Nereden bildiğinizi sorabilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650205,
						761650208
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650205,
					"content": "Kipumaki Uçurumu'nun eteğine gitmiştik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650206
					]
				},
				{
					"id": 761650206,
					"content": "Evet! Orada sorun çıkaran Vahşi Avı hallettik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761650207,
					"content": "Donuk Fırtına Küheylanlarının Ratniklerini bile gördük... Vahşi Ava karşı verdikleri savaştan kalan gölgeleri hâlâ orada duruyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761650210,
					"content": "Bunun gerçek olduğuna inanmıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650211
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650211,
					"content": "Tabii ki gerçekti! Kendi gözlerimizle gördük!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761650212,
					"content": "Ah... Yıllar içinde insanlar bana zaman zaman Kipumaki Uçurumu'nda şehit yoldaşlarımın silüetlerini gördüklerini söylediler. Bu yüzden hâlâ sık sık oraya giderim... Gitmişken de mezarlarıyla ilgilenirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650213
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650213,
					"content": "Ama bir kez bile... Bir kez bile onları kendim görmedim. O kadar uzun zaman geçti ki... Bu hikayelerin sadece beni teselli etmek için söylenen beyaz yalanlar olduğunu düşünmüştüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650214
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650214,
					"content": "Ama siz gerçekten onları görmüşsünüz... Neden ben gittiğimde kendilerini bana hiç göstermiyorlar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650215,
						761650217
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650215,
					"content": "Belki de... Henüz zamanı gelmemiştir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650216
					]
				},
				{
					"id": 761650216,
					"content": "Belki de... Yine de, sadece uçup giden gölgeler ya da anılardan ibaret olsalar bile, onların gerçekten orada olduğunu bilmek benim için yeterli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650219
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650219,
					"content": "#Her neyse, anlattığınız için teşekkür ederim {M#beyefendi}{F#hanımefendi}. Benim için bunun anlamı büyük.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650220
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650220,
					"content": "Bugün hâlâ burada olmayı onlara borçluyum. Ama yine de... Keşke bir kez daha Kipumaki Uçurumu'nun eteğinde onlarla omuz omuza savaşabilseydim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650221
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650221,
					"content": "Bir gün... Bir gün onlarla tekrar karşılaşacağıma eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650217,
					"content": "Belki de sana o acıyı hatırlamak istemiyorlardır...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650218
					]
				},
				{
					"id": 761650218,
					"content": "*iç çeker* Acı mı? Hayır... Son günlerde onlarla yan yana, sonuna kadar birlikte savaşmak... Bu nasıl acı verici olabilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650219
					],
					"speakerTitle": "Patolichev"
				},
				{
					"id": 761650208,
					"content": "Donuk Fırtına Küheylanlarının Ratniklerini gördük...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650209
					]
				},
				{
					"id": 761650209,
					"content": "Evet... Sadece gölgeleri kalsa bile, bu gölgeler hâlâ onları Vahşi Avla savaşırken gösteriyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650210
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}