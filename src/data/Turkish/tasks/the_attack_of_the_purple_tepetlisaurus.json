				{
					"id": 751790402,
					"content": "Yolda neler olduğunu görmedin mi yoksa? Bir yanardağ patlaması oldu ve yol canavarlar tarafından kapatılmış durumda. Daha ileri gitmemelisin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790403
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790403,
					"content": "Beni dinle. Burada biraz bekle. Birazdan kervanımızın geri kalanıyla birlikte yola çıkabilirsin, böylece birbirimizi korumuş oluruz. Tek başına gitmek çok tehlikeli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790404,
						751790408
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790404,
					"content": "Canavarlar mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790405
					]
				},
				{
					"id": 751790405,
					"content": "Evet, bildiğin mor Tepetlizor sürüsü! Belli ki Hiçlik tarafından yozlaştırılmışlar! İnanılmaz derecede vahşiler. Daha önce hiç bu kadar ürkütücü olanlarını görmemiştim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790406
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790406,
					"content": "Şöyle anlatayım, o yaratıklar kuyruklarını sallayıp arabalarımızı darmadağın ettiler. Tatankazorlardan bile daha güçlüler, herkesin baş edebileceği türden düşmanlar değiller kesinlikle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790407
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790407,
					"content": "Ciddiyim, sakın gaza gelip onlarla savaşmaya kalkma. Gördüğünde hemen yolunu değiştir, anlaştık mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790408,
					"content": "Merak etme, bir şey olmaz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790409
					]
				},
				{
					"id": 751790409,
					"content": "Sen... *iç çeker* Pekala, kendine dikkat et yeter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tizlo"
				}
			]
		},
