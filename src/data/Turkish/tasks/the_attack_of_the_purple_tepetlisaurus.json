				]
			},
			"dialogs": [
				{
					"id": 751790101,
					"content": "Hey, sen! D-Dur! Bunlar bizim! Çek elini! Seni uyarıyorum...! B-Ben var ya ben, Gece Nöbeti Savaşlarına bile katılabilirim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790102
					],
					"speakerTitle": "Masose"
				},
				{
					"id": 751790102,
					"content": "Eşyalarımızı çalmaya kalkışırsan... Gösteririm sana ben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790103
					],
					"speakerTitle": "Masose"
				},
				{
					"id": 751790103,
					"content": "*iç çeker*... Bugün neler oluyor böyle? Önce yanardağ patlaması, sonra mor bir Tepetlizor... Şimdi de bir grup haydut mu? Ne şanssızlık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790104
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790104,
					"content": "Masose, dur. Epey güçlü görünüyor. Onunla başa çıkabileceğimizi sanmıyorum. Ayrıca buraya yarışmayı izlemeye geldik, bu kadar risk almanın anlamı yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790105
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790105,
					"content": "N-Nasıl böyle konuşursun Itsaho? Bunlar bizim eşyalarımız! Hem zaten ikiye biriz. Belki de bir şansımız olabilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790106
					],
					"speakerTitle": "Masose"
				},
				{
					"id": 751790106,
					"content": "\"İki\" de nereden çıktı? Dayak yiyecek biri varsa o da sensin. Beni karıştırma bu işe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790107
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790107,
					"content": "#Affedersiniz {M#beyefendi}{F#hanımefendi}, o eşyalara ihtiyacımız yok artık. Almak isterseniz buyurun sizin olsun. Yeter ki bize zarar vermeyin, olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790108,
						751790109
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790108,
					"content": "Ortada bir yanlış anlaşılma olmalı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790111
					]
				},
				{
					"id": 751790111,
					"content": "Her şeyi yanlış anladınız! Biz aslında yardımsever maceracılarız, kötü niyetli kimseler değiliz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751790112,
					"content": "Sana neden inanay... Ay! Niye vurdun bana Itsaho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790113
					],
					"speakerTitle": "Masose"
				},
				{
					"id": 751790113,
					"content": "Eğer kötü niyetli olsalardı çoktan yemiştin dayağı. Niye bizimle konuşarak vakit kaybetsinler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790114
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790114,
					"content": "Dürüst olmak gerekirse, kervanımız yakın zamanda dağıldı. Eğer çok zahmet olmayacaksa patronumuza bir mesaj iletmemize yardım eder misiniz? Sadece burada onu beklediğimizi söylemeniz yeterli, çok minnettar oluruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790115
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790115,
					"content": "Kutudaki eşyaları alabilirsiniz, minnettarlığımızın bir göstergesi olarak görün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790116
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790116,
					"content": "Orası kolay. Tamamdır, bu iş bizde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751790109,
					"content": "Hımm, tam bir zeka küpüsün, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790110
					]
				},
				{
					"id": 751790110,
					"content": "Hey! Sanki suçlu bizmişiz gibi konuşma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790111
					],
					"speakerTitle": "Paimon"
				}
			]
		},
