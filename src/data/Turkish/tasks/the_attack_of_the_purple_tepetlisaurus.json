			"dialogs": [
				{
					"id": 751790301,
					"content": "Gerçi hayatımı kurtarmanın karşılığında böyle küçük bir hediye vermek biraz pintice oldu, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790302,
						751790303
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790302,
					"content": "Evet, kesinlikle yetersiz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790304
					]
				},
				{
					"id": 751790304,
					"content": "Haha, öyle olsun bakalım! Senin gibi insanları seviyorum, için dışın bir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790306
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790306,
					"content": "Hımm, her neyse, bu sana benden şahsi bir armağan. Alıver işte! Minik Tepetlizorun karnını doyurması için küçük bir katkı say. Teşekküre veya tantanaya lüzum yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790307
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790307,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790308
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751790308,
					"content": "Tamamdır, daha yolda düşürdüğümüz eşyaları toplamamız lazım. O yüzden biz çıkıyoruz! Umarım tekrar görüşürüz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790303,
					"content": "Hayır, bu kadarı yeter de artar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790305
					]
				},
				{
					"id": 751790305,
					"content": "Cık cık, hiç açık sözlü değilsin. Böyle işin eğlencesi kalmaz. Al gitsin işte! Dedikodusu çıkarsa insanlar beni cimri diye yaftalar yoksa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790306
					],
					"speakerTitle": "Itzayah"
				}
			]
		},
