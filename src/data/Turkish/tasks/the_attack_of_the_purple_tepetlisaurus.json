				{
					"id": 751790901,
					"content": "Eyvah... Itsaho, listede daha bir sürü şey eksik... Ş-Şunları bulmama yardım eder misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790902
					],
					"speakerTitle": "Masose"
				},
				{
					"id": 751790902,
					"content": "*iç çeker*... Vaktini boşa harcama. Ben zaten baktım. Çoğu kırılacak eşyalardı. Patlama ve çarpışmadan sonra sağlam kaldıklarını mı sanıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790903
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790903,
					"content": "Enerjini sakla ve biraz dinlen. Patron ve diğerleri gelince daha çok yol gideceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790904
					],
					"speakerTitle": "Itsaho"
				},
				{
					"id": 751790904,
					"content": "Yok, hayır! P-Peki, eğer sen istemiyorsan ben kendim giderim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Masose"
				}
