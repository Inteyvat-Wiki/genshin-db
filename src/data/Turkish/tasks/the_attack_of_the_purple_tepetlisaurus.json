			"dialogs": [
				{
					"id": 751791101,
					"content": "Ne halt edeceğim şimdi ben? Patron geri dönünce beni kesin benzetecek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791102,
						751791106
					],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791102,
					"content": "Neden ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751791103
					]
				},
				{
					"id": 751791103,
					"content": "*iç çeker*... Uzun hikaye... Kervanımız güzelce ilerliyordu ki birdenbire yanardağ patladı. Sonra, yerden kocaman mor Tepetlizorlar çıktı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791104
					],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791104,
					"content": "Dikkatim dağılmıştı ve Sürüngen yoldaşım tırsıp beni gruptan uzaklaştırdı. Geri döndüğümüzde yol tamamen kapanmıştı, şimdi diğerlerinin yanına dönemiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791105
					],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791105,
					"content": "Diğerlerinin ne durumda olduğunu bile bilmiyorum... Üstelik gruptan izinsiz ayrıldım... Patron beni gebertecek. İşim bitti, öldüm ben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791106,
					"content": "Ben olsam kaçardım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751791107
					]
				},
				{
					"id": 751791107,
					"content": "Kaçmak mı? Hayır, hayır, imkansız. Patron, Gece Krallığı gibi her zaman her yerdedir. Nereye gidersem gideyim beni bulup geri getirir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751791108
					],
					"speakerTitle": "Cuchihua"
				},
				{
					"id": 751791108,
					"content": "Gidip özür dilemem gerekiyor ama nasıl? Yol kapalı... Of, bu sefer ayvayı yedim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cuchihua"
				}
			]
