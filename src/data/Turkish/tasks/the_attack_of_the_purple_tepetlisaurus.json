			"dialogs": [
				{
					"id": 751790701,
					"content": "Demek ki sağ salim kurtulmanı bu üçüne borçlusun, öyle mi patron?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790702
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790702,
					"content": "Haha, aynen öyle! Onları görmeliydin, birkaç hamlede tüm canavarları yere serdiler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790703
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790703,
					"content": "Liderimizi kurtardınız. Bunun karşılığını nasıl öderim bilemiyorum. Lütfen minnetimin bir nişanesi olarak bu küçük hediyeyi kabul edin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790704
					],
					"speakerTitle": "Tizlo"
				},
				{
					"id": 751790704,
					"content": "Gerçekten mi Tizlo? Sen hep böyle pinti miydin? Hayatını kurtaranlara vereceğin hediye bu mu yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Itzayah"
				}
