					"nextDialogs": [
						751790203
					]
				},
				{
					"id": 751790203,
					"content": "B-Bir şeyim yok, sadece az önce koştuğum için biraz soluklanmam gerekiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zashari"
				},
				{
					"id": 751790204,
					"content": "Dinlenmeye ihtiyacın var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790205
					]
				},
				{
					"id": 751790205,
					"content": "İ-İlgin için teşekkürler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zashari"
				}
