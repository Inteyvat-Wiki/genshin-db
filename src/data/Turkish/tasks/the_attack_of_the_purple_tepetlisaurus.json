			"dialogs": [
				{
					"id": 751790601,
					"content": "Of... Ne uğraştırdı ama. Az kalsın Tepetlizorlar beni yere serecekti... Sinirlerim tepeme çıktı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790602
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790602,
					"content": "Sen olayı yanlış anlamışsın, onlar Hiçlik Canavarları! Tepetlizorlardan katbekat tehlikeliler. Onları normal Sürüngen sandın demek... Neden bu kadar zorlandığın şimdi anlaşılıyor!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790603
					]
				},
				{
					"id": 751790603,
					"content": "Hah, ondan mıydı yani? Şimdi dank etti. Bu sefer size çok şey borçluyum. Siz olmasaydınız bitmiştim ben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790604
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790604,
					"content": "Bir dakika, önce şu işe yaramaz sersemleri bir bulayım. Hepsinin güvende olduğundan emin olduktan sonra size adamakıllı teşekkür edeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790605
					],
					"speakerTitle": "Itzayah"
				},
				{
					"id": 751790605,
					"content": "Senin de yardımınla kervandaki insanlar yavaş yavaş toplanır.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
