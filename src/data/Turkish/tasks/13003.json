			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130030101,
					"content": "Neyse, kısacası kirlenmiş bölge aslında ormanın derinliklerindeki Ley Hattı sızıntısıymış. Artık her şey normale dönüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030102,
					"content": "Anlıyorum. Çabalarınız için teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030103
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 130030103,
					"content": "Havadaki fazla Ley Hattı enerjisi dağıldığında bölge sakinlerinin normal hayatlarına devam edebileceklerini bildiren bir duyuru yapabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 130030104,
					"content": "Bu da söz verdiğimiz ödül. Lütfen kabul edin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 130030105,
					"content": "Maceracılar Loncasından çıktıktan sonra Paimon seni sessiz bir yere götürüyor...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130030106
					]
				},
				{
					"id": 130030106,
					"content": "Karkata... Akademiye geri mi gönderilecek?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030107,
					"content": "Zaten hasarlı ama Paimon onun parçalarına ayrılacağını düşündükçe üzülüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030108,
					"content": "Ben de üzülüyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130030109
					]
				},
				{
					"id": 130030109,
					"content": "Öyle mi? O zaman neden yarın Tighnari'ye gidip ona bunu yapmamasını söylemiyoruz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030110,
					"content": "Paimon hemen gitmeyi çok istiyor ama Tighnari \"meseleleri yarın tartışırız\" demişti. Şimdi gidersek muhtemelen onu kızdırırız, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030111,
					"content": "Muhtemelen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130030112
					]
				},
				{
					"id": 130030112,
					"content": "Tamam o zaman! Yarın Tighnari'nin yanına gidip Karkata'yı parçalarına ayırmamasını söyleyelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1300303,
			"completionStepIds": [
				1300303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1300303",
							"2"
						],
						"stepId": 1300303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tighnari",
					"Karkata"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130030301,
					"content": "Tighnari...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030302,
					"content": "Şşş, sessiz olun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030303
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030303,
					"content": "Sıyırcıkgiller familyasına ait olan Leylak Defne, kas kasılmalarına karşı son derece etkilidir. Anestezik toz yapımında da kullanılabilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030304
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030304,
					"content": "Bu iki veriye göre bilhassa balık türlerine karşı etkili olacaktır... Bunların hepsini not al.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030305
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030305,
					"content": "Kolu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030306
					],
					"speakerTitle": "Karkata"
				},
				{
					"id": 130030306,
					"content": "Karkata!?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030307,
					"content": "Kalu! Kalu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030308
					],
					"speakerTitle": "Karkata"
				},
				{
					"id": 130030308,
					"content": "Size sessiz olun demiştim. Bitkiler sesten korkmaz ama siz bağırdıkça kulaklarım çınlıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030309
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030309,
					"content": "Karkata'yı parçalarına ayırmadın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030310,
					"content": "Bunu neden yapayım ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030311
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030311,
					"content": "Ama Paimon'un hatırladığına göre demiştin ki \"Akademinin kurallarına göre\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030312,
					"content": "Demek ikiniz o yüzden bu saatte gelip barbarlar gibi içeri daldınız. Pekala, sanırım dün bu meseleyi açıklığa kavuşturamadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030313
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030313,
					"content": "Demek istediğim Akademinin kurallarına göre tüm araştırma ürünlerinin yok edilmesi gerektiğiydi. İşte bu nedenle Akademinin orayı öğrenmesine izin veremeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030314
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030314,
					"content": "Yani orada kalmanın esas sebebi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130030315
					]
				},
				{
					"id": 130030315,
					"content": "Her neyse, ilk iş olarak Karkata'yı tamir ettim. Akademideki zamanlarımda Spantamad'da seçmeli bir ders almıştım. Günün birinde işime yarayacağı kimin aklına gelirdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030316
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030316,
					"content": "Daha sonra birlikte Abattouy'u gömdük. Araştırma malzemelerini düzenledikten sonra bazılarını hatıra olarak yanıma aldım, çoğunu da kanıtları silmek için yaktım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030317
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030317,
					"content": "Akademiden yana değilim. Kurallarından bana ne? Öte yandan Avidya Ormanı'nın Orman Gözcüsüyüm. Ormandaki tüm canlıları korumak benim görevim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030318
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030318,
					"content": "Bu dünyadaki her canlının bir anlamı var, Karkata da bunlardan biri. Şayet var olmuş ise öyle gelişigüzel bırakılıp yok edilemez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030319
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030319,
					"content": "Haha, bu harika!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030320,
					"content": "Kulilu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030321
					],
					"speakerTitle": "Karkata"
				},
				{
					"id": 130030321,
					"content": "Bir saniye, az önce \"yaşam formu\" dedin. Karkata'yı gerçekten yaşayan bir canlı olarak mı görüyorsun yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130030322,
					"content": "Bu sadece bir ihtimal. Karkata'nın Abattouy'u \"onarma\" çabalarını açıklamak oldukça güç.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030323
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030323,
					"content": "Abattouy, araştırmasının yalnızca küçük bir bölümünü geride bırakmış. Daha kaç komut daha yüklediğini kim bilebilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030324
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030324,
					"content": "Belki de tüm bu komutların birbiriyle çatışması bu tür davranışlara neden olmuştur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030325
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030325,
					"content": "Daha kesin konuşacak olursak Karkata'nın gerçek bir yaşam formu olduğu sonucuna varmak pek mümkün değil ama böyle bir ihtimal var. Ben de buna inanmak istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030326
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030326,
					"content": "Kolu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030327
					],
					"speakerTitle": "Karkata"
				},
				{
					"id": 130030327,
					"content": "Bu arada, bu denek üzerinde araştırmaya devam etmek istemiyorum. Sadece burada takılmasına izin veriyorum çünkü burası nispeten gözlerden uzak bir yer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030328
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030328,
					"content": "Yine de mevcut duruma bakılırsa onu araştırma asistanım yapmak fena fikir değil. En azından deneylerimi kaydedebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030329
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030329,
					"content": "Ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030330
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130030330,
					"content": "Kalu! Kalu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Karkata"
				}
			]
		},
