			},
			"dialogs": [
				{
					"id": 761760301,
					"content": "... Aria, Canon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760302
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760302,
					"content": "Bu yalnızca bir cezadan çok daha fazlasıydı. Hem bu ilk de değildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760303
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760303,
					"content": "Kralımızın bize emanet ettiği ejderhalar şehri olsun, şu ufacık insanların kurduğu o narin ama güzelim yuvalar olsun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760304
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760304,
					"content": "Öylece durup izlemeyi bırakmanız için daha kaç masum canın ölümüne şahit olmanız gerek?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760305
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760305,
					"content": "Kralımız burada olsaydı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760306
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760306,
					"content": "Artık burada değil Sonnet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760307
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760307,
					"content": "Eğer o sözde kudretli hükümdar bu ruhsuz ve korkunç kaderi \"düzen\" zannediyorsa, eğer sonu gelmiş bu dünyayı yutulup gitmekten kurtarmanın tek çaresi buysa, o zaman...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760308
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760308,
					"content": "Benden istenen bedel ne kadar ağır olursa olsun... Ve canımı ne kadar yakarsa yaksın, o zifiri karanlık sessizlikten bin kat iyidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760309
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760309,
					"content": "Dünya zaten yok olmaya mahkumsa... Karanlıkla savaşmanın ne anlamı var ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760310
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760310,
					"content": "... Sonnet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760311
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760311,
					"content": "Y-Yok bir şey Aria Abla! Bir şey demedim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760312
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760312,
					"content": "Bence o zalimin, bize inananları katletmesini öylece oturup izlememeliyiz... İster ejderhalar olsun, ister şu minicik insanlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760313
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760313,
					"content": "Onları... Kurtarmamız gerekmez mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760314
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760314,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760315
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760315,
					"content": "... Sonnet'in öfkesini anlayabiliyorum Aria. Bana kalırsa o hükümdarın yaptığı gerçekten çok acımasızcaydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760316
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760316,
					"content": "En ufak bir ihtimal bile olsa... Kurtarılabilecek kim varsa kurtarmak için elimden geleni yapmak istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760317
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760317,
					"content": "İyi de... Ya kurtaramayacaklarımız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760318
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760318,
					"content": "Kurtuluş yüzü göremeyen, yitip giden o canlar... Döktükleri kanları, gözyaşları ve acı dolu feryatları hiçbir iz bırakmadan silinip gidecek mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760319
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760319,
					"content": "Hayır... Böyle olmamalı. Tek dileğim herkesin kurtulması, kimsenin yitip gitmemesi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760320
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760320,
					"content": "Eğer \"düzeni\" de onunla beraber yok olup gidecekse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760321
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760321,
					"content": "... Sonnet. Var olma amacımızı sakın unutma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760322
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760322,
					"content": "Tek görevimiz, bize hayat veren Kralımız uzaklardan dönene kadar bu dünyayı korumak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760323
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760323,
					"content": "Bu düzenin bize neye mal olacağını başından beri biliyorduk... Lakin bu dünyanın göz göre göre yıkıma sürüklenmesine izin veremezdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760324
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761760324,
					"content": "... Hayır, aslında meselenin düzenle falan alakası yok Aria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760325
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760325,
					"content": "Sonnet, bizim için... Benim için sen biricik küçük kız kardeşimizsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760326
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760326,
					"content": "O yüzden... Lütfen Aria'yı ve beni üzecek bir şey yapma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760327
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760327,
					"content": "Bu ilahi düzene açıktan kafa tutma. En azından... Şimdi olmaz, dünya hâlâ bu kadar hassasken olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760328
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760328,
					"content": "Canon... Ben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760329
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761760329,
					"content": "Istaroth bana sadece insanların sahip olabileceği bir kelimeden bahsetti... \"Umut\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761760330
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761760330,
					"content": "Yaşadığımız sürece umut var... Umut her zaman olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canon"
				}
			]
		}
	]
}