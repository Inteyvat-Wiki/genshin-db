			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dori"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765060101,
					"content": "#Aa, şu gelen {NICKNAME} ile Paimon değil mi? Sizi burada görmek ne güzel, şansım dönüyor olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060102
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060102,
					"content": "Dori? Ne yapıyorsun burada tek başına? Dükkan mı açacaksın? Hımm, hiç ürün de getirmemişsin ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765060103,
					"content": "Ah, kusura bakmayın ama meşhur gezgin tüccar Dori bugün izinli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060104
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060104,
					"content": "Nod-Krailılara özenip bu cennette normal ve tasasız bir günün tadını çıkarmak istedim diyebiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060105
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060105,
					"content": "Cidden mi? Sen, Mora kazanmakla uğraşmıyorsun yani! Çölde bütün yıl yağmurlu geçti de dersin sen şimdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765060106,
					"content": "Hehe, merak etme. Ben ara versem dahi gayretli çalışanlarım gelirlerimizi sürekli olarak artırmaya devam ediyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060107
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060107,
					"content": "Rakamlar arttığı sürece endişelenecek hiçbir şey yok yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060108
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060108,
					"content": "Bu arada... Bir sıkıntınız mı var? Tatil yapıyor olabilirim ama iş fırsatı kapımı çalacak olursa geri de çevirmem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060109,
						765060110
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060109,
					"content": "Öylesine etrafa bakınıyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060111
					]
				},
				{
					"id": 765060111,
					"content": "Haa, Nod-Krai'ın eşsiz manzaralarını çekiyorsunuz demek. Öyleyse doğru kişiye geldiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060112
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060112,
					"content": "Burayı avucumun içi gibi bilirim. Tabii yerliler kadar iyi değil ama eğer tavsiyeye ihtiyacınız varsa yardımcı olabilirim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060113
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060113,
					"content": "Arkadaşlığımız hatırına size bizzat rehberlik edeceğim, hatta güzel bir dost indirimi de yapacağım. Öyleyse... Günlük beş yüz bin Moraya ne dersiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060114
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060114,
					"content": "Dori yine şaşırtmadı. Bir kere gözünü cebimizdeki Moraya dikmese olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765060115,
					"content": "Hayır hayır, bunu sadece sizin için yapıyorum sevgili müşterilerim! Nod-Krai'da güzel, harika ve unutulmaz bir vakit geçirebilmeniz için!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060116,
						765060117
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060116,
					"content": "Madem bize yardım etme konusunda bu kadar isteklisin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060118
					]
				},
				{
					"id": 765060118,
					"content": "Hımm... İlgi çekici bir fikir. Ancak çektiklerini para kazanmak amaçlı reklamlarda kullanamazsın, ona göre. İmaj haklarım paha biçilmezdir, haberin olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060119
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060119,
					"content": "Merak etme, eski dostlarımızın fotoğrafı elimizde olsun istiyoruz sadece. Hatıra amaçlı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765060120,
					"content": "#Tabii, tabii! {NICKNAME}, bizzat sen istediğin için bir istisna yapacağım. Sadece bir kare... Senden tek isteğim harika görünmemi sağla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765060121
					],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060121,
					"content": "Bir düşüneyim... Başlık olarak \"Dori, Lord Sangemah Bay Cennet Gibi Tatilde\" nasıl olur sence? Harika, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dori"
				},
				{
					"id": 765060117,
					"content": "Senin fotoğrafını çekebilir miyiz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060118
					]
				},
				{
					"id": 765060110,
					"content": "Bir yandan da fotoğraf çekmek için malzeme arıyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765060111
					]
				}
			]
		},
