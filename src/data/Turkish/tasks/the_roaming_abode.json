			},
			"dialogs": [
				{
					"id": 711051101,
					"content": "Başka bir şey yoksa ben artık gideyim. İstediğiniz gibi etrafı inceleyebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711051102
					],
					"speakerTitle": "Luo Amca"
				},
				{
					"id": 711051102,
					"content": "Gerçekten Xiangjun diye biri yok mu yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711051103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711051103,
					"content": "Etraftakilere de bir soracağım. Belki bir yanlışlık olmuştur. Belki birisi yaşadığı yeri unutmuştur falan, ne bileyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711051104
					],
					"speakerTitle": "Luo Amca"
				},
				{
					"id": 711051104,
					"content": "Neyse, o \"Adeptusun\" bitkileri sulamasına yardım ettiğiniz için teşekkürler size. Eminim kendisi de teşekkür mahiyetinde sizi koruyup kollayacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Luo Amca"
				}
			]
		}
	]
}