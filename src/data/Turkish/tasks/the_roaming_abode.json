			"dialogs": [
				{
					"id": 711050101,
					"content": "Dede...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050102
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050102,
					"content": "Selam ufaklık, gece vakti burada ne yapıyorsun böyle? Adın ne bakalım senin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050103,
					"content": "Adım Xiangjun... Dedemi arıyorum... İblisler kaçırdı onu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050104
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050104,
					"content": "İ-İblisler mi? Burada mı? Ne tür iblisler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050105,
					"content": "Ben... Ben de bilmiyorum ki... Dedem dağlarda olduklarını söylemişti, tek başıma oralarda dolaşmamı istemezdi. Şimdi bakın, üç gün oldu ve dedem hâlâ dağdan dönmedi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050106
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050106,
					"content": "Seni korkutmaya çalışıyor olmasın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050107
					]
				},
				{
					"id": 711050107,
					"content": "Paimon da öyle düşünüyor... Dağda ne yaptığını söyledi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050108,
					"content": "Dedem köyün otacısıdır. Kısa süre önce kutsal bir bitki buldu. Söylendiğine göre yalnızca Xuanlian Dağı'nın yakınlarındaki kutsanmış suyla sulanınca büyüyen bir bitkiymiş bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050109
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050109,
					"content": "Şey... Suyu koruyan bir iblis çıkmış olabilir mi karşısına?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050110
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050110,
					"content": "Sen içini rahat tut Xiangjun. Yolda ufak bir aksilik gelmiştir başına, o yüzden geç kalmıştır. Saat de iyice geç olmaya başladı, önce seni eve götürsek olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050111,
					"content": "Onu kurtarmadan gitmem ben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050112
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050112,
					"content": "Sana yardım edelim o zaman.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050113
					]
				},
				{
					"id": 711050113,
					"content": "Gerçekten mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050114
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050114,
					"content": "Elbette! Sen şimdilik evine dön ama. Gitmezsen dedenin başına bir dert daha açmış olursun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050115,
					"content": "Ha... Öyle olsun istemem tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050116
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050116,
					"content": "O zaman sen evde kal, biz de gidip onu arayalım. Önce seni sağ salim eve götürmemiz lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050117,
					"content": "Zahmet etmeyin. Qiaoying Köyü'nde yaşıyorum ben. Kendim dönebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050118
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050118,
					"content": "Ama şey... Dedemi hemen gidip arayabilir misiniz? İçim bir türlü rahat etmiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050119
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050119,
					"content": "Merak etme, biz halledeceğiz o işi. Yine de hazır buradayken soralım sana... Dedenin tam olarak nereye gittiğini biliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050120,
					"content": "Sadece şu yöne doğru gittiğini biliyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050121
					],
					"speakerTitle": "???"
				},
				{
					"id": 711050121,
					"content": "O halde oradan aramaya başlarız biz de.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050122
					]
				},
				{
					"id": 711050122,
					"content": "Çok teşekkür ederim! Ben artık geri döneyim de başınıza daha fazla dert açmayayım... Sizi orada bekleyeceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				}
			]
		},
		{
			"id": 7110502,
			"completionStepIds": [
				7110502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7110502",
