						],
						"pointId": 311400096
					}
				]
			},
			"dialogs": [
				{
					"id": 711050601,
					"content": "Hımm... Bahsettiği yer burası galiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050602,
					"content": "Neden ortalıkta kimse yok? Bir iz falan da bırakmamış ki takip edelim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050603,
					"content": "Çoktan geri dönmüş olmasın bu adam?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050604
					]
				},
				{
					"id": 711050604,
					"content": "Paimon'a sorarsan hayır... Yaralanmış sonuçta. O kadar uzağa nasıl yürüsün?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050605,
					"content": "İyi ama burada da değil ki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050606
					]
				},
				{
					"id": 711050606,
					"content": "Yolda karşılaştığı biri onu kurtarmış olabilir mi? Belki çoktan dönmüştür bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050607,
					"content": "Qiaoying Köyü'ne geri dönüp etrafa bir sorsak mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050608,
					"content": "Önce şu \"kutsanmış sudan\" biraz alalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050609
					]
				},
				{
					"id": 711050609,
					"content": "Ne? Ha, doğru ya. Xiangjun'un dedesi kurtulduysa bu suya ihtiyacı olur kesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050610,
					"content": "#Krizi nasıl da fırsata çeviriyorsun ama... Pek düşünceliymişsin {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7110508,
			"completionStepIds": [
				7110508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7110508",
							"2"
						],
						"stepId": 7110508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Luo Amca"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711050801,
					"content": "Aa, merhaba Gezgin. Hayırdır, iki ayağın bir pabuca girmiş sanki. Bir sorun mu var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050802
					],
					"speakerTitle": "Luo Amca"
				},
				{
					"id": 711050802,
					"content": "Şey... Xiangjun ile dedesinin nerede yaşadığını biliyor musun Luo Amca? Onları arıyoruz da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050803,
					"content": "Xiangjun mu? İlk kez duyuyorum bu ismi. Buralı mıymış? Köydeki herkesi tanırım halbuki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050804
					],
					"speakerTitle": "Luo Amca"
				},
				{
					"id": 711050804,
					"content": "Öyle mi? Bu nasıl olur? Dışarıda adının Xiangjun olduğunu söyleyen küçük bir kızla karşılaştık, Qiaoying Köyü'nde yaşadığını söyledi bize. Sonra da dedesini bulmamızı rica etti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050805,
					"content": "Yanında büyük, bambudan bir sal da vardı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050806,
					"content": "O bambu sallardan etrafta dolu var zaten de... Köyümüzde Xiangjun isimli biri olmadığından adım gibi eminim. Dedesi kimmiş, neyin nesiymiş?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050807
					],
					"speakerTitle": "Luo Amca"
				},
				{
					"id": 711050807,
					"content": "Otacıymış.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050808
					]
				},
				{
					"id": 711050808,
					"content": "Otacı mı? Bir düşüneyim. Bir otacımız vardı, evet... Vefat edeli yıllar oldu tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050809
					],
					"speakerTitle": "Luo Amca"
				},
				{
					"id": 711050809,
					"content": "Ne? Vefat mı etti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050810,
					"content": "Evet. Vahşi doğada canavarlarla burun buruna gelmiş, sonrası malum... *iç çeker* Aradığınız kişi o değildir herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050811
					],
					"speakerTitle": "Luo Amca"
				},
				{
					"id": 711050811,
					"content": "Kendisi kafadan çatlaktı biraz. Bırakın torun sahibi olmayı, hiç evlenmedi bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050812
					],
					"speakerTitle": "Luo Amca"
				},
				{
					"id": 711050812,
					"content": "Bir dakika ya... Neler dönüyor burada? O zaman tanıştığımız şu Xiangjun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050813,
					"content": "... Asıl iblis Xiangjun olmasın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050814,
					"content": "Otacınız ne tür otlar toplardı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050815
					]
				},
				{
					"id": 711050815,
					"content": "Çiçek, çimen falan filan işte. Hiçbirini biz de bilmiyoruz ki. Ben bir tek çaydan biraz anlarım, bu konuda size pek faydam dokunmaz yani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050816
					],
					"speakerTitle": "Luo Amca"
				},
				{
					"id": 711050816,
					"content": "Onu Xuanlian Dağı'nın yakınlarında bulduğumuzu hatırlıyorum sadece. Elinde bir şişe su vardı, sıkı sıkı kavramıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050817
					],
					"speakerTitle": "Luo Amca"
				},
				{
					"id": 711050817,
					"content": "Bahçesinde kutsal bir bitki olduğundan, büyümesi için kutsanmış su gerektiğinden bahsediyordu. Bana sorarsanız saçmalığın daniskası tabii. Alt tarafı nehir suyu işte, kutsanma olayı falan hikaye! Böyle bir şey için neden canını tehlikeye atar ki insan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050818
					],
					"speakerTitle": "Luo Amca"
				},
				{
					"id": 711050818,
					"content": "*iç çeker* Yine de onu gömdükten sonra suyu bahçesine döktük. Umarım biraz teselli olmuştur ona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050819
					],
					"speakerTitle": "Luo Amca"
				},
				{
					"id": 711050819,
					"content": "Xuanlian Dağı'nın kutsanmış suyunu mu döktünüz? Biz de dağa gidip o sudan biraz almıştık. Peki sizin bu otacı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050820
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050820,
					"content": "Sanırım aynı kişiden bahsediyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711050821
					]
				},
				{
					"id": 711050821,
					"content": "Acayip bir durummuş cidden, doğruya doğru... E hadi gelin benimle madem. Sizi otacının bahçesine götüreyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050822
					],
					"speakerTitle": "Luo Amca"
				},
				{
					"id": 711050822,
					"content": "Madem dağdan su aldınız, bahçesine dökün bari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Luo Amca"
				}
			]
		},
