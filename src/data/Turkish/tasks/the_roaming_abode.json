					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711050201,
					"content": "\"Oturduğum yerde uyuyakalmışım! Bugün içinde geri dönmem lazım, yoksa Xiangjun tek başına kalacak... Off, benim şu budala kafam yok mu!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050202
					],
					"speakerTitle": "Birinin Notları"
				},
				{
					"id": 711050202,
					"content": "\"Yanlış hatırlamıyorsam kestirme bir yol olacaktı... Yaodie Vadisi'nden Xuanlian Dağı'na giden küçük bir patika vardı sanki. O yoldan gidip dağdaki mağaradan geçtim mi tamamdır...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050203
					],
					"speakerTitle": "Birinin Notları"
				},
				{
					"id": 711050203,
					"content": "\"Canavarların buralarda kol gezdiğini duymuştum ama şansımı deneyeceğim artık mecburen...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050204
					],
					"speakerTitle": "Birinin Notları"
				},
				{
					"id": 711050204,
					"content": "Bunu Xiangjun'un dedesi bırakmış olmalı. Yazdığına göre kestirmeden gitmeye karar vermiş. Hadi gidip şu patikayı bulalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7110505,
			"completionStepIds": [
				7110505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7110505",
							"2"
						],
						"stepId": 7110505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711050501,
					"content": "\"Başından beri canavarlar konusunda endişeliydim zaten ama...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050502
					],
					"speakerTitle": "Birinin Notları"
				},
				{
					"id": 711050502,
					"content": "\"... Çok fazlalar... Bacağım... Hayatta durduramam onları...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050503
					],
					"speakerTitle": "Birinin Notları"
				},
				{
					"id": 711050503,
					"content": "\"... Çok uykum geldi... Xuanlian Dağı da hemen ileride gerçi... O kutsanmış sulardan mutlaka alacağım Xiangjun...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050504
					],
					"speakerTitle": "Birinin Notları"
				},
				{
					"id": 711050504,
					"content": "\"Xiangjun... O kutsanmış suyu mutlaka alacağım...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050505
					],
					"speakerTitle": "Birinin Notları"
				},
				{
					"id": 711050505,
					"content": "Eyvahlar olsun! Canavarların saldırısına uğrayıp ağır yaralanmış galiba... Her şeye rağmen hâlâ Xuanlian Dağı'ndan kutsanmış su almak için debeleniyor üstelik, şaka gibi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711050506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711050506,
					"content": "Acele edelim. Ona yardım edebiliriz belki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7110506,
