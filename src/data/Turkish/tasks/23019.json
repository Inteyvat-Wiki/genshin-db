				"objectNames": [
					"Rafiq"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230190101,
					"content": "Böyle yaptığımızda daha pahalıya mal olacağını biliyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190102
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190102,
					"content": "Neden bahsediyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190103
					]
				},
				{
					"id": 230190103,
					"content": "Ah, merhaba. Ben gemi tasarımındaki bir sorun üzerinde çalışıyorum ve bir çıkmaza girdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190104
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190104,
					"content": "Sana doğrudan anlatayım. Bir geminin maliyetini artırmadan daha fazla şey taşıyabilmesini sağlamak istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190105
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190105,
					"content": "Ağırlık çok fazla olduğunda yapı kırılmaya daha müsait hale geliyor. Yük eşit dağılmadığında ise denge bozuluyor, bunun gibi şeyler işte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190106
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190106,
					"content": "Bu sorunları çözmenin en iyi yolu daha iyi malzemeler kullanmak ama bunu yaparsak çok daha büyük bir maliyeti göze almamız gerekiyor. İşte asıl mesele bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190107
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190107,
					"content": "*iç çeker* Açıkçası Moram yok ama yine de iyi bir gemi inşa etmek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190108
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190108,
					"content": "Bu yüzden normalde Morayla çözülebilecek problemleri çözebilmek için bazı teknik imkanlardan faydalanmalıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190109
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190109,
					"content": "Gerçekten bunu yapabilir misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190110
					]
				},
				{
					"id": 230190110,
					"content": "Hahaha, inanmayabilirsin ama bunu yapan çok kişi var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190111
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190111,
					"content": "Sonuçta biz kıyı için balıkçı tekneleri inşa ediyoruz. Bizim tekneler hiçbir zaman fırtınada kalmayacak ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190112
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190112,
					"content": "Söz konusu gemi inşa etmek olunca maliyeti olabildiğince kısmamız; tamir edilmesi, onarılması gereken ne varsa yapmamız gerekiyor... Gemi kullanılabilecek durumda olduğu sürece onu geliştirebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190113
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190113,
					"content": "Bu ilkeyle çalıştığımız için gemi tadilatı işimiz gün geçtikçe iyiye gidiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190114
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190114,
					"content": "Gezgin, yardım etmek istersen limana biraz önce dönen şu gemiyi kontrol edebilirsin. Sürekli ağır yük taşıdığı için biraz sorun yaşıyor gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190115
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190115,
					"content": "Ben de tam bu konuyu araştırıyordum, belki buradan birkaç fikir edinebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190116,
						230190118
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190116,
					"content": "Bana bırak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190117
					]
				},
				{
					"id": 230190117,
					"content": "O halde bu işi sana bırakıyorum! Benim hemen gidip başka bir gemiyi tamir etmem gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190118,
					"content": "Neden kendin gitmiyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190119
					]
				},
				{
					"id": 230190119,
					"content": "Kendim yapardım ama başka bir gemiyi tamir etmem istendi. Gemi, balık yakalamak tekrar denize açılacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190120
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190120,
					"content": "O halde bu işi senden başkasına bırakamam Gezgin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				}
			]
		},
