			"dialogs": [
				{
					"id": 230190401,
					"content": "Gemiyi kontrol edebildin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190402
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190402,
					"content": "Evet, bitirdim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230190403
					]
				},
				{
					"id": 230190403,
					"content": "Geminin durumunu anlatıyorsun.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230190404
					]
				},
				{
					"id": 230190404,
					"content": "Anlıyorum. Çeşitli numaralarla maliyeti azaltılan gemilerde tam da beklediğim gibi bazı sıkıntılar yaşanıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190405
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190405,
					"content": "Ama bu gemileri tamir etmek de çok maliyetli oluyor. Bu geminin sahibinin... Bütçesinin her zaman kısıtlı olduğunu hatırlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230190406
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230190406,
					"content": "*iç çeker* Gidip onunla bir konuşsam iyi olacak. Hayatı Moradan çok daha değerli sonuçta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				}
			]
		}
