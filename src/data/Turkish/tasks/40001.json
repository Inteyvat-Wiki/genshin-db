			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400010201,
					"content": "Sonunda <color=#00E1FFFF>Liyue'deyiz</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010202,
					"content": "#Genç {M#adam}{F#hanım}, yanlış anlamazsan eğer, havada süzülen şu şey için kaç para istiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010203,
						400010205
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010203,
					"content": "O satılık değil!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010204
					]
				},
				{
					"id": 400010204,
					"content": "Paimon satılık değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010209,
					"content": "Hahaha... Aslına bakarsan, son zamanlarda ekonomik olarak sıkıntıdayım. Yani haklısın, muhtemelen param yetmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010210
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010210,
					"content": "Zaten küçük bir tüccarım. Nadide ve egzotik hazinelerle iş yapmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010211
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010211,
					"content": "Konuştukça daha da şüphe çektiğinin farkında mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010212,
					"content": "Amanın, birilerin bugün huysuzluğu üzerinde. Al bakalım, belki şeker keyfini yerine getirir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010213
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010213,
					"content": "Aman ne kadar da güvenilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010214,
					"content": "Sanırım ikiniz Fener Şenliği için Liyue'ye geldiniz, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010215
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010215,
					"content": "Bu yılın Mingxiao Fenerinin görmeye değer bir manzara olacağından bahsediyorlar. Feneri havaya kaldıracak olan Plaustrit son yirmi yılın en büyüğüymüş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010216
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010216,
					"content": "O kadar büyük ki insan merak etmekten kendini alamıyor... Acaba efsanelere konu olan şu bulutların arasında süzülen şehir gerçek mi ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010217
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010217,
					"content": "Yani, aynı boyutlarda bir Plaustrit parçasıyla havada kalabiliyor olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010218
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010218,
					"content": "Muhteşem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010219,
					"content": "Haha! Umarım yollarımız bir daha kesişir. Liyue'ye hoş gediniz! Tüm <color=#00E1FFFF>Liyue Limanı</color> adına konuşamam ama istediğiniz zaman dükkanıma uğrayabilirsiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				},
				{
					"id": 400010205,
					"content": "İnan bana, onu almaya paran yetmez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010206
					]
				},
				{
					"id": 400010206,
					"content": "Ne kadar garip bir şey dedin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010207,
					"content": "Ancak Paimon merak etti şimdi. Aklında tam olarak ne kadar vardı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400010208,
					"content": "Aman, unut gitsin. Paimon, Moranın alabileceğinden çok daha değerli dediğini farz edelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010209
					],
					"speakerTitle": "Paimon"
				}
			]
		},
