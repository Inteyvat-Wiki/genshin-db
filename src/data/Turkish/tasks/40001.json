		{
			"id": 4000106,
			"completionStepIds": [
				4000106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4000106",
							"2"
						],
						"stepId": 4000106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Madam Ping"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400010601,
					"content": "Bu yılın Mingxiao Feneri Gökyüzünün Rehberine adandı. Hava atmayı çok severdi. Kesin çok mutlu olacaktır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010602,
						400010611
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 400010602,
					"content": "Gökyüzünün Rehberi kim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010603
					]
				},
				{
					"id": 400010603,
					"content": "Bu yılın Mingxiao Feneri tamamlandığında, onun tıpatıp aynısı olacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010604
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 400010604,
					"content": "En azından niyetleri böyle. Umarım boynuzlarını küçük yapmazlar. Ne de olsa boynuzları onun gurur kaynağıydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010605
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 400010605,
					"content": "Rivayete göre, boynuzları Rex Lapis'in kutsal gücünün özüyle yapıldı ve bu şekilde Liyue'deki en sert malzemeye dönüştü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010606
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 400010606,
					"content": "Zaman geçmiş ve kaçınılmaz savaş patlak vermiş. Tanrılar birbirlerine tüm güçleriyle vurmuş ve dağlar yıkılmaya başlamış. Adeptus, dağın eteklerinde yaşayan köylülerin zarar görmemesi için arkadaşından boynuzlarını kesmesini istemiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010607
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 400010607,
					"content": "O kanla kaplı boynuzları, dağın devrilmesini engellemek için destek olarak kullanmış. Bu fedakarlığı yetmezmiş gibi, kan kaybından ölene kadar savaşmaya devam etmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010608
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 400010608,
					"content": "Onun sayesinde Tianheng Dağı hâlâ ihtişamlı bir şekilde duruyor. O savaşta kaybettiği kan ise Bishui Nehri'ne kaynak oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010609
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 400010609,
					"content": "Hehehe... Hikayeye inanır mısın bilmem ama dinlediğin için mutlu oldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010610
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 400010610,
					"content": "Tabii ki Fener Şenliğinin bugün var olmasının sebebi, asırlar boyunca insanların yalnız kalmak yerine arkadaş olarak bir araya gelmeyi seçmeleridir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 400010611,
					"content": "Hoşça kal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400010612
					]
				},
				{
					"id": 400010612,
					"content": "Görüşürüz. Bilgeliğin ateşi her yere yayılsın ve asla söndürülemesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madam Ping"
				}
			]
		},
		{
			"id": 4000109,
			"completionStepIds": [
				4000109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
