			"dialogs": [
				{
					"id": 790550101,
					"content": "Bu, \"Alabora Dağı\" gösterisinden bir sahne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550102
					],
					"speakerTitle": "Sahne Notları"
				},
				{
					"id": 790550102,
					"content": "Aslında hikaye, alabora olmuş bir gemide giden ve birbirine sırılsıklam aşık olmuş iki Su Tayfını anlatıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550103
					],
					"speakerTitle": "Sahne Notları"
				},
				{
					"id": 790550103,
					"content": "Birbirlerine açıldıktan sonra gün batımının aydınlattığı pruvanın orada durdular ve aşırı romantik bir sahne ortaya çıktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550104
					],
					"speakerTitle": "Sahne Notları"
				},
				{
					"id": 790550104,
					"content": "Ancak bu sahneden vazgeçildi... Çünkü bu kısmı oynayan Su Tayfları aşırı enerjiktiler ve böylesi romantik bir sahne için fazla kıpır kıpırdılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550105
					],
					"speakerTitle": "Sahne Notları"
				},
				{
					"id": 790550105,
					"content": "<color=#00E1FFFF>İkisini birden aynı anda pruvada yakalayabilsem</color> ortaya harika bir sahne çıkacak...",
