			"dialogs": [
				{
					"id": 747110101,
					"content": "Aha! Her şey yolunda gidiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110102
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110102,
					"content": "Tedavi arayışımızın artık son düzlüğe girdiğinden eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110103
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110103,
					"content": "Ancak listeyi tamamlamak için suda yaşayan birkaç hasta daha bulmanın haricinde, sizden daha özel bir ricam olacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110104
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110104,
					"content": "Etkilenen sulardaki bazı anahtar su altı mekanizmalarının yerini tespit etmenizi ve sensörlerinin kaydettiği verileri toplamanızı istiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110105,
						747110106
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110105,
					"content": "Sonra da verileri analiz edip işe yarar örüntüleri gün yüzüne mi çıkaracağız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747110107
					]
				},
				{
					"id": 747110107,
					"content": "Aynen öyle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110108
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110108,
					"content": "Derslerini aldıklarından emin olmak için tekne sahipleri ve dalgıçlarla da konuşmalıyız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747110109,
					"content": "Haklısın, balıkçıları ve turistleri saymıyorum bile... Tekneyle açılanından tut da suyun altına dalanına kadar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110110
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110110,
					"content": "Sularımızla etkileşime geçen herkesin dikkatli olması şart. Öyle kafalarına göre denizi çöplüğe çevirip denizdeki yaşam alanlarını altüst edemezler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747110111
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110111,
					"content": "Aksi takdirde çok saldırgan balıklar gelip teknelerini alabora edebilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747110106,
					"content": "Böylece ileride benzer olayların yaşanmasının önüne geçmiş olacağız, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747110107
					]
				}
			]
		}
	]
