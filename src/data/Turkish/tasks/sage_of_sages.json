			"dialogs": [
				{
					"id": 130380301,
					"content": "Bugün Düello Ayinini bir kez daha gerçekleştirmek üzere toplanmış bulunuyoruz. Gücü ve yetkisi aramızda bulunan bilgelerin en yücesi Lord Hermanubis bize şahitlik edecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380302
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380302,
					"content": "En kutsal törenimiz olan bu ayini sekteye uğratan izleyicilere müsamaha tanınmayacak. Düelloya tanıklık eden herkesin ayin boyunca en üst düzey saygı ve hürmeti göstermesi elzemdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380303
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380303,
					"content": "Sessizlik Tapınağını temsil eden taraf: Savunucular.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380304
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380304,
					"content": "Dede, gelmişsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380305
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380305,
					"content": "*öksürür* ... Bunca yıldan sonra bir Düello Ayini demek... Kararına şaşırdım Sethos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380306
					],
					"speakerTitle": "Bamoun"
				},
				{
					"id": 130380306,
					"content": "Ben ne yaptığımı biliyorum dede. Bana güven.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380307
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380307,
					"content": "Akademiyi temsil eden taraf: Meydan okuyanlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380308
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380308,
					"content": "Hazırız. Sesimizi duyurmak için savaşacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380309
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380309,
					"content": "Savaşçılar, yerlerinizi alın ve dövüş sırasını belirleyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380310
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380310,
					"content": "Meydan okuyan tarafı buraya hangi sebebin getirdiğini tartışmayacağız, yenilen tarafa ne olacağını da. Düellocular, ortada bizzat Hermanubis'in kudreti söz konusu. Şimdi savaşın, hak eden taraf galip gelinceye kadar savaşın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380311
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380311,
					"content": "Önce ben başlayacağım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380312
					]
				},
				{
					"id": 130380312,
					"content": "Hı? Emin misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380313,
					"content": "Eminim. Moralimizi yüksek tutmamız lazım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380314
					]
				},
				{
					"id": 130380314,
					"content": "#Katılıyorum. {NICKNAME} çok güçlü. Önce onu göndermek karşı tarafın gözünü korkutacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380315
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380315,
					"content": "Peki, sen de ikinci sıradasın o zaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380316
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380316,
					"content": "Tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380317
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380317,
					"content": "Kararımızı verdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380318
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380318,
					"content": "Biz de. Hadi başlayalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sethos"
				}
			]
		},
