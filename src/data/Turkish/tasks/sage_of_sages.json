			"dialogs": [
				{
					"id": 130380501,
					"content": "İkinci dövüş sona erdi. Şimdi üçüncü dövüşe geçeceğiz. Düellocular, lütfen öne gelin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380502
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380502,
					"content": "Hazırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380503
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380503,
					"content": "Ben de.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380504
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380504,
					"content": "Ayinin son aşamasına geldik. İkinize de önceden kabul ettiğiniz şartların bağlayıcılığını hatırlatmak isterim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380505
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380505,
					"content": "Hazır olduğunuzda başlayabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380506
					],
					"speakerTitle": "Duaenre"
				},
				{
					"id": 130380506,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380507
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380507,
					"content": "Ben Sethos. Hermanubis'in taşıyıcısı, Bamoun'un torunu, Sessizlik Tapınağının lideriyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380508
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380508,
					"content": "Uzun yıllar boyunca Lord Hermanubis'e olan yeminimize sadık kalarak Kral Deshret'in sırlarını koruduk. En karanlık dönemimizde bile, önümüzdeki yolu göremediğimizde bile umudumuzu yitirmedik, üstün gelmek için yeni ve cesur bir deneye kalkıştık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380509
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380509,
					"content": "Lord Hermanubis'in bilgeliğini ve gücünü tüm samimiyetimizle istedik, ruhunun ve ışığının üzerimize olmasını diledik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380510
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380510,
					"content": "Şimdi o gücün meşru hakimi olmak için savaşacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380511
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380511,
					"content": "Ben Cyno. Akademinin General Mahamatra'sı, Cyrus'un öğrencisi ve halefi, Spantamad'ın bilgesiyim. Gücümü, hocamı ve ulusumu savunmak için dövüşeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380512
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380512,
					"content": "Sen. Sanırım söylemediğin bazı şeyler var. Bu kutsal bir düello, Hermanubis bizi izliyor. Açıkla tüm düşüncelerini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380513
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380513,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380514
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380514,
					"content": "(Herkes... Yaşlısı genci, güçlüsü zayıfı, hepsi bu düellonun sonucunu bekliyor.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380515
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380515,
					"content": "Dedem bilge bir lider. Ayrıca elini kana bulamaktan çekinmeyen bir yönetici olmasıyla da bilinir. Düşüncelerini anlıyorum, benden beklentilerini de biliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380516
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380516,
					"content": "Ama inancımız bizi çok uzun süre kısıtladı. Büyüyünce bir keresinde yağmur ormanına gittim ve şehrin insanlarını kendi gözlerimle gördüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380517
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380517,
					"content": "Artık farklı bir dönemdeyiz. Sumeru halkı geçmişte olduğundan daha mutlu ve daha özgür. Şehrin en yüksek noktalarından birinde durup sokakları izlerken bunu düşündüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380518
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380518,
					"content": "Sonra seni düşündüm Cyno. İkimiz de aynı güce sahibiz fakat hayatlarımız birbirinden daha farklı olamaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380519
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380519,
					"content": "Hermanubis'in her bir Ba Parçası farklı bir özelliği niteliyor. Kudret, zafer... Veya henüz keşfedilmemiş başka sırlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380520
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380520,
					"content": "Eskiden parçalarımızın özelliği yüzünden birbirimizden bu kadar farklı olduğumuzu düşünürdüm. Ama... Belki de sen cevabını bulmuşsundur, bense hâlâ arıyorumdur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380521
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380521,
					"content": "Ben bir savaşçıdan ibaret değilim. Ben bağımsız biriyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380522
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380522,
					"content": "... Aynen öyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380523
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380523,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380524
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380524,
					"content": "\"Hermanubis\" adı ikimizde de izini bıraktı, hayatlarımızın gidişatını belirledi. Biz onun taşıyıcılarıyız fakat aynı zamanda bundan daha fazlasıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380525
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380525,
					"content": "Bana cevabını göster Cyno. Bana inancımdan fazlası olabileceğimi, sahip olduğum güçten fazlası olabileceğimi göster... Olabileceğim kişiyi göster bana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380526
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380526,
					"content": "Haydi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380527
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380527,
					"content": "Nasılsın? İyi misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380528,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380529
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380529,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sethos"
				}
			]
		},
