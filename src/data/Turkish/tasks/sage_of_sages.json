			},
			"dialogs": [
				{
					"id": 130380101,
					"content": "Grup, anlaştıkları saatte yeniden buluşur...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130380102
					]
				},
				{
					"id": 130380102,
					"content": "Bir müddet oturup düşündüm... Tahminimce Cyrus Hoca çöle gelirken büyük ihtimalle geri dönemeyeceğini göze almıştır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380103
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380103,
					"content": "Bir şeyi kafasına taktı mı takan ve geri adım atmayan inatçı bir adam. Onu kaçmaya ikna edemeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380104
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380104,
					"content": "Katılıyorum. Ustam Naphis de aynısını diyordu. Cyrus bir kere kafaya koydu mu akıl mantık dinlemiyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380105
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380105,
					"content": "Evet. Öyle bir nokta var işte. Aklıma başka şeyler de geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380106
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380106,
					"content": "Sessizlik Tapınağı hakkında duymanız gerekenleri duydunuz. Onun üzerine ekleyeceğim bir şey yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380107
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380107,
					"content": "Buraya dair kendi anılarım bulanık ama. Muhtemelen Ba Parçalarının yüksek gücünden ötürüdür. Çocukken sürekli başımın ağrımasını ve ateşimin çıkmasını açıklıyor bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380108
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380108,
					"content": "Bazen derin duygular hissettiğim ve zihnimde muğlak görsellerin belirdiği oluyordu. Ama çok hatırlamıyorum, bölük pörçük bazı şeyler var sadece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380109
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380109,
					"content": "O zamanlar çok küçüktüm, anlayabildiğim tek şey zihnimin içinde güçlü başka bir irade olduğuydu. Şu an düşününce sanırım o irade, Hermanubis'in iletişim kuramıyor olmamıza rağmen beni cesaretlendirme yöntemiydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380110
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380110,
					"content": "Ruhumda kendine yer edinen güç muhtemelen Tapınağın inancının mihenk taşlarından biriydi. Yani Hermanubis'in iradesi ve kudreti gerçek ve somutsa Tapınak üyeleri de onun meşru takipçileri sayılır. Öyleyse de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380111
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380111,
					"content": "Taleplerine boyun eğmeyeceksin, değil mi? Kesin başka bir yolu olmalı bunun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380112,
						130380113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380112,
					"content": "Acele karar verme Cyno.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380114
					]
				},
				{
					"id": 130380114,
					"content": "Yok, geri vermeyi düşünmüyorum. Sumeru'yu korumak için bu güce ihtiyacım var. Ama gücün kaderi üzerinde son kararı verme hakkı Tapınağın, sonuçta güç Kral Deshret'in Yedi Sütunundan birine ait...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380115
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380115,
					"content": "O yüzden onlarla doğrudan yüzleşeceğim ve bu güce sahip olma hakkını bileğimin hakkıyla kazanacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380116
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380116,
					"content": "Hımm, biz yola çıkmadan önce Alhaitham'ın dediği bir şeyi hatırlattı bu bana. Sessizlik Tapınağının aslında o zamanki seçkin yönetici sınıfı tarafından kurulduğunu söylemişti. Geleneklere göre bu tür örgütler kadim ve katı soyluluk kurallarına tabi tutuluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380117
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380117,
					"content": "Kaveh de yaptığı iş gezilerinde çöl kabilelerine dair benzer gözlemlerde bulunmuş. Çoğu kabilenin kendi içinde kuralları olduğunu söyledi. Kabile arası bağlara veya atalarının belirlediği kurallara leke sürmemeye büyük önem veriyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380118
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380118,
					"content": "Bence bunu kendi lehimize kullanabiliriz. Onlara kendi teklifimizi götürelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380119
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380119,
					"content": "Vay be... İşte böylece durumu tersine çevirdik resmen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380120,
					"content": "Aynı şeyi düşünüyoruz galiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380121
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380121,
					"content": "Hazır imkan varken onlara reddedemeyecekleri şartlar sunalım. Buradan ancak böyle galip çıkabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380122
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380122,
					"content": "Bence iyi fikir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380123
					]
				},
				{
					"id": 130380123,
					"content": "Harika. Ben konuşmayı nasıl başlatacağımızı biliyorum. Hadi gidip Sethos'u bulalım. Ona biraz tıp bilgim olduğunu belirtir ve dedesini muayene etmek istediğimi söyleriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380113,
					"content": "Bence de başka bir yolu olmalı!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380114
					]
				}
			]
		},
