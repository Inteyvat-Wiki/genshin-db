			"dialogs": [
				{
					"id": 130380201,
					"content": "Sethos. Konuşalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380202
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380202,
					"content": "Kararını verdin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380203
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380203,
					"content": "O konuya geleceğiz. Ama ondan önce... Tıp eğitimi almışlığım var da, acaba dedeni muayene etmeme izin verir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380204
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380204,
					"content": "Buna itirazım olmaz ama burada kendi doktorlarımız da var. Bize bilmediğimiz bir şey söyleyebileceğini düşünmüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380205
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380205,
					"content": "Öğrenmenin tek bir yolu var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380206
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380206,
					"content": "Gelin benimle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380207
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380207,
					"content": "Yüksek sesle konuşmayın. Rahatsızlık vermeyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380208
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380208,
					"content": "Tighnari tıp aletlerini çıkarır ve Bamoun'u basitçe muayene eder.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130380209
					]
				},
				{
					"id": 130380209,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380210
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380210,
					"content": "Dışarıda konuşalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380211
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380211,
					"content": "Bamoun derin bir komaya girmiş, gidişatı çok vahim. Eminim sizin hekimleriniz de aynı sonuca varmıştır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380212
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380212,
					"content": "Gençliğinde ciddi bir yaralanma geçirmiş, yıllar boyunca işlerinin ağırlığı yüzünden de durumu iyice kötüleşmiş. Şimdi bir de yaşlılığın etkisiyle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380213
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380213,
					"content": "Üzülerek belirtmek zorundayım ki... Benzer durumdaki hastalarda gördüklerimle kıyaslarsam dedenin çok vakti yok. En fazla birkaç gün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380214
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380214,
					"content": "... Evet, uzun süredir biliyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380215
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380215,
					"content": "Sen onun varisisin, değil mi? Belli ki büyük saygı duyuyorsun ona. Ama durumlara yaklaşımın ondan farklı. Daha geniş kapsamlı düşünüyorsun ve daha pragmatik bir yaklaşımın var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380216
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380216,
					"content": "Bu işi senin şartlarına göre nasıl bitirebiliriz söyle. Bamoun hâlâ hayattayken durumu çözüme kavuşturmanın bir yolunu bulalım birlikte. Senin için asıl önemli olan bu, biliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380217
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380217,
					"content": "Evet. Harcayacak vaktimiz yok. Bunu en iyi sen bilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380218,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380219
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380219,
					"content": "Aslında ikiniz de şu anda çok benzer bir durumdasınız. İkiniz de sizi yetiştiren adamlardan çok farklı bakış açılarına sahipsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380220
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380220,
					"content": "Evet. Üstelik bu olayı siz çıkarmadınız, onlar çıkardı ama nasıl olduysa zor kararları vermek size düştü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380221,
					"content": "... Haklısınız. İkimiz de bu probleme onlardan çok daha farklı yaklaşıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380222
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380222,
					"content": "Kabul ediyorum Cyno. Bunların hepsi Hermanubis yüzünden başladı, o halde onun yarattığı bir ayinle sonlandıralım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380223
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380223,
					"content": "Efsanelere göre Hermanubis, Tulaytullah'a ilk geldiğinde şehir sakinleriyle antrenman dövüşleri yaparmış. Kendisi ve iki yoldaşı birkaç gün dövüşerek azimlerini kanıtlamış ve nice insanın desteğini kazanmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380224
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380224,
					"content": "O destekçiler Sessizlik Tapınağının ilk üyeleri olmuş, antrenman dövüşleri de kuruluş ayinlerimizden birine dönüşmüş... Düello Ayini. Her şey onunla başlamış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380225
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380225,
					"content": "Gayet uygun duruyor. Ben varım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380226
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380226,
					"content": "Hermanubis'in bir diğer taşıyıcısı olarak Sessizlik Tapınağına derinden bağlısın. O yüzden seçtiğin yoldaşlarınla bu ayine katılmana izin vereceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380227
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380227,
					"content": "Üçe üç. İyi fikir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380228
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380228,
					"content": "Ancak ilave bazı şartlarım olacak. Meydan okuyan taraf siz olduğunuz için üç dövüşün üçünü de kazanmalısınız. ve Cyno... İkimiz de ortaya Ba Parçalarımızı koyacağız. Kazanan ikisini de alır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380229
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380229,
					"content": "Cyrus'un bir Ba Parçasıyla ayrılmasına izin vermek hataydı, dedemin acıma duygusuyla yaptığı bir hata. Sessizlik Tapınağının ilerleyebilmesi için bu sorunun çözülmesi gerekiyor. Bu konuda taviz veremem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380230
					],
					"speakerTitle": "Sethos"
				},
				{
					"id": 130380230,
					"content": "Tavize gerek yok. Aynı fikirdeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380231
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380231,
					"content": "Ben kazanırsam Sessizlik Tapınağı Cyrus'u serbest bırakmalı ve bu geçmiş anlaşmazlığı çözülmüş saymalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380232
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380232,
					"content": "Sen kazanırsan gücümü sana vereceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380233
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380233,
					"content": "Anlaştık. O zaman yarın akşam saat sekizde tören salonunda buluşalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sethos"
				}
			]
		},
