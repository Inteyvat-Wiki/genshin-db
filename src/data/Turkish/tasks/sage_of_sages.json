			"dialogs": [
				{
					"id": 130380601,
					"content": "Olan bitene bakılırsa artık bu işin geri dönüşü yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380602
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380602,
					"content": "Hiçbir zaman olmadı. Hocam gizlice çöle gelmeye karar verdiği andan beri geri dönmek gibi bir seçeneğim olmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380603
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380603,
					"content": "Kazanman lazım. Bu güce ihtiyacın var, hem General Mahamatra olarak hem de kendin için.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380604
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380604,
					"content": "Evet, doğru! Üstelik bu güç küçüklüğünden beri seni terk etmemiş. Seni gerçek sahibi olarak kabul ettiğinin bir işareti bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380605,
					"content": "... Hem General Mahamatra olarak hem de kendim için...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380606
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380606,
					"content": "Evet, öyle söyleyince... Bu gücü ehlileştirip kullanabilmek için çok engeller aşmam gerekti. Herkes yapamazdı bunu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380607
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380607,
					"content": "Aynen öyle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380608,
						130380609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130380608,
					"content": "Dikkatimiz dağılmasın. Kazanmaya odaklanmamız lazım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380610
					]
				},
				{
					"id": 130380610,
					"content": "#{NICKNAME} ile ben asla yenilmeyeceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380611
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 130380611,
					"content": "Ben de yenilmeyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380612
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380612,
					"content": "Çöl eskiden kadim ve büyük bir medeniyete ev sahipliği yapıyordu. Bu medeniyet, bazı nedenlerden ötürü yağmur ormanı medeniyetiyle anlaşmazlık yaşadı. Dehya'nın dediği gibi, ön yargılar insanların arasını bozdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380613
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380613,
					"content": "Ama burada bazı kişisel etkenler de rol oynamış olmalı. Bamoun'un önem verdiği ama bize bahsetmediği başka konular olduğunu düşünüyorum. Sethos'un da kötü biri olduğunu sanmıyorum. Bence doğru olduğuna inandığı şeyi yapıyor sadece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130380614
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380614,
					"content": "... Yarın her şey çözüme kavuşacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cyno"
				},
				{
					"id": 130380609,
					"content": "Bu işi bitirmene yardım edeceğiz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130380610
					]
				}
			]
		},
