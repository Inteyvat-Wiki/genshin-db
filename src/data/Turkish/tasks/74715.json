			"dialogs": [
				{
					"id": 747150101,
					"content": "Freminet? Aşırı yorgun duruyorsun! Kendini çok mu zorladın yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747150102,
					"content": "Şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150103
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747150103,
					"content": "Hop! Dalgıç kaskının içine saklanma! Biz senin arkadaşınız. İçini bir dökersen kendini çok daha iyi hissedersin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747150104,
					"content": "...*iç çeker* Sanırım haklısın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150105
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747150105,
					"content": "Az önce dalış yaparken tam bir baş belasına denk geldim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150106
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747150106,
					"content": "Baş belası mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747150107,
					"content": "Evet... Nasıl açıklasam... Fontaine yasalarına göre, batan bir kargonun sahibi sigorta ödemesini kabul ederse kargo sahipsiz mal haline gelir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150108
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747150108,
					"content": "İşte bu yüzden bazı insanlar dalgıçlığı köşeyi dönmenin bir yolu olarak görüyor. Başkalarının kaybettiği eşyaları çıkarıp karada Mora karşılığında satıyorlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150109
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747150109,
					"content": "Bu iş öyle pek bir beceri gerektirmiyor, hal böyle olunca da ortalık... Şey... Gözünü para bürümüş dalgıçlarla kaynıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150110
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747150110,
					"content": "Sırf değerli enkazlara ulaşmak uğruna barbarca yöntemlerle balıkları ve Tombalakları kaçırıyorlar... Bazı görevleri kabul etmememin esas nedeni de zaten bu tür insanlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150111
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747150111,
					"content": "Demek canını sıkan bu... Paimon ne hissettiğini çok iyi anlıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747150112,
					"content": "Az önce dalış yaparken, hayvanları ürkütüp kaçıran biriyle karşılaştım. Bütün cesaretimi toplayıp onu durdurmayı başardım ama işin sonunda bana epey ağır laflar etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150113
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747150113,
					"content": "Çok kötü olmuş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150114,
						747150115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747150114,
					"content": "Doğru olanı yapmışsın!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747150116
					]
				},
				{
					"id": 747150116,
					"content": "Nazik teklifiniz için teşekkür ederim ama... Zor olsa ve beni bitkin düşürse bile doğruyu savunmak ve bir şeyleri kendi başıma değiştirmeye çalışmak istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150117
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747150117,
					"content": "Su altında süzülmeye, Beril Kabuklarının desenlerini incelemeye, Romaritime Çiçeklerinin nefesini hissetmeye bayılıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150118
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747150118,
					"content": "Su altı dünyası seni kabullendiğinde sana şefkatle karşılık verir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150119
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747150119,
					"content": "Bencilce her istediğimizi koparıp almak yerine doğayla böyle bir bağ kurmamız gerektiğine inanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150120
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747150120,
					"content": "Vay canına Freminet, Paimon az önce söylediğin her şeye bayıldı! Gördün mü bak? Söylemek veya yapmak istediğin bir şey olduğunda bunu içine atmak yerine dışa vurmak çok daha iyi hissettirmiyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747150121,
					"content": "Şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150122
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747150122,
					"content": "Freminet?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747150123,
					"content": "Özür dilerim... Hâlâ biraz utangacım. Ama merak etmeyin... B-Bunu aşmaya çalışacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747150124
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747150124,
					"content": "Ah, az kalsın unutuyorum... En güncel su altı araştırma verilerini getirdim. Alın lütfen, işinize yarayacağına eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747150115,
					"content": "Bir dahakine onları senin yerine biz durdururuz!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747150116
					]
				}
			]
		}
	]
}