			"dialogs": [
				{
					"id": 223020501,
					"content": "Hemen bir göz atarız...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020502
					]
				},
				{
					"id": 223020502,
					"content": "Evet! Hem de çabucak. Aç hadi, aç hadi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 223020503,
					"content": "Hımm... Bu genç çocuğun, Dokuzuncu Chang'ın kendisinin olduğunu fark ettin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 223020504,
					"content": "Çünkü erkekler yaşlandıkça aksileşir ama Chang'ın gönlü genç, sence de öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 223020505,
					"content": "Bu kitabı hemen <color=#00E1FFFF>Feiyun Ticaret Loncasına</color> götürsek iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
