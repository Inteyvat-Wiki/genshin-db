			"dialogs": [
				{
					"id": 223020401,
					"content": "Kesinlikle kazanacağım. Kesinlikle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020402
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 223020402,
					"content": "Bu yarışmayı kazanacağım, sonra da kitabım tüm dünyada satılmaya başlayacak... Sonrasında kitabımı o da okuyacak... Kesin okur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020403
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 223020403,
					"content": "Hâlâ burada ne arıyorsun? Hemen kitabımı <color=#00E1FFFF>Feiyun Ticaret Loncasına</color> götür!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dokuzuncu Chang"
				}
			]
		},
