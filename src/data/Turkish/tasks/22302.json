			},
			"dialogs": [
				{
					"id": 223020101,
					"content": "Bu defa kazanacağım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020102
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 223020102,
					"content": "Neyi kazanacaksın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020103
					]
				},
				{
					"id": 223020103,
					"content": "Hiç duydun mu bilmiyorum ama Inazuma'da düzenli olarak gerçekleşen bir yaratıcı yazarlık yarışması var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020104
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 223020104,
					"content": "Sanırım adı... \"Bu Roman Bir Harika!\" idi. Daha da önemlisi bu yarışma, Inazuma yayıncılık piyasasının devi Yae Yayınevi tarafından düzenleniyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020105
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 223020105,
					"content": "Yarışmaya hazırlanırken, neleri beğendiklerini anlamak için Inazuma'nın popüler kurgu eserlerine daldım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020106
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 223020106,
					"content": "Tabii ki edebiyatla dolu bir eğitim hayatım olduğu için oradaki tüm kitapları okumuştum. Başvurum için Liyue ve Inazuma kültürünün en iyi yanlarını bir araya getiren bir roman yazdım. Kazanacağıma eminim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020107
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 223020107,
					"content": "Feiyun Ticaret Loncası ile konuştum. Başvurumu Inazuma'ya götürüp bizzat teslim etmesi için birini gönderiyorlar. Ancak epey süre geçti ve gelen giden olmadı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020108
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 223020108,
					"content": "Taslak metnini <color=#00E1FFFF>Feiyun Ticaret Loncasına</color> senin götürmeni isteyeceğim. Vaktin var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020109,
						223020111
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 223020109,
					"content": "Tabii.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020110
					]
				},
				{
					"id": 223020110,
					"content": "İşte bu. Hadi git ve bana yarışmayı kazandır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 223020111,
					"content": "Hikayenin konusu ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020112
					]
				},
				{
					"id": 223020112,
					"content": "Bu bir yarışma. Üzgünüm ama hikayemin ayrıntılarını seninle paylaşmayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020113
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 223020113,
					"content": "Bu yarışmayı kazanabilirsem her şey daha iyiye gidecek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dokuzuncu Chang"
				}
			]
		},
