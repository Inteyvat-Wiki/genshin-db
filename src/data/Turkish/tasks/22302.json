			"dialogs": [
				{
					"id": 223020201,
					"content": "<color=#00E1FFFF>Feiyun Ticaret Loncası</color> burası olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 223020202,
					"content": "Kitabı <color=#00E1FFFF>girişteki elemana</color> teslim et, o kadar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 223020203,
					"content": "Yine de... Paimon, bu kitabı bu kadar iyi yapanın ne olduğunu çok merak ediyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 223020204,
					"content": "Şöyle bir bakıversek mi? Ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
