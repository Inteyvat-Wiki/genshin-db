			"dialogs": [
				{
					"id": 223020301,
					"content": "Usta bu defa nereye gitti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020302
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020302,
					"content": "Dokuzuncu Chang'ın kitabını getirdim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223020303
					]
				},
				{
					"id": 223020303,
					"content": "Ne? Gerçekten mi? Hâlâ yazmaya devam ediyor mu o?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020304
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020304,
					"content": "Ah... Şimdi hatırladım. Inazuma'daki roman yazma yarışmasına katılmaktan bahsetmişti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020305
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020305,
					"content": "Bu defa ne hakkında yazmış? Önceki kitabı Yedi Yıldız hakkındaydı ve basmamız için çok ısrar etmişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020306
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020306,
					"content": "Kitap daha yayınlanmamasına rağmen, Taşordu az kalsın beni götürüyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020307
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020307,
					"content": "En azından bu defa yarışma için Inazuma'ya gidiyor. Muhtemelen kitaptan yola çıkıp tekrar bana kadar iz bulamazlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020308
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020308,
					"content": "Kitabı sen bana ver. Ben de götürmesi için Inazuma'ya giden denizcilerimizden birine veririm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020309
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020309,
					"content": "Ancak Chang'ın hiç kazanma şansı olduğunu düşünmüyorum. Inazuma'da şu anda \"Bir Kılıç Efsanesi\" diye bir kitabın ortalığı kasıp kavurduğunu duydum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020310
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020310,
					"content": "Onun da yazarı Liyue'den, ama kim olduğunu bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223020311
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 223020311,
					"content": "Kitabı getirdiğin için teşekkür ederim. Dokuzuncu Chang aslında bunu bizim almamızı istemişti, hatta ödemesini bile önden yaptı. Emeklerin karşılığında lütfen bunu kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xu"
				}
			]
		},
