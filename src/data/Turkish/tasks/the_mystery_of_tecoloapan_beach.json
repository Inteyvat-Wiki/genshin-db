			"dialogs": [
				{
					"id": 750761201,
					"content": "Oh, sonunda... Yabancı kahraman, senin yardımın olmasaydı karanlık düşman bizi çoktan bozguna uğratmış olabilirdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761202
					],
					"speakerTitle": "Zayıf Düşmüş Wayob Tezahürü"
				},
				{
					"id": 750761202,
					"content": "... Uzun zaman önce, buradaki kabile halkı düşmanımız tarafından büyülendi ve çok sayıda Gece Ruhu, Hiçliğin tuzağına düştü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761203
					],
					"speakerTitle": "Zayıf Düşmüş Wayob Tezahürü"
				},
				{
					"id": 750761203,
					"content": "Mührün bulunduğu yerde Gece tezahürünün gücü bile yavaş yavaş parçalanıyor... Bu mühür hem dış dünyayla hem de kabilenin inanç kaynağıyla olan tüm bağlantıları kopardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761204
					],
					"speakerTitle": "Zayıf Düşmüş Wayob Tezahürü"
				},
				{
					"id": 750761204,
					"content": "Savaşma şansı elde etmek için mührün kırılması gerek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761205
					],
					"speakerTitle": "Zayıf Düşmüş Wayob Tezahürü"
				},
				{
					"id": 750761205,
					"content": "Teşekkürler yabancı kahraman... Gece Ruhları, Gece Lordu'nun diyarını etkisi altına alan felaketten kurtulup rüyalarındaki eve geri dönmenin yolunu bulabilirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750761206
					],
					"speakerTitle": "Zayıf Düşmüş Wayob Tezahürü"
				},
				{
					"id": 750761206,
					"content": "Oh, sonunda Gecenin sessizliğine geri dönebilecekler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zayıf Düşmüş Wayob Tezahürü"
				}
			]
		}
