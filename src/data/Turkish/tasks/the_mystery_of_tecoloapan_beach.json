				"points": []
			},
			"dialogs": [
				{
					"id": 750760401,
					"content": "Denizin üstündeki sis son zamanlarda yoğunlaştı. Endişe verici bir alamet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760404
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760404,
					"content": "O halde efsane doğru olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760405
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760405,
					"content": "Ne efsanesi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750760406
					]
				},
				{
					"id": 750760406,
					"content": "Iıı... Bu hangi efsaneyi dinlemek istediğine göre değişir yabancı kahraman...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760407
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760407,
					"content": "O uçan ada ve devasa grafitiyle ilgili iki sebep ortaya atıldı: Biri hikayeye daha yakın, diğeriyse gerçek bir efsaneye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760402
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760402,
					"content": "Hangisini dinlemek istersin yabancı savaşçı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760408,
						750760411
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760408,
					"content": "Hikayeyi dinleyelim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750760409
					]
				},
				{
					"id": 750760409,
					"content": "Hikayelerin her zaman romantik bir yönü vardır... Sisli uçan adadaki grafitinin kökeni \"Qoyllor ile Ukuku'nun Öyküsü\"nün bir parçasıdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760403
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760403,
					"content": "Anlatılanlara göre Qoyllor adındaki kız, Babası Güneş ile iletişim kurabilmek için sahile kocaman bir grafiti çizmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760410
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760410,
					"content": "Babası Güneş, gökyüzünden grafitiyi gördü ve bu yüzden onu yeryüzünden aldı... Hikaye aşağı yukarı bu şekilde devam ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760417
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760417,
					"content": "Anlatılanlara göre Güneş Baba, kızının gücünü çalan yeryüzündeki insanlara ceza olarak tedirgin edici bir sis göndermiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760415
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760415,
					"content": "*iç çeker* İster efsane ister hikaye olsun, yükselen sis kesinlikle hayra alamet değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760416
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760416,
					"content": "Yabancı kahraman... Orası muhtemelen tehlikeli bir yer, bu yüzden fazla yaklaşmamalısın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760411,
					"content": "Gerçek efsane nasıl?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750760412
					]
				},
				{
					"id": 750760412,
					"content": "Gerçek efsanede ise... Anlatılanlara göre, uzun zaman önce Wayob kılığına girmiş kötü bir büyücü varmış ve kabilenin kahramanlarına büyü yapıyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760413
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760413,
					"content": "Daha sonra, kabilenin kahramanları, o kötü büyücüyü devasa grafitinin içine mühürlemek zorunda kalmışlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760414
					],
					"speakerTitle": "Sakaw"
				},
				{
					"id": 750760414,
					"content": "Okyanus yüzeyinin bu hale gelmesinin... Kötü büyücünün mührü parçalayıp kaçtığı anın bir alameti olduğu söylenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750760415
					],
					"speakerTitle": "Sakaw"
				}
			]
		},
