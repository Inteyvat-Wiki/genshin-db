			"dialogs": [
				{
					"id": 760300501,
					"content": "*sızlanır*... Ha? Bu da ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300502
					],
					"speakerTitle": "Rijeka"
				},
				{
					"id": 760300502,
					"content": "Ne kadar güzel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300503
					],
					"speakerTitle": "Rijeka"
				},
				{
					"id": 760300503,
					"content": "Bu iş görür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300504
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760300504,
					"content": "Ve gitti... Taşlı yol onu Donuk Ay Yerleşkesi'ne kadar götürecektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300505,
					"content": "(Columbina tanrı olarak görülmek istemediğini söylüyor. Ama yine de yardıma muhtaç olanlara el uzatıyor...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300506
					]
				},
				{
					"id": 760300506,
					"content": "Peki ya resim ne olacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300507,
					"content": "Sorun değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300508
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760300508,
					"content": "Başka bir zaman bitirebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300509
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760300509,
					"content": "İnsanların eve, ait oldukları yere dönüş yolunu bulmalarını izlemek hoşuma gidiyor.",
