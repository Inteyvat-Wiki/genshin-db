			"dialogs": [
				{
					"id": 760300101,
					"content": "Hımm. Bugün ortam normalden biraz farklı. Çiçek tarlasını mı süslüyorsun Columbina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300102,
					"content": "Ben yapmadım, onlar süsledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300103
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760300103,
					"content": "Kuuhenkileri mi diyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300104,
					"content": "Evet. Bu taşlar Kuuvahki emdiklerinde soluk bir ışık yayıyor. Kuuhenkiler çok sever bunları.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300105
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760300105,
					"content": "Taşları yere koyup oynuyorlar mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300106,
					"content": "Pek sayılmaz. Buraya gelip bakın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300107
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760300107,
					"content": "Hı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300108,
					"content": "Aa! Yukarıdan bakıldığında bir resim görünüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300109,
					"content": "Ama birkaç taş eksik kalmış sanırım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300110
					]
				},
				{
					"id": 760300110,
					"content": "Evet. Gidip biraz daha toplamam lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300111
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760300111,
					"content": "Dışarı mı çıkacaksın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300112,
					"content": "Bu taşların bol olduğu, ayın lütfuyla bezenmiş bir yer biliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300113
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760300113,
					"content": "Seninle gelmemizi ister misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300114
					]
				},
				{
					"id": 760300114,
					"content": "Olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300115
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760300115,
					"content": "O zaman toplamaya gidelim! Biz de resmin bitmiş halini görmek istiyoruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
