			"dialogs": [
				{
					"id": 760300301,
					"content": "Bu kadarı yeterli olur, değil mi? Epey topladık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300302,
					"content": "Hadi dönelim. Sanat eserlerinin yarım kalmasına kalbimiz el vermez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300303,
					"content": "*ağlar*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300304
					],
					"speakerTitle": "Rijeka"
				},
				{
					"id": 760300304,
					"content": "Aaaa! Çabuk saklan! Biri geliyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300305,
					"content": "*ağlar* Neredeyim... Anne... Eve gitmek istiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300306
					],
					"speakerTitle": "Rijeka"
				},
				{
					"id": 760300306,
					"content": "Donuk Ayın Çocuklarından biri galiba. Kayıp mı olmuş?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300307,
					"content": "Ben yardım ederim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760300308
					]
				},
				{
					"id": 760300308,
					"content": "Emin misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300309
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760300309,
					"content": "Tabii ki! Yardıma ihtiyacı olduğu bariz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300310,
					"content": "Donuk Ayın Çocukları yabancılara karşı çok temkinli, değil mi? Boynuzun yok ve saat çok geç... Ya onu korkutup kaçırırsan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300311
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760300311,
					"content": "Evet, o da bir ihtimal ama hiçbir şey yapmadan duramayız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760300312,
					"content": "Hımm... Benimle gelin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760300313
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760300313,
					"content": "Ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
