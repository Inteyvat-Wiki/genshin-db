			"dialogs": [
				{
					"id": 250220301,
					"content": "Ne güzel bir çiçekmiş bu böyle, adı bile kulağa hoş geliyor... Bir ısırık ister misin Hora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220304
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220304,
					"content": "Raaa, raaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220305
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220305,
					"content": "(Hora yavaşça çiğneyerek yaprakların tadını çıkarıyor.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220306
