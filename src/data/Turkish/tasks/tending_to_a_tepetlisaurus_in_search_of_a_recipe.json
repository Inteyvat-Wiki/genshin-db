			"dialogs": [
				{
					"id": 250220101,
					"content": "Hımm... Tarifi değiştirsem daha iyi olacak gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220102
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220102,
					"content": "Aaarrr! Raaaarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220103,
						250220104
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220103,
					"content": "Başka bir fikrin mi var? Duyalım bakalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220106
					]
				},
				{
					"id": 250220106,
					"content": "R-Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220107
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220107,
					"content": "Hora normalde koca bir kase meyveyi tek başına yer. Yemeğini bitirir bitirmez de tüm gün oyun oynar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220108
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220108,
					"content": "Ama artık ancak yarım kase yiyor. Bitirdikten sonra da kılını bile kımıldatmadan oturup kalıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220109
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220109,
					"content": "Acaba hasta mı diye korkmaya başlayınca gecenin bir yarısı bir veterinerin kapısını çaldım. Belki bana bir akıl verir dedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220110
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220110,
					"content": "Tüm gece kafa kafaya verip sorunun ne olduğunu çözmeye çalıştık. Sonra fark ettik ki hasta falan değilmiş... Meğer yemek beğenmiyormuş afacan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220111
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220111,
					"content": "Veteriner de en iyi çözümün yeni bir tarif denemek olduğunu söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220112
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220112,
					"content": "Bir de yemek saatlerinde Hora'ya müzik dinleterek iştahını açabileceğimi söyledi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220113,
						250220114
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220113,
					"content": "Harika bir fikirmiş...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220115
					]
				},
				{
					"id": 250220115,
					"content": "Hahaha... Tabii ya. Hatta Hora'nın çok sevdiği bir plak buldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220116
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220116,
					"content": "Ancak Hora plağı orta yerinden ısırıp kırdığı için bu fikri rafa kaldırmak zorunda kaldık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220117
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220117,
					"content": "Şaşıracak bir şey yok. Tepetlizorlara göre obsidiyen ve Filojistondan yapılan plaklar leziz bir atıştırmalık sayılır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220118
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220118,
					"content": "Neyse, hal böyle olunca Gök Kubbenin Evlatları kabilesine gidip yeni yemek malzemeleri bulmaktan başka çarem kalmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220119,
						250220120
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220119,
					"content": "Senin için malzeme almaya gidebilirim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220121
					]
				},
				{
					"id": 250220121,
					"content": "Yardım eder misin gerçekten? O kadar iyi olur ki! Gök Kubbenin Evlatlarındaki arkadaşlarım sadece Natlan'da bulunan malzemeleri kullanıyor gerçi ama... Senin elin her yere uzanır, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220124
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220124,
					"content": "Bir dakika, hemen veterinerin önerdiği malzeme listesine bakayım. Bizim sınırlarımız içinde bulunmayan malzemeleri bile iyi biliyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220125
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220125,
					"content": "Hımm... <color=#00E1FFFF>\"Gökkuşağı Gülü\", \"Eflatun Kavun\"</color> ve <color=#00E1FFFF>\"Qingxin\"</color> deneyebilirmişiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220122
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220122,
					"content": "Yardımın için çok teşekkür ederim. Farklı yemek malzemelerine denk gelirsen mutlaka bana getir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220123
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220123,
					"content": "Aruuuu, aruuuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220120,
					"content": "Malzeme toplama konusunda uzmanımdır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220121
					]
				},
				{
					"id": 250220114,
					"content": "Böyle müzikler olduğunu bilmiyordum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220115
					]
				},
				{
					"id": 250220104,
					"content": "(Hora'yı sev.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250220105
					]
				},
				{
					"id": 250220105,
					"content": "R-Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220106
					],
					"speakerTitle": "Hora"
				}
			]
		},
