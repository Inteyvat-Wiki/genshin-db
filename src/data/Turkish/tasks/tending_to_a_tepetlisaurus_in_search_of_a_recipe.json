					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220307
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220307,
					"content": "Oo! Çok beğenmiş gibi duruyor aslında ama çiçekler tek başına Hora'yı doyurmaya yetmez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220308
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220308,
					"content": "Ayrıca bu tür çiçeklerin pek de ucuz olduğunu sanmıyorum... Her neyse, şimdilik not almakta sakınca yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220309
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220309,
					"content": "Çiçekle nasıl yemek yapılır ki? Bir kekin içine falan mı koysak acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
			]
		},
