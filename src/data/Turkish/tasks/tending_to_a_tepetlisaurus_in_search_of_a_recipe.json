				{
					"id": 250220401,
					"content": "Vay vay, kocaman bir meyveymiş bu! Hora'yı doyurmaya yeter de artar. Denemek ister misin bakalım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220404
					],
					"speakerTitle": "Cazcal"
				},
				{
