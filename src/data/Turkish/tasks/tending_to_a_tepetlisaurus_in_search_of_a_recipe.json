					"content": "Raaa, raaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220405
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220405,
					"content": "(Hora çok geçmeden meyveyi midesine indiriyor.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220406
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220406,
					"content": "Aaarrr! Raaaarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220407
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220407,
					"content": "Hahaha, bir çırpıda bitirdi. Hoşuna gitti mi ufaklık?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220408
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220408,
					"content": "Raaa, raaah! Hırrrr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220409
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220409,
					"content": "Süper! Ben hemen Inazumalı tüccarları nerede bulabileceğimi öğreneyim. Daha fazla Eflatun Kavuna ihtiyacım olacak, malum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
