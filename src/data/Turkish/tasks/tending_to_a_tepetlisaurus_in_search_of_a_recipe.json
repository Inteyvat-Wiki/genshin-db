			"dialogs": [
				{
					"id": 250220501,
					"content": "Bu çok güzel kokuyormuş. Ferah bir aroması var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220504
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220504,
					"content": "Hora? Denemek ister mis... Aa, bak ya! Tek lokmada mideye indirdi çiçeği!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220505
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220505,
					"content": "(Hora, Qingxini tek lokmada yuttuktan sonra sana bakarak gözlerini kırpıştırıyor.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220506
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250220506,
					"content": "Hora aniden arkasını döner ve yanındaki meyve kasesinin yarısını tek seferde silip süpürür...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250220507
					]
				},
				{
					"id": 250220507,
					"content": "Hora'nın iştahı aniden geri döndü galiba... Nasıl oldu ki bu? Şu Qingxin zımbırtısı işe mi yaradı yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250220508
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250220508,
					"content": "Hemen veterinere sormam gerek...",
					"roleType": "TALK_ROLE_NPC",
