			"dialogs": [
				{
					"id": 733070201,
					"content": "Kimleri görüyorum, Sorush ile Yasnapatisi gelmiş... Aa, Paimon bile buradaymış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070202
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070202,
					"content": "Hey! Ne demek \"Paimon bile\"? Aşk olsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733070203,
					"content": "Yüzünüzdeki ifadeye bakılırsa ilginç bir şeyler bulmuş olmalısınız, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070204
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070204,
					"content": "\"İlginç\" doğru kelime mi, Paimon emin değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733070205,
					"content": "Zurvan'a Fravashi Ağacından bahsediyorsunuz...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						733070206
					]
				},
				{
					"id": 733070206,
					"content": "Anlıyorum. Şimdi, nereden başlasam ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070207
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070207,
					"content": "Anlattığınız şey kesinlikle bir Parinin dönüştüğü bir Fravashi Ağacı. Fakat bu ağaçların içinde yaşayan şeyler için sanırım \"Pari ruhu\" yerine \"hatıra parçaları\" demek daha doğru olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070208
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070208,
					"content": "Hatta toprağa dönemeyen hatıralar barındıran, bulduğunuz o Arındıran Işık Tüyüne oldukça benziyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070209,
						733070210,
						733070213
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070209,
					"content": "Toprağa dönemeyen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733070217
					]
				},
				{
					"id": 733070217,
					"content": "Bizlerse Vourukasha Vahası'ndan doğarız ve nihayetinde de oraya döneriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070218
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070218,
					"content": "Biz ve burayı koruyan tanrı, bu topraklarda akan zaman tarafından reddedildik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070219
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070219,
					"content": "Aslında bizim de umduğumuz buydu. Ne de olsa amacımız, kirliliğin bizimle beraber toprağa karışmasını önlemek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070220
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070220,
					"content": "Fravashi Ağacı bir Arındıran Işık Tüyü oluşturduğunda ağacın içindeki Pari yeniden Vourukasha Vahası'na dönebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070221
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070221,
					"content": "Arındıran Işık Tüyünü Amrita Göletine adadığında Pariye bulaşan kirlilik temizlenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070222
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070222,
					"content": "Hehe, o zaman bu iyi bir iş yaptık demek, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733070223,
					"content": "Hıh, bu gururunu benim kudretli gücüm sayesinde hissettiğini unutma Beyaz Pofuduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070224
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733070224,
					"content": "Sen de harikasın Sorush!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733070225,
					"content": "İşte bu. Fakat yanımda Yasnapatim bulunduğu sürece senin övgülerine ihtiyacım yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070226
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733070226,
					"content": "Yasnapati demişken, artık bu unvanı kabul ettiğine göre ayin için kesinlikle en uygun kişi sensin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070227
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070227,
					"content": "Eskiden Pariler ile birlikte yürüyen insan savaşçılar, çöle yayılmış Parilerin Vourukasha Vahası'na geri dönebilmeleri için bir arınma ayini düzenlerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070228
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070228,
					"content": "İşte o zamandan beri Parilerle özel bir bağ kuran kişilere \"Yasnapati\" adı verilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070229
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070229,
					"content": "Ha? Bu Sorush'un bize anlattığından tamamen farklı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733070230,
					"content": "Öyle mi? Bir şeyi de şans eseri doğru yapmasına şaşırmamak lazım. Sana gelecek olursak Yasnapati... Henüz dönmemiş Parilere yardımcı olma sorumluluğu artık senin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070231
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070231,
					"content": "Eğer başka Fravashi Ağaçlarıyla karşılaşırsan, oluşturdukları Arındıran Işık Tüylerini Vourukasha Vahası'na geri getir lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070232
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070232,
					"content": "Merak etme, sen rica etmemiş olsan bile biz onlara yardım ederdik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733070210,
					"content": "Amrita Göletine adadıklarımız gibi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733070211
					]
				},
				{
					"id": 733070211,
					"content": "Arındıran Işık Tüyleri, Simurgh'un Khvarena'sından elde edilir. Biz Pariler kutsal su Amritanın Khvarena ile temas etmesi sonucu dünyaya geliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070212
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070212,
					"content": "Bu yüzden aynı zamanda Khvarena'nın torunları olarak da biliniriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070217
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070213,
					"content": "Kulağa tanıdık geliyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733070214
					]
				},
				{
					"id": 733070214,
					"content": "Aa, Paimon ormanda aldığımız Bijayı hatırladı! Aranaraların hatıralarından yaratılmıştı o, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733070215,
					"content": "Aranara... Demek o dertsiz tasasız yaşayan yaratıkları siz de biliyorsunuz. O zaman açıklamak çok daha kolay olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070216
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070216,
					"content": "Bizim aksimize Aranaralar topraktan doğar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070217
					],
					"speakerTitle": "Zurvan"
				}
			]
		},
