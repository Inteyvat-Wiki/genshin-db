			},
			"dialogs": [
				{
					"id": 733070401,
					"content": "Zamanında dört bir yana dağılan Parilerin hepsi döndü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070402
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070402,
					"content": "Harika bir iş çıkardınız. Sorush'un seçtiği Yasnapatiden de bu beklenirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070403
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070403,
					"content": "Bunu bir iltifat olarak alıyorum Büyüğüm Zurvan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070404
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733070404,
					"content": "Hehe, Vourukasha Vahası şimdiden çok daha canlı görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733070405,
					"content": "Şu devasa deliği de kapattığımızda her şey kısa sürede normale dönecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733070406,
					"content": "Bu arada Paimon düşündü de, eğer siz Pariler sudan doğuyorsanız size \"Suri\" falan demek gerekmez miydi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733070407,
					"content": "Hey! Bize o saçma lakaplarından takmaya kalkma Beyaz Pofuduk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070408
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733070408,
					"content": "Hehe, bu aklıma çok eski bir olayı getirdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070409,
						733070410
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070409,
					"content": "\"Suri\" ile mi ilgili?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733070411
					]
				},
				{
					"id": 733070411,
					"content": "Uzun zaman önce çok sayıda Okeanid, yollarındaki birçok engeli aşarak yabancı diyarlardan buraya göçtü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070412
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070412,
					"content": "Buraya gelmek için sadece kavurucu çölleri aşmakla kalmadılar, vahşi canavarlarla da yüzleştiler. O su yaratıkları için yolculuk büyük bir işkenceydi herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070413
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070413,
					"content": "Merhum bir tanrıyı bulmaya gelmişlerdi, fakat geldikten sonra aradıklarının artık burada olmadığını fark ettiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070414
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070414,
					"content": "Harvisptokhm Ağacını gördükten sonra dağılıp ayrıldılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070415
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070415,
					"content": "Daha sonraları Okeanid efsaneleri yayıldı ve birçok maceracı, onların geçtiği yollarda seyahat edip sırlarını ortaya çıkarmaya çalıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070416
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070416,
					"content": "Önceleri bir söylenti olarak başladı ve zaman geçtikçe bu rotaya yeni bir anlam atfedildi. Kişinin saf masumiyeti bulmak amacıyla kendini feda etmesini simgeliyordu artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070417
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070417,
					"content": "Daha sonra Vourukasha Vahası dış dünyaya kapandığında bile onların yolculuğu uzun süre devam etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070418
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070418,
					"content": "Belki de onlar için yolculuk, hedefe varmaktan daha önemliydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070419
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070419,
					"content": "Kimilerine göre ise bir amaç uğruna çabalamak, kendini tamamen feda etmekten çok daha büyük önem taşıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070420
					],
					"speakerTitle": "Zurvan"
				},
				{
					"id": 733070420,
					"content": "Hey! Konu neden dönüp dolaşıp bana geliyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733070410,
					"content": "Umarım çok uzun bir hikaye değildir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733070411
					]
				}
			]
		},
