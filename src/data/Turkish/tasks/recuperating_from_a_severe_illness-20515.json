			"dialogs": [
				{
					"id": 205150101,
					"content": "Anna... Şimdi nereye gitti bu kız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150102,
					"content": "Yine mi Anna'yı bulamıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150103
					]
				},
				{
					"id": 205150103,
					"content": "Evet. Bütün şehirde aradım ama bulamadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150104,
					"content": "Lütfen bulmama yardım et. Çok yoruldum. Ayakta duramıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150105,
						205150107
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150105,
					"content": "Tamamdır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150106
					]
				},
				{
					"id": 205150106,
					"content": "İşi sana devrettim o zaman. Daha iyileşmeden böyle kaçıp gitmeye devam ederse yakında ben hasta olacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150111
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150111,
					"content": "Bekle... Anna, Katedrale gidip oradaki rahibelere teşekkür etmek istediğini söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150112
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150112,
					"content": "Önce Katedrale baksan iyi olabilir. Albert'a da sorabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150113
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150113,
					"content": "Genelde Katedralin oralarda takılır. Belki bir şey görmüştür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150107,
					"content": "Belki maceracı olmaya gitmiştir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150108
					]
				},
				{
					"id": 205150108,
					"content": "Gitmemiştir bence. Değil mi? Gitmiş midir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150109
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205150109,
					"content": "Bir şey desene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150111
					],
					"speakerTitle": "Anthony"
				}
			]
		},
