			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 766730901,
					"content": "Selam Nicole, biz geldik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730902,
					"content": "Ne çabuk! Çok hızlı çalışıyorsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730903
					],
					"speakerTitle": "İncele"
				},
				{
					"id": 766730903,
					"content": "Lafı bile olmaz. Peki şey, fotoğrafları sana nasıl vereceğiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730904,
					"content": "Şimdilik sizde kalsın. Birkaç güne geleceğim ben, o zaman heykelleri konuşuruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730905
					],
					"speakerTitle": "İncele"
				},
				{
					"id": 766730905,
					"content": "Tamamdır. Görüşürüz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
