			"dialogs": [
				{
					"id": 766730801,
					"content": "#Çok uzun zaman önce, evden kaçan genç bir {M#adam}{F#kadın} vardı. Son Morasını da harcadıktan sonra, kışın ayazında yıpranmış giysileriyle titreyerek yürüyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730802
					],
					"speakerTitle": "İncele"
				},
				{
					"id": 766730802,
					"content": "#Aniden, genç {M#adam}{F#kadın} kendini boşluğa adım atarken buldu ve tuhaf bir yere düştü. Daha tepki bile veremeden uzaklardan bir ses yankılandı:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730803
					],
					"speakerTitle": "İncele"
				},
				{
					"id": 766730803,
					"content": "\"Burası Ebedi Yüce Büyücü Nicola Coco'nun gizli yuvası. Ey zavallı, bana kalbindeki en büyük dileğini söyle, ona kavuşman için sana yol göstereceğim.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730804
					],
					"speakerTitle": "İncele"
				},
				{
					"id": 766730804,
					"content": "Aaa... Ne tuhaf bir ses.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730805,
					"content": "\"Nicola Coco\"... Kim ki o? Tanıyor muyuz?",
					"roleType": "TALK_ROLE_NPC",
