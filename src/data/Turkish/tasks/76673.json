					},
					{
						"sceneId": 3,
						"position": [
							5482.168,
							194.832,
							9712.457
						],
						"pointId": 15008
					}
				]
			},
			"dialogs": [
				{
					"id": 766731132,
					"content": "Şimdi geriye sadece Nicole'un son dokunuşları yapması kaldı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766731133,
					"content": "Bütün fazlalık taşları çıkardınız, değil mi? Bir bakayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731134
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731134,
					"content": "Hehe, bitti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731101
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766731101,
					"content": "Vay canına! Büyücünün kulübesi! Bu ne zaman buraya geldi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766731102,
					"content": "Büyücünün gücü mü bu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766731103
					]
				},
				{
					"id": 766731103,
					"content": "\"Büyücünün gücü mü bu?\" Genç ziyaretçinin sesi hayretle doluydu. \"Gerçekten hayran kaldım.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731104
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731104,
					"content": "Hah! Sonunda hikaye devam ediyor! Pekala, büyücüye ve onun genç ziyaretçisine ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766731105,
					"content": "Sonsuza dek mutlu yaşadılar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731106
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731106,
					"content": "... Son.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731107
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731107,
					"content": "Hı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731108,
						766731109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766731108,
					"content": "O arada ne oldu peki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766731110
					]
				},
				{
					"id": 766731110,
					"content": "*iç çeker* Sizi de memnun etmek zormuş. Peki, madem dinlemek için bu kadar can atıyorsunuz, mecbur en baştan alacağım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731111
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731111,
					"content": "#\"Şimdi kalbimin tek arzusu, senin dileklerini benim dileklerim yapmak.\" dedi genç {M#adam}{F#kadın}. Bu sözler yüce büyücü Nicola Coco'nun dikkatini çekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731112
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731112,
					"content": "Fakat tam birbirlerine ısınmaya başladıkları sırada bir grup davetsiz misafir baskın yaparak büyücüyü yakaladı ve kaçırdı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731113
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731113,
					"content": "Genç, şok içinde olan biteni izlerken Alynas adında yeni bir büyücü ortaya çıktı. Gençle bir sözleşme imzalayarak ona büyü gücünü bahşetti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731114
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731114,
					"content": "Fakat zorlu bir idman programını atlattıktan sonra arka planda işleyen başka bir komployu keşfettiler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731115
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731115,
					"content": "Meğerse yüce büyücü Nicola Coco uzaylı bir varlıkmış. Kendisi aslında Miyav Gezegeni Kralı Üçüncü Miyavtres'in ilk kızıymış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731116
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731116,
					"content": "Tüm dünyayı Miyav Gezegeni'ne tapmak için kandırmaya yönelik gizli bir komplonun parçası olarak büyücü kılığına girmiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731117
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731117,
					"content": "\"Ey yüce büyücü... Bunca zamandır bana yalan mı söylüyordun?\" Gencin sesi titredi, kalbi kırılmıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731118
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731118,
					"content": "\"Beni yalnız bırak. Gezegenlerimiz arasında bir savaş çıkacak. Biz en başından beri düşmandık.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731119
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731119,
					"content": "Büyücü, gözlerinde biriken yaşları kimse görmesin diye yüzünü çevirdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731120
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731120,
					"content": "Fakat genç adam cesurca uzanıp onu kolundan yakaladı ve asla bırakmayacağına yemin etti. Bu tutkulu hareketten etkilenen büyücü isyan etmeye karar verdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731121
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731121,
					"content": "Fakat tam o anda, bir zamanlar gence yardım etmiş olan Alynas kralın tarafına geçmişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731122
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731122,
					"content": "Alynas meğer en başından beri Üçüncü Miyavtres'in ikinci kızıymış. Gence yalnızca kız kardeşini ihanete teşvik etme umuduyla yardım etmiş, böylece Nicola'nın taht sıralamasındaki yerini gasp etme şansı yakalayacakmış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731123
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731123,
					"content": "Nicole uzun ve karmaşık hikayesini anlatmaya devam eder. Birçok tuhaf olay örgüsünden sonra baş kahraman artık bir insan bile değildir...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						766731124
					]
				},
				{
					"id": 766731124,
					"content": "Neyse, işin özü bu işte. Hikayenin sonunda ise bir noktada kediye dönüşmüş olan genç, büyücü ile birlikte çalışarak kralın planını başarıyla bozuyor. Sonra birlikte büyücünün kulübesine dönüyorlar ve huzur içinde sonsuza dek mutlu yaşıyorlar. Son.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731125
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731125,
					"content": "*burnunu çeker* Harikaydı... Bu hikayede ne ararsan var! Gerçek aşk... Adaletsizliğe karşı isyan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766731126,
					"content": "Sanki farklı bir hikaye olarak başlayıp bambaşka bir hikaye olarak bitti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766731127
					]
				},
				{
					"id": 766731127,
					"content": "Yapacak bir şey yok. Yaratılan her şey eninde sonunda yaratıcısının kontrolünden kurtulur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731128
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731128,
					"content": "Biz melekler de bunun bir örneğiyiz. Bir zamanlar insanlara rehberlik etmekle görevlendirilmiştik ama bazılarımız farklı bir yol seçtiği için tüm ırkımız cezalandırıldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731129
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731129,
					"content": "Semavi İlkeler bile kendi yarattıklarını tam olarak kontrol edemiyorsa... Benim ne şansım olabilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731130
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731130,
					"content": "Kadere asla akıl sır ermez, fakat yine de... Tanıştığım kişileri hikayelerinde mutlu bir sona yönlendirebilmeyi umuyorum. Hikayelerimdeki karakterler için de geçerli bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731131
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731131,
					"content": "Neyse, hikaye sona erdi ve benim de enerjim tükendi sayılır. Bir dahaki sefere anlatacak güzel bir hikayem olduğunda sizinle paylaşırım, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731135
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731135,
					"content": "Alynas meğer en başından beri Üçüncü Miyavtres'in ikinci kızıymış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731136
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731136,
					"content": "Gence yalnızca kız kardeşini ihanete teşvik etme umuduyla yardım etmiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731137
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731137,
					"content": "Böylece Nicola'nın taht sıralamasındaki yerini gasp etme şansı yakalayacakmış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766731109,
					"content": "Hikayenin bütün gelişme kısmını atladın!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766731110
					]
				}
			]
		},
