					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 3,
						"position": [
							5482.98,
							194.651,
							9710.385
						],
						"pointId": 14939
					},
					{
						"sceneId": 3,
						"position": [
							5480.907,
							194.819,
							9712.115
						],
						"pointId": 14940
					},
					{
						"sceneId": 3,
						"position": [
							5481.945,
							194.575,
							9709.521
						],
						"pointId": 14942
					}
				]
			},
			"dialogs": [
				{
					"id": 766730201,
					"content": "#Genç {M#adam}{F#kadın}, büyücünün görkemine ve güzelliğine hayran kalmıştı. Uzun bir sessizliğin ardından ciddiyetle konuştu:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730202
					],
					"speakerTitle": "İncele"
				},
				{
					"id": 766730202,
					"content": "\"Ey uzaklardan gelen yüce büyücü, ne kadar güzel ve bilgesin! Seni gördüğüm an kalbim pır pır etmeye başladı. Artık kalbimin tek arzusu, senin dileklerini kendi dileklerim kılmak.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730203
					],
					"speakerTitle": "İncele"
				},
				{
					"id": 766730203,
					"content": "Büyücü cevap verirken yüzünde belli belirsiz bir gülümseme göründü: \"Pekala. O halde seni, benim adıma gücünün yeteceği bazı işleri yapmakla görevlendireceğim. Kılavuzun burada, ödülün önümüzdeki günlerde seni bekliyor olacak.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730204
					],
					"speakerTitle": "İncele"
				},
				{
					"id": 766730204,
					"content": "Kılavuz mu? Bu parlayan küre mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7667303,
			"completionStepIds": [
				7667303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7667303",
							"2"
						],
						"stepId": 7667303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 766730301,
					"content": "\"Gizli yuva...\" dedi genç yolcu, yüzünde şaşkın bir ifadeyle. \"Bahsettiğin bu 'gizli yuva' nerede?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730302
					],
					"speakerTitle": "İncele"
				},
				{
					"id": 766730302,
					"content": "Büyücünün sesi bu soruyu duyunca biraz afalladı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730303
					],
					"speakerTitle": "İncele"
				},
				{
					"id": 766730303,
					"content": "(Bir dakika, bu karakterin çekingen olması mantıklı mı? Neyse, boş ver. Şimdilik böyle kalsın. Bay Dokuz daha sonra bunu geliştirir.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730304
					],
					"speakerTitle": "İncele"
				},
				{
					"id": 766730304,
					"content": "\"Öhöm, bir büyücüye böyle sorular sormak oldukça kabadır genç dostum. Büyücü kulübem tadilatta. Çok yakında ihtişamı karşısında nutkun tutulacak.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730305
					],
					"speakerTitle": "İncele"
				},
				{
					"id": 766730305,
					"content": "\"Bu senin sınavın olacak. Gücünü göster ve bu yüce büyücünün kendi bölgesini oluşturmasına yardım et.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İncele"
				}
			]
		},
		{
			"id": 7667304,
			"completionStepIds": [
				7667303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7667303",
							"2"
						],
						"stepId": 7667303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 766730401,
					"content": "\"Pekala genç dostum. Artık bu büyücünün karşılaştığı zorlukları biliyorsun... Nicola Coco'nun kutsal bölgesini inşa etmek için yardımına ihtiyacı var.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730402
					],
					"speakerTitle": "İncele"
				},
				{
					"id": 766730402,
					"content": "Büyücü, misafirine bir fincan çay doldurdu. \"Ne dersin?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730403,
						766730404
					],
					"speakerTitle": "İncele"
				},
				{
					"id": 766730403,
					"content": "Sana hizmet etmek benim için bir onurdur!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730405
					]
				},
				{
					"id": 766730405,
					"content": "Bir saniye! Dönüşü olmayan bir yola girmeden önce tekrar bir düşünmemiz gerekmez mi? Bu kişi hakkında hiçbir şey bilmiyoruz. Ayrıca biraz tuhaf bir havası var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730406,
					"content": "Hım... Gerçi bu çay fincanı tanıdık geliyor sanki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730407,
						766730408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730407,
					"content": "Çözebildin mi Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730409
					]
				},
				{
					"id": 766730409,
					"content": "Nicola Coco... Aa! Yoksa... Büyücü \"N\" mi? Nicole yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730410,
					"content": "Doğru. Hikayemi nasıl buldunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730411
					],
					"speakerTitle": "İncele"
				},
				{
					"id": 766730411,
					"content": "Şey... Söylemesi zor. Henüz bitmedi, değil mi? Sonunda karakterlere ne oluyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730412,
					"content": "Henüz karar vermedim. Önce evimin tadilatını halletmem gerekiyor. Belki ondan sonra ilham bulurum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730413
					],
					"speakerTitle": "İncele"
				},
				{
					"id": 766730413,
					"content": "Her neyse, sesimi duyabiliyorsanız sanırım şu anda Nod-Krai'dasınız demektir. Öyleyse benim için birkaç bir şey toplamanızı rica edebilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730414,
						766730416
					],
					"speakerTitle": "İncele"
				},
				{
					"id": 766730414,
					"content": "Ne gibi şeyler?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730415
					]
				},
				{
					"id": 766730415,
					"content": "Şöyle ki, evimi dekore etmek için birkaç heykel daha yapmak istiyorum ama şu anda ilham bulamıyorum. Bana fikir vermesi için birkaç fotoğraf çekebilirsiniz diye düşünüyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730418
					],
					"speakerTitle": "İncele"
				},
				{
					"id": 766730418,
					"content": "Ciddi misin? Pekala. Hallederiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730419,
					"content": "Sen burada bekle. Gidip neler bulabileceğimize bir bakalım. Ama heykeller bittikten sonra hikayenin sonunu getirmeyi unutma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730416,
					"content": "Heykellerle mi ilgili?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730417
					]
				},
				{
					"id": 766730417,
					"content": "Aynen öyle. Evimi dekore etmek için birkaç heykel daha yapmak istiyorum ama şu anda ilham bulamıyorum. Bana fikir vermesi için birkaç fotoğraf çekebilirsiniz diye düşünüyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730418
					],
					"speakerTitle": "İncele"
				},
				{
					"id": 766730408,
					"content": "Tanıdığımız biri...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730409
					]
				},
				{
					"id": 766730404,
					"content": "Yüce büyücü Nicola Coco, emrini yerine getireceğim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730405
					]
				}
			]
		},
