			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 3,
						"position": [
							5461.151,
							198.892,
							9742.186
						],
						"pointId": 14953
					}
				]
			},
			"dialogs": [
				{
					"id": 766730101,
					"content": "#Genç {M#adam}{F#kadın} ilerlerken büyücünün bölgesini süsleyen birçok zarif heykel dikkatini çekti. \"Bunlar da ne?\" diye sordu şaşkınlıkla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730102
					],
					"speakerTitle": "İncele"
				},
				{
					"id": 766730102,
					"content": "\"Bunlar bana karşı çıkanlar. Bir büyücünün gücünü küçümsediler ve bu yüzden taşa çevrildiler.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730103
					],
					"speakerTitle": "İncele"
				},
				{
					"id": 766730103,
					"content": "Hımm, bu çok hoşuma gitti. Spontane bir eklemeydi ama iyi olduğunu söyleyebilirim. Bir büyücü güçlü ve tehlikeli bir figür olmalıdır... Tehlike belirli bir gizem katar. Gizem olmadan da dünya çok sönük bir yer olurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730104
					],
					"speakerTitle": "İncele"
				},
				{
					"id": 766730104,
					"content": "(Ama insanları anında taşa çevirmek... Biraz abartı değil mi? Kimse bu kadar kaprisli birinin yanında olmak istemez ki... Tamam, sanırım lafımı biraz hafifletip üstü kapalı bir uyarıya çevireceğim.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730105
					],
					"speakerTitle": "İncele"
				},
				{
					"id": 766730105,
					"content": "Bunu duyan genç soğuk terler dökmeye başladı. Ama sonra büyücünün kahkahası sessizliği bozdu: \"Haha... İnandın mı? Şaka yapıyordum. Bu heykeller, kendimce zamanda belirli bir anı yakalama çalışmalarımdan ibaret.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730106
					],
					"speakerTitle": "İncele"
				},
				{
					"id": 766730106,
					"content": "\"Neyse, heykeller. Bu konuda yardımına ihtiyacım var. Büyücü kulübemi biraz boş hissediyorum, bu alanı sevimli yoldaşlarla doldurmak istiyorum.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İncele"
				}
			]
		},
		{
			"id": 7667302,
			"completionStepIds": [
				7667302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
