			},
			"dialogs": [
				{
					"id": 766730501,
					"content": "Tam da şu an görmek istediğim kişilersiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730502
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730502,
					"content": "Çektiğiniz fotoğraflara bayıldım, mükemmel bir kaynak oldu. Şimdi, tüm yontma aletlerini hazırladım. Birlikte denemek ister misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730503
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730503,
					"content": "Yontma aletleri mi? Şu blokları mı kastediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730504,
					"content": "Doğru. Heykeller taşların içinde. Tek yapmamız gereken fazla malzemeyi atmak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730505
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730505,
					"content": "İşinizi biraz kolaylaştırmak için yontma işlemine dair bir rehber hazırladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730506
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730506,
					"content": "İzleyin, önce ben göstereyim. İlk olarak genel hatları ortaya çıkarmak için büyük, cesur kesikler atıyoruz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730507
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730507,
					"content": "Taşların üzerindeki sayılar, bırakmanız gereken malzeme miktarını gösteriyor. Yani, önce böyle yapıyoruz... Sonra da böyle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730508
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730508,
					"content": "Ooo, şekil almaya başlıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730509,
					"content": "Anladınız mı? Blokları bu şekilde yonttuğunuzda temel şekli görebilmeniz lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730510
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730510,
					"content": "Sonra geriye sadece birkaç son dokunuş eklemek kalıyor... Ve işte bu kadar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730511
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730511,
					"content": "Bir dakika, ne? Göz açıp kapayıncaya kadar değişti! Bunu nasıl yaptın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730512,
					"content": "Hah, harika bir büyücü sırlarını o kadar kolay açıklamaz. Sadece izleyin ve hayran kalın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730513
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730513,
					"content": "Yontma işinin temelini kaptınız ama değil mi? Siz o kısma odaklanın, son dokunuşları bana bırakın. Teşekkürler şimdiden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730514
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730514,
					"content": "Pekala. Bir deneyelim bakalım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730515,
					"content": "Bu ne ya? Bize anlattığından çok daha zor bu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766730516,
					"content": "Hım? Ha pardon, kusura bakmayın. Yanlış olanı vermişim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730517
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730517,
					"content": "O benim çalışacağım heykel. Sizinki burada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730518
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 766730518,
					"content": "Oh... İçimiz rahatladı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
