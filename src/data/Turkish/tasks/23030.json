			"dialogs": [
				{
					"id": 230300401,
					"content": "Ne kadar şanslıyız, değil mi? Neyse ki kavanoz kırılmadı, yoksa şu an çok fena kusuyor olurduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300402
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300402,
					"content": "Bir dakika. Sen kokuya alışkın değil misin? Bunu bizzat sen yapmadın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300403
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300403,
					"content": "Sana bunun içine kusmaya sebep olan maddeler eklediğimi kaç kere açıkladım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300404
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300404,
					"content": "Buna alışık olup olmamak bir şey değiştirmiyor, koku herkeste otomatik olarak kusma refleksini tetikliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300405
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300405,
					"content": "Neden kendimi tekrar edip duruyorum ki? Zaten anlamıyorsun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300406
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300406,
					"content": "Bu arada Yasmin nereye gitti? Bugün hiç iksir sıkmadı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300407
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300407,
					"content": "Bulduğu ender bitkilerden örnek almaya gitmiş olmalı. Tipik Amurta davranışları... Bu zamana kadar nasıl hâlâ çözememiş olabilirsin ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300408
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300408,
					"content": "Pekala, kavanoz bize emanet. Yardımın için teşekkürler Gezgin. Lütfen bunları kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300409
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300409,
					"content": "Off, bu Amurtacılar... Onlar cidden...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pharez"
				}
			]
		},
