			"dialogs": [
				{
					"id": 230300101,
					"content": "Daha fazla veri... İhtiyacımız olan şey bu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300102
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300102,
					"content": "Cihazlar onları destekleyecek veriler olmadan nasıl çalışabilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300103
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300103,
					"content": "Tüm verileri almadan hiçbir şey yapmayalım mı diyorsun yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300104
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300104,
					"content": "Balık tutarken gelen tüm dalgaları tek tek analiz eder misin? Etmezsin! Yalnızca içinde balık olan dalgaya odaklanman gerekir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300105
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300105,
					"content": "Neden hiç balık yakalayamadığını şimdi anladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300106
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300106,
					"content": "Hadi ya! Sen Hara{RUBY#[S]Göstergebilim}vatat öğrencisi değilsin ki! Boşu boşuna kelime oyunları yapma bana. Artık işe koyulma vakti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300107
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300107,
					"content": "Daha fazla erteleyemeyiz. Çok vakit kaybedersek Yasmin'in de bizim de tezlerimizin bir kıymeti kalmayacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300108
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300108,
					"content": "Niye tartışıyorsunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230300109
					]
				},
				{
					"id": 230300109,
					"content": "Sen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300110
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300110,
					"content": "Sen Yasmin'in bahsettiği Gezgin olmalısın. Bize gerçekten çok yardım ettin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300111
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300111,
					"content": "Tanıştığıma memnun oldum Gezgin! Gerçekten büyük bir şeref!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300112
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300112,
					"content": "Benim adım Pharez, Kshahrewar'da öğrenciyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300113
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300113,
					"content": "Ben Ladep, Spantamad'da öğrenciyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300114
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300114,
					"content": "Senden bir isteğimiz olacak Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300115
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300115,
					"content": "Yasmin'in Kutsal Ağacın köklerine sıktığı o iksirleri biliyorsun, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300116
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300116,
					"content": "Şey... O iksirler son zamanlarda bize biraz sorun çıkarmaya başladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300117
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300117,
					"content": "İksir kullanılan bölgelerde sürekli farklı farklı canavarlar beliriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300118
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300118,
					"content": "Gerçekten formülde ya da oranlarda herhangi bir şey değiştirmedim. Sanırım bunun sebebi... Şey, öngörülemeyen birtakım durumlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300119
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300119,
					"content": "Sen nasıl diyorsan... Her neyse, Gezgin lütfen bizimle birlikte Yasmin'in iksir uyguladığı yerleri kontrol etmeye gel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300120
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300120,
					"content": "Muhtemelen çok fazla canavar olacak, bu yüzden oraya tek başımıza gidemeyiz. Dövüş konusunda yetenekli bir yol arkadaşına ihtiyacımız olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300121
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300121,
					"content": "Daha da önemlisi, Mantarlar o kadar tehlikeli olmasa bile iksirlerin yarattığı bu problem hocamızın kulağına giderse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300122
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300122,
					"content": "Tez önerilerimizin çöpe gideceği kesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300123
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300123,
					"content": "Özellikle de teslim edilen verilerde tek bir hata olması durumunda ciddi eleştirilere maruz kalınan Spantamad'da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300124,
						230300125
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300124,
					"content": "Pekala, bunu yapacağım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230300125,
					"content": "Daha önce böyle bir şey başınıza geldiğinde ne yapmıştınız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230300126
					]
				},
				{
					"id": 230300126,
					"content": "Eh, en yaygın çözüm bir maceracı tutmak olur. Bir keresinde de hocamızdan bizim için güvenilir birkaç Münzevi bulmasını rica ettik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300127
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300127,
					"content": "Yine de hocanın sabrı sonsuz değil tabii. Şu anki durumu düşününce onu tekrar rahatsız etmesek daha iyi olur dedik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300128
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300128,
					"content": "Lütfen bize yardım et Gezgin! Sen bizim tek umudumuzsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ladep"
				}
			]
		},
