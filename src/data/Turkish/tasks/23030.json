			},
			"dialogs": [
				{
					"id": 230300501,
					"content": "*öksürür*, *öksürür* *öksürür*... Burada sorun olmayacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300502
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300502,
					"content": "Off... Öğğk... Sen... Bunu sen yaptın! Sen neden kusuyorsun ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300503
					],
					"speakerTitle": "Pharez"
				},
				{
					"id": 230300503,
					"content": "Off... *öksürür**öksürür* *öksürür*",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230300504
					]
				},
				{
					"id": 230300504,
					"content": "Sana... Bunun içine kusmaya sebep olan maddeler eklediğimi bin kere açıkladım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300505
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300505,
					"content": "Buna alışık olup olmamak bir şey değiştirmiyor, koku herkeste otomatik olarak kusma refleksini tetikliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300506
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300506,
					"content": "Neden kendimi tekrar edip duruyorum ki? Zaten anlamıyorsun... Öğğk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300507
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300507,
					"content": "Ladep, Pharez ve Gezgin mi? Hepinizi buraya getiren şey ne olabilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300508
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230300508,
					"content": "İksir kavanozu da kırık... Burada bir canavar saldırısı mı oldu ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300509
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230300509,
					"content": "Görünüşe bakılırsa... Muhtemelen öyle olmuş. Buraya gelirken yolda hiç canavar gördün mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300510
					],
					"speakerTitle": "Ladep"
				},
				{
					"id": 230300510,
