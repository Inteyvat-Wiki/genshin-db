			"dialogs": [
				{
					"id": 240210101,
					"content": "Off... Ne koymuşlar bu kutunun içine ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210102
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210102,
					"content": "İyi misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210103
					]
				},
				{
					"id": 240210103,
					"content": "Yine karşılaştık Fahri Kıdemli Araştırmacı. Kusura bakma... Belimi... İncittim galiba... O kadar acıyor ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210104
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210104,
					"content": "Bir kutuyu bu tarafa çekip içindeki materyalleri düzenleyecektim de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210105
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210105,
					"content": "Kutunun bu kadar ağır olduğunu nereden bileyim? Kaldırırken vücudumu tam doğrultamadım, tüm yük belime bindi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210106
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210106,
					"content": "Şimdi de belim koptu kopacak resmen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210107,
						240210108
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210107,
					"content": "Seni doktora götürmemi ister misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210109
					]
				},
				{
					"id": 240210109,
					"content": "Hayır, gerek yok... Daha önce de belimi böyle incitmiştim. Biraz dinlensem yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210110
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210110,
					"content": "Paimon merak etti şimdi, kutunun içine ne koymuşlar da bu kadar ağır?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240210111,
					"content": "İçinde... Dünya kadar dosya vardır kesin. Enstitü bir zamanlar \"Önüne Geleni Belgele\" sloganıyla işliyordu zira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210112
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210112,
					"content": "Kısacası Enstitüde meydana gelen her şeyin somut olarak belgelenmesi gerekiyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210113
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210113,
					"content": "Bu prensiple çalışmaya başladıktan sonra Enstitünün kağıt kullanımı 5 kat arttı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210114
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210114,
					"content": "O kadar çok belge vardı ki her ofis, tüm o belge yığınlarını sınıflandırıp sıralayacak bir \"dosya yönetim birimi\" oluşturmak zorunda kalmıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210115
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210115,
					"content": "Yani her şeyin kağıda dökülmesi mi gerekiyordu? Öyle hayat mı geçer ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240210116,
					"content": "Aynen öyle. Sonra yavaş yavaş bu usulden vazgeçildi tabii. Yalnızca belirli konularda belge tutulmaya başlandı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210117
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210117,
					"content": "Neyse, şimdi bu konuların lüzumu yok. Bu dosya kutularını taşımama yardım eder misiniz Fahri Kıdemli Araştırmacı? Belim incindi incinmesine de bu dosyalar kendi kendini düzenlemeyecek nihayetinde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210118,
						240210119
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210118,
					"content": "Peki...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 240210119,
					"content": "Dinlenmeyi ihmal etme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210120
					]
				},
				{
					"id": 240210120,
					"content": "Merak etmeyin, belim kopmuş olabilir ama elim sağlam. Dosyaları düzenlemem için yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240210108,
					"content": "Sana bakması için birini çağırabilirim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210109
					]
				}
			]
		},
