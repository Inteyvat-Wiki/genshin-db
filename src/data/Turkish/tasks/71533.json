			"dialogs": [
				{
					"id": 715330101,
					"content": "Hay aksi, böyle de olmadı galiba... Hediye zarfı yapmak amma zormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330102
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330102,
					"content": "Mika, hediye zarfı mı yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715330103
					]
				},
				{
					"id": 715330103,
					"content": "#{NICKNAME}! Bu ne güzel tesadüf! Seni burada görmeyi beklemiyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330104
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330104,
					"content": "Fener Şenliğini kutlamaya mı geldin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715330105
					]
				},
				{
					"id": 715330105,
					"content": "Ha, yok. Bir mektup teslim etmek için gelmiştim ve tesadüfen Fener Şenliğine denk geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330106
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330106,
					"content": "Klee, Fener Şenliğine özel bu hediye zarflarından çok istediğini söyleyince gelmişken bir tane alayım dedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330107
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330107,
					"content": "Ama zarfları kendin yapıyormuşsun meğerse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330108
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330108,
					"content": "Yapmak için çok uğraştım ama beceremedim bir türlü. Nerede hata yaptığımı bir bilsem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330109
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330109,
					"content": "#{NICKNAME}, sen Liyue geleneklerine benden daha aşinasın... Biraz akıl verebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330110
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 715330110,
					"content": "Hımm, bir düşüneyim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
