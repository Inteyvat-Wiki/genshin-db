			},
			"dialogs": [
				{
					"id": 80070101,
					"content": "Anında küle dönüşeceğini düşünmüştüm... Halfdan'ın ruhu olağanüstü derecede dayanıklı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070102
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070102,
					"content": "Seni işgüzar soytarı! Bize ayak bağı olamayacaksın artık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070103
					],
					"speakerTitle": "Hiçlik Vaizi"
				},
				{
					"id": 80070103,
					"content": "Asıl ayak bağını unutuyorsun galiba. Ne duruyorsun? Bu benden kurtulman için büyük bir fırsat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070104
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070104,
					"content": "Dainsleif!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070105
					],
					"speakerTitle": "Hiçlik Vaizi"
				},
				{
					"id": 80070105,
					"content": "Şunun icabına baktıktan sonra cihazı devre dışı bırakın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				}
			]
		},
		{
			"id": 800703,
			"completionStepIds": [
				800703
