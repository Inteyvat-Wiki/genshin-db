			},
			"dialogs": [
				{
					"id": 80070901,
					"content": "Bu kadardı, değil mi? Cihaz tamamen kapandı herhalde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80070902,
					"content": "Yanma hissi kayboldu, evet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070903
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070903,
					"content": "Yani Hiçlik Tarikatının planına engel olabildik mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070904,
						80070905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80070904,
					"content": "Ama... Halfdan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80070906
					]
				},
				{
					"id": 80070906,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070907
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070907,
					"content": "Kontrol edeyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070908
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070908,
					"content": "Dain'in morali çok bozulmuş olsa gerek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80070909,
					"content": "O kadar zaman sonra eski yoldaşlarına bu halde kavuşmak... Ne kadar üzücü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80070910,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070911
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070911,
					"content": "... Gidelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070905,
					"content": "Son nefesini vermiş sanırım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80070906
					]
				}
			]
		},
		{
