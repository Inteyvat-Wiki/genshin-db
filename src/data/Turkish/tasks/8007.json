					"Dainsleif"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80071001,
					"content": "Halfdan'ın ruhuydu bu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071002,
					"content": "Burada birden fazla türde tuhaf güç var. Ruhların bu koşullarda ortaya çıkması hiç de garip değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071003
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071003,
					"content": "Yine de daha derinlere ilerleyip araştırmanıza devam edecekseniz dikkatli olmanız lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071004
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071004,
					"content": "*öksürür*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071005
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071005,
					"content": "Merak etme, çok dikkatli olacağız. Ha... Yani sen bizimle gelmiyor musun Dain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071006,
					"content": "Bu cihaz beni çok yıprattı. Kendimi toparlamam zaman alacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071007
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071007,
					"content": "Doğru... Şey, Paimon farkındaydı zaten! Bütün bu zamandır acıya katlanmaya çalıştığın çok belliydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071008,
					"content": "İyice dinlenmeyi hak ettin Dain... Hatta bir tatile çıksan güzel olurdu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071009,
					"content": "\"Tatil\" mi? Hah, tatil demek... Bu kelime bana çok uzak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071010
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071010,
					"content": "Dikkatimi vermem gereken daha mühim işler var. \"Kaderin Ağları\" operasyonu hâlâ devam ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071011
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071011,
					"content": "Tüm bu güçlendirme cihazları da o planla alakalıdır diye tahmin ediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071012,
						80071013
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071012,
					"content": "Ben de gözümü açık tutacağım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80071014
					]
				},
				{
					"id": 80071014,
					"content": "Anlayışın için teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071015
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071015,
					"content": "Umarım bir dahaki görüşmemizde kimin tarafında durduğuna emin olursun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071016
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80071016,
					"content": "Hah! Ne kadar kindarmış ya, en sonunda laf sokmayı da unutmadı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071017
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071017,
					"content": "Ne yazık ki kardeşini tekrar görme fırsatımız olmadı ama en azından işe yarar bilgiler edinebildik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071018
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071018,
					"content": "Yolculuğuna devam ettiğin sürece şüphesiz ki tekrar karşılaşacaksınız. Sonra da her şey normale dönecek. Değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071019
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071019,
					"content": "Ha, Paimon az kalsın unutuyordu... Buraya gelmemizin asıl nedeni dağ yabanilerine ne olduğunu öğrenmekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071020,
					"content": "Gidip madenciye anlatacak kadar şey gördük herhalde. İyi de... Ona bu durumu nasıl açıklayacağız? Olanlar o kadar karmaşık ki durumu bilmeyen bir insan hayatta anlamaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80071021
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071021,
					"content": "Neyse, bir yolunu buluruz herhalde. Buradaki işimiz bitince görevi tamamlamak için uğramayı unutmayalım yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80071013,
					"content": "Bir dahaki sefere daha çok konuşuruz. Sen iyileşmene bak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80071014
					]
				}
			]
		},
