				"points": []
			},
			"dialogs": [
				{
					"id": 80070301,
					"content": "Şimdi ne yapacağız? Hiçlik Vaizi gitti ama cihaz durmuyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80070302,
					"content": "Üstelik Halfdan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070303,
						80070304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80070303,
					"content": "Onun yerine ben geçeyim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80070305
					]
				},
				{
					"id": 80070305,
					"content": "Hayır! Cihaz etkin olduğu sürece lanetlenmiş olanlar güçsüz düşecektir. Hiçliğin icabına bakabilecek tek kişi sensin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070306
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070306,
					"content": "Onun yaptığı fedakarlığa değer veriyorsan zamanını burada daha fazla boşa harcama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070307
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070307,
					"content": "Şuradaki ışık hüzmelerini ve portalları görüyor musun? Farklı yerlere bu enerji cihazlarından koymuş olmalılar. Hepsini bulman lazım! Acele et!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80070308
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80070308,
					"content": "Yani bu Hiçlik portallarından geçmemiz mi lazım? Hop, Paimon'u da bekle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80070304,
					"content": "Arındırma gücünün benim üzerimde bir etkisi olmaz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80070305
					]
				}
			]
		},
		{
			"id": 800709,
			"completionStepIds": [
				800709
