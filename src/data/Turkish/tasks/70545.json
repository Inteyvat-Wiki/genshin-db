			"dialogs": [
				{
					"id": 705450101,
					"content": "Miyav, miyav miyav, miyaaavv.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450102,
					"content": "Miyav! Miyav miyav, miyav!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450103
					],
					"speakerTitle": "Tavşancık"
				},
				{
					"id": 705450103,
					"content": "Hımm... Hem Tavşancık hem Amber çok haklı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450104,
					"content": "Demek öyle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450105,
						705450106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450105,
					"content": "Çok zekice bir gözlem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450107
					]
				},
				{
					"id": 705450107,
					"content": "Aslında Paimon da pek anlamadı ama Amber ile Tavşancık'ın bir ortak fikirde buluştuğunu söyleyebilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450108,
					"content": "#{NICKNAME}, Paimon! Gelmişsiniz! Ben de tam sizi aramayı düşünüyordum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450109,
					"content": "Pisicik Kalesi'nde Valerina'ya ne kadar yardımcı olduğunuzu duydum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450110
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450110,
					"content": "#{NICKNAME} ile Paimon'un farkı bu işte! Mondstadt'a döndüğünüz anda yine birilerine hemen yardımınız dokundu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450111,
						705450112
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450111,
					"content": "Fahri Şövalye olarak, görevimi her ne olursa olsun yerine getireceğim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450113
					]
				},
				{
					"id": 705450113,
					"content": "Bu arada, az önce Tavşancık ile ne konuşuyordunuz? Çok eğlenceli bir sohbet ediyor gibiydiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450114,
					"content": "Miyav, miyav miyav?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450115
					],
					"speakerTitle": "Tavşancık"
				},
				{
					"id": 705450115,
					"content": "Tavşancık'a havanın nasıl olduğunu, yağmur yağıp yağmayacağını sordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450116
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450116,
					"content": "Ne? Kediler öyle şeylerden anlar mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450117,
					"content": "Hehe, Lisa bu konuda bir şeyler anlatmıştı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450118
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450118,
					"content": "Okuduğu kitapta kedilerin neme karşı çok hassas olduğu ve ıslanmayı hiç sevmedikleri yazıyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450119
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450119,
					"content": "Yani, nem oranında herhangi bir artış hissederlerse gergin bir şekilde patileriyle yüzlerini ovuşturmaya ve tüylerini yalamaya başlarlarmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450120
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450120,
					"content": "Kedinin böyle bir şey yapması büyük bir yağmurun yaklaştığına işaretmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450121
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450121,
					"content": "Vay canına, Paimon bunu hiç duymamıştı, çok harika bir bilgi bu! Az önce tesadüfen harika bir şey öğrendik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450122,
					"content": "#O halde, yolculuk boyunca kedilerin hareketlerine daha çok dikkat edelim {NICKNAME}! Bu şekilde... O kara bulutlar bizi artık sırılsıklam edemez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450123,
						705450124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705450123,
					"content": "Sanırım ileride daha çok dikkat etmemiz gerekecek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450125
					]
				},
				{
					"id": 705450125,
					"content": "Aslında ben buraya Valerina'ya bir şey sormaya gelmiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450126
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450126,
					"content": "Ama tam onunla konuşurken bu kedicik yanıma sokuldu ve çok sesli bir şekilde esnedi! O kadar sevimliydi ki anlatamam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450127
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450127,
					"content": "Bana karşı çok sıcak davrandığı için... Benim de ona ne kadar dost canlısı olduğumu göstermem gerek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450128
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450128,
					"content": "O esnada Lisa'nın bana dediklerini hatırladım ve gidip Tavşancık'a havanın nasıl olduğunu sordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450129
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450129,
					"content": "Ancak yüzünü ovuşturarak cevap verdi, sonra kuyruğunu salladı ve yere yatıp elime doğru sokuldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450130
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450130,
					"content": "*iç çeker* Yani birkaç güne yağmur yağacak mı, yağmayacak mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 705450124,
					"content": "Ben oldum olası sevimli kediciklerle çok dikkat ederim ki!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450125
					]
				},
				{
					"id": 705450112,
					"content": "Mondstadt'ın kedilerini savunmak benim birçok görevimden biri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450113
					]
				},
				{
					"id": 705450106,
					"content": "Bir dakika, ben anlayamadım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450107
					]
				}
			]
		}
	]
}