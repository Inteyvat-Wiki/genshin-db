			"dialogs": [
				{
					"id": 200360301,
					"content": "Yaptın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360302
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360302,
					"content": "Tepe çok rüzgarlıydı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360303
					]
				},
				{
					"id": 200360303,
					"content": "Güzel, biz de öyle olmasını istiyoruz. Böylece Karahindiba Tohumları uzaklara gidebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360304
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360304,
					"content": "Belki de gerçekten Godwin'e ulaşıp söylediklerimi iletirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360305
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360305,
					"content": "Elini uzat... İşte, bunları al. Teşekkür olarak kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360306
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360306,
					"content": "Godwin'e hâlâ söylemek istediğim bir sürü şey var. Gelecekte yine yardımına ihtiyacım olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Glory"
				}
			]
		}
	]
