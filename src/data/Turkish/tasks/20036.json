			},
			"dialogs": [
				{
					"id": 200360101,
					"content": "... Godwin... Ne zaman geri döneceksin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360102
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360102,
					"content": "Selam...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360103
					]
				},
				{
					"id": 200360103,
					"content": "Bu sesi tanıyorum... Demek uzaklardan gelen Gezginin sesiymiş! Yüce Rüzgar Hükümdarı'na şükürler olsun. Seni, rüzgarının rehberliğiyle buraya sürükledi... Senden bir isteğim var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360104
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360104,
					"content": "Erkek arkadaşım Godwin... Bildiğin üzere kendisi bir Favonius Şövalyesi... Çok uzun süre önce şehirden ayrıldı ve henüz geri gelmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360105
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360105,
					"content": "Gittiğinden beri ondan hiç haber almadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360106
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360106,
					"content": "Onun için çok endişeleniyorum. Zavallı Godwin, ya kötü dağ yabanileriyle karşılaşırsa? Ya da, Hiçlik Tarikatıyla savaşta olduklarını söylemişti, ya yaralanırsa? Şimdi de... O kadar uzun süredir uzaklarda ki, ya diğer güzel şövalyeleri beğenmeye başlarsa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360107
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360107,
					"content": "... Ah, üzgünüm! Kendimi kaptırdım. Annem her zaman karahindibaların insan arzularını çok uzaklara taşıdığını söylerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360108
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360108,
					"content": "Şimdi talebime gelirsek... Benim için Rüzgaralan'dan üç tane Karahindiba tohumu toplar mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360109,
						200360110
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360109,
					"content": "Elbette.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360111
					]
				},
				{
					"id": 200360111,
					"content": "Çok teşekkür ederim! Rüzgar Hükümdarı seni korusun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360110,
					"content": "Yapacak daha önemli işlerim var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360112
					]
				},
				{
					"id": 200360112,
					"content": "Bekle! Yalvarırım bana yardım et. Senin gibi deneyimli bir Gezgin için bu iş çocuk oyuncağıdır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Glory"
				}
			]
		},
