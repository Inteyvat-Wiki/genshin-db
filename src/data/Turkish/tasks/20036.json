			"dialogs": [
				{
					"id": 200360201,
					"content": "Hoş geldin, Karahindiba Tohumlarımı getirdin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360202
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360202,
					"content": "Evet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360203
					]
				},
				{
					"id": 200360203,
					"content": "Teşekkür ederim! Lütfen tohumları avucuma koyar mısın? Aksi takdirde göremediğim için onları kaybedebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360204
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360204,
					"content": "Bunlar yeterli olur mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200360205
					]
				},
				{
					"id": 200360205,
					"content": "Avucuma koyar mısın? Ancak öyle anlayabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360206
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360206,
					"content": "Bu kadarı yeter. Şimdi Godwin'e söylemek istediğim her şeyi bunlara söyleyeceğim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360207
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360207,
					"content": "Şey, lütfen kulaklarını tıka. Gizlice dinlemek yok! Bu, sevgililerin özeli. Anlarsın ya... *kıkırdar* Sen de benzer şeyler yaşamışsındır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360208
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360208,
					"content": "Tamamdır, işim bitti. Şimdi bunları Rüzgar Hükümdarı heykelinin üstüne çıkarıp rüzgara doğru bırak. Yüce hükümdar gerisini bizzat halleder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200360209
					],
					"speakerTitle": "Glory"
				},
				{
					"id": 200360209,
					"content": "Umarım tohumları Godwin'e gönderir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Glory"
				}
			]
		},
