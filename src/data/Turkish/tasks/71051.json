			"dialogs": [
				{
					"id": 710500801,
					"content": "Suyun yanındaki tuhaf nesne hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500802
					]
				},
				{
					"id": 710500802,
					"content": "Ne? Onu suyun yanına mı koydun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500803
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500803,
					"content": "Nasıl gitti? Özel bir şey oldu mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500804
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500804,
					"content": "Bir Toprak Ejderi ortaya çıktı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500805
					]
				},
				{
					"id": 710500805,
					"content": "Toprak Ejderi mi? Suyun içindeyken bir Toprak Ejderine mi dönüştü o?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500806
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500806,
					"content": "Ha anladım. Toprak Ejderine dönüşmedi, bir Toprak Ejderini oraya çekti demek istiyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500807
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500807,
					"content": "Az daha yüreğime iniyordu! Bir Toprak Ejderine dönüşmüş olsaydı, dünyaya bakış açım altüst olurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500808
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500808,
					"content": "O şey tam olarak nedir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500809
					]
				},
				{
					"id": 710500809,
					"content": "Çok basit aslında. Nasıl ifade etsem? Hım, ilk önce neden bana o Toprak Ejderiyle ilgili özel bir durum olup olmadığından bahsetmiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500810
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500810,
					"content": "Mesela Su elementi kullanıyor muydu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500811,
						710500813
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500811,
					"content": "Öyle bir şey.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500812
					]
				},
				{
					"id": 710500812,
					"content": "Aşağı yukarı doğru tahmin ettim demek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500816
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500816,
					"content": "O Toprak Ejderi muhtemelen Su elementini kullanabiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500817
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500817,
					"content": "Kanyon'un yer altı sularında yoğun miktarda Su enerjisi bulunuyor. Bu yüzden, yüksek yoğunluğa sahip bazı alanlar, senin balık tutarken yakaladığın su yosununa benzeyen nesne için beslenme alanına dönüşmüş oluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500818
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500818,
					"content": "Toprak Ejderi ile onun gibi Kanyon'da yaşayan ve suyu seven diğer yaratıklar, bu Su elementi bakımından zengin su yosunlarını tüketerek güçleniyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500819
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500819,
					"content": "Yani o nesne, aslında sadece Su elementi bakımından zengin bir su yosunu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500820
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500820,
					"content": "Demek yalnızca bir su yosunuymuş...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500821
					]
				},
				{
					"id": 710500821,
					"content": "Evet, sadece bir su yosunu. Tek farkı yoğun miktarlarda Su elementi enerjisi içeriyor olması.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500822
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500822,
					"content": "Bunlara sıradan çevre koşullarında pek rastlanmaz. Yalnızca yoğun ve saf bir güç, suyun kaynağını başkalaştırdıysa... Aman neyse ne, bu su yosunları...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500823
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500823,
					"content": "Bir gün duygulara sahip element varlıklarına dönüşebilir. Bak ne diyeceğim? Aslında bundan iyi araştırma konusu olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500813,
					"content": "Fark etmedim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500814
					]
				},
				{
					"id": 710500814,
					"content": "#Özelliğini fark etmeye fırsat bulamadan, onu çabucak alt etmiş olmalısın. Çok etkileyici. Sana boşuna efsanevi {NICKNAME} demiyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500815
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500815,
					"content": "Benim hipotezim şu şekilde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500816
					],
					"speakerTitle": "Khedive"
				}
			]
		}
	]
