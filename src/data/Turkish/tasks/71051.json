			"dialogs": [
				{
					"id": 710500501,
					"content": "Tuhaf nesne hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500502
					]
				},
				{
					"id": 710500502,
					"content": "Bunu balık tutarken mi buldun? Hımm, aslında ilk bakışta gerçekten de balık yemine benziyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500503
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500503,
					"content": "İnsanların balık tutarken böyle şeyler bulması normal mi? Watatsumi Adası'nda her gün balık tutmasına rağmen, Anisa bugüne dek özel bir şey bulmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500504
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500504,
					"content": "Belki de keramet balıkçıdadır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500505
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500505,
					"content": "Bir bakayım. Hımm, içinde oldukça yoğun miktarda Su enerjisi bulunduğunu hissedebiliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500506
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500506,
					"content": "Kanyon'daki yer altı suları, element güçleri bakımından olağan dışı bir zenginliğe sahip. Bu zenginliğin, bu tip şeylerin ortaya çıkmasıyla bir ilgisi var mıdır acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500507
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500507,
					"content": "Gerçi nesnenin içindeki element enerjisi, onu sudan çıkardığından beri azalıyor. Belki de gücünün nelere kadir olduğunu görmek için onu suyun yanına yerleştirmemiz gerekiyordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500508
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500508,
					"content": "Suyun yanına mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500509
					]
				},
				{
					"id": 710500509,
					"content": "Evet, bir de onu Su enerjisiyle etkinleştirmemiz gerekiyor. Böylece içindeki sırları keşfedebiliriz diye düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500510
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500510,
					"content": "Sen gidip de onu etkinleştirmeye ne dersin? Sonuçta onu bulup çıkaran sensin. Elde ettiğin sonuçlar hakkında beni bilgilendirirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500511
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710500511,
					"content": "Bulgular akademik değere sahip olursa, sana ödeme yaparım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				}
			]
		},
		{
			"id": 7105008,
