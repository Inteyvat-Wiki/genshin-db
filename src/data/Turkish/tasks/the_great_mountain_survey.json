					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701040303
					]
				},
				{
					"id": 701040303,
					"content": "Harika, çok yardımın dokundu. Bunları ve tekrardan her şey için teşekkürlerimi kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040304
					],
					"speakerTitle": "Esther"
				},
				{
					"id": 701040304,
					"content": "Gözlem için bu kadar az işaretçi varken ilginç bir şeyler bulabilecek miyim acaba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Esther"
