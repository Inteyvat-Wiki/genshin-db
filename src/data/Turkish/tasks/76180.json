			"dialogs": [
				{
					"id": 761800401,
					"content": "Eskiden hep senin bahçende toplanırdık Sandrone. Şimdiyse çaya bana misafir olan sensin. Ne kadar da tuhaf bir his.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800402
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761800402,
					"content": "Her şeyi hazırlayan yine benim. Benlik değişen pek bir şey yok yani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800403
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761800403,
					"content": "Hı hı, yemeklerin de hatırladığım kadar lezzetli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800404
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761800404,
					"content": "#Hımm... Duyduğuma göre {NICKNAME} sık sık ziyaretine geliyormuş. Genelde neler yapıyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800405
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761800405,
					"content": "Bazen sohbet ediyoruz, Kuuhenkilerle oyunlar oynuyoruz ya da resim çizmelerini izliyoruz. Bir de Ay Satrancı oynuyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800406
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761800406,
					"content": "Ay Satrancı mı? Hani şu üç taşı yan yana dizmeye çalıştığımız oyun değil mi o? Peki genelde kim kazanıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800407
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761800407,
					"content": "#Hiç hesabını tutmadım ama {NICKNAME} çok iyi oynuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800408
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761800408,
					"content": "Heh, gerçek beceri neymiş göstereyim sana. Bir oyuna var mısın? Berabere kalırsak sen kazanmış sayılırsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800409
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761800409,
					"content": "Varım. Hadi oynayalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Küçük Hanım"
				}
			]
		},
		{
			"id": 7618006,
			"completionStepIds": [
				7618004
			],
