			},
			"dialogs": [
				{
					"id": 761800801,
					"content": "Oyun oynamak çok zevkli. Bunu daha sık tekrarlamak isterim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800802,
						761800803
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761800802,
					"content": "(Biraz daha oturalım.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800804
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761800804,
					"content": "Hemen gidiyor musun? Peki o zaman, bir dahakine görüşürüz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761800803,
					"content": "Yavaş yavaş toparlansam iyi olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800804
					],
					"speakerTitle": "Kukla"
				}
			]
