					"Küçük Hanım"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761800601,
					"content": "N-Ne? Bu imkansız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800602
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761800602,
					"content": "Görünüşe göre kaybettin Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800603
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761800603,
					"content": "Ben... Bilerek yenildim bir kere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800604
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761800604,
					"content": "Hadi ya? O zaman bu gerginlik niye?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800605
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761800605,
					"content": "Kahretsin... Bir el daha oynayalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800606
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761800606,
					"content": "Hıh, çocuk oyuncağıydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800607
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761800607,
					"content": "Sen kazandın. Gerçekten çok yeteneklisin Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800608
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761800608,
					"content": "Bir dahakine daha zorlayıcı bir şeyler oynayalım. Matematiğe dayalı çok eğlenceli oyunlar biliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800609
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761800609,
					"content": "Harika olur! Haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800610
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761800610,
					"content": "Hı? Komik olan ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800611
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761800611,
					"content": "Seni daha önce bu kadar mutlu gördüğümü pek hatırlamıyorum. Beni oyun oynamaya kırk yılda bir davet ederdin, genelde de yanından kovardın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800612
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 761800612,
					"content": "Hey... Adımı zorbaya çıkarma şimdi! Bundan sonra seni çay saatine daha sık davet edeceğim, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761800613
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 761800613,
					"content": "Çok isterim Sandrone. Bu ufak buluşmalarımızı çok seviyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Küçük Hanım"
				}
			]
		},
