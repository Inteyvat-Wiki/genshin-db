			"dialogs": [
				{
					"id": 741870201,
					"content": "Hişt, sen! Evet, sen! Seni kafasız budala seni! Ne diye oyalanıyorsun? Sallana sallana iş yapıyor bir de... O hazineler kendi kendini mi taşıyacak sandın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870202
					],
					"speakerTitle": "Lider"
				},
				{
					"id": 741870202,
					"content": "Hayır efendim! Hazineler çok ağır da ondan! Tüm gün bununla uğraştık ama taşı taşı bitmiyorlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870203
					],
					"speakerTitle": "\"Aptal\" Dedikleri Adam"
				},
				{
					"id": 741870203,
					"content": "Senin gibi bir insan azmanının karnını boşuna mı doyuruyorum ben? Hazine bu, kaz kafalı seni, hazine! Elbette ağır olacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870204
					],
					"speakerTitle": "Lider"
				},
				{
					"id": 741870204,
					"content": "Hem bu hazineleri o adı batasıca barbarlardan \"aldık\" biz, öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870205
					],
					"speakerTitle": "Lider"
				},
				{
					"id": 741870205,
					"content": "Böyle bir serveti domuzlar gibi yaşayan o haşerelere bırakacak göz var mı bende?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870206
					],
					"speakerTitle": "Lider"
				},
				{
					"id": 741870206,
					"content": "Tüm bunları Remuria'ya götüreceksek yanımızda birkaç gemi daha getirseydik keşke efendim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870207
					],
					"speakerTitle": "\"Aptal\" Dedikleri Adam"
				},
				{
					"id": 741870207,
					"content": "Kafan basmıyor mu senin? İmparatorluğun kargo gemilerini böyle şeyler için kullanamayız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870208
					],
					"speakerTitle": "Lider"
				},
				{
					"id": 741870208,
					"content": "Taşıyamadıklarımızı yok edelim madem! O yabanilerin eline geçmesinden iyidir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870209
					],
					"speakerTitle": "\"Aptal\" Dedikleri Adam"
				},
				{
					"id": 741870209,
					"content": "Paimon'a mı öyle geliyor, yoksa bu konuşmayı daha önce de dinledik mi biz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870210,
						741870211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870210,
					"content": "Petrichor'a ilk geldiğimiz zamanı anımsattı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870212
					]
				},
				{
					"id": 741870212,
					"content": "Doğru ya, kovduğumuz o talihsiz maceracılar da benzer şeyler söylüyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870213,
					"content": "Bu seferki, öncekinden çok daha beter üstelik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870214,
					"content": "Bindikleri gemi battıktan sonra goleme dönüşmüş olabilirler mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870215,
					"content": "Çok korkunç!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870216,
					"content": "Siz IX. Lejyondan mısınız bakayım? Burada ne işiniz var? Charybdis Kalesi'ne geri çekilmeniz emredilmemiş miydi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870217
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870217,
					"content": "Selam Este! Eğlencemizi bozmaya kalkma sakın, duydun mu beni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870218
					],
					"speakerTitle": "Lider"
				},
				{
					"id": 741870218,
					"content": "Ölü bir balık bile bu barbarlardan daha tehlikelidir doğrusu. O yüzden bırak da bu civarda biraz takılalım, olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870219
					],
					"speakerTitle": "Lider"
				},
				{
					"id": 741870219,
					"content": "Bu hazineler... *iç çeker* Harmost size ne emri verdi bilmiyorum ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870220
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870220,
					"content": "Sebastos bu kendini bilmez kabileleri hizaya getirip onları kaderin pençelerinden kurtarmamızı emretmedi mi bize? Böyle ulu orta suç işleyin falan demedi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870221
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870221,
					"content": "Hah. Şaka yapıyorsun herhalde! Komutanımız Dominus Boethius gerçekten de bize bu yabanileri ağır bir şekilde cezalandırmamızı buyurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870222
					],
					"speakerTitle": "Lider"
				},
				{
					"id": 741870222,
					"content": "Yaptıklarımız karşısında ceza da almadık. Yani hem Phobos hem de İmparatorumuz Sebastos eylemlerimizi onaylıyor demek bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870223
					],
					"speakerTitle": "Lider"
				},
				{
					"id": 741870223,
					"content": "Nereden çıktı şimdi bu suç işleme meselesi? Hiç yoktan olay çıkarmaya çalışma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870224
					],
					"speakerTitle": "Lider"
				},
				{
					"id": 741870224,
					"content": "İyi ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870225
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870225,
					"content": "Burada başka bir Este daha mı var? İşler gitgide tuhaflaşıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870226,
					"content": "Sorunuzu yanıtlama vakti geldi anlaşılan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870227
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870227,
					"content": "Kasabada karşılaştığınız Este, Remurialıların soyundan geliyor. Ataları, yıllar önce benim izimden giderek yeni ulusa katıldı ve sıradan bir Fontaineli oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870228
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870228,
					"content": "Bu yüzden Fontainelilerin ruhunu çalan \"senfoni\" onu etkilemiyor. Dolayısıyla atasının anılarının kayıtlı olduğu melodi, gidecek başka bir yer bulamamış ve o heykele tutunmuş olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870229
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870229,
					"content": "Buradaki Este, Kasabalı Este'in atası mı diyorsun şimdi? Gerçek \"Bitirim Este\" mi yani? Peki ya diğerleri?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870230,
					"content": "Hepsi eski anılarda kaybolmuş ve etrafta dolaşan ruhlar. Hadi gidip bir göz atalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870231
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870231,
					"content": "Mösyö Os ile birlikte yürüyorsunuz...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741870232
					]
				},
				{
					"id": 741870232,
					"content": "Selam Este!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870233,
					"content": "Merhaba! Siz de kimsiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870234
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870234,
					"content": "Remurialıya benzemiyorsunuz. Yabani misiniz o halde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870235,
						741870236
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870235,
					"content": "Ben yoldan geçen bir gezginim sadece.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870237
					]
				},
				{
					"id": 741870237,
					"content": "Eh, burası bir savaş meydanı ve kendinizi büyük bir tehlikenin içine atmışsınız. Şu noktada kim olduğunuz fark etmez, buradan ayrılmalısınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870238
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870238,
					"content": "Este, benim ben. Epeydir görüşmedik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870239
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870239,
					"content": "... Aman tanrım. Demek sizsiniz Dominus Cassiodor! Nadiren bu surete bürünüyorsunuz, az kalsın tanıyamıyordum sizi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870240
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870240,
					"content": "Bu ikisi... Hizmetkarlarınız mı yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870241,
						741870242
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870241,
					"content": "Öyle de diyebilirsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870245
					]
				},
				{
					"id": 741870245,
					"content": "Peki ama neden buraya geldiniz Dominus Cassiodor? Sebastos sizi... Lanetlememiş miydi? Hatırlayamıyorum! Rüya falan mı görüyorum yoksa şu an?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870246
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870246,
					"content": "Öyle görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870247
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870247,
					"content": "Haha! Şaka yapıyorsunuz herhalde! Sebastos size yine bir gizli görev vermiş olmalı, yanılmıyorum değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870248
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870248,
					"content": "Doğru bildin. Konusu açılmışken sorayım, şu IX. Lejyonun askerleri neden hâlâ o zincirleri koruyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870249
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870249,
					"content": "Zincirler derken... Hazineden mi bahsediyorsunuz? Bildiğim kadarıyla onlar savaş esnasında ele geçirilen ganimetler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870250
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870250,
					"content": "Sebastos, savaşı büyük hedeflerimizi gerçekleştirme yolunda atmamız gereken üzücü fakat gerekli bir adım olarak görmesine ve bunun gibi acımasız davranışları da uzun süre önce yasaklamış olmasına rağmen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870251
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870251,
					"content": "Sizin de bildiğiniz üzere bu tarz şeyler sıradanlaştı artık... Kimse olan bitenin farkında olmasa da karanlığa doğru sürükleniyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870252
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870252,
					"content": "Dominus Cassiodor, ne oldu? Phobos güya bize mutluluk getirecekti ama adını koyamadığım bir acıdan başka bir şey hissetmiyorum ben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870253
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870253,
					"content": "Ben de bu sorunun cevabını arıyorum ama önce mevcut sorunla ilgilenmemiz gerekecek belli ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870254
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870254,
					"content": "Evet. Yine de onlar hâlâ bizim askerlerimiz! Mümkünse sorunu barışçıl bir şekilde çözelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Este"
				},
				{
					"id": 741870242,
					"content": "Aslında onun sahibiyim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870243
					]
				},
				{
					"id": 741870243,
					"content": "... Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870244
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870244,
					"content": "#Ortalığı karıştırıp durmasana {NICKNAME}! Merak etme Este, şaka yapıyordu sadece. Lütfen devam et sen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870236,
					"content": "Yabana atılmaması gereken bir yabaniyim ben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870237
					]
				},
				{
