			"dialogs": [
				{
					"id": 741870901,
					"content": "Önceki sorunumuzu çözdünüz anlaşılan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870902
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870902,
					"content": "Sanırım bu, bir sonraki hedefinize doğru hızla ilerleyeceğiniz manasına geliyor, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870903
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870903,
					"content": "Evet. Burası sana emanet Este...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870904
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870904,
					"content": "Unutma, doğru ve yanlış muhakemesini tamamen Phobos'a veya herhangi bir Harmost'a bırakmak yerine kalbinin bilgeliğini dinlemelisin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870905
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870905,
					"content": "Sebastos, bizi kaderimizin esiri olmaktan kurtarmak için Phobos'u yarattı. Ne var ki insanların ona körü körüne inanması bizi daha feci bir esarete sürükledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870906
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870906,
					"content": "Gelecekte tekrar buna benzer bir seçim yapman gerekebilir. Umarım o zaman doğru kararı verirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870907
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870907,
					"content": "Neden böyle şeyler söylemeye başladınız birden Dominus Cassiodor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870908
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870908,
					"content": "Yine de söylediklerinizi aklımın bir köşesinde bulunduracağım. Bendeniz Este artık kendi adalet muhakememi kendim yapacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870909
					],
					"speakerTitle": "Este"
				},
				{
					"id": 741870909,
					"content": "Ne güzel. Elveda Este. Elbet bir gün tekrar görüşeceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Osse"
				}
			]
		},
