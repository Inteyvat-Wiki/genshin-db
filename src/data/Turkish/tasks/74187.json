					}
				]
			},
			"dialogs": [
				{
					"id": 741870601,
					"content": "Öhöm, IX. Lejyonun askerleri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870602,
					"content": "Hı? Siz de kimsiniz? Este'in minik yardımcıları mısınız yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870603,
						741870605,
						741870607
					],
					"speakerTitle": "Lider"
				},
				{
					"id": 741870603,
					"content": "Aynen öyle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870604
					]
				},
				{
					"id": 741870604,
					"content": "Biz sıradan yardımcılar değiliz! Dominus Cassiodor ile birlikte gelen ve ona yardım için hazır olan güçlü yardımcılarız biz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870609,
					"content": "(Rol yapmaya epey de meraklısınız bakıyorum.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870610
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870610,
					"content": "Dominus Cassiodor demek... Sebastos'un onu Aremorica'ya gönderdiğini duymuştum. Ne çabuk dönmüş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870611
					],
					"speakerTitle": "Lider"
				},
				{
					"id": 741870611,
					"content": "Şey, aslında yanımızdaki kişi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870612,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870613
					],
					"speakerTitle": "Osse"
				},
				{
					"id": 741870613,
					"content": "N-Neyse, öyle işte! Ön saflardaki lejyonları görmeye geldik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870614,
					"content": "Evet. O kadarını anlamıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870615
					],
					"speakerTitle": "Lider"
				},
				{
					"id": 741870615,
					"content": "Yani ana birliklerle Charybdis Kalesi'ne gitmedik sonuçta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870616
					],
					"speakerTitle": "Lider"
				},
				{
					"id": 741870616,
					"content": "Ama biz artçı birlikleriz, o yüzden son \"temizlik\" işlerini yapmak da bizim görevimiz dahilinde, öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870617
					],
					"speakerTitle": "Lider"
				},
				{
					"id": 741870617,
					"content": "Bu da Phobos'tan gelen bir emir mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870618
					]
				},
				{
					"id": 741870618,
					"content": "Phobos'un her hareketimizi yönlendirmesi gerekiyordu fakat buraya geldiğimizden beri melodisini duyamaz olduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870619
					],
					"speakerTitle": "Lider"
				},
				{
					"id": 741870619,
					"content": "Bu yüzden biz de Dominus Boethius'un talimatlarına göre hareket ettik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870620,
						741870623
					],
					"speakerTitle": "Lider"
				},
				{
					"id": 741870620,
					"content": "Ah, şu küstah adam...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870621
					]
				},
				{
					"id": 741870621,
					"content": "Kim olduğunu sanıyorsun sen? Dominus Boethius'un adını nasıl öyle ağzına alabilirsin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870622
					],
					"speakerTitle": "Lider"
				},
				{
					"id": 741870622,
					"content": "Onun kadar saygın bir Harmost her konuda Sebastos'un talimatlarıyla hareket eder. Onun emirleri, Phobos'un emirleri gibidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870626,
						741870628
					],
					"speakerTitle": "Lider"
				},
				{
					"id": 741870626,
					"content": "Phobos da bir hata yapmış olabilir belki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870627
					]
				},
				{
					"id": 741870627,
					"content": "Remurialı olduğuna emin misin sen? Phobos'un sonsuz güce sahip Sebastos ve kusursuz kahin tarafından yaratıldığını bilmiyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lider"
				},
				{
					"id": 741870628,
					"content": "Ama melodiyi de duyamıyorsunuz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870629
					]
				},
				{
					"id": 741870629,
					"content": "Evet, doğru. Ama Phobos'tan başka neye güvenebiliriz ki biz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870630
					],
					"speakerTitle": "Lider"
				},
				{
					"id": 741870630,
					"content": "Doğru yoldan çıkacak olsaydık öylece kayıtsız kalmazdı, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lider"
				},
				{
					"id": 741870623,
					"content": "Sebastos, masum insanlara bir zarar gelmesine asla izin vermez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870624
					]
				},
				{
					"id": 741870624,
					"content": "Masum insanlar demek... Doğru, savaş başlamadan önce bizi savunmasız insanlara yardımcı olmakla görevlendirmişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870625
					],
					"speakerTitle": "Lider"
				},
				{
					"id": 741870625,
					"content": "Ama yaptığımız her şeyde Phobos'un onayını aldık. Onun emirleri ile Sebastos'un kutsal emirleri birbiriyle çelişiyor olabilir mi acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870626,
						741870628
					],
					"speakerTitle": "Lider"
				},
				{
					"id": 741870605,
					"content": "İmparator Sebastos'un gönderdiği hususi elçileriz biz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870606
					]
				},
				{
					"id": 741870606,
					"content": "Ne biçim rütbe ismi o ya... Tamamen yanlış da sayılmaz gerçi. Dominus Cassiodor ile birlikteyiz sonuçta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741870607,
					"content": "Cassiodor'un uşaklarıyız biz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741870608
					]
				},
				{
					"id": 741870608,
					"content": "Aynen öyle! Dominus Cassiodor'un sadık uşaklarıyız biz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870609
					],
					"speakerTitle": "Paimon"
				}
			]
		},
