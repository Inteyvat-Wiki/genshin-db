			"dialogs": [
				{
					"id": 741870701,
					"content": "Pekala... Doğru söylüyorsunuz. Yaptıklarımızı bir gözden geçirmeliyiz. Aslında ben... İşlerin nasıl bu noktaya geldiğini anlayamadım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870702
					],
					"speakerTitle": "Lider"
				},
				{
					"id": 741870702,
					"content": "Savaş çıktığından beri içimde tuhaf bir his var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870703
					],
					"speakerTitle": "Lider"
				},
				{
					"id": 741870703,
					"content": "Aslında amacımız özgürlüğün ve mutluluğun peşinden koşmaktı ama Phobos bizi adım adım buraya getirdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870704
					],
					"speakerTitle": "Lider"
				},
				{
					"id": 741870704,
					"content": "Bir sorun mu çıktı acaba? Çıktıysa da ne tür bir sorun var ortada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870705
					],
					"speakerTitle": "Lider"
				},
				{
					"id": 741870705,
					"content": "Döndüğünüzde Sebastos'la görüşürseniz lütfen ona durumumuzdan ve şüphelerimizden bahsedin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870706
					],
					"speakerTitle": "Lider"
				},
				{
					"id": 741870706,
					"content": "Bize büyük bir iyilik yapmış olursunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741870707
					],
					"speakerTitle": "Lider"
				},
				{
					"id": 741870707,
					"content": "Merak etme, bahsederiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
