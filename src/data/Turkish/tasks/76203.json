			"dialogs": [
				{
					"id": 762030501,
					"content": "Bu resimlerin hepsi bana kalbimde büyük önem taşıyan yerleri hatırlatıyor. Artık stüdyo da tamamen restore edildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030502
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030502,
					"content": "Pekala, gidip ödülümüzü alın. Ne oldu? Bana öyle bakmayın! Bu ödül elbette \"bizim\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030503
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030503,
					"content": "Bu sandığı açmadan gitmeyeceksiniz herhalde, değil mi? Eğer açmazsanız gitmenize izin veremem. Hem size o kadar hikaye anlattım, ben de bir ödülü hak etmedim mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
