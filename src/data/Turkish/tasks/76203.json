			"dialogs": [
				{
					"id": 762030101,
					"content": "Aa, geldiniz demek! Ben de tam size daha açık talimatlar mı yollasam diye düşünmeye başlamıştım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030102
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030102,
					"content": "Ama sonra düşündüm ki, ipuçlarımı çok bariz hale getirirsem seyahat planlarınıza engel olabilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030103
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030103,
					"content": "Ve sonra tam acaba ne yapsam diye düşünürken... Siz çıkageldiniz! Yani anlaşılan her şey yoluna girmiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030104
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030104,
					"content": "Nicole! Bugün ne kadar da enerji dolusun! Ve de kelimelerle... Kelimelerle dolusun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030105,
					"content": "Bunu bir iltifat olarak alıyorum! Pekala, bir sonraki odamı görmeye hazır mısınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
		{
			"id": 7620302,
