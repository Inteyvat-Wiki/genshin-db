							-40.547
						],
						"pointId": 9
					}
				]
			},
			"dialogs": [
				{
					"id": 762030301,
					"content": "Bu Irminsul ağacı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030302,
					"content": "Ha, bu resmi mi diyorsun? Beyaz ağaçlara yabancı değilsinizdir tabii... Ama ilk meleğin ihanetinin tam da bu ağaçlardan birinin dallarının altında gerçekleştiğini biliyor muydunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030303,
						762030304
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030303,
					"content": "Bilmiyordum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762030305
					]
				},
				{
					"id": 762030305,
					"content": "Hım, Paimon merak etti şimdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030306,
					"content": "Öyleyse sanırım artık size aşk ve korku dolu bir hikaye anlatma zamanı geldi. Olayda yer alanların kimliğini en iyi nasıl gizleyebilirim acaba, bir düşüneyim... Tamamdır, buldum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030307
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030307,
					"content": "Çok uzun zaman önce yıldızlar arasında dolanan bir gezgin vardı. Senden çok farklı bir gezgindi... Ama şu an bunun bir önemi yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030308
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030308,
					"content": "Bir gün Seher Yıldızı Prensesi'ni ziyaret etmek için gümüş bir ağaca gitti. Çok geçmeden ona krallığının en yasaklı sırlarını sormaya başladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030309
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030309,
					"content": "Söyledikleri prensesin kafasını karıştırmıştı. Bu adam, tanrıların yasakladığı tüm bu konuları nasıl bilebilirdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030310
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030310,
					"content": "Genç adam kökenini açıkladı ve prensese daha önce hiç görmediği şeyleri gösterdi; özgür iradeyi, hem asil hem de ruhani sevgiyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030311
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030311,
					"content": "Sözleri, o güne dek tanrıların zincirlediği benliğini uyandırdı. Kalbi yükselerek onu daha önce hiç aşmadığı sınırların ötesine taşıdı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030312
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030312,
					"content": "Seher Yıldızı Prensesi krallığın sırlarını gence açtı ve aralarında, tanrılara meydan okuma kararlılığıyla birlikte bir aşk büyüyüp serpildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030313
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030313,
					"content": "E bu bildiğin sıradan bir aşk hikayesi! Hani içinde korku olacaktı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030314,
					"content": "Merak etme Paimon, korku şimdi başlıyor. İnsanların sınırsız bir özgürlük içinde yaşamalarını sağlamayı çok istediler lakin tanrılar onların ihanetini affetmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030315
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030315,
					"content": "Yıldırımlarla ve öfkeleriyle aşıkların yuvasını yok ettiler. Büyük savaş sona erdiğinde ise prensesin gücü ve bilgeliği bir daha asla geri dönmemek üzere kayboldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030316
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030316,
					"content": "En yakın arkadaşları bile lanetlenmişti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030317
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030317,
					"content": "... Iıı, tamam... Hikayenin sonu bayağı korkunçmuş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030318,
					"content": "Ama bize ilk melekten bahsedeceğini söylememiş miydin? Ve, ve... Bu hikayenin gerçekten doğru olduğunu söylemiyorsun, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030319,
					"content": "Doğru tabii, en korkunç kısmı da bu ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030320
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030320,
					"content": "Öyleyse sanırım artık size aşk ve korku dolu bir hikaye anlatma zamanı geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030321
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030321,
					"content": "Olayda yer alanların kimliğini en iyi nasıl gizleyebilirim acaba, bir düşüneyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030322
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030322,
					"content": "Tamamdır, buldum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030304,
					"content": "Tanıdık geldi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762030305
					]
				}
			]
		},
