				]
			},
			"dialogs": [
				{
					"id": 762030401,
					"content": "Aa, burası Simulanka! Şey... Ama neden yerde Yae Yayınevi'nin resimli romanları var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030402,
					"content": "Edebiyatla nasıl tanıştığım konusuna gelirsek, en büyük ilham kaynağım... Leydi Anya'nın ta kendisidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030403
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030403,
					"content": "Cadılar Meclisine katılan son kişi olmasına rağmen ilk ayrılan da o oldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030404
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030404,
					"content": "Onun tüm hikayelerine bayılırdım. İster yalnızca bir fikir olsun ister tamamlanmış bir taslak metin, Anya okurlarını her zaman sevinçle dolduracak kadar becerikliydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030405
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030405,
					"content": "Cadılar Meclisindeki tartışmalar nadiren büyünün dışına çıkar. Ben Anya'nın kendine özgü bir büyüsü olduğuna inanıyorum. Sevgiyi ve şefkati kelimelere, hikayelere dökerek başkalarının kalbine dokunurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030406
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030406,
					"content": "Ondan bana nasıl sürükleyici masallar yazılabileceğine dair ipuçları vermesini istedim. Bana bir sürü püf nokta ve teknik öğretti ama nihayetinde en büyük düşmanım hep kendim oldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030407
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030407,
					"content": "Hikayeleri kağıda dökmeye üşeniyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762030408
					]
				},
				{
					"id": 762030408,
					"content": "Haha! Öyle de denebilir. Düşüncelerle iletişim kurmak çok daha pratik. Sanırım melekler bile tembelliğe yenik düşebiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030409
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030409,
					"content": "Ancak son zamanlarda, sırf yaşlı bir Peri dostumun sitemlerinden kurtulmak için bile olsa çaba göstermeye karar verdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030410
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030410,
					"content": "Ooo! Sonunda senin yazdığın bir hikayeyi okuyabilecek miyiz yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030411,
					"content": "Yazmaktan bahseden kim? Son birkaç yüzyılın popüler eserlerini satın alıp boş zamanlarımda okumaktan bahsediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030412
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030412,
					"content": "Haha! Yani öyle denebilir galiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030413
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030413,
					"content": "Düşüncelerle iletişim kurmak çok daha pratik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030414
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030414,
					"content": "Sanırım melekler bile tembelliğe yenik düşebiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
