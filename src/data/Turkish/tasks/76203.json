							495.725
						],
						"pointId": 7
					}
				]
			},
			"dialogs": [
				{
					"id": 762030201,
					"content": "Neler oluyor? Tablonun içine birden çekilince Paimon az kalsın kalp krizi geçirecekti! Bir dakika, burası tanıdık geliyor... Aa, büyücülerin çay saatlerini düzenlediği masa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030202,
					"content": "Her şey, Alice'in beni ilk kez çaya davet etmesiyle başladı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030203
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030203,
					"content": "O gün çaya şahsen katılmadım. Çünkü o zamanlar Cadılar Meclisine gerçekten katılmak isteyip istemediğime henüz karar vermemiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030204
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030204,
					"content": "Aralarında gerçek kimliğimi bilen tek kişi Alice'ti. Tek kelime etmemem ve kim olduğumu gizli tutmam konusunda beni uyardı. Sadece gözlem yapmam gerekiyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030205
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030205,
					"content": "... Peki sonra ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030206,
					"content": "Şey... Sonra, katılmakta tereddüt ettiğim için beni cezalandırdığı sonucuna vardım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030207
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030207,
					"content": "Herkes o kadar ilginç şeyler anlatıyordu ki sohbete dahil olmamak elde değildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030208
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030208,
					"content": "Hem sonra sohbet sırasında biri ortaya cevabını bildiğin bir soru atarsa nasıl sessiz kalabilirsin ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030209
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030209,
					"content": "Bu da bizi Barbeloth ile Alice arasındaki iddiaya, Rhinedottir'in yasaklı eserlerine, Ivanovna'nın siyasi entrikalarına getiriyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030210
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030210,
					"content": "Sanki bir çay fincanına sığdırılmış, harika bir oyunculuk sergilenen bir tiyatro oyunu gibiydi. Sadece sözleri bile onlara gerçeği tüm çıplaklığıyla gösterme içgüdümü ateşlemeye yetmişti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030211
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030211,
					"content": "Dayanamayıp zihinlerinin içinde konuşuverdin o zaman, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762030212,
					"content": "Tabii ki hayır! Kafam patlayacak gibi hissetmeme rağmen yine de kendimi tuttum. Ne de olsa ben sorumlu bir meleğim, \"söylemek istediklerim\" ile \"söyleyebileceklerim\" arasındaki ayrımın gayet farkındayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030213
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030213,
					"content": "O yüzden Alice'in zihninde sadece ikimiz özel olarak konuştuk ve ben de o an Cadılar Meclisine katılmayı kabul ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030214
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762030214,
					"content": "Kararıma oldukça sevindi ama kafasının içindeki o konuşma... Neyse, iddiasına göre sonraki birkaç gün boyunca o kadar şiddetli bir baş ağrısı çekmiş ki rahatlamak için Liyue'deki bir doktora gitmesi gerekmiş. Ama bunun için beni suçlayamaz ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nicole"
				}
			]
		},
		{
			"id": 7620303,
