			"dialogs": [
				{
					"id": 3560401,
					"content": "İşte sana vermek istediğim hediye...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560402
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560402,
					"content": "Bir <color=#00E1FFFF>Kanat</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560403
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560403,
					"content": "Kaşifler bunu rüzgarda uçmak için kullanır, ayrıca Mondstadt halkı da bunu kullanmaya bayılır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560404
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560404,
					"content": "Bunu sana vermek için seni buraya getirdim, böylece onu hemen deneyebilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560405
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560405,
					"content": "Ah, bu kanatlar konusunda gerçekten de çok heyecanlısın, hıh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3560406,
					"content": "Eh, bunun nedeni rüzgarın Mondstadt'ın kalbi ve ruhu olması!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560407
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560407,
					"content": "Tamam o zaman, bu kadar konuşma yeter! Haydi onu deneyelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560408
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560408,
					"content": "Bunu kullanması kolaydır ama yine de talimatlarıma dikkat etmen gerekli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		}
	]
