			"dialogs": [
				{
					"id": 3560101,
					"content": "Rüzgarın, karahindiba çiçeklerinin ve özgürlüğün şehrini size resmen takdim edeyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560102,
					"content": "Favonius Şövalyelerinin koruması altındaki yolcular... Mondstadt'a hoş geldiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560103
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560103,
					"content": "Nihayet, artık daha fazla dışarıda kamp kurmamız gerekmeyecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3560104,
					"content": "Ama... Şehir halkı çok neşeli görünmüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3560105,
					"content": "Son zamanlarda herkes Fırtına Dehşeti yüzünden çok endişeli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560106
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560106,
					"content": "Ama Jean bizimle birlikte olduğu sürece her şey yoluna girecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560107
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560107,
					"content": "Jean mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3560108,
					"content": "Favonius Şövalyelerinin Büyük Kumandan Vekili Jean, Mondstadt'ın Muhafızı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560109,
					"content": "Jean yanımızda olduğu sürece, korkunç Fırtına Dehşeti bile karşımıza çıkamaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560110,
						3560111
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560110,
					"content": "(Kulağa oldukça etkili biri gibi geliyor...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3560112
					]
				},
				{
					"id": 3560112,
					"content": "#Sizi Favonius Şövalyeleri Karargahına götürmeden önce, sana bir hediyem var {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560113
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560113,
					"content": "Bu, o dağ yabanisi kampını ortadan kaldırmama yardım ettiğin için bir ödül.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560114
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560114,
					"content": "Hey! Neden Paimon bir ödül almıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3560115,
					"content": "Ahh... Çünkü bu ödül senin işine yaramaz, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560116
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560116,
					"content": "Ama sana geleneksel bir Mondstadt lezzeti ikram edeceğim: Karamelize Soslu Rosto.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560117
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560117,
					"content": "Karamelize Soslu Rosto!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3560118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3560118,
					"content": "Benimle gelin, şehrin, ahh... <color=#00E1FFFF>Yüksek bölgesine</color> gideceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 3560111,
					"content": "(Umarım Rüzgar Tanrısı hakkında bir şey biliyordur.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3560112
					]
				}
			]
		},
