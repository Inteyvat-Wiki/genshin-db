				"points": []
			},
			"dialogs": [
				{
					"id": 105000101,
					"content": "Bu-Bunu nasıl bildin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000102,
					"content": "Nasıl mı? Çünkü ben gerçek bir astroloji ustasıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000103
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000103,
					"content": "Başka sorun yoksa hadi gidelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000104,
						105000105
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000104,
					"content": "Ah, o kadar çok sorum var ki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000106
					]
				},
				{
					"id": 105000106,
					"content": "*iç çeker* Pekala, biraz sabır gösterip açıklayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000107
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000107,
					"content": "Ben Astrolog Mona Megistus. Ancak isimleri yanlış hatırlamak kaba bir davranış olacağından diğerlerinin beni Mona adıyla çağırmasına izin veriyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000108
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000108,
					"content": "Ustam beni Mondstadt'tan bir kutuyu almakla görevlendirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000109
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000109,
					"content": "Bu, 50 yıl önce bir arkadaşıyla yaptığı anlaşmanın bir parçasıydı. Ancak ustam eskisi kadar dinç değil, o yüzden bu iş bana kaldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000110
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000110,
					"content": "Bir kutuyu geri almanın bizimle ilgisini çözemedim. Neden seninle birlikte gelmemizi istiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000111,
					"content": "Şey... Çünkü kutunun muhafızıyla dövüşmek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000112
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000112,
					"content": "Ustam ve arkadaşı, hayatları boyunca mistik sanatlar alanında rekabet halindelerdi ama birbirlerine üstünlük sağlayamadılar. Burada zafer kazanırsam ustamdan üstün olduğumu göstermiş olacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000113,
						105000115
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000113,
					"content": "Demek kendini kanıtlamak istiyorsun ha...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000114
					]
				},
				{
					"id": 105000114,
					"content": "Öhöm, şey, tam olarak söylemek gerekirse astrolojinin gücünü kanıtlamak istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000117
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000117,
					"content": "Şimdi, tahminlerime göre ustamın arkadaşının Mondstadt'tan gittiğini ve giderken de halefini o kutunun muhafızı olarak bıraktığını biliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000118
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000118,
					"content": "Benim gibi bu halef de ustasını geçen biri olmalı. Dikkatli olmalıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000119
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000119,
					"content": "Ancak bu yarışmada zaferimi garantilemek istiyorum ve bunun üzerine düşündükten sonra aklıma sen geldin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000120,
						105000122
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000120,
					"content": "Ama... Astrolojinin nasıl çalıştığına dair hiçbir fikrim yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000121
					]
				},
				{
					"id": 105000121,
					"content": "Zaten o bu işe nasıl bulaştı ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000123,
					"content": "Ustamdan bana öğrettiklerini ben de bir başkasına öğretmeliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000124
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000124,
					"content": "Talebemi onunla tanıştırırsam öne geçmiş olurum, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000125
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000125,
					"content": "Sen de Mondstadt'ın en büyük kahramanı olarak benimle aynı statüdesin. O yüzden...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000126,
						105000127
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000126,
					"content": "Reddediyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000128
					]
				},
				{
					"id": 105000128,
					"content": "Hadi ama, gerçek anlamda talebem olman gerekmiyor. Sadece rol yapman yeterli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000129
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000129,
					"content": "O kutuyu almak için benimle gelirsen senin de elde edebileceğin bir şey var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000130
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000130,
					"content": "O halefle karşılaşıp onunla bilgi alışverişi yapma fırsatını yakalarsam kaderini daha isabetli bir şekilde okuyabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000131
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000131,
					"content": "Bundan sonra senin için bazı cevaplarım olabilir; tanrılar ve akrabalar gibi uzak ve bulanık konuları bile kapsayan cevaplar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000132
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000132,
					"content": "Bu diyarı ülke ülke gezmekten daha hızlı olacağa benziyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000133,
						105000134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000133,
					"content": "Bunlar makul şartlara benziyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000135
					]
				},
				{
					"id": 105000135,
					"content": "Hehe, akıllıca bir seçim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000136
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000136,
					"content": "Bununla beraber, gitmeden önce ziyaret etmek istediğim bir yer var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000134,
					"content": "Pekala... Sanırım sana eşlik edeceğiz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000135
					]
				},
				{
					"id": 105000127,
					"content": "Ne zamandan beri senin öğrencinim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000128
					]
				},
				{
					"id": 105000122,
					"content": "Nasıl oldu da aklına ben geldim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000123
					]
				},
				{
					"id": 105000115,
					"content": "Yani temelde istediğin şey iyi görünmek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000116
					]
				},
				{
					"id": 105000116,
					"content": "Sen neden bahsediyorsun? Buradaki ana konu, bu fırsatı kullanarak astrolojinin gücünü kanıtlamak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000117
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000105,
					"content": "İlk olarak, sen kimsin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000106
					]
				}
			]
		},
