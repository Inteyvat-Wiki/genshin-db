			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bay Zhu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 105000201,
					"content": "(Hımm, buraya kurulan bir hanın işlerinin iyi gitmemesine şaşmamalı...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000202,
					"content": "Mona, tam zamanında geldin. Buraya gelirken yolda bir yeşim yüzük gördün mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000203
					],
					"speakerTitle": "Bay Zhu"
				},
				{
					"id": 105000203,
					"content": "Bir yeşim yüzük mü? Gördüğümü söyleyemem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000204
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000204,
					"content": "Ah, bu hiç iyi değil... O yüzüğü bana annem vermişti. Fakat arkam dönükken bir bodurlop onu yuttu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000205
					],
					"speakerTitle": "Bay Zhu"
				},
				{
					"id": 105000205,
					"content": "Öyle mi? Mona için bu sorunu çözmek zor olmamalı. O astrolojide oldukça iyidir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000206,
					"content": "Katiyen olmaz. Astroloji, gerçeklik hakkında bilgi edinmek ve doğrudan kaderi gözlemlemek için kullanılmalıdır. Kesinlikle dünyevi işler için değildir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000207
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000207,
					"content": "Ama buranın sahibinin sana iyi davrandığını söylememiş miydin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000208,
					"content": "Bu, gururla ve kişinin düşünme biçimiyle ilgili bir konu. Bir astrolog, sanatıyla tüm sorunları çözebileceğini düşünürse yıldızlı gökyüzü onu terk eder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000209
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000209,
					"content": "Kehanetleri, rehberlik gücünü kaybeder ve önünde duran bilinmezlikler sisini delip geçemez. Prensip prensiptir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000210
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000210,
					"content": "Bu kadar güçlü bir yetenek ve bunu geçimini sağlamak için kullanmıyor musun? Çok yazık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000211,
					"content": "*iç çeker* Pekala, yüzüğü bulmaya istekliysen ödül olarak yirmi bin Mora verecektim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000212
					],
					"speakerTitle": "Bay Zhu"
				},
				{
					"id": 105000212,
					"content": "Yi-Yirmi bin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000213,
						105000214
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000213,
					"content": "İyi misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000215
					]
				},
				{
					"id": 105000215,
					"content": "Ah, hiçbir şey! Ben... Sadece yüzüğü bulan kişi gerçekten şanslı olmalı diye düşünüyordum, bu kadar kolay yirmi bin Mora kazanabileceği için.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000216,
						105000217
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000216,
					"content": "Astroloğun gururundan bahsediyordun...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000218
					]
				},
				{
					"id": 105000218,
					"content": "Öhöm. Evet. Elbette. Yine de... Mekan sahibinin işleri iyi gitmiyor. Bulunması için bu kadar Mora harcamaya değer olduğuna göre gerçekten olağanüstü bir yüzük olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000219
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000219,
					"content": "Bu şekilde ayrılmamız doğru olmaz, o yüzden onun bulunmasına yardımcı olalım. Astroloji dışında başvurabileceğimiz yöntemler olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000220
					],
