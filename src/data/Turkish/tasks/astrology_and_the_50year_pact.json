				},
				{
					"id": 105000209,
					"content": "Kehanetleri, rehberlik gücünü kaybeder ve önünde duran bilinmezlikler sisini delip geçemez. Prensip prensiptir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000210
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000210,
					"content": "Bu kadar güçlü bir yetenek ve bunu geçimini sağlamak için kullanmıyor musun? Çok yazık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000211,
					"content": "*iç çeker* Pekala, yüzüğü bulmaya istekliysen ödül olarak yirmi bin Mora verecektim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000212
					],
					"speakerTitle": "Bay Zhu"
				},
				{
					"id": 105000213,
					"content": "İyi misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000215
					]
				},
				{
					"id": 105000214,
					"content": "Yüzüne ne oldu senin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000215
					]
				},
				{
					"id": 105000212,
					"content": "Yi-Yirmi bin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000213,
						105000214
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000216,
					"content": "Astroloğun gururundan bahsediyordun...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000218
					]
				},
				{
					"id": 105000217,
					"content": "\"Prensip prensiptir\" lafına ne oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000218
					]
				},
				{
					"id": 105000215,
					"content": "Ah, hiçbir şey! Ben... Sadece yüzüğü bulan kişi gerçekten şanslı olmalı diye düşünüyordum, bu kadar kolay yirmi bin Mora kazanabileceği için.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000216,
						105000217
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000218,
					"content": "Öhöm. Evet. Elbette. Yine de... Mekan sahibinin işleri iyi gitmiyor. Bulunması için bu kadar Mora harcamaya değer olduğuna göre gerçekten olağanüstü bir yüzük olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000219
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000219,
					"content": "Bu şekilde ayrılmamız doğru olmaz, o yüzden onun bulunmasına yardımcı olalım. Astroloji dışında başvurabileceğimiz yöntemler olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000220
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000220,
					"content": "Ah, Paimon bu işin nereye gittiğini biliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000222,
					"content": "Ama tabii...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000224
					]
				},
				{
					"id": 105000223,
					"content": "Sanırım beni ilgilendiren bir konu oldu. Yine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000224
					]
				},
				{
					"id": 105000221,
					"content": "#{NICKNAME}, biliyorum, bunu sana bırakacağım! Bu, sana ustan olarak verdiğim ilk görev olacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000222,
						105000223
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000224,
					"content": "Hımm, bir bodurlop tarafından yutulduğuna göre yakındaki tüm bodurlopları tuzağa düşürmek için Element Yemi kullanabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000825,
					"content": "Biliyor muydun? Bu, Şafak Şaraphanesinin şarap yaparken kazara geliştirdiği bir şeymiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000826
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000826,
					"content": "Formülü gizli ancak bodurlopları çekmede gerçekten iyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000827
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000227,
					"content": "Aferin Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000228
					]
				},
				{
					"id": 105000229,
					"content": "Açgözlü davrandığında bunu söyleme, seni...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						105000230
					]
				},
				{
					"id": 105000226,
					"content": "Ve... Hehe, Paimon aslında bir kısmını saklamıştı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000227,
						105000229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000228,
					"content": "Paimon gibisi yok, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000230,
					"content": "Ah, pireyi deve yapmayalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 105000231,
					"content": "Görünüşe göre bir plan yapmışsın zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						105000232
					],
					"speakerTitle": "Mona"
				},
				{
					"id": 105000232,
					"content": "Evet. Hemen döneceğiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1050009,
