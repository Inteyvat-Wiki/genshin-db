					"nextDialogs": [
						100100825
					]
				},
				{
					"id": 100100825,
					"content": "... Evet. Paimon'u bilirsin, tek yumrukta canavarları temizler! Böyle süper biri işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
