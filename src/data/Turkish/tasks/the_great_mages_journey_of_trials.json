			"dialogs": [
				{
					"id": 100100101,
					"content": "Hımm... Dodoko...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100102
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100102,
					"content": "Selam Klee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100103,
					"content": "#{M#Bay}{F#Bayan} Fahri Şövalye! Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100104
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100104,
					"content": "Dodoko'nun yardıma ihtiyacı var! Annem geleceğinizi söylemişti ama bu kadar çabuk olacağını bilmiyordum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100105
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100105,
					"content": "Dodoko'nun... Yardıma mı ihtiyacı var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100106,
					"content": "Teyvat aşkına... Görev bu mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100107,
					"content": "Ne? Hayır, Klee aşkına! Ve de Dodoko aşkına!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100108
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100108,
					"content": "Yok, Paimon onu biliyor. Paimon görevi soruyordu. Görevin ne olduğunu biliyorsun değil mi? Tıpkı şey gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100109,
						100100113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100109,
					"content": "Görev gibi işte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100100110
					]
				},
				{
					"id": 100100110,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100111
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100111,
					"content": "... Çok sağ ol Aşikar Şövalye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100112,
					"content": "Her neyse, şey... Bir görev... Of, bunu tarif etmek neden bu kadar zor? Görevler aslında... Dodoko'ya yardım etmek gibi! Evet! İşte görev budur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100119,
					"content": "Ha! Teşekkürler Paimon. Bu biraz daha mantıklı geldi, gerçi tam da değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100120
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100120,
					"content": "Neyse, hadi gidip Dodoko'ya yardım edelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100121
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100121,
					"content": "Dur bir dakika. Dodoko'nun nasıl bir yardıma ihtiyacı var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100122,
					"content": "Ha, doğru. Her Dodoko'nun süper özel bir Dodoko olmak için kırmızı dört yapraklı bir yonca bulması gerekir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100123
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100123,
					"content": "Sonra, Dodoko'nun birçok insanla arkadaş olması ve Dodo-Kral'ın imtihanından geçmesi gerekir. Bunlar tamamlandığında Dodoko süper harika bir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100124
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100124,
					"content": "Dodo Büyücü olur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100125
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100125,
					"content": "... Annem böyle söyledi en azından.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100126
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100126,
					"content": "Hım, Dodo-Kral'ın bir Dodo Büyücüyü yönetmesi... Aslında mantıklı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100127,
					"content": "Şey, peki tam olarak ne yapmamız gerekiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100128,
					"content": "Bilmem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100129
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100129,
					"content": "Ama annem ikinizin bana anlatacağını söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100130
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100130,
					"content": "P-Peki... Şey, o zaman şu kitaba bir bakalım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100131,
					"content": "Aa! İçinde bir not var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100132
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100132,
					"content": "Hım, bakalım ne yazıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100133,
					"content": "... Sınavın ilk aşamasında Dodoko, fısıldayan yaprakların olduğu bir ormana geldi. Orada, kat kat engellerin ardında, keşfedilmeyi bekleyen gizli bir sır gömülüydü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100134,
					"content": "Dodoko hakkında bir hikayenin parçası gibi görünüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100135,
					"content": "Aa, o ormanın nerede olduğunu biliyorum! Balık patla... Öhöm, hep oyun oynamaya gittiğim yer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100136
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100136,
					"content": "Hadi! Beni takip edin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100137
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100137,
					"content": "Pekala, hadi gidelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100113,
					"content": "Yapılması gereken bir şey.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100100114
					]
				},
				{
					"id": 100100114,
					"content": "Evet, yapılması gereken bir şey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100115,
					"content": "Aa! Yani... Zıpzıp Bodur'la balık patlatmaya gitmem gibi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100116
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100116,
					"content": "Hayır, hayır! \"Görev\" sadece yapmak istediğin bir şey değildir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100117,
					"content": "Kafam karıştı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100118
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100118,
					"content": "*iç çeker* Şöyle düşün... Annen sana bir şey yapmanı söyler ya hani? İşte o bir \"görev\"dir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100119
					],
					"speakerTitle": "Paimon"
				}
			]
		},
