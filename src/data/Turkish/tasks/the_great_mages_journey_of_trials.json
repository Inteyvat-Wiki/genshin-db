					"nextDialogs": [
						100100507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100507,
					"content": "Eğer Kumandan Jean, Klee'nin kapatıldığı odayı havaya uçurmasına izin verseydi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100508
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100508,
					"content": "Paimon'un aklındaki bu değildi... Bir saniye, peki ya imtihan? Yeni bir şey öğrenebildik mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100509,
					"content": "Evet! Zıpzıp Bodur'un patlamasından sonra oluşan delikte bunu buldum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100510
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100510,
					"content": "Hım, başka bir not.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100511,
					"content": "Evet, yine annemin el yazısı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100512
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100512,
					"content": "\"Pekala, Dodoko engellerin hepsini havaya uçurmuş olabilir de olmayabilir de... Gerçi en kestirme yol bazen en zarif olanıdır. Her iki durumda da Dodoko imtihanın ikinci aşamasına ulaştı...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100513,
					"content": "\"Bu ikinci aşama aynı zamanda son aşamaydı. Ne de olsa en enerji dolu çocuklar bile dinlenmesini bilmeli. Sonra...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100514,
					"content": "\"Dodoko düşen yıldızların olduğu gölün kıyısına ilerledi, son imtihanı geçti ve ödülünü aldı. Peki işler gerçekten bu kadar basit olabilir miydi?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100515,
					"content": "Hımm, \"düşen yıldızların olduğu bir göl\"... Bu Yıldızdüşen Gölü olmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100516,
					"content": "Hadi gidip ne bulacağız bir bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100517,
					"content": "Tamam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100518
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100518,
					"content": "Paimon bu ödülün ne olacağını çok merak ediyor. Süper bir hazine çıkarsa harika olur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
