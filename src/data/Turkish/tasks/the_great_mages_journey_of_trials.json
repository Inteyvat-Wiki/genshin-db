					"nextDialogs": [
						100100814
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100814,
					"content": "Şövalyeler şehir dışındaki ormandan patlama sesleri geldiğini bildirdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100815
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100815,
					"content": "#Şey, {M#Bay}{F#Bayan} Fahri Şövalye, Paimon... Yardım eder misiniz lütfen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100816
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100816,
					"content": "Ha, orada bir Dağ Yabanisi kampını ve bir sürü Bodurlopu temizliyorduk, ondan oldu. Üstelik Klee'nin görevini de yapıyorduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100817
					],
					"speakerTitle": "Paimon"
				},
