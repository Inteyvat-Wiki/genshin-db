						100100808
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100808,
					"content": "Dodo Klanında, sadece diyarın en süper ve en iyi Dodokoları Dodo-Kral'ın takdirini kazanabilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100809
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100809,
					"content": "Onların görevi diğer Dodokoları korumak ve onlara yardım etmek olduğu için, Dodo-Kral onlara özel bir şapka verir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100810
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100810,
					"content": "Böylece diğer Dodokolar onları tanıyabilir ve yardım için kime gidebileceklerini bilebilirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100811
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100811,
					"content": "Haa! Yani şimdi senin Dodokon da şapkalı özel Dodokolardan biri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100100812,
					"content": "Aynen öyle! Şapka sayesinde Dodoko artık bir Dodo Büyücü oldu! Özel kıvılcım büyüsüyle daha fazla kişiye yardım edebilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100813
					],
					"speakerTitle": "Klee"
				},
