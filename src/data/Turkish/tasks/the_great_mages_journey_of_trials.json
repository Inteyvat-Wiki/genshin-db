					"id": 100100817,
					"content": "Aynen öyle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100818
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100818,
					"content": "Hımm... Peki ya buradaki balıklar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100819
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100819,
					"content": "Ben... Onları patlatmış olabilirim. Ama gölde canavarlar vardı, o yüzden! Bilerek yapmadım! Diğer seferler gibi değil yani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100820
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100820,
					"content": "Anlıyorum. O diğer seferler kasıtlıydı, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100821
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 100100821,
					"content": "Şey... Kasıtsız değillerdi desem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100822
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 100100822,
					"content": "*iç çeker*... Buraya gelirken yok edilen kampı fark ettim ve canavarların Yıldızdüşen Gölü kıyısı boyunca kaçtığını gördüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100823
