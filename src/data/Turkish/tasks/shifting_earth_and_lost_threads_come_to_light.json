			},
			"dialogs": [
				{
					"id": 111220201,
					"content": "Hey! Ayak izleri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220202,
					"content": "Görünüşe göre Lingju Geçidi'nden geçip yürümeye devam etmişler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220203
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220203,
					"content": "Ayak izlerini takip edersek nereye gittiklerini bulabiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
