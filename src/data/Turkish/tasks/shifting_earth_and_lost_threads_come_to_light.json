			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220901,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220902
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220902,
					"content": "O nasıl? Y-Yaşayacak, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220903,
					"content": "O kadar bitap düşmüş ki bilincini kaybetmiş. Neyse ki ciddi bir tehlikesi yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220904
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220904,
					"content": "Kendini niye bu kadar yormuş ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220905
					]
				},
				{
					"id": 111220905,
					"content": "Paimon, kazmakla ilgili bir şeyler dediğini duydu. Bu hale düşene kadar kazı mı yapıyordu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220906,
					"content": "Öyle olması muhtemel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220907,
						111220908
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220907,
					"content": "Garip...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220909
					]
				},
				{
					"id": 111220909,
					"content": "Hımm. Cebinde bir şey var gibi görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220910
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220910,
					"content": "Bunlar... Cevher parçaları mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220911
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220911,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220912
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220912,
					"content": "Az önce bu cevher parçalarının içindeki anılara tanık oldum. Bu kişi, parçaları madenden çıkarmış. Aradığımız dört kişiden biri o.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220913
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220913,
					"content": "Önce buraya nasıl geldiğini çözmemiz gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220914
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220914,
					"content": "Kaçırıldı, sonra da... Burada bırakıldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220915,
					"content": "Madem ona ihtiyaçları yoktu, neden onu buraya kadar getirdiler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220916
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220916,
					"content": "Tabii... Geride kalmasına sebep olan bir şey yaşanmamışsa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220917
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220917,
					"content": "Off...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220918,
					"content": "Paimon bundan çok sıkıldı! Aklı almıyor artık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220919
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220919,
					"content": "Ah! Bir saniye! Bu parçaları görünce aklıma geldi, size bir şey vermek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220920
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220920,
					"content": "Nedir? Aa! Hediye mi yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220921
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220921,
					"content": "Bize mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220922
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220922,
					"content": "Dai Amca ile tanışmadan önce sersem gibiydim ama sizinle bu yolculuğa çıktığımdan beri zihnimdeki bulanıklığın dağıldığını hissediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220923
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220923,
					"content": "Dai Amca yardım için sizi görevlendirdiğinde çok mutlu olmuştum. Bu ipuçlarını tek başıma bulamazdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220924
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220924,
					"content": "Pazardan birkaç kristal almıştım. Sıradan kristaller değiller, bu saflıkta başka bir kristal bulmak fevkalade zordur! Herkese birer tane. Benden size hatıra olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220925
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220925,
					"content": "Çok güzel... Ah, çevirdiğinde rengi değişiyor! Her yüzünde farklı bir kristal var sanki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220926,
						111220927
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220926,
					"content": "Pahalı bir şeye benziyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220928
					]
				},
				{
					"id": 111220928,
					"content": "Tabii ki, artık senin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220929
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220929,
					"content": "Bu da sizin için Bay Zhongli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220930
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220930,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220931
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220931,
					"content": "Ne oldu, bir sorun mu var? Beğenmediniz mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220932
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220932,
					"content": "Tam tersi... Mevcut şartlar altında bir hediye almayı beklemiyordum sadece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220933
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220933,
					"content": "Ama teşekkürler. Ona gözüm gibi bakacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220934
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220934,
					"content": "Beğendiğinize sevindim. Başkalarını mutlu edebilecek hediyeler vermek güzel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220935
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220935,
					"content": "Ah! İleride başka taşlar da görüyorum. Siz dinlenin, ben biraz yürüyeceğim. Belki birkaç anı daha keşfederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220936
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220936,
					"content": "Taşları çok seviyorsun Kun Jun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220937
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220937,
					"content": "Cevherler dünyanın kristalleridir, zamanın tortusudur. Aralarında huzur buluyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220938
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220938,
					"content": "Biraz dinlenin, yola çıkmaya hazır olduğunuzda da beni çağırırsınız. Çok uzaklaşmam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220939
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220939,
					"content": "Tek başına sorun yaşamaz, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220940
					]
				},
				{
					"id": 111220940,
					"content": "Rahat ol, bölgeye göz attım. Tehlikeli hiçbir şey yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220941
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220941,
					"content": "Fakat sizinle konuşmak istediğim bir konu var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220942
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220942,
					"content": "Ne oldu? Neden birden ciddileştin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220943
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220943,
					"content": "Gezgin... Ejderkapanı denince aklına bir şey geliyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220944
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220944,
					"content": "Hayır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220945
					]
				},
				{
					"id": 111220945,
					"content": "Kun Jun'un aradığı cevheri mi diyorsun? Özelliği nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220946
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220946,
					"content": "Ejderkapanı, demir dövmede kullanılan nadir bir cevherdir. Sıradan kristallerin çoğu yüksek dereceli ortamlarda oluşur ama Ejderkapanı element tepkimeleri sonucu meydana gelir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220947
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220947,
					"content": "Element tepkimeleri madde oluşturabiliyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220948
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220948,
					"content": "Tabii ki. Ancak bu maddelerin yalnızca küçük bir kısmı uzun ömürlüdür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220949
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220949,
					"content": "Ejderkapanı binlerce yıl önce ilk kez büyük bir savaşın ortasında oluştu. Element enerjisinden doğan güçlü çarpışmalar element kristallerini yarattı. Savaş sona erdiğinde ise bu jeolojik kalıntılar şans eseri korundu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220950
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220950,
					"content": "Vaaaay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220951
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220951,
					"content": "Yine de bu kristalin diğerlerinden bir farkı yoktu. Seyrek görülürdü ve pek bilinmezdi. Birkaç asır önce de madenlerde neredeyse tamamen tükendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220952
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220952,
					"content": "Peki neden bir Liyueli, çoktan yeryüzünden silinmiş bir cevheri birdenbire keşfetmek istesin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220953
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220953,
					"content": "Evet! Varlığını biliyorsa tüm rezervlerin çoktan tükendiğini de bilmesi lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220954
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220954,
					"content": "Garip... Paimon'un kafası karıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220955
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220955,
					"content": "Madencilik işinde Ejderkapanı çok rağbet görür ama Bay Kun Jun gibi birinin bu cevherle ilgilenmesi... Kendisi bile bu cevheri ne için aradığını bilmezken hem de... Böyle bir şeye ilk kez şahit oluyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220956
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220956,
					"content": "Belki art niyetli biridir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220957
					]
				},
				{
					"id": 111220957,
					"content": "Art niyetli... *iç çeker* Kötü bir adam mı yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220958
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220958,
					"content": "Şu anda sonuca varılması imkansız bir varsayım. Gözlemleyip beklemeliyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220959
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220959,
					"content": "Unutmayın, öncelikli hedefimiz o madencileri kurtarmak. Diğer meseleler içinse... Er ya da geç her şey gün yüzüne çıkacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220960
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220960,
					"content": "Hedefimize gitgide yaklaşıyoruz. Bu yolu takip etmeye devam etmemiz gerekiyor bence. Birini bulduğumuza göre diğerleri çok uzakta değildir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220961
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220961,
					"content": "Güzelce dinlenin, sonra Bay Kun Jun'u çağırın. Araştırmamız henüz bitmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220962
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220962,
					"content": "Bu madencinin kampta rahat etmesini sağlayalım önce. Bu meseleye çözüm getirdik mi dönüp onunla ilgileniriz. Dai Amca'ya not bırakmayı öneririm. Kampı bulursa ne yapacağını bilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220927,
					"content": "Gerçekten alabilir miyim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220928
					]
				},
				{
					"id": 111220908,
					"content": "Buraya isteği dışında gelmedi mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220909
					]
				}
			]
		},
