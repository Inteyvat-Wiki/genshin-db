				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220401,
					"content": "Merhaba, burada hiç madenci gördün mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220402,
					"content": "Sanırım dört ya da beş gün önceydi. Buraya gelen birkaç adam gördüm, sepet ve kazma taşıyorlardı. Bahsettiğiniz kişiler onlar olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220403
					],
					"speakerTitle": "Ling"
				},
				{
					"id": 111220403,
					"content": "Evet, onlar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220404,
					"content": "Dört ya da beş gün önce mi? Tahmin ettiğimden daha yavaş ilerliyorlarmış. Lingju Geçidi'nin coğrafi yapısı onları yavaşlatmış olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220405
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220405,
					"content": "Çok garipti! Soluk bakışlı dört iri adam... Bir çeşit büyünün etkisi altında gibiydiler! Önlerinde de sendeleyen bir çocuk vardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220406
					],
					"speakerTitle": "Ling"
				},
				{
					"id": 111220406,
					"content": "Ha, şu çocuk... Nasıl biriydi, görebildin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220407
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220407,
					"content": "Gözüme ilişti evet. Kısa mavi saçlıydı. Sanıyorum... Bir kız çocuğuydu! Gülmüyordu, hatta çok sert bakıyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220408
					],
					"speakerTitle": "Ling"
				},
				{
					"id": 111220408,
					"content": "Peki bu taraftan mı gittiler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220409
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220409,
					"content": "Evet, buradan düz devam ettiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220410
					],
					"speakerTitle": "Ling"
				},
				{
					"id": 111220410,
					"content": "Peşlerinden gidelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1112207,
			"completionStepIds": [
				1112207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1112207",
							"2"
						],
						"stepId": 1112207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wanyu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111220701,
					"content": "Şu canavarlar çok agresifti. Geçerken beni fark etmiş olmalılar! Ne oluyor demeye kalmadan hepsi başıma üşüştü. Beni kurtardığınız için teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220702
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220702,
					"content": "Adım Wanyu, Liyue'deki Shenglu Salonunda görevliyim. İnsan kültürü ve medeniyeti araştırmamızı yönetiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220703
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220703,
					"content": "Öyle mi? Madenci olmadığına emin misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220704,
					"content": "Madenci mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220705
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220705,
					"content": "Evet. Maden aletleri taşıyan dört iri genç arıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220706,
					"content": "Sanırım... Gördüm onları.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220707
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220707,
					"content": "Cidden mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220708,
					"content": "Evet. Önceki gün Nantianmen'dan Lingju Geçidi'ne gidiyordum. Yarı yolda birkaç adama, bir de çocuğa rastladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220709
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220709,
					"content": "Biraz daha ayrıntı verebilir misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220710
					]
				},
				{
					"id": 111220710,
					"content": "Acelem vardı, pek dikkat etmedim. Maalesef nasıl göründüklerinden tam emin değilim. Kusura bakmayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220711
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220711,
					"content": "Bu bilgi bizim için yeterli. Teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220712
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220712,
					"content": "Umarım yardımı olur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220713
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220713,
					"content": "Katılmam gereken bir konferans var, gitsem iyi olacak. Yardımınız için tekrar teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220714
					],
					"speakerTitle": "Wanyu"
				},
				{
					"id": 111220714,
					"content": "Alim, madencilerin Nantianmen'e gittiğini görmüş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220715
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220715,
					"content": "Aradığımız kişiler olduklarından kesinlikle emin miyiz peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220716
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220716,
					"content": "Bir grup yetişkinle gezen bir çocuk! Paimon ikna oldu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220717,
					"content": "Başka bir grup da olabilir ama.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111220718
					]
				},
				{
					"id": 111220718,
					"content": "Ama, şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220719,
					"content": "Hey, belki oradaki taş bir şeyler biliyordur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220720
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220720,
					"content": "Aha! Paimon, gizli silahımızı neredeyse unutuyordu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220721
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220721,
					"content": "İşe yarar görünüyor, elimden geleni yapacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220722
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220722,
					"content": "Hım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220723
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220723,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220724
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220724,
					"content": "Evet, aynı grup. Bu yoldan gitmişler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220725
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220725,
					"content": "Haha, taş görünüz uzun süre aklımda kalacak Bay Kun Jun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220726
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220726,
					"content": "Nadiren kullansam da önemi büyük. Bay Zhongli'nin beni bu şekilde methetmesi gururumu okşadı gerçekten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220727
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220727,
					"content": "\"Kun Jun pusulamızı\" getirdiğimiz iyi oldu! Yön bulma becerilerimizi çoktan tüketirdik yoksa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220728,
					"content": "Hahaha, öyle mi dersin? Girdiğimiz onca sıkıntıya değiyor o zaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220729
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220729,
					"content": "Bir suç vakası çözmeye çalışıyormuşuz gibi. Çok eğlenceli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220730
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220730,
					"content": "Ne olursa olsun gözümüzü dört açsak iyi olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220731
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220731,
					"content": "Transa girmiş bir durumda dört yetişkin adam... Gece gündüz durmadan yürüyorlar. Dağları tepeleri aşıyorlar. Bir çocuğu takip ediyorlar. Bu öylesine bir hadise değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220732
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220732,
					"content": "Evet, haklısınız Bay Zhongli. Tetikte olmalıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220733
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111220733,
					"content": "Sadece o da değil. Toprak Ejderi Yavruları alimimize saldırdı ama bu kadar saldırgan olmaları... Normal değildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220734
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220734,
					"content": "Yolda birçok ipucuna rastladık. Hepsi de şimdilik doğru yolda olduğumuzu gösterdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220735
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220735,
					"content": "Hımm, geçen gün madenciler Nantianmen yönüne ilerlemeye başlamış. Buradan gitselerdi tehlikeli bir dağ yolundan geçmek zorunda kalacaklardı. İstikametleri gerçekten Nantianmen ise onlara yetişebiliriz gibi görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220736
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220736,
					"content": "Harika! Kaybedecek vakit yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220737
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111220737,
					"content": "Civarda bir yere işaret koydum şimdi. Dai Amca buradan geçerse onu bize yönlendirecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111220738
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111220738,
					"content": "Çok iyi düşünmüşsün! Tam bir Zhongli klasiği.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1112208,
