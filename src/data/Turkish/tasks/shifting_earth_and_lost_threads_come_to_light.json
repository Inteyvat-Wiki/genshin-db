			"dialogs": [
				{
					"id": 111229901,
					"content": "Bir dakika, burada izler var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111229902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111229902,
					"content": "Bunları madenciler bırakmış olmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111229903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111229903,
					"content": "Lingju Geçidi'nin sonuna doğru ilerleyelim. Orada ayak izi yoksa madenciler hâlâ geçitte demektir. Şayet yeni izler bulursak takip ederek nereye gittiklerini görebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		},
		{
			"id": 1112202,
			"completionStepIds": [
				1112202
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
