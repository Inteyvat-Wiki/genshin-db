			},
			"dialogs": [
				{
					"id": 221080201,
					"content": "Dağ yabanilerini yendin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080202
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221080202,
					"content": "Henüz değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080203
					]
				},
				{
					"id": 221080203,
					"content": "Sorun değil, acele etme. Aceleyle hareket eden bir maceracı, yüksek ihtimalle kendini tehlikeye atacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080204
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221080204,
					"content": "Bununla birlikte... Aceleden ziyade hız gerekebilir çünkü ödemen, bu görevi ne kadar hızlı tamamladığına bağlı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lahn"
				}
			]
		},
