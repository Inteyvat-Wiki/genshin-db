					"Lahn"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221080101,
					"content": "Umarım bu defa ortaya çıkar... Çok az ipucu kaldı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080102
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221080102,
					"content": "Sorun ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080103
					]
				},
				{
					"id": 221080103,
					"content": "Seni hangi rüzgar attı? Lonca hakkında daha fazla bilgi almak istiyorsan, Katheryne ile konuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080104
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221080104,
					"content": "Sen zaten bir maceracı mısın? Çok özür dilerim. Şube Başkanı olmama rağmen, Loncanın gündelik işleriyle ilgili pek bir bilgim yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080105
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221080105,
					"content": "Bu yüzden yeni gelenleri tanımıyorum... Ama sanırım sen yeni gelmedin değil mi? Oldukça tecrübeli bir maceracı gibi duruyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080106
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221080106,
					"content": "Öyle ya da böyle, bana yardım edebileceğin bir mesele olabilir. Ama belirtmiş olayım, bu lonca görevi değil, kişisel bir görev.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080107,
						221080108
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221080107,
					"content": "Görevi alabilirim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080109
					]
				},
				{
					"id": 221080109,
					"content": "Hevesini takdir ettim ama ayrıntıları dinlemeden görev kabul etmek, çok akıllıca değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080111
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221080111,
					"content": "Kabul edersen eğer, görevin dev kalkanları olan iki dağ yabanisini yenmek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080112
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221080112,
					"content": "Onların kalkanlarında Toprak enerjisi olur. Çok tehlikeli değildir ama yine de dikkatli olmak gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080113
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221080113,
					"content": "Sadece onları yenmeni istiyorum. Sonrasında gelip beni bul, ki sana bunun için iyi bir ödeme yapayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080114
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221080114,
					"content": "Ayrıca yolda kılıçla ilgili bir şey bulursan bana getir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080115
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221080115,
					"content": "Bulamazsan da sorun değil. Dağ yabanilerini yendiğin müddetçe ödemeni alacaksın. Hepsi bu kadar. Şimdi seni bırakayım da hazırlan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221080108,
					"content": "Biraz daha ayrıntı verirsen değerlendirebilirim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080110
					]
				},
				{
					"id": 221080110,
					"content": "İhtiyatlı bir cevap. Belli ki ihtiyatın değerini zor yoldan öğrenmişsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080111
					],
					"speakerTitle": "Lahn"
				}
			]
		},
