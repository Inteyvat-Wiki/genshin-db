			"dialogs": [
				{
					"id": 221080301,
					"content": "Dağ yabanilerini yendin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080302
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221080302,
					"content": "Evet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221080303
					]
				},
				{
					"id": 221080303,
					"content": "Aferin! Etkilendim. Görevini bir Maceracıya yakışır şekilde tamamladın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080304
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221080304,
					"content": "Ödemen burada. Teşekkür ederim, sayende artık buralar daha güvende olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080305
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221080305,
					"content": "Sanırım kılıçla ilgili bir şey bulamadın değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080306
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221080306,
					"content": "... Anladım. Ben de öyle düşünmüştüm. Neyse önemli değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221080307
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 221080307,
					"content": "Teşekkür ederim, işte ödemen. İyi günler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lahn"
				}
			]
		}
	]
