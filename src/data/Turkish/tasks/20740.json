				},
				{
					"id": 207400505,
					"content": "Bana getirdiğin çiçekleri de saksılara dikerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400506
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400506,
					"content": "Ah, evet. Sana bir şekilde teşekkürlerimi sunmam gerek. İşte, sana küçük bir hediye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207400507
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 207400507,
					"content": "Şimdi bu çiçekleri çabucak saksılara dikmem gerek. Karahindiba tohumları da buraya...",
					"roleType": "TALK_ROLE_NPC",
