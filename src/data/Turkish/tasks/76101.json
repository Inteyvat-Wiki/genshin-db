			"dialogs": [
				{
					"id": 761010301,
					"content": "İhtiyar, geri döndük!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010302
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010302,
					"content": "Sağ salim dönmüşsünüz bakıyorum. Kipumaki Uçurumu'nda durumlar nasıl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010303
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010303,
					"content": "Olanları kısaca özetliyorsunuz...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761010304
					]
				},
				{
					"id": 761010304,
					"content": "Tam da düşündüğüm gibi... Buradan bile gün gibi ortada her şey. Embla Sütunu, Hiçliğe ve \"Profesör\" dedikleri o ölümsüz iblise yenik düştü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010305
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010305,
					"content": "Şimdilik ortalık sessiz. Alia Hanım hâlâ onu uzak tutmak için savaşıyordur muhtemelen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010306
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010306,
					"content": "O bizim için hattı koruyor, bu fırsatı en iyi şekilde değerlendirmeliyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010307
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010307,
					"content": "Flins ve diğerleri sayesinde hazırlıklar neredeyse tamamlandı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010308
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010308,
					"content": "Sen de Sarmal Kılıcı geri getirdiğine göre Terpikeraunas'ın Oku nihayet hazır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010309
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010309,
					"content": "Şey... \"Terpikeraunas'ın Oku\" da ne? Gümüş Fitil ve Sarmal Kılıç gibi süper güçlü başka bir yadigar mı yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010310,
					"content": "Haha, ikisini de solda bırakır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010311
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010311,
					"content": "Beş yüzyıl önce Meşale Ustası ölümsüz canavarı yok edecek kadar güçlü değildi, bu yüzden onu sadece Kipumaki Uçurumu'nun altına mühürleyebildi. Yine de tereddüt etmedi. İlk Ay İlahicisi'yle birlikte gelecekte zafer kazanma umuduyla yola devam ettiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010312
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010312,
					"content": "Bu yay ve oku, ölümsüz canavarı yok etme günü geldiğinde hazır olsun diye kadim yöntemlerle yaptılar. O zamandan beri Işık Muhafızlarında nesilden nesile aktarılıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010313
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010313,
					"content": "Şimdi nihayet kaderini gerçekleştirme zamanı geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010314
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010314,
					"content": "Vay... İyiymiş! Neye benziyor? Görebilir miyiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010315,
					"content": "Zaten gördünüz şapşal. Hatta şu an içindeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010316,
						761010318
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010316,
					"content": "Ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010317
					]
				},
				{
					"id": 761010317,
					"content": "Bizi onunla fırlatmayı falan düşünmüyorsun herhalde... Değil mi? DEĞİL Mİ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010320,
					"content": "Bu devasa şölen salonu Terpikeraunas'ın Okunu muhafaza etmek için inşa edilmişti, ele geçirdiğiniz Sarmal Kılıç da uzun zamandır eksik olan ok ucuydu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010321
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010321,
					"content": "Sarmal Kılıç yerine yerleştirildiğinde Ok atışa hazır olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010322
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010322,
					"content": "İyi de bu bir şömine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010323,
					"content": "Kesinlikle öyle! Ama aynı zamanda Sarmal Kılıcı ok ucuna dönüştüren mekanizma işlevi de görüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010324
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010324,
					"content": "Felaket Yumurtası çatlamadan önce harekete geçmeliyiz. Bu yayla ok tam olarak bu an için, bu tehdidi sonsuza dek ortadan kaldırmak için nesilden nesile aktarıldı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010325
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010325,
					"content": "Sen atışı hazırlarken o ölümsüz canavar muhtemelen son bir kez daha saldıracak. Önümüze ne çıkarsa çıksın onu durduracağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010326
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010326,
					"content": "Terpikeraunas'ın Okunu fırlatma işi sende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010318,
					"content": "Okla mı fırlatacaksın beni?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010319
					]
				},
				{
					"id": 761010319,
					"content": "#{NICKNAME} gerçekten son çare silahımız demek! Olamaz, bu kesinlikle şaka olmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010320
					],
					"speakerTitle": "Paimon"
				}
			]
		},
