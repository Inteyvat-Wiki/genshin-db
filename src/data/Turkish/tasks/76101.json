			"dialogs": [
				{
					"id": 761010201,
					"content": "Illuga! Sonunda! Starşina Nikita her yerde seni arıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010202
					],
					"speakerTitle": "Olav"
				},
				{
					"id": 761010202,
					"content": "Hı? Starşina... Nikita mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010203,
					"content": "#Dur biraz. {NICKNAME}, şu Nikita... bizden Gümüş Fitili aramamızı isteyen ihtiyar değil miydi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010204,
					"content": "Sıradan bir Ratnik olduğunu söylememiş miydi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010205,
						761010206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010205,
					"content": "Evet...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010207
					]
				},
				{
					"id": 761010207,
					"content": "Ha, benim ihtiyar... Biraz eğlenmek istemiştir muhtemelen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010208
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010208,
					"content": "Bunu daha sonra konuşuruz. Şimdilik gidip onu bilgilendirelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010206,
					"content": "Sıradan bir Ratnik gibi durmuyordu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010207
					]
				}
			]
