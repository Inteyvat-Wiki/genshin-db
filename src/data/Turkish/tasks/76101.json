			"dialogs": [
				{
					"id": 761010101,
					"content": "#{NICKNAME}, Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010102
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010102,
					"content": "Hehe, tam zamanında gelmişiz! Burası gerçekten çok hareketli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010103,
					"content": "Son birkaç gündür herkes çok çalışıyor. İşler nihayet yoluna girince herkesi bir araya getirme fırsatı bulabildik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010104
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010104,
					"content": "Senin için de zor olmuştur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761010105
					]
				},
				{
					"id": 761010105,
					"content": "Benden bekleneni yaptım sadece. Fakat... O anda müdahale etmeseydiniz işler çok daha farklı sonuçlanabilirdi. Yine de kazanabilirdik ama çok daha ağır bir bedel öderdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010106
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010106,
					"content": "Hadi ama, bu işte birlikte değil miyiz? Bu kadar ciddiyete gerek yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761010107,
					"content": "Evet, haklısın. Ah, görünüşe göre İhtiyar konuşmak üzere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010108
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 761010108,
					"content": "Tüm yoldaşlarımıza ve soydaşlarımıza sesleniyorum: Bu sadece bir kutlama değil. Bu, zaferimizin ardındaki çabayı onurlandırma anıdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010109
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010109,
					"content": "Bu zaferi kutlarken bunu mümkün kılmak için her şeyini feda edenleri unutmayalım. Bir zamanlar hepimizin ettiği yemini kanlarını dökerek yerine getirdiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010110
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010110,
					"content": "Illuga'nın liderliğindeki \"Kabus Sarıasmaları\" Araştırma Birliği, bu savaşta belki de en tehlikeli görevi üstlendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010111
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010111,
					"content": "#Özellikle {NICKNAME} ve yoldaşı, kriz anında bir an bile tereddüt etmeden öne atılıp operasyonun başarısında hayati bir rol oynadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010112
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010112,
					"content": "Tüm tehlikelere göğüs gerdiler, fırtınayla yüzleştiler ve umutsuzluğun derinliklerinden zafere giden bir yol çizdiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010113
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010113,
					"content": "Yaşayanlar ve gelecek nesiller için savaşan herkes ve geride bıraktıkları miras sonsuza dek tarihe yazılacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010114
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010114,
					"content": "Evet, zafer bizim! Bedeli ağır oldu, doğru. Bir süre durup yas tutabiliriz, aramızdan ayrılanları anabiliriz... Ama kederin bizi tüketmesine izin vermemeliyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010115
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010115,
					"content": "Uğruna savaştığımız geleceğe sahibiz artık, bizden önce yolu aydınlatanların ateşini taşıyoruz. Onların ışığı parlamaya devam etmeli, biz de bunun için ilerlemeye devam etmeliyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761010116
					],
					"speakerTitle": "Nikita"
				},
				{
					"id": 761010116,
					"content": "Ama bugün kadehlerimizi zafere, cesaretleri asla unutulmayacak olan o yiğit ruhlara ve korumaya ant içtiğimiz geleceğe kaldıralım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nikita"
				}
			]
		},
