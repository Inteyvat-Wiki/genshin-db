						]
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7418304",
							"2"
						],
						"stepId": 7418304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mösyö Os"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741832201,
					"content": "Şimdi aklıma geldi de... Neuvillette de aslında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832202
					]
				},
				{
					"id": 741832202,
					"content": "Doğru ya! Neuvillette aslında Su Ejderhası'ydı, değil mi? Ee, bizim koca ejder Neuvillette'ten bile daha yaşlı mı demek bu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832203,
					"content": "Yeni bir Kadim Su Ejderhası mı doğdu? Eh, önceki Tüm Suların Hanımı'nın ölümünden bu yana epey vakit geçti tabii. Nasıl da akıp gidiyor zaman...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mösyö Os"
				}
			]
		},
		{
			"id": 7418323,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7418304",
							"2"
						],
						"stepId": 7418304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mösyö Os"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741832301,
					"content": "Her neyse, zalim ejderha Scylla bir zamanlar Sebastos'un dostuydu. Ne var ki Remurialılar ve Fontaineliler arasındaki savaş kritik bir noktaya vardığı sırada bir isyan başlattı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832302
					],
					"speakerTitle": "Mösyö Os"
				},
				{
					"id": 741832302,
					"content": "Scylla, vahşi Ejder Soyunu arkasına alarak onları Machimos'a yönlendirdi. Niyeti, içinde Sebastos'un da yaşadığı Capitolium'u basmaktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832303,
						741832304
					],
					"speakerTitle": "Mösyö Os"
				},
				{
					"id": 741832303,
					"content": "Machimos mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832305
					]
				},
				{
					"id": 741832305,
					"content": "Evet, kasabadakiler sürekli Machimos ve çan kulesi gibi şeylerden bahsediyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832306,
					"content": "Aynen. \"Machimos\", başkentin dışında yer alan bir şehirdir ve insafsız ejderha şehre girmek isterse öncelikle Janus Kapısı'ndan geçmesi gerekir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832307
					],
					"speakerTitle": "Mösyö Os"
				},
				{
					"id": 741832307,
					"content": "Bu, başkentin iç ve dış kısmını birbirinden ayıran bir bariyerdir. Ayrıca Sebastos ile müzisyenler tarafından oluşturulan ve Remuria'nın her tarafını kaplayan Senfoni, Janus Kapısı'ndan ve onun altın su yollarından geçiyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832308
					],
					"speakerTitle": "Mösyö Os"
				},
				{
					"id": 741832308,
					"content": "Boethius ile lejyonları da bunu fırsat bilip Janus Kapısı'nı kapattılar ve en sonunda o zalim ejderhayı mühürlediler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832309
					],
					"speakerTitle": "Mösyö Os"
				},
				{
					"id": 741832309,
					"content": "Belki de Scylla, Sebastos'un huzuruna varmak istemişti ama artık böyle bir fırsatı kalmadı. Daha sonra zalim ejderha, Remuria ile birlikte sulara gömüldü ve Sebastos da ortadan kayboldu, şimdiye kadar da onu gören olmadı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832310,
						741832311,
						741832312
					],
					"speakerTitle": "Mösyö Os"
				},
				{
					"id": 741832310,
					"content": "(Bu hikayede bir terslik var...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832313
					]
				},
				{
					"id": 741832313,
					"content": "#Bir şey mi hatırladın {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832314
					],
					"speakerTitle": "Mösyö Os"
				},
				{
					"id": 741832314,
					"content": "Tüm bunlar epey karmaşık geldi bana...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832315
					]
				},
				{
					"id": 741832315,
					"content": "Orası öyle... Felaket yaşandığı sırada başkentte olmadığım için ben de her şey olup bittikten sonra olaylardan haberdar oldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832316
					],
					"speakerTitle": "Mösyö Os"
				},
				{
					"id": 741832316,
					"content": "O zamanlar Sebastos'a ne olup bittiğini kimse bilmiyordu. Sanırım daha fazlasını öğrenmek için devam etmekten başka seçeneğimiz yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832317
					],
					"speakerTitle": "Mösyö Os"
				},
				{
					"id": 741832317,
					"content": "Kalede daha önce gördüğümüz o büyük parlak balık, Scylla'nın taştan hücresindeki çatlaklardan sızan düşünceleriydi herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832318
					],
					"speakerTitle": "Mösyö Os"
				},
				{
					"id": 741832318,
					"content": "Varlığımızı çoktan sezmiş olmalı. Bunca zamandır burada mühürlenmiş haldeyken dışarıdan gelenleri nihayet sezebildiğine göre, bizi de kendine çekmenin bir yolunu bulacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832319
					],
					"speakerTitle": "Mösyö Os"
				},
				{
					"id": 741832319,
					"content": "Demek öyle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832320,
					"content": "Dur bir dakika! Domus Aurea'ya giden yolun bu kapıdan geçtiğini falan söyledin ama Boethius kapıyı çoktan kapatmadı mı? Geçiş meçiş yok demek değil mi bu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832321,
					"content": "Geçmesi zor olacak tabii, orası kesin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832322
					],
					"speakerTitle": "Mösyö Os"
				},
				{
					"id": 741832322,
					"content": "Yetti ama, bu kadar da kaba olunmaz ki! Ortada açık bir kapı bile yok, gelmiş \"Sizi Domus Aurea'da bekleyeceğim, muhahaha!\" diye zırvalayıp duruyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832323,
					"content": "Acaba o zalim ejderhanın üstündeki mührü kaldırmanın bir yolunu mu bulsak? Sonra da daha önce yendiği düşmanını bulup ona kapıyı kırdırırız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832324,
					"content": "Olmaz! Böyle bir şeyi nasıl yaparız? Sonuçta Remuria'nın düşmanlarından birinden bahsediyoruz burada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832325,
						741832326
					],
					"speakerTitle": "Mösyö Os"
				},
				{
					"id": 741832325,
					"content": "Düşmanımın düşmanı dostum değil midir ama?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832327
					]
				},
				{
					"id": 741832327,
					"content": "Aynen öyle. Aradan uzun zaman geçti. Belki de yeni bir sayfa açıp artık iyi bir ejderha olmaya karar vermiştir, kim bilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832328,
					"content": "Ne olursa olsun sonuçta bir ejderha o...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741832329
					],
					"speakerTitle": "Mösyö Os"
				},
				{
					"id": 741832329,
					"content": "#E, ne var yani? Ejderhaysa da belki aklı başında, oturup konuşabileceğimiz türde bir ejderhadır. Hem ejderhalara daha önce de kafa tuttuk biz, değil mi {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741832326,
					"content": "İyi de ortada Remuria diye bir yer yok ki artık.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832327
					]
				},
				{
					"id": 741832311,
					"content": "(Daha önce gördüğüm o rüyada ise...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832313
					]
				},
				{
					"id": 741832312,
					"content": "(Scylla daha önce gelip Remus'u görmüş olmalı...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832313
					]
				},
				{
					"id": 741832304,
					"content": "Daha önce oradan bahsedildiğini duymuştum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832305
					]
				}
			]
