			"dialogs": [
				{
					"id": 741830401,
					"content": "Vay canına... Daha önce gördüğümüz o parlayan balığa benziyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830402,
					"content": "Yakınlardaki tepenin etrafında garip şeyler var... Neler oluyor böyle? Paimon'un kafası gittikçe daha da karışıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830403,
						741830404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830403,
					"content": "Bu sesi daha önce bir rüyada duymuştum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830405
					]
				},
				{
					"id": 741830405,
					"content": "Doğru. Onunla muhtemelen Sebastos'un rüyasında karşılaşmıştın, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830406
					],
					"speakerTitle": "Mösyö Os"
				},
				{
					"id": 741830406,
					"content": "Scylla, zamanında Sebastos'a hizmet eden insafsız bir ejderhaydı. Sonra Boethius tarafından zapt edildi ve buraya mühürlendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830407
					],
					"speakerTitle": "Mösyö Os"
				},
				{
					"id": 741830407,
					"content": "Ne diyorsun! Bizim huysuza bak sen, zalim bir ejderhayı dize getirmiş meğer! Paimon ondan böyle muhteşem bir şey beklemiyordu doğrusu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830408,
					"content": "Eh, \"insafsız ejderha\" diyorlardı ona ama aslında normalden biraz daha güçlü bir ejderdi sadece. Ne de olsa Tüm Suların Hanımı denizin derinliklerinde uyumaya devam ederken tek bir Su Ejderhası bile gelemezdi dünyaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mösyö Os"
				},
				{
					"id": 741830404,
					"content": "Adını artık hatırlayamıyorum ama...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830405
					]
				}
			]
		},
		{
			"id": 7418306,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7418306",
							"2"
						],
						"stepId": 7418306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Scylla",
					"Mösyö Os"
				],
				"points": [
					{
						"sceneId": 11,
						"position": [
							1569,
							656.42,
							4486
						],
						"pointId": 901101005
					}
				]
			},
			"dialogs": [
				{
					"id": 741830601,
					"content": "Ahh! Sıcacık, güzelim okyanus akıntıları! Nihayet özgürüm, nihayet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830602
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830602,
					"content": "Söyleyin bakalım ufaklıklar, yüzeyden mi geldiniz? Derin sulara gömülü bu hapishaneye ne sebeple geldiniz bilmiyorum ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830603
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830603,
					"content": "Ufak falan değiliz biz! Sen dev gibisin diye herkesi ufak sanıyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830604,
					"content": "Haha! Doğru! Neyse, beni binlerce yıldır buraya bağlayan zincirleri kırdınız. Size bir gönül borcum var artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830605
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830605,
					"content": "Yardımcı olabileceğim herhangi bir konu varsa söyleyin. Minnetimin bir göstergesi olarak üstüme düşeni yaparım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830606
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830606,
					"content": "#Hehe, Paimon makul biri olduğunu biliyordu! Neyse... Paimon'un adı Paimon, bu {NICKNAME}. Bu da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830607,
					"content": "Şey, Paimon sen ona ne diyorsun bilmiyor tabii ama biz ona Mösyö Os diyoruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830608,
					"content": "Oo, sen geldin demek Cassiodor. Uzun zaman oldu. Gelmeni de beklemiyordum doğrusu ama ne yazık ki geç kaldın. Binlerce yıl kadar geç kaldın hem de.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830609
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830609,
					"content": "Aa, bizim koca ejder sizi tanıyormuş meğer Mösyö Os!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830610,
					"content": "Alçak hainlere söyleyecek bir sözüm yok benim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830611
					],
					"speakerTitle": "Mösyö Os"
				},
				{
					"id": 741830611,
					"content": "Ağzından çıkanlara dikkat et fani! Biz ejderhaların soyundan geliriz. Sözümüzü tutar, kimseye ihanet etmeyiz. Senin o kibirli türün ise o kadarından bile aciz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830612
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830612,
					"content": "Hiç çeneni yorma! Zira benim gözümde sözlerinin zerre kadar değeri yok! İhanetin gün gibi ortada. Bize sırt çevirdiğiniz için savaşı kaybetmedik mi biz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830613
					],
					"speakerTitle": "Mösyö Os"
				},
				{
					"id": 741830613,
					"content": "O savaşı kaybetmeseydik... Ülkemiz de... Sebastos da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830614
					],
					"speakerTitle": "Mösyö Os"
				},
				{
					"id": 741830614,
					"content": "Ortalıkta değildin tabii, her şeyden bihabersin Cassiodor! Gerçekler düşündüğün gibi değil. Eh, gerçi gizli plandan haberdar olsaydın plan gizli olmaktan çıkardı ya zaten...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830615
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830615,
					"content": "... Gizli plan mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830616
					],
					"speakerTitle": "Mösyö Os"
				},
				{
					"id": 741830616,
					"content": "Başkente saldıran bir ejder ordusuna liderlik etmem aslında Remus'un son ve gizli planının bir parçasıydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830617
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830617,
					"content": "Tüm bunları ülkesini ve halkını kurtarmak için yaptı, gerçekten de çok erdemli bir adamdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830618,
						741830619
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830618,
					"content": "Kulağa çok saçma geliyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830620
					]
				},
				{
					"id": 741830620,
					"content": "Evet, bu işte bir tuhaflık var cidden. Bir hükümdar neden bir başkasından kendi ülkesini işgal etmesini istesin ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830621,
					"content": "Remus'un aklından ne geçtiğini senin benim gibiler bilebilir mi ufaklık? Durum ne olursa olsun bu dediklerimi göz önünde bulundur Cassiodor. Bundan sen bile bir anlam çıkarabilirsin bence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830623
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830623,
					"content": "Altın rehber arılar... Yalnızca Senfoninin çağrısına kulak verir onlar... Sebastos neden gücünü vahşi bir ejderhaya bahşetsin ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830624
					],
					"speakerTitle": "Mösyö Os"
				},
				{
					"id": 741830624,
					"content": "Çünkü bir anlaşmaları vardı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830625
					]
				},
				{
					"id": 741830625,
					"content": "Oo, öyle mi dersin? Pek de bilmiş çıktın ufaklık! Bunu nereden öğrendin bakalım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830626
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830626,
					"content": "Denize saçılmış anılardan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830627
					]
				},
				{
					"id": 741830627,
					"content": "Doğru söylüyorsun! Gerçekten de bir anlaşmamız vardı ama ben anlaşmayı bozdum. Onun asil fedakarlığını boş yere ziyan ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830628
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830628,
					"content": "Domus Aurea'ya zamanında yetişemedim! Ardından dalgalar tüm şehri yuttu ve soydaşlarım da kurtulamadı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830629
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830629,
					"content": "... Böyle bir şey nasıl...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830630
					],
					"speakerTitle": "Mösyö Os"
				},
				{
					"id": 741830630,
					"content": "Hıh! İhanetten bahsediyorsan eğer asıl hain olan Boethius idi bir kere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830631
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830631,
					"content": "Ben ki kadim ejderhalar çağından sonra ordulara önderlik etmiş bir prenstim... O yalancı, sahtekar şeytan ve tatlı dille söylediği yalanlar olmasa bu kadar kolay yenik düşer miydim hiç?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830632
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830632,
					"content": "O şeytan yalan söyleyerek ilk önce Remus'un emri üzerine direnişten vazgeçtiğini, sonra da lejyonlara direnişi durdurmaları emri verdiğini söyledi. Ancak oraya vardığımızda birden bize karşı ayaklandı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830633
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830633,
					"content": "Üzerinde uzunca düşündüm ve Remus'un planlarını bir şekilde öğrenmiş olduğu, bunun üzerine de kaçınılmaz bir tuzak kurup beni yavaş yavaş o tuzağa doğru çektiği kanaatine vardım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830634
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830634,
					"content": "O yüzden bedenim taşa dönüştü ve siz bugün gelip beni kurtarana kadar bin yıl boyunca öyle kaldım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830635
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830635,
					"content": "Boethius, yaptıklarının ne kadar büyük bir felaket getireceğini adı gibi biliyordu... Phobos üzerinde kontrol sahibi olmaya mı çalışıyordu acaba? Bu yüzden mi böyle bir günah işledi ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830636
					],
					"speakerTitle": "Mösyö Os"
				},
				{
					"id": 741830636,
					"content": "Hikayenin tamamını bilmiyormuşuz anlaşılan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830637
					]
				},
				{
					"id": 741830637,
					"content": "Yani diğerlerine hain deyip duruyordu ama asıl hain aslında en başından beri kendisiydi, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830638
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830638,
					"content": "Peki ama neden? Acaba gidip ona mı sorsak? Paimon net bir cevap alacağımızı düşünmüyor gerçi ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830639
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830639,
					"content": "Ne? O iğrenç, inatçı iblis solucan hâlâ yok olmadı mı yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830640
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830640,
					"content": "Öyle. Üstelik bir sürü Fontainelinin ruhunu da çaldı! Buraya gelme amacımız da aslında onları kurtarmaktı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830641,
					"content": "Bizi Domus Aurea'da bekleyeceğini söyledi... Şey, yani sadece Mösyö Os'u bekleyeceğini söylemişti, biz davetsiz misafiriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830699
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830699,
					"content": "Kapıyı aralık dahi bırakmamış, ne kadar da kaba biri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830642
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830642,
					"content": "Janus Kapısı mı? Hıh, her ne kadar bizi yıldırmak için ucuz numaralara başvurup dikkatimizi başka yöne çekmeye çalışsalar da günün sonunda abartılı bir taş kapıdan başka bir şey değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830643
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830643,
					"content": "Fiziksel formumu kaybetmiş olabilirim ama o ufaklıkları yanıma alıp sorunu çözmek pek de meşakkatli bir iş değil benim için.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830648
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830648,
					"content": "Bakın şimdi ufaklıklar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830644
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830644,
					"content": "Vaayy! Epey güvenilirmişsin ha koca ejder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830649
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830649,
					"content": "Şimdi yapmamız gereken tek şey açığa çıkmış bu mühürleri birer birer kırmak. Hazırsanız başlayalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830645
					],
					"speakerTitle": "Scylla"
				},
				{
					"id": 741830645,
					"content": "Pekala Mösyö Os. Hazır mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830646
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830646,
					"content": "Yüzdük yüzdük kuyruğuna geldik zaten. Başka çaremiz yok ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830647
					],
					"speakerTitle": "Mösyö Os"
				},
				{
					"id": 741830647,
					"content": "#Tamam o zaman. Peki ya sen {NICKNAME}? Hazır mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741830619,
					"content": "O da kafayı yemiş herhalde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830620
					]
				}
			]
		},
