				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741832101,
					"content": "Böyle cüsseli ejderler olduğunu hiç bilmiyordum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741832102
					]
				},
				{
					"id": 741832102,
					"content": "Hıh. Kültürsüz barbarlardan başka ne beklenirdi ki zaten. Çok daha garip bir şeye dönüşürlerse hiç şaşırmam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mösyö Os"
				}
			]
		},
		{
			"id": 7418322,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
