						207003302
					]
				},
				{
					"id": 207003302,
					"content": "Beni yanlış mı anladın, yoksa fark etmeyeceğimi filan mı düşündün?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003303
					],
					"speakerTitle": "Çareviç"
				},
				{
					"id": 207003303,
					"content": "O kutuların hassas olduğunu söyledim ama sen çoğunu paramparça etmişsin. Bunları nasıl satacağım şimdi?",
					"roleType": "TALK_ROLE_NPC",
