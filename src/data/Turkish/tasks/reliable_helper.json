				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Çareviç"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 207000101,
					"content": "Şanssızlığa bak. Bu Favonius Şövalyeleri var ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000102
					],
					"speakerTitle": "Çareviç"
				},
				{
					"id": 207000102,
					"content": "Bir sorun mu var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000103
					]
				},
				{
					"id": 207000103,
					"content": "Hah! Bu Favonius Şövalyelerinin hiçbir işten anladığı yok. İleride canavar olduğunu söylediler, geçmeme izin vermiyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000104
					],
					"speakerTitle": "Çareviç"
				},
				{
					"id": 207000104,
					"content": "Ama şimdiye kadar doğru dürüst bir açıklama dahi yapmadılar. Güven olmaz bunlara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000105
					],
					"speakerTitle": "Çareviç"
				},
				{
					"id": 207000105,
					"content": "Hâlâ yapmam gereken bir sürü iş var. Tüm bunların bana kaça patladığından haberleri var mı acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000106
					],
					"speakerTitle": "Çareviç"
				},
				{
					"id": 207000106,
					"content": "Bak sen... Bir maceracıya benziyorsun. Ne dersin, benim için küçük bir şey yapabilir misin? Karşılığını veririm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000107,
						207000109
					],
					"speakerTitle": "Çareviç"
				},
				{
					"id": 207000107,
					"content": "Tabii ki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000108
					]
				},
				{
					"id": 207000108,
					"content": "Harika. Açık sözlü insanları severim. İş bitince emeklerinin karşılığını fazlasıyla alacaksın, sözüm söz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000111
					],
					"speakerTitle": "Çareviç"
				},
				{
					"id": 207000111,
					"content": "Mondstadt civarındaki dağ yabanilerinin sayısı gitgide artıyor mu yoksa bana mı öyle geliyor? Sözde Şövalyeler var, bütün gün ne yapıyorlar kim bilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000112
					],
					"speakerTitle": "Çareviç"
				},
				{
					"id": 207000112,
					"content": "Yardım etmeyi kabul ettiğine göre bu canavarları da benim için defedersin artık. Ama orada tek başına olacaksın. Hımm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000113
					],
					"speakerTitle": "Çareviç"
				},
				{
					"id": 207000113,
					"content": "Boş ver. Dağın zirvesine, yamacına ya da eteğine gidip tek başına canavarların icabına bakabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000114
					],
					"speakerTitle": "Çareviç"
				},
				{
					"id": 207000114,
					"content": "Nereye gidersen git dağ yabanisinden başka bir şey görmeyeceksin zaten. Git hadi, vaktimi boşa harcama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Çareviç"
				},
				{
					"id": 207000109,
					"content": "Kaça anlaşırız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000110
					]
				},
				{
					"id": 207000110,
					"content": "Hah, işi nasıl hallettiğine göre değişir. Başarılı olursan emeklerinin karşılığını fazlasıyla alırsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000111
					],
					"speakerTitle": "Çareviç"
				}
			]
		},
