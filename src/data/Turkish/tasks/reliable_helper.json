			},
			"dialogs": [
				{
					"id": 207000304,
					"content": "Bugünlük bu kadar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000305
					]
				},
				{
					"id": 207000305,
					"content": "Favonius Şövalyeleri gibi baştan savma iş yaptın. Sana bir dakika demiştim! Unuttun mu yoksa beni kale bile almadın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000306
					],
					"speakerTitle": "Çareviç"
				},
				{
					"id": 207000306,
					"content": "Basit ayrıntıları bile görmezden geldiğin için... 1.000 Mora. Güle güle harca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000307
					],
					"speakerTitle": "Çareviç"
				},
				{
					"id": 207000307,
					"content": "1.000 Mora mı? Çok az!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 207000308,
