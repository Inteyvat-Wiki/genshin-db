					"speakerTitle": "Çareviç"
				},
				{
					"id": 207003306,
					"content": "Boş ver! Senin gibi bir dikkat yoksunuyla konuşacak bir şeyim yok benim. Al şu 1.000 Morayı da ne yaparsan yap!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003307
					],
					"speakerTitle": "Çareviç"
				},
				{
					"id": 207003307,
					"content": "1.000 Mora mı? Bu çok az!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207003308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 207003308,
					"content": "Çok mu az? Basit bir işi bile beceremediniz, bir de üstüne Mora mı istiyorsunuz? Bu kadarı size yeter de artar!",
					"roleType": "TALK_ROLE_NPC",
