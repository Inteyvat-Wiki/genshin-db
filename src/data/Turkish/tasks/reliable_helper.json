					"content": "İş tamam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207004302
					]
				},
				{
					"id": 207004302,
					"content": "Seni kenardan izledim farkındaysan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207004303
					],
					"speakerTitle": "Çareviç"
				},
				{
					"id": 207004303,
					"content": "İşleri kendi hızında yapmaya alışkın mısın, yoksa verdiğim emir bir kulağından girip diğerinden çıktı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207004304
					],
					"speakerTitle": "Çareviç"
				},
				{
					"id": 207004304,
					"content": "Snezhnaya'da \"sözünde durmak\" deriz, biliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207004305
					],
					"speakerTitle": "Çareviç"
				},
				{
					"id": 207004305,
					"content": "Verilen hizmetin karşılığını öderim, dediklerimi de harfiyen yaparım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207004306
					],
					"speakerTitle": "Çareviç"
				},
				{
					"id": 207004306,
					"content": "İşi tamamladın ama bu performansla... Sana anca 1.000 Mora ödeyebilirim. Al da ne yaparsan yap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207004307
					],
					"speakerTitle": "Çareviç"
				},
				{
					"id": 207004307,
					"content": "Ne? 1.000 Mora mı? O kadarcık Morayla ne yapabiliriz ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207004308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 207004308,
					"content": "Hıh. Çok mu az geldi? İşi baştan savma yaptınız. 1.000 Mora size çok bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Çareviç"
				}
			]
