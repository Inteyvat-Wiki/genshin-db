			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Çareviç"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 207000201,
					"content": "Bitti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207000202
					]
				},
				{
					"id": 207000202,
					"content": "Ne çabuk! Daha bir dakika bile geçmeden hem de! Yeteneklisin. Doğuştan yeteneklisin hatta, hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000203
					],
					"speakerTitle": "Çareviç"
				},
				{
					"id": 207000203,
					"content": "Güzel. 5.000 Mora, ne eksik ne fazla. Al bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000204
					],
					"speakerTitle": "Çareviç"
				},
				{
					"id": 207000204,
					"content": "\"Doğuştan yeteneklisin\" diyor ama 5.000 Mora veriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 207000205,
					"content": "Bu kadar mızmızlanmayın. Hizmet bedelini dikkatle hesapladım, emeğinizin karşılığı tam bu kadar ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207000206
					],
					"speakerTitle": "Çareviç"
				},
				{
					"id": 207000206,
					"content": "Daha çok Mora kazanmak için daha büyük işler yapmalısınız. Tekrar karşılaşma fırsatımız olursa o zaman şansınızı denersiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Çareviç"
				}
			]
		},
