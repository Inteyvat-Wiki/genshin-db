			"trigger": {
				"objectNames": [
					"Xu Liushi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190510301,
					"content": "Merhaba Gezgin. Deniz meteorolojisi hakkında bilgi almaya mı geldin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510302
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510302,
					"content": "Nereden bildin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510303
					]
				},
				{
					"id": 190510303,
					"content": "Haha, bu meslekte keskin bir görüşe sahip olmak gerekir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510304
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510304,
					"content": "Kaptanın sana talim kampını gezdirdiğini gördüm. Sonra da Yinxing ve Huixing ile konuşmaya gittin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510305
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510305,
					"content": "Bu yüzden kaptanın, bir denizcinin yaşamını görmeni istediğini düşündüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510306,
						190510307
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510306,
					"content": "İşinde gerçekten iyisin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510308
					]
				},
				{
					"id": 190510308,
					"content": "Hehe! Hadi başlayalım. Öncelikle sana meteorolojinin temellerinden bahsedeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510309
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510309,
					"content": "Temel olarak deniz meteorolojisi hem havayı hem de okyanustaki diğer olayları kayıt altına almak demektir. Mesela deniz sisi, fırtına dalgaları veya deniz hortumları gibi olayları.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510310
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510310,
					"content": "Tüm bunlar yolculuğumuzun güvenliğini tehdit edebilecek durumlardır. Neyse ki yaklaşan hava durumu ne olursa olsun her zaman bunu önceden bilebilmemizi sağlayan bir tür işaret olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510311
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510311,
					"content": "Deniz hortumları mesela... Okyanus üzerinde hızla dönen rüzgarlar yüzünden meydana gelirler. Büyük gemileri bile yutabilir ve büyük hasar verirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510312
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510312,
					"content": "Ama deniz hortumlarının sadece yüksek sıcaklığa ve neme sahip, büyük bulutların olduğu bir ortamda oluşabileceğini biliyorsanız hazırlık yapabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510313
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510313,
					"content": "Karşı yönde, çok farklı hızlarda esen rüzgarların olmasının da deniz hortumlarının oluşmasına direkt olarak sebep olduğunu biliyorsanız durumun çok daha farkında olabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510314
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510314,
					"content": "Bir de en önemlisi, bulutlarda beyaz bir girdap oluştuğunu görürseniz hemen mürettebata yaklaşan fırtınanın yolundan çekilmelerini söylemelisiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510315
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510315,
					"content": "İşte bu kadar. Deniz hortumunun işaretleri bunlar. Gururla söylemeliyim ki yıllardır ben nöbetteyken bir tanesi bile gözümden kaçmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510316,
						190510324
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510316,
					"content": "Gözlerin epey keskin galiba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510317
					]
				},
				{
					"id": 190510317,
					"content": "Denizi anlamakta iyiyimdir ama iş insanları anlamaya gelince, Kaptan kadar iyi değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510318
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510318,
					"content": "Wangshu Hanının yanındaki küçük balıkçı köyünü biliyor musun? Duyduğuma göre Kaptan çocukken orada yetişkinlerle balıkçılık yaparmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510319
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510319,
					"content": "Daha sonra limanda işe girmiş. Orada zar zor geçimini sağlamış. Çocukken öyle bir ortamda hayatta kalabilmek Kaptanın yeteneklerini ortaya koyuyor gerçekten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510320
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510320,
					"content": "O olmasa asla bu işi yapmayı düşünmezdim. Kendime güvenmemi sağladı ve yapabileceğimi söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510321
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510321,
					"content": "Belki duymamışsındır ama Güneyhaçı Filosu dışında ünlü bir hikayeden tanırlar beni. Hikayede ben, Üçüncü Rauntta Nakavt ve çok sayıda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510322
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510322,
					"content": "Sarhoş olup denize düşen ve eski mürettebatının dalga konusu olan acemi bir denizcinin daha sonra Güneyhaçı'nın gözcüsü olacağını kim bilebilirdi ki? Ama öyle oldu, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510323
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510323,
					"content": "İşte bu sadece yeteneğin yeterli olmadığının kanıtı. İnsanın karakterini iyi anlayabilen Kaptan gibi birine ihtiyaç var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510332
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510332,
					"content": "Zaman ayırdığın için teşekkürler. Şimdilik ihtiyacım olan her şeyi öğrendim sanırım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510333
					]
				},
				{
					"id": 190510333,
					"content": "Daha fazla bilgi almak istersen beni burada bulabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510324,
					"content": "Çok deneyimlisin galiba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510325
					]
				},
				{
					"id": 190510325,
					"content": "Açıkçası bildiğim neredeyse her şeyi Kaptandan öğrendim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510326
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510326,
					"content": "Sana az önce meteorolojiye dair anlattığım her şeyi... Asıl uzman Kaptan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510327
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510327,
					"content": "Wangshu Hanının yanındaki küçük balıkçı köyünü biliyor musun? Duyduğuma göre Kaptan Beidou çocukken orada balıkçılık yaparmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510328
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510328,
					"content": "Daha sonra limanda işe girmiş. Orada zar zor geçimini sağlamış. Çocukken öyle bir ortamda yetiştiğini düşünürsek denize dair her şeyi bilmesi şaşırtıcı değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510329
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510329,
					"content": "Filoya ilk katıldığımda önceki denizcilik kariyerim boşa mı gitti diye düşünür, her günümü endişe ve şüpheyle geçirirdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510330
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510330,
					"content": "Ama yavaş yavaş yeni şeyler öğrenip deneyim kazanırken sonunda Güneyhaçı'nın neden bu kadar harika olduğunu anladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510331
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510331,
					"content": "Sonuçta her filonun kaptanına \"Okyanusun Efendisi\" denmiyor. Sırf filoya katıldığım için bile şanslıyım bence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510332
					],
					"speakerTitle": "Xu Liushi"
				},
				{
					"id": 190510307,
					"content": "Görünüşe göre Beidou bu iş için doğru adamı bulmuş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510308
					]
				}
			]
