			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yinxing"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190510101,
					"content": "Merhaba Gezgin. Ben Yinxing. Güneyhaçı'nın cerrah denizcisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510102
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510102,
					"content": "Denizcilerden biri bir sağlık sorunu yaşadığında bana gelir. Deniz tutması ve nezleden ampütasyona her şeyle ben ilgileniyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510103
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510103,
					"content": "Denizde karşılaşılan sakatlıkların ve hastalıkların tedavisi hakkında bilgi almak isterim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510104
					]
				},
				{
					"id": 190510104,
					"content": "Bunu Kaptan ayarladı sanırım, değil mi? Tamam o zaman. Hadi başlayalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510105
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510105,
					"content": "Öncelikle şunu sorayım. Mürettebatın her yeni üyesinin karşılaştığı en büyük tehlike nedir sence?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510106,
						190510107,
						190510108
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510106,
					"content": "Deniz tutması mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510109
					]
				},
				{
					"id": 190510109,
					"content": "Evet, denizdeyken bu söylediğinde gerçekten sorun olabilir ama en büyük tehlike o değil. Yeni birisini bekleyen en büyük tehlike, denizden gelecek tehditleri hafife almaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510110
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510110,
					"content": "Kendilerini genç ve savaşa hazır görerek güvenliklerini hiç umursamayan birçok yeni mürettebat üyesi gördüm. Karada kendi başlarının çaresine bakacak kuvvette oldukları için denizde de sorun yaşamayacaklarını düşünüyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510111
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510111,
					"content": "Bunun gibiler sonunda kendilerini hep revirde bulurlar. Herkes bilmeli ki denizcilik, özellikle de uzun yolculuklarda, acımasız bir ortamda yapılan sert bir meslektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510112
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510112,
					"content": "Erzak azaldığında beslenme bozuklukları başlar. Sert okyanus havası birçok farklı türde sakatlığa ve hastalığa sebep olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510113
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510113,
					"content": "Ayrıca yalnızlıktan ve sıkıntıdan kaynaklanan psikolojik sorunlar da yaşanır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510114
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510114,
					"content": "Daha kötüsü, denizde ilaç ve tedavi imkanlarının eksikliği de küçük sağlık sorunlarının bile ciddileşmesine, hatta ölümcül olmasına yol açabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510115
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510115,
					"content": "Ampütasyon o yüzden mi gerekiyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510116
					]
				},
				{
					"id": 190510116,
					"content": "Haha, şaka yaptığımı sandın değil mi? Şaşırmadım. Yeni gelenlerin çoğu öyle sanıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510117
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510117,
					"content": "Ama umarım artık bu sorunların çoğunun biraz daha sıkı önlem alınarak önlenebileceğini anlamışsındır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510118
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510118,
					"content": "Şimdilik ikiniz bunları aklınızda tutsanız yeter bence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510119
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510119,
					"content": "Merak ettiğiniz başka bir şey var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510120,
						190510129,
						190510137
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510120,
					"content": "Beidou ne düşünüyor bu konuda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510121
					]
				},
				{
					"id": 190510121,
					"content": "Kaptan Beidou mu? Tanıştığım onca insan arasından insanların hayatına ve güvenliğine en çok değer veren muhtemelen odur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510122
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510122,
					"content": "Sadece doktor olsam da Beidou, denizciliğe uygun bulmadığım acemileri, uygun halde geri gelene kadar gemiden göndermek konusunda tam yetki verdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510123
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510123,
					"content": "Bir seyahatten önce erzak toplarken ilaçlar hep ilk sırada olur. Fiyatına bakmadan tedarikçileri seçmeme bile izin var. Tıbbi harcamalar için bütçemiz yeterli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510124
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510124,
					"content": "Muhasebecimiz Paragöz buna ne diyor biliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510125
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510125,
					"content": "Bunun büyük bir mali risk olduğunu. Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510126
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510126,
					"content": "Ama Beidou sağlıklı bir mürettebata sahip olmanın önemini biliyor. Bu yüzden her şeye rağmen beni yetkilendirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510127
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510127,
					"content": "Bana tamamen güveniyor ve bu sorunları çözebileceğimi düşünüyor... Tabii ben de onu hayal kırıklığına uğratmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510128
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510128,
					"content": "Yani soruna cevap olacaksa, Beidou böyle düşünüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510119
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510129,
					"content": "Mürettebattan uzuvları ampüte edilenlere ne oluyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510130
					]
				},
				{
					"id": 190510130,
					"content": "Onlar için endişelendin mi? Kaptan Beidou'nun senin diğerlerine benzemediğini düşünmesine şaşırmamalı. Tek özelliğin gücün değil anlaşılan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510131
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510131,
					"content": "Paragöz'ü sana defterlerimizi göstermeye ikna edersen göreceksin ki sabit bir bütçemiz var. İsmi \"Yaralı Mürettebat İçin İyileşme Ücretleri ve İş Göremezlik Yardımı\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510132
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510132,
					"content": "Filonun gelirine bakılmaksızın yanımızda savaşanlar her yıl tazminatlarını alacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510133
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510133,
					"content": "Karaya dönenlerden bazıları küçük işletmeler kurdu. Bazıları da dünya seyahatine çıkmayı tercih etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510134
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510134,
					"content": "Bu bütçe, hayatlarını olabildiğince özgürce geçirmelerini sağlamak için. Tabii karada yaşamak da büyük bir özgürlük sunuyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510135
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510135,
					"content": "Yine de bu her şeyi çözüyormuş gibi davranamayız. Bunlara boşuna yaşamı değiştiren sakatlıklar denilmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510136
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510136,
					"content": "Ama hiç değilse Kaptan Beidou Güneyhaçı'nın başındayken kimsenin yüzüstü bırakılmayacağını bilmek güzel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510119
					],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510137,
					"content": "Teşekkürler, çok şey öğrendim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510138
					]
				},
				{
					"id": 190510138,
					"content": "Memnuniyetle. Burada bırakalım o zaman. Sağlığına dikkat etmeyi unutma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yinxing"
				},
				{
					"id": 190510107,
					"content": "Nezle olmak mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510109
					]
				},
				{
					"id": 190510108,
					"content": "Bir uzvunu kaybetmek mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510109
					]
				}
			]
		},
		{
			"id": 1905102,
			"completionStepIds": [
				1905102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
