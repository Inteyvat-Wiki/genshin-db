						],
						"stepId": 1905102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Huixing"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190510201,
					"content": "Daha önce olanlar için özür dileriz Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510202
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510202,
					"content": "Seni filoya katılman ikna etmeye o kadar odaklanmışız ki abarttığımızı fark etmedik... İyi ki Kaptan bizi uyardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510203
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510203,
					"content": "Sorun değil. Haritacılık hakkında biraz daha bilgi almak istiyordum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510204
					]
				},
				{
					"id": 190510204,
					"content": "O zaman doğru kişiye geldin. Hava atmak gibi olmasın ama Liyue Limanı'ndaki en yetenekli haritacı karşında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510205
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510205,
					"content": "Yeni denizciler için bazı temel harita okuma bilgileri vererek başlayacağım. Sorun olursa durdurup sorabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510206
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510206,
					"content": "Eline bir dizi karmaşık harita geldiğinde nelere dikkat etmek gerektiğiyle başlayalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510207
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510207,
					"content": "Öncelikle mutlaka belirtilen kıyı şeritlerini, adaları, resifleri, su derinliklerini, hidrolojik koşulları ve diğer tehlikeleri aramalısın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510208
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510208,
					"content": "Bu özellikleri aklında bulundurarak o bölgede güvenli bir rota çizebilmek için ilk adımı atabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510209
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510209,
					"content": "Deniz haritaları görsel olarak diğerlerinden biraz farklıdır. Kara haritalarının aksine çoğu deniz haritasında belirli bir ölçek olmaz. Bu yüzden iki nokta arasındaki tam mesafeyi belirlemek zor olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510210
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510210,
					"content": "En gelişmiş deniz haritalarında yardımcı bir de grafik olur. Bunun üzerinde mesafeleri belirtmek için farklı renkte çizgiler vardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510211
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510211,
					"content": "Benim yönetimimde Güneyhaçı'nın bu gelişmiş teknikleri kullandığını da söylemeden geçmeyeyim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510212
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510212,
					"content": "Bazı haritacılar, haritaları üzerinde diğer önemli noktaları işaretler. Bu işaretler genelde onlara özel olur ve yanlarına not düşmemişlerse anlaması çok zor olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510213
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510213,
					"content": "Önceki haritacıdan kalan haritalar gibi mi mesela?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510214
					]
				},
				{
					"id": 190510214,
					"content": "Haha, sadece onlar değil. Her yerden topladığımız yırtık ve paramparça olmuş haritalarımız var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510215
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510215,
					"content": "Açıkçası bazen benim için bile çok zor oluyor. Bu haritalardan bazıları çok eski ve üzerlerinde daha önce hiç görmediğim semboller var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510216
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510216,
					"content": "Ama bunları çözmezsek denizin birçok gizemini kaçıracağımız kesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510217
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510217,
					"content": "Neyse ki Kaptan bizimle. Haritalar üzerinde daha fazla çalışmak için kullanabileceğim bazı antik göstergebilim kitapları buldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510218
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510218,
					"content": "Bu tür kaynakları Kaptanımızdan başkasının bulabileceğini düşünmüyorum. Eski haritalar ve antik göstergebilim kitapları her pazar yerinde satılmıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510219
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510219,
					"content": "Pardon! Konudan sapmışım, hehe. Harita okumanın temelleri bu kadar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510220
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510220,
					"content": "Merak ettiğin başka bir şey var mı Gezgin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510221,
						190510236
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510221,
					"content": "Deniz haritası çıkarmakta deneyimin var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510222
					]
				},
				{
					"id": 190510222,
					"content": "Harita çıkarmak mı? O kesinlikle daha ileri bir konu. Açıkçası o alanda sadece yüzeysel bir bilgiye sahibim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510223
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510223,
					"content": "Şu anda kullandıklarımız sadece önceki haritacıdan kalan haritaların düzenlenmiş halleri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510224
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510224,
					"content": "Yani haritacılık deneyimim genellikle haritalarımızı denizdeki değişikliklere uyarlamakla sınırlıydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510225
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510225,
					"content": "Kaptan Beidou'dan haritacılık hakkında daha fazla bilgi alabilirsin bence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510226
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510226,
					"content": "Bir keresinde filo yanlışlıkla henüz haritası çıkarılmamış bir bölgeye girdi. Muhtemel tehlikelerden kaçınmak için hemen filoyu geri çevirip geldiğimiz yönden geri çıktık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510227
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510227,
					"content": "Yine de Kaptan Beidou, bölgeyi tekrar keşfedecek olursak diye girdiğimiz bölgenin basit bir haritasını çıkarabildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510228
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510228,
					"content": "Harika, değil mi? Kaptanın haritacılık bildiğini görünce çok şaşırmıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510229
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510229,
					"content": "O zaman neden sana ihtiyacı olsun ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510230
					]
				},
				{
					"id": 190510230,
					"content": "Çünkü yetenekliyim ve Kaptan bunun boşa gitmesini istemiyor. Hehe. Bütün mürettebata böyle davranır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510231
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510231,
					"content": "Başta ben de bunu merak etmiştim. Çoğu filoda kaptan aynı zamanda rotayı da belirliyor sonuçta. O zamanlar bu kararını anlamamıştım. Ben de kendisine sordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510232
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510232,
					"content": "Sadece güldü ve daha akıllıca düşünmemi, Rex Lapis'in bile asla yalnız savaşmadığını söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510233
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510233,
					"content": "Güneyhaçı'nın sadece ona bağlı olmaması için filoda herkesin görevinde ustalaşmasını istiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510234
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510234,
					"content": "Böylece bir gün filodan ayrılırsa onun yokluğunda da seyahatlerimize devam edebileceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510235
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510235,
					"content": "Kaptan Beidou soğuk ve hatta bazen umursamaz davransa da aslında filodaki herkesin iyiliğini düşünür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190510220
					],
					"speakerTitle": "Huixing"
				},
				{
					"id": 190510236,
					"content": "Başka bir şey yok. Teşekkür ederim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190510237
					]
				},
				{
					"id": 190510237,
					"content": "Rica ederim. Kaptan Beidou'nun dostu benim de dostumdur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huixing"
				}
			]
		},
		{
			"id": 1905103,
