			"dialogs": [
				{
					"id": 752510101,
					"content": "Şerefe! Haaaaayne, hadi bir tur daha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752510102
					],
					"speakerTitle": "Papar"
				},
				{
					"id": 752510102,
					"content": "Hey! Sen de kimsin? Şu ağaçtan mı düştün?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752510103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752510103,
					"content": "Benim, Papar! Bir kadeh daha içelim dememiş miydik Hayne? Ne gece ama! Tanıştığımıza çok memnun oldum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752510104
					],
					"speakerTitle": "Papar"
				},
				{
					"id": 752510104,
					"content": "Iı... Hım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752510105
					],
					"speakerTitle": "Papar"
				},
				{
					"id": 752510105,
					"content": "Ha?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752510106
					]
				},
				{
					"id": 752510106,
					"content": "Hayne... Neden senden iki tane var? Biriniz uzun... Biriniz kısa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752510107
					],
					"speakerTitle": "Papar"
				},
				{
					"id": 752510107,
					"content": "Başkasıyla karıştırdın galiba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752510108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752510108,
					"content": "Hı? Ha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752510109
					],
					"speakerTitle": "Papar"
				},
				{
					"id": 752510109,
					"content": "Hayne! Neredesin? Hadi iç... *hıçkırır* İçmeye devam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752510110
					],
					"speakerTitle": "Papar"
				},
				{
