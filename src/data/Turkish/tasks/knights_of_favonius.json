				"objectNames": [
					"Jean"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3580101,
					"content": "... Sonra da onları hemen buraya getirdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580102
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3580102,
					"content": "Mondstadt'a hoş geldiniz, rüzgarın yol arkadaşları.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580103
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580103,
					"content": "Benim adım Jean, Favonius Şövalyelerinin Büyük Kumandan Vekiliyim. Bu Lisa, kendisi Kütüphanecimiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580104
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580104,
					"content": "Ah! Siz tatlı şeyler bize yardım etmek için mi buradasınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580105
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580105,
					"content": "Her ikiniz de çok sevimlisiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580106
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580106,
					"content": "Ne yazık ki, zamanlamanız çok talihsiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580107
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580107,
					"content": "Fırtına Dehşeti son zamanlarda yeniden ortaya çıkmasından bu yana, bölgenin altını üstüne getirmeye başladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580108
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580108,
					"content": "Basitçe anlatmak gerekirse, Mondstadt'ın element küresi ve ley hatları, şimdi bir kedi yavrusunun pençeleri arasındaki bir iplik yumağına benziyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580109
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580109,
					"content": "Bir büyücü için işler daha kötü olamazdı. Bir element parçacığı dahi cildimi berbat bir hale getirmeye yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580110
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580110,
					"content": "Eğer bu aksilik olmasaydı, Favonius Şövalyeleri sana yardım etmek için sadece kayıp ilanı afişleri asmakla kalmazdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580111
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580111,
					"content": "#Senden tek istediğimiz, biz {F#erkek kardeşini}{M#kız kardeşini} aramaya yardım ederken Mondstadt'ta dinlenmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580112,
						3580114
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580112,
					"content": "Ben de size yardım etmeliyim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580113
					]
				},
				{
					"id": 3580113,
					"content": "Paimon da yardım edecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3580116,
					"content": "Pekala. Bu durumda bir plana ihtiyacımız var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580117
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3580117,
					"content": "Fırtına Dehşeti artık Mondstadt'a doğrudan saldırdığı için, bu sorunu kökünden kesip atmak için bir fırsatımız olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580118
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580118,
					"content": "Lisa, tespit etme büyüsü ile Fırtına Dehşeti'nin gücünün kaynaklarını ortaya çıkardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580119
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580119,
					"content": "Öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580120
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3580120,
					"content": "Gücün kaynağı <color=#00E1FFFF>Dört Rüzgarın Tapınaklarında</color> bulunuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580121
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580121,
					"content": "Fırtına Dehşeti'nin bu türden fırtınalar çıkarma becerisi, tapınaklardan aldığı güçten kaynaklanıyor olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580122
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3580122,
					"content": "Hedefimiz, dört tapınaktan <color=#00E1FFFF>üçünün</color> icabına bakmak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580123
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580123,
					"content": "Neden yalnızca üçü ile uğraştığımızı herkesin anladığına inanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580124
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580124,
					"content": "Paimon anlamıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580125,
						3580126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3580125,
					"content": "Buralara özgü bir şey olmalı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580127
					]
				},
				{
					"id": 3580127,
					"content": "Favonius Şövalyeleri, zaman aleyhimize işliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580128
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580128,
					"content": "Fırtına azgın. Savunma odaklı bir pozisyonu korumanın hiçbir anlamı yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580129
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580129,
					"content": "Pekala. İnisiyatif alarak, durum daha kötüye gitmeden harekete geçmemiz gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 3580126,
					"content": "Daha sonra sorarız...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580127
					]
				},
				{
					"id": 3580114,
					"content": "O halde bu işi size bırakalım. Han ne tarafta?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580115
					]
				},
				{
					"id": 3580115,
					"content": "Hey! Bu kadar mıymıntı olma! Biz de bu işin bir parçası olmalıyız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580116
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}