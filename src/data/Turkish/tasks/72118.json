			},
			"dialogs": [
				{
					"id": 721180401,
					"content": "Harika! Bir bakayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180402
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180402,
					"content": "Şanslıyız. Mikage Ocağı'nın durumu dengeli ve içerideki enerji henüz aşırı yoğunlaşmış değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180403
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180403,
					"content": "Bu seviye yoğunlaşmada cihaz sorunsuz çalışacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180404
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180404,
					"content": "Bütün bu enerjiyi arındırmamıza gerek var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721180405
					]
				},
				{
					"id": 721180405,
					"content": "Bu cihaz onu yapabilseydi patenti için çoktan başvuruda bulunurdum ama buradaki güzel arkadaşımız sadece sınırlı bir alandaki enerji seviyelerini düşürebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180406
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180406,
					"content": "Fakat Mikage Ocağı'nın etkisizleştirilmesinin ve otomatik yeniden başlama programının çalışmamasının sebebi Tatarigami enerjisinin yüksek yoğunluk oranı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180407
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180407,
					"content": "En yüksek yoğunluktaki alanı bulup arındırabilirsek çekirdeği yeniden başlatabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180408
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180408,
					"content": "O zaman Mikage Ocağı'nın yeniden başlaması gerekir ve o noktadan sonrasında oluşan sorunlar bizi ilgilendirmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180409
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180409,
					"content": "Plan bu ama harekete geçmeden önce yapmam gereken son birkaç hazırlık var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
