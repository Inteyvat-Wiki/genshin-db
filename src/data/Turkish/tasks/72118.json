				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721180101,
					"content": "Nihayet! Sonunda bitti. Neyse ki bu özellikleri hatırlıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180102
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180102,
					"content": "Tatarigami enerjisini arındırmaya mı gidiyoruz o halde?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721180103
					]
				},
				{
					"id": 721180103,
					"content": "Her ne kadar gidip bu işi bitirmek istesem de Tatarigami karşısında aceleci davranmamalıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180104,
					"content": "Ayrıca gerekli malzemelerden bazılarını bulamadım, o yüzden son dakikada alternatif malzemeler kullanmak zorunda kaldım. Yani sonuç olarak bu cihazın güvenilirliği...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180105
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180105,
					"content": "Hımm. \"Bazı durumlarda istenen etkiyi yakalayamayabilir\" diyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180106
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180106,
					"content": "Normalde düzgün çalışır evet ama bir kaza durumunda elimizde patlar. En ufak bir sarsıntıda bazı bileşenler muhtemelen yerinden oynayacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180107,
					"content": "Durum böyle olunca bu yeni arkadaşı kullanmadan önce biraz daha hazırlık yapmamız lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180108
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180108,
					"content": "Mikage Ocağı'nın yakınına gidip benim için birkaç veri toplamanı rica edeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180109,
						721180111
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180109,
					"content": "Oldu bil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721180110
					]
				},
				{
					"id": 721180110,
					"content": "Çok teşekkürler. Seni burada bekleyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180111,
					"content": "Bu kadar dikkatli olmamıza gerek var mı cidden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721180112
					]
				},
				{
					"id": 721180112,
					"content": "Elbette var. Dürüst olmak gerekirse normal protokolün birkaç adımını atlıyorum zaten. Bay Flois burada olsaydı onun sürecini tamamlamak bir haftamızı alırdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180113
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721180113,
					"content": "Neyse, yapacak bir şey yok bu durumda ve proje inceleme panelinin temsilcisi olarak bu karar teknik olarak benim... Yani yaklaşımımızı duruma göre uyarlamamız için bize izin veriyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
