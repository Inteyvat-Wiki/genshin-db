			"dialogs": [
				{
					"id": 765110101,
					"content": "Leydi Nefer yanılmadıysa beklediğimiz uzman her an gelebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110102
					],
					"speakerTitle": "Sieciech"
				},
				{
					"id": 765110102,
					"content": "Kesinlikle Bay Sieciech. Akşam rüzgarları onun haberini çoktan getirdi bile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110103
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765110103,
					"content": "#{NICKNAME}, Paimon, merhaba. Görüşmeyeli uzun zaman oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110104
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765110104,
					"content": "İkinizi de böyle keyifli görmek beni çok mutlu etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110105,
						765110106
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765110105,
					"content": "Kazuha? Sen misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110107
					]
				},
				{
					"id": 765110107,
					"content": "Vay canına, seni Nod-Krai'da görmeyi beklemezdik. Hele ki bir Işık Muhafızıyla sohbet ederken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765110108,
					"content": "Hımm... Bir saniye... Neden aranızda bir gerginlik varmış gibi geliyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765110109,
					"content": "Şaşıracak bir şey yok. Yarışma zirve noktasına ulaştı ve farklı uluslardan gelen dövüş sanatları ustaları şimdi nihai sonucu bekliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110110,
						765110111
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765110110,
					"content": "Yarışma mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110112
					]
				},
				{
					"id": 765110112,
					"content": "Evet. Nod-Krai Teknik Dövüş Yarışması finallerine hoş geldiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110113
					],
					"speakerTitle": "Sieciech"
				},
				{
					"id": 765110113,
					"content": "Her hareketin serbest olduğu dövüşlerin aksine bu şampiyonada yarışmacının silah tekniklerini kullanışı ve bu tekniklerdeki ustalığı ön planda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110114
					],
					"speakerTitle": "Sieciech"
				},
				{
					"id": 765110114,
					"content": "İşte bu yüzden yarışma komitesi Maceracılar Loncasına gidip danışman olarak Güneyhaçı Filosu mensubu bir kılıç ustasının getirilmesini talep etti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110115
					],
					"speakerTitle": "Sieciech"
				},
				{
					"id": 765110115,
					"content": "Anlaşıldı! Demek bu seferki yarışmanın jürisi sensin Kazuha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765110116,
					"content": "Doğru, aslında ben de biraz şaşırdım. Güneyhaçı Yarışmasının Nod-Krai'a kadar ulaşmış olmasını beklemiyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110117
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765110117,
					"content": "Kaptan Beidou ve diğerleri bir ticaret fuarı için daha yeni Nasha Kasabası'na gelmişlerdi. Buradaki işleri bittiğine göre yakın zamanda geri gelmeleri pek olası değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110118
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765110118,
					"content": "Bana gelince, şu aralar boşum ve Güneyhaçı Yarışmasından biraz tecrübeliyim de. Bu yüzden Bay Sieciech'in davetini kabul ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110119
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765110119,
					"content": "Bay Kazuha'nın keskin gözleri ve mutlak tarafsızlığı sayesinde en zorlu karşılaşmalarda bile doğru kararlar verebildik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110120
					],
					"speakerTitle": "Sieciech"
				},
				{
					"id": 765110120,
					"content": "Fakat şimdi bir sorunumuz var: Üç finalist de kendi çapında oldukça güçlü ve teknik olarak hiçbiri bir diğerini aşamıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110121
					],
					"speakerTitle": "Sieciech"
				},
				{
					"id": 765110121,
					"content": "Bu gidişle günlerce dövüşseler bile bir sonuç çıkmayabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110122
					],
					"speakerTitle": "Sieciech"
				},
				{
					"id": 765110122,
					"content": "Nasıl yani? Bu nasıl bir yarışma? Paimon daha önce hiç böylesini duymamıştı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765110123,
					"content": "Bence şu konuştuğumuz planı uygulasak iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110124
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765110124,
					"content": "Katılıyorum. Sorunumuzu çözmek için uzmanların uzmanına güvenmemiz gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110125
					],
					"speakerTitle": "Sieciech"
				},
				{
					"id": 765110125,
					"content": "#Ha? Ne oluyor? {NICKNAME} neden birdenbire ortamın yıldızı oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765110126,
					"content": "Becerilerinin bir kısmını dahi göstersen önümüzdeki açmazı kırmaya yetebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110127,
						765110128
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765110127,
					"content": "Bir gösteri düellosu mu yapmamı istiyorsunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110129
					]
				},
				{
					"id": 765110129,
					"content": "Hayır, tam olarak değil. Güneyhaçı Yarışmasının şampiyonu ve gerçek bir dövüş sanatları ustası olarak, galibi belirleyecek son imtihan sen olacaksın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110130
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765110130,
					"content": "Üç finalistin her biriyle sırayla yüzleşeceksin, biz de seni ne kadar zorlayabildiklerine göre onları değerlendireceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110131
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765110131,
					"content": "En yüksek puanı alan finalist şampiyon ilan edilecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110132
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765110132,
					"content": "Katkıların için de yarışmanın para ödülünün yarısını sana vereceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110133
					],
					"speakerTitle": "Sieciech"
				},
				{
					"id": 765110133,
					"content": "Paimon'a göre bu... Pek de alışılmış bir çözüm değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765110134,
					"content": "Ama açmazı çözeceği kesin, hem biz de kazançlı çıkacağız! Harika bir çözüm Kazuha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110135,
						765110136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765110135,
					"content": "Doğrusu daha önce hiç böyle bir şey duymadım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110137
					]
				},
				{
					"id": 765110137,
					"content": "O zaman anlaştık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110138
					],
					"speakerTitle": "Sieciech"
				},
				{
					"id": 765110138,
					"content": "#Şimdiden teşekkürler {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765110139
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765110139,
					"content": "Üç rakibinin de kendine has becerileri var. Mücadelelerin tadını çıkaracağından ve gerçek bir şampiyon gibi davranacağından hiç şüphem yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765110136,
					"content": "Gerçekten de yeni bir yaklaşım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110137
					]
				},
				{
					"id": 765110128,
					"content": "Yarışmaya hareket katmamı mı istiyorsunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110129
					]
				},
				{
					"id": 765110111,
					"content": "Dövüş sanatları mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110112
					]
				},
				{
					"id": 765110106,
					"content": "Uzun zaman oldu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765110107
					]
				}
			]
		}
	]
}