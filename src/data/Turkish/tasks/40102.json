						"stepId": 4010206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaveh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401020601,
					"content": "Kapıyı ilk çaldığımızda içeriden çıt sesi bile gelmiyordu, evde kimse yok sandık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020602,
					"content": "Ee, dikkatli olmam gerek. Akademiden biri buraya gelip Alhaitham'ı arasa ve ben hiç düşünmeden kapıyı açsam, kısa sürede tüm şehir benim burada yaşadığımı öğrenir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020603
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020603,
					"content": "Bu konuda epey dikkatlisin demek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020604,
					"content": "Peki... Sen evdeyken biri içeri girip onu aramaya kalkışsa ne olacak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020605,
					"content": "Ben kendi odamda olduğum sürece sorun değil. Hem neden biri onu aramak için içeriye dalsın ki? Çoğu kişi öyle bir şey yapmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020606
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020606,
					"content": "Haklısın. Ee, sen şimdi onun nerede olduğunu biliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020607,
					"content": "Sence? Boş zamanında kim bilir nereye gidiyordur, şu anda benim için önemli olan tek şey onun evde olmaması!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020608
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020608,
					"content": "Tartışma falan mı yaşadınız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020609
					]
				},
				{
					"id": 401020609,
					"content": "Bana kalırsa bir tartışma değildi. Sorun iki çift hoş söz söylemeyi beceremiyor olması!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020610
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020610,
					"content": "Ona ikinci turun nasıl geçtiğini anlattım. Kura çekilişini ben kazandım, hatırlıyorsun değil mi? Tabii ki iyi karma sayesinde kazandım, şans benden yanaydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020611
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020611,
					"content": "Ama o, onun dedikleri... Anlatacaklarımı bitirdiğimde neler söylediğine inanamazsınız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020641
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020641,
					"content": "\"Üst sınıfım olduğunu hemen hatırlatmaktan çekinmezsin ama sorunu çözme şeklin hiç üst sınıftan birine yakışır değil. Bu durum akla, kıdemliliğe neden prestij atfettiğimiz sorusunu getiriyor.\" \"Üst sınıftan birine yakışır\" derken ne demek istiyor? Ne yani, şimdi benim üst sınıf unvanını hak etmem mi gerekiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020642
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020642,
					"content": "Bu kadarıyla da kalmadı! Şöyle devam etti:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020612
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020612,
					"content": "\"Her turda neden şansına güvenmek durumunda kaldığını bir düşünmeni isterim. Açıkçası bariz gerçekleri görmeden ve kabul etmeden bu yaşa kadar nasıl gelebildiğini anlayamıyorum.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020613
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020613,
					"content": "Hahaha... Evet, bu tam da Alhaitham'ın söyleyeceği bir şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020614,
					"content": "Artık burama geldi! Onunla ne zaman konuşsam hep aynı! Ne yapıp ne edip beni çileden çıkarıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020615
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020615,
					"content": "Her neyse, bu küçümseyici tavrımız kendisiyle karşılıklı. En kısa zamanda buradan taşınacağım. Hatta tam da şimdi eşyalarımı topluyordum. Artık kendi odasını kendi temizler, eşyalarını da kendi toparlar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020616
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020616,
					"content": "Bakın, duvara kusursuz asılı şu resimler var ya? Onları da götüreceğim! Heh, hayatında sanatsal zevkin zerresi varsa bugünden sonra artık o da olmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020617
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020617,
					"content": "Dur, şimdiden çıkıp gidiyor musun? Yarışma bitmedi daha ama, nasıl geçineceksin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020618,
					"content": "Şey, henüz gidemiyorum tabii. Sadece eşyalarımı şimdiden topluyorum ve önceden hazırlığımı yapıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020619
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020619,
					"content": "Yeni evimi çoktan buldum. Ödül parasını alır almaz gidip orayı satın alacağım ve eşyalarımı da taşıyacağım. En fazla üç gün içerisinde buradan temelli gitmiş olurum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020620
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020620,
					"content": "Bu hedefime ulaşmak için ne yapmam gerektiğini biliyorum. Üçüncü turda ne olursa olsun ben kazanacağım ve yarışmadan zaferle ayrılacağım! Göreceksiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020621
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020621,
					"content": "Pekala, biz de senin arkanda olacağız ama sen... İyi olacağından emin misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020622,
					"content": "Hımm? Nasıl yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020623
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020623,
					"content": "Layla senin bazen kendinle çeliştiğini düşünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020624
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020624,
					"content": "... Tam olarak ne demek oluyor bu? Siz de ciddi bir kişilik bozukluğumun olduğunu düşünmüyorsunuz, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020625
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020625,
					"content": "Öyle bir şey demedik! Ancak şöyle bir düşün. Kazanmak istediğini söylüyorsun ama Faruzan puanları sana vermek istediğini söylediğinde onu reddettin. Hem sonra o Çöl Tilkilerine yardım etmeyi de kendine vazife edindin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020626,
					"content": "İyi de bunların nesi tuhaf ki? Sebebini daha önce söylemiştim, eğer tersini yapsaydım kendimi suçlu hissederdim... Bunun neresi çelişki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020627
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020627,
					"content": "Neden suçlu hissedecektin ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020628
					]
				},
				{
					"id": 401020628,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020629
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020629,
					"content": "Şey, birden böyle sorunca... Evet, gerçekten neden? Güzel bir soru. Sanırım bu benim doğamda var. Ayrıca hiçbir şey yapmasaydım ve daha sonra kötü bir şey olsaydı kendimi suçlamadan edemezdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020630
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020630,
					"content": "Ama sürekli böyle düşünmek de hayatını çok yorucu hale getirir. Yardım ederek kendini tehlikeye attığından hiç bahsetmiyoruz bile... Çölün ortasında bayılmak mesela, gerçekten buna değer miydi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020631,
					"content": "O durum biraz karışık... Bakın, şimdilik bu konuyu bir kenara bırakalım, size neden Alhaitham'ın yardımı gerekiyordu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020632
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020632,
					"content": "Onun Sachin'i araştırmasına yardım edecektik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020633
					]
				},
				{
					"id": 401020633,
					"content": "Sachin mi? Hah, son zamanlarda o da Sachin diye birinden bahsediyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020634
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020634,
					"content": "O gün eve birkaç belge getirdiğini hatırlıyorum. Belgeleri okurken bir yandan da sesli bir şekilde düşünüyordu, bazı notlar alıp bir şeyleri karalıyordu. Hatta benim de bakmamı söyledi ama ben bakmadım. Bir saniye, gidip o notları bulayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020635
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020635,
					"content": "Bu olmalı. Bunu alın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020636
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020636,
					"content": "Iı... Bunları bize vermene bir şey demesin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020637
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020637,
					"content": "İzin mi istemem lazım? O canı istediğinde benim biramdan alıp içiyor ama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020638
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020638,
					"content": "Her neyse, notları okumak isteyip istemediğimi sormuştu, ben de o zaman gerek olmadığını düşünmüştüm. O da notları buraya koymuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020639
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020639,
					"content": "Başkalarının okumasını istemese notlarını öyle ortalığa koymaz. Sorun yok, güvenin bana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020640
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020640,
					"content": "Peki, madem öyle diyorsun. Sachin hakkında neler yazmış bakalım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
