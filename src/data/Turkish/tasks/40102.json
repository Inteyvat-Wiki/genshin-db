			},
			"dialogs": [
				{
					"id": 401020201,
					"content": "Merhaba, görüşmeyeli uzun zaman oldu. Bildireceğiniz herhangi bir sorun var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020202
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401020202,
					"content": "Dehya ve Candace ile ilgili durumu Aarav'a anlatıyorsunuz...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401020203
					]
				},
				{
					"id": 401020203,
					"content": "Birileri Sachin'i mi kaçırmayı planlıyormuş? Aman tanrım... Gerçi çok da şaşılacak bir şey değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020204
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401020204,
					"content": "Cümbüşün artan popülerliği, sponsor olarak onun da itibarını çok artırdı. \"Süper zengin\" tiplerden biri gibi görülüyor artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020205
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401020205,
					"content": "Artık birilerinin hedefinde olduğuna göre onu korumak için birkaç adam göndermen gerekmez mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020206,
					"content": "Aslına bakarsan biz de tam öyle yapmayı düşünüyorduk ama Sachin görünüşe göre zamanının çoğunu dışarıda saha çalışması yaparak geçiriyor ve nadiren Sumeru Şehri'ne geliyor. Kimse onunla iletişime geçemedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020207
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401020207,
					"content": "Elimizdeki tek ipucu onun bir zamanlar dediği bir şey... \"Darşanlar Şampiyonası her düzenlendiğinde malımı mülkümü miras bırakabileceğim uygun birini seçmek için yakınlardan izliyor olacağım.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020208
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401020208,
					"content": "Halen bu sözüne sadık kaldığını düşünürsek şehirde bir yerlerde olmalı. Söz konusu Münzeviler de onunla ilgili bir şeyler duymuş olmalı ki buraya gelip şanslarını denemek istemişler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020209
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401020209,
					"content": "Yani Sachin'in nerede olduğunu onlar da bilmiyordur, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020210,
					"content": "Sanırım hayır. Her neyse, Mahamatra Cyno hâlâ tatilde olduğundan bu işi ben halledeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020211
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401020211,
					"content": "Merak etme. Adam kaçırmaya niyetli birkaç kişi bugünlerde Sumeru Şehri'nde öyle elini kolunu sallayarak dolaşamaz. Onları ortaya çıkaracak yöntemlerim var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020212
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401020212,
					"content": "Bu arada, Sachin'in hikayesiyle ilgileniyorsanız siz de onun peşine düşsenize?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020213
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401020213,
					"content": "Nerede olduğunu ne kadar erken öğrenebilirsek, güvenliğini sağlamak için de o kadar hızlı harekete geçebiliriz. Yani, tüm Matrayı ve Otuzlu Teşkilatı onu korumak için görevlendirsek bile kendisi ortaya çıkmazsa yapabileceğimiz pek bir şey yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020214
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401020214,
					"content": "Haklısın. Onu biz de aramalıyız ama nereden başlayacağız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020215,
					"content": "Sachin hakkında Matranın elinde hiçbir bilgi var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020216
					]
				},
				{
					"id": 401020216,
					"content": "Korkarım ki yok. Hiçbir suça karışmadı veya akademik protokolü çiğnemedi, bu yüzden elimizde onun hakkında ayrıntılı bir dosya yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020217
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401020217,
					"content": "Alhaitham'ın Büyük Bilge Vekilliği konumundan çekildiğini ve tekrar Katipliğe döndüğünü duydum. Belki o bir şeyler biliyordur, gidip ona sorabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020218
					],
					"speakerTitle": "Aarav"
				},
				{
					"id": 401020218,
					"content": "Güzel fikir. Pekala, Cümbüş alanına geri dönelim ve onu bulabilecek miyiz bakalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
