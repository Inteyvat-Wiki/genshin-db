			"dialogs": [
				{
					"id": 401020301,
					"content": "Of... Selam Nilou, Alhaitham'ı gördün mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020302,
					"content": "Alhaitham mı? Görmedim, ne oldu ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020303
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 401020303,
					"content": "Birini arıyoruz da, bazı kayıtları incelemesi için onun yardımına ihtiyacımız var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020304,
					"content": "Hım, anladım... Üzgünüm, nereye gittiğini bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020305
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 401020305,
					"content": "Yarışma bitince ilk önce o ayrılır ve nereye gittiğini kimseye söylemez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020306
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 401020306,
					"content": "Ha. Tam da onun yapacağı bir davranışa benziyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020307,
					"content": "Bir düşüneyim... Dürüst olmak gerekirse hiç de Cümbüşle ilgileniyormuş gibi durmuyordu. Muhtemelen bu civarda değildir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020308
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 401020308,
					"content": "Ona göre yorumcu olmak zorla ikna edildiği ek işten başka bir şey değildi. İşten sonra gittiği yerleri biliyor musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020309,
						401020312
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 401020309,
					"content": "Hana olabilir mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020310
					]
				},
				{
					"id": 401020310,
					"content": "Şey... Son bir tur daha var. Yarışmanın ortasında kalkıp hana gidecek hali yok, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020311
					],
					"speakerTitle": "Nilou"
				},
				{
					"id": 401020311,
					"content": "Aa! Şimdi aklıma geldi, doğruca evine gitmiş olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020314,
					"content": "Paimon, onun evinin buradan çok da uzak olmadığını hatırlıyor. Evine gidip bir baksak iyi olur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020312,
					"content": "... Eve mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020313
					]
				},
				{
					"id": 401020313,
					"content": "Evet, olabilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020314
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
