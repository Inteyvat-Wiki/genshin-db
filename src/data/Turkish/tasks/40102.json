			},
			"dialogs": [
				{
					"id": 401020101,
					"content": "Bunca zamandır kafanı meşgul eden bir şey var sanki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020102,
						401020103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020102,
					"content": "(Yarışma başlamadan önce gördüğüm o beyaz saçlı adam...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020104
					]
				},
				{
					"id": 401020104,
					"content": "#{NICKNAME}, Paimon! Sizi nihayet buldum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020105
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 401020105,
					"content": "\"Nihayet\" mi? Bir şey mi oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020106,
					"content": "Bu seneki Akademi Cümbüşünde tuhaf bir şeylerin döndüğünü düşünmüyor musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020107
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 401020107,
					"content": "Az önce Candace ile birlikte kafedeydik ve sanırım buraya iş yapmaya gelen paralı askerler gördük. Asıl olay şu ki, alışveriş için gelmiş turist kılığına girmişlerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020108
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 401020108,
					"content": "Ama hiçbir kılık o pis kan kokusunu bastıramaz. Askerlerin şüpheli bakışlarına bakılırsa adam kaçırma veya suikast gibi kötü işlerin peşinde olduklarına bahse girerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020109
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 401020109,
					"content": "Onları bir süre gizlice dinledik. Hedefleri Sachin adında biriymiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020110
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 401020110,
					"content": "Sachin mi? Açılış töreninde Kareena'nın bahsettiği kişi değil mi o?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020111,
					"content": "Görünüşe göre yarışma ödüllerinin ve Bilgelik Tacının sponsoru o adam ama kendisi ortalıkta hiç görünmedi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020112,
					"content": "Zengin birine benziyor, tamam... Şimdi taşlar yerine oturdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020113
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 401020113,
					"content": "Münzeviler son zamanlarda zaten kıt kanaat geçiniyordu ve birçok grup da bu yüzden zenginlerle alakalı \"özel\" işler yapıyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020114
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 401020114,
					"content": "Kendi ifadelerine göre tek bir iş onları altı ay götürüyormuş. Bunun gibi bir iş ise kendilerini bir süre rahat ettirecek kadar Mora bırakır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020115
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 401020115,
					"content": "Cümbüş ile birlikte Sumeru Şehri'ne bir anda çok fazla turist geldi. İçeri sızmak için bu karmaşadan yararlanmış olmalılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020116
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 401020116,
					"content": "Dehya ve ben onları hemen oracıkta yakalamak istedik ama tetikte bekliyorlardı, bir bahane uydurup kaçtılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020117
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 401020117,
					"content": "Kargaşa çıkmayacak olsaydı onları orada tutup bağlardım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020118
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 401020118,
					"content": "Bu tür bir olayla resmi olarak kim ilgilenmeli? Matra mı? Otuzlu Teşkilat mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020119
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 401020119,
					"content": "Hımm... Cyno burada olsaydı kesin işin içine girerdi. Akademiye gidip olanları bir Matraya anlatmaya ne dersiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020120,
					"content": "İkinize de çok teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020121,
					"content": "Rica ederiz. Biz de tesadüf eseri karşılaştık zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020122
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 401020122,
					"content": "Evet, endişeye gerek yok. Bu alçaklar başarılı olursa Münzevilerin itibarı iyice yerle bir olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020123
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 401020123,
					"content": "Ama burası Sumeru Şehri. Candace ve ben burada dilediğimiz gibi hareket edemeyiz, bu yüzden bu işi sizlere bırakıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020124
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 401020124,
					"content": "Olur da yardımımız gerekirse bizi kafede bulabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020125
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 401020125,
					"content": "Paimon, senin canını sıkan bir şey olduğunu düşünüyor. Cümbüşten dolayı mı böylesin? Çünkü Paimon burada görünenden çok daha fazla şeyin döndüğünü düşünmeye başladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020126,
					"content": "Ah, böyle düşünmenin de bir faydası yok. Hadi gidip bir Matra bulalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020103,
					"content": "(İlk tur sona erdikten sonra kulak misafiri olduğumuz o gizli konuşma...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020104
					]
				}
			]
		},
		{
