					}
				]
			},
			"dialogs": [
				{
					"id": 401020501,
					"content": "Ne kadar çok bilgi var... Paimon'un başı döndü iyice.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020502,
					"content": "Yani özetle, Sachin malının mülkünün yönetimi için Akademiyi görevlendirdi ve kendisi araştırma yapmaya gitti, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020503,
					"content": "Yarışmacılardan birini beğenirse ona sadece bir ödül değil, tüm malını mülkünü vereceğini de söylemiş... Ne kadar çok Mora yapar o!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020504,
					"content": "Ne? Ciddi misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020505
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020505,
					"content": "Sachin'in tüm serveti... Benim ömrümde harcayabileceğimden çok daha fazla. Olur da ben seçilirsem tüm borçlarımı ödeyebilir ve kendime yeni bir ev alabilirim, üzerine de daha dünya kadar para kalır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020506
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020506,
					"content": "Yeni bir Alkazar Sarayı inşa ederdim... Ama bu sefer öncekinden on kat daha büyük yapardım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020507
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020507,
					"content": "Bir de Ormos Limanı'ndaki o köprü yenileme projesi var tabii. Onu düzgün bir şekilde yapmak için de nereden baksan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020508
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020508,
					"content": "Hey hey, kendine gel artık! Kendini çok kaptırdın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020509,
					"content": "Haklısın. Öncelikle kazanmaya ve bu evden taşınmaya odaklanmalıyım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020510
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020510,
					"content": "Hım? Bir saniye, bu sayfaların arasına sıkıştırılmış bir kağıt parçası var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020511,
					"content": "Alhaitham mı yazmış? Anlaşılan aklına bir şeyler geldikçe bu şekilde not alıyormuş. Hımm bir bakalım... İki cümle daire içine alınmış:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020512,
					"content": "\"Sachin, ölü mü yoksa yaşıyor mu? Bilinmiyor...\" ve \"Bilgelik Tacı\" mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020513,
					"content": "Yazdıklarından bazıları hiç anlaşılmıyor. Başka bir dilde mi yazılmış acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020514,
					"content": "Ver bakayım... Hı? Ben bu dili biliyorum. Hımm, bir saniye...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020515
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020515,
					"content": "\"Büyük idealler hayatın anlamsızlığına karşı koruma sağlamaz ama küçük kararlar sağlar...\" Kabaca böyle çevrilebilir, yüzde yüz doğru olduğunu garanti edemem tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020516
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020516,
					"content": "... Hımm? Altta küçük bir yazı daha var... Hah... Acaba bundan neden bahsetti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020517
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020517,
					"content": "Vay canına, bu dili okuyup anlayabiliyor olman harika!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020518,
					"content": "Öğrenciyken \"Kral Deshret Medeniyeti Harabelerinin Run ve Mimari Felsefe Çözümlemesi\" adlı bir projede birlikte çalışmıştık. O zamanlar bu dili biraz öğrenmek durumunda kalmıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020519
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020519,
					"content": "Vay, ilginçmiş! Peki... Tüm bunlarla Alhaitham ne demek istemiş olabilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020520,
					"content": "Heh. Kim bilir? Onun aklının nasıl çalıştığı dünyanın en büyük gizemlerinden biri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020521
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020521,
					"content": "Madem öyle, Paimon burada öğreneceğimiz başka bir şeyin kalmadığını düşünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020522,
					"content": "Umarım Aarav bir ilerleme kaydetmiştir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020523
					]
				},
				{
					"id": 401020523,
					"content": "Aynen, o dolandırıcıları yakalasa iyi eder. Ama o zamana kadar... Hadi gel gidip biraz gezelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 4010206,
			"completionStepIds": [
				4010206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4010206",
