			"dialogs": [
				{
					"id": 401020401,
					"content": "Önce kapıyı çalalım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020402,
					"content": "(Kapıyı çal.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020403
					]
				},
				{
					"id": 401020403,
					"content": "Ses yok... Evde kimse yoktur belki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020404,
					"content": "(Kapıyı çal.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401020405
					]
				},
				{
					"id": 401020405,
					"content": "Kimse var mııı? Alhaitham? Orada mısın? Bir konuda yardımın lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020406,
					"content": "Aa, siz miydiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020407
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401020407,
					"content": "Aa, Kaveh! Evde miydin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401020408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401020408,
					"content": "... Kapıyı açayım, içeri gelin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaveh"
				}
			]
		},
		{
			"id": 4010205,
