			"dialogs": [
				{
					"id": 401025001,
					"content": "Cümbüş esnasında birinin böyle bir şeyi denemeye cesaret etmesine şaşırdım. Sachin'in serveti ne kadar da iştah kabartıcıymış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401025002
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 401025002,
					"content": "Eline birden o kadar çok Mora geçseydi ne yapardın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401025003
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 401025003,
					"content": "Bilmem, daha önce hiç düşünmedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401025004
					],
					"speakerTitle": "Candace"
				},
				{
					"id": 401025004,
					"content": "Hadi, aklına ilk gelen şeyi söyle. Nereye, nasıl harcardın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401025005
					],
					"speakerTitle": "Dehya"
				},
				{
					"id": 401025005,
					"content": "Hımm... Yiyecek alırdım, su kaynakları arardım... Bu tür şeyler yapardım herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Candace"
				}
			]
		},
