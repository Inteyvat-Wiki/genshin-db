			"dialogs": [
				{
					"id": 711100201,
					"content": "Hey dostum, sen de mi buraya fotoğraf yarışmasına katılmaya geldin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100202
					],
					"speakerTitle": "Mali"
				},
				{
					"id": 711100202,
					"content": "Kameranın ana vatanından çıkmış Fontaineli bir fotoğrafçı olarak size birkaç tavsiyede bulunayım. Asıl fotoğrafçılık Kameranın kendinde başlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100203
					],
					"speakerTitle": "Mali"
				},
				{
					"id": 711100203,
					"content": "İşte ben de bu yüzden sizi biriyle tanıştırmak istiyorum. Memleketimde onun ürettiği Kameralardan memnun olmayan yoktur. Fiyatları da gayet uygun, isterseniz sizin için de bir tane ayarlayabilirim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100204
					],
					"speakerTitle": "Mali"
				},
				{
					"id": 711100204,
					"content": "Hey... Bana öyle garip garip bakmayın! Sizin için ekstra indirim yaptıracağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100205
					],
					"speakerTitle": "Mali"
				},
				{
					"id": 711100205,
					"content": "Durun... Gitmeyin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mali"
				}
			]
		},
