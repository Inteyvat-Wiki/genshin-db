			"dialogs": [
				{
					"id": 711100101,
					"content": "\"Chenyu Vadisi Yürüyüşümüz\" manzara fotoğrafı yarışmasına katılmaya mı geldiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100102
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100102,
					"content": "Manzara fotoğrafı yarışması mı? O da ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100103,
					"content": "Adı üstünde, Chenyu Vadisi'nin güzel manzaralarını tanıtmak için düzenlenen bir yarışma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100104
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100104,
					"content": "Vadinin en etkileyici manzaraya sahip yerleriyle ilgili daha önce Vadi sakinleriyle bir anket yapmıştık. Bu yarışmada da katılımcıların söz konusu yerlere gidip Kameralarıyla o yerlerin fotoğrafını çekmelerini istiyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100105
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100105,
					"content": "Yarışma sona erdiğinde, fotoğraflar arasından en iyi olanları seçeceğiz ve Hezhe Ofisinin bulunduğu caddede tanıtım amacıyla sergileyeceğiz. Nasıl? Siz de katılmak ister misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100106,
						711100108
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100106,
					"content": "Ben sonuca bakarım, ödül var mı sen onu söyle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100107
					]
				},
				{
					"id": 711100107,
					"content": "Tabii ki var. Sizin çektiğiniz fotoğraflar seçilirse sadece size özel bir sürpriz de olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100110
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100110,
					"content": "Vaay, sürpriz mi? Elimizden gelenin en iyisini yapmamız lazım o zaman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100111,
					"content": "Hehe, fotoğraflarınız seçilmezse üzülmenize gerek yok. Vakit ayırıp çabaladığınız için yine de memnun kalacağınız küçük bir ödül alacaksınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100112
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100112,
					"content": "Nereden başlıyoruz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100113
					]
				},
				{
					"id": 711100113,
					"content": "Bu rehbere bakabilirsiniz. Burada Vadi sakinlerinin tavsiye ettiği manzaraların yerleri var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100115
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100115,
					"content": "Hımm? Neden bazı yerlerin üzeri çizilmiş?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100116,
					"content": "Çünkü o yerler için yeterince başvuru aldık. Chenyu Vadisi'nin güzelliğine dair daha kapsamlı bir sergi yapmak istiyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100117
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100117,
					"content": "Kalan bu dört yer için başvurabilirsiniz. İsterseniz birini, isterseniz dördünü birden seçebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100118
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100118,
					"content": "#Paimon şimdi anladı... {NICKNAME}, kalan yerlerin hepsi için başvuralım mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100119,
					"content": "Eğer kazanma şansımız dörtte bir ise dört yerin dördünü de seçersek kazanma şansımız yüzde yüz olur! Böylece, sürpriz ödül kesin bizim olur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100120,
						711100123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100120,
					"content": "Öyle olacağını pek sanmıyorum ama.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100121
					]
				},
				{
					"id": 711100121,
					"content": "Gerçekten mi? Ama dört çeyrek bir tam yapmaz mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100122,
					"content": "Evet yapar ama bu başka...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100124
					]
				},
				{
					"id": 711100124,
					"content": "Hehe! Neyi bekliyoruz o zaman? İşe koyulalım! O sürpriz bizim olacak, başka yolu yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100123,
					"content": "Matematiğin de bayağı iyiymiş Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100124
					]
				},
				{
					"id": 711100108,
					"content": "Harika. Fotoğraf çekme konusunda kimse benimle boy ölçüşemez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100109
					]
				},
				{
					"id": 711100109,
					"content": "Epey sabırsızlanıyor gibisiniz. Bu arada, çektiğiniz fotoğraflar seçilirse sadece size özel bir sürpriz de olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100110
					],
					"speakerTitle": "Fangju"
				}
			]
		},
