			"dialogs": [
				{
					"id": 711101101,
					"content": "Hey ufaklık, bu pelikan sizin mi? Onu, Qiaoying Köyü ile aynı karede çekebilir miyiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101102,
					"content": "Cibili cibili cibili, şak şak şak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101103
					],
					"speakerTitle": "Mingjing"
				},
				{
