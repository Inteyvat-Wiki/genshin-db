			"dialogs": [
				{
					"id": 711101001,
					"content": "Ah, gelmişsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101002
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101002,
					"content": "Sergilenen fotoğrafları gördünüz mü? \"Chenyu Vadisi Yürüyüşümüz\" yarışması için toplamda sekiz fotoğraf seçildi ve bunların yarısı sizden!",
