					"nextDialogs": [
						711101104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101104,
					"content": "Pelikan dili bu, \"olur, olur\" manasında!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101105
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101105,
					"content": "Sen pelikanca mı konuşuyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711101106
					]
				},
				{
					"id": 711101106,
					"content": "Birazcık... Yemek yerken onların durmadan \"Cibili cibili cibili, şak şak şak!\" dediğini fark ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101107
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101107,
					"content": "Mutlu bir şekilde \"olur, olur\" dediklerine eminim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101108
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101108,
					"content": "Ben de onları bu şekilde çağırmayı öğrendim. Böyle der demez hemen geliyorlar, büyük ihtimalle yiyecek vereceğimi düşünüyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101109
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101109,
					"content": "Fotoğraf çekmek istiyorsanız siz de deneyebilirsiniz! Kusura bakmayın, benim şu anda eve gitmem gerek. Yoksa size daha fazlasını öğretirdim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101110
					],
					"speakerTitle": "Mingjing"
				},
				{
					"id": 711101110,
					"content": "Sorun değil ufaklık! Biz de bir deneyelim bakalım! Teşekkür ederiz, dikkatli git!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101111,
					"content": "#{NICKNAME}, hadi biz de deneyelim! Bir pelikanın dikkatini çekmeyi başarabilirsek güzel bir kare de yakalayabiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
