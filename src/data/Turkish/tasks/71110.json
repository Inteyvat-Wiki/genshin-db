			"dialogs": [
				{
					"id": 711101701,
					"content": "İşte orada! Fontaineli düzenbaz tüccar! Şansım gerçekten dönmeye başladı herhalde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101702
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101702,
					"content": "Hemen koşup üzerine mi atlasam ki? Ama o zaman da Chenyu Vadisi'nin bu harika fotoğraflarını kaçırırım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101703
					],
					"speakerTitle": "Akai"
				},
				{
					"id": 711101703,
					"content": "Hayır... Şimdi onun peşine düşersem daha çok zararıma olur. En iyisi önce fotoğraflara bakayım, özellikle de kendi çektiğim fotoğrafa...",
