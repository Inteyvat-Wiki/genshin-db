					"nextDialogs": [
						711101004
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101004,
					"content": "Vay canına! Bu harika bir haber!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101005,
					"content": "#Gördün mü {NICKNAME}? Paimon sana ne demişti? Dörtte dört yaptık! Paimon'un matematiği de uçuyor resmen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101006,
						711101007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101006,
					"content": "Aslında sekiz üzerinden dört.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711101008
					]
				},
				{
					"id": 711101008,
					"content": "Hehe, jüriler de benim gibi diğer iki fotoğrafınızı çok beğendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101009
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101009,
					"content": "Pekala, lütfen bu \"Chenyu Vadisi Yürüyüşümüz\" hatıra fotoğrafı albümünü kabul edin. Yarışmada seçilen tüm fotoğraflar bir arada, bunu hak ettiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101010
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101010,
					"content": "Sürpriz bu muydu? Ayy, mükemmel görünüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711101011,
					"content": "Sizin için de uygunsa lütfen bu Mora ödülümüzü kabul edin. Katıldığınız için kendi adıma da teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101012
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101012,
					"content": "Burası benim memleketim olduğu için bizzat teşekkür etmek istedim. Çünkü bu yerin güzelliğini daha önce hiç kimse bu kadar iyi ortaya koyamadı, sayenizde çok daha fazla kişi buraya aşık olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711101013
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101013,
					"content": "Teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711101007,
					"content": "Vay canına! Paimon'a bak sen!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711101008
					]
				}
			]
