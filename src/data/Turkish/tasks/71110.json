			"dialogs": [
				{
					"id": 711100801,
					"content": "Hımm... Bu fotoğraflar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100802
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100802,
					"content": "Nesi var? Olmamış mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100803,
					"content": "Tam tersi... Son günlerde mükemmel bazı fotoğraflar gördüm ama sizinki bir başka seviyede.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100805
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100805,
					"content": "Mesela şu Qiaoying Köyü fotoğrafı... Pelikan, sakin köye farklı bir canlılık katmış ve dinginlik ile hareketlilik arasındaki o kontrast harika yakalanmış... Cidden benzersiz bir yaklaşım olmuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100806
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100806,
					"content": "Tek jüri ben olsaydım kesinlikle sizin fotoğraflarınızı seçerdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100807
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100807,
					"content": "Vay! Ne hoş bir iltifat! Paimon'un yanakları kızardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100808,
						711100810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100808,
					"content": "Senin niye yanakların kızarıyor? Sanki sen çektin fotoğrafları!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100809
					]
				},
				{
					"id": 711100809,
					"content": "Paimon senin adına gurur duymuştu oysaki! Sonuçta senin ne kadar mütevazı olduğunu Paimon'dan başkası bilemez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100811,
					"content": "Her halükarda seçim süreci yarın sabahtan önce tamamlanmış olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100812
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100812,
					"content": "Seçilen fotoğrafları sabah sekizden akşam altıya kadar Hezhe Ofisinin bulunduğu caddede sergileyeceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100813
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100813,
					"content": "\"Chenyu Vadisi Yürüyüşümüz\" manzara fotoğrafı yarışmasına katıldığınız için teşekkür ederiz. Yarın uğramayı unutmayın lütfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711100814
					],
					"speakerTitle": "Fangju"
				},
				{
					"id": 711100814,
					"content": "Merak etme! Final sürprizini kaçıracak değiliz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711100810,
					"content": "Ben de biraz utanmaya başladım sanırım, hehe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711100811
					]
				}
			]
		},
