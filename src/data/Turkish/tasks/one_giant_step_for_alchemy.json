			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Timaeus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 409110102,
					"content": "Ne oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110103
					]
				},
				{
					"id": 409110101,
					"content": "Gezgin! Merhaba! Vaktin var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110102
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110103,
					"content": "Şey... Seni böyle durdurduğum için özür dilerim ama bir konuda yardımına ihtiyacım var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110104
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110104,
					"content": "Bildiğin üzere simya çalışmalarımda ilerleme kaydedemedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110105
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110105,
					"content": "Yani, ben de aynı şeyleri tekrar tekrar deneyemeyeceğimi fark ettim. Bu yaklaşımın, bana ilerleme sağlamayacağı apaçık ortada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110106
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110107,
					"content": "Biyo-simyaya geçmeye mi karar verdin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110108
					]
				},
				{
					"id": 409110109,
					"content": "Simya sanatının temeline mi ineceksin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110110
					]
				},
				{
					"id": 409110106,
					"content": "Ben de başka bir şeye odaklanmaya karar verdim. Başka bir açıdan yaklaşayım, daha önce hiç yapılmamış bir şey yapayım dedim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110107,
						409110109
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110108,
					"content": "Biyo-simya yeni bir şey değil. Biyo-simya üzerine araştırma yapan insanlar zaten var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110111
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110110,
					"content": "Kadimlerin simya sanatından mı bahsediyorsun? Hayır, onlar benim üzerine araştırma yapabileceğim bir konu değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110111
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110111,
					"content": "Simyadaki en önemli etkenin ne olduğunu biliyor musun? Elementler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110112
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110112,
					"content": "Birçok nedenden dolayı simya, saf element enerjisinin kendisi yerine, element enerjisiyle birleştirilmiş olan eşyalar ile yapılıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110113
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110113,
					"content": "Doğal olarak bu da dönüşüm sürecinin saflığını bozarak element tepkimesini daha az etkili kılıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110114
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110114,
					"content": "Bunu telafi edebilmek için çok fazla element malzemesi kullanmamız gerekiyor. O zaman bile dönüşüm süreci sırasında çok dikkatli olmamız gerekiyor çünkü sürecin saflığının bozulması, çıkacak olan ürünü mahvedebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110115
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110115,
					"content": "Ne yazık ki bu durum, Önsezileri kullanmadan simya yapmak isteyenlere ek masraf yaratıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110116
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110116,
					"content": "En büyük sorun, element enerjisiyle birleştirilmiş eşyaların ucuz olmaması.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110117
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110117,
					"content": "Bir madde dönüşümünün ortalama faturası, çalışmalarımızın meyvesinden çok daha şaşırtıcı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110118
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110119,
					"content": "Önsezim de yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110120
					]
				},
				{
					"id": 409110121,
					"content": "Yani, ne yapmamı istiyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						409110122
					]
				},
				{
					"id": 409110118,
					"content": "*iç çeker* Belki de bu yüzden hiç kayda değer ilerleme kaydedemedim. İlerleme kaydedebilmek için aşılması gereken engeller son derece çetin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110119,
						409110123
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110120,
					"content": "Doğru ama senin element enerjisini manipüle edebildiğini duydum, doğru mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110123
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110122,
					"content": "Önsezin olmasa da element enerjisini manipüle edebildiğini duydum. Bu doğru mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110123
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110123,
					"content": "Olay şu; yeni tür bir simya fırını tasarladım, adı <color=#00E1FFFF>Element Potası</color>. Çalışma mantığı ise...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110124
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110124,
					"content": "Aslında saf element enerjisini tutabilen ve element tepkimesi oluşturabilen bir kazan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110125
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110125,
					"content": "Şansım varsa eğer, Element Potası simya becerilerimi bir sonraki seviyeye taşıyacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110126
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110126,
					"content": "Her şey tamam. Sadece saf element enerjisini hareket ettirebilecek birine ihtiyacım var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110127
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110127,
					"content": "Yardım etmek istiyorsan, lütfen benimle <color=#00E1FFFF>Bin Rüzgar Tapınağında</color> buluş. Adamlarım orada her şeyi hazırladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						409110128
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 409110128,
					"content": "Umarım simyadaki dönüm noktam bu olur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Timaeus"
				}
			]
		},
