					"nextDialogs": [
						761060402
					]
				},
				{
					"id": 761060402,
					"content": "İşe alım yaparken \"aşırı küstahlık\" kriteri mi koyuyoruz? Bir saniye... Sen yeni işe alınanlardan biri değilsin ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761060403
					],
					"speakerTitle": "Veroslava"
				},
				{
					"id": 761060403,
					"content": "Demek içeri sızabileceğini sandın. Gözümden kaçamadın! Yakalayın şunu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Veroslava"
