			"dialogs": [
				{
					"id": 761060301,
					"content": "Gerçekten mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060302
					]
				},
				{
					"id": 761060302,
					"content": "Elbette! İçeride çalışan herkese fazladan bir bardak Elma Şırası veriliyor. Sağlıklarına zarar vermese insanlara neden böyle güzel şeyler versinler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761060303
					],
					"speakerTitle": "Veroslava"
				},
				{
					"id": 761060303,
					"content": "Ayrıca Donuk Ayın Çocuklarının bölgesinde bizzat gördüm! Rahibelerin kafalarından boynuzlar çıktı! Bu normal mi sence?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761060304
					],
					"speakerTitle": "Veroslava"
				},
				{
					"id": 761060304,
					"content": "Anladım... Uyarı için teşekkürler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060305
					]
				},
				{
					"id": 761060305,
					"content": "Bu çok korkunç! B-Biz de mi canavar olacağız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761060306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761060306,
					"content": "*iç çeker* Riskli işlere hep çömezleri gönderiyorlar... Dikkatli ol ve uzun süre orada kalma, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Veroslava"
				}
			]
		},
		{
