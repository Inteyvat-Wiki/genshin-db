			},
			"dialogs": [
				{
					"id": 80110201,
					"content": "Ne korkunç bir yer... Burası her zaman var mıydı? Yemin ederim burayı daha önce hiç fark etmedim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110202,
						80110203
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110202,
					"content": "Baksana...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110204
					]
				},
				{
					"id": 80110204,
					"content": "Hı? Sanki... İbadet ediyorlar. Bir yürüyorlar, bir diz çöküp ibadet ediyorlar... Ayrıca çok içten duruyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110205
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110205,
					"content": "Hayatımda hiç böyle bir şey görmedim. Burada gizli ne var acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110206
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110206,
					"content": "Bunu öğrenmenin tek bir yolu var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110207
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110207,
					"content": "(Buradaki hava ve bu korkunç sahne... Ürkütücü bir şekilde tanıdık geliyor...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 80110203,
					"content": "O dağ yabanileri ne yapıyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110204
					]
				}
			]
		},
