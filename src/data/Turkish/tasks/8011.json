					"nextDialogs": [
						80110503
					]
				},
				{
					"id": 80110503,
					"content": "(Zincirlere sarılı, havada asılı ve ortama uğursuz bir hava yayıyor... Onu tanımamanın imkanı yok. Kirli Heykele çok benziyor!)",
