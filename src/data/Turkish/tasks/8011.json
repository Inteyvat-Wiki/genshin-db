			"dialogs": [
				{
					"id": 80110401,
					"content": "O da kimdi? O... Yoksa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110402,
						80110403
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110402,
					"content": "Korktun mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110404
					]
				},
				{
					"id": 80110404,
					"content": "... O tek kelimeyle mükemmel bir varlıktı. Hayretler içindeyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110405
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110405,
					"content": "... Ha?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110406
					]
				},
				{
					"id": 80110406,
					"content": "Olağanüstü bir havası, tehlikeli ama güzel bir gücü vardı... Gerçekten büyüleyiciydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110407
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110407,
					"content": "Ama sen yine de onu yenmeyi başardın. Düşündüğümden çok daha güçlüymüşsün. Hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110408,
						80110409
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110408,
					"content": "Alışılmışın dışında zevklerin var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110410
					]
				},
				{
					"id": 80110410,
					"content": "Devam edelim. Her geçen saniye daha çok meraklanıyor ve heyecanlanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110409,
					"content": "Çok savaş deneyimim oldu, ondan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110410
					]
				},
				{
					"id": 80110403,
					"content": "Daha önce de benzerleriyle karşılaştım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110404
					]
				}
