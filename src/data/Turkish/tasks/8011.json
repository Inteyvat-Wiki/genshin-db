					"nextDialogs": [
						80110303
					]
				},
				{
					"id": 80110303,
					"content": "Hımm, \"izleme\" konusunda ısrar ediyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110304
					],
					"speakerTitle": "Kaderin Elçisi"
				},
				{
					"id": 80110304,
					"content": "... Pekala, o zaman ben de sana kaderin imtihanını veriyorum.",
