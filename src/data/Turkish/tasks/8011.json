				{
					"id": 80110504,
					"content": "(Yani Hiçlik Tarikatı ile bir alakası var. Bu ibadet eden dağ yabanileri bana biraz Yüce Hırsızı hatırlatıyor...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110505
					]
				},
				{
					"id": 80110505,
					"content": "Eide, burada bir uğursuzluk var. Hemen gitmeliyiz!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110506
					]
				},
				{
					"id": 80110506,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110507
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110507,
					"content": "Eide?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110508
					]
				},
				{
					"id": 80110508,
					"content": "... Ey sevgili yaratık, neden önümde eğiliyorsun? Bilinmeyenden korktuğun için mi, yoksa çok istediğin bir güç için mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110509
					],
					"speakerTitle": "Üret"
				},
				{
					"id": 80110509,
					"content": "(Bu kimin sesi? Kafamın içinden geliyor olmalı... Eide bunu duyamıyor mu?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110510
					]
				},
				{
					"id": 80110510,
					"content": "... Ey sevgili yaratık, neden önümde eğiliyorsun? Çünkü ben tanrı değilim... Sadece bir \"Günahkarım\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110511
					],
					"speakerTitle": "Üret"
				},
				{
					"id": 80110511,
					"content": "(Bir \"Günahkar\" mı?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110512
					]
				},
				{
					"id": 80110512,
					"content": "Günahın içine doğmuş saf ve lekesiz bir çiçek gibisin... Senin kaderini iyi biliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110513
					],
					"speakerTitle": "Üret"
				},
				{
					"id": 80110513,
					"content": "Artık dargınlıklarını bastırmana veya sayısız yalanı kabul etmene gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110514
					],
					"speakerTitle": "Üret"
				},
				{
					"id": 80110514,
					"content": "Durmadan ilerle, varlığının sınırlarını aş. Sana bahşedilen kaderin ötesine geç...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110515
					],
					"speakerTitle": "Üret"
				},
				{
					"id": 80110515,
					"content": "Zamanın sonu geldiğinde... Hayatına bakıp gözyaşı dökeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110516
					],
					"speakerTitle": "Üret"
				},
				{
					"id": 80110516,
					"content": "(... Sen kimsin? Bu sözler ne anlama geliyor?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110517
					]
				},
				{
					"id": 80110517,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110518
					],
					"speakerTitle": "Üret"
				},
				{
					"id": 80110518,
					"content": "(Ses... Gitti...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110519
					]
				},
				{
					"id": 80110519,
					"content": "!!!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110520
					]
				},
				{
					"id": 80110520,
					"content": "... Eide?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110521
					]
				},
				{
					"id": 80110521,
					"content": "*nefes nefese kalır* Az önce ne oldu öyle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110522
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110522,
					"content": "O şeyi gördüğümde kalbim bir anda huzurla doldu... B-Bir huşu kapladı içimi... Sevinçti belki de.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110523
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110523,
					"content": "Şimdi iyi misin peki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110524
					]
				},
				{
					"id": 80110524,
					"content": "Ben... İyiyim. Hatta... Buraya geldiğimden beri daha iyi hissediyorum. Çok tuhaf...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110525
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110525,
					"content": "Burada ters giden bir şeyler var... Hemen gitmemiz gerek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110526
					]
				},
				{
					"id": 80110526,
					"content": "Ah, ö-öyle mi? Tamam, nasıl istersen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110527,
					"content": "Uğursuz mağaradan çıkıp Eide'ın evine dönüyorsunuz.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 801106,
			"completionStepIds": [
				801111,
				801112
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"801111",
							"2"
						],
						"stepId": 801111,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Eide"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80110601,
					"content": "Caribert! Ah, şükürler olsun, durumu hâlâ iyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110602,
						80110603
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110602,
					"content": "Yine de Yedilerin Heykeline gitmemiz gerekmiyor mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110604
					]
				},
				{
					"id": 80110604,
					"content": "... Az önce yaşananların kader olduğuna dair tuhaf bir his var içimde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110605
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110605,
					"content": "Tam da Yedilerin Heykelinde ibadet etmeye çekindiğim bir anda böyle bir şeyin olması... Kader beni çağırıyor sanki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110606
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110606,
					"content": "O şeyin önünde eğildiğimi söyledin, belki... Belki etkili olmuştur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110607,
						80110608
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110607,
					"content": "Kulağa çok saçma geliyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110609
					]
				},
				{
					"id": 80110609,
					"content": "Ne olursa olsun elimden geleni yapacağım... Tıpkı senin dediğin gibi, tüm seçenekleri denemek zorundayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110610
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110610,
					"content": "Dağ yabanisine bir doz ilaç daha verilir...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80110611
					]
				},
				{
					"id": 80110611,
					"content": "Caribert?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110612
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110612,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110613
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110613,
					"content": "... B-Baba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110614
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110614,
					"content": "*nefesi kesilir* Caribert! Ah, aman tanrım, işe yaradı! Bu bir mucize! Ah, Caribert. Benim canım oğlum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110615,
						80110616
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110615,
					"content": "İnanamıyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110617
					]
				},
				{
					"id": 80110617,
					"content": "Gördün mü? İşe yaradı! Caribert yeniden konuşabiliyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110618
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110618,
					"content": "Annem... Annem nerede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110619
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110619,
					"content": "Annen... Caribert, bana bak. Benim kim olduğumu biliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110620
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110620,
					"content": "Tabii ki... Sen babamsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110621
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110621,
					"content": "Hahahaha... Evet! Haha... Ferahladım, feraha erdim... Evet, hissettiğim tam olarak bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110622
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110622,
					"content": "Kendini nasıl hissediyorsun Caribert? Tamamen kendine geldin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110623
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110623,
					"content": "Evet... Çok derin bir uykudan yeni uyanmış gibiyim. Rüyamda küçük bir odada saklanıyordum. Tüm bu süre boyunca dışarı çıkmaya cesaret edemedim ve çıkmak da istemiyordum zaten...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110624
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110624,
					"content": "Bir dakika...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110625
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110625,
					"content": "Vücudum! Bana ne oldu böyle? Bu... Bu ben miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110626
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110626,
					"content": "Baba... Bana ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110627
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110627,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110628
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110628,
					"content": "... Panik yapma oğlum. Bu sadece şey... Sen uyurken biz bir peri masalı dünyasına daldık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110629
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110629,
					"content": "Burada Khaenri'ah yok, evimiz yok. Bunun ne anlama geldiğini biliyor musun? Kırmızı gökyüzü yok... Dünyanın sonu diye bir şey yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110630
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110630,
					"content": "Bu dünyada sen küçük bir canavar olacaksın... Ama sonsuza kadar babanla kalacaksın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110631
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110631,
					"content": "Peki ben... Öldüm mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110632
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110632,
					"content": "Hayır, hayır, tabii ki hayır! Bak, Caribert... Kolunda hâlâ annenin atkısı var. Bu, onun seni izlediği ve koruduğu anlamına geliyor. Bu durumda nasıl ölmüş olabilirsin ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110633
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110633,
					"content": "Sahiden mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110634
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110634,
					"content": "Evet, gerçekten öyle! Daha yeni kendine geldin ve tüm bunlar sana çok kafa karıştırıcı geliyor olmalı. Şimdilik burada dinlen... Her şey çok daha iyi olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110635
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110635,
					"content": "Ha, bir de... Bir konuda bana söz vermen gerekiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110636
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110636,
					"content": "Maskeni asla çıkarma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110637
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110637,
					"content": "Anladın mı? Ne olursa olsun maskeni asla çıkarmamalısın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110638
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110638,
					"content": "Tamam baba... Çıkarmayacağım, söz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110639
					],
					"speakerTitle": "Caribert"
				},
				{
					"id": 80110639,
					"content": "Baba ve oğul uzun süre konuşurlar. Eide, tanrılarla olan deneyiminden sonra değişmiş biri gibi görünür...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80110640
					]
				},
				{
					"id": 80110640,
					"content": "O günden beridir hiç bu kadar mutlu olmamıştım... Böyle bir şeyin olduğuna gerçekten inanamıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110641,
						80110642
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110641,
					"content": "Evet...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110643
					]
				},
				{
					"id": 80110643,
					"content": "Hıh, Yedilere umut bağlamanın zaman kaybı olduğunu biliyordum... Hatta bir aptal gibi onların heykellerinden birine tapındım bile. Daha önce kendimi hiç bu kadar küçük düşürmemiştim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110644
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110644,
					"content": "Huylu huyundan vazgeçmezmiş işte... Bize karşı komplolar kuran tanrıların gün gelip bize yardımda bulunacaklarını düşünecek kadar saftım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110645
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110645,
					"content": "Ama o mağarada gördüğümüz tanrı... Gerçekten çok kudretliydi! Yedilere hiç benzemiyordu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110646
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110646,
					"content": "O harikulade güç... Gerçekten büyüleyiciydi... Onun önünde eğilmemin sebebi de mutlaka bu olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110647
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110647,
					"content": "Hımm, o halde... Kişi bir tanrıya yalvardıysa, tanrı da kişinin dualarına cevap verdiyse, sonrasında... Şey, kişinin tanrıya bağlılığını göstermek için bir şey yapması gerekiyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110648
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110648,
					"content": "İnanç pek uzmanlık alanım değildir... Ama yine de dileklerimi yerine getiren bir tanrıyı onurlandırmalıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110649,
						80110650
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110649,
					"content": "Ama Eide... O bir tanrı değildi ki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110651
					]
				},
				{
					"id": 80110651,
					"content": "\"Günahkar\" mı? Saçmalama. Onun hakkında tek bir şey bile bilmiyorsun... Böyle kötü konuşmaya nasıl cüret edersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110652
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110652,
					"content": "İkimiz de onun ilahi gücüne tanık olduk. Yediler daha önce ne zaman böyle bir mucize yarattı? Hiçbir zaman... O, onlardan çok daha kudretli bir tanrı! Ve sen hâlâ kalkmış ona \"Günahkar\" mı diyorsun? Çok saçma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110653
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110653,
					"content": "Neyse ne... Neye istersen ona inan ama benim inancımı sarsamazsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110654
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110654,
					"content": "Sen olsan da olmasan da ben gidip ona saygılarımı ileteceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
