			"dialogs": [
				{
					"id": 80110101,
					"content": "O... O Caribert değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110102,
						80110103
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110102,
					"content": "Evet, o değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110104
					]
				},
				{
					"id": 80110104,
					"content": "Doğru. Caribert'in kullandığı atkı, benim bir zamanlar annesine verdiğim bir hediyeydi. Şimdi ise onu bir nevi işaret olarak kullanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110105
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110105,
					"content": "Gö-Gözlerim bozulmuş herhalde... Kendi oğlumu nasıl tanıyamadım? Ah, bedenim iyice yıprandı... *iç çeker*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110106,
						80110107
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110106,
					"content": "Yine de bu dağ yabanisi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110108
					]
				},
				{
					"id": 80110108,
					"content": "Evet... Bizimle hiç ilgilenmiyor gibi. O yöne doğru yürümeye kararlı görünüyor... Nereye gidiyor olabilir acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80110109,
						80110110
					],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110109,
					"content": "Hiçbir fikrim yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110111
					]
				},
				{
					"id": 80110111,
					"content": "Evet... Dağ yabanileri hakkında ne kadar çok şey bilirsek o kadar iyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eide"
				},
				{
					"id": 80110110,
					"content": "Gidip bir bakalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110111
					]
				},
				{
					"id": 80110107,
					"content": "Bunda tuhaf bir şeyler var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110108
					]
				},
				{
					"id": 80110103,
					"content": "Kolunda sarılı ipek atkı yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80110104
					]
				}
			]
		},
		{
			"id": 801102,
