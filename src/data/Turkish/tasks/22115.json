			"dialogs": [
				{
					"id": 221150601,
					"content": "*iç çeker* Ah Küçük Chang...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150602
					],
					"speakerTitle": "Ruoxin Nine"
				},
				{
					"id": 221150602,
					"content": "Dokuzuncu Chang sağ salim geri döndü.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150603
					]
				},
				{
					"id": 221150603,
					"content": "Evet, gördüm! Teşekkür ederim canlarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150604
					],
					"speakerTitle": "Ruoxin Nine"
				},
				{
					"id": 221150604,
					"content": "Çocukluğundan beri böyleydi... Evden kaçıp başını belaya sokardı ve artık büyüdüğünü söyleyerek itiraz ederdi. Asla büyümeyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150605
					],
					"speakerTitle": "Ruoxin Nine"
				},
				{
					"id": 221150605,
					"content": "Her neyse, endişelenmeni gerektirecek bir şey yok. Küçük Chang hep kendi istediğini yapar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150606
					],
					"speakerTitle": "Ruoxin Nine"
				},
				{
					"id": 221150606,
					"content": "Onu eve getirmek adına bunca yol kat ettiğin için teşekkür ederim. Lütfen karşılığında bunu al.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150607
					],
					"speakerTitle": "Ruoxin Nine"
				},
				{
					"id": 221150607,
					"content": "Artık seni tutmayayım, yapacak işlerin vardır. Ama... Lütfen Küçük Chang gibi olma. Başkalarının onu nasıl gördüğüne o kadar takmış durumda ki durup kendine bakmıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150608
					],
					"speakerTitle": "Ruoxin Nine"
				},
				{
					"id": 221150608,
					"content": "Ölümlüler Adeptuslar gibi değil... Ölümlü bir yaşam, ölümden önceki kısa bir azap değil de nedir? Çok yazık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruoxin Nine"
				}
			]
		},
		{
			"id": 2211507,
