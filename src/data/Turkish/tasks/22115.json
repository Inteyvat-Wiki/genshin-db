					"Dokuzuncu Chang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221150201,
					"content": "Sefil canavarlar... Korkunç şeyler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150202
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 221150202,
					"content": "İstediğim tek şey sadece romanım için biraz ilham bulmaktı... Ama yok, onun yerine bu korkunç canavar sürüsünün ortasında kaldım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150203
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 221150203,
					"content": "Yardımın için teşekkür ederim. Sen olmasan ne yapardım bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150204
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 221150204,
					"content": "Ruoxin Nine seni çok merak etmiş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150205
					]
				},
				{
					"id": 221150205,
					"content": "Öyle mi? Enerjisini boşa harcıyor. Ben kendi başımın çaresine bakabiliyorum. Gerekseydi onların da icabına kolaylıkla bakardım... Zor olmazdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150206
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 221150206,
					"content": "Yine de geldiğine sevindim. Aksi takdirde biraz daha burada kalmam gerekecekti. Böylece en azından geri döndüğümde, onun bitmek bilmeyen dırdırına katlanmam gerekmeyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dokuzuncu Chang"
				}
			]
		},
		{
			"id": 2211503,
			"completionStepIds": [
				2211505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
