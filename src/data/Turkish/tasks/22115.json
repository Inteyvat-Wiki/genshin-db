			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dokuzuncu Chang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221150501,
					"content": "*iç çeker* Bu romanın gerçekten iyi olması gerek... Ama nasıl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150502
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 221150502,
					"content": "Bunları sen mi düşürdün?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150503
					]
				},
				{
					"id": 221150503,
					"content": "Ah evet, bunlar benim. Yazdıklarımı beğenmediğim için nehre atmıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150504
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 221150504,
					"content": "Hepsini topladığına inanamıyorum... Üstelik yazılar da pek okunabilir halde değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150505
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 221150505,
					"content": "Ne yazıyordun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150506
					]
				},
				{
					"id": 221150506,
					"content": "Çocukken tanıdığım bir kızın hikayesi. Bunlar çöpe attığım ilk taslaklar. Ah o küçük kız... Küçükken nasıl biri olduğunu bir bilsen. Sürekli ona hikaye okuyayım diye beni sıkıştırıyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150507
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 221150507,
					"content": "Ne yazık ki o zamandan beri yazı yazmaya pek vaktim olmadı. Başlangıç olsun diye ona hikayenin ilk sayfalarını yazdım. Vaktim olduğunda devamını yazarım diye düşündüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150508
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 221150508,
					"content": "Sonra bir gün ortadan kayboldu ve onu bir daha bulamadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150509
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 221150509,
					"content": "Eminim nedeni ailesiydi. Beni hiç sevmezlerdi, kızlarının benimle hiçbir şey yapmasını da istemezlerdi. Bu nedenle Qingce Köyü'nden sessizce ve sonsuza dek taşınmak için fırsat kolluyorlardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150510
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 221150510,
					"content": "Ama yakında görecekler! Artık adımı duyurdum, bu yüzden bana bir daha asla aynı gözle bakamayacaklar! Ona yazdığım bu hikaye biter bitmez tüm dünyada satılacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150511
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 221150511,
					"content": "Böylece dünyanın neresinde olurlarsa olsunlar yine beni görecekler! Artık çocukken olduğum Dokuzuncu Chang olmadığımı görecekler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150512
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 221150512,
					"content": "Sonra da... Sonra da onu tekrar görebileceğim... Ama önce hikayeyi yazmam gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150513
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 221150513,
					"content": "... Pardon. Oturmuş sana hayat hikayemi anlatıyorum! Her neyse, kitabım üzerinde çalışmaya dönmem gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dokuzuncu Chang"
				}
			]
		},
