			},
			"dialogs": [
				{
					"id": 221150101,
					"content": "*iç çeker* Eve gel Küçük Chang... Beni endişelendirmeye başladın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150102
					],
					"speakerTitle": "Ruoxin Nine"
				},
				{
					"id": 221150102,
					"content": "Küçük Chang kim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150103
					]
				},
				{
					"id": 221150103,
					"content": "Ah, o benim Dokuzuncu Chang'a taktığım isim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150104
					],
					"speakerTitle": "Ruoxin Nine"
				},
				{
					"id": 221150104,
					"content": "Ona Küçük Chang demeye çok alıştığım için şimdi \"Dokuzuncu Chang\" demek tuhaf geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150105
					],
					"speakerTitle": "Ruoxin Nine"
				},
				{
					"id": 221150105,
					"content": "Geçen gece romanı için dışarı çıkıp araştırma yapacağını söylemişti. Ben de üzerine çok düşünmedim, sadece her zamanki gibi çok geçe kalmamasını söyledim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150106
					],
					"speakerTitle": "Ruoxin Nine"
				},
				{
					"id": 221150106,
					"content": "Ama hâlâ geri dönmedi. Ona bir şey oldu diye çok endişeleniyorum",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150107
					],
					"speakerTitle": "Ruoxin Nine"
				},
				{
					"id": 221150107,
					"content": "Dışarı çıkıp onu aramak için çok yaşlı ve çelimsizim. Siz ikiniz benim için onu bulabilir misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150108,
						221150110
					],
					"speakerTitle": "Ruoxin Nine"
				},
				{
					"id": 221150108,
					"content": "Bize bırak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150109
					]
				},
				{
					"id": 221150109,
					"content": "Harika. Teşekkür ederim canlarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruoxin Nine"
				},
				{
					"id": 221150110,
					"content": "Ne tarafa gittiğini biliyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150111
					]
				},
				{
					"id": 221150111,
					"content": "*iç çeker* Gidebileceği tek bir yer var. Buranın kuzeyindeki Wuwang Tepesi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150112
					],
					"speakerTitle": "Ruoxin Nine"
				},
				{
					"id": 221150112,
					"content": "Lütfen benim için gidip onu bulun. Çok uzun süredir dışarıda... Umarım başına bir şey gelmemiştir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ruoxin Nine"
				}
			]
		},
		{
			"id": 2211502,
			"completionStepIds": [
				2211504
