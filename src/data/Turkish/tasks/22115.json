				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221150301,
					"content": "... Dedi ve gitti. Biz de artık geri dönelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 221150302,
					"content": "Bekle, yerdeki o şey de ne? Dokuzuncu Chang bir şey mi düşürdü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 221150303,
					"content": "Ne olur ne olmaz bir bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 2211505,
			"completionStepIds": [
				2211507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
