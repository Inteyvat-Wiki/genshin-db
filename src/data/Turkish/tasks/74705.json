			"dialogs": [
				{
					"id": 747050101,
					"content": "Hımm, bence... Bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050102
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 747050102,
					"content": "Evet, ne demek istediğini anladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050103
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747050103,
					"content": "Neden o?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050104
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 747050104,
					"content": "Kuyruğunun rengine bak. Akvaryumdaki en şık balık o.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050105
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 747050105,
					"content": "Renkleri benim zevkime göre biraz fazla iddialı ama peki, bunu bir iltifat olarak kabul edeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050106
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 747050106,
					"content": "Aa! Ne kadar kalabalık burası! Herkes balıkları görmeye mi gelmiş?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747050107,
					"content": "Hı hı! Sahnemi daha yeni bitirdim, hazır vakit bulmuşken akvaryumunuzu doya doya seyredeyim dedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050108
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747050108,
					"content": "Ne konuşuyordunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747050109,
					"content": "Chiori'ye en çok benzeyen balığa karar vermeye çalışıyorduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050110
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 747050110,
					"content": "Bunu siz de mi yapıyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747050111,
					"content": "Aa... Haha, şey... Hehe... Aslında bundan ilk bahseden Columbina'ydı. Kulağa eğlenceli geldi ve sonra bir de baktık ki biz de yapıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050112
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747050112,
					"content": "Bulaşıcıymış yani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747050113,
					"content": "Aa, bak! Şu aynı sana benziyor Chevreuse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050114
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 747050114,
					"content": "Nasıl yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050115
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 747050115,
					"content": "Yerinde hiç durmuyor, akvaryumun içinde fır dönüyor. Aynı senin gibi, bir saniye bile boş durmadan antrenman yapıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747050116
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 747050116,
					"content": "... Beni böyle mi görüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chevreuse"
				}
			]
		}
	]
