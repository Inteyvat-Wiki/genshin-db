			"dialogs": [
				{
					"id": 740990101,
					"content": "Balık yerine canavar yakalama hakkında!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740990102
					]
				},
				{
					"id": 740990102,
					"content": "Ah! Şimdi bir düşündüm de... Kendi yemime balık yerine canavar gelmesi kadar eşsiz bir deneyim yoktu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740990103
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 740990103,
					"content": "Canavarlardan öyle pek korkmam. Fontaine Araştırma Enstitüsü ile Fontaine Şehri arasında tek başıma gidip gelirdim. Yol üzerinde çoğu kez haydutlarla karşılaşırdım ve çoğunlukla da onları yenerdim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740990104
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 740990104,
					"content": "Ancak şu anda ben bir Balıkçılık Derneği müdürüyüm ve ona göre davranmalıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740990105
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 740990105,
					"content": "Balıkları korkutursam veya yakınlarda balık tutanlara herhangi bir sorun çıkartırsam bunu, kendimi bir müdür olarak insanların beklentilerini karşılayamamış olarak görürüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740990106
					],
					"speakerTitle": "Delaroche"
				},
				{
					"id": 740990106,
					"content": "Bu yüzden sınırlı ve temkinli bir şekilde ilerlemeliyim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Delaroche"
				}
