			"dialogs": [
				{
					"id": 742500101,
					"content": "Aklıma geldi de, daha önce Snezhnaya'ya geldiğinizde pek iyi bir ev sahibi olduğum söylenemez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500102
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742500102,
					"content": "Lafı bile olmaz Leydi Sandrone. Hiç oturup sohbet etmemiş olsak bile bizi hep en güzel ikramlarla ağırladınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500103
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500103,
					"content": "*iç çeker* Özür dilerim. O zamanlar çok meşguldüm. Bir sonraki ziyaretinizde sizinle daha iyi ilgileneceğimden emin olabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500104
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742500104,
					"content": "Hıhı. Daha önce icatlarını denememe de hiç izin vermemiştin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500105
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 742500105,
					"content": "Onun sebepleri farklıydı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500106
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742500106,
					"content": "Hıh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500107
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 742500107,
					"content": "Aslında babam, mecbur kalmadıkça sizi rahatsız etmememizi tembihlemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500108
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 742500108,
					"content": "Bunu dert etme, ara sıra rahatsız edilmek benim için sorun değil. Canın ne zaman isterse çay içmeye gelebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500109
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742500109,
					"content": "Gerçekten mi? A-Aslında... Ne zamandır sizden Pers'e bir göz atmanızı rica etmek istiyordum... Size danışmak istediğim birkaç geliştirme fikri var aklımda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500110
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 742500110,
					"content": "Tabii, sonuçta bu benim uzmanlık alanım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500111
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742500111,
					"content": "... Teşekkürler Leydi Sandrone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500112
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 742500112,
					"content": "Hımm. Haberci olmak gerçekten o kadar zor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500113
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 742500113,
					"content": "Düşününce... Evet, biraz öyle sanırım. Hesaba katacak çok şey var. Hoş, benim asıl derdim meslektaşlarımla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500114
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742500114,
					"content": "Yani... Başkalarıyla iyi geçinmek olmazsa olmaz bir beceri mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500115
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 742500115,
					"content": "Sanırım öyle... Ama bu konuda pek endişelenmenize gerek yok gibi. En azından Lyney için kesinlikle söyleyebilirim bunu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500116
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742500116,
					"content": "Haha, beni utandırıyorsunuz Leydi Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500117
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500117,
					"content": "Haberci olmak ister miydin? Gerçi... Boş ver. Bunu sormak bana düşmez. Bir şey demediğimi farz et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500118
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742500118,
					"content": "Hımm... Bunları düşünmek için biraz erken. Şimdiden kafa yormama gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500119
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500119,
					"content": "Haberci olursan görevlerde bize eşlik etmeye vaktin olmaz, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500120
					],
					"speakerTitle": "Lynette"
				},
				{
					"id": 742500120,
					"content": "Yani bu durumda... Lynette ve benim de mi Haberci olmamız gerekecek?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500121
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 742500121,
					"content": "Dediğim gibi, böyle şeyleri düşünmek için daha çok erken!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500122
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500122,
					"content": "Ayrıca nereye gidersem gideyim, ikinizi de asla geride bırakmam. Söz veriyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742500123
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 742500123,
					"content": "Hah... Bazen bu küçük ailenize gerçekten imreniyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kukla"
				}
			]
		},
