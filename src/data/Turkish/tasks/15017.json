			"dialogs": [
				{
					"id": 150170101,
					"content": "Erken geldiniz! Hediye için sabırsızlanıyorsunuz, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170102,
						150170105
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170102,
					"content": "Tlazolli ile Nechca'yı ziyaret etmek istedik sadece.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170103
					]
				},
				{
					"id": 150170103,
					"content": "Aynen öyle! Nechca son zamanlarda çok hastaydı ve Tlazolli de çok sevdiği işini bırakmak zorunda kaldı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170104,
					"content": "Durum daha iyiye gidiyor ama yine de biraz morale ihtiyaçları olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170109,
					"content": "Haha, birini Tlazolli'nin yanına gönderdim ve ona geleceğimizi haber vermesini söyledim bile. Muhtemelen gerekli tüm hazırlıkları yapmıştır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170110
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170110,
					"content": "Hadi gidelim madem. Dükkana göz kulak olur musun Imix? Hemen dönerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170105,
					"content": "Merak ettim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170106
					]
				},
				{
					"id": 150170106,
					"content": "Paimon da merak etti... Ama aynı zamanda Nechca'nın ne durumda olduğunu görmek için de buradayız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170107,
					"content": "Bu kadar ciddi bir hastalık geçirdikten sonra iyileşmesi zor olmalı. Bir de Tlazolli var tabii...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170108,
					"content": "Sevdiği şeyi bırakmak zorunda kaldı... Onları neşelendirmek istiyoruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170109
					],
					"speakerTitle": "Paimon"
				}
			]
		},
