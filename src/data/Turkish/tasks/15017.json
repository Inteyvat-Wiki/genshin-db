			"dialogs": [
				{
					"id": 150170201,
					"content": "İşte geldik. Güzel ev değil mi? Bir saniye, kapıyı çalayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170202
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170202,
					"content": "Tlazolli, aç kapıyı! Geldiler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170203
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170203,
					"content": "... Tlazolli? Evde misin? Açsana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170204
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170204,
					"content": "Tuhaf... Kapı kilitli ama bu vakitte dışarıda olmaması gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170205
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170205,
					"content": "Hey, Nechca? Nechca? Benim, Cheven. Kapıyı aç lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170206,
						150170207
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170206,
					"content": "(Yanıt yok...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170210
					]
				},
				{
					"id": 150170210,
					"content": "Yine de Tlazolli'ye geleceğimizi söylemiştim... Belki Nechca ile ilaç almaya gitmişlerdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170211
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170211,
					"content": "Hey, oradaki ne öyle? Bir Tepetlizor yuvasına benziyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170212,
					"content": "Doğru, Tlazolli'nin bir Tepetlizor yoldaşı var. Adı da yanlış hatırlamıyorsam eğer... Iengu muydu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170213
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170213,
					"content": "Halen demircilik işiyle uğraşırken bazı kazı işlerinde sık sık Iengu'dan yardım alırdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170214
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170214,
					"content": "Ancak Nechca hastalandıktan sonra Tlazolli ona pek kazı yaptırmadı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170215
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170215,
					"content": "Bir saniye... Ne olmuş böyle? Ortalık karman çorman! Iengu'dan da hiçbir iz yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170216
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170216,
					"content": "Aa, şu kırık kutulara bakın! Burada kötü bir şeyler olmuş galiba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170217,
						150170218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170217,
					"content": "Daha yakından bakalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 150170218,
					"content": "Sen burada kal Cheven.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170219
					]
				},
				{
					"id": 150170219,
					"content": "Tamam! O zaman ben... Şimdilik saklanacak bir yer bulayım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170220
					],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170220,
					"content": "Nasıl oluyor da Imix bana ne zaman tehlikeli bir yere gitmememi söylese hep bir tehlikeyle karşılaşıyorum? Sanki sözlerinin üzerimde bir gücü var... Belki de Wayob'un işidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cheven"
				},
				{
					"id": 150170207,
					"content": "Kapıyı kırayım mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150170208
					]
				},
				{
					"id": 150170208,
					"content": "Ya başlarına bir şey geldiyse? Nechca yine kötüleşti mi acaba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150170209,
					"content": "Neyse kötüyü düşünmeyelim şimdi. En son buraya geldiğimde ikisi de gayet iyiydi. Nechca odasında mışıl mışıl uyuyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150170210
					],
					"speakerTitle": "Cheven"
				}
			]
		},
