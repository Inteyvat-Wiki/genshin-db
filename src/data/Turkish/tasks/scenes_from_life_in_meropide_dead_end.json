						],
						"pointId": 6254
					}
				]
			},
			"dialogs": [
				{
					"id": 740300201,
					"content": "Tam zamanında. Bana yardım edin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300202,
						740300206
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300202,
					"content": "Zihin okuyabiliyor musun? Çok korkunç!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300203
					]
				},
				{
					"id": 740300203,
					"content": "Galvaryet bizi yardıma gönderdi de... Nereden bildin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300204,
					"content": "... Çünkü burada sizden başka yardım edebilecek kimse yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300205
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300205,
					"content": "... Çok mantıklı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300210,
					"content": "Neyse, göreviniz hiç zor değil. Görmüş olduğunuz Araştırma Terminalini aynı anda iki kişinin çalıştırması gerekiyor. Ben çoktan komutları girdim, siz gidip kolu çekseniz yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300211
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300211,
					"content": "Neredeyse unutuyordum... Yükleme cihazı buralarda bir yerlerde olmalı. Lütfen başlamadan önce yükleme cihazını kurun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300212
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300212,
					"content": "Ve... Emin olmak için soruyorum, makina katili değilsiniz, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300213,
						740300214
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300213,
					"content": "Makina katili derken neyi kastettiğine göre değişir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300215
					]
				},
				{
					"id": 740300215,
					"content": "Neden sordun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300216,
					"content": "Geçen sefer Galvana'dan yardım istemiştim, başımı bir anlığına başka bir yöne çevirdiğimde terminal yok olmuştu. Ona ne olduğunu sorduğumda ise cevap verememişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300217
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300217,
					"content": "Sonra kardeşine sordum ve Galvana'nın eline aldığı makinaların yarım gün bile sağ kalamadığını öğrendim. Alain Guillotin bile ondan umudu kesmiş sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300218
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300218,
					"content": "Tamir ücretini de ödememden kesmişlerdi. Siz de onun gibiyseniz tüm çabalarım boşa gidecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300219
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300219,
					"content": "Olaya bak. Bizim onunla uzaktan yakından alakamız yok, sakın endişelenme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300220,
					"content": "Size güveniyorum o zaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300214,
					"content": "Araştırma terminalinin saldırısına uğrarsam olabilirim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300215
					]
				},
				{
					"id": 740300206,
					"content": "Ücretsiz bir şey yapmayız ama.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300207
					]
				},
				{
					"id": 740300207,
					"content": "Daha sonra Galvaryet'den ödemenizi yapmasını isterim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300208
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300208,
					"content": "Ne? Ödemeyi direkt senden alacağımızı söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300209,
					"content": "Öyle mi dedi? Tamam o zaman. Burada bütçe başvurusu yapmak Fontaine Araştırma Enstitüsünden de zor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300210
					],
					"speakerTitle": "Clynes"
				}
			]
		},
		{
