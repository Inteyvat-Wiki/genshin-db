					}
				]
			},
			"dialogs": [
				{
					"id": 740300401,
					"content": "Güzel. Böyle bir yerde olmasaydık sizi asistan olarak tutardım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300402
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300402,
					"content": "Çok kolay oldu. Bu arada bu cihaz ne işe yarıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300403,
					"content": "Burada dış dünyaya bağlanan ve gözetim altında tutulması gereken bir uçurum vardı. Geçidi artık bu cihazla mühürleyip iş gücünden tasarruf edebileceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300404
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300404,
					"content": "Zaten Fontaine Araştırma Enstitüsünde var olan bir makinaydı ama zamanım bol olduğu için birkaç ufak eklenti yaptım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300405
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300405,
					"content": "Görmüş olduğunuz, makinanın son hali bile değil. Onu Jeod Maden Kuyusunda kullanıyoruz... Öhöm, çok konuştum sanırım. Duymamış gibi davranabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300406,
						740300408
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300406,
					"content": "Yani Jeod Maden Kuyusunda çıkışlar var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300407
					]
				},
				{
					"id": 740300407,
					"content": "Evet, epey zekisiniz bakıyorum. Ancak daha zeki olsaydınız bu bilgiyi apaçık söylemez, kendinize saklardınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300411
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300411,
					"content": "Neyse, sorunumuz çözüldü. Galvana'nın artık sık sık buraya gelmesine gerek kalmadı. Ben de artık mola verebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300412
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300412,
					"content": "... Ah, evet. Az kalsın ödemenizi unutuyordum. Yardımınız için teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300408,
					"content": "Son hali daha mı güçlü?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300409
					]
				},
				{
					"id": 740300409,
					"content": "Tabii ki! Farklı parçaları var... Bir dakika, neden soruyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300410
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740300410,
					"content": "Her şeyiyle öğrenmek istiyorsanız kendiniz deneyebilirsiniz tabii. Yakalanırsanız ben sorumlu değilim ama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300411
					],
					"speakerTitle": "Clynes"
				}
			]
		}
	]
}