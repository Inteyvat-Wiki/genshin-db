			},
			"dialogs": [
				{
					"id": 740300101,
					"content": "Merhaba, buyurun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300102,
						740300105
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740300102,
					"content": "Lütfen bize yardım et, nazik büyücü.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300103
					]
				},
				{
					"id": 740300103,
					"content": "Neden Lanoire gibi konuşuyorsun? Sadede gel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300104
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740300104,
					"content": "Bize bir sürü Kupon lazım. Yapabileceğimiz iş var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300107,
					"content": "Estienne'in oyununa katılmadınız değil mi? Nerede durmanız gerektiğini bilmeniz lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300108
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740300108,
					"content": "... Yine de bir konuda yardımınız gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300109
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740300109,
					"content": "Clynes şu anda Erozyon Uçurumu'nda cihaz benzeri bir şey tamir ediyor olmalı. Ona yardım eder misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300110
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740300110,
					"content": "Ödemeyi ondan isteyin. İtiraz etmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300111
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740300111,
					"content": "Oldu bil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740300105,
					"content": "Yardımcı olabileceğimiz bir şey var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300106
					]
				},
				{
					"id": 740300106,
					"content": "Ödeme de alacaksak daha iyi olur tabii!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300107
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7403002,
			"completionStepIds": [
				7403002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
