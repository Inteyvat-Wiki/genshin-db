					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20110101,
					"content": "Yıldızlar ve hiçlik yoldaşınız olsun! Senin için ne yapabilirim gezgin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110102,
						20110103
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110102,
					"content": "Inazuma'ya yolculuk hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110104
					]
				},
				{
					"id": 20110104,
					"content": "Ah evet, Inazuma'ya geçişinle ilgili hazırlıkları Güneyhaçı Filosunun kaptanıyla birlikte çoktan ayarladığını duydum. Öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110105
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110105,
					"content": "Düşündüm de, o toprakları son ziyaret edişimden beri uzunca bir süre geçti. Maalesef seninle paylaşmaya değer güncel bir istihbaratım yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110106,
					"content": "İşte buradasın! Sen Beidou'nun Inazuma'ya götüreceği gezginsin, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110107,
						20110109
					],
					"speakerTitle": "Deniz Ejderi"
				},
				{
					"id": 20110107,
					"content": "Bütün gün seni bekliyordum!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110108
					]
				},
				{
					"id": 20110108,
					"content": "Ha, öyle mi? Haha... Yani, seninle tanışmak büyük bir şeref.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110110
					],
					"speakerTitle": "Deniz Ejderi"
				},
				{
					"id": 20110110,
					"content": "Filo neredeyse taze yiyecek ve içecek tedarikini tamamladı. Tayfa yoklama yaptıktan sonra yola çıkabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110111
					],
					"speakerTitle": "Deniz Ejderi"
				},
				{
					"id": 20110111,
					"content": "Kaptan Beidou, seni almam için beni gönderdi. Gemiye çıktığın an demir alırız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110112
					],
					"speakerTitle": "Deniz Ejderi"
				},
				{
					"id": 20110112,
					"content": "Beidou, sözünde duran bir kaptanmış gibi görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110113,
					"content": "Tabii ki! Kaptanın ayak dirediği şeyler de çoktur. Gemiye çıktığında kendi gözlerinle göreceğinden eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110114
					],
					"speakerTitle": "Deniz Ejderi"
				},
				{
					"id": 20110114,
					"content": "Sizler de yola çıkacaksınız demek, öyle mi? Sizleri tebrik etmek gerek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110115
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110115,
					"content": "Önündeki yolculuk ister göğün zirvelerine çıksın, ister hiçliğin en dibine insin, atacağın her adım ayrı bir başarıdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110116
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110116,
					"content": "Yeniden buluşuncaya dek, yıldızlar ve hiçlik yoldaşınız olsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110117,
						20110118
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110117,
					"content": "Yıldızlar ve hiçlik yoldaşın olsun Katheryne...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110119
					]
				},
				{
					"id": 20110119,
					"content": "Ah... Veda etmek çok zor... Birbirimizi neredeyse her gün görüyorduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110120,
					"content": "Haha, madem böyle hissediyorsun, vardığında neden gelip beni bulmuyorsun? Seni Narukami Adası'nda bekliyor olacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110121,
						20110122
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 20110121,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110123
					]
				},
				{
					"id": 20110123,
					"content": "Yani Inazuma'da başka bir Katheryne daha mı var? Gördün mü, aşırı duygusal davranmanın gereği yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110124,
					"content": "Haha, sanırım senin için Liyue Limanı'na veda etme vakti. Artık mesajımı ilettiğime göre, geri dönebilirim. Gemi şu anda Guyun Taş Ormanı açıklarında demirli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110125
					],
					"speakerTitle": "Deniz Ejderi"
				},
				{
					"id": 20110125,
					"content": "Tamam, bize haber vermek adına bunca yolu geldiğin için teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110126,
					"content": "Sadece emirleri takip ediyorum. Alcor'da görüşmek üzere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Deniz Ejderi"
				},
				{
					"id": 20110122,
					"content": "... Biliyordum!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110123
					]
				},
				{
					"id": 20110118,
					"content": "Seni özleyeceğiz...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110119
					]
				},
				{
					"id": 20110109,
					"content": "Sanırım istihbaratımız geldi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110110
					]
				},
				{
					"id": 20110103,
					"content": "Güneyhaçı Filosu hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110104
					]
				}
			]
		},
		{
			"id": 201103,
