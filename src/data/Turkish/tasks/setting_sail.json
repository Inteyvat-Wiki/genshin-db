			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Beidou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20110301,
					"content": "Hah, sonunda geldiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110302
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110302,
					"content": "Bunca yıldır, yağmur veya fırtına olsun, Güneyhaçı Filosunda asla bir gecikme yaşanmadı. Başka herhangi biri olsaydı, çoktan yelken açıp gitmiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110303,
						20110304
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110303,
					"content": "Kusuruma bakmayın Kaptan!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110305
					]
				},
				{
					"id": 20110305,
					"content": "Hahaha, bu kadar ciddiye almayın, sadece şaka yapıyorum. Tam zamanında geldiniz. Tayfa, son hazırlıkları daha demin bitirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110306
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110306,
					"content": "*iç çeker* Pekala, artık herkes burada olduğuna göre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110307
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110307,
					"content": "Gök gürültülü fırtınalarla çevrili \"sonsuzluk\" ülkesine doğru yelken açtık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110308
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110308,
					"content": "Demir alın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110304,
					"content": "Bu gemide bulunmak büyük bir şeref!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110305
					]
				}
			]
		},
		{
			"id": 201107,
			"completionStepIds": [
				201107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201107",
							"2"
						],
						"stepId": 201107,
						"stateName": "QUEST_STATE_UNFINISHED"
