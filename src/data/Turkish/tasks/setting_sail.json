				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Thoma"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20110701,
					"content": "Sonunda geldiniz. Beni gerçekten çok beklettin Kaptan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110702
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20110702,
					"content": "Ve görünüşe göre bir çift kaçak yolcumuz var... Ya da onur konuğu mu demeliyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110703
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20110703,
					"content": "Hey! Şşş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110704,
					"content": "Yüce Şogun'unu suçlayabilirsin. Inazuma çevresindeki çalkantılar son zamanlarda daha da şiddetlendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110705
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110705,
					"content": "Her ne kadar filo tüm zorluklara hazır olsa da, sert hava koşulları yine de biraz gecikmeye neden oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110706
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110706,
					"content": "Peki o zaman, herkesi birbiriyle tanıştırayım. Bu Thoma, son zamanlarda tanıştığım bir ticaret ortağı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110707
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110707,
					"content": "Hah, seni görmek için kaç zamandır beklediğimi bilmiyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110708
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20110708,
					"content": "Thoma, bu ikisi de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110709
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110709,
					"content": "Tanıtmana gerek yok, onların namını duymayan kalmadı. Görünüşe göre bu yabancıların yaptığı önemli işlere dair söylentiler, fırtınalı denizlere bile ulaşmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110710,
						20110711
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20110710,
					"content": "Tanıştığımıza memnun oldum Thoma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110712
					]
				},
				{
					"id": 20110712,
					"content": "Haha, bunu söylediğini duymak gerçekten güzel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110713,
					"content": "Şansın yaver giderse sana burada bir avantaj sağlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110714
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110714,
					"content": "#{NICKNAME}, Thoma uzun bir süredir Ritou'da yaşıyor ve onun artık buraların kurdu olduğunu söylemek yanlış olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110715
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110715,
					"content": "Buralarda herhangi bir problemle karşılaşırsan Thoma'yla konuş. Ama sana bir numara yapmaya kalkışırsa, sonraki gelişimde onunla bizzat kendim ilgilenirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110716
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110716,
					"content": "Hahaha, endişelenmene gerek yok. Oldukça iyi anlaşacağımıza eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110717
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20110717,
					"content": "Güzel. O zaman her şey tamamsa ben gidiyorum. Buralarda yelkenlerim inik yakalanmak istemem, sonuçta gemide aranan bir kaçak var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110718
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110718,
					"content": "Ah, doğru! Kazuha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110719,
					"content": "Şimdilik hoşça kal Gezgin. Ne kadar riskli \"fırtınalar\" ile karşılaşırsan karşılaş, elinden geleni yapmayı unutma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110720,
						20110721
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 20110720,
					"content": "Bunu başarabiliriz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110722
					]
				},
				{
					"id": 20110722,
					"content": "Yolun açık olsun Kaptan Beidou! Hoşça kal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20110723,
					"content": "O zaman, önce senin sınır noktasında kaydını yapmamız gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110724
					],
					"speakerTitle": "Thoma"
				},
				{
