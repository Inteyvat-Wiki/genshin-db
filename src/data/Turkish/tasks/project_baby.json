			"dialogs": [
				{
					"id": 230042201,
					"content": "Bu şapkalar... Hahaha, yılanlarım için yapmıştım bunları. Nasıl unutmuşum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042202
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042202,
					"content": "Gösteri için çocukların ilgisini çekebilsinler diye hepsine birer gece başlığı yapmıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042203
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042203,
					"content": "Jori için kırmızı, Amum için yeşil, Gana için sarı, Drak için de mavi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042204
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042204,
					"content": "Ne tatlı! Gösteri çok başarılı geçmiş olmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230042205,
					"content": "İlk başta iyi gitmişti ama yılanlar ne zaman ağızlarını açsa çocuklar ağlamaya başlardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042206
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042206,
					"content": "Neyse, unut gitsin. Bunu emeklerinin karşılığı olarak al lütfen. Çok bir şey değil ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
			]
		},
