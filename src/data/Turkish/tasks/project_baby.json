					"nextDialogs": [
						230040908
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040908,
					"content": "Eskiden kurduğum kampların çoğu terk edildi.",
					"roleType": "TALK_ROLE_NPC",
