			"dialogs": [
				{
					"id": 230041101,
					"content": "Evcil yılanlar için özel yiyecekler mi var? Fare falan yemiyor mu bunlar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230041102,
					"content": "Evet, eskiden kendileri avlanırlardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041103
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041103,
					"content": "Ama yemek yerken birkaç çocuğu korkuttuklarından beri bensiz dışarı çıkmalarını yasakladım. Onlara yiyecek hazırlamaya başladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041104
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041104,
					"content": "*iç çeker* Ama ondan sonra pek bir yere gitmediler ve başka bir şey yemeyi inatla reddettiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041105
					],
					"speakerTitle": "Gulabgir"
				},
				{
