						230040803
					]
				},
				{
					"id": 230040803,
					"content": "Anlıyorum... Vahşi hayvanlar mı yapmış?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040804
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040804,
					"content": "Şimdi sen söyleyince aklıma geldi, hazırladığım yiyecekler Mantarları ve kuşları cezbederdi... Vahşi hayvanları cezbetmesine şaşırmadım yani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040805
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040805,
					"content": "Belki de gerçekten bu yiyeceklerle ticarete atılmalıyım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230040806
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040806,
					"content": "İyi giderse şu an performans sergileyerek kazandığım paradan çok daha fazla para kazanabilirim...",
