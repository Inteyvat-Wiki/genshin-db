			"dialogs": [
				{
					"id": 230042401,
					"content": "Ah! Bu benim yılanlar için yaptığım tırmanma kulesi değil mi? Bana birçok şey hatırlattı! Hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042402
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042402,
					"content": "Yılanlar için tırmanma kulesi mi dedin? Ne ki o?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230042403,
					"content": "Yılanların tırmanması için bir oyuncak işte. Sürekli benim üstümde olamazlardı ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042404
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042404,
					"content": "Geri getirdiğin için teşekkür ederim. Lütfen bunu ödemen olarak kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042405
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042405,
					"content": "Böyle mi tasarlamışım? Ah, gerçekten de birçok hatıra anımsadım şimdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
