			"dialogs": [
				{
					"id": 230042001,
					"content": "Bu boncuk... Nasıl? Nereden buldun bunu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042002
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042002,
					"content": "Kampta bir kabın içinde buldum. Sen mi bıraktın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230042003,
					"content": "Eski gösterilerimde kullanırdım bunu. Ben flüt çalarken minik dostlarım o boncuğu kafalarında taşıyıp gövdeleri havada dans ederlerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042004
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042004,
					"content": "Ama bu tür numaraların zamanı çoktan geçti, ben de uzun zamandır gösteri yapmadım zaten. Bunu kaybettiğimi bile fark etmemişim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230042005
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230042005,
					"content": "Neyse, geri getirdiğin için teşekkür ederim. İşte ödemen, al lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				}
			]
