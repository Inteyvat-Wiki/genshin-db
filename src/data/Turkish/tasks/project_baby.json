						230040909
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230040909,
					"content": "Yağmur ormanında kalsaydım nasıl bir hayatım olurdu acaba?",
					"roleType": "TALK_ROLE_NPC",
