					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230041205,
					"content": "Evet, eskiden kendileri avlanırlardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041206
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041206,
					"content": "Ama yemek yerken birkaç çocuğu korkuttuklarından beri bensiz dışarı çıkmalarını yasakladım. Onlara yiyecek hazırlamaya başladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041207
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041207,
					"content": "*iç çeker* Ama ondan sonra pek bir yere gitmediler ve başka bir şey yemeyi inatla reddettiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041208
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041208,
					"content": "*iç çeker* Paimon \"bedava yemek yok\" sanmıştı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041209,
						230041210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230041209,
					"content": "Lezzetli!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041211
					]
				},
				{
					"id": 230041211,
					"content": "Paimon daha tadını bile sormadı, hayal kurmaya devam edebilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230041212,
					"content": "Yemeğin tadını çıkarmak Paimon'un işi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230041213,
					"content": "Tabii tabii. Gerçekten çok mantıklısın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041214
					]
				},
				{
					"id": 230041214,
					"content": "Bitki toplamaya çıktığımda yiyecekleri kamplarımdan birinde bırakmış olmalıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041215
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041215,
					"content": "Ama minik dostlarıma bakmam lazım, o yüzden gidemem. Yine yemek ararken birilerini korkutmalarını istemem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041216
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041216,
					"content": "Gezgin, o kampa gidip yiyecekleri alabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041217,
						230041220,
						230041222
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041217,
					"content": "Tabii ki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041218
					]
				},
				{
					"id": 230041218,
					"content": "Çok teşekkür ederim. Oraya bu minik dostlarımla gitmeye kalksak kim bilir ne tür kazalar gelirdi başımıza?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041219
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041219,
					"content": "Birkaç gün ormanda eğlenmeye kalksalar mahvolurdum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041225
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041225,
					"content": "Neyse, sana güveniyorum Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041226
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041226,
					"content": "Kaldığım tüm kampları senin için haritada işaretledim, lütfen oraları kontrol et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041220,
					"content": "Kamplarda başka yılan yok değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041221
					]
				},
				{
					"id": 230041221,
					"content": "Hayır, yok. Kamplarımı kurarken yılan yuvalarından uzak olmalarına özellikle dikkat ederim ki başımız belaya girmesin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041225
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041222,
					"content": "Kaç kamp var demiştin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041223
					]
				},
				{
					"id": 230041223,
					"content": "Yağmur ormanında yaşarken birkaç tane kurmuştum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041224
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041224,
					"content": "Artık yağmur ormanında yaşamıyorum ama bitki toplamaya çıktığımda kamplarımda dinleniyorum hâlâ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230041225
					],
					"speakerTitle": "Gulabgir"
				},
				{
					"id": 230041210,
					"content": "Çok lezzetli!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041211
					]
				},
				{
					"id": 230041203,
					"content": "Changsheng bunu duysa kızardı sana.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230041204
					]
				}
			]
		},
