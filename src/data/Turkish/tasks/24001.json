			"dialogs": [
				{
					"id": 240010301,
					"content": "İşte burada! Ayrıca gayet iyi görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010302
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010302,
					"content": "Acaba Bayan Staelle köpeklerin operaya ya da kendisinin kitaplarına ilgi duymadığını ne zaman fark eder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010303
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010303,
					"content": "Hadi dönelim, muhtemelen çok endişelenmiştir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Blathine"
