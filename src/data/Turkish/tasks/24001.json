			"dialogs": [
				{
					"id": 240010401,
					"content": "Barea! Ah, bebeğim! Nerelerdeydin sen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010402
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010402,
					"content": "Biraz dinlenmek için sessiz sakin bir yer bulmuş. Ufak bir kaçamak yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010403
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010403,
					"content": "Ah, nasıl telaşlandım! Teşekkür ederim Memur Blathine! Sıradaki romanımda size de yer vereceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010404
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010404,
					"content": "Düşünceniz için teşekkürler ancak mürekkebiniz boşa gitmesin. Yani, insanlar bir polis memurunun günlük hayatına ilgi duyar mı, bilemedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010405
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010405,
					"content": "O zaman hikayeni biraz dramatize ederim... İlginç olacak, gerçekten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010406
					],
					"speakerTitle": "Staelle"
				},
				{
					"id": 240010406,
					"content": "Verdiğiniz sözler de benim için fazlasıyla drama içeriyor aslında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010407
					],
					"speakerTitle": "Blathine"
				},
				{
					"id": 240010407,
					"content": "Ah, sonuç ilham verici olmalı! Düşüneyim bakalım, senin arkadaşın olarak kimi yazsam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Staelle"
				}
			]
		},
