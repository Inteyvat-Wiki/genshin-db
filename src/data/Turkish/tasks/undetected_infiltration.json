			},
			"dialogs": [
				{
					"id": 710540501,
					"content": "Önce <color=#00E1FFFF>silah zulası</color> ile ilgilenmemiz hayatımızı kolaylaştırır diye düşünüyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540502
					]
				},
				{
					"id": 710540502,
					"content": "Aynen. Göz açıp kapayıncaya kadar silahsız kalacaklar! Göreceksiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanbo"
				}
			]
		},
		{
			"id": 7105406,
			"completionStepIds": [
				7105403
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
