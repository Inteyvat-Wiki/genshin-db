			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yanbo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710540201,
					"content": "Geldiniz mi? Harika. Yardım etmek isteyeceğinizi biliyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540202
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540202,
					"content": "Hazine Avcısı kaçakçılar ile Fatui arasındaki alışveriş, doğudaki büyük kampta gerçekleşecek. Yol üzerinde de üç tane küçük kamp kurmuşlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540203
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540203,
					"content": "Muhbirin verdiği bilgilere göre, güneydoğuda <color=#00E1FFFF>yemek kampı</color>, doğuda <color=#00E1FFFF>silah zulası</color> ve kuzeydoğuda <color=#00E1FFFF>simya kampı</color> yer alıyor. Bunların üçünü de gafil avlayabilirsek, tedarik hatlarını da kesebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540204
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540204,
					"content": "Daha önce Yeşim Konak'ta yaşanan olay yüzünden, bu bölgede az sayıda devriyemiz vardı. Bunu fırsat bilip buralarda cirit attılar ve buraya o kadar alıştılar ki savunmalarını önemli ölçüde azalttılar. Bu, bizim saldırmamız için iyi bir fırsat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540205
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540205,
					"content": "Sorun şu ki... Az önce yaşanan yanlış anlaşılma, sadece tek bir kampı ele geçirmemize yetecek kadar adamımızın kalmasına sebep oldu. Yine de yardım gerekirse, elimizden geleni yapacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanbo"
				}
			]
		},
		{
			"id": 7105403,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
