			"dialogs": [
				{
					"id": 710540301,
					"content": "İlk hedefinizin <color=#00E1FFFF>yemek kampı</color> olmasını öneririm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540302
					]
				},
				{
					"id": 710540302,
					"content": "Tamamdır. Onların yiyeceklerini hızla ele geçireceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanbo"
				}
			]
		},
		{
