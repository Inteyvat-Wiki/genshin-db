				}
			]
		},
		{
			"id": 7105407,
			"completionStepIds": [
				7105413
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105413",
							"2"
						],
						"stepId": 7105413,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yanbo",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710540701,
					"content": "Bu harikaydı. Yardım için teşekkür ederim. Ödül işte burada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540702
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540702,
					"content": "Yaşasın, Mora! Ne? Ne ara üstünüzü değiştirdiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540723,
					"content": "Savaşmaya başladığınızda... Şey, bu pek önemli değil ama savaşın ortasında bizi yine pataklamamanız için üniformalarımızı değiştirmek zorunda kaldık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540703
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540703,
					"content": "Taşordu, her zamanki gibi yardımlarınız için teşekkür ediyor. Anlaşmamıza istinaden, ihtiyaç duyduğunuz bir şey var mı diye etrafa göz atabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540704
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540704,
					"content": "Şey, tabii el koyduklarımızı alamazsınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540705,
						710540707
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540705,
					"content": "Çok iyi bir iş çıkardınız, tebrikler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540706
					]
				},
				{
					"id": 710540706,
					"content": "Her şey sizin sayenizde yolunda gitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540709
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540709,
					"content": "Yani demek istediğim... Bu haydutlar gibi yasa dışı yollarla köşeyi dönmeye çalışmadığınız sürece kapınızı çalmayız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540710
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540710,
					"content": "Peh. Biz zaten öyle kişiler değiliz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540711,
					"content": "Evet, doğru. Haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540712
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540712,
					"content": "*iç çeker* Konuya dönecek olursak... İyi veya kötü olduğu fark etmeksizin, sizin gibi element güçlerini kullanabilen kişileri hafife almamak gerekiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540713
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540713,
					"content": "Bizim için haftalar hatta aylar sürecek bir görev, sizin için bir çocuk oyuncağından ibaretti... Kötü amaçla kullanılırsa, bu tarz beceriler çok büyük zararlar verebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540714
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540714,
					"content": "İşte tam da bu yüzden, ben bir Önsezim yok diye üzülmüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540715
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540715,
					"content": "Hayatlarını insanüstü güçler elde etmeye adayan, sonunda ise başkalarının kontrolündeki piyonlara ve kuklalara dönüşen insanlar gördüm. Böyle bir şey yapmaya değer mi gerçekten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540716
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540716,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540717
					]
				},
				{
					"id": 710540717,
					"content": "Halkın çoğunluğu, Önsezilerden gelen güçleri olmayan kişilerden oluşuyor. Onları tam olarak anlayabilen ve koruyabilen kişiler de benzer şekilde sıradan insanlardan çıkıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540718
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540718,
					"content": "Sıradan biri olarak, çoğunluğu koruyanların arasında olmaktan gurur duyuyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540719
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540719,
					"content": "Bir gün Önseziler sona erse ve Liyue Limanı'nı koruyan Adeptuslar ortadan kaybolsa bile, ben görev yerimi terk etmeyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540720
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540720,
					"content": "Kusura bakmayın, yine çenem düştü. Fazla vaktinizi almadım, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540721
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540721,
					"content": "Pekala, yapmamız gereken kontroller ve işaretlememiz gereken kaçak mallar var. Sanırım sohbetimizi burada sonlandırmamız gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540722
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540722,
					"content": "Yoldaşlarımız adına size bir kez daha teşekkür etmek istiyorum. Umarım yolculuğunuzun geri kalanı sorunsuz geçer. Taşordu burada olduğu sürece, kötülük asla kazanamayacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540707,
					"content": "Bu, hapse girmeyeceğimiz anlamına mı geliyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540708
					]
				},
				{
					"id": 710540708,
					"content": "Evet, sonuçta Taşordu'ya yardım ediyordunuz... Yani Taşordu'nun yardımıyla kaçakçıları yakalıyordunuz. Sizi nasıl hapse atabiliriz ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540709
					],
					"speakerTitle": "Yanbo"
				}
			]
		},
