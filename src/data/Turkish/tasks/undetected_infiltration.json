			},
			"dialogs": [
				{
					"id": 710540401,
					"content": "Bence işe <color=#00E1FFFF>simya kampı</color> ile başlayarak onlara en büyük darbeyi vururuz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540402
					]
				},
				{
					"id": 710540402,
					"content": "Pekala. Orada ne yapıyorlarsa ona bir son vereceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yanbo"
				}
			]
		},
		{
			"id": 7105405,
			"completionStepIds": [],
