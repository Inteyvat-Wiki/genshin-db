			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yanbo",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710540101,
					"content": "Durun! Lütfen durun! Açıklamamıza izin verin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540102
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540102,
					"content": "Siz Hazine Avcısı değil misiniz? Teslim olsanız iyi olur. Burada açıklanacak bir şey yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540103,
					"content": "#Kanyon Bölgesinin Taşordu Manga Komutanı Yanbo emrinizde. Sizinle tanışmak büyük bir şeref {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540104
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540104,
					"content": "Şey... Saygıdeğer uçan yoldaşınızla da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540105
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540105,
					"content": "Hey, hey! Paimon diyecekseniz bayım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540106,
					"content": "Haha... Affedersiniz. Çok özür dilerim ama sanırım burada küçük bir yanlış anlaşılma söz konusu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540107,
						710540109
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540107,
					"content": "Yani siz Hazine Avcısı değil misiniz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540108
					]
				},
				{
					"id": 710540108,
					"content": "Hayır, değiliz. Hatta tam tersiyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540112
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540112,
					"content": "*öksürür* Bu bölgenin, bir zamanlar Hazine Avcılarının ini olduğunu söylemek yanlış olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540113
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540113,
					"content": "İşçiler dağıtıldıktan sonra o sansarlar buraya dadandı... İlk başlarda yalnızca maden kazıyor, Parlak Kum Kristali kaçakçılığı yapıyor ve devriyelerimizle saklambaç oynuyorlardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540114
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540114,
					"content": "Zamanla daha da cesaretlendiler ve madencilerin geride bıraktığı eski depoya girmeye ve orayı mesken tutmaya başladılar. Oradaki aletleri kullanarak, basit süs eşyaları bile üretip sattılar! *iç çeker* Her düşündüğümde üzülüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540115
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540115,
					"content": "Neyi her düşündüğünde üzülüyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540116
					]
				},
				{
					"id": 710540116,
					"content": "Böyle kabaca yapılmış süs eşyalarına yalnızca Liyue'yi ilk kez ziyaret edenler veya dünyadan bihaber alimler kanar. Bahse varım, bu eşyaları piyasaya ucuz bir fiyattan sürmeye çalışacaklar. Hatta belki de bununla bazı yasal markalara zarar vermeyi bile deneyecekler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540117
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540117,
					"content": "Sonuçta kendi markaları falan yok, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540118,
					"content": "Yok. Bana sorarsanız, bu işten iyi Mora kaldıracaklarını düşünmeleri bile başlı başına bir rezillik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540119
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540119,
					"content": "O yüzden buraya geldik ve o esnada burada bulunan Hazine Avcılarının icabına baktık. Sonra da onların kılığına girip beklemeye başladık... Tabii bu bir süre önceydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540120
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540120,
					"content": "Şimdiye kadar onların liderlerinden birinin, Fatui'nin kollarından biriyle iletişim halinde olduğunu ve tehlikeli eşyalarla ilgili bir alışverişe hazırlandıklarını öğrendik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540121,
						710540124
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540121,
					"content": "Fatui ile Hazine Avcıları arasındaki ilişki hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540122
					]
				},
				{
					"id": 710540122,
					"content": "Daha önce Fatui'nin planlarını bozmuş olmamıza rağmen, hâlâ bu vahşi kesimde bir miktar güce sahipler... Onların profesyonelliklerini ve savaş güçlerini küçümsememek gerekiyor. Bizim, onları en tehlikeli düşmanlarımız olarak gördüğümüz bile söylenebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540123
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540123,
					"content": "Bize karşı koymak için Hazine Avcılarıyla iş birliği yaparlarsa, içinden çıkılması güç bir güvenlik tehdidiyle karşı karşıya kalabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540126
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540126,
					"content": "Her halükarda tüm gücümüzle saldırmaya hazırdık. Tek yapmamız gereken hepsini tek bir hamlede yakalamaktı. Böylece ne haltlar karıştırdıklarını öğrenebilecektik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540127
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540127,
					"content": "Biz de tam o sırada geldik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540128,
					"content": "*iç çeker* İyi olduğunuzu biliyorduk ama bu kadar iyi olduğunuzu düşünmemiştik... Komutam altındaki adamların neredeyse yarısını etkisiz hale getirdiniz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540129
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540129,
					"content": "Tabii biz başka bir sebepten ötürü buradaydık... Yedi Yıldız Dizilimini dizginleyen Anahtar Kayalardan biri burada bulunuyor. Onun Hazine Avcılarının eline geçmesine izin veremezdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540130,
						710540132
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540130,
					"content": "Şey, pardon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540131
					]
				},
				{
					"id": 710540131,
					"content": "Hahaha! Abartılacak bir şey değil. Sizi tanımadığımız için biz de kusurluyuz sonuçta... Aslında geçmenize izin vermemizi söyleyen bir emir geldi ama buraya bu kadar çabuk gelmenizi beklemiyorduk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540134
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540134,
					"content": "Vay be, adam epey rahat biri. Bu, gidebileceğimiz anlamına mı geliyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540135,
					"content": "Şey... Benim sizi suçlamıyor olmam, Liyue yasalarının da sizi suçlamayacağı anlamına gelmiyor. Hehe, bunun için üzgünüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540136
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540136,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540137,
						710540138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540137,
					"content": "Bir dahaki sefere sözlerini tamamla, olur mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540139
					]
				},
				{
					"id": 710540139,
					"content": "Hımm, bir bakalım. Darp, saldırı, Taşordu'ya mukavemet, Yedi Yıldız Dizilimini yok etmeye teşebbüs ve mala zarar verme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540140
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540140,
					"content": "Taşordu'nun müsamahasına rağmen... Tebrikler, Liyue'de beş yıldan on yıla kadar yiyecek ve konaklama hizmetleri kazandınız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540141
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540141,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540142,
						710540144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540142,
					"content": "Avukat vermiyor musunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540143
					]
				},
				{
					"id": 710540143,
					"content": "Aynen, bize bir isim listesi ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540146,
					"content": "*öksürür* Bırakın da sözlerimi bitireyim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540147
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540147,
					"content": "Bununla birlikte, kanunlara uyan vatandaşlar veya yabancı misafirler Taşordu'ya görevlerini yerine getirmelerinde yasal yollardan yardımcı olurlarsa, hak ettikleri ödül ve karşılıkları alabilirler. Bu da buranın kanunlarından biridir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540148
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540148,
					"content": "Kısacası merak etmeyin, az önceki dövüş boşuna değildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540149
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540149,
					"content": "Peki, size yardım edince elimize ne geçecek?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540150
					]
				},
				{
					"id": 710540150,
					"content": "Çalıntı malları öyle gelişigüzel taşımamak lazım. Bize yardım etmeye karar verirseniz, yolda tesadüfen bulduğunuz eşyalarla dilediğinizi yapma hakkını elde edebilirsiniz. Mesela \"bir Hazine Avcısının gizli zulası\" gibi şeyler bulabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540151
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540151,
					"content": "Yanımızda biraz Mora da var. Umarım bunu almanız sizin için bir sorun teşkil etmez. Ne yazık ki çok değil. Dışarıdan böyle bir \"yardım\" almayı beklemediğimiz için yanımızda fazla bulundurmamıştık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540152
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540152,
					"content": "Yani bu, hapse girmeyeceğimiz ve hazine kazanacağımız anlamına mı geliyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540153
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540153,
					"content": "Evet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540154
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540154,
					"content": "O zaman anlaştık! Önden buyurun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540155,
						710540156
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540155,
					"content": "Bir dakika!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540157
					]
				},
				{
					"id": 710540157,
					"content": "Hadi, bu kadar mesafeli olmaya gerek yok... Sonraki emirleri beklemek üzere buluşma noktasına gidiyorum. Bize çabucak yetişin yoksa biz önden gideriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540158
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540158,
					"content": "Tamam! Hadi onları takip edelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540159
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540159,
					"content": "Hey!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540160
					]
				},
				{
					"id": 710540160,
					"content": "Hadi ama! Sonuçta burada resmi görevlere yardımcı oluyoruz. Üstelik cebimize Mora da girecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540156,
					"content": "Ben daha sözümü bitirmedim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540157
					]
				},
				{
					"id": 710540144,
					"content": "Sana çok daha sert vurabilirmişim aslında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540145
					]
				},
				{
					"id": 710540145,
					"content": "Pöh! Tek yaptığımız birkaç sinir bozucu elemanı pataklamaktı! Hadi ama! Üstelik Hazine Avcısı üniformaları giyiyordunuz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710540138,
					"content": "Bunu bilerek yaptın...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540139
					]
				},
				{
					"id": 710540132,
					"content": "Şey, görünüşe göre bu sefer gerçekten de yanlış kişileri patakladık...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540133
					]
				},
				{
					"id": 710540133,
					"content": "Evet, öyle oldu ama dediğim gibi başta biz sizi tanıyamadık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540134
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540124,
					"content": "Tehlikeli eşyalar hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540125
					]
				},
				{
					"id": 710540125,
					"content": "Muhbirim, Fatui'nin büyük miktarda Mora ve malzeme karşılığında Hazine Avcılarının elindeki bir şeyi aldığını söylüyor ama bulabildiği tek şey yiyecek ve günlük ihtiyaçlar olmuş. Bunun bir aldatmaca olabileceğini düşünüyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540126
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540109,
					"content": "O zaman... Taşordudan mısınız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710540110
					]
				},
				{
					"id": 710540110,
					"content": "Haha, doğru düzgün açıklayamadığım için kusuruma bakmayın. Aslında biz de sizin sabotajcı olduğunuzu düşünmüştük.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540111
					],
					"speakerTitle": "Yanbo"
				},
				{
					"id": 710540111,
					"content": "Yani, bakış açısına göre değişebilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710540112
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7105402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
