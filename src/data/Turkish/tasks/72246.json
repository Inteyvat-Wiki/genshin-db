				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sumida",
					"Kama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722460101,
					"content": "Ne kadar da güzel bir bileklik! Ne kadar da güzel bir vazo! Liyue'deki ürünler gerçekten çok güzel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460102
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460102,
					"content": "Yok, olmaz. Bu kadar basit sözcükler benim gibi bir yazara hiç yakışmıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460103
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460103,
					"content": "Belki de ustalıkla yapılmış bu porselen bibloyu alıp bir sonraki romanımda kullanmalıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460104
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460104,
					"content": "Ah evet, evet! İşte bunu yazacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460105
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460105,
					"content": "\"Olayların gidişatını değiştirmek için gereken Önsezi vazonun içerisinde mühürlüydü!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460106
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460106,
					"content": "Evet, bu gerçekten merak uyandırıcı bir konu! Sen ne düşünüyorsun Kama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460107
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460107,
					"content": "Leydi Sumida, ben gerçekten...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460108
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460108,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460109
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460109,
					"content": "Bu vazonun betimlemesi çok iyi ayarlanmalı. Üzerine çok zaman harcarsanız sezdirmeniz çok belli olur. Çok üstü kapalı konuşursanız da daha sonrasında olayların gelişmesindeki rolü çok garip duracak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460110
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460110,
					"content": "Hımm, gerçekten haklısın! Bunu hemen yazayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460111
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460111,
					"content": "Yok, bekle. Bunu başka bir yerde yapalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460112
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460112,
					"content": "Ayrıca ben sana bin kere bana \"Leydi\" deme demedim mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460113
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460113,
					"content": "Tabii yine de birbirine \"Leydi\", \"Lord\" diyen sıradan görünümlü bir maceracı çifti de fena kitap konusu olmaz, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sumida"
				}
			]
		},
		{
			"id": 7224602,
			"completionStepIds": [
				7224603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224603",
							"2"
						],
						"stepId": 7224603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sumida",
					"Kama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722460201,
					"content": "Uf... Bu iyi geldi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460202
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460202,
					"content": "Ya da \"kuzeydeki en büyük kütüphane böyle olmalı\" mı demeliyim? Vera'nın Melankolisi serisini tek seferde bitirebileceğimi düşünmek... Harika hissettiriyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460203
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460203,
					"content": "Leydi Sumida, kısık sesle konuşmak daha akıllıca olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460204
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460204,
					"content": "Doğru. Üzgünüm. Bir anda çok heyecanlandım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460205
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460205,
					"content": "Zarar görmenizden korkuyorum. Şu kütüphanecinin çok korkunç bir havası var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460206
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460206,
					"content": "Ne? Gerçekten mi? Ben de onun tipik, hafif tembel bir cadı olduğunu düşünüyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460207
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460207,
					"content": "Şimdi sen söyleyince; genelde bu tip karakterler son derece güçlü oluyor. Tamam o halde, onunla ters düşmeye gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460208
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460208,
					"content": "Aslında bu tür bir karakteri temel alarak bir hikaye yazabilirim, değil mi? Adı da \"Büyük Kütüphane Büyücüsü\" olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460209
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460209,
					"content": "Seyahatlerin nasıl gidiyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460210
					]
				},
				{
					"id": 722460210,
					"content": "Ah. Epey zaman oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460211
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460211,
					"content": "#Oo, bu da efsanevi {NICKNAME} değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460212
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460212,
					"content": "Yolculuğumuz mu? Ben de eskiden kitaplarımda kullanacak malzeme bulmak için yolculuğa çıkardım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460213
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460213,
					"content": "Fırtınaları daha iyi betimleyebilmek için Musoujin Geçidi'ne, şeytan yılanı betimleyebilmek için de Yılan Başı'na gitmiştim. Kaçakların hayatını daha iyi anlayabilmek için de Kama'dan orduya katılmasını istemiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460214
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460214,
					"content": "Kama'nın yerinde olmak istemezdim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460215
					]
				},
				{
					"id": 722460215,
					"content": "O kadar da zor değildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460216
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460216,
					"content": "Şu anki yolculuğumuz zorlu geçecek. Belirli hedefi olmayan bir yolculuk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460217
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460217,
					"content": "Tıpkı Kino'nun Seyahatleri'nde olduğu gibi bu dünyada üzerine yazmaya değer çok şey olduğunu henüz keşfettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460218
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460218,
					"content": "Kama ile önerilen yerleri görmeye gittik ve oralardaki dükkanları gezdik. Sonra da doğada kamp kurup ateş başında yabancı gezginlerle birbirimize hikayeler anlattık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460219
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460219,
					"content": "Uyandığımızda bütün eşyalarımız gitmişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460220
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460220,
					"content": "Ne? Eşyalarınızı bulabildiniz mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460221
					]
				},
				{
					"id": 722460221,
					"content": "Evet, bulduk. Açıkçası hırsız çetesinin ondan fazla üyesi olduğunu öğrenince eşyalarımızı asla geri alamayacağımızı düşünmüştüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460222
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460222,
					"content": "Ama nasıl olduysa Kama onları eşyalarımızı vermeye ikna etti. Hatta yanımızda bulunsun diye üzerinde kuzgun nişanı olan bu paradan bile verdiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460223
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460223,
					"content": "Yazık. Bunun çok ilgi çekici bir hikaye olacağını düşünmüştüm ama Kama ayrıntıları anlatmak istemedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460224,
						722460225
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460224,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460226
					]
				},
				{
					"id": 722460226,
					"content": "Yalnızca görevimi yaptım. Leydi Sumida, endişelenmenize hiç gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460227
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460227,
					"content": "Kama, cidden yerin doldurulamaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460228
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460228,
					"content": "Maceralarımız bizi dünyanın en ucuna da götürse yanımda sen olduğun sürece başımızın belaya gireceğini düşünmüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460229
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460229,
					"content": "Konusu açılmışken; Tsurumi Adası'ndaki olaydan sonra gerçekten çok değiştin. Artık yapmak istediğin şeyler, paylaşmak istediğin fikirlerin ve endişelerin var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460230
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460230,
					"content": "Leydi Sumida eğer siz uygun görmüyorsanız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460231
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460231,
					"content": "Hayır, hayır! Bunun harika olduğunu düşünüyorum. Dile getirdiklerin gerçekten yerinde ve önemli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460232,
						722460233
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460232,
					"content": "İkinizi yalnız bırakayım o halde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460234
					]
				},
				{
					"id": 722460234,
					"content": "#Aynen öyle. Görüşürüz {NICKNAME}. Aynı \"Prenses Fischl'ın Çiçekleri\" kitabındaki gibi her şeyin sonunda buluşalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460235
					],
					"speakerTitle": "Sumida"
				},
				{
					"id": 722460235,
					"content": "#Görüşürüz {NICKNAME}. Kendine dikkat et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460233,
					"content": "Başka bir yerde tekrar görüşmek üzere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460234
					]
				},
				{
					"id": 722460225,
					"content": "Harikasın Kama.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722460226
					]
				}
			]
		},
