			"dialogs": [
				{
					"id": 722460301,
					"content": "Leydi Sumida, bir sonraki durağımızın neresi olacağı hakkında bir fikriniz var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722460302
					],
					"speakerTitle": "Kama"
				},
				{
					"id": 722460302,
					"content": "Bir düşüneyim... Mondstadt'ta çok büyük bir kütüphane olduğunu duymuştum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sumida"
				}
			]
		},
		{
			"id": 7224604,
