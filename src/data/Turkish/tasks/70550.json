			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Klee"
				],
				"points": [
					{
						"sceneId": 51205,
						"position": [
							2198.146,
							230.219,
							-780.029
						],
						"pointId": 1
					},
					{
						"sceneId": 51205,
						"position": [
							2198.069,
							230.089,
							-777.449
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705500101,
					"content": "#Hı? Bu... {M#Bay}{F#Bayan} Fahri Şövalye mi? Oley, sensin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500102,
						705500103
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500102,
					"content": "Selam Klee!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500104
					]
				},
				{
					"id": 705500104,
					"content": "Haha. Eula Teyze, Bayan Hertha'nın içecek standına yardım edecek harika birini bulduğunu söylemişti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500105
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500105,
					"content": "Klee seni burada görünce buranın tüm Teyvat'taki en iyi içecek standı olduğundan emin oldu Fahri Şövalye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500106,
						705500107
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500106,
					"content": "Böyle düşünmen çok hoş Klee. Amacımız o zaten!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500108
					]
				},
				{
					"id": 705500108,
					"content": "Y-Yani bu stant şu an en iyisi DEĞİL mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500109
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500109,
					"content": "#Şey... Klee'nin şimdiye kadar gördüğü içecek stantları arasında {M#Bay}{F#Bayan} Fahri Şövalyeninki açık ara en iyisi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500110
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500110,
					"content": "#Ayrıcaaaa... {M#Bay}{F#Bayan} Fahri Şövalye hangi içeceği yaparsa yapsın Klee'nin bayılacağı garanti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500111,
						705500112
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500111,
					"content": "Klee, bu kez bana karşı biraz daha acımasız olmanı istiyorum!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500113
					]
				},
				{
					"id": 705500113,
					"content": "Aa! K-Kaba olmamı mı istiyorsun? A-Ama... Klee sana asla kaba davranamaz ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500114
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500114,
					"content": "Hımm, dur bir düşüneyim... Buldum! Albedo taklidi yapacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500115
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500115,
					"content": "Albedo ne zaman Timaeus'un çalışmalarını incelese yüzü inanılmaz ciddi bir hal alır ve Klee onun söylediği her kelimeyi duyabilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500116,
						705500117
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500116,
					"content": "E süper, o halde benim öğretmenim olursun!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500118
					]
				},
				{
					"id": 705500118,
					"content": "Hihi... Klee'nin süper ötesi siparişine hazır ol!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500119
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500119,
					"content": "Yakında annemle balık patlatmaya gideceğim... Ama sakın Kumandan Jean'e söyleme, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500120
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500120,
					"content": "Bugün annemle biiiir sürü balık patlattık... Ama sakın Kumandan Jean'e söyleme, olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500121
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500121,
					"content": "Son birkaç gündür annemle oyun oynamaya doyamadım! Çok eğlenceliydi! Hücre hapsine gönderilmek bile neşesini bozmaya yetmedi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500122
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500122,
					"content": "Bu yüzden Klee, Havadar Havalar sipariş etmek istiyor. Parlak ve güneşli bir gün gibi hissettiren her şey Klee'yi kesinlikle inanılmaz mutlu eder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500123,
						705500124
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500123,
					"content": "Anlaşıldı Bayan Klee, hemen hazırlıyorum!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500125
					]
				},
				{
					"id": 705500125,
					"content": "Hihi, acaba tadı nasıl olacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500124,
					"content": "Anlaşıldı Usta Simyager Klee, hemen hazırlıyorum!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500125
					]
				},
				{
					"id": 705500117,
					"content": "E süper, o halde Usta Simyager Klee olursun!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500118
					]
				},
				{
					"id": 705500112,
					"content": "Bu sefer beni istediğin kadar eleştirebilirsin!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500113
					]
				},
				{
					"id": 705500107,
					"content": "Böyle düşünmen çok hoş Klee. En iyisi olmak için çabalıyorum!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500108
					]
				},
				{
					"id": 705500103,
					"content": "Selam sevgili müşterim Klee!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500104
					]
				}
			]
		},
