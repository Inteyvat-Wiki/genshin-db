			"dialogs": [
				{
					"id": 705500301,
					"content": "Ta da! Bitti. Bu yeni tarifimi çok seveceğinden adım gibi eminim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500302
					]
				},
				{
					"id": 705500302,
					"content": "Vay canına! Üstünde Dodoko Şekerlemesi var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500303
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500303,
					"content": "Bu bardağın içi ne kadar da turuncu! Dodoko da pofuduk beyaz bulutların üzerine uzanmış gibi duruyor... Ayrıca bardağın içindeki hava çok daha güzelmiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500304
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500304,
					"content": "Tadına bakmak ister misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500305
					]
				},
				{
					"id": 705500305,
					"content": "Çok lezzetli... Bayıldım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500306
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500306,
					"content": "Klee yavaşça içmeli... Bir dikişte bitiremem, yoksa bu lezzete yazık olur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500307
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500307,
					"content": "#{M#Bay}{F#Bayan} Fahri Şövalye, bu inanılmaz... Sanki güneş ışığıyla meyve suyunu karıştırmışsın gibi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500308
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500308,
					"content": "Klee oynamaktan çok yorulmuştu ama şimdi toparlanmış... Sıcacık... Ve huzurlu... Hissediyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500309
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500309,
					"content": "#*esner* Sen bir tanesin {M#Bay}{F#Bayan} Fahri Şövalye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500310,
						705500311
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500310,
					"content": "Bu içeceğe bir isim vermek ister misin Klee?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500312
					]
				},
				{
					"id": 705500312,
					"content": "Gerçekten mi? Bir düşüneyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500313
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500313,
					"content": "Hımm... Hava güzelse ve Dodoko mutluysa o zaman Dodoko şarkı söylemek ister, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500314
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500314,
					"content": "Dodoko şarkı söyleyince Klee'nin de içinden şarkı söylemek gelir... O yüzden adı... Dodoko'yla Düet olsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500315,
						705500316
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500315,
					"content": "Müthiş bir isim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500317
					]
				},
				{
					"id": 705500317,
					"content": "Hihi, teşekkürler! Ayrıca Klee'ye bu kadar lezzetli bir içecek hazırladığın için de teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500318
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500318,
					"content": "Klee gidip annesine şu an Mondstadt'taki en güzel içeceğin Dodoko'yla Düet olduğunu söyleyecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500319,
						705500320
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500319,
					"content": "Beğenmene sevindim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500321
					]
				},
				{
					"id": 705500321,
					"content": "#Hihi! Klee, {M#Bay}{F#Bayan} Fahri Şövalye için annesinin büyülü sözlerini yazıp sana bir kopyasını verecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500322
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500322,
					"content": "Sen de büyü yapmayı öğrenmelisin, böylece istediğin tüm şekerlemeleri yapabilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500323
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500323,
					"content": "Sonra görüşürüz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500320,
					"content": "Sınavını geçtim Bayan Klee!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500321
					]
				},
				{
					"id": 705500316,
					"content": "En iyi isimleri sen buluyorsun!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500317
					]
				},
				{
					"id": 705500311,
					"content": "Harika bir şey bulacağına eminim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500312
					]
				}
			]
		}
