						"position": [
							2198.069,
							230.089,
							-777.449
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705500201,
					"content": "Havadar Havalar hazır. Hadi bir dene bakalım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500202
					]
				},
				{
					"id": 705500202,
					"content": "Vay canına, Havadar Havalar bu renkte miymiş? Mor bir gökyüzü... Parlak, ışıltılı bir gece olması mı gerekiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500203,
						705500204
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500203,
					"content": "Belki de alacakaranlıkta bulutsuz bir gökyüzü olması gerekiyordur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500205
					]
				},
				{
					"id": 705500205,
					"content": "Klee önce bir yudum alsın... Sonra sen de daha dikkatli düşünürsün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500206
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500206,
					"content": "Oh, bitti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500207
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500207,
					"content": "Çok lezzetli! Hem tatlı hem de ekşi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500208
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500208,
					"content": "Klee Izgara Balık yerken bunu da içerse kesin iki, üç, dört, hatta... Beş tanesini bile mideye indirebilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500209
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500209,
					"content": "Ama tek bir içecek yetmez. Klee... Pasta tadında bir içecek denemek istiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500210,
						705500211,
						705500212
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500210,
					"content": "Anlaşıldı. \"Bardakta Pasta\"ya ne dersin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500213
					]
				},
				{
					"id": 705500213,
					"content": "#Hımm... Klee hangi içeceği seçeceğini bilemiyor. Birlikte karar versek ya {M#Bay}{F#Bayan} Fahri Şövalye?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500214
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500214,
					"content": "Yanında getirdiğin şekerlemeler çok özel görünüyorlar!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500215
					]
				},
				{
					"id": 705500215,
					"content": "Bunlar mı? Hihi... Annem bana bunları simya tezgahını kullanarak yapmayı öğretti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500216
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500216,
					"content": "Bir tutam şeker... Sonra çok daha fazla şeker, sonra annemin Fontaine'deki arkadaşından gelen çiçekler, Barbie Teyze'den yıldız balı ve son olarak Tavia Teyze'den biraz büyülü reçel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500217
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500217,
					"content": "Her şeyi simya masasında birleştir, istediğin şekli dile, annemin büyülü sözlerini söyle ve... Puf! Dodoko şeklinde şekerleme hazır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500218,
						705500219
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500218,
					"content": "Bayağı zahmetli işmiş...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500220
					]
				},
				{
					"id": 705500220,
					"content": "İstersen Klee sana da Dodoko Şekerlemesi verebilir! Hatta çok sevdiysen sana annemin büyülü sözlerini bile öğretebilirim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500221
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500221,
					"content": "Böylece ne zaman istersen kendi şekerlemelerini yapabilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500222,
						705500223
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500222,
					"content": "Bu muhteşem tarifini paylaştığın için teşekkürler Klee!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500224
					]
				},
				{
					"id": 705500224,
					"content": "Hihi, eğer takılırsan gelip Klee'ye sormayı unutma! Büyülü şekerlemeler konusunda uzmanım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500225
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500225,
					"content": "Bugün için başka bir planın var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500226
					]
				},
				{
					"id": 705500226,
					"content": "Evet! Annem geçenlerde bana harika bir kitap verdi. Her gece bir bölüm okumamı, yararlı şeyler öğrenmemi, sonra da erkenden yatmamı söyledi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500227
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500227,
					"content": "O kitap Klee'ye \"itici madde\" denilen şeyin nasıl yapılacağını öğretti. Artık Zıpzıp Bodur \"Viyuuv!\" diye fırlayıp daha bile yükseğe sıçrayabiliyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500228,
						705500229
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500228,
					"content": "P-Peki bu öğrenmen gereken bir şey mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500230
					]
				},
				{
					"id": 705500230,
					"content": "Hiç zor değil... Aslında bomba yapmaya çok benziyor. Sadece yontarken dikkatli olmalısın... Aniden GÜM diye patlayabilecek bir kalemi açmak gibi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500231
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500231,
					"content": "Uyku vakti Klee'nin programının önemli bir parçasıdır! Annem yanıma oturur ve bana harika hikayeler anlatır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500232
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500232,
					"content": "Annemin mücevherlerden yapılmış bir lambası var ve ne zaman o lambayı açsa \"ding dong\" diye ses çıkarıp tavanı aydınlatıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500233
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500233,
					"content": "Tavanda hikayenin sahneleri mi gösteriliyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500234
					]
				},
				{
					"id": 705500234,
					"content": "Evet! Hikayede bir şey olduğunda tavandaki ışıklar güzel resimler oluşturuyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500235
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500235,
					"content": "Bazen annem hikaye bitmeden uyuyakalıyor ve onun üstünü Klee örtüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500236
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500236,
					"content": "#Lambayı kullanmayı öğrenir öğrenmez sana hikaye anlatmaya gelebilirim {M#Bay}{F#Bayan} Fahri Şövalye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500237,
						705500238
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500237,
					"content": "Harika olur!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500239
					]
				},
				{
					"id": 705500239,
					"content": "Hihi, Klee bir sürü güzel hikaye ezberledi... Hem de herkesi her gün mutlu etmeye yetecek kadar çok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500240
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500240,
					"content": "Bugün başka bir şey yemeyi planlıyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500241
					]
				},
				{
					"id": 705500241,
					"content": "Evet! Eve gidince kitabımı okurken bir yandan da tuzlu kuruyemiş atıştıracağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500242
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500242,
					"content": "Klee eskiden akşam yemeğinden sonra pasta yerdi ama Kumandan Jean pastanın çok şekerli olduğunu ve yatmadan önce şekerli şeyler yemenin iyi olmadığını söyledi! İnsanı şişko yapıyormuş ve dişlerini çürütüyormuş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500243
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500243,
					"content": "O yüzden annem de Barbie Teyze'den akıl alıp bana kuruyemiş vermeye başladı. Kuruyemişin beynimi daha iyi çalıştırıp bir şeyleri daha kolay hatırlamamı sağladığını söylüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500244
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500244,
					"content": "Kuruyemişlerin pek tadı yok, ot çiğnemeye benziyor ama biraz tuz eklersen fena olmuyorlar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500245
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500245,
					"content": "İyi bir çözüm bulmuşsun belli ki. Hem besleyici hem sağlıklı!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500246
					]
				},
				{
					"id": 705500246,
					"content": "Hem sağlıklı hem de tatlı bazı malzemeler olmalı aslında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500247
					]
				},
				{
					"id": 705500247,
					"content": "Aa, doğru... Klee hâlâ tatlı bir şeyler yemek istiyor... Pasta mesela! Belki kremasını azıcık koyarız... Ya da daha fazla meyve ekleriz belki ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500248
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500248,
					"content": "Sahi ya! Annemin gözlüklü bir arkadaşı ona koca bir torba dolusu Fontaine Bulle Meyvesi vermişti. Yuvarlak ve kocamanlardı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500249
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500249,
					"content": "Klee onlardan bir sürü yedi ve hepsi çok tatlıydı... Ama Kumandan Jean sorun olmadığını söyledi çünkü şekerli meyveler bizim bildiğimiz şeker gibi değilmiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500250
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500250,
					"content": "Yani eğer illa kuruyemiş yiyeceksem belki önce onları biraz meyve suyuna batırabilirim, ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500251
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500251,
					"content": "Yemek demişken, umarım günde üç öğün yemeyi ihmal etmiyorsundur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500252
					]
				},
				{
					"id": 705500252,
					"content": "Günde üç öğün mü? Hihi, Klee genelde günde beş öğün yer, hatta bazen yedi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500253
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500253,
					"content": "Cidden mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500254
					]
				},
				{
					"id": 705500254,
					"content": "Maceracılık çok enerji gerektirir ve eğer tek seferde çok yemek yersem iyi koşamam... O yüzden sık sık az yemek daha iyidir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500255
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500255,
					"content": "Önceden Klee'nin bütün yemeklerini Albedo hazırlardı. Beslenme kutumu her zaman o kadar özenle hazırlardı ki tıpkı güzel bir resme benzerdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500256,
						705500257
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500256,
					"content": "Tam onluk bir hareket...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500258
					]
				},
				{
					"id": 705500258,
					"content": "Albedo'nun Ejdersırtı'nda işi olduğu zamanlarda Klee diğer Favonius Şövalyeleriyle birlikte yer yemeğini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500259
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500259,
					"content": "Kaeya'nın kampı genelde en düzgün olanıdır, Amber bazen ağaçlarda kamp kurar ve çok eğlenceli olur! Ha, bir de en güzel yemekleri Hertha Teyze yapar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500260
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500260,
					"content": "Annem geri döndüğünde daha da lezzetli yemekler olacak. Bir sürü farklı balığı alıp küçük puding küplerine dönüştürdüğü bir yemek var, adı Gökkuşağı Balık Jölesi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500261,
						705500262
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500261,
					"content": "Karnımı acıktırıyorsun...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500263
					]
				},
				{
					"id": 705500263,
					"content": "Onun Çikolatalı Kıtır Dilimleri de harikadır! Çikolata ve kurabiyeden yapılmış en yeni icadı! Biraz acılar ama kıtır kıtırlar, nefis kokuyorlar ve ağızda çok tatlı bir lezzet bırakıyorlar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500264
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500264,
					"content": "Onları her yediğimde enerjiyle doluyorum... Bir dahaki sefere Klee getirsin de sen de dene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500265
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500265,
					"content": "Pekala, sanırım içeceğini nasıl geliştireceğimi biliyorum!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500266
					]
				},
				{
					"id": 705500266,
					"content": "Sana bir tane daha hazırlayayım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500267
					]
				},
				{
					"id": 705500267,
					"content": "Vay! Çok hızlıydı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705500268
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500268,
					"content": "Klee hazırlayacağın bir sonraki karışımın ne kadar lezzetli olacağını görmek için sabırsızlanıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				},
				{
					"id": 705500262,
					"content": "Büyük bir maceracıdan harika bir yemek...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500263
					]
				},
				{
					"id": 705500257,
					"content": "Bir ara Albedo'nun yemeklerini tatmayı çok isterim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500258
					]
				},
				{
					"id": 705500238,
					"content": "Bu sözünü hatırlatırım sana!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500239
					]
				},
				{
					"id": 705500229,
					"content": "Y-Yapması kolay mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500230
					]
				},
				{
					"id": 705500223,
					"content": "Nasıl yapılacağını öğrenmek için çok çalışacağım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500224
					]
				},
				{
					"id": 705500219,
					"content": "Ne müthiş bir tatlı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500220
					]
				},
				{
					"id": 705500211,
					"content": "Pekala, inanılmaz lezzetli bir içeceğe daha hazırla kendini!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500213
					]
				},
				{
					"id": 705500212,
					"content": "Klee hangi tadı isterse onu deneyebilir!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500213
					]
				},
				{
					"id": 705500204,
					"content": "En uygun renk bu değil sanki... Birkaç değişiklik yapsam nasıl olur?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705500205
					]
				}
			]
		},
