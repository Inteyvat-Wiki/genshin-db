			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Alrani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718100101,
					"content": "Bu halde tezimi nasıl yazacağım ben? Ne yapsam acaba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100102
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100102,
					"content": "İyi misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100103
					]
				},
				{
					"id": 718100103,
					"content": "Ben... Ne? Ah, demek sensin! Beni hatırlıyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100104
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100104,
					"content": "Ben, şey, Lingju Geçidi'nde Hazine Avcılarının kafesinden kurtardığın kişiyim. O gün beni kurtardığın için teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100105
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100105,
					"content": "Seni buraya hangi rüzgar attı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100106
					]
				},
				{
					"id": 718100106,
					"content": "Şey, sen beni kurtardıktan sonra Soraya'yı bulmaya Wangshu Hanına gittim. Şans eseri bulabildim de.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100107
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100107,
					"content": "Soraya çok iyi biri! Bana hem yemek ısmarladı hem de notlarımı yeniden düzenlememe yardım etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100108
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100108,
					"content": "Ama sonra bana... Seçtiğim konu üzerine Akademide zaten çok sayıda tez yazıldığını söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100109
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100109,
					"content": "Olağanüstü bir tez yazamadığım sürece dersi geçmem mümkün değil... Soraya, bakış açımı değiştirmemi önerdi. Mesela elementlerle ilgili bir şey yazabilirmişim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100110
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100110,
					"content": "Ama benim Önsezim yok, elementleri kullanamıyorum. Nereden başlamam gerektiğini de hiç bilmiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100111
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100111,
					"content": "O yüzden şehre gelmekten başka seçeneğim yoktu. Hakkında yazabileceğim bir şeyler arıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100112
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100112,
					"content": "Bir dakika... Beni kurtarırken çok benzersiz bir şekilde dövüştüğünü hatırlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100113
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100113,
					"content": "Yoksa senin Önsezin mi var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100114
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100114,
					"content": "Hayır, yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100115
					]
				},
				{
					"id": 718100115,
					"content": "Nasıl yani? Önsezin olmadan nasıl öyle dövüşebiliyorsun? Bu mümkün mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100116
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100116,
					"content": "Neyse boş ver. Belli ki çok uzun bir hikaye bu... Yine de senden bir şey rica edeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100117
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100117,
					"content": "Bana nasıl dövüştüğünü gösterebilir misin? Belki tezimi düzeltmeme yarayacak bir şeyler gözüme çarpar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100118
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100118,
					"content": "Lütfen yardım et! Bu tezi bitiremeden Akademiye dönersem biterim ben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100119,
						718100122
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100119,
					"content": "Peki, tamam...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100120
					]
				},
				{
					"id": 718100120,
					"content": "Çok teşekkür ederim! O halde şehrin dışına çıkalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100121
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100121,
					"content": "Şuralarda bir grup Dağ Yabanisi gördüğümü hatırlıyorum. Onlarla savaşarak bana dövüş tarzını göster lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100122,
					"content": "Akademi cidden o kadar korkunç bir yer mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100123
					]
				},
				{
					"id": 718100123,
					"content": "Öyle korkunç bir yer ki anlatamam. Kabuslarıma giriyor, hep ağlayarak uyanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100124
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100124,
					"content": "Bir taslak veya tez savunması daha hazırlayacağıma Hazine Avcılarının kafesinde kalmayı tercih ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100125
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100125,
					"content": "Neyse, Akademi konusunu kapatalım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100126
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100126,
					"content": "Şuralarda bir grup Dağ Yabanisi gördüğümü hatırlıyorum. Onlarla savaşarak bana dövüş tarzını göster lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alrani"
				}
			]
		},
		{
			"id": 7181002,
			"completionStepIds": [
				7181003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
