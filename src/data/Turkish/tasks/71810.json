				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Alrani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718100201,
					"content": "Vay be! Dövüş tarzın gerçekten benzersiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100202
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100202,
					"content": "Bu arada duyduğum kadarıyla Önsezi sahipleri elementlerin varlığını hissedebiliyorlarmış. Bu yetenek Element Görüşü diye biliniyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100203
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100203,
					"content": "Önsezin olmasa bile element enerjisini kullanabildiğini gördüm. O zaman sen de Element Görüşü yeteneğine sahipsin, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100204
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100204,
					"content": "Yakınlarda birkaç bodurlop görmüştüm. Element Görüşünü nasıl kullandığını gösterebilir misin? O bodurlopları bulmak için kullanabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alrani"
				}
			]
		},
		{
			"id": 7181003,
			"completionStepIds": [
				7181009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181009",
							"2"
						],
						"stepId": 7181009,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Alrani"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718100301,
					"content": "Hahaha, Önsezim olmadığı için Element Görüşünü kullandığını fark etmedim bile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100302
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100302,
					"content": "Bu sadece diğer Önsezi sahiplerinin hissedebildiği bir şey olsa gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100303
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100303,
					"content": "Bana bu kadar çok şey gösterdiğin için teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100304
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100304,
					"content": "*iç çeker* Keşke bir Önsezim olsaydı... Elektrik Önsezim olsa harika olurdu. Hem havalı görünürdü hem de kendimi koruyabilirdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100305
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100305,
					"content": "Gerçi yok, düşününce Elektrik Önsezisi edinmek diğerlerine kıyasla daha da zor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100306
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100306,
					"content": "Yeterince çabalarsan eminim Elektrik Önsezisi alabilirsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100307
					]
				},
				{
					"id": 718100307,
					"content": "Hayır, ne kadar çabalarsam çabalayayım mümkün değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100308
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100308,
					"content": "Bir saniye, sen bilmiyor musun yoksa? Son bir senedir hiç kimseye Elektrik Önsezisi verilmediği söyleniyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100309
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100309,
					"content": "Akademinin bir süredir bu konuyu araştırdığını duydum. Nihayetinde Elektrik Hükümdarı'nın isteği bu yönde olduğu için ölümlülere Elektrik Önsezisi verilmediği sonucuna varmışlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100310
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100310,
					"content": "Ayrıca duyduğuma göre Inazuma'nın Elektrik Hükümdarı \"Önsezi Avı Fermanı\" diye bir şey yürürlüğe koymuş. Inazuma'daki Önsezi sahiplerinin çoğunun Önsezilerine el konulacakmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100311
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100311,
					"content": "İtaatsizlik edip Önsezilerini saklayan kişiler ağır şekilde cezalandırılacakmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100312
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100312,
					"content": "Önceden bu ferman ile ilgili bir tez yazmak için Inazuma'ya gitmek istiyordum fakat çok tehlikeli bir yer gibi geldi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100313
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100313,
					"content": "Sana bir şey olmaz. Önsezin yok ki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718100314
					]
				},
				{
					"id": 718100314,
					"content": "Öyle deme! Önsezisi olan insanlar bile bu kadar sorun yaşıyorsa Önsezisi olmayan insanlar kim bilir ne haldedir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100315
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100315,
					"content": "Sanırım Liyue'de kalıp huzur içinde tezimi bitirsem daha iyi olur. Sonra da en kısa zamanda tespitlerimi Sumeru'daki Akademiye bildirmeliyim. Daha fazla gecikirsem başımın etini yiyecekler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100316
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100316,
					"content": "Ah, doğru ya. Bana gösterdiklerin için sana teşekkür etmedim hâlâ. Bunları kabul et lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718100317
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 718100317,
					"content": "Bu sefer tezimi kesinlikle bitireceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alrani"
				}
			]
		}
	]
}