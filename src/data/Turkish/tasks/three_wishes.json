						20030502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030502,
					"content": "Üzgünüm, sıradan müşteriye hizmet vermiyoruz. Gitmeniz gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030503
					],
					"speakerTitle": "Kozue"
				},
				{
					"id": 20030503,
					"content": "Bekleyin! Biz sıradan müşteri değiliz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030504,
					"content": "Peki o halde... Giysilerinize bakarsak... Ülkeye gizlice girmiş birkaç yabancı olmalısınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030505
					],
					"speakerTitle": "Kozue"
				},
				{
					"id": 20030505,
					"content": "Giysilerimiz o kadar... Ah! Iıı... Paimon'un demek istediği...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030506,
					"content": "İşte Davet Mektubumuz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030507
					]
				},
				{
					"id": 20030507,
					"content": "Hımm, Yashiro Heyetinin mührü... Bu, Bay Thoma'dan olmalı. Sanırım görünüş bazen aldatıcı olabiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030508
					],
					"speakerTitle": "Kozue"
				},
				{
					"id": 20030508,
					"content": "Bu durumda, Yashiro Heyetinin güvenli bölgesi olan Komore Çayevine hoş geldiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030509
					],
					"speakerTitle": "Kozue"
				},
				{
					"id": 20030509,
					"content": "Bu şekilde kulağa daha hoş geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
