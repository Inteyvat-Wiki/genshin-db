					"Thoma"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20030101,
					"content": "Pekala, işte geldik. Thoma nerede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030102,
					"content": "*iç çeker* Paimon, onu hiçbir yerde görmüyor. Bizimle buluşma sözünü unuttu mu sence?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030103,
					"content": "Kimmiş verdiği sözü unutan? Ben de beni unuttuğunuzu düşünmeye başlamıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030104
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030104,
					"content": "N-ne? Bu köpek bizimle mi konuşuyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030105,
					"content": "Hahaha, sakin ol, bu kadar şaşırmana gerek yok. Tepkinden beni ilk kez bu şekilde gördüğünü anlıyorum, doğru mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030106,
						20030107
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030106,
					"content": "Yani... Sen... Köpek misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030108
					]
				},
				{
					"id": 20030108,
					"content": "Hah, yani Liyue Limanı'ndayken böyle bir şey görmedin, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030109
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030109,
					"content": "Ah, şimdi sen öyle söyleyince... Bir anda daha az olağan dışı gelmeye başladı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030110,
						20030111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030110,
					"content": "Ama yine de mantıklı değil...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030112
					]
				},
				{
					"id": 20030112,
					"content": "Hahaha. Tamam, tamam, yeterince eğlendim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030113
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030113,
					"content": "Hey! Biraz daha zorlarsan kötü bir lakabın olacak bayım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030114,
					"content": "Hehe, açıkçası biraz zaman öldürüyordum. Sizi burada o kadar uzun süredir bekliyorum ki... Ritou'da da aynısı olmuştu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030115
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030115,
					"content": "Bu yüzden geldiğinizde sizi böyle karşılayıp biraz eğlenmek istedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030116
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030116,
					"content": "Ama ciddi olmak gerekirse biraz önce maruz kaldığınız küçük \"test\" için özür dilemek istiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030117
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030117,
					"content": "Sizi Bayan Kamisato'nun karşısına çıkarıp çıkarmayacağımıza ve yanımızda yıldırımla yüzleşmeye cesaretinizin olup olmadığınızı belirlememize yardımcı oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030118
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030118,
					"content": "Of. Şimdi ciddileştin diye Paimon'un seni affedeceğini sanma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030119,
					"content": "Haha... Üzgünüm, aşırıya mı kaçtım? Kusuruma bakmayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030120,
						20030121
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030120,
					"content": "Peki, \"testimizde\" nasıldık?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030122
					]
				},
				{
					"id": 20030122,
					"content": "Şunu söyleyeyim, en baştan beri \"kurallardan\" kaçınıyorsun, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030123
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030123,
					"content": "Çünkü sarsılmaz ve kararlı bir iradeye sahipsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030124
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030124,
					"content": "Uzun süre önce neredeyse aynı olan bir arkadaşımız vardı... Ama yıldırım çarptığında...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030125,
						20030126
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030125,
					"content": "Kazuha'nın arkadaşını diyorsun...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030127
					]
				},
				{
					"id": 20030127,
					"content": "Ah, demek hikayesini duydun. Hım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030128
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030128,
					"content": "Işığı giderek daha fazla parlıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030129
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030129,
					"content": "O halde Shirasagi Himegimi ile görüşmemize izin var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030130
					]
				},
				{
					"id": 20030130,
					"content": "Evet, elbette. Sizi, Yashiro Heyetinin bulunduğu Kamisato Malikanesine götüreceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030131
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030131,
					"content": "Ama ondan önce ikinizin bana eşlik etmesini umduğum başka bir yer var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030132
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030132,
					"content": "Aa? Neresi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030133,
					"content": "Benimle Alemüstü Tanrı'nın Heykeline gelmenizi isterim. Yapımı henüz devam ediyor ama şimdiden Narukami Adası'nın neredeyse her yerinden onu görebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030126,
					"content": "Saraydaki bir düelloda ölmesinden bahsediyorsun...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030127
					]
				},
				{
					"id": 20030121,
					"content": "\"Yıldırımla yüzleşme cesareti\" mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030122
					]
				},
				{
					"id": 20030111,
					"content": "Bir köpek gördüğümde, onun köpek mi değil mi olduğunu bilirim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030112
					]
				},
				{
					"id": 20030107,
					"content": "İnsan görünümlü Thoma nereye gitti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030108
					]
				}
			]
		},
		{
			"id": 200302,
			"completionStepIds": [
				200302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200302",
							"2"
						],
						"stepId": 200302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Thoma"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20030201,
					"content": "Bu bölgenin kasvetli bir havası var. İnsanlar buraya muhtemelen çok sık gelmiyor, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030202,
					"content": "Hah, Paimon'un gözleri mi yanlış görüyor, yoksa heykelde gömülü şeyler mi var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030203,
					"content": "Önseziler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030204
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030204,
					"content": "Önseziler! Önsezi Avı Fermanında toplanan tüm Önsezilerin bu heykele konduğunu mu söylüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030206,
					"content": "Şogun neden Önsezi Avı Fermanı yayınladı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030207
					]
				},
				{
					"id": 20030205,
					"content": "Önsezi Avı Fermanını duydunuz demek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030206
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030207,
					"content": "Açıklamaya çalışmadan önce belki de size ilk önce Mondstadt'ın Özgürlük Şehri ve Liyue'nin de Sözleşmeler Şehri olduğunu hatırlatmam gerekir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030208
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030208,
					"content": "Inazuma'ya gelince... Sonsuzluk Ülkesi olarak bilinir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030209
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030209,
					"content": "Şogun Raiden, hem milletin en güçlü hükümdarı hem de tanrısıdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030210
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030210,
					"content": "Söz konusu \"sonsuzluk\"... Onun, Inazuma'yı yönetmeye yönelik sonsuz ve değişmez arzusudur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030211
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030211,
					"content": "Bu nedenle ülkenin işlerini yönetmek için Üçlü Heyeti ve insanların hareketini kısıtlamak için Sakoku Fermanını kullanır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030212
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030212,
					"content": "Şogun, Inazuma'yı durağan halde tutmak ve daima zamanın bir uçtan diğer bir uca akışını sağlamak ister.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030213
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030213,
					"content": "Her tanrının kendi arzusu var gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030214,
					"content": "Tabii, benim anlayabildiğim kadarıyla böyle. Kısa süre önce yayınlanan Önsezi Avı Fermanının nedenine gelince...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030215
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030215,
					"content": "Belki de Şogun, Önsezilerin insanlara değişme gücü verdiğine ve kendi sonsuzluğunun, bu tür bir istikrarsızlığın varlığına asla izin vermediğine inanıyordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030216
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030216,
					"content": "Ne olursa olsun gerçek şu ki, Şogun Raiden milleti Önsezilerden temizlemek için Tenryou Heyetini gönderdi ve her bir önseziyi heykele gömdü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030217
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030217,
					"content": "... Bu Alemüstü Tanrı'nın Heykeli de Inazuma'nın sonsuzluk simgesi olarak görülebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030218
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030218,
					"content": "Ama öyleyse Şogun Raiden'ın şey olduğu söylenemez mi... Nasıl denir, bencil mesela?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030219,
					"content": "Haha, yalnızca sizin gibi dışarıdan gelenler Şogun Raiden hakkında bu kadar direkt konuşmaya cesaret edebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030220
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030220,
					"content": "Ama yine de... Katılıyorum. Önsezi Avı Fermanı var olmaması gereken bir şey ve Bayan Kamisato, duyurulduğu günden beri onunla mücadele etmeye kendini adadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030221
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030235,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030223,
					"content": "Biraz önceki... O ses neydi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030224
					]
				},
				{
					"id": 20030221,
					"content": "#Hah? {NICKNAME}, iyi misin? Aklın başka yerde gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030222,
					"content": "Ses mi? Ne sesi? Hiçbir şey duymadım. Bir şey mi oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030223
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030225,
					"content": "Ben... İnsanların arzularının sesini duyabiliyordum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030226
					]
				},
				{
					"id": 20030224,
					"content": "Evet, heykele dokundun ve sonra... Sonra ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030226,
					"content": "\"Arzular\" mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030227
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030227,
					"content": "Hımm... Sanırım bu, o sözü doğruluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030228
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030228,
					"content": "Daha önce duymuş muydun? Bir kişinin isteği belirli bir güce ulaştığında, tanrılar onlara lütufla bakarmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030229
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030229,
					"content": "Önseziler oradan geliyor işte... Diğer bir deyişle, bir kişinin Önsezisi, onun isteğini temsil eder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030230
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030230,
					"content": "Yani, az önce söylediğin doğruysa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030231
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030232,
					"content": "O zaman Önsezi, isteği simgeliyor, gücü değil...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030233
					]
				},
				{
					"id": 20030231,
					"content": "... Bu kişilerin istekleri hayal ettiğimden daha güçlü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030232
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030233,
					"content": "Pekala. Narukami Adası turumuzdaki bir sonraki durağımız Kamisato Malikanesi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030234
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030234,
					"content": "Oh be, sonunda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
