					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20030401,
					"content": "Demek Inazuma'daki önemli kişilerin yaşadığı yer burasıymış. Paimon buranın daha şey olmasını beklerdi... Havalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030402,
						20030403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030402,
					"content": "Yeşim Konak'ı geçmesi zor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030404
					]
				},
				{
					"id": 20030404,
					"content": "Kamisato Malikanesine hoş geldiniz, saygıdeğer misafirler. Bayan Kamisato, nihayet sizinle tanışabileceği için çok memnun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030405
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030405,
					"content": "Bu sürekli bahsedip durduğun Shirasagi Himegimi mi? Peki, ımm, o nerede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030406,
					"content": "Öhöm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030407
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030407,
					"content": "Ah... Ha, perdenin arkasında mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030408,
					"content": "Evet, haha, Yashiro Heyetinin kızı olarak Bayan Kamisato, misafirleri bu şekilde kabul etmeye alışkındır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030409
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030409,
					"content": "Yashiro Heyeti içerisinde nesillerdir saygı duyulan bir gelenek olarak düşünebilirsiniz bunu. Hoş olmayan bir sürpriz olduysa kusura bakmayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030410,
						20030411
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030410,
					"content": "Sanırım anladım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030412
					]
				},
				{
					"id": 20030412,
					"content": "Mantıklı. Sonuçta çok önemli bir insan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030413,
					"content": "Sizi bu şekilde karşılayarak nezaketsizlik yaptıysam beni lütfen affedin... Özellikle de denizdeki uzun ve yıpratıcı yolculuğunuzdan sonra.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030414
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030414,
					"content": "Gelmenizi dört gözle bekledim ve Thoma, gerçekten zamanın akışını değiştirme gücüne sahip olduğunuz konusunda bana güvence verdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030415
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030415,
					"content": "Şu anda Inazuma'da, Önsezi Avı Fermanı adına, insanların arzuları anlamsızca ayaklar altına alınıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030416
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030416,
					"content": "Yashiro Heyeti, Şogun'a hizmet etmesine rağmen, görevlerimizi yerine getirirken insanlarla iletişim kurmamız gerektiğinden, halkla yakın ilişki kurarız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030417
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030417,
					"content": "Heyetin gücü insanların ona duyduğu güvene göre artar veya azalır. Bu duruma kayıtsız kalmak, kaderimize boyun eğmek anlamına gelir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030418
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030418,
					"content": "Gezgin, bize gücünü ödünç ver ve biz de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030419,
						20030420
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030419,
					"content": "Yalnızca Şogun Raiden'ı görmek için buraya geldim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030421
					]
				},
				{
					"id": 20030421,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030422
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030422,
					"content": "Bakın leydim, söylediğim gibi... Bu bizi bir sonuca ulaştırmayacaktır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030423
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030423,
					"content": "Ben artık gidiyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030424
					]
				},
				{
					"id": 20030424,
					"content": "Hayır, lütfen... Bekleyin! Lütfen... Gitmeyin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030425
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030425,
					"content": "*iç çeker*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030426
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030426,
					"content": "Ne oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030427
					]
				},
				{
					"id": 20030427,
					"content": "Sizi Şogun Raiden ile tanıştıracağım ama bir şartla... Benim için üç küçük dileği yerine getirmeniz gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030428
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030428,
					"content": "Dilekleriniz nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030429,
					"content": "Önsezileri kendilerinden alınan üç kişiyle ilgili. Onlarla karşılaştığınızda muhtemelen kim olduklarını anlarsınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030430
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030430,
					"content": "Bir köyü koruyan bir savaşçı, Önsezi Avı Fermanının gerçekleştirilmesine yardımcı olan eski bir samuray ve dünyanın en iyisi olmaya kararlı bir kılıç ustası. Paimon doğru mu anladı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20030431,
					"content": "Doğru. Lütfen onlara yardım etmek için elinizden geleni yapın. Ben, burada sizin geri dönmenizi bekleyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030432,
						20030433
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030432,
					"content": "İstediğinizi yapacağım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030434
					]
				},
				{
					"id": 20030434,
					"content": "Hehe... O halde size minnettarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030435
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 20030435,
					"content": "Harika bir iş çıkaracağınıza eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thoma"
				},
				{
					"id": 20030433,
					"content": "Bu çok zor bir görev...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030434
					]
				},
				{
					"id": 20030420,
					"content": "Bir isyan başlatmaya gelmedim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030421
					]
				},
				{
					"id": 20030411,
					"content": "(Bu biraz hayal kırıklığı oldu...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030412
					]
				},
				{
					"id": 20030403,
					"content": "Şafak Şaraphanesini geçmesi zor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030404
					]
				}
			]
