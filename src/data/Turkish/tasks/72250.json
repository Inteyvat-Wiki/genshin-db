				"points": []
			},
			"dialogs": [
				{
					"id": 722500101,
					"content": "İmdat! Yardım edin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500102
					],
					"speakerTitle": "Gama"
				},
				{
					"id": 722500102,
					"content": "Liderlerimizin Supada no Hiko'nun ayaklanmasını bastırmakta zorlandığını ve Dainichi Mikoshi'nin savunmasız kaldığını duydum. Hal böyle olunca ben de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500103
					],
					"speakerTitle": "Gama"
				},
				{
					"id": 722500103,
					"content": "Yalvarırım güzel gardiyan, bağışla değersiz hayatımı! Bakmam gereken bir hasta anam, büyütmem gereken 12 tane öksüzüm var. Ne olursun acı bana, kör sinekten bir farkım yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500104
					],
					"speakerTitle": "Gama"
				},
				{
					"id": 722500104,
					"content": "Öhöm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722500105
					]
				},
				{
					"id": 722500105,
					"content": "Ne? Seni Dainichi Mikoshi'nin etrafındaki muhafızlardan zannettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500106
					],
					"speakerTitle": "Gama"
				},
				{
					"id": 722500106,
					"content": "Sıra dışı giysilerine bakılırsa benimle aynı mesleği yapıyor olabilir misin? Fakat başka bir yerden mi geldin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500107
					],
					"speakerTitle": "Gama"
				},
				{
					"id": 722500107,
					"content": "Kim seninle aynı mesleği yapmak ister be!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722500108,
					"content": "Ama böyle yapma, kıvırmaya hiç gerek yok. *iç çeker* Sanırım dünyadaki en şanssız kişiyim. Dainichi Mikoshi'ye gireceğim diye ne badireler atlattım, tam da sağlam para kaldıracağım derken... Geldim buradaki mekanik tuzağa takıldım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500109
					],
					"speakerTitle": "Gama"
				},
				{
					"id": 722500109,
					"content": "\"Zenginden çalıp fakire verme\" günü bugün değilmiş demek ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500110
					],
					"speakerTitle": "Gama"
				},
				{
					"id": 722500110,
					"content": "Hadi be oradan! Bizim orada hırsıza hırsız derler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722500111,
					"content": "Sen ne bilirsin ki? Kodamanlar dekadan müzik dinler, tıka basa doyana kadar yer ve yarını yokmuşçasına içer. Biz alt tabaka da karın tokluğuna canımız çıkana kadar çalışalım! Mantığı nerede bunun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500112
					],
					"speakerTitle": "Gama"
				},
				{
					"id": 722500112,
					"content": "Hayatımı kurtardığın için sana bir sır vereceğim. Buranın bakımında çalışan ustaların dilleri çözülsün diye küçük bir şeyler ateşledim. Bana burada eskiden hazine saklamak için kullanılan iki oda daha olduğunu söylediler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500113
					],
					"speakerTitle": "Gama"
				},
				{
					"id": 722500113,
					"content": "İki tane daha mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722500114,
					"content": "#Ne dersin {NICKNAME}? Sen, ben ve Paimon gidip \"zenginden çalıp fakire verelim\" mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722500115,
					"content": "Ama odaların nerede olduklarını bilmiyorum. O işçiler bana daha fazlasını söylemedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500116
					],
					"speakerTitle": "Gama"
				},
				{
					"id": 722500116,
					"content": "Bu bilgi sana hediyem olsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500117
					],
					"speakerTitle": "Gama"
				},
				{
					"id": 722500117,
					"content": "Nasılsa Enkanomiya'da kimse yok, gidip odalarda ne tür antik yadigarlar bulabileceğimize bakalım mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722500118,
					"content": "#Hadi {NICKNAME}, gidip sandıkları karıştıralım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}