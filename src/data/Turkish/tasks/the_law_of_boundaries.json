			"dialogs": [
				{
					"id": 100090101,
					"content": "Hımm... Önceki sonuçlara bakılırsa deneyde birkaç düzenleme yapmalı ve malzemeler ile ekipmanların hepsinin düzgün olduğundan emin olmalıyım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090102
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090102,
					"content": "#Yapmam gereken iksir için... Aa, {NICKNAME}, Paimon! Buraya hangi rüzgar attı sizi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090103
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090103,
					"content": "\"Görevin\" için yardıma geldik. Elimizden gelen bir şey var mı diye bakmak istedik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090104,
					"content": "\"Görevim\"... Ha, Bay Albedo'nun bahsettiği görev mi? Cadılar Meclisinden gelen hani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090105
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090105,
					"content": "Tam zamanında geldiniz. Deney devam ediyor, ben de tam üzerinde çalışmaya başlayacaktım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090106
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090106,
					"content": "Devam mı ediyor? Yani bunca zamandır bunun üzerinde mi çalışıyordun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090107,
					"content": "Evet. Çalıştığım diğer araştırma konularıyla örtüştüğü için fazladan çok iş yükü olmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090108
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090108,
					"content": "Yine de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090109
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090109,
					"content": "Ne oldu? Deneyle ilgili bir sorun mu var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090110,
					"content": "Şu ana kadar \"başarılı\" olamadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090111
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090111,
					"content": "Ha, demek sürekli başarısız oluyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090112,
					"content": "Sadece \"başarısızlık\" olarak adlandıramayız bunu. Bu görevin arkasındaki teorik çerçeve düşündüğümden biraz daha karmaşık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090113
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090113,
					"content": "Bu görev tam olarak nedir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100090114
					]
				},
				{
					"id": 100090114,
					"content": "Doğru ya! Bize hâlâ ne tür bir deney olduğunu söylemedin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090115,
					"content": "Tatlı Çiçekleri normal boyutunun 16 katına dönüştürebilecek bir iksir geliştirmeyi amaçlayan bir deney bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090116
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090116,
					"content": "Yani \"Botanik Güçlendirme Reaktifi Tip IV, Model VII\" formülasyonu. Tahmin edebileceğiniz üzere bu deneyi yedinci kez yapıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090117
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090117,
					"content": "Vay be! Yani, aslında büyüme serumu yapmamız gerekiyor! Ya da onun yedinci versiyonunu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090118,
					"content": "E-Evet... Aşağı yukarı öyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090119
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090119,
					"content": "Bu benim yedinci denemem ama bu sefer formülde çok fazla değişiklik yapmadım, çünkü hem bu deneyin arkasındaki teorik prensipler hem de ortaya çıkan ürün formülde bir hata olmadığını kanıtlıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090120
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090120,
					"content": "Ama henüz \"başarılı\" olamadın, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090121,
					"content": "Evet. Şu anki formülümün yanlış olmadığını, daha ziyade... Başka bir kilit unsurun eksik olduğunu düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090122
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090122,
					"content": "Haaa... Hehe, o zaman Paimon ne yapacağını biliyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090123,
						100090125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090123,
					"content": "Sana yardım edelim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100090124
					]
				},
				{
					"id": 100090124,
					"content": "Evet! Zaten buraya bunun için geldik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090127,
					"content": "Şey, deneyebiliriz tabii ama... Orijinal formüldeki oranları ayarlamam gerekir ve bu da iksiri daha da kararsız hale getirebilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090128
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090128,
					"content": "Hayır, bunu KESİNLİKLE denemeyeceğiz! Sadece orijinalini göster bize!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090129,
					"content": "İşte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090130
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090130,
					"content": "Yine de hâlâ iki malzeme eksik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090131
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090131,
					"content": "İşte o konuda yardımcı olabiliriz. Ne toplamamız gerekiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090132,
					"content": "Baz olarak kullanmak için Pınarköy'den kaynak suyu ve bir de Fırtınanın Gözü parçaları lazım... Ama ikincisi biraz zor olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090133
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090133,
					"content": "Hallederiz biz! Hadi gidelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090125,
					"content": "Belki biraz Paimon özü ekleyebiliriz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100090126
					]
				},
				{
					"id": 100090126,
					"content": "Hehe, işte bu yüzden yardım ediy... Bir dakika, Paimon bir malzeme DEĞİL!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090127
					],
					"speakerTitle": "Paimon"
				}
			]
		},
