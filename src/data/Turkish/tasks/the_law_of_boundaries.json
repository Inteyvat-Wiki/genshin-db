			"dialogs": [
				{
					"id": 100091101,
					"content": "Of, başardık. O boyutta da olsa Yalancı Çiçek günün sonunda yine bir Yalancı Çiçek işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091102,
					"content": "... Hımm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091103
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091103,
					"content": "Ama... Bu kadar büyümesi normal mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091104,
					"content": "Savaş sırasında sadece kabaca bir tahmin yapabildim ama orijinal boyutunun en az 16 katı, belki daha bile büyük görünüyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091105
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091105,
					"content": "Bu da deneyimizin... Başarılı olduğu anlamına geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091106
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091106,
					"content": "E bu iyi bir şey değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091107,
					"content": "Sonuçların ne anlama geldiğinden hâlâ emin değilim... Ama eğer sonraki denemeler bu sonucu tekrar elde edebilirse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091108
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091108,
					"content": "Bu, bir şeylerin farklı olduğu anlamına geliyor... Belki de bu dünyanın sınırları ve kuralları bilinmeyen bir faktör nedeniyle değişiyordur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091109
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091109,
					"content": "Bunun iyi mi kötü mü olduğunu söyleyemem ama en azından simya açısından düşünecek olursam genişleyen sınırlar bize daha fazla olasılığın açıldığı anlamına geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091110
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091110,
					"content": "Her halükarda ben görevimi tamamladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091111
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091111,
					"content": "Öyle görünüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091112,
					"content": "Hımm. Gerçi bu, iksiri yapan kişinin etkisi de olabilir. Ya da belki bu Yalancı Çiçek diğerlerinden bir şekilde farklıdır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091113
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091113,
					"content": "Hâlâ doğrulanması gereken pek çok unsur var, sanırım bu görev çok daha fazla soruya yol açıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091114
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091114,
					"content": "Peki, yardıma ihtiyacın olursa buradayız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091115,
					"content": "Şu büyüme serumunu Paimon'da da deneyebilir miyiz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100091116
					]
				},
				{
					"id": 100091116,
					"content": "Hehe, düşünsene... Paimon 16 kat daha büyük olsaydı bir grup Hazine Avcısını un ufak edebilirdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091117,
					"content": "Bilemedim. Serumun Yalancı Çiçek üzerinde işe yaramasının tek nedeni, iç yapısının Tatlı Çiçeğe yeterince benzer olması... Eğer sen içersen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091118
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091118,
					"content": "16 kat büyüyebilirsin ama aynı zamanda bitkisel bir yaşam formuna da dönüşebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091119
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091119,
					"content": "Yok, kalsın. Bu iş olmaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091120,
					"content": "Ha bu arada, Paimon bir şey sormak istiyordu... Neden tüm araştırmaların Tatlı Çiçek ve Güneriği gibi bitkilere odaklı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100091121,
					"content": "Ha, çok basit. Güneriklerinin ve Tatlı Çiçeklerin nektarı tatlı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091122
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091122,
					"content": "Bu açıdan baktığımızda, bir Yalancı Çiçeği kazara 16 kat büyütmenin gizli bir faydası var, çünkü Yalancı Çiçek Nektarının tadı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091123
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100091123,
					"content": "... Tatlı Çiçeklerle bire bir aynı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100091124
					],
					"speakerTitle": "Paimon"
				},
