			"dialogs": [
				{
					"id": 100090801,
					"content": "İşte bu... Mükemmel bir uygulamaydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090802
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090802,
					"content": "Gerçekten mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090803,
					"content": "Evet, demlemede hiçbir kusur görmüyorum... Birazını çıkarıp ürünün bileşimini test edeyim. Bir dakika...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090804
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090804,
					"content": "Sucrose iksirden biraz numune alır ve bileşimini incelemek için bir cihaz kullanır...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						100090805
					]
				},
				{
					"id": 100090805,
					"content": "Evet, dediğim gibi. Kusursuz bir uygulama. İksir mükemmel. Tam da beklediğim gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090806
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090806,
					"content": "Yani şanslı sayımız yedi miymiş?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090807,
					"content": "İncelendiğinde önceki altı denemeyle aynı görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090808
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090808,
					"content": "Aa... Sonuçlar bire bir aynı mı çıktı yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090809,
					"content": "Tam olarak değil. Deney sonuçları benzer değişkenlerle bile farklı olabilir. Sonucun ne olacağını asla bilemezsin. Zaten deneyleri değerli kılan da budur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090810
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090810,
					"content": "Gelin bunu test edelim. Önceden diktiğim bazı Tatlı Çiçekleri kullanabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090811
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090811,
					"content": "Çiçekleri iksirle ıslatmamız ve ne olacağını görmemiz gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sucrose"
				}
			]
		},
		{
