			"dialogs": [
				{
					"id": 100090601,
					"content": "Tamam, malzemeler hazır ve kazan da hemen burada, yani başlayabiliriz. Ama şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090602
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090602,
					"content": "Bir sorun mu var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100090603,
					"content": "Yok, hayır. Sadece... Kenardan izlemem sorun olur mu? Yani, sadece doğru kayıt tutabilmek için...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090604
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090604,
					"content": "Deneyler sırasında gözlemlenmeyi çoğu insan sevmiyor da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090605
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090605,
					"content": "Hiç sorun değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100090606
					]
				},
				{
					"id": 100090606,
					"content": "Teşekkürler. Ben hazırım, istediğin zaman başlayabiliriz. Ayrıntılı notlar almayı da unutmayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100090607
					],
					"speakerTitle": "Sucrose"
				},
				{
					"id": 100090607,
					"content": "Pekala, deneye başlamaya hazır mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sucrose"
				}
			]
		},
