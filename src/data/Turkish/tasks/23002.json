					"Hanbei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230020101,
					"content": "Buradaki mantarlar fena durmuyor. Alışveriş listeme onları da ekleyeceğim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020102
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020102,
					"content": "Hanbei mi? Oldukça tanıdık bir isim. Paimon bu ismi daha önce duyduğundan emin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020103,
						230020104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020103,
					"content": "Tatarasuna'daki adam mıydı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020105
					]
				},
				{
					"id": 230020105,
					"content": "Ay! Mikage Ocağı'nda ortalığı karıştıran adamdı o!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020106,
						230020107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020106,
					"content": "Sanırım o yabancı ataşe olarak burada...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020108
					]
				},
				{
					"id": 230020108,
					"content": "Demek gerçekten de burada, Sumeru'da. Paimon ataşe olayının şaka olduğunu düşünmüştü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020109,
					"content": "Hımm... Sarı saçlar... Uçan minik bir şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020110
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020110,
					"content": "Gezgin sen misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020111,
						230020112
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020111,
					"content": "Aynen öyle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020114
					]
				},
				{
					"id": 230020114,
					"content": "Haha, gerçekten sizsiniz demek. Yousuke'nin mektubunda Bay Xavier'ye Mikage Ocağı olayında yardım ettiğinizden bahsediliyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020115
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020115,
					"content": "*iç çeker* Çok utanıyorum. Siz ikiniz Mikage Ocağı'ndaki işleri düzeltirken ben idari işlerle boğuşuyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020116
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020116,
					"content": "İdari işler Mikage Ocağı'ndan daha mı önemli gerçekten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020117
					]
				},
				{
					"id": 230020117,
					"content": "Neyin önemli olduğunu hiç bilmiyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020118,
					"content": "İdari işler olmadan Mikage Ocağı'nın bakımı bu kadar sorunsuz ilerlemezdi bu arada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020119
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020119,
					"content": "Yakındaki insanları tahliye ettim, onarımlar için malzemeleri hazırladım, adamları yerlerine yönlendirdim ve hatta üretimi bile koordine ettim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020120
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020120,
					"content": "İdari destek olmadan bu işler çok karışırdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020121
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020121,
					"content": "Tıpkı Toranosuke'nin söylediği gibi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020122
					]
				},
				{
					"id": 230020122,
					"content": "Şanına yaraşır biriymişsin gerçekten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020123,
					"content": "Toranosuke... O adam idari işleri hiç umursamıyor. Onunla çalışırken başıma hep ek iş çıkıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020124
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020124,
					"content": "Ama artık Mikage Ocağı'nın yetkilisi ben değilim. Artık Sumeru'da ataşe olarak görev yapıyorum ve mantar ticaretini yönetiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020125
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020125,
					"content": "Gezgin, başardığın işleri Yousuke'den duydum ve senin gerçekten güvenilir bir insan olduğuna inanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020126
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020126,
					"content": "Sakıncası yoksa bana bir konuda yardımcı olur musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020127
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020127,
					"content": "Güvenilir bir mantar tedarikçisi bulmaya çalışıyorum ve burada bir sürü tüccarla tanıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020128
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020128,
					"content": "Ama sadece hep en iyi mallarını gösteriyorlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020129
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020129,
					"content": "Bence mallarının kalitesini görmek için çiftliklerine gidip bir bakmak lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020130
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020130,
					"content": "Fakat gördüğün üzere ben vahşi doğada kalite kontrol nasıl yapılır bilmem. Bir de yalnız başıma gidersem o ormandan ölüm çıkar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020131
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020131,
					"content": "O yüzden senden oraya gidip bana birkaç mantar toplamanı rica ediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020132,
						230020133
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020132,
					"content": "Sanırım yapabilirim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020134
					]
				},
				{
					"id": 230020134,
					"content": "Yapacak mısın? Süper! Ödeme konusunu düşünme, sözleşmeyi bile hazırladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020135
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020135,
					"content": "Bir bak bakalım. Evet, bu belge işte. Bu senin iş sözleşmen, ödemelerinin dökümü, bir tebliğ ve bir gizlilik anlaşması. Az daha unutuyordum, bu da mantar çiftliğinin haritası...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020136
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020136,
					"content": "Hanbei ile tüm belgelere dikkatlice baktıktan sonra çok yoruluyorsun...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230020137
					]
				},
				{
					"id": 230020137,
					"content": "Güzel, her şeyi biliyorsun artık. Şogunluğa rapor göndereceğim, onaylarını aldıktan sonra her şeyi tamamlayabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020138
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020138,
					"content": "O zamana kadar paranı ben ödeyeceğim. Bu iş daha fazla bekleyemez çünkü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020139
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020139,
					"content": "Tabii ki bunun için de gerekli evrakları hazırlayacağım. Aldığın paranın vergisini ödemek gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020140
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020140,
					"content": "Ben... Gidip mantar toplayacağım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020141
					]
				},
				{
					"id": 230020141,
					"content": "Ha? Ha, tamam. İşine bak sen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020142
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020142,
					"content": "Yine bir belaya bulaşmayacağız değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020143,
						230020145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020143,
					"content": "Ona göz kulak olursam hayır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020144
					]
				},
				{
					"id": 230020144,
					"content": "Gerçekten mi? Tamam, haklısın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020147,
					"content": "Neden bu kadar şüphecisin? Merak edecek bir şey yok, her türlü hazırlığı yaptım. Sorunsuz işleyecek bu süreç.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020148
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020148,
					"content": "O tür bir sorundan bahsetmiyoruz... *iç çeker* Neyse, hadi mantarlarını toplayalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020145,
					"content": "Bu sefer ne sorun çıkaracak bakalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020146
					]
				},
				{
					"id": 230020146,
					"content": "Öyle bir şey olursa bize burada kimse yardım etmez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020133,
					"content": "Önce ödemeyi konuşalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020134
					]
				},
				{
					"id": 230020112,
					"content": "Bu Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020113
					]
				},
				{
					"id": 230020113,
					"content": "Paimon'un adı Paimon! \"Minik uçan şey\" falan değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230020107,
					"content": "Buraya mantarlar için gelmiş bence...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020108
					]
				},
				{
					"id": 230020104,
					"content": "Toranosuke ve Yousuke de ondan bahsetmişti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020105
					]
				}
			]
		},
