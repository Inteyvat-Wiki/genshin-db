			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hanbei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230020301,
					"content": "Harika, bu kadarı yeter de artar bile. Gayet güzel görünüyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020302
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020302,
					"content": "Al bakalım ödemeni, yardımın için teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020303
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020303,
					"content": "Bu vergi eklenmiş hali mi, eklenmemiş hali mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230020304
					]
				},
				{
					"id": 230020304,
					"content": "Eklenmiş hali elbette. Korkma, seni gecikmiş vergi ödemek için Inazuma'ya kadar gönderecek halim yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020305
					],
					"speakerTitle": "Hanbei"
				},
				{
					"id": 230020305,
					"content": "Ama Şogunluğun vergi politikasında değişiklik oldu mu bilemem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230020306
