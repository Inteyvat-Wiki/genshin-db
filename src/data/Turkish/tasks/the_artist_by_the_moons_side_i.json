			"dialogs": [
				{
					"id": 760360101,
					"content": "Bu mavi değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360102
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760360102,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360103,
						760360104
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360103,
					"content": "Columbina?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360105
					]
				},
				{
					"id": 760360105,
					"content": "Ha, siz miydiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360106
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760360106,
					"content": "Bana yardım edebilir misiniz? Merak etmeyin, karşılığını veririm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360107
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760360107,
					"content": "Şaka mı yapıyorsun? Bize borcun falan olmadığını biliyorsun, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360108,
						760360109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360108,
					"content": "Bize fazlasıyla yardımın dokundu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360110
					]
				},
				{
					"id": 760360110,
					"content": "Evet. Bize hiçbir şey veremeyecek olsan bile yardım ederiz sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360111,
					"content": "Neye ihtiyacın var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360112,
					"content": "Şey... Aslında yardıma ihtiyacı olan bu yaratık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360113
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760360113,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360114
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360114,
					"content": "Kuuhenki mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360115,
					"content": "Bu ufaklık bir yerlerde bir fırça bulmuş. Yanıma geldiğinde neşeyle sallayıp bana gösterdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360116
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760360116,
					"content": "Onun için bir tuval ve boya bulabildim ama bir süredir denemesine rağmen, istediği renkleri karıştırmayı başaramadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360117
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760360117,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360118
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 760360118,
					"content": "Ay! Sen nereden çıktın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360119,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360120
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 760360120,
					"content": "??",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360121
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360121,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360122
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 760360122,
					"content": "Iıı... Oyun mu oynuyoruz? Pardon, hiçbir şey anlamadık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360123,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360124
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 760360124,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360125
					],
					"speakerTitle": "Luonnotar"
				},
				{
					"id": 760360125,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360126
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360126,
					"content": "Aa, çantan ilgisini çekti galiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360127,
					"content": "Yanınızda uygun renkler vardır belki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360128
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760360128,
					"content": "Yanımızda o tarz şeyleri pek taşımayız... Boya demişken, sen nereden buldun onları? Yanlış anlama ama pek resim yapacak birine benzemiyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360129,
					"content": "Ufaklık çok sabırsızdı, ben de yakındaki çiçeklerden boya yaptım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360130
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760360130,
					"content": "Hımm, belki de Luonnotar boya yapılabilecek başka canlı renkli şeyler arıyordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360131,
					"content": "Yanımızda neler var diye bir bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360109,
					"content": "Asıl bizim \"karşılık vermemiz\" gerekir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360110
					]
				},
				{
					"id": 760360104,
					"content": "Ne oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360105
					]
				}
			]
