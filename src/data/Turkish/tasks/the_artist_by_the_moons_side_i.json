			"dialogs": [
				{
					"id": 760360301,
					"content": "Bunlar olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360302,
					"content": "Evet. Kuuhenki oldukça memnun görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360303
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760360303,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360304
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360304,
					"content": "Paimon Kuuhenkilerin resim yapabildiğini bilmiyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360305,
					"content": "Kuuhenkiler bize çok benziyorlar aslında. Hepsinin kendine has kişilikleri ve hobileri var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360306
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760360306,
					"content": "Nod-Krai'daki tüm Kuuhenkileri ayırt edebiliyor musun yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360307,
					"content": "Evet, sadece tanıştıklarımı tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360308
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760360308,
					"content": "Bu çok etkileyici! Luonnotar dışındaki Kuuhenkilerin hepsi aynı görünüyor çünkü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360309,
					"content": "Bu küçük ressamın adı ne peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360310,
					"content": "Adı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360311
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760360311,
					"content": "Bir dakika... İsimleri var, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360312,
					"content": "Birbirimizi tanıyoruz, bu kadarı yetiyor. İsimlere ihtiyacımız yok... Hem benim de bir adım yok zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360313
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760360313,
					"content": "Kötü gelenekleri sürdürmen gerekmez ama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360314,
					"content": "Hımm... Bir düşünelim... \"Luonnotar\", \"Ay Tanrıçası'nın lütfuyla doğan varlık\" anlamına geliyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360315,
					"content": "Donuk Ayın Çocuklarının dilinde \"resim\" nasıl deniyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360316,
					"content": "Sanırım şeydi... Maa... Naus? Maalaus? Evet. Maalaus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360317
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760360317,
					"content": "Uuu, kulağa hoş geliyor! O zaman adı bu olsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360318,
					"content": "??",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360319
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360319,
					"content": "Ne yaptın Maalaus? Resmini bitirdin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360320,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360321
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760360321,
					"content": "Uuu! Bakalım, bakalım... Vay canına. Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360322,
					"content": "Ne oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360323
					]
				},
				{
					"id": 760360323,
					"content": "Bu muhteşem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360324,
					"content": "Paimon çocuksu bir resim bekliyordu... Ya da Melusinaların çizdiği tarzda bir şeyler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760360325,
					"content": "Kuuhenkiler çevrelerini algılamakta epey iyilerdir. Gördüklerini resme dökerken bire bir, olduğu gibi aktarırlar genelde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760360326
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760360326,
					"content": "Columbina'yı mı çizdin Maalaus?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760360327
