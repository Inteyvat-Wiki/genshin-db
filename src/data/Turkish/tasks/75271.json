			"dialogs": [
				{
					"id": 752710301,
					"content": "Romantik kırmızı balonlar... Eminim sevdiğimin aklını başından alacaktır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710302
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710302,
					"content": "Öyle değil mi dostum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710303,
						752710304
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710303,
					"content": "Ben... Bu konulardan pek anlamam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710305
					]
				},
				{
					"id": 752710305,
					"content": "Ne olursa olsun sana teşekkür ederim dostum. Biraz daha kal da seni Yopoyi'yle tanıştırayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710306
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710306,
					"content": "Saate bakılırsa... Hımm, her an gelebilir. Randevumuz vardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710304,
					"content": "Çok seveceğine eminim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710305
					]
				}
			]
