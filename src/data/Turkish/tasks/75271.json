			"dialogs": [
				{
					"id": 752710601,
					"content": "Yopoyi! Sonunda geldin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710602
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710602,
					"content": "Ziki? Bu sen misin? Bu kıyafetin ne böyle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710603
					],
					"speakerTitle": "Yopoyi"
				},
				{
					"id": 752710603,
					"content": "Nanaslı oldum, sen seviyorsun ya hani! Kostümü özel kiraladım, nasıl görünüyorum? Şu balonlara bak bir de! Senin için hazırladım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710604
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710604,
					"content": "Aslında sana uzun zamandır söylemek istediğim bir şey vardı... Lütfen benimle çıkar mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710605
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710605,
					"content": "... Sen ciddi misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710606
					],
					"speakerTitle": "Yopoyi"
				},
				{
					"id": 752710606,
					"content": "Çok ciddiyim! Benim güzel Yopoyi'm, lütfen benimle çıkar mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710607
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710607,
					"content": "O kıyafeti giymeye çalışırken başını falan mı çarptın? Bugün bizim üçüncü yıl dönümümüz! Evliyiz ya hani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710608
					],
					"speakerTitle": "Yopoyi"
				},
				{
					"id": 752710608,
					"content": "Biliyorum ama... Bana hep romantik olmadığımı söylüyorsun. Evliliğimizden önce de sana olan aşkımı açıkça hiç söylemedim... Biraz geç kaldım ama sana bu şekilde ilanıaşk etmek istiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710609
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710609,
					"content": "Haha... Demek öyle. Peki o zaman, teklifini kabul ediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710610
					],
					"speakerTitle": "Yopoyi"
				},
				{
					"id": 752710610,
					"content": "Gerçekten mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710611
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710611,
					"content": "Evet, gerçekten. Seni romantik şapşal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710612
					],
					"speakerTitle": "Yopoyi"
				},
				{
					"id": 752710612,
					"content": "Hafifçe esen rüzgarla birlikte sevgililer birbirlerine sarılır.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
