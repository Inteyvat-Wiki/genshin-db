			"dialogs": [
				{
					"id": 752710101,
					"content": "Lütfen balonları patlatma! Eğer onlarla oynamak istersen sana başka verebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710102
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710102,
					"content": "Çok özel balonlara benziyorlar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710103
					]
				},
				{
					"id": 752710103,
					"content": "Bunu söylemeye biraz utanıyorum ama onlar benim için çok önemli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710104
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710104,
					"content": "Onlara baktığında amaçlarını anlayabiliyorsun, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710105,
						752710107
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710105,
					"content": "Evlilik teklifi mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710106
					]
				},
				{
					"id": 752710106,
					"content": "İlanıaşk aslında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710109
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710109,
					"content": "Yopoyi'ye olan aşkımı bu romantik balonlarla itiraf etmeyi düşünüyorum! Ee? Ne düşünüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710110
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710110,
					"content": "Kırmızı balonları kullanmalısın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710111
					]
				},
				{
					"id": 752710111,
					"content": "Hımm... Haklı olabilirsin. Hâlâ yeterince romantik değil miyim acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710112
					],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710112,
					"content": "Ama Yopoyi her an gelebilir! Kırmızı balonları nereden bulacağım ben şimdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ziki"
				},
				{
					"id": 752710107,
					"content": "İlanıaşk mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752710108
					]
				},
				{
					"id": 752710108,
					"content": "A-Aynen öyle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752710109
					],
					"speakerTitle": "Ziki"
				}
			]
		},
		{
