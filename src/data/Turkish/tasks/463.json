			"dialogs": [
				{
					"id": 4630001,
					"content": "Bu sefer tüm gizemler çözüldü. Çok emek harcadık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630014
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630014,
					"content": "Ama doğrusu bu hazine haritası cidden berbat... Sanki bir korsan çizmiş gibi duruyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630002,
					"content": "O zaman şimdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630003,
						4630005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630003,
					"content": "Hadi önce Kaeya'ye gidelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4630004
					]
				},
				{
					"id": 4630004,
					"content": "Hı? Paimon'a göre buna gerek yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630006,
					"content": "Aklımı okudun! Paimon çok sevindi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630007,
					"content": "Hadi gidelim! Bizden önce başkaları varmasın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630008,
					"content": "Mesela... Mesela Kaeya'nın bahsettiği Hazine Avcıları.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630009,
					"content": "Neyse, Paimon kılıcı ödünç alıp şey yapmak istiyor sadece...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630010,
					"content": "Hayır, hiçbir şey duymadın! Paimon... Paimon kılıcı görmek istiyor sadece!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630011,
					"content": "Kesinlikle aşırı süper güçlü olmak istemiyor ve sadece oynamak istiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630012,
					"content": "Hehe... Tamam, Paimon diyor ki sohbeti sonraya saklayalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4630013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630013,
					"content": "Arkadya hazinesini bulmaya gidiyoruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4630005,
					"content": "Hadi doğrudan hazinenin olduğu yere gidelim!",
