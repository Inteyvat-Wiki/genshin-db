					"content": "Bu şahıs kendisini Mahamata gibi tanıtarak Pazar limanı yakınlarında gasp ve hırsızlık yapmaktadır. Regzar Kalesi şu an bu şahıs hakkında soruşturma yürütmektedir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941003
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731941003,
					"content": "Ormanda saklandığına dair kanıtlar mevcuttur. Lütfen onu gördüğünüz yerde yetkililere haber verin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
