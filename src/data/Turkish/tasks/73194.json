			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731941101,
					"content": "Mahamata artık burayı duyuru yayınlamada kullanmayacağı için, burası hanımız için mükemmel bir mesaj panosu olacak. Lütfen mesajlarınızı burada paylaşmaktan çekinmeyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941102
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731941102,
					"content": "\"Sipariş verdiğim on adet şarap kasası geldi mi? Dün geldiğimde yoktu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941103
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731941103,
					"content": "\"Bu imkansız! Senden önce sarışın biri geldi ve oda arkadaşın olduğunu söyleyerek hepsini aldı. Hatta önceki gün buraya birlikte geldiğinizi bile hatırlıyorum. Yanılıyor olmalısın.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941104
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731941104,
					"content": "\"Pekala. Anlaşıldı.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
