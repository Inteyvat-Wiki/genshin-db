			"dialogs": [
				{
					"id": 731941201,
					"content": "\"Yağmur ormanına seyahat etmeyi planlıyorsanız dikkatli olun. Geçen gün danışmanım bazı bitikleri toplamam için beni oraya göndermişti, az kalsın bir Rishboland Kaplanına yem oluyordum.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941202
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731941202,
					"content": "\"Neyse ki yakınlardaki bir Orman Muhafızı beni kurtardı. Kendisini Acemi Orman Muhafızı olarak tanıttı ama bana kalırsa oldukça tecrübeli biriydi. En önemlisi de yaşadığım şoku atlatmam için bana çok leziz yiyecekler ikram etti.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731941203
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731941203,
					"content": "\"Duyduğuma göre Tighnari'nin öğrencisiymiş. Ee, ne demişler... Öğrencisi öğretmenine çekermiş işte!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
