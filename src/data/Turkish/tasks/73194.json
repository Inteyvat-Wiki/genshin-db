			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940101,
					"content": "Bu İlan Panosu Sumeru Şehri'nde meydana gelen önemli olayları kamuoyuna duyurmak için Mahamata tarafından hazırlanmıştır. Bildirilere dair herhangi bir sorunuz olursa İlan Panosuna mesaj bırakabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7319402,
			"completionStepIds": [
				7319402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319402",
							"2"
						],
						"stepId": 7319402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940201,
					"content": "\"Duydunuz mu? Orman Gözcüleri ormanın kuzeyinde yoktan var olan muhteşem bir saray bulmuş.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940202
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731940202,
					"content": "\"Ama oraya giden herkes dolandırılıp parasını kaybetmiş. Orman Gözcüleri onları bulduğunda üzerlerinde bir tek donları kalmış.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940203
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731940203,
					"content": "\"Ağlıyor ve neler olduğunu anlatmayı reddediyorlarmış. Kesinlikle dehşet verici.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940204
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731940204,
					"content": "\"En iyisi ormanda dolaşmamak.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7319403,
			"completionStepIds": [
				7319403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319403",
							"2"
						],
						"stepId": 7319403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940301,
					"content": "Şu anda duyurular Akaşa aracılığıyla Sumeru'nun her yanında gösteriliyor. Önemli bir duyuruyu kaçırmamak için Akaşa Terminalinizi lütfen çıkarmayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940302
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731940302,
					"content": "Yabancı tüccarların, yaşlıların ve çocukların rahat etmesi için İlan Panosu bir süreliğine etkin kalmaya devam edecek. İleride, uygun herhangi bir zamanda kaldırılabilir. Lütfen buna çok bağlı kalmamaya çalışın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7319404,
			"completionStepIds": [
				7319404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319404",
							"2"
						],
						"stepId": 7319404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940401,
					"content": "Bu yılki Anahit Bereketi dağıtımları başlamıştır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940402
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731940402,
					"content": "Dağıtım, prensipte geçen yılın planları ve koşulları doğrultusunda gerçekleştirilecek. İlgili bilginin detayları Akaşa'da ilan edilmiştir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940403
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731940403,
					"content": "Herhangi bir değişiklik olması durumunda, Akademiye düzenleme başvurusunda bulunmak için lütfen öncelikle en yakındaki Mahamata ile iletişime geçin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7319405,
			"completionStepIds": [
				7319405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319405",
							"2"
						],
						"stepId": 7319405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940501,
					"content": "Eleazar vakaları şehirde artış göstermektedir. Deride uyuşma, eklemlerde güçsüzlük veya vücutta gri ve siyah pullar gibi belirtilerle karşılaşmanız durumunda, muayene olmak için lütfen derhal Bimarstan'a gidin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940502
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731940502,
					"content": "Tedavi için erken müdahale sağlanmazsa hastalık kötüleşerek sakatlık gibi ciddi sonuçlara sebep olabilir. Lütfen bu uyarıyı dikkate alın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7319406,
			"completionStepIds": [
				7319406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
