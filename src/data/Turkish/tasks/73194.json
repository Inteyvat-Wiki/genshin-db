			"dialogs": [
				{
					"id": 731940801,
					"content": "Hırsızlığa uğramamak için kalabalık alanlarda üzerinizde fazla miktarda Mora taşımayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940802
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731940802,
					"content": "Değerli eşyalarınızın çalındığını fark etmeniz durumunda yakınlarda devriye gezen Münzevilerden yardım istemeyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940803
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731940803,
					"content": "Çünkü zanlı muhtemelen onlardan biridir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
