				"points": []
			},
			"dialogs": [
				{
					"id": 731940701,
					"content": "Bimarstan, Amurta'nın altında çalışan ve Sumeru'nun tüm sakinlerine ücretsiz sağlık hizmeti veren bir tıbbi tesistir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940702
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731940702,
					"content": "Bimarstan'daki doktorlar Amu{RUBY#[S]Biyoloji}rta tarafından verilen lisansa sahiptir. Teşhis ve tedavi planlarımız Akaşa tarafından birçok kez kontrolden geçirilir. Tüm Sumeru sakinlerine en güvenli ve en profesyonel tıbbi hizmetleri sağlamaktayız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940703
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731940703,
					"content": "Lütfen maddi kayıp yaşamamak ve sağlığınıza telafisi olmayan zararlar vermemek için tanımlanmamış ya da lisans sahibi olmayan doktorlara güvenmeyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
