					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940902
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731940902,
					"content": "Bu şahıs kendisini ülkeler arasında seyahat eden meşhur bir eşkıya olarak tanıtmaktadır ama esasında Münzevilerin hiyerarşisi içinde hiç yer almayan bir sahtekardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940903
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731940903,
					"content": "Yakın zamanda şahısla alakalı birçok dolandırıcılık vakası bildirilmiştir. Lütfen dikkatli olun ve ona kanmayın.",
					"roleType": "TALK_ROLE_NPC",
