			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731940601,
					"content": "Özel bir hatırlatma: Sumeru'daki tek paralı asker örgütü Münzevilerdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940602
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731940602,
					"content": "Dolandırılmamak için lütfen kimliği belirsiz kişilere itibar etmeyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731940603
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 731940603,
					"content": "Koruma ya da güvenlik tutmak ve diğer tüm istekleriniz için lütfen Otuzlu Teşkilattan Parchamdar Rukh Shah ile irtibata geçin veya Akademi görevlisi Effendi aracılığıyla özel görev yayınla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7319407,
			"completionStepIds": [
				7319407
			],
