			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110430101,
					"content": "A-Atlamamızı mı istiyorsun? Bu kadar yüksekten mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110430102,
					"content": "Atlamanıza gerek yok... Eğer daha iyi bir yol bulursanız tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430103,
						110430104
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430103,
					"content": "Daha iyi bir yöntem bulsak iyi olacak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110430105
					]
				},
				{
					"id": 110430105,
					"content": "Hangi yolu seçerseniz seçin deney gölün karşı kıyısına vardığınızda bitecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430106
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430106,
					"content": "Karşılaştırmalı analizimde harcadığınız zamanı ve en yüksek hızınızı kaydedeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430107,
					"content": "Gölün karşı tarafı... Yani... Yüzecek miyiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110430108,
					"content": "Hiçbir sınır yok. Görevi sezgilerinizle, size en mantıklı gelen yoldan tamamlayacaksınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430109
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430109,
					"content": "Bazıları soğuk sulara dayanamayabilir... Bazıları ferahlatıcı bulabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430110
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430110,
					"content": "Neyi seçerseniz seçin her şey deneyin bir parçası. Bana göre her detay araştırma için paha biçilemez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430111,
						110430112
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430111,
					"content": "Tam benlik bir deney.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110430113
					]
				},
				{
					"id": 110430113,
					"content": "Öyleyse lütfen buyurun. Sonuçları heyecanla bekliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430112,
					"content": "Aslında bu süper güç kısmından daha rahat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110430113
					]
				},
				{
					"id": 110430104,
					"content": "Söylediğin şey hiç güven vermedi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110430105
					]
				}
			]
		},
		{
			"id": 1104303,
			"completionStepIds": [
				1104303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104303",
							"2"
						],
						"stepId": 1104303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110430301,
					"content": "Harika! Hiç böyle bir performans görmemiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430302
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430302,
					"content": "Hakkında söylenenler doğruymuş Gezgin. Verilere göre ortalama bir Mondstadtlıyı kolaylıkla geçiyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430303
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430303,
					"content": "Sen de yol boyunca bizi hiç yorulmadan takip ettin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110430304,
					"content": "Ben mi? Aslında simyayı kullanarak biraz hile yaptım ama neyse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430305
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430305,
					"content": "Eğer Teyvat'ın doğal kanunları seni etkilemiyorsa ait olduğun dünya dışı medeniyete dair farklı çıkarımlarda bulunabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430306
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430306,
					"content": "Teyvat'ın doğa kanunları seni etkiliyorsa bu tür etkilerin yokluğunda meydana gelecek evrime dair çıkarımlar yapmam mümkün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430307
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430307,
					"content": "Bunun ortaya çıkarabileceği ihtimaller neredeyse sonsuz. Büyüleyici sonuçlar... Tekrar tekrar deneyimlenecek bir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430308
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430308,
					"content": "Amaaa ARAŞTIRMANA ne faydası olacak bunun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110430309,
					"content": "Araştırmama engel olan birçok sorunu çözmeme yardımcı oldunuz. Kampa geri döndüğümde size ilginç bir şey gösterebileceğimi sanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430310
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430310,
					"content": "Bu kadar araştırdığın başka bir şey var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110430311
					]
				},
				{
					"id": 110430311,
					"content": "Seninle birkaç... Tuhaf tür arasında bir bağ kurmak üzereyim sanırım. Umarım alınmazsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430312
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430312,
					"content": "Altın, Taşlaşmış Ağaçlar, bizimkinin sekiz katı boyutunda bir güneş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430313
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430313,
					"content": "Araştırma süreci özünde büyüleyicidir ama bu gibi hislerin kaybolması doğal olarak kaçınılmazdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430314
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430314,
					"content": "Tüm enerjimi araştırmaya vermeye hazırım ama örnekler sınırlı. Bilinmeyenler bilimsel kavrayış kapsamına girdiğinde aydınlanma hissi kaybolur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430315
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430315,
					"content": "Başlangıçta şaşkınlık uyandıran her nesne sonunda bir Güneriği veya Tatlı Çiçek gibi sıradan bir şey olur. Artık dikkate değer değildirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430316
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430316,
					"content": "Ya... Bu yüzden mi o dağ yabanilerini çiziyordun? Aralarındaki farklarda yeni ve ilginç bir şey görebildiğin için yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110430317,
					"content": "Aynen öyle. Daha önce söylediğim gibi, o yaratıklar çoğunlukla \"sıkıcı ve yakından incelemeye değmez\". Şu an merakımı cezbedecek neredeyse hiçbir özellikleri yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430318
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430318,
					"content": "Yani tüm bu deneylerden sonra basit bir çizim taslağı gibi sıkıcı mı olacağız sana göre?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110430319,
					"content": "Tabii ki hayır. Bana çok yardımcı oldunuz. Ömrüm boyunca arkadaşlığımızı unutmayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430320
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430320,
					"content": "Şimdi kampa dönmeden önce bir deney daha yapacağız; zekanı değerlendireceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110430321
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110430321,
					"content": "Beni takip edin. Yakınlarda başka harabeler de var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				}
			]
		},
