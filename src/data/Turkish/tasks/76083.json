					"nextDialogs": [
						760830408
					]
				},
				{
					"id": 760830408,
					"content": "Hey, bu yılan balığının beli neden böyle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760830409,
					"content": "İkinizin de bilgi düzeyi oldukça etkileyici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830410
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760830410,
					"content": "Doğru cevap \"ay\" olacaktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830411
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760830411,
					"content": "Geri gelin. Harika bir iş çıkardınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760830412,
					"content": "Yay.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760830413
					]
				},
				{
					"id": 760830413,
					"content": "Gözü olan herkes bunun bir yay olduğunu görebilir! Cevap nasıl bu kadar basit olabilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760830414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760830414,
					"content": "Teknik olarak haklısınız ama korkarım Kuuhenkilerin yapmaya çalıştığı tam olarak o değildi.",
