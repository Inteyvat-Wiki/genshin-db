			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Pervasız Pallad",
					"Joel",
					"Joserf",
					"Cyrus"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708030101,
					"content": "Ne? Bu da kim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030102,
						708030103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030102,
					"content": "O... Joel'in babası mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030104
					]
				},
				{
					"id": 708030104,
					"content": "Ah, Gezgin! Gelmişsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030105
					],
					"speakerTitle": "Pervasız Pallad"
				},
				{
					"id": 708030105,
					"content": "Seni Joserf ile tanıştırayım. Kendisi Joel'in babası.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030106
					],
					"speakerTitle": "Pervasız Pallad"
				},
				{
					"id": 708030106,
					"content": "Baba! Bu sana bahsettiğim gezgin. Geçmişte gezgin bana çok yardımcı oldu. Bir keresinde beraber kardan adam yapmışlığımız bile var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030107
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708030107,
					"content": "Joel bana senden çok bahsetti. Ne kadar teşekkür etsem az.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030108,
						708030109
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030108,
					"content": "Sonunda kavuştunuz, mutlu oldum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030110
					]
				},
				{
					"id": 708030110,
					"content": "Vay canına, bu harika!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030111,
					"content": "Fena değil Pallad, hiç fena değil! Bu sefer harika bir iş çıkardın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030112
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708030112,
					"content": "\"Bu sefer\" mi? Geçen sefer bir şey mi oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030113,
					"content": "Şey... Geçen sefer Ejdersırtı'nda bulduğumu söylediğim kişiyi hatırlıyorsun, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030114
					],
					"speakerTitle": "Pervasız Pallad"
				},
				{
					"id": 708030114,
					"content": "Sen dağa tırmanmama ve canavarları yenmeme yardım ettikten sonra, ben orada kalıp bölgeyi aramaya devam ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030115
					],
					"speakerTitle": "Pervasız Pallad"
				},
				{
					"id": 708030115,
					"content": "Aramalarım sırasında yanlışlıkla ayağım takıldı ve yuvarlanarak dağdan aşağı düştüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030116
					],
					"speakerTitle": "Pervasız Pallad"
				},
				{
					"id": 708030116,
					"content": "Sen... Yuvarlandın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030117,
					"content": "Neyse ki düştüğüm yerde kar çok kalındı da canım yanmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030118
					],
					"speakerTitle": "Pervasız Pallad"
				},
				{
					"id": 708030118,
					"content": "Tam dönmeye hazırlanırken yanımdan sesler gelmeye başladı. Sonra bir anda biri fırladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030119
					],
					"speakerTitle": "Pervasız Pallad"
				},
				{
					"id": 708030119,
					"content": "Onun, aradığım kişi olduğunu başta anlamadım. Hatta arama ekibindeki maceracılardan biriyle karıştırdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030120
					],
					"speakerTitle": "Pervasız Pallad"
				},
				{
					"id": 708030120,
					"content": "Birkaç kelime konuştuktan sonra, hafızasının yerinde olmadığını fark ettim. Kendi adını bile hatırlayamıyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030121
					],
					"speakerTitle": "Pervasız Pallad"
				},
				{
					"id": 708030121,
					"content": "Hava buz gibiydi ve her şeyi orada çözecek vaktimiz yoktu. Ben de onu, benimle kampa dönmesi için ikna ettim ve her şeyi orada konuşabileceğimizi söyledim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030122
					],
					"speakerTitle": "Pervasız Pallad"
				},
				{
					"id": 708030122,
					"content": "Kampa döndük ve Joel ile karşılaştık. Joel onu gördüğü an, yüzünde afallamış bir ifadeyle dondu kaldı. Sonra bir anda \"Baba! Baba!\" diye ağlamaya başladı. İşte o an Joserf hatırlamaya başladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030123
					],
					"speakerTitle": "Pervasız Pallad"
				},
				{
					"id": 708030123,
					"content": "Babacığım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030124
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708030124,
					"content": "Baban burada Joel, babacığın döndü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030125
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030125,
					"content": "Joserf, başka hiçbir şey hatırlamıyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030126,
					"content": "Yaban Domuzu Prenses, tilkileri beslemen...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030127,
					"content": "Özür dilerim, hiçbir şey hatırlayamıyorum. Belki kafa travmamdan dolayıdır. Emin değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030128
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030128,
					"content": "Uyandığımda kendimi kanlar içinde buldum. Eşyalarım ortada yoktu, kim olduğumu veya oraya nasıl geldiğimi gösterecek hiçbir şey yoktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030129
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030129,
					"content": "Kendimi toparlayabilmek için sürünerek bir mağaraya gittim. Bacaklarımı ve ayaklarımı daha iyi hissetmeye başlayınca, avcılık becerilerimle hayatta kaldım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030130
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030130,
					"content": "Baba... Senin için çok endişelendim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030131
					],
					"speakerTitle": "Joel"
				},
				{
					"id": 708030131,
					"content": "Artık iyiyim Joel. Ağlama, babacık bir yere gitmiyor. Yanından hiç ayrılmayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030132
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030132,
					"content": "Şimdi ne yapacaksın Joserf?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708030133,
					"content": "Ben... Bir süre daha ailemle kalmak istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030134
					],
					"speakerTitle": "Joserf"
				},
				{
					"id": 708030134,
					"content": "Sağ salim dönmen bir mucize! Mutlu son diye buna diyorlar galiba, hahah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030135
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708030135,
					"content": "Bu arada Pallad, maceracılık becerilerinin iyi bir seviyeye gelmesi için daha kırk fırın ekmek yemen gerekecek. Yani dengeni kaybedip dağdan yuvarlanarak düşmek de ne bileyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030136
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708030136,
					"content": "Loncaya döndüğümüz an takviye derslere başlıyoruz, o kadar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030137
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708030137,
					"content": "Ne? A-ama Cyrus... Bu sefer hatalarımı telafi etmedim mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030138
					],
					"speakerTitle": "Pervasız Pallad"
				},
				{
					"id": 708030138,
					"content": "Aması maması yok! Loncaya dönüyoruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708030139
					],
					"speakerTitle": "Cyrus"
				},
				{
					"id": 708030139,
					"content": "Lonca Başkanı, lütfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pervasız Pallad"
				},
				{
					"id": 708030109,
					"content": "İyi olduğuna sevindim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030110
					]
				},
				{
					"id": 708030103,
					"content": "Joel'in devasa hali...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708030104
					]
				}
			]
		}
	]
}