			},
			"dialogs": [
				{
					"id": 60080401,
					"content": "Hımm? Ne dedin? Tekrar söyleyebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080402
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080402,
					"content": "Şey... Senin eski meslektaşın. Yıldızkumu Sahili'nde onunla birlikteydik, o da Vahşi Ava yenik düştü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080403,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080404
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080404,
					"content": "Güldün mü sen az önce?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080405,
					"content": "... Hayır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080406
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080406,
					"content": "(Gayet de güldü!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080407,
					"content": "Aranız kötü mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080408,
					"content": "Hayır. Yenildikten sonra yüzünde oluşacak ifadeyi hayal ettim ve... İlginç buldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080409
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080409,
					"content": "Çok sarsılmış görünüyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080410,
					"content": "Çok geçmeden adapte olur. Bir şeylere alışmakta çok iyidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080411
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080411,
					"content": "#Neyse, konudan çok saptık. Ay İliğini hedefleyen adamın ne kadar tehlikeli olduğunu biliyoruz artık... Onu yanında taşımak istediğinden emin misin {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080412,
					"content": "Fatui'nin istihbaratı güvenilirse eğer, tüm Nod-Krai bir araya gelse bile Rerir'i yenemez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080413
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080413,
					"content": "Belki de onu bir süreliğine kısıtlayan bir durum vardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080414
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080414,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080415
					]
				},
				{
					"id": 60080415,
					"content": "Karar vermeden önce senden bir iyilik isteyeceğim Columbina.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080416
					]
				},
				{
					"id": 60080416,
					"content": "Nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080417
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080417,
					"content": "Kardeşimle birlikte Nod-Krai'a geldiğimde neler olduğunu gösterebilir misin? Uzay gemimiz indiğinde yani...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080418
					]
				},
				{
					"id": 60080418,
					"content": "Tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080419
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080419,
					"content": "Çok çabuk ikna oldu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080420,
					"content": "Dediğim gibi, bu benim için yalnızca bir ay ışığı hüzmesi. Pek bir önemi yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080421
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080421,
					"content": "Bana elini ver ve kendini hazırla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080422
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080422,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080423
					]
				},
				{
					"id": 60080423,
					"content": "(Önceden gördüğümüzle aynı ama bu sefer daha net...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080424
					]
				},
				{
					"id": 60080424,
					"content": "(En azından güvenli bir şekilde iniş yapmışız...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080425
					]
				},
				{
					"id": 60080425,
					"content": "(...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080426
					]
				},
				{
					"id": 60080426,
					"content": "(Sanırım aradan çok uzun zaman geçti...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080427
					]
				},
				{
					"id": 60080427,
					"content": "#(Hâlâ uzay gemisindeyiz. Ne kadar uzun süre kalmışız... Acaba {M#Lumine}{F#Aether} ne zaman dışarı çıktı?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080428
					]
				},
				{
					"id": 60080428,
					"content": "#(Bir dakika. {M#Lumine mi}{F#Aether mı} o?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080429
					]
				},
				{
					"id": 60080429,
					"content": "(Ama bu nasıl olur? İndiğimizden beri uzay gemisinden kimse çıkmadı... Kapısı bile açılmadı daha!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080430
					]
				},
				{
					"id": 60080430,
					"content": "Burası... Neresi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080431
					]
				},
				{
					"id": 60080431,
					"content": "#{M#Aether}{F#Lumine}! Hadi! Buradan gitmemiz lazım!",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						60080432
					]
				},
				{
					"id": 60080432,
					"content": "Ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080433
					]
				},
				{
					"id": 60080433,
					"content": "H-Hey! İyi misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080434,
					"content": "Uzay gemimiz... İniş yapmamızın üzerinden çok uzun süre geçti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080435
					]
				},
				{
					"id": 60080435,
					"content": "#Gemiden çıkan kimse olmadı ama {M#Lumine}{F#Aether}... Bir şekilde beni uzay gemisinin dışında buldu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080436
					]
				},
				{
					"id": 60080436,
					"content": "Ne? Öyle bir şey nasıl mümkün olabilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080437,
					"content": "Bilmiyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080438
					]
				},
				{
					"id": 60080438,
					"content": "Anılarda saklı olan sırlar kurabiye kırıntılarına benzer. Tek bir ısırık aldığında her yere dağılırlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080439
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080439,
					"content": "(Çok tuhaf şeyler oluyor. İşin aslını öğrenmeliyim.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080440
					]
				},
				{
					"id": 60080440,
					"content": "(Ama Nefer'ın da dediği gibi, Nod-Krai yok olursa geriye araştıracak bir şey kalmaz...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080441
					]
				},
				{
					"id": 60080441,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080442
					]
				},
				{
					"id": 60080442,
					"content": "Karar verdim. Ay İliğini yanımda taşıyacağım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080443
					]
				},
				{
					"id": 60080443,
					"content": "Şey... Madem öyle diyorsun, Paimon sana engel olamaz ama yine de... Iıı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080444
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080444,
					"content": "Yardıma ihtiyacın olacak mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080445
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080445,
					"content": "Ne yardımı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080446
					]
				},
				{
					"id": 60080446,
					"content": "İliği gizlemene yardımcı olabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080447
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080447,
					"content": "Öyle mi? Süper olur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080448
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080448,
					"content": "İçinde olduğunu fark etmek başlı başına kolay bir iş değil. Ama Kuuvahki kullanarak nasıl daha iyi gizleyebileceğni öğretebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080449
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080449,
					"content": "Böyle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080450
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080450,
					"content": "Aaa! Kalkan gibi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080451
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080451,
					"content": "(Ay ışığı gibi... Yumuşak ve nazik...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080452
					]
				},
				{
					"id": 60080452,
					"content": "Hissediyor musun? Şimdi olduğu gibi korumaya çalış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080453
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080453,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080454
					]
				},
				{
					"id": 60080454,
					"content": "Çabuk öğreniyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080455
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080455,
					"content": "Epey sağlam duruyor. Acil durumlarda kendini savunmak için de kullanabilirsin herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080456
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080456,
					"content": "Öğrettiğin için teşekkür ederim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080457
					]
				},
				{
					"id": 60080457,
					"content": "Hep burada mı duruyorsun Columbina? Dışarısı tehlikeli tabii ama yürüyüşe falan çıkmıyor musun hiç?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080458
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080458,
					"content": "... Ben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080459
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080459,
					"content": "... Yabancıları sevmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080460
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080460,
					"content": "Biz de senin için yabancı mı sayılıyoruz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080461
					]
				},
				{
					"id": 60080461,
					"content": "Biraz daha iyisiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080462,
						60080463
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080462,
					"content": "Vahşi Avla meselemiz bittiğinde...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080464
					]
				},
				{
					"id": 60080464,
					"content": "Evet! Donuk Ayın Çocukları sen görmeyeli çok değişti. Belki onları seversin bu sefer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080465
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080465,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080466
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080466,
					"content": "Düşüneceğim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080467
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080467,
					"content": "Yorgun görünüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080468
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080468,
					"content": "Muhtemelen uzun süredir bu kadar çok konuşmamıştır...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080469
					]
				},
				{
					"id": 60080469,
					"content": "Bize yardım etmeyi kabul ettiğin için sağ ol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080470
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080470,
					"content": "... Rica ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080471
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080471,
					"content": "Buradaki çiçekler... Sizin gibi misafirleri seviyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080463,
					"content": "Birlikte yürüyüşe çıkalım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080464
					]
				}
			]
		}
	]
}