			"dialogs": [
				{
					"id": 60080201,
					"content": "Çok iyi görünmüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080202,
					"content": "R-Rahatsız ettiğimiz için kusura bakma ama iyi misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080203,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080204
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080204,
					"content": "Durumun kötüleşti mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080205
					]
				},
				{
					"id": 60080205,
					"content": "... Başım dönüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080206
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080206,
					"content": "... Sanki... Aya dönüyor gibiyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080207
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080207,
					"content": "O kadar mı kötü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080208,
					"content": "Hımm? Sende... Ayın gücünü hissediyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080209
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080209,
					"content": "Ay İliğini Fatui'den geri aldık. Sana bir faydası dokunabilir mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080210
					]
				},
				{
					"id": 60080210,
					"content": "Hımm... Peki bu sefer ne istiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080211
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080211,
					"content": "Onun derdine düşmenin sırası mı? Senin iyileşmene bakman lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080212,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080213
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080213,
					"content": "(Bunca zamandır karşılıklı çıkar ilişkileri yaşadığı için buna alışmış olabilir mi?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080214
					]
				},
				{
					"id": 60080214,
					"content": "Gelecekte yardımına ihtiyacım olabilir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080215
					]
				},
				{
					"id": 60080215,
					"content": "... Ah. Pekala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080216
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080216,
					"content": "Elini ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080217
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080217,
					"content": "*nefes verir* ... Dünyaya döndüm. Teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080218
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080218,
					"content": "Zaten hep buradaydın... Neyse, daha iyi hissediyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080219,
					"content": "Çok daha iyiyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080220,
						60080221
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080220,
					"content": "Ne yaptın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080222
					]
				},
				{
					"id": 60080222,
					"content": "Bedenindeki ay... Suyun üzerindeki bir yansıma kadar sessiz... Muhteşem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080223
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080223,
					"content": "Sadece suya düşen hüzmelerinden bir parça aldım. Şimdilik ayaklarımı yerde tutmaya yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080224
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080224,
					"content": "Başka değişiklikler de hissettim sanırım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080225
					]
				},
				{
					"id": 60080225,
					"content": "Bu \"Ay Tanrıçası'nın Lütfu\". Dokunduğum her şey bu işareti taşır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080226
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080226,
					"content": "Zararsızdır, zamanla yok olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080227
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080227,
					"content": "Hazır konusu açılmışken, artık gücünü toparladığına göre Ay İliğini geri almak ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080228,
					"content": "Sonuçta bunun bir \"tanrıya\" ait olması gerekiyor, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080229,
					"content": "Bunlar Ebedi Ay Tanrıçası Aria'nın kalıntıları.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080230
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080230,
					"content": "Yani gerçekten de... Bir saniye, ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080231,
					"content": "Bilmiyor muydunuz zaten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080232
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080232,
					"content": "Lauma sadece diğer parçalardan farklı olduğunu ve içinde kutsal bir güç sezdiğini söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080233,
					"content": "Dediği doğru. İlikten ay ışığı hüzmesini alırken bazı anıları da çıkardım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080234
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080234,
					"content": "Ebedi Ay Tanrıçası'na ait olduğunu bu sayede biliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080235
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080235,
					"content": "Ama Lauma da Ay İliğini kullanarak geçmişe baktı. O neden görmedi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080236,
					"content": "(Lauma yalnızca kısa ve bulanık parçalar görebildiğini söylemişti. Belki de böyle bir şeyi sadece Ay Tanrıçası sezebiliyordur...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080237
					]
				},
				{
					"id": 60080237,
					"content": "Bir zamanlar gökyüzünde üç ay vardı. Her biri, kendini yöneten tanrıçaya aitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080238
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080238,
					"content": "Ama cenaze alevi savaşından sonra tanrıçaların üçü birden katledildi. Üç aydan ikisi ise savaş esnasında parçalandı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080239
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080239,
					"content": "Aria öldükten sonra gücü bu Ay İliğinin içinde yoğunlaştı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080240
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080240,
					"content": "Hareli Ayın kalıntıları hiçbir zaman bulunamadı. Donuk Ayın tanrıçası ölse de ayı kırılmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080241
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080241,
					"content": "Kehanette anlatıldığı gibi, bu aydan yeni bir tanrı doğacaktı. Donuk Ayın Çocukları bu tanrıya \"Kuu{RUBY#[S]Ay Hanımı}tar\" adını verdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080242
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080242,
					"content": "Gücümün Donuk Aya ait olduğunu hissedebiliyorum. Ama sahte gökyüzünün ötesinde, benden çok uzakta duruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080243
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080243,
					"content": "Bu gücü \"kontrol etmek\" şöyle dursun, \"hissetmek\" bile büyük çaba gerektiriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080244
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080244,
					"content": "B-Bir dakika, Paimon'un tekrar etmesi lazım... Elimizde Ebedi Ayın Ay İliği var, Hareli Ayınki ise bulunamıyor... O zaman Donuk Ayın İliği senin içinde mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080245,
					"content": "Hayır. Ay iliği yalnızca bir ay tanrıçası öldükten sonra oluşabilir. Bir çeşit enerji çekirdeği gibi düşünebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080246
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080246,
					"content": "Ayda taş var mı diye sormak gibi bir şey bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080247
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080247,
					"content": "Haa, yani Donuk Ayın gücünü sen mi temsil ediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080248
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080248,
					"content": "Evet. Gnosisi olan tanrılara Hükümdar deniyor... Ay İliğini sen taşıyorsun, bu seni bir \"Ay Tanrıçası\" mı yapar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080249
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080249,
					"content": "Aynı şey olduğunu sanmıyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080250
					]
				},
				{
					"id": 60080250,
					"content": "Tanrı olmak istemiyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080251
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080251,
					"content": "Sorun o değil ki! Ayrıca neden bu unvanı başkasına paslamaya bu kadar heveslisin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080252
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080252,
					"content": "Neyse, \"Ay Tanrıçası olma\" konusunu bir kenara bırakalım. Ay İliğini sana geri verelim mi diye soruyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080253
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080253,
					"content": "İstemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080254
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080254,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080255
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080255,
					"content": "O da bana gelmek istemiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080256
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080256,
					"content": "Bu ne anlama geliyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080257
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080257,
					"content": "Gücüyle temasa geçtiğimde bir şekilde beni \"reddettiğini\" hissettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080258
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080258,
					"content": "Bunun sebebi benim de Ay Tanrıçası olmamdır diye tahmin ediyorum. İki ay aynı anda doğamayacağı gibi, birbirlerini de yutamazlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080259
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080259,
					"content": "O zaman şimdilik bana kaldı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080260
					]
				},
				{
					"id": 60080260,
					"content": "Sorun çıkarmayacağından emin misin? Lauma gücü saklayabildiğini söylemişti ama Küçük Hanım kolayca hissedebildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080261
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080261,
					"content": "Vahşi av sıradan bir düşman değil sonuçta. İliğin varlığını hissederlerse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080262
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080262,
					"content": "Vahşi Av mı? Bu olgudan sanki bir insanmış gibi bahsediyorsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080263
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080263,
					"content": "Görünüşe göre arkasında kesinlikle bir insan var, çok net bir amaca sahip olduğu da belli. Ay İliğinin peşini bırakmıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080264
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080264,
					"content": "Bu bir yerden tanıdık geliyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080265
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080265,
					"content": "Ne? Gerçekten mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080266
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080266,
					"content": "Fatui ile çalışırken meslektaşlarım birinden bahsederdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080267
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080267,
					"content": "Felaket sırasında Hiçlik gücünü elde eden bir Khaenri'ahlıydı... Aylara olan takıntısı korkunç boyuttaydı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080268
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080268,
					"content": "Khaenri'ah mı? Gördüğümüz hayaletin bununla bir ilgisi olup olmadığını bilmiyoruz ama özellikleri uyuşuyor... Adı neydi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080269
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080269,
					"content": "Tek bildiğim diğerlerinin ondan \"Ay Avcısı\" diye bahsettiği.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080270
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080270,
					"content": "Beş Günahkardan biri mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080271
					]
				},
				{
					"id": 60080271,
					"content": "Doğru, öyle bir unvanı da vardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080272
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080272,
					"content": "Ne? Bir saniye... Dain ondan bahsetmemiş miydi? Düşmanımız Beş Günahkardan biri olan Rerir mi yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080273
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080273,
					"content": "O olsaydı daha güçlü olurdu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080274
					]
				},
				{
					"id": 60080274,
					"content": "Felaketten kısa bir süre sonra ortadan kayboldu diye duymuştum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080275
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080275,
					"content": "Ama meslektaşlarıma nereye gittiğini sorduğumda \"Gerçekten bilmiyor musun?\" dediler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080276
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080276,
					"content": "Neden öyle söylediler ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080277
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080277,
					"content": "Kaderinin sonuyla ilgili anlatılanlara göre geri dönüşü olmayan bir yere, \"ayın yansıması\"nın içine düşmüş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080278
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080278,
					"content": "Dur, bekle, bir saniye... Üst üste çok fazla bilgi verdin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080279
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080279,
					"content": "Ben de zamanında öyle hissetmiştim. Aylar hakkında her şeyi bilmem gerektiğini düşünüyorlardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080280
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080280,
					"content": "Ama dediğim gibi... Benim \"başlangıcım\" sahte gökyüzünün ardında yatıyor. Adımı bile hatırlamıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080281
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080281,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080282
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080282,
					"content": "Her halükarda Vahşi Avın durumu o gittikten sonra büyük ölçüde kötüye gitti ve Hiçlik facialarıyla eş anlamlı hale geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080283
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080283,
					"content": "Günümüzdeki olgu aynı unvanı devralmış olsa da, hem ölçeği hem de ölümcüllüğü açısından emsalini geride bıraktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080284
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 60080284,
					"content": "Of. Uğursuz Beş Günahkardan birine karşı savaştığımızı düşünmek çok garip...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080285
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080285,
					"content": "Bu bizi aşar ki! Yıldızkumu Sahili'nde şansımız yaver gitti herhalde... Gücünün tamamını kullanmamış olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60080286
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080286,
					"content": "Buna rağmen... Kukla'yı yendi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60080221,
					"content": "... Daha doğrusu ben ne yaptım?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60080222
					]
				}
			]
		},
