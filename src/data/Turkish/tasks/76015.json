				},
				{
					"id": 760150208,
					"content": "\"Dans sesleri geldi komşumdan, başladı ayaklarımda bir heyecan, hey!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150209
					],
					"speakerTitle": "Yüksek Sesli Hayalet"
				},
				{
					"id": 760150209,
					"content": "\"Hepinizde bir gülümseme, çalıyorum işte bir beste.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150210
					]
				},
				{
					"id": 760150210,
					"content": "\"Dans ediyoruz hepimiz her yerde!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150211
					],
					"speakerTitle": "Yüksek Sesli Hayalet"
				},
				{
					"id": 760150211,
					"content": "\"Haydi toplanın millet, dans edelim ilelebet!\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150212
					]
				},
				{
					"id": 760150212,
					"content": "Haha! Doğru, işte bu! Çabuk kapıyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150213
					],
					"speakerTitle": "Yüksek Sesli Hayalet"
				},
				{
					"id": 760150213,
					"content": "Adım ███. Tanışmış olduk şimdi. Sandalye senindir, cömert biriyim ne de olsa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150214
					],
					"speakerTitle": "Yüksek Sesli Hayalet"
				},
				{
					"id": 760150214,
					"content": "Sen de mi bir Ratniksin? Merak etme, bu içkin benden. Belki eğitim sırasında birbirimizi yine görürüz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150215,
						760150216
					],
					"speakerTitle": "Yüksek Sesli Hayalet"
				},
				{
					"id": 760150215,
					"content": "Her ne kadar içemesem de sağ ol.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150217
					]
				},
				{
					"id": 760150217,
					"content": "Ben devriyeye çıkıyorum. Görüşürüz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yüksek Sesli Hayalet"
				},
				{
					"id": 760150216,
					"content": "Tanıştığıma memnun oldum efendim. Adım Flins.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150217
					]
				},
				{
					"id": 760150205,
					"content": "Ben burada oturmak istiyorum desem?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150206
					]
				}
			]
		},
