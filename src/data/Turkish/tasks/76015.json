			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yüksek Sesli Hayalet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760150101,
					"content": "Sen kimsin? Burası benim koltuğum, handa herkes bilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150102
					],
					"speakerTitle": "Yüksek Sesli Hayalet"
				},
				{
					"id": 760150102,
					"content": "Adaya yeni falan mı geldin? Başkasının yerini kapamazsın böyle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150103
					],
					"speakerTitle": "Yüksek Sesli Hayalet"
				},
				{
					"id": 760150103,
					"content": "Ayrıca biram nerede kaldı? Acele et, haydi! Birazdan devriyeye çıkacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150104,
						760150105
					],
					"speakerTitle": "Yüksek Sesli Hayalet"
				},
				{
					"id": 760150104,
					"content": "Handa bira mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150106
					]
				},
				{
					"id": 760150106,
					"content": "İyi madem! Ama önce gel bizimle iç ve şarkı söyle. Arkadaş olduğumuzda istediğin yere oturabilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150107
					],
					"speakerTitle": "Yüksek Sesli Hayalet"
				},
				{
					"id": 760150107,
					"content": "Şarkıyı biliyorsun değil mi? Hu hu, hadi! Biz bir satır söyleyeceğiz, sonra sen bir satır söyleyeceksin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150108
					],
					"speakerTitle": "Yüksek Sesli Hayalet"
				},
				{
					"id": 760150108,
					"content": "\"Dans sesleri geldi komşumdan, başladı ayaklarımda bir heyecan, hey!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150109,
						760150110,
						760150111
					],
					"speakerTitle": "Yüksek Sesli Hayalet"
				},
				{
					"id": 760150109,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150112
					]
				},
				{
					"id": 760150112,
					"content": "Hayır, hayır! Şaka mısın sen? Nod-Krai'da herkes bilir bu şarkıyı, hadi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150113
					],
					"speakerTitle": "Yüksek Sesli Hayalet"
				},
				{
					"id": 760150113,
					"content": "Şarkı söyleyip eğlenmezsen buraya uyum sağlayamazsın ha. Vahşi Av geldiğinde de dostu olmayan askerler için işler hiç iyi sonlanmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760150114
					],
					"speakerTitle": "Yüksek Sesli Hayalet"
				},
				{
					"id": 760150114,
					"content": "Hadi git şarkıyı öğren, sonra geri gel, tamam mı? Hop! Bana bir bira daha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yüksek Sesli Hayalet"
				},
				{
					"id": 760150110,
					"content": "\"Dostum Paimon komiktir pek, güldürür beni hep, ho ho ho!\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150112
					]
				},
				{
					"id": 760150111,
					"content": "\"Adadaki hayaletler toplanır sandalyeye, şarkı söyleyip dans ederler her yerde!\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150112
					]
				},
				{
					"id": 760150105,
					"content": "Biraz oturmama müsaade edebilir misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760150106
					]
				}
			]
		},
