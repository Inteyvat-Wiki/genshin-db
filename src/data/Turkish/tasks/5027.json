				"points": []
			},
			"dialogs": [
				{
					"id": 50270101,
					"content": "Vay canına, Hükümdarımız ne kadar muhteşem, ne kadar cesur! Lord Xbalanque ile başa baş mücadele etti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270102
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 50270102,
					"content": "Alçak gönüllülüğü bırak. Sen de olsan aynısını yapardın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270103
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 50270103,
					"content": "Haha, kim olsa yapardı tabii! Ben de bu fırsatı kaçırmazdım! Peki ya sen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270104
					],
					"speakerTitle": "Ajaw"
				},
				{
					"id": 50270104,
					"content": "B-Ben... Cesaret edemezdim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270105
					],
					"speakerTitle": "Kachina"
				},
				{
					"id": 50270105,
					"content": "Savaşmak bir savaşçının doğasında vardır. Fırsat karşına çıksa eminim sen de içgüdülerinle karar verirdin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270106
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 50270106,
					"content": "*iç çeker* Enerjinize diyecek yok doğrusu... Ama en yüce atamız Lord Xbalanque'den bahsediyoruz burada. Büyüklerinizle kapışmaya ne kadar meraklıymışsınız öyle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270107
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 50270107,
					"content": "Citlali Nine! Bir gün seninle de kapışalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270108
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 50270108,
					"content": "Yok hayır, öyle bir şey asla olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				}
			]
		},
		{
			"id": 502702,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"502701",
							"2"
						],
						"stepId": 502701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mausau",
					"Ororon",
					"Iansan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 50270201,
					"content": "Sence benden nasıl bir sebze olurdu? Kırmızı mı yoksa yeşil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270202
					],
					"speakerTitle": "Mausau"
				},
				{
					"id": 50270202,
					"content": "Sen mi? Bence... Senden bir soğan olurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270203
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50270203,
					"content": "Soğan mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270204
					],
					"speakerTitle": "Mausau"
				},
				{
					"id": 50270204,
					"content": "Sıradan görünen ama kendisine saldıran herkesi gözyaşlarına boğan biri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270205
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50270205,
					"content": "Gerçekten mi? Çok güçlüymüş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270206
					],
					"speakerTitle": "Mausau"
				},
				{
					"id": 50270206,
					"content": "Bu ikisi ne konuşuyor böyle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270207
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 50270207,
					"content": "Soğanlar çok güçlüdür. Bir gün bir arkadaşımın evine gittiğimde soğan kesiyordu. Birden ağlamaya başladı, sonra Sürüngenler de ağlamaya başladı derken neredeyse odadaki tüm canlılar ağlıyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270208
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50270208,
					"content": "Peki ya sen? Sen de ağladın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270209
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 50270209,
					"content": "Ben de odadaydım ama son anda pelerinimle gözlerimi kapadım. Cacucu ve Ifa yüzümü göremediklerinden benim de ağladığımı sandılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270210
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50270210,
					"content": "Ben de bir soğan adam olup insanları ağlatmak isterdim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270211
					],
					"speakerTitle": "Mausau"
				},
				{
					"id": 50270211,
					"content": "Tabii ki, hiç sorun değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270212
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50270212,
					"content": "Sözünüzü bölmek istiyorum ama sohbete nereden dahil olacağımı hiç bilemedim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270213
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 50270213,
					"content": "Iansan, sen küçük bir... Mantarsın. Evet, öylesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270214
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50270214,
					"content": "Soran olmadı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270215
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 50270215,
					"content": "Gerçi... Mantarlar epey dayanıklı şeyler sanırım... Tamam, onaylıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270216
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 50270216,
					"content": "O zaman sen de dayanıklı olmalısın, öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270217
					],
					"speakerTitle": "Mausau"
				},
				{
					"id": 50270217,
					"content": "Aynen öyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50270218
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 50270218,
					"content": "Evet... Tabii, neden olmasın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iansan"
				}
			]
		}
	]
}