			"trigger": {
				"objectNames": [
					"Küçük Çam Kozalağı",
					"Alev Bombası Kütüğü Figürü",
					"Vigee"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 755100101,
					"content": "Maskeli Savaşçı, Ara Bulucu gibi uçamasa bile kazanmak için tek yapması gereken saldırılarını doğru zamanlamak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100102
					],
					"speakerTitle": "Küçük Çam Kozalağı"
				},
				{
					"id": 755100102,
					"content": "Aptal! Düz bir çizgide ne kadar hızlı koştuğunun ne önemi var? Dönüp de bir şeye vuramazsa hiçbir anlamı yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100103
					],
					"speakerTitle": "Alev Bombası Kütüğü Figürü"
				},
				{
					"id": 755100103,
					"content": "Yeter artık çocuklar. Medenice konuşabiliriz, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100104
					],
					"speakerTitle": "Vigee"
				},
				{
					"id": 755100104,
					"content": "Medeniyiz ya! Sadece, şey... Konu büyük savaşçılardan açıldığında heyecanlanıyoruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100105
					],
					"speakerTitle": "Alev Bombası Kütüğü Figürü"
				},
				{
					"id": 755100105,
					"content": "Kafaya takmayın Bayan Vigee! Savaşta olduğumuzu biliyoruz ama savaşırken mantık ve kanıtlardan yararlanacağız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100106
					],
					"speakerTitle": "Küçük Çam Kozalağı"
				},
				{
					"id": 755100106,
					"content": "... Aha! Yeni bir strateji geldi aklıma. Sana yeniden meydan okuyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100107
					],
					"speakerTitle": "Alev Bombası Kütüğü Figürü"
				},
				{
					"id": 755100107,
					"content": "Rövanş, rövanş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100108,
						755100109
					],
					"speakerTitle": "Küçük Çam Kozalağı"
				},
				{
					"id": 755100108,
					"content": "Burası gerçekten çok hareketli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100110
					]
				},
				{
					"id": 755100110,
					"content": "Yeni bir müşteri! Merhaba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100111
					],
					"speakerTitle": "Vigee"
				},
				{
					"id": 755100111,
					"content": "Kıyafetlerine bakılırsa seyahat eden birisin, değil mi? Ortak bir yanımız çıktı bak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100112
					],
					"speakerTitle": "Vigee"
				},
				{
					"id": 755100112,
					"content": "Çocuklarla beraber yaptığım bu etkileşimli dokuma parşömeni denemek ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100113,
						755100114
					],
					"speakerTitle": "Vigee"
				},
				{
					"id": 755100113,
					"content": "\"Etkileşimli dokuma parşömen\" mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100115
					]
				},
				{
					"id": 755100115,
					"content": "Liyue'nin gölge oyunlarını, Inazuma'nın çizgi romanlarını ve Fontaine'in film teknolojisini bir araya getiren bir oyun bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100116
					],
					"speakerTitle": "Vigee"
				},
				{
					"id": 755100116,
					"content": "Bizim yerel kahramanlarımızdan ilham alarak \"sınır ötesi mücadele\" konseptinde yeni bir hikaye oluşturmayı amaçlıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100117
					],
					"speakerTitle": "Vigee"
				},
				{
					"id": 755100117,
					"content": "Bir dene! Kim bilir, belki senin için de yepyeni bir tecrübe olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100118
					],
					"speakerTitle": "Vigee"
				},
				{
					"id": 755100118,
					"content": "Memnuniyetle!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100119
					]
				},
				{
					"id": 755100119,
					"content": "Harika! İyi eğlenceler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vigee"
				},
				{
					"id": 755100114,
					"content": "Kendi kendine hareket eden bir parşömen mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100115
					]
				},
				{
					"id": 755100109,
					"content": "Neler oluyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100110
					]
				}
			]
		},
