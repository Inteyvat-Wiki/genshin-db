			"dialogs": [
				{
					"id": 191170106,
					"content": "Hav! Hav! *hırlar*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170107
					],
					"speakerTitle": "Ninken"
				},
				{
					"id": 191170107,
					"content": "Ne kadar vahşi bir köpeksin, neredeyse beni yine ısırıyordun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170108
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170108,
					"content": "Çok zayıflamışsın... Biraz yemek ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170109
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170109,
					"content": "Bizimle geri dönmene gerek yok ama şimdi yemek zamanı. Bir köpeğin yemesi lazım, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170110
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170110,
					"content": "Zehirli olduğunu düşünmüyorsun, değil mi? Bak, ilk lokmayı ben alıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170121
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170121,
					"content": "Gördün mü? Lezzetli ve içinde zehir yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170111,
						191170112
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170111,
					"content": "Thoma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191170113
					]
				},
				{
					"id": 191170113,
					"content": "Hadi ama, sadece bir ısırık. Küçük, minik bir ısırık, sonra seni rahat bırakacağım, nasıl fikir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170114
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170114,
					"content": "Hav! Hav, hav!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170115
					],
					"speakerTitle": "Ninken"
				},
				{
					"id": 191170115,
					"content": "Getirdiğimiz yemeği ağzına bile sürmedi, pek ilgilenmiyor gibi görünüyor. Bana mı öyle geliyor yoksa biraz gergin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170116
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170116,
					"content": "Belki denizde bir şey vardır... Ya da yakınlarda onu tedirgin eden bir şey olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170117
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170117,
					"content": "Şuradaki canavarlardan kaynaklanıyor bence.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191170118
					]
				},
				{
					"id": 191170118,
					"content": "Cavanarların saldırmış olma ihtimali yüksek diyorsun. Hımm, bu mümkün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170119
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170119,
					"content": "İnsanlar tehlikeli durumlarda iştahlarını kaybetme eğilimindedirler. Belki köpekler için de durum aynıdır. Buradaki köpek dostumuz için etraftaki canavarların icabına bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191170120
					],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170120,
					"content": "#Yardımın için teşekkürler. Sayende buralar sakinleşecek {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Thoma"
				},
				{
					"id": 191170112,
					"content": "Bunun için fazla zahmete giriyorsun...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191170113
					]
				}
			]
		}
	]
