			"dialogs": [
				{
					"id": 752150301,
					"content": "Yeni eleman bulmak mesele değil. Asıl zorluk, bir süre sonra çoğu izin almak için bahaneler uydurmaya başladığında veya tamamen gelmeyi bıraktığında başlıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150302
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150302,
					"content": "Koç, öğrencilerin motivasyonunu yüksek tutmak için bir sürü fikir buldu, o blok mücadelesi de bunlardan biri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150303
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150303,
					"content": "Ama sonunda, bazıları o bloka abanarak puanlarını artırmaya çalıştı ve bu yüzden her tarafları mosmor oldu. Haliyle, izin almak isteyenlerin sayısı da arttı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kerih"
				}
			]
		},
