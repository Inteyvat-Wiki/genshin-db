			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kerih"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752150201,
					"content": "Ciddi olamazsın! O blokun köşesini mi kopardın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150202
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150202,
					"content": "Bunu en son Varesa başarmıştı... Anlaşılan sende de aynı yetenek var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150203,
						752150204
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150203,
					"content": "Biraz uğraştırdı, ne yalan söyleyeyim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752150205
					]
				},
				{
					"id": 752150205,
					"content": "Demek ki görünüşe aldanmamak lazım. Biliyor musun, eğer kabul edersen seni burada koç olarak işe alabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150206
					],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150206,
					"content": "Bu arada, şu \"Meyve Bolluğundan\" dene biraz. Bizim öğrenciler arasında çok popüler, atletik performansını artırabiliyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kerih"
				},
				{
					"id": 752150204,
					"content": "Hehe, çocuk oyuncağıydı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752150205
					]
				}
			]
		},
		{
