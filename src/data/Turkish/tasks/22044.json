			"dialogs": [
				{
					"id": 220440101,
					"content": "Gezgin, hoş geldin! Saygılarını sunmaya mı geldin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440102
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440102,
					"content": "Oymacılık işlerin nasıl gidiyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220440103
					]
				},
				{
					"id": 220440103,
					"content": "Ah, işler tıkırında. Tabii oymaların ebatlarını düzeltmem gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440104
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440104,
					"content": "İlk yaptığım hesaplamalara göre oymaların en azından avuç içine rahatça sığması gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440105
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440105,
					"content": "Böylece birisi eline aldığında rahatça oynayabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440106
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440106,
					"content": "Bunun yanı sıra oymalar yerine bazı süslemelere odaklanmam gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440107
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440107,
					"content": "Oymacılıkla uğraşanları incelediğim zaman kenarlarına küçük aksesuarlar yerleştirdiklerini gördüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440108
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440108,
					"content": "Çiçekler, hayvanlar... Çiçek desenli yüzeyler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440109
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440109,
					"content": "Ben de kütük oymalarımda böyle şeyler olsun istiyorum. Tabii ebatlarından dolayı her bir oymaya yalnızca bir adet süs eşyası yerleştirebilirim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440110
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440110,
					"content": "Bu sebeple süslemeleri çıkartılabilir olarak tasarlamak istiyorum, böylelikle müşterinin isteğine göre farklı süslemeler yerleştirebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440111
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440111,
					"content": "Gözyaşı Otu gibi basit bir süs ile başlarım muhtemelen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440112
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440112,
					"content": "Çalışma yapabilmem için bana 3 sap Gözyaşı Otu toplayabilir misin Gezgin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440113,
						220440114
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440113,
					"content": "Bana güvenebilirsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220440117
					]
				},
				{
					"id": 220440117,
					"content": "Ne yazık ki bu işi sana bırakmak zorundayım Gezgin. Gözyaşı Otlarını topladığında lütfen gelip beni bul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440114,
					"content": "Niye üç tane?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220440115
					]
				},
				{
					"id": 220440115,
					"content": "Üç tane olursa onların üç farklı halini de gözlemleyebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440116
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 220440116,
					"content": "Böylelikle Gözyaşı Otu desenini en iyi şekilde oyabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440117
					],
					"speakerTitle": "Ooshima Junpei"
				}
			]
		},
