			"dialogs": [
				{
					"id": 401960101,
					"content": "Selam millet! Çok geç kalmadık, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960102,
					"content": "Yok, tam zamanında geldiniz. İyi dinlenebildiniz mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960103
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 401960103,
					"content": "İşleyen demir ışıldarmış.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960104
					]
				},
				{
					"id": 401960104,
					"content": "Sürekli enerjik kalabilmek için harika bir yol gerçekten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960105
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960105,
					"content": "Hepiniz hazırlıklara başladınız mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960106
					]
				},
				{
					"id": 401960106,
					"content": "Dün Bay Argenteau'dan haber geldi, alışverişin yerini ve zamanını öğrendik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960107
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960107,
					"content": "Bugün öğleden sonra gerçekleşecek. Meğer hepimizin çok iyi bildiği Fantastik Film Diyarının restoranında olacakmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960108
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960108,
					"content": "Sahiden mi? O yere bir takıntısı var belli ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960109,
					"content": "İyi de...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960110
					]
				},
				{
					"id": 401960110,
					"content": "#Sen de bizim gibi düşünüyorsun sanırım {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960111
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960111,
					"content": "Evet. Birini kalabalık bir etkinlik alanında yakalamak, açık bir alanda yakalamaktan çok daha zor olacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960112
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 401960112,
					"content": "Suçlu, kalabalığın içine karışmaya, hatta insanları rehin alarak kaçmaya çalışabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960113
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 401960113,
					"content": "Bu nedenle ek önlemler almak durumunda kaldık. Dün haberi alır almaz Gölge Mareşosesi ve Özel Güvenlik ve Teftiş Devriyesi ile birlikte çalışmalara başladık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960114
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 401960114,
					"content": "Evet. Oraya çok sayıda gizli ajan göndereceğiz. Olaylar beklediğimiz gibi gitmezse önceliğimiz vatandaşların güvenliği olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960115
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960115,
					"content": "Tabii her şeyin sorunsuz ilerlemesini umuyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960116
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960116,
					"content": "Önceki vakadan aşina olduğum pek çok sima da var, mesela Özel Devriyeden Yüzbaşı Chevreuse gibi. O yüzden bayağı iyimserim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960117
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960117,
					"content": "İçgüdülerine güveniyoruz o halde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960118
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960118,
					"content": "Bu arada Bayan Lepine-Pauline ve Bayan Navia ile de iletişim halindeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960119
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960119,
					"content": "Spina di Rosula da kontrollü bir şekilde destek sağlayacak. O nedenle endişe edecek bir durum yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960120
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 401960120,
					"content": "Bir ihtimal... Bayan Escoffier ile alakalı bir sorun yaşanabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960121,
						401960123
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960121,
					"content": "Suçlulara hizmet etmek istemiyor mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960122
					]
				},
				{
					"id": 401960123,
					"content": "Onları kesme tahtasına mı yatırmak istiyor yoksa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960124
					]
				},
				{
					"id": 401960122,
					"content": "Haha, keşke o kadar basit olsaydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960125
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960124,
					"content": "Bak bu hiç fena fikir değil aslında...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960125
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960125,
					"content": "Öhöm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960126
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 401960126,
					"content": "Pekala, şakayı bir kenara bırakalım. Bayan Escoffier, restoranının bu operasyon yüzünden herhangi bir zarara uğramamasını istiyor. Bu konuda gayet net konuştu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960127
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960127,
					"content": "Haha... Korkarım işler onun umduğu gibi ilerlemeyebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960128
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960128,
					"content": "Benim yapabileceğim bir şey var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960129
					]
				},
				{
					"id": 401960129,
					"content": "Açıkçası, bu işe zaten gereğinden fazla dahil oldun. Seni en başından bu işe karıştırmamalıydık. Bundan sonrasını Fontaine yetkilileri halledebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960130
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960130,
					"content": "Ama yine de durumun nasıl sonuçlanacağını görmek istersin diye düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960131
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960131,
					"content": "Kesinlikle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960132
					]
				},
				{
					"id": 401960132,
					"content": "Peki öyleyse. Olay yerine gidebilirsin ama dikkatli ol ve duruma uygun hareket et. İşler ters gitmediği sürece bir şey yapmana gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960133
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960133,
					"content": "İşlerin o raddeye gelmemesi için elimden geleni yapacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960134
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960134,
					"content": "Sen de mi dahil olacaksın Kinich?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960135
					]
				},
				{
					"id": 401960135,
					"content": "Tabii ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960136
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960136,
					"content": "Hâlâ cevaplanmamış birçok soru var ama elimizdeki bilgiler, zanlının Natlanlı olduğuna işaret ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960137
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960137,
					"content": "Ayrıca ben davanın tanıklarından biriyim. Bu işin nereye varacağını görmek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960138
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960138,
					"content": "Hehe, Kinich yine şaşırtmadı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960139,
					"content": "Grup, operasyonun ayrıntılarını ve dikkat edilmesi gerekenleri konuşur.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401960140
					]
				},
				{
					"id": 401960142,
					"content": "Neyse, hoşbeşi bırakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960143
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960143,
					"content": "Operasyon öğleden sonra gerçekleşecek. Yeterince hızlı hareket edersek gitmeden evvel birkaç fincan çay içebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960144
					],
					"speakerTitle": "Wriothesley"
				},
				{
					"id": 401960144,
					"content": "O zaman bir şeyler yesek iyi olacak! Aç karnına iş yapılmaz sonuçta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960145,
					"content": "İyi de sen izleyeceksin sadece...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401960146
					]
				},
				{
					"id": 401960146,
					"content": "Paimon sana destek olacak sonuçta, o da önemli bir iş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401960147,
					"content": "Pekala, ben önden festival alanına gidiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960148
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960148,
					"content": "Ajaw etkinliğin özel yemeklerini denemek için günlerdir dırdır ediyor. Çenesini bir an önce kapatsam iyi olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960149
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960149,
					"content": "Birazdan görüşürüz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401960150
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 401960150,
					"content": "Durumun nasıl sonuçlandığını anlatırsınız o halde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neuvillette"
				}
			]
		},
