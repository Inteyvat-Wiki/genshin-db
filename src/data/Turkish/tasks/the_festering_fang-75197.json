			},
			"dialogs": [
				{
					"id": 751970102,
					"content": "Hah, ben de uğramanı bekliyordum. Evet, şu Ejder Dişleri... Aa, toplamışsın bile zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970103
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970103,
					"content": "Siz keşifteyken ben de ufak bir sorunla karşılaştım... Bu Ejder Dişine neyle vurursam vurayım ufacık bir parçasını bile yontamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970104
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970104,
					"content": "Daha önce hiç böyle bir şey görmedim, bu yüzden bu malzemelerin nasıl işlendiğini öğrenmek için Albedo'yla konuşmaya birini gönderdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970105
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970105,
					"content": "Ve Bay Albedo da Bayan Sucrose ile şuradaki Run Taşını gönderdi. Simyager Tezgahının üzerinde duruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970106
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970106,
					"content": "Run Taşı mı? Ejder Dişiyle ne ilgisi var ki bunun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751970107,
					"content": "Bayan Sucrose'un Bay Albedo'dan aktardığı bilgilere göre, silah yapabilmek için malzemeyi bir tür özel işlemden geçirmemiz gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970108
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970108,
					"content": "Bunlardan bir tanesi, bir Ejder Dişinin ejderha \"canlılığı\" emmesini sağlayarak diğer Ejder Dişlerini de düzeltmek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970109
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970109,
					"content": "Bayan Sucrose, Run Taşıyla ilgili şunları söyledi: \"Bu taş, bin yıl önce Mondstadt'ın eski aristokrasiye karşı başlattığı ayaklanmada Favonius Şövalyelerine yardım eden gezgin bir kumpanyanın bıraktığı bir yadigar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970110
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970110,
					"content": "Kumpanyanın flütçüsü Mare Jivari'de \"Bakunawa\" adlı bir canavarla savaşmış. Bu Run Taşı onun bedeninden kazınarak çıkarılmış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970111
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970111,
					"content": "Bir dakika, Paimon yanlış hatırlamıyorsa Citlali bize Mare Jivari'nin 500 yıl önce Sanhaj'ın Hiçlik ile savaşı sırasında oluştuğunu söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751970112,
					"content": "Kumpanyanın hikayesinin bin yıl önceye dayandığından emin miyiz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751970113
					]
				},
				{
					"id": 751970113,
					"content": "Haha, nasıl yanlış olabilir ki? Göçebe kumpanyanın kahramanlık hikayesi o zamandan beri \"Krallar ve Klanlar Tarihi\"nde kayıtlı duruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970114
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970114,
					"content": "Her neyse. Bay Albedo, bu Run Taşının tıpkı Ejderhalar gibi \"sonsuz canlılığa\" sahip olduğunu söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970115
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970115,
					"content": "Tek yapman gereken, Simya Tezgahını kullanarak Ejder Dişiyle Run Taşının canlılığını emmek. Sonra da silahımızı dövmeye geçebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970116
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970116,
					"content": "Gerçekten çok etkileyici... Albedo'dan da bu beklenirdi zaten...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970117,
						751970119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751970117,
					"content": "Daha sonra ona teşekkür etmemiz gerekecek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751970118
					]
				},
				{
					"id": 751970118,
					"content": "#Evet! O olmasaydı tamamen çaresiz kalırdık... Her neyse {NICKNAME}, hadi Run Taşının gücünü emmeyi deneyelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751970120,
					"content": "Haha, harika! O zaman al Ejder Dişini bakalım, bu iş sende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970121
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970121,
					"content": "Simya gerçekten de mucizevi bir şey... Binlerce yıllık bir taşın \"canlılığını\" nasıl emebilirsin ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970119,
					"content": "Tamamdır, hallederim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751970120
					]
				}
			]
		},
