			},
			"dialogs": [
				{
					"id": 751970505,
					"content": "Orban silahı dövmeye başlar...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						751970501
					]
				},
				{
					"id": 751970501,
					"content": "İşte! Silah tamam! Haha, tutsana. Hissiyatı nasıl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970502
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970502,
					"content": "Borcum nedir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751970503
					]
				},
				{
					"id": 751970503,
					"content": "Borç falan yok, bu malzemeyle çalışabilmek çok nadir yakalanabilecek bir fırsattı. İşe Mora karıştırmanın lüzumu yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970504
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970504,
					"content": "Tamamdır. Bence bu silah maceraya hazır, sen ne dersin? Umarım ona iyi bakarsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orban"
				}
			]
		},
