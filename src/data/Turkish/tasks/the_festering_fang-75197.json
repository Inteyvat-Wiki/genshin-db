					"nextDialogs": [
						751970403
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970403,
					"content": "Hahaha! Simyanın böyle mucizeler yaratabileceğini bilmiyordum. Bay Albedo'dan da bu beklenirdi zaten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751970404
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 751970404,
					"content": "Yardımın için teşekkürler. Simya sanatından hiç anlamam doğrusu. Pekala, artık tüm malzemelere sahibiz. Bana biraz zaman verin, hemen şu silahı yapayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orban"
				}
			]
		},
