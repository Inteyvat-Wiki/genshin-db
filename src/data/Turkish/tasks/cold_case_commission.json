			"dialogs": [
				{
					"id": 80190401,
					"content": "Misafirlerimiz mi var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190402
					],
					"speakerTitle": "Amadhiah"
				},
				{
					"id": 80190402,
					"content": "Merhaba Amadhiah Dede! Şu kaybolan çocuğu bulmaya geldik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190403,
					"content": "Ha, ondan geldiniz demek! Bunca yolu sırf bizim için gelmişsiniz... Çok düşüncelisiniz. O genç adama yardım edebileceğinize inanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190404
					],
					"speakerTitle": "Amadhiah"
				},
				{
					"id": 80190404,
					"content": "Bize ondan bahsedebilir misin biraz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190405,
					"content": "Tabii! Elimden geldiğince yardım etmek isterim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190406
					],
					"speakerTitle": "Amadhiah"
				},
				{
					"id": 80190406,
					"content": "Gözlerim artık iyi görmüyor, o yüzden tipini anlatamam maalesef. Ama sesini duyduğumu hatırlıyorum... Yakın zamanda değil tabii. Artık duyamadığım için bir boşluk var içimde sanki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190407
					],
					"speakerTitle": "Amadhiah"
				},
				{
					"id": 80190407,
					"content": "Anne babası köyde yaşamıyor sanırsam. Ama hiç de yalnız durmuyordu. Hatta genelde başkalarına eşlik etmeyi teklif ederdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190408
					],
					"speakerTitle": "Amadhiah"
				},
				{
					"id": 80190408,
					"content": "Sık sık zaman ayırıp yaşlıları ziyaret eder veya yetimlerle vakit geçirip oynardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190409
					],
					"speakerTitle": "Amadhiah"
				},
				{
					"id": 80190409,
					"content": "Aklını kurcalayan bir sorun mu var, hemen gelip dinlerdi. Ne diyeceğini de çok iyi bilirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190410
					],
					"speakerTitle": "Amadhiah"
				},
				{
					"id": 80190410,
					"content": "Köyün reisi olarak ona minnet borçluyum. Köy sakinlerine zor zamanlarında yol göstermek benim işim aslında ama genelde o ilgilendi hep bunlarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190411
					],
					"speakerTitle": "Amadhiah"
				},
				{
					"id": 80190411,
					"content": "Vay be, çok düşünceli ve kibar birine benziyor! Kaybının sizi niye bu kadar etkilediği anlaşılıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190412,
					"content": "Ama şey... Adını, adresini ya da ailesini biliyor musun acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190413,
					"content": "*iç çeker* Bunu söylemeye utanıyorum ama... Hatırlayamıyorum. Hani bu bilgileri biliyor olmam lazım ama ne kadar hatırlamaya çalışırsam çalışayım aklıma gelmiyor. Belki gerçekten yaşımdan dolayıdır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190414
					],
					"speakerTitle": "Amadhiah"
				},
				{
					"id": 80190414,
					"content": "Hı... Sorun değil! Hatırlamak için zorlama kendini. Biz bir çözüm buluruz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190415,
					"content": "#Sen ne dersin {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190416,
						80190417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190416,
					"content": "Bu olayda göründüğünden fazlası var kesin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190418
					]
				},
				{
					"id": 80190418,
					"content": "Paimon da öyle düşünüyor! İsim olayı mesela... Kimsenin hatırlayamaması çok garip.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190419,
					"content": "Ailesine veya nerede yaşadığına dair bir şey söyleyebilen de çıkmadı... Sanki gerçeklikten silinmiş gitmiş çocuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190420,
						80190421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190420,
					"content": "Bana kalırsa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190422
					]
				},
				{
					"id": 80190422,
					"content": "Bir dakika... Yani \"silinmemiş\" de en başından beri aslında hiç var olmamış mı diyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190423,
					"content": "Peki, Paimon'un bunu biraz sindirmesi lazım... Sadece insanların anılarında var olan biri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190424,
					"content": "(Mahadevi Rukkhadevata'daki gibi olmuş olabilir mi? İnsanların hafızaları topluca değiştirilmiş mi burada da?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190425
					]
				},
				{
					"id": 80190425,
					"content": "Siz yeni gelen maceracılarsınız, değil mi? Vimara Köyü görevi için mi geldiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190426
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190426,
					"content": "Aynen öyle! Daha yeni başladık araştırmaya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190427,
					"content": "Duyduğuma çok sevindim! İyi ki vazgeçmemişsiniz. Maceracılar Loncası görev ilanımızı iptal eder diye korkuyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190428
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190428,
					"content": "Adım Atossa bu arada. Vimara Köyü'nde büyüdüm. Neyse, diyeceğim şu ki... Kayıp köylümüzü aramaya devam edin lütfen. Yalvarırım. Onu bulmanız lazım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190429,
						80190430
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190429,
					"content": "Buluruz, merak etme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190431
					]
				},
				{
					"id": 80190431,
					"content": "Evet, merak etme hiç! Ne yapmamız gerekiyorsa yapacağız! Sen kayıp kişiyle yakın mıydın? Bize yardımcı olabilecek bir şeyler biliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190432,
					"content": "Hımm... Yardımcı olur mu bilmiyorum ama gelin benimle. Size göstermek istediğim bir yer var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190430,
					"content": "Elimizden geleni yapacağız.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190431
					]
				},
				{
					"id": 80190421,
					"content": "Yalnızca insanların anılarında yaşayan birine benziyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190422
					]
				},
				{
					"id": 80190417,
					"content": "Mantıklı olmayan noktalar var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190418
					]
				}
			]
		},
