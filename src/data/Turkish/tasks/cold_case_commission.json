			"dialogs": [
				{
					"id": 80190301,
					"content": "Merhaba! Bir şey mi alacaktınız? Bu civarlarda iş yapıyorum da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190302
					],
					"speakerTitle": "Bahram"
				},
				{
					"id": 80190302,
					"content": "Ha, yok yok. Maceracıyız biz! Bizi Katheryne gönderdi, Vimara Köyü'nde bir görev varmış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190303,
					"content": "Ha, onun için geldiniz demek... *iç çeker* Sizden önce gelenler de olmuştu. Çok zahmet verdik hepinize.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190304
					],
					"speakerTitle": "Bahram"
				},
				{
					"id": 80190304,
					"content": "Açık konuşayım, pek umutlu değiliz. Bir sürü maceracı kalktı geldi, hepsi de kendine güveniyordu ama sonra elleri boş döndüler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190305
					],
					"speakerTitle": "Bahram"
				},
				{
					"id": 80190305,
					"content": "Cevaplamadığımız soru kalmadı, köyün çevresinde de ipucu bulmak için bakılmadık yer kalmadı. Ama yine de kimse bir ilerleme katedemedi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190306
					],
					"speakerTitle": "Bahram"
				},
				{
					"id": 80190306,
					"content": "Peki bu aradığımız kişi... Adı nedir? Nerede yaşıyordu? Akrabası var mıdır?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190307,
					"content": "Bilmiyorum. Bir fikrim yok. Bir şey diyemem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190308
					],
					"speakerTitle": "Bahram"
				},
				{
					"id": 80190308,
					"content": "Pekiii... Sorulardan gerçekten bıkmışsın galiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190309,
					"content": "Ha... Kusura bakmayın. Size bozulmuşum gibi oldu herhalde. Sorularınızı cevaplıyordum aslında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190310,
						80190311
					],
					"speakerTitle": "Bahram"
				},
				{
					"id": 80190310,
					"content": "Yani üç sorunun da cevabı yok...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190312
					]
				},
				{
					"id": 80190312,
					"content": "Paylaşabileceğimiz pek bir bilgi yok gibi duruyor biliyorum ama şunu söyleyebilirim ki hepimiz onu çok sever sayarız. Biriyle aynı köyde yaşadığınızda birlikte çok anınız oluyor, anlatabiliyor muyum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190313
					],
					"speakerTitle": "Bahram"
				},
				{
					"id": 80190313,
					"content": "Detaylara hakim değiliz sadece. Belki bir zamanlar hakimdik ama o bilgiler çoktan uçtu gitti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190314
					],
					"speakerTitle": "Bahram"
				},
				{
					"id": 80190314,
					"content": "Köydeki herkes böyle düşünüyor en azından. Hepimiz bildiklerimizi aramızda paylaştık, en mantıklı çıkarım bu oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190315
					],
					"speakerTitle": "Bahram"
				},
				{
					"id": 80190315,
					"content": "Peki, detayları bırakalım şimdilik o zaman... Nasıl biriydi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190316,
					"content": "Genç bir çocuktu, yirmili yaşların başında olsa gerek. Çok kibardı, hep ihtiyacı olana yardım eli uzatırdı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190317
					],
					"speakerTitle": "Bahram"
				},
				{
					"id": 80190317,
					"content": "Müşterim olmadığında sohbet ederdik. Başkaları için kaç defa kendini tehlikeye attığını görmüşlüğüm var, haha... Çok ilginç bir çocuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190318
					],
					"speakerTitle": "Bahram"
				},
				{
					"id": 80190318,
					"content": "Ondan bahsetmeye başlayınca deminki ümitsizliğin gitti sanki. Galiba senin üzerinde olumlu bir izlenim bırakmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190319,
					"content": "E tabii ki! Köydeki herkes çok severdi onu. Yoksa görev ilanı vermezdik zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190320
					],
					"speakerTitle": "Bahram"
				},
				{
					"id": 80190320,
					"content": "Artık onun gibi içten, temiz kalpli gençlerin sayısı azaldı. Birden kaybolması garip... Umarım başına bir şey gelmemiştir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190321
					],
					"speakerTitle": "Bahram"
				},
				{
					"id": 80190321,
					"content": "Acaba... Kimseye haber vermeden taşınmış olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190322,
					"content": "Yok. Veda etmeden gidecek biri değil. Hem ayrıca taşınacak olsa köyden kimse mi görmezdi? Öyle bir şeyi başaramazdı bence...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190323
					],
					"speakerTitle": "Bahram"
				},
				{
					"id": 80190323,
					"content": "Hım... Peki. Bilgiler için sağ ol! Biz bir başkalarıyla da konuşalım bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190311,
					"content": "Bize söyleyebileceğin başka bir şey var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190312
					]
				}
			]
		},
		{
			"id": 801904,
