			"dialogs": [
				{
					"id": 80190701,
					"content": "Çok sağ olun! Canavarların çıkagelmesini beklemiyordum hiç. Siz olmasanız ne yapardım bilmiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190702
