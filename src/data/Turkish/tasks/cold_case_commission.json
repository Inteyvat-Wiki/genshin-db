			"dialogs": [
				{
					"id": 80190101,
					"content": "Hah, süper! Sizi gördüğüm iyi oldu. Tam sizlik bir görev geldi. Hatta bu görevi sizin dışınızda kimse yapamaz desem yeridir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80190102,
					"content": "Bizden başka kimse yapamaz demek? Hım, yardımımız bu kadar önemliyse Hükümdar sınıfı bir görev olsa gerek, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190103,
						80190104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190103,
					"content": "Öyle bir sınıflandırma duymadım ben hiç.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190105
					]
				},
				{
					"id": 80190105,
					"content": "Hehe... Maceracılar Loncası öyle bir sınıflandırma sistemi kullanmıyor. Hatta bu görev muhtemelen beklediğiniz kadar zorlu değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80190106,
					"content": "Görevde sadece kayıp bir kişinin bulunması isteniyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80190107,
					"content": "Hı... O zaman neden bu işi bizden başkası yapamaz dedin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190108,
					"content": "Tamamlanmamış eski ilanlara göz atarken denk geldim bu göreve.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80190109,
					"content": "İlk başta basit gibi geliyor ama kayıtlarımıza bakılırsa bu görev en az on defa denenmiş, her seferinde de başarısız olmuş. Üstelik başarılı ve meşhur maceracılar da denemiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80190110,
					"content": "Maceracılar Loncasının itibarı ve Sumeru şubemizin performansı tehlikede olduğu için bu özel görevi son yıllardaki en yüksek görev başarı oranına sahip maceracıya atamak mantıklı olur dedik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190111
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80190111,
					"content": "... O da biziz işte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190112,
						80190113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190112,
					"content": "İki iltifata hemen tav oluyorsun Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190114
					]
				},
				{
					"id": 80190114,
					"content": "Hehe... Elinizden geleni yapsanız yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190115
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80190115,
					"content": "Sizin de boyunuzu aşarsa o zaman ilanı veren kişiden görevi iptal etmesini isteyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190116
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80190116,
					"content": "Peki, kimi arıyoruz ve neden bu görevi tamamlaması bu kadar zor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190117,
					"content": "Görev ilanını Vimara Köyü sakinleri ortaklaşa verdi. Köylülerden birinin kaybolduğunu söylediler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190118
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80190118,
					"content": "Ama sorun şu ki... Kaybolan kişinin adını bilmiyorlar. Yalnızca dış görünüşü hakkında bilgi verebiliyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190119
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80190119,
					"content": "Iıı... Aynı köyde yaşıyorlar ama adını bilmiyorlar mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190120,
					"content": "Hımm, bu görevi hiçbir maceracı tamamlayamadıysa \"kayıp köylü\" diye biri yoktur belki? Hani... Eşek şakası falan olamaz mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190121,
					"content": "Sanmam. Görevi vermek için birkaç köy sakini beraber geldi. Görünüşleri ve seslerine bakılırsa oldukça samimi duruyorlardı açıkçası. Şaka yapıyorlarmış gibi bir halleri yoktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190122
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80190122,
					"content": "Üstelik görev ilanı vermek için işlem ücreti ödemek gerekiyor. Yapması Mora gerektiren bir eşek şakası pek mantıklı olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190123
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80190123,
					"content": "Doğru, saçma olurdu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190124
					]
				},
				{
					"id": 80190124,
					"content": "Her halükarda en iyisi Vimara Köyü'ne gidip bir soruşturun. Maceracılar Loncasının öğrendiği bazı bilgiler var ama bence doğrudan köylülerle konuşursanız daha güvenilir bilgiler edinirsiniz. Yanlış yönlendirilmemek için bilginin kaynağına gitmek lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190125
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 80190125,
					"content": "Tamam, gidelim o zaman! Paimon bu olayı çok merak etmeye başladı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190113,
					"content": "Ama ben bu görevi tamamlayabileceğimizin garantisini veremem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190114
					]
				},
				{
					"id": 80190104,
					"content": "Ama olur tabii, hallederiz. Hangi Hükümdara yardım gerekiyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190105
					]
				}
			]
		},
