					"speakerTitle": "Atossa"
				},
				{
					"id": 80190702,
					"content": "Lafı bile olmaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190703,
						80190704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190703,
					"content": "Asıl şu an sormamız gereken soru şu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190705
					]
				},
				{
					"id": 80190705,
					"content": "Hımm, aslında şimdi düşününce son zamanlarda Vimara Köyü civarındaki Dağ Yabanileri çok aktif...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190706
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190706,
					"content": "Sinirli görünüyorlar, gözlerine ne kestirirlerse saldırıyorlar. Amadhiah Reis artık çocukların köyün dışında oynamasına izin vermiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190707
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190707,
					"content": "Hım... Belki de bu işin arkasında gerçekten Hiçlik Tarikatı vardır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190708,
					"content": "Ne olur ne olmaz Vimara Köyü'ne dönüp etrafı kolaçan edelim. Hiçlik Tarikatı bir şeyler planlıyorsa köylülerin başı dertte olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190704,
					"content": "Hiçlik Tarikatının burada ne işi var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190705
					]
				}
