			},
			"dialogs": [
				{
					"id": 80190501,
					"content": "Burası mı? Bu ağacın altı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190502,
					"content": "Evet. Çok olaysız duruyor biliyorum ama burası benim için çok anlamlı bir yer. Hatıralarla dolu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190503
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190503,
					"content": "Hep bu ağacın altında oturup sohbet ederdik. Bazen gökyüzündeki bulutlara bakardık, bazen de tenimizi okşayan rüzgarı hissederdik. Saatlerce otururduk bazen, zamanın nasıl geçtiğini asla anlamazdık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190504
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190504,
					"content": "Beni Vimara Köyü'ndekiler evlat edindi. Orman Muhafızları beni ormanda bulmuş küçükken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190505
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190505,
					"content": "Çok iyi insanlar oldu etrafımda hep. Köyde büyümek de çok zevkliydi. Ama... Bazen kendimi çok yalnız hissettiğim zamanlar olurdu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190506
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190506,
					"content": "Yalnız mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190507,
					"content": "*iç çeker* Nasıl desem ki? Canını sıkan bir durum ya da paylaşmak istediğin bir haber olduğunda birine anlatmak istersin ya hani... Ben çok uzun bir süre boyunca kiminle konuşabilirim bilemedim, hatta biriyle konuşsam mı ondan bile emin değildim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190508
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190508,
					"content": "Herkes kendi sorunlarıyla uğraşıyor hayatta. Ben başkalarına içimi dökmek istesem bile yük olmak istemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190509,
						80190510
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190509,
					"content": "Ne demek istediğini anladım galiba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190511
					]
				},
				{
					"id": 80190511,
					"content": "Öyle mi? Ne hissettiğimi anlıyor musun gerçekten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190512,
						80190513
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190512,
					"content": "Ne olursa olsun konuşabildiğim bir aile üyem vardı zamanında.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190514
					]
				},
				{
					"id": 80190514,
					"content": "Ayy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190515,
					"content": "Vay be, ne hoşmuş. Çok şanslısın. Bizim kayıp köylümüz de... Sanırım benim için ikisi de olmuştu diyebiliriz. Hem güvenebileceğim bir aile üyesi hem de beni gerçekten anlayan bir arkadaş gibiydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190516
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190516,
					"content": "Karşıma ne çıkarsa çıksın her şeyi onunla konuşabileceğimi biliyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190517
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190517,
					"content": "Çok düşünceli ve temiz kalpli biriydi... Sabırlıydı da. Ne zaman konuşsak büyük bir ilgiyle dinlerdi, sanki anlattıklarım onun için de çok önemliymiş gibi hissettirirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190518
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190518,
					"content": "... Kaybolduğundan beri ona anlatmak istediğim o kadar çok şey birikti ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190519
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190519,
					"content": "Yok yok, artık bunların bir önemi kalmadı. Onu yeniden görmek istiyorum sadece...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190520
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190520,
					"content": "Vay be, çok yakınmışsınız demek ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190521,
					"content": "Kendinden bahsetmiş miydi hiç?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190522,
					"content": "Hımm... Çoğunlukla köyde gördüğü ilginç şeyleri anlatırdı... Çılgın bazı fikirleri olurdu, onları paylaşmayı da severdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190523
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190523,
					"content": "Aa, doğru, bir keresinde annesi ve babasını sormuştum... Sadece \"Artık aramızda değiller.\" demişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190524
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190524,
					"content": "Köyü mü terk etmişler yoksa vefat mı etmişler anlayamadım, burnumu sokmak da istemedim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190525
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190525,
					"content": "Hımm, hâlâ pek bir bilgi yok elimizde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190526,
					"content": "Kusuruma bakmayın, böyle başınızı şişirdim ama hiç yardımcı olamadım. Özür dilerim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190527,
						80190528
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190527,
					"content": "Deme öyle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190529
					]
				},
				{
					"id": 80190529,
					"content": "En son bu kadar çene çaldığımda o henüz kaybolmamıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190530
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190530,
					"content": "Şimdi düşündüm de ne zaman konuşsak tam şu anki gibi gün batımı zamanında olurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190531
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190531,
					"content": "Zaman hep çok yavaş akardı. Saatlerdir konuşuyormuşuz gibi gelirdi, sonra bir bakardım güneş gökyüzündeki yerinden kıpırdamamış olurdu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190532
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80190532,
					"content": "#Rahat hissettiğinde zaman daha yavaş geçiyor gibi gelir hep, değil mi? ... Hı? Ne oldu {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190533,
						80190534
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190533,
					"content": "Demek günün hep aynı saatiydi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190535
					]
				},
				{
					"id": 80190535,
					"content": "(Öğrendiğimiz kadarına bakılırsa bu kesinlikle sıradan bir kayıp vakası değil...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190536
					]
				},
				{
					"id": 80190536,
					"content": "(Atossa'nın bize zamanla ilgili söyledikleri, bu gizemi çözmenin anahtarı olabilir...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190537
					]
				},
				{
					"id": 80190537,
					"content": "... Aa, şu Dağ Yabanilerine baksana... Biraz tuhaf mı davranıyorlar sanki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190538
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190538,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190539
					]
				},
				{
					"id": 80190539,
					"content": "Aa, Hiçlik Tarikatı. Bu işin arkasında onlar olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80190540
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190540,
					"content": "Eyvah, bizi gördüler. Çabuk, savaşa hazır ol!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80190534,
					"content": "Ve zaman hiç geçmiyormuş gibiydi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190535
					]
				},
				{
					"id": 80190528,
					"content": "Onu daha iyi anlamamıza yardımcı oldun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190529
					]
				},
				{
					"id": 80190513,
					"content": "Ama şimdi beni seve seve dinleyen ve anlayan bir sürü arkadaşım oldu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190514
					]
				},
				{
					"id": 80190510,
					"content": "Aile böyle durumlar için vardır işte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80190511
					]
				}
			]
		},
