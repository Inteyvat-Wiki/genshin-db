				"points": []
			},
			"dialogs": [
				{
					"id": 727320101,
					"content": "Arataki Çetesi, buraya sizinle düello yapmaya geldim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320102
					],
					"speakerTitle": "Izdırap Tüccarı"
				},
				{
					"id": 727320102,
					"content": "Öyle mi? Büyük Usta Hanakado benimle dövüşmesi için başka bir çocuk daha mı gönderdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320103
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727320103,
					"content": "Başka adamı kalmamış mı gönderecek? Aralarından en kötüsünü seçip göndermiş resmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320104
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727320104,
					"content": "... Benim derdim seninle değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320105
					],
					"speakerTitle": "Izdırap Tüccarı"
				},
				{
					"id": 727320105,
					"content": "Boş tenekeden çok ses çıkarmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320106
					],
					"speakerTitle": "Izdırap Tüccarı"
				},
				{
					"id": 727320106,
					"content": "Şu sarışın oldukça güçlü ve yetenekli bir savaşçıya benziyor. Arataki Çetesinin asıl lideri o olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320107
					],
					"speakerTitle": "Izdırap Tüccarı"
				},
				{
					"id": 727320107,
					"content": "Hahaha! Paimon insan sarrafı olduğunu bilmiyordu! Hadi onu biraz daha öv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727320108,
					"content": "Hey, hey! Ne diyorsunuz ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320109
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727320109,
					"content": "Yoldaşım güçlüdür ama kendisi çetemizin dış gücüdür. Arataki Çetesinin gerçek lideri Arataki Itto'dan başkası değildir, dolayısıyla başından beri benim, yani Arataki Itto'nun peşindesin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320110,
						727320111
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727320110,
					"content": "Hımm, ben de Oni Kralın Geçici Sağ Kolu mu oluyorum?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727320112
					]
				},
				{
					"id": 727320112,
					"content": "Hey, iyi fikir aslında! Arataki Çetesi dünyadaki en güçlü çete olmayabilir ama yine de bir lider olmak havalı olsa gerek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727320113,
					"content": "Senin için de uygunsa Paimon, 3 Günlüğüne Arataki Üyesi Paimon veya Arataki Çetesinin Geçici Lideri Paimon olarak anılmak istiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727320114,
					"content": "Hey, hey, hey! Rakibin sizi ayartmasına izin vermeyin! Onun... Bir anlaşmazlık çıkarmaya çalıştığı ortada. Bizi birbirimize düşürmek istiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320115
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727320115,
					"content": "Onun patronunu bir yeneyim de görün! Sözlerini geri almak için bana yalvaracak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320116
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727320116,
					"content": "Hemen havalara girme. Arataki Çetesinin iç işleri beni ilgilendirmez. Sadece güçlü rakiplerle dövüşmek istiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727320117
					],
					"speakerTitle": "Izdırap Tüccarı"
				},
				{
					"id": 727320117,
					"content": "Buradaki sarışın ne kadar güçlüymüş bir görelim bakalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Izdırap Tüccarı"
				},
				{
					"id": 727320111,
					"content": "Sadece birkaç günlüğüne lider olmama izin veremez misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727320112
					]
				}
			]
		}
	]
}