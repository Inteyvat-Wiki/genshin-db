			"trigger": {
				"objectNames": [
					"Büyük Düzenbaz Sennichi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727350101,
					"content": "Hey, hanginiz bu çetenin lideri? Hadi göster kendini! Dövüşmenin zamanı geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350102
					],
					"speakerTitle": "Büyük Düzenbaz Sennichi"
				},
				{
					"id": 727350102,
					"content": "Ben devler arasında bir dev olan Büyük Düzenbaz Sennichi'yim. Büyük Usta Hanakado, Arataki Çetesinin liderinin kellesini istedi... Ben de onu almaya geldim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350103
					],
					"speakerTitle": "Büyük Düzenbaz Sennichi"
				},
				{
					"id": 727350103,
					"content": "Vay canına, görünümü de... Sesi de oldukça hiddetli! Bu sefer gerçekten güçlü bir rakiple karşı karşıyayız sanırım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727350104,
					"content": "Sen buna nasıl cüret edersin ha? İsminin başında \"Büyük\" olunca ne oluyor? Benim yerime geçip ilgi odağı mı olmak istiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350105
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727350105,
					"content": "Pekala, \"devler arasındaki dev\", senin boyunu biraz küçültsek iyi olacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350106
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727350106,
					"content": "Ç-Çok uzun! Sen... Sen bir Onisin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350107
					],
					"speakerTitle": "Büyük Düzenbaz Sennichi"
				},
				{
					"id": 727350107,
					"content": "B-Beni kahvaltıda yiyecek gibi görünüyorsun! Senin gibi biri neden böcek dövüştürür ki? Bu bir çocuk oyunu... Of, yine neye bulaştım ben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350108
					],
					"speakerTitle": "Büyük Düzenbaz Sennichi"
				},
				{
					"id": 727350108,
					"content": "Şey, affedersin? \"Çocuk oyunu\" mu dedin, yoksa ben mi yanlış duydum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350109
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727350109,
					"content": "Görünüşe göre böcek dövüşünün neyle ilgili olduğu hakkında hiç fikrin yok. Yanlış anlayışını bir kıdemli olarak düzelteceğim dostum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350110,
						727350111
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 727350110,
					"content": "Hadi göster ona gününü!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727350112
					]
				},
				{
					"id": 727350112,
					"content": "Evet! Hadi gidip ona dersini ver! Bunu yapabilirsin Boşboğaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727350113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 727350113,
					"content": "Artık geri dönüşü yok... Hadi, göster bakalım kendini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Büyük Düzenbaz Sennichi"
				},
				{
					"id": 727350111,
					"content": "Bu adamın iyi bir derse ihtiyacı var!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727350112
					]
				}
			]
		}
	]
}