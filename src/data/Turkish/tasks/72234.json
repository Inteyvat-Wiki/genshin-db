			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kabayama"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722340101,
					"content": "İşler nasıl gidiyor? Her şey yolunda mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340102
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340102,
					"content": "Vay canına! Çok ani oldu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340103
					]
				},
				{
					"id": 722340103,
					"content": "Çok özür dilerim. Amacım seni korkutmak değildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340104
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340104,
					"content": "Ben Kabayama. Genellikle tam da senin şu anda oturduğun yerde otururum. Hoş, sakin bir yer. Oturup hayat hakkında düşüncelere dalabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340105
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340105,
					"content": "Geri ister misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340106
					]
				},
				{
					"id": 722340106,
					"content": "Sağ ol ama önemli değil. Bu arada sen buralı değilsin, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340107
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340107,
					"content": "Evet değilim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340108
					]
				},
				{
					"id": 722340108,
					"content": "O zaman oldukça bilgili olmalısın. Dış dünyayı hiç görmedim ama çok ev değiştirdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340109
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340109,
					"content": "*iç çeker* Hazır sözü geçmişken...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340110
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340110,
					"content": "O kadar sık taşınırdık ki küçükken hiç yakın arkadaş edinme fırsatım olmadı. Gezinirken çok güzel yerler gördüm ama hiç bunları paylaşacak birisi olmadı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340111
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340111,
					"content": "Aslında... Bu yerleri sana göstermeme ne dersin? Bunun gibi yerlerden geçersen oturup etrafa göz at. Sonra gelip bana ne düşündüğünü söyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340112
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340112,
					"content": "Bu tür yerlerden birisi Geçitler'in en yüksek noktasındaki bir taş geçidin altında. Bir başkası Ebedi Gece Tapınağının yakınındaki mercanlarla çevrili açık bir alan. En sonuncusu da Yılan Kalbi'ndeki yüksek harabelerin yanında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340113
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340113,
					"content": "Tüm bu yerlere işaret koydum ve yolumu aydınlatması için de bir lamba astım. Rahatlıkla bulacağına eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kabayama"
				}
			]
		},
		{
