			},
			"dialogs": [
				{
					"id": 722340301,
					"content": "Demek döndün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340302
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340302,
					"content": "Tüm yerleri buldun mu? Senin gibi çok gezmiş birisi için pek de görecek bir şey olmayabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340303,
						722340304
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340303,
					"content": "Ben eşsiz güzellikte olduklarını düşünüyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340305
					]
				},
				{
					"id": 722340305,
					"content": "Ne yazık ki başka kimseyle paylaşmaya imkanım olmadı. En azından senin fikrini duyduğuma minnettarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340306
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340306,
					"content": "Belki bunlardan daha güzel yerler vardır. Burada her yer karanlık. Yiyecek bakımından da çok fazla çeşit yok. Ayrıca ejderlere de dikkat etmemiz gerekiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340307
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340307,
					"content": "Fakat bu kadar uzun süre burada yaşayınca kendimi yakın hissediyorum, biliyor musun? O birkaç yeri hâlâ özlüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340308
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340308,
					"content": "Hiç böyle hissettiğin oluyor mu? Yeterince uzun süre yaşayınca bunun gibi bir yer bile yuva hissi veriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340309,
						722340310
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340309,
					"content": "Belki de.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340311
					]
				},
				{
					"id": 722340311,
					"content": "Öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340312
					],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340312,
					"content": "Neyse, en azından beni dinlediğin için teşekkürler. Sana karşılığında verecek pek bir şeyim yok ama lütfen bunları al.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kabayama"
				},
				{
					"id": 722340310,
					"content": "Pek sayılmaz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340311
					]
				},
				{
					"id": 722340304,
					"content": "Oldukça sıradandılar. Çok daha güzel yerler gördüm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340305
					]
				}
			]
		}
	]
