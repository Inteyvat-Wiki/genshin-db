				},
				{
					"id": 2005902002,
					"content": "Bana <color=#00E1FFFF>dağ yabanilerinden biraz ganimet</color> getirir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005902003
