			"dialogs": [
				{
					"id": 2005910001,
					"content": "Bu ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910002
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 2005910002,
					"content": "Hoş geldin! Zevkli biriymişsin dostum. Tüm dikkatini dükkandaki en değerli parçaya verdin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910003
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910003,
					"content": "Bu kısa süre önce bir dağ yabanisi liderinden alınan bir savaş hatırası. Alan gezgin de bu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910004
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910004,
					"content": "O dağ yabanisi denilen korkunç eşkıya kim bilir ne zamandır Mondstadt'a bela olmuştu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910005
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910005,
					"content": "Bu gezgin, tecrübeli bir savaşçı diye kolayca kazandı sanmayın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910006
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910006,
					"content": "Cidden mi? Vay be... O dağ yabanisi bayağı fenaymış anlaşılan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910007
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 2005910007,
					"content": "... Bunu alıp Cyrus'a ya da Stanley'ye mi göstersem acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910008
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 2005910008,
					"content": "Belki o zaman hakkımda farklı düşünürler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910009
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 2005910009,
					"content": "Tabii! Bu dükkanda sır tutmayı biliriz. Merak etme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910010
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910010,
					"content": "Bana sorarsan şimdi al yoksa yakında kesin başkası kapar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910011
					],
					"speakerTitle": "Marjorie"
				},
				{
					"id": 2005910011,
					"content": "Düşünmem lazım... Söylediği doğru mu gezgin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		},
