			"dialogs": [
				{
					"id": 2005902001,
					"content": "Hımm. Sana en çok ne satar hiç söylemedim değil mi? Eminim ne aradığını bilmiyorsundur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
