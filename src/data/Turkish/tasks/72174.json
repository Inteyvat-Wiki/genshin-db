				},
				{
					"id": 721741002,
					"content": "Sağ olasın sevgili yabancı, hop! Sonunda yelken açabileceğiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721741003
					],
					"speakerTitle": "\"Sandalcı\""
				},
				{
					"id": 721741003,
					"content": "Nehrin ilerisinde! Şurada altın meşe! Altın taşlar dört bir yanda, altın pelin otları serili yerlerde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721741004
					],
					"speakerTitle": "\"Sandalcı\""
				},
				{
					"id": 721741004,
					"content": "Manzara olabildiğince güzel, gözün görebileceğinden çok daha güzel...",
