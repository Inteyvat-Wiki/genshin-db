			"trigger": {
				"objectNames": [
					"\"Sandalcı\""
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721740101,
					"content": "Nehrin kenarında selviler, gümüş rengine bürünmüş! Gümüş taşlar dört bir yanda, gümüş pelin otları serili yerlerde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740102,
						721740103
					],
					"speakerTitle": "\"Sandalcı\""
				},
				{
					"id": 721740102,
					"content": "Pardon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740104
					]
				},
				{
					"id": 721740104,
					"content": "Oo, kimler gelmiş! Misafir misiniz? Tekneye mi binmek istiyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740105
					],
					"speakerTitle": "\"Sandalcı\""
				},
				{
					"id": 721740105,
					"content": "Hayhay, bakalım, hemen bakalım... Ama siz yabancı gibisiniz. Olmaz olmaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740106,
						721740107
					],
					"speakerTitle": "\"Sandalcı\""
				},
				{
					"id": 721740106,
					"content": "\"Olmaz\" derken?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740108
					]
				},
				{
					"id": 721740108,
					"content": "Parıltılı gümüş kayık aya doğru yelken açar, ancak size uygun değildir, değildir! Tekneye binmeyesiniz, güverteye basmayasınız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740109
					],
					"speakerTitle": "\"Sandalcı\""
				},
				{
					"id": 721740109,
					"content": "Ay ay ay... Sis çoktan dağıldı, çoktan dağıldı sis! Peki tekneye hâlâ kim binmedi? Altın salonun hanımı çok ama çok kızacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740110
					],
					"speakerTitle": "\"Sandalcı\""
				},
				{
					"id": 721740110,
					"content": "Tekne mi? Hani nerede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740111
					]
				},
				{
					"id": 721740111,
					"content": "Hey, hey... Güneşin ve bayırın evladı, gümüş kayık! Altın gibi parlayan ay sarayına gelmeli her şey, evine geri dönmeli her şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740112
					],
					"speakerTitle": "\"Sandalcı\""
				},
				{
					"id": 721740112,
					"content": "Ne yazık, ne yazık! Bazı çocuklar yolunu kaybetti, binmediler tekneye hâlâ! Hanımefendi kızacak. Çok ama çok kızacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721740113,
						721740114
					],
					"speakerTitle": "\"Sandalcı\""
				},
				{
					"id": 721740113,
					"content": "Yardıma ihtiyacın var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740115
					]
				},
				{
					"id": 721740115,
					"content": "Hadi, hadi, binin tekneye, tekne binilmek içindir! Dolanma, artık kaybolma, yas tutmadığın hayat için...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Sandalcı\""
				},
				{
					"id": 721740114,
					"content": "Beni duyuyor musun sen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740115
					]
				},
				{
					"id": 721740107,
					"content": "Neden bahsediyorsun sen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740108
					]
				},
				{
					"id": 721740103,
					"content": "Sen kimsin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721740104
					]
				}
			]
		},
