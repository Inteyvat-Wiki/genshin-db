					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040203
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040203,
					"content": "Bir şey bulursan sakın heyecanlanıp koşarak çıkma. Önce <color=#00E1FFFF>ipucunu not al</color>.",
					"roleType": "TALK_ROLE_NPC",
