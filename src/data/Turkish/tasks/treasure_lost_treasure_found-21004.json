					"nextDialogs": [
						210049009
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049009,
					"content": "Tabii ben hepsini bulacak kadar formda değilim. İlkini bulmak bile beni çok yordu. Kendime gelmem günler sürdü.",
