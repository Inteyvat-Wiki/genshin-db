				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210045001,
					"content": "Arama nasıl gidiyor? Hazineyi buldun mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045003
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045003,
					"content": "Evet. Sonuçta \"kavuştukları\" yerle ilgili.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045004
					]
				},
				{
					"id": 210045004,
					"content": "Öyle mi? Yani tıpkı Guizhong'un Dört Emrinde geçtiği gibi. Hazine \"bu dört emrin kavuştuğu\" yerdeymiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045005
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045005,
					"content": "Bu bilmeceyi kim yazdıysa Guizhong'a büyük bir hayranlık duyuyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045006
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045006,
					"content": "O kadar ki Guili Uygarlığı yok olmuş olsa bile Guizhong'un Dört Emrini gelecek nesiller için korumuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045007
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045007,
					"content": "Emirlerin sahibi Guizhong ise halkı tarafından çok seviliyor olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045008
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045008,
					"content": "Belli ki halkının bilge olmasını, belirli etik kurallara bağlı kalmasını, güçlü ve sağlıklı olmasını, vatanları olan Guili Uygarlığını koruma yolunda bir araya gelmesini istemiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045009,
						210045016,
						210045021
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045009,
					"content": "Ama başaramamış.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045010
					]
				},
				{
					"id": 210045010,
					"content": "Başaramamış mı? Haklısın aslında. Sonuçta hayatını kaybetmiş. Guili Uygarlığı yok olduğunda halkı yersiz yurtsuz kalmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045011
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045011,
					"content": "Yine de bugün Guizhong'un Dört Emri tekrar gün yüzü gördü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045012
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045012,
					"content": "Guizhong bu sözleri halkı için hem ilke hem de lütuf olsun diye bizzat yazmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045013
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045013,
					"content": "Bir zamanlar bu emirlerin ışığında halkına önderlik ederek onları bu topraklara yerleştirmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045014
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045014,
					"content": "Artık aramızda olmayabilir ama inançları ve ilkeleri hâlâ ayakta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045015
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045015,
					"content": "Ona bu kadar saygı duyan kişi kimse gerçekten çok zekiymiş. Guizhong'un Dört Emrinin gelecek nesillere aktarılmasını garantilemek için gizli bir hazinenin cazibesini kullanmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045028
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045028,
					"content": "Acaba onun için değerli olan hazine nadir metaller ve kıymetli taşlar mıymış yoksa Guizhong'un Dört Emri mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045029
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045029,
					"content": "Haha. En azından ben buradaki asıl hazinenin emirler olduğunu düşünüyorum. Altın veya değerli taşlarla dolu bir sandık bunlarla kıyaslanamaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045030
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045030,
					"content": "Ama insanlara sorulsa kaç tanesi maddi zenginlik yerine bir emir listesini seçer ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045016,
					"content": "Nazik bir tanrıya benziyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045017
					]
				},
				{
					"id": 210045017,
					"content": "Tanrılar genelde nazik olmuyor sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045018
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045018,
					"content": "Belki bir zamanlar öyleydiler. Belki çok uzun zaman önce, insanlara önderlik eden tanrılardan bazıları nazik tanrılardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045019
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045019,
					"content": "Halklarını koruyan, onların arasına karışan, onlar dünyayı keşfederken yanlarında duran tanrılar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045020
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045020,
					"content": "Ama sonunda halkını koruyacak gücü bulamayan da bu nazik tanrılar olmuş. Örneğin Guizhong. Bir zamanlar tüm bir medeniyetin damarlarında akan dört emri korumak için bile karmaşık bir hazine avı gerekmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045029
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045021,
					"content": "Keşke onunla tanışabilseydim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210045022
					]
				},
				{
					"id": 210045022,
					"content": "Bir tanrıyla mı tanışmak istiyorsun? Düşüncelerin gerçekten çok tuhaf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045023
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045023,
					"content": "Merak ediyorum da... Guizhong'la tanışabilseydin ona ne derdin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045024
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045024,
					"content": "\"Üzülme Guizhong. Elinden geleni yaptın\" mı derdin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045025
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045025,
					"content": "Ben olsam Guizhong'un Dört Emrini hata yapmadan ezbere okurdum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045026
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045026,
					"content": "Ona görüşlerinin ve ilkelerinin hâlâ sağ salim durduğunu söylerdim. Bu topraklardaki insanların atalarına öğrettiği şeylerin hâlâ hatırlandığını söylerdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210045027
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210045027,
					"content": "Bence Guizhong gibi her şeyi kaybetmiş birini sadece bu neşelendirebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
