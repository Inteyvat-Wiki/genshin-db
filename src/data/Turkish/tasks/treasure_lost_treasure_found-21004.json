				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210042201,
					"content": "Tahmini bir hipotez ama bence Guizhong'un Dört Emriyle bağlantılı olan dört harabe, emirlerin anlamını çözmekte önemli olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042202
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042202,
					"content": "Harabelerin ilgisinin tam olarak ne olduğunu da bulmak gerek tabii. Ayrıca ben hipotezlerimi tam anlamıyla deneyecek gücümün olduğunu düşünmüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042203
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042203,
					"content": "Belki de tek bir bakış açısına saplanmışımdır ve bu fikir beni hiçbir yere götürmeyecektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
