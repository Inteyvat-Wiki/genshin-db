			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210040101,
					"content": "Guizhong'un Dört Emri. Bize ne anlatmaya çalışıyorlar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040102,
						210040104
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040102,
					"content": "Hazırım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040103
					]
				},
				{
					"id": 210040103,
					"content": "Bakıyorum da çok heyecanlısın! Beğendim. Hadi Guizhong'un Dört Emrini okumaya başlayalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040106
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040106,
					"content": "\"Akıl ile öğret, erdemli ol, kemiklerini güçlendir, bir amaç etrafında toplan. Bu dört emrin kavuşması bundan böyle 'Guili Uygarlığı' olarak bilinsin.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040107
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040107,
					"content": "İlk bakışta okunuşu bir emir dizisi gibi. Hayatın altın kuralları.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040108
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040108,
					"content": "Söylenene göre gizli bir hazineye giden ipuçlarını da barındırıyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040109
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040109,
					"content": "Ama çözemiyorum. Galiba buna akademisyenlerin \"eski usul\" dediği yollardan bakmamız gerekecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040110
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040110,
					"content": "Önceden bulduğumuz o yedi geçidin her biri bir tür harabedeydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040111
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040111,
					"content": "Bu sefer nereden başlayacağımızı bilmediğimize göre şimdilik harabeleri aramaya devam edebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040112,
						210040116,
						210040122
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040112,
					"content": "Tam olarak nerede arayacağız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040113
					]
				},
				{
					"id": 210040113,
					"content": "Hımm. Şimdilik sadece Guili Ovası'nı arayalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040114
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040114,
					"content": "Tabii ben sadece bir alim olduğum için size ayak bağı olurum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040115
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040115,
					"content": "O nedenle harabeleri aramayı size bırakıyorum. Ne bulduğunuzu söyleyin yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040129
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040129,
					"content": "Konusu açılmışken... Bir keresinde buradaki harabelerden birinde, üzerinde yazılar olan tuhaf bir levha bulmuştum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040130
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040130,
					"content": "Tabii o levhayı tek başına inceledim. Kapsamlı bir araştırma yapmadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040131
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040131,
					"content": "Düşününce o levhanın Guizhong'un Dört Emriyle bağlantılı olabileceği aklıma geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040132
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040132,
					"content": "Yerini haritanda işaretleyeyim mi? Gidip baksan iyi olur. Belki seni bir yere götürür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040116,
					"content": "TÜM harabeleri mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040117
					]
				},
				{
					"id": 210040117,
					"content": "Tabii ki hayır. Liyue'deki tüm harabelere kendi başımıza bakabilmemiz imkansız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040118
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040118,
					"content": "O yüzden arama bölgemizi sınırlandıralım. Hazine, Guili Ovası'ndaki Guili Uygarlığıyla bağlantılı olduğuna göre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040119
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040119,
					"content": "Aramamızı şimdilik Guili Ovası'yla sınırlandıralım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040120
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040120,
					"content": "Bu arada benim gibi bir alimin sahada size ayak uydurması mümkün değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040121
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040121,
					"content": "O nedenle harabeleri aramayı size bırakıyorum. Ne bulduğunuzu söyleyin yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040129
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040122,
					"content": "İşte geliyorum Liyue harabeleri!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040123
					]
				},
				{
					"id": 210040123,
					"content": "Dur! Bir dakika! Liyue'deki her harabeyi nasıl arayacaksın? Asla bitiremezsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040124
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040124,
					"content": "Her hazine dendiğinde bu kadar heyecanlanırsan olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040125
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040125,
					"content": "Şöyle yapalım. Hazinenin Guili Ovası'ndaki Guili Uygarlığından geldiğini biliyoruz. Arama bölgemizi sınırlandıralım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040126
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040126,
					"content": "Başlangıçta sadece Guili Ovası'nı arayalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040127
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040127,
					"content": "Bekle! Daha bitirmedim! Harabeleri iyice aramayı unutma. İlginç bir şey bulursan geri gelip bana söyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040128
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040128,
					"content": "Unutma, Guili Ovası'nda kalacaksın! Heyecana kapılıp bölgeden dışarı çıkma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040129
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210040104,
					"content": "Hadi şu hazineyi bulalım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040105
					]
				},
				{
					"id": 210040105,
					"content": "Hazinenin en ufak bir sözü geçse hemen heyecanlanıyorsun. Hımm. Peki, öyle olsun. Hadi Guizhong'un Dört Emrini okumaya başlayalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210040106
					],
					"speakerTitle": "Soraya"
				}
			]
		},
