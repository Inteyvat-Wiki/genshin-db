				{
					"id": 210040901,
					"content": "Biz gidelim artık.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210040902
					]
				},
				{
					"id": 210040902,
					"content": "Gidiyor musunuz? Unutmayın, ilginç bir şey bulursanız gelip bana söyleyeceksiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
		{
			"id": 2100420,
			"completionStepIds": [
				2100420
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2100420",
							"2"
						],
						"stepId": 2100420,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210042001,
					"content": "Bazen bir tanrı bile kaderden kaçamaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042002
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042002,
					"content": "Dört harabede dört ipucu buldum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210042003
					]
				},
				{
					"id": 210042003,
					"content": "Dört harabe, dört ipucu... Ayrıca dört emir var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042004
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042004,
					"content": "Bu ipuçlarının her biri Dört Emirden birinin anlamını açıklıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042005
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042005,
					"content": "Doğru anlama ulaşmak için Guizhong'un Dört Emrinin asıl metni gerekli. Bu dördü yardımcı oluyor ama araştırmamız için o kadar önemli değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042006
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042006,
					"content": "Bu beş paragrafın her biri bağlantılı. Peki nasıl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042007
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042007,
					"content": "\"Kavuşma...\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210042008
					]
				},
				{
					"id": 210042008,
					"content": "Hımm. Acaba \"kavuşma\" ile bu dördünün bir şekilde bağlantılı olduğundan mı bahsediliyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042009
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042009,
					"content": "Bir dakika. Guizhong'un Dört Emrinin her biri bir harabede bulunuyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042010
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042010,
					"content": "Hımm. Tahmin yürütüyorum ama belki dört <color=#00E1FFFF>harabenin</color>, Guizhong'un Dört Emrini çözmekle bir ilgisi vardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042011
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042011,
					"content": "Tam olarak nasıl olduğunu bilmiyorum. Biraz üzerine düşünmem gerek. Sen de düşünebilirsin. Ya da daha iyisi, gidip bizzat araştırabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042012
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042012,
					"content": "Sonuçta ben çelimsiz bir alimim. Birkaç saniye koşunca bitkin düşüyorum. Keşke senin kadar dayanıklı olsam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210042013
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210042013,
					"content": "Neyse. Ben bunu biraz daha düşüneceğim. Aklına bir şey gelir veya bir şey bulursan nerede olduğumu biliyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
		{
			"id": 2100422,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
