					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049303,
					"content": "Tabii Guizhong güçlü bir tanrı olduğundan değil ama... En azından bana öyle gelmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210049304
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210049304,
					"content": "Sanırım Guili Uygarlığının yanında Guizhong dışında bir tanrı daha var. Kimsenin tek seferde iki tanrıya meydan okuyacak kadar aptal olduğunu düşünmüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
