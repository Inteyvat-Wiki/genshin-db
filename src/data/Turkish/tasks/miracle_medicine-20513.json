				{
					"id": 205130101,
					"content": "Bu normal duruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130102,
					"content": "Gayet iyi görünüyorsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130103
					]
				},
				{
					"id": 205130103,
					"content": "Evet, sanırım kafamda kuruyormuşum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130104,
					"content": "Anna gün geçtikçe daha iyi oluyor. Bu doktor gerçekten iyiymiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130105
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130105,
					"content": "İstersen birkaç malzeme daha bulmama yardım edebilirsin. Bu sefer Rüzgarın Okşadığı Rüzgargülü lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130106,
						205130111,
						205130115
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130106,
					"content": "İlaç gibi gelmedi bana.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130107
					]
				},
				{
					"id": 205130107,
					"content": "Rüzgargülü Çiçekleri bazen ilaç yapmakta kullanılır ama genelde hafif hastalıklar içindir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130108
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130108,
					"content": "Belki kilit nokta Rüzgar Bodurlopudur ama Rüzgargülü Çiçekleri ve Rüzgar Bodurlopları bir arada pek bulunmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130109
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130109,
					"content": "Şansımız varmış. Jack daha önce birkaç kere öyle bir şey görmüş. Bölgelerini kabaca bana gösterdi. Getir, sonuncusunu haritanda işaretleyeyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130110
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130110,
					"content": "Uçabildikleri için Rüzgar Bodurloplarıyla baş edemiyorum. O yüzden tek çarem sensin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130111,
					"content": "Mondstadt işte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130112
					]
				},
				{
					"id": 205130112,
					"content": "Seninle tartışacak değilim ama Rüzgargülü Çiçekleri ve Rüzgar Bodurlopları birlikte pek sık görülmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130113
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130113,
					"content": "Şansımız varmış. Jack daha önce birkaç kere öyle bir şey görmüş. Bölgelerini kabaca bana gösterdi. Getir, sonuncusunu haritanda işaretleyeyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130114
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130114,
					"content": "Uçabildikleri için Rüzgar Bodurloplarıyla savaşamıyorum. O yüzden tek çarem sensin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130115,
					"content": "Senin için bir Rüzgar Bodurlopu yakalayacağım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130116
					]
				},
				{
					"id": 205130116,
					"content": "Rezil olduğumu görmek istiyorsun, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130117
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130117,
					"content": "Neyse. Rüzgargülü Çiçekleri ve Rüzgar Bodurlopları birlikte pek sık görülmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130118
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205130118,
					"content": "Şansımız varmış. Jack daha önce birkaç kere öyle bir şey görmüş. Bölgelerini kabaca bana gösterdi. Getir, sonuncusunu haritanda işaretleyeyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130119
