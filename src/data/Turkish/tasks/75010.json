			"dialogs": [
				{
					"id": 750100201,
					"content": "Aa, tüylü bir şey. Tüylü bir şey yolunu keser...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750100202
					]
				},
				{
					"id": 750100202,
					"content": "Hım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100203
					],
					"speakerTitle": "Enerjik Alpaka"
				},
				{
					"id": 750100203,
					"content": "Raarrr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100204
					],
					"speakerTitle": "\"Rafadan\""
				},
				{
					"id": 750100204,
					"content": "Hımmmm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100205
					],
					"speakerTitle": "Enerjik Alpaka"
				},
				{
					"id": 750100205,
					"content": "Ha? Demek hepiniz arkadaşsınız, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750100206,
					"content": "Rarr! Raarr, rarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100207
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750100207,
					"content": "Alpakaları gözetlemekten sorumlu biri gelip Yumkazoru sakinleştirir...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750100208
					]
				},
				{
					"id": 750100208,
					"content": "Hey, hey, sakin ol Rafadan. Bak, gördün mü? Böyle acele kararlar verdiğin için bu isme sahipsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100209
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100209,
					"content": "Raarr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100210
					],
					"speakerTitle": "\"Rafadan\""
				},
				{
					"id": 750100210,
					"content": "Onu merak etme, sorumluluk hissi çok yüksek. Etrafta yabancılar olunca geriliyor. Ancak onun bu adanmışlığı sayesinde Alpakaların bakımını kolaylıkla halledebiliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100211
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100211,
					"content": "Her neyse! Sizi buraya hangi rüzgar attı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100212,
						750100214
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100212,
					"content": "Sadece dolaşıyoruz. Maceraya çıkıyoruz yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100213
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750100213,
					"content": "Maceracısınız demek! Tahminime göre, Rafadan sizin korkutucu bir auraya sahip tehlikeli tipler olduğunuzu düşündü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100216
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100216,
					"content": "Hım. Paimon Yumkazorların bunu yapabildiğini bilmiyordu. Biz de Alpakaların saldırıya uğrayacağını düşünüyorduk! Bir yanlış anlaşılma oldu galiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750100217,
					"content": "Evet, hep öyle zannedilir. Dostumun biraz sert göründüğünü biliyorum ama Alpakalarla arası çok iyidir. Hatta arkadaş olduklarını bile söyleyebilirim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100218
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100218,
					"content": "Rrrr... Raarr! Raarr! Raaarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100219
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750100219,
					"content": "Hım? Nasılsın ufaklık? Sen de onlarla arkadaş olmak ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100220
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100220,
					"content": "Raarr! Raaaarrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100221
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750100221,
					"content": "Vay, öyle galiba. Ama evet, düşününce hep bizimle takılıyorsun. Birkaç hayvanla arkadaşlık edersen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750100222,
					"content": "Bu ona çok iyi gelirdi kesinlikle. Alpaka dostlarıyla çevrelenmiş küçük bir Tepetlizor çok sevimli görünürdü, öyle değil mi? Onları seyrederken üç kase Yakıcı Et Yahnisini mideye indirsem bile bana mısın demez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100223
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100223,
					"content": "Tabii önce Alpakalarımın da onaylaması lazım. Arkadaşlık zorlamaya gelmez biliyorsunuz. Sence de öyle değil mi Rafadan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100224
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100224,
					"content": "Mrrmpp.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100225,
						750100228
					],
					"speakerTitle": "\"Rafadan\""
				},
				{
					"id": 750100225,
					"content": "#Hey, bu da nedir? Birileri {REALNAME[ID(2)|SHOWHOST(true)]} ile arkadaş olmak istemiyor galiba!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750100226
					]
				},
				{
					"id": 750100226,
					"content": "#Hey, hey, hemen savunmaya geçme! {REALNAME[ID(2)|SHOWHOST(true)]} önce kendi bir denesin, ona şans verelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750100227,
					"content": "Çocuklar yalnızca sıkı çalışarak bir şeylerin üstesinden gelmeyi öğrendiklerinde büyürler, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750100231,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100232
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750100232,
					"content": "Tepetlizorunuz iyice özgüvenle dolup taşmış görünüyor. Sanırım geri dönüp biraz dinleneceğim. Sorun çıkarsa seslenin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100233
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100233,
					"content": "Aslında benim yerime Rafadan'a seslenseniz daha iyi olur. Ne de olsa burada Alpakalar ondan sorulur... Şaka şaka. Pekala küçük dostum, burada güzel güzel oyna. İyi şanslar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750100228,
					"content": "Sorun değil. Ne olursa olsun biz onun yanındayız.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750100229
					]
				},
				{
					"id": 750100229,
					"content": "Paimon senin her ihtimale karşı iyi davranmaya çalıştığını biliyor... Ancak daha yolun başındayken karamsar olmaya gerek yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750100230,
					"content": "#Çocuklar güçlenmek ve sağlıklı olmak için daha çok teşvike ihtiyaç duyarlar. Yapabilirsin {REALNAME[ID(2)|SHOWHOST(true)]}! Paimon sana inanıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750100214,
					"content": "Son zamanlarda huzurlu ve kırsal bir hayatı düşünüyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750100215
					]
				},
				{
					"id": 750100215,
