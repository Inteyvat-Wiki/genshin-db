						750101203
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750101203,
					"content": "Haha, ne kadar da güleç bir şeysin sen öyle. Benim de keyfimi yerine getirdin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750101204
					],
					"speakerTitle": "Wactana"
				},
				{
					"id": 750101204,
					"content": "#Hey, Wactana, senin daha çok Alpakalar için endişeleniyor olman gerekmiyor mu? {REALNAME[ID(2)|SHOWHOST(true)]} ile arkadaş olan Alpaka çok tehlikeli bir yerdeydi.",
