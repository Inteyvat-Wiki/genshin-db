			"dialogs": [
				{
					"id": 240020201,
					"content": "Bayan Isadora, yardım edebileceğim bir konu var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020202
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020202,
					"content": "Memur Muirne, size bir sorum olacaktı. Bu sabah ofise getirdiğim şu hesap yığınını hatırlıyor musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020203
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020203,
					"content": "Hatırlıyorum. Hatta Mor Altın Balıkçı Martıların da saldırısına uğramıştın, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020204
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020204,
					"content": "Evet, doğru! O sinir bozucu martılar uçup gidince ben de hemen ofise koştum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020205
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020205,
					"content": "Kaçarken yere bir kağıt düşürüp düşürmediğimi hatırlıyor musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020206
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020206,
					"content": "Hım... Hatırlayamıyorum. Ben de o sırada başka işlerle meşguldüm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020207
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020207,
					"content": "Ama acil bir şekilde ihtiyacın varsa ofise giden yolu \"yeniden canlandırabiliriz\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020208
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020208,
					"content": "Ha? Gerçekten yapar mıyız? Size çok zahmet vermiş olurum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020209
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020209,
					"content": "Sadece bir şeyler arayacağız. Mermonia Sarayı'ndaki işlerden çok daha kolay olduğu kesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020210
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020210,
					"content": "Elinizdeki belgeleri yığınlar halinde bağlamıştınız, doğru mu hatırlıyorum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020211
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020211,
					"content": "Evet, doğru. Sonuçta mali inceleme raporlarımızda çok titiz olmak gerekiyor. Epey dikkatliymişsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020212
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020212,
					"content": "Ustaların sarayın dış duvarının bakımını yapması gibi büyük görevlerden, bir ofis masasının kilidinin değiştirilmesi gibi küçük görevlere kadar her şeyin listelenmesi gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020213
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020213,
					"content": "Bu şekilde her ayın giderleri bir iple bağlamayı gerektirecek kadar büyük bir yığın haline geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020214
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020214,
					"content": "Yani kısacası tek bir sayfanın uçup gitmesi mümkün değil. Belge kaybolduysa da o birleştirdiğiniz yığınlar halinde kaybolurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020215
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020215,
					"content": "Siz ofise geleli çok olmadı zaten, hadi hemen çıkalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muirne"
				}
			]
		},
