					"Isadora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240020101,
					"content": "Hah. Nereye gitti? Şansa bak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020102
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020102,
					"content": "Ah, bir kopya daha yazamayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020103
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020103,
					"content": "Bir şey mi kaybettin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020104
					]
				},
				{
					"id": 240020104,
					"content": "Yani, umarım sadece kaybolmuştur. Ben iyi tarafından bakmaya çalışıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020105,
						240020106
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020105,
					"content": "İyi tarafından bakmak dediğin bu mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020107
					]
				},
				{
					"id": 240020107,
					"content": "Yani... Aradığın şey ofisin altı aylık masraf defteriyse kaybolması iyi bir şey olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020108
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020108,
					"content": "Bunun yakın bir zamanda Bayan Keiser'e verilmesi gerekiyordu... Ancak ben bir anda defterde beş sayfanın eksik olduğunu fark ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020109
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020109,
					"content": "Bu beş sayfa farklı ayların kayıtlarındandı ve hepsinde de büyük giderler yazılıydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020110
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020110,
					"content": "Son inceleme sırasında eksik olduklarını fark ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020111
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020111,
					"content": "Eğer onları yanlışlıkla başka bir yere koymadıysam veya hiç kayıt altına almadıysam... O zaman büro giderlerini hesapladığımda nasıl bu sonuca ulaştım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020112
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020112,
					"content": "Ah, düşünemiyorum bile. Gerçekten onları yazmayı unuttuysam Bayan Cadme benden son on yıllık defterleri bulup hepsini tek tek kontrol etmemi ister.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020113
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020113,
					"content": "Bu oldukça ciddi bir durum gibi görünüyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020114
					]
				},
				{
					"id": 240020114,
					"content": "Evet, öyle! Eğer bu belgeler yazılmadıysa ya da kaybolduysa önümüzdeki ay birkaç ofis birden finansman sorunlarıyla karşı karşıya kalacak demektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020115
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020115,
					"content": "Şansa bak... Dün tüm gece ayakta kalıp defteri yazmakla uğraştığımı ve bugün de alıp Saraya getirdiğimi hatırlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020116
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020116,
					"content": "Buraya geldiğim zaman büyük bir martı sürüsü vardı, onlardan korkunca ellerim bir anda gevşedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020117
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020117,
					"content": "*iç çeker* Sanırım belgeleri tam o sırada kaybettim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020118,
						240020119
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020118,
					"content": "Aramana yardım edeceğim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020120
					]
				},
				{
					"id": 240020120,
					"content": "Yardım mı edeceksin? Harika! Hadi ilk bu yoldan gidelim o zaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020121
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020121,
					"content": "Bilgiler çok gizli falan değil, o yüzden sayfaları toplarken bir şeyler görür ederim diye endişelenmene gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020122
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020122,
					"content": "Ah, tabii ya! O sırada bir de Memur Muirne ile karşılaşmıştım! Martıları benim için o kovalamıştı hatta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020123
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020123,
					"content": "Defteri görüp görmediğini sorabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020119,
					"content": "Hadi birlikte arayalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020120
					]
				},
				{
					"id": 240020106,
					"content": "Bir şeylerin kaybolması iyi bir şey mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020107
					]
				}
			]
		},
