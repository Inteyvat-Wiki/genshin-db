			"dialogs": [
				{
					"id": 240020401,
					"content": "Ah, aradığım belgeler bunlar! Ah, çok şükür, hepsi burada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020402
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020402,
					"content": "Neden hesaplamaları kafede yapıyordun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240020403
					]
				},
				{
					"id": 240020403,
					"content": "Ş-Şey, doğru hesapladığımdan emin olmak için çok fazla kahve içmem gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020404
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020404,
					"content": "Saraydaki tüm ofislerin giderleri burada. Aslında beş kişinin birlikte yapacağı bir iş bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020405
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020405,
					"content": "Ama benim dışımda ofiste çalışan herkes genelde ya geçici olarak başka ofislerden çağrılıyor, ya bir işe gönderiliyor ya da bazı ziyaretler gerçekleştiriyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020406
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020406,
					"content": "Yani giderleri hesaplamaya gelince iş bana kalıyor. Günlerce uyuyamıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020407
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020407,
					"content": "Sadece gider hesaplamaları değil, faturaları halletmek de bana kalıyor. Gözlerim bozuldu neredeyse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020408
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020408,
					"content": "Her neyse, o belgeleri bulduk neyse ki. Müsaadeniz olursa Bayan Isadora, size Saraya kadar eşlik etmek isterim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020409
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 240020409,
					"content": "Teşekkürler Memur Muirne. *iç çeker* Sen ve Gezgin şu son üç ayda karşılaştığım en iyi kişilersiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020410
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020410,
					"content": "Diğer herkes ya bana bağırıyor ya da beni çalışmam için zorluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240020411
					],
					"speakerTitle": "Isadora"
				},
				{
					"id": 240020411,
					"content": "Ah, hayır hayır, şikayet etmeyi bırakmam lazım. Geri dönsem iyi olacak yoksa Bayan Keiser yine bana bağıracak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Isadora"
				}
			]
		}
	]
}