			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Akashi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722830101,
					"content": "Öf. Bugün günümde değilim galiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830102
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830102,
					"content": "Sorun nedir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830103
					]
				},
				{
					"id": 722830103,
					"content": "Okçuluk eğitimi sonuçlarım gittikçe kötüleşiyor. Yemin ederim bir gün yanlışlıkla kendimi dizimden vuracağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830104
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830104,
					"content": "Niye böyle bir yerde okçuluk antrenmanı yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830105
					]
				},
				{
					"id": 722830105,
					"content": "Aman! Hep o Jibashiri'nin suçu. Bunu yapmamı o önerdi! Biliyor musun? Bazen hepsinin sadist olduğunu düşünüyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830106
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830106,
					"content": "Bu arada Müren Balığı yetiştiriciliği hakkında bir şeyler biliyor musun? Okçuluk konusunda geleceğimin pek parlak olmadığını düşünüyorum. O yüzden başka bir şey yapsam daha iyi olacak sanki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830107
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830107,
					"content": "İkisinin arasında bir bağlantı var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830108
					]
				},
				{
					"id": 722830108,
					"content": "Neyse ya, boş ver. Anlaşılan sen müren balığı yetiştiriciliğine dair hiçbir şey bilmiyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830109
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830109,
					"content": "Öncelikle birkaç müren balığı yavrusu yakalaman lazım ama o kadar küçük oluyorlar ki çıplak gözle zar zor görülüyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830110
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830110,
					"content": "Ben de okçular hedefleri çok uzaktan vurabildikleri için gözleri keskindir diye düşündüm. O nedenle birkaç deneyimli Jibashiri'ye görüşümü nasıl geliştirebileceğimi sordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830111
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830111,
					"content": "\"Eğitiminde aceleci olmamalısın Akashi. Tutarlı şekilde ilerlemek için önce sağlam bir temel oluşturmalısın.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830112
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830112,
					"content": "\"Müren balığı yavruları çok küçüktür ve hızlı hareket ederler. Bu yüzden sabit hedeflerle başlamalısın. Tabii bu hedefler çok yakın da olmamalı. Yanlış yapmak istemiyorsan yaptığın işi ciddiyetle yapmalısın.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830113
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830113,
					"content": "Ben de söylediklerine uydum. Burada okçuluk antrenmanı yaptım ama hedefi bir kere bile vuramadım. Vurmak mümkün mü acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830114
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830114,
					"content": "Sen denemek ister misin? Şu taş platforma çıkarsan hedefleri görebilirsin. Hepsini vurursan başarmış olacaksın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830115
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830115,
					"content": "Tabii, bana bırak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830116
					]
				},
				{
					"id": 722830116,
					"content": "Peki o zaman. Gerçek yeteneğini göster bakalım. İşin bitince yanıma gel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akashi"
				}
			]
		},
		{
			"id": 7228302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
