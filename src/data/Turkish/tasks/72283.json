			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Akashi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722830201,
					"content": "Hımm. Demek sen de vuramadın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830202
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830202,
					"content": "Bugün günümde değilim galiba. Nasıl oluyorsa bir şeyler ilerlememe engel oluyor herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830203
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830203,
					"content": "Birkaç kere daha denemek ister misin? Sonuçta hedefler o müren balığı yavruları gibi kaçışacak değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830203
					],
					"speakerTitle": "Akashi"
				}
			]
		},
		{
			"id": 7228303,
			"completionStepIds": [
				7228303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7228303",
