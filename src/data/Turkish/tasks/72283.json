				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Akashi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722830301,
					"content": "Vay be! Başardın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830302
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830302,
					"content": "*iç çeker* Gerçekten profesyonel bir okçu gibiydin. Birkaç yıl daha çalışsam bile benim gibi düzgün eğitim almamış birinin senin seviyene erişebileceğini sanmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830303
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830303,
					"content": "Ayrıca her gün buraya antrenman yapmaya gelsem bile uzun zamandır canlı bir müren balığının zıpladığını görmedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830304
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830304,
					"content": "Bu arada müren balıklarını sever misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830305,
						722830306
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830305,
					"content": "Evet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830307
					]
				},
				{
					"id": 722830307,
					"content": "Öyle mi? Ben çok severim. O kadar çok ki bir gün müren balığı yetiştirmek bile isterdim. Sence de çok sevimli değiller mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830308
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830308,
					"content": "Tabii müren balıklarını tabağımda daha çok severim. Hem görünüşleri hem tatları güzel. Harika bir ikili!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830309
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830309,
					"content": "Konusu açılmışken... Sence yanlış şeye mi odaklanıyorum? Yani okçuluğa çalışmamın tek sebebi müren balığı yetiştirmek istemem. Onu da sadece müren balıklarını sevdiğim için istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830310
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830310,
					"content": "Sonuçta onları özgürce yaşarken görmeyi seviyorum. Yani yetiştirmeye çalışmam mantıklı değil sanırım. Anlatabiliyor muyum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830311
					],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830311,
					"content": "Neyse. Gösteri için teşekkürler. Lütfen bunları kabul et. İyi şanslar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akashi"
				},
				{
					"id": 722830306,
					"content": "Pek bana göre değiller.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830307
					]
				}
			]
		}
	]
}