			"dialogs": [
				{
					"id": 710830101,
					"content": "Ne? Cidden Yedi Yıldız Dizilimini bozdun mu? Off. Bunu haftalık rapora yazmam gerekecek galiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830102
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830102,
					"content": "Havalı olsun, tamam mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830103
					]
				},
				{
					"id": 710830103,
					"content": "*öksürür* Lütfen. Durum çok ciddi. Hatta o kadar ciddi ki ne kadar ciddi olduğuna Yedi Yıldız bizzat karar verecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830104
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830104,
					"content": "Yani rapor gönderildiğinde Yedi Yıldızdan biri bizzat seni durdurmak için gelebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830105
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830105,
					"content": "O zaman seni ben bile kurtaramam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830106
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830106,
					"content": "(Bir şey ima ettiğini hiç gizlemiyor...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830107
					]
				},
				{
					"id": 710830107,
					"content": "Korktun mu? Peki, işine devam et o zaman! Hâlâ seni bekleyen birileri var, biliyorsun değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muning"
				}
			]
		},
