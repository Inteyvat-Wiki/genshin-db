			"dialogs": [
				{
					"id": 710830201,
					"content": "Aşağısı nasıl? Başınıza bir şey geldi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830202,
						710830210
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830202,
					"content": "(Yaşadıklarını Muning'e anlatıyorsun.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830203
					]
				},
				{
					"id": 710830203,
					"content": "Hımm. Anladım. Cidden tehlikeliymiş. O zaman ne yazık ki Jinwu ve Zhiqiong'a göz kulak olmama yardım etmeni isteyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830204
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830204,
					"content": "Beni durdurman gerekmiyor mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830205
					]
				},
				{
					"id": 710830205,
					"content": "Evet, görevim o ama her seferinde çok hızlı kaçtığın için yakalayamıyorum. O yüzden durduramam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830206
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830206,
					"content": "O kadar hızlı koşmuyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830207
					]
				},
				{
					"id": 710830207,
					"content": "Hayır, koşuyorsun. Raporda öyle yazıyor. Raporda yazıyorsa doğrudur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710830208
					],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830208,
					"content": "Peki. Demek ki çok hızlıyım, pekala.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830209
					]
				},
				{
					"id": 710830209,
					"content": "Aynen öyle. O yüzden lütfen dikkatli ol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muning"
				},
				{
					"id": 710830210,
					"content": "Endişelenme, bir şey olmaz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710830211
					]
				},
				{
					"id": 710830211,
					"content": "Güzel, güzel. Her şey yolunda gittiği sürece Yedi Yıldız bana çok baskı yapmaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muning"
				}
			]
		}
	]
