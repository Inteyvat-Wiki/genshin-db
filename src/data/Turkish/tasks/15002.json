			"dialogs": [
				{
					"id": 150020201,
					"content": "#{NICKNAME}, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020202
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020202,
					"content": "Kinich! Seninle karşılaştığımız iyi oldu! Biz de seni arıyorduk tam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150020203,
					"content": "Selam. Seni tekrar görmek güzel.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020204
					]
				},
				{
					"id": 150020204,
					"content": "Doğrudan sadede geleceğim. Kabile büyüğümüz Trinidad'dan bir teklif kabul ettiğinizi duydum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020205
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020205,
					"content": "Ha! Şey, Bedel Ateşi Gecesi şeyi mi? Iıı... İlk tercihi sendin tabii de, işte... Off... Dışarıdan göründüğü gibi değil bak, yemin ederiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150020206,
					"content": "Sakin olun, sıkıntı yok. Sormamın sebebi başka. Trinidad'ın size karşı yüzde yüz dürüst davrandığını düşünmüyorum maalesef. Asıl niyeti Dağ Kralı sorununu kökten çözmek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020207
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020207,
					"content": "Kökten mi? Yani bu son Bedel Ateşi Gecesi mi olacak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150020208,
					"content": "Evet. Sizi kullanarak Dağ Kralı'nı Gece Krallığı'na göndermek istiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020209
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020209,
					"content": "Gece Krallığı'na mı? Yani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150020210,
					"content": "Ölüme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020211
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020211,
					"content": "Hop, hop, hop! Ciddi misin sen? Böyle ciddi suçlamalar başını belaya sokabilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150020212,
					"content": "Çok mu sert oldu? Peki, daha kibar anlatayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020213
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020213,
					"content": "Bir ihtimal belki tören sırasında Trinidad... Dağ Kralı'nı öldürmenizi umuyor olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020214
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020214,
					"content": "İyi de... Çok saçma! Dağ Kralı'nın kabilenizin zaferinin yaşayan bir simgesi olduğunu söylemişti bize!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150020215,
					"content": "O zaferin bir bedeli oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020216
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020216,
					"content": "Evet. Dağ Kralı zaferimizin yaşayan bir simgesi fakat bu zaferin bir bedeli oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020217
					],
					"speakerTitle": "Trinidad",
					"speakerSubtitle": "Kabile Büyüğü, Gök Kubbenin Evlatları"
				},
				{
					"id": 150020217,
					"content": "*iç çeker*... Nanna ilk kaybımız değil üstelik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020218
					],
					"speakerTitle": "Trinidad",
					"speakerSubtitle": "Kabile Büyüğü, Gök Kubbenin Evlatları"
				},
				{
					"id": 150020218,
					"content": "Yoldaşı Nanna yüzünden mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020219
					]
				},
				{
					"id": 150020219,
					"content": "Evet. Muhtemelen hayatını kaybeden son yoldaşımız da olmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020220
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020220,
					"content": "Yine de... Bunun tek çözümü Dağ Kralı'nı öldürmek mi? Biraz abartılı bir karar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150020221,
					"content": "Onu nasıl öldürmeyi planlıyor ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020222
					]
				},
				{
					"id": 150020222,
					"content": "Dağ Kralı'ndaki Hiçlik kirliliği biraz özel bir durum. Kirlilik onu o kadar uzun süredir tüketti ki onu tamamen bitirdi ve verdiği hasarın geri dönüşü yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020223
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020223,
					"content": "İçindeki bu şeytani güç hem onu delirtti hem de yüzyıllar boyunca onu hayatta tuttu. Yani bir bakıma eğer bedeninden tamamen temizlenirse Dağ Kralı nihayet huzur içinde istirahat edebilecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020224
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020224,
					"content": "Geçmiş törenlerde Hiçlik gücünün yaklaşık yarısını temizledik sadece. Bunun sebebi dengeyi korumak, onu hem hayatta hem uykuda tutmaktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020225
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020225,
					"content": "Trinidad ne kadarını temizlememizi istediğini söylemedi... Ama törenden önce konuşmak istediği detaylar olduğunu söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150020226,
					"content": "O halde yakında öğrenirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020227
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020227,
					"content": "... Eğer gerçekten Dağ Kralı'nı öldürmemizi isterse ne yapmalıyız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020228,
						150020229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150020228,
					"content": "Bence bu iş bizim boyumuzu aştı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020230
					]
				},
				{
					"id": 150020230,
					"content": "Şok oldunuz biliyorum ama şimdilik bunu bilmiyormuş gibi davranın. Trinidad ile buluştuktan sonra şefimizle görüşmeye vaktiniz kalır mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020231
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020231,
					"content": "Sizinle bir anlaşma yapmak istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020232
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020232,
					"content": "Ne anlaşması?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150020233,
					"content": "Bedeli gayet makul bir anlaşma. Eminim başka bir sürü sorunuz vardır ama onları daha sonra konuşuruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020234
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020234,
					"content": "Peki. Görüşürüz o zaman.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020235
					]
				},
				{
					"id": 150020235,
					"content": "Güzel. Görüşürüz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020229,
					"content": "Vazgeçmek için çok mu geç kaldık?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020230
					]
				}
			]
		},
