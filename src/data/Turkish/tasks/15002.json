			},
			"dialogs": [
				{
					"id": 150020401,
					"content": "Paimon nihayet Trinidad'ı neden reddettiğini anladı Kinich.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150020402,
					"content": "Ne planladığını biliyordun, değil mi? O yüzden bu sefer ateş taşıyıcı olmak istemedin, çünkü faydasından çok zararı var. Mora olayı bahaneydi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150020403,
					"content": "Faydasından çok zararı olduğu doğru. Ama verdiğim cevap yalnızca bahaneden ibaret değildi. Bu sıra dışı sorunu çözmek sıra dışı bir bedel gerektiriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020404
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020404,
					"content": "Bir planın mı var yani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020405
					]
				},
				{
					"id": 150020405,
					"content": "Üzerinde çalışıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020406
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020406,
					"content": "Öyle mi? Anlat bakalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150020407,
					"content": "Birazdan anlatacağım. Bana sormak istediğin bir soru yok muydu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020408
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020408,
					"content": "Ha, doğru... Neydi? Hah! Tamam! Ajaw konusunu konuşmamız lazım, iyice çığırından çıktı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150020409,
					"content": "Katılıyorum... Nerede şu an?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020410
					]
				},
				{
					"id": 150020410,
					"content": "Bir sorunu olduğu konusunda ben de hemfikirim. Disipline ihtiyacı var, o yüzden hoca tuttum ona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020411
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020411,
					"content": "Hoca mı tuttun? Ah, Paimon onun azar yediğini görmeyi o kadar çok isterdi ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150020412,
					"content": "Neyse, Ajaw ile karşılaştığımızda ikinizin Hiçlikle ilgili bir konuyu araştırdığınızı söyledi... Dağ Kralı durumuyla bir bağlantısı var mı bunun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150020413,
					"content": "Evet. Üzerinde çalıştığım plan bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020414
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020414,
					"content": "Sürüngen avcısıyım ama bazen Hiçliği de avlıyorum. Bir keresinde birkaç mor iblis köpeği kovalarken kazara gizli bir alana girdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020415
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020415,
					"content": "Sonrasında araştırma yaptım. Bu alanlara \"Canavar Yarığı\" deniyormuş ve bunlar farklı boyutlarda olabiliyormuş. Mor köpekler de onların içinden geliyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020416
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020416,
					"content": "Yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150020417,
					"content": "Yani eğer bu Canavar Yarıklarından birini bulsak, içindeki canavarları temizlesek ve Dağ Kralı'nı bu yarığa koysak... Hem yaşamaya devam eder hem de kabileye tehdit olmaktan çıkar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020418
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020418,
					"content": "Vay be! Çılgınca bir fikirmiş... İşe yarar mı ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150020419,
					"content": "Riskli tabii. Denklemde pek çok bilinmeyen var. Örneğin yarıkta belirli bir süre geçirdikten sonra Dağ Kralı'nın durumu kötüleşebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020420
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020420,
					"content": "Yine de tam olarak böyle bir çözüme ihtiyacımız var, geçici bir önlem olsa da fark etmez. Bu sorunun kabilemizde yarattığı kargaşayı kendi gözlerinizle gördünüz. Bunun böyle olacağı çok önceden beri belliydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020421
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020421,
					"content": "Şefimiz ne olursa olsun Dağ Kralı'nı hayatta tutmak konusunda kararlı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020422
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020422,
					"content": "Paimon anlayabiliyor... Olay aslında Dağ Kralı'ndan ziyade kendi kültürünüzü ve mirasınızı korumak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150020423,
					"content": "Evet ama öte yandan Trinidad gibi hem şimdi hem de gelecekte değer verdiği kişileri korumayı daha önemli görenler de var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020424
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020424,
					"content": "Bu görüşünde de oldukça haklı. Görkemli bir tarihin son kalıntılarını korumaya çalışmak iyi güzel ama bunun bedeli yoldaşlarının hayatıyla mı ödenmeli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020425
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020425,
					"content": "Kimse bunun adil bir takas olduğunu söyleyemez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020426
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020426,
					"content": "Haklısın, doğru cevabı bulmak hiç kolay değil... Bu konuyu şimdilik bir kenara koyalım ve senin planını uyguladığımızı varsayalım. Bu bahsettiğin Canavar Yarığını nasıl bulmayı düşünüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150020427,
					"content": "Çünkü bizim gördüğümüz kadarıyla köpekler bize saldırmak istediğinde yarıkları açıyor, tam tersini yapamıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150020428,
					"content": "Sanırım bir yolunu biliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020429
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020429,
					"content": "Gerçekten yapacak mısın bunu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020430
					]
				},
				{
					"id": 150020430,
					"content": "Daha iyi bir fikriniz var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020431
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020431,
					"content": "Şu an yok, ama işte... Hiçliğin gücünü kendi amaçlarımız için kullanmanın sonu iyi bitmeyecek gibi bir his var içimizde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150020432,
					"content": "Sonuçta Dağ Kralı'nı en başta canavara dönüştüren de Hiçlikti. İnsanlar kafayı sıyırdığını düşünecek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150020433,
					"content": "İşin sonu iyi bitmezse ödeyeceğimiz bedel o olur. Dünyada her şeyin bir bedeli vardır sonuçta... Ateş Getiren Yupanqui, Bedel Ateşini çaldığında bedeli ağır olmuş mesela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020434
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020434,
					"content": "Dağ Kralı'nın dengesiz patlamaları kabile içindeki gerilimi had safhaya getirdi. Bu sorun en kısa zamanda çözülmezse topluca bir açmazda kalacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020435
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020435,
					"content": "Peki... O zaman bizimle yapmak istediğin şu \"anlaşma\" nedir? Hiçlik gücünü kullanma konusunda uzman sayılmayız sonuçta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020436
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150020436,
					"content": "Sizden tek istediğim insanları benden uzak tutmanız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020437
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020437,
					"content": "Her gün insanlar yanıma gelip beni ateş taşıyıcı olmaya ikna etmeye çalışıyor. Enerjimi onlara harcayamam şu an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020438
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020438,
					"content": "Bana yardım ederseniz karşılığında size bir hediyem olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020439
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020439,
					"content": "Oo, ne tür bir hediye?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020440
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150020440,
					"content": "Emeklerinize değecek bir hediye diyebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020441
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020441,
					"content": "Tamam da insanları nasıl senden uzak tutacağız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020442
					]
				},
				{
					"id": 150020442,
					"content": "Yaptığınızı yapmaya devam edin. Kabile halkıyla kaynaşın ki insanlar yeni bir ateş taşıyıcımız olduğunu kabullensinler artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020443
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020443,
					"content": "Böylece sürekli birileri gelip törene katılayım diye yalvarmaz, ben de Canavar Yarığını çağırmanın bir yolunu bulmaya odaklanabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020444
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020444,
					"content": "Ondan sonra tören günü geldiğinde de Dağ Kralı'nı yeni evine taşırız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020445
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020445,
					"content": "Hâlâ çok çılgınca bir fikir gibi geliyor... Senin gibi korkusuz biri için bile tehlikeli bir plan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020446
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150020446,
					"content": "Ayrıca işe yaradı diyelim, ya bu çözüm ne Şef Wayna'nın ne de Trinidad'ın hoşuna gitmezse? O zaman ne yapacağını düşündün mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020447
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150020447,
					"content": "O zaman en azından ikisi de aynı tarafta buluşmuş olur, karşılarına beni alırlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020448
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020448,
					"content": "Kabilenin benim gibi bir Sürüngen avcısından ziyade onlar gibi liderlere ihtiyacı var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020449
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020449,
					"content": "Her halükarda bu işten Mora kazanamayacaksın galiba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020450
					]
				},
				{
					"id": 150020450,
					"content": "Heh. Anlaştık sayıyorum o zaman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020451
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020451,
					"content": "Deneyelim bakalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020452
					]
				},
				{
					"id": 150020452,
					"content": "Evet. Kim bilir, belki önümüzdeki üç gün içinde bu soruna daha iyi bir çözüm buluruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020453
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150020453,
					"content": "Süper. O halde önümüzdeki günleri lütfen kabilede geçirin ve her fırsatta yardım elinizi uzatın. Eminim herkes yeni ateş taşıyıcımızla tanışmaktan büyük mutluluk duyacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020454
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020454,
					"content": "İkimize de iyi şanslar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kinich"
				}
			]
		}
	]
}