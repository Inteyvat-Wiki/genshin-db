			"dialogs": [
				{
					"id": 150020101,
					"content": "Dönmüşsünüz yüce savaşçılar. İyi dinlenebildiniz mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020102
					],
					"speakerTitle": "Trinidad"
				},
				{
					"id": 150020102,
					"content": "Şey... Gayet iyiydi, evet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150020103,
					"content": "Sevindim. Benim tarafımda da işler sorunsuz ilerliyor. Kabilemizin pek çok büyüğü kahramanlık hikayelerinizi duymuş, şefimiz de dahil. Hepsi sizin hakkınızda iyi şeyler söylüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020104
					],
					"speakerTitle": "Trinidad"
				},
				{
					"id": 150020104,
					"content": "Törenin Mal{RUBY#[D]Bedel Ateşi}ipo adını taşıyan kişi tarafından gerçekleştirilmesi gerektiğini düşünenler var tabii ama onlar eski kafalı. Artık çağa ayak uydurmamız lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020105
					],
					"speakerTitle": "Trinidad"
				},
				{
					"id": 150020105,
					"content": "Ki zaten Kinich töreni yapmak istemiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150020106,
					"content": "Aynen öyle. O yüzden şimdi törenin ince detaylarını konuşalım sizinle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020107
					],
					"speakerTitle": "Trinidad"
				},
				{
					"id": 150020107,
					"content": "Ateş yakma kısmını dün konuşmuştuk. Bir sonraki adım Dağ Kralı'nın arındırılması.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020108
					],
					"speakerTitle": "Trinidad"
				},
				{
					"id": 150020108,
					"content": "O nasıl oluyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020109
					]
				},
				{
					"id": 150020109,
					"content": "Gayet basit, Kutsal Alevi kullanmanız yeterli. Biz daha önce pek çok kez yaptık, çok rutin bir süreç. Eminim siz de bir sorun yaşamazsınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020110
					],
					"speakerTitle": "Trinidad"
				},
				{
					"id": 150020110,
					"content": "Önemini vurgulamak istediğim bir nokta var ama. Mümkün olduğunca çok Hiçlik enerjisi yakmalısınız. Ne kadar enerji temizlersek Dağ Kralı o kadar uzun süre uykuda kalır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020111
					],
					"speakerTitle": "Trinidad"
				},
				{
					"id": 150020111,
					"content": "\"Uykuda\" demek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150020112,
					"content": "Evet. Önceki yıllarda ateş taşıyıcılar yeterli miktarda Hiçlik enerjisi temizleyemedi genelde. Bu töreni belirli aralıklarla düzenlememizin sebebi de bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020113
					],
					"speakerTitle": "Trinidad"
				},
				{
					"id": 150020113,
					"content": "Fakat anladığım kadarıyla Hiçliğe karşı savaşmakta tecrübelisin. Üstelik dün Kutsal Alevi hiç sorun yaşamadan kullanmayı da başardın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020114
					],
					"speakerTitle": "Trinidad"
				},
				{
					"id": 150020114,
					"content": "Yardımınla eminim ki bu sefer Dağ Kralı'nın bedeninde kalan tüm Hiçlik enerjisini temizleyeceğiz ve bitmek bilmeyen bu tehdidi çok uzun yıllar boyunca kabilemizden uzak tutacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020115
					],
					"speakerTitle": "Trinidad"
				},
				{
					"id": 150020115,
					"content": "#{NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150020116,
					"content": "Anladım. Bilmemiz gereken başka bir şey var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020117
					]
				},
				{
					"id": 150020117,
					"content": "Bu anlattıklarım seni korkutmadı mı hiç? Gerçekten kendine çok güveniyorsun, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020118
					],
					"speakerTitle": "Trinidad"
				},
				{
					"id": 150020118,
					"content": "Bilmeniz gerekenler bu kadardı. Tören üç gün sonra. Hazır olduğumuzda gelip sizi alırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020119
					],
					"speakerTitle": "Trinidad"
				},
				{
					"id": 150020119,
					"content": "O sırada isterseniz köyümüzü dolaşabilirsiniz. Halkımızla kaynaşmanız kabile büyüklerimizin hoşuna gider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020120
					],
					"speakerTitle": "Trinidad"
				},
				{
					"id": 150020120,
					"content": "Hatta birkaçına işlerinde yardımcı olursanız daha da iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020121
					],
					"speakerTitle": "Trinidad"
				},
				{
					"id": 150020121,
					"content": "Şimdi bir de angarya işler mi çıktı başımıza? Ücreti biraz daha artırsaymışız keşke...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150020122,
					"content": "Haha, ufak bir öneriydi yalnızca. Halkımızın saygısını kazanmanıza yardımcı olur, ayrıca kudretli kahramanlar olarak bunu hak ettiğinizi düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020123
					],
					"speakerTitle": "Trinidad"
				},
				{
					"id": 150020123,
					"content": "Ben önümüzdeki birkaç gün buralarda olacağım. Sorunuz olursa beni nerede bulabileceğinizi biliyorsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Trinidad"
				}
			]
		},
