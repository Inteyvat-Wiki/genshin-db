			"dialogs": [
				{
					"id": 150020301,
					"content": "Hah, geldiniz demek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020302
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020302,
					"content": "Kinich! Trinidad dedi ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150020303,
					"content": "Tahmin edebiliyorum. Yüzlerinizden belli oluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020304
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020304,
					"content": "#{NICKNAME} ile Paimon mu o? Geldiğinizde karşılayamadım, kusuruma bakmayın. Şef olarak görevimdi aslında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020305
					],
					"speakerTitle": "Wayna",
					"speakerSubtitle": "Gök Kubbenin Evlatlarının Şefi"
				},
				{
					"id": 150020305,
					"content": "Merhaba Şef Wayna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150020306,
					"content": "Trinidad'dan haberinizi dün aldım, o yüzden sizinle kısa bir sohbet etmek için Kinich'ten sizi çağırmasını rica ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020307
					],
					"speakerTitle": "Wayna",
					"speakerSubtitle": "Gök Kubbenin Evlatlarının Şefi"
				},
				{
					"id": 150020307,
					"content": "Çok sağ olun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020308
					]
				},
				{
					"id": 150020308,
					"content": "Hehe... Kinich size durumu anlatmış sanırım, ben doğrudan sadede geleceğim. Öncelikle önümüzdeki Bedel Ateşi Gecesi için ateş taşıyıcılar olmanızı koşulsuz destekliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020309
					],
					"speakerTitle": "Wayna",
					"speakerSubtitle": "Gök Kubbenin Evlatlarının Şefi"
				},
				{
					"id": 150020309,
					"content": "Fakat sizden Dağ Kralı'nın güvenliğini sağlamak için gerekli adımları atmanızı istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020310
					],
					"speakerTitle": "Wayna",
					"speakerSubtitle": "Gök Kubbenin Evlatlarının Şefi"
				},
				{
					"id": 150020310,
					"content": "Kabilemizdeki her çocuk kahramanlarımızın öykülerini dinleyerek büyür. Gerek Ateş Getiren Yupanqui olsun gerek Hiçliğe karşı savaşan Burkina ve Dağ Kralı olsun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020311
					],
					"speakerTitle": "Wayna",
					"speakerSubtitle": "Gök Kubbenin Evlatlarının Şefi"
				},
				{
					"id": 150020311,
					"content": "Bunlar bizim tarihimiz, mirasımız, gurur kaynağımızdır, inancımızın temelidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020312
					],
					"speakerTitle": "Wayna",
					"speakerSubtitle": "Gök Kubbenin Evlatlarının Şefi"
				},
				{
					"id": 150020312,
					"content": "Dağ Kralı'nı öldürmek ruhumuzu yok etmek olur... Gece Krallığı'nda atalarımızın yüzüne bakmaya asla cüret edemem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020313
					],
					"speakerTitle": "Wayna",
					"speakerSubtitle": "Gök Kubbenin Evlatlarının Şefi"
				},
				{
					"id": 150020313,
					"content": "Nanna'nın ölümü büyük bir trajediydi kuşkusuz, aldığı kararlardan ötürü Trinidad'ı da suçlamıyorum. Yine de Dağ Kralı'na zarar gelmesine göz yumamam. Kimliğimizin kökenlerini tehlikeye atar bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020314
					],
					"speakerTitle": "Wayna",
					"speakerSubtitle": "Gök Kubbenin Evlatlarının Şefi"
				},
				{
					"id": 150020314,
					"content": "Saygıdeğer konuklarım, lütfen bu konuyu ciddiyetle bir değerlendirin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020315
					],
					"speakerTitle": "Wayna",
					"speakerSubtitle": "Gök Kubbenin Evlatlarının Şefi"
				},
				{
					"id": 150020315,
					"content": "İki tarafın da memnun kalacağı bir orta yol yok mudur?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020316
					]
				},
				{
					"id": 150020316,
					"content": "Vardır belki. Fakat yıllar boyunca durumu kontrol altında tutma çabalarımıza rağmen biz bir çözüm bulamadık. Şu an sizin düşüncenizi merak ediyorum açıkçası.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020317,
						150020319,
						150020321,
						150020323
					],
					"speakerTitle": "Wayna",
					"speakerSubtitle": "Gök Kubbenin Evlatlarının Şefi"
				},
				{
					"id": 150020317,
					"content": "Talebinizi onurlandırmaya daha yakınım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020318
					]
				},
				{
					"id": 150020318,
					"content": "Fikrinin kesinleşmediğini seziyorum fakat yine de sözlerin beni rahatlattı. Törene üç gün kaldı. Umarım bu günler sana ve kararına netlik kazandırır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020326
					],
					"speakerTitle": "Wayna",
					"speakerSubtitle": "Gök Kubbenin Evlatlarının Şefi"
				},
				{
					"id": 150020326,
					"content": "Kinich, geçen şey demiştin ya hani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150020327,
					"content": "Gelin konuşurken bir yandan yürüyelim. Size kabileyi göstereyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020328
					],
					"speakerTitle": "Kinich"
				},
				{
					"id": 150020328,
					"content": "Olur tabii. Paimon'un temiz havaya ihtiyacı vardı zaten...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150020319,
					"content": "Trinidad ile yaptığım anlaşmayı onurlandırmaya daha yakınım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020320
					]
				},
				{
					"id": 150020320,
					"content": "Açıkçası bunu endişe verici buluyorum fakat eminim etraflıca düşünmek için daha fazla vakte ihtiyacın vardır. Neyse ki törene henüz üç gün var. Umarım bu günler sana ve kararına netlik kazandırır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020326
					],
					"speakerTitle": "Wayna",
					"speakerSubtitle": "Gök Kubbenin Evlatlarının Şefi"
				},
				{
					"id": 150020321,
					"content": "Düşünmek için vakte ihtiyacım var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020322
					]
				},
				{
					"id": 150020322,
					"content": "Anlıyorum. Törene üç gün var. Umarım bu günler sana ve kararına netlik kazandırır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020326
					],
					"speakerTitle": "Wayna",
					"speakerSubtitle": "Gök Kubbenin Evlatlarının Şefi"
				},
				{
					"id": 150020323,
					"content": "Paimon, gel biz bu gece seninle başka bir kabileye geçelim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150020324
					]
				},
				{
					"id": 150020324,
					"content": "Kaçmak çözüm değil ki... Bu konuyu düşünmeye ihtiyacın var senin. Merak etme, kafa kafaya verirsek bir çözüm buluruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150020325,
					"content": "Sağ olun. Törene üç gün var. Umarım bu günler sana ve kararına netlik kazandırır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150020326
					],
					"speakerTitle": "Wayna",
					"speakerSubtitle": "Gök Kubbenin Evlatlarının Şefi"
				}
			]
		},
