			},
			"dialogs": [
				{
					"id": 210000501,
					"content": "Oh... Bu mesajı yazacağım diye tüm gece uyumadım. O şişeyi kaybetseydik tekrar yazmak zorunda kalırdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000502
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210000502,
					"content": "Vay, gece kuşu seni. Dertlerin bitmiyor bir türlü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000503,
					"content": "Şey... Pek derdim yok aslında. Sadece nasıl olgunlaşacağımı öğrenmek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000504
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210000504,
					"content": "Pek çok kaynağa baktım, bir sürü kitap okudum ama okudukça kafamda daha çok soru işareti oluştu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000505
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210000505,
					"content": "Hehe, bu yüzden ben de mesaja anlamadığım tüm soruları yazdım. Umarım cevap alabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000506
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210000506,
					"content": "Şişemizi gönderelim hadi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Minik Meng"
				}
