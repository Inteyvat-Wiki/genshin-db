			"dialogs": [
				{
					"id": 210000101,
					"content": "*iç çeker* Yapabilir miyim ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000102
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210000102,
					"content": "Sorun nedir Minik Meng?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000103
					]
				},
				{
					"id": 210000103,
					"content": "Ah, sen misin Gezgin? Nasılsın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000104
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210000104,
					"content": "Üzgün gibisin Minik Meng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000105,
					"content": "Ne oldu? Diğer çocuklar seninle korsancılık oynamayı mı bıraktı yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000106,
					"content": "Ha? Yok. Minik Lulu ve Minik Fei az önce eve döndüler de.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000107
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210000107,
					"content": "Şey... Ben biraz daha kalıp tek başıma buralarda dolanmak istedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000108
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210000108,
					"content": "Annenler endişelenmez mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000109,
					"content": "Onlar çalışıyorlardır hâlâ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000110
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210000110,
					"content": "Ama şimdi bunu konuşmayalım. Sana bir şey sorabilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000111,
						210000112
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210000111,
					"content": "Neymiş bakalım sorun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000114
					]
				},
				{
					"id": 210000114,
					"content": "Şey... Hakkında çok hikaye duydum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000115
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210000115,
					"content": "Çok yer gezmiş, çok şey görmüşsün. Belki aradığım cevabı bulabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000116
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210000116,
					"content": "Ahh, ciddileşiyoruz demek. Nedir sorun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000117,
					"content": "Acaba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000118
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210000118,
					"content": "Nasıl \"olgun\" olunur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000119,
						210000122
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210000119,
					"content": "Zamanla olgunlaşırsın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000120
					]
				},
				{
					"id": 210000120,
					"content": "Yani yaşımız ilerledikçe mutlaka olgunlaşıyor muyuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000121
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210000121,
					"content": "Ama o zaman çok vakit almaz mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000124
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210000124,
					"content": "Şehir dışına çıkmak istersen sana eşlik edebiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210000125,
					"content": "Şey... Sizi rahatsız etmek istemem. Sırf şehir dışına çıktım diye özel bir deneyim yaşayacağımın da garantisi yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000126
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210000126,
					"content": "Onun yerine sizden başka bir şey isteyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000127
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210000127,
					"content": "Çözemeyeceğimiz sorunlar olduğunda onları yazıya döküp kağıdı sürüklenen bir şişeye koyabileceğimizi, şişeyi nehre bırakınca da sorunların su gibi akıp gittiğini duymuştum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000128
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210000128,
					"content": "Böylece dert tasa kalmazmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000129
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210000129,
					"content": "Ama dışarıda her yeri canavarlar sarmış. Tek başıma gidersem güvende olmam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000130
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210000130,
					"content": "Ben şişeyi bırakırken beni korur musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000131,
						210000132
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210000131,
					"content": "Tabii ki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000133
					]
				},
				{
					"id": 210000133,
					"content": "Çok teşekkürler! Merak etmeyin, biraz birikimim var. Karşılığını öderim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000134
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210000134,
					"content": "Gidelim o zaman. Önce Bishui Nehri'ne inelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210000132,
					"content": "İş üstündeyim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000133
					]
				},
				{
					"id": 210000122,
					"content": "Bazı özel deneyimler yaşamalısın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000123
					]
				},
				{
					"id": 210000123,
					"content": "Özel deneyimler... Hiç Liyue Limanı'nın dışına adım atmadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000124
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210000112,
					"content": "Maalesef oynayacak vaktim yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000113
					]
				},
				{
					"id": 210000113,
					"content": "Hahaha, o oyunu sadece Minik Lulu ve Minik Fei'yle oynuyorum. Onlar burada yokken oynamam zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000114
					],
					"speakerTitle": "Minik Meng"
				}
			]
		},
