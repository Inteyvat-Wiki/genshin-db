			"dialogs": [
				{
					"id": 210000301,
					"content": "Ne? Böyle şeyler de mi varmış? Korkunçtu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000302
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210000302,
					"content": "Çok teşekkürler! Hadi devam edelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000303
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210000303,
					"content": "Bir dakika. Sürüklenen şişem nerede? Az önce elimdeydi, şimdi yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000304
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210000304,
					"content": "O... Yalancı Çiçekle dövüşürken mi düşürdüm acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000305
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210000305,
					"content": "Lütfen onu bulmama yardım edin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Minik Meng"
				}
			]
		},
