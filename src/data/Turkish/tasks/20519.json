			"dialogs": [
				{
					"id": 205190501,
					"content": "Senin... Senin için ne yapabilirim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190502
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 205190502,
					"content": "Hâlâ Rahibe Victoria'nın cevap vermesini bekliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190503
					],
					"speakerTitle": "Jilliana"
				},
				{
					"id": 205190503,
					"content": "Bu olay... Ne olursa olsun sonuçlarına hazırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jilliana"
				}
