				"points": []
			},
			"dialogs": [
				{
					"id": 205190301,
					"content": "Şu Hazine Avcıları... Ah, kusura bakma! Bir şey mi oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190302
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205190302,
					"content": "Mondstadt çevresinde Hazine Avcıları fink atıyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190303
					]
				},
				{
					"id": 205190303,
					"content": "Hazine Avcıları mı? Biz de bir grubun peşindeyiz. O tilki sürüsü ne hadle Mondstadt'ta gezebiliyor? Niyetlerini bilmiyor oluşumuz da cabası...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190304
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205190304,
					"content": "Sebebi ne olursa olsun, niyetlerinin iyi olmadığı kesin. İnsan gücümüzün büyük kısmını onlarla baş etmeye ayırdık, yani raporunla ilgilenecek kadar insan gücümüz şimdilik yok. Kusura bakma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190305
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 205190305,
					"content": "Yine de raporunu not alıyorum. Hazine Avcıları ile işimiz bitince üstlerime ileteceğim. Bize bildirdiğin için tekrardan çok teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huffman"
				}
			]
		},
		{
			"id": 2051904,
