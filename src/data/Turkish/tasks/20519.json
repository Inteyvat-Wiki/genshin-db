					"Vile"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205190401,
					"content": "Hâlâ hazırlanıyor musun? Sorun değil. Hazır olunca yola çıkarsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190402,
						205190406
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190402,
					"content": "Kim bu beyefendi bu arada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190403
					]
				},
				{
					"id": 205190403,
					"content": "Ne kadar sorsan da söylemem. Bizim sektörde işler böyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190404
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190404,
					"content": "Herhangi bir bilgi paylaşıyorsak bu ancak mecbur olduğumuz içindir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190405
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190405,
					"content": "Şunu bir düşün mesela: Az önce söylediklerimin hangisi \"mecbur olduğum için paylaştığım bilgiler\" kategorisine girer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190406,
					"content": "Amacınız ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205190407
					]
				},
				{
					"id": 205190407,
					"content": "O beyefendinin amacı... Tahmin edemiyorum. Ama o da Mondstadt'ı korumak istiyor, buna inanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190408
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190408,
					"content": "Şöyle söyleyeyim, o bile bunca şeyi sırf eğlence olsun diye yapmazdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205190409
					],
					"speakerTitle": "Vile"
				},
				{
					"id": 205190409,
					"content": "Hımm, hayır. Böyle şeyler hakkında konuşmasam daha iyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vile"
				}
			]
		},
