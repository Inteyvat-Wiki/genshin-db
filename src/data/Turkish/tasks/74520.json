			"dialogs": [
				{
					"id": 745200401,
					"content": "#Aa, {NICKNAME}. Seni burada görmeyi beklemiyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200402,
						745200403
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200402,
					"content": "Görüşmeyeli uzun zaman oldu Eula.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200404
					]
				},
				{
					"id": 745200404,
					"content": "Rutin bir devriyedeyim. Ama bana kalırsa bu, savaş formumu korumamı sağlayan gerekli bir aktivite.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200405
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200405,
					"content": "Mondstadt son zamanlarda görece huzurlu günler yaşıyor ve Keşif Bölüğünün harekete geçmesini gerektirecek neredeyse hiçbir tehdit olmadı. Dolayısıyla herkes biraz rahatladı tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200406
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200406,
					"content": "İş ve yaşam dengesi iyi bir şeydir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200407
					]
				},
				{
					"id": 745200407,
					"content": "Haklısın ama Ekip Komutanı olarak savaş gücümü her zaman yüksek tutmalıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200408
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200408,
					"content": "Ne de olsa düşmanlarımızın kılıçları barış zamanında körelmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200409
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200409,
					"content": "Bu nedenle, paslanmamak için devriyeler arasında kılıç kullanma becerilerime çalışabileceğim sessiz yerler ararım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200410,
						745200411
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200410,
					"content": "Öyleyse vakit geldi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200412
					]
				},
				{
					"id": 745200412,
					"content": "Hımm? Ne ilginç bir istek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200413
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200413,
					"content": "Ama ben çok hızlı hareket ederim. Kameranın bana yetişebileceğinden emin misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200414,
						745200415
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200414,
					"content": "Sen normal hızında ilerle yeter!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200416
					]
				},
				{
					"id": 745200416,
					"content": "Özgüvenli olman hoşuma gitti. Öyleyse var gücümle ilerleyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200417
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200417,
					"content": "Şimdi dikkatle izle. Dalgalar bir anda yükselip alçalıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eula"
				},
				{
					"id": 745200415,
					"content": "Ben seni kadrajın içinde tutarım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200416
					]
				},
				{
					"id": 745200411,
					"content": "Bir fotoğrafını çekeyim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200412
					]
				},
				{
					"id": 745200403,
					"content": "Görevde misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200404
					]
				}
			]
		}
	]
