				"points": []
			},
			"dialogs": [
				{
					"id": 751880101,
					"content": "Şu tarlalara gidip benim <color=#00E1FFFF>üç küçük Sürüngenim</color> orada mı diye bakar mısın? Lütfen onları bana geri getir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paqarin"
				}
			]
		},
		{
			"id": 7518802,
			"completionStepIds": [
				7518802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7518802",
							"2"
						],
						"stepId": 7518802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paqarin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751880201,
					"content": "Hey, sen! Evet, sana diyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880202
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880202,
					"content": "Ne kadar da dinçsin, koşma hızın da iyi... Epey güçlü olduğun belli, spor yapıyorsun sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880203
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880203,
					"content": "Bereket Kolektifi savaşçılarından biri misin? Yoksa başka bir kabileden misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880204,
						751880205
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880204,
					"content": "Ben yoldan geçen bir maceracıyım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751880206
					]
				},
				{
					"id": 751880206,
					"content": "Demek öyle, bu kötü oldu. *iç çeker* Neyse, sanırım tam ihtiyacın olduğunda yardım edecek birinin ortaya çıkması sadece rüyalarda görebileceğin türden bir şans.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880207
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880207,
					"content": "Ne oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751880208
					]
				},
				{
					"id": 751880208,
					"content": "Şey, burada bir çiftliğim var, sen de görmüşsündür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880209
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880209,
					"content": "Şimdiye kadar çiftliğimi hep kendi başıma idare ettim ama son zamanlarda şansım yaver gitmiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880210
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880210,
					"content": "Birkaç gün önce kabileden bir savaşçıyla güreşirken sırtımı incittim. Biliyorum, çok saçma bir hareketti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880211
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880211,
					"content": "Bu durum yüzünden, bırak babama yeni tarlaları temizlemesinde yardım etmeyi, kendi çiftliğimin işlerini bile halledemiyorum. Doğrusunu söylemek gerekirse, şu an yürümek bile acı veriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880212
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880212,
					"content": "Tam da birkaç günlüğüne yardım edecek birini tutmayı düşünüyordum ki sen çıkageldin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880213
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880213,
					"content": "Meğer sadece buradan geçiyormuşsun, yazık oldu. Çiftçilik her gün düzenli çalışma gerektirir, yoksa mahsulüm heba olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880214
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880214,
					"content": "Ama şu anda ta kabileye kadar gidip birini bulacak dermanım yok. *iç çeker* Yetiştirdiğim birkaç küçük Tatankazor dışında yardım edecek kimsecikler yok buralarda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880215
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880215,
					"content": "O küçük baş belaları da bu aralar azıttı. Üçü birden tarlalarda keyif çatıyor, yanıma bile uğramıyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880216
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880216,
					"content": "Bana bir iyilik yapıp onları geri getirebilir misin? Yürümekte çok zorlanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880217
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880217,
					"content": "Tabii ki, hiç sorun değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751880218
					]
				},
				{
					"id": 751880218,
					"content": "Sağ ol, gerçekten minnettarım. Genelde çok iyi huyludurlar ve tarlada çalışırken bana arkadaşlık ederler. Bu aralar onlara ne olduysa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751880219
					],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880219,
					"content": "Onlara seslendiğinde eminim ki... Yani, öyle umuyorum ki o üç küçük Sürüngen kendiliğinden geri dönecektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paqarin"
				},
				{
					"id": 751880205,
					"content": "Natlan'la hiç alakam yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751880206
					]
				}
			]
		},
		{
			"id": 7518804,
			"completionStepIds": [
				7518804
