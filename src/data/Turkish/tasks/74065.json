			"dialogs": [
				{
					"id": 740650101,
					"content": "#Vay, vay! Bakın {NICKNAME} ve Paimon gelmiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650102,
						740650103
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650102,
					"content": "Tanışıyor muyuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650104
					]
				},
				{
					"id": 740650104,
					"content": "Bu kadar soğuk davranmanıza gerek yok. Geçen sefer benim için yaptıklarınızı asla unutmayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650105
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650105,
					"content": "Geçen sefer... Aa! Hâlâ sana soracak çok şeyimiz var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650106,
					"content": "Ö-Öyle mi? Of, bu da ne? Hafızama yine bir şey oldu! Daha önce ne olmuştu ya? Hiçbir şey hatırlayamıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650107
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650107,
					"content": "Bilgeler, geçmişten ziyade geleceğe odaklanmamız gerektiğini söylerler. O yüzden geçmişi unutup gelecekteki iş birliklerimize odaklanalım, ne dersiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650108
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650108,
					"content": "Elimde ödemesi iyi olan birkaç görev var ama onları yapacak kimse yok. Müsaitseniz size vermek isterim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650109
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650109,
					"content": "Hıh! Sakın bizi kolay kolay kandırabileceğini düşünme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650110,
					"content": "Peki ödeme ne kadar iyi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650111
					]
				},
				{
					"id": 740650111,
					"content": "Hey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650112,
					"content": "Sizin gibi insanlarla iş konuşmayı bu yüzden seviyorum işte. Ne diyorlardı ona? Hah, leb demeden leblebiyi anlamak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650113
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650113,
					"content": "Doğrudan sizi memnun edecek bir miktarı teklif etsem olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650114
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650114,
					"content": "Yüz Kupon! Sizce yeterli mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650115
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650115,
					"content": "Yüz Kupon mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650116,
					"content": "Hımm, bakıyorum da teklifim sizi hemen etkileyiverdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650117,
						740650119
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650117,
					"content": "Bu kadar Kuponla bir Fonta bile alamayız.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650118
					]
				},
				{
					"id": 740650118,
					"content": "Evet! Paimon bu teklifi yapacak kadar yüzsüz olduğuna inanamıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650121,
					"content": "Yeterince eli açığım sanmıştım. Siz gençler cidden... İyilikten hiç anlamıyorsunuz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650122
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650122,
					"content": "Burada böylesine kolay ve kazançlı bir iş için varını yoğunu ortaya koyacak birçok sefil insan var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650123
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650123,
					"content": "Decembre, seni pis dolandırıcı! Sonunda yakaladım seni! Geçen sefer posta odasının orada dolanırken görmüştüm seni, işleri asıl fiyatının çok daha altına yeni gelenlere yaptırıyor ve aradaki farkı cebe indiriyordun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650124
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650124,
					"content": "#{NICKNAME}, Paimon? Onun yalanlarına kanmadınız, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650125,
						740650127
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650125,
					"content": "Tam anlamıyla yıkıldım... Bizi daha önce bir kere kandırdı!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650126
					]
				},
				{
					"id": 740650126,
					"content": "*iç çeker* O zaman çok geç kalmışım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650130
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650130,
					"content": "Neyse, onun dediği hiçbir şeye inanmayın. Buraya yeni gelenleri veya kuralları bilmeyenleri hedef alarak onları kandırır. Elimizde halihazırda uzun bir kurban listesi var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650131
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650131,
					"content": "Dediklerime inanmasınlar mı? İnsanları kandırıyor muymuşum? Sence seninle benim aramda bir fark var mı? Siz muhafızlar da işlerinizi başkalarına yaptırmak için Kuponları kullanmıyor musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650132
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650132,
					"content": "Evet ama vereceğimiz paranın bir kısmını cebimize atmıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650133
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650133,
					"content": "Ne ima ediyorsun? Kanıtın olmadan beni böyle şeylerle itham edemezsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650134
					],
					"speakerTitle": "Decembre"
				},
				{
					"id": 740650134,
					"content": "Kanıt mı istiyorsun? Hadi gidelim o halde. Gideceğin hücre hem sessiz hem de geniş bir yer, kanıtları dikkatle incelemek için mükemmel. Buradaki işim bittikten sonra daha Jeod Maden Kuyusunda ilgilenmem gereken işler var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650135
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650135,
					"content": "#{NICKNAME}, Paimon. Müsaitseniz bana yardım edebilir misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650136
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650136,
					"content": "Hey, bizim de yapacak işlerimiz var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650137,
					"content": "Ücreti iyiyse yaparız!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650138
					]
				},
				{
					"id": 740650138,
					"content": "Hey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650139,
					"content": "Haha! Ödemeyi yönetmeliklere göre yapacağım elbette. Bunları bildiğinizi varsayıyorum, ayrıca sizi kazıklamayacağımdan emin olabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650140
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650140,
					"content": "Neyse, Jeod Maden Kuyusu bazı Fontemer Sapkınları görülmüş... Hemen kontrol altına alınmazlarsa büyük sorunlara neden olabilirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650141
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650141,
					"content": "Ben önce bu adamı hücreye götüreceğim. Onu diğer muhafızlara teslim etmek biraz zamanımı alacak... İşim biter bitmez size yetişeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650142
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650142,
					"content": "Tamam ama çok geç kalma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650143,
					"content": "Elimden geleni yapacağım ama bu evrak işleri... Hızla yapıp kurtulabileceğim bir şey değil. Maden kuyusundaki işi size bırakıyorum o halde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650127,
					"content": "Ama bu sefer kandıramadı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650128
					]
				},
				{
					"id": 740650128,
					"content": "Bu sefer mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650129
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650129,
					"content": "Şey... Bundan önce de bir şeyler olmuştu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650119,
					"content": "Size 100 Kupon vereceğim, siz çalışacaksınız ve ben kar edeceğim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650120
					]
				},
				{
					"id": 740650120,
					"content": "Vay be! Demek aklından bu geçiyormuş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650103,
					"content": "İçimde kötü bir his var...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740650104
					]
				}
			]
		},
