			"dialogs": [
				{
					"id": 740650301,
					"content": "Daha yeni mi geliyorsun? Tüm Fontemer Sapkınlarının üstesinden çoktan geldik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650302,
					"content": "Sonunda bunu da görmüş oldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650303
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650303,
					"content": "Neyi görmüş oldun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740650304,
					"content": "Olay yerine geldiğimde tüm işin başkası tarafından yapılmış olmasını tabii ki! Sanırım burada benlik bir iş kalmamış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740650305
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740650305,
					"content": "Bu sizin için. Gerçekten çok teşekkür ederim! Bugün güzel bir uyku çekeceğime eminim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maupoil"
				}
			]
		}
	]
}