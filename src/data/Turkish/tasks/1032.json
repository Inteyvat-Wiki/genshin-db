			"dialogs": [
				{
					"id": 10293301,
					"content": "Ushi baksana, küçük Eflatun Kavunumuz uyuyakalmış. Sence rüya görüyor mudur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293302
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10293302,
					"content": "Möö? Möö.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293303
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10293303,
					"content": "Gerçekten çok yorgun düşmüş demek. Onu bu halde görmek üzücü, yani normalde hiç susmazdı... Ah ya, zavallıcık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293304
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10293304,
					"content": "Şu küçük dostumuz da yorgun görünüyor. Onlar için biraz endişeleniyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293305
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 10293305,
					"content": "Möö, möö, möö.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293306
					],
					"speakerTitle": "Ushi"
				},
				{
					"id": 10293306,
					"content": "Hapisteyken böyle mi uyuyorum? Hah, bu doğru. Gerçekten de krallar gibi uyurum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293307
					],
					"speakerTitle": "Arataki Itto"
				},
				{
