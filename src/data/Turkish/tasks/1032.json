					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10293202,
					"content": "İyi misin? Birden sesin kesildi. Bu pek senin yapacağın bir şey değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293203
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10293203,
					"content": "Sessiz ol, sonra konuşuruz. Şu an elimizdeki ipuçlarını gözden geçiriyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293204
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10293204,
					"content": "Belki de kaçabilmemizin arkasındaki neden, gözden kaçırdığım bir detayda saklıdır... Her şeyin üzerinden bir kez daha geçeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293205
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10293205,
					"content": "Pekala...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293206
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 10293206,
					"content": "Merak etme. Bize anlattığın şeyleri yazmayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10293207
					],
					"speakerTitle": "Yanfei"
				},
				{
					"id": 10293207,
					"content": "Hayır, demek istediğim olanları değerlendireceksen sana yardım etmek isterim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yelan"
				}
			]
		},
