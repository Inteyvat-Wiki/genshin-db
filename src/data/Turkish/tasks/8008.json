			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yuehui"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80080101,
					"content": "Madenci Bey! Biz rapor vermeye geldik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80080102,
					"content": "Aa, sizi gördüğüme çok sevindim! Gerilmeye başlamıştım... Başta makul bir ücret ödediğimi ve sizin işinizin ehli olduğunuzu düşünmüştüm ama... Ya bu tuhaf görev sırasında başlarına bir şey gelirse ne yaparım ben diye çok endişelendim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080103
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080103,
					"content": "Size bir şey olsaydı kendimi asla affetmezdim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080104
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080104,
					"content": "Merak etmeyin beyefendi, biz bundan daha kötülerini de gördük! Hem sonuçta geri döndük zaten. İyi haberlerimiz de var, neler olup bittiğini çözebildik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80080105,
					"content": "Harika, harika! Neler oluyormuş peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080106
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080106,
					"content": "Şey... Hah... Iıı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080107,
						80080109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80080107,
					"content": "Dağ yabanisi bakımevi gibi bir yere dönüşmüş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080108
					]
				},
				{
					"id": 80080108,
					"content": "Ne? Bakımevi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080111
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080111,
					"content": "Şey, kısacası aşağıdaki dağ yabanileri artık dövüşmek istemiyor. Onları rahat bırakırsanız size sorun çıkarmazlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080112,
						80080113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80080112,
					"content": "Paimon haklı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080114
					]
				},
				{
					"id": 80080114,
					"content": "Eh, gidip onları kasıtlı olarak kışkırtmayacağımıza emin olabilirsiniz. Ortalığı karıştırmak madencilerin en son isteyeceği şeydir... Cevher dışında istediğimiz bir şey yok zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080115
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080115,
					"content": "Paimon bu düşüncenizi beğendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80080116,
					"content": "Dürüst olmak gerekirse anlattığınız durumu pek anlamadım. Yine de her şey yolunda diyorsanız size inanıyorum. Tekrar işe koyulabiliriz demek bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080117
					],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080117,
					"content": "Size çok minnettarım! Bunun için çok uğraşmanız gerekti. Lütfen bunu emeğinizin karşılığı olarak kabul edin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuehui"
				},
				{
					"id": 80080113,
					"content": "Endişelenmeniz gereken bir şey yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080114
					]
				},
				{
					"id": 80080109,
					"content": "Dağ yabanisi cenneti gibi bir yer olmuş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80080110
					]
				},
				{
					"id": 80080110,
					"content": "Anlayamadım, cennet mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80080111
					],
					"speakerTitle": "Yuehui"
				}
			]
		}
	]
}