			"dialogs": [
				{
					"id": 223050601,
					"content": "İşlenmemiş taşın değerini ölçmek için herkesin kendine has bir yöntemi vardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050602
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050602,
					"content": "Kimileri tamamen içgüdülerine güvenir. İlk bakışta almak istedikleri taşı bilirler. Kimisi de tüm taşları ayrıntılı şekilde incelemeyi tercih eder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050603
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050603,
					"content": "Hangi yöntemin sizin için daha iyi olacağını söylemek beni aşar. <color=#00E1FFFF>Daha yakından bakmak</color> ya da sadece <color=#00E1FFFF>iç sesinizi dinlemek</color> tamamen size kalmış.",
