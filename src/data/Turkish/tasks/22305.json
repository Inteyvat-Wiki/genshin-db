			"dialogs": [
				{
					"id": 223050401,
					"content": "400 Mora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050402
					]
				},
				{
					"id": 223050402,
					"content": "Tüm yeni müşterilerime önerdiğim miktar tam da bu, efendim. Sizi zengin edecek bir tutar değil ama yatırım yapmanıza yetecek bir tutar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050403
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050403,
					"content": "Şöyle buyurun lütfen efendim. Tercih ettiğiniz taşı seçin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050404
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050404,
					"content": "Dilediğiniz kadar bekleyebiliriz. Hazır olduğunuzda taşı kırmaktan memnuniyet duyarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shitou"
				}
			]
		},
		{
			"id": 2230505,
			"completionStepIds": [
				2230505
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
