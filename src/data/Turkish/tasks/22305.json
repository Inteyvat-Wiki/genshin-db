			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shitou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223050501,
					"content": "600 Mora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050502
					]
				},
				{
					"id": 223050502,
					"content": "Sezgileriniz oldukça kuvvetli, efendim! Yeni müşteriler genelde ne kadar ekerlerse, o kadar biçeceklerini anlayamıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050503
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050503,
					"content": "Lütfen şöyle buyurun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050504
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050504,
					"content": "Bunlar koleksiyonumuzdaki en eşsiz taşlar. Dilediğiniz gibi inceleyebilirsiniz, her birinin tek tek incelemeye değer olduğunu söyleyebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050505
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050505,
					"content": "Hangisinin en iyisi olduğuna karar verdiğinizde, lütfen bana haber verin. Sizin için taşı memnuniyetle kıracağım.",
