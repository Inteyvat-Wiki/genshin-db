			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shitou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223050301,
					"content": "200 Mora.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050302
					]
				},
				{
					"id": 223050302,
					"content": "Oldukça ölçülü bir tercih. İşte, lütfen beğendiğiniz taşı seçin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050303
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050303,
					"content": "Ama seçim yaparken dikkatli olun. 200 Moralık yatırımın karşılığını almak isteriz değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050304
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050304,
					"content": "Kararınızı verdiğinizde söylerseniz, ben de taşı kırayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shitou"
				}
			]
		},
		{
			"id": 2230504,
			"completionStepIds": [
				2230504
