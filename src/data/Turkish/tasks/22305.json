			"dialogs": [
				{
					"id": 223051001,
					"content": "Ne yazık ki bunun içinde çok ufak bir yeşim var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223051002
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223051002,
					"content": "Önemli değil. Çok iyi bir deneyimdi değil mi? Merak gidermek için harcanan Mora, bence gayet makul bir harcama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223051003
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223051003,
					"content": "Beni kötü çıkan bir taş olmadığına inandırdınız...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223051004
					]
				},
				{
					"id": 223051004,
					"content": "Aynen öyle! Tüm taşlarımız sorumluluk bilinciyle toplanıp özenle ve iyi niyetle seçilir. Herhangi birine \"kötü taş\" dersem, gerçekleri epey çarpıtmış olurum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223051005
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223051005,
					"content": "Lütfen umudunuzu yitirmeyin! Hepimiz, umut vaat eden ancak sonunda karşımıza hayal kırıklığı olarak çıkan bir taş konusunda yanılgıya düşmüşüzdür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223051006
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223051006,
					"content": "Bunu ben alayım. Denemeye devam etmek isterseniz, faturayı en son halledebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223051007
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223051007,
					"content": "<color=#00E1FFFF>Ne kadar borcunuz olduğunu en son hesaplayacağım</color>. Böyle tek tek gidersek kafamız karışır, bunu istemeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223051008
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223051008,
					"content": "Ne dersiniz efendim? Bir tur daha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shitou"
				}
			]
