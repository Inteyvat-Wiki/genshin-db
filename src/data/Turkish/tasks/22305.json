				"points": []
			},
			"dialogs": [
				{
					"id": 223050201,
					"content": "Gizemli Yeşim'de gerçekten çok geniş işlenmemiş taş seçeneklerimiz bulunmaktadır. Tüm koleksiyonu incelemek yorucu olabilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050202
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050202,
					"content": "Bu nedenle taşları sizin için sınıflandırdım. Bütçenizi öğrenebilir miyim acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shitou"
				}
			]
		},
		{
			"id": 2230503,
