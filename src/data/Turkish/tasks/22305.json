			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shitou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223050101,
					"content": "#Pardon {F#Hanımefendi}{M#Beyefendi}! Bu taşlarla şansınızı denemek ister misiniz? Bugün şanslı gününüzde olabilirsiniz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050102,
						223050104,
						223050108
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050102,
					"content": "Hadi bakalım deneyelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050103
					]
				},
				{
					"id": 223050103,
					"content": "#Harika bir seçim {F#Hanımefendi}{M#Beyefendi}. Eminim pişman olmayacaksınız! Talih cesurdan yanadır ve görünüşe göre endişe etmeniz gereken bir durum yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050116
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050116,
					"content": "Bu tarafa gelin lütfen efendim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050104,
					"content": "Ne tür bir taş?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050105
					]
				},
				{
					"id": 223050105,
					"content": "Yalnızca dükkanımdaki en kaliteli işlenmemiş taşlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050106
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050106,
					"content": "Bir taş alıp kırıyorsunuz ve içinden yeşim çıkarsa size bolca ödeme yapıyorum. Tabii ki yeşim yoksa, Mora da yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050107
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050107,
					"content": "Öğrenmenin en kolay yolu, bir tane alıp denemek efendim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050102,
						22305108
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050108,
					"content": "Taşlar nereden geliyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050109
					]
				},
				{
					"id": 223050109,
					"content": "Bu dükkanda yalnızca en kaliteli taşlar bulunur efendim. Hepsi Kanyon'dan özenle çıkartıldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050110
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050110,
					"content": "İçinize su serpeyim efendim! Gizemli Yeşim, yılların getirdiği bir yeşim süs eşyası işleme tecrübesine sahiptir. Yeşim taşı konusunda üstümüze yoktur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050111
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050111,
					"content": "Ama Sivil İşler Bakanlığı Kanyon'u kapattığından beri işler eskisi gibi değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050112
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050112,
					"content": "Artık yeni ham taşlar gelmediği için arz da zaman içinde iyice azaldı... İnanır mısınız artık taşların kendisi, yeşim dekorasyonlardan çok daha değerli olabilecek kadar nadir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050113
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050113,
					"content": "Ben de düşündüm ve \"Neden taşları satmayayım ki?\" dedim. Hem işleme maliyetini ortadan kaldırıyor, hem de işe biraz heyecan katıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050114
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050114,
					"content": "Ne dersiniz? Taş tahmininin şahane dünyasına bir yolculuk yapalım mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223050115
					],
					"speakerTitle": "Shitou"
				},
				{
					"id": 223050115,
					"content": "Deneyeceğim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223050116
					]
				}
			]
		},
		{
			"id": 2230502,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
