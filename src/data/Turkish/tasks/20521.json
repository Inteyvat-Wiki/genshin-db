				"points": []
			},
			"dialogs": [
				{
					"id": 205210301,
					"content": "Bu Kremalı Yahni sana.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210302
					]
				},
				{
					"id": 205210302,
					"content": "Ah, Harris yollamış galiba seni. Teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210303
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210303,
					"content": "Enfes yemeklerine alışmasam iyi olacak, yoksa bir daha kurutulmuş yemeklere geri dönemeyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210304
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210304,
					"content": "Haha, şaka şaka. Bir maceracı olarak yemek konusunda ne zaman sineye çekmem gerektiğini iyi bilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210305
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210305,
					"content": "Dağın tepesine mi tırmanacaksın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210306
					]
				},
				{
					"id": 205210306,
					"content": "Tabii ki, bu kampı mola için kurdum. Güzel bir fırsat bulunca daha yukarılara kamp kurup kuramayacağıma bakacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210307
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210307,
					"content": "Buradan itibaren sıcak yemek bulamayacağım malum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210308
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210308,
					"content": "Kendimi güvene almadan ilerlemem ama. Burada biraz daha gözlem yaptıktan sonra kampa dönüp plan yapacağım ve ona göre kararımı vereceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210309
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 205210309,
					"content": "Bunca yolu geldiğin için çok sağ ol. Buyur, karşılığında bunları al.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				}
			]
		},
