			"trigger": {
				"objectNames": [
					"Harris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205210101,
					"content": "Macera ateşini körüklemeden nasıl gider maceraya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210102
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210102,
					"content": "\"Macera ateşi\" mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210103
					]
				},
				{
					"id": 205210103,
					"content": "Ah, sıcak yemek yani. Iris'ten bahsediyorum, kaşif olan. Gitmeden sıcak bir yemek yeseydi iyiydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210104
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210104,
					"content": "Bir kaşif ekibi için dağlara bir keşif gezisi düzenlemek istiyor da. Ama düzgün bir plan yapmadan tek başına gidip, birkaç gün kamp yapıp dağdaki şartları gözlemleyecekmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210105
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210105,
					"content": "Kamp yeri çok uzakta değil, yani hâlâ kolayca erzak götürme şansımız var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210106
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210106,
					"content": "Ama dağın tepesinde o kadar karın içinde kamp yapmak... Enerji için sıcak bir yemeğe ihtiyacı var sanki, ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210107
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210107,
					"content": "Tabii o yolculuğu tek başıma yapmaya cüret edemem. Peki ya sen? Bu Kremalı Yahniyi benim için Iris'e götürür müsün?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210108,
						205210110
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210108,
					"content": "Tabii ki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210109
					]
				},
				{
					"id": 205210109,
					"content": "Teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210113
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210113,
					"content": "Yemek hâlâ sıcak ve taze. Iris'e çabucak götürsen güzel olur. Hava soğuk olunca yemek de çabucak soğur sonuçta, soğursa da yenmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210114
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210114,
					"content": "Gerçi en kötü ihtimalle yolda başın derse girerse ve yemek de arada kaynarsa buraya geri gel hemen. Sana yenisini pişiririm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210110,
					"content": "Onu nerede bulabilirim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205210111
					]
				},
				{
					"id": 205210111,
					"content": "Kampın dağın biraz yukarısında olduğunu söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210112
					],
					"speakerTitle": "Harris"
				},
				{
					"id": 205210112,
					"content": "Temkinli olmasını bilen tecrübeli bir maceracı sonuçta. Kamp yerinden çok uzaklaşmamıştır yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205210113
					],
					"speakerTitle": "Harris"
				}
			]
		},
