			},
			"dialogs": [
				{
					"id": 760810201,
					"content": "Mükemmel bir dövüştü Sör Sigurd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810202
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810202,
					"content": "Bir kahramanın sonunun böyle olması çok üzücü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810203
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810203,
					"content": "Hayatını feda ettiğin topraklarda yalnız başına dolaşmak... İlk kez Işık Muhafızı yeminini ettiğinde bu günleri göreceğini tahmin etmiş miydin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810204
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810204,
					"content": "Belki de bilmene rağmen tereddüt etmemişsindir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810205
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810205,
					"content": "Gelecekte seni tekrar ziyaret edeceğim. Elveda Sör Sigurd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
			]
		},
