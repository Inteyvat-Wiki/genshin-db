			},
			"dialogs": [
				{
					"id": 760819901,
					"content": "Canavarları yok etme yöntemi... Hayır, olamaz. O efsanevi şahsiyet uzun zaman önce görev sırasında can verdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819902
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760819902,
					"content": "Bir şekilde uyanmış olabilir mi? Hımm... Zamanınız varsa Yosunhöyük Tundrası'nın kuzeydoğusundaki sahile gidin. Mezarı orada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819903
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760819903,
					"content": "Yaşlı adam bana bir zamanlar yanında savaştığı efsanevi Starşina Sigurd'un hikayelerini anlatırdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819904
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760819904,
					"content": "Mor kılıç, altın sarısı saçlar... Tıpkı hikayelerde anlatıldığı gibi. Son birkaç gündür gördüğüm kişi... Gerçekten o olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760819905
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760819905,
					"content": "Mezarı Yosunhöyük Tundrası'nın kuzeydoğusundaki sahilde. Vaktim olursa oraya bir göz atacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		}
	]
}