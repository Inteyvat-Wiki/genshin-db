			"dialogs": [
				{
					"id": 760810101,
					"content": "Efsanevi Starşina Sigurd'un bir uzun kılıç kullandığını ve canavar öldürme becerilerinin eşsiz olduğunu duymuştum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810102
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810102,
					"content": "Büyük bir savaşın ardından yok olmuş, anısına bu boş mezarı yapmışlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810103
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810103,
					"content": "Mor bir kılıç ve altın saçlar... Vahşi Ava kafa tutan gezgin savaşçı o olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810104
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810104,
					"content": "Son Gece Mezarlığındaki diğer pek çok ruh gibi, onun da ruhu mezarında huzur bulamamış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810105
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810105,
					"content": "Kahramanın ruhu, ölümünden sonra bile korkusuzca Vahşi Ava karşı kaldırıyor kılıcını.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810106
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810106,
					"content": "... Saygıma layık bir adamsınız Bay Sigurd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810107
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810107,
					"content": "Ancak nefret ve sorumluluk uğruna yalnız başına savaşmak, senin gibi bir savaşçı için fazla acımasız bir kader.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810108
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810108,
					"content": "Diğer Işık Muhafızlarıyla birlikte kadehleri devirip şarkılar söylediğin günleri özlüyor musun Sigurd? Düşmanlarını öldürme arzun dışında bir sebebin var mı kılıcını kuşanmak için?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810109
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 760810109,
					"content": "Öyleyse göster kendini. Eski günlerde olduğu gibi, Işık Muhafızı olduğun zamanlardaki gibi dövüşelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flins"
				}
			]
		},
