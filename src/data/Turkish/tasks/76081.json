			"dialogs": [
				{
					"id": 760810401,
					"content": "İyi dövüştünüz Bay Sigurd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810402
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810402,
					"content": "İçiniz rahat olsun. Siz ve yoldaşlarınız şehit olduktan sonra, babam Nikita Starşina görevini üstlendi ve düzeni yeniden inşa etinler diye kurtardığınız insanları yönlendirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810403
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810403,
					"content": "Vahşi Avın gölgesi altında bile bu toprakları koruyacak kadar kuvvetliyiz artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810404
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810404,
					"content": "Fedakarlığınız boşa gitmedi. Kahramanlıklarınız ve iradeniz yaşamaya devam edecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810405
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810405,
					"content": "Elveda Bay Sigurd. Sizi arada bir ziyaret edeceğim. Umarım sonunda huzur bulabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		},
		{
