					}
				]
			},
			"dialogs": [
				{
					"id": 760810301,
					"content": "Bay Sigurd, size hayatımı borçluyum. O zaman Işık Muhafızlarını güneye yönlendirip savunma hattını tutmasaydınız, ne olduğunu bile idrak edemeden ölebilirdim ve cesedimi kimse bulamazdı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810302
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810302,
					"content": "Peki neden ruhunuz huzur bulamadı? Neden hâlâ gezinip savaşıyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810303
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810303,
					"content": "Vahşi Avın aşınmasıyla kirlenmişsiniz, varlığınız paramparça olmuş... Savaş alanını terk etmemişsiniz anlaşılan. Sizin için savaş hiç bitmemiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810304
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810304,
					"content": "Bu bakımdan belki ben de sizden çok farklı değilimdir. Vahşi Av tamamen yok olmadıkça hiçbirimiz gerçek huzuru bulamayacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810305
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810305,
					"content": "Sizinle tanışmak bir onur, Bay Sigurd.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810306
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810306,
					"content": "Şimdi anlıyorum. Bir Işık Muhafızı için en iyi iletişim şekli kılıç tokuşturmaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760810307
					],
					"speakerTitle": "Illuga"
				},
				{
					"id": 760810307,
					"content": "O zaman izninizle size yeni nesil Işık Muhafızlarının gücünü göstereyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Illuga"
				}
			]
		},
