			"dialogs": [
				{
					"id": 765000101,
					"content": "#{NICKNAME}! Buraya gel! Paimon'un sana göstermek istediği harika bir şey var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000102,
					"content": "Şuna bak! O kalabalık pazar yerinde bunu bulana kadar Paimon'un canı çıktı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000103,
						765000104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000103,
					"content": "Bana kalırsa bu... Kameraların içinde bir duayen sayılır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765000106
					]
				},
				{
					"id": 765000106,
					"content": "Dükkanın gizemli sahibinin anlattığına göre bu Kamerayı yıllar önce Fontaineli o çok ünlü fotoğrafçı Pierre Leblanc kullanmış!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000107,
					"content": "Söylenenlere göre bu Kamerayla çektiği fotoğrafların eşi benzeri yokmuş ve sık sık Buğukuş'un manşetlerinde de kullanılırmış!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000108,
					"content": "Bu Efsanevi Kamerayı kullanırsan çektiğin fotoğraflar da kesin iki katı efsane olur! Fotoğrafları da Mora karşılığında satarız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000109,
						765000112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000109,
					"content": "Bu Kamera... Pahalıydı, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765000110
					]
				},
				{
					"id": 765000110,
					"content": "O kadar da değil! Paimon'un acil durum fonu var, merak etme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000111,
					"content": "Senin beğenmen yeter, Paimon sana her şeyi alır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000116,
						765000117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000116,
					"content": "Vay canına. O halde teşekkürler Paimon, bu çok güzel bir hediye.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765000118
					]
				},
				{
					"id": 765000118,
					"content": "Yaşasın! Sen mutluysan Paimon da mutlu! Artık yeni bir ulusa geldiğimize göre bu Kamerayı iyi kullanıp gördüğümüz her yeni şeyin fotoğrafını çekelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000119,
					"content": "Paimon bu özel günü kutlamak için bir de yeni bir fotoğraf albümü hazırladı. Paimon ne kadar güvenilir ve düşünceli, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000120,
					"content": "Pekala, bu kadar gevezelik yeter! Gidip biraz fotoğraf çekelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000117,
					"content": "Bununla efsanevi fotoğraflar çekeceğim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765000118
					]
				},
				{
					"id": 765000112,
					"content": "Dolandırıcı bir tüccara çarpılmadın, değil mi Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765000113
					]
				},
				{
					"id": 765000113,
					"content": "Merak etme! Emin olmak için Paimon güvenilir bir mühendise teyit ettirdi. Bu kesinlikle büyük usta Leblanc'ın eskiden kullandığı modelin aynısı, hiç şüphe yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000114,
					"content": "Ama dur, daha bitmedi! Mühendis içini açtı ve Leblanc'ın adının baş harflerinin kazındığını gördü! İşte sapasağlam bir kanıt, hehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000115,
					"content": "Paimon ne kadar güvenilir bir rehber, değil mi? İyi günde, kötü günde hep yanında!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000116,
						765000117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765000104,
					"content": "Antikalara mı ilgi duyuyorsun Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765000105
					]
				},
				{
					"id": 765000105,
					"content": "Hayır ya! Paimon sana sürpriz bir hediye olsun diye hazırladı bunu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765000106
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}