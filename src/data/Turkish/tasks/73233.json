					"Raef"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732330401,
					"content": "İşte bunlar. Çok teşekkür ederim Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330402,
						732330403
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330402,
					"content": "Kendi çiçekçi dükkanını açmadığınan eminsin değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330404
					]
				},
				{
					"id": 732330404,
					"content": "Şey, ben... Sürekli gidip gelmektense topluca alayım dedim işte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330405
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330405,
					"content": "Neyse, sen git şurada biraz dinlen. Ben şu tohumları ekip biraz gübreleyeyim, sonra da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330406
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330406,
					"content": "Raef saksıyı doldurmaya başlar...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732330407
					]
				},
				{
					"id": 732330407,
					"content": "Tamamdır, bu iş görür! Nermin'in yapması gereken tek şey bitkiyi sulamak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330408
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330408,
					"content": "Gezgin, şey, acaba bu saksıyı ona götürmeme yardımcı olur musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330409
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330409,
					"content": "Neden kendin götürmüyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330410
					]
				},
				{
					"id": 732330410,
					"content": "Ben bu yolda nöbet tutuyorum. Eğer yiyecek veya mal gelirse, almak için köyden daha fazla insan getirmem gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330411
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330411,
					"content": "Bir de, buralar nasıldır bilirsin. Yavaş hareket edersen, mallar güneşin altında heba olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330412
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330412,
					"content": "Bunu esirgeme benden, ne olur. Nermin çok uzakta değil. Tek yapman gereken bu çiçek saksısını ona vermek. Kalanını ona ulaştırmanın bir yolunu bulurum ben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330403,
					"content": "Bunca şeye neden ihtiyacın vardı ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330404
					]
				}
			]
		},
		{
			"id": 7323305,
			"completionStepIds": [
				7323305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
