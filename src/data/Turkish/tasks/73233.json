			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nermin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732330501,
					"content": "İçeriden birileri bir ses duyar gibi oldu...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732330502
					]
				},
				{
					"id": 732330502,
					"content": "Merhaba. Yardımcı olabileceğim bir şey var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330503
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 732330503,
					"content": "Ben bu çiçek saksısını getirmiştim de.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330504
					]
				},
				{
					"id": 732330504,
					"content": "Raef mi gönderdi bunu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330505
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 732330505,
					"content": "Bu saksıda çiçekler mi var? Gerçekten mi? Yardım ettiğin için sana da çok teşekkür ederim. Çok hoşuma gitti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330506
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 732330506,
					"content": "Peki ama... Ben bu çiçeklere nasıl bakacağım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330507
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 732330507,
					"content": "İlk defa mı çiçek yetiştireceksin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330508
					]
				},
				{
					"id": 732330508,
					"content": "Yok, hayır... Bitkilere bakma konusunda pek iyi değilimdir de. Bir öncekiler hep elimde soldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330509
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 732330509,
					"content": "Bu saksıdaki çiçeklerin daha da narin olduğunu düşünüyorum. Hadi yine bakmayı beceremezsem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330510
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 732330510,
					"content": "Yok, hayır, ben yapamam... Ama madem çiçekler elime ulaştı, onlara bakabilmek için elimden geleni yapmalıyım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330511
					],
					"speakerTitle": "Nermin"
				},
				{
					"id": 732330511,
					"content": "Belki Kulsoom Nine bu sorunu çözebilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nermin"
				}
			]
		},
		{
