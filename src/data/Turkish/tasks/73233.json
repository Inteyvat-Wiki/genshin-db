					"Azalai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732330201,
					"content": "Hah, demek bir paket daha var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330202
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 732330202,
					"content": "Hey, Raef'in malları...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330203
					]
				},
				{
					"id": 732330203,
					"content": "Sipariş verdiği şeyleri mi diyorsun? Şanslısın! Gelen malların içinde onun siparişleri de var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330204
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 732330204,
					"content": "Yalnız onun siparişleri epey fazla. Onları almaya mı geldin sen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330205,
						732330206
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 732330205,
					"content": "Çok mu ağır?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330207
					]
				},
				{
					"id": 732330207,
					"content": "Şu saksı dışında çeşit çeşit tohum, gübre ve bir takım bahçe alet edevatı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330208
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 732330208,
					"content": "Hepsi birlikte epey ağır oluyor. Tek başına halledebilecek misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330209,
						732330210
					],
					"speakerTitle": "Azalai"
				},
				{
					"id": 732330209,
					"content": "Benim de kendimce yöntemlerim var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330211
					]
				},
				{
					"id": 732330211,
					"content": "Ah, demek öyle... Pekala. Ben siparişleri paketleyeyim. Buraya kadar zahmet ettiğin için teşekkürler bu arada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Azalai"
				},
				{
					"id": 732330210,
					"content": "Yardım edeceğimi söyledim, o yüzden...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330211
					]
				},
				{
					"id": 732330206,
					"content": "Neler aldı ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330207
					]
				}
			]
		},
		{
			"id": 7323303,
