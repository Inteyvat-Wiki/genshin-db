					"Raef"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732330601,
					"content": "Dönmüşsün Gezgin. Yardım ettiğin için çok teşekkür ederim. Nermin nasıl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330602,
						732330605
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330602,
					"content": "Çiçeklere bakamayacağından endişe ediyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330603
					]
				},
				{
					"id": 732330603,
					"content": "Şey... Ona bu konuda destek olacağım. Hiçbir şey işe yaramazsa soracak birini buluruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330604
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330604,
					"content": "O da işe yaramazsa... O zaman ben... yetiştirmesi daha kolay bir şey bulurum herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330608
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330608,
					"content": "Her halükarda bana yardım ettiğin için teşekkürler Gezgin. Lütfen bu ödülü kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330609
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330609,
					"content": "Diğer malları ona daha sonra gönderirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330610
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330610,
					"content": "Bir dakika. Bu bahçe aletleri kullanım kılavuzuyla gelmedi mi? Olamaz... Bunları nasıl kullanacağımı bilmiyorum ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330605,
					"content": "Daha önce ona hiç çiçek göndermemiş miydin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732330606
					]
				},
				{
					"id": 732330606,
					"content": "Tam olarak öyle olduğunu söyleyemem. Daha önce aldıklarımın hepsi çiçek açmış haldeydi ama köye gelene kadar kuruyup gidiyorlardı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330607
					],
					"speakerTitle": "Raef"
				},
				{
					"id": 732330607,
					"content": "O yüzden de bu sefer ona yeni ekilmiş çiçek göndermeye karar verdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732330608
					],
					"speakerTitle": "Raef"
				}
			]
		},
