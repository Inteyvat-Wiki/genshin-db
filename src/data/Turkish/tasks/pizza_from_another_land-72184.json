			"dialogs": [
				{
					"id": 721840301,
					"content": "Gezgin. Dönmüşsün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840302
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840302,
					"content": "Nasıl gitti? Hiç geri bildirim aldın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840303
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840303,
					"content": "Müşterilerin geri bildirimi hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840304
					]
				},
				{
					"id": 721840304,
					"content": "Pizzada Eflatun Kavun... Çok da karmaşık bir iş değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840305
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840305,
					"content": "Malzemelerin geri kalanı normalde olduğu gibi hazırlanacak. Geri bildirimde \"Inazuma'nın yerel tatlarından bazıları\" dendiğine göre başka malzemeler de ekleyebilirim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840306
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840306,
					"content": "Deniz Mantarı? Gözyaşı Otu? Peki ya Fosforlu Mantar nasıl olur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840307
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840307,
					"content": "Yardım lazım mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840308
					]
				},
				{
					"id": 721840308,
					"content": "Üzgünüm, koyabileceğim diğer malzemeleri düşünüyordum. Sanırım dükkanda pek Eflatun Kavun kalmadı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840309
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840309,
					"content": "Gezgin, lütfen bana Eflatun Kavun getirir misin? Sanırım elimdeki tek eksik malzeme o.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840310,
						721840312
					],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840310,
					"content": "Hemen hallediyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840311
					]
				},
				{
					"id": 721840311,
					"content": "O zaman sana güveniyorum. Tek bir Eflatun Kavun yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				},
				{
					"id": 721840312,
					"content": "Başka malzeme gerekiyor mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840313
					]
				},
				{
					"id": 721840313,
					"content": "Dükkanda diğer malzemeler stokta var. Bir tane Eflatun Kavun getirsen yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kiminami Anna"
				}
			]
