				"objectNames": [
					"Beryna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760710101,
					"content": "Lezzetli ekmekler yapabilseydim herkesin moralini yükseltebilirdim. Ama işler bu haldeyken bu pek kolay değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710102,
						760710103
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				},
				{
					"id": 760710102,
					"content": "Bir sorun mu var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760710105
					]
				},
				{
					"id": 760710105,
					"content": "Küçükken annemin benim için yaptığı bir ekmek vardı, ondan yapmaya çalışıyorum. Tipi mantara benziyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710106
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				},
				{
					"id": 760710106,
					"content": "Hatırladığım kadarıyla önce mantarları ve böğürtlenleri koyu kıvam alana kadar pişiriyorsun, sonra taze yoğrulmuş hamurun içine sarıp hepsini birlikte fırınlıyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710107
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				},
				{
					"id": 760710107,
					"content": "En önemli kısım taze hasat edilmiş çavdardan yapılan un kullanmak. Ekmeğe asıl tadını veren budur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710108
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				},
				{
					"id": 760710108,
					"content": "Buraya biraz çavdar toplarım diye geldim ama görünüşe göre son zamanlarda kimsenin tarlalarla ilgilenmeye vakti olmamış. Etrafta bir sürü tuhaf küçük yaratık dolanıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710109
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				},
				{
					"id": 760710109,
					"content": "Bay Valdis burada olsaydı onlarla başa çıkabilirdi kesin. Ama ben bu tür konularda iyi değilim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710110
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				},
				{
					"id": 760710110,
					"content": "Şey... Biraz çavdar toplamama yardım eder misin? Az bir şey lazım zaten. Karşılığında sana sıcak mantarlı ekmek yapmayı öğretebilirim. Olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				},
				{
					"id": 760710103,
					"content": "Hoşça kal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760710104
					]
				},
				{
					"id": 760710104,
					"content": "Dur, hemen gitme. Bana yardım eder misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710105
					],
					"speakerTitle": "Beryna",
					"speakerSubtitle": "Ratnik"
				}
			]
		},
