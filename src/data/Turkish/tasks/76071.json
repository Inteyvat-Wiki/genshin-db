			"dialogs": [
				{
					"id": 760710301,
					"content": "Harika, teşekkür ederim! Bu taze çavdarlar sayesinde sonunda tekrar sıcacık ve doyurucu bir ekmek yapabileceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
