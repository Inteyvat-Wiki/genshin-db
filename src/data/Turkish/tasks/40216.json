			"dialogs": [
				{
					"id": 766530501,
					"content": "Hımm... Araştırmama devam etsem mi acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530502
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530502,
					"content": "Bu nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530503,
					"content": "1 Numaralı Zip-Zap Casus Robot!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530504
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530504,
					"content": "Zip zap... Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530505,
					"content": "Tam olarak açıklamam gerekirse bu gördüğün, Aino'nun en son geliştirdiği görünmez 1 Numaralı Zip-Zap Casus Robot test platformu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530506
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530506,
					"content": "Aino geçenlerde karaborsadan terk edilmiş bir temizlik robotu satın aldı. Ünite üzerinde değişiklikler yaptıktan sonra bugün gördüğünüz 1 Numaralı Zip-Zap Casus Robotu yarattı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530507
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530507,
					"content": "Bu platform, robotun baskı altında dahi gizli kalma becerilerini test etmek için birçok zorlu ortamın simülasyonunu yapabiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530508
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530508,
					"content": "Aino neden görünmez robotlar yapıyordu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530509,
					"content": "Krum-Çın %70 Tatlı çalındıktan sonra Aino kararını verdi ve şöyle dedi: \"Düşman ne kadar güçlü olursa olsun, arkadaşlarımızı kurtarmalıyız!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530510
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530510,
					"content": "Daha sonra hızla 1 Numaralı Zip-Zap Casus Robotun taslağını tamamladı ve geliştirmeye başladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530511
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530511,
					"content": "Planına göre geliştirme tamamlandığında robot, oldukça sıkı korunan Kuuvahki Deneysel Tasarım Bürosuna bile sızabilecek ve arkadaşlarımızı kolaylıkla kurtarabilecekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530512
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530512,
					"content": "Harikaymış bu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530513,
					"content": "Fakat Aino kısa süre sonra, planının mükemmel hale gelmesi için çok fazla zaman gerektiğini fark etti ve planı rafa kaldırmak istedi. Hesaplamalarına göre Nod-Krai'ın altını üstüne getirmek çok daha hızlı olurmuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530514
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530514,
					"content": "Kararımı verdim! Madem acelemiz yok, 1 Numaralı Zip-Zap Casus Robot üzerinde çalışmaya devam edeceğim! Arkadaşlarımızı kurtarmamıza mutlaka yardımı olacaktır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530515
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 766530515,
					"content": "Test için sizin yardımınızı rica edebilir miyiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530516
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530516,
					"content": "Geçmiş verilere göre testçilerden referans veri alınabilirse Aino'nun geliştirme hızı en az %30 artacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530517
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 766530517,
					"content": "Paimon'u da sayın! Çok eğlenceli olacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766530518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766530518,
					"content": "Ben de yardım edeceğim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766530519
					]
				},
				{
					"id": 766530519,
					"content": "Aino adına ikinize de teşekkür ederim. Size platforma erişim izni vereceğim. Bundan sonra istediğiniz testleri yapabileceksiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ineffa"
				}
			]
		}
	]
