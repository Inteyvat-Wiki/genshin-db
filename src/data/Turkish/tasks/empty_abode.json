			"dialogs": [
				{
					"id": 3890601,
					"content": "Ah, daha fazla ilerleyemeyiz. Sanırım harabeler kadim <color=#00E1FFFF>mühürlerle</color> korunuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890602
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890602,
					"content": "Bu Dvalin'in işi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3890603,
					"content": "Hayır. Bu harabeler bir zamanlar kadim bir şehrin parçasıydı. Dvalin sadece buralara yerleşmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890604
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890604,
					"content": "Bu harabeler Dört Rüzgar var olmadan önce bile buradaydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890605
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890605,
					"content": "Mondstadt, hükümdarı olmayan bir şehir. Ama önceden...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890606
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890606,
					"content": "Onu bir tiran yönetiyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890607
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890607,
					"content": "Neyse... Gelecekte fırsat bulursak sana bu hikayeyi bir şarkıyla anlatırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890608
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3890608,
					"content": "Bu mührün üstündeki işaretler... Arkeolojik bilgim beni yanıltmıyorsa, <color=#00E1FFFF>ışık kumandasına</color> benziyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890609
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3890609,
					"content": "Bunu alır ve tüm <color=#00E1FFFF>parçaları</color> <color=#00E1FFFF>tekrar birleştirirsek</color>, onu <color=#00E1FFFF>çalıştırabiliriz</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890610
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3890610,
					"content": "Bu kumanda için ışık seremonisini tamamlamak üzereyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890611
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3890611,
					"content": "Hadi <color=#00E1FFFF>son parçayı</color> da geri koyalım ve görelim.",
