			"dialogs": [
				{
					"id": 240140101,
					"content": "Buradaki balık sayısı tekrar azaldı. Mekabalıkların işi mi bu yine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140102
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140102,
					"content": "Balık yavrularını derine koymam gerekiyor... Of, dalgıç giysim neden şimdi bozuldu ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140103
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140103,
					"content": "Ne yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140104
					]
				},
				{
					"id": 240140104,
					"content": "Merhaba. Tanıştığımıza memnun oldum. Ben Linorea, çevresel sorunlarda uzmanlaşmış bir gazeteciyim. Ben... Suya balık yavruları koyuyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140105,
						240140109
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140105,
					"content": "Gazeteci mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140106
					]
				},
				{
					"id": 240140106,
					"content": "Evet, yani bir bakıma. Ama ben öyle ünlüler hakkında dedikodu yazan veya tüm gün sıkıcı haberleri tekrarlayanlar gibi değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140107
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140107,
					"content": "Benim ilgilendiğim şey, şu anda devam eden ve Fontaine Şehri halkının güvenliğini tehdit eden bir mesele.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140108
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140108,
					"content": "İşte tam da bu yüzden buradaki suya balık yavruları koyuyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140110
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140110,
					"content": "Mekabalıkları biliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140111,
						240140112
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140111,
					"content": "Hiç duymadım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 240140112,
					"content": "Fontaine Şehri'ne özgü bir tür mü?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 240140109,
					"content": "Peki bunu neden yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140110
					]
				}
			]
		},
