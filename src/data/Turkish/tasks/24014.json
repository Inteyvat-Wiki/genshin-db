				},
				{
					"id": 240140602,
					"content": "Koydum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140603
					]
				},
				{
					"id": 240140603,
					"content": "Çok teşekkür ederim. Dalgıç giysimi onardıktan sonra geri dönüp işime kaldığım yerden devam edeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140604
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140604,
					"content": "Umarım bu balıklar güzel bir şekilde büyürler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140605
					]
				},
				{
					"id": 240140605,
					"content": "Merak etme, her türden su ve çevre için çeşit çeşit balık yavrusu hazırladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140606
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140606,
					"content": "Az önce koyduğun yavrular, bu bölge için özel olarak seçilmişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140607
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140607,
					"content": "Birkaç defa daha yavru balıkları yerleştireceğim, tuttuğumuz maceracılar da buraya gelip bölgeyi Mekabalıklardan temizleyecekler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140608
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140608,
					"content": "Bu yavruların büyüyüp buranın doğal dengesini yeniden sağlayacağını düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140609
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140609,
					"content": "Yeterince su birikintisi bir toparlansın, sonra uzun bir rapor yazacağım. Halka, Fontaine Araştırma Enstitüsünün çevreye verdiği zararları anlatacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140610
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140610,
					"content": "Sen bekle beni Damestier. Beni bir kere daha durdurmana müsaade etmeyeceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linorea"
				}
			]
		},
