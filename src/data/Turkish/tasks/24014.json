				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linorea"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240140701,
					"content": "Hıh. Bu Mekabalıklar, Fontaine Araştırma Enstitüsünün kurmalı makinaları. Fontaine Şehri'ndeki suları mahvedenler de onlar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140702
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140702,
					"content": "Su birikintileri, genellikle çeşitli balıklarla diğer canlıların uyum içinde yaşayabildiği dengeli ekosistemlere sahiptir. Bu düzen, onların büyüyüp çoğalmasına olanak sağlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140703
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140703,
					"content": "Bu düzen, zaman zaman insanlar balık tutmaya geldiklerinde veya işgalci bir tür ortaya çıktığında bozulur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140704
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140704,
					"content": "Bazen hava değişip balıkların oradan ayrılmasına neden olur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140726
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140726,
					"content": "Büyük resme odaklanırsan bu suda çok hassas bir dengenin olduğunu görürsün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140705
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140705,
					"content": "Ancak Enstitüdeki o ahmaklar Mekabalıkları yaptığından beri her şey tamamen altüst oldu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140706
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140706,
					"content": "Onları halka, sulardaki çöpleri ve diğer şeyleri sudan temizleyen aletler olarak gösteriyorlar. Ve diğer etkilerinden bahsetmiyorlar bile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140707
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140707,
					"content": "İlk başta dedikleri gibiydi ve bize söyledikleri yalanlara inanmıştık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140708
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140708,
					"content": "Ancak bir süre sonra Mekabalıkların olduğu sulardaki balık miktarının sürekli azaldığına dair raporlar almaya başladık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140709
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140709,
					"content": "Tam da o zaman Mekabalıkların diğer balıkları da \"çöp\" olarak görüp temizlemeye başladığının farkına vardık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140710,
						240140711
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140710,
					"content": "Yani \"suları temizlemekten\" kasıtları buymuş...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140712
					]
				},
				{
					"id": 240140712,
					"content": "Biz çok karşı çıkınca o araştırmacılar Mekabalıkları kapatıp toplamaya hazırlandılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140713
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140713,
					"content": "Ama buna hazırlanırken Enstitüde büyük bir patlama oldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140714
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140714,
					"content": "Patlamadan sonra normalde kapatılmış olan bazı Mekabalıklar kendilerini açtılar ve diğer balıklara çok daha vahşice saldırmaya başladılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140715
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140715,
					"content": "Birçok iş arkadaşım ve ben bunun kabul edilemez olduğuna karar verdik. Mekabalıklar bu çılgınlıklarına devam ederlerse su ekosistemimize geri dönüşü olmayan bir zarar verecekler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140716
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140716,
					"content": "Biz de birkaç çevrecinin yardımıyla birçok su kaynağına uygun balık yavruları koymayı ve yapay yollarla balık miktarını artırmayı planladık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140717
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140717,
					"content": "Diğer bir yandan Mekabalıkları yok etmeleri ve toplamaları için maceracılar tuttuk. Bu şekilde su ekosistemimizi korumak için iki yönlü yaklaşım oluşturduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140718,
						240140719
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140718,
					"content": "Etkileyici bir azim doğrusu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140720
					]
				},
				{
					"id": 240140720,
					"content": "İltifatın için teşekkürler. Biliyorum, bu bir gazetecinin yapması gereken bir şeymiş gibi gelmiyor ama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140721
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140721,
					"content": "Cepheye gidip iş yapmanın, makale ve yazı yazmaktan çok daha önemli olduğuna inanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140727
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140727,
					"content": "Ancak cephede bu şekilde çalışarak en güvenilir ve doğru bilgiyi edinip en iyi makaleleri yazabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140722
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140722,
					"content": "Vay canına, bu gazeteci gerçekten çok iyi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240140723,
					"content": "Senin için ne yapabilirim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140724
					]
				},
				{
					"id": 240140724,
					"content": "Hımm. Teklifin için teşekkür ederim. Şu anda dalgıç giysim kullanılmaz halde olduğu için suya dalıp balık yavrularını koyamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140725
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140725,
					"content": "Zahmet olmazsa benim için dalabilir misin? Derin ya da sığ olması fark etmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140719,
					"content": "Muhteşem bir plan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140720
					]
				},
				{
					"id": 240140711,
					"content": "Su dışındaki her şeyi çöp sayıyorlar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140712
					]
				}
			]
		},
		{
