			"dialogs": [
				{
					"id": 240140801,
					"content": "Bu Mekabalıklar... Tam bir baş belası!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140802,
						240140803
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140802,
					"content": "Ne oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140804
					]
				},
				{
					"id": 240140804,
					"content": "Onardım ama hemen yine paramparça oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140805
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140805,
					"content": "Bu bölgedeki Mekabalıklar bir nedenden ötürü... Vahşileşmişler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140806
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140806,
					"content": "Yavru balıkları buraya koymaya kalktığım anda etrafımı sardılar ve yavruları durmaksızın yediler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140807
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140807,
					"content": "Hatta bazıları dalgıç giysimde yavru balık kaldığı için üzerime bile atladı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140808
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140808,
					"content": "Bana saldırmayacaklarını biliyorum ama... Yine de çok korktum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140809
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140809,
					"content": "Onlara karşı koymaya çalışarak suda çırpındım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140810
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140810,
					"content": "Nasıl oldu bilmiyorum ama bu, dalgıç giysimde büyük bir yırtık daha açtı... Neyse ki kıyıya yakın olduğum için sudan hemen çıkabildim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140811
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140811,
					"content": "Ancak mevcut durumda yavru balıkları dağıtmamın imkanı yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140812
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140812,
					"content": "Gezgin, bana tekrar yardımcı olabilir misin? Sığ ya da derin olması fark etmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140803,
					"content": "Dalgıç giysini onardın mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140804
					]
				}
			]
		}
	]
}