				},
				{
					"id": 240140204,
					"content": "Merhaba. Tanıştığımıza memnun oldum. Ben Linorea, çevresel sorunlarda uzmanlaşmış bir gazeteciyim. Ben... Suya balık yavruları koyuyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140205
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140205,
					"content": "Bir dakika, sen tanıdık görünüyorsun. Semaine'ı son gördüğümüzde onunla değil miydin Linorea?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240140206,
					"content": "Sen yoksa Semaine'ın...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140207
					]
				},
				{
					"id": 240140207,
					"content": "Bir dakika, Semaine'ı tanıyor musunuz? Siz... Aa, o hediyeleri getirmesine yardımcı olanlar sizler miydiniz? Çok teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140208
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140208,
					"content": "Semaine, geçen ben operadan döndükten sonra bahsetmişti yardımlarınızdan. Dürüst olmak gerekirse bir süredir sizi evimde bir yemeğe davet etmek istiyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140209
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140209,
					"content": "Sizinle burada karşılaşacağımı düşünmemiştim... Ama gerçekten kötü bir zamanda yollarımız kesişti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140210
					],
					"speakerTitle": "Linorea"
				},
				{
					"id": 240140210,
					"content": "Suya balık yavrusu attığını söylemiştin, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240140211,
					"content": "Peki bunu neden yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240140212
					]
				},
				{
					"id": 240140212,
					"content": "Mekabalıkları biliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240140213,
						240140214
					],
					"speakerTitle": "Linorea"
				},
				{
