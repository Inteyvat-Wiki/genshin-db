			"dialogs": [
				{
					"id": 742530101,
					"content": "Dürüst olmak gerekirse hâlâ şoktayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530102
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742530102,
					"content": "Biliyor musun, o zamanlar Alain de ben de senin bu dünyadan çoktan ayrıldığını sanıyorduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530103
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742530103,
					"content": "Hımm... Biraz daha erken uyansaydık seni ve Alain'i görmeye gelebilirdik belki. Ama ne yaparsın, kader işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530104
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530104,
					"content": "Bayan Mary-Ann...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530105
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742530105,
					"content": "Şu kaderin cilvesine bak. Ann ile seyahatlerimiz sırasında bir film afişinde senin portreni göreceğimiz kimin aklına gelirdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530106
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530106,
					"content": "Yani bu yüzden mi benimle iletişime geçmeye karar verdin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530107
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742530107,
					"content": "Aynen öyle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530108
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742530108,
					"content": "Ah... Kahve kokusu. Beni eski günlere götürdü... Hehe, bizi çay saatine davet ettiğin için teşekkür ederiz Bayan Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530109
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530109,
					"content": "Bahçenizin o kadar hoş bir düzeni var ki... Sizin gibi zarif bir hanımefendiye de bu yaraşır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530110
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530110,
					"content": "Burası bir zamanlar Alain ile yuvamızdı. Bu güzelliği yaşatmanın en doğrusu olduğuna inanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530111
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742530111,
					"content": "Gördün mü? Bu işte şimdiden abimden fersah fersah öndesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530112
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530112,
					"content": "Alain odasını dekore bile etmezdi. Güzel şeylerden anlamıyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530113
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742530113,
					"content": "Evet, Rene de aynı öyleydi. Bir odayı güzelce süsleyip çay saati hazırlayabilen bir tek Jakob'la ben vardık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530114
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530114,
					"content": "Küçükken de mi öyleydi? Ben hep yaşından dolayı olduğunu sanırdım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530115
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742530115,
					"content": "Hep öyleydi. Çalışmaları söz konusu olunca zehir gibiydi ama diğer konularda pek becerikli sayılmazdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530116
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530116,
					"content": "Belki de bu yüzden içimizden tatlı bir rüyanın yalanına sığınmak yerine acı gerçekleri seçen tek kişi o oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530117
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530117,
					"content": "Hım. Seçiminden pişman olduğunu sanmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530118
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742530118,
					"content": "Ben de sanmam, sonuçta bir kahraman olarak dileği buydu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530119
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742530119,
					"content": "Asıl pişman olan biziz. Onu bu dileğiyle bir başına bırakmamalıydık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530120
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742530120,
					"content": "Peki ya siz Bayan Sandrone? Dilediğiniz bir şey var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530121
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530121,
					"content": "Alain de bir keresinde bana aynı soruyu sormuştu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530122
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742530122,
					"content": "Hımm? O da mı sordu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530123
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530123,
					"content": "Abi çok olgunlaşmış. Onu tanıdığım zamanlarda asla böyle bir şey sormazdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530124
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530124,
					"content": "\"Dilek\" çok boş bir kelime. İstediğin her şeye sahip olabilir misin hiç? Hah, öyle olsa dünyada kötülük diye bir şey olmazdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530125
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742530125,
					"content": "Yapmak istediğim ve doğru olduğuna inandığım şeyi yapıyorum. Bu bir dilek sayılır mı bilmiyorum ama beni mutlu ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530126
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742530126,
					"content": "Hımm, bu harika bir şey. Sana imreniyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530127
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530127,
					"content": "Peki Alain'e... Kızgın mısın? Sonuçta seni... Mary-Ann'in suretinde yarattı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530128
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530128,
					"content": "Hiç değilim. Her zaman kendime has, eşsiz ve ayrı bir birey olduğumu ve kendi yolumu çizmem gerektiğini açıkça belirtti. Ben de tam olarak bunu yaptım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530129
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742530129,
					"content": "Haha, konu ister hikayeler olsun ister yiyecek... Sen kendi seçimlerinle mutlu olduğun sürece senin için en doğrusu odur Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530130
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742530130,
					"content": "Kesinlikle. O halde şimdi, bizim için özenle hazırladığın yiyeceklerin sessizce tadını çıkaralım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mary-Ann"
				}
			]
		},
