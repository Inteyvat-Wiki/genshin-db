			"dialogs": [
				{
					"id": 742530201,
					"content": "Her şey huzurlu ve sakinken hayat ne güzel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530202,
						742530203
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530202,
					"content": "(Biraz daha oturalım.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530204
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742530204,
					"content": "Saat o kadar oldu mu? Haha. Daha sık görüşelim Bayan Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742530203,
					"content": "Yavaş yavaş toparlansam iyi olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530204
					],
					"speakerTitle": "Kukla"
				}
			]
		}
	]
