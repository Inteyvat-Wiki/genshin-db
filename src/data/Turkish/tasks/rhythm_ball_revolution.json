			"dialogs": [
				{
					"id": 755080101,
					"content": "Selam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080102
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 755080102,
					"content": "Onur konuklarımız gelmiş! İşte şimdi parti başlayabilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080103
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 755080103,
					"content": "Selam Mualani! Aa, Xilonen de buradaymış!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755080104,
					"content": "Mizuki? Inazuma'dan ne ara döndün sen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755080105,
					"content": "Döndüm işte. Natlan'daki dostlarım benim ailem gibidir. Kaplıca Halkını uzaktaki evim gibi görüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080106
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 755080106,
					"content": "Buranın halkına yardım etmek istiyorsam Natlan'daki şubemi ihmal etmemem gerekir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080107
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 755080107,
					"content": "Bayan Mizuki'nin iş ahlakı takdire şayan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080108
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755080108,
					"content": "Diğer hizmet sağlayıcıları olarak kendisine karşı mahcup oluyoruz ama böyle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080109,
						755080110
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755080109,
					"content": "Yoksa... Sen de onun müşterisi misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080111
					]
				},
				{
					"id": 755080111,
					"content": "Son zamanlarda tuhaf rüyalar görüyorum... Mesela müşterinin dört haftalık sipariş süresini bir haftaya düşürmesi gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080112
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755080112,
					"content": "Ya da tehlike barındıran küre şeklindeki bir aksesuarın acil siparişi gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080113,
						755080114
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755080113,
					"content": "Bunu biliyorum. Bodurloplar ve Mantarlar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080115
					]
				},
				{
					"id": 755080115,
					"content": "Vay be, hemen çaktın köfteyi Gezgin. Gören de Xilonen'e rüyasında o tuhaf siparişleri sen veriyorsun sanır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755080116,
					"content": "O yaratıklar... Tehlikeli mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080117
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755080117,
					"content": "Neyse, zor kısmı sipariş süresi değil. Küre tasarımlar aldatıcıdır ve aceleye getirirsen sonuçlar hiç de güzel olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080118
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755080118,
					"content": "Son zamanlarda hep böyle rüyalar görüyorum. O yüzden tüm siparişlerimi tamamladım ve Bayan Mizuki'den yardım istemeye karar verdim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080119
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755080119,
					"content": "İlaç gibi geldi! O gün öğleden sonra uyuduğumda tuhaf rüyalardan eser kalmamıştı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080120
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755080120,
					"content": "Yardım edebildiğime sevindim Bayan Xilonen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080121
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 755080121,
					"content": "Yine de o rüyalardan kurtulmanda sadece benim payım olduğu söylenemez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080122
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 755080122,
					"content": "Sonuç olarak herkes uykusunu aldı ve keyifler yerinde! Şimdi parti zamanı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080123
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 755080123,
					"content": "Suyun üzerinde bir parti desek daha doğru olur! Kabile geleneğimizdir, çok eğlenceli olacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080124,
						755080125
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 755080124,
					"content": "Suyun üzerinde bir parti demek...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080126
					]
				},
				{
					"id": 755080126,
					"content": "Evet! Hadi partileyelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755080127,
					"content": "... Bu arada, partide tam olarak neler var? Lezzetli yemeklerin ve içeceklerin dışında yani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755080128,
					"content": "Natlan'da nasıl parti yapılır ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080129,
						755080130,
						755080131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755080129,
					"content": "Koholazorla çok hızlı bir şekilde sörf yapılabilir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080132
					]
				},
				{
					"id": 755080132,
					"content": "Ne? Sen ciddi misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755080133,
					"content": "Yok artık, tam bir ekstrem spor tutkunuymuşsun da haberim yokmuş. Açıkçası benim aklıma da ilk onlar gelmişti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080134
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 755080134,
					"content": "Ama Şef Amina'nın da dediği gibi... *öhöm* \"Herkes yüksek adrenalinli aktiviteleri sevmez!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080135
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 755080135,
					"content": "\"Plaj voleybolu bile tehlikeli olabilir. Keyifli bir oyundur ama arkadaşının kafasına sert bir top gelirse oyunun tadı kaçar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080136
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 755080136,
					"content": "\"Bu etkinliğin eğlenceli olması lazım. İnsanları yaralayacak ve Bayan Mizuki'ye ekstra iş çıkaracak türden şeylere bulaşmayalım!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080137
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 755080137,
					"content": "Haksız sayılmaz. Seve seve yardımcı olurum ama hastalarımın travmalarına bizzat katkı sağlamak da istemem. Kimsenin zarar görmemesi daha iyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080138
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 755080138,
					"content": "Aynen öyle, işte bu yüzden senden tavsiye almaya geldim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080139
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 755080139,
					"content": "Ee, plan nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755080140,
					"content": "Ayrıca herkesin ekstrem sporlarda tecrübesi yok ve bazılarımızın bu yüzden etkinliğe katılmamasını istemeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080141
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 755080141,
					"content": "Sohbet sırasında Mikawa Çiçek Festivalinden ve oyunlara yönelik rahat yaklaşımlarından bahsetmiştim ve Bayan Mualani'nin çok ilgisini çekmişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080142
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 755080142,
					"content": "Böylece Akitsu Haneasobi'ye bir Natlan dokunuşu yapmaya karar verdik! Ve ortaya hem rahat hem eğlenceli bir oyun olan \"Ritim Topu\" çıktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080143
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 755080143,
					"content": "Bir Inazuma oyunu... Üstelik Natlan dokunuşuyla! Müthiş bir fikir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080144,
						755080145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755080144,
					"content": "Burası Yankıların Çocuklarının Dans Pisti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080146
					]
				},
				{
					"id": 755080146,
					"content": "Vay be, halbuki yüksek sesle bile dinlemedin henüz. Ritim duygun iyiymiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080147
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755080147,
					"content": "Ve tahmin edeceğin üzere bu duygu \"Ritim Topu\"nda çok işine yarayacak. Amaç, müziğin ritmiyle toplara vurarak tüm blokları parçalamak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080148
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755080148,
					"content": "Karmaşık teknikler yok, güvende miyiz derdi yok, sadece içgüdüler ön planda. Herkesin keyif alacağı bir oyun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080149
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755080149,
					"content": "Bu arada tabii sen becerilerin sayesinde müziğe yeni katmanlar ekleyebilir ya da yeni bir ritim duygusu geliştirebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080150
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755080150,
					"content": "Sonuçta farklı DJ'ler aynı şarkıya bambaşka bir hissiyat kazandırabilir. Ve ritimlerin olduğu bir oyunda, oyuncular tüm yaratıcılıklarını sergileyebilirler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080151
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755080151,
					"content": "Kim bilir... Rahatlatıcı bir arka plan müziği senin ellerinde bir \"trance\" ya da \"artcore\" parçaya dönüşebilir belki de!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080152
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755080152,
					"content": "Neler yaratacağını görmek için sabırsızlanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080153
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 755080153,
					"content": "#Hıhı, sen nasıl dersen... Yapabileceğin bir şey gibi duruyor, değil mi {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080154,
						755080155
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755080154,
					"content": "Herhalde, müzik ve oyun benim işim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080156
					]
				},
				{
					"id": 755080156,
					"content": "İşte aradığım ruh! Sen ve Paimon iyi vakit geçirirseniz görevi tamamlamış sayılırız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080157
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 755080157,
					"content": "Ben de izlerken yiyebileceğimiz biraz atıştırmalık ve içecek alayım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080158
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 755080158,
					"content": "#Kendini fazla kaptırma, olur mu {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080159
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 755080159,
					"content": "Gece uyumadan önce zihninde sürekli bir Dans Pisti müziğinin dönüp durmasını istemezsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080160
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 755080160,
					"content": "Teşekkürler herkese! Çok eğleneceğiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755080161
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755080161,
					"content": "Bu arada zihnimizde sürekli çalan DJ Xilonen olacaksa o kadar da fena olmaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 755080155,
					"content": "Tabii! Elimden geleni yapacağım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080156
					]
				},
				{
					"id": 755080145,
					"content": "Müziğin ritmini gerçekten hissedebiliyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080146
					]
				},
				{
					"id": 755080130,
					"content": "Gukuzorun sırtından atlayarak hava dalışı gerçekleştirilebilir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080132
					]
				},
				{
					"id": 755080131,
					"content": "Ya da bir Yumkazorla halatsız bungee jumping yapılabilir... Bunu denedim bu arada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080132
					]
				},
				{
					"id": 755080125,
					"content": "Kulağa eğlenceli geliyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080126
					]
				},
				{
					"id": 755080114,
					"content": "Uçarloplar ve Balon Ahtapotlardan mı bahsediyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755080115
					]
				},
				{
