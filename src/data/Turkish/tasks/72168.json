			},
			"dialogs": [
				{
					"id": 721680201,
					"content": "Parvaneh, gerçekten bunu yapmanın başka bir yolu yok mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680202
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680202,
					"content": "Kitapta yalnızca bu yazıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680203
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680203,
					"content": "Keşke yolumuzu kesen yalnızca bir grup canavar olsaydı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680204
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721680204,
					"content": "Bu Kiraz Çiçeklerini mi arıyordunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680205
					]
				},
				{
					"id": 721680205,
					"content": "Ah! Evet, onlar! Şu renge bak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680206
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680206,
					"content": "Vay canına! Sanırım sonunda yiyebileceğiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680207
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721680207,
					"content": "Bir saniye, bariyeri geçtin mi? Sana söylediğimiz yöntemi mi kullandın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680208
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680208,
					"content": "Öyle yaptım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680209
					]
				},
				{
					"id": 721680209,
					"content": "Bana Yıldırım Kirazı Dalını nereden bulduğunu söyleyebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680210
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680210,
					"content": "Dala dokununca Elektrik Taneciği üzerinde nasıl bir etki bıraktı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680211
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680211,
					"content": "Bekle, üzgünüm, önce defterimi çıkarayım. Elektrik Taneciği sana yapıştıktan sonra bir şey hissettin mi? Bir de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680212
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680212,
					"content": "Parvaneh, lütfen, Gezgine biraz müsaade et. Daha yeni bize yardımcı oldular... Araştırman biraz bekleyebilir, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680213
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680213,
					"content": "Çok teşekkürler Gezgin. Anlaştığımız gibi karşılığını alacaksın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680214
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680214,
					"content": "İlk önce bizi bir süre burada beklemen gerek. Getirdiğin Kiraz Çiçekleriyle bir yemek hazırlayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680215
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680215,
					"content": "Inazuma'ya özgü, Kiraz Çiçekli Tempura adında bir yemek olduğunu duymuştum. Sanırım bu yemeği deneme vakti geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680216
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721680216,
					"content": "Hazırlamam için bana biraz zaman ver. Çok süreceğini düşünmüyorum, biraz sonra tekrar gel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		},
		{
			"id": 7216803,
			"completionStepIds": [
				7216804
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7216804",
							"2"
						],
						"stepId": 7216804,
						"stateName": "QUEST_STATE_UNFINISHED"
