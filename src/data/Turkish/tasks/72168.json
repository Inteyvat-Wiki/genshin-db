					"nextDialogs": [
						721680404
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721680404,
					"content": "Yöntemini benim için bir kez daha anlatabilir misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680405
					]
				},
				{
					"id": 721680405,
					"content": "Anlatayım. Kısaca, buralarda Yıldırım Kirazı Dalı diye bilinen şeyi bulup dokunmalısın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680406
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721680406,
					"content": "Daha sonra Elektrik Taneciği denen şey sana yapışacak ve bu sayede bariyeri aşabileceksin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				}
			]
