			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400040201,
					"content": "#Vay vay, uzun zamandır görüşmemiştik {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040202
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040202,
					"content": "Kaeya, Liyue'deki Fener Şenliğine gittik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040203,
					"content": "Ne güzel. Nasıldı? Eğlendiniz mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040204
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040204,
					"content": "Lezzetli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040205,
					"content": "Peki öyleyse, Mondstadt Harpastum Festivalini dört gözle bekliyor olmalısın. Beğeneceğine eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040206
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040206,
					"content": "Konuya gel, Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040207
					]
				},
				{
					"id": 400040207,
					"content": "Tamam, tamam! Kaeya, sana anlatmamız gereken bir konu var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040208,
					"content": "Hım... Fener malzemeleri... Odun, kağıt ve yağ... Kazaya davetiye çıkarmışlar gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040209
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040209,
					"content": "Haha, ne kadar da eğlenceli. Bu sembolü biliyor olabileceğimi nereden çıkarttın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040210,
						400040215
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040210,
					"content": "Her konuda harikasın ve sana güveniyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040211
					]
				},
				{
					"id": 400040211,
					"content": "İşte hepsi bu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040212,
					"content": "Hah. Gururum okşandı ama beni gözünde biraz büyütüyor olabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040213
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040213,
					"content": "İşte! Sonunda Kaeya mükemmel bir şekilde hazırlayıp ustalıkla dile getirerek, şövalye erdemlerinden alçak gönüllülüğünü sergiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040214,
					"content": "Bak sen, Liyue'de geçirdiğin zamanda daha da akıllanmış ve kelime dağarcığını artırmış gibisin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040220
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040220,
					"content": "Neyse, konudan uzaklaştım. Bu sembol, sizin Hazine Avcıları olarak bildiğiniz sınır ötesi suç örgütüne ait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040221
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040221,
					"content": "Daha fazlasını öğrenmek istiyorsan, seni içeriden bir muhbirle iletişime geçirebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040222
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040222,
					"content": "Şey, az önce Favonius Şövalyelerinin düşmanla anlaşma yapmadığını söylememiş miydin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040223,
					"content": "Bu benim özel muhbirim. Favonius Şövalyeleriyle bir ilgisi yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040224
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040224,
					"content": "Biraz bekleyip Rüzgaralan'a gidin. Muhbire sizinle orada buluşmasını söyleyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040225
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040225,
					"content": "Teşekkürler Kaeya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040226,
					"content": "Sakın unutma; \"bilgiye ulaşmanın yolu şaraptan geçer\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040227
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040227,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040215,
					"content": "Olayla karanlık tarafınla yakınlaşan biri olarak bunu bilirsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040216
					]
				},
				{
					"id": 400040216,
					"content": "Kesinlikle öyle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040217,
					"content": "Hayır! Ne söylediğine dikkat etmelisin Fahri Şövalye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040218
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040218,
					"content": "Karanlık tarafla yakınlaştığımı söylerken ne demek istiyorsun? Favonius Şövalyeleri düşmanlarıyla anlaşma yapmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040219
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 400040219,
					"content": "Bunun \"dürüstlük\" adı verilen bir şövalye erdemiyle ilgisi var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040220
					],
					"speakerTitle": "Kaeya"
				}
			]
		},
		{
			"id": 4000403,
			"completionStepIds": [
				4000403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4000403",
							"2"
						],
						"stepId": 4000403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nimrod"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400040301,
					"content": "Ha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040302
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040302,
					"content": "Hey! Buluşacağımız o kişi, Kaeya'nın muhbiri sensin, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040303,
					"content": "Muhbir mi? Ben değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040304
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040304,
					"content": "Ama... Burada buluşacağız diye anlaşmıştık ve sen de buradaki tek kişisin. Yani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040305,
					"content": "\"Burada buluşmak\" mı? Heh, ben bir şey bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040306
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040307,
					"content": "Bilgiye ulaşmanın yolu şaraptan geçer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040308
					]
				},
				{
					"id": 400040310,
					"content": "Şaraplı maraplı bir şey.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400040311
					]
				},
				{
					"id": 400040306,
					"content": "Ah, bu kadar sinir bozucu olmayı bırak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040307,
						400040310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040308,
					"content": "Tamam. Evet, benim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040309
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040309,
					"content": "Yaptıkların çok mu gerekliydi acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040311,
					"content": "Hım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040312
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040312,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040313,
					"content": "Tamam, teknik olarak şifreyi yanlış söyledin ama evet şarapla ilgili bir şeydi ve o bir şeyin, bilgiye giden yol olduğunu varsayıyorum. Şimdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040314
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040314,
					"content": "Evet, yeterince yakın. Buyurun benim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040315
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040315,
					"content": "Yaptıkların çok mu gerekliydi acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040316,
					"content": "Ne öğrenmek istiyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040317
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040317,
					"content": "*iç çeker* Durum şöyle ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040318,
					"content": "Tamam. Anlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040319
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040319,
					"content": "Yani? Bize içeriden biri olarak ne söyleyebilirsin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040320,
					"content": "Hazine Avcılarının işi olduğunu düşünmüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040321
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040321,
					"content": "Hazine Avcılarının dev bir sınır ötesi operasyonu sürdürebilmelerinin nedeni, tek bir temel ilkeye bağlı kalmalarıdır. O da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040322
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040322,
					"content": "İhtiyatlı bir şekilde hareket ederek faaliyet gösteriyorlar. Aksine, büyük riskler alarak bir servet yapmak, onların gözünde son derece saçma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040323
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040323,
					"content": "Liyue'yi koruyan Adeptuslar var, değil mi? Ayrıca Adeptuslar Fener Şenliği sırasında fazlasıyla aktif oluyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040325
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040324,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040325,
					"content": "Bu yüzden bunu bizim... Pardon, \"onların\"! Dilim sürçtü, benim kadar uzun süre gizli görevde olunca ister istemez... Neyse, nerede kalmıştım? Heh, evet. Onların, yani Hazine Avcılarının Fener Şenliği sırasında harekete geçmesine imkan yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040326
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040326,
					"content": "Ayrıca Liyue'deki Hazine Avcıları örgütüne yakın zamanda isimsiz bir mektup geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040327
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040327,
					"content": "Biri neden onlara isimsiz bir mektup yollasın ki? Suçu onlara atmak istediği için olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 400040328,
					"content": "Kimse bilmiyor ama sana sadece mektubun hangi Hazine Avcıları şubesinde olduğunu söyleyebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040329
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040329,
					"content": "İşte. Haritanda yerini işaretledim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400040330
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 400040330,
					"content": "#Harika. Yani, Paimon bu konuşmanın verimli geçtiğini düşünüyor! {NICKNAME}, tek sağlam ipucumuz bu. Boşa harcamayalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
