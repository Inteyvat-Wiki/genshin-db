			"dialogs": [
				{
					"id": 730141201,
					"content": "Vay be... Paimon onları böyle bir yerde bulacağımızı hiç düşünmemişti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141202,
					"content": "Bir saniye! \"Dallar ve yaprakların\" bunlar olduğuna emin misin? Bunlar sanki biraz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141203,
					"content": "Aranaraların yerleştirdiği taşlar gibi sanki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141204
					]
				},
				{
					"id": 730141204,
					"content": "Taş yapraklar ve taş dallar. Aramuhukunda ve Doğa Efendisi tarafından oluşturuldular ve Vanarana'nın gücünü Varuna Mekanizmasına aktarıyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141205
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141205,
					"content": "Öyleyse Varuna Mekanizması tıpkı kocaman bir ağaç gibi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141206
					]
				},
				{
					"id": 730141206,
					"content": "Ah, demek öyle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141207,
					"content": "Hımm... Eyvah. Üç yaprağın da şu dala doğru bakması lazım ama Arapandu yeterince güçlü değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141208
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141208,
					"content": "#Siz Aranaralar biraz ufaksınız cidden. Endişelenme, bunu Nara {NICKNAME} halleder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141209,
					"content": "Belki Arabalika bu işi halledebilir ama Aranakula ve Arakunti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141210
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141210,
					"content": "#Yine de önce bu sorunu halletmemiz lazım. Arapandu bu işi sana bırakıyor Nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				}
			]
		},
