			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arapandu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730141501,
					"content": "#Teşekkür ederim Nara {NICKNAME}. Gerisini Arapandu halleder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141502
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141502,
					"content": "Fakat çok uzun zaman geçti. İşe yarayacak mı emin değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141503
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141503,
					"content": "Nasıl yani? İşe yaramama ihtimali de mi var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141504,
					"content": "Önceden sorun çıkmamıştı ama şimdi işe yaramayabilir. Güneş de her gün doğuyor ama yarın da doğacağından emin olamıyoruz ya, onun gibi bir şey.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141505
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141505,
					"content": "Paimon, ancak güneşin doğduğunu görünce \"ah, güneş tekrar doğdu\" diyebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141506
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141506,
					"content": "Bir saniye ya, Paimon korkmaya başladı! Ya güneş bir daha asla doğmazsa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141507,
					"content": "#Korkmana gerek yok Paimon. Nara {NICKNAME} tıpkı güneş gibi, altın gibi parıldıyor. Aynı Nara Varuna gibi. Nara {NICKNAME} cesur bir Nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141508
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141508,
					"content": "#Nara Varuna bizlere ayla güneşi getirmişti. Nara {NICKNAME} de aynı şeyi yapabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141509
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141509,
					"content": "Evet! Paimon da ona güveniyor. O, her türlü zorluğun üstesinden gelebilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141510,
					"content": "Endişeye gerek yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141511
					]
				},
				{
					"id": 730141511,
					"content": "Ama şimdilik bu işi Arapandu'ya bırakın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141512
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141512,
					"content": "Paimon işe yaradığını düşünüyor, ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141513,
					"content": "Evet, buradaki dal ve yapraklar iyileşti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141514
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141514,
					"content": "Harika! Senin Aranara dansın da gerçekten çok ilgi çekiciydi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141515,
					"content": "Sen de Aranaralardan dans etmesini öğren Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141516
					]
				},
				{
					"id": 730141516,
					"content": "Çok iyi olur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141517,
					"content": "Ne kadar yemek yediğini düşünürsek, biraz egzersiz senin için iyi olur...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141518
					]
				},
				{
					"id": 730141518,
					"content": "#Ne dedin sen? Paimon da {NICKNAME} ile birlikte oradan oraya koşup duruyor. O da egzersiz sayılır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141519,
					"content": "Neyse. Bu, Varuna Mekanizmasını tamir etmeye yetmeyecek, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141520,
					"content": "Vana'da bunun gibi üç farklı yer daha var. Arabalika oldukça güçlüdür ve bu işi başarabilir; Arapandu ise Aranakula ve Arakunti için çok endişeleniyor. O tuhaf yağmurdan sonra Vana çok daha tehlikeli bir yer haline geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141521
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141521,
					"content": "O halde biz senin için gidip onlar ne durumdalarmış bir bakalım. Sonuçta, Varuna Mekanizması tamir edilmezse içimiz rahat bir şekilde Utsava Festivaline hazırlanamayız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141522,
					"content": "#Nara {NICKNAME} ve Paimon'un yardımıyla, Varuna Mekanizması yakında kesinlikle tamir edilecek. Tıpkı geçmişte olduğu gibi Vana'ya hayat gelecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141523
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141523,
					"content": "Aranakula <color=#00E1FFFF>Yasna Abidesi'ne</color> gitti. Vana'nın derinliklerinde Aranaraların Nara Varuna için yaptığı bir anıt duruyor. Ne yazık ki Mantarlar ve sporlar yüzünden uzun zamandır oraya gidemedik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141524
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141524,
					"content": "Aranakula toprak ve tohumlarla iç içe olmaya alışıktır. Topraktan gelen bir şey onu kolay kolay şaşırtamaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141525
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141525,
					"content": "Onu bulun ve Arapandu'nun selamını söyleyin. Sonrasında korkmayacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141526
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141526,
					"content": "Biraz çekingen bir Aranara gibi geldi bana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141527,
					"content": "#Arabalika'nın Ararakalarisi oldukça güçlüdür! Ama yine de... Lütfen gidip onun ne durumda olduğuna bir bakın Paimon ve Nara {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141528
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141528,
					"content": "#Arabalika <color=#00E1FFFF>Dahri Harabeleri'nde.</color> Orada yoğun bir demir kokusu var... Paimon ve Nara {NICKNAME} dikkatli olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141529
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141529,
					"content": "Dikkat ederiz, teşekkürler!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141530
					]
				},
				{
					"id": 730141530,
					"content": "Arakunti <color=#00E1FFFF>Düşler Korusu'nda.</color> Oraya gidip rüyalara girebilirsiniz. Kendisi epeydir Naralardan uzakta kaldı, korkup saklanırsa müziğimizi çalın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141531
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141531,
					"content": "Hazır konusu açılmışken, önceden Aranaraların bestesini almamış mıydık? Arakunti'yi bulamazsak, o besteyi çalmayı deneyebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141532
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141532,
					"content": "Arapandu, \"dinlenme noktasında\" bekleyip Vana'nın nasıl olduğunu inceleyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141533
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141533,
					"content": "Aranakula, Arabalika ve Arakunti, dalları ve yaprakları iyileştirdikten sonra \"dinlenme noktasında\" buluşacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141534
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141534,
					"content": "#Altın Nara, cesur Nara. Aramuhukunda seni korusun Nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141535
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141535,
					"content": "Tabii ki! Bize güvenebilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7301417,
			"completionStepIds": [
				7301417
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301417",
							"2"
						],
						"stepId": 7301417,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Arapandu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730141701,
					"content": "Baksanıza! Oradaki şey de ne öyle? Harikaymış!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141702,
					"content": "#Artık Nara {NICKNAME} ve Paimon biliyor. Karşınızdaki Varunastra. Tabii Varuna Mekanizması daha derinlerde, hatta kökler kadar derinde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141703
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141703,
					"content": "Nara Varuna'yı hafife almışız. Paimon, onun bu kadar büyük olacağını tahmin etmemişti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141704,
					"content": "Böylesine bir güç hafife alınmamalı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141705
					]
				},
				{
					"id": 730141705,
					"content": "Kara yağmurdan ve Nara Varuna Vana'ya gelmeden önce, Aramuhukunda ile Doğa Efendisi birlikte Varuna Mekanizmasını yarattılar. Yağmur birçok şeye hayat verdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141706
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141706,
					"content": "Kara yağmur, kara çamur ve diğer pek çok kötü şey Vana'yı kirletmişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141707
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141707,
					"content": "O gelmeden önce Arapandu hiç böylesine cesur bir Nara görmemişti. Durgun sisin ardındaki güneşi nasıl getirdiyse, Aranaralarla birlikte makinayı da öyle tamir etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141708
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141708,
					"content": "Nara Varuna artık Vanarana'da değil. Aramuhukunda da artık Vanarana'da değil... Yine de Aranaralar, Utsava Festivali ve Vana için Varuna Mekanizmasını tamir etmeli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141709
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141709,
					"content": "Araja ve Arama'ya Utsava Festivali hazırlıklarına yardım edeceğimize dair söz vermiştik. Nasıl derler bilirsiniz, ne kadar çok Nara odun atarsa yangın da o kadar büyük olur, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141710,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141711
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141711,
					"content": "Yok yok! Paimon'un demek istediği ne kadar çok Nara yardıma koşarsa, işler o kadar sorunsuz ilerler! Korkma, yangın falan yok! Alakası yok yani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141712,
					"content": "Paimon, yine aştın kendini.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141713
					]
				},
				{
					"id": 730141713,
					"content": "Öyle deme ya. Ne de olsa şu an Sumeru'dayız. Paimon herkese çok şey bildiğini göstermek istedi, hepsi bu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141714,
					"content": "#Arapandu korkmadı. Paimon temiz kalpli birisi, tıpkı Nara {NICKNAME} ve Nara Varuna gibi. Paimon da Aranaraların dostu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141715
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141715,
					"content": "Aranakula, Arabalika, Arakunti ve Arapandu Varuna Mekanizmasını iyileştirmek istiyor ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141716
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141716,
					"content": "Sporlar ve Mantarlar her yerde, elimizden bir şey gelmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141717
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141717,
					"content": "Arapandu'nun Ararakalarisi Arabalika'nınki kadar güçlü değil. Üstelik tuhaf yağmur yüzünden Mantarlar daha da vahşileşti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141718
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141718,
					"content": "Bir saniye... Arana, Paimon'a demişti ki Ararakalariyi kullanarak Maranayı yenebilirsiniz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141719,
					"content": "Güçlü bir Ararakalari Mantarları temizleyebilir. Arapandu'nun Ararakalarisi güçsüz. Mantarlara hiçbir şey yapamaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141720
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141720,
					"content": "Ne? Ararakalari o şekilde kullanılabiliyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141721
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141721,
					"content": "Ararakalari belirli türdeki yeteneklere verilen genel bir isim olmalı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141722
					]
				},
				{
					"id": 730141722,
					"content": "#Nara {NICKNAME} Paimon'dan daha akıllı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141723
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141723,
					"content": "Üff...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141724,
					"content": "Her Aranaranın farklı Ararakalarisi vardır fakat tüm Aranaralar bu beceriyi kullanmak için Vana bitkilerinden güç alır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141725
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141725,
					"content": "Arabalika'nın Ararakalarisi çok güçlü. Büyük Mantarlar ve büyük demir Naralar onun için sorun değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141726
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141726,
					"content": "Büyük demir Naralar mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141727,
					"content": "#Büyük demir Naralar oldukça büyüktür ve tıpkı Nara {NICKNAME} gibi iki kolu ve iki bacağı vardır. Fakat tek gözlüdür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141728
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141728,
					"content": "Ah, Harabe Muhafızlarından bahsediyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141729,
					"content": "Hemen de bildin Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141730
					]
				},
				{
					"id": 730141730,
					"content": "Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141731
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141731,
					"content": "Ah! Şuradaki ağaçta Mantarlar var. Arabalika onları yenebilir fakat Arapandu yenemez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141732
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141732,
					"content": "#Nara {NICKNAME} Mantarlardan korkmuyor. Ararakalari kullanmamana rağmen çok güçlüsün. Güçlü bir rüzgarın yaprakları savuruşu gibi mahvet onları! Bir çırpıda bitir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141733
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141733,
					"content": "#Sporları ve Mantarları hızlıca temizlemezsen çoğalırlar Nara {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141734
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141734,
					"content": "#Bu işi bize bırak! Nara {NICKNAME} onların icabına hemencecik bakar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}