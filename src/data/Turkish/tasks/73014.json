					"content": "#Nara {NICKNAME} ile de iyi anlaşırsın kesin Arapandu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140315,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730140316
					]
				},
				{
					"id": 730140316,
					"content": "O Vanarana'dan ayrıldıktan sonra pek çok kişi topraktan geldi ve toprağa gitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140317
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140317,
					"content": "Sonrasında Varuna Mekanizmasının dalları ve yaprakları zayıfladı. Varunastra tıpkı ürkek bir serçe gibi kanatlarını çırptı. Ardından uzun bir süre yağmur yağdı. Çok tuhaftı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140318
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140318,
					"content": "Eskiden gezinen mantarlar şimdi Vana'da yaşıyor. Daha önce hiç görülmemiş tohumlar artık her yerde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140319
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140319,
					"content": "Mantarlardan ve sporlardan mı bahsediyorsun? İyi ama Varuna Mekanizması ve Varunastra ne peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140320,
					"content": "Güçlü birer silah olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140321,
						730140323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140321,
					"content": "Valuka'yı ikiye bölebilecek bir kılıç.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730140322
					]
				},
				{
					"id": 730140322,
					"content": "Bir saniye! Bu çok güçlü olur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140327,
					"content": "#Hımm... Hayır, öyle değil. Nara {NICKNAME} ve Paimon yanılıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140328
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140328,
					"content": "Yüksek bir yerlere çıkalım. Arapandu size anlatacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140323,
					"content": "Belki de silah değillerdir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730140324
					]
				},
				{
					"id": 730140324,
					"content": "Nedir o zaman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140325,
					"content": "Sudan yaratılmış kanatlı Aranaralar olabilir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730140326
					]
				},
				{
					"id": 730140326,
					"content": "Öyle olsa Okeanid sayılmazlar mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140327
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7301410,
			"completionStepIds": [
				7301410
			],
