				"points": []
			},
			"dialogs": [
				{
					"id": 730141001,
					"content": "Demek burası \"dinlenme noktası\". İzlere bakılırsa Aranaralar bir süre önce buradaymış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141002,
					"content": "Buradan bakınca Varuna Mekanizması çok daha etkileyici. Ah... Basınç çok fazla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141003,
					"content": "Paimon, içine çekilmeyesin dikkat et.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141004
					]
				},
				{
					"id": 730141004,
					"content": "Öyle bir şey olmayacak! Yani, Paimon öyle umuyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141005,
					"content": "Bir anlaşma yaptık. Varuna Mekanizmasının dallarını ve yapraklarını iyileştirdikten sonra \"dinlenme noktasında\" buluşacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141006
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141006,
					"content": "Sonra da Varuna Mekanizmasının köklerini yiyen kötü böcekleri kovup onu iyileştireceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141007
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141007,
					"content": "Bu arada, \"Varuna Mekanizmasının dalları ve yaprakları\" derken neyi kastediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141008,
					"content": "Varuna Mekanizmasının dalları ve yaprakları Vana'nın her yerine dağılmıştır. Onlar kara yağmurun iyi yağmura dönüştürülmesi için gereken gücü sağlar. Sonra da iyi yağmur her şeye hayat verir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141009
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141009,
					"content": "Nasıl yağmur suları önce bir dereye sonra da göle akıyorsa dallar ve yapraklar da Varuna Mekanizmasına giren ufak tefek şeyleri temizliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141010
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141010,
					"content": "Varuna Mekanizması artık eskisi gibi değil. Dallar kırılıp yağmur suyunun akmasını engellediği için dereler oluşamıyormuş gibi düşünün. Dereler olmayınca da göl kuruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141011
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141011,
					"content": "Ah... Paimon hâlâ anlamadı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141012,
						730141017
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141012,
					"content": "Acıkmak gibi bir şey aslında.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141013
					]
				},
				{
					"id": 730141013,
					"content": "Ah, Paimon anladı! Paimon yemek yemeyince çalışacak gücü kalmıyor! Varuna Mekanizmasının açlıktan sinirleri mi bozulmuş yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141014,
						730141016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141014,
					"content": "Yani tam da öyle değil...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141015
					]
				},
				{
					"id": 730141015,
					"content": "Hımm, bu doğru! Aç olduğunda zaten kimsenin sinirlenecek gücü kalmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141021
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141021,
					"content": "Neyse, önce dallarla yaprakları iyileştirmemiz lazım, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141022
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141022,
					"content": "#Evet. Arapandu, Nara {NICKNAME} ile Paimon'u oraya götürecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730141016,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141021
					]
				},
				{
					"id": 730141017,
					"content": "Güvenli bir nakliye yolunun engellerle kapandığını hayal edin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141018
					]
				},
				{
					"id": 730141018,
					"content": "O zaman yolumuza devam etmek için bütün engelleri kaldırmamız gerek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141019
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141019,
					"content": "O zaman başka bir yol bulmamız lazım! Zaten kim bu yoldan gidelim dedi ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730141020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730141020,
					"content": "Sahi, kim bu yolu seçti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730141021
					]
				}
			]
		},
