				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Arapandu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730140301,
					"content": "Ah, Naraymış. Altın ve cesur Nara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140302
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140302,
					"content": "#Selam! Paimon'un adı Paimon ve bu da {NICKNAME}. Burada tek başına neler yapıyorsun bakalım? Vanarana'daki herkes Utsava Festivaline hazırlanmakla meşgul.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140303,
					"content": "Arapandu'nun Utsava Festivali için, Apam Ormanı için ve Nara Varuna için yapması gereken çok önemli bir görevi var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140304
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140304,
					"content": "O halde sen Arapandu olmalısın. \"Nara Varuna\" da kim? Hımm. Bu adı bir yerlerden hatırlıyorum sanki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140305,
					"content": "#Nara Varuna... O altın ve cesur bir Nara, tıpkı Nara {NICKNAME} gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140306
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140306,
					"content": "Ayın ve güneşin ortadan kaybolduğu sırada, Vanarana'daki büyük ağaçların yaprakları bile rüzgarla uçup gitti. Kara yağmur tüm dalları çürüttü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140307
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140307,
					"content": "Vana'nın acısı toprağa karıştı. Demir ve tuz kokusu dört bir yanı sardı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140308
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140308,
					"content": "Vay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140309,
					"content": "Nara Varuna gelene kadar güneşin kaç defa doğup battığını kimse bilmez. Nara Varuna Altın dilinde konuşan bir Altın Naraydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140310
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140310,
					"content": "Aranaralarla birlikte ayı ve güneşi geri getirdiler. Varuna Mekanizması, Vanarana'nın tüm acısını alıp götürdü. Kara yağmur kesilmişti ve demirle tuz kokusundan eser yoktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140311
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140311,
					"content": "Tıpkı güneşe, çamura ve çiy damlacıklarına benzeyen Nara Varuna'yı Vanarana'daki herkes çok sevdi ve ona teşekkür etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140312
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140312,
					"content": "Vay, harikaymış! O iyi bir Nara olmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140313,
					"content": "#Hehe... Tabii Nara {NICKNAME} için de aynı şeyler geçerli. Çoğu kişiye yardımı dokundu ve herkes ona minnettar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140314,
					"content": "#Nara {NICKNAME} ile de iyi anlaşırsın kesin Arapandu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140315,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730140316
					]
				},
				{
					"id": 730140316,
					"content": "O Vanarana'dan ayrıldıktan sonra pek çok kişi topraktan geldi ve toprağa gitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140317
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140317,
					"content": "Sonrasında Varuna Mekanizmasının dalları ve yaprakları zayıfladı. Varunastra tıpkı ürkek bir serçe gibi kanatlarını çırptı. Ardından uzun bir süre yağmur yağdı. Çok tuhaftı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140318
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140318,
					"content": "Eskiden gezinen mantarlar şimdi Vana'da yaşıyor. Daha önce hiç görülmemiş tohumlar artık her yerde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140319
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140319,
					"content": "Mantarlardan ve sporlardan mı bahsediyorsun? İyi ama Varuna Mekanizması ve Varunastra ne peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140320,
					"content": "Güçlü birer silah olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140321,
						730140323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140321,
					"content": "Valuka'yı ikiye bölebilecek bir kılıç.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730140322
					]
				},
				{
					"id": 730140322,
					"content": "Bir saniye! Bu çok güçlü olur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140327,
					"content": "#Hımm... Hayır, öyle değil. Nara {NICKNAME} ve Paimon yanılıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140328
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140328,
					"content": "Yüksek bir yerlere çıkalım. Arapandu size anlatacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730140323,
					"content": "Belki de silah değillerdir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730140324
					]
				},
				{
					"id": 730140324,
					"content": "Nedir o zaman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730140325,
					"content": "Sudan yaratılmış kanatlı Aranaralar olabilir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730140326
					]
				},
				{
					"id": 730140326,
					"content": "Öyle olsa Okeanid sayılmazlar mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140327
					],
					"speakerTitle": "Paimon"
				}
			]
		},
