			"dialogs": [
				{
					"id": 730420101,
					"content": "Arakanta senin hakkında çok şey duydu Altın Nara. Sen iyi bir Narasın. Arakanta'yla oynar mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420102
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420102,
					"content": "Arakanta'nın oyunu basit ve eğlenceli! Kuralları dinle Nara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420103
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420103,
					"content": "Arakanta birçok Doğa parçacığı çıkaracak. Bunlar çemberde saklanan \"Aranaralar\". Nara büyük ve güçlü bir \"Rishboland Kaplanı\". Hadi biraz \"Aranara\" kovala!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420104
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420104,
					"content": "\"Rishboland Kaplanı\" kısa sürede tüm Aranaraları yakalarsa Nara kazanır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420105
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420105,
					"content": "Beğendin mi? Nara, Arakanta'yla oyun oynamak ister mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakanta"
				}
