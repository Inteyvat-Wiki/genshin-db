			"dialogs": [
				{
					"id": 730420601,
					"content": "Çok eğlenceli! Arakanta, Altın Narayla oyun oynadığına çok sevindi! Ayrıca Nara çok hızlı ve harika! Tıpkı gerçek bir kaplan gibi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420602
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420602,
					"content": "Diğer Aranaralarla ve gerçek Rishboland Kaplanlarıyla oynamak eğlenceli ama yeni Nara arkadaşımızla oynamak daha eğlenceli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420603
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420603,
					"content": "Rishboland Kaplanı niye Aranaraları kovalasın ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730420604
					]
				},
				{
					"id": 730420604,
					"content": "Rishboland Kaplanı ve Aranaralar arkadaştır. Arkadaşlar birlikte oynar ama Arakanta, Naraların Rishboland Kaplanından korktuğunu fark etti. O yüzden Utsava Festivali için yeni bir oyun buldu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730420605
					],
					"speakerTitle": "Arakanta"
				},
				{
					"id": 730420605,
					"content": "Sağ ol Nara. Al, Altın Nara için bir çiçek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakanta"
				}
			]
