			"dialogs": [
				{
					"id": 747080101,
					"content": "#{NICKNAME}, Paimon, merhaba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080102
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080102,
					"content": "Bayan Guillotin bir akvaryum işlettiğinizden bahsetti. Ben de haliyle su altı yaşamı danışmanı olarak görev yapma davetini kabul ettim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080103,
						747080104
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080103,
					"content": "Seninle çalışmak harika olacak!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080105
					]
				},
				{
					"id": 747080105,
					"content": "Yaşasın! Başhemşire Sigewinne varken küçük balıkçıkların hastalanmasından endişelenmemize gerek yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747080106,
					"content": "Hehe, benden Chevalmarin Fantastik Film Diyarındaki hayvanlara bakmamı istediğinizden bu yana işin inceliklerini biraz kaptım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080107
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080107,
					"content": "Meğerse hayvanlara bakmak, hastalara bakmaktan pek de farklı değilmiş. En azından uslu olanlarına yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080108
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080108,
					"content": "Ama mesele de bu zaten, bütün balıklar uslu değil. Yani eldeki balıklara bakmak bir yana, rehabilitasyon uygulama konusunda da konuşmak istediğim birkaç fikrim var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080109
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080109,
					"content": "Buyur, dinliyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080110
					]
				},
				{
					"id": 747080110,
					"content": "Memur Ceasth'ın dediğine bakılırsa, bazı vahşi balıklar son günlerde normalden daha fazla hırçınlaşmış. Diğer canlıları geçtim, dalgıçlara ve hatta küçük teknelere bile saldırıyorlarmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080111
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080111,
					"content": "Acaba onları biraz kafa dinleyip rahatlamaları için akvaryuma mı davet etsek? En azından ortalığı birbirine katmalarına engel oluruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080112
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080112,
					"content": "Buraya geldiklerinde şu ani huysuzluklarını geçirmenin bir yoluna bakarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080113
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080113,
					"content": "Bu sayede balıkların ve suların normale geri dönmesini sağlarız, siz de akvaryumunuza birbirinden eşsiz konuklar eklemiş olursunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080114
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080114,
					"content": "Ne müthiş bir fikir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747080115,
					"content": "Ben varım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080116
					]
				},
				{
					"id": 747080116,
					"content": "Tamamdır, o saldırgan balıkları nerede bulabileceğinize dair tüm bildiklerimi anlatacağım. Gerisi sizde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747080104,
					"content": "Fazladan yardım aldığımıza çok sevindik!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080105
					]
				}
			]
		}
	]
}