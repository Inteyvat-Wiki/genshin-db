			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Amber"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4810102,
					"content": "Gayet güzel.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810104
					]
				},
				{
					"id": 4810103,
					"content": "Kendimi kaptırıp çok yüksekten uçup duruyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810104
					]
				},
				{
					"id": 4810101,
					"content": "#Merhaba {NICKNAME}! Her yerde seni arıyordum! Geçen sefer sana verdiğim kanatlar nasıl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810102,
						4810103
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810104,
					"content": "Anlaşılan iyice alışmaya başlamışsın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810105
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810105,
					"content": "Ama uçuş ehliyetin yok, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810106
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810106,
					"content": "Uçuş ehliyeti mi? Hım... O da neymiş?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810107,
					"content": "Adından anlaşılmıyor mu? Mondstadt'ta yasal olarak uçmak için uçuş ehliyetiniz olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810108
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810108,
					"content": "#Aa... Ama {NICKNAME} ile Paimon çok uzun zamandır kanatla uçuyor ki. Biz bunu ilk defa duyuyoruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810109,
					"content": "Evet, her tarafta uçup duruyordunuz... Herkes fark etti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810110
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810110,
					"content": "He he.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810111,
					"content": "Yani... Sen bize uçuş ehliyeti vermek istediğin için mi bizi arıyordun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810112,
					"content": "Asla olmaz! Favonius Şövalyelerinin katı kuralları var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810113
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810113,
					"content": "Sınavı geçmeniz gerekiyor. Ancak o zaman Şövalyeler ehliyetinizi verir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810114
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810114,
					"content": "#Bugün {NICKNAME} resmi uçuş ehliyeti sınavına giriyor, ben de ona gözetmenlik yapmak üzere geldim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810115
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810115,
					"content": "Kanatları ben verdim, bu yüzden bu benim sorumluluğum. Yani en azından Büyük Kumandan Vekili Jean öyle derdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810116
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810117,
					"content": "... Belki bana biraz kolaylık sağlarsın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810118
					]
				},
				{
					"id": 4810119,
					"content": "Sorun değil. Geçebilirim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810120
					]
				},
				{
					"id": 4810116,
					"content": "Sınav mı? Amma can sıkıcıymış. Yine de Amber sınav görevlisi olduğuna göre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810117,
						4810119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810118,
					"content": "Olmaz, ASLA olmaz! Sınav görevlisi Amber'ın otoritesine karşı çıkmayın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810121
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810120,
					"content": "#Eminim ki {NICKNAME} hiç zorlanmadan geçecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810121
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810121,
					"content": "Yani... Fırtına Dehşeti'nin saldırdığı gün nasıl uçtuğunu bütün şehir gördü. Merak etme, hiç sorun yaşamadan geçersin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810122
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810122,
					"content": "Ama kurallara uyup olması gerektiği şekilde uçmalıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810123
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810123,
					"content": "İşte. Bu uçuş kılavuzunu al. Ezberlemene gerek yok, burada yazanlara aşinalık kazansan yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810124
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810124,
					"content": "Örneğin: Her kanatta bir kişi uçabilir, belirlenen ağırlık sınırının üzerinde hiçbir şey taşınmamalıdır, bir Rüzgar Bodurlopu kullanarak kalkış yapılmamalıdır ve benzeri kurallar var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810125
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810125,
					"content": "Neyse, kılavuzu dikkatlice oku, tamam mı? Lisa bana büyü öğretirken ben de kocaman kalın kitaplar okumak zorunda kalmıştım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810126
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810126,
					"content": "Vay be, ne de kocaman eski bir kitap... Paimon hemen başlasak iyi olur diyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810127,
					"content": "Harika. Okuduktan sonra gelip beni bulun. Rüzgaralan'da olacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 4810401,
					"content": "*off* Favonius Şövalyeleri uçuş kılavuzunu okumak pek de eğlenceli OLMAYACAK bence...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810402,
					"content": "Neyse, başlasam iyi olur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4810602,
					"content": "Peri masalı gibi sanki...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810604
					]
				},
				{
					"id": 4810603,
					"content": "Mondstadtlılar uçmayı öğrenme konusunda gerçekten tutkulular.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810604
					]
				},
				{
					"id": 4810601,
					"content": "Hımm... Süper hikayeymiş... Peki ama Şövalyelerin uçuş kılavuzu cidden bu tarzda mı yazılmış?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810602,
						4810603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4810604,
					"content": "Hı. Neyse, hadi gidip Amber'ı bulalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}