			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jak"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741002601,
					"content": "#{NICKNAME}, gelmişsin! Bayan Lyris'in hazinesini elde edince zafere giden en önemli adımı da atmış olacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002602
					],
					"speakerTitle": "Jak"
				},
				{
					"id": 741002602,
					"content": "Nihayet istilacıları yenme ve Prenses Lyris'i kurtarma şansını yakaladık! Artık Jak Orkestrası gösterisini yapabilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002603
					],
					"speakerTitle": "Jak"
				},
				{
					"id": 741002603,
					"content": "Açılış müziğinin son bölümü!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002604,
						741002605
					],
					"speakerTitle": "Jak"
				},
				{
					"id": 741002604,
					"content": "Ciddi mi? Sadece açılış müziği mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741002606
					]
				},
				{
					"id": 741002606,
					"content": "Ah, Bayan Lyris'i kurtardıktan ve krallığı yeniden ayağa kaldırdıktan sonra her şeyin gerçekten sona ereceğini mi düşünmüştün? Hah! Gerçek dünyayı küçük bir peri masalından ibaret sandın herhalde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002607
					],
					"speakerTitle": "Jak"
				},
				{
					"id": 741002607,
					"content": "Dünya senin gibi düşünen avanaklarla dolu olduğu için tarih kendini tekerrür edip duruyor! Sonraki adımın, yerleşik sınıf yapısını ve toplumun zenginlik dağılım yöntemlerini ortadan kaldırmak olduğu ayan beyan ortada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002608
					],
					"speakerTitle": "Jak"
				},
				{
					"id": 741002608,
					"content": "Makul bir şekilde eşit olan bir dünyada eşitlik, olayların makul bir hali olmalıdır ve Bayan Lyris'in de çok istediği şey budur. Mevcut durumu göz önünde bulundurduğumuzda ise...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002609
					],
					"speakerTitle": "Jak"
				},
				{
					"id": 741002609,
					"content": "Benim gitme sıram geldi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741002610
					]
				},
				{
					"id": 741002610,
					"content": "Her şeyden önce doğal bir şekilde... Bu devrimin alt yapısını oluşturmalıyız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jak"
				},
				{
					"id": 741002605,
					"content": "Ben de senfoninin en doruk noktası olacak sanıyordum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741002606
					]
				}
			]
		},
