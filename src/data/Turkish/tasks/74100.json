		{
			"id": 7410025,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7410003",
							"2"
						],
						"stepId": 7410003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Al",
					"Petit Chou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741002501,
					"content": "Prenses Lyris'in hazinesini elde edebilirsek adalet kuvvetleri de zamanla daha da güçlenecektir! Narcissus'u yeneceğimiz güne az kaldı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002502
					],
					"speakerTitle": "Al"
				},
				{
					"id": 741002502,
					"content": "... İşte bu yüzden Ney'in kahramanca yaptığı fedakarlıkları unutamayız. Eğer hazineyi saklamasaydı Narcissus prensesin olduğu kuleye kesin ulaşırdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002503
					],
					"speakerTitle": "Al"
				},
				{
					"id": 741002503,
					"content": "Evet! Ney gerçekten harika!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002504
					],
					"speakerTitle": "Petit Chou"
				},
				{
					"id": 741002504,
					"content": "#Ne Ney'in çabalarının boşa gitmesine izin verilecek ne de olağanüstü katkılarından ötürü {NICKNAME} onurlandırılmaktan geri kalınacak! Bu sefer, herkesin yardımıyla Prenses Lyris'i kurtaracağız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002505
					],
					"speakerTitle": "Al"
				},
				{
					"id": 741002505,
					"content": "Evet! Prenses Lyris'i kurtaralım. Sonrasında...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002506
					],
					"speakerTitle": "Petit Chou"
				},
				{
					"id": 741002506,
					"content": "Sonrasında ise Nergis Haçı Krallığı önceki ihtişamına geri kavuşacaktır! Prenses seni kollarına alacak, tüylerini sevecek ve minik başını yavaşça okşayacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002507
					],
					"speakerTitle": "Al"
				},
				{
					"id": 741002507,
					"content": "Sularda kaybolan anılar yeniden yüzeye çıkacak ve arkadaşlarımızın hepsi prensesin etrafına doluşup kahkahalar atacak! Neşeyle dolu bir tablo olacak, kavgalar ve sorunlar bir daha ufkumuza gölge düşüremeyecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002508
					],
					"speakerTitle": "Al"
				},
				{
					"id": 741002508,
					"content": "Tıpkı daha önce olduğu gibi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741002509
					],
					"speakerTitle": "Petit Chou"
				},
				{
					"id": 741002509,
					"content": "... Aynen, daha önce olduğu gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Al"
				}
			]
		},
		{
			"id": 7410026,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
