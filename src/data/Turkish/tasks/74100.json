			},
			"dialogs": [
				{
					"id": 741003101,
					"content": "(koklar)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003102
					],
					"speakerTitle": "Mori"
				},
				{
					"id": 741003102,
					"content": "Hav hav! İyi insan. Beni sevmek ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003103,
						741003106
					],
					"speakerTitle": "Mori"
				},
				{
					"id": 741003103,
					"content": "Tabii, gel bakalım Mori, seni biraz sevip okşayayım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741003104
					]
				},
				{
					"id": 741003104,
					"content": "Mori'yi seviyorsun.\\nMori sudan yapılmış (bir köpek) olduğu için oldukça ıslaktır.\\nAncak Mori çok mutlu görünür.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741003105
					]
				},
				{
					"id": 741003105,
					"content": "Hav hav! Teşekkürler iyi insan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mori"
				},
				{
					"id": 741003106,
					"content": "Bir dahaki sefere seni daha çok seveceğim Mori.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741003107
					]
				},
				{
					"id": 741003107,
					"content": "Havvv... Mori kötü diye mi bu sefer az sevdin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003108
					],
					"speakerTitle": "Mori"
				},
				{
					"id": 741003108,
					"content": "Bunun iyi veya kötü olmakla ne alakası var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741003109
					]
				},
				{
					"id": 741003109,
					"content": "Hav hav! İyi köpekler okşanır. Kötü köpeklere ise... Eğitim verilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003110
					],
					"speakerTitle": "Mori"
				},
				{
					"id": 741003110,
					"content": "*sızlanır*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741003111
					],
					"speakerTitle": "Mori"
				},
				{
					"id": 741003111,
					"content": "Mori'yi üzgün görünce elini uzatıp onu seviyorsun.\\nMori sudan yapılmış (bir köpek) olduğu için oldukça ıslaktır.\\nMori'nin mavi gözleri bir kez daha parlamaya başlar.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741003112
					]
				},
				{
					"id": 741003112,
					"content": "Hav hav! Beni okşadığın için teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mori"
				}
			]
		}
	]
