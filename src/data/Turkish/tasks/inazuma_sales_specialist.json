			},
			"dialogs": [
				{
					"id": 220360101,
					"content": "Bu iş o kadar zor ki... Mallarımın o kadar eşsiz ve kaliteli olmasına rağmen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360102
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360102,
					"content": "Neden kimse bir şeyler almaya gelmiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360103
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360103,
					"content": "Sorun nedir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360104
					]
				},
				{
					"id": 220360104,
					"content": "Ah, Gezgin. *iç çeker* Şey... Hiç gübre satamıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360105
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360105,
					"content": "Alrani sana yardım etmeyecek miydi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360106
					]
				},
				{
					"id": 220360106,
					"content": "Yardım ediyor zaten ama sorun şu ki ikimiz de bu ürünlerin reklamını nasıl yapacağımızı bilmiyoruz. Öylece dikilmiş müşteri gelsin diye bekliyoruz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360107
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360107,
					"content": "Ritou'yu bilirsin, buranın insanları cimridir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360108
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360108,
					"content": "Ben de tüccar loncasından yardım istemeye gittim, onlar da bana pazarlama diye bir şey yapmam gerektiğini söylediler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360109
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360109,
					"content": "Özetle gübrenin etkileri ve mantığı hakkında insanları bilgilendirmem gerektiğini söylediler. Ayrıca gübrenin etkilerini verilerle destekleyip \"ücretsiz deneme\" hizmeti sağlamam gerekiyormuş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360110
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360110,
					"content": "Maalesef ben bu konularda biraz cahilim. Hem gübreyi de üreten ben olmadığım için neyin ne olduğunu nereden bileceğim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360111
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360111,
					"content": "Neyse, kağıtta yazanı okuyarak da olsa ürünlerim hakkında bir tanıtım hazırlamam gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360112
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360112,
					"content": "Alrani çoktan ürünleri tanıtmaya çıktı bile. Sonra ben de gideceğim. Acaba sen de bize yardım edebilir misin Gezgin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360113,
						220360116
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360113,
					"content": "Tabii ki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360114
					]
				},
				{
					"id": 220360114,
					"content": "Fevkalade! Sana güveniyoruz Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360115
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360115,
					"content": "Konda Köyü'ne gitmen gerekiyor. Buraya çok uzak değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360119
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360119,
					"content": "Gübremizle ilgilenen Konda Densuke adında bir beyefendi var. Öncesinde de dükkana gelip benimle sohbet etmişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360120
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360120,
					"content": "Mekanına gidip ürünümüzü tanıttıktan sonra ona ücretsiz deneme teklif edersen belki biraz gübre satın alabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360116,
					"content": "Alrani nereye gitti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360117
					]
				},
				{
					"id": 220360117,
					"content": "Malzeme toplaması gerektiği için oldukça uzak yerlere gitmesi gerekiyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360118
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360118,
					"content": "Konda Köyü'ne gitmen gerekiyor. Buraya çok uzak değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360119
					],
					"speakerTitle": "Vahid"
				}
			]
		},
