			"dialogs": [
				{
					"id": 220360201,
					"content": "Tamam, bana gübrenin nasıl kullanıldığını anlat...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360202
					]
				},
				{
					"id": 220360202,
					"content": "Tabii ya, haklısın. Önce sana öğretmem gerek. Aldığın gübrenin belli bir şekilde kullanılması gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360203
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360203,
					"content": "Bir bakayım... Kitapçığa göre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360204
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360204,
					"content": "Gübreye biraz <color=#37FFFF>ezilmiş yaprak</color> koymadan önce <color=#37FFFF>su</color> eklemelisin. Son olarak <color=#37FFFF>iyice karıştırıp</color> toprağa yayman gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360205
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360205,
					"content": "Bunları sırasına göre yapmazsan işler ters gidebilir ve müşteride iyi bir izlenim bırakmaz. İşimizin geleceği buna bağlı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360206,
						220360208
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360206,
					"content": "Unutmam merak etme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360207
					]
				},
				{
					"id": 220360207,
					"content": "O zaman sana güveniyorum. Anahit Bereketini müşteriye teslim ettikten sonra ücretini alabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360208,
					"content": "İşlem sırasını tekrar söyleyebilir misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360209
					]
				},
				{
					"id": 220360209,
					"content": "Gübreye biraz <color=#37FFFF>ezilmiş yaprak</color> koymadan önce <color=#37FFFF>su</color> eklemelisin. Son olarak <color=#37FFFF>iyice karıştırıp</color> toprağa yayman gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360210
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360210,
					"content": "Sana güveniyorum Gezgin, bu işi halledeceğimize inanıyorum. Şansımız yaver giderse bu ay işler yoluna girebilir!",
					"roleType": "TALK_ROLE_NPC",
