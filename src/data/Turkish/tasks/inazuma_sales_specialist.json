			"dialogs": [
				{
					"id": 220360501,
					"content": "Tekrar karşılaştık arkadaşlar. Bu sefer ne öğrenmek istiyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360502,
						220360503
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360502,
					"content": "Bu sefer soru sormaya gelmedim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360504
					]
				},
				{
					"id": 220360504,
					"content": "Ah, seni Vahid mi gönderdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360505
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360505,
					"content": "Ritou'da yeni gübre dükkanı olduğunu duydum. Bu nedenle gübresini denemek için Bay Vahid ile görüşmeye gitmiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360506
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360506,
					"content": "Gübre, ekinleri yetiştirmeye fayda sağlarsa, işler Konda Köyü için tekrar rayına oturabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360507
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360507,
					"content": "Eh, köyü eski haline getirmek yine benim gibi eski toprakların eline bakıyor sanırım. Bu köyün gençleri yok mu... Hıh! Ellerinden hiçbir iş gelmiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360508
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360508,
					"content": "Evet, söyle bakalım. Bu gübreyi nasıl kullanmam gerekiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360509,
						220360510,
						220360511
					],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360509,
					"content": "Önce su ekle, onları karıştırmadan önce de ezilmiş yaprak koy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360512
					]
				},
				{
					"id": 220360512,
					"content": "Bir gübre için biraz zahmetliymiş... Neyse, hallederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Konda Densuke"
				},
				{
					"id": 220360510,
					"content": "Önce ezilmiş yaprak ekle, karıştır ve son olarak içine su koy.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360512
					]
				},
				{
					"id": 220360511,
					"content": "Önce ezilmiş yaprak ekle, içine su koy ve iyice karıştır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360512
					]
				},
				{
					"id": 220360503,
					"content": "Gübrenin kullanımı hakkında konuşmaya geldim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360504
					]
				}
			]
