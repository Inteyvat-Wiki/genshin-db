					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360407
					]
				},
				{
					"id": 220360407,
					"content": "O zaman sana güveniyorum. Anahit Bereketini müşteriye teslim ettikten sonra ücretini alabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360408,
					"content": "İşlem sırasını tekrar söyleyebilir misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220360409
					]
				},
				{
					"id": 220360409,
					"content": "Gübreye <color=#37FFFF>su eklemeden</color> önce biraz <color=#37FFFF>ezilmiş yaprak</color> koyman gerek. Sonrasında ise <color=#37FFFF>onları iyice karıştırıp</color> toprağa yaymalısın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220360410
					],
					"speakerTitle": "Vahid"
				},
				{
					"id": 220360410,
					"content": "Sana güveniyorum Gezgin, bu işi halledeceğimize inanıyorum. Şansımız yaver giderse bu ay işler yoluna girebilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vahid"
				}
			]
		},
