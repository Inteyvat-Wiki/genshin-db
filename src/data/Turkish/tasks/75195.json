			"dialogs": [
				{
					"id": 751950201,
					"content": "Aman tanrım... Tam vaktinde imdadımıza yetişen iyi kalpli bir kahraman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950202
					],
					"speakerTitle": "Dutta"
				},
				{
					"id": 751950202,
					"content": "Bu çorak tarladaki taşları temizlemesi için bir Tatankazor getirmeyi düşünüyordum. Hatta ansızın ortalıkta canavarlar belirirse onlarla da baş edecekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950203
					],
					"speakerTitle": "Dutta"
				},
				{
					"id": 751950203,
					"content": "Ben daha işe koyulmadan birileri her şeyi benim yerime halletmiş bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950204
					],
					"speakerTitle": "Dutta"
				},
				{
					"id": 751950204,
					"content": "Kendimi bildim bileli her sabah kapımın önündeki meyve ağaçlarını gübrelerim. Bu olsa olsa tanrıların beni ödüllendirme şeklidir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950205
					],
					"speakerTitle": "Dutta"
				},
				{
					"id": 751950205,
					"content": "Ey kalbi güzel insan, tanrıların yeryüzündeki temsilcisi! Ben Dutta, bu iyiliğin için sana minnettarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751950206
					],
					"speakerTitle": "Dutta"
				},
				{
					"id": 751950206,
					"content": "Sana verebileceğim özel bir şeyim yok, sadece biraz Mora ve birkaç ıvır zıvır var. Lütfen kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dutta"
				}
			]
		}
