						230070202
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070202,
					"content": "Bodurlopların toplandığı bir yer buldum. Oraya gidip bana biraz toprak getirir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070203,
						230070206
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070203,
					"content": "Bana bırak.",
