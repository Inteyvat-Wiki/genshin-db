			"dialogs": [
				{
					"id": 230070101,
					"content": "Daha iyi bir malzeme yok mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070102
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070102,
					"content": "Ne malzemesi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070103
					]
				},
				{
					"id": 230070103,
					"content": "Pardon, yine kendi kendime konuştum. Şu berbat hava yüzünden evlerde bir sürü sorun çıktı. Hiç bu kadar meşgul olmamıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070104
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070104,
					"content": "Sen çömlekçi değil miydin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070105
					]
				},
				{
					"id": 230070105,
					"content": "Evet ama aynı zamanda duvar ustasıyım. İki işte de olay toprakta bitiyor. Çok bir farkı yok yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070106
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070106,
					"content": "Şu lafı duydun mu? \"Öğrenmek ev inşa etmeye benzer. Yüksek bir ev inşa etmek istiyorsan sağlam temelin olmalı.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070107
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070107,
					"content": "\"Ve bilgi dağarcığını geliştirmek istiyorsan temelin sağlam olmalı. Temelin zayıfsa her şey yıkımla sonuçlanır...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070108
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070108,
					"content": "Üst düzey zeki insanlar hep böyle der. Ben pek anlamıyorum ama ev inşa etmenin öğrenmek kadar önemli olduğunu düşündükleri açık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070109,
						230070110
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070109,
					"content": "Mecazen öyle diyorlar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070111
					]
				},
				{
					"id": 230070111,
					"content": "Her neyse, bir evin temelini düşününce akla inşa malzemeleri geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230070112
					],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070112,
					"content": "Toprak, her şeyi birbirine bağlayan ve destekleyen malzeme, yani toprağın sağlamlığı ve uyumluluğu artırılabilirse evlerimiz daha dayanıklı olur. Benim de bu kadar çok işim olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akim"
				},
				{
					"id": 230070110,
					"content": "Anlatmak istedikleri şey bu değil bence.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230070111
					]
				}
			]
		},
