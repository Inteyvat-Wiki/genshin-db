			},
			"dialogs": [
				{
					"id": 110010401,
					"content": "Merhaba, nefis yemeğinden tadabilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010402
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110010402,
					"content": "Üzgünüm, önümüzdeki birkaç gün için hazırlayabileceğim tüm siparişleri aldım. Sizin için en erken verebileceğim tarih yedi gün sonrası. Uygun mudur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010403
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 110010403,
					"content": "Vay canına. Bu kadar popülerse nefis olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110010404,
					"content": "İlginç... Bu kadın şüphesiz ki çok ünlü bir şef...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110010405
					]
				},
				{
					"id": 110010405,
					"content": "Evet, iyi bir noktaya parmak bastın. Pınarköy'de bu kadın varken Draff neden Xiangling'in yardımını istiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110010406,
					"content": "Hımm... Belki de Mondstadt mutfağının Teyvat'ın en büyük iş merkezi olan Liyue Limanı mutfağıyla yarışamayacağını düşünüyordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010407
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 110010407,
					"content": "Ama ben buna katılmıyorum. Aşçılığımın hiç kimseninkinden aşağı kalır yanı olduğunu düşünmüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010408
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 110010408,
					"content": "Peki o zaman... Bana neler yapabildiğini göster. Belki sana geri bildirimde bulunabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010409
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110010409,
					"content": "Üzgünüm ama \"Ah, bunun tadı güzelmiş\" şeklindeki müşteri geri bildirimi işime yaramıyor. Geri bildirim isteseydim profesyonel bir şefe sorardım. Bekle, sen... Xiangling misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010410
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 110010410,
					"content": "Evet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010411
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110010411,
					"content": "Gerçekten sensin! O halde konu et pişirmeye geldiğinde ne yaptığını bildiğini düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010412
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 110010412,
					"content": "Aslında bugünün en iyi parçalarından bir tane kaldı. Söyle bakalım, bunu nasıl pişirirdin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010413
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 110010413,
					"content": "Etin yağ oranına bağlı. Bu parçayı muhtemelen biraz tuzla, biraz Jueyun Biberiyle ve Qingxin çiçeğiyle birlikte sıcak bir taş üzerinde pişirirdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010414
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110010414,
					"content": "Qingxin çiçeği mi? Ama erimiş yağ, çiçeğin aromasını çiğ yenilen halinden on kat daha güçlü hale getirirdi... Her şeyin üstüne çıkardı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010415
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 110010415,
					"content": "Biliyorum, bu yüzden bu bir garnitür. Eti asla onun içinde marine etmezdim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010416
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110010416,
					"content": "Bunu daha önce denemiştim. Çiçek yapraklarını yağlayıp onları doğru ısıda ve sürede pişirirsen acılığı tamamen gider ve güzel, çıtır bir garnitür elde edersin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010417
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110010417,
					"content": "Ardından bir miktar yüksek rakımda yetişen Jueyun Biberi ekle, düşük nem ve değişken sıcaklık onlara benzersiz kuru bir sıcaklık verir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010418
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110010418,
					"content": "Çiçek yaprakları; deniz tuzunun keskinliğini, acı biber acısını ve taze, yeni pişirilmiş bifteğin tadını içine çekerken aynı zamanda ağızda çiçeksi bir tat bırakır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010419
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110010419,
					"content": "Bu çok fazla! Olabildiğince süsleme kullanıp etin hakkını vermiyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010420
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 110010420,
					"content": "Kim rosto dışında her şeyin tadını alabildiği bir rosto yemek ister ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010421
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 110010421,
					"content": "Hey hey hey, tartışmayı bırakın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010422,
						110010423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110010422,
					"content": "Kendileri dışında birini duyabileceklerini sanmıyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110010424
					]
				},
				{
					"id": 110010424,
					"content": "Hıh. Pekala, bu aşçılık tartışmasını sonlandırmanın tek bir kesin yolu var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010425
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110010425,
					"content": "Bir yemek yarışması için meydan okuyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010426
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110010426,
					"content": "Bana uyar! Aşçılığımı geçemezsen bu Draff'ın senin hakkında açıkça yanıldığını gösterir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010427
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 110010427,
					"content": "Tamam ama kazanırsam kazanan yemeğimi Pınarköy'ü tanıtmak için kullanacaksın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010428
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110010428,
					"content": "Ama sen kaybedersen kazanan yemeğimi Wanmin menüsüne ekleyeceksin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010429
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 110010429,
					"content": "\"Wanmin menüsüne yapılan bu özel ekleme, et uzmanı Pınarköy Şefi Brook tarafından cömertçe yapılmıştır.\" yazılı bir başlıkla birlikte eklenecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010430
					],
					"speakerTitle": "Brook"
				},
				{
					"id": 110010430,
					"content": "Anlaştık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010431
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110010431,
					"content": "Malzemeleri almak için gidiyorum. Liyue'de görüşürüz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010432
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110010432,
					"content": "Bekle! Bekleee!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110010433,
					"content": "#{NICKNAME}, hadi yakalamaya çalışalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
