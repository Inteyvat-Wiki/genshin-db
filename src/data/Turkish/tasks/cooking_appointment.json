			"dialogs": [
				{
					"id": 110010201,
					"content": "Sen Xiangling olmalısın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010202
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 110010202,
					"content": "Üzgünüm Bay Draff, bunların hepsi benim hatam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010203
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110010203,
					"content": "Tüm hikayeyi öğrendim ve şimdi bizzat buradasın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010204
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 110010204,
					"content": "Ooo, kavga geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010205,
						110010206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110010205,
					"content": "Şiddet çözüm değildir!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110010207
					]
				},
				{
					"id": 110010207,
					"content": "... Lütfen etimi tanıtmama yardım et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010208
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 110010208,
					"content": "... Hı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010209
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110010209,
					"content": "Biraz küstah davrandıysam kusura bakma. Açıklamama izin ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010210
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 110010210,
					"content": "Pınarköy, itibarını en kaliteli et ürünleri üzerine kurmuştur, ancak bu itibar şimdiye kadar Mondstadt ile sınırlı kaldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010211
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 110010211,
					"content": "Büyük üstat Xiangling'in Mondstadt'ta olduğunu duyunca Allan'ı sana gönderdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010212
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 110010212,
					"content": "Üstat mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110010213,
					"content": "Duymadınız mı? O, Liyue Limanı'ndaki eşsiz yerel lezzet durağı olan Wanmin Restoranının arkasındaki kişi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010214
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 110010214,
					"content": "Tüm Liyue'deki en sevilen bazı yemeklerin başarısının sırrı, yemek malzemeleri konusundaki benzersiz yaklaşım. Gezginler tarafından da çok beğeniliyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010215
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 110010215,
					"content": "Hahaha, çok naziksiniz. Ucuz ve lezzetli şeyler pişirmeye çalışıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010216
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110010216,
					"content": "Pınarköy'ün birinci sınıf eti ile birinci sınıf yemek pişiren birinci sınıf bir şefle... Ünümüz dört bir yana yayılırdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010217
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 110010217,
					"content": "Hımm... Bilmiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010218
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110010218,
					"content": "Hep nasıl lezzetli yemekler yapabileceğimi düşünüyorum... Hiçbir zaman kendimi belli malzemelerle sınırlamıyorum. Herhangi bir şeyi tanıtmakla ilgili hiçbir şey bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010219
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110010219,
					"content": "Yine de her zaman yaban domuzu eti kullanıyorsun, öyle değil mi? Sorunun ne olduğunu anlamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010220
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 110010220,
					"content": "Sorun şu ki... Biraz Bodurlop Özü eklememe ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010221
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110010221,
					"content": "Bu... Aslında biraz daha normal bir şey ekleyemez misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010222
					],
					"speakerTitle": "Draff"
				},
				{
					"id": 110010222,
					"content": "Benim için \"normal\" malzeme diye bir şey yok! Doğru şekilde pişirirseniz her şeyi lezzetli hale getirebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010223
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110010223,
					"content": "Kullanabileceğim malzemelerle yaratıcılığımın sınırlanmasına izin vermeyeceğim. Böyle pişirilen yiyecekler sıkıcı olmaya mahkumdur, nokta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010224,
						110010225
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110010224,
					"content": "Tansiyon hızla yükseldi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110010226
					]
				},
				{
					"id": 110010226,
					"content": "*iç çeker* Pekala, bu konuda bu kadar çok kararlıysan unut bunu. Ama gerçekten yazık oldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Draff"
				},
				{
					"id": 110010225,
					"content": "Ünlü şefler kararlı olmalarıyla bilinir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110010226
					]
				},
				{
					"id": 110010206,
					"content": "Dövüşmek istiyorsan elinden geleni ardına koyma!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110010207
					]
				}
			]
		},
		{
