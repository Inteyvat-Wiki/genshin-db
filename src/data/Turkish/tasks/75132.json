			"dialogs": [
				{
					"id": 751320101,
					"content": "... Ah... Uzak diyardan gelen kahraman...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320102
					],
					"speakerTitle": "Gizemli Grafitinin İradesi"
				},
				{
					"id": 751320102,
					"content": "Lütfen işit sözlerimi. Ben yol gösteren gece kuzgunuyum, aynı zamanda Gece Lordu'nun şiirsel düşüncelerinin bir hatırasıyım... Ve ay ışığındaki milyarlarca düşünceden sadece biriyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320103
					],
					"speakerTitle": "Gizemli Grafitinin İradesi"
				},
				{
					"id": 751320103,
					"content": "Kulağını bana ver, yeryüzünün altındaki ruh nehri parçalandı zira. Seninle yalnızca bu resim aracılığıyla konuşabiliyorum ve seni uyarıyorum... Karanlık düşmana dikkat et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320104
					],
					"speakerTitle": "Gizemli Grafitinin İradesi"
				},
				{
					"id": 751320104,
					"content": "O kırık ayna bir zamanlar parlak yansımalar saçıyordu. Şimdiyse koyu dumanlar yavaş yavaş üç bölgeye yayıldı. Onları iyi hatırla:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320105
					],
					"speakerTitle": "Gizemli Grafitinin İradesi"
				},
				{
					"id": 751320105,
					"content": "Birincisi doğuda, bir zamanlar gölgelerin saklandığı, efsanevi kahramanların duvar resimlerinden ortaya çıktığı yerde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320106
					],
					"speakerTitle": "Gizemli Grafitinin İradesi"
				},
				{
					"id": 751320106,
					"content": "İkincisi batıda, karanlığın tezahürlerinin, en derin gecenin efendisinin sinir bozucu bir taklidini yaptığı, bir gizem denizinin üzerinde bulunan yerde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320107
					],
					"speakerTitle": "Gizemli Grafitinin İradesi"
				},
				{
					"id": 751320107,
					"content": "Üçüncüsüyse Kül Şehir çalkalanırken, çoktan dağılmış olması gereken yoğun bir sisin şu anda etrafa yayıldığı uçurumların altında yer alıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320108
					],
					"speakerTitle": "Gizemli Grafitinin İradesi"
				},
				{
					"id": 751320108,
					"content": "Ey yabancı kahraman, dikkatli ol... Karanlık düşmanımızın dolaştığı yerlerde temkinli ol. Aşındıran düşmandan sakın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gizemli Grafitinin İradesi"
				}
			]
		},
