			"dialogs": [
				{
					"id": 751320601,
					"content": "Ey yabancı kahraman, hissedebiliyorum... Yapmış olduğun her şeyi hissedebiliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320602
					],
					"speakerTitle": "Gizemli Grafitinin İradesi"
				},
				{
					"id": 751320602,
					"content": "Ey kahraman, bu müthiş bir başarı. Aşınmış güç artık Gece diyarına geri döndü. Gece Ruhlarının neşesini hissedebiliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320603
					],
					"speakerTitle": "Gizemli Grafitinin İradesi"
				},
				{
					"id": 751320603,
					"content": "... Bunları mükafatın olarak kabul et kahraman. Çünkü yüceliğe ulaşanlar ödüllendirilmelidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gizemli Grafitinin İradesi"
				}
			]
		}
