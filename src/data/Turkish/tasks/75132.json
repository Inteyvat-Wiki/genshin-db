			"dialogs": [
				{
					"id": 751320501,
					"content": "Karanlık düşmanımızın dolaştığı yerlerde temkinli ol. Aşındıran düşmandan sakın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320502
					],
					"speakerTitle": "Gizemli Grafitinin İradesi"
				},
				{
					"id": 751320502,
					"content": "Bilmek istediğin bir şey var mı yabancı kahraman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320503,
						751320506,
						751320509,
						751320512
					],
					"speakerTitle": "Gizemli Grafitinin İradesi"
				},
				{
					"id": 751320503,
					"content": "Bana kahramanların duvar resimlerinden bahset...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751320504
					]
				},
				{
					"id": 751320504,
					"content": "Onları doğuda, parlak ağaçların sallanıp titreştiği bir mağaranın içinde bulacaksın. Burada, tıpkı dokuma parşömenlerini tutan hikayecilerin dediği gibi, geçmişin hikayelerinde saklı bir dehşet de var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320505
					],
					"speakerTitle": "Gizemli Grafitinin İradesi"
				},
				{
					"id": 751320505,
					"content": "Belki de o gölge, o hikayeler aracılığıyla esaretinden kurtulmanın yolunu arıyordur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320502
					],
					"speakerTitle": "Gizemli Grafitinin İradesi"
				},
				{
					"id": 751320506,
					"content": "Bana gizem denizinin üstünde ne olduğunu söyle...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751320507
					]
				},
				{
					"id": 751320507,
					"content": "Batıda sisle kaplı bir ada bulunur. Orası bir zamanlar kutsal ayinlerin mabedi ve uzun süre önce Iktomizorlarla sözleşme yapanların meskeniydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320508
					],
					"speakerTitle": "Gizemli Grafitinin İradesi"
				},
				{
					"id": 751320508,
					"content": "Fakat oradan balçık çıktı, kutsal mekan karanlık bir lağım çukuruna dönüşüp mühürlendi ve unutuldu... Fakat bizim kurnaz düşmanımız asla bu kadar kolay pes etmez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320502
					],
					"speakerTitle": "Gizemli Grafitinin İradesi"
				},
				{
					"id": 751320509,
					"content": "Bana solgun sisten bahset...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751320510
					]
				},
				{
					"id": 751320510,
					"content": "O kirlenmiş sis, kadim şehir Ochkanatlan yok edildiğinde oluştu. Mühürlenmiş olmalıydı... Ancak zaman ve hafıza bizim aleyhimize işliyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320511
					],
					"speakerTitle": "Gizemli Grafitinin İradesi"
				},
				{
					"id": 751320511,
					"content": "Keşke... Ah... Keşke biri bu solgun sisi bir kez daha dağıtabilseydi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751320502
					],
					"speakerTitle": "Gizemli Grafitinin İradesi"
				},
				{
					"id": 751320512,
					"content": "Hayır, şu anda bilmem gereken bir şey yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751320513
					]
				},
				{
					"id": 751320513,
					"content": "Ah... Unutma, unutma... Dikkatli ol, tetikte ol...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gizemli Grafitinin İradesi"
				}
			]
		},
