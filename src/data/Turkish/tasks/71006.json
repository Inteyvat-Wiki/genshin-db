						710060703
					]
				},
				{
					"id": 710060703,
					"content": "Taş mı? Neden soruyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060704
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060704,
					"content": "<color=#00E1FFFF>Luhua Göleti'ni</color> çizmek için güzel bir manzara ararken buldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060705
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060705,
					"content": "<color=#00E1FFFF>Luhua Göleti'ne</color> gidip bakmak ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060706
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060706,
					"content": "Gidecek olursan dikkati elden bırakma. Göletin çevresinde in cin top oynuyor. Taşı kim niye oraya fırlattıysa artık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
