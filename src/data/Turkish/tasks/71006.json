			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710060601,
					"content": "Resim malzemelerimi buldun mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060602
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060602,
					"content": "Evet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060603
					]
				},
				{
					"id": 710060603,
					"content": "Referans aldığım yerde bırakmışım demek, tam tahmin ettiğim gibi. Resim çizerken malzemelerimi yere koyarım genelde. Alışkanlık işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060604
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060604,
					"content": "Bir de üstüne acelem varsa bir sürü eşyam bıraktığım yerde kalıyor. Çok teşekkür ederim. Sen olmasaydın şehre dönüp yenilerini almak zorunda kalacaktım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060605
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060605,
					"content": "Burada resim yapmaya devam edecek misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060606
					]
				},
				{
					"id": 710060606,
					"content": "Aklımın ucundan bile geçirmem. Burada gözleri ışıldayan iki heykel olduğunu, yaydıkları ışığın çok uzaklardan görülebildiğini söylediler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060607
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060607,
					"content": "Pırıl pırıl gözleriyle dağa yoldaşlık eden dev heykeller... Müthiş bir tablo olacağından hiç şüphem yoktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060608
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060608,
					"content": "Buraya geldiğimde heykelleri buldum bulmasına ama ışıldayan gözlerden eser yoktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060609
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060609,
					"content": "Belki özel bir zamanda gelmem ya da özel bir açıdan bakmam gerekiyordur diye çevrede gezip durdum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060610
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060610,
					"content": "Belli ki nerede durursam durayım manzara değişmeyecek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060611
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060611,
					"content": "Yolculuğun tek getirisi bu oldu. Şu taraftaki gölette buldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060612
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060612,
					"content": "Hım, ben de aynısından buldum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060613
					]
				},
				{
					"id": 710060613,
					"content": "Öyle mi? Bir bakayım. Vay canına, bunlar birbirinin aynısı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060614
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060614,
					"content": "Çok tuhaf. Üstelik ikisinin de arkasına birtakım kelimeler kazınmış. Bakalım ne yazıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060615
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060615,
					"content": "\"Taş muhafızlar korur kapıları, geçirmez ona göz atmayanları...\" Ne demek acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060616
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060616,
					"content": "Bu taş pek işime yaramaz, sana vermemi ister misin? Malzemelerimi bulduğun için teşekkür hediyesi olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060617
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060617,
					"content": "Bir dakika, aklıma bir fikir geldi. Kulağa biraz uçuk bir fikir gibi gelebilir ama sence de bu taşların şekli gözü andırmıyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060618
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060618,
					"content": "Öyleyse taşların bilmecedeki \"göz atma\" işiyle bir ilgisi olsa gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060619
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060619,
					"content": "Neyse, yine sesli düşünmeye başladım. Çizecek başka manzaralar bulmaya gideyim artık. Eşyalarımı bulduğun için teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
