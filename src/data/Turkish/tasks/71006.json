			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710060101,
					"content": "Of, bu kötü oldu. Şimdi nasıl resim yapacağım ben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060102
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060102,
					"content": "Sorun ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060103
					]
				},
				{
					"id": 710060103,
					"content": "Oh be, sen miydin Gezgin? Sorunum şu ki Luhua Göleti etrafında ilham arayışı içindeydim ve dönerken yanımda götüreyim diye birkaç resmini çizeyim dedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060104
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060104,
					"content": "Ama iyi bir açı bulamadım ve resimlerin hiçbirinden memnun kalmadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060105
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060105,
					"content": "Manzarayı izlemeye öyle dalmışım ki çoğu fırçamın ve boyamın kaybolduğunu anca buraya vardığımda fark ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060106
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060106,
					"content": "Muhtemelen önceki yerde resim yaparken unuttum. Gidip eşyalarım orada mı bir bakar mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060107,
						710060110
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060107,
					"content": "Resimleri nerede yapmıştın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060108
					]
				},
				{
					"id": 710060108,
					"content": "Aslında... Ben de tam hatırlamıyorum. Genelde resimlerime o kadar dalıyorum ki etrafa pek dikkat etmiyorum. Yani sana tam bir konum söyleyemem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060109
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060109,
					"content": "Ama bu bölgede sadece iki resim çizdim, yani yalnızca bu iki yerde olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060113
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060113,
					"content": "Bu iki resmi sana vereyim. Eminim resim aletlerim, resimler için <color=#00E1FFFF>referans olarak kullandığım</color> bu iki yerden birindedir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060114
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060114,
					"content": "Aletleri bulunca lütfen bana getir. Ben etrafa bakınmaya devam edeyim... Eminim daha iyi bir açı vardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060110,
					"content": "Peki aramaya nereden başlayayım?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060111
					]
				},
				{
					"id": 710060111,
					"content": "Resimlerime o kadar dalmışım ki etrafa dikkat edemedim, yani ayrıntılarını hiç hatırlamıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060112
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060112,
					"content": "Ama bu bölgede sadece iki resim yaptım, yani yalnızca bu iki yerde olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060113
					],
					"speakerTitle": "Vermeer"
				}
			]
		},
