				{
					"id": 710061001,
					"content": "Ya... Demek böyleymiş! Taşlar gerçekten de heykellerin gözleriymiş. Gözlerinin ışıldaması için taşları yerine oturtmak gerekiyormuş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710061002
