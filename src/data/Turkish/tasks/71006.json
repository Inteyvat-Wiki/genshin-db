			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vermeer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710060201,
					"content": "Resim malzemelerimi buldun mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060202
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060202,
					"content": "Buldum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060203
					]
				},
				{
					"id": 710060203,
					"content": "Referans aldığım yerde bırakmışım demek, tam tahmin ettiğim gibi. Resim çizerken malzemelerimi yere koyarım genelde. Alışkanlık işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060204
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060204,
					"content": "Bir de üstüne acelem varsa bir sürü eşyam bıraktığım yerde kalıyor. Çok teşekkür ederim. Sen olmasaydın şehre dönüp yenilerini almak zorunda kalacaktım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060205
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060205,
					"content": "Burada resim yapmaya devam edecek misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060206
					]
				},
				{
					"id": 710060206,
					"content": "Aklımın ucundan bile geçirmem. Burada gözleri ışıldayan iki heykel olduğunu, yaydıkları ışığın çok uzaklardan görülebildiğini söylediler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060207
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060207,
					"content": "Pırıl pırıl gözleriyle dağa yoldaşlık eden dev heykeller... Müthiş bir tablo olacağından hiç şüphem yoktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060208
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060208,
					"content": "Buraya geldiğimde heykelleri buldum bulmasına ama ışıldayan gözlerden eser yoktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060209
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060209,
					"content": "Belki özel bir zamanda gelmem ya da özel bir açıdan bakmam gerekiyordur diye çevrede gezip durdum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060210
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060210,
					"content": "Belli ki nerede durursam durayım manzara değişmeyecek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060211
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060211,
					"content": "Yolculuğun tek getirisi bu oldu. Şu taraftaki gölette buldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060212
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060212,
					"content": "Ne olduğu hakkında hiçbir fikrim yok ama baktıkça daha çok bir göze benziyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060213
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060213,
					"content": "Ama eğer bir gözse yakınlarda benzer bir taş daha olmalı. Sonuçta insanların iki gözü vardır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060214
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060214,
					"content": "*iç çeker* Tabii bu sadece varsayım. Çok da düşünmeye gerek yok. Bu taş pek işime yaramaz, sana vermemi ister misin? Malzemelerimi bulduğun için teşekkür hediyesi olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060215
					],
					"speakerTitle": "Vermeer"
				},
				{
					"id": 710060215,
					"content": "Gözleri parıldayan heykeller... Acaba Luhua Göleti'nde açığa çıkmayı bekleyen ne sırlar var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vermeer"
				}
			]
		},
