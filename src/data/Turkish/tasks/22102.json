			"dialogs": [
				{
					"id": 221020101,
					"content": "Bu iş artık çığırından çıkmaya başladı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020102
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020102,
					"content": "Sorun ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221020103
					]
				},
				{
					"id": 221020103,
					"content": "Kaç gündür uyumadım... Gözümün altındaki morlukları görüyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020104
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020104,
					"content": "Misafirlerle tanıştın mı? Hepsi birbirinden beter, hepsinin ayrı bir sorunu var. Bir tanesi ciddi ciddi binanın tepesinden aşağıya atladı. Hem de böylesine yüksek bir binadan. Amacı neydi ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020105
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020105,
					"content": "Neyse, kafana takma sen bunları. Şehirden gelecek bir yiyecek teslimatını bekliyorum, yakında burada olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020106
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020106,
					"content": "Ancak yoldaki canavarların sorun çıkarma ihtimali var. Acaba gidip onları benim için ortadan kaldırabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020107,
						221020108
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020107,
					"content": "Tamam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221020109
					]
				},
				{
					"id": 221020109,
					"content": "Teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020108,
					"content": "Burası lanetli olabilir mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221020110
					]
				},
				{
					"id": 221020110,
					"content": "Eh... Kapınız dünyanın dört bir yanından gelen gezginlere açıksa, bir o kadar yük de beraberinde gelecektir... En azından ben öyle düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020111
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020111,
					"content": "Fakat idare edebiliriz. Altı üstü merkeze biraz uzak ve görece kalabalık bir han işletiyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020112
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020112,
					"content": "Yardımın için çok teşekkür ederim. Sana iyi şanslar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
