					"nextDialogs": [
						221020203
					]
				},
				{
					"id": 221020203,
					"content": "Tamam, lütfen elini çabuk tut. Şefin malzemeleri tükenmek üzere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221020204
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221020204,
					"content": "Bu işi kendim de hallederdim ancak buna son çare olarak başvurmayı tercih ediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
