				"points": []
			},
			"dialogs": [
				{
					"id": 200730201,
					"content": "Tüm erzakları bıraktın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730202
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730202,
					"content": "Hepsi olmaları gereken yerde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730203
					]
				},
				{
					"id": 200730203,
					"content": "Harika haber. Artık rahatlayabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730204
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730204,
					"content": "Ama umarım dağa çıkanlar yeterli hazırlığı yapmışlardır da bu acil durum erzaklarına muhtaç kalmazlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730205
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730205,
					"content": "Bir baktım da senin kıyafetlerin ne kadar inceymiş. Mondstadt'ta ince kıyafetler mi moda şu an?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730206
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730206,
					"content": "Durum ne olursa olsun lütfen bunları teşekkür olarak kabul et. Üzerine giyecek kalın bir şeyler al.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Riese"
				}
			]
		},
