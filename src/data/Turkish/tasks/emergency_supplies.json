				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Riese"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200730101,
					"content": "Gezgin! Harika zamanlama. Senden bir şey rica edebilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730102
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730102,
					"content": "Ne lazım?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730103
					]
				},
				{
					"id": 200730103,
					"content": "Yukarıdaki koşulların ne kadar korkunç olduğunu mutlaka görmüşsündür. Tecrübeli maceracılar bile Ejdersırtı'ndaki tüm zorlukların üstesinden gelebileceklerini söyleyemez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730104
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730104,
					"content": "Büyük Kumandan Vekili, burada durup tüm vatandaşları dağa çıkmamaları konusunda uyarmamı emretti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730105
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730105,
					"content": "Birçok vatandaşı vazgeçirebilmeme rağmen o maceracılar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730106
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730106,
					"content": "Onları ikna etmeye çalışmanın hiçbir anlamı yok, bunu sen de biliyorsun. Tek istekleri şu dağa çıkmak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730107
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730107,
					"content": "Maceracıların karıştığı o kadar çok olay oldu ki bir süre sonra saymayı unuttum. Ancak sayıları azalmadan birbiri ardına gelmeye devam ediyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730108
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730108,
					"content": "Her birini vazgeçirmeye çalışmak imkansız... Bu nedenle Ejdersırtı'nda belirlenmiş noktalara bırakılacak erzak hazırlamaya karar verdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730109
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730109,
					"content": "Bu şekilde işleri istediği gibi gitmemiş olan ve geri dönmeye hazırlanan maceracıların kendilerini dağın zorlu koşullarından kurtarma şansları artacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730110
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730110,
					"content": "Ancak iyi talihinin sarhoşu olmuş pervasız bir aptal çok yükseğe çıkarsa tutunacak tek dalı kendisi olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730111
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730111,
					"content": "Bu erzakları dağa çıkarmaya ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730112,
						200730114
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730112,
					"content": "Bana bırak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730113
					]
				},
				{
					"id": 200730113,
					"content": "O halde sana güveniyorum. *iç çeker* Keşke bu maceracıların kılıç tutan elleri seninki kadar iyi olsa, şu beyin diye taşıdıkları şeyi senin gibi kullanabilseler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730117
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730117,
					"content": "Haritanda üç konum işaretledim. Tek yapman gereken her konuma <color=#00E1FFFF>bir porsiyon Jambon</color> bırakmak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730118
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730118,
					"content": "*iç çeker* Keşke maceracılar kendilerini daha iyi tanısalar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730114,
					"content": "İşe yarayacaklar mı ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730115
					]
				},
				{
					"id": 200730115,
					"content": "İşe yarasınlar veya yaramasınlar... Hiç yoktan iyidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730116
					],
					"speakerTitle": "Riese"
				},
				{
					"id": 200730116,
					"content": "Bu dağdaki korkunç koşullara karşı ne kadar erzakımız olursa o kadar iyi. Bu konuda yardımına güveniyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730117
					],
					"speakerTitle": "Riese"
				}
			]
		},
		{
			"id": 2007302,
			"completionStepIds": [
				2007306
			],
