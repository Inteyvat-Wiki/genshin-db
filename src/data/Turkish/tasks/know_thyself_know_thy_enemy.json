			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Gürbüz Wu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120010301,
					"content": "Kim var orada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010302,
						120010304
					],
					"speakerTitle": "Gürbüz Wu"
				},
				{
					"id": 120010302,
					"content": "Soylu Maocai ile görüşmeye gelen bir Mondstadt tüccarıyım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010303
					]
				},
				{
					"id": 120010303,
					"content": "Gerçekten mi? Bir toplantıdan bahsetmemişti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010306
					],
					"speakerTitle": "Gürbüz Wu"
				},
				{
					"id": 120010306,
					"content": "Ustamız bugün birkaç acil işle ilgileniyor. Önceki tüm randevuları iptal edildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010307
					],
					"speakerTitle": "Gürbüz Wu"
				},
				{
					"id": 120010307,
					"content": "Acil iş mi? Nedir bu iş?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010308,
					"content": "Usta, son zamanlarda büyük bir iş teklifi üzerinde çalışıyor. Bir VIP müşteri ile buluşmak için bu sabah erkenden çıktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010309
					],
					"speakerTitle": "Gürbüz Wu"
				},
				{
					"id": 120010309,
					"content": "Peki şimdi nerede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010310,
					"content": "Üzgünüm ama Usta, bu bilgiyi herhangi biriyle paylaşmamamız gerektiğini ısrarla belirtti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010311
					],
					"speakerTitle": "Gürbüz Wu"
				},
				{
					"id": 120010311,
					"content": "\"Herhangi biriyle\" mi? Onun VIP müşterilerinden olmadığımızı mı söylüyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010312
					]
				},
				{
					"id": 120010312,
					"content": "H-Hayır! Yani evet, evet öylesiniz! Ah... B-Ben sizi gücendirmek istemedim, lütfen bana inanın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010313,
						120010314
					],
					"speakerTitle": "Gürbüz Wu"
				},
				{
					"id": 120010313,
					"content": "Beni Soylu Maocai'a götür yoksa sonuçlarına katlanırsın!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010315
					]
				},
				{
					"id": 120010315,
					"content": "Üzgünüm, üzgünüm! Usta şu anda Xinyue Köşkü'nde iş görüşmesinde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010316
					],
					"speakerTitle": "Gürbüz Wu"
				},
				{
					"id": 120010316,
					"content": "Merhamet edin! Lütfen, ustam öğrenirse bana hoşgörü göstermez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010317
					],
					"speakerTitle": "Gürbüz Wu"
				},
				{
					"id": 120010317,
					"content": "Pekala, BENİM ustamın senin gibi kaba muhafızlarla konuşmaktan çok daha önemli işleri var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010318,
					"content": "Şansın yaver gitti, o patronunla büyük bir iş teklifini görüşmekle meşgulken yaptığın terbiyesizliği önemsemeyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010319,
					"content": "Te-Teşekkürler, teşekkürler! İşiniz, Toprağın Efendisi tarafından daima kutsansın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010320
					],
					"speakerTitle": "Gürbüz Wu"
				},
				{
					"id": 120010320,
					"content": "#İyi iş çıkardın {NICKNAME}! Paimon, senin çetin bir anlaşmacı olduğunu hiç bilmiyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010321,
						120010323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010321,
					"content": "Sadece blöf yapıyordum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010322
					]
				},
				{
					"id": 120010322,
					"content": "Öyle mi? Artık Paimon, kurnazlıklarının gelecekte onu kandırmasına izin vermeyeceğini biliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010325,
					"content": "Her neyse, görünen o ki söz konusu olan VIP müşteri, Fatui'den biri olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010326,
						120010327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010326,
					"content": "Sanırım haklısın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010328
					]
				},
				{
					"id": 120010328,
					"content": "Bu durumda hadi Xinyue Köşkü'ne gidelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010327,
					"content": "Bu, bizim yararımıza olabilir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010328
					]
				},
				{
					"id": 120010323,
					"content": "Sen de iyi iş çıkardın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010324
					]
				},
				{
					"id": 120010324,
					"content": "Hahaha! Paimon, iltifatları ve benzeri şeyleri çok sever... Ama Paimon'a birkaç lezzetli atıştırmalık vermek samimiyetini gösterir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010314,
					"content": "Neden olduğun bu ek masrafları patronuna açıklamak ister misin yoksa ben mi açıklayayım?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010315
					]
				},
				{
					"id": 120010304,
					"content": "#Ben {NICKNAME}, patronunuzun VIP müşterisiyim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010305
					]
				},
				{
					"id": 120010305,
					"content": "Ne tuhaf, konuk listesinde yoksunuz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010306
					],
					"speakerTitle": "Gürbüz Wu"
				}
			]
		},
