			},
			"dialogs": [
				{
					"id": 120010801,
					"content": "Hıh! Araştırman gereken başka şeyler olduğunu söylemiştin, sanki bir tür gizemli adammışsın gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010802,
					"content": "Aslında söylemek istediğin tek şey, kitabını okurken sırtını yaslayabileceğin yeni bir yer istemekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010803,
					"content": "Soylu Maocai'ın neyin peşinde olduğunu artık biliyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010804
					]
				},
				{
					"id": 120010804,
					"content": "Anladım. Ben de öyle tahmin etmiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010805
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010805,
					"content": "Gerçekten tahmin ettin mi yoksa bunu sadece akıllı görünmek için mi söylüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010806,
					"content": "Eylem planımız artık net. İlk olarak lütfen bu mektubu Feiyun Ticaret Loncasına teslim edin. Onlar ne yapacaklarını bilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010807
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010807,
					"content": "Efendim, açıklayamayacağım sebepler nedeniyle size katılamayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010808
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010808,
					"content": "Mektubun içeriğini okumanıza gerek yok, zamanı geldiğinde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010809
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010809,
					"content": "Üff, bu yazı çok zor okunuyor! Paimon, bundan hiçbir şey anlayamıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010810,
						120010811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010810,
					"content": "Çok eski bir el yazısı olabilir mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010812
					]
				},
				{
					"id": 120010812,
					"content": "Ha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010813
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010813,
					"content": "Bu yüzden onu okumanıza gerek yok demiştim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010814
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010814,
					"content": "Feiyun Ticaret Loncasında bunu anlayabilecek biri var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010815
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010815,
					"content": "Ama neden onların dahil olmasını istiyorsun? Onlar, Liyue'deki önemli ticaret loncalarından biri. Neden bize yardım etmek istesinler ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010816,
					"content": "Feiyun Ticaret Loncası nedir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010817
					]
				},
				{
					"id": 120010817,
					"content": "Liyue'ye vardığımızdan beri Paimon, insanların bundan bahsettiğini duyuyor. Lonca, burada gerçekleşen birçok işi izliyor gibi görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010818,
					"content": "Böylesine büyük bir destek harika olur... Ama yardım etmek isteyeceklerine emin misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010819,
					"content": "Bu konuda endişelenmenize gerek yok. Bildiğim kadarıyla centilmenlik anlayışımız aynı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010820
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010820,
					"content": "Bu mektuba koyduğum tam olarak makul bir şekilde ve tutkuyla öne sürülmüş durumu okuduktan sonra kesinlikle harekete geçecekler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010821,
						120010822
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010821,
					"content": "Nasıl emin olabiliyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010823
					]
				},
				{
					"id": 120010823,
					"content": "Soylu Maocai'a hiç unutamayacağı bir ders vermeliyiz. Bu tek başımıza yapabileceğimiz bir şey değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010824
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010824,
					"content": "Ayrıca bu işe dahil olduğumu kimsenin bilmesini istemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010825
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010825,
					"content": "Neden bilmesinler? Bunu sadece Dokuzuncu Chang'a yardım etmek için yapmıyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010826
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010826,
					"content": "\"Olayın sonunda sessiz sedasız ortadan kaybolmak için birinin adını ve katkısını gizlemek,\" yapılması gereken yiğitlik budur. Anının tadını çıkarmak, büyük ödüldür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010827
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010827,
					"content": "Bana yapılan her bir iyiliğin karşılığını fazlasıyla vermeyi kendime görev edinirim. Ne övgü ne de ödül beklerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010828
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010828,
					"content": "Bu kulağa çok hoş geliyor. Ama dürüst olmak gerekirse... Bunu yapmalarını, kitabını okumaya devam edebilmek için istiyorsun, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010829
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010829,
					"content": "Bu mektubu, Feiyun Ticaret Loncasına teslim edeceğiniz için şimdiden teşekkürler. Loncadan biri, sizi Liuli Konağı'nın yanında karşılayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010830
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 120010830,
					"content": "Hey! Paimon'u görmezden gelmeyi bırak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010822,
					"content": "Yine de neden onları dahil ediyoruz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010823
					]
				},
				{
					"id": 120010811,
					"content": "Bir şifreye ihtiyacı olan gizli bir metin olabilir mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010812
					]
				}
			]
		}
