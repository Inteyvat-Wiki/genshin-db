					"Soylu Maocai"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120010701,
					"content": "Anlıyorum. Evet. Lütfen endişelenmeyin, siparişinizin vaat edildiği gibi tamamlanacağına söz veriyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010702
					],
					"speakerTitle": "Soylu Maocai"
				},
				{
					"id": 120010702,
					"content": "Hımm... Gönderdiğim adamın değerlendirmesi pek de iyimser değildi. İş birliği yapmayan biri mi var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010703
					],
					"speakerTitle": "Tetikçi"
				},
				{
					"id": 120010703,
					"content": "Ah... Yalnızca küçük bir tedarik sorunuyla karşılaştık, hepsi bu. Cor Lapisi henüz satın alamadık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010704
					],
					"speakerTitle": "Soylu Maocai"
				},
				{
					"id": 120010704,
					"content": "Ama endişelenmeniz gereken bir şey yok. Dokuzuncu Chang satmazsa başkasından satın alabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010705
					],
					"speakerTitle": "Soylu Maocai"
				},
				{
					"id": 120010705,
					"content": "Bu en uygunu olur. Tekrar hatırlatıyorum, Fatui sadece sonuca bakar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010706
					],
					"speakerTitle": "Tetikçi"
				},
				{
					"id": 120010706,
					"content": "Bu işe belli bir seviyede destek vermek istiyoruz. Ancak zamanında tamamlanmazsa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010707
					],
					"speakerTitle": "Tetikçi"
				},
				{
					"id": 120010707,
					"content": "Birden iyi niyetimizin bedelinin çok ağır olabileceğini fark edebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010708
					],
					"speakerTitle": "Tetikçi"
				},
				{
					"id": 120010708,
					"content": "Anlıyorum... Korumanız için size borçluyum. Sizi hayal kırıklığına uğratmak istemediğimi biliyorsunuz, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010709
					],
					"speakerTitle": "Soylu Maocai"
				},
				{
					"id": 120010709,
					"content": "Zamanı gelince göreceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010710
					],
					"speakerTitle": "Tetikçi"
				},
				{
					"id": 120010710,
					"content": "*iç çeker* O yaşlı adam Chang'a lanet olsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soylu Maocai"
				},
				{
					"id": 610045701,
					"content": "Yani Bay Soylu Maocai, Fatui ile iş birliği yapıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 610045702,
					"content": "Acaba Guhua İneği hiç ilerleme kaydetti mi? Gidip ona söyleyelim mi?",
					"roleType": "TALK_ROLE_NPC",
