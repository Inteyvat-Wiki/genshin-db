			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120010201,
					"content": "Peki Soylu Maocai'ın Fatui ile gerçekten gizli anlaşma yapıp yapmadığını nasıl öğreneceğiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010202,
						120010203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010202,
					"content": "Somut bir delil bulmamız lazım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010204
					]
				},
				{
					"id": 120010204,
					"content": "Pekala... Gidip bir bakalım mı? En iyi ihtimalle onu suçüstü yakalarız; olmazsa onu tehdit edip ötüp ötmediğini görürüz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120010205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010205,
					"content": "Hadi önce muhafızlarla konuşalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010206
					]
				},
				{
					"id": 120010206,
					"content": "Tamam patron! Ne söylersen patron!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120010203,
					"content": "Onu suçüstü yakalamamız gerekiyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120010204
					]
				}
			]
		},
		{
			"id": 1200103,
			"completionStepIds": [
				1200103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
