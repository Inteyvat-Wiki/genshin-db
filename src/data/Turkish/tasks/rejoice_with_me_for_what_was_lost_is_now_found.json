					"Jeht",
					"Benben"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732441001,
					"content": "Bak, Benben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441002,
					"content": "Aderfi'nin Benben'i alamamasına sevindim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441003
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441003,
					"content": "Ya da buradaki her şeyin aynı eskisi gibi göründüğünü ve bir değişiklik olmadığını söyleyebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441004
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441004,
					"content": "Gerçekten de Lideri devireceğini ve sonra da sağ salim çadırına dönebileceğini mi düşündü? Ne kadar da kendini beğenmiş bir aptal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441005
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441005,
					"content": "Neyse ki bu aptallığı sayesinde Benben'e kötü bir şey olmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441006
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441006,
					"content": "Sen buna \"kötü bir şey olmadı\" mı diyorsun? Ah, zavallı Benben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441007,
						732441008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441007,
					"content": "Bu hale nasıl geldin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441009
					]
				},
				{
					"id": 732441009,
					"content": "Evet, neden yerde duruyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441010,
					"content": "Her neyse, Benben'e ne oldu? Onu en son gördüğümüzde her şey yolunda gibiydi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441011
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441011,
					"content": "Khaj-Nisut'tan ayrıldıktan sonra Benben giderek zayıfladı... Parçaları arızalanmış gibi duruyordu ve çıkardığı bip seslerinin şiddeti de gittikçe azalıyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441012
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441012,
					"content": "Daha sonra hiç ses çıkarmamaya başladı ve hareketsiz hale geldi. Sanki ömrünün yavaş yavaş tükenişini izliyormuşum gibi hissettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441013
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441013,
					"content": "O sıralarda kabileden Aderfi dışında hiç kimse Benben'e neler olduğunu bilmiyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441014
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441014,
					"content": "Bu yüzden ben de Benben'i ilgilenmesi için ona bıraktım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441015
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441015,
					"content": "Olamaz... Benben sonsuza kadar böyle mi kalacak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441016
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441016,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441017
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441017,
					"content": "En azından Benben halen burada bizimle. Er ya da geç onu tamir etmenin bir yolunu bulacağımıza eminim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441018
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441018,
					"content": "Ama bu şekilde yapabileceğimiz bir şey yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441019
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732441019,
					"content": "Hımm, bir düşüneyim. Aderfi'nin, Benben'in sorunu her ne ise çok ciddi bir şey olmadığını ve birkaç gün içinde düzeleceğini söylediğini hatırlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441020
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441020,
					"content": "Onu iyi tanırım, eğer bir tür soruşturma yapmışsa geride kesin bir kayıt bırakmıştır. Etrafa bir göz atalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441021
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441021,
					"content": "Gerçekten de \"çok ciddi bir şeyi yok\" ise Benben'i kendimiz bile tamir etmeyi deneyebiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441008,
					"content": "Benben'in nesi var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441009
					]
				}
			]
		},
