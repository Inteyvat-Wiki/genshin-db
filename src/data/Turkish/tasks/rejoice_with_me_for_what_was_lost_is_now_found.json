			"dialogs": [
				{
					"id": 732441901,
					"content": "Enerji Dönüşüm Kondansatörleri... Onları bulduğumuzda Benben'in eski haline döneceğini umuyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441902
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441902,
					"content": "Hâlâ emin değilseniz ben de sizinle gelebilirim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441903,
						732441904
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441903,
					"content": "Sen burada Benben'le kal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441905
					]
				},
				{
					"id": 732441905,
					"content": "Pekala. İyi haberlerinizi bekliyorum... Kendinize dikkat edin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441904,
					"content": "Çok hızlı bir şekilde gidip geleceğiz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441905
					]
				}
			]
		},
