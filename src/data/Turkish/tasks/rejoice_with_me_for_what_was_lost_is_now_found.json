					"nextDialogs": [
						732441517
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441517,
					"content": "Benben, hiçbir şey söylemeden hareketsiz bir şekilde duruyor olsa da sizin yaptığınız her şeyden haberdar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732441518
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732441518,
					"content": "Teşekküre lüzum yok, Benben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732441519
					]
				},
