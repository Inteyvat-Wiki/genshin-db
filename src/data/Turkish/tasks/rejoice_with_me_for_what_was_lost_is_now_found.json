			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jeht"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732440301,
					"content": "Hey bak, burada bir şey var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440302,
					"content": "Paimon'a soruşturma kayıtları gibi gelmedi. Daha çok... Bir mektuba benziyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440303,
					"content": "Mektup mu? Hadi açalım ve ne yazıyormuş bakalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440304
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440304,
					"content": "Mektupta Benben'in enerjisinin bittiği yazıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440305,
					"content": "Paimon şöyle bir düşündüğünde, ister Kral Deshret'in Anıt Mezarının kapısını açmak olsun ister bizim için izinleri etkinleştirmek olsun, Benben yol boyunca bizim için çok şey yaptı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440306,
					"content": "Ve Benben gibi mekanik yaratıklar bile yorulur. Belki de bizim için onca şeyi yaptıktan sonra enerjisi bitmiştir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440307
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440307,
					"content": "Mektupta Enerji Dönüşüm Kondansatörü denen bir şeylerden bahsediliyordu ama ben çadırda böyle bir şey görmedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440308
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440308,
					"content": "Acaba onu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440309,
						732440312
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440309,
					"content": "Bir yere saklanmış olabilirler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440310
					]
				},
				{
					"id": 732440310,
					"content": "Pek sanmam. Eğer o Kondansatörler Benben'i onarmak için ise Aderfi neden onları saklamaya çalışsın ki? Bunları hemen kullanmak daha mantıklı olmaz mıydı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440311
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440311,
					"content": "Aha buldum! Anlaşma henüz gerçekleşmediği için olmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440314
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440314,
					"content": "Aderfi, Benben'i anlaşmanın yapıldığı yere götürmediği için burada Enerji Dönüşüm Kondansatörü de yoktu... Geriye tek bir soru kaldı o zaman, Aderfi kiminle anlaşma yaptı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440315
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440315,
					"content": "Ah, benim bu soruyu sormam da çok saçma oldu. Onun kabile dışında bu tür anlaşmalar yapacağı tek bir grup var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440316,
						732440318
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440316,
					"content": "Sumerulu araştırmacılar mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440317
					]
				},
				{
					"id": 732440317,
					"content": "Fatui!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440320
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440320,
					"content": "Peki şimdi ne yapacağız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440321,
					"content": "Ne mi yapacağız? Fatui ile pazarlık yapmayacağız. Anlaşma yerine gideceğiz ve onlardan Kondansatörleri çalacağız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440322
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440322,
					"content": "İşte bu! Gidelim ve çalalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440323,
					"content": "Ama Benben'i... Şu anki haliyle yanımızda taşıyamayacağımız için onu anlaşma yerine götüremeyiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440324
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440324,
					"content": "Onu öylece bırakmak da güvenli değil. Onu tekrar riskli bir duruma sokmak istemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440325
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440325,
					"content": "#Paimon ve {NICKNAME}, Fatui'ye baskın yapacak! Sen Benben ile birlikte burada kal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440326,
						732440328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440326,
					"content": "Tamam!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440327
					]
				},
				{
					"id": 732440327,
					"content": "Pekala hadi Fatui'ye baskın yapalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440330,
					"content": "#Tek başıma gitmeyi gerçekten çok istiyorum ama... {NICKNAME} ve Paimon, Benben'in eski haline dönmesi için ikinize güveniyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440331
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440331,
					"content": "Onlar sadece bir avuç dolusu Fatui de olsalar, yine de dikkatli olmakta fayda var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440332
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440332,
					"content": "Endişelenme! O iş bizde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440333,
					"content": "Benben'le birlikte bu hainin çadırında kalmak istemiyorum. Onu kendi yerime götüreceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440334
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440334,
					"content": "Siz Kondansatörleri aldıktan sonra benim çadırımda buluşalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440328,
					"content": "Hadi Fatui'ye baskın yapalım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440329
					]
				},
				{
					"id": 732440329,
					"content": "Evet evet! İlk defa yapmıyoruz zaten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440318,
					"content": "Fatui!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440319
					]
				},
				{
					"id": 732440319,
					"content": "Aynen öyle. Başka kim olabilirdi ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440320
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440312,
					"content": "Onları hiç almamış olabilir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440313
					]
				},
				{
					"id": 732440313,
					"content": "Ah, demek istediğini anladım! Anlaşma henüz yapılmadı bile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440314
					],
					"speakerTitle": "Jeht"
				}
			]
		},
