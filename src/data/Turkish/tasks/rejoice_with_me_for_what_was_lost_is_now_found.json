				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732440101,
					"content": "Ben... Bunu nasıl unuttum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440102
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440102,
					"content": "Umarım çok geç kalmamışızdır. En azından çadırının etrafını aramalıyız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440103
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440103,
					"content": "Jeht! Ne oldu? Bir yere mi gidiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440104,
					"content": "#Paimon ve {NICKNAME}... Tam zamanında geldiniz. Tam da benim yapmam gereken bir şey vardı... Aderfi'nin kaldığı yere gitmem lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440105
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440105,
					"content": "Aderfi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440106,
					"content": "Şu Fatui ile gizli anlaşmalar yapan hain mi? Ah, Paimon anladı! Geride değerli bir şeyler bıraktı mı diye bakmaya gidiyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440107,
					"content": "Hayır, onun eşyalarıyla hiç ilgilenmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440108
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440108,
					"content": "Aderfi gibi hainlerin eşyalarıyla nasıl ilgilenileceği konusunda kabilenin kendi kuralları var. Hıh, kurallar olmasaydı şüphesiz ilk fırsatta her şeyi yakardım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440109
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440109,
					"content": "Onun çadırına gitmek istememin sebebi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440110
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440110,
					"content": "Sebebi Benben, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440111
					]
				},
				{
					"id": 732440111,
					"content": "Ah, hayır! Benben halen Aderfi'nin yanında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440112,
					"content": "Jehhht... Neden Benben'i onun gibi biriyle bıraktın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440113,
					"content": "B-Ben onun bir hain olduğunu bilmiyordum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440114
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440114,
					"content": "Her neyse, en kısa zamanda Benben'i kontrol etmem gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440115
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732440115,
					"content": "#{NICKNAME}, onunla birlikte gitmeliyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732440116,
						732440117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440116,
					"content": "Hadi o zaman, daha fazla vakit kaybetmeyelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440118
					]
				},
				{
					"id": 732440118,
					"content": "Aynen... Paimon, Benben'in iyi olmasını umuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732440117,
					"content": "Hadi yola koyulalım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732440118
					]
				}
			]
		},
		{
			"id": 7324403,
			"completionStepIds": [
				7324403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
