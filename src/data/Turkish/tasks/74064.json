			"trigger": {
				"objectNames": [
					"Clynes"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740640301,
					"content": "Hı? Clynes mı o?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640302,
						740640304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640302,
					"content": "Selam Clynes. Yine karşılaştık.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640303
					]
				},
				{
					"id": 740640303,
					"content": "Hı? Clynes buradaysa işareti gerçekten o yapmış olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640306,
					"content": "Hı? Siz ikiniz burada ne yapıyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640307
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640307,
					"content": "Neden bahsediyorsunuz? Dediklerinizden hiçbir şey anlamadım. Beni başka biriyle karıştırdınız sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640308,
						740640310
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640308,
					"content": "Bence yanlış adamı yakaladık Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640309
					]
				},
				{
					"id": 740640309,
					"content": "#Ah, yanlış adamı yakaladık galiba... Bir dakika! Seni kandırmasına izin verme {NICKNAME}! Burada başka kimse yok! Suçlu o!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640312,
					"content": "... Peki, siz kazandınız. Evet, ben yaptım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640313
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640313,
					"content": "*iç çeker* İşaretleri bazı eski arkadaşlarımla konuşmak için kullanmayı planlıyordum, onların yerine sizi görmeyi hiç beklemiyordum doğrusu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640314
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640314,
					"content": "Arkadaşlarınla konuşmak için mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640315,
					"content": "Şifreli Mektup, Bay Butor tarafından geliştirilmiş olan ve Fontaine Araştırma Enstitüsü dahil olmak üzere çok az kişinin çözebildiği bir teknolojidir. Bunu bilmemin tek sebebi ise onun bir zamanlar bana yardım etmiş olması.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640316
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640316,
					"content": "Maalesef çok gençken aramızdan ayrıldı ve yönetim de onun bu Şifreli Mektup teknolojisini pek umursamadı. Bu yüzden yaptığım işaretleri çözebilecek birisi olursa konuşacak bir şeyimiz olur diye düşündüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640317
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640317,
					"content": "Şey, konuşacak bir şeyimiz yok demiyorum. Sadece konuşamayacağımız konular konuşabileceklerimizden daha fazla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640318,
						740640321
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640318,
					"content": "Öyleyse kendini daha fazla zorlamana gerek yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640319
					]
				},
				{
					"id": 740640319,
					"content": "Çok dürüstsün. Bir zamanlar senin kadar dürüst olan ve bu yüzden başı derde giren bir arkadaşım vardı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640320
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640320,
					"content": "Şimdi düşünüyorum da o zamanlar ne güzelmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640325
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640325,
					"content": "Neyse, buraya sadece beni yakalamak için mi geldiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640326
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640326,
					"content": "Paimon az daha unutuyordu! Galvaryet ve Maupoil bizden grafitiyi yapan suçluyu araştırmamızı istedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640327,
					"content": "Teslim ol lütfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640328
					]
				},
				{
					"id": 740640328,
					"content": "Teslim ol! Direnirsen orantısız güç kullanmaktan kaçınmayız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640329,
					"content": "*iç çeker* Şimdilik bu konudan konuşamaz mıyız? Maupoil bir yana, asıl Galvaryet'nin eline düşmek istemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640330
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640330,
					"content": "Şey, tüm bunlara bu seferlik göz yumabilir misiniz acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640331
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640331,
					"content": "Ama Maupoil, Kalede grafitinin yasak olduğunu söyledi! Kuralları çiğnemek kötüdür, öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640332,
					"content": "Eğer kurallara ve tanımlara bu kadar saygı duyuyorsanız, duvardaki Şifreli Mektupların diğer yazılardan farksız olduğunu bilmelisiniz. Bunların hepsinin dekordan hiçbir farkı yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640333
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640333,
					"content": "#Peki şöyle yapsak nasıl olur? Sizinle geleceğim ama beni teslim edip etmemeye {NICKNAME} karar verecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640334
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640334,
					"content": "Elbette bana yardım edip beni Galvaryet'nin eline düşürmezseniz... Size uygun bir şekilde ödemenizi yaparım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640335
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640335,
					"content": "Kaderim sizin ellerinizde. Hadi gidelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640321,
					"content": "Bunu duyduğuma üzüldüm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640322
					]
				},
				{
					"id": 740640322,
					"content": "Hah! Bu sözüne nasıl karşılık verebilirim sence?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640323
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640323,
					"content": "Böyle durumlarda kibarca \"Maceralarını duymak iyi olurdu.\" falan demem gerekir ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640324
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640324,
					"content": "Ama en azından bu konuda kendime karşı dürüst olmaya karar verdim. Dış dünyanın nasıl olduğuyla ilgili yeni hikayeler duymak istemiyorum, tek istediğim birisiyle konuşabilmek. O yüzden özür dilemesi gereken benim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640325
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640310,
					"content": "Etrafına bir bak. Senden başka biri var mı burada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640311
					]
				},
				{
					"id": 740640311,
					"content": "Evet, doğru söylüyor! Bu şekilde kıvırarak bizi kandıramazsın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640304,
					"content": "İtiraf et! Sen yaptın, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640305
					]
				},
				{
					"id": 740640305,
					"content": "İtiraf et! Grafitinin ardında sen varsın, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640306
					],
					"speakerTitle": "Paimon"
				}
			]
		},
