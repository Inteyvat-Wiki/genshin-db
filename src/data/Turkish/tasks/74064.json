				},
				{
					"id": 740640502,
					"content": "Her şeyin bir düzeni vardır, önce o düzenin ardındaki ilkeleri anlaman gerekir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640503
					],
