			"dialogs": [
				{
					"id": 740640401,
					"content": "Demek Clynes'ı buldunuz. Ama... Grafitiyi yapan kişiyi ya da herhangi bir ipucu bulabildiniz mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640402
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640402,
					"content": "Şey, o konuda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640403,
						740640413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640403,
					"content": "Suçlu Clynes'mış.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640404
					]
				},
				{
					"id": 740640404,
					"content": "Ben de öyle düşünmüştüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640405
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640405,
					"content": "Of, bir sözle tüm bahanelerim çöp oldu. Sanırım artık topun ağzındayım, bakalım hakkımdan nasıl geleceksiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640406
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640406,
					"content": "Kural kuraldır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640407,
					"content": "Doğrusunu söylemek gerekirse senin cezandan çok bu işareti nasıl sileceğimizi düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640408
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640408,
					"content": "Şifreli Mektup teknolojisine ilgi mi duyuyorsun yoksa? Öyleyse istersen bir yere otur, her şeyi anlatmak biraz vaktimizi alacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640409
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640409,
					"content": "Hayır, detayları öğrenmek istemiyorum. Sadece bu işareti nasıl sileceğimi söylesen yeter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640410
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640410,
					"content": "O da iki kelimeyle anlatılamayacak kadar uzun. Ne de olsa özel boya ve kullanılan teknikler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640411
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640411,
					"content": "İlgilenmem gereken başka işler var, lütfen kısa tut. Of... Lütfen ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640412
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640412,
					"content": "#Onları kendi hallerine bırakalım. {NICKNAME}, Paimon, söz verdiğimiz gibi ödemeniz. Yardımınız için teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640413,
					"content": "Bunun için bir profesyonele ihtiyacımız var. Clynes, bir göz atsana.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640414
					]
				},
				{
					"id": 740640414,
					"content": "Daha önce bahsettiğin özel işaret bu mu Clynes?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640415
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640415,
					"content": "Bir bakayım... Hımm... Aha... Sizce de bir dişliye benzemiyor mu? Böylesine büyük bir dişli, Fontaine Araştırma Enstitüsü dışında nereden gelmiş olabilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640416
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640416,
					"content": "Senin gibi o da Enstitüden işte. Bence aranızdaki ilişki gayet orada. İtiraf et işte, suçlu sensin, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640417
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640417,
					"content": "Bu şekilde konuşamazsın! Eğer bir gün şansım yaver gider de Galvana ile Debord Otelde yemek yiyecek olursam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640418
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640418,
					"content": "Sanırım henüz uyanamamışsın, hâlâ hayaller alemindeysen seni seve seve uyandırabilirim. Eğer yumruklarım yeterli olmazsa eminim Roussimoff da birkaç yumrukla bana destek olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640419
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640419,
					"content": "Sakin olun, bir örnek veriyordum! Ama bu sadece bir örnek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640420
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640420,
					"content": "Ne söylüyordum ben... *öhöm* Neyse, Galvana ile yemeğe çıkacak olsaydık ikimiz de Meropide Kalesi'nden olmamıza rağmen bu yemek, aramızda herhangi bir ilişki olduğu manasına gelmezdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640421
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640421,
					"content": "Gördün mü? Bir ilişki falan yok işte! Yani benimle Galvana arasında bir ilişki olmadığı gibi, bu işaret ile benim aramda da bir ilişki yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640422
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640422,
					"content": "Peki, beni ikna ettin ama sadece kız kardeşimle arandaki ilişki konusunda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640423
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640423,
					"content": "İkna olmadın mı yani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640424
					]
				},
				{
					"id": 740640424,
					"content": "B-Bu konuda bize söz düşmez. Gerisi size kalmış!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640425,
					"content": "Her halükarda size teşekkür borçluyum. Bu da söz verdiğim gibi ücretiniz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640426
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740640426,
					"content": "#Doğru ya! {NICKNAME}, Paimon! Ücretinizi az daha unutacaktım! Gerçi suçluyu yakalayamadınız ama olsun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640427
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640427,
					"content": "Eminim Clynes bu işareti silmenin bir yolunu bulacaktır! Gerisini ona ve Galvaryet'ye bırakıyorum, ilgilenmem gereken başka işler var benim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maupoil"
				}
			]
		},
