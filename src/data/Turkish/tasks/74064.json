			"dialogs": [
				{
					"id": 740640201,
					"content": "Bir Tombalak yakalayıp onu işaretin üstüne tükürttürsek işe yarar mı acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640202
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640202,
					"content": "Ciddi misin? Son zamanlarda çok mu strese girdin, akıl sağlığın hâlâ yerinde mi ya da çok mu çalıştın anlamadım ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640203
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640203,
					"content": "Hiçbir sorunum yok, merak etme. Sadece bir Tombalağı tükürürken görmek istedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640204
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640204,
					"content": "Sen... Bir iki gün izin alsan iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Galvaryet"
				}
			]
		},
		{
			"id": 7406403,
			"completionStepIds": [
				7406403
