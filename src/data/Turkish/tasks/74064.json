			"dialogs": [
				{
					"id": 740640101,
					"content": "Dediğim gibi, ya onu silmenin bir yolunu ya da bu işin ardındaki kişiyi bulacaksın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640102
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640102,
					"content": "Senin için söylemesi kolay tabii... Türlü türlü temizlik malzemelerini kullandım ama hiçbiri işe yaramadı... Daha güçlü bir şey lazımsa eğer... Lekeli Su Tayfı Kovucusunu denememiz gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640103
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640103,
					"content": "Lekeli Su Tayfı Kovucusu mu? Duvarda bir delik mi açmak istiyorsun? Yakında hepimiz balıklarla birlikte uyuruz o zaman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640104
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640104,
					"content": "O zaman suçluyu yakalamamız lazım ama kim olduğuna dair elimizde hiçbir ipucu yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640105
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640105,
					"content": "Sorun nedir? Sizin için yapabileceğimiz bir şey var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640106,
					"content": "Şey... Duvardaki işareti görüyor musunuz? Meropide Kalesi'nde grafiti yapmak yasaktır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640107
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640107,
					"content": "Her şeyi denedik ama onu duvardan bir türlü silemedik. O yüzden en azından suçluyu yakalayabilirsek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640108
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640108,
					"content": "Bekle bir dakika, şimdi düşündüm de bir ipucumuz var aslında. Clynes'ın daha önce yalnızca özel yöntemlerle deşifre edilebilen Fontaine Araştırma Enstitüsüne ait bir işaretten bahsettiğini hatırlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640109
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640109,
					"content": "Bunun aynı türden bir işaret olduğunu mu söylüyorsun yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640110
					],
					"speakerTitle": "Maupoil"
				},
				{
					"id": 740640110,
					"content": "O zamanlar bu konuya pek ilgim olmadığından ona daha fazla soru sormamıştım. Burada olsaydı bizi bilgilendirebilirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640111,
						740640113
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640111,
					"content": "Belki de suçlu odur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640112
					]
				},
				{
					"id": 740640112,
					"content": "Olabilir, bu da ihtimaller dahilinde. Ancak öyleyse bile, hehe... Kuralları bilmesi lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640115
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640115,
					"content": "#{NICKNAME}, Paimon, sizler hem bilgili hem de tecrübeli maceracılarsınız, bir fikriniz var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640116
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640116,
					"content": "Bize bu grafitinin ardındaki suçluyu bulmamızda yardım edin veya Clynes'ı bir göz atması için buraya getirin. Hımm... Bunu resmi bir görev olarak görebilirsiniz, ödemenizi Kuponla yapacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640117
					],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640117,
					"content": "Tamam, görev artık resmi olduğuna göre bize de elimizden geleni yapmak düşer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740640118,
					"content": "Teşekkür ederiz. Ben de bu sırada bu grafitiyi silmenin bir yolu olup olmadığını bulmaya çalışacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Galvaryet"
				},
				{
					"id": 740640113,
					"content": "O zaman gidip onu arayalım mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640114
					]
				},
				{
					"id": 740640114,
					"content": "Nerede olduğu hakkında hiçbir fikrim yok... Bugün onu hiç görmedim. Ayrıca cidden ondan yardım mı isteyeceğiz? Ondan her bir şey istediğimizde kendime olan saygımı biraz daha kaybediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640115
					],
					"speakerTitle": "Maupoil"
				}
			]
		},
