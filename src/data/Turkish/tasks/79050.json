					"nextDialogs": [
						790501506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501506,
					"content": "Ressam belki bir gün dostlarını ziyaret eder ve onların şaheserini görme fırsatı bulur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501507,
					"content": "Doğrusu bu resmin eşsiz bir tarzı var... Öyle çok gösterişli bir parça değil ama yine de çok göz alıcı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790501508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790501508,
					"content": "Daha da önemlisi Paimon bu resmi anlayabiliyor! Belki bu tarzı taklit ederse Paimon da çok şirin ama kolay anlaşılır resimler yapabilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
