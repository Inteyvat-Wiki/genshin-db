				{
					"id": 710160301,
					"content": "İsimsiz Hazine hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160302
					]
				},
				{
					"id": 710160302,
					"content": "Doğru tahmin ediyorsam getirdiğin hazine üçlünün bir parçası.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160303
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160303,
					"content": "Üç parça da birleştiğinde asıl şekline ulaşacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160304
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160304,
					"content": "Hepsini toplayabilirsen sana bol keseden bir teklif sunabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160305
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160305,
					"content": "Parçaların tarihi düşündüğümüzden de eskiye dayanıyor olabilir. Hepsini toplamak... Kolay olmayacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				}
			]
		},
