			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linlang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710160201,
					"content": "İsimsiz Hazine hakkında...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160202
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160202,
					"content": "Bir bakalım... Çok iyi durumda. Üzerindeki desenler gerçekten de eski görünüyor. Açıp bakayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160203
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160203,
					"content": "Birkaç ufak ezik var ama elden çıkarmaya niyetliysen sana fiyat teklifi yapabilirim. Düşük bir fiyat vermeyeceğim ama çok yüksek de olmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160204
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160204,
					"content": "Şimdi şuna da baktım. Bu işaretler kesinlikle Liyue işaretleri. Şuraya da Azhdaha hakkında bir anekdot kazınmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160205
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160205,
					"content": "Hikayelere göre Azhdaha, Liyue'deki Toprak ruhlarının bir araya gelmesi sonucu ortaya çıkan bir ejdermiş. O kadar güçlüymüş ki Rex Lapis bile boyun eğdirememiş ona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160206
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160206,
					"content": "Üç Adeptusu yardıma çağıran Rex Lapis onlarla birlikte mağarayı andıran bir diyar yaratmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160207
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160207,
					"content": "Ardından Rex Lapis yaratıkla savaşıp onu diyara doğru çekmiş ve Adeptuslar da girişi mühürleyerek Azhdaha'yı içeri hapsetmeyi başarmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160208
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160208,
					"content": "Görmüş olduğunuz bu desenler üç Adeptusun bu mağara diyarını yaratışını anlatıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160209
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160209,
					"content": "Buna benzer en az üç yadigar daha olmalı. Üçünü de birleştirirsek parça tamamlanacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160210,
						710160212
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160210,
					"content": "Bunları nereden biliyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160211
					]
				},
				{
					"id": 710160211,
					"content": "Her türden eşyanın ticaretini yapıyorum. Her alanda biraz bilgi sahibi olmanın çok faydasını gördüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160215
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160215,
					"content": "Neyse, konuyu dağıtmayayım. Önceden söylediğim gibi bundan toplam üç tane olmalı. Yalnızca birinin sana sağlayacağı kazanç yüksek olmayacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160216
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160216,
					"content": "Üçünü de toplarsan işin rengi değişir tabii. Çok kadim bir yadigara benziyor bu, hepsini toplamak kolay olmayacaktır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160212,
					"content": "Liyue gerçekten de büyülü bir yer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160213
					]
				},
				{
					"id": 710160213,
					"content": "Bu konudan o kadar da emin değilim ama üstlerimden biri zamanında Liyue'nin çok büyük olduğunu, haliyle tarihinin de zengin olduğunu söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160214
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160214,
					"content": "Liyue'de ilginç yadigarlar bulursan şaşırma çünkü halihazırda bildiğimiz Liyue tarihi okyanustaki küçük bir su damlasından ibaret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160215
					],
					"speakerTitle": "Linlang"
				}
			]
		},
