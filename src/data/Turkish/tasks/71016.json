			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Linlang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710160501,
					"content": "Hepsini buldum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160502
					]
				},
				{
					"id": 710160502,
					"content": "Sen... Başardın mı gerçekten? Lütfen göster... Evet, bu üç desen birleştiğinde gerçekten de Azhdaha'nın hikayesini anlatıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160503
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160503,
					"content": "Bu turna Adeptus Dağkesen olmalı, bu geyik de Ay Oymacısı. Üçüncüsü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160504
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160504,
					"content": "Ne? Bu desen... Sanki birileri bu deseni özellikle kazımış gibi, ne olduğunu anlayamıyorum. Üçüncü Adeptus kim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160505
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160505,
					"content": "Neyse. Bu meseleler benim bilgimi aşıyor. Sonuçta hazine artık tamamlandı. Eminim yüksek fiyattan alıcı bulacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160506
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160506,
					"content": "Hatıra olarak mı saklayacaksın yoksa bana mı satacaksın? Satarsan iyi ödeme yaparım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160507
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160507,
					"content": "Tamam anlaştık.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710160508
					]
				},
				{
					"id": 710160508,
					"content": "Harika. Şöyle vereyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710160509
					],
					"speakerTitle": "Linlang"
				},
				{
					"id": 710160509,
					"content": "Hâlâ kafamı kurcalıyor, neden Adeptuslardan birinin görüntüsü karalanmış?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
