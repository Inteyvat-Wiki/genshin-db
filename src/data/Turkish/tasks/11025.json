					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240302,
					"content": "Tuz Tanrısı için biraz üzülüyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240303
					]
				},
				{
					"id": 110240303,
					"content": "Doğruyu ve yanlışı Hükümdarlar Savaşı zamanında bugünkü gibi yargılamıyorduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240304
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240304,
					"content": "Tabii artık değiştim... Keşke o daha sakin bir zaman diliminde yaşasaydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240305,
					"content": "O yadigarlar Osial'ın güçlenmesine sebep olmaz mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240306
					]
				},
				{
					"id": 110240306,
					"content": "Tuz kadehi ve tuz cetvelinin kendi çaplarında bir gücü olsa da Osial'ın gücü karşısında birer hiçler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240307
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240307,
					"content": "Bir gün olur da gücünü toplayıp geri gelirse... Ah, inanıyorum ki, tekrar yenilecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240308,
					"content": "Peki şimdi sen ne yapacaksın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240309
					]
				},
				{
					"id": 110240309,
					"content": "Güzel soru. Eskiden sormuş olsaydın cevabım çok net olurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240310
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240310,
					"content": "Şimdi ise... Eh, sanırım Wangsheng Cenaze Evinde danışman olarak çalışmaya devam edeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240311
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110240311,
					"content": "Bu yolculuktan keyif aldıysanız Liyue'nin geçmişine dair anıları korumam gerektiğinde yine bana katılabilirsiniz. Ne dersiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
