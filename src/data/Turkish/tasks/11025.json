			"dialogs": [
				{
					"id": 110240301,
					"content": "Bir süre burada kalacağım. Korkarım ki hayatta böyle anılar gitgide azalıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240302,
