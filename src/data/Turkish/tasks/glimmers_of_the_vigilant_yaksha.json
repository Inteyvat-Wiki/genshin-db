			"dialogs": [
				{
					"id": 111010201,
					"content": "\"Yakshalar: Muhafız Adeptuslar\" kitabını mı arıyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010202
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 111010202,
					"content": "Evet. Buyurun, üstü kalsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010203
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111010203,
					"content": "Oo... Çok cömertsiniz. Bizi seçtiğiniz için teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010204
					],
					"speakerTitle": "Jifang"
				},
				{
					"id": 111010204,
					"content": "Hey, şu, Yıldızkoparan değil mi? Yeniden karşılaştık, bu ne tesadüf!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010205,
						111010206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010205,
					"content": "Yıldızkapan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010207
					]
				},
				{
					"id": 111010207,
					"content": "Biraz önce aldığı şu kitabı duydun mu? \"Yakshalar: Muhafız Adeptuslar\" mıydı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010208,
					"content": "Şey, her neyse. Kesinlikle Adeptuslar hakkında bir kitaptı. Bir Adeptus neden kendisi hakkında bir kitap almak istesin ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010209,
						111010211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010209,
					"content": "Bu işte bir bit yeniği var...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010210
					]
				},
				{
					"id": 111010210,
					"content": "Cidden mi? Ben saçında hiç bit görmedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010214,
						111010216,
						111010218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010214,
					"content": "Bir Adeptus neden insanların kendisine Mora ödemesini istesin ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010215
					]
				},
				{
					"id": 111010215,
					"content": "Hah, iyi bir noktaya değindin... Tanıştığımız diğer Adeptuslardan hiçbiri başkalarından gelecek şeylere ihtiyaçları varmış gibi durmuyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010220,
					"content": "Hım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010221,
					"content": "Paimon o kitaba bakmamız gerektiğini düşünüyor. Belki bu adam hakkında işe yarar bir bilgi buluruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010216,
					"content": "Bana kalırsa o bir şarlatan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010217
					]
				},
				{
					"id": 111010217,
					"content": "Yani, aslında insanların dileklerini yerine getiremediğini mi söylüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010218,
					"content": "Maskesi çok çirkin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010219
					]
				},
				{
					"id": 111010219,
					"content": "Haklısın, gerçekten öyle. Şüphe uyandıran cinsten...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010211,
					"content": "Belki de kendini beğenmiş biridir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010212
					]
				},
				{
					"id": 111010212,
					"content": "Olabilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010213,
					"content": "Hımm... Paimon şimdi düşünüyor da, bu adamla ilgili yolunda gitmeyen bir şeyler var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010214,
						111010216,
						111010218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010206,
					"content": "Tesadüf mü yoksa adeptüf mü?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010207
					]
				}
			]
		},
