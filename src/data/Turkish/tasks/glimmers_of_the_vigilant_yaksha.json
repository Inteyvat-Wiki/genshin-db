				{
					"id": 111011401,
					"content": "Aklıma başka bir şey gelmiyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111011402
					]
				},
				{
					"id": 111011402,
					"content": "Evet, Paimon bütün önemli noktaları zaten özetlediğimizi düşünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111011403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111011403,
					"content": "Peki, konumuza dönecek olursak. Cevaplamamız gereken ilk şey şu süper kötü görünümlü dağ yabanilerinin nereden çıktığı, ikinci olarak da Yıldızkapan'ın Yakshalar ile ne alakası olduğu. Değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111011404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111011404,
					"content": "Şimdi bütün bunların başladığı yere geri dönelim ve araştırmamıza başlayalım! Jueyun Gölü'nün üzerindeki gizem perdesini aralayalım ve tüm şanıyla hakikati gün yüzüne çıkaralım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111011405,
						111011406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111011405,
					"content": "Yani dedektifi oynuyoruz artık, öyle mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111011407
					]
				},
				{
					"id": 111011407,
					"content": "Hahah! Dürüst olmak gerekirse Paimon o adamın gerçek bir Adeptus çıkmasını umuyor. En azından, kötü ruh kovma taktikleri yeterince sahici görünüyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111011408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111011408,
					"content": "Hımm... Fakat ne kadar çok ümitlenirsek o kadar çok üzülürüz. Bu yüzden emin olmak için önce etraflıca bir araştıralım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111011409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111011409,
					"content": "Pekala, hadi Wangshu Hanına geri dönelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111011406,
					"content": "Kendini çok kaptırdın...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111011407
					]
				}
