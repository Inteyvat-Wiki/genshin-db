			},
			"dialogs": [
				{
					"id": 111010701,
					"content": "Anlamıyorum... Neden Yetki Mührü hiçbir işe yaramadı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010702
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111010702,
					"content": "Bu dağ yabanilerinin şeytani havası mı güçlenmiş?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010703
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111010703,
					"content": "Yetki Mührü mü? Bu neden kulağa tanıdık geliyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010704,
						111010705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010704,
					"content": "Evet, Jueyun'dan bedava çıkış kartı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010706
					]
				},
				{
					"id": 111010706,
					"content": "Doğru! Bu, Adeptusların yadigarı. Bu yüzden onların gücünden izler taşıyor olmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010707,
					"content": "*iç çeker* Geçen sefer o canavarları korkutup kaçırabilmesine şaşmamalı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010708,
					"content": "S-Siz ikiniz ne geveliyorsunuz? Yüce Olan ben uykumu tam alamadım sadece... Yani Adeptus güçlerim... Yeterli seviyede değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010709
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111010709,
					"content": "Bir fırsat daha verilseydi şayet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010710
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111010710,
					"content": "Şansına bir grup dağ yabanisi daha geliyor şuradan. Onları sana bırakalım mı öyleyse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010711,
					"content": "B-Ben, Yüce Olan... Birden huzursuz hissetmeye başladım. Kesinlikle Adeptus güçlerimi çok fazla tükettim, yoksa şu şeytani yaratıkları bir an evvel ortadan kaldırırdım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010712
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111010712,
					"content": "Ah! Demek hepsi palavraydı. Şüphelenmekte haklıymışız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010713,
					"content": "Hadi Gezgin, görünüşe göre iş bize kaldı. Element Görüşünü kullan ve onları hakla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111010705,
					"content": "Demek kötü ruh kovma ayinleri için bunu kullanıyordu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111010706
					]
				}
			]
