				{
					"id": 111011101,
					"content": "Şeytanlarla ilgili kısım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111011102
					]
				},
				{
					"id": 111011102,
					"content": "Kitapta Hükümdarlar Savaşı sırasında yenilgiye uğrayan tanrıların öfkeli ruhlarının kimi zaman salgınlara, canavarlara veya mutasyonlara yol açabileceği anlatılıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111011103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111011103,
					"content": "Hepsi kulağa korkunç geliyor. Hey, bir saniye... Paimon merak ediyor da acaba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111011104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111011104,
					"content": "Sence daha önce gördüğümüz o süper kötü dağ yabanileri, kitabın bahsettiği \"mutasyonlar\" mıydı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
