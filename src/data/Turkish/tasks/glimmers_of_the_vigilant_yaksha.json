				{
					"id": 111011201,
					"content": "Karmayla ilgili kısım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111011202
					]
				},
				{
					"id": 111011202,
					"content": "Kitaba göre Yakshalar, binlerce yıl boyunca tanrıların gazabına karşı savaştıktan sonra karmanın gücüyle bağlanmışlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111011203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111011203,
					"content": "Tanrıların nefret dolu düşünceleriyle zehirlenen Yakshalar, çoğu zaman tarifsiz korku, öfke ya da ızdırap nöbetlerine girerlermiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111011204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111011204,
					"content": "*iç çeker* Çok trajik... Liyue'yi koruyarak geçirdikleri onca yıldan sonra hiçbir ödül almamışlar ve üstüne bir de o kadar çok acıyla boğuşmak zorunda kalmışlar ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
