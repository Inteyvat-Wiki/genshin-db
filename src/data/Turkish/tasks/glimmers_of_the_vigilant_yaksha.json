						111011302
					]
				},
				{
					"id": 111011302,
					"content": "Eskiden beş büyük Yaksha varmış, ancak söylenenlere göre bunlardan sadece biri hâlâ hayatta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
