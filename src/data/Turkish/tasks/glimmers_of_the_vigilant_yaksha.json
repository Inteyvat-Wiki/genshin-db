					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010502
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111010502,
					"content": "... Kaçın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010503
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111010503,
					"content": "N-Neden kaçmıyorsunuz?!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111010504
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
