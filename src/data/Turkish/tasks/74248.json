			"dialogs": [
				{
					"id": 742480101,
					"content": "Ah! Bayan Columbina, Bayan Sandrone! Vakit ayırıp Masa Oyunu Topluluğumuza katıldığınız için teşekkür ederiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480102
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 742480102,
					"content": "O zevk asıl bize ait. Daha önce hiç oynamadık açıkçası, o yüzden bize biraz yol göstermen lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480103
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742480103,
					"content": "Merak etmeyin, herhangi bir baskı altında değilsiniz. Önemli olan herkesin eğlenmesi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480104
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 742480104,
					"content": "Harika! Bunu dört gözle bekliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480105
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 742480105,
					"content": "O zaman kısaca hikayeyi anlatayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480106
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 742480106,
					"content": "\"Vampirlerle insanların iç içe yaşadığı bir çağdayız. Hikayemiz, bu iki ırka birden ev sahipliği yapan bir şehirde geçiyor...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480107
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Canlandıran: Clorinde"
				},
				{
					"id": 742480107,
					"content": "\"Açıkça kanlı bıçaklı olmasalar da, insanlar ve vampirler arasındaki ilişki uyumlu olmaktan çok uzaktır. Şimdi ise gecenin karanlığında işlenen bir cinayet, bu pamuk ipliğine bağlı dengeyi tamamen altüst etti...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480108
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Canlandıran: Clorinde"
				},
				{
					"id": 742480108,
					"content": "Vampirler mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480109
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 742480109,
					"content": "İnsan kanı içerek hayatta kalan bir ırk. Fantastik romanlarda yaygın bir temadır. Daha önce hiç böyle hikayeler okudun mu Bayan Columbina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480110
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 742480110,
					"content": "Hımm, sanırım duymuştum. Peki bu hikayede ne yapıyoruz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480111
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 742480111,
					"content": "Öncelikle herkesin hangi karakter olmak istediğine karar vermesi gerekiyor. Kurguya uygun olduğu sürece dilediğiniz kimliği ve mesleği seçebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480112
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 742480112,
					"content": "Nasıl bir karakter olmak istiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480113
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 742480113,
					"content": "Karar vermekte zorlanıyorsan başka biriyle takım olup senin için bir karakter yaratmasını isteyebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480114
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 742480114,
					"content": "Aa? Yani... Geçmişimizi başka birinin oluşturmasına izin verebiliyor muyuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480115
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742480115,
					"content": "Çok eğlenceli olur aslında! Hadi hepimiz öyle yapalım! Karakter kağıdımı sana bırakıyorum Clorinde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480116
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 742480116,
					"content": "O zaman benim karakterime sen karar ver Sandrone, ben de sana en uygun rolü düşüneyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480117
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 742480117,
					"content": "Hah... Bana uyar. Zaten hangi mesleği seçeceğimden emin değildim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480118
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742480118,
					"content": "Herkes bitirdi mi? Hehe, benimkinde ne yazdığını görmek için sabırsızlanıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480119
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 742480119,
					"content": "\"Ben, vampirlerin ve insanların bir arada yaşadığı bir şehirde ticaret yapan bir tüccarım...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480120
					],
					"speakerTitle": "Navia",
					"speakerSubtitle": "Gezgin Tüccar"
				},
				{
					"id": 742480120,
					"content": "... Bir saniye ya. Oyun Yöneticisi, bu karakter kağıdı önceki karakterime aşırı benziyor... İstatistikleri bile bire bir aynı! Resmen her şeyi kopyala yapıştır yapmışsın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480121
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 742480121,
					"content": "Sana ne verirsem vereyim, nasıl olsa hikayeyi rayından çıkarmanın tuhaf bir yolunu bulacaksın. Hem bence bu tarz kurnaz ve şamatacı bir karakter sana cuk oturuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480122
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 742480122,
					"content": "... Hey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480123
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 742480123,
					"content": "Haha. Bakalım ben kimmişim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480124
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 742480124,
					"content": "\"Ben çok ama çok kötü bir vampirim. Gündüzleri evde uyumayı severim, sadece geceleri Ay çıktığında bahçede dolaşmak için dışarı çıkarım.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480125
					],
					"speakerTitle": "Küçük Hanım",
					"speakerSubtitle": "Çok Ama Çok Kötü Vampir"
				},
				{
					"id": 742480125,
					"content": "\"Şarkı söylemeyi severim ve avımı cezbetmek için sesimi kullanırım. Gözlerimin içine bakan hiç kimse gün doğumunu görecek kadar yaşamadı.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480126
					],
					"speakerTitle": "Küçük Hanım",
					"speakerSubtitle": "Çok Ama Çok Kötü Vampir"
				},
				{
					"id": 742480126,
					"content": "Hımm... Beni böyle mi görüyorsun Sandrone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480127
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 742480127,
					"content": "Hehe, sence de sana yakışmıyor mu? Ayrıca çok ilginç bir karakter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480128
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742480128,
					"content": "Peki ama yine de biraz daha... İyi kalpli bir vampir olmak için elimden geleni yapmak istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480129
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 742480129,
					"content": "Nasıl istersen. Pekala, benimkine bakalım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480130
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742480130,
					"content": "\"Ben odamda icatlarla uğraşmayı seven zarif ve soylu bir hanımefendiyim. Çok geç uyurum ve son derece düzensiz bir programa sahibim...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480131
					],
					"speakerTitle": "Kukla",
					"speakerSubtitle": "Vampir Avcısı"
				},
				{
					"id": 742480131,
					"content": "Hey! Kim kendini böyle tanıtır ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480132
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742480132,
					"content": "Hıh... \"Ama aynı zamanda bir vampir avcısıyım. Şehirde birinin başı belaya girdiğinde icatlarımla cesurca yardımına koşarım...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480133
					],
					"speakerTitle": "Kukla",
					"speakerSubtitle": "Vampir Avcısı"
				},
				{
					"id": 742480133,
					"content": "... Ne? Bu bana hiç benzemiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480134
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742480134,
					"content": "Öyle mi dersin? Bence tıpatıp kopyan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480135
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 742480135,
					"content": "Yalnız bu tanıtımlara bakacak olursak Bayan Columbina ile Bayan Sandrone'nin karakterlerinin can düşmanı olması gerekiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480136
					],
					"speakerTitle": "Navia",
					"speakerSubtitle": "Gezgin Tüccar"
				},
				{
					"id": 742480136,
					"content": "Hımm, bu hikayede gerçekten çarpıcı gelişmeler yaşanacak anlaşılan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480137
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Canlandıran: Clorinde"
				},
				{
					"id": 742480137,
					"content": "Ay! Sabırsızlanıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480138
					],
					"speakerTitle": "Navia",
					"speakerSubtitle": "Gezgin Tüccar"
				},
				{
					"id": 742480138,
					"content": "Hah... Bu hikaye başımızı fena ağrıtacak gibi geliyor bana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480139
					],
					"speakerTitle": "Kukla",
					"speakerSubtitle": "Vampir Avcısı"
				},
				{
					"id": 742480139,
					"content": "İşlerin nereye varacağından endişelisin, değil mi Sandrone? Ne o, yoksa sırf kötü, kan emici bir vampirim diye korktun mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480140
					],
					"speakerTitle": "Küçük Hanım",
					"speakerSubtitle": "Çok Ama Çok Kötü Vampir"
				},
				{
					"id": 742480140,
					"content": "Hah! Benim tek korkum karakterini terbiye etme fırsatını kaçırmak olur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kukla",
					"speakerSubtitle": "Vampir Avcısı"
				}
			]
		},
