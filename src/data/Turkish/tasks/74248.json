			"dialogs": [
				{
					"id": 742480201,
					"content": "Bu \"Masa Oyunu Topluluğu\" cidden çok eğlenceliymiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480202,
						742480203
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 742480202,
					"content": "(Biraz daha oturalım.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480204
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742480204,
					"content": "Evet. Çok ama çok kötü vampirin de eve dönme vakti geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 742480203,
					"content": "Yavaş yavaş toparlansam iyi olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742480204
					],
					"speakerTitle": "Kukla"
				}
			]
		}
	]
