			"dialogs": [
				{
					"id": 120190101,
					"content": "Hımm? Konuşmak istediğiniz başka bir şey var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190102,
						120190105,
						120190109,
						120190113
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190102,
					"content": "Sütlü Dango...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120190103
					]
				},
				{
					"id": 120190103,
					"content": "O içecekten çok keyif aldığına hiç şüphem yok. Eminim olabildiğince mutlu olmuştur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190104
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190104,
					"content": "Aslında şunu demek isterdi: \"Zihnin Dinlenme Yerine en yakın ne zaman bir şube açabilirsin?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190101
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190105,
					"content": "Şogun Raiden hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120190106
					]
				},
				{
					"id": 120190106,
					"content": "Kukla, evet. Bir kuklanın çalışma kurallarını değiştirmenin son derece zor olduğunu duymuştum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190107
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190107,
					"content": "Büyük ihtimalle tarihte ilk kez biri bu tarz bir sorunla karşılaştı. Bilge ve güçlü Ei'i şaşırtmayı başardığını düşünürsek bunun ne kadar zor olduğunu tahmin edebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190108
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190108,
					"content": "Bu, Musou no Hitotachi'nin bile çözemeyeceği bir sorun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190101
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190109,
					"content": "Resimli romanlar hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120190110
					]
				},
				{
					"id": 120190110,
					"content": "Birinin Şogun Raiden olarak yeniden doğması sizce de eğlenceli bir fikir değil mi? Resimli romanların doğasında var bu, birazcık eğlence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190111
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190111,
					"content": "Tabii onun için bu... Biraz fazla yenilikçi oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190112
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190112,
					"content": "Ah, belki de Guuji Yae Olarak Yeniden Doğan'a bir devam yarışması düzenlemeliyim. Nasıl sence?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190101
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120190113,
					"content": "Söyleyeceğim başka bir şey yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
}