			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaeya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4610201,
					"content": "Burası olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610202
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610202,
					"content": "Anlatsana artık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610203,
					"content": "Nereden başlasam... Tamam, durun önce sırrı anlatayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610204
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610204,
					"content": "Geçmişimden bir sır. Bu sırrı saklayacağınıza güveniyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610205
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610205,
					"content": "Merak etme, Paimon'dan sır çıkmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610206,
					"content": "İşin doğrusu benim büyükbabam korsandı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610207
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610207,
					"content": "Aa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610208,
					"content": "... Bir dakika, sesin niye böyle neşeli geliyor? Uydurduğumu mu düşünüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610209
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610209,
					"content": "Göz bandıma baksana! Bu göz bandı bana büyükbabamdan miras kaldı. Kan bağımız olduğunun somut bir kanıtı bu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610210,
						4610213
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610210,
					"content": "Göz bandının bu şekilde aktarılabildiğini bilmiyordum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610211
					]
				},
				{
					"id": 4610211,
					"content": "#Hadi canım! {NICKNAME}, böyle yaygın bir bilgiyi nasıl bilmezsin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610212
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610212,
					"content": "Çocuklara anne babalarının saç şeklinin aktarılmasından hiç de farklı değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610214
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610214,
					"content": "Dün büyükbabamın bıraktığı notlara göz atarken <color=#00E1FFFF>hazine</color> bahsinin geçtiği kayıtlara rastladım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610215
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610215,
					"content": "... Hazine mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610216,
					"content": "Notlara göre hazine \"Kayıp Arkadya Harabelerinde\" gömülüymüş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610217
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610217,
					"content": "Hazine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610218,
					"content": "Ancak harabelerin yeri şu anda bilinmiyor. İpucu aramayı denedim ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610219
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610219,
					"content": "Hazine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610220,
					"content": "Kaeya! Nasıl bir hazineymiş bu? Altın mı? Yoksa daha da iyisi mücevher mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610221,
					"content": "Peh! Sadece altından ve mücevherden oluşan hazineye hazine mi denirmiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610222
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610222,
					"content": "Benim büyükbabamın hazinesi bir kılıç!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610223
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610223,
					"content": "Kullanan kişiye emsalsiz bir güç veren büyülü bir kılıç!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610224
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610224,
					"content": "Vayyyyy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610225,
					"content": "Kılıcı bir tanrı Kutsal Diyar'dan denize atmış. Daha sonra şans eseri büyükbabamın mürettebatı kılıcı bulup denizden çıkarmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610226
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610226,
					"content": "Büyükbabam kılıcı kavradığı anda gök gümbür gümbür gümbürdemiş, dalgalar kabarmış, açık gökyüzünü aniden şiddetli rüzgarlar yutmuş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610227
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610227,
					"content": "Büyükbabam büyülü kılıcın kudretiyle çok başlı bir yılanı, gümüş saçlı bir periyi ve fena bir hiçlik ejderini yenmiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610228
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610228,
					"content": "Ancak kılıcın muazzam gücü daha pek çok açgözlü korsanı cezbetmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610229
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610229,
					"content": "Anlamsız çekişmeleri önlemek isteyen büyükbabam da büyülü kılıcı saklamış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610230,
						4610232
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610230,
					"content": "Sekiz başlı yılanlar, gümüş saçlı periler... Bunlar gerçekten var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610231
					]
				},
				{
					"id": 4610231,
					"content": "Yaşadığımız dünya büyüleyici bir dünya, bir sürü bilinmeyen ve anlaşılmaz gizemlerle dolu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610233
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610233,
					"content": "Bu inanılmaz heyecan dolu maceralar ancak korsanların anlatacağı masallardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610234
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610234,
					"content": "İnanılmaz! Şaşıp kaldım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610235,
					"content": "Bir <color=#00E1FFFF>Hazine Avcıları</color> çetesi son zamanlarda çok aktif ve pek çok harabedeki yadigarları çaldılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610236
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610236,
					"content": "Ne yazık ki çok geçmeden Arkadya Harabelerini de bulacaklar ve büyülü kılıç kaybolacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610237
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610237,
					"content": "Kılıcın yanlış kişilerin eline geçmesine izin veremeyiz! Kılıcı onlardan önce ele geçirmeliyiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610238,
					"content": "#Sen merak etme, Paimon ve {NICKNAME} sana yardım edecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610239,
					"content": "Vay canına...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610240
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610240,
					"content": "Harika! Lütfen aramızda kalsın. İyi haberlerinizi bekliyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610241
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610241,
					"content": "#Hey! Ne düşünüyorsun {NICKNAME}? Heyecan verici, değil mi? Aşırı güçlü bir kılıç söz konusu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610242,
						4610243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610242,
					"content": "Anlattıkları doğru mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610244
					]
				},
				{
					"id": 4610244,
					"content": "Pekala... Hadi <color=#00E1FFFF>Maceracılar Loncasına</color> gidip daha fazla bilgi edinebilir miyiz bir bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610245,
					"content": "Maceracılar harabeler hakkında daha fazla bilgi sahibidir, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610243,
					"content": "Anlattıkları cidden doğru mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610244
					]
				},
				{
					"id": 4610232,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610233
					]
				},
				{
					"id": 4610213,
