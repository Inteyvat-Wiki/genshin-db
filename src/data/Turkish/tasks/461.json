			"dialogs": [
				{
					"id": 4610101,
					"content": "Çok kötü... Çok can sıkıcı... Ne yapacağım ben şimdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610102,
						4610103
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610102,
					"content": "Sorun nedir Kaeya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610104
					]
				},
				{
					"id": 4610104,
					"content": "#Bin Rüzgara şükürler olsun! {NICKNAME}, seni tanrılar göndermiş olmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610105
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610105,
					"content": "Bu zavallı ölümlüyü kurtarmak için Rüzgar Tanrısı tarafından gönderilen elçiden bana biraz zaman ayırmasını isteyebilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610106
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610106,
					"content": "Iyy, sadede gel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610107,
						4610109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610107,
					"content": "Pek zamanım yok...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610108
					]
				},
				{
					"id": 4610108,
					"content": "Muhteşem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610110
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610110,
					"content": "Diğer şövalyelerin duymaması gerek! Senden başka kimseden yardım isteyemem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610111
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610111,
					"content": "Lütfen bu konuyu konuşabileceğimiz bir yere gidelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610112
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610112,
					"content": "Genel merkezin hemen dışındaki avluda konuşalım. Benimle gelin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4610113
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4610113,
					"content": "Bu gizli kapaklı iş de ne böyle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4610109,
					"content": "Neler olduğunu anlat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610110
					]
				},
				{
					"id": 4610103,
					"content": "Sen genelde soğukkanlılığını yitirmezsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4610104
					]
				}
			]
		},
		{
			"id": 46102,
			"completionStepIds": [
				46109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
