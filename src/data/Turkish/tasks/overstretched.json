				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210033001,
					"content": "Dayanamıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033002
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033002,
					"content": "Sorun ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210033003
					]
				},
				{
					"id": 210033003,
					"content": "Kim var orada? Bu köprüyü geçmek isteyen herkes sorgulanacak. Kurallar böyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033004
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033004,
					"content": "Ama... Şu kıyafetlerine bir bak! Senden endişelenmeme hiç gerek yok belli ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033005
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033005,
					"content": "Neden mi? Düşünsene. Suçlular mümkün olduğunca göze batmamaya çalışır, öyle değil mi? Sense çok gösterişli giyinmişsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033015
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033015,
					"content": "Burada ne yapıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033006
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033006,
					"content": "Ben bu bölgeden sorumlu Taşordu muhafızıyım. Burası Dihua Bataklığı için büyük bir geçittir. Tüccarlar ve turistler buradan geçer. Bu nedenle ben de burada nöbet tutmaya gönderildim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033007
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033007,
					"content": "Geçen gün yakınlarda birkaç canavar buldum. Kamp kurmuşlar. Henüz harekete geçmeseler de güvenlik açısından tehlikeliler. Onlara dikkat etmem lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033008
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033008,
					"content": "Zevkle gidip onları kovardım ama nöbet yerimden ayrılırsam başka canavarların bunu fırsat bilip buradan geçenleri pusuya düşürmesinden korkuyorum. Bütün gün buraya sıkışıp kalıyorum. Çok çaresiz hissediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033009
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033009,
					"content": "Canavarların icabına baktım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210033010
					]
				},
				{
					"id": 210033010,
					"content": "Gerçekten mi? Hepsinin mi? Harika!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033011
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033011,
					"content": "Çok yardımcı oldun. Senden böyle bir şey istediğim için kusura bakma. Benim yapmam gerekirdi ama bütün işi sen yaptın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033012
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033012,
					"content": "Of. Üstlerim ne yapıyor bilmiyorum ama bu zamana kadar cidden birilerini göndermiş olmaları gerekirdi. Burası bir kişi için fazla büyük.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033013
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033013,
					"content": "İlk fırsatta onlara bu durum hakkında eksiksiz bir rapor göndereceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210033014
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210033014,
					"content": "Teşekkür ederim. Zahmet ettin. Lütfen bunları kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qiaoxi"
				}
			]
		},
