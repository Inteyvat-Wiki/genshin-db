			"dialogs": [
				{
					"id": 210030111,
					"content": "*iç çeker* Daha kalabalık olsak hiç sorun olmazdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210030112
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210030112,
					"content": "Zevkle gidip onları kovardım ama nöbet yerimden ayrılırsam başka canavarların bunu fırsat bilip buradan geçenleri pusuya düşürmesinden korkuyorum. Bütün gün buraya sıkışıp kalıyorum. Çok çaresiz hissediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210030113
					],
					"speakerTitle": "Qiaoxi"
				},
				{
					"id": 210030113,
					"content": "Benim için gidip canavarların icabına bakabilir misin? Böylece başka işlere odaklanabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qiaoxi"
				}
			]
		},
		{
