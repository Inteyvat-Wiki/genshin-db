			"dialogs": [
				{
					"id": 220070101,
					"content": "Nereye gitti şimdi bu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070102
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070102,
					"content": "Sorun ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220070103
					]
				},
				{
					"id": 220070103,
					"content": "Bir harabeyi araştırıyordum, birden canavarların saldırısına uğradım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070104
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070104,
					"content": "Panikleyip kaçtım ama bulduğum yadigarı orada düşürdüm herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070105
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070105,
					"content": "Canavarlar gittikten sonra harabeye geri döndüm ama yadigarı bulamadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070106
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070106,
					"content": "Her yerde aradım, bir türlü bulamıyorum. Acaba canavarlar almış olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070107
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070107,
					"content": "Aramama yardım eder misin? Bulursan bu kutuya koyabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				}
			]
		},
