					"nextDialogs": [
						220070203
					]
				},
				{
					"id": 220070203,
					"content": "Hey! Kutuyu incelersen yadigar zarar görmesin diye kutunun içini bir sürü kıyafetle doldurduğumu görebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070204
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070204,
					"content": "Ben profesyonel bir alimim, bilmem haberin var mı? Acemi hatalar yapmam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220070205
					],
					"speakerTitle": "Bao'er"
				},
				{
					"id": 220070205,
					"content": "Neyse, yadigarı aramama yardım ettiğin için teşekkürler. O canavarlara karşı bir şey yapamazdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bao'er"
				}
			]
		},
