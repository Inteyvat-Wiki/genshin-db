			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xiangling"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110000501,
					"content": "Vay canına! Bu harika! Bir kısmını az yağda kızartırım, bir kısmını da mantarlarla pişiririm. Bodurlop Özü ile nasıl olur merak ediyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000502,
						110000504
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000502,
					"content": "Kendi dünyasına daldı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000503
					]
				},
				{
					"id": 110000503,
					"content": "Paimon bizi unuttuğunu düşünüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000506,
					"content": "Ah, üzgünüm! Yeni tarifleri düşününce çok heyecanlandım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000507
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000507,
					"content": "Söz verdiğim gibi, lezzetli bir atıştırmalık! Hadi, deneyin! Ve bana fikrinizi söyleyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000508
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000508,
					"content": "Artık senin yemek tadımcıların mıyız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000509,
					"content": "Ah tanrım, bu... Enfes!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000510,
					"content": "Bunu nasıl yaptığını bize anlatır mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000511,
					"content": "Hahaha, elbette! Yalnız tarifi henüz yazmadım, hımm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000512
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000512,
					"content": "Buldum! Bir tane daha hazırlayacağım, böylece siz de izleyebilirsiniz. Hemen anlayacağınızdan eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000513
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000513,
					"content": "Yapması oldukça zor görünüyor, bu yemeği öğrenmek söylediğinden daha uzun sürecek. Ayrıca bir kızartma tavamız ya da herhangi bir baharatımız yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110000514,
					"content": "Hadi ama, çok kolay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000515
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000515,
					"content": "Biraz kuyruk yağı kullanarak bir taş levhanın üzerinde kızartabiliriz. Taşlardan bir ocak yapıp, tutuşturmak için kuru otlar ve ateş için ince dalları...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000516
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000516,
					"content": "Tatlı çiçekler, şeker yerine kullanılır. Tuz için ise geçen gün bir mağarada bol miktarda kaya tuzu buldum, hâlâ çok fazla var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000517,
						110000518
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000517,
					"content": "Bunu daha önce milyonlarca defa yapmış gibi görünüyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000519
					]
				},
				{
					"id": 110000519,
					"content": "Hahaha, yeni bir şey deneme şansı bulduğumda kendimi durduramıyorum. Ama evden çıkarken her seferinde tüm mutfak malzemelerimi de yanıma alamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000520
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000520,
					"content": "Her şeyi hazırlamam için bana biraz zaman verin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000521
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000521,
					"content": "Hey! Ne yaptığını sanıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000601
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 110000601,
					"content": "Burası yaban domuzlarının doğal yaşam alanı, onları burada avlayamazsınız! Hepsini kaçıracaksınız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000602
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 110000602,
					"content": "Biz avcılar, yumurtlayan tavuğu kesmemek gerektiğini iyi biliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000603
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 110000603,
					"content": "Ah! Anladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000604
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000604,
					"content": "En taze, en iyi kalitedeki et; doğal ortamlarında büyüyen ve serbestçe gezen yaban domuzlarından elde edilir! Hepsi kaçarsa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000605
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000605,
					"content": "... Bu gastronomiye büyük bir darbe vurur. Hayır, hatta tüm insanlığa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000606,
						110000607
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000606,
					"content": "Bu da bir bakış açısı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000608
					]
				},
				{
					"id": 110000608,
					"content": "Üzgünüm. Heyecanlandım ve yaratacağımız etkiyi düşünmedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000609
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110000609,
					"content": "*iç çeker* Draff'tan özür dilemelisiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000610
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 110000610,
					"content": "Liderimiz olarak daima av kurallarına uymanın önemini vurgular. Korkarım ki şu anda çok üzgün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000611,
						110000612
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 110000611,
					"content": "Ne yapacağız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110000613
					]
				},
				{
					"id": 110000613,
					"content": "Bir hata yaptım ve gidip özür dilemeliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110000614
					],
					"speakerTitle": "Xiangling"
				},
				{
