			"dialogs": [
				{
					"id": 750490401,
					"content": "Bu girişi bulabileceğin hiç aklıma gelmemişti. Buraya uzun zamandır kimse gelmemişti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750490402
					],
					"speakerTitle": "Gece Ruhu Tayfı"
				},
				{
					"id": 750490402,
					"content": "Burası... Hımm, evet, Gece Ruhlarının dolaştığı yer burası. Ancak ne yazık ki artık güneşin aydınlattığı dünyada onların ne adını ne de yaptıklarını hatırlayacak birileri kaldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750490403
					],
					"speakerTitle": "Gece Ruhu Tayfı"
				},
				{
					"id": 750490403,
					"content": "Ah şu Gece Ruhları... Hanımımız uyurken onun gördüğü rüyalarıyız biz. Tanrıçamız gözlerini araladığında, zihnindeki ufak düşünceleriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750490404
					],
					"speakerTitle": "Gece Ruhu Tayfı"
				},
				{
					"id": 750490404,
					"content": "Kanlı canlı birinin buraya ayak basması... Haha, içlerindeki savaş arzusu dinmek bilmeyenler buna artık karşı koyamazlar... Sen, yabancı savaşçı, herkes seni çok seviyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750490405
					],
					"speakerTitle": "Gece Ruhu Tayfı"
				},
				{
					"id": 750490405,
					"content": "Bu huzursuz ruhları savaşın ve zaferin ateşiyle sakinleştir ve ödüller kazan... Ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gece Ruhu Tayfı"
				}
			]
		},
